version 1
name "SdfSparseScratchStudy"
(array)entities {
    - {
        name "Camera"
        prototype "SdfOptimizationCamera"
        components {
            GameTransform x=0.0 y=0.0
            GameCamera width=640.0 height=400.0 focal_distance=0.0
            GameHRC2D surface_shadow_mode="Horizon8" ambient=0.25 fog=0.01 bounce_intensity=0.1
        }
    }
    - {
        name "Cyan light"
        prototype "SdfLight"
        components {
            GameTransform x=-280.0 y=-150.0
            GameMaterial emission_color=0x38d9edff
        }
    }
    - {
        name "Amber light"
        prototype "SdfLight"
        components {
            GameTransform x=280.0 y=150.0
            GameMaterial emission_color=0xffac54ff
        }
    }
    - {
        name "Group -1 -1 sphere"
        prototype "SdfSphere"
        components {
            GameTransform x=-244.0 y=-135.0
            GameVisualTransform scale=0.7 pitch=0.0 yaw=0.0 roll=0.0
            GameShader material="SdfAmber"
        }
    }
    - {
        name "Group -1 -1 mesh"
        prototype "SdfComparisonMesh"
        components {
            GameTransform x=-216.0 y=-130.0
            GameVisualTransform scale=0.7 pitch=0.0 yaw=0.0 roll=0.0
            GameGeometry3D elevation=20.0
            GameShader material="SdfCyan"
        }
    }
    - {
        name "Group -1 -1 torus"
        prototype "SdfTorus"
        components {
            GameTransform x=-198.0 y=-143.0
            GameVisualTransform scale=0.6 pitch=0.0 yaw=0.0 roll=0.0
            GameGeometry3D elevation=50.0
            GameShader material="SdfRose"
        }
    }
    - {
        name "Group -1 1 sphere"
        prototype "SdfSphere"
        components {
            GameTransform x=-244.0 y=135.0
            GameVisualTransform scale=0.7 pitch=0.0 yaw=0.0 roll=0.0
            GameShader material="SdfAmber"
        }
    }
    - {
        name "Group -1 1 mesh"
        prototype "SdfComparisonMesh"
        components {
            GameTransform x=-216.0 y=140.0
            GameVisualTransform scale=0.7 pitch=0.0 yaw=0.0 roll=0.0
            GameGeometry3D elevation=20.0
            GameShader material="SdfCyan"
        }
    }
    - {
        name "Group -1 1 torus"
        prototype "SdfTorus"
        components {
            GameTransform x=-198.0 y=127.0
            GameVisualTransform scale=0.6 pitch=0.0 yaw=0.0 roll=0.0
            GameGeometry3D elevation=50.0
            GameShader material="SdfRose"
        }
    }
    - {
        name "Group 1 -1 sphere"
        prototype "SdfSphere"
        components {
            GameTransform x=216.0 y=-135.0
            GameVisualTransform scale=0.7 pitch=0.0 yaw=0.0 roll=0.0
            GameShader material="SdfAmber"
        }
    }
    - {
        name "Group 1 -1 mesh"
        prototype "SdfComparisonMesh"
        components {
            GameTransform x=244.0 y=-130.0
            GameVisualTransform scale=0.7 pitch=0.0 yaw=0.0 roll=0.0
            GameGeometry3D elevation=20.0
            GameShader material="SdfCyan"
        }
    }
    - {
        name "Group 1 -1 torus"
        prototype "SdfTorus"
        components {
            GameTransform x=262.0 y=-143.0
            GameVisualTransform scale=0.6 pitch=0.0 yaw=0.0 roll=0.0
            GameGeometry3D elevation=50.0
            GameShader material="SdfRose"
        }
    }
    - {
        name "Group 1 1 sphere"
        prototype "SdfSphere"
        components {
            GameTransform x=216.0 y=135.0
            GameVisualTransform scale=0.7 pitch=0.0 yaw=0.0 roll=0.0
            GameShader material="SdfAmber"
        }
    }
    - {
        name "Group 1 1 mesh"
        prototype "SdfComparisonMesh"
        components {
            GameTransform x=244.0 y=140.0
            GameVisualTransform scale=0.7 pitch=0.0 yaw=0.0 roll=0.0
            GameGeometry3D elevation=20.0
            GameShader material="SdfCyan"
        }
    }
    - {
        name "Group 1 1 torus"
        prototype "SdfTorus"
        components {
            GameTransform x=262.0 y=127.0
            GameVisualTransform scale=0.6 pitch=0.0 yaw=0.0 roll=0.0
            GameGeometry3D elevation=50.0
            GameShader material="SdfRose"
        }
    }
}
