package scalar_square_root

Root :: (value: number) -> number { return sqrt(value); }
GroupedScale :: (value: f64) -> f64 { return value * -(1.5) + value * (-(-2.5)); }
GroupedHalf :: (value: number) -> number { return value * -(+(-(-(0.5)))); }
GroupedZero :: () -> f64 { return -(+(0.0)); }
GroupedPrecise :: () -> f64 { return -(1.0000000000000002); }

Main :: () -> int {
    assert(GroupedScale(2.0) == 2.0 && GroupedHalf(4.0) == -2.0);
    zero64 := GroupedZero();
    assert(zero64 == 0.0 && 1.0 / zero64 < 0.0);
    positive64 := -zero64;
    assert(1.0 / positive64 > 0.0);
    assert(GroupedPrecise() < -1.0 && GroupedPrecise() == -1.0000000000000002);
    assert(Root(81.0) == 9.0);
    assert(Root(2.0) == 1.4142135623730951);
    assert(Root(1.0e-38) > 0.0);
    assert(Root(1.0e-38) < 1.1e-19);
    zero := Root(-0.0);
    assert(zero == 0.0);
    assert(1.0 / zero < 0.0);
    negative := Root(-1.0);
    assert(negative != negative);
    maximum: number = 3.4028234663852886e38;
    infinity := Root(maximum * maximum);
    assert(infinity > maximum);
    widened: f64 = sqrt(2.0);
    assert(widened == f64(Root(2.0)));
    return 0;
}
