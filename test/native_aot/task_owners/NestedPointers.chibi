package owned_nested_pointers

import target "core:target"

foreign import libc "system:c"
foreign libc {
    fopen :: (path: cstring, mode: cstring) -> rawptr
    fclose :: (stream: rawptr) -> i32
    access :: (path: cstring, mode: i32) -> i32
    _access :: (path: cstring, mode: i32) -> i32
}
Make :: () -> ^^int { value := 1; pointer := &value; return &pointer; }
Box :: (value: int) -> ^int { return &value; }
Capture :: (value: ^^int) -> ^^^int { return &value; }
Churn :: () { for index in 0..<3000 { discarded := Capture(Make()); } }
when target.Os == target.Windows {
    Exists :: (path: string) -> bool { return _access(path, 0) == 0; }
} else {
    Exists :: (path: string) -> bool { return access(path, 0) == 0; }
}
Mark :: (path: string) {
    stream := fopen(path, "wb");
    assert(stream != 0);
    closed := fclose(stream);
    assert(closed == 0);
}
Worker :: (pointer: ^^int) -> int {
    saved := pointer^;
    while !Exists("allow-old") { yield; }
    Churn();
    assert(pointer^^ == 1 && saved^ == 1);
    pointer^ = Box(7);
    Churn();
    assert(pointer^^ == 7 && saved^ == 1);
    Mark("old-done");
    return 0;
}
Main :: () -> int {
    worker := Worker(Make());
    Mark("owner-ready");
    return 0;
}
Frame :: () -> int { return 0; }
