    }
    if (target == "chibi_builtin_fonts") {
        return [
            "src/runtime/ui/builtin_fonts.c",
            "build/sdk/generated/fonts/editor_nerd_symbols_font.c",
            "build/sdk/generated/fonts/editor_ui_font.c",
            "build/sdk/generated/fonts/editor_ui_bold_font.c",
            "build/sdk/generated/fonts/editor_ui_medium_font.c",
