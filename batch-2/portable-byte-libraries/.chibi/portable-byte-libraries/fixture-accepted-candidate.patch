+package crc32
+
+@test
+IeeeMatchesPublishedAndBinaryAnswers :: () {
+    empty: u8[] = [];
+    digits: u8[] = [49, 50, 51, 52, 53, 54, 55, 56, 57];
+    assert(Ieee(empty) == u32(0));
+    assert(Ieee(digits) == u32(0xcbf43926));
+    // Binary and UTF-8 byte vectors independently checked with Python zlib.crc32.
+    zeros: u8[] = [0, 0, 0, 0];
+    binary: u8[] = [0, 1, 127, 128, 255];
+    utf8: u8[] = [65, 0, 195, 169, 240, 159, 152, 128];
+    assert(Ieee(zeros) == u32(0x2144df1c));
+    assert(Ieee(binary) == u32(0x37b2c8d3));
+    assert(Ieee(utf8) == u32(0x4e57e6bf));
+    assert(length(binary) == 5 && binary[0] == 0 && binary[4] == 255);
+    return;
+}
+
+@test
+EverySplitContinuesTheSameIeeeChecksum :: () {
+    data: u8[] = [0, 1, 127, 128, 255, 0, 65, 195, 169, 240, 159, 152, 128];
+    empty: u8[] = [];
+    expected := Ieee(data);
+    split := 0;
+    while split <= length(data) {
+        prefix: u8[] = [];
+        suffix: u8[] = [];
+        index := 0;
+        while index < length(data) {
+            if index < split {
+                prefix.append(data[index]);
+            } else {
+                suffix.append(data[index]);
+            }
+            index += 1;
+        }
+        first := UpdateIeee(u32(0), prefix);
+        assert(UpdateIeee(first, empty) == first);
+        assert(UpdateIeee(first, suffix) == expected);
+        split += 1;
+    }
+    assert(UpdateIeee(u32(0x12345678), empty) == u32(0x12345678));
+    return;
+}
+
+@test
+AllByteValuesMatchIndependentIeeeAnswer :: () {
+    data: u8[] = [];
+    index := 0;
+    while index < 256 {
+        data.append(u8(index));
+        index += 1;
+    }
+    // Python zlib.crc32(bytes(range(256))).
+    assert(Ieee(data) == u32(0x29058c73));
+    return;
+}
diff --git a/packages/core/hash/fnv/Fnv.chibi b/packages/core/hash/fnv/Fnv.chibi
new file mode 100644
index 000000000..c6c0a7932
--- /dev/null
+++ b/packages/core/hash/fnv/Fnv.chibi
@@ -0,0 +1,35 @@
+package fnv
+
+// FNV-1a hashes raw bytes. These hashes are for lookup and change detection,
+// not authentication. Results do not depend on the host's byte order.
+// Parameters: https://www.ietf.org/archive/id/draft-eastlake-fnv-35.html#section-5
+
+// Continues a 32-bit FNV-1a hash. Empty data preserves previous.
+// One pass, constant scalar storage, and no mutation of data.
+pub Update32 :: (previous: u32, data: u8[]) -> u32 {
+    hash := previous;
+    for value in data {
+        hash = (hash ^ u32(value)) * u32(0x01000193);
+    }
+    return hash;
+}
+
+// Continues a 64-bit FNV-1a hash. Empty data preserves previous.
+pub Update64 :: (previous: u64, data: u8[]) -> u64 {
+    hash := previous;
+    for value in data {
+        hash = (hash ^ u64(value)) * u64(0x100000001b3);
+    }
+    return hash;
+}
+
+// Starts with the standard 32-bit offset basis. Multiplication intentionally
+// wraps at 32 bits; development integer reports can report this overflow.
+pub Fnv1a32 :: (data: u8[]) -> u32 {
+    return Update32(0x811c9dc5, data);
+}
+
+// Starts with the standard 64-bit offset basis and wraps at 64 bits.
+pub Fnv1a64 :: (data: u8[]) -> u64 {
+    return Update64(0xcbf29ce484222325, data);
+}
