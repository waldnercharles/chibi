diff --git a/packages/core/bytes/Bytes.chibi b/packages/core/bytes/Bytes.chibi
new file mode 100644
index 000000000..49ce19988
--- /dev/null
+++ b/packages/core/bytes/Bytes.chibi
@@ -0,0 +1,151 @@
+package bytes
+
+import strings "core:strings"
+
+// Copy every encoded byte, including NUL and malformed UTF-8. O(n) time and space.
+pub FromString :: (value: string) -> u8[] {
+    result: u8[] = [];
+    for index in 0..<strings.ByteLength(value) {
+        result.append(u8(strings.ByteAt(value, index)));
+    }
+    return result;
+}
+
+// The immutable result preserves every byte without UTF-8 validation. O(n).
+pub ToString :: (value: u8[]) -> string {
+    return text_from_bytes(value);
+}
+
+// Unsigned lexicographic comparison, returning exactly -1, 0 or 1.
+// O(min(length(left), length(right))) time and no temporary storage.
+pub Compare :: (left: u8[], right: u8[]) -> int {
+    index: int = 0;
+    while index < length(left) && index < length(right) {
+        if left[index] < right[index] {
+            return -1;
+        }
+        if left[index] > right[index] {
+            return 1;
+        }
+        index += 1;
+    }
+    if length(left) < length(right) {
+        return -1;
+    }
+    if length(left) > length(right) {
+        return 1;
+    }
+    return 0;
+}
+
+pub Equal :: (left: u8[], right: u8[]) -> bool {
+    return length(left) == length(right) && Compare(left, right) == 0;
+}
+
+// Byte offsets start at zero; -1 means absent. O(n), no temporary storage.
+pub IndexByte :: (data: u8[], value: u8) -> int {
+    for index in 0..<length(data) {
+        if data[index] == value {
+            return index;
+        }
+    }
+    return -1;
+}
+
+pub LastIndexByte :: (data: u8[], value: u8) -> int {
+    index := length(data) - 1;
+    while index >= 0 {
+        if data[index] == value {
+            return index;
+        }
+        index -= 1;
+    }
+    return -1;
+}
+
+MatchesAt :: (data: u8[], needle: u8[], offset: int) -> bool {
+    for index in 0..<length(needle) {
+        if data[offset + index] != needle[index] {
+            return false;
+        }
+    }
+    return true;
+}
+
+PrefixTable :: (needle: u8[]) -> int[] {
+    table: int[] = [0];
+    matched: int = 0;
+    for index in 1..<length(needle) {
+        while matched > 0 && needle[index] != needle[matched] {
+            matched = table[matched - 1];
+        }
+        if needle[index] == needle[matched] {
+            matched += 1;
+        }
+        table.append(matched);
+    }
+    return table;
+}
+
+// Knuth-Morris-Pratt search retains overlapping matches when finding the last one.
+Search :: (data: u8[], needle: u8[], last: bool) -> int {
+    if length(needle) == 0 {
+        if last {
+            return length(data);
+        }
+        return 0;
+    }
+    if length(needle) > length(data) {
+        return -1;
+    }
+    if length(needle) == 1 {
+        if last {
+            return LastIndexByte(data, needle[0]);
+        }
+        return IndexByte(data, needle[0]);
+    }
+    table := PrefixTable(needle);
+    matched: int = 0;
+    found: int = -1;
+    for index in 0..<length(data) {
+        while matched > 0 && data[index] != needle[matched] {
+            matched = table[matched - 1];
+        }
+        if data[index] == needle[matched] {
+            matched += 1;
+        }
+        if matched == length(needle) {
+            found = index - length(needle) + 1;
+            if !last {
+                return found;
+            }
+            matched = table[matched - 1];
+        }
+    }
+    return found;
+}
+
+// An empty needle matches at zero. O(n+m) time, O(m) temporary integer storage.
+// Empty and one-byte needles need no temporary storage.
+pub Index :: (data: u8[], needle: u8[]) -> int {
+    return Search(data, needle, false);
+}
+
+// An empty needle matches at length(data). O(n+m) time, O(m) temporary storage.
+pub LastIndex :: (data: u8[], needle: u8[]) -> int {
+    return Search(data, needle, true);
+}
+
+pub Contains :: (data: u8[], needle: u8[]) -> bool {
+    return Index(data, needle) >= 0;
+}
+
+// O(length(prefix)) time, no temporary storage. Empty prefixes always match.
+pub HasPrefix :: (data: u8[], prefix: u8[]) -> bool {
+    return length(prefix) <= length(data) && MatchesAt(data, prefix, 0);
+}
+
+// O(length(suffix)) time, no temporary storage. Empty suffixes always match.
+pub HasSuffix :: (data: u8[], suffix: u8[]) -> bool {
+    return length(suffix) <= length(data) && MatchesAt(data, suffix, length(data) - length(suffix));
+}
diff --git a/packages/core/bytes/Tests.chibi b/packages/core/bytes/Tests.chibi
new file mode 100644
index 000000000..739aad764
--- /dev/null
+++ b/packages/core/bytes/Tests.chibi
@@ -0,0 +1,157 @@
+package bytes
+
+import strings "core:strings"
+
+@test
+UnsignedOrderAndPrefixOrder :: () {
+    assert(Compare([], []) == 0);
+    assert(Compare([], [0]) == -1);
+    assert(Compare([0], []) == 1);
+    assert(Compare([0, 127], [0, 128]) == -1);
+    assert(Compare([255], [128, 255]) == 1);
+    assert(Compare([0, 255], [0, 255]) == 0);
+    assert(Equal([0, 255], [0, 255]));
+    assert(!Equal([0], [0, 0]));
+    assert(!Equal([255], [0]));
+    return;
+}
+
+@test
+EmptyNeedlesAndMissingBytes :: () {
+    assert(Index([], []) == 0);
+    assert(LastIndex([], []) == 0);
+    assert(Index([1, 2], []) == 0);
+    assert(LastIndex([1, 2], []) == 2);
+    assert(Index([], [0]) == -1);
+    assert(LastIndex([], [0]) == -1);
+    assert(IndexByte([], 0) == -1);
+    assert(LastIndexByte([], 0) == -1);
+    assert(Contains([1], []));
+    assert(HasPrefix([], []));
+    assert(HasSuffix([], []));
+    assert(!HasPrefix([], [0]));
+    assert(!HasSuffix([], [0]));
+    return;
+}
+
+@test
+SearchPreservesBinaryOffsets :: () {
+    data: u8[] = [0, 255, 0, 255, 255, 0];
+    assert(IndexByte(data, 255) == 1);
+    assert(LastIndexByte(data, 255) == 4);
+    assert(IndexByte(data, 128) == -1);
+    assert(LastIndexByte(data, 128) == -1);
+    assert(Index(data, [0, 255]) == 0);
+    assert(LastIndex(data, [0, 255]) == 2);
+    assert(Index(data, [255, 255]) == 3);
+    assert(LastIndex(data, [255, 255]) == 3);
+    assert(Index(data, [0, 0]) == -1);
+    assert(LastIndex(data, [0, 0]) == -1);
+    assert(!Contains(data, [1]));
+    assert(HasPrefix(data, [0, 255, 0]));
+    assert(HasSuffix(data, [255, 255, 0]));
+    assert(!HasPrefix(data, [0, 254]));
+    assert(!HasSuffix(data, [255, 1]));
+    assert(Index([1, 1, 1, 1, 2], [1, 1, 2]) == 2);
+    assert(LastIndex([1, 1, 1, 1, 2], [1, 1, 2]) == 2);
+    assert(Index([1, 2, 1, 2, 1, 2, 1], [1, 2, 1]) == 0);
+    assert(LastIndex([1, 2, 1, 2, 1, 2, 1], [1, 2, 1]) == 4);
+    return;
+}
+
+@test
+EveryByteConvertsWithoutValidation :: () {
+    data: u8[] = [];
+    for index in 0..<256 {
+        data.append(u8(index));
+    }
+    text := ToString(data);
+    assert(strings.ByteLength(text) == 256);
+    for index in 0..<256 {
+        assert(strings.ByteAt(text, index) == index);
+    }
+    assert(Equal(FromString(text), data));
+    assert(ToString([]) == "");
+    assert(length(FromString("")) == 0);
+    assert(Equal(FromString("A"), [65]));
+    assert(ToString([65, 0, 66]) != "A");
+    data[0] = 255;
+    assert(strings.ByteAt(text, 0) == 0);
+    copy := FromString(text);
+    copy[1] = 255;
+    assert(strings.ByteAt(text, 1) == 1);
+    return;
+}
+
+@test
+ByteSearchCoversTheWholeByteDomain :: () {
+    data: u8[] = [];
+    for index in 0..<256 {
+        data.append(u8(index));
+    }
+    for index in 0..<256 {
+        value := u8(index);
+        assert(IndexByte(data, value) == index);
+        assert(LastIndexByte(data, value) == index);
+        assert(Index(data, [value]) == index);
+        assert(LastIndex(data, [value]) == index);
+    }
+    return;
+}
+
+BinaryWord :: (size: int, bits: int) -> u8[] {
+    word: u8[] = [];
+    for index in 0..<size {
+        word.append(u8((bits >> u32(index)) & 1));
+    }
+    return word;
+}
+
+Oracle :: struct {
+    first: int;
+    last: int;
+}
+
+// Enumerate all candidate offsets independently of the prefix-table search.
+ReferenceSearch :: (data: u8[], needle: u8[]) -> Oracle {
+    first: int = -1;
+    last: int = -1;
+    for offset in 0..<length(data) - length(needle) + 1 {
+        matched: bool = true;
+        for index in 0..<length(needle) {
+            if data[offset + index] != needle[index] {
+                matched = false;
+            }
+        }
+        if matched {
+            if first == -1 {
+                first = offset;
+            }
+            last = offset;
+        }
+    }
+    return {first: first, last: last};
+}
+
+@test
+SubstringSearchMatchesExhaustiveShortBinaryWords :: () {
+    dataCount: int = 1;
+    for size in 0..<5 {
+        for bits in 0..<dataCount {
+            data := BinaryWord(size, bits);
+            needleCount: int = 1;
+            for count in 0..<4 {
+                for value in 0..<needleCount {
+                    needle := BinaryWord(count, value);
+                    expected := ReferenceSearch(data, needle);
+                    assert(Index(data, needle) == expected.first);
+                    assert(LastIndex(data, needle) == expected.last);
+                    assert(Contains(data, needle) == (expected.first != -1));
+                }
+                needleCount *= 2;
+            }
+        }
+        dataCount *= 2;
+    }
+    return;
+}
diff --git a/packages/core/hash/adler32/Adler32.chibi b/packages/core/hash/adler32/Adler32.chibi
new file mode 100644
index 000000000..f90a1cc12
--- /dev/null
+++ b/packages/core/hash/adler32/Adler32.chibi
@@ -0,0 +1,34 @@
+package adler32
+
+// Adler-32 parameters are defined in RFC 1950 section 2.2.
+// https://www.rfc-editor.org/rfc/rfc1950.html#section-2.2
+// Computes the byte sums in bounded blocks, without mutating data.
+// The algorithm uses constant scalar storage and O(n) work.
+
+// Continues a checksum returned by Sum or Update. Empty data preserves previous.
+// u64 accumulators accommodate every u32 seed without intermediate overflow.
+pub Update :: (previous: u32, data: u8[]) -> u32 {
+    first := u64(previous & u32(0xffff));
+    second := u64(previous >> u32(16));
+    start := 0;
+    while start < length(data) {
+        count := length(data) - start;
+        if count > 5552 {
+            count = 5552;
+        }
+        end := start + count;
+        while start < end {
+            first += u64(data[start]);
+            second += first;
+            start += 1;
+        }
+        first %= u64(65521);
+        second %= u64(65521);
+    }
+    return (u32(second) << u32(16)) | u32(first);
+}
+
+// Starts with the standard initial checksum of 1. The empty checksum is 1.
+pub Sum :: (data: u8[]) -> u32 {
+    return Update(1, data);
+}
diff --git a/packages/core/hash/adler32/Tests.chibi b/packages/core/hash/adler32/Tests.chibi
new file mode 100644
index 000000000..4bc7e0649
--- /dev/null
+++ b/packages/core/hash/adler32/Tests.chibi
@@ -0,0 +1,68 @@
+package adler32
+
+@test
+StandardAdler32Answers :: () {
+    empty: u8[] = [];
+    wikipedia: u8[] = [87, 105, 107, 105, 112, 101, 100, 105, 97];
+    digits: u8[] = [49, 50, 51, 52, 53, 54, 55, 56, 57];
+    assert(Sum(empty) == u32(1));
+    assert(Sum(wikipedia) == u32(0x11e60398));
+    assert(Sum(digits) == u32(0x091e01de));
+    return;
+}
+
+@test
+Adler32IncludesZeroAndUnsignedBytes :: () {
+    data: u8[] = [0, 127, 128, 255, 0];
+    // Independent checksum from Python's zlib.adler32.
+    assert(Sum(data) == u32(0x057f01ff));
+    assert(data[0] == u8(0) && data[1] == u8(127));
+    assert(data[2] == u8(128) && data[3] == u8(255) && data[4] == u8(0));
+    return;
+}
+
+@test
+Adler32EverySplitContinuesTheSameChecksum :: () {
+    data: u8[] = [0, 127, 128, 255, 0];
+    empty: u8[] = [];
+    split := 0;
+    while split <= length(data) {
+        first: u8[] = [];
+        second: u8[] = [];
+        i := 0;
+        while i < length(data) {
+            if i < split {
+                first.append(data[i]);
+            } else {
+                second.append(data[i]);
+            }
+            i += 1;
+        }
+        checksum := Update(1, first);
+        assert(Update(Update(checksum, empty), second) == u32(0x057f01ff));
+        split += 1;
+    }
+    assert(Update(0, empty) == u32(0));
+    assert(Update(0xffffffff, empty) == u32(0xffffffff));
+    return;
+}
+
+@test
+Adler32LongMaximumByteInput :: () {
+    data: u8[] = [];
+    while length(data) < 11105 {
+        data.append(u8(255));
+        // Independent answers from Python's zlib.adler32 for repeated 0xff.
+        if length(data) == 5551 {
+            assert(Sum(data) == u32(0x56039a8d));
+        }
+        if length(data) == 5552 {
+            assert(Sum(data) == u32(0xf18f9b8c));
+        }
+        if length(data) == 5553 {
+            assert(Sum(data) == u32(0x8e299c8b));
+        }
+    }
+    assert(Sum(data) == u32(0x37a33825));
+    return;
+}
