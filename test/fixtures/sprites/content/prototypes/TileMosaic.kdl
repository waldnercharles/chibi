name "TileMosaic"
components {
    GAME.GameOrientation radians=0.35
    GAME.GameTilemap cells="1 2 -1 3" columns=2 frame_height=16 frame_width=16 height_map="content/images/props_height.png" image="content/images/props.png" layer=1 normal_map="content/images/props_normal.png" relief=4.0 rows=2
    GAME.GameTransform x=-120.0 y=40.0
}
