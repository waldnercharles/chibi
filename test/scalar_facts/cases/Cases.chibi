        Rejected("too_many_arguments", "package scalar\nMain :: () -> int { return Id(1, 2); }\nId :: (x: int) -> int { return x; }", "call has the wrong number of arguments", "Id(1, 2)"),
        Rejected("argument_type", "package scalar\nMain :: () -> int { return Id(true); }\nId :: (x: int) -> int { return x; }", "argument differs from its parameter type", "Id(true)"),
        Rejected("call_result_type", "package scalar\nMain :: () -> int { return Yes(); }\nYes :: () -> bool { return true; }", "returned value differs from the result type", "return Yes();"),
