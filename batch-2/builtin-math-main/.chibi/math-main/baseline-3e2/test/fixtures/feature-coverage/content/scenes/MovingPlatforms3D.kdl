version 1
name "MovingPlatforms3D"
presentation "3d"
(array)entities {
    - name="View" prototype="MovingPlatformsView"
    - name="Gravity" prototype="Gravity3D"
    - {
        name "TranslatingPlatform"
        prototype "MovingPlatform3D"
        components {
            Transform3D {
                position x=-120.0
            }
            Body3D {
                linear_velocity x=24.0
            }
        }
    }
    - {
        name "TranslatingRider"
        prototype "PlatformRider3D"
        components {
            Transform3D {
                position x=-120.0 y=28.0
            }
        }
    }
    - {
        name "RotatingPlatform"
        prototype "MovingPlatform3D"
        components {
            Transform3D {
                position x=120.0
            }
            Body3D {
                angular_velocity y=0.5
            }
            Material scene=0x60a078ff
        }
    }
    - {
        name "RotatingRider"
        prototype "PlatformRider3D"
        components {
            Transform3D {
                position x=168.0 y=28.0
            }
        }
    }
}
