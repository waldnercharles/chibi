package bits

// Concrete-width unsigned bit operations. These functions allocate no storage.
// Zero has width leading and trailing zeros. Rotation counts wrap modulo width.

pub CountOnes32 :: (value: u32) -> int {
    word := value - ((value >> u32(1)) & u32(0x55555555));
    word = (word & u32(0x33333333)) + ((word >> u32(2)) & u32(0x33333333));
    word = (word + (word >> u32(4))) & u32(0x0f0f0f0f);
    word += word >> u32(8);
    word += word >> u32(16);
    return int(word & u32(63));
}

pub CountOnes64 :: (value: u64) -> int {
    word := value - ((value >> u32(1)) & u64(0x5555555555555555));
    word = (word & u64(0x3333333333333333)) + ((word >> u32(2)) & u64(0x3333333333333333));
    word = (word + (word >> u32(4))) & u64(0x0f0f0f0f0f0f0f0f);
    word += word >> u32(8);
    word += word >> u32(16);
    word += word >> u32(32);
    return int(word & u64(127));
}

pub LeadingZeros32 :: (value: u32) -> int {
    if value == 0 {
        return 32;
    }
    word := value;
    count := 0;
    if word >> u32(16) == 0 {
        count += 16;
        word = word << u32(16);
    }
    if word >> u32(24) == 0 {
        count += 8;
        word = word << u32(8);
    }
    if word >> u32(28) == 0 {
        count += 4;
        word = word << u32(4);
    }
    if word >> u32(30) == 0 {
        count += 2;
        word = word << u32(2);
    }
    if word >> u32(31) == 0 {
        count += 1;
    }
    return count;
}

pub LeadingZeros64 :: (value: u64) -> int {
    if value == 0 {
        return 64;
    }
    high := value >> u32(32);
    if high == 0 {
        return 32 + LeadingZeros32(u32(value));
    }
    return LeadingZeros32(u32(high));
}

pub TrailingZeros32 :: (value: u32) -> int {
    if value == 0 {
        return 32;
    }
    word := value;
    count := 0;
    if (word & u32(0xffff)) == 0 {
        count += 16;
        word = word >> u32(16);
    }
    if (word & u32(0xff)) == 0 {
        count += 8;
        word = word >> u32(8);
    }
    if (word & u32(15)) == 0 {
        count += 4;
        word = word >> u32(4);
    }
    if (word & u32(3)) == 0 {
        count += 2;
        word = word >> u32(2);
    }
    if (word & u32(1)) == 0 {
        count += 1;
    }
    return count;
}

pub TrailingZeros64 :: (value: u64) -> int {
    low := value & u64(0xffffffff);
    if low == 0 {
        return 32 + TrailingZeros32(u32(value >> u32(32)));
    }
    return TrailingZeros32(u32(low));
}

pub ByteSwap16 :: (value: u16) -> u16 {
    return (value >> u32(8)) | (value << u32(8));
}

pub ByteSwap32 :: (value: u32) -> u32 {
    word := ((value & u32(0x00ff00ff)) << u32(8)) | ((value >> u32(8)) & u32(0x00ff00ff));
    return (word << u32(16)) | (word >> u32(16));
}

pub ByteSwap64 :: (value: u64) -> u64 {
    word := ((value & u64(0x00ff00ff00ff00ff)) << u32(8)) | ((value >> u32(8)) & u64(0x00ff00ff00ff00ff));
    word = ((word & u64(0x0000ffff0000ffff)) << u32(16)) | ((word >> u32(16)) & u64(0x0000ffff0000ffff));
    return (word << u32(32)) | (word >> u32(32));
}

pub Reverse32 :: (value: u32) -> u32 {
    word := ((value & u32(0x55555555)) << u32(1)) | ((value >> u32(1)) & u32(0x55555555));
    word = ((word & u32(0x33333333)) << u32(2)) | ((word >> u32(2)) & u32(0x33333333));
    word = ((word & u32(0x0f0f0f0f)) << u32(4)) | ((word >> u32(4)) & u32(0x0f0f0f0f));
    return ByteSwap32(word);
}

pub Reverse64 :: (value: u64) -> u64 {
    word := ((value & u64(0x5555555555555555)) << u32(1)) | ((value >> u32(1)) & u64(0x5555555555555555));
    word = ((word & u64(0x3333333333333333)) << u32(2)) | ((word >> u32(2)) & u64(0x3333333333333333));
    word = ((word & u64(0x0f0f0f0f0f0f0f0f)) << u32(4)) | ((word >> u32(4)) & u64(0x0f0f0f0f0f0f0f0f));
    return ByteSwap64(word);
}

pub RotateLeft32 :: (value: u32, count: u32) -> u32 {
    shift := count & u32(31);
    return (value << shift) | (value >> (u32(32) - shift));
}

pub RotateRight32 :: (value: u32, count: u32) -> u32 {
    shift := count & u32(31);
    return (value >> shift) | (value << (u32(32) - shift));
}

pub RotateLeft64 :: (value: u64, count: u32) -> u64 {
    shift := count & u32(63);
    return (value << shift) | (value >> (u32(64) - shift));
}

pub RotateRight64 :: (value: u64, count: u32) -> u64 {
    shift := count & u32(63);
    return (value >> shift) | (value << (u32(64) - shift));
}
