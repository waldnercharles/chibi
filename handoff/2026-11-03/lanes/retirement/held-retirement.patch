-            return NULL;
-        }
-        FILE *file = fdopen(fd, "w");
-        if (!file) {
-            close(fd);
-            return NULL;
-        }
-        /* Preserve completed observations even if a later child times out. */
-        setvbuf(file, NULL, _IOLBF, 0);
-        fputs("category\tstep\tstarted\tobserved\tstatus\terror\n", file);
-        return file;
-    }
