name "TrailEmitter"
components {
    (object)GAME.GameOrientation
    GAME.GameParticleEmitter {
        active #true
        antialias {
            end x=1.0 y=1.0
            exponent 1.0
            start x=2.0 y=3.0
        }
        color 0x00fff0ff
        direction x=-1.0
        drag {
            start x=2.0 y=3.0
        }
        emission {
            start x=0.01 y=0.02
        }
        end_color 0x004c8000
        fluid_mass 0.0002
        heading_only #true
        lifetime x=0.15 y=0.3
        offset x=-6.0
        planar #true
        rate 60.0
        size {
            start x=0.25 y=0.25
        }
        speed x=20.0 y=40.0
        spread 1.047198
    }
    GAME.GameProjectile lifetime=1.5
    (object)GAME.GameTransform
    (object)GAME.GameVelocity
}
(array)behaviors "ProjectileLifecycle"
