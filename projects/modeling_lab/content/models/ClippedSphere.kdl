version 3
name "ClippedSphere"
domain "model"
id_counter 13
description "Sphere intersected with a thin finite slab."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Sphere"
                inputs Radius=29.0
            }
            - {
                id 6
                type "Model Box"
                inputs {
                    "Half Size" {
                        default x=34.0 y=12.0 z=21.0
                    }
                }
            }
            - id=9 type="Model Intersection"
        }
        (array)edges {
            - from="3.Geometry" to="9.A"
            - from="6.Geometry" to="9.B"
            - from="9.Geometry" to="1.Geometry"
        }
    }
}
