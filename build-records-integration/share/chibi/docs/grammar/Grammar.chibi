package grammar

import markdown "project:markdown"
import strings "core:strings"

// The grammar page, generated from the Tree-sitter grammar's source: each
// rule in source order, with the comments written above it and its
// definition. The grammar file keeps its rules in a `rules: {` block, one per
// four-space-indented `name: ($) =>` line.

// The rule a line starts, or "".
RuleName :: (line: string) -> string {
    if (!strings.HasPrefix(line, "    ") || markdown.IsBlank(markdown.At(line, 4)) ||
        strings.HasPrefix(line, "    //")) {
        return "";
    }
    colon := strings.Index(line, ": ");
    if (colon < 0) {
        return "";
    }
    return strings.Slice(line, 4, colon - 4);
}

// The Markdown of the grammar page, generated from the grammar file's lines,
// and the index in lines of each of its lines: a comment's or definition's
// own, and its rule's for the lines written around them.
Markdown :: (lines: string[]) -> (md: string[], origins: int[]) {
    md = ["# Grammar", "",
          "The syntax of `.chibi` source, rule by rule, as the parser defines it. A rule whose name starts with `_` shapes others without appearing in syntax trees.",
          ""];
    origins = markdown.Pad(origins, length(md), 0);
    count := length(lines);
    index: int = 0;
    while (index < count && lines[index] != "  rules: {") {
        index += 1;
    }
    index += 1;
    // The lines of the comment above the current line.
    comment: int[] = [];
    while (index < count && !strings.HasPrefix(lines[index], "  }")) {
        line := lines[index];
        name := RuleName(line);
        if (strings.HasPrefix(line, "    //")) {
            comment.append(index);
            index += 1;
            continue;
        }
        if (name == "") {
            comment = [];
            index += 1;
            continue;
        }
        md.append(format_text("### {}", name));
        md.append("");
        origins = markdown.Pad(origins, length(md), index);
        for (at in comment) {
            md.append(markdown.Trim(markdown.From(lines[at], 6)));
            origins.append(at);
        }
        md.append("");
        md.append("```js");
        origins = markdown.Pad(origins, length(md), index);
        md.append(markdown.From(line, 4));
        origins.append(index);
        index += 1;
        while (index < count && !strings.HasPrefix(lines[index], "  }") &&
               RuleName(lines[index]) == "" && !strings.HasPrefix(lines[index], "    //")) {
            md.append(markdown.From(lines[index], 4));
            origins.append(index);
            index += 1;
        }
        md.append("```");
        md.append("");
        origins = markdown.Pad(origins, length(md), index - 1);
        comment = [];
    }
    return (md: md, origins: origins);
}

// The grammar page's body: lines are the grammar file's, and the last three
// arguments map links as markdown.Render does.
pub Render :: (lines: string[], page: string, sources: string[], outputs: string[]) -> string[] {
    grammar := Markdown(lines);
    return markdown.Render(grammar.md, page, sources, outputs);
}

// A report, as markdown.Dropped writes it, of each link Render writes as text,
// at the line of the grammar file that holds it.
pub Unpublished :: (lines: string[], page: string, sources: string[], outputs: string[]) -> string[] {
    grammar := Markdown(lines);
    rendered := markdown.Page(grammar.md, page, sources, outputs);
    reports: string[] = [];
    index: int = 0;
    while (index < length(rendered.at)) {
        line := grammar.origins[rendered.at[index]];
        reports.append(markdown.Dropped(page, line + 1, rendered.targets[index]));
        index += 1;
    }
    return reports;
}
