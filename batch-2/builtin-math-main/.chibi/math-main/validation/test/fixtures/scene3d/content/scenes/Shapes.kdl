version 1
name "Shapes"
presentation "3d"
(array)entities {
    - {
        name "Environment"
        prototype "Environment"
        (array)behaviors
    }
    - {
        name "Sun"
        prototype "Sun"
        (array)behaviors
    }
    - {
        name "Box"
        prototype "Solid"
        components {
            Transform x=200.0 y=-180.0
            Geometry3D primitive=0 width=100.0 depth=100.0 height=100.0 elevation=50.0
            Material scene=0xd04030ff
        }
        (array)behaviors
    }
    - {
        name "Sphere"
        prototype "Solid"
        components {
            Transform x=440.0 y=-180.0
            Geometry3D primitive=1 width=110.0 depth=110.0 height=110.0 elevation=55.0
            Material scene=0x40a0e0ff
        }
        (array)behaviors
    }
    - {
        name "Lamp"
        prototype "Solid"
        components {
            Transform x=320.0 y=-90.0
            Geometry3D primitive=1 width=16.0 depth=16.0 height=16.0 elevation=90.0
            Material scene=0xffe0b0ff emission_color=0xffc080ff emission_intensity=4.0 emission_multiplier=1.0
            PointLight color=0xffc080ff intensity=6.0 radius=420.0 elevation=90.0 shadows=#true
        }
    }
    - {
        name "Spot"
        prototype "Solid"
        components {
            Transform x=600.0 y=-320.0
            Geometry3D primitive=1 width=16.0 depth=16.0 height=16.0 elevation=170.0
            Material scene=0xd0e0ffff emission_color=0xa0c0ffff emission_intensity=4.0 emission_multiplier=1.0
            SpotLight {
                color 0xa0c0ffff
                direction x=-220.0 y=-170.0 z=170.0
                elevation 170.0
                inner_angle 50.0
                intensity 10.0
                outer_angle 70.0
                radius 500.0
                shadows #true
            }
        }
    }
    - {
        name "Floor"
        prototype "Solid"
        components {
            Transform x=320.0 y=-180.0
            Geometry3D primitive=0 width=600.0 depth=400.0 height=4.0 elevation=-2.0
            Material scene=0x808080ff
        }
        (array)behaviors
    }
}
