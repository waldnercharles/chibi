package facts

// constant and dynamic byte array debugger origins
@test
Calls :: () {
    r1: u8[] = Folded();
    e1: u8[] = [3, 4];
    assert(length(r1) == length(e1), "Folded call 1 length");
    for k in 0..<length(e1) {
        assert(r1[k] == e1[k], "Folded call 1 element");
    }
    a2_0: u8 = 7;
    r2: u8[] = Mixed(a2_0);
    e2: u8[] = [3, 7];
    assert(length(r2) == length(e2), "Mixed call 2 length");
    for k in 0..<length(e2) {
        assert(r2[k] == e2[k], "Mixed call 2 element");
    }
    r3: int = Inferred();
    e3: int = 7;
    assert(r3 == e3, "Inferred call 3");
}
