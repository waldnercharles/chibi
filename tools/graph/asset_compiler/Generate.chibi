package asset_compiler_stage

import os "core:os"
import strings "core:strings"

// Retain each fragment once per level, not every growing prefix.
Join :: (parts: string[]) -> string {
    while (length(parts) > 1) {
        next: string[] = [];
        index: int = 0;
        while (index < length(parts)) {
            if (index + 1 < length(parts)) {
                next.append(format_text("{}{}", parts[index], parts[index + 1]));
            } else {
                next.append(parts[index]);
            }
            index += 2;
        }
        parts = next;
    }
    if (length(parts) == 0) {
        return "";
    }
    return parts[0];
}

Quote :: (text: string) -> string {
    parts := ["\""];
    start: int = 0;
    index: int = 0;
    for (value in strings.Bytes(text)) {
        escape := "";
        if (value == 34) {
            escape = "\\\"";
        }
        if (value == 92) {
            escape = "\\\\";
        }
        if (value == 10) {
            escape = "\\n";
        }
        if (value == 13) {
            escape = "\\r";
        }
        if (value == 9) {
            escape = "\\t";
        }
        if (value < 32 && escape == "") {
            digits := "0123456789abcdef";
            escape = Join(["\\u00", strings.Slice(digits, value / 16, 1), strings.Slice(digits, value % 16, 1)]);
        }
        if (escape != "") {
            parts.append(strings.Slice(text, start, index - start));
            parts.append(escape);
            start = index + 1;
        }
        index += 1;
    }
    parts.append(strings.Slice(text, start, index - start));
    parts.append("\"");
    return Join(parts);
}

Array :: (values: string[]) -> string {
    parts: string[] = [];
    for (value in values) {
        parts.append(Quote(value));
    }
    return Join(["[", strings.Join(parts, ","), "]"]);
}

Sources :: (folder: string) -> string[] {
    paths: string[] = [];
    for (name in build.list_directory(folder)) {
        path := Join([folder, "/", name]);
        if (os.IsDirectory(path)) {
            for (nested in Sources(path)) {
                paths.append(Join([name, "/", nested]));
            }
        } else if (strings.HasSuffix(name, ".chibi")) {
            paths.append(name);
        }
    }
    return paths;
}

pub InventoryDirectories :: () -> string[] {
    return ["tools/compiler/package_compiler", "tools/compiler/scalar_facts", "tools/compiler/asset_compiler",
            "tools/compiler/asset_source", "tools/compiler/asset_packaging", "packages/core", "packages/game",
            "tools/graph/asset_compiler", "tools/compiler/cost_explanations", "tools/compiler/math_types"];
}

pub Inventory :: (root: string) -> string {
    entries: string[] = [];
    for (directory in InventoryDirectories()) {
        for (path in Sources(Join([root, "/", directory]))) {
            entries.append(Join([directory, "/", path, "\n"]));
        }
    }
    return Join(entries);
}

Read :: (root: string, paths: string[]) -> string[] {
    sources: string[] = [];
    for (path in paths) {
        if (strings.HasPrefix(path, "/sdk/core/")) {
            sources.append(build.read_file(Join([root, "/packages/core/", strings.Slice(path, 10, strings.ByteLength(path))])));
        } else if (strings.HasPrefix(path, "/sdk/game/")) {
            sources.append(build.read_file(Join([root, "/packages/game/", strings.Slice(path, 10, strings.ByteLength(path))])));
        } else {
            sources.append(build.read_file(Join([root, "/tools/compiler/", path])));
        }
    }
    return sources;
}

Request :: (first: string, paths: string[], sources: string[], target: string, game: bool) -> string {
    ordered_paths := [first];
    ordered_sources: string[] = [];
    index: int = 0;
    while (index < length(paths)) {
        if (paths[index] == first) {
            ordered_sources.append(sources[index]);
        }
        index += 1;
    }
    if (length(ordered_sources) != 1) {
        return "";
    }
    index = 0;
    while (index < length(paths)) {
        if (paths[index] != first) {
            ordered_paths.append(paths[index]);
            ordered_sources.append(sources[index]);
        }
        index += 1;
    }
    target = build.trim(target);
    if (!strings.HasPrefix(target, "[") || !strings.HasSuffix(target, "]")) {
        return "";
    }
    collections := "[\"/project\",[\"core\"],[\"/sdk/core\"],";
    if (game) {
        collections = "[\"/project\",[\"core\",\"game\"],[\"/sdk/core\",\"/sdk/game\"],";
    }
    return Join([collections, Array(ordered_paths), ",", Array(ordered_sources),
                 ",false,", strings.Slice(target, 1, strings.ByteLength(target) - 2), "]"]);
}

Invoke :: (host: string, artifact: string, callable: string, input: string, output: string, timeout: string) -> bool {
    generated := os.Capture([host, "--artifact", artifact, "--entry", callable, "--input", input, "--backend", "sljit",
                             "--budget", "10000000000", "--timeout-ms", timeout, "--output-bytes", output]);
    if (generated.status != 0) {
        os.Print(Join(["asset compiler generation failed: ", generated.stderr]));
        if (callable == "0x140a9546d9e8c296") {
            diagnosed := os.Capture([host, "--artifact", artifact, "--entry", "0x19dfb0cfc681eb4b", "--input", input,
                                     "--backend", "sljit", "--budget", "10000000000", "--timeout-ms", timeout]);
            os.Print(diagnosed.stdout);
        }
        return false;
    }
    return true;
}

// A compiled product depends only on its request and the seed that compiles
// it, so it is kept under their digest in `cache`: a build whose sources did
// not change copies it instead of compiling the compiler's sources again.
Key :: (seed: string, request: string) -> string {
    return build.hash_text(Join([build.hash_file(seed), "\n", request]));
}

Product :: (host: string, seed: string, callable: string, request: string, key: string, output: string,
            cache: string, timeout: string, inputs: string) -> bool {
    stored := Join([cache, "/", key]);
    if (os.Exists(stored)) {
        return !os.Copy(stored, output);
    }
    if (os.WriteText(inputs, request) ||
        !Invoke(host, seed, callable, inputs, Join([output, ".tmp"]), timeout)) {
        return false;
    }
    if (os.MakeDirectory(cache) || os.Copy(Join([output, ".tmp"]), stored)) {
        os.Print(Join(["asset compiler: caching product failed: ", key]));
    }
    return !os.Rename(Join([output, ".tmp"]), output);
}

// Removes the cached products this build did not use, so the cache stays at
// the size of one build.
Prune :: (cache: string, keep: string[]) {
    for (name in build.list_directory(cache)) {
        used := false;
        for (item in keep) {
            if (item == name) {
                used = true;
            }
        }
        if (!used && os.Remove(Join([cache, "/", name]))) {
            os.Print(Join(["asset compiler: pruning cache entry failed: ", name]));
        }
    }
}

// Whole seconds from the system clock, for the phase timings the log reports.
Stamp :: () -> string {
    clock := os.Capture(["date", "+%s"]);
    return build.trim(clock.stdout);
}

// Explicit filesystem snapshots and atomic products; source compilation and
// resource generation execute ordinary Chibi in the prepared compiler host.
// Reports are buffered until normal return/unwinding, not live flushed traces;
// a killed or crashed host may not publish them.
pub Generate :: (root: string, host: string, folder: string, target: string, compiler_timeout: string) -> bool {
    os.Print("asset compiler: entered generator");
    inventory := Inventory(root);
    records: string[] = [];
    stamps: string[] = [];
    // Capture non-text snapshot inputs before any host invocation reads them.
    for (path in ["tools/compiler/bootstrap/compiler.chibip", "tools/compiler/bootstrap/bootstrap.json",
                  "tools/graph/asset_compiler/Generate.chibi", "tools/compiler/asset_compiler/CompilerSources.txt",
                  "tools/toolchain/AssetCompiler.chibi"]) {
        checksum := build.hash_file(Join([root, "/", path]));
        records.append(Join(["{\"path\":", Quote(path), ",\"sha256\":", Quote(checksum), "}"]));
        stamps.append(Join([checksum, " ", path, "\n"]));
    }
    native_facts := Join([folder, "/native_target.json"]);
    if (os.MakeDirectory(folder) || os.Run([host, "--target-json", native_facts]) != 0) {
        return false;
    }
    native_target := build.trim(build.read_file(native_facts));
    if (target == "") {
        target = native_target;
    }
    paths: string[] = [];
    for (path in build.lines(build.read_file(Join([root, "/tools/compiler/asset_compiler/CompilerSources.txt"])))) {
        if (path != "") {
            paths.append(path);
        }
    }
    for (directory in ["package_compiler"]) {
        for (file in build.list_directory(Join([root, "/tools/compiler/", directory]))) {
            path := Join([directory, "/", file]);
            found := false;
            for (item in paths) {
                if (item == path) {
                    found = true;
                }
            }
            if (!found && strings.HasSuffix(file, ".chibi")) {
                paths.append(path);
            }
        }
    }
    // Compiler implementation dependencies are explicit in CompilerSources.txt.
    // Public core sources are packaged below, without entering the seed target.
    for (directory in ["asset_compiler", "asset_source", "asset_packaging"]) {
        for (file in build.list_directory(Join([root, "/tools/compiler/", directory]))) {
            if (strings.HasSuffix(file, ".chibi")) {
                paths.append(Join([directory, "/", file]));
            }
        }
    }
    for (path in Sources(Join([root, "/packages/game"]))) {
        paths.append(Join(["/sdk/game/", path]));
    }
    paths.append("cost_explanations/Explain.chibi");
    sources := Read(root, paths);
    inputs := Join([folder, "/input.json"]);
    facade := Join([folder, "/native_facade.chibip"]);
    artifact := Join([folder, "/asset_compiler.chibip"]);
    // The checked seed compiles the facade, its own sources included, once:
    // it only has to compile them, so no stage-one compiler is built first.
    seed := Join([root, "/tools/compiler/bootstrap/compiler.chibip"]);
    closure_entry := "0x140a9546d9e8c296"; // package_compiler.CompileClosure
    cache := Join([root, "/.chibi/asset-compiler-cache"]);
    os.Print("asset compiler: serialize facade request");
    facade_request := Request("asset_compiler/Compile.chibi", paths, sources, native_target, true);
    facade_key := Key(seed, facade_request);
    kept := [facade_key];
    os.Print(format_text("asset compiler: invoke facade compiler at {} ({} sources, {} bytes)", Stamp(), length(paths),
                         strings.ByteLength(facade_request)));
    if (!Product(host, seed, closure_entry, facade_request, facade_key, facade, cache, compiler_timeout, inputs)) {
        return false;
    }
    os.Print(format_text("asset compiler: facade ready at {}", Stamp()));
    if (target == native_target) {
        if (os.Copy(facade, artifact)) {
            return false;
        }
    } else {
        os.Print("asset compiler: serialize target request");
        target_request := Request("asset_compiler/Compile.chibi", paths, sources, target, true);
        target_key := Key(seed, target_request);
        kept.append(target_key);
        os.Print("asset compiler: invoke target compiler");
        if (!Product(host, seed, closure_entry, target_request, target_key, artifact, cache, compiler_timeout, inputs)) {
            return false;
        }
    }
    if (os.IsDirectory(cache)) {
        Prune(cache, kept);
    }
    // Keep the complete public library snapshot separate from compiler inputs.
    // Retain original compiled source bytes so the final hash check still
    // rejects a file changed during generation.
    for (relative in Sources(Join([root, "/packages/core"]))) {
        path := Join(["/sdk/core/", relative]);
        found := false;
        for (item in paths) {
            if (item == path) {
                found = true;
            }
        }
        if (!found) {
            captured := Read(root, [path]);
            paths.append(path);
            sources.append(captured[0]);
        }
    }
    library_paths: string[] = [];
    library_sources: string[] = [];
    index: int = 0;
    while (index < length(paths)) {
        if (strings.HasPrefix(paths[index], "/sdk/core/") || strings.HasPrefix(paths[index], "/sdk/game/")) {
            library_paths.append(paths[index]);
            library_sources.append(sources[index]);
        }
        index += 1;
    }
    os.Print("asset compiler: serialize packaging request");
    if (os.WriteText(inputs, Join(["[", Array(library_paths), ",", Array(library_sources), "]"]))) {
        return false;
    }
    // The same stable package-symbol hash used by all prepared entry IDs.
    id := u64(14695981039346656037);
    for (value in strings.Bytes("package-symbol:project:asset_compiler:1:Packaged:callable")) {
        id = (id ^ u64(value)) * u64(1099511628211);
    }
    os.Print(format_text("asset compiler: invoke packaging at {}", Stamp()));
    if (!Invoke(host, facade, format_text("0x{:016x}", id), inputs, Join([folder, "/asset_compiler_packaged.c.tmp"]), compiler_timeout) ||
        os.Rename(Join([folder, "/asset_compiler_packaged.c.tmp"]), Join([folder, "/asset_compiler_packaged.c"]))) {
        return false;
    }
    os.Print(format_text("asset compiler: packaging ready at {}", Stamp()));
    index = 0;
    while (index < length(paths)) {
        path := paths[index];
        disk := Join(["tools/compiler/", path]);
        if (strings.HasPrefix(path, "/sdk/")) {
            disk = Join(["packages/", strings.Slice(path, 5, strings.ByteLength(path))]);
        }
        stamps.append(Join([build.hash_text(sources[index]), " ", disk, "\n"]));
        records.append(Join(["{\"path\":", Quote(disk), ",\"sha256\":", Quote(build.hash_text(sources[index])), "}"]));
        index += 1;
    }
    manifest := Join(["{\"format\":1,\"artifact\":\"asset_compiler.chibip\",\"artifact_sha256\":",
                      Quote(build.hash_file(artifact)), ",\"resource_sha256\":",
                      Quote(build.hash_file(Join([folder, "/asset_compiler_packaged.c"]))),
                      ",\"target\":", target, ",\"sources\":[", strings.Join(records, ","), "]}\n"]);
    for (stamp in stamps) {
        checksum := build.before(stamp, " ");
        path := build.trim(build.after(stamp, " "));
        if (build.hash_file(Join([root, "/", path])) != checksum) {
            os.Print(Join(["asset compiler source changed during generation: ", path]));
            return false;
        }
    }
    if (Inventory(root) != inventory) {
        os.Print("asset compiler source inventory changed during generation");
        return false;
    }
    if (os.WriteText(Join([folder, "/inventory.txt"]), inventory) ||
        os.WriteText(Join([folder, "/inventory-directories.txt"]), Join([strings.Join(InventoryDirectories(), "\n"), "\n"])) ||
        os.WriteText(Join([folder, "/sources.sha256"]), Join(stamps)) ||
        os.WriteText(Join([folder, "/manifest.json"]), manifest) ||
        os.WriteText(Join([folder, "/target.json"]), target)) {
        return false;
    }
    os.Print("asset compiler: embed artifact");
    blob := Join([folder, "/asset_compiler_blob.inc"]);
    build.embed_file(artifact, blob, "asset_compiler_blob");
    if (!os.Exists(blob)) {
        return false;
    }
    if (os.Remove(inputs) || os.Remove(facade) || os.Remove(native_facts)) {
        return false;
    }
    os.Print("asset compiler: generation complete");
    return true;
}
