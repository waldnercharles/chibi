-        canonical == &EXECUTION_union_test_call ||
-        canonical == &EXECUTION_union_get_call || canonical == &EXECUTION_snapshot_call ||
-        canonical == &EXECUTION_value_copy_call ||
-        canonical == &EXECUTION_value_drop_call) {
