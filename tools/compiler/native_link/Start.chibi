package native_link

import strings "core:strings"

// The start modules: the LLVM IR of the shim that starts a native program,
// calls its entry `chibi_scalar() -> i32` (`chibi_scalar(ptr)` with a runtime
// context when `context` is set) and makes the result the exit status. Link it
// as one more object beside the program's own.
//
// The shim keeps the process arguments where core:os reads them: `@chibi_argc`
// (i32) and `@chibi_argv` (ptr to the argument strings) on Linux and macOS, and
// on Windows `@chibi_command_line`, the UTF-16 string GetCommandLineW gives.
// They are set before the entry runs.
//
// A context's allocate is libc's calloc (HeapAlloc on Windows) and its release
// libc's free (HeapFree on Windows); its index
// failure aborts; formatting text is not available to a program. A failed
// assert ends the entry early with its failure in the context, which the shim
// reports on stderr before it exits with status 134.

WindowsPrelude :: () -> string {
    return Join([
        "target triple = \"x86_64-pc-windows-msvc\"\n",
        "module asm \".text\"\n",
        "module asm \".globl __chkstk\"\n",
        "module asm \"__chkstk:\"\n",
        "module asm \"pushq %rcx\"\n",
        "module asm \"pushq %rax\"\n",
        "module asm \"cmpq $0x1000, %rax\"\n",
        "module asm \"leaq 24(%rsp), %rcx\"\n",
        "module asm \"jb 1f\"\n",
        "module asm \"2:\"\n",
        "module asm \"subq $0x1000, %rcx\"\n",
        "module asm \"testq %rcx, (%rcx)\"\n",
        "module asm \"subq $0x1000, %rax\"\n",
        "module asm \"cmpq $0x1000, %rax\"\n",
        "module asm \"ja 2b\"\n",
        "module asm \"1:\"\n",
        "module asm \"subq %rax, %rcx\"\n",
        "module asm \"testq %rcx, (%rcx)\"\n",
        "module asm \"popq %rax\"\n",
        "module asm \"popq %rcx\"\n",
        "module asm \"retq\"\n",
        "@_fltused = dso_local global i32 0\n",
        "declare dllimport void @ExitProcess(i32) noreturn\n",
        "declare dllimport ptr @GetCommandLineW()\n",
        "@chibi_command_line = dso_local global ptr null\n"
    ]);
}

// The runtime context's format_text for a program with no VM to call, as the
// VM formats: each `{}` of the format, the first value, is replaced by the next
// value (decimal text for an integer, signed by its tag; `true` or `false` for
// a bool; a string's bytes), or by nothing when no value is left; `{{` and
// `}}` are one brace; any other brace stays. Floats are not formatted yet and
// trap. The result is made once, in memory chibi_allocate gives, sized from
// the format and the values. Written as a byte copy loop so a program that
// links nothing needs no memcpy.
RuntimeFormat :: () -> string {
    return Join([
        "@chibi_true = private unnamed_addr constant [4 x i8] c\"true\"\n",
        "@chibi_false = private unnamed_addr constant [5 x i8] c\"false\"\n",
        "declare void @llvm.trap()\n",
        "define internal void @chibi_copy(ptr %to, ptr %from, i32 %count) {\n",
        "entry:\n",
        "  br label %loop\n",
        "loop:\n",
        "  %at = phi i32 [ 0, %entry ], [ %next, %body ]\n",
        "  %more = icmp slt i32 %at, %count\n",
        "  br i1 %more, label %body, label %done\n",
        "body:\n",
        "  %source = getelementptr inbounds i8, ptr %from, i32 %at\n",
        "  %byte = load i8, ptr %source\n",
        "  %target = getelementptr inbounds i8, ptr %to, i32 %at\n",
        "  store i8 %byte, ptr %target\n",
        "  %next = add i32 %at, 1\n",
        "  br label %loop\n",
        "done:\n",
        "  ret void\n",
        "}\n",
        "define internal void @chibi_format_text(ptr %ctx, ptr %values, i32 %count, ptr %result) {\n",
        "entry:\n",
        "  %i.slot = alloca i32\n",
        "  %o.slot = alloca i32\n",
        "  %a.slot = alloca i32\n",
        "  %digits = alloca [20 x i8]\n",
        "  store i32 0, ptr %i.slot\n",
        "  store i32 0, ptr %o.slot\n",
        "  store i32 1, ptr %a.slot\n",
        "  %fmt.length.at = getelementptr inbounds { i32, i32, i64, ptr }, ptr %values, i32 0, i32 1\n",
        "  %fmt.length = load i32, ptr %fmt.length.at\n",
        "  %fmt.bytes.at = getelementptr inbounds { i32, i32, i64, ptr }, ptr %values, i32 0, i32 3\n",
        "  %fmt = load ptr, ptr %fmt.bytes.at\n",
        "  %fmt.wide = zext i32 %fmt.length to i64\n",
        "  br label %size\n",
        "size:\n",
        "  %k = phi i32 [ 1, %entry ], [ %k.next, %size.arg ]\n",
        "  %bound = phi i64 [ %fmt.wide, %entry ], [ %bound.next, %size.arg ]\n",
        "  %counting = icmp slt i32 %k, %count\n",
        "  br i1 %counting, label %size.arg, label %alloc\n",
        "size.arg:\n",
        "  %value = getelementptr inbounds { i32, i32, i64, ptr }, ptr %values, i32 %k\n",
        "  %tag.at = getelementptr inbounds { i32, i32, i64, ptr }, ptr %value, i32 0, i32 0\n",
        "  %tag = load i32, ptr %tag.at\n",
        "  %length.at = getelementptr inbounds { i32, i32, i64, ptr }, ptr %value, i32 0, i32 1\n",
        "  %length = load i32, ptr %length.at\n",
        "  %length.wide = zext i32 %length to i64\n",
        "  %is.text = icmp eq i32 %tag, 12\n",
        "  %extra = select i1 %is.text, i64 %length.wide, i64 24\n",
        "  %bound.next = add i64 %bound, %extra\n",
        "  %k.next = add i32 %k, 1\n",
        "  br label %size\n",
        "alloc:\n",
        "  %total = add i64 %bound, 1\n",
        "  %buffer = call ptr @chibi_allocate(ptr %ctx, i64 %total)\n",
        "  br label %walk\n",
        "walk:\n",
        "  %i = load i32, ptr %i.slot\n",
        "  %ended = icmp sge i32 %i, %fmt.length\n",
        "  br i1 %ended, label %finish, label %step\n",
        "step:\n",
        "  %c.at = getelementptr inbounds i8, ptr %fmt, i32 %i\n",
        "  %c = load i8, ptr %c.at\n",
        "  %after = add i32 %i, 1\n",
        "  %has.after = icmp slt i32 %after, %fmt.length\n",
        "  br i1 %has.after, label %peek, label %literal\n",
        "peek:\n",
        "  %n.at = getelementptr inbounds i8, ptr %fmt, i32 %after\n",
        "  %n = load i8, ptr %n.at\n",
        "  %c.open = icmp eq i8 %c, 123\n",
        "  %c.close = icmp eq i8 %c, 125\n",
        "  %n.open = icmp eq i8 %n, 123\n",
        "  %n.close = icmp eq i8 %n, 125\n",
        "  %open.open = and i1 %c.open, %n.open\n",
        "  %open.close = and i1 %c.open, %n.close\n",
        "  %close.close = and i1 %c.close, %n.close\n",
        "  %escaped = or i1 %open.open, %close.close\n",
        "  br i1 %escaped, label %escape, label %hole.check\n",
        "hole.check:\n",
        "  br i1 %open.close, label %hole, label %literal\n",
        "escape:\n",
        "  %oe = load i32, ptr %o.slot\n",
        "  %te = getelementptr inbounds i8, ptr %buffer, i32 %oe\n",
        "  store i8 %c, ptr %te\n",
        "  %oe.one = add i32 %oe, 1\n",
        "  store i32 %oe.one, ptr %o.slot\n",
        "  %skip.escape = add i32 %i, 2\n",
        "  store i32 %skip.escape, ptr %i.slot\n",
        "  br label %walk\n",
        "hole:\n",
        "  %a = load i32, ptr %a.slot\n",
        "  %have = icmp slt i32 %a, %count\n",
        "  br i1 %have, label %argument, label %unfilled\n",
        "unfilled:\n",
        "  %skip.hole = add i32 %i, 2\n",
        "  store i32 %skip.hole, ptr %i.slot\n",
        "  br label %walk\n",
        "literal:\n",
        "  %o = load i32, ptr %o.slot\n",
        "  %to = getelementptr inbounds i8, ptr %buffer, i32 %o\n",
        "  store i8 %c, ptr %to\n",
        "  %o.one = add i32 %o, 1\n",
        "  store i32 %o.one, ptr %o.slot\n",
        "  store i32 %after, ptr %i.slot\n",
        "  br label %walk\n",
        "argument:\n",
        "  %arg = getelementptr inbounds { i32, i32, i64, ptr }, ptr %values, i32 %a\n",
        "  %arg.tag.at = getelementptr inbounds { i32, i32, i64, ptr }, ptr %arg, i32 0, i32 0\n",
        "  %arg.tag = load i32, ptr %arg.tag.at\n",
        "  %arg.length.at = getelementptr inbounds { i32, i32, i64, ptr }, ptr %arg, i32 0, i32 1\n",
        "  %arg.length = load i32, ptr %arg.length.at\n",
        "  %arg.word.at = getelementptr inbounds { i32, i32, i64, ptr }, ptr %arg, i32 0, i32 2\n",
        "  %arg.word = load i64, ptr %arg.word.at\n",
        "  %arg.bytes.at = getelementptr inbounds { i32, i32, i64, ptr }, ptr %arg, i32 0, i32 3\n",
        "  %arg.bytes = load ptr, ptr %arg.bytes.at\n",
        "  %a.next = add i32 %a, 1\n",
        "  store i32 %a.next, ptr %a.slot\n",
        "  %skip = add i32 %i, 2\n",
        "  store i32 %skip, ptr %i.slot\n",
        "  %o.arg = load i32, ptr %o.slot\n",
        "  %out = getelementptr inbounds i8, ptr %buffer, i32 %o.arg\n",
        "  %text.arg = icmp eq i32 %arg.tag, 12\n",
        "  br i1 %text.arg, label %text, label %scalar\n",
        "text:\n",
        "  call void @chibi_copy(ptr %out, ptr %arg.bytes, i32 %arg.length)\n",
        "  %o.text = add i32 %o.arg, %arg.length\n",
        "  store i32 %o.text, ptr %o.slot\n",
        "  br label %walk\n",
        "scalar:\n",
        "  %is.bool = icmp eq i32 %arg.tag, 2\n",
        "  br i1 %is.bool, label %boolean, label %number\n",
        "boolean:\n",
        "  %truth = icmp ne i64 %arg.word, 0\n",
        "  %word.ptr = select i1 %truth, ptr @chibi_true, ptr @chibi_false\n",
        "  %word.len = select i1 %truth, i32 4, i32 5\n",
        "  call void @chibi_copy(ptr %out, ptr %word.ptr, i32 %word.len)\n",
        "  %o.bool = add i32 %o.arg, %word.len\n",
        "  store i32 %o.bool, ptr %o.slot\n",
        "  br label %walk\n",
        "number:\n",
        "  %float.a = icmp eq i32 %arg.tag, 10\n",
        "  %float.b = icmp eq i32 %arg.tag, 11\n",
        "  %floating = or i1 %float.a, %float.b\n",
        "  br i1 %floating, label %trap, label %decimal\n",
        "trap:\n",
        "  call void @llvm.trap()\n",
        "  unreachable\n",
        "decimal:\n",
        "  %s1 = icmp eq i32 %arg.tag, 1\n",
        "  %s3 = icmp eq i32 %arg.tag, 3\n",
        "  %s5 = icmp eq i32 %arg.tag, 5\n",
        "  %s8 = icmp eq i32 %arg.tag, 8\n",
        "  %s13 = or i1 %s1, %s3\n",
        "  %s58 = or i1 %s5, %s8\n",
        "  %signed = or i1 %s13, %s58\n",
        "  %below = icmp slt i64 %arg.word, 0\n",
        "  %negative = and i1 %signed, %below\n",
        "  %flipped = sub i64 0, %arg.word\n",
        "  %magnitude = select i1 %negative, i64 %flipped, i64 %arg.word\n",
        "  br label %emit\n",
        "emit:\n",
        "  %rest = phi i64 [ %magnitude, %decimal ], [ %rest.next, %emit ]\n",
        "  %at.now = phi i32 [ 20, %decimal ], [ %at.back, %emit ]\n",
        "  %digit = urem i64 %rest, 10\n",
        "  %char = add i64 %digit, 48\n",
        "  %digit.byte = trunc i64 %char to i8\n",
        "  %at.back = sub i32 %at.now, 1\n",
        "  %slot = getelementptr inbounds [20 x i8], ptr %digits, i32 0, i32 %at.back\n",
        "  store i8 %digit.byte, ptr %slot\n",
        "  %rest.next = udiv i64 %rest, 10\n",
        "  %again = icmp ne i64 %rest.next, 0\n",
        "  br i1 %again, label %emit, label %placed\n",
        "placed:\n",
        "  %width = sub i32 20, %at.back\n",
        "  br i1 %negative, label %minus, label %plain\n",
        "minus:\n",
        "  store i8 45, ptr %out\n",
        "  %out.one = getelementptr inbounds i8, ptr %out, i32 1\n",
        "  br label %plain\n",
        "plain:\n",
        "  %dest = phi ptr [ %out, %placed ], [ %out.one, %minus ]\n",
        "  %sign.width = phi i32 [ 0, %placed ], [ 1, %minus ]\n",
        "  %first = getelementptr inbounds [20 x i8], ptr %digits, i32 0, i32 %at.back\n",
        "  call void @chibi_copy(ptr %dest, ptr %first, i32 %width)\n",
        "  %o.sum = add i32 %o.arg, %width\n",
        "  %o.signed = add i32 %o.sum, %sign.width\n",
        "  store i32 %o.signed, ptr %o.slot\n",
        "  br label %walk\n",
        "finish:\n",
        "  %o.final = load i32, ptr %o.slot\n",
        "  %r.bytes = getelementptr inbounds { ptr, i32, ptr }, ptr %result, i32 0, i32 0\n",
        "  store ptr %buffer, ptr %r.bytes\n",
        "  %r.length = getelementptr inbounds { ptr, i32, ptr }, ptr %result, i32 0, i32 1\n",
        "  store i32 %o.final, ptr %r.length\n",
        "  %r.owner = getelementptr inbounds { ptr, i32, ptr }, ptr %result, i32 0, i32 2\n",
        "  store ptr null, ptr %r.owner\n",
        "  ret void\n",
        "}\n"
    ]);
}

WindowsStart :: () -> string {
    return Join([
        WindowsPrelude(),
        "declare i32 @chibi_scalar()\n",
        "define void @mainCRTStartup() {\n",
        "  %line = call ptr @GetCommandLineW()\n",
        "  store ptr %line, ptr @chibi_command_line\n",
        "  %status = call i32 @chibi_scalar()\n",
        "  call void @ExitProcess(i32 %status)\n",
        "  unreachable\n",
        "}\n"
    ]);
}

WindowsContextStart :: () -> string {
    return Join([
        WindowsPrelude(),
        "declare dllimport ptr @GetProcessHeap()\n",
        "declare dllimport ptr @HeapAlloc(ptr, i32, i64)\n",
        "declare dllimport i32 @HeapFree(ptr, i32, ptr)\n",
        "declare dllimport ptr @GetStdHandle(i32)\n",
        "declare dllimport i32 @WriteFile(ptr, ptr, i32, ptr, ptr)\n",
        "declare i32 @chibi_scalar(ptr)\n",
        "@chibi_report_head = private unnamed_addr constant [29 x i8] c\"assertion failed in function \"\n",
        "@chibi_report_from = private unnamed_addr constant [17 x i8] c\" at source bytes \"\n",
        "@chibi_report_to = private unnamed_addr constant [4 x i8] c\" to \"\n",
        "@chibi_report_end = private unnamed_addr constant [1 x i8] c\"\\0A\"\n",
        RuntimeFormat(),
        "define internal ptr @chibi_allocate(ptr %ctx, i64 %size) {\n",
        "  %heap = call ptr @GetProcessHeap()\n",
        "  %memory = call ptr @HeapAlloc(ptr %heap, i32 8, i64 %size)\n",
        "  ret ptr %memory\n",
        "}\n",
        "define internal void @chibi_release(ptr %ctx, ptr %allocation) {\n",
        "  %heap = call ptr @GetProcessHeap()\n",
        "  %freed = call i32 @HeapFree(ptr %heap, i32 0, ptr %allocation)\n",
        "  ret void\n",
        "}\n",
        "define internal void @chibi_index_failed(ptr %ctx, i32 %index, i32 %length) {\n",
        "  call void @ExitProcess(i32 134)\n",
        "  unreachable\n",
        "}\n",
        "define internal void @chibi_write(ptr %bytes, i32 %count) {\n",
        "  %error = call ptr @GetStdHandle(i32 -12)\n",
        "  %written = alloca i32\n",
        "  %ignored = call i32 @WriteFile(ptr %error, ptr %bytes, i32 %count, ptr %written, ptr null)\n",
        "  ret void\n",
        "}\n",
        "define internal void @chibi_write_decimal(i64 %value) {\n",
        "entry:\n",
        "  %buffer = alloca [20 x i8]\n",
        "  br label %loop\n",
        "loop:\n",
        "  %rest = phi i64 [ %value, %entry ], [ %next, %loop ]\n",
        "  %at = phi i32 [ 20, %entry ], [ %back, %loop ]\n",
        "  %digit = urem i64 %rest, 10\n",
        "  %character = add i64 %digit, 48\n",
        "  %byte = trunc i64 %character to i8\n",
        "  %back = sub i32 %at, 1\n",
        "  %slot = getelementptr inbounds [20 x i8], ptr %buffer, i32 0, i32 %back\n",
        "  store i8 %byte, ptr %slot\n",
        "  %next = udiv i64 %rest, 10\n",
        "  %more = icmp ne i64 %next, 0\n",
        "  br i1 %more, label %loop, label %done\n",
        "done:\n",
        "  %first = getelementptr inbounds [20 x i8], ptr %buffer, i32 0, i32 %back\n",
        "  %count = sub i32 20, %back\n",
        "  call void @chibi_write(ptr %first, i32 %count)\n",
        "  ret void\n",
        "}\n",
        "@chibi_context = global { ptr, ptr, ptr, ptr, ptr } ",
        "{ ptr @chibi_format_text, ptr null, ptr @chibi_allocate, ptr @chibi_index_failed, ptr @chibi_release }\n",
        "define void @mainCRTStartup() {\n",
        "  %line = call ptr @GetCommandLineW()\n",
        "  store ptr %line, ptr @chibi_command_line\n",
        "  %status = call i32 @chibi_scalar(ptr @chibi_context)\n",
        "  %failure.at = getelementptr inbounds { ptr, ptr, ptr, ptr, ptr }, ptr @chibi_context, i32 0, i32 1\n",
        "  %failure = load ptr, ptr %failure.at\n",
        "  %failed = icmp ne ptr %failure, null\n",
        "  br i1 %failed, label %report, label %done\n",
        "report:\n",
        "  %function = load i64, ptr %failure\n",
        "  %start.at = getelementptr inbounds { i64, i32, i32 }, ptr %failure, i32 0, i32 1\n",
        "  %start = load i32, ptr %start.at\n",
        "  %end.at = getelementptr inbounds { i64, i32, i32 }, ptr %failure, i32 0, i32 2\n",
        "  %end = load i32, ptr %end.at\n",
        "  %start.wide = zext i32 %start to i64\n",
        "  %end.wide = zext i32 %end to i64\n",
        "  call void @chibi_write(ptr @chibi_report_head, i32 29)\n",
        "  call void @chibi_write_decimal(i64 %function)\n",
        "  call void @chibi_write(ptr @chibi_report_from, i32 17)\n",
        "  call void @chibi_write_decimal(i64 %start.wide)\n",
        "  call void @chibi_write(ptr @chibi_report_to, i32 4)\n",
        "  call void @chibi_write_decimal(i64 %end.wide)\n",
        "  call void @chibi_write(ptr @chibi_report_end, i32 1)\n",
        "  call void @ExitProcess(i32 134)\n",
        "  unreachable\n",
        "done:\n",
        "  call void @ExitProcess(i32 %status)\n",
        "  unreachable\n",
        "}\n"
    ]);
}

LinuxStart :: () -> string {
    return Join([
        "target triple = \"x86_64-unknown-linux-gnu\"\n",
        "module asm \".text\"\n",
        "module asm \".globl _start\"\n",
        "module asm \".type _start, @function\"\n",
        "module asm \"_start:\"\n",
        "module asm \"xorl %ebp, %ebp\"\n",
        "module asm \"movq (%rsp), %rax\"\n",
        "module asm \"movl %eax, chibi_argc(%rip)\"\n",
        "module asm \"leaq 8(%rsp), %rax\"\n",
        "module asm \"movq %rax, chibi_argv(%rip)\"\n",
        "module asm \"movq (%rsp), %rax\"\n",
        "module asm \"leaq 16(%rsp,%rax,8), %rax\"\n",
        "module asm \"movq %rax, chibi_envp(%rip)\"\n",
        "module asm \"andq $-16, %rsp\"\n",
        "module asm \"callq chibi_scalar\"\n",
        "module asm \"movl %eax, %edi\"\n",
        "module asm \"movl $231, %eax\"\n",
        "module asm \"syscall\"\n",
        "module asm \"ud2\"\n",
        "@chibi_argc = dso_local global i32 0\n",
        "@chibi_argv = dso_local global ptr null\n",
        "declare i32 @chibi_scalar()\n"
    ]);
}

DynamicStart :: (triple: string, context: bool) -> string {
    if (!context) {
        return Join([
            "target triple = \"", triple, "\"\n",
            "declare i32 @chibi_scalar()\n",
            "@chibi_argc = dso_local global i32 0\n",
            "@chibi_argv = dso_local global ptr null\n",
            "define i32 @main(i32 %argc, ptr %argv, ptr %envp) {\n",
            "  store i32 %argc, ptr @chibi_argc\n",
            "  store ptr %argv, ptr @chibi_argv\n",
            "  store ptr %envp, ptr @chibi_envp\n",
            "  %status = call i32 @chibi_scalar()\n",
            "  ret i32 %status\n",
            "}\n"
        ]);
    }
    return Join([
        "target triple = \"", triple, "\"\n",
        "declare ptr @calloc(i64, i64)\n",
        "declare void @free(ptr)\n",
        "declare void @abort() noreturn\n",
        "declare i32 @dprintf(i32, ptr, ...)\n",
        "@chibi_report = private unnamed_addr constant [59 x i8] ",
        "c\"assertion failed in function %lu at source bytes %d to %d\\0A\\00\"\n",
        "declare i32 @chibi_scalar(ptr)\n",
        RuntimeFormat(),
        "define internal ptr @chibi_allocate(ptr %ctx, i64 %size) {\n",
        "  %memory = call ptr @calloc(i64 1, i64 %size)\n",
        "  ret ptr %memory\n",
        "}\n",
        "define internal void @chibi_release(ptr %ctx, ptr %allocation) {\n",
        "  call void @free(ptr %allocation)\n",
        "  ret void\n",
        "}\n",
        "define internal void @chibi_index_failed(ptr %ctx, i32 %index, i32 %length) {\n",
        "  call void @abort()\n",
        "  unreachable\n",
        "}\n",
        "@chibi_context = global { ptr, ptr, ptr, ptr, ptr } ",
        "{ ptr @chibi_format_text, ptr null, ptr @chibi_allocate, ptr @chibi_index_failed, ptr @chibi_release }\n",
        "@chibi_argc = dso_local global i32 0\n",
        "@chibi_argv = dso_local global ptr null\n",
        "define i32 @main(i32 %argc, ptr %argv, ptr %envp) {\n",
        "  store i32 %argc, ptr @chibi_argc\n",
        "  store ptr %argv, ptr @chibi_argv\n",
            "  store ptr %envp, ptr @chibi_envp\n",
        "  %status = call i32 @chibi_scalar(ptr @chibi_context)\n",
        "  %failure.at = getelementptr inbounds { ptr, ptr, ptr, ptr, ptr }, ptr @chibi_context, i32 0, i32 1\n",
        "  %failure = load ptr, ptr %failure.at\n",
        "  %failed = icmp ne ptr %failure, null\n",
        "  br i1 %failed, label %report, label %done\n",
        "report:\n",
        "  %function = load i64, ptr %failure\n",
        "  %start.at = getelementptr inbounds { i64, i32, i32 }, ptr %failure, i32 0, i32 1\n",
        "  %start = load i32, ptr %start.at\n",
        "  %end.at = getelementptr inbounds { i64, i32, i32 }, ptr %failure, i32 0, i32 2\n",
        "  %end = load i32, ptr %end.at\n",
        "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @chibi_report, i64 %function, i32 %start, i32 %end)\n",
        "  ret i32 134\n",
        "done:\n",
        "  ret i32 %status\n",
        "}\n"
    ]);
}

// The start module for the triple. A static Linux program has no C library, so
// it takes no context: "" for that combination and for a triple this link step
// does not know.
Module :: (triple: string, static: bool, context: bool) -> string {
    target := TargetOf(triple);
    if (target == WindowsX64 && context) {
        return WindowsContextStart();
    }
    if (target == WindowsX64) {
        return WindowsStart();
    }
    if (target == LinuxX64 && static && context) {
        return "";
    }
    if (target == LinuxX64 && static) {
        return LinuxStart();
    }
    if (target < 0) {
        return "";
    }
    return DynamicStart(triple, context);
}

// The process arguments as C-ABI functions, appended to every start module:
// chibi_argument_count() -> i64; chibi_argument(index, buffer, size) -> i64 copies up to
// `size` bytes of argument `index` (no NUL) and returns its whole length, -1 for an
// index out of range; chibi_environment() -> ptr is the environment block (the envp
// array; null on Windows, which reads it through the system).
PosixArguments :: () -> string {
    return Join([
        "@chibi_envp = dso_local global ptr null\n",
        "define i64 @chibi_argument_count() {\n",
        "  %n = load i32, ptr @chibi_argc\n",
        "  %w = sext i32 %n to i64\n",
        "  ret i64 %w\n",
        "}\n",
        "define ptr @chibi_process_argv() {\n",
        "  %a = load ptr, ptr @chibi_argv\n  ret ptr %a\n}\n",
        "define ptr @chibi_environment() {\n",
        "  %e = load ptr, ptr @chibi_envp\n",
        "  ret ptr %e\n",
        "}\n",
        "define i64 @chibi_argument(i64 %index, ptr %buffer, i64 %size) {\n",
        "entry:\n",
        "  %count32 = load i32, ptr @chibi_argc\n",
        "  %count = sext i32 %count32 to i64\n",
        "  %below = icmp slt i64 %index, 0\n",
        "  %above = icmp sge i64 %index, %count\n",
        "  %bad = or i1 %below, %above\n",
        "  br i1 %bad, label %missing, label %found\n",
        "missing:\n",
        "  ret i64 -1\n",
        "found:\n",
        "  %argv = load ptr, ptr @chibi_argv\n",
        "  %slot = getelementptr inbounds ptr, ptr %argv, i64 %index\n",
        "  %text = load ptr, ptr %slot\n",
        "  br label %measure\n",
        "measure:\n",
        "  %length = phi i64 [ 0, %found ], [ %next, %measure ]\n",
        "  %at = getelementptr inbounds i8, ptr %text, i64 %length\n",
        "  %byte = load i8, ptr %at\n",
        "  %end = icmp eq i8 %byte, 0\n",
        "  %next = add i64 %length, 1\n",
        "  br i1 %end, label %copy, label %measure\n",
        "copy:\n",
        "  %limit = icmp ult i64 %length, %size\n",
        "  %bytes = select i1 %limit, i64 %length, i64 %size\n",
        "  br label %loop\n",
        "loop:\n",
        "  %i = phi i64 [ 0, %copy ], [ %step, %body ]\n",
        "  %done = icmp uge i64 %i, %bytes\n",
        "  br i1 %done, label %finish, label %body\n",
        "body:\n",
        "  %from = getelementptr inbounds i8, ptr %text, i64 %i\n",
        "  %b = load i8, ptr %from\n",
        "  %to = getelementptr inbounds i8, ptr %buffer, i64 %i\n",
        "  store i8 %b, ptr %to\n",
        "  %step = add i64 %i, 1\n",
        "  br label %loop\n",
        "finish:\n",
        "  ret i64 %length\n",
        "}\n"
    ]);
}

// Windows: the same functions over the UTF-16 command line, split by the C
// runtime's rules (the program name ends at the first quote or white space; a quote
// toggles quoting; 2n backslashes before a quote are n, an odd one makes the quote
// literal) and encoded as UTF-8.
// The LLVM IR that splits a UTF-16 command line into arguments and encodes them as
// UTF-8: chibi_command_argument(line, index, buffer, size) -> i64 and
// chibi_command_count(line) -> i64. It touches no system function, so test/native_aot/link
// runs it on any host.
pub CommandLineParser :: () -> string {
    return Join([
        "define internal i64 @chibi_utf8(i32 %cp, ptr %out) {\n",
        "entry:\n",
        "  %one = icmp ult i32 %cp, 128\n",
        "  br i1 %one, label %one.byte, label %not.one\n",
        "one.byte:\n",
        "  %b0 = trunc i32 %cp to i8\n",
        "  store i8 %b0, ptr %out\n",
        "  ret i64 1\n",
        "not.one:\n",
        "  %two = icmp ult i32 %cp, 2048\n",
        "  br i1 %two, label %two.bytes, label %not.two\n",
        "two.bytes:\n",
        "  %t0 = lshr i32 %cp, 6\n",
        "  %t0o = or i32 %t0, 192\n",
        "  %t0b = trunc i32 %t0o to i8\n",
        "  store i8 %t0b, ptr %out\n",
        "  %t1 = and i32 %cp, 63\n",
        "  %t1o = or i32 %t1, 128\n",
        "  %t1b = trunc i32 %t1o to i8\n",
        "  %t1p = getelementptr inbounds i8, ptr %out, i64 1\n",
        "  store i8 %t1b, ptr %t1p\n",
        "  ret i64 2\n",
        "not.two:\n",
        "  %three = icmp ult i32 %cp, 65536\n",
        "  br i1 %three, label %three.bytes, label %four.bytes\n",
        "three.bytes:\n",
        "  %h0 = lshr i32 %cp, 12\n",
        "  %h0o = or i32 %h0, 224\n",
        "  %h0b = trunc i32 %h0o to i8\n",
        "  store i8 %h0b, ptr %out\n",
        "  %h1 = lshr i32 %cp, 6\n",
        "  %h1m = and i32 %h1, 63\n",
        "  %h1o = or i32 %h1m, 128\n",
        "  %h1b = trunc i32 %h1o to i8\n",
        "  %h1p = getelementptr inbounds i8, ptr %out, i64 1\n",
        "  store i8 %h1b, ptr %h1p\n",
        "  %h2 = and i32 %cp, 63\n",
        "  %h2o = or i32 %h2, 128\n",
        "  %h2b = trunc i32 %h2o to i8\n",
        "  %h2p = getelementptr inbounds i8, ptr %out, i64 2\n",
        "  store i8 %h2b, ptr %h2p\n",
        "  ret i64 3\n",
        "four.bytes:\n",
        "  %f0 = lshr i32 %cp, 18\n",
        "  %f0o = or i32 %f0, 240\n",
        "  %f0b = trunc i32 %f0o to i8\n",
        "  store i8 %f0b, ptr %out\n",
        "  %f1 = lshr i32 %cp, 12\n",
        "  %f1m = and i32 %f1, 63\n",
        "  %f1o = or i32 %f1m, 128\n",
        "  %f1b = trunc i32 %f1o to i8\n",
        "  %f1p = getelementptr inbounds i8, ptr %out, i64 1\n",
        "  store i8 %f1b, ptr %f1p\n",
        "  %f2 = lshr i32 %cp, 6\n",
        "  %f2m = and i32 %f2, 63\n",
        "  %f2o = or i32 %f2m, 128\n",
        "  %f2b = trunc i32 %f2o to i8\n",
        "  %f2p = getelementptr inbounds i8, ptr %out, i64 2\n",
        "  store i8 %f2b, ptr %f2p\n",
        "  %f3 = and i32 %cp, 63\n",
        "  %f3o = or i32 %f3, 128\n",
        "  %f3b = trunc i32 %f3o to i8\n",
        "  %f3p = getelementptr inbounds i8, ptr %out, i64 3\n",
        "  store i8 %f3b, ptr %f3p\n",
        "  ret i64 4\n",
        "}\n",
        "define internal i64 @chibi_decode(ptr %line, i64 %p, ptr %cp) {\n",
        "entry:\n",
        "  %at = getelementptr inbounds i16, ptr %line, i64 %p\n",
        "  %unit16 = load i16, ptr %at\n",
        "  %u = zext i16 %unit16 to i32\n",
        "  %not.low = icmp ult i32 %u, 55296\n",
        "  %past = icmp ugt i32 %u, 57343\n",
        "  %plain = or i1 %not.low, %past\n",
        "  br i1 %plain, label %single, label %surrogate\n",
        "single:\n",
        "  store i32 %u, ptr %cp\n",
        "  ret i64 1\n",
        "surrogate:\n",
        "  %is.high = icmp ult i32 %u, 56320\n",
        "  br i1 %is.high, label %pair, label %lone\n",
        "pair:\n",
        "  %next = add i64 %p, 1\n",
        "  %nat = getelementptr inbounds i16, ptr %line, i64 %next\n",
        "  %low16 = load i16, ptr %nat\n",
        "  %low = zext i16 %low16 to i32\n",
        "  %low.lo = icmp uge i32 %low, 56320\n",
        "  %low.hi = icmp ule i32 %low, 57343\n",
        "  %is.low = and i1 %low.lo, %low.hi\n",
        "  br i1 %is.low, label %combine, label %lone\n",
        "combine:\n",
        "  %hi.bits = sub i32 %u, 55296\n",
        "  %hi.shift = shl i32 %hi.bits, 10\n",
        "  %lo.bits = sub i32 %low, 56320\n",
        "  %sum = add i32 %hi.shift, %lo.bits\n",
        "  %scalar = add i32 %sum, 65536\n",
        "  store i32 %scalar, ptr %cp\n",
        "  ret i64 2\n",
        "lone:\n",
        "  store i32 65533, ptr %cp\n",
        "  ret i64 1\n",
        "}\n",
        "define internal void @chibi_emit(i32 %cp, i1 %want, ptr %buffer, i64 %size, ptr %out) {\n",
        "entry:\n",
        "  br i1 %want, label %encode, label %skip\n",
        "skip:\n",
        "  ret void\n",
        "encode:\n",
        "  %scratch = alloca [4 x i8]\n",
        "  %count = call i64 @chibi_utf8(i32 %cp, ptr %scratch)\n",
        "  br label %loop\n",
        "loop:\n",
        "  %i = phi i64 [ 0, %encode ], [ %step, %next ]\n",
        "  %done = icmp uge i64 %i, %count\n",
        "  br i1 %done, label %finish, label %body\n",
        "body:\n",
        "  %at = load i64, ptr %out\n",
        "  %room = icmp ult i64 %at, %size\n",
        "  br i1 %room, label %store, label %next\n",
        "store:\n",
        "  %from = getelementptr inbounds i8, ptr %scratch, i64 %i\n",
        "  %b = load i8, ptr %from\n",
        "  %to = getelementptr inbounds i8, ptr %buffer, i64 %at\n",
        "  store i8 %b, ptr %to\n",
        "  br label %next\n",
        "next:\n",
        "  %at2 = load i64, ptr %out\n",
        "  %at3 = add i64 %at2, 1\n",
        "  store i64 %at3, ptr %out\n",
        "  %step = add i64 %i, 1\n",
        "  br label %loop\n",
        "finish:\n",
        "  ret void\n",
        "}\n",
        "define internal i64 @chibi_command_argument(ptr %line, i64 %index, ptr %buffer, i64 %size) {\n",
        "entry:\n",
        "  %p = alloca i64\n",
        "  %arg = alloca i64\n",
        "  %out = alloca i64\n",
        "  %cp = alloca i32\n",
        "  %quoted = alloca i1\n",
        "  %slashes = alloca i64\n",
        "  store i64 0, ptr %p\n",
        "  store i64 0, ptr %arg\n",
        "  store i64 0, ptr %out\n",
        "  %first = load i16, ptr %line\n",
        "  %opens = icmp eq i16 %first, 34\n",
        "  %name.want = icmp eq i64 %index, 0\n",
        "  br i1 %opens, label %name.quoted, label %name.plain\n",
        "name.quoted:\n",
        "  store i64 1, ptr %p\n",
        "  br label %name.quoted.loop\n",
        "name.quoted.loop:\n",
        "  %nq.p = load i64, ptr %p\n",
        "  %nq.at = getelementptr inbounds i16, ptr %line, i64 %nq.p\n",
        "  %nq.u = load i16, ptr %nq.at\n",
        "  %nq.end = icmp eq i16 %nq.u, 0\n",
        "  %nq.close = icmp eq i16 %nq.u, 34\n",
        "  %nq.stop = or i1 %nq.end, %nq.close\n",
        "  br i1 %nq.stop, label %name.quoted.end, label %name.quoted.take\n",
        "name.quoted.take:\n",
        "  %nq.used = call i64 @chibi_decode(ptr %line, i64 %nq.p, ptr %cp)\n",
        "  %nq.cp = load i32, ptr %cp\n",
        "  call void @chibi_emit(i32 %nq.cp, i1 %name.want, ptr %buffer, i64 %size, ptr %out)\n",
        "  %nq.next = add i64 %nq.p, %nq.used\n",
        "  store i64 %nq.next, ptr %p\n",
        "  br label %name.quoted.loop\n",
        "name.quoted.end:\n",
        "  br i1 %nq.close, label %name.quoted.skip, label %name.done\n",
        "name.quoted.skip:\n",
        "  %nq.after = add i64 %nq.p, 1\n",
        "  store i64 %nq.after, ptr %p\n",
        "  br label %name.done\n",
        "name.plain:\n",
        "  br label %name.plain.loop\n",
        "name.plain.loop:\n",
        "  %np.p = load i64, ptr %p\n",
        "  %np.at = getelementptr inbounds i16, ptr %line, i64 %np.p\n",
        "  %np.u = load i16, ptr %np.at\n",
        "  %np.end = icmp eq i16 %np.u, 0\n",
        "  %np.space = icmp eq i16 %np.u, 32\n",
        "  %np.tab = icmp eq i16 %np.u, 9\n",
        "  %np.white = or i1 %np.space, %np.tab\n",
        "  %np.stop = or i1 %np.end, %np.white\n",
        "  br i1 %np.stop, label %name.done, label %name.plain.take\n",
        "name.plain.take:\n",
        "  %np.used = call i64 @chibi_decode(ptr %line, i64 %np.p, ptr %cp)\n",
        "  %np.cp = load i32, ptr %cp\n",
        "  call void @chibi_emit(i32 %np.cp, i1 %name.want, ptr %buffer, i64 %size, ptr %out)\n",
        "  %np.next = add i64 %np.p, %np.used\n",
        "  store i64 %np.next, ptr %p\n",
        "  br label %name.plain.loop\n",
        "name.done:\n",
        "  br i1 %name.want, label %answer, label %arguments\n",
        "answer:\n",
        "  %name.length = load i64, ptr %out\n",
        "  ret i64 %name.length\n",
        "arguments:\n",
        "  br label %next.argument\n",
        "next.argument:\n",
        "  br label %skip.white\n",
        "skip.white:\n",
        "  %sw.p = load i64, ptr %p\n",
        "  %sw.at = getelementptr inbounds i16, ptr %line, i64 %sw.p\n",
        "  %sw.u = load i16, ptr %sw.at\n",
        "  %sw.space = icmp eq i16 %sw.u, 32\n",
        "  %sw.tab = icmp eq i16 %sw.u, 9\n",
        "  %sw.white = or i1 %sw.space, %sw.tab\n",
        "  br i1 %sw.white, label %skip.step, label %skip.done\n",
        "skip.step:\n",
        "  %sw.next = add i64 %sw.p, 1\n",
        "  store i64 %sw.next, ptr %p\n",
        "  br label %skip.white\n",
        "skip.done:\n",
        "  %sd.end = icmp eq i16 %sw.u, 0\n",
        "  br i1 %sd.end, label %missing, label %begin\n",
        "missing:\n",
        "  ret i64 -1\n",
        "begin:\n",
        "  %arg.old = load i64, ptr %arg\n",
        "  %arg.new = add i64 %arg.old, 1\n",
        "  store i64 %arg.new, ptr %arg\n",
        "  %want = icmp eq i64 %arg.new, %index\n",
        "  store i1 false, ptr %quoted\n",
        "  br label %scan\n",
        "scan:\n",
        "  store i64 0, ptr %slashes\n",
        "  br label %count\n",
        "count:\n",
        "  %c.p = load i64, ptr %p\n",
        "  %c.at = getelementptr inbounds i16, ptr %line, i64 %c.p\n",
        "  %c.u = load i16, ptr %c.at\n",
        "  %c.slash = icmp eq i16 %c.u, 92\n",
        "  br i1 %c.slash, label %count.step, label %counted\n",
        "count.step:\n",
        "  %c.n = load i64, ptr %slashes\n",
        "  %c.n1 = add i64 %c.n, 1\n",
        "  store i64 %c.n1, ptr %slashes\n",
        "  %c.next = add i64 %c.p, 1\n",
        "  store i64 %c.next, ptr %p\n",
        "  br label %count\n",
        "counted:\n",
        "  %n = load i64, ptr %slashes\n",
        "  %quote = icmp eq i16 %c.u, 34\n",
        "  br i1 %quote, label %before.quote, label %literal.slashes\n",
        "before.quote:\n",
        "  %half = lshr i64 %n, 1\n",
        "  br label %half.loop\n",
        "half.loop:\n",
        "  %hi = phi i64 [ 0, %before.quote ], [ %hi.next, %half.body ]\n",
        "  %hdone = icmp uge i64 %hi, %half\n",
        "  br i1 %hdone, label %half.done, label %half.body\n",
        "half.body:\n",
        "  call void @chibi_emit(i32 92, i1 %want, ptr %buffer, i64 %size, ptr %out)\n",
        "  %hi.next = add i64 %hi, 1\n",
        "  br label %half.loop\n",
        "half.done:\n",
        "  %odd.bit = and i64 %n, 1\n",
        "  %odd = icmp ne i64 %odd.bit, 0\n",
        "  %q.p = load i64, ptr %p\n",
        "  %q.next = add i64 %q.p, 1\n",
        "  store i64 %q.next, ptr %p\n",
        "  br i1 %odd, label %literal.quote, label %toggle.quote\n",
        "literal.quote:\n",
        "  call void @chibi_emit(i32 34, i1 %want, ptr %buffer, i64 %size, ptr %out)\n",
        "  br label %after.unit\n",
        "toggle.quote:\n",
        "  %was = load i1, ptr %quoted\n",
        "  %now = xor i1 %was, true\n",
        "  store i1 %now, ptr %quoted\n",
        "  br label %after.unit\n",
        "literal.slashes:\n",
        "  br label %slash.loop\n",
        "slash.loop:\n",
        "  %si = phi i64 [ 0, %literal.slashes ], [ %si.next, %slash.body ]\n",
        "  %sdone = icmp uge i64 %si, %n\n",
        "  br i1 %sdone, label %slash.done, label %slash.body\n",
        "slash.body:\n",
        "  call void @chibi_emit(i32 92, i1 %want, ptr %buffer, i64 %size, ptr %out)\n",
        "  %si.next = add i64 %si, 1\n",
        "  br label %slash.loop\n",
        "slash.done:\n",
        "  %e.p = load i64, ptr %p\n",
        "  %e.at = getelementptr inbounds i16, ptr %line, i64 %e.p\n",
        "  %e.u = load i16, ptr %e.at\n",
        "  %e.end = icmp eq i16 %e.u, 0\n",
        "  br i1 %e.end, label %finish, label %ordinary\n",
        "ordinary:\n",
        "  %e.space = icmp eq i16 %e.u, 32\n",
        "  %e.tab = icmp eq i16 %e.u, 9\n",
        "  %e.white = or i1 %e.space, %e.tab\n",
        "  %e.in = load i1, ptr %quoted\n",
        "  %e.not.in = xor i1 %e.in, true\n",
        "  %e.split = and i1 %e.white, %e.not.in\n",
        "  br i1 %e.split, label %finish, label %take\n",
        "take:\n",
        "  %t.used = call i64 @chibi_decode(ptr %line, i64 %e.p, ptr %cp)\n",
        "  %t.cp = load i32, ptr %cp\n",
        "  call void @chibi_emit(i32 %t.cp, i1 %want, ptr %buffer, i64 %size, ptr %out)\n",
        "  %t.next = add i64 %e.p, %t.used\n",
        "  store i64 %t.next, ptr %p\n",
        "  br label %scan\n",
        "after.unit:\n",
        "  %a.p = load i64, ptr %p\n",
        "  %a.at = getelementptr inbounds i16, ptr %line, i64 %a.p\n",
        "  %a.u = load i16, ptr %a.at\n",
        "  %a.end = icmp eq i16 %a.u, 0\n",
        "  br i1 %a.end, label %finish, label %after.check\n",
        "after.check:\n",
        "  %a.space = icmp eq i16 %a.u, 32\n",
        "  %a.tab = icmp eq i16 %a.u, 9\n",
        "  %a.white = or i1 %a.space, %a.tab\n",
        "  %a.in = load i1, ptr %quoted\n",
        "  %a.not.in = xor i1 %a.in, true\n",
        "  %a.split = and i1 %a.white, %a.not.in\n",
        "  br i1 %a.split, label %finish, label %scan\n",
        "finish:\n",
        "  br i1 %want, label %done.wanted, label %next.argument\n",
        "done.wanted:\n",
        "  %length = load i64, ptr %out\n",
        "  ret i64 %length\n",
        "}\n",
        "define internal i64 @chibi_command_count(ptr %line) {\n",
        "entry:\n",
        "  br label %loop\n",
        "loop:\n",
        "  %i = phi i64 [ 0, %entry ], [ %next, %step ]\n",
        "  %length = call i64 @chibi_command_argument(ptr %line, i64 %i, ptr null, i64 0)\n",
        "  %missing = icmp slt i64 %length, 0\n",
        "  br i1 %missing, label %done, label %step\n",
        "step:\n",
        "  %next = add i64 %i, 1\n",
        "  br label %loop\n",
        "done:\n",
        "  ret i64 %i\n",
        "}\n"
    ]);
}

WindowsArguments :: () -> string {
    return Join([
        CommandLineParser(),
        "define i64 @chibi_argument_count() {\n",
        "  %line = load ptr, ptr @chibi_command_line\n",
        "  %n = call i64 @chibi_command_count(ptr %line)\n",
        "  ret i64 %n\n",
        "}\n",
        "define ptr @chibi_environment() {\n",
        "  ret ptr null\n",
        "}\n",
        "define i64 @chibi_argument(i64 %index, ptr %buffer, i64 %size) {\n",
        "  %line = load ptr, ptr @chibi_command_line\n",
        "  %n = call i64 @chibi_command_argument(ptr %line, i64 %index, ptr %buffer, i64 %size)\n",
        "  ret i64 %n\n",
        "}\n"
    ]);
}

// What a start module for `triple` imports from system libraries: on Windows
// the kernel32 functions its `declare dllimport` lines name, with or without
// a context, which the link's kernel32 stub exports. Other start modules take
// theirs from the C library. A test holds this list to the modules.
pub StartImports :: (triple: string) -> Import {
    if (TargetOf(triple) != WindowsX64) {
        none: Import = {name: "", symbols: []};
        return none;
    }
    kernel32: Import = {name: "kernel32",
                        symbols: ["ExitProcess", "GetCommandLineW", "GetProcessHeap", "HeapAlloc", "HeapFree", "GetStdHandle",
                                  "WriteFile"]};
    return kernel32;
}

pub Start :: (triple: string, static: bool, context: bool) -> string {
    module := Module(triple, static, context);
    if (module == "") {
        return "";
    }
    if (TargetOf(triple) == WindowsX64) {
        return Join([module, WindowsArguments()]);
    }
    return Join([module, PosixArguments()]);
}

// A shared generation has no process entry. Its host-call wrappers use the
// same libc-backed runtime as an executable, held privately by this generation.
pub SharedContext :: (triple: string, context: bool) -> string {
    if (TargetOf(triple) != LinuxX64) {
        return "";
    }
    module := DynamicStart(triple, context);
    boundary := strings.Index(module, "define i32 @main(");
    assert(boundary > 0);
    module = strings.Slice(module, 0, boundary);
    module = strings.ReplaceAll(module, "@chibi_context = global", "@chibi_context = hidden global");
    module = Join([module, PosixArguments(),
        "define i32 @chibi_host_set_process(i64 %count, ptr %arguments, ptr %environment) {\n",
        "  %n = trunc i64 %count to i32\n  store i32 %n, ptr @chibi_argc\n",
        "  store ptr %arguments, ptr @chibi_argv\n  store ptr %environment, ptr @chibi_envp\n  ret i32 0\n}\n"]);
    return strings.ReplaceAll(module, "= dso_local global", "= hidden global");
}
