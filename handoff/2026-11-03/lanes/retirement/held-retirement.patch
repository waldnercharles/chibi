-    if (pipe(fds)) {
-        return false;
-    }
-    for (int i = 0; i < 2; i++) {
-        /* Keep spawn actions independent of closed parent standard streams. */
-        if (fds[i] < 3) {
-            int fd = fcntl(fds[i], F_DUPFD_CLOEXEC, 3);
-            if (fd < 0) {
-                return false;
-            }
-            close(fds[i]);
-            fds[i] = fd;
-        }
-        if (fcntl(fds[i], F_SETFD, FD_CLOEXEC)) {
-            return false;
-        }
