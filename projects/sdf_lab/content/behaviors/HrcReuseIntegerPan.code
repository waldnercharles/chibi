behavior "HrcReuseIntegerPan" {
    owner "ecs.entity";
    state elapsed: float = 0.0;
    on Tick as tick(DeltaSeconds: float = 0.0) {
        &state.elapsed += cast<double>(&delta);
        &component("GAME.GameTransform", "x") = floor(22 * sin(cast<double>(&state.elapsed) * 0.7)) * (3200 / 540);
    }
}
