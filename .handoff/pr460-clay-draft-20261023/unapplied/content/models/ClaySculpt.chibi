                            data.Field.Named("y", data.Value.Real(0.0)),
                            data.Field.Named("inputs", data.Object([
                                data.Field.Named("Smoothness", data.Value.Real(3.0))
                            ]))
                        ]),
                        data.Object([
                            data.Field.Named("id", data.Value.UInt(700)),
                            data.Field.Named("type", data.Value.Text("Behavior Expression")),
                            data.Field.Named("x", data.Value.Real(280.0)),
                            data.Field.Named("y", data.Value.Real(650.0)),
                            data.Field.Named("reference_name", data.Value.Text("vec3(-7, 38 - 15 * form, 6)")),
                            data.Field.Named("inputs", data.Object([
