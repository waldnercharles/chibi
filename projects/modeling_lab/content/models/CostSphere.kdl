version 3
name "CostSphere"
domain "model"
id_counter 14
description "A single public uniform dimension, shared by every instance in the cost study."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 6
                type "Model Parameter"
                reference_name "Radius"
                inputs Minimum=0.5 Maximum=2.0
            }
            - id=11 type="Model Sphere"
        }
        (array)edges {
            - from="6.Value" to="11.Radius"
            - from="11.Geometry" to="1.Geometry"
        }
    }
}
