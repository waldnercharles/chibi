package managed_source_probe

import abi "project:native_abi"
import link "project:native_link"
import host "project:native_link_host"
import os "core:os"
import strings "core:strings"

// Inspect the emitted control flow without executing a fabricated inactive
// pointer. Each optional write's Nil edge must skip its Text payload import.
OptionalWriteBranches :: (text: string) -> bool {
    blocks: string[] = [];
    lines: string[] = [];
    active := false;
    checked := 0;
    for line in strings.SplitLines(text) {
        if (strings.HasPrefix(line, "define ")) {
            active = strings.Contains(line, " @chibi_scalar");
            blocks = [];
            lines = [];
        }
        if (!active) { continue; }
        if (line == format_text("p{}:", length(blocks))) {
            if (length(blocks) > 0) { blocks[length(blocks) - 1] = strings.Join(lines, "\n"); }
            blocks.append("");
            lines = [];
        }
        lines.append(line);
        if (!strings.Contains(line, " = call ") || !strings.Contains(line, "@chibi_text.share(")) { continue; }
        pc := length(blocks) - 1;
        if (pc < 7 || !strings.Contains(blocks[pc - 5], "extractvalue") ||
            !strings.Contains(blocks[pc - 5], ", 0\n") || !strings.Contains(blocks[pc - 4], "store i32 0") ||
            !strings.Contains(blocks[pc - 3], "icmp eq i32") ||
            !strings.Contains(blocks[pc - 2], format_text("label %p{}, label %p{}", pc + 3, pc - 1)) ||
            !strings.Contains(blocks[pc - 1], "extractvalue") || !strings.Contains(blocks[pc - 1], ", 1\n")) { return false; }
        checked += 1;
    }
    return checked >= 3;
}

Main :: () -> int {
    args := os.Arguments();
    callbacks := length(args) > 0 && args[0] == "--callbacks";
    if (callbacks) { args = slice(args, 1, length(args)); }
    assertion := length(args) > 0 && args[0] == "--assertion";
    if (assertion) { args = slice(args, 1, length(args)); }
    failure := "";
    if (length(args) > 1 && args[0] == "--failure") {
        failure = args[1];
        args = slice(args, 2, length(args));
    }
    if (length(args) < 4) { return 2; }
    work := args[0];
    llvm := args[1];
    audit := os.ReadText(args[2]);
    if (audit.error) { return 2; }
    if (os.Platform() == "Windows") {
        audit.text = strings.ReplaceAll(audit.text, "\r\n", "\n");
        // The UCRT has no POSIX dprintf, and Win64 long is only 32 bits.
        // Format three i64 arguments into a fixed stack buffer, then write it
        // directly so ExitProcess cannot discard a buffered audit report.
        report := "@managed_source.report = private constant [44 x i8] c\"managed source live %ld peak %ld total %ld\\0A\\00\"";
        assert(length(strings.Split(audit.text, report)) == 2);
        audit.text = strings.ReplaceAll(audit.text, report,
            "@managed_source.report = private constant [47 x i8] c\"managed source live %lld peak %lld total %lld\\0A\\00\"");
        printed := "  %printed = call i32 (i32, ptr, ...) @dprintf(i32 1, ptr @managed_source.report, i64 %live, i64 %peak, i64 %total)";
        assert(length(strings.Split(audit.text, printed)) == 2);
        audit.text = strings.ReplaceAll(audit.text, printed,
            "  %printed = call i32 @managed_source.print(i64 %live, i64 %peak, i64 %total)");
        audit.text = strings.ReplaceAll(audit.text, "declare i32 @dprintf(i32, ptr, ...)\n", "");
        audit.text = strings.Concatenate([audit.text, "\n",
            "; chibi-import system:c malloc\n; chibi-import system:c free\n; chibi-import system:c __stdio_common_vsprintf\n",
            "; chibi-import system:kernel32 GetStdHandle\n; chibi-import system:kernel32 WriteFile\n",
            "declare i32 @__stdio_common_vsprintf(i64, ptr, i64, ptr, ptr, ptr)\n",
            "declare ptr @GetStdHandle(i32)\ndeclare i32 @WriteFile(ptr, ptr, i32, ptr, ptr)\n",
            "define internal i32 @managed_source.print(i64 %live, i64 %peak, i64 %total) {\nentry:\n",
            "  %buffer = alloca [128 x i8]\n  %arguments = alloca [3 x i64]\n",
            "  %peak.at = getelementptr [3 x i64], ptr %arguments, i32 0, i32 1\n",
            "  %total.at = getelementptr [3 x i64], ptr %arguments, i32 0, i32 2\n",
            "  store i64 %live, ptr %arguments\n  store i64 %peak, ptr %peak.at\n  store i64 %total, ptr %total.at\n",
            "  %count = call i32 @__stdio_common_vsprintf(i64 34, ptr %buffer, i64 128, ptr @managed_source.report, ptr null, ptr %arguments)\n",
            "  %fits = icmp ult i32 %count, 128\n  br i1 %fits, label %write, label %bad\nwrite:\n",
            "  %output = call ptr @GetStdHandle(i32 -11)\n  %written = alloca i32\n  store i32 0, ptr %written\n",
            "  %status = call i32 @WriteFile(ptr %output, ptr %buffer, i32 %count, ptr %written, ptr null)\n",
            "  %okay = icmp ne i32 %status, 0\n  %actual = load i32, ptr %written\n",
            "  %complete = icmp eq i32 %actual, %count\n  %valid = and i1 %okay, %complete\n",
            "  br i1 %valid, label %done, label %bad\nbad:\n  call void @llvm.trap()\n  unreachable\ndone:\n  ret i32 %count\n}\n"]);
    }
    if (callbacks) {
        // Real allocator callbacks may request collection and construct cells
        // outside sweep. Nested allocations use the same audited allocator;
        // only the outer allocation constructs a fresh unreachable cell.
        prefix := "@managed_source.constructing = internal global i1 false\n";
        allocation := "  %callback.heap = call ptr @chibi_managed.owner(ptr %ctx)\n";
        allocation = strings.Concatenate([allocation,
            "  %nested = load i1, ptr @managed_source.constructing\n  br i1 %nested, label %allocate, label %construct\nconstruct:\n",
            "  store i1 true, ptr @managed_source.constructing\n",
            "  %cell = call ptr @chibi_managed.new(ptr %ctx, ptr %callback.heap, i64 8, ptr null, ptr null, i32 6)\n",
            "  call void @chibi_managed.collect(ptr %ctx, ptr %callback.heap)\n",
            "  store i1 false, ptr @managed_source.constructing\n  br label %allocate\nallocate:\n"]);
        hooked := strings.ReplaceAll(audit.text,
            "define internal ptr @managed_source.allocate(ptr %ctx, i64 %bytes) {\nentry:\n",
            strings.Concatenate(["define internal ptr @managed_source.allocate(ptr %ctx, i64 %bytes) {\nentry:\n", allocation]));
        hooked = strings.ReplaceAll(hooked,
            "define internal void @managed_source.release(ptr %ctx, ptr %memory) {\nentry:\n",
            "define internal void @managed_source.release(ptr %ctx, ptr %memory) {\nentry:\n  %callback.heap = call ptr @chibi_managed.owner(ptr %ctx)\n  call void @chibi_managed.collect(ptr %ctx, ptr %callback.heap)\n");
        audit.text = strings.Concatenate([prefix, hooked]);
    }

    target := abi.LinuxX64();
    if (os.Platform() == "Darwin") { target = abi.MacOSArm64(); }
    if (os.Platform() == "Windows") { target = abi.WindowsX64(); }
    start := format_text("{}/source-audit-start.ll", work);
    for (index in 3..<length(args)) {
        source := os.ReadText(args[index]);
        if (source.error) { return 2; }
        if (strings.HasSuffix(args[index], "/OptionalStrings.ll") && !OptionalWriteBranches(source.text)) {
            os.Print("optional text writes inspect their payload without a Nil edge");
            return 1;
        }
        // Match the emitted module's actual context callbacks. Formatting
        // fixtures need the same owned-text runtime as public native programs.
        formatting := strings.Contains(source.text, "; chibi-format\n");
        numbers := strings.Contains(source.text, "; chibi-format-numbers\n");
        start_text := link.ManagedProgramContext(link.ProgramStart(target.triple, false, true, formatting, numbers));
        if (os.WriteText(start, start_text)) { return 2; }
        text := strings.ReplaceAll(source.text, "define i32 @chibi_scalar(ptr %ctx)",
            "define i32 @managed_source.entry(ptr %ctx)");
        // ScopedAliases has no managed values but still proves the scoped
        // reference ABI. Its audit also needs the poison intrinsic.
        if (!strings.Contains(text, "declare void @llvm.memset.p0.i64(")) {
            text = strings.Concatenate([text, "\ndeclare void @llvm.memset.p0.i64(ptr, i8, i64, i1)\n"]);
        }
        for (forced in [false, true]) {
            current := text;
            if (forced) {
                current = strings.ReplaceAll(current, "call void @chibi_managed.safepoint(",
                    "call void @chibi_managed.collect(");
            }
            module := format_text("{}/source-audit-{}-{}.ll", work, index, forced);
            checked_audit := audit.text;
            // Records and RecordArrays keep 10000 96-byte Link cells live. A later threshold
            // can retain twice those bytes in smaller 68-byte numeric cells:
            // fewer than 29000 cells, plus the few independently owned arrays.
            // Other fixtures retain the tighter dead-allocation bound.
            if ((strings.HasSuffix(args[index], "/Records.ll") || strings.HasSuffix(args[index], "/RecordArrays.ll"))) {
                checked_audit = strings.ReplaceAll(checked_audit, "icmp ule i64 %peak, 2048", "icmp ule i64 %peak, 30000");
            }
            if (strings.HasSuffix(args[index], "/StringArrays.ll") || strings.HasSuffix(args[index], "/ViewStrings.ll") || strings.HasSuffix(args[index], "/ViewOwned.ll") || strings.HasSuffix(args[index], "/TaskViews.ll") || strings.HasSuffix(args[index], "/TaskViewPromises.ll")) {
                // Each 88-byte cell owns backing plus two text allocations.
                // The 64 KiB threshold permits fewer than 3000 such live
                // allocations, plus the fixture's few permanent owners. Owned record
                // arrays similarly keep backing and nested arrays per cell.
                checked_audit = strings.ReplaceAll(checked_audit, "icmp ule i64 %peak, 2048", "icmp ule i64 %peak, 4096");
            }
            if (strings.HasSuffix(args[index], "/ViewAppend.ll")) {
                // One cell plus geometric backing growth for 4096 appends;
                // a snapshot copy on each append exceeds this by two orders.
                checked_audit = strings.ReplaceAll(checked_audit, "icmp ule i64 %peak, 2048", "icmp ule i64 %total, 32");
            }
            if (strings.HasSuffix(args[index], "/PointerAppend.ll")) {
                // 4097 pointed cells plus one array cell and geometric backing
                // growth. Copying backing at every append exceeds this bound.
                checked_audit = strings.ReplaceAll(checked_audit, "icmp ule i64 %peak, 2048", "icmp ule i64 %total, 5200");
            }
            if (strings.HasSuffix(args[index], "/TextSpan.ll")) {
                // 4096 immutable windows acquire existing text owners. Only
                // the source and fixed runtime setup need allocation.
                checked_audit = strings.ReplaceAll(checked_audit, "icmp ule i64 %peak, 2048", "icmp ule i64 %total, 32");
            }
            if (strings.HasSuffix(args[index], "/TextBorrowed.ll")) {
                // Uncounted host/literal bytes must be imported before a
                // view escapes. Each nonempty window needs its own owner.
                checked_audit = strings.ReplaceAll(checked_audit, "%bounded = icmp ule i64 %peak, 2048",
                    "%imported = icmp uge i64 %total, 4096\n  %setup = icmp ule i64 %total, 4128\n  %bounded = and i1 %imported, %setup");
            }
            if (os.WriteText(module, strings.Concatenate([current, checked_audit]))) { return 2; }
            for (level in [int(0), 2]) {
                output := format_text("{}/source-audit-{}-{}-O{}", work, index, forced, level);
                if (os.Platform() == "Windows") { output = strings.Concatenate([output, ".exe"]); }
                objects := [strings.Concatenate([output, ".o"]), strings.Concatenate([output, "-start.o"])];
                if (host.Objects(llvm, [module, start], objects, level, 1)) { return 1; }
                plan := link.Program(target.triple, llvm, objects, [], [], [], output, "", false);
                if (os.Platform() == "Darwin") {
                    runtime: link.Import = {name: "System", symbols: ["malloc", "calloc", "free", "write", "dprintf", "printf", "abort", "memset", "__error"]};
                    plan.imports = [runtime];
                } else if (os.Platform() == "Windows") {
                    plan.static = true;
                    plan.imports = link.SystemImports(strings.SplitLines(strings.Concatenate([current, checked_audit, start_text])), target.triple);
                }
                if (host.Link(plan)) { return 1; }
                result := os.Capture([output]);
                valid := result.status == 0;
                if (assertion) {
                    valid = result.status == 134 && strings.Contains(result.stderr, "native failure: AssertionFailed") &&
                            strings.HasPrefix(result.stdout, "managed source live 0 peak ");
                }
                if (failure != "") {
                    // A fatal helper aborts the process rather than returning
                    // through the audit wrapper. Poison still checks all frees
                    // reached before the precise failure category is reported.
                    valid = result.status == 134 && strings.Contains(result.stderr,
                        strings.Concatenate(["native failure: ", failure]));
                }
                if (!valid) {
                    os.Print(format_text("managed source {} force={} O{} status={} {}{}", args[index], forced, level,
                        result.status, result.stdout, result.stderr));
                    return 1;
                }
                checked := "poisoned balance";
                if (failure != "") { checked = "poisoned failure category"; }
                os.Print(format_text("PASS managed source {} force={} O{} {}", args[index], forced, level, checked));
                os.Print(result.stdout);
                // Preserve child diagnostics for strict callers as well as failures.
                if (result.stderr != "") { os.Print(result.stderr); }
            }
        }
    }
    return 0;
}
