+CopyCompilerPayload :: (source: string, destination: string) -> bool {
+    original := Join([build.root(), "/tools/compiler"]);
+    if (build.file_kind(destination) != "" || !SameCompilerPayload(original, source, true)) {
+        return false;
+    }
+    excluded := build.lines(build.read_file(Join([original, "/NativeBuildFiles.txt"])));
+    for (relative in CompilerFiles(source, "", excluded)) {
+        if (relative == "" || !CopyTree(Join([source, "/", relative]),
+                                        Join([destination, "/", relative]))) {
+            return false;
+        }
+    }
+    return SameCompilerPayload(original, destination, false);
+}
