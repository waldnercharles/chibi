# Record configured artifact identities without assuming target output names or
# directories. Object membership remains the build graph's responsibility.
include_guard(GLOBAL)
function(chibi_package_target_records directory output)
    set(records "")
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(type "${target}" TYPE)
        if(type STREQUAL "STATIC_LIBRARY" OR type STREQUAL "EXECUTABLE" OR type STREQUAL "OBJECT_LIBRARY")
            if(target MATCHES "[\t\r\n]" OR CMAKE_BINARY_DIR MATCHES "[\t\r\n]")
                message(FATAL_ERROR "Package target records require single-line names and paths")
            endif()
            if(type STREQUAL "OBJECT_LIBRARY")
                string(APPEND records "${type}\t${target}\t\n")
            else()
                string(APPEND records "${type}\t${target}\t$<TARGET_FILE:${target}>\n")
            endif()
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        chibi_package_target_records("${child}" nested)
        string(APPEND records "${nested}")
    endforeach()
    set(${output} "${records}" PARENT_SCOPE)
endfunction()
function(chibi_package_targets)
    if(NOT CMAKE_GENERATOR STREQUAL "Ninja")
        return()
    endif()
    chibi_package_target_records("${CMAKE_SOURCE_DIR}" records)
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/chibi_package_targets-$<CONFIG>.txt"
        CONTENT "1\n${records}")
endfunction()
