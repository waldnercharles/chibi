AddInt :: (a: int, b: int) -> int {
    return a + b;
}

SubtractInt :: (a: int, b: int) -> int {
    return a - b;
}

MultiplyInt :: (a: int, b: int) -> int {
    return a * b;
}

LessInt :: (a: int, b: int) -> bool {
    return a < b;
}

DivideInt :: (a: int, b: int) -> int {
    return a / b;
}

RemainderInt :: (a: int, b: int) -> int {
    return a % b;
}

@test
IntAddition :: () {
    left: int = -1;
    right: int = 1;
    actual: int = AddInt(left, right);
    expected: int = 0;
    assert(actual == expected);
    return;
}

@test
IntSubtraction :: () {
    left: int = 0;
    right: int = 1;
    actual: int = SubtractInt(left, right);
    expected: int = -1;
    assert(actual == expected);
    return;
}

@test
IntMultiplication :: () {
    left: int = -2147483647;
    right: int = 3;
    actual: int = MultiplyInt(left, right);
    expected: int = -2147483645;
    assert(actual == expected);
    return;
}

@test
IntOrdering :: () {
    left: int = -2147483648;
    right: int = 1;
    actual: bool = LessInt(left, right);
    expected: bool = true;
    assert(actual == expected);
    return;
}

@test
IntDivision :: () {
    left: int = -2;
    right: int = 2;
    actual: int = DivideInt(left, right);
    expected: int = -1;
    assert(actual == expected);
    return;
}

@test
IntRemainder :: () {
    left: int = -1;
    right: int = 2;
    actual: int = RemainderInt(left, right);
    expected: int = -1;
    assert(actual == expected);
    return;
}

@test
IntDivideByZero :: () {
    left: int = -2147483648;
    right: int = 0;
    actual: int = DivideInt(left, right);
    expected: int = 0;
    assert(actual == expected);
    return;
}

@test
IntRemainderByZero :: () {
    left: int = -2147483648;
    right: int = 0;
    actual: int = RemainderInt(left, right);
    expected: int = -2147483648;
    assert(actual == expected);
    return;
}

@test
IntDivideMinimumByMinusOne :: () {
    left: int = -2147483648;
    right: int = -1;
    actual: int = DivideInt(left, right);
    expected: int = -2147483648;
    assert(actual == expected);
    return;
}

@test
IntRemainderMinimumByMinusOne :: () {
    left: int = -2147483648;
    right: int = -1;
    actual: int = RemainderInt(left, right);
    expected: int = 0;
    assert(actual == expected);
    return;
}

