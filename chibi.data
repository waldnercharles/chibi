version: 3
name: ShaderMath
domain: shader-library
id_counter: 399
description: Shared pulse and ring masking functions with explicit inputs.
graphs:
- {kind: event, name: Functions}
- id: 56
  kind: function
  name: Pulse
  entry_id: 57
  return_id: 59
  call_depth_limit: 64
  nodes:
  - id: 57
    type: Function Entry
    outputs:
    - {id: 61, name: Time, type: float, kind: data}
    - {id: 62, name: Speed, type: float, kind: data}
  - id: 59
    type: Return
    inputs:
    - {id: 63, name: Brightness, type: float, kind: data}
  - id: 190
    type: Behavior Expression
    reference_id: 163
    reference_name: (sin(time * speed) + 1) * 0.5
    inputs:
      time: {type: float}
      speed: {type: float}
    outputs:
      Result: {type: float}
  edges:
  - {from: 57.Time, to: 190.time}
  - {from: 57.Speed, to: 190.speed}
  - {from: 190.Result, to: 59.Brightness}
- id: 102
  kind: function
  name: Ring Mask
  entry_id: 103
  return_id: 107
  call_depth_limit: 64
  nodes:
  - id: 103
    type: Function Entry
    outputs:
    - id: 104
      name: Position
      type: struct
      type_name: ShaderVec2
      kind: data
      default: {x: 0.0, "y": 0.0}
    - {id: 105, name: Radius, type: float, kind: data, default: 35.0}
    - {id: 106, name: Width, type: float, kind: data, default: 3.0}
  - id: 107
    type: Return
    inputs:
    - {id: 108, name: Mask, type: float, kind: data}
  - id: 110
    type: Shader Circle
    inputs:
      Position:
        default: {x: 0.0, "y": 0.0}
  - id: 305
    type: Behavior Expression
    reference_id: 275
    reference_name: saturate(1 - abs(distance) / max(width, 0.001))
    inputs:
      distance: {type: float}
      width: {type: float}
    outputs:
      Result: {type: float}
  edges:
  - {from: 103.Position, to: 110.Position}
  - {from: 103.Radius, to: 110.Radius}
  - {from: 103.Width, to: 305.width}
  - {from: 110.Value, to: 305.distance}
  - {from: 305.Result, to: 107.Mask}
- id: 163
  kind: function
  math_expression: (sin(time * speed) + 1) * 0.5
  entry_id: 249
- id: 275
  kind: function
  math_expression: saturate(1 - abs(distance) / max(width, 0.001))
  entry_id: 370
version: 3
name: FreeMotion
id_counter: 120
owner_type: ecs.entity
graphs:
- kind: event
  name: ""
  nodes:
  - id: 1
    type: Event
    reference_name: Tick
    outputs:
      DeltaSeconds: {type: float, kind: data}
  - {id: 4, type: Get_GameTransform}
  - {id: 6, type: Get_GameVelocity}
  - id: 25
    type: Behavior Expression
    reference_id: 8
    reference_name: position + velocity * dt
    inputs:
      position: {type: struct, type_name: GameTransform}
      velocity: {type: struct, type_name: GameVelocity}
      dt: {type: float}
    outputs:
      Result: {type: struct, type_name: GameTransform}
  - {id: 81, type: Set_GameTransform}
  edges:
  - {from: 1.Then, to: 81.Exec}
  - {from: 1.DeltaSeconds, to: 25.dt}
  - {from: 4.Value, to: 25.position}
  - {from: 6.Value, to: 25.velocity}
  - {from: 25.Result, to: 81.Value}
- id: 8
  kind: function
  math_expression: position + velocity * dt
  entry_id: 104
query:
  op: all
  terms:
  - {op: has, component: GAME.GameTransform}
  - {op: has, component: GAME.GameVelocity}
  - {op: has, component: GAME.GameAppearance}
  - op: not
    terms:
    - {op: has, component: GAME.GameCollider}
  - op: not
    terms:
    - {op: has, component: GAME.GameBody}
rml: <div class="menu-button"><slot/></div>
rcss: |
  .menu-button {
    display: block; height: 40dp; margin-top: 12dp; padding: 0 12dp; line-height: 40dp;
    background-color: #173744; border-radius: 4dp;
  }
  .menu-button:hover { background-color: #205363; }
  .menu-button:active { background-color: #2d6a79; }
  .menu-button .key { float: right; color: #7fa6b3; }
rml: |
  <div id="panel">
    <div class="title" id="paused">Paused</div>
    <div class="title" id="cleared">Encounter cleared</div>
    <div class="title" id="defeated">Defeated</div>
    <use ui="MenuButton" id="resume" data-event-click="emit('Resume')">Resume<span class="key">Enter</span></use>
    <use ui="MenuButton" data-event-click="emit('Restart')">Restart<span class="key">R</span></use>
    <use ui="MenuButton" data-event-click="emit('Quit')">Quit<span class="key">Q</span></use>
  </div>
rcss: |
  body { background-color: #0004087d; pointer-events: auto; }
  #panel {
    position: absolute; left: 50%; top: 50%; width: 312dp; height: 193dp;
    margin-left: -180dp; margin-top: -120.5dp; padding: 24dp;
    background-color: #050e15f5; border: 1dp #416f7eb9; border-radius: 8dp;
  }
  .title { display: none; height: 35dp; margin-bottom: 2dp; line-height: 35dp; font-size: 27dp; color: #ccf8fb; }
  body.paused #paused, body.cleared #cleared, body.defeated #defeated { display: block; }
  #defeated { color: #ff8c96; }
  body.cleared #resume, body.defeated #resume { display: none; }
  body.cleared #panel, body.defeated #panel { height: 141dp; margin-top: -94.5dp; }
