// Adapted from Neon-Swarm shaders/hrc/prefilter.shd; original source comments retained.
// Prefilter for trace shader inputs.
//
// Replaces GPU mipmap downsampling with:
//   Emission:      Gaussian-weighted average (smoother than box)
//   Transmittance: arithmetic MEAN of τ (physically correct — τ is additive along a ray)
//   Bounce:        Gaussian-weighted average (smoother indirect feedback)
//
// Dispatched at work_w x work_h. Each thread reads an S x S block of
// canvas-resolution pixels (S = canvas_dim / work_dim).

layout(set = 0, binding = 0) uniform sampler2D u_emission;
layout(set = 0, binding = 1) uniform sampler2D u_transmittance;
layout(set = 0, binding = 2) uniform sampler2D u_bounce;

layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D u_emission_out;
layout(set = 1, binding = 1, r16f) uniform writeonly image2D u_transmittance_out;
layout(set = 1, binding = 2, rgba16f) uniform writeonly image2D u_bounce_out;

layout(set = 2, binding = 0) uniform Params
{
	int u_canvas_w;
	int u_canvas_h;
	int u_work_w;
	int u_work_h;
};

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main()
{
	ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
	if (gid.x >= u_work_w || gid.y >= u_work_h) return;

	// Floating-point cell size (handles non-integer canvas/work ratios).
	float cell_w = float(u_canvas_w) / float(u_work_w);
	float cell_h = float(u_canvas_h) / float(u_work_h);

	// Canvas pixel range for this grid cell.
	float fx0 = float(gid.x) * cell_w;
	float fy0 = float(gid.y) * cell_h;
	int x0 = int(floor(fx0));
	int y0 = int(floor(fy0));
	int sx = min(int(ceil(fx0 + cell_w)), u_canvas_w) - x0;
	int sy = min(int(ceil(fy0 + cell_h)), u_canvas_h) - y0;

	// Nyquist-correct sigma for downsampling by factor S.
	float sigma_x = cell_w * 0.5;
	float sigma_y = cell_h * 0.5;

	// Emission/bounce LOD: mip level closest to work resolution.
	// Pre-averages each sample over its cell, reducing sub-pixel jitter.
	float emission_lod = ceil(log2(max(cell_w, cell_h)));
	float inv2s2_x = 1.0 / (2.0 * sigma_x * sigma_x);
	float inv2s2_y = 1.0 / (2.0 * sigma_y * sigma_y);
	float cx = fx0 + cell_w * 0.5;
	float cy = fy0 + cell_h * 0.5;

	vec3 emission_sum = vec3(0.0);
	vec3 bounce_sum = vec3(0.0);
	float tau_sum = 0.0;

	// Small blocks: uniform average (Gaussian weights ≈ equal at this size).
	if (sx <= 2 && sy <= 2) {
		float count = float(sx * sy);
		for (int dy = 0; dy < sy; dy++) {
			for (int dx = 0; dx < sx; dx++) {
				float px = float(x0 + dx) + 0.5;
				float py = float(y0 + dy) + 0.5;
				vec2 uv = vec2(px, py) / vec2(u_canvas_w, u_canvas_h);
				emission_sum += textureLod(u_emission, uv, emission_lod).rgb;
				bounce_sum += textureLod(u_bounce, uv, emission_lod).rgb;
				tau_sum += dot(textureLod(u_transmittance, uv, emission_lod).rgb, vec3(1.0/3.0));
			}
		}
		emission_sum /= count;
		bounce_sum /= count;
		tau_sum /= count;
	} else {
		float weight_sum = 0.0;
		for (int dy = 0; dy < sy; dy++) {
			for (int dx = 0; dx < sx; dx++) {
				float px = float(x0 + dx) + 0.5;
				float py = float(y0 + dy) + 0.5;
				vec2 uv = vec2(px, py) / vec2(u_canvas_w, u_canvas_h);

				float ddx = px - cx;
				float ddy = py - cy;
				float w = exp(-(ddx * ddx * inv2s2_x + ddy * ddy * inv2s2_y));

				emission_sum += textureLod(u_emission, uv, emission_lod).rgb * w;
				bounce_sum += textureLod(u_bounce, uv, emission_lod).rgb * w;
				tau_sum += dot(textureLod(u_transmittance, uv, emission_lod).rgb, vec3(1.0/3.0));
				weight_sum += w;
			}
		}
		emission_sum /= max(weight_sum, 1e-6);
		bounce_sum /= max(weight_sum, 1e-6);
		tau_sum /= float(sx * sy);
	}

	imageStore(u_emission_out, gid, vec4(emission_sum, 1.0));
	imageStore(u_transmittance_out, gid, vec4(tau_sum, 0, 0, 0));
	imageStore(u_bounce_out, gid, vec4(bounce_sum, 1.0));
}
