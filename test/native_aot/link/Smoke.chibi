package native_link_smoke

import host "native_link_host:."
import link "native_link:."
import os "core:os"
import strings "core:strings"

// Links a real program on this machine with only LLVM's tools: a module that
// calls `add` from a vendored-style archive, built with llc and llvm-ar. It
// runs from `chibi build test native-link` (tools/tests.tsv, through run.sh,
// which gives the build host the two packages as collections) with
// CHIBI_LLVM_BIN naming the folder of llc, llvm-ar and the lld tools; an empty
// PATH is enough. Without CHIBI_LLVM_BIN it reports that it did not run. The
// program must exit with status 42.

Join :: (parts: string[]) -> string {
    return strings.Join(parts, "");
}

Triple :: () -> string {
    if (os.Platform() == "Darwin") {
        return "arm64-apple-macosx11.0.0";
    }
    if (os.Platform() == "Windows") {
        return "x86_64-pc-windows-msvc";
    }
    return "x86_64-unknown-linux-gnu";
}

Add :: (triple: string) -> string {
    return Join(["target triple = \"", triple, "\"\n",
                 "define i32 @add(i32 %a, i32 %b) {\n  %c = add i32 %a, %b\n  ret i32 %c\n}\n"]);
}

// The program's entry, which link.Start's shim calls: 42 when the shim's argument
// functions work (no arguments but the program's own, its name has bytes, an index
// past the end is -1), by way of `add` from the archive.
Entry :: (triple: string) -> string {
    return Join(["target triple = \"", triple, "\"\ndeclare i32 @add(i32, i32)\ndeclare i64 @chibi_argument_count()\n",
                 "declare i64 @chibi_argument(i64, ptr, i64)\n",
                 "define i32 @chibi_scalar() {\n  %buffer = alloca [64 x i8]\n",
                 "  %count = call i64 @chibi_argument_count()\n",
                 "  %name = call i64 @chibi_argument(i64 0, ptr %buffer, i64 64)\n",
                 "  %past = call i64 @chibi_argument(i64 %count, ptr %buffer, i64 64)\n",
                 "  %one = icmp eq i64 %count, 1\n  %named = icmp sgt i64 %name, 0\n  %missing = icmp eq i64 %past, -1\n",
                 "  %first = and i1 %one, %named\n  %all = and i1 %first, %missing\n  %bit = zext i1 %all to i32\n",
                 "  %x = call i32 @add(i32 41, i32 %bit)\n  ret i32 %x\n}\n"]);
}

// Removes the folder and the files in it, which is all a run leaves.
Clear :: (folder: string) -> bool {
    if (os.Kind(folder) == os.KindNone) {
        return true;
    }
    listed := os.List(folder);
    if (listed.error != nil) {
        return false;
    }
    for (name in listed.names) {
        if (os.Remove(Join([folder, "/", name])) != nil) {
            return false;
        }
    }
    return os.Remove(folder) == nil;
}

// Windows programs split their UTF-16 command line with link.CommandLineParser, IR that
// calls no system function. Parser.ll holds its cases (quotes, backslashes, empty and
// spaced arguments, non-ASCII and a surrogate pair) and an entry that returns 42 when
// every one parses as listed; it runs here on any host.
ParserCases :: (llvm: string, work: string, triple: string, windows: bool) -> int {
    harness := os.ReadText(Join([os.Root(), "/test/native_aot/link/Parser.ll"]));
    if (harness.error != nil) {
        return Fail("cannot read Parser.ll");
    }
    module := Join(["target triple = \"", triple, "\"\n", harness.text, link.CommandLineParser()]);
    suffix := "";
    if (windows) {
        suffix = ".exe";
    }
    program := Join([work, "/parser", suffix]);
    if (os.WriteText(Join([work, "/parser.ll"]), module) != nil ||
        host.Object(llvm, Join([work, "/parser.ll"]), Join([work, "/parser.o"]), 2) != nil) {
        return Fail("the parser cases do not compile");
    }
    plan := link.Program(triple, llvm, [Join([work, "/parser.o"]), Join([work, "/start.o"])], [], [], [], program, "", windows);
    failure := host.Link(plan);
    if (failure != nil) {
        return Fail(format_text("the parser cases did not link, kind {} code {}", failure.kind, failure.code));
    }
    status := os.Run([program]);
    if (status != 42) {
        return Fail(format_text("the parser cases ended with {}; the code names the case: 100 plus its number is a wrong argument, 200 a short buffer, 300 a missing -1, 400 a wrong count", status));
    }
    return 0;
}

Fail :: (what: string) -> int {
    os.Print(Join(["native-link: ", what]));
    return 1;
}

Run :: () -> int {
    llvm := os.Getenv("CHIBI_LLVM_BIN");
    if (llvm == "") {
        os.Print("native-link: not run: set CHIBI_LLVM_BIN to the folder of llc, llvm-ar and the lld tools");
        return 0;
    }
    triple := Triple();
    work := Join([os.Root(), "/.chibi/native-link-smoke"]);
    if (!Clear(work) || os.MakeDirectory(work) != nil) {
        return Fail("cannot prepare the work folder");
    }
    windows := link.TargetOf(triple) == link.WindowsX64;
    suffix := ".a";
    program := Join([work, "/program"]);
    suffix2 := "";
    if (windows) {
        suffix = ".lib";
        suffix2 = ".exe";
        program = Join([work, "/program.exe"]);
    }
    if (os.WriteText(Join([work, "/add.ll"]), Add(triple)) != nil ||
        os.WriteText(Join([work, "/main.ll"]), Entry(triple)) != nil ||
        os.WriteText(Join([work, "/start.ll"]), link.Start(triple, windows, false)) != nil) {
        return Fail("cannot write the modules");
    }
    if (host.Object(llvm, Join([work, "/add.ll"]), Join([work, "/add.o"]), 2) != nil ||
        host.Object(llvm, Join([work, "/main.ll"]), Join([work, "/main.o"]), 2) != nil ||
        host.Object(llvm, Join([work, "/start.ll"]), Join([work, "/start.o"]), 2) != nil) {
        return Fail("llc failed");
    }
    ar := host.Tool(llvm, "llvm-ar");
    archive := Join([work, "/libadd", suffix]);
    if (ar == "" || os.Run([ar, "rcs", archive, Join([work, "/add.o"])]) != 0) {
        return Fail("llvm-ar failed");
    }
    // Two links of the same inputs to different paths give the same bytes, and
    // each leaves nothing but its program: the work folder is removed.
    digests: string[] = [];
    for (name in [program, Join([work, "/again", suffix2])]) {
        plan := link.Program(triple, llvm, [Join([work, "/main.o"]), Join([work, "/start.o"])], [archive], [], [], name, "",
                             windows);
        failure := host.Link(plan);
        if (failure != nil) {
            return Fail(format_text("the link failed, kind {} code {}", failure.kind, failure.code));
        }
        if (os.Kind(Join([name, ".work"])) != os.KindNone || os.Kind(Join([name, ".partial"])) != os.KindNone) {
            return Fail("the link left its work folder or partial file");
        }
        hashed := os.HashFile(name);
        if (hashed.error != nil) {
            return Fail("cannot hash the program");
        }
        digests.append(hashed.digest);
    }
    if (digests[0] != digests[1]) {
        return Fail("two links of the same inputs differ");
    }
    status := os.Run([program]);
    if (status != 42) {
        return Fail(format_text("the program exited with {}, not 42", status));
    }
    parsed := ParserCases(llvm, work, triple, windows);
    if (parsed != 0) {
        return parsed;
    }
    os.Print("native-link: linked and ran a program from an object and an archive; the command-line parser agrees on its cases");
    return 0;
}
