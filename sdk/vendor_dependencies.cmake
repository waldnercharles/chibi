# Install the exact pinned third-party archives the SDK links.
# Imported targets below own real archives and copied public headers; the installed
# definitions never refer to the dependency build or the engine checkout.
# The third-party archive builder (third_party/CMakeLists.txt) writes its own
# definitions file at the archive's root, with global imported targets.
if(NOT CHIBI_VENDOR_DEPENDENCY_CONFIG)
    set(CHIBI_VENDOR_DEPENDENCY_CONFIG "${CMAKE_CURRENT_BINARY_DIR}/ChibiVendorDependencies.cmake")
    set(CHIBI_VENDOR_DEPENDENCY_ROOT "../../..")
endif()
file(WRITE "${CHIBI_VENDOR_DEPENDENCY_CONFIG}" "include(CMakeFindDependencyMacro)\nget_filename_component(_chibi_vendor_prefix \"\${CMAKE_CURRENT_LIST_DIR}/${CHIBI_VENDOR_DEPENDENCY_ROOT}\" ABSOLUTE)\n")
# Cute's Linux link interface contains FindOpenGL's paths or imported targets.
# Recreate these system API roles on the consumer instead of vendoring a shared
# host library or trusting an arbitrary same-named path.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    find_package(OpenGL QUIET)
endif()
function(chibi_vendor_opengl dependency output)
    set(${output} "" PARENT_SCOPE)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        return()
    endif()
    set(requested "")
    if(IS_ABSOLUTE "${dependency}" AND EXISTS "${dependency}")
        file(REAL_PATH "${dependency}" requested)
    elseif(NOT TARGET "${dependency}")
        return()
    endif()
    foreach(pair "GL|OPENGL_gl_LIBRARY" "OpenGL|OPENGL_opengl_LIBRARY" "GLX|OPENGL_glx_LIBRARY")
        string(REPLACE "|" ";" pair "${pair}")
        list(GET pair 0 role)
        list(GET pair 1 variable)
        if(NOT ${variable} OR NOT EXISTS "${${variable}}")
            continue()
        endif()
        file(REAL_PATH "${${variable}}" discovered)
        set(target "OpenGL::${role}")
        if(NOT dependency STREQUAL target AND NOT requested STREQUAL discovered)
            continue()
        endif()
        if(NOT TARGET "${target}")
            message(FATAL_ERROR "Discovered OpenGL library has no ${target} provider: ${dependency}")
        endif()
        get_target_property(imported "${target}" IMPORTED)
        if(NOT imported)
            message(FATAL_ERROR "OpenGL provider ${target} is not a discovered imported library")
        endif()
        get_target_property(location "${target}" IMPORTED_LOCATION)
        if(NOT location OR NOT EXISTS "${location}")
            message(FATAL_ERROR "OpenGL provider ${target} has no discovered library location")
        endif()
        file(REAL_PATH "${location}" actual)
        if(NOT actual STREQUAL discovered)
            message(FATAL_ERROR "OpenGL provider ${target} does not match discovered library: ${dependency}")
        endif()
        get_property(recorded GLOBAL PROPERTY "CHIBI_VENDOR_OPENGL_${role}")
        if(NOT recorded)
            file(APPEND "${CHIBI_VENDOR_DEPENDENCY_CONFIG}"
                "find_dependency(OpenGL)\nif(NOT TARGET ${target})\n    message(FATAL_ERROR \"Chibi requires ${target}\")\nendif()\n")
            set_property(GLOBAL PROPERTY "CHIBI_VENDOR_OPENGL_${role}" TRUE)
        endif()
        set(${output} "${target}" PARENT_SCOPE)
        return()
    endforeach()
endfunction()
function(chibi_vendor_dependency target output)
    get_target_property(alias ${target} ALIASED_TARGET)
    if(alias)
        set(target ${alias})
    endif()
    # A target the third-party archive already defined keeps its name.
    if(target MATCHES "^Chibi::vendor_(.+)$")
        set(key "${CMAKE_MATCH_1}")
    else()
        string(MAKE_C_IDENTIFIER "${target}" key)
    endif()
    set(owner "Chibi::vendor_${key}")
    get_property(recorded GLOBAL PROPERTY "CHIBI_VENDOR_DEPENDENCY_${key}")
    if(recorded)
        set(${output} "${owner}" PARENT_SCOPE)
        return()
    endif()
    if(target STREQUAL "Threads::Threads")
        file(APPEND "${CHIBI_VENDOR_DEPENDENCY_CONFIG}" "find_dependency(Threads)\n")
        set(${output} "Threads::Threads" PARENT_SCOPE)
        return()
    endif()
    set_property(GLOBAL PROPERTY "CHIBI_VENDOR_DEPENDENCY_${key}" TRUE)
    get_target_property(type ${target} TYPE)
    get_target_property(imported ${target} IMPORTED)
    if(type STREQUAL "INTERFACE_LIBRARY")
        file(APPEND "${CHIBI_VENDOR_DEPENDENCY_CONFIG}" "add_library(${owner} INTERFACE IMPORTED${CHIBI_VENDOR_DEPENDENCY_SCOPE})\n")
    else()
        if(imported)
            get_target_property(location ${target} IMPORTED_LOCATION)
            if(NOT location)
                get_target_property(configs ${target} IMPORTED_CONFIGURATIONS)
                foreach(config IN LISTS configs)
                    string(TOUPPER "${config}" config)
                    get_target_property(location ${target} IMPORTED_LOCATION_${config})
                    if(location)
                        break()
                    endif()
                endforeach()
            endif()
            if(NOT location MATCHES "\\.(a|lib)$")
                message(FATAL_ERROR "Vendor dependency ${target} must be a pinned static archive: ${location}")
            endif()
        elseif(NOT type STREQUAL "STATIC_LIBRARY")
            message(FATAL_ERROR "Unsupported vendor dependency ${target}: ${type}")
        endif()
        set(archive "${CMAKE_STATIC_LIBRARY_PREFIX}chibi_vendor_${key}${CMAKE_STATIC_LIBRARY_SUFFIX}")
        install(FILES "$<TARGET_FILE:${target}>" DESTINATION lib/chibi-vendor RENAME "${archive}")
        file(APPEND "${CHIBI_VENDOR_DEPENDENCY_CONFIG}"
            "add_library(${owner} STATIC IMPORTED${CHIBI_VENDOR_DEPENDENCY_SCOPE})\nset_target_properties(${owner} PROPERTIES IMPORTED_LOCATION \"\${_chibi_vendor_prefix}/lib/chibi-vendor/${archive}\")\n")
        # A library marked as C++ makes its consumers link with the C++ driver,
        # which brings the C++ runtime and its sanitizer support.
        if(imported)
            get_target_property(languages ${target} IMPORTED_LINK_INTERFACE_LANGUAGES)
        else()
            get_target_property(languages ${target} LINKER_LANGUAGE)
        endif()
        if(languages)
            file(APPEND "${CHIBI_VENDOR_DEPENDENCY_CONFIG}"
                "set_property(TARGET ${owner} PROPERTY IMPORTED_LINK_INTERFACE_LANGUAGES ${languages})\n")
        endif()
    endif()
    set(paths "")
    get_target_property(includes ${target} INTERFACE_INCLUDE_DIRECTORIES)
    set(index 0)
    foreach(path IN LISTS includes)
        if(path MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
            set(path "${CMAKE_MATCH_1}")
        elseif(path MATCHES "^\\$<")
            continue()
        endif()
        if(NOT IS_DIRECTORY "${path}" OR path IN_LIST CMAKE_C_IMPLICIT_INCLUDE_DIRECTORIES)
            continue()
        endif()
        math(EXPR index "${index}+1")
        set(destination "include/chibi/vendor/${key}/${index}")
        install(DIRECTORY "${path}/" DESTINATION "${destination}"
            FILES_MATCHING PATTERN "*.h" PATTERN "*.hpp" PATTERN "*.inl" PATTERN "bindings" EXCLUDE)
        set(license_root "${path}")
        foreach(level RANGE 0 3)
            file(GLOB licenses "${license_root}/LICENSE*" "${license_root}/License*"
                "${license_root}/COPYING*" "${license_root}/NOTICE*" "${license_root}/FTL.TXT"
                "${license_root}/docs/FTL.TXT")
            # Case-insensitive file systems match one file to both spellings.
            list(REMOVE_DUPLICATES licenses)
            foreach(license IN LISTS licenses)
                if(NOT IS_DIRECTORY "${license}")
                    install(FILES "${license}" DESTINATION "share/chibi/licenses/vendor/${key}")
                endif()
            endforeach()
            get_filename_component(license_root "${license_root}" DIRECTORY)
        endforeach()
        list(APPEND paths "\${_chibi_vendor_prefix}/${destination}")
    endforeach()
    # A library from the third-party archive keeps the licences the archive
    # recorded for it.
    set(archive_licenses "${CHIBI_THIRD_PARTY_DIR}/share/chibi/licenses/vendor/${key}")
    if(imported AND CHIBI_THIRD_PARTY_DIR AND IS_DIRECTORY "${archive_licenses}")
        install(DIRECTORY "${archive_licenses}" DESTINATION share/chibi/licenses/vendor)
    endif()
    if(paths)
        file(APPEND "${CHIBI_VENDOR_DEPENDENCY_CONFIG}"
            "set_property(TARGET ${owner} PROPERTY INTERFACE_INCLUDE_DIRECTORIES \"${paths}\")\n")
    endif()
    get_target_property(definitions ${target} INTERFACE_COMPILE_DEFINITIONS)
    if(definitions)
        file(APPEND "${CHIBI_VENDOR_DEPENDENCY_CONFIG}"
            "set_property(TARGET ${owner} PROPERTY INTERFACE_COMPILE_DEFINITIONS [==[${definitions}]==])\n")
    endif()
    foreach(property INTERFACE_COMPILE_FEATURES INTERFACE_COMPILE_OPTIONS INTERFACE_LINK_OPTIONS)
        get_target_property(values ${target} ${property})
        if(values)
            file(APPEND "${CHIBI_VENDOR_DEPENDENCY_CONFIG}"
                "set_property(TARGET ${owner} PROPERTY ${property} [==[${values}]==])\n")
        endif()
    endforeach()
    set(links "")
    get_target_property(dependencies ${target} INTERFACE_LINK_LIBRARIES)
    foreach(dependency IN LISTS dependencies)
        if(dependency MATCHES "^\\$<LINK_ONLY:(.*)>$")
            set(dependency "${CMAKE_MATCH_1}")
        elseif(dependency MATCHES "^\\$<(BUILD_INTERFACE|TARGET_NAME):(.*)>$")
            set(dependency "${CMAKE_MATCH_2}")
        endif()
        chibi_vendor_opengl("${dependency}" system_opengl)
        if(system_opengl)
            list(APPEND links "${system_opengl}")
        elseif(TARGET ${dependency})
            chibi_vendor_dependency(${dependency} resolved)
            list(APPEND links "${resolved}")
        elseif(dependency MATCHES "^\\$<LINK_LIBRARY:(WEAK_)?FRAMEWORK,[A-Za-z0-9_]+>$")
            list(APPEND links "${dependency}")
        elseif(dependency MATCHES "^/.*[/]([A-Za-z0-9_]+)\\.framework$")
            list(APPEND links "-framework ${CMAKE_MATCH_1}")
        elseif(dependency MATCHES "^/usr/lib[^/]*/([^/]+/)?lib([A-Za-z0-9_+.-]+)\\.(so|a)$")
            list(APPEND links "${CMAKE_MATCH_2}")
        elseif(IS_ABSOLUTE "${dependency}")
            message(FATAL_ERROR "Vendor dependency ${target} has an unowned absolute link: ${dependency}")
        elseif(dependency MATCHES "^\\$<")
            message(FATAL_ERROR "Vendor dependency ${target} has an unresolved link expression: ${dependency}")
        elseif(dependency AND NOT dependency MATCHES "-NOTFOUND$")
            list(APPEND links "${dependency}")
        endif()
    endforeach()
    if(links)
        file(APPEND "${CHIBI_VENDOR_DEPENDENCY_CONFIG}"
            "set_property(TARGET ${owner} PROPERTY INTERFACE_LINK_LIBRARIES [==[${links}]==])\n")
    endif()
    set(${output} "${owner}" PARENT_SCOPE)
endfunction()
