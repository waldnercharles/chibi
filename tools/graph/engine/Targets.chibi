// A target's system include directories, which CMake gives after its others as
// -isystem: staged headers as Includes names them.
pub SystemIncludes :: (target: string) -> string[] {
    if (target == "chibi_vector_capabilities") {
        return ["public/math"];
    }
    if (target == "chibi_tilemap_runtime") {
        return ["public/math"];
    }
    if (target == "chibi_ui_runtime") {
        return ["public/math"];
    }
    if (target == "chibi_mesh_runtime") {
        return ["public/math"];
    }
    if (target == "chibi_model_bake") {
        return ["public/math"];
    }
    if (target == "chibi_native_types") {
        return ["public/math"];
    }
    if (target == "chibi_spatial_runtime") {
        return ["public/math"];
    }
    if (target == "chibi_native_bindings") {
        return ["public/math"];
    }
    if (target == "chibi_entity_runtime") {
        return ["public/math"];
    }
    if (target == "chibi_rhythm_runtime") {
        return ["public/math"];
    }
    if (target == "chibi_particle_runtime") {
        return ["public/math"];
    }
    if (target == "chibi_input_runtime") {
        return ["public/math"];
    }
    if (target == "chibi_visual_motion_runtime") {
        return ["public/math"];
    }
    if (target == "chibi_declared_components") {
        return ["public/math"];
    }
    if (target == "chibi_visual_catalog") {
        return ["public/math"];
    }
    if (target == "chibi_scene_authoring") {
        return ["public/math"];
    }
    if (target == "chibi_scenario_document") {
        return ["public/math"];
    }
    if (target == "chibi_material_runtime") {
        return ["public/math"];
    }
    if (target == "chibi_physics_runtime") {
        return ["public/math"];
    }
    if (target == "chibi_physics3d_runtime") {
        return ["public/math"];
    }
    if (target == "chibi_visibility_runtime") {
        return ["public/math"];
    }
    if (target == "chibi_graph_authoring") {
        return ["public/math"];
    }
    if (target == "chibi_host_native_default") {
        return ["public/math"];
    }
    if (target == "chibi_engine") {
        return ["public/math"];
    }
    if (target == "chibi_image_preparation") {
        return ["private/image_preparation"];
    }
    if (target == "chibi_asset_authoring") {
        return ["public/math"];
    }
    if (target == "chibi_player") {
        return ["public/math"];
    }
    if (target == "chibi_shader_preparation") {
        return ["public/math"];
    }
    if (target == "chibi_model_authoring") {
        return ["public/math"];
    }
    if (target == "chibi_platform") {
        return [
            "third-party/include/chibi/desktop_vendor/cute/1",
            "third-party/include/chibi/desktop_vendor/cute/2",
            "third-party/include/chibi/desktop_vendor/cute/3",
            "third-party/include/chibi/desktop_vendor/cute/4",
            "third-party/include/chibi/desktop_vendor/cute/5",
            "third-party/include/chibi/desktop_vendor/physfs_static/1",
            "third-party/include/chibi/desktop_vendor/SDL3_Headers/1",
            "third-party/include/chibi/desktop_vendor/SDL3_Headers/2"
        ];
