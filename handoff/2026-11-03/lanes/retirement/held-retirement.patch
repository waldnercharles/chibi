-        }
-        if (rhs && i->op != BF_INDEX && i->op != BF_WRITE &&
-            kinds[i->right] != BEHAVIOR_VALUE) {
-            return false;
-        }
-        if (produces) {
-            producers[next_slot++] = pc;
-        }
-    }
-    return next_slot == slot_count && code_count >= 2 &&
-           code[code_count - 2].op == BF_RETURN && code[code_count - 1].op == BF_END;
-}
