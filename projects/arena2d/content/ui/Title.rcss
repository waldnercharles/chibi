#title {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  font-size: 12dp; color: #d8e6ee;
}

#card {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0; pointer-events: auto;
  transition: opacity 1.1s cubic-in-out;
}
#card[data-ending-style] { opacity: 0; }

.veil {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  decorator: vertical-gradient(#02050bf2 #050a14d9);
}
.glow {
  position: absolute; left: 20%; right: 20%; top: 58%; height: 1dp;
  background-color: #ffb45a55;
  transition: left right opacity 2.8s 0.6s cubic-out;
}
#card[data-starting-style] .glow { left: 50%; right: 50%; opacity: 0; }

.center {
  position: absolute; left: 0; right: 0; top: 34%; text-align: center;
}

.kicker {
  display: block; font-size: 10dp; letter-spacing: 7dp; text-transform: uppercase; color: #ffb45a;
  transition: opacity 1.6s 0.3s cubic-out;
}
#card[data-starting-style] .kicker { opacity: 0; }

.word {
  display: block; margin-top: 14dp; font-size: 64dp; letter-spacing: 22dp; text-transform: uppercase; color: #f4f8ff;
  transition: opacity letter-spacing 3.2s 0.1s cubic-out;
}
#card[data-starting-style] .word { opacity: 0; letter-spacing: 48dp; }

.rule {
  display: block; width: 240dp; height: 1dp; margin: 18dp auto 0 auto; background-color: #6ff6ff66;
  transition: width opacity 2.4s 1.0s cubic-out;
}
#card[data-starting-style] .rule { width: 0dp; opacity: 0; }

.sub {
  display: block; margin-top: 18dp; font-size: 12dp; letter-spacing: 1dp; color: #8ea5b4;
  transition: opacity 2s 1.4s cubic-out;
}
#card[data-starting-style] .sub { opacity: 0; }

.descend {
  display: inline-block; margin-top: 46dp; height: 34dp; line-height: 34dp; padding: 0 12dp 0 22dp;
  font-size: 12dp; letter-spacing: 6dp; text-transform: uppercase; color: #eef6ff;
  border: 1dp #6ff6ff66; border-radius: 4dp; background-color: #6ff6ff0d;
  transition: opacity 1.4s 2.2s cubic-out, background-color border-color 0.15s linear-out;
  .key {
    display: inline-block; margin-left: 16dp; padding: 0 6dp; height: 16dp; line-height: 16dp;
    font-size: 9dp; letter-spacing: 1dp; color: #0a1a20; background-color: #6ff6ff; border-radius: 3dp;
    vertical-align: middle;
  }
}
.descend:hover { background-color: #6ff6ff26; border-color: #6ff6ff; }
#card[data-starting-style] .descend { opacity: 0; }

.seed {
  display: block; margin-top: 16dp; font-size: 9dp; letter-spacing: 3dp; text-transform: uppercase; color: #4f6370;
  transition: opacity 1.4s 2.6s cubic-out;
  .num { color: #8aa3b3; letter-spacing: 2dp; }
}
#card[data-starting-style] .seed { opacity: 0; }

.legend {
  position: absolute; left: 0; right: 0; bottom: 34dp; text-align: center;
  font-size: 9dp; letter-spacing: 2dp; text-transform: uppercase; color: #5d7280;
  transition: opacity 1.4s 3s cubic-out;
  .ctl { margin: 0 14dp; }
  .cap {
    display: inline-block; height: 16dp; line-height: 16dp; padding: 0 5dp; margin-right: 7dp;
    font-size: 8dp; letter-spacing: 1dp; color: #b8c7d2; border: 1dp #ffffff26; border-radius: 3dp;
  }
}
#card[data-starting-style] .legend { opacity: 0; }
