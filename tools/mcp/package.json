{
  "name": "chibi-mcp",
  "version": "0.2.0",
  "description": "Intent-oriented local MCP adapter for the Chibi editor",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chibi",
    "shader",
    "game-editor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/waldnercharles/c-blueprints.git",
    "directory": "tools/mcp"
  },
  "homepage": "https://github.com/waldnercharles/c-blueprints/tree/main/tools/mcp",
  "files": [
    "authoring.mjs",
    "laya.mjs",
    "laya-cli.mjs",
    "computer-use.mjs",
    "launch.sh",
    "server.mjs",
    "tool-catalog.mjs",
    "editor-command.mjs",
    "editor-command-cli.mjs"
  ],
  "bin": {
    "chibi-mcp": "./server.mjs"
  },
  "scripts": {
    "check": "node --check server.mjs && node --check authoring.mjs && node --check laya.mjs && node --check laya-cli.mjs && node --check laya-demo.mjs && node --check computer-use.mjs && node --check tool-catalog.mjs && node --check name-audit.mjs && node --check setup-codex.mjs",
    "test:laya": "node --test laya.test.mjs",
    "test:editor": "node --test editor-command.test.mjs",
    "audit:names": "node name-audit.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "js-tiktoken": "^1.0.21"
  }
}
