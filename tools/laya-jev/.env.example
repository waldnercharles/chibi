LAYA_API_KEY=replace-with-a-long-local-secret
LAYA_MODEL=laya
LAYA_DEVICE=cpu
LAYA_BIND=127.0.0.1
LAYA_PORT=8768

# Optional Hugging Face token for higher download limits.
# HF_TOKEN=

# Offline mode uses a standalone model downloaded with download_model.py.
# LAYA_MODEL_DIR=/Users/you/.cache/laya-jev/laya

# Use the PR source branch by default. Override only when testing another ref.
# LAYA_REPOSITORY=https://github.com/sirgio03/laya.git
# LAYA_REF=e683ef8d37b0828758a4e9e2004d1ab7fc3505bc
