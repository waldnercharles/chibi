version 3
name "ConstructShellWindow"
domain "model"
id_counter 25
description "An outward shell opens through a real solid cut. The shell thickness is full width, not half width."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 6
                type "Model Sphere"
                inputs Radius=28.0
            }
            - {
                id 9
                type "Model Shell"
                inputs Thickness=4.0 Side="Outward"
            }
            - {
                id 14
                type "Model Box"
                inputs {
                    "Half Size" {
                        default x=40.0 y=12.0 z=40.0
                    }
                }
            }
            - id=17 type="Model Difference"
            - id=21 type="Model Part" reference_name="Split spherical shell"
        }
        (array)edges {
            - from="6.Geometry" to="9.Geometry"
            - from="9.Geometry" to="17.A"
            - from="14.Geometry" to="17.B"
            - from="17.Geometry" to="21.Geometry"
            - from="21.Geometry" to="1.Geometry"
        }
    }
}
