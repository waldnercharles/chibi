version 3
name "ConstructAnchorFixture"
domain "model"
id_counter 47
description "Two instances attach by exported socket identity to independent rotated frames. One instance has a numeric socket override; source geometry and anchor must remain coherent."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 6
                type "Model Instance"
                reference_asset "ConstructAnchorProbe"
                outputs {
                    Socket id=8 declaration_id=11 type_name="Anchor3D" default=0
                }
            }
            - {
                id 9
                type "Model Instance"
                reference_asset "ConstructAnchorProbe"
                inputs {
                    "Socket Position" {
                        id 11
                        declaration_id 6
                        type "struct"
                        type_name "ShaderVec3"
                        default x=7.0 y=-25.0 z=0.0
                    }
                }
                outputs {
                    Geometry id=10
                    Socket id=12 declaration_id=11 type_name="Anchor3D" default=0
                }
            }
            - {
                id 13
                type "Model Anchor"
                reference_name "Left mount"
                inputs {
                    Position {
                        default x=-30.0 y=0.0 z=0.0
                    }
                    Angles {
                        default x=0.0 y=0.0 z=0.65
                    }
                }
            }
            - {
                id 19
                type "Model Anchor"
                reference_name "Right mount"
                inputs {
                    Position {
                        default x=30.0 y=0.0 z=0.0
                    }
                    Angles {
                        default x=0.0 y=0.0 z=-0.65
                    }
                }
            }
            - id=25 type="Model Attach"
            - id=30 type="Model Attach"
            - id=35 type="Model Union"
            - {
                id 39
                type "Model Rounded Box"
                inputs {
                    "Half Size" {
                        default x=40.0 y=5.0 z=9.0
                    }
                    Radius 3.0
                }
            }
            - id=43 type="Model Union"
        }
        (array)edges {
            - from="6.Geometry" to="25.Geometry"
            - from="6.Socket" to="25.Source Anchor"
            - from="9.Geometry" to="30.Geometry"
            - from="9.Socket" to="30.Source Anchor"
            - from="13.Anchor" to="25.Target Anchor"
            - from="19.Anchor" to="30.Target Anchor"
            - from="25.Geometry" to="35.A"
            - from="30.Geometry" to="35.B"
            - from="35.Geometry" to="43.A"
            - from="39.Geometry" to="43.B"
            - from="43.Geometry" to="1.Geometry"
        }
    }
}
