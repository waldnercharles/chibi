        ];
    }
    if (target == "chibi_native_prepared") {
        return [
            "public/native_prepared", "public/native_capabilities", "public/capabilities", "public/types",
            "public/support", "public/execution_contract", "public/behavior_runtime", "public/execution",
            "public/ecs", "public/tasks", "public/events", "public/input_action"
        ];
    }
    if (target == "chibi_scene_runtime") {
        return [
            "public/scene_runtime", "public/behavior_runtime", "public/execution", "public/types",
            "public/support", "public/execution_contract", "public/ecs", "public/tasks", "public/events"
        ];
    }
    if (target == "chibi_vector_capabilities") {
        return [
            "public/vector_capabilities", "public/native_capabilities", "public/capabilities", "public/types",
            "public/support", "public/execution_contract"
        ];
    }
    if (target == "chibi_math_capabilities") {
        return [
            "public/math_capabilities", "public/native_capabilities", "public/capabilities", "public/types",
            "public/support", "public/execution_contract", "public/execution", "public/ecs", "public/tasks"
        ];
    }
    if (target == "chibi_arithmetic_capabilities") {
        return [
            "public/arithmetic_capabilities", "public/native_capabilities", "public/capabilities",
            "public/types", "public/support", "public/execution_contract", "public/execution", "public/ecs",
            "public/tasks"
        ];
    }
    if (target == "chibi_tilemap_runtime") {
        return ["public/tilemap_runtime", "public/support"];
    }
    if (target == "chibi_ui_runtime") {
        return [
            "public/ui_runtime", "public/asset_values", "public/support", "public/native_capabilities",
