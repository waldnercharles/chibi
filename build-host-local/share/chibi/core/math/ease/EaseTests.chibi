package ease

EaseClose :: (actual: number, expected: number) {
    assert(actual >= expected - 0.000004 && actual <= expected + 0.000004);
}

@test
EveryEasingKeepsItsEndpoints :: () {
    assert(Linear(0) == 0 && Linear(1) == 1);
    assert(QuadraticIn(0) == 0 && QuadraticIn(1) == 1);
    assert(QuadraticOut(0) == 0 && QuadraticOut(1) == 1);
    assert(QuadraticInOut(0) == 0 && QuadraticInOut(1) == 1);
    assert(CubicIn(0) == 0 && CubicIn(1) == 1);
    assert(CubicOut(0) == 0 && CubicOut(1) == 1);
    assert(CubicInOut(0) == 0 && CubicInOut(1) == 1);
    assert(QuarticIn(0) == 0 && QuarticIn(1) == 1);
    assert(QuarticOut(0) == 0 && QuarticOut(1) == 1);
    assert(QuarticInOut(0) == 0 && QuarticInOut(1) == 1);
    assert(QuinticIn(0) == 0 && QuinticIn(1) == 1);
    assert(QuinticOut(0) == 0 && QuinticOut(1) == 1);
    assert(QuinticInOut(0) == 0 && QuinticInOut(1) == 1);
    assert(SineIn(0) == 0 && SineIn(1) == 1);
    assert(SineOut(0) == 0 && SineOut(1) == 1);
    assert(SineInOut(0) == 0 && SineInOut(1) == 1);
    assert(CircularIn(0) == 0 && CircularIn(1) == 1);
    assert(CircularOut(0) == 0 && CircularOut(1) == 1);
    assert(CircularInOut(0) == 0 && CircularInOut(1) == 1);
    assert(ExponentialIn(0) == 0 && ExponentialIn(1) == 1);
    assert(ExponentialOut(0) == 0 && ExponentialOut(1) == 1);
    assert(ExponentialInOut(0) == 0 && ExponentialInOut(1) == 1);
    assert(ElasticIn(0) == 0 && ElasticIn(1) == 1);
    assert(ElasticOut(0) == 0 && ElasticOut(1) == 1);
    assert(ElasticInOut(0) == 0 && ElasticInOut(1) == 1);
    assert(BackIn(0) == 0 && BackIn(1) == 1);
    assert(BackOut(0) == 0 && BackOut(1) == 1);
    assert(BackInOut(0) == 0 && BackInOut(1) == 1);
    assert(BounceIn(0) == 0 && BounceIn(1) == 1);
    assert(BounceOut(0) == 0 && BounceOut(1) == 1);
    assert(BounceInOut(0) == 0 && BounceInOut(1) == 1);
}

@test
EveryInOutPassesThroughTheMiddle :: () {
    assert(Linear(0.5) == 0.5);
    assert(QuadraticInOut(0.5) == 0.5);
    assert(CubicInOut(0.5) == 0.5);
    assert(QuarticInOut(0.5) == 0.5);
    assert(QuinticInOut(0.5) == 0.5);
    EaseClose(SineInOut(0.5), 0.5);
    assert(CircularInOut(0.5) == 0.5);
    assert(ExponentialInOut(0.5) == 0.5);
    assert(ElasticInOut(0.5) == 0.5);
    assert(BackInOut(0.5) == 0.5);
    assert(BounceInOut(0.5) == 0.5);
}

@test
PolynomialFamiliesHaveTheirDistinctRates :: () {
    assert(Linear(0.25) == 0.25);
    assert(QuadraticIn(0.5) == 0.25);
    assert(QuadraticOut(0.5) == 0.75);
    assert(QuadraticInOut(0.25) == 0.125);
    assert(CubicIn(0.5) == 0.125);
    assert(CubicOut(0.5) == 0.875);
    assert(CubicInOut(0.25) == 0.0625);
    assert(QuarticIn(0.5) == 0.0625);
    assert(QuarticOut(0.5) == 0.9375);
    assert(QuarticInOut(0.25) == 0.03125);
    assert(QuinticIn(0.5) == 0.03125);
    assert(QuinticOut(0.5) == 0.96875);
    assert(QuinticInOut(0.25) == 0.015625);
}

@test
TrigonometricAndExponentialFamiliesHaveKnownSamples :: () {
    EaseClose(SineIn(0.5), 0.2928932188);
    EaseClose(SineOut(0.5), 0.7071067812);
    EaseClose(SineInOut(0.25), 0.1464466094);
    EaseClose(CircularIn(0.5), 0.1339745962);
    EaseClose(CircularOut(0.5), 0.8660254038);
    EaseClose(CircularInOut(0.25), 0.0669872981);
    assert(ExponentialIn(0.5) == 0.03125);
    assert(ExponentialOut(0.5) == 0.96875);
    assert(ExponentialInOut(0.25) == 0.015625);
}

@test
OutCurvesReverseInCurves :: () {
    index: int = 0;
    while (index <= 32) {
        progress: number = number(index) / 32;
        reverse := 1 - progress;
        EaseClose(QuadraticOut(progress) + QuadraticIn(reverse), 1);
        EaseClose(CubicOut(progress) + CubicIn(reverse), 1);
        EaseClose(QuarticOut(progress) + QuarticIn(reverse), 1);
        EaseClose(QuinticOut(progress) + QuinticIn(reverse), 1);
        EaseClose(SineOut(progress) + SineIn(reverse), 1);
        EaseClose(CircularOut(progress) + CircularIn(reverse), 1);
        EaseClose(ExponentialOut(progress) + ExponentialIn(reverse), 1);
        EaseClose(ElasticOut(progress) + ElasticIn(reverse), 1);
        EaseClose(BackOut(progress) + BackIn(reverse), 1);
        EaseClose(BounceOut(progress) + BounceIn(reverse), 1);
        index += 1;
    }
}

@test
InOutCurvesAreSymmetric :: () {
    index: int = 0;
    while (index <= 32) {
        progress: number = number(index) / 32;
        reverse := 1 - progress;
        EaseClose(QuadraticInOut(progress) + QuadraticInOut(reverse), 1);
        EaseClose(CubicInOut(progress) + CubicInOut(reverse), 1);
        EaseClose(QuarticInOut(progress) + QuarticInOut(reverse), 1);
        EaseClose(QuinticInOut(progress) + QuinticInOut(reverse), 1);
        EaseClose(SineInOut(progress) + SineInOut(reverse), 1);
        EaseClose(CircularInOut(progress) + CircularInOut(reverse), 1);
        EaseClose(ExponentialInOut(progress) + ExponentialInOut(reverse), 1);
        EaseClose(ElasticInOut(progress) + ElasticInOut(reverse), 1);
        EaseClose(BackInOut(progress) + BackInOut(reverse), 1);
        EaseClose(BounceInOut(progress) + BounceInOut(reverse), 1);
        index += 1;
    }
}

@test
NonOvershootingFamiliesMoveForward :: () {
    index: int = 1;
    while (index <= 64) {
        progress: number = number(index) / 64;
        previous: number = number(index - 1) / 64;
        assert(Linear(previous) <= Linear(progress));
        assert(QuadraticIn(previous) <= QuadraticIn(progress));
        assert(QuadraticOut(previous) <= QuadraticOut(progress));
        assert(QuadraticInOut(previous) <= QuadraticInOut(progress));
        assert(CubicIn(previous) <= CubicIn(progress));
        assert(CubicOut(previous) <= CubicOut(progress));
        assert(CubicInOut(previous) <= CubicInOut(progress));
        assert(QuarticIn(previous) <= QuarticIn(progress));
        assert(QuarticOut(previous) <= QuarticOut(progress));
        assert(QuarticInOut(previous) <= QuarticInOut(progress));
        assert(QuinticIn(previous) <= QuinticIn(progress));
        assert(QuinticOut(previous) <= QuinticOut(progress));
        assert(QuinticInOut(previous) <= QuinticInOut(progress));
        assert(SineIn(previous) <= SineIn(progress));
        assert(SineOut(previous) <= SineOut(progress));
        assert(SineInOut(previous) <= SineInOut(progress));
        assert(CircularIn(previous) <= CircularIn(progress));
        assert(CircularOut(previous) <= CircularOut(progress));
        assert(CircularInOut(previous) <= CircularInOut(progress));
        assert(ExponentialIn(previous) <= ExponentialIn(progress));
        assert(ExponentialOut(previous) <= ExponentialOut(progress));
        assert(ExponentialInOut(previous) <= ExponentialInOut(progress));
        index += 1;
    }
}

@test
BackCurvesAnticipateAndOvershoot :: () {
    EaseClose(BackIn(0.5), -0.375);
    EaseClose(BackOut(0.5), 1.375);
    assert(BackInOut(0.25) < 0);
    assert(BackInOut(0.75) > 1);
}

@test
ElasticCurvesOscillateAcrossTheirTargets :: () {
    assert(ElasticIn(0.5) < 0);
    assert(ElasticIn(0.75) > 0);
    assert(ElasticOut(0.25) < 1);
    assert(ElasticOut(0.5) > 1);
    assert(ElasticInOut(0.25) < 0);
    assert(ElasticInOut(0.75) > 1);
}

@test
BounceCurvesHaveSeparateRebounds :: () {
    EaseClose(BounceOut(4.0 / 11.0), 1);
    EaseClose(BounceOut(8.0 / 11.0), 1);
    EaseClose(BounceOut(0.9), 1);
    EaseClose(BounceOut(6.0 / 11.0), 0.7);
    assert(BounceOut(0.45) < BounceOut(0.4));
    assert(BounceOut(0.65) > BounceOut(0.6));
    assert(BounceIn(0.55) > BounceIn(0.6));
}

@test
ProgressIsNotSilentlyClamped :: () {
    assert(Linear(-0.5) == -0.5 && Linear(1.5) == 1.5);
    assert(QuadraticIn(-0.5) == 0.25);
    assert(CubicOut(1.5) == 1.125);
}
