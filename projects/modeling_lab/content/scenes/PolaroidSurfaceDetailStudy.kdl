version 1
name "PolaroidSurfaceDetailStudy"
(array)entities {
    - {
        name "Camera"
        prototype "StudyCamera"
        components {
            GameCamera width=650.0 height=380.0 focal_distance=1100.0
            GameHRC2D surface_relief=0.0 ambient=0.2 bloom=0.01 intensity=3.0 exposure=0.6
        }
    }
    - {
        name "Key"
        prototype "StudyLight"
        components {
            GameTransform x=-250.0 y=-150.0
        }
    }
    - {
        name "Fill"
        prototype "StudyLight"
        components {
            GameTransform x=250.0 y=140.0
        }
    }
    - {
        name "Baseline photograph reconstruction"
        prototype "PolaroidOneStep"
        components {
            GameTransform x=-150.0 y=0.0
            GameVisualTransform scale=19.0 pitch=0.301598 yaw=0.124322 roll=-1.277962
        }
    }
    - {
        name "Surface detail reconstruction"
        prototype "PolaroidSurfaceDetail"
        components {
            GameTransform x=150.0 y=0.0
        }
    }
}
