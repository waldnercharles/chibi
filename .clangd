# Point clangd at the build graph's compilation database.
#
# `chibi build` writes BUILD/compile_commands.json for every target and links it
# to the ignored root-level compile_commands.json. It holds the real compile
# flags, including the libclang include directory for tools/reflect/reflect.c.
# Without this file clangd searches only the source tree, fails to resolve
# <clang-c/Index.h> and <dcimgui.h>, and reports missing-header errors that the
# actual build does not have.
#
# Those false positives are dangerous rather than merely noisy: the tempting fix
# is to hardcode an absolute include path into the source, which trades a real
# portability property for a quiet editor.
CompileFlags:
  CompilationDatabase: .
