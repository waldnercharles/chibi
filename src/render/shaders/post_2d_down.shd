// 13-tap bloom downsample (Jimenez, "Next Generation Post Processing in Call
// of Duty: Advanced Warfare", 2014). The first level weights each 2x2 group by
// the inverse of its luminance, so single bright pixels do not flicker.
layout(set = 3, binding = 1) uniform shd_uniforms {
    vec2 source_texel;
    float karis;
};

vec3 tap(vec2 uv)
{
    vec3 c = texture(u_image, uv).rgb;
    if (isnan(c.r) || isnan(c.g) || isnan(c.b)) return vec3(0);
    return clamp(c, vec3(0), vec3(65504));
}

float weight(vec3 c)
{
    return 1.0 / (1.0 + dot(c, vec3(0.2126, 0.7152, 0.0722)));
}

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 uv = params.uv, t = source_texel;
    vec3 a = tap(uv + t * vec2(-2, 2)), b = tap(uv + t * vec2(0, 2)), c = tap(uv + t * vec2(2, 2));
    vec3 d = tap(uv + t * vec2(-2, 0)), e = tap(uv), f = tap(uv + t * vec2(2, 0));
    vec3 g = tap(uv + t * vec2(-2, -2)), h = tap(uv + t * vec2(0, -2)), i = tap(uv + t * vec2(2, -2));
    vec3 j = tap(uv + t * vec2(-1, 1)), k = tap(uv + t * vec2(1, 1));
    vec3 l = tap(uv + t * vec2(-1, -1)), m = tap(uv + t * vec2(1, -1));
    vec3 g0 = (a + b + d + e) * .25, g1 = (b + c + e + f) * .25;
    vec3 g2 = (d + e + g + h) * .25, g3 = (e + f + h + i) * .25;
    vec3 g4 = (j + k + l + m) * .25;
    vec4 w = karis > .5 ? vec4(weight(g0), weight(g1), weight(g2), weight(g3)) : vec4(1);
    float w4 = karis > .5 ? weight(g4) : 1.0;
    vec3 sum = (g0 * w.x + g1 * w.y + g2 * w.z + g3 * w.w) * .125 + g4 * w4 * .5;
    return vec4(sum / (dot(w, vec4(.125)) + w4 * .5), 1);
}
