+            );
+            REQUIRE(instance && lifetime_dispatch(instance, 0) == FLOW_OK);
+            int status = execution_program_update(program, 0.1, 0, 1000);
+            REQUIRE(lifetime_request_count == 1);
+            if (!synchronous) {
