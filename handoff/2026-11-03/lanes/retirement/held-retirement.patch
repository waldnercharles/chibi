-                              : negate ? UINT64_C(0) - x
-                              : sign   ? (uint64_t)(sx / sy)
-                                       : x / y;
-            uint64_t remainder = !y     ? x
-                               : negate ? 0
-                               : sign   ? (uint64_t)(sx % sy)
