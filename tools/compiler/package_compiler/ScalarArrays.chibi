package package_compiler

import facts "project:scalar_facts"
import snapshot "project:source_snapshot"

// Arrays for the scalar producer: a variable, parameter, result or call that
// is an array of numbers, bool, strings, or records or unions the source
// declares, with its literals, reads `a[i]`, `a[i].f`,
// `length(a)` and `a.length()`, `slice(a, start, count)`, `resize(a, n)` and
// `contains(a, x)`, stores `a[i] = x`, `a[i] += x` and `a[i].f = x`,
// `a.append(x)`, `a.extend(b)` and `a.remove_index(i)`, and loops over its
// elements. The ordinary compiler's decisions
// type them; these rows say which array a statement changes, and where a
// value that would otherwise be shared is copied. An array that is read from a
// variable and stored in another, or returned from a parameter, is copied; a
// call's argument is lent, since a function cannot change its parameters.

// The facts type of the elements `shape` describes, a number, bool, string,
// or a record or union the source declares; 0 for any other.
ScalarElementType :: (types: TypeDecl[], shape: ValueType) -> int {
    return ScalarValueType(types, shape.storage, 0, shape.record);
}
// The facts type of an array whose elements are of `storage` and `record`, or
// 0 when they are of no such type.
ScalarArrayType :: (types: TypeDecl[], storage: int, record: int) -> int {
    element := ScalarValueType(types, storage, 0, record);
    if (element == 0) {
        return 0;
    }
    return facts.ArrayType + element;
}
// Whether elements of `storage` can be in a scalar module's array.
ScalarArrayElement :: (storage: int) -> bool {
    return ScalarTypeOf(storage) != 0 || storage == StructStorage || storage == UnionStorage;
}
// The array the value `node` is, as the storage of its elements: a variable,
// a field of a record, or a call of a function of the source that returns one.
// Any other value has storage 0.
ScalarArrayShape :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                     names: Name[], types: TypeDecl[], members: TypeMember[], package: int, node: int) -> ValueType {
    none: ValueType = {storage: 0, container: 0, record: -1};
    value := Unparenthesized(forest, node);
    if (Is(forest, value, "identifier")) {
        found := Lookup(names, Text(forest, text, value));
        if (found >= 0 && names[found].container == ArrayContainer) {
            return {storage: names[found].storage, container: ArrayContainer, record: names[found].record};
        }
        return none;
    }
    // An array field of a record.
    if (Is(forest, value, "member_expression")) {
        field := ScalarMember(forest, text, callables, params, names, types, members, package, value);
        if (field >= 0 && members[field].container == ArrayContainer) {
            return {storage: members[field].storage, container: ArrayContainer, record: members[field].record};
        }
        return none;
    }
    if (Is(forest, value, "call_expression")) {
        callee := CalledFunction(forest, text, callables, [], names, package, value);
        if (callee >= 0 && callables[callee].result_container == ArrayContainer) {
            return {storage: callables[callee].result, container: ArrayContainer,
                    record: callables[callee].result_record};
        }
        native := ScalarArrayCall(forest, text, callables, params, names, types, members, package, value);
        if (native.operator != 0 && native.operator != facts.ArrayContains) {
            return ScalarArrayShape(forest, text, callables, params, names, types, members, package, native.array);
        }
    }
    return none;
}
// A call of an array native: the Array operator, the node of the array it
// takes and the nodes of its other arguments.
ScalarNativeCall :: struct {
    operator: int;
    array: int;
    arguments: int[];
}
// The array native `node` calls on an array: `slice(a, start, count)`,
// `resize(a, n)`, `append(a, x)`, `extend(a, b)` or `contains(a, x)`, or
// `a.contains(x)`; operator 0 for any other call. The first four give new
// arrays and change nothing they take.
ScalarArrayCall :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                    names: Name[], types: TypeDecl[], members: TypeMember[], package: int,
                    node: int) -> ScalarNativeCall {
    none: ScalarNativeCall = {operator: 0, array: -1, arguments: []};
    if (!Is(forest, node, "call_expression") ||
        CalledFunction(forest, text, callables, [], names, package, node) >= 0) {
        return none;
    }
    function := Field(forest, node, "function");
    arguments := Members(forest, Field(forest, node, "arguments"));
    name := "";
    array: int = -1;
    others: int[] = [];
    if (Is(forest, function, "identifier") && length(arguments) > 0) {
        name = Text(forest, text, function);
        array = arguments[0];
        for (index in 1..<length(arguments)) {
            others.append(arguments[index]);
        }
    } else if (Is(forest, function, "member_expression")) {
        name = Text(forest, text, Field(forest, function, "member"));
        array = Field(forest, function, "object");
        others = arguments;
    }
    operator: int = 0;
    wanted: int = 0;
    if (NameMatches(name, "slice") && Is(forest, function, "identifier")) {
        operator = facts.ArraySlice;
        wanted = 2;
    } else if (NameMatches(name, "resize") && Is(forest, function, "identifier")) {
        operator = facts.ArrayResize;
        wanted = 1;
    } else if (NameMatches(name, "append") && Is(forest, function, "identifier")) {
        operator = facts.ArrayWith;
        wanted = 1;
    } else if (NameMatches(name, "extend") && Is(forest, function, "identifier")) {
        operator = facts.ArrayJoin;
        wanted = 1;
    } else if (NameMatches(name, "contains")) {
        operator = facts.ArrayContains;
        wanted = 1;
    }
    if (operator == 0 || length(others) != wanted || array < 0 ||
        ScalarArrayShape(forest, text, callables, params, names, types, members, package, array).storage == 0) {
        return none;
    }
    return {operator: operator, array: array, arguments: others};
}
// The array whose length `node` takes, `length(a)` or `a.length()`, or -1.
ScalarLengthOf :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                   names: Name[], types: TypeDecl[], members: TypeMember[], package: int, node: int) -> int {
    if (!Is(forest, node, "call_expression")) {
        return -1;
    }
    function := Field(forest, node, "function");
    arguments := Members(forest, Field(forest, node, "arguments"));
    array: int = -1;
    if (Is(forest, function, "identifier") && NameMatches(Text(forest, text, function), "length") &&
        length(arguments) == 1 && CalledFunction(forest, text, callables, [], names, package, node) < 0) {
        array = arguments[0];
    } else if (Is(forest, function, "member_expression") &&
               NameMatches(Text(forest, text, Field(forest, function, "member")), "length") && length(arguments) == 0 &&
               CalledFunction(forest, text, callables, [], names, package, node) < 0) {
        array = Field(forest, function, "object");
    }
    if (array >= 0 && ScalarArrayShape(forest, text, callables, params, names, types, members, package, array).storage != 0) {
        return array;
    }
    return -1;
}
// The array variable that `statement`, an expression statement, changes, or
// -1: its call is `a.append(x)`, `a.extend(b)` or `a.remove_index(i)` on it.
ScalarChangeOf :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                   names: Name[], types: TypeDecl[], members: TypeMember[], package: int, statement: int) -> int {
    call := FirstMember(forest, statement);
    if (!Is(forest, statement, "expression_statement") || !Is(forest, call, "call_expression")) {
        return -1;
    }
    function := Field(forest, call, "function");
    if (!Is(forest, function, "member_expression") ||
        ScalarChangeKind(forest, text, statement) == 0 ||
        length(Members(forest, Field(forest, call, "arguments"))) != 1) {
        return -1;
    }
    object := Unparenthesized(forest, Field(forest, function, "object"));
    if (Is(forest, object, "identifier") &&
        ScalarArrayShape(forest, text, callables, params, names, types, members, package, object).storage != 0) {
        return object;
    }
    return -1;
}
// The Array operator of the method `statement` calls: ArrayPush for append,
// ArrayExtend for extend and ArrayRemove for remove_index; 0 for any other.
ScalarChangeKind :: (forest: snapshot.SnapshotNode[], text: string, statement: int) -> int {
    function := Field(forest, FirstMember(forest, statement), "function");
    if (!Is(forest, function, "member_expression")) {
        return 0;
    }
    method := Text(forest, text, Field(forest, function, "member"));
    if (NameMatches(method, "append")) {
        return facts.ArrayPush;
    }
    if (NameMatches(method, "extend")) {
        return facts.ArrayExtend;
    }
    if (NameMatches(method, "remove_index")) {
        return facts.ArrayRemove;
    }
    return 0;
}
// Whether `node` reads an array another place keeps: a variable, a field or
// an element. Storing it copies it, so no two places share the elements.
ScalarBorrowed :: (forest: snapshot.SnapshotNode[], node: int) -> bool {
    return Is(forest, node, "identifier") || Is(forest, node, "member_expression") ||
           Is(forest, node, "index_expression");
}
// Whether `value`, returned, reads an array the caller keeps: a parameter, a
// pattern's binding or a loop's variable, or a field or an element of any.
ScalarKeptRead :: (forest: snapshot.SnapshotNode[], text: string, names: Name[], value: int) -> bool {
    node := Unparenthesized(forest, value);
    if (Is(forest, node, "member_expression") || Is(forest, node, "index_expression")) {
        return true;
    }
    if (!Is(forest, node, "identifier")) {
        return false;
    }
    found := Lookup(names, Text(forest, text, node));
    return found >= 0 && (names[found].place == ParameterPlace || !names[found].writable);
}
// Whether `value`, the array a loop visits, is a variable that the loop's
// `body` changes, so the loop visits a copy of it.
ScalarIterationCopies :: (forest: snapshot.SnapshotNode[], text: string, body: int, value: int) -> bool {
    node := Unparenthesized(forest, value);
    return Is(forest, node, "identifier") &&
           NamePosition(MutatedNames(forest, text, body, []), Text(forest, text, node)) >= 0;
}
// The array variable's type as a facts type, or 0 for a value that is none.
ScalarArrayHeld :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                    names: Name[], types: TypeDecl[], members: TypeMember[], package: int, node: int) -> int {
    shape := ScalarArrayShape(forest, text, callables, params, names, types, members, package, node);
    if (shape.storage == 0) {
        return 0;
    }
    return ScalarArrayType(types, shape.storage, shape.record);
}
// The facts type of member `field` of a record or union: a number, bool,
// string, array, or record or union the source declares; 0 for any other.
ScalarMemberType :: (types: TypeDecl[], members: TypeMember[], field: int) -> int {
    return ScalarValueType(types, members[field].storage, members[field].container, members[field].record);
}
// The shape of member `field`: its storage, container and record.
ScalarMemberShape :: (members: TypeMember[], field: int) -> ValueType {
    return {storage: members[field].storage, container: members[field].container, record: members[field].record};
}
// The shape of the elements of the array `shape` describes.
ScalarElementShape :: (shape: ValueType) -> ValueType {
    return {storage: shape.storage, container: 0, record: shape.record};
}
// The rows of `node`, a value of the elements or member `shape` describes,
// after `rows`: an array as ScalarArrayStored reads one, a record as
// ScalarRecordValue reads one, any other converted to its storage.
ScalarElementValue :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                       callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                       constants: ConstDecl[], node: int, shape: ValueType, rows: facts.Row[]) -> ScalarOperands {
    if (shape.container == ArrayContainer) {
        return ScalarArrayStored(forest, text, callables, params, callable, names, types, members, constants, node, shape,
                                 true, rows);
    }
    if (shape.storage == StructStorage) {
        return ScalarRecordValue(forest, text, callables, params, callable, names, types, members, constants, node,
                                 shape.record, rows);
    }
    return ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, node, node,
                         shape.storage, shape.storage, facts.Clamp, rows);
}
// The rows of `operand`, an array of the elements `shape` describes, after
// `rows`: a variable's read, a call of a function of the source that returns
// one, or a literal, each element as ScalarElementValue reads it, then its
// ArrayNew. The array is the variable's own, not a copy.
ScalarArrayValue :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                     callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                     constants: ConstDecl[], operand: int, shape: ValueType, rows: facts.Row[]) -> ScalarOperands {
    node := Unparenthesized(forest, operand);
    output := rows;
    array := ScalarArrayType(types, shape.storage, shape.record);
    held := ScalarArrayHeld(forest, text, callables, params, names, types, members, callable.package, node);
    if (Is(forest, node, "identifier") && held != 0) {
        output.append(ScalarAt(forest, node, facts.ReadRow, held, ScalarVariable(names, Text(forest, text, node)).index,
                               0, ""));
        return ScalarOperands.Built(output);
    }
    if ((Is(forest, node, "call_expression") || Is(forest, node, "member_expression")) && held != 0) {
        return ScalarOperand(forest, text, callables, params, callable, names, types, members, constants, node, 0, rows);
    }
    if (!Is(forest, node, "array_expression") || array == 0) {
        return ScalarOperands.Failed(Diagnose(forest, node, 0,
                                              "scalar proof takes arrays only from literals, variables and calls"));
    }
    elements := Members(forest, node);
    for (element in elements) {
        switch ScalarElementValue(forest, text, callables, params, callable, names, types, members, constants, element,
                                  ScalarElementShape(shape), output) {
            case .Failed(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Built(built):
                output = built;
        }
    }
    output.append(ScalarAt(forest, node, facts.ArrayRow, array, facts.ArrayNew, length(elements), ""));
    return ScalarOperands.Built(output);
}
// The rows of `operand` as ScalarArrayValue gives them, then an ArrayCopy
// when `copy` and the value is one an array variable holds.
ScalarArrayStored :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                      callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                      constants: ConstDecl[], operand: int, shape: ValueType, copied: bool,
                      rows: facts.Row[]) -> ScalarOperands {
    switch ScalarArrayValue(forest, text, callables, params, callable, names, types, members, constants, operand, shape,
                            rows) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output := built;
            if (copied && ScalarBorrowed(forest, Unparenthesized(forest, operand))) {
                output.append(ScalarAt(forest, operand, facts.ArrayRow, ScalarArrayType(types, shape.storage, shape.record),
                                       facts.ArrayCopy, 1, ""));
            }
            return ScalarOperands.Built(output);
    }
}
// The rows of `node`, `a[i]` of an array, after `rows`: the array, the index
// as an int, then its ArrayGet.
ScalarIndexed :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                  callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[],
                  node: int, rows: facts.Row[]) -> ScalarOperands {
    object := Field(forest, node, "object");
    index := Field(forest, node, "index");
    shape := ScalarArrayShape(forest, text, callables, params, names, types, members, callable.package, object);
    if (ScalarArrayHeld(forest, text, callables, params, names, types, members, callable.package, object) == 0 ||
        Is(forest, index, "range_expression")) {
        return ScalarOperands.Failed(Diagnose(forest, node, 0, "scalar proof indexes only arrays of numbers, bool, strings, records and unions by an int"));
    }
    output := rows;
    switch ScalarArrayValue(forest, text, callables, params, callable, names, types, members, constants, object, shape,
                            output) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output = built;
    }
    switch ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, index, index,
                         IntStorage, IntStorage, facts.Clamp, output) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output = built;
    }
    output.append(ScalarAt(forest, node, facts.ArrayRow, ScalarElementType(types, shape), facts.ArrayGet, 2, ""));
    return ScalarOperands.Built(output);
}
// The rows of `node`, `length(a)` or `a.length()` of the array `object`,
// after `rows`: the array, then its ArrayLength.
ScalarLength :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                 callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[],
                 node: int, object: int, rows: facts.Row[]) -> ScalarOperands {
    if (ScalarArrayHeld(forest, text, callables, params, names, types, members, callable.package, object) == 0) {
        return ScalarOperands.Failed(Diagnose(forest, node, 0, "scalar proof supports only arrays of numbers, bool, strings, records and unions"));
    }
    shape := ScalarArrayShape(forest, text, callables, params, names, types, members, callable.package, object);
    switch ScalarArrayValue(forest, text, callables, params, callable, names, types, members, constants, object, shape,
                            rows) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output := built;
            output.append(ScalarAt(forest, node, facts.ArrayRow, facts.IntType, facts.ArrayLength, 1, ""));
            return ScalarOperands.Built(output);
    }
}
// The rows that read the array variable `object` and the index `index` of an
// element, after `rows`.
ScalarElementPlace :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                       callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                       constants: ConstDecl[], object: int, index: int, shape: ValueType,
                       rows: facts.Row[]) -> ScalarOperands {
    switch ScalarArrayValue(forest, text, callables, params, callable, names, types, members, constants, object, shape,
                            rows) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            return ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, index,
                                 index, IntStorage, IntStorage, facts.Clamp, built);
    }
}
// The operand rows of the assignment `node` to element `a[i]` or to its field
// `a[i].f`, after `rows`, as StatementStep writes them. The element's place is
// the array and the index. The value is stored at the place after it: a plain
// store of an element, or a field, is the value converted to the element's or
// the field's storage, after the element read, whose field it replaces; a
// compound assignment reads the element, then the field, and combines it with
// the value. Each ends with ArraySet.
ScalarElementAssigned :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                          callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                          constants: ConstDecl[], node: int, rows: facts.Row[]) -> ScalarOperands {
    destination := Field(forest, node, "target");
    fielded := Is(forest, destination, "member_expression");
    place := destination;
    if (fielded) {
        place = Unparenthesized(forest, Field(forest, destination, "object"));
    }
    object := Field(forest, place, "object");
    index := Field(forest, place, "index");
    shape := ScalarArrayShape(forest, text, callables, params, names, types, members, callable.package, object);
    array := ScalarArrayHeld(forest, text, callables, params, names, types, members, callable.package, object);
    element := ScalarElementType(types, shape);
    if (array == 0 || !Is(forest, Unparenthesized(forest, object), "identifier") ||
        Is(forest, index, "range_expression")) {
        return ScalarOperands.Failed(Diagnose(forest, destination, 0,
                                              "scalar proof assigns only elements of array variables"));
    }
    // What the value replaces: the element, or one of its fields.
    stored := ScalarElementShape(shape);
    field := -1;
    if (fielded) {
        field = ScalarMember(forest, text, callables, params, names, types, members, callable.package, destination);
        if (field < 0) {
            return ScalarOperands.Failed(Diagnose(forest, destination, 0,
                                                  "scalar proof assigns only elements of array variables"));
        }
        stored = ScalarMemberShape(members, field);
    }
    place_type := ScalarTypeOf(stored.storage);
    if (!fielded) {
        place_type = element;
    }
    output := rows;
    operator := ScalarArithmetic(CompoundOperator(Text(forest, text, Field(forest, node, "operator"))));
    reads := 1;
    if (operator != 0 || fielded) {
        reads = 2;
    }
    if (operator != 0 && fielded) {
        reads = 3;
    }
    for (read in 0..<reads) {
        switch ScalarElementPlace(forest, text, callables, params, callable, names, types, members, constants, object,
                                  index, shape, output) {
            case .Failed(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Built(built):
                output = built;
        }
        if (read > 0) {
            output.append(ScalarAt(forest, destination, facts.ArrayRow, element, facts.ArrayGet, 2, ""));
        }
    }
    if (operator != 0 && fielded) {
        output.append(ScalarAt(forest, destination, facts.FieldRow, place_type, field - types[shape.record].first, 1,
                               ""));
    }
    value := Field(forest, node, "value");
    switch ScalarElementValue(forest, text, callables, params, callable, names, types, members, constants, value, stored,
                              output) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output = built;
    }
    if (operator != 0) {
        output.append(ScalarAt(forest, node, facts.ArithmeticRow, place_type, operator, 2, ""));
    }
    if (fielded) {
        output.append(ScalarAt(forest, destination, facts.UpdateRow, element, field - types[shape.record].first, 2, ""));
    }
    output.append(ScalarAt(forest, destination, facts.ArrayRow, array, facts.ArraySet, 3, ""));
    return ScalarOperands.Built(output);
}
// The operand rows of the statement `a.append(x)`, `a.extend(b)` or
// `a.remove_index(i)` of array variable `object`, after `rows`: a read of the
// array, the argument, an element, another array or an int, then the Array
// row of `operator`.
ScalarChanged :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                  callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                  constants: ConstDecl[], statement: int, object: int, operator: int,
                  rows: facts.Row[]) -> ScalarOperands {
    shape := ScalarArrayShape(forest, text, callables, params, names, types, members, callable.package, object);
    array := ScalarArrayType(types, shape.storage, shape.record);
    call := FirstMember(forest, statement);
    if (array == 0) {
        return ScalarOperands.Failed(Diagnose(forest, call, 0, "scalar proof supports only arrays of numbers, bool, strings, records and unions"));
    }
    output := rows;
    output.append(ScalarAt(forest, object, facts.ReadRow, array, ScalarVariable(names, Text(forest, text, object)).index,
                           0, ""));
    value := FirstMember(forest, Field(forest, call, "arguments"));
    switch ScalarArrayArgument(forest, text, callables, params, callable, names, types, members, constants, value, shape,
                               operator, output) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output = built;
    }
    output.append(ScalarAt(forest, call, facts.ArrayRow, array, operator, 2, ""));
    return ScalarOperands.Built(output);
}
// The rows of `node`, the argument of the array native `operator` on arrays of
// the elements `shape` describes, after `rows`: another array for
// ArrayExtend, an element for ArrayPush and ArrayContains, otherwise an int.
ScalarArrayArgument :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                        callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                        constants: ConstDecl[], node: int, shape: ValueType, operator: int,
                        rows: facts.Row[]) -> ScalarOperands {
    if (operator == facts.ArrayExtend || operator == facts.ArrayJoin) {
        return ScalarArrayValue(forest, text, callables, params, callable, names, types, members, constants, node, shape,
                                rows);
    }
    if (operator == facts.ArrayPush || operator == facts.ArrayWith || operator == facts.ArrayContains) {
        return ScalarElementValue(forest, text, callables, params, callable, names, types, members, constants, node,
                                  ScalarElementShape(shape), rows);
    }
    return ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, node, node,
                         IntStorage, IntStorage, facts.Clamp, rows);
}
// The rows of `node`, a call of the array native described by `native`, after
// `rows`: the array, its arguments, then the Array row.
ScalarNativeRows :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                     callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                     constants: ConstDecl[], node: int, native: ScalarNativeCall,
                     rows: facts.Row[]) -> ScalarOperands {
    shape := ScalarArrayShape(forest, text, callables, params, names, types, members, callable.package, native.array);
    array := ScalarArrayType(types, shape.storage, shape.record);
    if (array == 0 || (native.operator == facts.ArrayContains && ScalarTypeOf(shape.storage) == 0)) {
        return ScalarOperands.Failed(Diagnose(forest, node, 0, "scalar proof supports only arrays of numbers, bool, strings, records and unions"));
    }
    switch ScalarArrayValue(forest, text, callables, params, callable, names, types, members, constants, native.array,
                            shape, rows) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output := built;
            for (argument in native.arguments) {
                switch ScalarArrayArgument(forest, text, callables, params, callable, names, types, members, constants,
                                           argument, shape, native.operator, output) {
                    case .Failed(diagnostic):
                        return ScalarOperands.Failed(diagnostic);
                    case .Built(argued):
                        output = argued;
                }
            }
            type := array;
            if (native.operator == facts.ArrayContains) {
                type = facts.BoolType;
            }
            output.append(ScalarAt(forest, node, facts.ArrayRow, type, native.operator, 1 + length(native.arguments), ""));
            return ScalarOperands.Built(output);
    }
}
// The array that the local declaration `node` declares, as the storage of its
// elements, or storage 0 for a declaration of another type: its declared
// type's, or its value's, a literal's from its first element.
ScalarLocalArray :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                     callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                     constants: ConstDecl[], node: int) -> ValueType {
    none: ValueType = {storage: 0, container: 0, record: -1};
    declared := Field(forest, node, "type");
    value := Field(forest, node, "value");
    if (declared >= 0) {
        // Reading a type may add an optional or pointer type; this analysis
        // keeps none of them.
        table := types;
        resolved := ReadType(forest, text, &table, names, callable.package, declared);
        if (resolved.container == ArrayContainer) {
            return resolved;
        }
        return none;
    }
    shape := ScalarArrayShape(forest, text, callables, params, names, types, members, callable.package, value);
    if (shape.storage != 0) {
        return shape;
    }
    literal := Unparenthesized(forest, value);
    first := FirstMember(forest, literal);
    if (!Is(forest, literal, "array_expression") || first < 0) {
        return none;
    }
    storage := ScalarOperandStorage(forest, text, callables, params, callable, names, types, members, constants, first,
                                    ConstantExpressionStorage(forest, text, first));
    return {storage: storage, container: ArrayContainer, record: -1};
}
