version 1
name "Room"
presentation "3d"
(array)entities {
    - {
        name "Environment"
        prototype "Environment"
        components {
            GAME.GameEnvironment global_illumination="Medium"
        }
        (array)behaviors
    }
    - {
        name "Camera"
        prototype "Camera"
        components {
            GAME.GameTransform3D {
                position x=320.0 y=380.0 z=420.0
                rotation x=-0.2425 y=0.0 z=0.0 w=0.9701
                scale x=1.0 y=1.0 z=1.0
            }
        }
        (array)behaviors
    }
    - {
        name "Sun"
        prototype "Sun"
        (array)behaviors
    }
    - {
        name "Floor"
        prototype "Solid"
        components {
            GAME.GameTransform x=320.0 y=-180.0
            GAME.GameGeometry3D primitive=0 width=600.0 depth=400.0 height=4.0 elevation=-2.0
            GAME.GameMaterial scene=0xc0c0c0ff
        }
        (array)behaviors
    }
    - {
        name "Red"
        prototype "Solid"
        components {
            GAME.GameTransform x=30.0 y=-180.0
            GAME.GameGeometry3D primitive=0 width=20.0 depth=400.0 height=240.0 elevation=120.0
            GAME.GameMaterial scene=0xd02020ff
        }
        (array)behaviors
    }
    - {
        name "Green"
        prototype "Solid"
        components {
            GAME.GameTransform x=610.0 y=-180.0
            GAME.GameGeometry3D primitive=0 width=20.0 depth=400.0 height=240.0 elevation=120.0
            GAME.GameMaterial scene=0x20c020ff
        }
        (array)behaviors
    }
    - {
        name "Back"
        prototype "Solid"
        components {
            GAME.GameTransform x=320.0 y=-370.0
            GAME.GameGeometry3D primitive=0 width=600.0 depth=20.0 height=240.0 elevation=120.0
            GAME.GameMaterial scene=0xc0c0c0ff
        }
        (array)behaviors
    }
    - {
        name "Lamp"
        prototype "Solid"
        components {
            GAME.GameTransform x=500.0 y=-300.0
            GAME.GameGeometry3D primitive=1 width=40.0 depth=40.0 height=40.0 elevation=20.0
            GAME.GameMaterial scene=0xffe0b0ff emission_color=0xffa040ff emission_intensity=6.0 emission_multiplier=1.0
        }
        (array)behaviors
    }
    - {
        name "Block"
        prototype "Solid"
        components {
            GAME.GameTransform x=320.0 y=-200.0
            GAME.GameGeometry3D primitive=0 width=120.0 depth=120.0 height=120.0 elevation=60.0
            GAME.GameMaterial scene=0xc0c0c0ff
        }
        (array)behaviors
    }
}
