+// Keep the new binding inside generated source text. Whole-package preparation
+// must not impose it on legacy CompilerTools or the existing SDK.Verify entry.
+PolicyPairSource :: () -> string {
+    return Join([
+        "package pair_probe\nimport strings \"core:strings\"\n",
+        "Verify :: () -> int {\n",
+        "    for (name in [\"00\", \"10\", \"01\", \"11\"]) {\n",
+        "        root := strings.Join([build.root(), \"/\", name, \"/\"], \"\");\n",
+        "        if (build.publish_pair(strings.Join([root, \"source0\"], \"\"),\n",
+        "                               strings.Join([root, \"destination0\"], \"\"),\n",
+        "                               strings.Join([root, \"source1\"], \"\"),\n",
+        "                               strings.Join([root, \"destination1\"], \"\")) != 0) {\n",
+        "            return 1;\n        }\n    }\n    return 0;\n}\n"
+    ]);
+}
+PolicyPairProof :: (stage: string, proof: string) -> bool {
+    host := Join([proof, "/prefix/libexec/chibi/chibi-build-host"]);
+    work := Join([proof, "/work"]);
+    source := Join([proof, "/PairProbe.chibi"]);
+    artifact := Join([proof, "/payload/PairProbe.chibip"]);
+    if (length(build.list_directory(work)) != 0 ||
+        !build.write_file(source, PolicyPairSource()) ||
+        !PolicyExport(stage, source, "Verify", artifact)) {
+        return false;
+    }
+    hash := build.hash_file(artifact);
+    if (!PolicyHash(hash) || !build.remove(source) || build.file_kind(source) != "") {
+        return false;
+    }
+    // The parent seeds and later inspects the files. A child that returns zero
+    // without executing the native cannot satisfy these observed transitions.
+    for (name in ["00", "10", "01", "11"]) {
+        directory := Join([work, "/", name]);
+        if (!build.reserve_directory(directory) ||
+            !build.write_file(Join([directory, "/source0"]), Join(["new0:", name, "\n"])) ||
+            !build.write_file(Join([directory, "/source1"]), Join(["new1:", name, "\n"]))) {
+            return false;
+        }
+        if (strings.HasPrefix(name, "1") &&
+            !build.write_file(Join([directory, "/destination0"]), Join(["old0:", name, "\n"]))) {
+            return false;
+        }
+        if (strings.HasSuffix(name, "1") &&
+            !build.write_file(Join([directory, "/destination1"]), Join(["old1:", name, "\n"]))) {
+            return false;
+        }
+    }
+    if (PolicyRun(host, work, artifact, "Verify", []) != 0 ||
+        build.last_stdout() != "" || build.last_stderr() != "" ||
+        build.hash_file(artifact) != hash || build.file_kind(source) != "") {
+        return false;
+    }
+    for (name in ["00", "10", "01", "11"]) {
+        directory := Join([work, "/", name]);
+        if (build.join(build.list_directory(directory), "\n") != "destination0\ndestination1" ||
+            build.file_kind(Join([directory, "/source0"])) != "" ||
+            build.file_kind(Join([directory, "/source1"])) != "" ||
+            build.file_kind(Join([directory, "/destination0"])) != "file" ||
+            build.file_kind(Join([directory, "/destination1"])) != "file" ||
+            build.read_file(Join([directory, "/destination0"])) != Join(["new0:", name, "\n"]) ||
+            build.read_file(Join([directory, "/destination1"])) != Join(["new1:", name, "\n"]) ||
+            !RemoveTree(directory)) {
+            return false;
+        }
+    }
+    if (length(build.list_directory(work)) != 0 || build.hash_file(artifact) != hash) {
+        return false;
+    }
+    build.report(Join(["sdk: prepared publish-pair probe ", hash]));
+    return true;
+}
