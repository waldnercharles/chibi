package named_binding

import binding "project:lexical_binding"
import syntax "project:syntax_diagnostics"
import strings "core:strings"

// All tables contain analyzer/catalog facts. A negative ID slot denotes zero;
// symbol_types is aligned with the lexical symbol table. Nonnegative indices
// and spans retain the owning analyzer's structural invariants.
Type :: struct { storage: int; container: int; flags: int; nominal_slot: int; parameter_slot: int; }
Entry :: struct {
    name: string;
    source_name: string;
    key: string;
    id_slot: int;
    type: int;
    has_source_name: bool;
    has_key: bool;
    internal: bool;
    component: bool;
}
Import :: struct {
    alias: string;
    identity: string;
    document: int;
    export_start: int;
    export_count: int;
    has_alias: bool;
}
Export :: struct { name: string; kind: int; id_slot: int; }
Use :: struct { kind: int; symbol: int; member_slot: int; start: int; end: int; line: int; column: int; document: int; }
Request :: struct { text: string; scope: int; start: int; end: int; line: int; column: int; document: int; }
TypeUse :: union { Absent | Reference(symbol: int, member: uint64, start: int, end: int, line: int, column: int, document: int) }
Resolution :: union {
    Resolved(storage: int, container: int, flags: int, nominal: uint64,
             parameter: uint64, use: TypeUse, diagnostics: syntax.Diagnostic[])
}
Environment :: union {
    Tables(lexical: binding.Environment, types: Type[], ids: uint64[],
           merged: Entry[], own: Entry[], native: Entry[], symbol_types: int[],
           imports: Import[], exports: Export[], uses: Use[], identity: string,
           package_scope: int, has_native: bool, has_documents: bool, entity_id: uint64)
}
Value :: union { Typed(storage: int, container: int, flags: int, nominal: uint64, parameter: uint64) }

IDAt :: pure fn(ids: uint64[], slot: int) -> uint64 {
    if (slot < 0) { return uint64(0); }
    return ids[slot];
}
TypeAt :: pure fn(types: Type[], ids: uint64[], index: int) -> Value {
    type := types[index];
    return Value.Typed(type.storage, type.container, type.flags,
                       IDAt(ids, type.nominal_slot), IDAt(ids, type.parameter_slot));
}
Builtin :: pure fn(name: string) -> Value {
    if (name == "Cancelled") {
        return Value.Typed(18, 0, 512, uint64(0x63616e63656c6c65), uint64(0));
    }
    names: string[] = ["void", "bool", "int8", "byte", "int16", "uint16", "int", "uint",
                       "int64", "uint64", "float", "double", "name", "string", "handle", "struct", "enum"];
    index: int = 0;
    while (index < length(names)) {
        if (names[index] == name) { return Value.Typed(index, 0, 0, uint64(0), uint64(0)); }
        index += 1;
    }
    if (name == "number") { return Value.Typed(11, 0, 0, uint64(0), uint64(0)); }
    if (name == "exec" || name == "flow") { return Value.Typed(0, 0, 0, uint64(0), uint64(0)); }
    if (name == "entity") { return Value.Typed(14, 0, 0, binding.ID("type", "ecs.entity"), uint64(0)); }
    if (name == "task") { return Value.Typed(17, 0, 64, uint64(0), uint64(0)); }
    if (name == "any") { return Value.Typed(0, 0, 16, uint64(0), uint64(0)); }
    return Value.Typed(0, 0, 1, uint64(0), uint64(0));
}
Bad :: pure fn(value: Value) -> bool {
    switch value { case .Typed(storage, container, flags, nominal, parameter): return (flags & 1) != 0; }
}
WithNominal :: pure fn(value: Value, id: uint64) -> Value {
    switch value { case .Typed(storage, container, flags, nominal, parameter): return Value.Typed(storage, container, flags, id, parameter); }
}

// Catalog spelling compatibility is byte based: ASCII case plus ignored
// underscores, spaces and hyphens. UTF-8 bytes remain unchanged.
Next :: pure fn(text: string, index: int) -> int {
    current := index;
    byte := strings.ByteAt(text, current);
    while (byte == 95 || byte == 32 || byte == 45) {
        current += 1;
        byte = strings.ByteAt(text, current);
    }
    return current;
}
FoldByte :: pure fn(byte: int) -> int {
    if (byte < 0) { return 0; }
    if (byte >= 65 && byte <= 90) { return byte + 32; }
    return byte;
}
Matches :: pure fn(left: string, right: string) -> bool {
    a: int = 0;
    b: int = 0;
    while (true) {
        a = Next(left, a);
        b = Next(right, b);
        x := FoldByte(strings.ByteAt(left, a));
        y := FoldByte(strings.ByteAt(right, b));
        if (x != y) { return false; }
        if (x == 0) { return true; }
        a += 1;
        b += 1;
    }
}
ShortName :: pure fn(name: string) -> string {
    start: int = 0;
    index: int = 0;
    count := strings.ByteLength(name);
    while (index < count) {
        if (strings.ByteAt(name, index) == 46) { start = index + 1; }
        index += 1;
    }
    return strings.Slice(name, start, count - start);
}
FindCatalog :: pure fn(entries: Entry[], name: string) -> int {
    found: int = -1;
    index: int = 0;
    while (index < length(entries)) {
        item := entries[index];
        if (!item.internal) {
            if (item.name == name) { return index; }
            if (Matches(item.name, name) || Matches(ShortName(item.name), name) ||
                (item.has_source_name && Matches(item.source_name, name)) ||
                (item.has_key && Matches(item.key, name))) {
                if (found >= 0) { found = -2; }
                if (found != -2) { found = index; }
            }
        }
        index += 1;
    }
    return found;
}
TypeIndex :: pure fn(entries: Entry[], ids: uint64[], id: uint64) -> int {
    index: int = 0;
    while (index < length(entries)) {
        if (IDAt(ids, entries[index].id_slot) == id) { return index; }
        index += 1;
    }
    return -1;
}
Namespace :: pure fn(environment: Environment, scope: int, document: int, name: string) -> int {
    switch environment {
        case .Tables(lexical, types, ids, merged, own, native, symbol_types, imports, exports, uses,
                     identity, package_scope, has_native, has_documents, entity_id):
            if (!has_documents) { return -1; }
            dot: int = 0;
            count := strings.ByteLength(name);
            while (dot < count && strings.ByteAt(name, dot) != 46) { dot += 1; }
            if (dot == 0 || dot == count) { return -1; }
            alias := strings.Slice(name, 0, dot);
            index: int = 0;
            while (index < length(imports)) {
                imported := imports[index];
                if (imported.document == document && imported.has_alias && imported.alias == alias && alias != "_") {
                    local := binding.FindName(lexical, scope, alias);
                    if (local < 0) { local = binding.FindCallable(lexical, scope, alias); }
                    switch lexical {
                        case .Tables(scopes, symbols, functions, lexical_ids, keys):
                            if (local >= 0 && symbols[local].scope > package_scope) { return -1; }
                    }
                    return index;
                }
                index += 1;
            }
            return -1;
    }
}
FindType :: pure fn(environment: Environment, scope: int, document: int, name: string) -> int {
    importedIndex := Namespace(environment, scope, document, name);
    switch environment {
        case .Tables(lexical, types, ids, merged, own, native, symbol_types, imports, exports, uses,
                     identity, package_scope, has_native, has_documents, entity_id):
            if (importedIndex >= 0) {
                dot: int = 0;
                while (strings.ByteAt(name, dot) != 46) { dot += 1; }
                member := strings.Slice(name, dot + 1, strings.ByteLength(name) - dot - 1);
                imported := imports[importedIndex];
                if (imported.identity == identity) {
                    switch lexical {
                        case .Tables(scopes, symbols, functions, lexical_ids, keys):
                            index: int = 0;
                            while (index < length(symbols)) {
                                symbol := symbols[index];
                                if (symbol.scope == package_scope && symbol.kind == 13 && symbol.name == member) {
                                    return TypeIndex(merged, ids, IDAt(lexical_ids, symbol.id_slot));
                                }
                                index += 1;
                            }
                    }
                    return -1;
                }
                index := imported.export_start;
                end := index + imported.export_count;
                while (index < end) {
                    exported := exports[index];
                    if (exported.kind == 1 && exported.name == member) {
                        return TypeIndex(merged, ids, IDAt(ids, exported.id_slot));
                    }
                    index += 1;
                }
                return -1;
            }
            if (!has_native) { return FindCatalog(merged, name); }
            found := FindCatalog(own, name);
            if (found >= 0) { return TypeIndex(merged, ids, IDAt(ids, own[found].id_slot)); }
            if (found == -2) { return found; }
            found = FindCatalog(native, name);
            if (found >= 0) { return TypeIndex(merged, ids, IDAt(ids, native[found].id_slot)); }
            return found;
    }
}
UseAt :: pure fn(environment: Environment, request: Request, symbol: int, nominal: uint64) -> TypeUse {
    if (symbol < 0 && nominal == uint64(0)) { return TypeUse.Absent; }
    switch environment {
        case .Tables(lexical, types, ids, merged, own, native, symbol_types, imports, exports, uses,
                     identity, package_scope, has_native, has_documents, entity_id):
            foreach (use in uses) {
                if (use.kind == 4 && use.symbol == symbol && IDAt(ids, use.member_slot) == nominal &&
                    use.document == request.document && use.start == request.start && use.end == request.end) {
                    return TypeUse.Absent;
                }
            }
            return TypeUse.Reference(symbol, nominal, request.start, request.end, request.line, request.column, request.document);
    }
}
Complete :: pure fn(environment: Environment, request: Request, value: Value, symbol: int,
                    diagnostics: syntax.Diagnostic[], tokens: string[], forced_container: int, added_flags: int) -> Resolution {
    switch value {
        case .Typed(storage, original_container, original_flags, nominal, parameter):
            container := original_container;
            flags := original_flags | added_flags;
            if (forced_container >= 0) { container = forced_container; }
            foreach (token in tokens) {
                if (token == "ref") { flags = flags | 4; }
                if (token == "?") { flags = flags | 2; }
                if (token == "[" || token == "[]") { container = 1; }
            }
            use := TypeUse.Absent;
            if ((flags & 1) == 0) {
                useNominal := nominal;
                if (symbol >= 0) { useNominal = uint64(0); }
                use = UseAt(environment, request, symbol, useNominal);
            }
            if ((flags & 2) != 0) {
                switch environment {
                    case .Tables(lexical, types, ids, merged, own, native, symbol_types, imports, exports, uses,
                                 identity, package_scope, has_native, has_documents, entity_id):
                        found := TypeIndex(merged, ids, nominal);
                        if (found < 0 || !merged[found].component) { flags = flags | 2048; }
                }
            }
            return Resolution.Resolved(storage, container, flags, nominal, parameter, use, diagnostics);
    }
}
BindName :: pure fn(environment: Environment, request: Request, name: string,
                    parsed: bool, tokens: string[], forced_container: int, added_flags: int) -> Resolution {
    value := Builtin(name);
    diagnostics: syntax.Diagnostic[] = [];
    switch environment {
        case .Tables(lexical, types, ids, merged, own, native, symbol_types, imports, exports, uses,
                     identity, package_scope, has_native, has_documents, entity_id):
            symbol := binding.FindName(lexical, request.scope, name);
            replaced := false;
            if (parsed || Bad(value)) {
                switch lexical {
                    case .Tables(scopes, symbols, functions, lexical_ids, keys):
                        if (symbol >= 0 && (symbols[symbol].kind == 12 || symbols[symbol].kind == 13)) {
                            value = TypeAt(types, ids, symbol_types[symbol]);
                            replaced = true;
                        }
                }
            }
            if (!replaced && Bad(value)) {
                found := FindType(environment, request.scope, request.document, name);
                if (found >= 0) {
                    value = WithNominal(TypeAt(types, ids, merged[found].type), IDAt(ids, merged[found].id_slot));
                } else {
                    message_prefix := "Unknown";
                    if (found == -2) { message_prefix = "Ambiguous"; }
                    diagnostic: syntax.Diagnostic = {
                        start: request.start, end: request.end, line: request.line,
                        column: request.column, document: request.document,
                        message: strings.Slice(format_text("{} type '{}'", message_prefix, name), 0, 191)
                    };
                    diagnostics = array_add(diagnostics, diagnostic);
                }
            }
            if (name == "entity" && entity_id != uint64(0)) { value = WithNominal(value, entity_id); }
            useSymbol: int = -1;
            switch lexical {
                case .Tables(scopes, symbols, functions, lexical_ids, keys):
                    if (symbol >= 0 && symbols[symbol].kind == 12) { useSymbol = symbol; }
            }
            return Complete(environment, request, value, useSymbol, diagnostics, tokens, forced_container, added_flags);
    }
}
// Parsed names are decoded ordinary type leaves. Constructor arguments,
// structural union/task assembly and measured signatures remain separate.
Parsed :: pure fn(environment: Environment, request: Request, tokens: string[]) -> Resolution {
    return BindName(environment, request, request.text, true, tokens, -1, 0);
}
Whitespace :: pure fn(byte: int) -> bool {
    return byte == 32 || (byte >= 9 && byte <= 13);
}
Text :: pure fn(environment: Environment, request: Request) -> Resolution {
    name := "";
    index: int = 0;
    count := strings.ByteLength(request.text);
    while (index < count) {
        if (!Whitespace(strings.ByteAt(request.text, index))) {
            name = format_text("{}{}", name, strings.Slice(request.text, index, 1));
        }
        index += 1;
    }
    flags: int = 0;
    count = strings.ByteLength(name);
    if (strings.Slice(name, 0, 3) == "ref" && count > 3) {
        name = strings.Slice(name, 3, count - 3);
        count -= 3;
        flags = flags | 4;
    }
    if (count > 0 && strings.ByteAt(name, count - 1) == 63) {
        count -= 1;
        name = strings.Slice(name, 0, count);
        flags = flags | 2;
    }
    container: int = 0;
    if (count >= 2 && strings.Slice(name, count - 2, 2) == "[]") {
        count -= 2;
        name = strings.Slice(name, 0, count);
        container = 1;
    }
    prefixes: string[] = ["set<", "map<", "array<"];
    containers: int[] = [int(2), int(3), int(1)];
    index = 0;
    while (index < length(prefixes)) {
        prefix := prefixes[index];
        size := strings.ByteLength(prefix);
        if (strings.Slice(name, 0, size) == prefix && count > size && strings.ByteAt(name, count - 1) == 62) {
            container = containers[index];
            count -= size + 1;
            name = strings.Slice(name, size, count);
            break;
        }
        index += 1;
    }
    if ((strings.Slice(name, 0, 7) == "struct<" || strings.Slice(name, 0, 7) == "handle<") &&
        count > 7 && strings.ByteAt(name, count - 1) == 62) {
        name = strings.Slice(name, 7, count - 8);
    } else if (strings.Slice(name, 0, 5) == "enum<" && count > 5 && strings.ByteAt(name, count - 1) == 62) {
        name = strings.Slice(name, 5, count - 6);
    }
    if (strings.ByteAt(name, 0) == 34) {
        decoded := compiler_json_string(name);
        // Legacy fallback copies the decoded C-string prefix, including when
        // JSON contains NUL. Parsed-name validation is a different entry path.
        if (decoded.valid) { name = decoded.value; }
    }
    tokens: string[] = [];
    return BindName(environment, request, name, false, tokens, container, flags);
}
