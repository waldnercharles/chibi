package facts

// single named result
@test
Calls :: () {
    a3_0: int = 3;
    r3: int = Use(a3_0);
    e3: int = 44;
    assert(r3 == e3, "Use call 3");
}

@test
Records :: () {
    assert(One(3).value == 4, "One");
    pair := Sequential();
    assert(pair.a == 2 && pair.b == 2, "Sequential");
}
