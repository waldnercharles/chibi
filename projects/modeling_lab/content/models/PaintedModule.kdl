version 3
name "PaintedModule"
domain "model"
id_counter 61
description "Painted body, metal insert and emissive cap. A cylindrical cut inherits the painted left operand's material; a smooth join uses its dominant operand."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - id=3 type="Model Material Slot" reference_name="Body" reference_asset="ModelBluePaint"
            - id=5 type="Model Material Slot" reference_name="Insert" reference_asset="ModelBrass"
            - id=7 type="Model Material Slot" reference_name="Signal" reference_asset="ModelSignal"
            - {
                id 9
                type "Model Rounded Box"
                inputs {
                    "Half Size" {
                        default x=26.0 y=15.0 z=19.0
                    }
                    Radius 3.0
                }
            }
            - id=13 type="Model Part" reference_name="Painted body"
            - {
                id 17
                type "Model Cylinder"
                inputs Radius=8.0 "Half Height"=22.0
            }
            - {
                id 21
                type "Model Translate"
                inputs {
                    Offset {
                        default x=-10.0 y=0.0 z=0.0
                    }
                }
            }
            - id=25 type="Model Difference"
            - {
                id 29
                type "Model Sphere"
                inputs Radius=13.0
            }
            - id=32 type="Model Part" reference_name="Metal insert"
            - {
                id 36
                type "Model Translate"
                inputs {
                    Offset {
                        default x=23.0 y=6.0 z=0.0
                    }
                }
            }
            - {
                id 40
                type "Model Smooth Union"
                inputs Smoothness=5.0
            }
            - {
                id 45
                type "Model Cylinder"
                inputs Radius=5.0 "Half Height"=4.0
            }
            - id=49 type="Model Part" reference_name="Signal cap"
            - {
                id 53
                type "Model Translate"
                inputs {
                    Offset {
                        default x=5.0 y=17.0 z=9.0
                    }
                }
            }
            - id=57 type="Model Union"
        }
        (array)edges {
            - from="3.Slot" to="13.Material"
            - from="5.Slot" to="32.Material"
            - from="7.Slot" to="49.Material"
            - from="9.Geometry" to="13.Geometry"
            - from="13.Geometry" to="25.A"
            - from="17.Geometry" to="21.Geometry"
            - from="21.Geometry" to="25.B"
            - from="25.Geometry" to="40.A"
            - from="29.Geometry" to="32.Geometry"
            - from="32.Geometry" to="36.Geometry"
            - from="36.Geometry" to="40.B"
            - from="40.Geometry" to="57.A"
            - from="45.Geometry" to="49.Geometry"
            - from="49.Geometry" to="53.Geometry"
            - from="53.Geometry" to="57.B"
            - from="57.Geometry" to="1.Geometry"
        }
    }
}
