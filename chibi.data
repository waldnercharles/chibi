rcss: |
  body {
    position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp;
    display: flex; overflow: auto;
  }
  .dialog-backdrop { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; background-color: #0000008c; }
  .dialog-panel {
    position: relative; margin: auto; padding: 12dp; color: var(--foreground); background-color: var(--popover);
    border: 1dp var(--popover-edge); border-radius: var(--r-lg);
  }
rml: |
  <div data-keys="Enter:Choose Space:Choose Down:Next Up:Previous" autofocus>
    <div class="menu-group">Wires</div>
    <use ui="MenuOption" data-checked="save.wires" value="curved">Curved</use>
    <use ui="MenuOption" data-checked="save.wires" value="orthogonal">Orthogonal</use>
    <use ui="MenuOption" data-checked="save.wires" value="straight">Straight</use>
    <use ui="MenuOption" data-checked="save.wires" value="subway">Subway</use>
    <div class="menu-sep"/>
    <div class="menu-group">Nodes</div>
    <use ui="MenuCheck" data-checked="save.shortBindings">Short Bindings</use>
    <use ui="MenuCheck" data-checked="save.titleFlow">Flow in Titles</use>
    <use ui="MenuCheck" data-checked="save.compactNodes">Compact Nodes</use>
  </div>
rml: <label class="menu-item menu-check"><input type="checkbox" attrs/><span class="icon lead">&#xeab2;</span><span class="label"><slot/></span></label>
rcss: |
  .menu-check { position: relative; tab-index: auto; }
  .menu-check input { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; tab-index: none; }
  .menu-check .lead { opacity: 0; }
  .menu-check input:checked ~ .lead { opacity: 1; }
  .menu-check:hover { background-color: var(--primary); color: var(--primary-foreground); }
  .menu-check:hover .lead { color: var(--primary-foreground); }
  .menu-check:focus-visible { background-color: var(--primary); color: var(--primary-foreground); }
  .menu-check:focus-visible .lead { color: var(--primary-foreground); }
rml: <label class="menu-item menu-option"><input type="radio" attrs/><span class="icon lead">&#xeab2;</span><span class="label"><slot/></span></label>
rcss: |
  .menu-option { position: relative; tab-index: auto; }
  .menu-option input { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; tab-index: none; }
  .menu-option .lead { opacity: 0; }
  .menu-option input:checked ~ .lead { opacity: 1; }
  .menu-option:hover { background-color: var(--primary); color: var(--primary-foreground); }
  .menu-option:hover .lead { color: var(--primary-foreground); }
  .menu-option:focus-visible { background-color: var(--primary); color: var(--primary-foreground); }
  .menu-option:focus-visible .lead { color: var(--primary-foreground); }
rml: |
  <div class="caption">{{ world.title }}</div>
  <div class="prop" data-for="row : world.saved">
    <div class="label">{{ row.key }}</div>
    <div class="control"><use ui="TextField" data-alias-text="row.value"/></div>
  </div>
  <div class="empty" data-if="world.saved.size == 0">No saved keys</div>
rcss: |
  .caption { display: block; height: var(--h); line-height: var(--h); color: var(--muted-foreground); }
  .empty { display: block; padding: 12dp 0dp; color: var(--faint-foreground); text-align: center; }
rml: |
  <use ui="Dialog" data-keys="Escape:Close Enter:Choose Space:Choose Down:Next Up:Previous" autofocus>
    <div class="title">Settings</div>
    <div class="columns">
      <div class="column">
        <div class="menu-group">Theme</div>
        <use ui="MenuOption" data-checked="save.theme" value="system">System</use>
        <use ui="MenuOption" data-checked="save.theme" value="dark">Dark</use>
        <use ui="MenuOption" data-checked="save.theme" value="light">Light</use>
        <div class="menu-sep"/>
        <div class="menu-group">Density</div>
        <use ui="MenuOption" data-checked="save.density" value="compact">Compact</use>
        <use ui="MenuOption" data-checked="save.density" value="comfortable">Comfortable</use>
        <div class="menu-sep"/>
        <use ui="MenuCheck" data-checked="save.reduceMotion">Reduce Motion</use>
      </div>
      <div class="column">
        <div class="menu-group">Graph Wires</div>
        <use ui="MenuOption" data-checked="save.wires" value="curved">Curved</use>
        <use ui="MenuOption" data-checked="save.wires" value="orthogonal">Orthogonal</use>
        <use ui="MenuOption" data-checked="save.wires" value="straight">Straight</use>
        <use ui="MenuOption" data-checked="save.wires" value="subway">Subway</use>
        <div class="menu-sep"/>
        <div class="menu-group">Graph Nodes</div>
        <use ui="MenuCheck" data-checked="save.shortBindings">Short Bindings</use>
        <use ui="MenuCheck" data-checked="save.titleFlow">Flow in Titles</use>
        <use ui="MenuCheck" data-checked="save.compactNodes">Compact Nodes</use>
      </div>
    </div>
  </use>
rcss: |
  .title { display: block; padding: 2dp 6dp 10dp; font-size: 14dp; font-weight: 600; color: var(--foreground); }
  .columns { display: flex; gap: 12dp; }
  .column { display: block; width: 200dp; }
rml: |
  <body data-class-dark="save.theme == 'dark' || (save.theme == 'system' && system.dark)" data-class-comfortable="save.density == 'comfortable'"><slot/></body>
rcss: |
  /* The Studio scene's page, and so the editor's theme: shadcn/ui's tokens,
     the editor's roles derived from them, and the control styles every Studio
     document shares, in import order. Ported from
     docs/prototypes/studio/kit.css; differences from the web source: dp units,
     seconds for durations, named tweens, borders without a style keyword, and
     no outline. Documents size and paint their own body. */
  @import "theme/base.rcss";
  @import "theme/tokens.rcss";
  @import "theme/roles.rcss";
  @import "theme/button.rcss";
  @import "theme/field.rcss";
  @import "theme/panel.rcss";
  @import "theme/popup.rcss";
  @import "theme/command.rcss";
  @import "theme/tree.rcss";
  @import "theme/toast.rcss";
  @import "theme/motion.rcss";
  @import "theme/list.rcss";
  @import "theme/code.rcss";
  @import "theme/drag.rcss";
  @import "theme/chart.rcss";
rml: <div class="field text"><input type="text" class="value" data-value-lazy="text"/></div>
rcss: 'body { display: flex; flex: 1 1 0dp; }'
rml: |
  <div class="panel" data-open="" data-for="section : theme.sections">
    <div class="panel-head">
      <span class="title">{{ section.file }}</span>
      <span class="badge">{{ section.selector }}</span>
    </div>
    <div class="panel-body">
      <div class="prop" data-for="row : section.rows">
        <div class="label">{{ row.name }}</div>
        <div class="control">
          <use ui="ColorField" data-if="row.color" data-alias-color="row.value"/>
          <use ui="TextField" data-if="!row.color" data-alias-text="row.value"/>
        </div>
      </div>
    </div>
  </div>
  <div class="empty" data-if="theme.sections.size == 0">No theme</div>
rcss: |
  .panel-head .badge { margin-left: auto; }
  .empty { display: block; padding: 12dp 0dp; color: var(--faint-foreground); text-align: center; }
rml: |
  <div class="gallery">
    <div class="menu-group">MenuOption</div>
    <use ui="MenuOption" value="first">First</use>
    <use ui="MenuOption" value="second">Second</use>
    <div class="menu-sep"/>
    <div class="menu-group">MenuCheck</div>
    <use ui="MenuCheck">Check</use>
  </div>
rcss: |
  .gallery { display: block; width: 220dp; }
/* Resets, text helpers and scrollbars. */
* { box-sizing: border-box; }
div, section, header, nav, main, footer, p { display: block; }
body { font-family: Inter; font-size: 12dp; line-height: 16dp; color: var(--foreground); }

.icon { font-family: Symbols; font-size: 14dp; line-height: 16dp; width: 16dp; text-align: center; display: inline-block; color: var(--muted-foreground); }
.icon.sm { font-size: 12dp; width: 12dp; }
.dim { color: var(--faint-foreground); }
.muted { color: var(--muted-foreground); }
.spacer { flex: 1 1 0dp; }
.row { display: flex; align-items: center; gap: 6dp; }

scrollbarvertical { width: 8dp; margin-left: 0dp; }
scrollbarvertical slidertrack { background-color: transparent; }
scrollbarvertical sliderbar { margin: 2dp; border-radius: 3dp; background-color: var(--scrollbar); }
scrollbarvertical sliderbar:hover { background-color: var(--scrollbar-hover); }
scrollbarhorizontal { height: 8dp; }
scrollbarhorizontal sliderbar { margin: 2dp; border-radius: 3dp; background-color: var(--scrollbar); }
scrollbarcorner { background-color: transparent; }
/* Button — ghost (default), subtle, primary, outline, danger. */
.btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6dp;
    height: var(--h); padding: 0dp 8dp; border-radius: var(--r); white-space: nowrap;
    color: var(--muted-foreground); background-color: transparent; border: 1dp transparent;
    tab-index: auto;
    transition: background-color color 0.11s cubic-out;
}
.btn .label { white-space: nowrap; }
.btn:hover { background-color: var(--accent); color: var(--foreground); }
.btn:hover .icon { color: var(--foreground); }
.btn:active, .btn[data-pressed] { background-color: var(--press); color: var(--foreground); }
.btn[data-disabled] { opacity: 0.38; }
.btn:focus-visible { border-color: var(--ring); }
.btn.subtle { background-color: var(--secondary); color: var(--foreground); }
.btn.subtle:hover { background-color: var(--field-hover); }
.btn.primary { background-color: var(--primary); color: var(--primary-foreground); }
.btn.primary .icon { color: var(--primary-foreground); }
.btn.primary:hover { background-color: var(--primary-hover); }
.btn.outline { border-color: var(--border); color: var(--foreground); }
.btn.danger { color: var(--destructive); }
.btn.icon-only { width: var(--h); padding: 0dp; }
.btn.sm { height: var(--h-sm); font-size: 11dp; padding: 0dp 6dp; }
.btn.sm.icon-only { width: var(--h-sm); padding: 0dp; }
.btn[data-state=on] { background-color: var(--primary-soft); color: var(--foreground); }
.btn[data-state=on] .icon { color: var(--primary-text); }

/* Toggle group — Blender's expanded enum. */
.segmented { display: flex; height: var(--h); background-color: var(--secondary); border-radius: var(--r); flex: 1 1 0dp; }
.segmented .seg {
    display: block; text-align: center; line-height: var(--h); flex: 1 1 0dp;
    padding: 0dp 8dp; color: var(--muted-foreground); border-left: 1dp var(--edge); white-space: nowrap;
    transition: background-color 0.11s cubic-out;
}
.segmented .seg:first-child { border-left: 0dp; border-radius: 4dp 0dp 0dp 4dp; }
.segmented .seg:last-child { border-radius: 0dp 4dp 4dp 0dp; }
.segmented .seg:hover { background-color: var(--field-hover); color: var(--foreground); }
.segmented .seg[data-pressed] { background-color: var(--primary); color: var(--primary-foreground); }
.segmented[data-readonly] { opacity: 0.6; }
/* Charts (Liveline): the element draws series in `color` and the grid in
   `border-color`; labels are positioned by the kit. */
kit-chart { display: block; position: relative; color: var(--primary-text); border-color: var(--line); border-width: 0dp; }
.chart-tick { position: absolute; left: 4dp; font-size: 10dp; line-height: 14dp; color: var(--faint-foreground); pointer-events: none; font-family: InterNumeric; }
.chart-badge { position: absolute; right: 4dp; height: 18dp; line-height: 18dp; padding: 0dp 6dp; border-radius: 9dp; background-color: var(--primary); color: var(--primary-foreground); font-size: 10dp; font-family: InterNumeric; pointer-events: none; }
.chart-hover { position: absolute; top: 4dp; height: 18dp; line-height: 18dp; padding: 0dp 6dp; border-radius: var(--r); background-color: var(--tooltip); border: 1dp var(--tooltip-edge); color: var(--foreground); font-size: 10dp; font-family: InterNumeric; pointer-events: none; }
body:not(.dark) .chart-hover { color: #fafafa; }
/* Code tokens (Shiki classes). */
.tok-number { color: var(--tok-number); }
.tok-string { color: var(--tok-string); }
.tok-keyword { color: var(--tok-keyword); }
.tok-name { color: var(--tok-name); }
.tok-path { color: var(--tok-path); }
.tok-punct { color: var(--tok-punct); }
.tok-muted { color: var(--faint-foreground); }
.tok-error { color: var(--destructive); }
.tok-warning { color: var(--warning); }
/* Command (cmdk). */
.command-backdrop { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; background-color: var(--backdrop); pointer-events: auto; z-index: 29; opacity: 1; transition: opacity 0.16s cubic-out; }
.command-backdrop[data-starting-style], .command-backdrop[data-ending-style] { opacity: 0; }
.command {
    position: absolute; left: 50%; top: 88dp; width: 600dp; margin-left: -300dp; background-color: var(--popover);
    border: 1dp var(--popover-edge); border-radius: 8dp; display: block; pointer-events: auto;
    z-index: 30;
    opacity: 1; margin-top: 0dp; transition: opacity margin-top 0.16s cubic-out;
}
.command[data-starting-style], .command[data-ending-style] { opacity: 0; margin-top: -6dp; }
.command[data-ending-style] { transition: opacity margin-top 0.1s cubic-in; }
.cmd-input { display: flex; align-items: center; gap: 8dp; height: 44dp; padding: 0dp 12dp; border-bottom: 1dp var(--border); }
.cmd-input .icon { font-size: 15dp; color: var(--faint-foreground); }
.cmd-input input { flex: 1 1 0dp; font-size: 14dp; height: 20dp; color: var(--foreground); }
.cmd-list { display: block; max-height: 360dp; overflow-y: auto; padding: 4dp 6dp 6dp; }
.cmd-group { height: 26dp; display: block; padding: 10dp 6dp 0dp; font-size: 11dp; color: var(--faint-foreground); }
.cmd-item { display: flex; align-items: center; gap: 10dp; height: 32dp; padding: 0dp 8dp; border-radius: 5dp; color: var(--foreground); }
.cmd-item .text { display: block; flex: 1 1 0dp; overflow: hidden; }
.cmd-item .label { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* A description is a muted second line under the label. */
.cmd-item .about { display: none; font-size: 11dp; line-height: 14dp; color: var(--faint-foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cmd-item[data-described] { height: 42dp; }
.cmd-item[data-described] .about { display: block; }
.cmd-item .label b { font-weight: 600; color: var(--strong); }
.cmd-item .meta { color: var(--faint-foreground); font-size: 11dp; white-space: nowrap; }
.cmd-item[data-selected] { background-color: var(--item-selected); }
.cmd-empty { height: 64dp; line-height: 64dp; display: block; text-align: center; color: var(--faint-foreground); }
.cmd-footer { display: flex; align-items: center; gap: 4dp; height: 32dp; padding: 0dp 12dp; border-top: 1dp var(--border); color: var(--faint-foreground); font-size: 11dp; }
.cmd-footer .hint { margin-right: 10dp; }

/* Color picker popover: vertex gradients need no shader support. */
.popup.picker { width: 232dp; padding: 8dp; }
.picker .sv { position: relative; height: 150dp; border-radius: 4dp; drag: drag; cursor: crosshair; }
.picker .sv-white { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; border-radius: 4dp; decorator: horizontal-gradient(#ffffffff #ffffff00); }
.picker .sv-black { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; border-radius: 4dp; decorator: vertical-gradient(#00000000 #000000ff); }
.picker .sv .puck { position: absolute; width: 10dp; height: 10dp; margin: -5dp 0dp 0dp -5dp; border-radius: 5dp; border: 2dp #ffffff; }
.picker .hue { position: relative; display: flex; height: 12dp; border-radius: 3dp; margin-top: 8dp; drag: drag; }
.picker .hue-seg { flex: 1 1 0dp; height: 100%; }
.picker .hue .puck { position: absolute; top: 0dp; bottom: 0dp; width: 4dp; margin-left: -2dp; background-color: #ffffff; border-radius: 1dp; }
.picker .hexrow { margin-top: 8dp; }
.picker .hexrow input.value { width: 100%; font-family: InterNumeric; }
/* Drag and drop (dnd-kit): the overlay follows the pointer; targets light up. */
.drag-overlay {
    position: absolute; display: flex; align-items: center; gap: 6dp; height: 24dp; padding: 0dp 8dp;
    background-color: var(--popover); border: 1dp var(--popover-edge); border-radius: var(--r); color: var(--foreground);
    pointer-events: none; z-index: 45; white-space: nowrap; opacity: 0.92;
    transition: opacity 0.12s cubic-out;
}
.drag-overlay[data-starting-style], .drag-overlay[data-ending-style] { opacity: 0; }
.drag-overlay .label { display: block; line-height: 16dp; }
.drag-overlay[data-over] { border-color: var(--primary); }
[data-dragging] { opacity: 0.5; }
[data-drop-over] { background-color: var(--primary-soft); }
.tree-row[data-drop-over] { border-color: var(--primary); }
/* Field shell (shadcn Input Group): addon, value, unit, stepper arrows. */
.field {
    position: relative; display: flex; align-items: center; height: var(--h); flex: 1 1 0dp;
    background-color: var(--secondary); border-radius: var(--r); color: var(--foreground); overflow: hidden;
    border: 1dp transparent;
    transition: background-color 0.11s cubic-out;
}
.field:hover { background-color: var(--field-hover); }
.field[data-disabled] { opacity: 0.45; }
.field[data-readonly] { background-color: transparent; border-color: var(--border); }
.field[data-readonly] .step { display: none; }
.field[data-editing] { background-color: var(--field-edit); border-color: var(--ring); }
.field[data-invalid] { border-color: var(--destructive); }
.field[data-scrubbing] { background-color: var(--field-press); }
.field:focus-visible { border-color: var(--ring); }
.field.number { tab-index: auto; drag: drag; cursor: ew-resize; }
.field .fill { position: absolute; left: 0dp; top: 0dp; bottom: 0dp; background-color: var(--fill); pointer-events: none; }
.field:hover .fill, .field[data-scrubbing] .fill { background-color: var(--fill-hover); }
.field .mark { position: absolute; left: 0dp; top: 3dp; bottom: 3dp; width: 2dp; border-radius: 1dp; background-color: transparent; }
.field[data-overridden] .mark { background-color: var(--override); }
.field .part { position: relative; display: block; height: var(--text-line); line-height: var(--text-line); }
.field .addon { padding-left: 7dp; color: var(--faint-foreground); flex: 0 0 auto; }
.field .addon.x { color: var(--axis-x); }
.field .addon.y { color: var(--axis-y); }
.field .value {
    flex: 1 1 0dp; padding: 0dp 7dp; text-align: right;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-family: InterNumeric;
}
.field .unit { padding-right: 7dp; color: var(--faint-foreground); flex: 0 0 auto; margin-left: -4dp; }
.field input.value { cursor: text; height: 16dp; line-height: 16dp; margin-top: 2dp; font-family: Inter; color: var(--foreground); }
.field input.value selection { background-color: var(--primary); color: var(--primary-foreground); }
.field .step {
    position: absolute; top: 0dp; bottom: 0dp; width: 14dp; display: flex; align-items: center; justify-content: center;
    color: var(--muted-foreground); opacity: 0; transition: opacity 0.11s cubic-out; cursor: arrow;
}
.field .step .icon { font-size: 10dp; width: 10dp; }
.field .step.dec { left: 0dp; }
.field .step.inc { right: 0dp; }
.field:hover .step { opacity: 1; }
.field.slider .step, .field[data-editing] .step, .field[data-scrubbing] .step { opacity: 0; }
.field .step:hover { background-color: var(--press); }
.field.text, .field.search { background-color: var(--field-edit); cursor: text; }
.field.text:hover, .field.search:hover { background-color: var(--input-hover); }
.field.text .value, .field.search .value { text-align: left; font-family: Inter; }
.field.text input.value, .field.search input.value { width: 100%; padding: 0dp 7dp; }
.field.search .addon { padding-left: 6dp; }
.field.search .addon .icon { color: var(--faint-foreground); }
.field.search input.value { padding-left: 5dp; }
.field.area { display: block; height: auto; }
.field.area textarea.value {
    display: block; width: 100%; height: auto; padding: 2dp 7dp; line-height: 16dp; cursor: text;
    font-family: Inter; color: var(--foreground); text-align: left; white-space: pre-wrap; overflow-y: auto;
}
.field.area textarea.value selection { background-color: var(--primary); color: var(--primary-foreground); }

/* Joined vector: components share one control. */
.joined { display: flex; flex: 1 1 0dp; gap: 1dp; }
.joined .field { border-radius: 0dp; }
.joined .field:first-child { border-radius: 4dp 0dp 0dp 4dp; }
.joined .field:last-child { border-radius: 0dp 4dp 4dp 0dp; }

/* Select trigger. */
.field.select { justify-content: flex-start; padding: 0dp 4dp 0dp 8dp; gap: 6dp; cursor: arrow; }
.field.select .value { padding: 0dp; text-align: left; font-family: Inter; }
.field.select .caret { color: var(--faint-foreground); width: 14dp; }
.field.select[data-open] { background-color: var(--field-edit); }

/* Color field. */
.field.color { cursor: arrow; }
.field.color .swatch { position: absolute; left: 3dp; right: 3dp; top: 3dp; bottom: 3dp; border-radius: 2dp; }
.field.color .swatch.none { border: 1dp var(--border); }

/* Checkbox. */
.check { display: inline-flex; align-items: center; gap: 7dp; height: var(--h); color: var(--foreground); tab-index: auto; }
.check .box {
    width: 14dp; height: 14dp; border-radius: 3dp; background-color: var(--secondary);
    display: flex; align-items: center; justify-content: center;
    transition: background-color 0.11s cubic-out;
}
.check:hover .box { background-color: var(--field-hover); }
.check .box .icon { font-size: 11dp; width: 12dp; color: var(--primary-foreground); opacity: 0; }
.check[data-checked] .box { background-color: var(--primary); }
.check[data-checked] .box .icon { opacity: 1; }
.check[data-disabled], .check[data-readonly] { opacity: 0.5; }
/* Virtualized list: the content is as tall as every row; padding places the first
   emitted row. */
.vlist { overflow-y: auto; }
.vlist-content { display: block; position: relative; }
/* NumberFlow: one clipped wheel per digit; the kit moves the strip. Wheels and
   symbols share one line box so they align. */
.number-flow { display: inline-block; white-space: nowrap; font-family: InterNumeric; --nf-line: 16dp; }
.nf-digit { display: inline-block; position: relative; overflow: hidden; height: var(--nf-line); vertical-align: top; }
.nf-strip { display: block; }
.nf-cell { display: block; height: var(--nf-line); line-height: var(--nf-line); text-align: center; }
.nf-symbol { display: inline-block; height: var(--nf-line); line-height: var(--nf-line); vertical-align: top; }

/* Torph: segments are boxes so they can move; leaving ones are placed absolutely. */
.morph { display: inline-block; position: relative; white-space: nowrap; }
.morph-seg { display: inline-block; white-space: pre; }
/* Property rows (Blender property split). */
.prop { display: flex; align-items: flex-start; gap: 8dp; margin-top: var(--gap); }
.prop .label {
    width: 38%; flex: 0 0 auto; height: var(--h); display: flex; align-items: center; justify-content: flex-end;
    color: var(--muted-foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.prop .control { flex: 1 1 0dp; display: flex; align-items: center; gap: 4dp; }
.prop .label .hl { background-color: var(--highlight); color: var(--strong); border-radius: 2dp; }

/* Collapsible panel (Blender panel). */
.panel { display: block; background-color: var(--card); border-radius: var(--r-lg); margin-bottom: 4dp; }
.panel-head {
    display: flex; align-items: center; gap: 4dp; height: 26dp; padding: 0dp 4dp 0dp 6dp;
    background-color: var(--panel-head); border-radius: var(--r-lg); color: var(--foreground);
}
.panel[data-open] .panel-head { border-radius: 6dp 6dp 0dp 0dp; }
.panel-head:hover { background-color: var(--panel-head-hover); }
.panel-head .chev { color: var(--faint-foreground); width: 12dp; font-size: 11dp; transform: rotate(-90deg); transition: transform 0.14s cubic-out; }
.panel[data-open] .panel-head .chev { transform: rotate(0deg); }
.panel-head .title { font-weight: 600; }
.panel-head .grip { color: var(--disabled-foreground); opacity: 0; font-size: 12dp; }
.panel-head:hover .grip { opacity: 1; }
.panel-body { display: block; padding: 4dp 8dp 8dp 6dp; }

/* Badge and kbd. */
.badge { display: inline-block; height: 16dp; line-height: 16dp; padding: 0dp 5dp; border-radius: 3dp; font-size: 10dp; color: var(--muted-foreground); background-color: var(--line); white-space: nowrap; }
.badge.override { color: var(--override-fg); background-color: var(--override-soft); }
.badge.accent { color: var(--primary-text); background-color: var(--primary-soft); }
.kbd { font-size: 11dp; color: var(--faint-foreground); white-space: nowrap; }
.kbd-key { display: inline-block; text-align: center; min-width: 18dp; height: 18dp; line-height: 18dp; padding: 0dp 4dp; border-radius: 3dp; background-color: var(--line); color: var(--muted-foreground); font-size: 10dp; }
/* Overlay layer: popups, tooltips and the command palette. */
#layer { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; pointer-events: none; z-index: 10; }
.modal-host { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; pointer-events: auto; z-index: 15; }
.popup {
    position: absolute; pointer-events: auto; background-color: var(--popover); border: 1dp var(--popover-edge);
        border-radius: var(--r-lg); padding: 4dp; min-width: 180dp; max-width: 480dp; color: var(--foreground);
    display: block; z-index: 20;
}
.popup[data-unplaced] { visibility: hidden; }
/* Presence: enter 140 ms, exit faster at 100 ms, easing in from the anchor side.
   No transforms: the renderer clips by scissor, and RmlUi cannot scissor a
   transformed element, so a transformed popup would stop clipping its scroll. */
.popup { opacity: 1; margin-top: 0dp; transition: opacity margin-top 0.14s cubic-out; }
.popup[data-starting-style], .popup[data-ending-style] { opacity: 0; margin-top: -3dp; }
.popup[data-ending-style] { transition: opacity margin-top 0.1s cubic-in; }
.menu-item {
    display: flex; align-items: center; gap: 8dp; height: var(--h); padding: 0dp 8dp 0dp 6dp; border-radius: var(--r);
    white-space: nowrap; color: var(--foreground);
}
.menu-item .lead { color: var(--muted-foreground); }
.menu-item .label { flex: 1 1 auto; overflow: hidden; }
.menu-item .kbd { margin-left: 24dp; flex: 0 0 auto; }
.menu-item .chev { color: var(--faint-foreground); font-size: 11dp; }
.menu-item[data-highlighted] { background-color: var(--primary); color: var(--primary-foreground); }
.menu-item[data-highlighted] .lead, .menu-item[data-highlighted] .kbd, .menu-item[data-highlighted] .chev { color: #ffffffcc; }
.menu-item[data-disabled] { color: var(--disabled-foreground); }
.menu-item[data-current] .label, .menu-item[data-current] .lead { color: var(--primary-text); }
.menu-item[data-current][data-highlighted] .label, .menu-item[data-current][data-highlighted] .lead { color: var(--primary-foreground); }
.menu-item[data-disabled][data-highlighted] { background-color: var(--accent); color: var(--disabled-foreground); }
.menu-item[data-disabled] .lead, .menu-item[data-disabled] .kbd { color: var(--disabled-foreground); }
.menu-sep { height: 1dp; margin: 4dp 2dp; background-color: var(--border); }
.menu-group { height: 22dp; line-height: 22dp; display: block; padding: 0dp 6dp; font-size: 11dp; color: var(--faint-foreground); }

/* The label and shortcut stay on one line; a description wraps beneath them.
   The kit sets the font size (kit_popup.c), undoing a canvas's zoom, so the
   other lengths are in em. */
.tooltip {
    position: absolute; pointer-events: none; background-color: var(--tooltip); border: 1dp var(--tooltip-edge); border-radius: 0.36em;
    padding: 0.36em 0.64em; display: block; color: var(--foreground); line-height: 1.45em;
    z-index: 40;
}
.tip-head { display: flex; align-items: center; gap: 0.73em; white-space: nowrap; }
.tip-about { display: block; max-width: 23.6em; margin-top: 0.18em; line-height: 1.36em; color: var(--muted-foreground); white-space: normal; }
.tooltip .kbd { font-size: 1em; color: var(--faint-foreground); }
.tooltip { opacity: 1; transition: opacity 0.1s cubic-out; }
.tooltip[data-starting-style] { opacity: 0; }
.tooltip[data-instant] { transition: none; }
/* The editor's roles beyond shadcn's, derived from the palette so a pasted
   theme carries through. Mixes that differ in the dark palette repeat under
   .dark; status, override and code colors are the editor's own. */
body {
    /* Surfaces, darkest to lightest. */
    --app: color-mix(in srgb, var(--background) 83%, #000);
    --edge: color-mix(in srgb, var(--background) 80%, #000);
    --rail: color-mix(in srgb, var(--background) 94%, #000);
    --panel-head: color-mix(in srgb, var(--foreground) 4%, var(--card));
    --panel-head-hover: color-mix(in srgb, var(--foreground) 8%, var(--card));
    --field-hover: color-mix(in srgb, var(--foreground) 5%, var(--secondary));
    --field-press: color-mix(in srgb, var(--secondary) 92%, #000);
    --field-edit: var(--popover);
    --input-hover: color-mix(in srgb, var(--foreground) 3%, var(--popover));
    --canvas: var(--popover);
    --viewport: #1e1e20;
    --floating: color-mix(in srgb, var(--popover) 90%, transparent);
    --tooltip: var(--foreground);
    --tooltip-edge: var(--foreground);
    --backdrop: #00000033;
    /* Lines. */
    --line: color-mix(in srgb, var(--border) 52%, transparent);
    --popover-edge: var(--border);
    /* Text. */
    --faint-foreground: color-mix(in srgb, var(--muted-foreground) 80%, var(--background));
    --disabled-foreground: color-mix(in srgb, var(--muted-foreground) 50%, var(--background));
    --strong: #000000;
    --primary-text: color-mix(in oklab, #000 11%, var(--primary));
    --link: color-mix(in oklab, #000 11%, var(--primary));
    /* Primary-tinted states. */
    --primary-hover: color-mix(in srgb, var(--foreground) 12%, var(--primary));
    --primary-soft: color-mix(in srgb, var(--primary) 15%, transparent);
    --primary-edge: color-mix(in srgb, var(--primary) 67%, transparent);
    --primary-wash: color-mix(in srgb, var(--primary) 27%, transparent);
    --fill: color-mix(in srgb, var(--primary) 55%, transparent);
    --fill-hover: color-mix(in srgb, var(--primary) 69%, transparent);
    --selected: color-mix(in oklab, var(--primary) 19%, var(--popover));
    --active-row: color-mix(in oklab, var(--primary) 33%, var(--popover));
    /* Foreground-tinted states. */
    --press: color-mix(in srgb, var(--foreground) 9%, transparent);
    --item-selected: color-mix(in srgb, var(--foreground) 5%, transparent);
    --scrollbar: color-mix(in srgb, var(--foreground) 15%, transparent);
    --scrollbar-hover: color-mix(in srgb, var(--foreground) 25%, transparent);
    /* Status, overrides and search. */
    --warning: #b7791f;
    --success: #2f8f3a;
    --override: #0e9494;
    --override-fg: #0b7d73;
    --override-soft: #0e94941f;
    --highlight: #e8b64a66;
    --notice: #fff4e5f0;
    --notice-fg: #9a4d00;
    --axis-x: #c2413b;
    --axis-y: #3f8f2f;
    /* Code tokens (highlight.c). */
    --tok-number: #098658;
    --tok-string: #a31515;
    --tok-keyword: #af00db;
    --tok-name: #0451a5;
    --tok-path: #2f5fa8;
    --tok-punct: #6e6e76;
    /* Metrics; body.comfortable scales controls, not text. */
    --h: 22dp;
    --text-line: 20dp; /* text line inside a bordered control */
    --h-sm: 18dp;
    --row: 22dp;
    --gap: 2dp;
    --header-h: 28dp;
    --r: 4dp;
    --r-lg: var(--radius);
}
.dark {
    --app: color-mix(in srgb, var(--background) 55%, #000);
    --edge: color-mix(in srgb, var(--background) 34%, #000);
    --floating: color-mix(in srgb, var(--card) 90%, transparent);
    --tooltip: color-mix(in srgb, var(--popover) 60%, #000);
    --tooltip-edge: #333338;
    --backdrop: #0000004d;
    --faint-foreground: color-mix(in srgb, var(--muted-foreground) 62%, var(--background));
    --disabled-foreground: color-mix(in srgb, var(--muted-foreground) 37%, var(--background));
    --strong: #ffffff;
    --primary-text: color-mix(in oklab, #fff 58%, var(--primary));
    --link: color-mix(in oklab, #fff 50%, var(--primary));
    --primary-soft: color-mix(in srgb, var(--primary) 23%, transparent);
    --primary-wash: color-mix(in srgb, var(--primary) 33%, transparent);
    --fill: color-mix(in srgb, var(--primary) 72%, transparent);
    --fill-hover: color-mix(in srgb, var(--primary) 85%, transparent);
    --selected: color-mix(in oklab, var(--primary) 27%, var(--popover));
    --active-row: color-mix(in oklab, var(--primary) 65%, var(--popover));
    --press: color-mix(in srgb, var(--foreground) 10%, transparent);
    --item-selected: color-mix(in srgb, var(--foreground) 7%, transparent);
    --scrollbar: color-mix(in srgb, var(--foreground) 12%, transparent);
    --scrollbar-hover: color-mix(in srgb, var(--foreground) 20%, transparent);
    --warning: #d9a53d;
    --success: #57ab5a;
    --override: #19b6b6;
    --override-fg: #7fe0d4;
    --override-soft: #3db4a61f;
    --highlight: #d9a53d44;
    --notice: #1a1612f0;
    --notice-fg: #ffad66;
    --axis-x: #e0727a;
    --axis-y: #82c46b;
    --tok-number: #b5cea8;
    --tok-string: #ce9178;
    --tok-keyword: #c586c0;
    --tok-name: #9cdcfe;
    --tok-path: #8fb4ee;
    --tok-punct: #8b8b94;
}
body.comfortable { --h: 26dp; --text-line: 24dp; --h-sm: 20dp; --row: 26dp; --gap: 3dp; --header-h: 32dp; }
body:not(.dark) .tooltip { color: #fafafa; }
body:not(.dark) .tooltip .kbd { color: #a1a1aa; }
body:not(.dark) .tooltip .tip-about { color: #d4d4d8; }
/* next-themes: a palette change must not animate element by element. */
body.theme-switching * { transition: none; }

@media (theme: reduced-motion) {
    * { transition: none; }
}
/* Toasts (Sonner): 356 dp wide, 14 dp gap, bottom-right above the status bar. The
   kit drives transform, opacity and height with springs. */
.toaster { position: absolute; right: 16dp; bottom: 36dp; width: 356dp; height: 0dp; z-index: 35; pointer-events: none; }
.toast {
    position: absolute; left: 0dp; right: 0dp; bottom: 0dp; display: flex; align-items: flex-start; gap: 9dp;
    padding: 10dp 10dp 10dp 12dp; background-color: var(--popover); border: 1dp var(--popover-edge); border-radius: 8dp;
    transform-origin: 50% 0%; color: var(--foreground); overflow: hidden;
}
.toast .lead { font-size: 15dp; width: 16dp; line-height: 18dp; flex: 0 0 auto; }
.toast[data-type=success] .lead { color: var(--success); }
.toast[data-type=info] .lead { color: var(--primary-text); }
.toast[data-type=warning] .lead { color: var(--warning); }
.toast[data-type=error] .lead { color: var(--destructive); }
.toast[data-type=loading] .lead { color: var(--muted-foreground); animation: 0.9s linear infinite toast-spin; }
@keyframes toast-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.toast .content { flex: 1 1 0dp; display: block; }
.toast .title { display: block; line-height: 18dp; font-weight: 500; }
.toast .description { display: block; line-height: 16dp; margin-top: 1dp; color: var(--muted-foreground); font-size: 11dp; white-space: normal; }
.toast .toast-action, .toast .toast-close { flex: 0 0 auto; }
.toast[data-behind] .lead, .toast[data-behind] .content, .toast[data-behind] .btn { opacity: 0; }
/* The palette, in shadcn/ui's tokens: light on :root, dark on .dark. A shadcn
   theme's two variable blocks paste over these, and the editor's roles
   (roles.rcss) follow them. */
:root {
    --radius: 6dp;
    --background: #f4f4f5;
    --foreground: #18181b;
    --card: #ebebee;
    --card-foreground: #18181b;
    --popover: #ffffff;
    --popover-foreground: #18181b;
    --primary: #3b6fc2;
    --primary-foreground: #ffffff;
    --secondary: #d9d9de;
    --secondary-foreground: #18181b;
    --muted: #e7e7ea;
    --muted-foreground: #52525b;
    --accent: #0000000b;
    --accent-foreground: #18181b;
    --destructive: #d73a31;
    --border: #0000001f;
    --input: #0000001f;
    --ring: #3b82f6;
}
.dark {
    --background: #28282b;
    --foreground: #e5e5e8;
    --card: #303034;
    --card-foreground: #e5e5e8;
    --popover: #1c1c1e;
    --popover-foreground: #e5e5e8;
    --primary: #4772b3;
    --primary-foreground: #ffffff;
    --secondary: #424247;
    --secondary-foreground: #e5e5e8;
    --muted: #2e2e31;
    --muted-foreground: #adadb5;
    --accent: #ffffff0f;
    --accent-foreground: #e5e5e8;
    --destructive: #e5534b;
    --border: #ffffff1c;
    --input: #ffffff1c;
    --ring: #73abff;
}
/* Tree rows (Outliner, lists). */
.tree-row {
    display: flex; align-items: center; gap: 4dp; height: var(--row); padding-right: 4dp; border-radius: var(--r);
    color: var(--foreground); white-space: nowrap; border: 1dp transparent;
}
.tree-row:hover { background-color: var(--accent); }
.tree-row[data-selected] { background-color: var(--selected); }
.tree-row[data-active] { background-color: var(--active-row); }
.tree-row[data-active] .name { color: var(--strong); }
.tree-row .twisty { width: 14dp; font-size: 11dp; color: var(--faint-foreground); }
.tree-row .name { flex: 1 1 0dp; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tree-row .meta { color: var(--faint-foreground); font-size: 11dp; }
.tree-row .trail { display: flex; align-items: center; gap: 1dp; }
.tree-row .toggle { width: 20dp; height: 18dp; padding: 0dp; }
.tree-row .toggle .icon { color: var(--faint-foreground); font-size: 13dp; }
.tree-row .toggle[data-state=off] .icon { color: var(--disabled-foreground); }
.tree-row .toggle[data-state=on] { background-color: transparent; }
.tree-row .inline .icon { font-size: 12dp; width: 14dp; color: var(--link); }
version: 3
name: Studio
content: content
start_scene: scenes/Studio.yaml
ui: StudioShell
