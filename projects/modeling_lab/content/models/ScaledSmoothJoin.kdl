version 3
name "ScaledSmoothJoin"
domain "model"
id_counter 23
description "Smooth bounds account for the conservative distance ratio under nonuniform scale."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Sphere"
                inputs Radius=16.0
            }
            - {
                id 6
                type "Model Scale"
                inputs {
                    Factors {
                        default x=1.7 y=0.65 z=0.9
                    }
                }
            }
            - {
                id 10
                type "Model Translate"
                inputs {
                    Offset {
                        default x=-18.0 y=0.0 z=0.0
                    }
                }
            }
            - {
                id 14
                type "Model Translate"
                inputs {
                    Offset {
                        default x=18.0 y=0.0 z=0.0
                    }
                }
            }
            - {
                id 18
                type "Model Smooth Union"
                inputs Smoothness=7.0
            }
        }
        (array)edges {
            - from="3.Geometry" to="6.Geometry"
            - from="6.Geometry" to="10.Geometry"
            - from="6.Geometry" to="14.Geometry"
            - from="10.Geometry" to="18.A"
            - from="14.Geometry" to="18.B"
            - from="18.Geometry" to="1.Geometry"
        }
    }
}
