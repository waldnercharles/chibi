package package_compiler

import facts "project:scalar_facts"
import binding "project:lexical_binding"
import snapshot "project:source_snapshot"
import syntax "project:syntax_diagnostics"

// Optional cells initially contain plain values only. Their tag and payload
// move together; owned backing and managed graph edges need a separate layout.
ScalarPointerOptional :: (types: TypeDecl[], record: int) -> bool {
    if (!ScalarOptional(types, record)) { return false; }
    declared := types[record];
    if (declared.value_container != 0) { return false; }
    if (declared.value_record < 0) { return Numeric(declared.value_storage) || declared.value_storage == BoolStorage; }
    return declared.value_storage == StructStorage && types[declared.value_record].kind == RecordDecl;
}
// Managed cells keep their pointee's complete identity; storage alone is not
// enough for a nominal type. Nullable descriptors retain that pointee type;
// only their absent value has an all-zero descriptor.
ScalarPointerElement :: (types: TypeDecl[], record: int) -> ValueType {
    none: ValueType = {storage: 0, container: 0, record: -1};
    if (record < 0 || record >= length(types)) { return none; }
    declared := types[record];
    if (declared.kind != PointerDecl || (declared.value_container != 0 && declared.value_container != ArrayContainer)) {
        return none;
    }
    if (declared.value_container == 0 && declared.value_storage == StructStorage && declared.value_record >= 0 &&
        types[declared.value_record].kind == RecordDecl) {
        return {storage: StructStorage, container: 0, record: declared.value_record};
    }
    if (declared.value_container == 0 && declared.value_storage == UnionStorage &&
        ScalarPointerOptional(types, declared.value_record)) {
        return {storage: UnionStorage, container: 0, record: declared.value_record};
    }
    if (declared.value_container == ArrayContainer && declared.value_record >= 0) {
        shape: ValueType = {storage: declared.value_storage, container: ViewContainer, record: declared.value_record};
        if (ScalarViewType(types, shape) != 0) { shape.container = ArrayContainer; return shape; }
    }
    if (declared.value_record != -1) { return none; }
    type := ScalarTypeOf(declared.value_storage);
    if ((type < facts.IntType || type > facts.DoubleType) && type != facts.StringType) { return none; }
    return {storage: declared.value_storage, container: declared.value_container, record: -1};
}
ScalarPointerType :: (types: TypeDecl[], record: int) -> int {
    if (ScalarPointerElement(types, record).storage == 0) { return 0; }
    return facts.PointerType;
}
// Primitive tags retain the established semantic identity. A record adds its
// full layout and the native payload ABI version; neither a local ordinal nor
// a nominal-only tag can permit a changed generation's layout.
ScalarPointerTag :: (types: TypeDecl[], value: ValueType) -> i64 {
    nominal := SemanticTag(types, value);
    if (value.container == ArrayContainer && value.record >= 0) {
        schema := types[value.record].native_schema;
        if (schema == 0) { return 0; }
        return i64(wrap: binding.ID("native-managed-owned-array-v1", format_text("{}:{}", nominal, schema)));
    }
    if (value.container == ArrayContainer) {
        return i64(wrap: binding.ID("native-managed-array-v1", format_text("{}", nominal)));
    }
    if (value.storage == UnionStorage && value.container == 0 && ScalarPointerOptional(types, value.record)) {
        payload := types[value.record];
        layout: u64 = 0;
        if (payload.value_record >= 0) { layout = types[payload.value_record].layout; }
        return i64(wrap: binding.ID("native-managed-optional-v1", format_text("{}:{}", nominal, layout)));
    }
    if (value.storage == StructStorage && value.container == 0 && value.record >= 0) {
        return i64(wrap: binding.ID("native-managed-record-v1", format_text("{}:{}", nominal, types[value.record].layout)));
    }
    return i64(wrap: nominal);
}
// Automatic field dereference and explicit p^ share the same managed root.
// A rewritten scoped parameter remains an ordinary borrowed record place.
ScalarPointerObject :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                        names: Name[], types: TypeDecl[], members: TypeMember[], package: int, node: int) -> int {
    object := Unparenthesized(forest, node);
    if (Is(forest, object, syntax.DereferenceExpression)) {
        if (ScalarScopedDereference(forest, text, names, object)) { return -1; }
        object = Field(forest, object, syntax.FieldOperand);
    }
    pointer := ScalarPointerRecord(forest, text, callables, params, names, types, members, package, object);
    if (pointer < 0 || ScalarPointerElement(types, pointer).storage != StructStorage) { return -1; }
    return pointer;
}
ScalarPointerFieldRows :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                          callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                          constants: ConstDecl[], node: int, rows: facts.Row[]) -> ScalarOperands {
    object := Unparenthesized(forest, Field(forest, node, syntax.FieldObject));
    pointer := ScalarPointerObject(forest, text, callables, params, names, types, members, callable.package, object);
    record := ScalarMemberRecordOf(forest, text, callables, params, names, types, members, callable.package, object);
    field := ScalarMember(forest, text, callables, params, names, types, members, callable.package, node);
    if (record < 0 || field < 0) {
        return ScalarOperands.Failed(Diagnose(forest, node, 0, "native managed field requires a flat authored record"));
    }
    output := rows;
    if (pointer >= 0) {
        if (Is(forest, object, syntax.DereferenceExpression)) { object = Field(forest, object, syntax.FieldOperand); }
        switch ScalarOperand(forest, text, callables, params, callable, names, types, members, constants, object,
                              PointerStorage, output) {
            case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
            case .Built(built): output = built;
        }
    } else {
        if (!Is(forest, object, syntax.Identifier)) {
            return ScalarOperands.Failed(Diagnose(forest, node, 0, "native managed field address requires an owned record variable"));
        }
        found := Lookup(names, Text(forest, text, object));
        if (found < 0 || names[found].place == ReferencePlace) {
            return ScalarOperands.Failed(Diagnose(forest, node, 0, "native managed pointers cannot capture a borrowed reference"));
        }
        address := ScalarAt(forest, object, facts.ManagedAddressRow, facts.PointerType, names[found].index,
                            ScalarRecordType(types, record), "");
        address.literal = ScalarPointerTag(types, {storage: StructStorage, container: 0, record: record});
        output.append(address);
    }
    projected := ScalarAt(forest, node, facts.ManagedFieldRow, ScalarRecordType(types, record), field - types[record].first, 1, "");
    projected.literal = ScalarPointerTag(types, ScalarMemberShape(members, field));
    output.append(projected);
    return ScalarOperands.Built(output);
}
// A scoped reference already names the caller's target. Its explicit first
// dereference reads that logical value, which may itself be a descriptor.
ScalarScopedDereference :: (forest: snapshot.SnapshotNode[], text: string, names: Name[], node: int) -> bool {
    if (!Is(forest, node, syntax.DereferenceExpression)) { return false; }
    operand := Unparenthesized(forest, Field(forest, node, syntax.FieldOperand));
    if (!Is(forest, operand, syntax.Identifier)) { return false; }
    found := Lookup(names, Text(forest, text, operand));
    return found >= 0 && names[found].place == ReferencePlace;
}

// Pointer values come from a local's address, an existing pointer, a function
// result or a pointer-array element. Ordinary body checking interns the types.
ScalarPointerRecord :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                        names: Name[], types: TypeDecl[], members: TypeMember[], package: int, operand: int) -> int {
    node := Unparenthesized(forest, operand);
    if (Is(forest, node, syntax.AwaitExpression)) {
        awaited := Unparenthesized(forest, Field(forest, node, syntax.FieldValue));
        if (Is(forest, awaited, syntax.CallExpression)) {
            called := CalledFunction(forest, text, callables, [], names, package, awaited);
            if (called >= 0 && callables[called].waits) {
                shape := TaskSuccessValue(callables[called], params);
                if (shape.storage == PointerStorage && shape.container == 0) { return shape.record; }
            }
        }
        return -1;
    }
    if (Is(forest, node, syntax.AddressExpression)) {
        held := Unparenthesized(forest, Field(forest, node, syntax.FieldOperand));
        if (ScalarScopedDereference(forest, text, names, held)) { return -1; }
        if (Is(forest, held, syntax.DereferenceExpression)) {
            return ScalarPointerRecord(forest, text, callables, params, names, types, members, package,
                                        Field(forest, held, syntax.FieldOperand));
        }
        if (Is(forest, held, syntax.MemberExpression)) {
            field := ScalarMember(forest, text, callables, params, names, types, members, package, held);
            if (field < 0) { return -1; }
            return FindPointer(types, ScalarMemberShape(members, field), false);
        }
        if (!Is(forest, held, syntax.Identifier)) { return -1; }
        found := Lookup(names, Text(forest, text, held));
        if (found < 0) { return -1; }
        binding := names[found];
        scalar := binding.record == -1 && ((ScalarTypeOf(binding.storage) >= facts.IntType &&
                  ScalarTypeOf(binding.storage) <= facts.DoubleType) || binding.storage == TextStorage);
        record := binding.storage == StructStorage && binding.record >= 0 && types[binding.record].kind == RecordDecl;
        array := (scalar || (binding.storage == TextStorage && binding.record == -1)) && binding.container == ArrayContainer;
        if (binding.container == ArrayContainer && binding.record >= 0) {
            array = ScalarViewType(types, {storage: binding.storage, container: ViewContainer, record: binding.record}) != 0;
        }
        optional := binding.storage == UnionStorage && ScalarPointerOptional(types, binding.record);
        if (binding.place == ReferencePlace || (binding.container != 0 && !array) || (!scalar && !record && !array && !optional)) { return -1; }
        pointed: ValueType = {storage: binding.storage, container: binding.container, record: binding.record};
        return FindPointer(types, pointed, false);
    }
    if (ScalarScopedDereference(forest, text, names, node)) {
        named := Unparenthesized(forest, Field(forest, node, syntax.FieldOperand));
        found := Lookup(names, Text(forest, text, named));
        if (names[found].storage == PointerStorage && names[found].container == 0) { return names[found].record; }
        return -1;
    }
    if (Is(forest, node, syntax.Identifier)) {
        found := Lookup(names, Text(forest, text, node));
        if (found >= 0 && names[found].storage == PointerStorage && names[found].container == 0) {
            return names[found].record;
        }
        if (found >= 0 && names[found].storage == UnionStorage && names[found].container == 0 &&
            names[found].record >= 0 && types[names[found].record].kind == TaskResultDecl &&
            TaskResultPresent(forest, text, names[found], node)) {
            shape := TaskResultSuccess(types, names[found].record);
            if (shape.storage == PointerStorage && shape.container == 0) { return shape.record; }
        }
        return -1;
    }
    if (Is(forest, node, syntax.MemberExpression)) {
        field := ScalarMember(forest, text, callables, params, names, types, members, package, node);
        if (field >= 0 && members[field].storage == PointerStorage && members[field].container == 0) {
            return members[field].record;
        }
        return -1;
    }
    if (Is(forest, node, syntax.CallExpression)) {
        called := CalledFunction(forest, text, callables, [], names, package, node);
        if (called >= 0 && callables[called].result == PointerStorage && callables[called].result_container == 0 &&
            (!callables[called].waits || ImmediatelyAwaited(forest, node))) {
            return callables[called].result_record;
        }
        return -1;
    }
    if (Is(forest, node, syntax.IndexExpression)) {
        array := ScalarArrayShape(forest, text, callables, params, names, types, members, package,
                                  Field(forest, node, syntax.FieldObject));
        if (array.container == ArrayContainer && array.storage == PointerStorage) { return array.record; }
    }
    return -1;
}
ScalarManagedRow :: (forest: snapshot.SnapshotNode[], node: int, type: int, operator: int, count: int,
                     types: TypeDecl[], record: int) -> facts.Row {
    row := ScalarAt(forest, node, facts.ManagedRow, type, operator, count, "");
    row.literal = ScalarPointerTag(types, ScalarPointerElement(types, record));
    return row;
}
ScalarPointerAddress :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                         callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                         constants: ConstDecl[], node: int, rows: facts.Row[]) -> ScalarOperands {
    record := ScalarPointerRecord(forest, text, callables, params, names, types, members, callable.package, node);
    if (ScalarPointerType(types, record) == 0) {
        return ScalarOperands.Failed(Diagnose(forest, node, 0, "native managed pointers require a non-null numeric or bool local"));
    }
    held := Unparenthesized(forest, Field(forest, node, syntax.FieldOperand));
    if (Is(forest, held, syntax.MemberExpression)) {
        return ScalarPointerFieldRows(forest, text, callables, params, callable, names, types, members, constants, held, rows);
    }
    if (Is(forest, held, syntax.DereferenceExpression)) {
        return ScalarOperand(forest, text, callables, params, callable, names, types, members, constants,
                              Field(forest, held, syntax.FieldOperand), PointerStorage, rows);
    }
    found := Lookup(names, Text(forest, text, held));
    if (found < 0 || names[found].place == ReferencePlace) {
        return ScalarOperands.Failed(Diagnose(forest, node, 0, "native managed pointers cannot capture a borrowed reference"));
    }
    output := rows;
    address := ScalarAt(forest, node, facts.ManagedAddressRow, facts.PointerType, names[found].index, 0, "");
    shape := ScalarPointerElement(types, record);
    if (shape.storage == StructStorage || shape.storage == UnionStorage || shape.container == ArrayContainer) {
        address.count = ScalarValueType(types, shape.storage, shape.container, shape.record);
    }
    address.literal = ScalarPointerTag(types, shape);
    output.append(address);
    return ScalarOperands.Built(output);
}
// Read and scoped-borrow resolve the same descriptor identity; the latter
// leaves a reference for an existing scoped call rather than loading a scalar.
ScalarPointerAccess :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                        callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                        constants: ConstDecl[], operand: int, borrowed: bool, rows: facts.Row[]) -> ScalarOperands {
    record := ScalarPointerRecord(forest, text, callables, params, names, types, members, callable.package, operand);
    shape := ScalarPointerElement(types, record);
    if (shape.storage == 0) {
        return ScalarOperands.Failed(Diagnose(forest, operand, 0, "native managed pointer reads require a numeric or bool pointee"));
    }
    output := rows;
    switch ScalarOperand(forest, text, callables, params, callable, names, types, members, constants,
                          operand, PointerStorage, output) {
        case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
        case .Built(built): output = built;
    }
    operator := facts.ManagedRead;
    type := ScalarValueType(types, shape.storage, shape.container, shape.record);
    if (borrowed) { operator = facts.ManagedBorrow; type += facts.ReferenceType; }
    output.append(ScalarManagedRow(forest, operand, type, operator, 1, types, record));
    return ScalarOperands.Built(output);
}

// The saved target is read before the incoming value. A compound assignment
// reads the old pointee once before evaluating its right-hand side.
ScalarPointerAssigned :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                          callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                          constants: ConstDecl[], statement: int, temporary: int, shape: ValueType) -> ScalarOperands {
    value := Field(forest, statement, syntax.FieldValue);
    type := ScalarValueType(types, shape.storage, shape.container, shape.record);
    // These reads refer to the compiler's saved target, not a second source
    // evaluation. The second hidden statement occupies the RHS expression.
    output := [ScalarAt(forest, value, facts.ReadRow, facts.PointerType, temporary, 0, "")];
    operator := ScalarArithmetic(CompoundOperator(Operator(forest, statement)));
    if (CompoundOperator(Operator(forest, statement)) != NoOperator) {
        if (operator == 0 || shape.storage == BoolStorage || shape.container != 0) {
            return ScalarOperands.Failed(Diagnose(forest, statement, 0, "native pointer compound assignment requires a numeric operator"));
        }
        output.append(ScalarAt(forest, value, facts.ReadRow, facts.PointerType, temporary, 0, ""));
        read := ScalarAt(forest, value, facts.ManagedRow, type, facts.ManagedRead, 1, "");
        read.literal = ScalarPointerTag(types, shape);
        output.append(read);
    }
    switch ScalarElementValue(forest, text, callables, params, callable, names, types, members, constants,
                               value, shape, output) {
        case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
        case .Built(built): output = built;
    }
    if (operator != 0) { output.append(ScalarAt(forest, value, facts.ArithmeticRow, type, operator, 2, "")); }
    changed := ScalarAt(forest, value, facts.ManagedRow, type, facts.ManagedWrite, 2, "");
    changed.literal = ScalarPointerTag(types, shape);
    output.append(changed);
    return ScalarOperands.Built(output);
}

// These effects come from the checked managed-pointer operations. Other host
// effects still pass through ScalarHosts and each source expression's lowering.
ScalarPointerEffects :: (hosts: Host[]) -> int {
    effects: int = 0;
    for host in hosts {
        intrinsic := host.intrinsic;
        if (intrinsic >= InResult) { intrinsic -= InResult; }
        if (intrinsic == PointerReadIntrinsic || intrinsic == PointerReferenceIntrinsic) { effects |= ReadEffect; }
        if (intrinsic == PointerWriteIntrinsic) { effects |= WriteEffect; }
    }
    return effects;
}

// Tag only records whose managed address or inline pointer fields are used.
// Ordinary record facts keep their existing literals, including char flags.
// The pass is linear in rows, type declarations and the selected fields.
ScalarManagedRecords :: (forest: snapshot.SnapshotNode[], types: TypeDecl[], members: TypeMember[],
                         rows: facts.Row[]) -> ScalarOperands {
    managed := false;
    for (at in 0..<length(rows)) {
        kind := rows[at].kind;
        managed = kind == facts.ManagedAddressRow || kind == facts.ManagedFieldRow ||
                  kind == facts.ManagedRow || (kind == facts.MemberRow && rows[at].type == facts.PointerType);
        if (managed) { break; }
    }
    if (!managed) { return ScalarOperands.Built(rows); }
    heads: int[] = [];
    for (at in 0..<length(rows)) {
        if (rows[at].kind == facts.RecordRow || rows[at].kind == facts.UnionRow) { heads.append(at); }
    }
    declarations := resize([int(-1)], length(heads));
    wanted := resize([false], length(heads));
    for (index in 0..<length(heads)) { declarations[index] = -1; }
    ordinal := 0;
    for (index in 0..<length(types)) {
        if (!ScalarDeclares(types, types[index])) { continue; }
        assert(ordinal < length(heads));
        declarations[ordinal] = index;
        ordinal += 1;
    }
    owner := -1;
    for (row in rows) {
        if (row.kind == facts.RecordRow || row.kind == facts.UnionRow) { owner += 1; }
        if (row.kind == facts.FunctionRow) { owner = -1; }
        type := 0;
        if (row.kind == facts.MemberRow && row.type == facts.PointerType && owner >= 0) { wanted[owner] = true; }
        if (row.kind == facts.ManagedAddressRow) { type = row.count; }
        if (row.kind == facts.ManagedFieldRow || row.kind == facts.ManagedRow) { type = row.type; }
        if (type >= facts.ReferenceType) { type -= facts.ReferenceType; }
        if (type >= facts.RecordType && type < facts.ArrayType && type - facts.RecordType < length(wanted)) {
            wanted[type - facts.RecordType] = true;
        }
    }
    output := rows;
    for (index in 0..<length(heads)) {
        if (!wanted[index]) { continue; }
        record := declarations[index];
        if (ScalarPointerOptional(types, record)) {
            payload := types[record];
            if (payload.value_record >= 0) {
                child := types[payload.value_record];
                if (child.layout == 0) {
                    return ScalarOperands.Failed(Diagnose(forest, child.node, 0,
                        "native optional cells require a stable payload layout"));
                }
                for (at in child.first..<child.first + child.count) {
                    field := members[at];
                    if (field.container != 0 || field.record >= 0 || (!Numeric(field.storage) && field.storage != BoolStorage)) {
                        return ScalarOperands.Failed(Diagnose(forest, child.node, 0,
                            "native optional cells require plain numeric or bool payloads"));
                    }
                }
            }
            header := output[heads[index]];
            header.literal = ScalarPointerTag(types, {storage: UnionStorage, container: 0, record: record});
            output[heads[index]] = header;
            continue;
        }
        // Structural join wrappers are traced inline. A zero identity keeps
        // them outside the managed-cell allocation/projection contract.
        if (record >= 0 && types[record].kind == TaskResultDecl) { continue; }
        if (record < 0 || types[record].kind != RecordDecl || types[record].layout == 0) {
            return ScalarOperands.Failed(Diagnose(forest, 0, 0, "native managed records require a stable authored layout"));
        }
        declared := types[record];
        header := output[heads[index]];
        header.literal = ScalarPointerTag(types, {storage: StructStorage, container: 0, record: record});
        output[heads[index]] = header;
        for (ordinal in 0..<declared.count) {
            field := members[declared.first + ordinal];
            scalar := field.record == -1 && (Numeric(field.storage) || field.storage == BoolStorage);
            pointer := field.storage == PointerStorage && ScalarPointerType(types, field.record) != 0;
            if (field.container != 0 || (!scalar && !pointer) || CharType(types, field.storage, field.container, field.record)) {
                return ScalarOperands.Failed(Diagnose(forest, declared.node, 0,
                    "native managed record cells require flat numeric, bool or pointer fields"));
            }
            member := output[heads[index] + 1 + ordinal];
            member.literal = ScalarPointerTag(types, {storage: field.storage, container: 0, record: field.record});
            output[heads[index] + 1 + ordinal] = member;
        }
    }
    return ScalarOperands.Built(output);
}
