.menu-check { position: relative; tab-index: auto; }
.menu-check input { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; tab-index: none; }
.menu-check .lead { opacity: 0; }
.menu-check input:checked ~ .lead { opacity: 1; }
.menu-check:hover { background-color: var(--primary); color: var(--primary-foreground); }
.menu-check:hover .lead { color: var(--primary-foreground); }
.menu-check:focus-visible { background-color: var(--primary); color: var(--primary-foreground); }
.menu-check:focus-visible .lead { color: var(--primary-foreground); }
