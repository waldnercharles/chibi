version 1
name "Rendering3D"
presentation "3d"
(array)entities {
    - name="View" prototype="RenderView"
    - {
        name "Environment"
        prototype "Stage"
        components {
            Environment ambient_sky=0x404860ff ambient_ground=0x101820ff ambient_intensity=0.7 tone_mapping="AgX" bloom_strength=0.12 bloom_threshold=1.0 bloom_radius=0.012 occlusion="Medium" occlusion_radius=24.0
            DirectionalLight {
                direction x=0.4 y=-1.0 z=-0.4
                color 0xffecd0ff
                intensity 1.4
                shadows #true
                angular_diameter 3.0
            }
        }
    }
    - {
        name "Floor"
        prototype "RenderSolid"
        components {
            Geometry3D width=340.0 depth=220.0 height=8.0 elevation=-4.0
            Shader material="SurfaceActivity"
        }
    }
    - {
        name "Frame"
        prototype "RenderFrame"
        components {
            Transform x=-100.0 y=-10.0
        }
    }
    - {
        name "ImportedWedge"
        prototype "RenderWedge"
        components {
            Transform3D {
                position y=30.0 z=-10.0
                rotation w=1.0
                scale x=1.0 y=1.0 z=1.0
            }
            Geometry3D width=60.0 height=60.0 depth=60.0
        }
    }
    - {
        name "AssembledPedestal"
        prototype "RenderPedestal"
        components {
            Transform x=100.0 y=-10.0
        }
    }
    - {
        name "PointLamp"
        prototype "Stage"
        components {
            Transform x=-90.0 y=55.0
            PointLight color=0xff8040ff intensity=5.0 radius=180.0 elevation=90.0 shadows=#true
        }
    }
    - {
        name "SpotLamp"
        prototype "Stage"
        components {
            Transform x=100.0 y=30.0
            SpotLight {
                direction x=0.0 y=-1.0 z=-0.4
                color 0x80a0ffff
                intensity 8.0
                radius 180.0
                elevation 100.0
                inner_angle 35.0
                outer_angle 65.0
                shadows #true
            }
        }
    }
    - {
        name "Activity"
        prototype "SurfaceActivitySource"
        components {
            Transform x=0.0 y=55.0
        }
    }
}
