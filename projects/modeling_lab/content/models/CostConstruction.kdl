version 3
name "CostConstruction"
domain "model"
id_counter 19
description "A bounded 24-part radial construction deliberately repeats field work while retaining a small authored graph."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 6
                type "Model Sphere"
                inputs Radius=3.0
            }
            - {
                id 9
                type "Model Translate"
                inputs {
                    Offset {
                        default x=10.0 y=0.0 z=0.0
                    }
                }
            }
            - {
                id 13
                type "Model Radial Array"
                inputs Count=24 "Angle Step"=0.2617994
            }
        }
        (array)edges {
            - from="6.Geometry" to="9.Geometry"
            - from="9.Geometry" to="13.Geometry"
            - from="13.Geometry" to="1.Geometry"
        }
    }
}
