version 3
name "AnalyticalSphere"
domain "shape"
bounds_x 30.0
bounds_y 30.0
id_counter 24
description "Independent numerical reference, length(p) - 30, with manual rendering bounds."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Shader Shape Output"
            - id=3 type="Shader ObjectPosition"
            - {
                id 21
                type "Behavior Expression"
                reference_name "length(p) - 30"
                inputs {
                    p id=22 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=23 type="float"
                }
            }
        }
        (array)edges {
            - from="3.Value" to="21.p"
            - from="21.Result" to="1.Distance"
        }
    }
    - id=5 kind="function" math_expression="length(p) - 30" entry_id=6
}
