package retained_snapshot_runtime
import native "project:llvm_native"
import abi "project:native_abi"
import os "core:os"
import strings "core:strings"
import link "project:native_link"
import host "project:native_link_host"
Op :: (op: int, type: int, output: int, left: int) -> native.Instruction {
    return {op: op, type: type, output: output, left: left, right: 0, target: 0, literal: 0};
}
// Use the production object/link path and the shared poison/balance oracle.
Run :: (target: abi.Target, work: string, llvm: string, text: string) -> int {
    module := strings.Concatenate([work, "/runtime.ll"]);
    start := strings.Concatenate([work, "/runtime-start.ll"]);
    if os.WriteText(module, text) || os.WriteText(start, link.Start(target.triple, false, true)) { return 2; }
    for level in [int(0), 2] {
        objects := [format_text("{}/runtime-O{}.o", work, level), format_text("{}/runtime-start-O{}.o", work, level)];
        if host.Objects(llvm, [module, start], objects, level, 1) { return 1; }
        program := format_text("{}/runtime-O{}", work, level);
        plan := link.Program(target.triple, llvm, objects, [], [], [], program, "", false);
        if os.Platform() == "Darwin" {
            plan.imports = [{name: "System", symbols: ["malloc", "calloc", "free", "dprintf", "abort", "snprintf", "_exit"]}];
        }
        if host.Link(plan) || os.Run([program]) != 0 { return 1; }
    }
    return 0;
}
Main :: () -> int {
    arguments := os.Arguments();
    if length(arguments) != 4 { return 2; }
    work := arguments[0];
    llvm := arguments[1];
    runtime := os.ReadText(arguments[2]);
    if runtime.error { return 2; }
    audit := os.ReadText(arguments[3]);
    if audit.error { return 2; }
    target := abi.LinuxX64();
    if os.Platform() == "Darwin" { target = abi.MacOSArm64(); }
    ai := native.ArrayType + abi.IntStorage;
    aa := native.ArrayType + native.RecordType;
    at := native.ArrayType + native.RecordType + 1;
    texts := native.ArrayType + abi.TextStorage;
    records: native.Record[] = [{first: 0, count: 3, identity: 0}, {first: 3, count: 2, identity: 0}];
    fields := [abi.IntStorage, abi.TextStorage, ai, abi.TextStorage, at];
    labels := ["number", "message", "values", "name", "children"];
    nodes: native.SnapshotShapeNode[] = [
        {kind: native.SnapshotArray, type: aa, extra: 0, first: 0, count: 1},
        {kind: native.SnapshotRecord, type: native.RecordType, extra: 0, first: 1, count: 3},
        {kind: native.SnapshotScalar, type: abi.IntStorage, extra: abi.ValueTag(abi.IntStorage), first: 0, count: 0},
        {kind: native.SnapshotScalar, type: abi.TextStorage, extra: abi.ValueTag(abi.TextStorage), first: 0, count: 0},
        {kind: native.SnapshotArray, type: ai, extra: 0, first: 4, count: 1},
        {kind: native.SnapshotRecord, type: native.RecordType + 1, extra: 0, first: 5, count: 2},
        {kind: native.SnapshotArray, type: at, extra: 0, first: 7, count: 1},
        {kind: native.SnapshotArray, type: texts, extra: 0, first: 8, count: 1}];
    shapes: native.SnapshotShapes = {nodes: nodes, edges: [
        {name: "", target: 1}, {name: "number", target: 2}, {name: "message", target: 3}, {name: "values", target: 4},
        {name: "", target: 2}, {name: "name", target: 3}, {name: "children", target: 6}, {name: "", target: 5}, {name: "", target: 3}], roots: [0, 6, 7, -1]};
    // The inline chain covers sparse copying: one owned leaf is visited
    // once, rather than copying each complete parent again on the way down.
    shape_nodes := shapes.nodes;
    shape_edges := shapes.edges;
    shape_nodes.append({kind: native.SnapshotScalar, type: abi.WordStorage, extra: abi.ValueTag(abi.WordStorage), first: 0, count: 0});
    for layer in 0..<100 {
        previous := native.RecordType + 1 + layer;
        records.append({first: length(fields), count: 2, identity: 0});
        fields.extend([abi.WordStorage, previous]);
        labels.extend(["tag", "inner"]);
        child := 5;
        if layer > 0 { child = length(shape_nodes) - 1; }
        shape_nodes.append({kind: native.SnapshotRecord, type: previous + 1, extra: 0, first: length(shape_edges), count: 2});
        shape_edges.extend([{name: "tag", target: 8}, {name: "inner", target: child}]);
    }
    shapes.nodes = shape_nodes;
    shapes.edges = shape_edges;
    roots := shapes.roots;
    roots.append(length(shape_nodes) - 1);
    shapes.roots = roots;
    slots: int[] = [];
    code := [Op(native.Check, 0, 0, 0)];
    retained := 0;
    for type in [aa, at, texts, ai, native.RecordType + 101] {
        slot := length(slots);
        slots.extend([type, type, type]);
        code.append(Op(native.Constant, type, slot, 0));
        code.append(Op(native.ValueCopy, type, slot + 1, slot));
        code.append(Op(native.ValueDrop, type, 0, slot + 1));
        load := Op(native.StateLoad, type, slot + 2, slot + 1);
        load.right = retained;
        load.target = retained;
        code.append(load);
        retained += 1;
    }
    slot := length(slots);
    slots.append(abi.IntStorage);
    code.append(Op(native.Constant, abi.IntStorage, slot, 0));
    code.append(Op(native.Publish, abi.IntStorage, 0, slot));
    code.append(Op(native.Return, 0, 0, 0));
    shape: native.Function = {result: abi.IntStorage, first_parameter: 0, parameters: 0, first_slot: 0, slots: length(slots),
        first_local: 0, locals: 0, first_code: 0, code: length(code), first_argument: 0, arguments: 0};
    switch native.EmitSnapshotLibrary(target, "SnapshotProbe", ["Frame"], [i64(1)], [shape], [], slots, [], code, [],
        records, fields, ["Frame.records", "Frame.tree", "Frame.texts", "Frame.numbers", "Frame.inline"], 1000000, labels, -1, [], shapes) {
        case .Rejected(instruction, message): os.Print(message); return 1;
        case .Emitted(text):
            module := strings.Concatenate([text, runtime.text, audit.text]);
            if Run(target, work, llvm, module) != 0 { return 1; }
    }
    return 0;
}
