    }
    if (options.numeric_base != 0 && options.numeric_base != 1 && options.numeric_base != 2) {
        return "Invalid formatter options: numeric_base must be preserve, decimal or hex";
    }
    if (options.exponent_group < 0 || options.exponent_group > 16) {
        return "Invalid formatter options: exponent_group must be 0..16";
    }
    if (options.string_escapes != 0 && options.string_escapes != 1 && options.string_escapes != 2) {
        return "Invalid formatter options: string_escapes must be preserve, minimal or ascii";
    }
    if (options.char_escapes != 0 && options.char_escapes != 1 && options.char_escapes != 2) {
        return "Invalid formatter options: char_escapes must be preserve, minimal or ascii";
    }
    if (options.imports != 0 && options.imports != 1 && options.imports != 2) {
