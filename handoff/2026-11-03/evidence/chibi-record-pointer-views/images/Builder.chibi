    return ["CONSTANT", "VARIABLE", "DELTA", "ARGUMENT", "LOCAL", "PRESENT", "TYPE_NAME", "OWNER", "WORLD", "CONTEXT", "STORAGE_NAME", "ARRAY", "QUERY_VARIABLE", "QUERY", "HOST_SLOT", "HOST_SERVICE", "COMMAND_SERVICE", "COMMAND_RESULT", "OWN_NAME", "COPY_STRING", "COPY_ARRAY", "INTERN_STRING", "STRING_EQUAL", "STATE_SELECT", "RANDOM", "ADD", "SUB", "MUL", "DIV", "MOD", "NEG", "ABS", "MIN", "MAX", "CONVERT", "CAST", "FLAGS", "LT", "LE", "GT", "GE", "EQ", "NE", "SELECT", "BIT_AND", "BIT_OR", "BIT_XOR", "BIT_NOT", "SHL", "SHR", "SIN", "COS", "TAN", "ASIN", "ACOS", "ATAN", "EXP", "LOG", "LOG10", "FRACT", "SIGN", "SQRT", "FLOOR", "CEIL", "ROUND", "POW", "ATAN2", "MOD_F32", "MOD_F64", "HYPOT", "FMA", "RANDOM_RANGE", "ENTITY", "COMPONENT", "COMPONENT_READ", "COLUMN", "COLUMN_TRY", "ROW", "INDEX", "LOAD", "READ", "RETRIGGER", "STORE", "STORE_VALUE", "RESULT", "SAVE", "RESULT_PRESENT", "RESULT_TYPE_NAME", "RESULT_ARRAY", "STORE_HEADER", "STORE_TYPE_NAME", "REQUIRE", "ASSERT", "WRITE", "COMPONENT_WRITE", "COMMAND_ARGUMENT", "COMMAND_OUTPUT", "COMMAND", "COMMAND_BEGIN", "HOST_CALL", "INVOKE", "SUSPEND", "DELAY", "POINT", "WATCH_BEGIN", "WATCH_RESET", "WATCH_VALUE", "WATCH_PRESENT", "WATCH_END", "TRACE", "CHECK", "CALL_CHECK", "ENTER", "LEAVE", "FAIL", "JUMP", "BRANCH", "RETURN", "SOURCE_POINT", "SOURCE_WATCH", "END"];
}
