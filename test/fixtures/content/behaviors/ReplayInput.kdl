version 3
name "ReplayInput"
id_counter 100
description "Fire sets velocity so replay exercises an authored input action."
owner_type "ecs.entity"
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Event" reference_name="Fire"
            - {
                id 14
                type "Set_GameVelocity"
                inputs {
                    Value {
                        default x=1.0 y=0.0
                    }
                }
                outputs {
                    Value id=35
                }
            }
        }
        (array)edges {
            - from="1.Then" to="14.Exec"
        }
    }
}
