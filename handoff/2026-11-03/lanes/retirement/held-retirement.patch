-/* The cache holds recovered compilers, each under the digest of everything
- * that decides its bytes: the seed, Compile's arguments (the sources and
- * the target) and the prepared format. The host that ran the recovery is
- * not part of it: recovery is deterministic and proves its fixed point, so
- * every host build (Debug, Release, sanitized, relocated) shares an entry. */
-#define CACHE_VERSION "chibi-compiler-cache-3"
-
-static void cache_key(const artifact *a, const char *json, size_t length, char key[BINARY_CACHE_KEY_BYTES + 1])
-{
-    char seed[65], arguments[65], digest[65];
-    sha256_hex(a->closure, a->closure_length, seed);
-    sha256_hex(json, length, arguments);
-    sha256 hash;
-    sha256_begin(&hash);
-    char text[256];
-    int used = snprintf(
-        text,
-        sizeof text,
-        CACHE_VERSION " prepared %d seed %s arguments %s",
-        EXECUTION_PREPARED_VERSION,
-        seed,
-        arguments
-    );
-    sha256_add(&hash, text, (size_t)used);
-    sha256_end(&hash, digest);
-    snprintf(key, BINARY_CACHE_KEY_BYTES + 1, "compiler-%s", digest);
-}
-
-/* One cache serves every checkout on the machine; past this many bytes the
- * entries written longest ago go first (reads don't refresh them). About 65
- * recovered compilers of 30 MB. */
-#define CACHE_BUDGET_BYTES (2048ull * 1024u * 1024u)
-
-/* Removes the oldest entries until `incoming` more bytes fit the budget. */
-static void cache_evict(const char *directory, uint64_t incoming)
-{
-    binary_cache_entry *entries = NULL;
-    int count = 0;
-    if (!binary_cache_list(directory, &entries, &count)) {
-        return;
-    }
-    uint64_t total = incoming;
-    for (int i = 0; i < count; i++) {
-        total += entries[i].bytes;
-    }
-    while (total > CACHE_BUDGET_BYTES) {
-        int oldest = -1;
-        for (int i = 0; i < count; i++) {
-            if (entries[i].bytes &&
-                (oldest < 0 || entries[i].stamp < entries[oldest].stamp)) {
-                oldest = i;
-            }
-        }
-        if (oldest < 0 || !binary_cache_remove(directory, entries[oldest].key)) {
-            break;
-        }
-        total -= entries[oldest].bytes;
-        entries[oldest].bytes = 0;
-    }
-    free(entries);
-}
-
-/* Keeps the recovered compiler for the next start. Losing the lock or the
- * write costs only that start's time. */
-static void cache_publish(const char *directory, const char *key, const unsigned char *bytes, size_t length)
-{
-    if (!directory || !key) {
-        return;
-    }
-    int lock = binary_cache_lock(directory);
-    if (lock < 0) {
-        return;
-    }
-    cache_evict(directory, length + BINARY_CACHE_HEADER_BYTES);
-    binary_cache_write(directory, key, bytes, length, COMPILER_HOST_MAX_CLOSURE_BYTES);
-    binary_cache_unlock(lock);
-}
-
-/* Writes the recovered compiler to output when there is one. */
-static bool written(const char *output, const unsigned char *bytes, size_t length, char *report, size_t size)
-{
-    if (output && !write_path(output, bytes, length)) {
-        snprintf(report, size, "%s cannot be written", output);
-        return false;
-    }
-    return true;
-}
-/* Compiles the sources with the artifact loaded in host, which this frees.
- * When they are the sources the artifact recorded, the result is the
- * artifact's own bytes. Otherwise the artifact only has to compile them, as
- * the seed of a Zig-style bootstrap: it compiles stage one, stage one compiles
- * stage two, and stage two, or stage one when it already is stage two's bytes,
- * must compile the sources to itself, so the artifact's code generation need
- * not match the sources'. Writes that fixed point to `output` when there is
- * one. This is the self-hosting proof; builds load stage one (stage_one). */
-static bool recover(
-    compiler_host *host,
-    const artifact *a,
-    const char *json,
-    size_t length,
-    int changed,
-    const char *output,
-    char *report,
-    size_t size
-)
-{
-    size_t first_length = 0, second_length = 0, third_length = 0;
-    unsigned char *first = compile(host, json, length, &first_length, report, size);
-    compiler_host_free(host);
-    if (!first) {
-        return false;
-    }
-    const char *revision = yyjson_get_str(yyjson_obj_get(a->root, "revision"));
-    revision = revision && *revision ? revision : "unrecorded";
-    char digest[65];
-    if (!changed) {
-        sha256_hex(first, first_length, digest);
-        bool valid = same(first, first_length, a->closure, a->closure_length);
-        if (valid) {
-            snprintf(
-                report,
-                size,
-                "recovered the compiler of revision %s: %zu bytes, sha256 %s",
-                revision,
-                first_length,
-                digest
-            );
-        } else {
-            snprintf(report, size, "the artifact compiles the sources it records to %zu other bytes", first_length);
-        }
-        valid = valid && written(output, first, first_length, report, size);
-        free(first);
-        return valid;
-    }
-    compiler_host *stage_one = compiler_host_load(first, first_length, behavior_default_backend(), report, size);
-    unsigned char *second = stage_one
-                              ? compile(stage_one, json, length, &second_length, report, size)
-                              : NULL;
-    unsigned char *fixed = first, *third = NULL;
-    size_t fixed_length = first_length;
-    compiler_host *fixed_host = stage_one;
-    bool valid = second != NULL;
-    if (valid && !same(second, second_length, first, first_length)) {
-        /* Stage one generates other code than the artifact did, so stage two
-         * is the first compiler built the way the sources build themselves. */
-        fixed = second;
-        fixed_length = second_length;
-        fixed_host = compiler_host_load(second, second_length, behavior_default_backend(), report, size);
-        compiler_host_free(stage_one);
-        third = fixed_host
-                  ? compile(fixed_host, json, length, &third_length, report, size)
-                  : NULL;
-        valid = third && same(third, third_length, second, second_length);
-        if (third && !valid) {
-            snprintf(report, size, "the second compiler compiles the sources to %zu other bytes, not to itself", third_length);
-        }
-    }
-    sha256_hex(fixed, fixed_length, digest);
-    if (valid) {
-        snprintf(
-            report,
-            size,
-            "%d compiler sources changed since revision %s; the artifact "
-            "compiled a compiler of %zu bytes%s, sha256 %s, that compiles "
-            "them to itself",
-            changed,
-            revision,
-            fixed_length,
-            third ? " (after a second compiler)" : "",
-            digest
-        );
-    }
-    valid = valid && written(output, fixed, fixed_length, report, size);
-    compiler_host_free(fixed_host);
-    free(third);
-    free(second);
-    free(first);
-    return valid;
-}
-
-/* Reads the contract, the artifact and Compile's arguments for the sources on
- * disk, rejecting what this host cannot admit. */
-static bool inputs(
-    const compiler_bootstrap *b,
-    artifact *a,
-    char **json,
-    size_t *length,
