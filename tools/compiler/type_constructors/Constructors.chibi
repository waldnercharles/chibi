package type_constructors

import named "project:named_binding"
import binding "project:lexical_binding"
import syntax "project:syntax_diagnostics"

// Original catalog order and spans, with no precomputed lookup/selection facts.
pub Definition :: struct {
    id_slot: int;
    variant_start: int;
    variant_count: int;
    element_type: int;
}
pub RawVariant :: struct {
    tag_slot: int;
    type: int;
}
pub Capability :: struct {
    id_slot: int;
    result_count: int;
}
pub Function :: struct {
    symbol: int;
    result_start: int;
    result_count: int;
}
pub Symbol :: struct {
    id_slot: int;
}
pub Environment :: union {
    Tables(types: named.Type[], ids: u64[], definitions: Definition[], variants: RawVariant[],
           capabilities: Capability[], functions: Function[], symbols: Symbol[], result_symbols: int[])
}
pub Request :: struct {
    pointer_size: int;
    start: int;
    end: int;
    line: int;
    column: int;
    document: int;
}
// Published selections refer to original metadata. Synthesized variants carry
// their exact scalar type and full-width IDs in the output pool.
Variant :: struct {
    catalog_type: int;
    variant: int;
    member: int;
    storage: int;
    container: int;
    flags: int;
    nominal_slot: int;
    parameter_slot: int;
    tag_slot: int;
    collection: u64;
}
Field :: struct {
    capability: int;
    parameter: int;
    symbol: int;
}
Selections :: union {
    Selected(variants: Variant[], ids: u64[])
}
pub Plan :: union {
    Constructed(value: named.Value, publish: bool, id: u64, name: string,
                definition: named.Value, size: int, internal: bool,
                variants: Variant[], fields: Field[], ids: u64[], diagnostics: syntax.Diagnostic[],
                element_type: named.Value, element_collection: u64)
}

Tag :: (value: named.Value, collection: u64) -> u64 {
    switch value {
        case .Typed(storage, container, flags, nominal, parameter):
            if ((flags & 512) != 0) {
                return nominal;
            }
            if ((flags & 1024) != 0) {
                return parameter;
            }
            nominal_id := nominal;
            result: u64 = 0;
            if ((flags & 64) != 0) {
                nominal_id = 0;
                result = parameter;
            }
            if (collection != 0) {
                return binding.ID("union-type", format_text("{}:{}:{}:{}:{}:{}", storage, container, nominal_id, result, flags & 74, collection));
            }
            return binding.ID("union-type", format_text("{}:{}:{}:{}:{}", storage, container, nominal_id, result, flags & 74));
    }
}
FindDefinition :: (environment: Environment, id: u64) -> int {
    switch environment {
        case .Tables(types, ids, definitions, variants, capabilities, functions, symbols, results):
            index: int = 0;
            while (index < length(definitions)) {
                if (named.IDAt(ids, definitions[index].id_slot) == id) {
                    return index;
                }
                index += 1;
            }
            return -1;
    }
}
Select :: (selection: Selections, value: named.Value, catalog_type: int, variant: int,
           member: int, tag: u64, collection: u64) -> Selections {
    switch selection {
        case .Selected(payload_rows, payload_ids):
            rows := payload_rows;
            ids := payload_ids;
            index: int = 0;
            while (index < length(rows)) {
                if (ids[rows[index].tag_slot] == tag) {
                    return selection;
                }
                index += 1;
            }
            switch value {
                case .Typed(storage, container, flags, nominal, parameter):
                    slot := length(ids);
                    ids.append(nominal);
                    ids.append(parameter);
                    ids.append(tag);
                    row: Variant = {catalog_type: catalog_type, variant: variant, member: member,
                                    storage: storage, container: container, flags: flags,
                                    nominal_slot: slot, parameter_slot: slot + 1, tag_slot: slot + 2, collection: collection};
                    rows.append(row);
                    return Selections.Selected(rows, ids);
            }
    }
}
SelectMember :: (environment: Environment, selection: Selections, value: named.Value, member: int, collection: u64) -> Selections {
    switch value {
        case .Typed(storage, container, flags, nominal, parameter):
            nested: int = -1;
            if ((flags & 256) != 0 && (flags & 2048) == 0 && container == 0) {
                nested = FindDefinition(environment, nominal);
            }
            if (nested < 0) {
                return Select(selection, value, -1, -1, member, Tag(value, collection), collection);
            }
            switch environment {
                case .Tables(types, ids, definitions, variants, capabilities, functions, symbols, results):
                    definition := definitions[nested];
                    index: int = 0;
                    while (index < definition.variant_count) {
                        original := variants[definition.variant_start + index];
                        tag := named.IDAt(ids, original.tag_slot);
                        if (parameter == 0 || tag == parameter) {
                            selection = Select(selection, named.TypeAt(types, ids, original.type), nested, index, -1, tag, types[original.type].collection);
                        }
                        index += 1;
                    }
                    return selection;
            }
    }
}
// Compare the first differing bit from most to least significant. This stays
// within the bootstrap executor's supported unsigned bit operations.
TagAfter :: (left: u64, right: u64) -> bool {
    mask: u64 = 1 << 63;
    while (mask != 0) {
        left_bit := left & mask;
        right_bit := right & mask;
        if (left_bit != right_bit) {
            return left_bit != 0;
        }
        mask = mask >> 1;
    }
    return false;
}
FinishUnion :: (environment: Environment, selection: Selections, pointer_size: int,
                diagnostics: syntax.Diagnostic[]) -> Plan {
    fields: Field[] = [];
    switch selection {
        case .Selected(payload_rows, payload_ids):
            rows := payload_rows;
            ids := payload_ids;
            index: int = 1;
            while (index < length(rows)) {
                cursor := index;
                while (cursor > 0 && TagAfter(ids[rows[cursor - 1].tag_slot], ids[rows[cursor].tag_slot])) {
                    previous := rows[cursor - 1];
                    rows[cursor - 1] = rows[cursor];
                    rows[cursor] = previous;
                    cursor -= 1;
                }
                index += 1;
            }
            id: u64 = 14695981039346656037;
            index = 0;
            while (index < length(rows)) {
                id = (id ^ ids[rows[index].tag_slot]) * 1099511628211;
                index += 1;
            }
            value := named.Value.Typed(18, 0, 256, id, 0);
            if (FindDefinition(environment, id) >= 0) {
                empty: Variant[] = [];
                noIDs: u64[] = [];
                return Plan.Constructed(value, false, 0, "",
                                        named.Value.Typed(0, 0, 0, 0, 0),
                                        0, false, empty, fields, noIDs, diagnostics, named.Value.Typed(0, 0, 0, 0, 0), 0);
            }
            return Plan.Constructed(value, true, id, format_text("union:{}", id), value,
                                    pointer_size, true, rows, fields, ids, diagnostics, named.Value.Typed(0, 0, 0, 0, 0), 0);
    }
}
pub Union :: (environment: Environment, members: int[], pointer_size: int) -> Plan {
    rows: Variant[] = [];
    ids: u64[] = [];
    selection := Selections.Selected(rows, ids);
    switch environment {
        case .Tables(types, sourceIDs, definitions, variants, capabilities, functions, symbols, results):
            index: int = 0;
            while (index < length(members)) {
                selection = SelectMember(environment, selection, named.TypeAt(types, sourceIDs, members[index]), index, types[members[index]].collection);
                index += 1;
            }
    }
    diagnostics: syntax.Diagnostic[] = [];
    return FinishUnion(environment, selection, pointer_size, diagnostics);
}
pub Task :: (environment: Environment, result: int, function: u64) -> Plan {
    fields: Field[] = [];
    variants: Variant[] = [];
    outputIDs: u64[] = [];
    diagnostics: syntax.Diagnostic[] = [];
    switch environment {
        case .Tables(types, ids, definitions, rawVariants, capabilities, functions, symbols, results):
            descriptor := named.TypeAt(types, ids, result);
            id := Tag(descriptor, 0);
            value := named.Value.Typed(17, 0, 64, function, id);
            if (FindDefinition(environment, id) >= 0) {
                return Plan.Constructed(value, false, 0, "",
                                        named.Value.Typed(0, 0, 0, 0, 0),
                                        0, false, variants, fields, outputIDs, diagnostics, named.Value.Typed(0, 0, 0, 0, 0), 0);
            }
            if ((types[result].flags & 8) != 0) {
                capability: int = -1;
                index: int = 0;
                while (index < length(capabilities) && capability < 0) {
                    if (named.IDAt(ids, capabilities[index].id_slot) == function) {
                        capability = index;
                    }
                    index += 1;
                }
                if (capability >= 0) {
                    index = 0;
                    while (index < capabilities[capability].result_count) {
                        field: Field = {capability: capability, parameter: index, symbol: -1};
                        fields.append(field);
                        index += 1;
                    }
                } else {
                    function_index: int = -1;
                    index = 0;
                    while (index < length(functions) && function_index < 0) {
                        candidate := functions[index];
                        if (candidate.symbol >= 0 && named.IDAt(ids, symbols[candidate.symbol].id_slot) == function) {
                            function_index = index;
                        }
                        index += 1;
                    }
                    if (function_index >= 0) {
                        index = 0;
                        while (index < functions[function_index].result_count) {
                            field: Field = {capability: -1, parameter: -1, symbol: results[functions[function_index].result_start + index]};
                            fields.append(field);
                            index += 1;
                        }
                    }
                }
            }
            return Plan.Constructed(value, true, id, format_text("task-result:{}", id), descriptor,
                                    0, true, variants, fields, outputIDs, diagnostics, named.Value.Typed(0, 0, 0, 0, 0), 0);
    }
}
pub Await :: (environment: Environment, success: int, request: Request) -> Plan {
    diagnostics: syntax.Diagnostic[] = [];
    rows: Variant[] = [];
    outputIDs: u64[] = [];
    selection := Selections.Selected(rows, outputIDs);
    switch environment {
        case .Tables(types, ids, definitions, variants, capabilities, functions, symbols, results):
            value := named.TypeAt(types, ids, success);
            cancelled := (types[success].flags & 512) != 0;
            definition: int = -1;
            if ((types[success].flags & 256) != 0) {
                definition = FindDefinition(environment, named.IDAt(ids, types[success].nominal_slot));
            }
            if (definition >= 0) {
                index: int = 0;
                while (index < definitions[definition].variant_count) {
                    tag := named.IDAt(ids, variants[definitions[definition].variant_start + index].tag_slot);
                    if (tag == 0x63616e63656c6c65) {
                        cancelled = true;
                    }
                    index += 1;
                }
            }
            if (cancelled) {
                diagnostic: syntax.Diagnostic = {start: request.start, end: request.end, line: request.line,
                                                 column: request.column, document: request.document,
                                                 message: "Cancelled is reserved for task cancellation, not a successful task result"};
                diagnostics.append(diagnostic);
            }
            selection = SelectMember(environment, selection, value, 0, types[success].collection);
            selection = SelectMember(environment, selection, named.Value.Typed(18, 0, 512,
                                                                               0x63616e63656c6c65, 0), 1, 0);
    }
    return FinishUnion(environment, selection, request.pointer_size, diagnostics);
}

// A pointer names its complete pointee, including optional/container metadata.
// Its payload metadata is published independently of the returned pointer type.
pub Pointer :: (environment: Environment, pointee: int, pointer_size: int) -> Plan {
    fields: Field[] = [];
    variants: Variant[] = [];
    outputIDs: u64[] = [];
    diagnostics: syntax.Diagnostic[] = [];
    switch environment {
        case .Tables(types, ids, definitions, rawVariants, capabilities, functions, symbols, results):
            element := named.TypeAt(types, ids, pointee);
            collection := types[pointee].collection;
            id := binding.ID("pointer-type", format_text("{}", Tag(element, collection)));
            value := named.Value.Typed(19, 0, 0, id, 0);
            if (FindDefinition(environment, id) >= 0) {
                return Plan.Constructed(value, false, 0, "",
                                        named.Value.Typed(0, 0, 0, 0, 0),
                                        0, false, variants, fields, outputIDs, diagnostics,
                                        named.Value.Typed(0, 0, 0, 0, 0), 0);
            }
            return Plan.Constructed(value, true, id, format_text("__pointer_{}", id), value,
                                    pointer_size, true, variants, fields, outputIDs, diagnostics, element, collection);
    }
}
