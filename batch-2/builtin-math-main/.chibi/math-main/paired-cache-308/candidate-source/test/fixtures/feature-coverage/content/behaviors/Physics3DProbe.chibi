Physics3DProbe :: behavior {
    on Tick :: () {
        place := self.GlobalTransform3D.position
        below := raycast_3d(place, place - vec3(0, 320, 0), 1, self, false)
        ahead := shape_cast_3d(self, vec3(64, 0, 0), 1, false)
        touching := contact_entities_3d(self, 1)
        apply_force_3d(self, vec3(0, self.Body3D.mass * 2, 0))
    }
    on ContactBegin3D :: (Point: vec3) {
        landed := Point
        apply_impulse_3d(self, vec3(0, self.Body3D.mass * 32, 0))
    }
    on ContactEnd3D :: (Other: entity) {
        left := Other
    }
}
