package engine

import files "graph:files"
import os "core:os"
import strings "core:strings"

// Finds a build profile's toolchain, as the Makefile and root CMakeLists.txt
// find it when nothing is chosen: the named profiles are the Makefile's
// SANITIZER_, DEBUG_ and RELEASE_CMAKE_FLAGS, its default the first.

// The profile `name` names on this machine, or a profile whose compiler is
// empty when the name is unknown or no compiler is found. Its C++ compiler
// and archive depend on the compiler and sanitizers a caller may override, so
// CxxCompiler and ThirdParty find them once they are final.
pub Discover :: (name: string, source_root: string, build_dir: string, libclang_root: string) -> Profile {
    compiler := DiscoverCompiler();
    profile: Profile = {
        compiler: compiler,
        cxx_compiler: "",
        compiler_id: CompilerId(compiler),
        build_type: "Debug",
        debug_optimization: "",
        debug_frame_pointers: false,
        architecture: "",
        sysroot: "",
        warnings: true,
        sanitizers: "",
        debug_compilation_dir: "",
        libclang_include: "",
        opengl_library: "", opengl_include: "", glx_library: "",
        libclang_library: "",
        clang_resource_include: "",
        third_party: "",
        reflect: "",
        asset_generator_hosts: ""
    };
    if (name == "sanitizer") {
        profile.sanitizers = "address,undefined";
    } else if (name == "release") {
        profile.build_type = "Release";
    } else if (name != "debug") {
        profile.compiler = "";
    }
    if (os.Platform() == "Darwin") {
        uname := os.Capture(["uname", "-m"]);
        if (uname.status == 0) {
            profile.architecture = strings.TrimSpace(uname.stdout);
        }
        profile.sysroot = DiscoverSysroot(compiler);
    }
    profile.debug_compilation_dir = CcacheDebugDirectory(source_root, build_dir);
    profile.libclang_include = DiscoverLibclang("include", libclang_root);
    profile.libclang_library = DiscoverLibclang("library", libclang_root);
    profile.clang_resource_include = ClangResourceInclude(profile.libclang_library);
    return profile;
}

// The unpacked third-party archive cmake/third_party.cmake loads for a
// profile: third_party/archives.tsv's pin for this host's target and the
// profile's variant, below .git/chibi/third_party in the clone's Git
// directory, where tools/toolchain/Build.chibi unpacks it. Sanitized builds
// use the archive instrumented the same way, except with Apple clang, whose
// sanitizer runtime the instrumented archives do not link with. Empty when
// nothing is pinned for this host; the directory is missing until something
// unpacks it. Build.chibi's ThirdPartyTarget and ThirdPartyCache name the
// target and cache the same way; that program parses with older hosts, so it
// keeps its own copy.
pub ThirdParty :: (source_root: string, compiler_id: string, sanitizers: string) -> string {
    uname := os.Capture(["uname", "-m"]);
    if (uname.status != 0) {
        return "";
    }
    machine := strings.TrimSpace(uname.stdout);
    family := "linux";
    if (os.Platform() == "Darwin") {
        family = "macos";
    }
    architecture := "x64";
    if (machine == "arm64" || machine == "aarch64") {
        architecture = "arm64";
    }
    variant := "release";
    if (compiler_id != "AppleClang" && sanitizers == "address,undefined") {
        variant = "address-undefined";
    } else if (compiler_id != "AppleClang" && sanitizers == "thread") {
        variant = "thread";
    }
    cache := Join([source_root, "/.chibi/third_party"]);
    git := os.Capture(["git", "-C", source_root, "rev-parse", "--path-format=absolute", "--git-common-dir"]);
    if (git.status == 0) {
        cache = Join([strings.TrimSpace(git.stdout), "/chibi/third_party"]);
    }
    pin := Join([family, "-", architecture, "\t", variant, "\t"]);
    for (line in strings.Lines(files.Text(Join([source_root, "/third_party/archives.tsv"])))) {
        if (strings.HasPrefix(line, pin)) {
            return Join([cache, "/", strings.Partition(strings.Partition(strings.Partition(line, "\t").tail, "\t").tail, "\t").tail]);
        }
    }
    return "";
}

// CC, or Homebrew LLVM's clang as the Makefile prefers it, or cc.
DiscoverCompiler :: () -> string {
    chosen := os.Getenv("CC");
    if (chosen == "" && os.Exists("/opt/homebrew/opt/llvm/bin/clang")) {
        return "/opt/homebrew/opt/llvm/bin/clang";
    }
    if (chosen == "" && os.Getenv("CXX") == "" && os.Platform() == "Linux" &&
        os.FindExecutable("clang") != "" && os.FindExecutable("clang++") != "") {
        chosen = "clang";
    }
    if (chosen == "") {
        chosen = "cc";
    }
    return os.FindExecutable(chosen);
}

// CXX, or the C++ driver beside a C compiler named clang, gcc or cc, or the
// one on PATH for the compiler's kind, as CMake finds them. Empty when none
// is found.
pub CxxCompiler :: (compiler: string, compiler_id: string) -> string {
    chosen := os.Getenv("CXX");
    if (chosen != "") {
        return os.FindExecutable(chosen);
    }
    directory := strings.Slice(compiler, 0, strings.LastIndex(compiler, "/") + 1);
    name := strings.Slice(compiler, strings.ByteLength(directory), strings.ByteLength(compiler));
    for (pair in ["clang=clang++", "gcc=g++", "cc=c++"]) {
        prefix := strings.Partition(pair, "=").head;
        if (name == prefix || strings.HasPrefix(name, Join([prefix, "-"]))) {
            suffix := strings.Slice(name, strings.ByteLength(prefix), strings.ByteLength(name));
            candidate := Join([directory, strings.Partition(pair, "=").tail, suffix]);
            if (os.Exists(candidate)) {
                return candidate;
            }
        }
    }
    if (compiler_id == "GNU") {
        return os.FindExecutable("g++");
    }
    if (compiler_id == "Clang" || compiler_id == "AppleClang") {
        return os.FindExecutable("clang++");
    }
    return os.FindExecutable("c++");
}

// AppleClang, Clang or GNU, from the compiler's version banner, as CMake
// names them; empty for another compiler.
pub CompilerId :: (compiler: string) -> string {
    if (compiler == "") {
        return "";
    }
    version := os.Capture([compiler, "--version"]);
    if (version.status != 0) {
        return "";
    }
    banner := version.stdout;
    if (strings.Contains(banner, "Apple clang")) {
        return "AppleClang";
    }
    if (strings.Contains(banner, "clang version")) {
        return "Clang";
    }
    if (strings.Contains(banner, "Free Software Foundation") || strings.HasPrefix(banner, "gcc")) {
        return "GNU";
    }
    return "";
}

// SDKROOT, or the SDK the compiler passes its cc1 with -isysroot, or the one
// xcrun names, as tools/toolchain/Build.chibi finds it for CMake.
DiscoverSysroot :: (compiler: string) -> string {
    chosen := os.Getenv("SDKROOT");
    if (chosen != "") {
        return chosen;
    }
    trace := os.Capture([compiler, "-###", "-x", "c", "-fsyntax-only", "/dev/null"]);
    if (trace.status == 0) {
        report := trace.stderr;
        flag := "\"-isysroot\" \"";
        at := strings.Index(report, flag);
        if (at >= 0) {
            rest := strings.Slice(report, at + strings.ByteLength(flag), strings.ByteLength(report));
            // The SDK is often a versioned link, as MacOSX26.sdk is; CMake's
            // cache holds the directory it names.
            sdk := os.RealPath(strings.Slice(rest, 0, strings.Index(rest, "\"")));
            if (os.IsDirectory(sdk)) {
                return sdk;
            }
        }
    }
    xcrun := os.Capture(["xcrun", "--show-sdk-path"]);
    if (xcrun.status == 0) {
        return strings.TrimSpace(xcrun.stdout);
    }
    return "";
}

// What CMake names debug info's directory when ccache compiles a build below
// the source tree: the build's path there with every component `build`, so
// differently named builds share ccache objects. Empty without ccache or for
// a build elsewhere.
pub CcacheDebugDirectory :: (source_root: string, build_dir: string) -> string {
    prefix := Join([source_root, "/"]);
    if (os.FindExecutable("ccache") == "" || !strings.HasPrefix(build_dir, prefix)) {
        return "";
    }
    parts: string[] = [];
    for (part in strings.Split(strings.Slice(build_dir, strings.ByteLength(prefix), strings.ByteLength(build_dir)), "/")) {
        if (part != "") {
            parts.append("build");
        }
    }
    return strings.Join(parts, "/");
}

// Environment path lists use the host's separator; spaces belong to a path.
LibclangEnvironment :: (name: string) -> string[] {
    separator := ":";
    if (os.Platform() == "Windows") {
        separator = ";";
    }
    return strings.Split(os.Getenv(name), separator);
}

// Conventional include/library directories still identify one installation.
// Keep its headers and library together instead of combining LLVM versions.
LibclangPrefix :: (directory: string) -> string {
    while (strings.ByteLength(directory) > 1 && strings.HasSuffix(directory, "/")) {
        directory = strings.Slice(directory, 0, strings.ByteLength(directory) - 1);
    }
    if (directory == "include" || directory == "lib" || directory == "lib64") {
        return ".";
    }
    for (suffix in ["/include", "/lib", "/lib64"]) {
        if (strings.HasSuffix(directory, suffix)) {
            return strings.Slice(directory, 0, strings.ByteLength(directory) - strings.ByteLength(suffix));
        }
    }
    multiarch := strings.LastIndex(directory, "/lib/");
    if (multiarch >= 0) {
        return strings.Slice(directory, 0, multiarch);
    }
    if (strings.HasPrefix(directory, "lib/") && strings.LastIndex(directory, "/") == 3) {
        return ".";
    }
    return "";
}

LibclangLibrary :: (prefix: string) -> string {
    directories := [Join([prefix, "/lib"]), Join([prefix, "/lib64"])];
    if (os.Platform() == "Linux") {
        uname := os.Capture(["uname", "-m"]);
        if (uname.status == 0) {
            machine := strings.TrimSpace(uname.stdout);
            if (machine == "arm64") {
                machine = "aarch64";
            }
            directories.append(Join([prefix, "/lib/", machine, "-linux-gnu"]));
        }
    }
    for (directory in directories) {
        for (name in ["libclang.dylib", "libclang.so", "libclang-18.dylib", "libclang-18.so", "libclang.a", "libclang-18.a"]) {
            path := Join([directory, "/", name]);
            if (os.Exists(path)) {
                return path;
            }
        }
    }
    return "";
}

// Relative environment paths name directories below the engine source root.
// Preserve absolute aliases, including drive paths, in generated commands.
LibclangAbsolutePrefix :: (prefix: string) -> string {
    drive := strings.ByteLength(prefix) >= 3 && strings.Slice(prefix, 1, 1) == ":" &&
             (strings.Slice(prefix, 2, 1) == "/" || strings.Slice(prefix, 2, 1) == "\\");
    if (strings.HasPrefix(prefix, "/") || strings.HasPrefix(prefix, "\\\\") || drive) {
        return prefix;
    }
    return os.RealPath(Join([os.Root(), "/", prefix]));
}

// An explicit root wins, followed by environment prefixes, known LLVM installs
// and ordinary system prefixes. Each candidate must own both headers/library.
DiscoverLibclang :: (part: string, root: string) -> string {
    prefixes := [root];
    prefixes.extend(LibclangEnvironment("CMAKE_PREFIX_PATH"));
    for (variable in ["CMAKE_INCLUDE_PATH", "CMAKE_LIBRARY_PATH"]) {
        for (directory in LibclangEnvironment(variable)) {
            prefixes.append(LibclangPrefix(directory));
        }
    }
    prefixes.extend(["/opt/homebrew/opt/llvm", "/usr/local/opt/llvm"]);
    versions: string[] = [];
    for (name in files.Names("/usr/lib")) {
        if (strings.HasPrefix(name, "llvm-")) {
            versions.append(name);
        }
    }
    // Newest first: a longer version number is newer, then the larger.
    for (i in 0..<length(versions)) {
        for (j in i + 1..<length(versions)) {
            a := versions[i];
            b := versions[j];
            if (strings.ByteLength(b) > strings.ByteLength(a) ||
                (strings.ByteLength(b) == strings.ByteLength(a) && strings.Compare(b, a) > 0)) {
                versions[i] = b;
                versions[j] = a;
            }
        }
    }
    for (version in versions) {
        prefixes.append(Join(["/usr/lib/", version]));
    }
    prefixes.extend(["/usr/local", "/usr", "/"]);
    for (candidate in prefixes) {
        if (candidate == "") {
            continue;
        }
        prefix := LibclangAbsolutePrefix(candidate);
        if (prefix == "") {
            continue;
        }
        include := Join([prefix, "/include"]);
        if (!os.Exists(Join([include, "/clang-c/Index.h"]))) {
            continue;
        }
        shared := LibclangLibrary(prefix);
        if (shared != "") {
            if (part == "include") {
                return include;
            }
            return shared;
        }
    }
    return "";
}

// The archiver and indexer beside the compiler, as LLVM ships them, or those
// on PATH.
pub DiscoverTool :: (compiler: string, llvm: string, name: string) -> string {
    beside := Join([strings.Slice(compiler, 0, strings.LastIndex(compiler, "/")), "/", llvm]);
    if (os.Exists(beside)) {
        return beside;
    }
    return os.FindExecutable(name);
}

// Linux development libraries, in explicit search paths then the compiler's
// native library directories. Keep the unversioned linker name, as CMake does.
pub SystemLibrary :: (compiler: string, name: string) -> string {
    directories: string[] = [];
    for (variable in ["CMAKE_LIBRARY_PATH", "LIBRARY_PATH"]) {
        directories.extend(strings.Split(os.Getenv(variable), ":"));
    }
    if (compiler != "") {
        dirs := os.Capture([compiler, "-print-search-dirs"]);
        if (dirs.status == 0) {
            for (line in strings.Lines(dirs.stdout)) {
                if (strings.HasPrefix(line, "libraries: =")) {
                    directories.extend(strings.Split(strings.Partition(line, "libraries: =").tail, ":"));
                }
            }
        }
    }
    for (directory in directories) {
        if (directory != "" && os.Exists(Join([directory, "/", name]))) {
            return Join([os.RealPath(directory), "/", name]);
        }
    }
    return "";
}

// Find OpenGL headers independently of the shared libraries, as FindOpenGL
// does. The standard /usr/include remains implicit in compiler commands.
pub OpenGLInclude :: () -> string {
    directories: string[] = [];
    for (variable in ["CMAKE_INCLUDE_PATH", "CPATH", "C_INCLUDE_PATH"]) {
        directories.extend(strings.Split(os.Getenv(variable), ":"));
    }
    for (prefix in strings.Split(os.Getenv("CMAKE_PREFIX_PATH"), ":")) {
        if (prefix != "") {
            directories.append(Join([prefix, "/include"]));
        }
    }
    directories.append("/usr/include");
    for (directory in directories) {
        if (directory != "" && os.Exists(Join([directory, "/GL/gl.h"]))) {
            return os.RealPath(directory);
        }
    }
    return "";
}

// Why an option the profile takes is invalid, or "" when none is. The
// Debug-only options take one of their values and the Debug build type, and
// an omitted value is rejected too: Option alone falls back at end-of-argv.
pub ProfileOptionError :: (arguments: string[], build_type: string) -> string {
    for (i in 0..<length(arguments)) {
        if (arguments[i] == "--debug-optimization" &&
            (i + 1 == length(arguments) ||
             (arguments[i + 1] != "0" && arguments[i + 1] != "1") ||
             build_type != "Debug")) {
            return "graph: --debug-optimization requires 0 or 1 and build type Debug";
        }
        if (arguments[i] == "--debug-frame-pointers" &&
            (i + 1 == length(arguments) ||
             (arguments[i + 1] != "on" && arguments[i + 1] != "off") ||
             build_type != "Debug")) {
            return "graph: --debug-frame-pointers requires on or off and build type Debug";
        }
        if (arguments[i] == "--asset-generator-hosts" &&
            (i + 1 == length(arguments) || !strings.HasPrefix(arguments[i + 1], "/"))) {
            return "graph: --asset-generator-hosts requires an absolute directory";
        }
    }
    return "";
}

// Why a --target the arguments name is not among `targets`, or "" when each
// is: checked before any discovery or build writes.
pub TargetError :: (arguments: string[], targets: string[]) -> string {
    for (i in 0..<length(arguments)) {
        if (arguments[i] != "--target") {
            continue;
        }
        if (i + 1 == length(arguments) || strings.HasPrefix(arguments[i + 1], "--")) {
            return "graph: --target requires a target name";
        }
        found := false;
        for (target in targets) {
            found = found || arguments[i + 1] == target;
        }
        if (!found) {
            return format_text("graph: unknown target '{}'", arguments[i + 1]);
        }
    }
    return "";
}
