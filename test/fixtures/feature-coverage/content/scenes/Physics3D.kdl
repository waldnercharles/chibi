version 1
name "Physics3D"
(array)entities {
    - name="Ground" prototype="Ground3D"
    - {
        name "Crate"
        prototype "Crate3D"
        (array)behaviors "Physics3DProbe"
    }
    - {
        name "Walker"
        prototype "Walker3D"
        (array)behaviors "WalkerProbe"
    }
    - name="Gravity" prototype="Gravity3D"
}
