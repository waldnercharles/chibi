package package_compiler

import snapshot "project:source_snapshot"
import routes "project:package_routes"
import binding "project:lexical_binding"
import syntax "project:syntax_diagnostics"
import writer "project:prepared_writer"
import strings "core:strings"

// Compiles one package of functions and records to a prepared closure. Stage
// zero builds this compiler; everything after the raw parser is authored.

// Layout facts of the runtime this compiler targets, which Chibi cannot see:
// pointer width and the byte offsets of a value header's members.
Target :: struct {
    pointer_storage: int; pointer_size: int; value_size: int; payload_offset: int; results_offset: int;
    type_offset: int; container_offset: int; name_offset: int; record_offset: int;
}
// Prepared instructions this compiler emits, as ordinals on the target.
Ops :: struct {
    constant: int; argument: int; local: int; save: int; context: int; array: int; host_slot: int;
    string_equal: int; index: int; load: int; write: int; result: int; host_call: int; invoke: int;
    check: int; branch_if: int; jump: int; finish: int; end: int; add: int; sub: int; mul: int;
    div: int; mod: int; neg: int; bit_and: int; bit_or: int; bit_xor: int; bit_not: int; shl: int;
    shr: int; lt: int; le: int; gt: int; ge: int; eq: int; ne: int;
}
// A signature type: a storage code and, for records, a record index.
ValueType :: struct { storage: int; record: int; }
Callable :: struct {
    name: string; document: int; node: int; first: int; count: int; result: int; result_record: int;
}
Param :: struct { name: string; storage: int; record: int; }
// An authored record; its fields are fields[first, first + count).
Record :: struct { name: string; type_name: string; first: int; count: int; size: int; }
RecordField :: struct { name: string; storage: int; offset: int; }
Result :: union { Rejected(diagnostic: syntax.Diagnostic) | Compiled(module: uint64, bytes: byte[]) }
Declarations :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Collected(callables: Callable[], params: Param[], records: Record[], fields: RecordField[])
}

BoolStorage: int : 1;
IntStorage: int : 6;
WordStorage: int : 9;
TextStorage: int : 13;
StructStorage: int : 15;
FunctionKind: int : 1;
RecordKind: int : 13;
// Runtime intrinsics are host capabilities with this prefix and ABI one.
IntrinsicBase: uint64 : 0x4348494900000000;

Ordinal :: pure fn(names: string[], name: string) -> int {
    index: int = 0;
    while (index < length(names)) {
        if (names[index] == name) { return index; }
        index += 1;
    }
    return -1;
}
ResolveOps :: pure fn(names: string[]) -> Ops {
    return {constant: Ordinal(names, "CONSTANT"), argument: Ordinal(names, "ARGUMENT"),
        local: Ordinal(names, "LOCAL"), save: Ordinal(names, "SAVE"), context: Ordinal(names, "CONTEXT"),
        array: Ordinal(names, "ARRAY"), host_slot: Ordinal(names, "HOST_SLOT"),
        string_equal: Ordinal(names, "STRING_EQUAL"), index: Ordinal(names, "INDEX"),
        load: Ordinal(names, "LOAD"), write: Ordinal(names, "WRITE"), result: Ordinal(names, "RESULT"),
        host_call: Ordinal(names, "HOST_CALL"), invoke: Ordinal(names, "INVOKE"), check: Ordinal(names, "CHECK"),
        branch_if: Ordinal(names, "BRANCH"), jump: Ordinal(names, "JUMP"), finish: Ordinal(names, "RETURN"),
        end: Ordinal(names, "END"), add: Ordinal(names, "ADD"), sub: Ordinal(names, "SUB"),
        mul: Ordinal(names, "MUL"), div: Ordinal(names, "DIV"), mod: Ordinal(names, "MOD"),
        neg: Ordinal(names, "NEG"), bit_and: Ordinal(names, "BIT_AND"), bit_or: Ordinal(names, "BIT_OR"),
        bit_xor: Ordinal(names, "BIT_XOR"), bit_not: Ordinal(names, "BIT_NOT"), shl: Ordinal(names, "SHL"),
        shr: Ordinal(names, "SHR"), lt: Ordinal(names, "LT"), le: Ordinal(names, "LE"),
        gt: Ordinal(names, "GT"), ge: Ordinal(names, "GE"), eq: Ordinal(names, "EQ"), ne: Ordinal(names, "NE")};
}
// Whether the target names every instruction this compiler emits.
Complete :: pure fn(ops: Ops) -> bool {
    used: int[] = [ops.constant, ops.argument, ops.local, ops.save, ops.context, ops.array,
        ops.host_slot, ops.string_equal, ops.index, ops.load, ops.write, ops.result, ops.host_call,
        ops.invoke, ops.check, ops.branch_if, ops.jump, ops.finish,
        ops.end, ops.add, ops.sub, ops.mul, ops.div, ops.mod, ops.neg, ops.bit_and, ops.bit_or,
        ops.bit_xor, ops.bit_not, ops.shl, ops.shr, ops.lt, ops.le, ops.gt, ops.ge, ops.eq, ops.ne];
    foreach (op in used) {
        if (op < 0) { return false; }
    }
    return true;
}
// The storage of a type a record field may hold, 0 for any other.
FieldStorage :: pure fn(text: string) -> int {
    if (text == "int") { return IntStorage; }
    if (text == "bool") { return BoolStorage; }
    if (text == "string") { return TextStorage; }
    return 0;
}
FindRecord :: pure fn(records: Record[], name: string) -> int {
    index: int = 0;
    while (index < length(records)) {
        if (records[index].name == name) { return index; }
        index += 1;
    }
    return -1;
}
// A field type or a record of this package; storage 0 when neither.
ResolveType :: pure fn(records: Record[], text: string) -> ValueType {
    storage := FieldStorage(text);
    if (storage != 0) { return {storage: storage, record: -1}; }
    record := FindRecord(records, text);
    if (record < 0) { return {storage: 0, record: -1}; }
    return {storage: StructStorage, record: record};
}
// Field width, which is also its alignment, as the runtime lays records out.
FieldSize :: pure fn(storage: int, target: Target) -> int {
    if (storage == TextStorage) { return target.pointer_size; }
    if (storage == IntStorage) { return 4; }
    return 1;
}
AlignTo :: pure fn(size: int, alignment: int) -> int {
    rest := size % alignment;
    if (rest == 0) { return size; }
    return size + alignment - rest;
}
InputFailure :: pure fn(document: int, message: string) -> Result {
    diagnostic: syntax.Diagnostic = {start: 0, end: 0, line: 1, column: 1, document: document, message: message};
    return Result.Rejected(diagnostic);
}

// Every record and function of one package, in file and source order.
// Records come first, so any signature may name any record.
Declare :: pure fn(forest: snapshot.SnapshotNode[], documents: snapshot.Document[], files: int[],
                   package_name: string, target: Target) -> Declarations {
    callables: Callable[] = [];
    params: Param[] = [];
    records: Record[] = [];
    fields: RecordField[] = [];
    foreach (file in files) {
        text := documents[file].text;
        member := FirstMember(forest, documents[file].syntax_root);
        while (member >= 0) {
            if (Is(forest, member, "record_declaration")) {
                name := NameText(forest, text, Field(forest, member, "name"));
                if (name == "") {
                    return Declarations.Failed(Diagnose(forest, Field(forest, member, "name"), file, "Invalid string or embedded NUL"));
                }
                if (FindRecord(records, name) >= 0) {
                    return Declarations.Failed(Diagnose(forest, member, file, format_text("Duplicate declaration '{}'", name)));
                }
                first := length(fields);
                size: int = 0;
                alignment: int = 1;
                item := FirstMember(forest, Field(forest, member, "body"));
                while (item >= 0) {
                    field_name := NameText(forest, text, Field(forest, item, "name"));
                    if (field_name == "") {
                        return Declarations.Failed(Diagnose(forest, Field(forest, item, "name"), file, "Invalid string or embedded NUL"));
                    }
                    storage := FieldStorage(Text(forest, text, Field(forest, item, "type")));
                    if (storage == 0 || Field(forest, item, "value") >= 0) {
                        return Declarations.Failed(Diagnose(forest, item, file,
                            "record field needs an int, bool or string type and no default"));
                    }
                    at := first;
                    while (at < length(fields)) {
                        if (fields[at].name == field_name) {
                            return Declarations.Failed(Diagnose(forest, item, file,
                                format_text("Duplicate field '{}'", field_name)));
                        }
                        at += 1;
                    }
                    width := FieldSize(storage, target);
                    size = AlignTo(size, width);
                    field: RecordField = {name: field_name, storage: storage, offset: size};
                    fields = array_add(fields, field);
                    size += width;
                    if (width > alignment) { alignment = width; }
                    item = NextMember(forest, item);
                }
                if (length(fields) == first) {
                    return Declarations.Failed(Diagnose(forest, member, file, "record needs a field"));
                }
                record: Record = {name: name, type_name: format_text("{}.{}", package_name, name), first: first,
                    count: length(fields) - first, size: AlignTo(size, alignment)};
                records = array_add(records, record);
            }
            member = NextMember(forest, member);
        }
    }
    foreach (file in files) {
        text := documents[file].text;
        member := FirstMember(forest, documents[file].syntax_root);
        while (member >= 0) {
            if (Is(forest, member, "function_declaration")) {
                name := NameText(forest, text, Field(forest, member, "name"));
                if (name == "") {
                    return Declarations.Failed(Diagnose(forest, Field(forest, member, "name"), file, "Invalid string or embedded NUL"));
                }
                // Records and functions share the package scope.
                if (FindCallable(callables, name) >= 0 || FindRecord(records, name) >= 0) {
                    return Declarations.Failed(Diagnose(forest, member, file, format_text("Duplicate declaration '{}'", name)));
                }
                first := length(params);
                parameter := FirstMember(forest, Field(forest, member, "parameters"));
                while (parameter >= 0) {
                    declared := ResolveType(records, Text(forest, text, Field(forest, parameter, "type")));
                    if (declared.storage == 0) {
                        return Declarations.Failed(Diagnose(forest, parameter, file, "parameter type is not supported yet"));
                    }
                    param_name := NameText(forest, text, Field(forest, parameter, "name"));
                    if (param_name == "") {
                        return Declarations.Failed(Diagnose(forest, Field(forest, parameter, "name"), file, "Invalid string or embedded NUL"));
                    }
                    param: Param = {name: param_name, storage: declared.storage, record: declared.record};
                    params = array_add(params, param);
                    parameter = NextMember(forest, parameter);
                }
                result: ValueType = {storage: 0, record: -1};
                results := Field(forest, member, "results");
                if (results >= 0) {
                    result = ResolveType(records, Text(forest, text, results));
                    if (result.storage == 0) {
                        return Declarations.Failed(Diagnose(forest, results, file, "result type is not supported yet"));
                    }
                }
                callable: Callable = {name: name, document: file, node: member, first: first,
                    count: length(params) - first, result: result.storage, result_record: result.record};
                callables = array_add(callables, callable);
            } else if (!Is(forest, member, "package_header") && !Is(forest, member, "record_declaration")) {
                return Declarations.Failed(Diagnose(forest, member, file, "unsupported declaration"));
            }
            member = NextMember(forest, member);
        }
    }
    return Declarations.Collected(callables, params, records, fields);
}

ScalarValue :: pure fn(storage: int, wide: int) -> writer.Value {
    return {tag: storage, container: 0, type_name: "", has_type_name: false, authored: false,
        wide: wide, text: "", has_text: false, present: false, first: 0, count: 0};
}
// The header of a value of `storage`; an absent record names its layout.
Header :: pure fn(storage: int, record: int, records: Record[], layouts: int[]) -> writer.Value {
    if (storage != StructStorage) { return ScalarValue(storage, 0); }
    return {tag: StructStorage, container: 0, type_name: records[record].type_name, has_type_name: true,
        authored: true, wide: layouts[record], text: "", has_text: false, present: false, first: 0,
        count: records[record].count};
}
NoSource :: pure fn() -> writer.Source {
    return {graph: 0, call: 0, parent: -1, asset: "", has_asset: false, start: 0, end: 0, line: 0, column: 0};
}
Range :: pure fn(first: int, count: int) -> writer.Span { return {first: first, count: count}; }
Own :: pure fn(index: int) -> writer.Reference { return {imported: -1, own: index, function: 0, role: 0}; }
// FNV-1a over `count` little-endian bytes of `value`, as the runtime hashes
// layouts.
HashBytes :: pure fn(hash: uint64, value: uint64, count: int) -> uint64 {
    out := hash;
    rest := value;
    index: int = 0;
    while (index < count) {
        out = (out ^ (rest & 255)) * 1099511628211;
        rest = rest >> 8;
        index += 1;
    }
    return out;
}
HashText :: pure fn(hash: uint64, text: string) -> uint64 {
    out := hash;
    index: int = 0;
    while (index < strings.ByteLength(text)) {
        out = HashBytes(out, uint64(strings.ByteAt(text, index)), 1);
        index += 1;
    }
    return HashBytes(out, 0, 1);
}
// The runtime's layout hash of a record: its size and field count, then each
// field's name, offset, size, storage and (absent) type name.
LayoutHash :: pure fn(record: Record, fields: RecordField[], target: Target) -> uint64 {
    hash: uint64 = 1469598103934665603;
    hash = HashBytes(hash, uint64(record.size), target.pointer_size);
    hash = HashBytes(hash, uint64(record.count), 4);
    at := record.first;
    while (at < record.first + record.count) {
        field := fields[at];
        hash = HashText(hash, field.name);
        hash = HashBytes(hash, uint64(field.offset), target.pointer_size);
        hash = HashBytes(hash, uint64(FieldSize(field.storage, target)), target.pointer_size);
        hash = HashBytes(hash, uint64(field.storage), 4);
        hash = HashText(hash, "");
        at += 1;
    }
    return hash;
}

// The prepared module of a package. Each body is a canonical definition the
// runtime verifies and finalizes when it loads it.
Assemble :: pure fn(forest: snapshot.SnapshotNode[], documents: snapshot.Document[], identity: string,
                    module: uint64, callables: Callable[], params: Param[], records: Record[],
                    record_fields: RecordField[], ops: Ops, target: Target, abi: uint64) -> Result {
    wide: uint64[] = [0];
    values: writer.Value[] = [];
    ints: int[] = [];
    spans: writer.Span[] = [];
    functions: writer.Function[] = [];
    instructions: writer.Instruction[] = [];
    locals: writer.Local[] = [];
    parameters: writer.Parameter[] = [];
    frames: writer.Frame[] = [];
    sources: writer.Source[] = [];
    data: writer.Data[] = [];
    hosts: writer.Host[] = [];
    roots: writer.Root[] = [];
    calls: writer.Call[] = [];
    references: writer.Reference[] = [];
    entries: writer.Entry[] = [];
    requirements: writer.Requirement[] = [];
    fields: writer.Field[] = [];
    // Each record's layout, as an index into `wide`.
    layouts: int[] = [];
    foreach (record in records) {
        wide = array_add(wide, binding.ID("package-symbol", format_text("{}:{}:{}", identity, RecordKind, record.name)));
        wide = array_add(wide, LayoutHash(record, record_fields, target));
        layouts = array_add(layouts, length(wide) - 1);
        requirement: writer.Requirement = {id: length(wide) - 2, layout: length(wide) - 1, storage: StructStorage,
            name: record.type_name, size: record.size, authored: true, first: length(fields), count: record.count};
        requirements = array_add(requirements, requirement);
        at := record.first;
        while (at < record.first + record.count) {
            field: writer.Field = {name: record_fields[at].name, kind: record_fields[at].storage};
            fields = array_add(fields, field);
            at += 1;
        }
    }
    abi_one := length(wide);
    wide = array_add(wide, uint64(1));
    index: int = 0;
    while (index < length(callables)) {
        callable := callables[index];
        tables := EmitBody(forest, documents[callable.document].text, callable.document, callables, params,
            records, record_fields, index, ops, target);
        switch tables {
            case .Failed(diagnostic): return Result.Rejected(diagnostic);
            case .Emitted(body_slots, body_locals, body_cells, body_code, body_calls, body_hosts, body_roots):
                base := length(spans);
                // Argument defaults and kinds.
                spans = array_add(spans, Range(length(values), callable.count));
                at: int = 0;
                while (at < callable.count) {
                    param := params[callable.first + at];
                    values = array_add(values, Header(param.storage, param.record, records, layouts));
                    at += 1;
                }
                spans = array_add(spans, Range(length(ints), callable.count));
                at = 0;
                while (at < callable.count) { ints = array_add(ints, int(0)); at += 1; }
                // Result defaults and kinds.
                result_count: int = 0;
                if (callable.result != 0) { result_count = 1; }
                spans = array_add(spans, Range(length(values), result_count));
                if (result_count != 0) {
                    values = array_add(values, Header(callable.result, callable.result_record, records, layouts));
                }
                spans = array_add(spans, Range(length(ints), result_count));
                if (result_count != 0) { ints = array_add(ints, int(0)); }
                spans = array_add(spans, Range(0, 0));
                spans = array_add(spans, Range(length(ints), length(body_slots)));
                foreach (slot in body_slots) { ints = array_add(ints, slot.storage); }
                spans = array_add(spans, Range(length(ints), length(body_slots)));
                foreach (slot in body_slots) { ints = array_add(ints, slot.kind); }
                // Record pointers each slot may hold while the function waits.
                spans = array_add(spans, Range(length(roots), length(body_roots)));
                foreach (root in body_roots) {
                    values = array_add(values, Header(StructStorage, root.record, records, layouts));
                    row: writer.Root = {bank: 0, index: root.slot, shape: length(values) - 1};
                    roots = array_add(roots, row);
                }
                // Instructions, each with its own value row and source at pc + 1.
                spans = array_add(spans, Range(length(instructions), length(body_code)));
                pc: int = 0;
                foreach (code in body_code) {
                    value := Header(code.value_storage, code.value_record, records, layouts);
                    if (code.has_text) {
                        value.text = code.text;
                        value.has_text = true;
                    }
                    bits := uint64(wrap: int64(code.payload));
                    if (bits != 0) {
                        value.wide = length(wide);
                        wide = array_add(wide, bits);
                    }
                    values = array_add(values, value);
                    row: writer.Instruction = {op: code.op, type: code.type, output: code.output,
                        left: code.left, right: code.right, target: code.target, frame: 0, source: pc + 1,
                        stack: -1, pin: 0, offset: code.offset, indirect: false, component_index: 0, node: 0,
                        value: length(values) - 1, layout: 0, message: "", has_message: false};
                    instructions = array_add(instructions, row);
                    pc += 1;
                }
                spans = array_add(spans, Range(length(locals), length(body_locals)));
                foreach (storage in body_locals) {
                    values = array_add(values, ScalarValue(storage, 0));
                    local: writer.Local = {kind: 0, initial: length(values) - 1, frame: 0, node: 0, pin: 0,
                        offset: 0, parameter: false, array_default: false, data_index: 0};
                    locals = array_add(locals, local);
                }
                spans = array_add(spans, Range(length(parameters), callable.count));
                at = 0;
                while (at < callable.count) {
                    param := params[callable.first + at];
                    values = array_add(values, Header(param.storage, param.record, records, layouts));
                    parameter: writer.Parameter = {initial: length(values) - 1, frame: 0, pin: 0};
                    parameters = array_add(parameters, parameter);
                    at += 1;
                }
                // One frame with an empty origin, then the instruction origins.
                sources = array_add(sources, NoSource());
                frame: writer.Frame = {source: length(sources) - 1, depth: 0, resume: 0, source_index: 0, stack: -1};
                spans = array_add(spans, Range(length(frames), 1));
                frames = array_add(frames, frame);
                spans = array_add(spans, Range(length(sources), length(body_code) + 1));
                sources = array_add(sources, NoSource());
                asset := documents[callable.document].key;
                foreach (code in body_code) {
                    source := NoSource();
                    source.asset = asset;
                    source.has_asset = true;
                    source.start = code.start;
                    source.end = code.end;
                    source.line = code.line;
                    source.column = code.column;
                    sources = array_add(sources, source);
                }
                spans = array_add(spans, Range(0, 0));
                spans = array_add(spans, Range(0, 0));
                // Data cells: record cells own a buffer of the record's size;
                // constructor offset cells hold their field offset.
                spans = array_add(spans, Range(length(data), length(body_cells)));
                foreach (cell in body_cells) {
                    value := Header(cell.storage, cell.record, records, layouts);
                    size: int = 0;
                    if (cell.storage == StructStorage) { size = records[cell.record].size; }
                    if (cell.offset != 0) {
                        value.wide = length(wide);
                        wide = array_add(wide, uint64(cell.offset));
                    }
                    values = array_add(values, value);
                    datum: writer.Data = {kind: 0, initial: length(values) - 1, size: size};
                    data = array_add(data, datum);
                }
                spans = array_add(spans, Range(length(hosts), length(body_hosts)));
                foreach (host in body_hosts) {
                    wide = array_add(wide, IntrinsicBase | uint64(host.intrinsic));
                    row: writer.Host = {capability: length(wide) - 1, abi: abi_one, first: host.first,
                        result_first: host.result_first, result_count: host.result_count, outcome_first: 0,
                        outcome_count: 0};
                    hosts = array_add(hosts, row);
                }
                spans = array_add(spans, Range(length(calls), length(body_calls)));
                foreach (invocation in body_calls) {
                    references = array_add(references, Own(invocation.callee));
                    call: writer.Call = {function: length(references) - 1, first: invocation.first,
                        count: invocation.count, result_first: invocation.result_first,
                        result_count: invocation.result_count, task: false};
                    calls = array_add(calls, call);
                }
                while (length(spans) < base + writer.Tables) { spans = array_add(spans, Range(0, 0)); }
                head: writer.Function = {argument_count: callable.count, result_count: result_count,
                    variable_count: 0, root_steps: 0, child_budget: 0, depth_bound: 0, pure_depth_limit: 0,
                    breakpoints: false, batchable: false, managed: false, custom_lowering: false,
                    checkpoints: false, pin_watches: false, watch_size: 0, component_bindings: false,
                    component_access: false, spans: base};
                functions = array_add(functions, head);
                wide = array_add(wide, binding.ID("package-symbol",
                    format_text("{}:{}:{}:callable", identity, FunctionKind, callable.name)));
                references = array_add(references, Own(index));
                references = array_add(references, Own(-1));
                exported: writer.Entry = {id: length(wide) - 1, kind: 0, entry_name: callable.name, has_entry: true,
                    continuation_wait: false, effects: 0, body: length(references) - 2,
                    subscription: length(references) - 1};
                entries = array_add(entries, exported);
        }
        index += 1;
    }
    imports: writer.Import[] = [];
    layouts_table: writer.ResultLayout[] = [];
    points: writer.Point[] = [];
    watches: writer.Watch[] = [];
    prepared := writer.Write(writer.Module.Tables(module, 0, abi, wide, values, ints, requirements,
        fields, imports, functions, spans, roots, instructions, locals, parameters, frames, sources,
        layouts_table, data, hosts, calls, references, points, watches, entries));
    ids: uint64[] = [module];
    names: string[] = [identity];
    starts: int[] = [0];
    lengths: int[] = [length(prepared)];
    return Result.Compiled(module, writer.Closure(module, ids, names, prepared, starts, lengths));
}

// `abi` is the target's prepared header ABI and `names` its instruction names
// in ordinal order.
Compile :: pure fn(project: string, paths: string[], sources: string[], target: Target,
                   abi: uint64, names: string[]) -> Result {
    ops := ResolveOps(names);
    if (abi == 0 || !Complete(ops) || length(paths) == 0 || length(paths) != length(sources)) {
        return InputFailure(-1, "unsupported compiler input or target");
    }
    inputs: snapshot.Input[] = [];
    sizes: uint64[] = [];
    index: int = 0;
    while (index < length(paths)) {
        input: snapshot.Input = {path: paths[index], text: sources[index], has_path: true, has_text: true};
        inputs = array_add(inputs, input);
        sizes = array_add(sizes, uint64(strings.ByteLength(sources[index])));
        index += 1;
    }
    options: snapshot.Options = {project: project, has_project: true, has_options: true,
        has_files: true, has_collections: false, file_count: length(inputs), collection_count: 0};
    collections: routes.Collection[] = [];
    switch snapshot.Build(options, collections, inputs, sizes) {
        case .Rejected(diagnostic, related, graph_error, cycle, documents, nodes, imports):
            return Result.Rejected(diagnostic);
        case .Accepted(roots, documents, nodes, imports, graph):
            if (length(imports) != 0) { return InputFailure(imports[0].file, "imports are not supported yet"); }
            switch graph {
                case .Rejected(error, cycle): return InputFailure(-1, "package graph is invalid");
                case .Accepted(packages, members, file_packages, order, edges, bindings):
                    if (length(packages) != 1) { return InputFailure(-1, "one package is supported yet"); }
                    files := slice(members, packages[0].member_start, packages[0].member_count);
                    switch Declare(nodes, documents, files, packages[0].name, target) {
                        case .Failed(diagnostic): return Result.Rejected(diagnostic);
                        case .Collected(callables, params, records, fields):
                            identity := documents[files[0]].identity;
                            return Assemble(nodes, documents, identity, binding.ID("module", identity),
                                callables, params, records, fields, ops, target, abi);
                    }
            }
    }
}
