behavior "ArenaPickupBehavior" {
    owner "ecs.entity";
    state "Base Rotation": float = 0.0;
    value _2_pi_rand: double = (2 * pi * rand());
    on Tick as tick() {
        match (&component("GAME.GamePickup", "state")) {
            case 0 {
                "Wait and Pulse"();
            }
            case 1 {
                "Collect Along Spiral"();
            }
            default {
            }
        }
    }
    on CollectExperience as collectexperience() {
        "Start Collection"(Radius: 10000.0);
    }
    on Begin as begin() {
        set_variable<"Base Rotation">(Value: float = _2_pi_rand);
    }
    function "Wait and Pulse"() -> () {
        depth_limit 64;
        value scene_rhythm = scene_rhythm();
        value pulse_angle: double = (smooth_step(Value: scene_rhythm.Phase) * 2 * pi);
        value pulse_fade = "Pulse Fade"(Lifetime: float = &component("GAME.GamePickup", "lifetime"), Age: double = &component("GAME.GamePickup", "age"));
        value pulse_yaw: double = (pulse_angle + &state."Base Rotation");
        value pulse_scale = "Pulse Scale"(Angle: double = pulse_angle, Fade: float = pulse_fade);
        after entry {
            &component("GAME.GamePickup", "age") += cast<double>(&delta);
            if (cast<double>(&component("GAME.GamePickup", "age")) >= cast<double>(&component("GAME.GamePickup", "lifetime"))) {
                destroy_entity(Entity: self);
            } else {
                await set_component(Component: "GAME.GameVisualTransform", Entity: 0, Value.yaw: float = pulse_yaw, Value.scale: float = pulse_scale);
                await "Start Collection"(Radius: 48.0);
                return();
            }
        }
    }
    function "Collect Along Spiral"() -> () {
        depth_limit 64;
        value get_gamepickup = get_game_pickup();
        value self_2 = engine["Self"]();
        action set_gamepickup_collection_age = set_game_pickup_collection_age(Value: (collection_age_2 + &delta), Target: 0);
        value getentity_gameexperience = get_entity_game_experience(Entity: &local.Target);
        value add: int = add(A: plain int = getentity_gameexperience.Value.current, B: plain int = get_gamepickup.Value."value");
        value self_3 = engine["Self"]();
        value getentity_gametransform = get_entity_game_transform(Entity: &local.Target);
        value spiral_t = "Spiral T"(CollectionAge: float = set_gamepickup_collection_age.Value.collection_age);
        value spiral_angle = "Spiral Angle"(T: float = &local."Spiral T");
        value spiral_weight = "Spiral Weight"(T: float = &local."Spiral T");
        value spiral_scale = "Spiral Scale"(T: float = &local."Spiral T");
        value has_component = has_component(Component: "GAME.GameExperience", Entity: &local.Target);
        value x: float = getentity_gametransform.Value.x;
        value y: float = getentity_gametransform.Value.y;
        value collection_age_2: float = get_gamepickup.Value.collection_age;
        local Target = get_gamepickup.Value.target;
        local "Spiral T" = spiral_t;
        local "Spiral Angle" = spiral_angle;
        after entry {
            if (has_component) {
                set_gamepickup_collection_age();
            } else {
                destroy_entity(Entity: self_2);
            }
        }
        after set_gamepickup_collection_age {
            if (cast<double>(&component("GAME.GamePickup", "collection_age")) >= 0.6) {
                await set_game_pickup_state(Value: 2, Target: 0);
                await set_game_experience_current(Value: add, Target: &local.Target);
                destroy_entity(Entity: self_3);
            } else {
                await set_component(Component: "GAME.GameTransform", Entity: 0, Value.x: float = "Spiral X"(TargetX: float = getentity_gametransform.Value.x, Weight: double = spiral_weight, OriginX: float = &component("GAME.GamePickup", "origin.x"), Theta: float = &local."Spiral Angle", OriginY: float = &component("GAME.GamePickup", "origin.y"), TargetY: float = getentity_gametransform.Value.y, T: float = &local."Spiral T"), Value.y: float = "Spiral Y"(TargetY: float = getentity_gametransform.Value.y, Weight: double = spiral_weight, OriginX: float = &component("GAME.GamePickup", "origin.x"), TargetX: float = getentity_gametransform.Value.x, Theta: float = &local."Spiral Angle", OriginY: float = &component("GAME.GamePickup", "origin.y"), T: float = &local."Spiral T"));
                await set_component(Component: "GAME.GameVisualTransform", Entity: 0, Value.yaw: float = (&state."Base Rotation" + &local."Spiral Angle"), Value.scale: float = spiral_scale);
                return();
            }
        }
    }
    function "Start Collection"(Radius: float = 48.0) -> () {
        depth_limit 64;
        value get_gametransform = get_game_transform();
        value find_nearest_entity = find_nearest_entity(Position: convert<"game_transform_to_cf">(get_gametransform), Radius: entry.Radius, Categories: 1, Exclude: 0);
        value hasentity_gameexperience = has_entity_game_experience(Entity: find_nearest_entity.Entity);
        after entry {
            if (cast<double>(&component("GAME.GamePickup", "state")) == 0) {
                if (find_nearest_entity.Found) {
                    if (hasentity_gameexperience) {
                        await set_component(Component: "GAME.GamePickup", Entity: 0, Value."state": int = 1, Value.collection_age: float = 0.0, Value.target: handle<"ecs.entity"> = find_nearest_entity.Entity, Value.origin: convert<"game_transform_to_cf">(get_gametransform));
                        await set_game_trail_width(Value: 0.65, Target: 0);
                        return();
                    } else {
                        return();
                    }
                } else {
                    return();
                }
            } else {
                return();
            }
        }
    }
    pure function "Pulse Fade"<T0: float, T1: double, T2: float>(Lifetime: T0 = 0.0, Age: T1 = 0.0) -> (Result: T2 = 0.0) {
        depth_limit 64;
        value subtract = subtract(A: double = entry.Lifetime, B: double = entry.Age);
        value real = real(Value: 2.0);
        value divide = divide(A: double = subtract, B: double = real);
        value real_2 = real(Value: 0.0);
        value real_3 = real(Value: 1.0);
        value clamp = clamp(Value: double = divide, Min: double = real_2, Max: double = real_3);
        result Result: float = clamp;
    }
    pure function "Pulse Scale"<T0: double, T1: float, T2: double>(Angle: T0 = 0.0, Fade: T1 = 0.0) -> (Result: T2 = 0.0) {
        depth_limit 64;
        value real = real(Value: 0.9);
        value real_2 = real(Value: 0.1);
        value cosine = cosine(Value: entry.Angle);
        value multiply = multiply(A: double = real_2, B: double = cosine);
        value add = add(A: double = real, B: double = multiply);
        value multiply_2 = multiply(A: double = add, B: double = entry.Fade);
        result Result: double = multiply_2;
    }
    pure function "Spiral T"<T0: float, T1: float>(CollectionAge: T0 = 0.0) -> (Result: T1 = 0.0) {
        depth_limit 64;
        value real = real(Value: 0.6);
        value divide = divide(A: float = entry, B: double = real);
        result Result: float = divide;
    }
    pure function "Spiral Angle"<T0: float, T1: float>(T: T0 = 0.0) -> (Result: T1 = 0.0) {
        depth_limit 64;
        value real = real(Value: 2.5);
        value multiply = multiply(A: double = entry, B: double = real);
        value real_2 = real(Value: 3.141592653589793);
        value multiply_2 = multiply(A: double = multiply, B: double = real_2);
        result Result: float = multiply_2;
    }
    pure function "Spiral Weight"<T0: float, T1: double>(T: T0 = 0.0) -> (Result: T1 = 0.0) {
        depth_limit 64;
        value real = real(Value: 1.0);
        value subtract = subtract(A: double = real, B: double = entry);
        value real_2 = real(Value: 1.0);
        value subtract_2 = subtract(A: double = real_2, B: double = entry);
        value multiply = multiply(A: double = subtract, B: double = subtract_2);
        value real_3 = real(Value: 1.0);
        value real_4 = real(Value: 5.0);
        value multiply_2 = multiply(A: double = real_4, B: double = entry);
        value add = add(A: double = real_3, B: double = multiply_2);
        value multiply_3 = multiply(A: double = multiply, B: double = add);
        result Result: double = multiply_3;
    }
    pure function "Spiral X"<T0: float, T1: double, T2: float, T3: float, T4: float, T5: float, T6: float, T7: float>(TargetX: T0 = 0.0, Weight: T1 = 0.0, OriginX: T2 = 0.0, Theta: T3 = 0.0, OriginY: T4 = 0.0, TargetY: T5 = 0.0, T: T6 = 0.0) -> (Result: T7 = 0.0) {
        depth_limit 64;
        value subtract = subtract(A: double = entry.OriginX, B: double = entry.TargetX);
        value cosine = cosine(Value: entry.Theta);
        value multiply = multiply(A: double = subtract, B: double = cosine);
        value subtract_2 = subtract(A: double = entry.OriginY, B: double = entry.TargetY);
        value sine = sine(Value: entry.Theta);
        value multiply_2 = multiply(A: double = subtract_2, B: double = sine);
        value subtract_3 = subtract(A: double = multiply, B: double = multiply_2);
        value multiply_3 = multiply(A: double = entry.Weight, B: double = subtract_3);
        value add = add(A: double = entry.TargetX, B: double = multiply_3);
        value real = real(Value: 12.0);
        value real_2 = real(Value: 3.141592653589793);
        value multiply_4 = multiply(A: double = real_2, B: double = entry.T);
        value sine_2 = sine(Value: multiply_4);
        value multiply_5 = multiply(A: double = real, B: double = sine_2);
        value cosine_2 = cosine(Value: entry.Theta);
        value multiply_6 = multiply(A: double = multiply_5, B: double = cosine_2);
        value add_2 = add(A: double = add, B: double = multiply_6);
        result Result: float = add_2;
    }
    pure function "Spiral Y"<T0: float, T1: double, T2: float, T3: float, T4: float, T5: float, T6: float, T7: float>(TargetY: T0 = 0.0, Weight: T1 = 0.0, OriginX: T2 = 0.0, TargetX: T3 = 0.0, Theta: T4 = 0.0, OriginY: T5 = 0.0, T: T6 = 0.0) -> (Result: T7 = 0.0) {
        depth_limit 64;
        value subtract = subtract(A: double = entry.OriginX, B: double = entry.TargetX);
        value sine = sine(Value: entry.Theta);
        value multiply = multiply(A: double = subtract, B: double = sine);
        value subtract_2 = subtract(A: double = entry.OriginY, B: double = entry.TargetY);
        value cosine = cosine(Value: entry.Theta);
        value multiply_2 = multiply(A: double = subtract_2, B: double = cosine);
        value add = add(A: double = multiply, B: double = multiply_2);
        value multiply_3 = multiply(A: double = entry.Weight, B: double = add);
        value add_2 = add(A: double = entry.TargetY, B: double = multiply_3);
        value real = real(Value: 12.0);
        value real_2 = real(Value: 3.141592653589793);
        value multiply_4 = multiply(A: double = real_2, B: double = entry.T);
        value sine_2 = sine(Value: multiply_4);
        value multiply_5 = multiply(A: double = real, B: double = sine_2);
        value sine_3 = sine(Value: entry.Theta);
        value multiply_6 = multiply(A: double = multiply_5, B: double = sine_3);
        value add_3 = add(A: double = add_2, B: double = multiply_6);
        result Result: float = add_3;
    }
    pure function "Spiral Scale"<T0: float, T1: double>(T: T0 = 0.0) -> (Result: T1 = 0.0) {
        depth_limit 64;
        value real = real(Value: 1.0);
        value real_2 = real(Value: 0.5);
        value multiply = multiply(A: double = real_2, B: double = entry);
        value subtract = subtract(A: double = real, B: double = multiply);
        result Result: double = subtract;
    }
}
