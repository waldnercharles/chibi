// chibi doc publishes these pages in order.
title "Chibi"
(array)sections {
    - {
        name "Overview"
        (array)pages {
            - {
                title "Chibi"
                source "README.md"
                output "index.html"
            }
        }
    }
    - {
        name "Learn"
        (array)pages {
            - {
                title "The Chibi language"
                source "docs/code-language.md"
                output "language.html"
            }
        }
    }
    - {
        name "Testing"
        (array)pages {
            - {
                title "Testing"
                source "docs/guide/testing.md"
                output "testing.html"
            }
        }
    }
    - {
        name "Packages"
        (array)pages {
            - {
                title "Core packages"
                packages "packages/core"
                collection "core"
                output "packages.html"
            }
        }
    }
    - {
        name "Examples"
        (array)pages {
            - {
                title "Examples"
                source "docs/examples.md"
                output "examples.html"
            }
        }
    }
    - {
        name "FAQ"
        (array)pages {
            - {
                title "FAQ"
                source "docs/guide/faq.md"
                output "faq.html"
            }
        }
    }
    - {
        name "Grammar"
        (array)pages {
            - {
                title "Grammar"
                grammar "src/language/grammar.js"
                output "grammar.html"
            }
        }
    }
    - {
        name "Toolchain"
        (array)pages {
            - {
                title "Toolchain"
                source "docs/guide/toolchain.md"
                output "toolchain.html"
            }
        }
    }
}
