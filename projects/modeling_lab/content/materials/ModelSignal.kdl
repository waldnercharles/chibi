(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 1
                type "Shader Surface Output"
                inputs {
                    "Base Color" {
                        default x=0.08 y=0.7 z=0.32
                    }
                    Emission {
                        default x=0.1 y=0.8 z=0.35
                    }
                    Roughness 0.32
                    Normal {
                        default x=0.0 y=0.0 z=0.0
                    }
                }
            }
        }
    }
}
