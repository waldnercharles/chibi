+static field_program *solid_program(float value)
+{
+    field_ir ir = { .op = FIELD_CONSTANT, .value = value };
+    return field_program_new(&ir, 1, 0, NULL, 0, error, sizeof error);
+}
+static void cleanup()
+{
+    free(saved);
+    saved = NULL;
