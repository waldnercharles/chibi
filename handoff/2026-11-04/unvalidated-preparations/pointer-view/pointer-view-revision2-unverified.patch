@@ -0,0 +1,13 @@
+package pointer_element_schema
+Leaf :: struct { number: f32; }
+Row :: struct { number: int; link: ^^Leaf; }
+MakeRow :: () -> ^Row {
+    leaf: Leaf = {number: 7}; pointer := &leaf;
+    row: Row = {number: 11, link: &pointer};
+    return &row;
+}
+Main :: () -> int {
+    values: (^Row?)[] = [MakeRow(), nil]; owner := &values;
+    selected := owner.view(0..<2)!;
+    return selected.length() - 2;
+}
