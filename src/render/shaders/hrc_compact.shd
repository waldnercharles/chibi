// T0 keeps odd probes. T1 keeps both endpoint directions at even probes
// and all three directions at odd probes, five intervals per probe pair.
int hrc_compact_probe(int packed_x, int level, int compact_mode)
{
	if (compact_mode == 1) return 2 * (packed_x / 2) + 1;
	if (compact_mode == 2) return 2 * (packed_x / 5) + (packed_x % 5 < 2 ? 0 : 1);
	return packed_x / ((1 << level) + 1);
}

int hrc_compact_direction(int packed_x, int level, int compact_mode)
{
	if (compact_mode == 1) return packed_x % 2;
	if (compact_mode == 2) {
		int within_pair = packed_x % 5;
		return within_pair < 2 ? within_pair * 2 : within_pair - 2;
	}
	return packed_x % ((1 << level) + 1);
}

int hrc_t_storage_x(int level, int probe_x, int k, int compact_t0, int compact_t1)
{
	if (level == 0 && compact_t0 != 0) return (probe_x / 2) * 2 + k;
	if (level == 1 && compact_t1 != 0) {
		int within_pair = (probe_x % 2) != 0 ? 2 + k : k / 2;
		return (probe_x / 2) * 5 + within_pair;
	}
	return probe_x * ((1 << level) + 1) + k;
}
