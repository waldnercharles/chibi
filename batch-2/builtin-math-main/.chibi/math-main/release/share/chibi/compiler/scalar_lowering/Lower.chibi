package scalar_lowering

// Private wire schema 1, pinned to the typed IR at 9bf6e275. No callbacks.
// Flags are deliberately zero-only in this slice. State defaults are facts,
// not evaluated here. Native target rows contain layout facts only.
pub Type :: struct {
    storage: int;
    container: int;
    flags: int;
    nominal_slot: int;
    parameter_slot: int;
}
pub Expression :: struct {
    kind: int;
    op: int;
    left: int;
    right: int;
    symbol: int;
    type: int;
    literal: int;
    range: int;
}
pub Symbol :: struct {
    kind: int;
    id_slot: int;
    type: int;
}
pub Variable :: struct {
    id_slot: int;
    type: int;
    literal: int;
}
pub Result :: struct {
    expression: int;
    type: int;
}
pub Literal :: struct {
    storage: int;
    payload: int;
}
pub Range :: struct {
    start: int;
    end: int;
    line: int;
    column: int;
    document: int;
}
pub Target :: struct {
    schema: int;
    prepared: int;
    pointer_storage: int;
    value_size: int;
    payload_offset: int;
    results_offset: int;
}
pub Request :: union {
    Tables(types: Type[], expressions: Expression[], symbols: Symbol[],
           variables: Variable[], results: Result[], literals: Literal[], ids: u64[],
           ranges: Range[], documents: string[], target: Target, range: int)
}
Slot :: struct {
    storage: int;
    kind: int;
}
Local :: struct {
    storage: int;
    payload: int;
    kind: int;
}
Instruction :: struct {
    op: int;
    storage: int;
    output: int;
    left: int;
    right: int;
    target: int;
    frame: int;
    source: int;
    stack: int;
    pin: int;
    offset: int;
    indirect: bool;
    component: int;
    node_id: int;
    value_storage: int;
    payload: int;
    layout: int;
    message: string;
}
Diagnostic :: struct {
    range: int;
    message: string;
}
pub Plan :: union {
    Rejected(diagnostics: Diagnostic[])
    | Ready(target: Target, variable_ids: u64[], defaults: Literal[], results: Literal[],
            slots: Slot[], locals: Local[], origins: Range[], documents: string[], code: Instruction[])
}
Emitter :: union {
    Emitted(slots: Slot[], locals: Local[], origins: Range[], code: Instruction[])
}
Frame :: struct {
    expression: int;
    phase: int;
    left: int;
    local: int;
    branch_pc: int;
    skip: int;
}

Boolean: int : 1;
Integer: int : 6;
// Private canonical opcodes. The native decoder translates these names one-to-one.
Constant: int : 0;
VariableRead: int : 1;
LocalRead: int : 2;
Context: int : 3;
Index: int : 4;
Write: int : 5;
Save: int : 6;
Branch: int : 7;
Jump: int : 8;
Return: int : 9;
End: int : 10;
Negate: int : 11;
BitNot: int : 12;
Add: int : 13;
Subtract: int : 14;
Multiply: int : 15;
Divide: int : 16;
Modulo: int : 17;
Equal: int : 18;
NotEqual: int : 19;
Less: int : 20;
LessEqual: int : 21;
Greater: int : 22;
GreaterEqual: int : 23;
BitAnd: int : 24;
BitOr: int : 25;
BitXor: int : 26;
ShiftLeft: int : 27;
ShiftRight: int : 28;

Reject :: (range: int, message: string) -> Plan {
    diagnostics: Diagnostic[] = [];
    item: Diagnostic = {range: range, message: message};
    return Plan.Rejected(append(diagnostics, item));
}
ValidIndex :: (index: int, count: int) -> bool {
    return index >= 0 && index < count;
}
Scalar :: (type: Type) -> bool {
    return (type.storage == Boolean || type.storage == Integer) && type.container == 0 &&
           type.flags == 0 && type.nominal_slot == -1 && type.parameter_slot == -1;
}
ValidLiteral :: (item: Literal, storage: int) -> bool {
    return item.storage == storage && (storage == Integer ||
                                       (storage == Boolean && (item.payload == 0 || item.payload == 1)));
}
Opcode :: (op: int) -> int {
    if (op >= 1 && op <= 5) {
        return Add + op - 1;
    }
    if (op >= 10 && op <= 15) {
        return Equal + op - 10;
    }
    if (op >= 16 && op <= 20) {
        return BitAnd + op - 16;
    }
    return -1;
}
Code :: (op: int, storage: int, left: int, right: int, target: int) -> Instruction {
    return {op: op, storage: storage, output: 0, left: left, right: right, target: target,
            frame: 0, source: 0, stack: -1, pin: 0, offset: 0, indirect: false, component: 0,
            node_id: 0, value_storage: 0, payload: 0, layout: 0, message: ""};
}
ConstantCode :: (item: Literal) -> Instruction {
    code := Code(Constant, item.storage, 0, 0, 0);
    code.value_storage = item.storage;
    code.payload = item.payload;
    return code;
}
Emit :: (output: Emitter, item: Instruction, origin: Range, storage: int, kind: int) -> Emitter {
    switch output {
        case .Emitted(raw_slots, raw_locals, raw_origins, raw_code):
            slots := raw_slots;
            locals := raw_locals;
            origins := raw_origins;
            code := raw_code;
            // The native builder reserves source row zero before any emission.
            item.source = length(origins) + 1;
            if (storage != 0) {
                item.output = length(slots);
                slot: Slot = {storage: storage, kind: kind};
                slots.append(slot);
            }
            if (item.op == Save) {
                local := locals[item.target];
                local.kind = slots[item.left].kind;
                locals[item.target] = local;
            }
            origins.append(origin);
            code.append(item);
            return Emitter.Emitted(slots, locals, origins, code);
    }
}
PC :: (output: Emitter) -> int {
    switch output {
        case .Emitted(slots, locals, origins, code):
            return length(code);
    }
}
LastSlot :: (output: Emitter) -> int {
    switch output {
        case .Emitted(slots, locals, origins, code):
            return length(slots) - 1;
    }
}
LocalCount :: (output: Emitter) -> int {
    switch output {
        case .Emitted(slots, locals, origins, code):
            return length(locals);
    }
}
AddLocal :: (output: Emitter) -> Emitter {
    switch output {
        case .Emitted(slots, locals, origins, code):
            item: Local = {storage: Boolean, payload: 0, kind: 0};
            return Emitter.Emitted(slots, append(locals, item), origins, code);
    }
}
Patch :: (output: Emitter, pc: int, target: int) -> Emitter {
    switch output {
        case .Emitted(slots, locals, origins, raw_code):
            code := raw_code;
            item := code[pc];
            item.target = target;
            code[pc] = item;
            return Emitter.Emitted(slots, locals, origins, code);
    }
}
NewFrame :: (expression: int) -> Frame {
    return {expression: expression, phase: 0, left: -1, local: -1, branch_pc: -1, skip: -1};
}

pub Lower :: (request: Request) -> Plan {
    switch request {
        case .Tables(types, expressions, symbols, variables, results, literals, ids, ranges, documents, abi, request_range):
            // Finite component contract, independent of the executor's budget.
            if (length(types) > 24 || length(expressions) > 24 || length(symbols) > 2 ||
                length(variables) > 2 || length(results) < 1 || length(results) > 2 ||
                length(literals) > 24 || length(ids) > 4 || length(ranges) > 25 ||
                length(documents) < 1 || length(documents) > 3 ||
                !ValidIndex(request_range, length(ranges))) {
                return Reject(-1, "scalar lowering input exceeds its schema limits");
            }
            if (abi.schema != 1 || abi.prepared != 26 ||
                (abi.pointer_storage != 7 && abi.pointer_storage != 9) ||
                abi.value_size < 1 || abi.value_size > 256 || abi.payload_offset < 0 ||
                abi.payload_offset > abi.value_size - 4 || abi.results_offset < 0 || abi.results_offset > 4096) {
                return Reject(request_range, "unsupported scalar lowering target facts");
            }
            index: int = 0;
            while (index < length(ranges)) {
                place := ranges[index];
                if (place.start < 0 || place.end < place.start || place.line < 0 || place.column < 0 ||
                    !ValidIndex(place.document, length(documents))) {
                    return Reject(index, "invalid scalar lowering source range");
                }
                index += 1;
            }
            index = 0;
            while (index < length(documents)) {
                if (text_byte_length(documents[index]) > 240) {
                    return Reject(request_range, "scalar lowering document is too long");
                }
                index += 1;
            }
            index = 0;
            while (index < length(types)) {
                if (!Scalar(types[index])) {
                    return Reject(request_range, "scalar lowering supports only ordinary Bool and I32 types");
                }
                index += 1;
            }
            defaults: Literal[] = [];
            variable_ids: u64[] = [];
            index = 0;
            while (index < length(variables)) {
                variable := variables[index];
                if (!ValidIndex(variable.type, length(types)) || !ValidIndex(variable.literal, length(literals)) ||
                    !ValidIndex(variable.id_slot, length(ids))) {
                    return Reject(request_range, "invalid scalar lowering variable signature");
                }
                identity := ids[variable.id_slot];
                if (identity == 0 || !ValidLiteral(literals[variable.literal], types[variable.type].storage)) {
                    return Reject(request_range, "invalid scalar lowering variable default");
                }
                earlier: int = 0;
                while (earlier < index) {
                    if (variable_ids[earlier] == identity) {
                        return Reject(request_range, "duplicate scalar lowering variable identity");
                    }
                    earlier += 1;
                }
                variable_ids.append(identity);
                defaults.append(literals[variable.literal]);
                index += 1;
            }
            symbol_variables: int[] = [];
            index = 0;
            while (index < length(symbols)) {
                symbol := symbols[index];
                if ((symbol.kind != 4 && symbol.kind != 5) || !ValidIndex(symbol.id_slot, length(ids)) ||
                    !ValidIndex(symbol.type, length(types))) {
                    return Reject(request_range, "scalar lowering supports only state symbols");
                }
                found: int = -1;
                candidate: int = 0;
                while (candidate < length(variable_ids)) {
                    if (variable_ids[candidate] == ids[symbol.id_slot]) {
                        found = candidate;
                    }
                    candidate += 1;
                }
                if (found < 0) {
                    return Reject(request_range, "scalar lowering state has no variable signature");
                }
                if (types[symbol.type].storage != defaults[found].storage) {
                    return Reject(request_range, "scalar lowering state signature differs from its type");
                }
                symbol_variables.append(found);
                index += 1;
            }
            // Validate every raw row, including rows unreachable from the results.
            // Edges need not be topological. The visited-instance cap catches reachable cycles.
            index = 0;
            while (index < length(expressions)) {
                item := expressions[index];
                if (!ValidIndex(item.type, length(types)) || !ValidIndex(item.range, length(ranges))) {
                    return Reject(request_range, "invalid scalar lowering expression metadata");
                }
                storage: int = types[item.type].storage;
                if (item.kind == 1) {
                    if (!ValidIndex(item.literal, length(literals))) {
                        return Reject(item.range, "invalid scalar lowering literal index");
                    }
                    if (!ValidLiteral(literals[item.literal], storage)) {
                        return Reject(item.range, "scalar lowering literal differs from its type");
                    }
                } else if (item.kind == 2) {
                    if (!ValidIndex(item.symbol, length(symbols))) {
                        return Reject(item.range, "invalid scalar lowering symbol index");
                    }
                    if (types[symbols[item.symbol].type].storage != storage) {
                        return Reject(item.range, "scalar lowering symbol differs from its type");
                    }
                } else if (item.kind == 3 || item.kind == 4 || item.kind == 5) {
                    if (!ValidIndex(item.left, length(expressions))) {
                        return Reject(item.range, "invalid scalar lowering left operand");
                    }
                    child := expressions[item.left];
                    if (!ValidIndex(child.type, length(types))) {
                        return Reject(item.range, "invalid scalar lowering operand type");
                    }
                    left_storage: int = types[child.type].storage;
                    if (item.kind == 5 || (item.kind == 3 && item.op == 0)) {
                        if (storage != left_storage) {
                            return Reject(item.range, "scalar lowering admits identity conversions only");
                        }
                    } else if (item.kind == 3) {
                        if (!((item.op == 6 || item.op == 21) && storage == Integer && left_storage == Integer) &&
                            !(item.op == 7 && storage == Boolean && left_storage == Boolean)) {
                            return Reject(item.range, "unsupported scalar lowering unary operator");
                        }
                    } else {
                        if (!ValidIndex(item.right, length(expressions))) {
                            return Reject(item.range, "invalid scalar lowering right operand");
                        }
                        right := expressions[item.right];
                        if (!ValidIndex(right.type, length(types))) {
                            return Reject(item.range, "invalid scalar lowering operand type");
                        }
                        if (left_storage != types[right.type].storage) {
                            return Reject(item.range, "scalar lowering admits identity conversions only");
                        }
                        logical: bool = item.op == 8 || item.op == 9;
                        compare: bool = item.op >= 10 && item.op <= 15;
                        if (logical) {
                            if (storage != Boolean || left_storage != Boolean) {
                                return Reject(item.range, "scalar lowering logical operands must be Bool");
                            }
                        } else if (Opcode(item.op) < 0 ||
                                   (compare && (storage != Boolean || (item.op >= 12 && left_storage != Integer))) ||
                                   (!compare && (storage != Integer || left_storage != Integer))) {
                            return Reject(item.range, "unsupported scalar lowering binary operator");
                        }
                    }
                } else {
                    return Reject(item.range, "unsupported scalar lowering expression kind");
                }
                index += 1;
            }
            headers: Literal[] = [];
            index = 0;
            while (index < length(results)) {
                result := results[index];
                if (!ValidIndex(result.expression, length(expressions)) || !ValidIndex(result.type, length(types))) {
                    return Reject(request_range, "invalid scalar lowering result signature");
                }
                if (types[result.type].storage != types[expressions[result.expression].type].storage) {
                    return Reject(request_range, "scalar lowering admits identity result conversions only");
                }
                header: Literal = {storage: types[result.type].storage, payload: 0};
                headers.append(header);
                index += 1;
            }
            slots: Slot[] = [];
            locals: Local[] = [];
            origins: Range[] = [];
            code: Instruction[] = [];
            output := Emitter.Emitted(slots, locals, origins, code);
            frames: Frame[] = [];
            index = 0;
            while (index < 257) {
                frames.append(NewFrame(-1));
                index += 1;
            }
            visits: int = 0;
            ordinal: int = 0;
            while (ordinal < length(results)) {
                frames[0] = NewFrame(results[ordinal].expression);
                top: int = 0;
                value: int = -1;
                returning: bool = false;
                while (top >= 0) {
                    frame := frames[top];
                    item := expressions[frame.expression];
                    place := ranges[item.range];
                    storage: int = types[item.type].storage;
                    if (PC(output) > 248) {
                        return Reject(item.range, "scalar lowering exceeds its instruction limit");
                    }
                    if (returning) {
                        if (frame.phase == 1) {
                            if (item.kind == 5 || (item.kind == 3 && item.op == 0)) {
                                top -= 1;
                                continue;
                            }
                            if (item.kind == 3) {
                                if (item.op == 7) {
                                    zero: Literal = {storage: Boolean, payload: 0};
                                    output = Emit(output, ConstantCode(zero), place, Boolean, 0);
                                    zero_slot: int = LastSlot(output);
                                    output = Emit(output, Code(Equal, Boolean, value, zero_slot, 0), place, Boolean, 0);
                                } else {
                                    op: int = Negate;
                                    if (item.op == 21) {
                                        op = BitNot;
                                    }
                                    output = Emit(output, Code(op, storage, value, 0, 0), place, storage, 0);
                                }
                                value = LastSlot(output);
                                top -= 1;
                                continue;
                            }
                            frame.left = value;
                            frame.phase = 2;
                            if (item.op == 8 || item.op == 9) {
                                frame.local = LocalCount(output);
                                output = AddLocal(output);
                                output = Emit(output, Code(Save, Boolean, value, 0, frame.local), place, 0, 0);
                                frame.branch_pc = PC(output);
                                output = Emit(output, Code(Branch, 0, value, 0, -1), place, 0, 0);
                                if (item.op == 8) {
                                    frame.skip = PC(output);
                                    output = Emit(output, Code(Jump, 0, 0, 0, -1), place, 0, 0);
                                    output = Patch(output, frame.branch_pc, PC(output));
                                }
                            }
                            frames[top] = frame;
                            top += 1;
                            frames[top] = NewFrame(item.right);
                            returning = false;
                            continue;
                        }
                        if (item.op == 8 || item.op == 9) {
                            output = Emit(output, Code(Save, Boolean, value, 0, frame.local), place, 0, 0);
                            patch: int = frame.branch_pc;
                            if (frame.skip >= 0) {
                                patch = frame.skip;
                            }
                            output = Patch(output, patch, PC(output));
                            output = Emit(output, Code(LocalRead, Boolean, frame.local, 0, 0), place, Boolean, 0);
                        } else {
                            operand_storage: int = types[expressions[item.left].type].storage;
                            output = Emit(output, Code(Opcode(item.op), operand_storage, frame.left, value, -1), place, storage, 0);
                        }
                        value = LastSlot(output);
                        top -= 1;
                        continue;
                    }
                    visits += 1;
                    if (visits > 256 || top >= 256) {
                        return Reject(item.range, "scalar lowering exceeds its traversal limit");
                    }
                    if (item.kind == 1 || item.kind == 2) {
                        instruction := Code(Constant, storage, 0, 0, 0);
                        if (item.kind == 1) {
                            instruction = ConstantCode(literals[item.literal]);
                        }
                        if (item.kind == 2) {
                            instruction = Code(VariableRead, storage, symbol_variables[item.symbol], 0, 0);
                        }
                        output = Emit(output, instruction, place, storage, 0);
                        value = LastSlot(output);
                        returning = true;
                        top -= 1;
                        continue;
                    }
                    frame.phase = 1;
                    frames[top] = frame;
                    top += 1;
                    frames[top] = NewFrame(item.left);
                }
                place := ranges[request_range];
                instruction := Code(Context, abi.pointer_storage, 0, 0, 0);
                instruction.offset = abi.results_offset;
                output = Emit(output, instruction, place, abi.pointer_storage, 1);
                bank: int = LastSlot(output);
                literal: Literal = {storage: Integer, payload: ordinal};
                output = Emit(output, ConstantCode(literal), place, Integer, 0);
                position: int = LastSlot(output);
                instruction = Code(Index, abi.pointer_storage, bank, position, 0);
                instruction.offset = abi.value_size;
                output = Emit(output, instruction, place, abi.pointer_storage, 1);
                header: int = LastSlot(output);
                instruction = Code(Write, headers[ordinal].storage, value, header, 0);
                instruction.offset = abi.payload_offset;
                output = Emit(output, instruction, place, 0, 0);
                ordinal += 1;
            }
            output = Emit(output, Code(Return, 0, 0, 0, 0), ranges[request_range], 0, 0);
            output = Emit(output, Code(End, 0, 0, 0, 0), ranges[request_range], 0, 0);
            if (PC(output) > 256) {
                return Reject(request_range, "scalar lowering exceeds its instruction limit");
            }
            switch output {
                case .Emitted(final_slots, final_locals, final_origins, final_code):
                    return Plan.Ready(abi, variable_ids, defaults, headers,
                                      final_slots, final_locals, final_origins, documents, final_code);
            }
    }
}
