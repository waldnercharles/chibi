package facts

// fallible shadowed member accepts its own presence guard
@test
Calls :: () {
    a1_0: bool = false;
    r1: int = Use(a1_0);
    e1: int = 3;
    assert(r1 == e1, "Use call 1");
    a2_0: bool = true;
    r2: int = Use(a2_0);
    e2: int = 11;
    assert(r2 == e2, "Use call 2");
}
