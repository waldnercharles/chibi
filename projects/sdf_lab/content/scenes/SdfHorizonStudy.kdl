version 1
name "SdfHorizonStudy"
(array)entities {
    - {
        name "Camera"
        prototype "SdfOptimizationCamera"
        components {
            GameTransform x=0.0 y=0.0
            GameCamera width=620.0 height=400.0 focal_distance=0.0
            GameHRC2D ambient=0.08 fog=0.02 bounce_intensity=0.12
        }
    }
    - {
        name "West cyan"
        prototype "SdfLight"
        components {
            GameTransform x=-260.0 y=0.0
            GameMaterial emission_color=0x38d9edff
        }
    }
    - {
        name "East amber"
        prototype "SdfLight"
        components {
            GameTransform x=260.0 y=0.0
            GameMaterial emission_color=0xffac54ff
        }
    }
    - {
        name "North rose"
        prototype "SdfLight"
        components {
            GameTransform x=0.0 y=-160.0
            GameMaterial emission_color=0xec749fff
        }
    }
    - {
        name "South ivory"
        prototype "SdfLight"
        components {
            GameTransform x=0.0 y=160.0
            GameMaterial emission_color=0xcddcffff
        }
    }
    - {
        name "Continuous canopy"
        prototype "SdfHorizonCanopy"
        components {
            GameTransform x=-105.0 y=0.0
            GameGeometry3D elevation=0.0
            GameShader material="SdfCyan"
        }
    }
    - {
        name "Moving blocker"
        prototype "SdfRoundedBox"
        components {
            GameTransform x=-105.0 y=0.0
            GameVisualTransform scale=0.45
            GameGeometry3D elevation=30.0
            GameShader material="SdfRose"
        }
        (array)behaviors "SdfRigidSweep"
    }
    - {
        name "Separated west hill"
        prototype "SdfSphere"
        components {
            GameTransform x=100.0 y=-55.0
            GameVisualTransform scale=0.85 pitch=0.0
            GameShader material="SdfAmber"
        }
    }
    - {
        name "Separated east hill"
        prototype "SdfSphere"
        components {
            GameTransform x=155.0 y=-55.0
            GameVisualTransform scale=0.85 pitch=0.0
            GameShader material="SdfAmber"
        }
    }
    - {
        name "Low continuous receiver"
        prototype "SdfComparisonMesh"
        components {
            GameTransform x=130.0 y=65.0
            GameGeometry3D width=115.0 height=6.0 depth=70.0 elevation=-20.0
            GameVisualTransform pitch=0.0 roll=0.0
        }
    }
    - {
        name "Tilted ridge"
        prototype "SdfRoundedBox"
        components {
            GameTransform x=130.0 y=65.0
            GameVisualTransform scale=0.65 pitch=0.4 roll=0.35
            GameGeometry3D elevation=10.0
        }
    }
}
