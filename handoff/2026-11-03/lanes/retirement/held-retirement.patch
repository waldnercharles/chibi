-            case BF_VARIABLE:
-            case BF_LOCAL:
-                if (i->right || i->target) {
-                    return false;
-                }
-                break;
-            case BF_NEG:
-            case BF_BIT_NOT:
-                if (i->right || i->target || i->type != PIN_I32 ||
-                    slots[i->left] != PIN_I32) {
-                    return false;
-                }
-                break;
-            case BF_INDEX:
-            case BF_WRITE:
-                if (i->target) {
-                    return false;
-                }
-                break;
-            case BF_SAVE:
-            case BF_BRANCH:
-                if (i->right) {
-                    return false;
-                }
-                break;
-            case BF_JUMP:
-                if (i->left || i->right) {
-                    return false;
-                }
-                break;
-            case BF_RETURN:
-            case BF_END:
-                if (i->left || i->right || i->target || i->type != PIN_FLOW ||
