version 1
name "MaterialStudy"
(array)entities {
    - name="Camera" prototype="MaterialStudyCamera"
    - name="Materials" prototype="MaterialStudyWorld"
    - {
        name "Solid sample"
        prototype "MaterialSpecimen"
        components {
            Transform x=0.0 y=115.0
        }
    }
    - {
        name "Cut sample"
        prototype "MaterialSpecimen"
        components {
            Transform x=0.0 y=-120.0
        }
        (array)behaviors "CutMaterial"
    }
}
