package native_emitter

import facts "project:scalar_facts"
import scalar "project:scalar_llvm"
import strings "core:strings"

// `chibi build --native`'s entries over CollectScalar's rows. Each returns
// raw bytes the compiler host writes unchanged: the module's IR, or why it has
// none.
pub Emit :: (rows: facts.Row[]) -> u8[] {
    return scalar.EmitBytes(rows);
}
// Emit with line tables, for a source in `directory`.
pub EmitLines :: (rows: facts.Row[], directory: string) -> u8[] {
    return scalar.EmitLinesBytes(rows, directory);
}

pub Diagnose :: (rows: facts.Row[]) -> u8[] {
    message := "";
    switch scalar.Emit(rows) {
        case .Rejected(rejected):
            message = format_text("{}:{}: {}", rejected[1].line, rejected[1].column, rejected[1].text);
        case .Invalid(reason):
            message = reason;
        case .Emitted(text):
            message = "";
    }
    bytes: u8[] = [];
    for (value in strings.Bytes(message)) {
        bytes.append(u8(value));
    }
    return bytes;
}
