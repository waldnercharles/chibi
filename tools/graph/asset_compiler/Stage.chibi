package asset_compiler_stage

import strings "core:strings"

Join :: (parts: string[]) -> string { return strings.Join(parts, ""); }

pub Current :: (root: string) -> bool {
    resource := Join([root, "/tools/compiler/asset_compiler/bootstrap/native64"]);
    return build.file_exists(Join([resource, "/inventory.txt"])) &&
           build.read_file(Join([resource, "/inventory.txt"])) == Inventory(root) &&
           Fingerprints(root, resource) && Products(resource);
}

Products :: (resource: string) -> bool {
    if (!build.file_exists(Join([resource, "/manifest.json"]))) { return false; }
    manifest := build.read_file(Join([resource, "/manifest.json"]));
    artifact := build.before(build.after(manifest, "\"artifact_sha256\":\""), "\"");
    code := build.before(build.after(manifest, "\"resource_sha256\":\""), "\"");
    return strings.ByteLength(artifact) == 64 && strings.ByteLength(code) == 64 &&
           build.hash_file(Join([resource, "/asset_compiler.chibip"])) == artifact &&
           build.hash_file(Join([resource, "/asset_compiler_packaged.c"])) == code;
}

Fingerprints :: (root: string, resource: string) -> bool {
    lines := build.lines(build.read_file(Join([resource, "/sources.sha256"])));
    if (length(lines) == 0) { return false; }
    for (line in lines) {
        if (line == "") { continue; }
        expected := build.before(line, " ");
        path := build.after(line, " ");
        if (strings.ByteLength(expected) != 64 || path == "" ||
            build.hash_file(Join([root, "/", path])) != expected) { return false; }
    }
    return true;
}

// The shipped compiler artifact is a bootstrap input. Source changes regenerate
// it through the authored compiler before the graph compiles its resource.
pub Stage :: (root: string, build_dir: string) -> bool {
    resource := Join([root, "/tools/compiler/asset_compiler/bootstrap/native64"]);
    output := Join([build_dir, "/sdk/generated/assets"]);
    current := Current(root);
    if (!build.make_directory(output)) { return false; }
    if (!current) {
        host := Join([build_dir, "/sdk/chibi-compiler-host"]);
        if (!Generate(root, host, output, "")) {
            build.report("asset compiler regeneration failed");
            return false;
        }
        return true;
    }
    if (!build.copy_file(Join([resource, "/asset_compiler_packaged.c"]), Join([output, "/asset_compiler_packaged.c"]))) {
        return false;
    }
    // embed_file returns whether it changed the output; an unchanged blob is ready.
    blob := Join([output, "/asset_compiler_blob.inc"]);
    build.embed_file(Join([resource, "/asset_compiler.chibip"]), blob, "asset_compiler_blob");
    return build.file_exists(blob);
}
