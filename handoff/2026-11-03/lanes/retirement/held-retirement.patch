-                          ? pin_value_array_promote(storage, &copy, source)
-                          : pin_value_capture_to_arena(storage, &copy, source);
-            if (error || (storage->collectable && copy.ptr &&
-                          pin_array_make_unique(storage, copy.ptr))) {
-                return -1;
-            }
