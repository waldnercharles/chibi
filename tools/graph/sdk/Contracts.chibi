pub PlatformProperties :: (name: string, platform: string) -> string[] {
    if (platform == "Darwin") {
        if (name == "render") {
            return [
                "INTERFACE_LINK_LIBRARIES=Chibi::platform;Chibi::ui;Chibi::engine;Chibi::player;Chibi::shader_runtime;Chibi::model_runtime;Chibi::mesh_runtime;Chibi::native_types;Chibi::spatial_runtime;Chibi::native_capabilities;Chibi::particle_runtime;Chibi::material_runtime;Chibi::ui_runtime;Chibi::save_runtime;Chibi::ui_document_values;Chibi::ui_documents;Chibi::visual_catalog;$<LINK_ONLY:Chibi::support>;$<LINK_ONLY:Chibi::json>;$<LINK_ONLY:Chibi::asset_values>;$<LINK_ONLY:Chibi::task_pool_runtime>;$<LINK_ONLY:Chibi::tilemap_runtime>;-framework Metal;-framework Foundation;Chibi::image_catalog"
            ];
        }
        if (name == "ui") {
            return [
                "INTERFACE_LINK_LIBRARIES=Chibi::platform;Chibi::json;Chibi::ui_document_values;Chibi::ui_documents;Chibi::text_search;$<LINK_ONLY:Chibi::builtin_fonts>;$<LINK_ONLY:Chibi::support>;$<LINK_ONLY:Chibi::vendor_rmlui_core>;$<LINK_ONLY:c++>"
            ];
        }
    }
    if (platform == "Linux" && name == "ui") {
        for (property in Properties(name)) {
            if (strings.HasPrefix(property, "INTERFACE_LINK_LIBRARIES=")) {
                return [strings.Join([property, ";$<LINK_ONLY:stdc++>"], "")];
            }
        }
    }
    return [];
}

// Vendor names include their vendor_ prefix and omit the Chibi:: namespace.
pub VendorTargets :: (platform: string) -> string[] {
    if (!Supported(platform)) {
        return [];
    }
    return [
        "vendor_SDL3_Headers",
        "vendor_SDL3_static",
        "vendor_box2d",
        "vendor_box3d",
        "vendor_cute",
        "vendor_enkits",
        "vendor_freetype",
        "vendor_physfs_static",
        "vendor_rmlui_core",
        "vendor_sljit"
    ];
}

pub VendorLibrary :: (name: string, platform: string) -> string {
    if (!Supported(platform)) {
        return "";
    }
    if (name == "vendor_SDL3_static") {
        return "lib/chibi-vendor/libchibi_vendor_SDL3_static.a";
    }
    if (name == "vendor_box2d") {
        return "lib/chibi-vendor/libchibi_vendor_box2d.a";
    }
    if (name == "vendor_box3d") {
        return "lib/chibi-vendor/libchibi_vendor_box3d.a";
    }
    if (name == "vendor_cute") {
        return "lib/chibi-vendor/libchibi_vendor_cute.a";
    }
    if (name == "vendor_enkits") {
        return "lib/chibi-vendor/libchibi_vendor_enkits.a";
    }
    if (name == "vendor_freetype") {
        return "lib/chibi-vendor/libchibi_vendor_freetype.a";
    }
    if (name == "vendor_physfs_static") {
        return "lib/chibi-vendor/libchibi_vendor_physfs_static.a";
    }
    if (name == "vendor_rmlui_core") {
        return "lib/chibi-vendor/libchibi_vendor_rmlui_core.a";
    }
    if (name == "vendor_sljit") {
        return "lib/chibi-vendor/libchibi_vendor_sljit.a";
    }
    return "";
}

pub VendorProperties :: (name: string, platform: string) -> string[] {
    if (!Supported(platform)) {
        return [];
    }
    if (name == "vendor_SDL3_Headers") {
        return [
            "INTERFACE_INCLUDE_DIRECTORIES=@prefix/include/chibi/vendor/SDL3_Headers/1;@prefix/include/chibi/vendor/SDL3_Headers/2"
        ];
    }
    if (name == "vendor_SDL3_static") {
        return [
            "INTERFACE_LINK_LIBRARIES=m;$<LINK_LIBRARY:FRAMEWORK,CoreMedia>;$<LINK_LIBRARY:FRAMEWORK,CoreVideo>;$<LINK_LIBRARY:FRAMEWORK,Cocoa>;$<LINK_LIBRARY:WEAK_FRAMEWORK,UniformTypeIdentifiers>;$<LINK_LIBRARY:FRAMEWORK,IOKit>;$<LINK_LIBRARY:FRAMEWORK,ForceFeedback>;$<LINK_LIBRARY:FRAMEWORK,Carbon>;$<LINK_LIBRARY:FRAMEWORK,CoreAudio>;$<LINK_LIBRARY:FRAMEWORK,AudioToolbox>;$<LINK_LIBRARY:FRAMEWORK,AVFoundation>;$<LINK_LIBRARY:FRAMEWORK,Foundation>;$<LINK_LIBRARY:FRAMEWORK,GameController>;$<LINK_LIBRARY:FRAMEWORK,Metal>;$<LINK_LIBRARY:FRAMEWORK,QuartzCore>;$<LINK_LIBRARY:WEAK_FRAMEWORK,CoreHaptics>;Chibi::vendor_SDL3_Headers",
            "INTERFACE_LINK_OPTIONS=-lpthread"
        ];
    }
    if (name == "vendor_box2d") {
        return [
            "INTERFACE_INCLUDE_DIRECTORIES=@prefix/include/chibi/vendor/box2d/1",
            "INTERFACE_LINK_LIBRARIES=m"
        ];
    }
    if (name == "vendor_box3d") {
        return [
            "INTERFACE_INCLUDE_DIRECTORIES=@prefix/include/chibi/vendor/box3d/1",
            "INTERFACE_LINK_LIBRARIES=m;Threads::Threads"
        ];
    }
    if (name == "vendor_cute") {
        return [
            "INTERFACE_COMPILE_DEFINITIONS=CF_STATIC;CF_RUNTIME_SHADER_COMPILATION;IMGUI_USE_WCHAR32;ImDrawIdx=unsigned int",
            "INTERFACE_INCLUDE_DIRECTORIES=@prefix/include/chibi/vendor/cute/1;@prefix/include/chibi/vendor/cute/2;@prefix/include/chibi/vendor/cute/3;@prefix/include/chibi/vendor/cute/4;@prefix/include/chibi/vendor/cute/5",
            "INTERFACE_LINK_LIBRARIES=-framework IOKit;-framework Foundation;-framework Security;-framework QuartzCore;-framework Metal;-framework MetalKit;-framework Network;-framework VideoToolbox;-framework CoreMedia;-framework CoreVideo;-framework CoreFoundation;Chibi::vendor_physfs_static;Chibi::vendor_SDL3_static"
        ];
    }
    if (name == "vendor_enkits") {
        return [
            "INTERFACE_COMPILE_DEFINITIONS=ENKITS_TASK_PRIORITIES_NUM=3",
            "INTERFACE_INCLUDE_DIRECTORIES=@prefix/include/chibi/vendor/enkits/1",
            "INTERFACE_LINK_LIBRARIES=Threads::Threads;c++"
        ];
    }
    if (name == "vendor_freetype") {
        return [
            "INTERFACE_INCLUDE_DIRECTORIES=@prefix/include/chibi/vendor/freetype/1;@prefix/include/chibi/vendor/freetype/2"
        ];
    }
    if (name == "vendor_physfs_static") {
        return [
            "INTERFACE_INCLUDE_DIRECTORIES=@prefix/include/chibi/vendor/physfs_static/1",
            "INTERFACE_LINK_LIBRARIES=-framework IOKit -framework Foundation"
        ];
    }
    if (name == "vendor_rmlui_core") {
        return [
            "INTERFACE_COMPILE_DEFINITIONS=RMLUI_STATIC_LIB",
            "INTERFACE_COMPILE_FEATURES=cxx_std_17",
            "INTERFACE_INCLUDE_DIRECTORIES=@prefix/include/chibi/vendor/rmlui_core/1",
            "INTERFACE_LINK_LIBRARIES=Chibi::vendor_freetype"
        ];
    }
    if (name == "vendor_sljit") {
        return [
            "INTERFACE_INCLUDE_DIRECTORIES=@prefix/include/chibi/vendor/sljit/1"
        ];
    }
    return [];
}

// DESTINATION=SOURCE entries. Source roots are bound by the installer. For
// include/chibi/vendor directory entries copy only VendorHeader-matching files.
// All other entries copy their complete regular-file/directory input.
pub VendorEntries :: (platform: string) -> string[] {
    if (!Supported(platform)) {
        return [];
    }
    return [
        "include/chibi/vendor/SDL3_Headers/1=@vendor/include/chibi/vendor/SDL3_Headers/1",
        "include/chibi/vendor/SDL3_Headers/2=@vendor/include/chibi/vendor/SDL3_Headers/2",
        "include/chibi/vendor/box2d/1=@vendor/include/chibi/vendor/box2d/1",
        "include/chibi/vendor/box3d/1=@vendor/include/chibi/vendor/box3d/1",
        "include/chibi/vendor/cute/1=@vendor/include/chibi/vendor/cute/1",
        "include/chibi/vendor/cute/2=@vendor/include/chibi/vendor/cute/2",
        "include/chibi/vendor/cute/3=@vendor/include/chibi/vendor/cute/3",
        "include/chibi/vendor/cute/4=@vendor/include/chibi/vendor/cute/4",
        "include/chibi/vendor/cute/5=@vendor/include/chibi/vendor/cute/5",
        "include/chibi/vendor/enkits/1=@vendor/include/chibi/vendor/enkits/1",
        "include/chibi/vendor/freetype/1=@vendor/include/chibi/vendor/freetype/1",
        "include/chibi/vendor/freetype/2=@vendor/include/chibi/vendor/freetype/2",
        "include/chibi/vendor/physfs_static/1=@vendor/include/chibi/vendor/physfs_static/1",
        "include/chibi/vendor/rmlui_core/1=@vendor/include/chibi/vendor/rmlui_core/1",
        "include/chibi/vendor/sljit/1=@vendor/include/chibi/vendor/sljit/1",
        "lib/chibi-vendor/libchibi_vendor_SDL3_static.a=@vendor/lib/chibi-vendor/libchibi_vendor_SDL3_static.a",
        "lib/chibi-vendor/libchibi_vendor_box2d.a=@vendor/lib/chibi-vendor/libchibi_vendor_box2d.a",
        "lib/chibi-vendor/libchibi_vendor_box3d.a=@vendor/lib/chibi-vendor/libchibi_vendor_box3d.a",
        "lib/chibi-vendor/libchibi_vendor_cute.a=@vendor/lib/chibi-vendor/libchibi_vendor_cute.a",
        "lib/chibi-vendor/libchibi_vendor_enkits.a=@vendor/lib/chibi-vendor/libchibi_vendor_enkits.a",
        "lib/chibi-vendor/libchibi_vendor_freetype.a=@vendor/lib/chibi-vendor/libchibi_vendor_freetype.a",
        "lib/chibi-vendor/libchibi_vendor_physfs_static.a=@vendor/lib/chibi-vendor/libchibi_vendor_physfs_static.a",
        "lib/chibi-vendor/libchibi_vendor_rmlui_core.a=@vendor/lib/chibi-vendor/libchibi_vendor_rmlui_core.a",
        "lib/chibi-vendor/libchibi_vendor_sljit.a=@vendor/lib/chibi-vendor/libchibi_vendor_sljit.a",
        "share/chibi/licenses/cute-math/LICENSE=@vendor/source/cute_framework/LICENSE",
        "share/chibi/licenses/vendor/SDL3_Headers=@vendor/share/chibi/licenses/vendor/SDL3_Headers",
        "share/chibi/licenses/vendor/box2d=@vendor/share/chibi/licenses/vendor/box2d",
        "share/chibi/licenses/vendor/box3d=@vendor/share/chibi/licenses/vendor/box3d",
        "share/chibi/licenses/vendor/cute=@vendor/share/chibi/licenses/vendor/cute",
        "share/chibi/licenses/vendor/enkits=@vendor/share/chibi/licenses/vendor/enkits",
        "share/chibi/licenses/vendor/freetype=@vendor/share/chibi/licenses/vendor/freetype",
        "share/chibi/licenses/vendor/physfs_static=@vendor/share/chibi/licenses/vendor/physfs_static",
        "share/chibi/licenses/vendor/rmlui_core=@vendor/share/chibi/licenses/vendor/rmlui_core",
        "share/chibi/licenses/vendor/sljit=@vendor/share/chibi/licenses/vendor/sljit"
    ];
}

pub VendorHeader :: (path: string) -> bool {
    if (strings.Contains(strings.Join(["/", path, "/"], ""), "/bindings/")) {
        return false;
    }
    return strings.HasSuffix(path, ".h") || strings.HasSuffix(path, ".hpp") || strings.HasSuffix(path, ".inl");
}

// Engine-owned files/directories installed beside runtime packages. Font
// notices are explicit so font binaries and unrelated READMEs are not copied.
// engine.json, package.json and compatibility files are generated separately.
pub ResourceEntries :: () -> string[] {
    return [
        "share/chibi/core/strings/Strings.chibi=@source/packages/core/strings/Strings.chibi",
        "share/chibi/docs/sdk.md=@source/sdk/README.md",
        "share/chibi/licenses/chibi/COPYING.EXAMPLES=@source/COPYING.EXAMPLES",
        "share/chibi/licenses/chibi/COPYING.LESSER=@source/COPYING.LESSER",
        "share/chibi/licenses/chibi/COPYING=@source/COPYING",
        "share/chibi/licenses/chibi/LICENSE.md=@source/LICENSE.md",
        "share/chibi/licenses/chibi/docs/distribution-licensing.md=@source/docs/distribution-licensing.md",
        "share/chibi/licenses/fmt/LICENSE=@source/third_party/fmt/LICENSE",
        "share/chibi/licenses/fmt/README.md=@source/third_party/fmt/README.md",
        "share/chibi/licenses/fonts/geist/OFL.txt=@source/third_party/fonts/geist/OFL.txt",
        "share/chibi/licenses/fonts/inconsolata/OFL.txt=@source/third_party/fonts/inconsolata/OFL.txt",
        "share/chibi/licenses/fonts/inter/OFL.txt=@source/third_party/fonts/inter/OFL.txt",
