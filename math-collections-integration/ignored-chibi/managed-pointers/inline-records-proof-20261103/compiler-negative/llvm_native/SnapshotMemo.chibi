package llvm_native

import strings "core:strings"

// A migration-local memo owns only its bucket storage. Callers own every
// mapped value and keep source addresses stable until migration ends.
// Half-full open addressing gives constant expected lookup; growth doubles.
SnapshotMemoRuntime :: (guarded: bool = false) -> string {
    return strings.Join([
        "%chibi.snapshot.memo = type { ptr, i32, i32 }\n",
        "%chibi.snapshot.entry = type { ptr, i64, i64 }\n",
        "\n",
        "; Keys are stable source addresses plus a caller-defined semantic identity.\n",
        "; Source null is the empty bucket; all-zero values bypass memoization.\n",
        "define internal ptr @chibi_snapshot.memo.place(ptr %entries, i32 %capacity, ptr %source, i64 %key) {\n",
        "entry:\n",
        "  %address = ptrtoint ptr %source to i64\n",
        "  %mixed = xor i64 %address, %key\n",
        "  %shifted = lshr i64 %mixed, 33\n",
        "  %folded = xor i64 %mixed, %shifted\n",
        "  %scaled = mul i64 %folded, -49064778989728563\n",
        "  %upper = lshr i64 %scaled, 33\n",
        "  %hashed = xor i64 %scaled, %upper\n",
        "  %narrow = trunc i64 %hashed to i32\n",
        "  %mask = sub i32 %capacity, 1\n",
        "  %initial = and i32 %narrow, %mask\n",
        "  br label %probe\n",
        "probe:\n",
        "  %index = phi i32 [ %initial, %entry ], [ %next, %again ]\n",
        "  %at = getelementptr %chibi.snapshot.entry, ptr %entries, i32 %index\n",
        "  %present = load ptr, ptr %at\n",
        "  %empty = icmp eq ptr %present, null\n",
        "  br i1 %empty, label %done, label %check\n",
        "check:\n",
        "  %key.at = getelementptr %chibi.snapshot.entry, ptr %at, i32 0, i32 1\n",
        "  %stored = load i64, ptr %key.at\n",
        "  %same.source = icmp eq ptr %present, %source\n",
        "  %same.key = icmp eq i64 %stored, %key\n",
        "  %same = and i1 %same.source, %same.key\n",
        "  br i1 %same, label %done, label %again\n",
        "again:\n",
        "  %increment = add i32 %index, 1\n",
        "  %next = and i32 %increment, %mask\n",
        "  br label %probe\n",
        "done:\n",
        "  ret ptr %at\n",
        "}\n",
        "\n",
        "define internal ptr @chibi_snapshot.memo.find(ptr %memo, ptr %source, i64 %key) {\n",
        "entry:\n",
        "  %capacity.at = getelementptr %chibi.snapshot.memo, ptr %memo, i32 0, i32 2\n",
        "  %capacity = load i32, ptr %capacity.at\n",
        "  %empty = icmp eq i32 %capacity, 0\n",
        "  br i1 %empty, label %none, label %search\n",
        "search:\n",
        "  %entries = load ptr, ptr %memo\n",
        "  %at = call ptr @chibi_snapshot.memo.place(ptr %entries, i32 %capacity, ptr %source, i64 %key)\n",
        "  %present = load ptr, ptr %at\n",
        "  %found = icmp ne ptr %present, null\n",
        "  br i1 %found, label %done, label %none\n",
        "done:\n",
        "  ret ptr %at\n",
        "none:\n",
        "  ret ptr null\n",
        "}\n",
        "\n",
        "define internal void @chibi_snapshot.memo.grow(ptr %ctx, ptr %memo) {\n",
        "entry:\n",
        "  %used.at = getelementptr %chibi.snapshot.memo, ptr %memo, i32 0, i32 1\n",
        "  %capacity.at = getelementptr %chibi.snapshot.memo, ptr %memo, i32 0, i32 2\n",
        "  %old.capacity = load i32, ptr %capacity.at\n",
        "  %bounded = icmp ult i32 %old.capacity, 1073741824\n",
        "  br i1 %bounded, label %size, label %oom\n",
        "size:\n",
        "  %first = icmp eq i32 %old.capacity, 0\n",
        "  %doubled = shl i32 %old.capacity, 1\n",
        "  %capacity = select i1 %first, i32 16, i32 %doubled\n",
        "  %end = getelementptr %chibi.snapshot.entry, ptr null, i32 %capacity\n",
        "  %bytes = ptrtoint ptr %end to i64\n",
        ContextCall("allocate", 2, guarded),
        "  %entries = call ptr %allocate(ptr %ctx, i64 %bytes)\n",
        "  br label %clear\n",
        "clear:\n",
        "  %index = phi i32 [ 0, %size ], [ %next, %clear ]\n",
        "  %at = getelementptr %chibi.snapshot.entry, ptr %entries, i32 %index\n",
        "  ; Empty buckets need only their source pointer initialized.\n",
        "  store ptr null, ptr %at\n",
        "  %next = add i32 %index, 1\n",
        "  %cleared = icmp eq i32 %next, %capacity\n",
        "  br i1 %cleared, label %old, label %clear\n",
        "old:\n",
        "  %previous = load ptr, ptr %memo\n",
        "  br label %rehash\n",
        "rehash:\n",
        "  %from = phi i32 [ 0, %old ], [ %following, %advance ]\n",
        "  %finished = icmp eq i32 %from, %old.capacity\n",
        "  br i1 %finished, label %release, label %inspect\n",
        "inspect:\n",
        "  %item = getelementptr %chibi.snapshot.entry, ptr %previous, i32 %from\n",
        "  %source = load ptr, ptr %item\n",
        "  %occupied = icmp ne ptr %source, null\n",
        "  br i1 %occupied, label %copy, label %advance\n",
        "copy:\n",
        "  %key.at = getelementptr %chibi.snapshot.entry, ptr %item, i32 0, i32 1\n",
        "  %key = load i64, ptr %key.at\n",
        "  %destination = call ptr @chibi_snapshot.memo.place(ptr %entries, i32 %capacity, ptr %source, i64 %key)\n",
        "  %value = load %chibi.snapshot.entry, ptr %item\n",
        "  store %chibi.snapshot.entry %value, ptr %destination\n",
        "  br label %advance\n",
        "advance:\n",
        "  %following = add i32 %from, 1\n",
        "  br label %rehash\n",
        "release:\n",
        "  %has.previous = icmp ne ptr %previous, null\n",
        "  br i1 %has.previous, label %free, label %publish\n",
        "free:\n",
        ContextCall("give", 4, guarded),
        "  call void %give(ptr %ctx, ptr %previous)\n",
        "  br label %publish\n",
        "publish:\n",
        "  store ptr %entries, ptr %memo\n",
        "  store i32 %capacity, ptr %capacity.at\n",
        "  ret void\n",
        "oom:\n",
        "  call void @llvm.trap()\n",
        "  unreachable\n",
        "}\n",
        "\n",
        "define internal void @chibi_snapshot.memo.put(ptr %ctx, ptr %memo, ptr %source, i64 %key, i64 %value) {\n",
        "entry:\n",
        "  %existing = call ptr @chibi_snapshot.memo.find(ptr %memo, ptr %source, i64 %key)\n",
        "  %present = icmp ne ptr %existing, null\n",
        "  br i1 %present, label %update, label %room\n",
        "update:\n",
        "  %updated = getelementptr %chibi.snapshot.entry, ptr %existing, i32 0, i32 2\n",
        "  store i64 %value, ptr %updated\n",
        "  ret void\n",
        "room:\n",
        "  %used.at = getelementptr %chibi.snapshot.memo, ptr %memo, i32 0, i32 1\n",
        "  %capacity.at = getelementptr %chibi.snapshot.memo, ptr %memo, i32 0, i32 2\n",
        "  %used = load i32, ptr %used.at\n",
        "  %capacity = load i32, ptr %capacity.at\n",
        "  %half = lshr i32 %capacity, 1\n",
        "  %full = icmp uge i32 %used, %half\n",
        "  br i1 %full, label %grow, label %insert\n",
        "grow:\n",
        "  call void @chibi_snapshot.memo.grow(ptr %ctx, ptr %memo)\n",
        "  br label %insert\n",
        "insert:\n",
        "  %entries = load ptr, ptr %memo\n",
        "  %available = load i32, ptr %capacity.at\n",
        "  %at = call ptr @chibi_snapshot.memo.place(ptr %entries, i32 %available, ptr %source, i64 %key)\n",
        "  %key.at = getelementptr %chibi.snapshot.entry, ptr %at, i32 0, i32 1\n",
        "  %value.at = getelementptr %chibi.snapshot.entry, ptr %at, i32 0, i32 2\n",
        "  store i64 %key, ptr %key.at\n",
        "  store i64 %value, ptr %value.at\n",
        "  store ptr %source, ptr %at\n",
        "  %next = add i32 %used, 1\n",
        "  store i32 %next, ptr %used.at\n",
        "  ret void\n",
        "}\n",
        "\n",
        "define internal void @chibi_snapshot.memo.release(ptr %ctx, ptr %memo) {\n",
        "entry:\n",
        "  %entries = load ptr, ptr %memo\n",
        "  %present = icmp ne ptr %entries, null\n",
        "  br i1 %present, label %free, label %done\n",
        "free:\n",
        ContextCall("give", 4, guarded),
        "  call void %give(ptr %ctx, ptr %entries)\n",
        "  br label %done\n",
        "done:\n",
        "  store %chibi.snapshot.memo zeroinitializer, ptr %memo\n",
        "  ret void\n",
        "}\n"
    ], "");
}
