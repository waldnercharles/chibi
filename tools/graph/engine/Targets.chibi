    }
    if (target == "chibi_compiler_host") {
        return ["third-party/include/chibi/vendor/tree_sitter/1"];
    }
    if (target == "chibi_compiler_syntax") {
        return ["third-party/include/chibi/vendor/tree_sitter/1"];
    }
    return [];
}

// The macros a target's compiles define, before its include directories.
pub Defines :: (target: string) -> string[] {
    if (target == "chibi_execution") {
        return ["CHIBI_HAVE_SJLIT=1"];
    }
    if (target == "chibi_task_pool_runtime") {
        return ["CHIBI_HAS_ENKITS=1", "ENKITS_TASK_PRIORITIES_NUM=3"];
    }
    if (target == "policy_worker") {
        return ["_DEFAULT_SOURCE", "_POSIX_C_SOURCE=200809L"];
    }
    if (target == "benchmark_trials") {
        return ["_POSIX_C_SOURCE=200809L"];
    }
    if (target == "test_language") {
        return [
            "CHIBI_PACKAGE_TEST_POOL=1", "CHIBI_TEST_ASSET_COMPILER_HOST=1", "CHIBI_TEST_ENKITS=1",
            "CHIBI_TEST_RECORD_SERVICES", "CHIBI_TEST_SOURCE_ASSETS", "ENKITS_TASK_PRIORITIES_NUM=3"
        ];
    }
    if (target == "chibi_sdk_contracts") {
        return [
            "CHIBI_TEST_NATIVE_RUNTIME=1", "CHIBI_TEST_SOURCE_FEATURES=1", "CHIBI_TEST_SOURCE_RUNTIME=1"
        ];
    }
    if (target == "chibi_native_consumer") {
        return [
            "CHIBI_SOURCE_ROOT=\"{source_root}\"", "CHIBI_TEST_NATIVE_RUNTIME=1",
            "CHIBI_TEST_PREPARATION=1"
        ];
    }
    if (target == "chibi_ui_document_consumer") {
        return ["_DARWIN_C_SOURCE", "_DEFAULT_SOURCE", "_POSIX_C_SOURCE=200809L"];
    }
    if (target == "chibi_image_preparation_consumer") {
        return ["_DARWIN_C_SOURCE", "_DEFAULT_SOURCE", "_POSIX_C_SOURCE=200809L"];
    }
    if (target == "chibi_source_features_consumer") {
        return [
            "CF_RUNTIME_SHADER_COMPILATION", "CF_STATIC", "CHIBI_SOURCE_ROOT=\"{source_root}\"",
            "IMGUI_USE_WCHAR32", "ImDrawIdx=unsigned int"
        ];
    }
    if (target == "test_tools") {
        return [
            "CF_RUNTIME_SHADER_COMPILATION", "CF_STATIC",
            "CHIBI_POLICY_WORKER_PATH=\"{program:policy_worker}\"",
            "CHIBI_SOURCE_ROOT=\"{source_root}\"", "CHIBI_TEST_ASSET_VALUES=1",
            "CHIBI_TEST_AUDIO_ANALYSIS=1", "CHIBI_TEST_AUTHORING_DOCUMENTS=1", "CHIBI_TEST_BOX3D=1",
            "CHIBI_TEST_BUILD_PROCESS=1", "CHIBI_TEST_COMPILER_ARTIFACT=1", "CHIBI_TEST_C_EXPORT=1",
            "CHIBI_TEST_FMT=1", "CHIBI_TEST_IMAGE_PREPARATION=1", "CHIBI_TEST_MATERIAL_RUNTIME=1", "CHIBI_TEST_NATIVE_RUNTIME=1",
            "CHIBI_TEST_PARTICLES=1", "CHIBI_TEST_PNG_ENCODING=1", "CHIBI_TEST_PREVIEW=1",
            "CHIBI_TEST_PREVIEW_COMPONENTS=1", "CHIBI_TEST_PROGRAM=1",
            "CHIBI_TEST_SCENE_SNAPSHOT_READ=1",
            "CHIBI_TEST_SHADER_BAKE=1", "CHIBI_TEST_SOURCE_FEATURES=1",
            "CHIBI_TEST_SOURCE_RUNTIME=1", "CHIBI_TEST_TILEMAP=1", "CHIBI_TEST_UI_DOCUMENT=1",
            "IMGUI_USE_WCHAR32", "ImDrawIdx=unsigned int", "_DARWIN_C_SOURCE", "_DEFAULT_SOURCE",
            "_POSIX_C_SOURCE=200809L"
        ];
    }
    return [];
}

// Options a target adds after the profile's flags. The graph drives Clang
// and GCC, which both take them: fields and math keep floating-point
// contraction off so their results match on every backend, vendored C
// compiles without warnings, and on Linux execution puts each function and
// object in its own section, so the compiler host's link can discard the
// prepared writer it does not call.
pub Options :: (target: string) -> string[] {
    if (target == "chibi_program_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_fields") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_fmt") {
        return ["-w"];
    }
    if (target == "chibi_json") {
        return ["-w"];
    }
    if (target == "chibi_execution" && os.Platform() == "Linux") {
        return ["-ffunction-sections", "-fdata-sections"];
    }
    if (target == "chibi_math_capabilities") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_material_runtime") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_engine") {
        return ["-ffp-contract=off"];
    }
    if (target == "test_host") {
        return ["-UNDEBUG"];
    }
    if (target == "concurrent_runner") {
        return ["-UNDEBUG"];
    }
    if (target == "policy_worker") {
        return ["-UNDEBUG"];
    }
    if (target == "test_language") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_asset_compiler_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "test_behavior_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_sdk_contracts") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_scene_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_shader_bake_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_native_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_asset_values_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_ui_document_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_particle_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_image_preparation_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_source_runtime_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_source_features_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "test_tools") {
        return ["-UNDEBUG"];
    }
    return [];
}

// Options one source adds after its target's, as CMake's COMPILE_OPTIONS
// source property adds them: the transform and particle kernels keep
// floating-point contraction off, as fields does, and generated parsers
// compile without warnings.
pub SourceOptions :: (target: string, file: string) -> string[] {
    if (target == "chibi_spatial_runtime" && file == "src/runtime/visual_transform.c") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_spatial_runtime" && file == "src/runtime/transform_propagation.c") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_particle_runtime" && file == "src/runtime/particles.c") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_language_syntax" && file == "src/language/src/parser.c") {
        return ["-w"];
    }
    return [];
}

// The language tests' sources that include private headers below src/, as
// test/language/CMakeLists.txt gives them.
LanguageTestsOverSource :: () -> string[] {
    return [
        "src/host/process.c", "src/host/native_libraries.c", "src/host/stack_overflow.c",
        "src/toolchain/compiler_artifact.c", "src/toolchain/compiler_host.c",
        "src/toolchain/compiler_json.c", "src/toolchain/compiler_syntax.c",
        "src/toolchain/compiler_target.c", "test/language/argument_effects_chibi.c",
        "test/language/bounded_compiler_chibi.c",
        "test/language/capture.c",
        "test/language/compiler_artifact_chibi.c",
        "test/language/component_write_ir.c",
        "test/language/execution.c", "test/language/execution_scope.c",
        "test/language/integer_semantics.c", "test/language/host_packages_compiler.c",
        "test/language/native_census.c",

        "test/language/package_compiler_chibi.c",


        "test/language/package_snapshot_chibi.c", "test/language/package_syntax.c",
        "test/language/package_syntax_chibi.c",
        "test/language/ranges.c",
        "test/language/record_prepared.c",
        "test/language/compositional_records.c",



        "test/language/type_relations_chibi.c",
        "test/language/unit_algebra_chibi.c"

    ];
}

// Defines one source adds after its target's, as CMake's COMPILE_DEFINITIONS
// source property adds them; Expand fills {source_root}, {build_type},
// {sha256:PATH} and {program:NAME}.
pub SourceDefines :: (target: string, file: string) -> string[] {
    if (target == "test_language" && file == "test/language/package_math.c") {
        return ["CHIBI_CORE_MATH_ROOT=\"{source_root}/packages/core/math\"", "CHIBI_SOURCE_ROOT=\"{source_root}\""];
    }
    if (target == "test_language" && file == "test/language/package_compiler_chibi.c") {
        return ["CHIBI_CORE_MATH_ROOT=\"{source_root}/packages/core/math\""];
    }
    if (target == "test_language" &&
        (file == || file == "test/language/asset_packaging_chibi.c" ||
         file == "test/language/integer_semantics.c" || file == "test/language/host_packages_compiler.c")) {
        return ["CHIBI_SOURCE_ROOT=\"{source_root}\""];
    }
    return [];
}

// Include directories one source adds before its target's, as CMake's
// INCLUDE_DIRECTORIES source property adds them: test_tools' C export cases
// the testing headers.
pub SourceIncludes :: (target: string, file: string) -> string[] {
    if (target == "test_language" && Listed(LanguageTestsOverSource(), file)) {
        return ["src"];
    }
    return [];
}

// The C++ standard a target's C++ sources compile with, its CMake
// CXX_STANDARD with GNU extensions, or empty for none: the UI host, over RmlUi,
// declares C++17.
pub CxxStandard :: (target: string) -> string {
    return "";
}

// The name a target's headers are staged under, its CMake EXPORT_NAME when
// that is not the target's name without chibi_, and the target an export
// name stages.
pub ExportName :: (target: string) -> string {
    return "";
}
pub ExportTarget :: (component: string) -> string {
    return Join(["chibi_", component]);
}

// Whether names hold name.
Listed :: (names: string[], name: string) -> bool {
    for (listed in names) {
        if (listed == name) {
            return true;
        }
    }
    return false;
}

// Headers a header set configures below its private root, `HEADER=INPUT`, as
// CMake's configure_file writes them: a `.in` INPUT with its Substitutions,
// any other copied. The language tests embed the Chibi sources they compile;
// the tooling tests copy the fixtures their consumers include.
pub Configures :: (target: string) -> string[] {
    if (target == "chibi_language_testing") {
        return [
            "third_party/pico_headers/pico_unit.h=third_party/pico_headers/pico_unit.h",
            "test/prepared_fixture.h=test/prepared_fixture.h",
            "test/parallel.h=test/parallel.h",
            "package_core_source.h=test/language/package_core_source.h.in",
            "core_strings_tests_source.h=test/language/core_strings_tests_source.h.in",
            "host_packages_source.h=test/language/host_packages_source.h.in",
            "portable_asset_source.h=test/language/portable_asset_source.h.in",
            "package_portable_source.h=test/language/package_portable_source.h.in",
            "package_portable_consumer.h=test/language/package_portable_consumer.h.in",
            "integer_arithmetic_source.h=test/language/integer_arithmetic_source.h.in",
            "package_graph_chibi_source.h=test/language/package_graph_chibi_source.h.in",
            "syntax_chibi_source.h=test/language/syntax_chibi_source.h.in",
            "source_tokenizer_chibi_source.h=test/language/source_tokenizer_chibi_source.h.in",
            "package_syntax_chibi_source.h=test/language/package_syntax_chibi_source.h.in",
            "package_paths_chibi_source.h=test/language/package_paths_chibi_source.h.in",
            "package_routes_chibi_source.h=test/language/package_routes_chibi_source.h.in",
            "package_snapshot_chibi_source.h=test/language/package_snapshot_chibi_source.h.in",
            "constant_proof_chibi_source.h=test/language/constant_proof_chibi_source.h.in",
            "constant_scalar_chibi_source.h=test/language/constant_scalar_chibi_source.h.in",
            "shader_source_chibi_source.h=test/language/shader_source_chibi_source.h.in",
            "asset_packaging_chibi_source.h=test/language/asset_packaging_chibi_source.h.in",
            "scalar_lowering_chibi_source.h=test/language/scalar_lowering_chibi_source.h.in",
            "lexical_binding_chibi_source.h=test/language/lexical_binding_chibi_source.h.in",
            "nominal_binding_chibi_source.h=test/language/nominal_binding_chibi_source.h.in",
            "named_binding_chibi_source.h=test/language/named_binding_chibi_source.h.in",
            "type_constructors_chibi_source.h=test/language/type_constructors_chibi_source.h.in",
            "type_relations_chibi_source.h=test/language/type_relations_chibi_source.h.in",
            "unit_algebra_chibi_source.h=test/language/unit_algebra_chibi_source.h.in",
            "signature_reader_chibi_source.h=test/language/signature_reader_chibi_source.h.in",
            "callable_headers_chibi_source.h=test/language/callable_headers_chibi_source.h.in",
            "unit_analysis_chibi_source.h=test/language/unit_analysis_chibi_source.h.in",
            "union_members_chibi_source.h=test/language/union_members_chibi_source.h.in",
            "effect_analysis_chibi_source.h=test/language/effect_analysis_chibi_source.h.in",
            "record_members_chibi_source.h=test/language/record_members_chibi_source.h.in",
            "compositional_records_source.h=test/language/compositional_records_source.h.in",
            "build_workflow_source.h=test/language/build_workflow_source.h.in",
            "bounded_compiler_chibi_source.h=test/language/bounded_compiler_chibi_source.h.in",
            "prepared_writer_chibi_source.h=test/language/prepared_writer_chibi_source.h.in",
            "package_compiler_chibi_source.h=test/language/package_compiler_chibi_source.h.in"
        ];
    }
    if (target == "chibi_tools_testing") {
        return [
            "third_party/pico_headers/pico_unit.h=third_party/pico_headers/pico_unit.h",
            "test/prepared_fixture.h=test/prepared_fixture.h",
            "test/tools/fixture.h=test/tools/fixture.h",
            "test/support/reflected_types.h=test/support/reflected_types.h",
            "export_compiler.h=test/tools/export_compiler.h.in"
        ];
    }
    return [];
}

// The values of a target's `@NAME@` placeholders, `NAME=KIND:VALUE`: `bytes:PATH`
// as CMake's file(READ ... HEX) initializer, `cstring:PATH` as C string lines,
// and `compiler:ARGUMENT` as C string initializer lines of the profile's C
// compiler, its C flags and then ARGUMENT, as test/tools writes the compiler
// its exported C builds with. `test-sources:PREFIX:PACKAGE:DIR` and
// `test-inputs:PREFIX:PACKAGE:DIR` discover a test package's direct .chibi files.
pub Substitutions :: (target: string) -> string[] {
    if (target == "chibi_language_testing") {
        return [
            "CHIBI_ASSET_PACKAGING_BYTES=bytes:tools/compiler/asset_packaging/Packaging.chibi",
            "CHIBI_PORTABLE_ASSET_BYTES=bytes:test/fixtures/portable-byte-asset/Build.chibi",
            "CHIBI_ASSET_GENERATOR_BYTES=bytes:tools/graph/asset_compiler/Generate.chibi",
            "CHIBI_ANALYSIS_STATE_BYTES=bytes:tools/compiler/analysis_state/State.chibi",
            "CHIBI_BOUNDED_COMPILE_BYTES=bytes:tools/compiler/bounded_compiler/Compile.chibi",
            "CHIBI_BOUNDED_EXPRESSION_BYTES=bytes:tools/compiler/bounded_compiler/Expression.chibi",
            "CHIBI_BOUNDED_PREPARE_BYTES=bytes:tools/compiler/bounded_compiler/Prepare.chibi",
            "CHIBI_CALLABLE_HEADERS_BYTES=bytes:tools/compiler/callable_headers/Headers.chibi",
            "CHIBI_COMPILER_FACTS_BYTES=bytes:tools/compiler/compiler_facts/Facts.chibi",
            "CHIBI_COMPILER_SYNTAX_BYTES=bytes:test/language/native_syntax/Syntax.chibi.txt",
            "CHIBI_CONSTANT_FOLDING_BYTES=bytes:tools/compiler/constant_folding/Fold.chibi",
            "CHIBI_CONSTANT_IR_BYTES=bytes:tools/compiler/constant_ir/IR.chibi",
            "CHIBI_CONSTANT_PROOF_BYTES=bytes:tools/compiler/constant_admissibility/Proof.chibi",
            "CHIBI_CONSTANT_SCALAR_BYTES=bytes:tools/compiler/constant_scalar/Scalar.chibi",
            "CHIBI_CORE_STRINGS_BYTES=bytes:packages/core/strings/Strings.chibi",
            "CHIBI_CORE_STRINGS_TEST_SOURCES=test-sources:CORE_STRINGS_TEST_SOURCE:core_strings:test/core_strings",
            "CHIBI_CORE_STRINGS_TEST_INPUTS=test-inputs:CORE_STRINGS_TEST_SOURCE:core_strings:test/core_strings",
            "CHIBI_CORE_TIME_BYTES=bytes:packages/core/time/Time.chibi",
