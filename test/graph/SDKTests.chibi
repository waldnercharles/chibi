package graph_sdk_tests

import sdk "graph:sdk"
import engine "graph:engine"
import c "graph:c"
import os "core:os"
import strings "core:strings"

// The runtime SDK's manifest JSON, its graph evidence over synthetic records
// and tools, and its installer.

Join :: (parts: string[]) -> string {
    return strings.Join(parts, "");
}

Write :: (path: string, text: string) {
    assert(build.make_directory(strings.Slice(path, 0, strings.LastIndex(path, "/"))));
    assert(build.write_file(path, text));
}

Record :: (command: string[], inputs: string[], output: string) {
    lines := [build.join(command, "\n"), ""];
    recorded := slice(inputs, 0, length(inputs));
    recorded.append(output);
    for (path in recorded) {
        lines.extend([path, build.file_stamp(path)]);
    }
    lines.append("");
    Write(Join([output, ".chibi-record"]), build.join(lines, "\n"));
}

// Evidence fixtures live below the scratch directory Run makes.
Evidence :: () -> string {
    return Join([os.Root(), "/.chibi/graph-sdk/evidence"]);
}

Roots :: () -> string[] {
    root := Evidence();
    return [Join([root, "/source"]), Join([root, "/build"]), Join([root, "/vendor"])];
}

ObjectRecords :: () {
    roots := Roots();
    source := Join([roots[0], "/src/example.c"]);
    header := Join([roots[0], "/src/example.h"]);
    output := Join([roots[1], "/objects/example.o"]);
    Write(source, "source bytes\n");
    Write(header, "header bytes\n");
    Write(output, "synthetic object\n");
    command := ["/fixture/cc", "-DNAME=one two", "", "-o", output, "-c", source];
    inputs := [source, header];
    Record(command, inputs, output);
    proof := sdk.RecordEvidence(roots, command, output, inputs);
    assert(proof != "");
    assert(sdk.JsonGet(proof, "path") == sdk.JsonQuote("@build/objects/example.o"));
    assert(sdk.JsonGet(proof, "sha256") == sdk.JsonQuote(build.hash_file(output)));
    assert(sdk.JsonGet(sdk.JsonGet(proof, "dependencies"), "@source/src/example.c") == sdk.JsonQuote(build.hash_file(source)));
    assert(sdk.JsonGet(sdk.JsonGet(proof, "dependencies"), "@source/src/example.h") == sdk.JsonQuote(build.hash_file(header)));
    normalized := sdk.JsonGet(proof, "arguments");
    assert(sdk.JsonGet(proof, "command_sha256") == sdk.JsonQuote(build.hash_text(normalized)));
    assert(!strings.Contains(proof, roots[0]) && !strings.Contains(proof, roots[1]));
    changed := slice(command, 0, length(command));
    changed[1] = "-DNAME=different";
    assert(sdk.RecordEvidence(roots, changed, output, inputs) == "");
    assert(sdk.RecordEvidence(roots, command, output, [source]) == "");
    assert(sdk.RecordEvidence(roots, command, output, [header, source]) == "");
    assert(sdk.RecordEvidence(roots, command, output, [source, header, header]) == "");
    Write(header, "changed header bytes\n");
    assert(sdk.RecordEvidence(roots, command, output, inputs) == "");
    Record(command, inputs, output);
    assert(sdk.RecordEvidence(roots, command, output, inputs) != "");
    Write(output, "changed object bytes\n");
    assert(sdk.RecordEvidence(roots, command, output, inputs) == "");
    Record(command, inputs, output);
    assert(build.remove(header));
    assert(sdk.RecordEvidence(roots, command, output, inputs) == "");
    Write(header, "header restored\n");
    Record(command, inputs, output);
    assert(build.remove(Join([output, ".chibi-record"])));
    assert(sdk.RecordEvidence(roots, command, output, inputs) == "");
    Record(command, inputs, output);
    assert(build.remove(output));
    assert(sdk.RecordEvidence(roots, command, output, inputs) == "");
    Write(output, "restored synthetic object\n");
    Record(command, inputs, output);
    for (bad in ["NUL\u0000argument", "line\nargument", "line\rargument"]) {
        invalid := slice(command, 0, length(command));
        invalid[1] = bad;
        Record(invalid, inputs, output);
        assert(sdk.RecordEvidence(roots, invalid, output, inputs) == "");
    }
    Record(command, inputs, output);
    assert(sdk.RecordEvidence([roots[0], "", roots[2]], command, output, inputs) == "");
    assert(sdk.RecordEvidence([roots[0], Join([roots[1], "-sibling"]), roots[2]], command, output, inputs) == "");
    duplicates := [source, header, header];
    Record(command, duplicates, output);
    proof = sdk.RecordEvidence(roots, command, output, duplicates);
    assert(proof != "" && length(sdk.JsonFields(sdk.JsonGet(proof, "dependencies"))) == 2);
}

ArchiveAndLinkRecords :: () {
    roots := Roots();
    first := Join([roots[1], "/objects/first.o"]);
    second := Join([roots[1], "/objects/second.o"]);
    archive := Join([roots[1], "/lib/libexample.a"]);
    vendor := Join([roots[2], "/lib/libvendor.a"]);
    player := Join([roots[1], "/sdk/chibi-player"]);
    for (path in [first, second, archive, vendor, player]) {
        Write(path, "synthetic artifact\n");
    }
    archived := ["/fixture/ar", "qc", archive, first, second];
    Record(archived, [first, second], archive);
    assert(sdk.RecordEvidence(roots, archived, archive, [first, second]) != "");
    assert(sdk.RecordEvidence(roots, archived, archive, [first]) == "");
    assert(sdk.RecordEvidence(roots, ["/fixture/ar", "qc", archive, second, first], archive, [first, second]) == "");
    linked := ["/fixture/c++", first, "-o", player, archive, vendor, vendor];
    inputs := [first, archive, vendor, vendor];
    Record(linked, inputs, player);
    proof := sdk.RecordEvidence(roots, linked, player, inputs);
    assert(proof != "");
    assert(length(sdk.JsonFields(sdk.JsonGet(proof, "dependencies"))) == 3);
    assert(sdk.JsonGet(sdk.JsonGet(proof, "dependencies"), "@vendor/lib/libvendor.a") == sdk.JsonQuote(build.hash_file(vendor)));
    assert(sdk.RecordEvidence(roots, linked, player, [first, archive]) == "");
    Write(archive, "changed archive bytes\n");
    assert(sdk.RecordEvidence(roots, linked, player, inputs) == "");
}

FixtureProfile :: (vendor: string) -> engine.Profile {
    return {
        compiler: "", cxx_compiler: "", compiler_id: "Clang", build_type: "Debug", debug_optimization: "",
        debug_frame_pointers: false, architecture: "x86_64", sysroot: "", warnings: true, sanitizers: "",
        debug_compilation_dir: "", libclang_include: "", opengl_library: "", opengl_include: "", glx_library: "",
        libclang_library: "", clang_resource_include: "", third_party: vendor, reflect: "", asset_generator_hosts: ""
    };
}

ToolPreflight :: () {
    roots := Roots();
    root := Evidence();
    compiler := Join([root, "/fake-compiler"]);
    script := "#!/bin/sh\ncase \"$1\" in\n--version) printf 'Fixture clang version 18.1\\n' ;;\n-dumpmachine) printf 'x86_64-apple-darwin\\n' ;;\n*) printf '#define __SIZEOF_POINTER__ 8\\n#define __BYTE_ORDER__ __ORDER_LITTLE_ENDIAN__\\n#define __ORDER_LITTLE_ENDIAN__ 1234\\n#define __x86_64__ 1\\n' ;;\nesac\n";
    Write(compiler, script);
    assert(build.run(["chmod", "+x", compiler]) == 0);
    tools: c.Tools = {launcher: "", compiler: compiler, cxx_compiler: compiler, archiver: compiler, ranlib: compiler, jobs: 2};
    profile := FixtureProfile(roots[2]);
    profile.compiler = compiler;
    profile.cxx_compiler = compiler;
    selected := Join([roots[1], "/objects/chibi_support/src/support/arena.c.o.chibi-record"]);
    unrelated := Join([roots[1], "/objects/unselected/keep.chibi-record"]);
    object := strings.TrimSuffix(selected, ".chibi-record");
    Write(selected, "old selected record");
    Write(object, "selected output stays");
    Write(unrelated, "unrelated record stays");
    assert(sdk.PrepareBuildConfiguration(roots[1], profile, tools));
    assert(!build.file_exists(selected) && build.read_file(object) == "selected output stays");
    assert(build.read_file(unrelated) == "unrelated record stays");
    pending := Join([roots[1], "/sdk/runtime-build-pending.json"]);
    configuration := Join([roots[1], "/sdk/runtime-build.json"]);
    assert(build.file_kind(pending) == "file");
    assert(sdk.WriteBuildConfiguration(roots[1], profile, tools));
    assert(!build.file_exists(pending));
    saved := sdk.JsonCanonical(build.read_file(configuration));
    assert(sdk.JsonGet(saved, "pointer_bits") == "64");
    assert(sdk.JsonText(sdk.JsonGet(saved, "processor")) == "x86_64");
    assert(sdk.JsonText(sdk.JsonGet(saved, "compiler_version")) == "Fixture clang version 18.1");
    assert(sdk.JsonText(sdk.JsonGet(saved, "compiler_version_format")) == "raw-banner");
    assert(sdk.JsonText(sdk.JsonGet(saved, "compiler_default_target")) == "x86_64-apple-darwin");
    Write(selected, "warm selected record");
    assert(sdk.PrepareBuildConfiguration(roots[1], profile, tools));
    assert(build.read_file(selected) == "warm selected record");
    Write(compiler, Join([script, "# compiler changed during construction\n"]));
    assert(build.run(["chmod", "+x", compiler]) == 0);
    assert(!sdk.WriteBuildConfiguration(roots[1], profile, tools));
    assert(build.file_exists(pending) && sdk.JsonCanonical(build.read_file(configuration)) == saved);
    assert(sdk.GraphEvidence(roots[0], roots[1], roots[2]) == "");
    assert(sdk.PrepareBuildConfiguration(roots[1], profile, tools));
    assert(!build.file_exists(selected) && !build.file_exists(configuration));
    assert(sdk.WriteBuildConfiguration(roots[1], profile, tools));
    assert(!build.file_exists(pending));
    saved = sdk.JsonCanonical(build.read_file(configuration));
    profile.architecture = "arm64";
    assert(sdk.PrepareBuildConfiguration(roots[1], profile, tools));
    assert(!sdk.WriteBuildConfiguration(roots[1], profile, tools));
    assert(sdk.JsonCanonical(build.read_file(configuration)) == saved && build.file_exists(pending));
    profile.architecture = "x86_64";
    profile.reflect = compiler;
    assert(sdk.PrepareBuildConfiguration(roots[1], profile, tools));
    assert(sdk.WriteBuildConfiguration(roots[1], profile, tools));
    saved = sdk.JsonCanonical(build.read_file(configuration));
    assert(sdk.JsonGet(sdk.JsonGet(saved, "tool_identities"), "reflect") != "");
    tools.cxx_compiler = Join([root, "/missing-compiler"]);
    assert(!sdk.PrepareBuildConfiguration(roots[1], profile, tools));
}

CanonicalManifest :: () {
    pretty := " {\n \"products\": { \"chibi-player\": \"bin/chibi-player\" },\n \"build_id\": \"old\", \"files\": {}, \"manifest_format\": 1, \"kind\": \"runtime\"\n}\n";
    expected := "{\"build_id\":\"old\",\"files\":{},\"kind\":\"runtime\",\"manifest_format\":1,\"products\":{\"chibi-player\":\"bin/chibi-player\"}}";
    assert(sdk.JsonCanonical(pretty) == expected);
    assert(sdk.JsonGet(pretty, "products") == "{\"chibi-player\":\"bin/chibi-player\"}");
    assert(sdk.JsonGet(pretty, "missing") == "");
    assert(sdk.JsonWithout(pretty, "build_id") == "{\"files\":{},\"kind\":\"runtime\",\"manifest_format\":1,\"products\":{\"chibi-player\":\"bin/chibi-player\"}}");
    assert(sdk.JsonWithout(pretty, "missing") == expected);
    keys := sdk.JsonKeys(pretty);
    assert(length(keys) == 5 && keys[0] == "build_id" && keys[4] == "products");
    assert(sdk.JsonObject(["z", "a"], [" [ true, null, -0 ] ", "\"value\""]) == "{\"a\":\"value\",\"z\":[true,null,0]}");
    assert(sdk.JsonArray([" 2 ", "{\"b\":false,\"a\":null}"]) == "[2,{\"a\":null,\"b\":false}]");
    items := sdk.JsonItems(" [ -0, {\"z\":2, \"a\":1}, \"\\u00e9\" ] ");
    assert(length(items) == 3 && items[0] == "0" && items[1] == "{\"a\":1,\"z\":2}" && items[2] == "\"\\u00e9\"");
    assert(sdk.JsonCanonical(sdk.JsonWithout(pretty, "build_id")) == sdk.JsonWithout(pretty, "build_id"));
}

CanonicalUnicode :: () {
    assert(sdk.JsonQuote("é😀\"\\/\n\t\r") == "\"\\u00e9\\ud83d\\ude00\\\"\\\\/\\n\\t\\r\"");
    assert(sdk.JsonCanonical("\"\\uD83D\\uDE00\\/\\u0061\"") == "\"\\ud83d\\ude00/a\"");
    assert(sdk.JsonText("\"\\ud83d\\ude00\\u00e9\"") == "😀é");
    assert(sdk.JsonCanonical("{\"𐀀\":1,\"\":2,\"é\":3,\"a\":4}") == "{\"a\":4,\"\\u00e9\":3,\"\\ue000\":2,\"\\ud800\\udc00\":1}");
    nul := sdk.JsonText("\"a\\u0000b\"");
    assert(strings.ByteLength(nul) == 3 && strings.ByteAt(nul, 1) == 0);
    assert(sdk.JsonQuote(nul) == "\"a\\u0000b\"");
    assert(sdk.JsonQuote(format_text("{:c}", int(127))) == "\"\\u007f\"");
    controls := format_text("{:c}{:c}{:c}", int(8), int(12), int(31));
    assert(sdk.JsonQuote(controls) == "\"\\b\\f\\u001f\"");
    assert(sdk.JsonCanonical("{\"\\u0061\":1,\"a\":2}") == "");
    assert(sdk.JsonCanonical("{\"é\":1,\"\\u00e9\":2}") == "");
}

CanonicalRejectsMalformed :: () {
    invalid := ["", " ", "+1", "01", "-01", "-", "1.0", "1e2", "NaN", "Infinity", "true false",
                "9223372036854775808", "-9223372036854775809", "[1,]", "[,1]", "[1 2]", "{\"a\":1,}",
                "{\"a\":1 \"b\":2}", "{\"a\"}", "{1:2}", "{\"a\":1,\"a\":2}", "[{\"a\":1,\"a\":2}]",
                "\"unterminated", "\"\\q\"", "\"\\u12x4\"", "\"\\u123\"", "\"\\ud800\"", "\"\\udc00\"",
                "\"\\ud800x\"", "\"\\ud800\\u0041\"", "\"\\ud800\\ud800\"", "\"raw\nline\"", "\"a\"suffix"];
    for (text in invalid) {
        assert(sdk.JsonCanonical(text) == "");
    }
    invalid_utf8 := [format_text("{:c}", int(128)), format_text("{:c}{:c}", int(192), int(128)),
                     format_text("{:c}{:c}{:c}", int(224), int(128), int(128)), format_text("{:c}{:c}{:c}", int(237), int(160), int(128)),
                     format_text("{:c}{:c}{:c}{:c}", int(244), int(144), int(128), int(128)), format_text("{:c}{:c}", int(226), int(130))];
    for (text in invalid_utf8) {
        assert(sdk.JsonQuote(text) == "");
        assert(sdk.JsonCanonical(format_text("\"{}\"", text)) == "");
    }
    assert(sdk.JsonCanonical("-0") == "0");
    assert(sdk.JsonCanonical("9223372036854775807") == "9223372036854775807");
    assert(sdk.JsonCanonical("-9223372036854775808") == "-9223372036854775808");
    assert(sdk.JsonObject(["same", "same"], ["1", "2"]) == "");
    assert(sdk.JsonObject(["missing"], []) == "");
    assert(sdk.JsonObject(["invalid"], ["1.2"]) == "");
    assert(sdk.JsonObject([format_text("{:c}", int(128))], ["1"]) == "");
    assert(sdk.JsonArray(["false", "["]) == "");
    assert(sdk.JsonGet("[]", "a") == "" && length(sdk.JsonKeys("[]")) == 0);
    assert(length(sdk.JsonItems("{}")) == 0 && sdk.JsonWithout("[]", "a") == "");
    assert(sdk.JsonText("true") == "" && sdk.JsonText("\"\"") == "");
}

CanonicalFields :: () {
    fields := sdk.JsonFields(" {\"\\u00e9\": {\"z\":-0,\"a\":[true,\"😀\"]}, \"\\u0061\":null, \"😀\":\"\\u0000\"} ");
    assert(length(fields) == 3);
    assert(fields[0].key == "a" && fields[0].value == "null");
    assert(fields[1].key == "é" && fields[1].value == "{\"a\":[true,\"\\ud83d\\ude00\"],\"z\":0}");
    assert(fields[2].key == "😀" && fields[2].value == "\"\\u0000\"");
    assert(length(sdk.JsonFields("{}")) == 0 && length(sdk.JsonFields("[]")) == 0);
    for (invalid in ["", "{", "{\"a\"}", "{\"a\":}", "{\"a\":1,}", "{\"a\":1}x", "{\"a\":1,\"\\u0061\":2}", "{\"a\":{\"b\":1,\"b\":2}}", "{\"a\":1.0}"]) {
        assert(length(sdk.JsonFields(invalid)) == 0);
    }
}

CanonicalDepth :: () {
    text := "0";
    for (index in 0..<127) {
        text = format_text("[{}]", text);
    }
    assert(sdk.JsonCanonical(text) == text);
    assert(sdk.JsonCanonical(format_text("[{}]", text)) == "");
    assert(sdk.JsonArray([text]) == "");
    assert(sdk.JsonObject(["deep"], [text]) == "");
    assert(length(sdk.JsonFields(format_text("{{\"deep\":{}}}", text))) == 0);
}

// Expected bytes come from Python json.dumps(sort_keys=True,
// separators=(',', ':'), ensure_ascii=True) over the decoded input.
PythonVectors :: () {
    inputs := [
        " {\n \"b\" : [1, 2,{\"z\":null,\"a\":true}] , \"a\":\"x\" }\n",
        "{\"k\":\"café 雪 😀 \\u007f \\u0001 \\\" \\\\ \\/ \\b\\f\\n\\r\\t\"}",
        "{\"é\":1,\"e\":2,\"😀\":3,\"￿\":4}",
        "[-0, 0, -1, 9223372036854775807, -9223372036854775808]",
        "\"é😀\\u007f\"",
        "{}",
        "[]",
        "null",
        "true",
        "false",
        "[[[[]]], {\"a\":{\"b\":{\"c\":[]}}}]",
        "{\"a\":1,\"A\":2,\"_\":3,\"0\":4}",
        "  [ 1 , \"two\" , [ 3 ] ]  "
    ];
    expected := [
        "{\"a\":\"x\",\"b\":[1,2,{\"a\":true,\"z\":null}]}",
        "{\"k\":\"caf\\u00e9 \\u96ea \\ud83d\\ude00 \\u007f \\u0001 \\\" \\\\ / \\b\\f\\n\\r\\t\"}",
        "{\"e\":2,\"\\u00e9\":1,\"\\uffff\":4,\"\\ud83d\\ude00\":3}",
        "[0,0,-1,9223372036854775807,-9223372036854775808]",
        "\"\\u00e9\\ud83d\\ude00\\u007f\"",
        "{}",
        "[]",
        "null",
        "true",
        "false",
        "[[[[]]],{\"a\":{\"b\":{\"c\":[]}}}]",
        "{\"0\":4,\"A\":2,\"_\":3,\"a\":1}",
        "[1,\"two\",[3]]"
    ];
    for (index in 0..<length(inputs)) {
        assert(sdk.JsonCanonical(inputs[index]) == expected[index]);
    }
}

InstallFixture :: (prefix: string, marker: string) -> string {
    if (!build.make_directory(Join([prefix, "/bin"])) ||
        !build.make_directory(Join([prefix, "/share/chibi"])) ||
        !build.copy_file(build.find_executable("true"), Join([prefix, "/bin/chibi-player"])) ||
        !build.write_file(Join([prefix, "/marker"]), marker)) {
        return "";
    }
    id := sdk.JsonQuote(build.hash_text(marker));
    formats := "{\"execution\":{\"version\":1}}";
    engine := sdk.JsonObject(["project_version", "build_id", "artifact_formats"], ["1", id, formats]);
    if (!build.write_file(Join([prefix, "/share/chibi/engine.json"]), engine)) {
        return "";
    }
    targets: string[] = [];
    for (name in sdk.RuntimeTargets()) {
        targets.append(sdk.JsonQuote(Join(["Chibi::", name])));
    }
    requirements := sdk.JsonObject(["project_format", "artifact_formats", "system", "pointer_bits"],
                                   ["1", formats, sdk.JsonQuote(build.platform()), "64"]);
    manifest := sdk.JsonObject(["manifest_format", "kind", "package_version", "engine", "files",
                                "products", "targets", "requirements"], ["1", sdk.JsonQuote("runtime"), sdk.JsonQuote("0.1.0"),
                                                                         sdk.JsonObject(["manifest", "build_id"], [sdk.JsonQuote("share/chibi/engine.json"), id]),
                                                                         sdk.RuntimeFiles(prefix, ""), "{\"chibi-player\":\"bin/chibi-player\"}", sdk.JsonArray(targets), requirements]);
    manifest = sdk.RuntimeExtend(manifest, ["build_id"], [sdk.JsonQuote(build.hash_text(manifest))]);
    if (!build.write_file(Join([prefix, "/share/chibi/package.json"]), manifest)) {
        return "";
    }
    return manifest;
}

// The installer's paths, inventory, replacement, rollback and competing
// output. These are small filesystem and package boundaries; they construct
// no engine library or SDK product.
InstallReplacesAndRollsBack :: (work: string) {
    assert(sdk.RuntimePath("include/chibi/café/雪.h") && !sdk.RuntimePath("../outside") && !sdk.RuntimePath("/absolute") &&
           !sdk.RuntimePath("a//b") && !sdk.RuntimePath("a/./b") && !sdk.RuntimePath("a\\b"), "the package path contract");
    original := Join([work, "/original"]);
    previous := InstallFixture(original, "first");
    assert(previous != "" && sdk.RuntimeVerify(original) == previous, "a valid package");
    assert(build.write_file(Join([original, "/marker"]), "changed") && sdk.RuntimeVerify(original) == "", "changed installed bytes are rejected");
    assert(sdk.RuntimeAssemble(build.root(), Join([work, "/missing-build"]), Join([work, "/missing-vendor"]), original) == 2 &&
           build.read_file(Join([original, "/marker"])) == "changed", "an invalid prior package is not overwritten");
    previous = InstallFixture(original, "restored");
    rollback := Join([work, "/rollback"]);
    assert(build.reserve_directory(rollback), "the rollback stage");
    assert(!sdk.RuntimePublish(rollback, original, previous) && sdk.RuntimeVerify(original) == previous &&
           build.file_kind(rollback) == "", "a failed publication restores the prior package");
    stale := Join([work, "/stale-preimage"]);
    competing := InstallFixture(original, "concurrent generation");
    assert(build.reserve_directory(stale) && InstallFixture(Join([stale, "/package"]), "unpublished") != "", "the stale stage");
    assert(!sdk.RuntimePublish(stale, original, previous) && sdk.RuntimeVerify(original) == competing &&
           build.file_kind(stale) == "", "a changed prior generation is kept");
    previous = competing;
    replacement := Join([work, "/replacement"]);
    assert(build.reserve_directory(replacement), "the replacement stage");
    next := InstallFixture(Join([replacement, "/package"]), "second");
    assert(next != previous && sdk.RuntimePublish(replacement, original, previous) &&
           sdk.RuntimeVerify(original) == next && build.file_kind(replacement) == "", "a managed replacement");
    occupied := Join([work, "/occupied"]);
    fresh := Join([work, "/fresh"]);
    assert(build.make_directory(occupied) && build.write_file(Join([occupied, "/unrelated"]), "keep") &&
           build.reserve_directory(fresh) && InstallFixture(Join([fresh, "/package"]), "fresh") != "", "a competing prefix");
    assert(!sdk.RuntimePublish(fresh, occupied, "") && build.read_file(Join([occupied, "/unrelated"])) == "keep", "a competing prefix is not overwritten");
    assert(build.run(["ln", "-s", "marker", Join([original, "/link"])]) == 0 && sdk.RuntimeVerify(original) == "", "a package with a link is rejected");
}

// The build host runs this entry. The evidence and installer cases need
// macOS's tools.
pub Run :: () -> int {
    CanonicalManifest();
    CanonicalUnicode();
    CanonicalRejectsMalformed();
    CanonicalFields();
    CanonicalDepth();
    PythonVectors();
    if (os.Platform() != "Darwin") {
        return 0;
    }
    scratch := Join([os.Root(), "/.chibi/graph-sdk"]);
    assert(os.Run(["rm", "-rf", scratch]) == 0 && os.MakeDirectory(Join([scratch, "/install"])) == nil, "the scratch directory");
    ObjectRecords();
    ArchiveAndLinkRecords();
    ToolPreflight();
    InstallReplacesAndRollsBack(Join([scratch, "/install"]));
    assert(os.Run(["rm", "-rf", scratch]) == 0, "the scratch cleanup");
    return 0;
}
