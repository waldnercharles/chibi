package package_compiler

import snapshot "project:source_snapshot"
import graph "project:package_graph"
import syntax "project:syntax_diagnostics"

// Compile-time execution of authored functions. A constant or a callee of one
// may call a function of any package whose parameters and result are integers
// or bool: the body runs on the compiler, with locals, assignment (plain and
// compound), `if`, `while`, `break`, `continue` and `return`. Expressions
// reuse the exact constant evaluator, so arithmetic keeps its range checks and
// a result that does not fit its type is an error, not a wrap. Each
// evaluation has a step budget and a call-depth limit.
CtSteps: int : 65536;
CtDepth: int : 128;

CtResult :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Waiting
    | Value(bits: u64, storage: int)
}
CtFlow :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Waiting
    | Normal
    | Returned(bits: u64, storage: int)
    | Broke
    | Continued
}

// The constant `name` of an activation, its current value.
CtLocal :: (name: string, package: int, file: int, storage: int, bits: u64) -> ConstDecl {
    return {name: name, package: package, storage: storage, bits: bits, node: -1, file: file, folded: true,
            occurrence: 0};
}
// What an expression of an activation reads: its locals, innermost first, the
// calls already evaluated, then the constants.
CtScope :: (constants: ConstDecl[], package: int, file: int, names: string[], bits: u64[], storages: int[],
            memo: ConstDecl[]) -> ConstDecl[] {
    scope: ConstDecl[] = [];
    at := length(names) - 1;
    while (at >= 0) {
        scope.append(CtLocal(names[at], package, file, storages[at], bits[at]));
        at -= 1;
    }
    scope.extend(memo);
    scope.extend(constants);
    return scope;
}
// The memo constant standing for the evaluated call at `node`, -1 for none.
FindMemo :: (constants: ConstDecl[], node: int) -> int {
    index: int = 0;
    while (index < length(constants)) {
        if (constants[index].name == "" && constants[index].node == node) {
            return index;
        }
        index += 1;
    }
    return -1;
}
// The function a call names, in `package` or through an import alias; -1 when
// it names none.
CtCallee :: (forest: snapshot.SnapshotNode[], text: string, links: graph.Binding[], callables: Callable[],
             package: int, file: int, call: int) -> int {
    function := Field(forest, call, syntax.FieldFunction);
    if (Is(forest, function, syntax.Identifier)) {
        return FindCallable(callables, package, Text(forest, text, function));
    }
    if (Is(forest, function, syntax.MemberExpression)) {
        home := QualifierOf(forest, text, Aliases(links, file), package, Field(forest, function, syntax.FieldObject));
        if (home < 0) {
            return -1;
        }
        return FindCallable(callables, home, Text(forest, text, Field(forest, function, syntax.FieldMember)));
    }
    return -1;
}
// Appends the outermost calls of authored functions in the expression `node`:
// a call's own arguments are evaluated with it.
CtCollect :: (forest: snapshot.SnapshotNode[], text: string, links: graph.Binding[], callables: Callable[],
              package: int, file: int, node: int, out: ^(int[])) {
    if (node < 0) {
        return;
    }
    if (Is(forest, node, syntax.CallExpression) && CtCallee(forest, text, links, callables, package, file, node) >= 0) {
        out.append(node);
        return;
    }
    for (child in Members(forest, node)) {
        CtCollect(forest, text, links, callables, package, file, child, out);
    }
}
// Whether `node` is a condition: a comparison, a logical operation, `not`, or
// a boolean literal or local.
CtBoolean :: (forest: snapshot.SnapshotNode[], text: string, scope: ConstDecl[], aliases: Name[], package: int,
              node: int) -> bool {
    value := Unparenthesized(forest, node);
    if (Is(forest, value, syntax.Boolean)) {
        return true;
    }
    named := ConstantOf(forest, text, scope, aliases, package, value);
    if (named >= 0) {
        return scope[named].storage == BoolStorage;
    }
    if (Is(forest, value, syntax.CallExpression)) {
        return Text(forest, text, Field(forest, value, syntax.FieldFunction)) == "not";
    }
    operator := Text(forest, text, Field(forest, value, syntax.FieldOperator));
    if (Is(forest, value, syntax.UnaryExpression)) {
        return operator == "not" || operator == "!";
    }
    if (Is(forest, value, syntax.BinaryExpression)) {
        return ComparisonOperator(operator) || operator == "and" || operator == "&&" || operator == "or" ||
               operator == "||";
    }
    return false;
}
CtFail :: (forest: snapshot.SnapshotNode[], node: int, file: int, message: string) -> syntax.Diagnostic {
    return Diagnose(forest, node, file, message);
}
// The value of the expression `node` in an activation. `want` is the type an
// untyped expression takes, 0 for the default.
CtEval :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], links: graph.Binding[],
           callables: Callable[], params: Param[], constants: ConstDecl[], package: int, file: int,
           names: ^(string[]), bits: ^(u64[]), storages: ^(int[]), steps: ^int, depth: int, node: int,
           want: int) -> CtResult {
    text := documents[file].text;
    memo: ConstDecl[] = [];
    calls: int[] = [];
    CtCollect(forest, text, links, callables, package, file, node, &calls);
    for (call in calls) {
        switch CtCall(forest, documents, links, callables, params, constants, package, file, names, bits, storages,
                      steps, depth, call) {
            case .Failed(diagnostic):
                return CtResult.Failed(diagnostic);
            case .Waiting:
                return CtResult.Waiting;
            case .Value(value, storage):
                placed: ConstDecl = {name: "", package: package, storage: storage, bits: value, node: call,
                                    file: file, folded: true, occurrence: 0};
                memo.append(placed);
        }
    }
    scope := CtScope(constants, package, file, names^, bits^, storages^, memo);
    aliases := Aliases(links, file);
    if (CtBoolean(forest, text, scope, aliases, package, node)) {
        switch FoldCondition(forest, text, file, scope, aliases, package, node) {
            case .Failed(diagnostic):
                return CtResult.Failed(diagnostic);
            case .Waiting:
                return CtResult.Waiting;
            case .Yes:
                return CtResult.Value(1, BoolStorage);
            case .No:
                return CtResult.Value(0, BoolStorage);
        }
    }
    typed := ConstantType(forest, text, scope, aliases, package, node);
    if (typed == 0) {
        typed = want;
    }
    if (typed == 0) {
        typed = IntStorage;
    }
    switch FoldConstant(forest, text, file, scope, aliases, package, node, typed) {
        case .Failed(diagnostic):
            return CtResult.Failed(diagnostic);
        case .Waiting:
            return CtResult.Waiting;
        case .Folded(folded):
            return CtResult.Value(folded, typed);
    }
}
// Calls the function that `call` names with its arguments evaluated here.
CtCall :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], links: graph.Binding[],
           callables: Callable[], params: Param[], constants: ConstDecl[], package: int, file: int,
           names: ^(string[]), bits: ^(u64[]), storages: ^(int[]), steps: ^int, depth: int,
           call: int) -> CtResult {
    callee := CtCallee(forest, documents[file].text, links, callables, package, file, call);
    callable := callables[callee];
    if (callable.count < 0) {
        return CtResult.Failed(CtFail(forest, call, file, "compile-time execution does not call generic functions yet"));
    }
    if (depth >= CtDepth) {
        return CtResult.Failed(CtFail(forest, call, file, "compile-time evaluation exceeded 128 nested calls"));
    }
    arguments := Members(forest, Field(forest, call, syntax.FieldArguments));
    if (length(arguments) != callable.count) {
        return CtResult.Failed(CtFail(forest, call, file, "compile-time call needs every argument"));
    }
    arg_bits: u64[] = [];
    arg_storages: int[] = [];
    index: int = 0;
    while (index < length(arguments)) {
        param := params[callable.first + index];
        if ((!Integer(param.storage) && param.storage != BoolStorage) || param.container != 0 || param.reference ||
            Is(forest, arguments[index], syntax.NamedArgument)) {
            return CtResult.Failed(CtFail(forest, arguments[index], file,
                                          "compile-time calls take integer and bool arguments by position"));
        }
        switch CtEval(forest, documents, links, callables, params, constants, package, file, names, bits, storages,
                      steps, depth, arguments[index], param.storage) {
            case .Failed(diagnostic):
                return CtResult.Failed(diagnostic);
            case .Waiting:
                return CtResult.Waiting;
            case .Value(value, storage):
                if (storage != param.storage && !Widens(storage, param.storage)) {
                    return CtResult.Failed(CtFail(forest, arguments[index], file,
                                                  format_text("Mismatched integer types {} and {}; convert one operand",
                                                              TypeName(storage), TypeName(param.storage))));
                }
                arg_bits.append(CtWidened(value, storage, param.storage));
                arg_storages.append(param.storage);
        }
        index += 1;
    }
    return CtRun(forest, documents, links, callables, params, constants, callee, arg_bits, arg_storages, steps,
                 depth + 1);
}
// `value` of type `from` as a value of the wider type `to`.
CtWidened :: (value: u64, from: int, to: int) -> u64 {
    return ExactWrapped(ExactStored(value, from), to);
}
// Runs function `callee` with its arguments.
CtRun :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], links: graph.Binding[],
          callables: Callable[], params: Param[], constants: ConstDecl[], callee: int, arg_bits: u64[],
          arg_storages: int[], steps: ^int, depth: int) -> CtResult {
    callable := callables[callee];
    file := callable.document;
    if (callable.result == 0 || (!Integer(callable.result) && callable.result != BoolStorage) ||
        callable.result_container != 0 || callable.results != 0) {
        return CtResult.Failed(CtFail(forest, callable.node, file,
                                      "compile-time execution needs a function with one integer or bool result"));
    }
    names: string[] = [];
    index: int = 0;
    while (index < callable.count) {
        names.append(params[callable.first + index].name);
        index += 1;
    }
    bits := arg_bits;
    storages := arg_storages;
    body := Field(forest, callable.node, syntax.FieldBody);
    switch CtBlock(forest, documents, links, callables, params, constants, callable.package, file, &names, &bits,
                   &storages, steps, depth, callable.result, Members(forest, body)) {
        case .Failed(diagnostic):
            return CtResult.Failed(diagnostic);
        case .Waiting:
            return CtResult.Waiting;
        case .Returned(value, storage):
            return CtResult.Value(value, storage);
        case .Normal:
            return CtResult.Failed(CtFail(forest, callable.node, file, "a compile-time function must return a value"));
        case .Broke:
            return CtResult.Failed(CtFail(forest, callable.node, file, "break outside a loop"));
        case .Continued:
            return CtResult.Failed(CtFail(forest, callable.node, file, "continue outside a loop"));
    }
}
// The index of local `name`, the newest first; -1 for none.
CtLookup :: (names: string[], name: string) -> int {
    at := length(names) - 1;
    while (at >= 0) {
        if (names[at] == name) {
            return at;
        }
        at -= 1;
    }
    return -1;
}
// `left op right` over exact values of type `storage`.
CtApply :: (operator: string, left: u64[], right: u64[]) -> u64[] {
    if (operator == "+") {
        return ExactAdd(left, right);
    }
    if (operator == "-") {
        return ExactSubtract(left, right);
    }
    if (operator == "*") {
        return ExactMultiply(left, right);
    }
    if (operator == "/" || operator == "%") {
        return ExactDivide(left, right, operator == "%");
    }
    return ExactBitwise(operator, left, right);
}
// Runs the statements of a block; its locals end with it.
CtBlock :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], links: graph.Binding[],
            callables: Callable[], params: Param[], constants: ConstDecl[], package: int, file: int,
            names: ^(string[]), bits: ^(u64[]), storages: ^(int[]), steps: ^int, depth: int, result: int,
            statements: int[]) -> CtFlow {
    mark := length(names^);
    text := documents[file].text;
    for (statement in statements) {
        steps^ += 1;
        if (steps^ > CtSteps) {
            return CtFlow.Failed(CtFail(forest, statement, file, "compile-time evaluation exceeded 65536 steps"));
        }
        flow := CtStatement(forest, documents, links, callables, params, constants, package, file, names, bits,
                            storages, steps, depth, result, statement);
        switch flow {
            case .Normal:
                continue;
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Returned(value, storage):
                names^ = slice(names^, 0, mark);
                bits^ = slice(bits^, 0, mark);
                storages^ = slice(storages^, 0, mark);
                return CtFlow.Returned(value, storage);
            case .Broke:
                names^ = slice(names^, 0, mark);
                bits^ = slice(bits^, 0, mark);
                storages^ = slice(storages^, 0, mark);
                return CtFlow.Broke;
            case .Continued:
                names^ = slice(names^, 0, mark);
                bits^ = slice(bits^, 0, mark);
                storages^ = slice(storages^, 0, mark);
                return CtFlow.Continued;
        }
    }
    names^ = slice(names^, 0, mark);
    bits^ = slice(bits^, 0, mark);
    storages^ = slice(storages^, 0, mark);
    return CtFlow.Normal;
}
CtStatement :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], links: graph.Binding[],
                callables: Callable[], params: Param[], constants: ConstDecl[], package: int, file: int,
                names: ^(string[]), bits: ^(u64[]), storages: ^(int[]), steps: ^int, depth: int, result: int,
                statement: int) -> CtFlow {
    text := documents[file].text;
    if (Is(forest, statement, syntax.ReturnStatement)) {
        value := Field(forest, statement, syntax.FieldValue);
        if (value < 0) {
            return CtFlow.Failed(CtFail(forest, statement, file, "return needs a value"));
        }
        switch CtEval(forest, documents, links, callables, params, constants, package, file, names, bits, storages,
                      steps, depth, value, result) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Value(returned, storage):
                if (storage != result && !Widens(storage, result)) {
                    return CtFlow.Failed(CtFail(forest, value, file, "returned value differs from the result type"));
                }
                return CtFlow.Returned(CtWidened(returned, storage, result), result);
        }
    }
    if (Is(forest, statement, syntax.BreakStatement)) {
        return CtFlow.Broke;
    }
    if (Is(forest, statement, syntax.ContinueStatement)) {
        return CtFlow.Continued;
    }
    if (Is(forest, statement, syntax.LocalDeclaration)) {
        want: int = 0;
        declared := Field(forest, statement, syntax.FieldType);
        if (declared >= 0) {
            want = ScalarStorage(Text(forest, text, declared));
            if (want == 0 || (!Integer(want) && want != BoolStorage)) {
                return CtFlow.Failed(CtFail(forest, declared, file,
                                            "compile-time locals are integers or bool"));
            }
        }
        value := Field(forest, statement, syntax.FieldValue);
        if (value < 0) {
            return CtFlow.Failed(CtFail(forest, statement, file, "a compile-time local needs a value"));
        }
        switch CtEval(forest, documents, links, callables, params, constants, package, file, names, bits, storages,
                      steps, depth, value, want) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Value(initial, storage):
                if (want != 0 && storage != want && !Widens(storage, want)) {
                    return CtFlow.Failed(CtFail(forest, value, file, "local value differs from its type"));
                }
                if (want == 0) {
                    want = storage;
                }
                names.append(Text(forest, text, Field(forest, statement, syntax.FieldName)));
                bits.append(CtWidened(initial, storage, want));
                storages.append(want);
                return CtFlow.Normal;
        }
    }
    if (Is(forest, statement, syntax.Assignment)) {
        target := Field(forest, statement, syntax.FieldTarget);
        at := -1;
        if (Is(forest, target, syntax.Identifier)) {
            at = CtLookup(names^, Text(forest, text, target));
        }
        if (at < 0) {
            return CtFlow.Failed(CtFail(forest, statement, file, "compile-time assignment needs a local"));
        }
        local := storages^[at];
        operator := CompoundOperator(Text(forest, text, Field(forest, statement, syntax.FieldOperator)));
        switch CtEval(forest, documents, links, callables, params, constants, package, file, names, bits, storages,
                      steps, depth, Field(forest, statement, syntax.FieldValue), local) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Value(assigned, storage):
                if (storage != local && !Widens(storage, local)) {
                    return CtFlow.Failed(CtFail(forest, statement, file, "assigned value differs from its local"));
                }
                if (operator == "") {
                    bits^[at] = CtWidened(assigned, storage, local);
                    return CtFlow.Normal;
                }
                if (!Integer(local)) {
                    return CtFlow.Failed(CtFail(forest, statement, file, "compound assignment needs integer operands"));
                }
                current := ExactStored(bits^[at], local);
                operand := ExactStored(assigned, storage);
                if ((operator == "/" || operator == "%") && ExactZero(operand)) {
                    return CtFlow.Failed(CtFail(forest, statement, file, "Constant division by zero"));
                }
                combined := CtApply(operator, current, operand);
                if (MagnitudeBits(Magnitude(combined)) > ExactLimit || !ExactFits(combined, local)) {
                    return CtFlow.Failed(OutsideRange(forest, file, statement, local));
                }
                bits^[at] = ExactWrapped(combined, local);
                return CtFlow.Normal;
        }
    }
    if (Is(forest, statement, syntax.IfStatement)) {
        switch CtEval(forest, documents, links, callables, params, constants, package, file, names, bits, storages,
                      steps, depth, Field(forest, statement, syntax.FieldCondition), BoolStorage) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Value(taken, storage):
                if (storage != BoolStorage) {
                    return CtFlow.Failed(CtFail(forest, Field(forest, statement, syntax.FieldCondition), file,
                                                "an if condition must be a bool"));
                }
                if (taken != 0) {
                    return CtBlock(forest, documents, links, callables, params, constants, package, file, names, bits,
                                   storages, steps, depth, result,
                                   Members(forest, Field(forest, statement, syntax.FieldConsequence)));
                }
                alternative := Field(forest, statement, syntax.FieldAlternative);
                if (Is(forest, alternative, syntax.IfStatement)) {
                    return CtStatement(forest, documents, links, callables, params, constants, package, file, names,
                                       bits, storages, steps, depth, result, alternative);
                }
                if (alternative >= 0) {
                    return CtBlock(forest, documents, links, callables, params, constants, package, file, names, bits,
                                   storages, steps, depth, result, Members(forest, alternative));
                }
                return CtFlow.Normal;
        }
    }
    if (Is(forest, statement, syntax.WhileStatement)) {
        while (true) {
            steps^ += 1;
            if (steps^ > CtSteps) {
                return CtFlow.Failed(CtFail(forest, statement, file, "compile-time evaluation exceeded 65536 steps"));
            }
            switch CtEval(forest, documents, links, callables, params, constants, package, file, names, bits,
                          storages, steps, depth, Field(forest, statement, syntax.FieldCondition), BoolStorage) {
                case .Failed(diagnostic):
                    return CtFlow.Failed(diagnostic);
                case .Waiting:
                    return CtFlow.Waiting;
                case .Value(taken, storage):
                    if (storage != BoolStorage) {
                        return CtFlow.Failed(CtFail(forest, Field(forest, statement, syntax.FieldCondition), file,
                                                    "a while condition must be a bool"));
                    }
                    if (taken == 0) {
                        return CtFlow.Normal;
                    }
            }
            switch CtBlock(forest, documents, links, callables, params, constants, package, file, names, bits,
                           storages, steps, depth, result, Members(forest, Field(forest, statement, syntax.FieldBody))) {
                case .Failed(diagnostic):
                    return CtFlow.Failed(diagnostic);
                case .Waiting:
                    return CtFlow.Waiting;
                case .Returned(value, storage):
                    return CtFlow.Returned(value, storage);
                case .Broke:
                    return CtFlow.Normal;
                case .Normal:
                    continue;
                case .Continued:
                    continue;
            }
        }
    }
    return CtFlow.Failed(CtFail(forest, statement, file, "compile-time execution does not support this statement yet"));
}
// Folds the value of a constant whose expression calls authored functions:
// each call runs first and stands for its value.
FoldCalling :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], links: graph.Binding[],
                callables: Callable[], params: Param[], constants: ConstDecl[], package: int, file: int,
                node: int, storage: int) -> Folding {
    text := documents[file].text;
    aliases := Aliases(links, file);
    calls: int[] = [];
    CtCollect(forest, text, links, callables, package, file, node, &calls);
    if (length(calls) == 0) {
        return FoldConstant(forest, text, file, constants, aliases, package, node, storage);
    }
    names: string[] = [];
    bits: u64[] = [];
    storages: int[] = [];
    steps: int = 0;
    memo: ConstDecl[] = [];
    for (call in calls) {
        switch CtCall(forest, documents, links, callables, params, constants, package, file, &names, &bits, &storages,
                      &steps, 0, call) {
            case .Failed(diagnostic):
                return Folding.Failed(diagnostic);
            case .Waiting:
                return Folding.Waiting;
            case .Value(value, result):
                placed: ConstDecl = {name: "", package: package, storage: result, bits: value, node: call, file: file,
                                    folded: true, occurrence: 0};
                memo.append(placed);
        }
    }
    scope := memo;
    scope.extend(constants);
    return FoldConstant(forest, text, file, scope, aliases, package, node, storage);
}
