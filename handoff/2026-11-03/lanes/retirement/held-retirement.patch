-    for (int i = 0; i < acount(f->definitions); i++) {
-        if (!behavior_function_own(f->definitions[i])) {
-            goto invalid;
-        }
-    }
-    if (f->fast) {
-        if (!behavior_function_own(f->fast)) {
-            goto invalid;
-        }
