version 3
name "ArenaShipMotionBehavior"
id_counter 1350
description "Sustained aim-relative strafe slowly rolls between the pyramid's 90-degree faces. Roll angle and angular velocity stay continuous through reversals. Release settles onto the nearest face captured while moving. Reverse movement adds a subtle nose lift. Tune speed, rocking and settling under Motion in the Variables Inspector."
owner_type "ecs.entity"
(array)variables {
    - id=1 name="Roll Speed (Degrees/Second)" type="float" type_name="float" category="Motion" default=36.0
    - id=2 name="Reverse Nose Lift (Degrees)" type="float" type_name="float" category="Motion" default=3.0
    - id=3 name="Settle Response (Hz)" type="float" type_name="float" category="Motion" default=1.0
    - id=4 name="Settle Damping" type="float" type_name="float" category="Motion" default=1.0
    - id=5 name="Roll Angle" type="float" type_name="float" category="State"
    - id=6 name="Roll Velocity" type="float" type_name="float" category="State"
    - id=7 name="Nose Position" type="float" type_name="float" category="State"
    - id=8 name="Nose Velocity" type="float" type_name="float" category="State"
    - id=252 name="Face Rocking" type="float" type_name="float" category="Motion" default=0.5
    - id=253 name="Roll Acceleration (Per Second)" type="float" type_name="float" category="Motion" default=3.0
    - id=254 name="Strafe Dead Zone" type="float" type_name="float" category="Motion" default=0.12
    - id=255 name="Resting Face" type="float" type_name="float" category="State"
}
