package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("ClayView")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Transform", data.Object([
                    data.Field.Named("x", data.Value.Real(0.0)),
                    data.Field.Named("y", data.Value.Real(0.0))
                ])),
                data.Field.Named("Camera", data.Object([
                    data.Field.Named("width", data.Value.Real(320.0)),
                    data.Field.Named("height", data.Value.Real(180.0)),
                    data.Field.Named("pitch", data.Value.Real(0.35)),
                    data.Field.Named("target_elevation", data.Value.Real(12.0))
                ])),
                data.Field.Named("SurfaceQuality", data.Object([
                    data.Field.Named("resolution", data.Value.Text("Full")),
                    data.Field.Named("sdf_normal_mode", data.Value.Text("Tetrahedral")),
                    data.Field.Named("sdf_pixel_error", data.Value.Real(0.25))
                ]))
            ]))
        ])
    );
}
