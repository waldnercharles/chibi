package facts

// optional errors beside named struct results
@test
Calls :: () {
    a1_0: bool = false;
    r1: int = Use(a1_0);
    e1: int = 12;
    assert(r1 == e1, "Use call 1");
    a2_0: bool = true;
    r2: int = Use(a2_0);
    e2: int = 20;
    assert(r2 == e2, "Use call 2");
    r3: int = Empty();
    e3: int = 1;
    assert(r3 == e3, "Empty call 3");
}
