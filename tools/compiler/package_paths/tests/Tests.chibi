package package_paths_tests

import paths "project:package_paths"

// Path normalization for package routes, from the former C resolver differential
// (package_paths_chibi.c): the same requests, each with the result the C resolver gave.
// A request without a base or a floor sets its has_* flag to false.
Normalized :: (base: string, has_base: bool, path: string, floor: string, has_floor: bool, expected: string) {
    request: paths.Request = {base: base, path: path, floor: floor, has_base: has_base, has_path: true, has_floor: has_floor};
    switch paths.Normalize(request) {
        case .Normalized(got):
            assert(got == expected, "normalized path");
        case .Invalid:
            assert(false, "the path is valid");
    }
}

Invalid :: (base: string, has_base: bool, path: string, has_path: bool, floor: string, has_floor: bool) {
    request: paths.Request = {base: base, path: path, floor: floor, has_base: has_base, has_path: has_path, has_floor: has_floor};
    switch paths.Normalize(request) {
        case .Normalized(got):
            assert(false, "the path is invalid");
        case .Invalid:
            assert(true, "invalid");
    }
}

@test
ProjectRoot :: () {
    Normalized("", false, "/workspace/./project", "", false, "/workspace/project");
}

@test
CollectionRoot :: () {
    Normalized("", false, "/sdk/./core", "", false, "/sdk/core");
}

@test
ProjectRelativeFile :: () {
    Normalized("/workspace/project", true, "app/a.chibi", "/workspace/project", true, "/workspace/project/app/a.chibi");
}

@test
ProjectAbsoluteFile :: () {
    Normalized("/workspace/project", true, "/workspace/project/app/./a.chibi", "", false, "/workspace/project/app/a.chibi");
}

@test
CollectionAbsoluteFile :: () {
    Normalized("/workspace/project", true, "/sdk/core/scalar/a.chibi", "", false, "/sdk/core/scalar/a.chibi");
}

@test
RelativeImport :: () {
    Normalized("/workspace/project/app", true, "../math", "/workspace/project", true, "/workspace/project/math");
}

@test
ProjectImport :: () {
    Normalized("/workspace/project", true, "math/.", "/workspace/project", true, "/workspace/project/math");
}

@test
CollectionImport :: () {
    Normalized("/sdk/core", true, "scalar", "/sdk/core", true, "/sdk/core/scalar");
}

@test
ProjectRootEscape :: () {
    Invalid("/workspace/project/app", true, "../../outside", true, "/workspace/project", true);
}

@test
NestedRootEscape :: () {
    Invalid("/workspace/project/app", true, "../math", true, "/workspace/project/app", true);
}

@test
MissingImportPath :: () {
    Normalized("/workspace/project/app", true, "../missing", "/workspace/project", true, "/workspace/project/missing");
}

@test
RelocatedRoot :: () {
    Normalized("", false, "/moved/project", "", false, "/moved/project");
}

@test
RootFloorDotDot :: () {
    Normalized("/", true, "x/../y", "/", true, "/y");
}

@test
FinalPrefixBoundary :: () {
    Invalid("", false, "/workspace/project2/a", true, "/workspace/project", true);
}

@test
IntermediateEscapeReentry :: () {
    Invalid("/workspace/project", true, "../project/app", true, "/workspace/project", true);
}

@test
SlashesAndDots :: () {
    Normalized("/workspace/project", true, "./a//b/../c", "/workspace/project", true, "/workspace/project/a/c");
}

@test
Backslash :: () {
    Invalid("/workspace/project", true, "a\\b", true, "", false);
}

@test
RelativeWithoutBase :: () {
    Invalid("", false, "app", true, "", false);
}

@test
EmptyRelative :: () {
    Normalized("/workspace/project", true, "", "", false, "/workspace/project");
}

@test
AbsoluteRoot :: () {
    Normalized("", false, "/", "", false, "/");
}

@test
AbsoluteIgnoresUnusedBase :: () {
    Normalized("bad\\base", true, "/ok", "", false, "/ok");
}

@test
MissingPathIsInvalid :: () {
    Invalid("/workspace/project", true, "", false, "", false);
}
