version 3
name "EngineVariants"
domain "model"
id_counter 39
description "Three references retain shared defaults or use explicit local radius overrides. Placement is a geometry function."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 15
                type "Model Instance"
                reference_asset "EngineModule"
                inputs {
                    Radius id=17 declaration_id=3 type="float" default=10.0
                }
                outputs {
                    Geometry id=16
                }
            }
            - id=18 type="Model Instance" reference_asset="EngineModule"
            - {
                id 20
                type "Model Instance"
                reference_asset "EngineModule"
                inputs {
                    Radius id=22 declaration_id=3 type="float" default=20.0
                }
                outputs {
                    Geometry id=21
                }
            }
            - {
                id 23
                type "Call Pure Function"
                reference_name "Offset Part"
                inputs {
                    Geometry id=24 type="handle" type_name="Geometry3D"
                    Offset {
                        id 25
                        type "struct"
                        type_name "ShaderVec3"
                        default x=-48.0 y=0.0 z=0.0
                    }
                }
                outputs {
                    Geometry id=26 type="handle" type_name="Geometry3D"
                }
            }
            - {
                id 27
                type "Call Pure Function"
                reference_name "Offset Part"
                inputs {
                    Geometry id=28 type="handle" type_name="Geometry3D"
                    Offset {
                        id 29
                        type "struct"
                        type_name "ShaderVec3"
                        default x=54.0 y=0.0 z=0.0
                    }
                }
                outputs {
                    Geometry id=30 type="handle" type_name="Geometry3D"
                }
            }
            - id=31 type="Model Union"
            - id=35 type="Model Union"
        }
        (array)edges {
            - from="15.Geometry" to="23.Geometry"
            - from="18.Geometry" to="31.B"
            - from="20.Geometry" to="27.Geometry"
            - from="23.Geometry" to="31.A"
            - from="27.Geometry" to="35.B"
            - from="31.Geometry" to="35.A"
            - from="35.Geometry" to="1.Geometry"
        }
    }
    - {
        id 3
        kind "function"
        name "Offset Part"
        entry_id 4
        return_id 6
        call_depth_limit 64
        (array)nodes {
            - {
                id 4
                type "Function Entry"
                (array)outputs {
                    - id=8 name="Geometry" type="handle" type_name="Geometry3D" kind="data"
                    - id=9 name="Offset" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 6
                type "Return"
                (array)inputs {
                    - id=10 name="Geometry" type="handle" type_name="Geometry3D" kind="data"
                }
            }
            - id=11 type="Model Translate"
        }
        (array)edges {
            - from="4.Geometry" to="11.Geometry"
            - from="4.Offset" to="11.Offset"
            - from="11.Geometry" to="6.Geometry"
        }
    }
}
