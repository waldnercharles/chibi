name "MovingPlatformsView"
components {
    Camera height=360.0 width=640.0
    DirectionalLight {
        color 0xffffffff
        direction x=0.45 y=-0.85 z=-0.4
        intensity 2.8
        shadows #true
    }
    Environment ambient_ground=0x303840ff ambient_intensity=1.0 ambient_sky=0x8090a0ff fog_resolution=0.25 fog_steps=4
    (object)Transform
}
