version 3
name "SdfBoredBox"
domain "shape"
bounds_x 48.0
bounds_y 48.0
id_counter 194
description "Difference: rounded box minus a through-cylinder along local Y."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Shader Shape Output"
            - id=3 type="Shader ObjectPosition"
            - {
                id 32
                type "Behavior Expression"
                reference_name "abs(p) - vec3(27, 23, 27)"
                inputs {
                    p id=33 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=34 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 75
                type "Behavior Expression"
                reference_name "length(max(offset, 0)) + min(max(max(offset.x, offset.y), offset.z), 0) - 6"
                inputs {
                    offset id=76 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=77 type="float"
                }
            }
            - {
                id 143
                type "Behavior Expression"
                reference_name "length(p.xz) - 14"
                inputs {
                    p id=144 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=145 type="float"
                }
            }
            - {
                id 190
                type "Behavior Expression"
                reference_name "max(body, -bore)"
                inputs {
                    body id=191 type="float"
                    bore id=192 type="float"
                }
                outputs {
                    Result id=193 type="float"
                }
            }
        }
        (array)edges {
            - from="3.Value" to="32.p"
            - from="3.Value" to="143.p"
            - from="32.Result" to="75.offset"
            - from="75.Result" to="190.body"
            - from="143.Result" to="190.bore"
            - from="190.Result" to="1.Distance"
        }
    }
    - id=7 kind="function" math_expression="abs(p) - vec3(27, 23, 27)" entry_id=8
    - id=35 kind="function" math_expression="length(max(offset, 0)) + min(max(max(offset.x, offset.y), offset.z), 0) - 6" entry_id=79
    - id=127 kind="function" math_expression="length(p.xz) - 14" entry_id=147
    - id=172 kind="function" math_expression="max(body, -bore)" entry_id=173
}
