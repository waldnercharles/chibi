// Material targets; see render_material_textures.
layout(set = 2, binding = 1) uniform sampler2D scene_tex;
layout(set = 2, binding = 2) uniform sampler2D fluence_tex;
layout(set = 2, binding = 3) uniform sampler2D source_tex;
layout(set = 2, binding = 4) uniform sampler2D albedo_tex;
layout(set = 2, binding = 5) uniform sampler2D normal_tex;

layout(set = 2, binding = 6) uniform sampler2D background_tex;
layout(set = 2, binding = 7) uniform sampler2D visibility_tex;
layout(set = 2, binding = 8) uniform sampler2D surface_q0;
layout(set = 2, binding = 9) uniform sampler2D surface_q1;
layout(set = 2, binding = 10) uniform sampler2D surface_q2;
layout(set = 2, binding = 11) uniform sampler2D surface_q3;
layout(set = 2, binding = 12) uniform sampler2D cover_tex;

layout(set = 3, binding = 1) uniform shd_uniforms
{
    float ambient;
    float intensity;
    float debug_view;
    float shadow_floor;
    float fog;
    float dither_phase;
    vec4 crop_uv;
    float surface_sigma;
    // x enabled, y relief, z bevel, w specular gain.
    vec4 surface_params;
    // xy canvas uv to surface uv scale, zw one surface texel in uv.
    vec4 surface_map;
    int linear_output;
    float world_per_px;
    float reconstruction_threshold;
};

#include "color.shd"

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

float reconstruction_transmittance(ivec2 p, ivec2 sample_size, ivec2 full_size)
{
    vec2 uv = (vec2(p) + 0.5) / vec2(sample_size);
    ivec2 absorption_p = clamp(ivec2(uv * vec2(full_size)), ivec2(0), full_size - 1);
    float tau = texelFetch(source_tex, absorption_p, 0).a;
    return exp(-max(tau, 0.0));
}

vec4 reconstruction_weights(vec2 uv, ivec2 sample_size, ivec2 full_size,
                            out ivec2 p00, out ivec2 p10,
                            out ivec2 p01, out ivec2 p11)
{
    vec2 grid = uv * vec2(sample_size) - 0.5;
    ivec2 base = ivec2(floor(grid));
    vec2 f = fract(grid);
    ivec2 last = sample_size - 1;
    p00 = clamp(base, ivec2(0), last);
    p10 = clamp(base + ivec2(1, 0), ivec2(0), last);
    p01 = clamp(base + ivec2(0, 1), ivec2(0), last);
    p11 = clamp(base + ivec2(1, 1), ivec2(0), last);

    ivec2 center = clamp(ivec2(uv * vec2(full_size)), ivec2(0), full_size - 1);
    float target = exp(-max(texelFetch(source_tex, center, 0).a, 0.0));
    float t00 = reconstruction_transmittance(p00, sample_size, full_size) - target;
    float t10 = reconstruction_transmittance(p10, sample_size, full_size) - target;
    float t01 = reconstruction_transmittance(p01, sample_size, full_size) - target;
    float t11 = reconstruction_transmittance(p11, sample_size, full_size) - target;
    float sigma = max(reconstruction_threshold, 0.02);
    float sigma2 = 2.0 * sigma * sigma;
    return vec4((1.0 - f.x) * (1.0 - f.y) * exp(-(t00 * t00) / sigma2),
                f.x * (1.0 - f.y) * exp(-(t10 * t10) / sigma2),
                (1.0 - f.x) * f.y * exp(-(t01 * t01) / sigma2),
                f.x * f.y * exp(-(t11 * t11) / sigma2));
}

// Height and geometry coverage. Fog's display coverage does not change relief.
// Mesh samples retain a real face plane through subpixel shadow queries.
vec2 relief_at(vec2 uv)
{
    ivec2 size = textureSize(albedo_tex, 0);
    ivec2 p = clamp(ivec2(uv * vec2(size)), ivec2(0), size - 1);
    vec4 geometry = texelFetch(cover_tex, p, 0);
    if (geometry.g <= 1e-6) return vec2(0);
    float height = texelFetch(albedo_tex, p, 0).a / geometry.g;
    if (geometry.b > geometry.g * 0.5) {
        vec2 tilt = texelFetch(normal_tex, p, 0).xy / geometry.g;
        float nz = sqrt(max(1.0 - dot(tilt, tilt), 0.0));
        vec2 offset = (uv * vec2(size) - (vec2(p) + 0.5)) * world_per_px;
        if (nz > 0.05) height -= dot(tilt, vec2(offset.x, -offset.y)) / nz;
    }
    return vec2(height, geometry.g);
}

vec4 quadrant_at(int i, vec2 uv)
{
    if (i == 0) return texture(surface_q0, uv);
    if (i == 1) return texture(surface_q1, uv);
    if (i == 2) return texture(surface_q2, uv);
    return texture(surface_q3, uv);
}

float surface_shadow(vec2 uv, vec2 toward, vec2 relief)
{
    if (surface_params.y <= 0.0 || relief.y <= 0.5) return 1.0;
    const float STEP = 0.6;
    vec2 pixel_uv = 1.0 / vec2(textureSize(albedo_tex, 0));
    vec2 step_uv = vec2(toward.x, -toward.y) * (STEP / world_per_px) * pixel_uv;
    float rise = STEP / surface_params.y;
    float shadow = 1.0;
    for (int i = 1; i <= 10; i++) {
        vec2 r = relief_at(uv + step_uv * float(i));
        if (r.y < 0.5) break;
        // Half-float height storage requires a bias that follows its precision.
        float bias = max(0.002, max(abs(relief.x), abs(r.x)) * 0.001);
        shadow = min(shadow, clamp(1.0 - (r.x - relief.x - rise * float(i) - bias), 0.0, 1.0));
    }
    return shadow;
}

vec3 sample_fluence(vec2 uv)
{
    ivec2 sample_size = textureSize(fluence_tex, 0);
    ivec2 full_size = textureSize(source_tex, 0);
    if (all(equal(sample_size, full_size))) return texture(fluence_tex, uv).rgb;

    ivec2 p00, p10, p01, p11;
    vec4 weights = reconstruction_weights(uv, sample_size, full_size, p00, p10, p01, p11);
    float total = dot(weights, vec4(1));
    if (total <= 1e-6) return vec3(0);
    vec3 sum = texelFetch(fluence_tex, p00, 0).rgb * weights.x +
               texelFetch(fluence_tex, p10, 0).rgb * weights.y +
               texelFetch(fluence_tex, p01, 0).rgb * weights.z +
               texelFetch(fluence_tex, p11, 0).rgb * weights.w;
    return max(sum / total, vec3(0));
}

// GGX distribution, height-correlated Smith visibility and Schlick Fresnel for
// a dielectric, viewed straight down the camera axis.
float highlight(vec3 n, vec3 l, float roughness)
{
    vec3 h = normalize(l + vec3(0, 0, 1));
    float nv = max(n.z, 0.0001);
    float nl = max(dot(n, l), 0.0);
    float nh = max(dot(n, h), 0.0);
    float alpha = max(roughness * roughness, 0.0025);
    float a2 = alpha * alpha;
    float d = nh * nh * (a2 - 1.0) + 1.0;
    float distribution = a2 / max(3.14159265 * d * d, 0.00000001);
    float visibility = 0.5 / max(nl * sqrt(nv * nv * (1.0 - a2) + a2) +
                                 nv * sqrt(nl * nl * (1.0 - a2) + a2), 0.0001);
    float fresnel = 0.04 + 0.96 * pow(1.0 - max(h.z, 0.0), 5.0);
    return fresnel * distribution * visibility * nl;
}

// Emission as display shows it: each texel's light scaled back by its cover,
// then filtered, so partly covered edges keep their coverage.
vec3 display_emission(vec2 uv)
{
    ivec2 size = textureSize(source_tex, 0);
    vec2 p = uv * vec2(size) - 0.5;
    ivec2 lo = clamp(ivec2(floor(p)), ivec2(0), size - 1);
    ivec2 hi = min(lo + 1, size - 1);
    vec2 f = clamp(p - floor(p), 0.0, 1.0);
    vec3 e00 = texelFetch(source_tex, lo, 0).rgb * texelFetch(cover_tex, lo, 0).r;
    vec3 e10 = texelFetch(source_tex, ivec2(hi.x, lo.y), 0).rgb * texelFetch(cover_tex, ivec2(hi.x, lo.y), 0).r;
    vec3 e01 = texelFetch(source_tex, ivec2(lo.x, hi.y), 0).rgb * texelFetch(cover_tex, ivec2(lo.x, hi.y), 0).r;
    vec3 e11 = texelFetch(source_tex, hi, 0).rgb * texelFetch(cover_tex, hi, 0).r;
    return mix(mix(e00, e10, f.x), mix(e01, e11, f.x), f.y);
}

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 source_uv = mix(crop_uv.xy, crop_uv.zw, screen_uv);
    vec4 scene = texture(scene_tex, source_uv);
    vec4 source = texture(source_tex, source_uv);
    vec3 emission = display_emission(source_uv);
    vec3 albedo = texture(albedo_tex, source_uv).rgb;
    vec3 fluence = sample_fluence(source_uv);
    vec4 normal = texture(normal_tex, source_uv);

    int mode = int(debug_view + 0.5);
    if (mode == 1) return scene;
    if (mode == 2) return vec4(emission, 1.0);
    if (mode == 3) return vec4(vec3(exp(-source.a)), 1.0);
    if (mode == 4) return vec4(albedo, 1.0);
    if (mode == 5) return vec4(fluence * 5.0, 1.0);
    if (mode == 6) return vec4(normal.xyz * 0.5 + 0.5, normal.a);

    // Screen-space liquid distortion samples the background and incident light.
    // Foreground opaque objects remain in front; this is not a depth/Snell solve.
    vec2 pixel_uv = 1.0 / vec2(textureSize(normal_tex, 0));
    vec2 distortion = normal.z < 0.0 ? normal.xy * (-normal.z) * pixel_uv : vec2(0);
    vec2 fluence_uv = source_uv + distortion;
    if (normal.z < 0.0) fluence = sample_fluence(fluence_uv);
    vec4 visibility = texture(visibility_tex, source_uv);
    // The same exposure as visible emitters reveals light received by fluid.
    // Coverage blends this artistic gain; it never feeds the transport solver.
    float volume_exposure = mix(1.0, intensity, visibility.a);
    vec3 incident = fluence * volume_exposure;
    if (normal.z < 0.0) {
        // Liquid edges brighten from light received just outside them.
        vec2 reach = 8.0 * pixel_uv;
        vec3 outside = .25 * (sample_fluence(source_uv + vec2(reach.x, 0)) +
                              sample_fluence(source_uv - vec2(reach.x, 0)) +
                              sample_fluence(source_uv + vec2(0, reach.y)) +
                              sample_fluence(source_uv - vec2(0, reach.y)));
        incident += outside * normal.a * 2.0 * intensity;
    }

    // Each quadrant keeps its RGB energy through the BRDF and visibility.
    // The four evaluations are independent of the number of emitters.
    vec4 geometry = texture(cover_tex, source_uv);
    bool mesh = geometry.b > geometry.g * 0.5 && geometry.g > 0.0;
    if (normal.z >= 0.0 && geometry.g > 1e-6) normal /= geometry.g;
    bool solid = normal.z > 0.0 || (normal.z == 0.0 && (normal.w > 0.0 || dot(normal.xy, normal.xy) > 0.0));
    vec2 tilt = solid ? normal.xy : vec2(0);
    vec2 suv = source_uv * surface_map.xy;
    vec2 dx = vec2(surface_map.z, 0), dy = vec2(0, surface_map.w);
    float open = max(quadrant_at(0, suv).a, 0.0);
    if (solid && !mesh && surface_params.x > 0.0) {
        vec2 outward = 0.5 * surface_sigma * vec2(
            quadrant_at(0, suv + dx).a - quadrant_at(0, suv - dx).a,
            quadrant_at(0, suv - dy).a - quadrant_at(0, suv + dy).a);
        tilt += outward * surface_params.z * step(1e-4, normal.z);
    }
    vec3 n = solid ? normalize(vec3(tilt, sqrt(max(1.0 - dot(normal.xy, normal.xy), 0.0)))) : vec3(0, 0, 1);
    vec3 surface_light = vec3(0), surface_shaded = vec3(0);
    vec2 dominant = vec2(0);
    float energy = 0.0, shadow_sum = 0.0;
    vec2 axes[4] = vec2[4](vec2(1, 0), vec2(0, -1), vec2(-1, 0), vec2(0, 1));
    vec2 relief = relief_at(source_uv);
    if (solid && surface_params.x > 0.0) {
        float reach = clamp((2.0 * open - 0.05) / 0.95, 0.0, 1.0);
        float gain = reach * normal.z * intensity / max(open, 1e-4);
        float gloss = clamp(normal.w, 0.0, 1.0);
        for (int i = 0; i < 4; i++) {
            vec3 q = max(quadrant_at(i, suv).rgb, vec3(0));
            float power = dot(q, LUMA);
            if (power <= 1e-8) continue;
            vec2 gradient = vec2(
                dot(quadrant_at(i, suv + dx).rgb - quadrant_at(i, suv - dx).rgb, LUMA),
                dot(quadrant_at(i, suv - dy).rgb - quadrant_at(i, suv + dy).rgb, LUMA));
            vec2 slope = 0.5 * surface_sigma * gradient / power;
            vec2 toward = axes[i] + slope / max(1.0, length(slope));
            toward -= axes[i] * min(dot(toward, axes[i]) - 0.2, 0.0);
            toward = normalize(toward);
            vec3 l = normalize(vec3(toward * surface_params.y, 1.0));
            float shadow = surface_shadow(source_uv, toward, relief);
            float diffuse = max(dot(n, l), 0.0) / l.z;
            float specular = gloss > 0.0
                ? 3.14159265 * highlight(n, l, 1.0 - gloss) / l.z * surface_params.w : 0.0;
            vec3 received = q * gain;
            surface_light += received;
            surface_shaded += received * (albedo * diffuse + vec3(specular * geometry.g)) * shadow;
            dominant += toward * power;
            shadow_sum += shadow * power;
            energy += power;
        }
    }
    dominant /= max(energy, 1e-8);
    if (mode == 7) return vec4(surface_light, 1.0);
    if (mode == 8) return vec4(dominant * 0.5 + 0.5, energy > 0.0 ? shadow_sum / energy : 1.0, 1.0);
    if (mode == 9) return vec4(n * 0.5 + 0.5, 1.0);

    vec3 lit = incident * albedo + surface_shaded + max(albedo * shadow_floor, visibility.rgb);
    vec3 out_linear = fluence * fog + emission * intensity + scene.rgb * ambient + lit;
    vec2 background_uv = clamp(screen_uv + distortion / (crop_uv.zw - crop_uv.xy), vec2(0), vec2(1));
    out_linear += texture(background_tex, background_uv).rgb * (1.0 - scene.a);
    if (linear_output != 0) return vec4(max(out_linear, vec3(0.0)), 1.0);
    vec3 out_srgb = linear_to_srgb(max(out_linear, vec3(0.0)));
    float dither = dither8bit_ign(gl_FragCoord.xy, dither_phase);
    return vec4(clamp(out_srgb + vec3(dither), vec3(0.0), vec3(1.0)), 1.0);
}
