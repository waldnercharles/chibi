AssertsFixtureSource :: () -> string { return "package scalar\nMain :: () -> int {\n    x: int = 1;\n    assert(x < 2, \"x is small\");\n    return x;\n}\n"; }
AssertsRows :: () -> facts.Row[] {
    rows := Produced(AssertsFixtureSource());
    ExpectKinds(rows, [facts.SourceRow, facts.DocumentRow, facts.FunctionRow, facts.LocalRow, facts.LiteralRow, facts.AssertRow, facts.ReadRow, facts.LiteralRow, facts.CompareRow, facts.ReturnRow, facts.ReadRow]);
    ValidateRows(rows, "");
    RejectChanged(rows, [Changed(5, TypeField, 2)], "invalid scalar statement row");
    RejectChanged(rows, [Changed(5, ValueField, 1)], "invalid scalar statement row");
    RejectChanged(rows, [Named(5, NameField, "x")], "invalid scalar statement row");
    RejectChanged(rows, [Changed(5, LiteralField, 1)], "invalid scalar statement row");
    RejectChanged(rows, [Changed(8, KindField, 11), Changed(8, TypeField, 1)], "scalar condition is not one bool");
    ValidateRows(rows, "");
    return rows;
}
