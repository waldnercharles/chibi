package llvm_native

import abi "project:native_abi"
import strings "core:strings"

// A nonmoving heap whose zero value is empty. Its owner supplies all live
// roots and calls collection only with execution quiescent or roots spilled.
// Cells retain static typed layout metadata and drop callbacks. Their images
// must outlive every cell; standalone executable images live for the process.
// At 64-bit targets the heap is 56 bytes, each cell header 64, stack root 24 and persistent root 32.
// Mark/sweep is O(roots + cells + edges), with no per-edge allocation/recursion.
// This raw collector is a backend contract. Source admission additionally
// validates typed descriptors and supplies roots around each safe point.
pub ManagedRuntime :: () -> string {
    return strings.Join([
        format_text("%chibi.managed.heap = type {}\n", abi.ManagedHeapType()),
        "%chibi.managed.cell = type { ptr, ptr, ptr, ptr, i64, i1, ptr, i32 }\n",
        format_text("%chibi.managed.layout = type {}\n", abi.ManagedLayoutType()),
        "%chibi.managed.root = type { ptr, ptr, ptr }\n",
        "%chibi.managed.persistent = type { ptr, ptr, ptr, ptr }\n",
        "\n",
        "; A heap's cells never move. Trace and drop callbacks receive payload storage.\n",
        "; Tracing only queues managed cells; dropping only releases external owners.\n",
        "; A nullable per-image counter pins callback code until the last cell drops.\n",
        "; The host may unload a zero-count image only after execution is quiescent.\n",
        "define internal void @chibi_managed.code(ptr %layout, i64 %delta) {\n",
        "entry:\n",
        "  %described = icmp ne ptr %layout, null\n",
        "  br i1 %described, label %find, label %exit\n",
        "find:\n",
        "  %counter.at = getelementptr %chibi.managed.layout, ptr %layout, i32 0, i32 2\n",
        "  %counter = load ptr, ptr %counter.at\n",
        "  %counted = icmp ne ptr %counter, null\n",
        "  br i1 %counted, label %change, label %exit\n",
        "change:\n",
        "  %before = atomicrmw add ptr %counter, i64 %delta acq_rel\n",
        "  %adding = icmp eq i64 %delta, 1\n",
        "  %limit = select i1 %adding, i64 -1, i64 0\n",
        "  %valid = icmp ne i64 %before, %limit\n",
        "  br i1 %valid, label %exit, label %trap\n",
        "trap:\n",
        "  call void @llvm.trap()\n",
        "  unreachable\n",
        "exit:\n",
        "  ret void\n",
        "}\n",
        "define internal ptr @chibi_managed.new(ptr %ctx, ptr %heap, i64 %bytes, ptr %layout, ptr %drop, i32 %storage) {\n",
        "entry:\n",
        "  %header = ptrtoint ptr getelementptr (%chibi.managed.cell, ptr null, i32 1) to i64\n",
        "  %room = sub i64 -1, %header\n",
        "  %fits = icmp ule i64 %bytes, %room\n",
        "  %used.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 3\n",
        "  %used = load i64, ptr %used.at\n",
        "  %total = add i64 %bytes, %header\n",
        "  %remaining = sub i64 -1, %used\n",
        "  %counts = icmp ule i64 %total, %remaining\n",
        "  %no.drop = icmp eq ptr %drop, null\n",
        "  %has.layout = icmp ne ptr %layout, null\n",
        "  %callbacks.owned = or i1 %no.drop, %has.layout\n",
        "  %sized = and i1 %fits, %counts\n",
        "  %valid = and i1 %sized, %callbacks.owned\n",
        "  br i1 %valid, label %allocate, label %trap\n",
        "allocate:\n",
        format_text("  %allocator.at = getelementptr {}, ptr %ctx, i32 0, i32 2\n", abi.ContextType()),
        "  %allocator = load ptr, ptr %allocator.at\n",
        "  %cell = call ptr %allocator(ptr %ctx, i64 %total)\n",
        "  store %chibi.managed.cell zeroinitializer, ptr %cell\n",
        "  %first = load ptr, ptr %heap\n",
        "  store ptr %first, ptr %cell\n",
        "  %layout.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 2\n",
        "  %drop.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 3\n",
        "  %size.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 4\n",
        "  store ptr %layout, ptr %layout.at\n",
        "  store ptr %drop, ptr %drop.at\n",
        "  store i64 %total, ptr %size.at\n",
        "  %owner.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 6\n",
        "  store ptr %heap, ptr %owner.at\n",
        "  %storage.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 7\n",
        "  store i32 %storage, ptr %storage.at\n",
        "  %payload = getelementptr %chibi.managed.cell, ptr %cell, i32 1\n",
        "  call void @llvm.memset.p0.i64(ptr %payload, i8 0, i64 %bytes, i1 false)\n",
        "  call void @chibi_managed.code(ptr %layout, i64 1)\n",
        "  store ptr %cell, ptr %heap\n",
        "  %next.used = add i64 %used, %total\n",
        "  store i64 %next.used, ptr %used.at\n",
        "  ret ptr %cell\n",
        "trap:\n",
        "  call void @llvm.trap()\n",
        "  unreachable\n",
        "}\n",
        "\n",
        "; Root nodes and their slots have stable addresses until the matching pop.\n",
        "; All slots are initialized before push; writes update the registered slot.\n",
        "define internal void @chibi_managed.push(ptr %heap, ptr %root, ptr %slot, ptr %trace) {\n",
        "entry:\n",
        "  %head = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 1\n",
        "  %old = load ptr, ptr %head\n",
        "  store ptr %old, ptr %root\n",
        "  %value.at = getelementptr %chibi.managed.root, ptr %root, i32 0, i32 1\n",
        "  %trace.at = getelementptr %chibi.managed.root, ptr %root, i32 0, i32 2\n",
        "  store ptr %slot, ptr %value.at\n",
        "  store ptr %trace, ptr %trace.at\n",
        "  store ptr %root, ptr %head\n",
        "  ret void\n",
        "}\n",
        "define internal void @chibi_managed.pop(ptr %heap, ptr %root) {\n",
        "entry:\n",
        "  %head = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 1\n",
        "  %old = load ptr, ptr %head\n",
        "  %same = icmp eq ptr %old, %root\n",
        "  br i1 %same, label %remove, label %trap\n",
        "remove:\n",
        "  %previous = load ptr, ptr %root\n",
        "  store ptr %previous, ptr %head\n",
        "  store %chibi.managed.root zeroinitializer, ptr %root\n",
        "  ret void\n",
        "trap:\n",
        "  call void @llvm.trap()\n",
        "  unreachable\n",
        "}\n",
        "\n",
        "; The cell header is its work-list node, so cycles and deep graphs allocate no\n",
        "; traversal memory and use no recursive collector stack.\n",
        "define internal void @chibi_managed.mark(ptr %heap, ptr %cell) {\n",
        "entry:\n",
        "  %empty = icmp eq ptr %cell, null\n",
        "  br i1 %empty, label %exit, label %check\n",
        "check:\n",
        "  %owner.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 6\n",
        "  %owner = load ptr, ptr %owner.at\n",
        "  %same.owner = icmp eq ptr %owner, %heap\n",
        "  br i1 %same.owner, label %owned, label %trap\n",
        "owned:\n",
        "  %marked.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 5\n",
        "  %marked = load i1, ptr %marked.at\n",
        "  br i1 %marked, label %exit, label %queue\n",
        "queue:\n",
        "  store i1 true, ptr %marked.at\n",
        "  %work.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 2\n",
        "  %old = load ptr, ptr %work.at\n",
        "  %next.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 1\n",
        "  store ptr %old, ptr %next.at\n",
        "  store ptr %cell, ptr %work.at\n",
        "  br label %exit\n",
        "exit:\n",
        "  ret void\n",
        "trap:\n",
        "  call void @llvm.trap()\n",
        "  unreachable\n",
        "}\n",
        "\n",
        "; Hold requires an unlinked node and an initialized stable slot until unhold.\n",
        "; Backlinks name the previous link, including the heap head, for O(1) removal.\n",
        "define internal void @chibi_managed.hold(ptr %heap, ptr %node, ptr %slot, ptr %trace) {\n",
        "entry:\n",
        "  %head.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 6\n",
        "  %head = load ptr, ptr %head.at\n",
        "  store ptr %head, ptr %node\n",
        "  %back.at = getelementptr %chibi.managed.persistent, ptr %node, i32 0, i32 1\n",
        "  %slot.at = getelementptr %chibi.managed.persistent, ptr %node, i32 0, i32 2\n",
        "  %trace.at = getelementptr %chibi.managed.persistent, ptr %node, i32 0, i32 3\n",
        "  store ptr %head.at, ptr %back.at\n",
        "  store ptr %slot, ptr %slot.at\n",
        "  store ptr %trace, ptr %trace.at\n",
        "  %has.head = icmp ne ptr %head, null\n",
        "  br i1 %has.head, label %link, label %publish\n",
        "link:\n",
        "  %head.back = getelementptr %chibi.managed.persistent, ptr %head, i32 0, i32 1\n",
        "  store ptr %node, ptr %head.back\n",
        "  br label %publish\n",
        "publish:\n",
        "  store ptr %node, ptr %head.at\n",
        "  ret void\n",
        "}\n",
        "define internal void @chibi_managed.unhold(ptr %node) {\n",
        "entry:\n",
        "  %back.at = getelementptr %chibi.managed.persistent, ptr %node, i32 0, i32 1\n",
        "  %back = load ptr, ptr %back.at\n",
        "  %held = icmp ne ptr %back, null\n",
        "  br i1 %held, label %remove, label %exit\n",
        "remove:\n",
        "  %next = load ptr, ptr %node\n",
        "  store ptr %next, ptr %back\n",
        "  %has.next = icmp ne ptr %next, null\n",
        "  br i1 %has.next, label %link, label %clear\n",
        "link:\n",
        "  %next.back = getelementptr %chibi.managed.persistent, ptr %next, i32 0, i32 1\n",
        "  store ptr %back, ptr %next.back\n",
        "  br label %clear\n",
        "clear:\n",
        "  store %chibi.managed.persistent zeroinitializer, ptr %node\n",
        "  br label %exit\n",
        "exit:\n",
        "  ret void\n",
        "}\n",
        "; Only quiescent code with complete spilled roots may call collect/safepoint.\n",
        "; Callbacks never allocate or collect and drop never follows managed edges.\n",
        "define internal void @chibi_managed.collect(ptr %ctx, ptr %heap) {\n",
        "entry:\n",
        "  %epoch.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 5\n",
        "  %old.epoch = load i64, ptr %epoch.at\n",
        "  %epoch = add i64 %old.epoch, 1\n",
        "  %wrapped = icmp eq i64 %epoch, 0\n",
        "  br i1 %wrapped, label %trap, label %start\n",
        "start:\n",
        "  store i64 %epoch, ptr %epoch.at\n",
        "  %roots.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 1\n",
        "  %first.root = load ptr, ptr %roots.at\n",
        "  br label %roots\n",
        "roots:\n",
        "  %root = phi ptr [ %first.root, %start ], [ %next.root, %trace.root ]\n",
        "  %roots.done = icmp eq ptr %root, null\n",
        "  br i1 %roots.done, label %persistent.start, label %trace.root\n",
        "trace.root:\n",
        "  %next.root = load ptr, ptr %root\n",
        "  %slot.at = getelementptr %chibi.managed.root, ptr %root, i32 0, i32 1\n",
        "  %root.trace.at = getelementptr %chibi.managed.root, ptr %root, i32 0, i32 2\n",
        "  %slot = load ptr, ptr %slot.at\n",
        "  %root.trace = load ptr, ptr %root.trace.at\n",
        "  call void %root.trace(ptr %heap, ptr %slot)\n",
        "  br label %roots\n",
        "persistent.start:\n",
        "  %persistent.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 6\n",
        "  %first.persistent = load ptr, ptr %persistent.at\n",
        "  br label %persistent\n",
        "persistent:\n",
        "  %held.root = phi ptr [ %first.persistent, %persistent.start ], [ %next.held, %trace.held ]\n",
        "  %held.done = icmp eq ptr %held.root, null\n",
        "  br i1 %held.done, label %work, label %trace.held\n",
        "trace.held:\n",
        "  %next.held = load ptr, ptr %held.root\n",
        "  %held.slot.at = getelementptr %chibi.managed.persistent, ptr %held.root, i32 0, i32 2\n",
        "  %held.trace.at = getelementptr %chibi.managed.persistent, ptr %held.root, i32 0, i32 3\n",
        "  %held.slot = load ptr, ptr %held.slot.at\n",
        "  %held.trace = load ptr, ptr %held.trace.at\n",
        "  call void %held.trace(ptr %heap, ptr %held.slot)\n",
        "  br label %persistent\n",
        "work:\n",
        "  %work.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 2\n",
        "  %cell = load ptr, ptr %work.at\n",
        "  %work.done = icmp eq ptr %cell, null\n",
        "  br i1 %work.done, label %sweep, label %take\n",
        "take:\n",
        "  %next.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 1\n",
        "  %next = load ptr, ptr %next.at\n",
        "  store ptr %next, ptr %work.at\n",
        "  store ptr null, ptr %next.at\n",
        "  %layout.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 2\n",
        "  %layout = load ptr, ptr %layout.at\n",
        "  %leaf = icmp eq ptr %layout, null\n",
        "  br i1 %leaf, label %work, label %trace.layout\n",
        "trace.layout:\n",
        "  %trace = load ptr, ptr %layout\n",
        "  %untraced = icmp eq ptr %trace, null\n",
        "  br i1 %untraced, label %work, label %trace.cell\n",
        "trace.cell:\n",
        "  %payload = getelementptr %chibi.managed.cell, ptr %cell, i32 1\n",
        "  call void %trace(ptr %heap, ptr %payload)\n",
        "  br label %work\n",
        "sweep:\n",
        "  br label %cells\n",
        "cells:\n",
        "  %link = phi ptr [ %heap, %sweep ], [ %cell.next, %keep ], [ %link, %release ]\n",
        "  %current = load ptr, ptr %link\n",
        "  %done = icmp eq ptr %current, null\n",
        "  br i1 %done, label %exit, label %inspect\n",
        "inspect:\n",
        "  %mark.at = getelementptr %chibi.managed.cell, ptr %current, i32 0, i32 5\n",
        "  %live = load i1, ptr %mark.at\n",
        "  br i1 %live, label %keep, label %discard\n",
        "keep:\n",
        "  store i1 false, ptr %mark.at\n",
        "  %cell.next = getelementptr %chibi.managed.cell, ptr %current, i32 0, i32 0\n",
        "  br label %cells\n",
        "discard:\n",
        "  %following = load ptr, ptr %current\n",
        "  store ptr %following, ptr %link\n",
        "  %drop.at = getelementptr %chibi.managed.cell, ptr %current, i32 0, i32 3\n",
        "  %drop = load ptr, ptr %drop.at\n",
        "  %plain = icmp eq ptr %drop, null\n",
        "  br i1 %plain, label %release, label %drop.cell\n",
        "drop.cell:\n",
        "  %value = getelementptr %chibi.managed.cell, ptr %current, i32 1\n",
        "  call void %drop(ptr %ctx, ptr %value)\n",
        "  br label %release\n",
        "release:\n",
        "  %discard.layout.at = getelementptr %chibi.managed.cell, ptr %current, i32 0, i32 2\n",
        "  %discard.layout = load ptr, ptr %discard.layout.at\n",
        "  call void @chibi_managed.code(ptr %discard.layout, i64 -1)\n",
        "  %size.at = getelementptr %chibi.managed.cell, ptr %current, i32 0, i32 4\n",
        "  %size = load i64, ptr %size.at\n",
        "  %used.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 3\n",
        "  %used = load i64, ptr %used.at\n",
        "  %left = sub i64 %used, %size\n",
        "  store i64 %left, ptr %used.at\n",
        format_text("  %release.at = getelementptr {}, ptr %ctx, i32 0, i32 4\n", abi.ContextType()),
        "  %free = load ptr, ptr %release.at\n",
        "  call void %free(ptr %ctx, ptr %current)\n",
        "  br label %cells\n",
        "exit:\n",
        "  %kept.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 3\n",
        "  %kept = load i64, ptr %kept.at\n",
        "  %doubled = shl i64 %kept, 1\n",
        "  %overflow = icmp ult i64 %doubled, %kept\n",
        "  %bounded = select i1 %overflow, i64 -1, i64 %doubled\n",
        "  %large = icmp ugt i64 %bounded, 65536\n",
        "  %threshold = select i1 %large, i64 %bounded, i64 65536\n",
        "  %threshold.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 4\n",
        "  store i64 %threshold, ptr %threshold.at\n",
        "  ret void\n",
        "trap:\n",
        "  call void @llvm.trap()\n",
        "  unreachable\n",
        "}\n",
        "define internal void @chibi_managed.safepoint(ptr %ctx, ptr %heap) {\n",
        "entry:\n",
        "  %used.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 3\n",
        "  %used = load i64, ptr %used.at\n",
        "  %threshold.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 4\n",
        "  %configured = load i64, ptr %threshold.at\n",
        "  %set = icmp ugt i64 %configured, 65536\n",
        "  %threshold = select i1 %set, i64 %configured, i64 65536\n",
        "  %due = icmp uge i64 %used, %threshold\n",
        "  br i1 %due, label %collect, label %exit\n",
        "collect:\n",
        "  call void @chibi_managed.collect(ptr %ctx, ptr %heap)\n",
        "  br label %exit\n",
        "exit:\n",
        "  ret void\n",
        "}\n"
    ], "");
}

// Only standalone ProgramMode emits these helpers. The legacy five-field
// context does not supply a collector owner, so generic bundles reject them.
ManagedPointerRuntime :: () -> string {
    text := strings.Join([
        "define internal ptr @chibi_managed.owner(ptr %ctx) {\n",
        "entry:\n",
        "  %at = getelementptr $C, ptr %ctx, i32 0, i32 $F\n",
        "  %heap = load ptr, ptr %at\n",
        "  %valid = icmp ne ptr %heap, null\n",
        "  br i1 %valid, label %exit, label %trap\n",
        "exit:\n",
        "  ret ptr %heap\n",
        "trap:\n",
        "  call void @llvm.trap()\n",
        "  unreachable\n",
        "}\n",
        "; The descriptor's stable semantic tag is checked before touching its value.\n",
        "; Offset/size checks also make the eventual field projection use this path.\n",
        "define internal ptr @chibi_managed.address(ptr %heap, $P %value, i64 %wanted, i64 %bytes, i32 %storage) {\n",
        "entry:\n",
        "  %cell = extractvalue $P %value, 0\n",
        "  %offset = extractvalue $P %value, 1\n",
        "  %identity = extractvalue $P %value, 2\n",
        "  %absent = icmp eq ptr %cell, null\n",
        "  br i1 %absent, label %bad, label %validate\n",
        "validate:\n",
        "  %owner.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 6\n",
        "  %owner = load ptr, ptr %owner.at\n",
        "  %owned = icmp eq ptr %owner, %heap\n",
        "  %typed = icmp eq i64 %identity, %wanted\n",
        "  %valid.identity = icmp ne i64 %identity, 0\n",
        "  %storage.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 7\n",
        "  %actual.storage = load i32, ptr %storage.at\n",
        "  %storage.ok = icmp eq i32 %actual.storage, %storage\n",
        "  %layout.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 2\n",
        "  %layout = load ptr, ptr %layout.at\n",
        "  %size.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 4\n",
        "  %allocation = load i64, ptr %size.at\n",
        "  %header = ptrtoint ptr getelementptr (%chibi.managed.cell, ptr null, i32 1) to i64\n",
        "  %size = sub i64 %allocation, %header\n",
        "  %fits = icmp ule i64 %bytes, %size\n",
        "  %available = sub i64 %size, %bytes\n",
        "  %inside = icmp ule i64 %offset, %available\n",
        "  %range = and i1 %fits, %inside\n",
        "  %identity.ok = and i1 %typed, %valid.identity\n",
        "  %typed.owner = and i1 %owned, %identity.ok\n",
        "  %valid = and i1 %typed.owner, %range\n",
        "  br i1 %valid, label %layout.check, label %bad\n",
        "layout.check:\n",
        "  %plain = icmp eq ptr %layout, null\n",
        "  br i1 %plain, label %scalar.check, label %typed.check\n",
        "scalar.check:\n",
        "  br i1 %storage.ok, label %resolve, label %bad\n",
        "typed.check:\n",
        "  %check.at = getelementptr %chibi.managed.layout, ptr %layout, i32 0, i32 1\n",
        "  %check = load ptr, ptr %check.at\n",
        "  %checked = icmp ne ptr %check, null\n",
        "  br i1 %checked, label %validate.layout, label %bad\n",
        "validate.layout:\n",
        "  %permitted = call i1 %check(i64 %offset, i64 %wanted, i64 %bytes, i32 %storage)\n",
        "  br i1 %permitted, label %resolve, label %bad\n",
        "resolve:\n",
        "  %payload = getelementptr %chibi.managed.cell, ptr %cell, i32 1\n",
        "  %address = getelementptr i8, ptr %payload, i64 %offset\n",
        "  ret ptr %address\n",
        "bad:\n",
        "  call void @chibi_native_failure(i32 0)\n",
        "  unreachable\n",
        "}\n"
    ], "");
    text = strings.ReplaceAll(text, "$C", abi.ManagedContextType());
    text = strings.ReplaceAll(text, "$F", format_text("{}", abi.ManagedOwnerField));
    text = strings.ReplaceAll(text, "$P", abi.ManagedPointerType());
    return strings.Concatenate([text, ManagedTraceRuntime()]);
}

ManagedStorage :: (type: int) -> bool {
    return type == PointerType || type == ArrayType + PointerType;
}
ManagedTypes :: (types: int[]) -> bool {
    for (type in types) {
        if (ManagedStorage(type) || (type >= RefType && ManagedStorage(type - RefType))) { return true; }
    }
    return false;
}
// All roots refer to initialized stable slots. Plain functions pay nothing;
// suspended frames attach their persistent roots after coroutine allocation.
ManagedRoots :: (shape: Function, slots: int[], locals: int[], traced: bool[]) -> string {
    output: string[] = ["  %managed.heap = call ptr @chibi_managed.owner(ptr %ctx)\n",
        "  %managed.head = getelementptr %chibi.managed.heap, ptr %managed.heap, i32 0, i32 1\n",
        "  %managed.previous = load ptr, ptr %managed.head\n"];
    for (part in [int(0), 1]) {
        first := shape.first_slot;
        count := shape.slots;
        prefix := "s";
        types := slots;
        if (part == 1) { first = shape.first_local; count = shape.locals; prefix = "l"; types = locals; }
        for (index in 0..<count) {
            type := types[first + index];
            // Only GC releases cells, so scalar pointer snapshots are safe
            // roots. Array reads may borrow freed backing; explicit pins
            // instead cover actual owning places across collecting calls.
            if (type != PointerType && !ManagedTraced(type, traced)) { continue; }
            trace := "pointer";
            if (type != PointerType) { trace = format_text("record{}", type - RecordType); }
            output.append(Store(Zero(type), type, prefix, index));
            output.append(format_text("  %managed.{}{} = alloca %chibi.managed.root\n", prefix, index));
            output.append(format_text("  call void @chibi_managed.push(ptr %managed.heap, ptr %managed.{}{}, ptr %{}{}, ptr @chibi_managed.trace.{})\n",
                                      prefix, index, prefix, index, trace));
        }
    }
    return strings.Join(output, "");
}
// The nodes and their slots are used by attach and release across suspension,
// so coroutine lowering puts them in the stable heap frame, not the ramp stack.
ManagedFrameRoots :: struct { prologue: string; attach: string; cleanup: string; }
ManagedFrame :: (shape: Function, slots: int[], locals: int[]) -> ManagedFrameRoots {
    prologue: string[] = ["  %managed.heap = call ptr @chibi_managed.owner(ptr %ctx)\n"];
    attach: string[] = [];
    cleanup: string[] = [];
    for (part in [int(0), 1]) {
        first := shape.first_slot;
        count := shape.slots;
        prefix := "s";
        types := slots;
        if (part == 1) { first = shape.first_local; count = shape.locals; prefix = "l"; types = locals; }
        for (index in 0..<count) {
            if (types[first + index] != PointerType) { continue; }
            prologue.append(Store(Zero(PointerType), PointerType, prefix, index));
            prologue.append(format_text("  %managed.{}{} = alloca %chibi.managed.persistent\n  store %chibi.managed.persistent zeroinitializer, ptr %managed.{}{}\n", prefix, index, prefix, index));
            attach.append(format_text("  call void @chibi_managed.hold(ptr %managed.heap, ptr %managed.{}{}, ptr %{}{}, ptr @chibi_managed.trace.pointer)\n", prefix, index, prefix, index));
            cleanup.append(format_text("  call void @chibi_managed.unhold(ptr %managed.{}{})\n", prefix, index));
        }
    }
    return {prologue: strings.Join(prologue, ""), attach: strings.Join(attach, ""), cleanup: strings.Join(cleanup, "")};
}
// A cancelled/failed continuation can bypass unpin. Each active pin names
// exactly one owned array descriptor; clear it before dropping that owner.
ManagedFramePins :: (shape: Function, code: Instruction[], prefix: string) -> string {
    output: string[] = [];
    array := ArrayType + PointerType;
    for (pc in 0..<shape.code) {
        item := code[shape.first_code + pc];
        if (item.op != ManagedPin) { continue; }
        id := item.right;
        output.append(format_text("  %{}.back{} = getelementptr %chibi.managed.persistent, ptr %managed.pin{}, i32 0, i32 1\n", prefix, id, id));
        output.append(format_text("  %{}.held{} = load ptr, ptr %{}.back{}\n  %{}.active{} = icmp ne ptr %{}.held{}, null\n", prefix, id, prefix, id, prefix, id, prefix, id));
        output.append(format_text("  br i1 %{}.active{}, label %{}.drop{}, label %{}.next{}\n{}.drop{}:\n", prefix, id, prefix, id, prefix, id, prefix, id));
        output.append(format_text("  %{}.slot.at{} = getelementptr %chibi.managed.persistent, ptr %managed.pin{}, i32 0, i32 2\n  %{}.slot{} = load ptr, ptr %{}.slot.at{}\n", prefix, id, id, prefix, id, prefix, id));
        output.append(format_text("  %{}.value{} = load {}, ptr %{}.slot{}\n  store {} zeroinitializer, ptr %{}.slot{}\n", prefix, id, TypeName(array), prefix, id, TypeName(array), prefix, id));
        output.append(format_text("  call void @chibi_managed.unhold(ptr %managed.pin{})\n  call void @chibi_array.{}.drop(ptr %ctx, {} %{}.value{})\n  br label %{}.next{}\n{}.next{}:\n", id, array, TypeName(array), prefix, id, prefix, id, prefix, id));
    }
    return strings.Join(output, "");
}
ManagedUnroots :: (is_entry: bool) -> string {
    // Restoring the frame boundary also removes transient pins when a failed
    // call bypassed its normal unpin instructions.
    output := "  store ptr %managed.previous, ptr %managed.head\n";
    if (is_entry) { output = strings.Concatenate([output, "  call void @chibi_managed.collect(ptr %ctx, ptr %managed.heap)\n"]); }
    return output;
}
ManagedInstruction :: (item: Instruction, pc: int, records: Record[], persistent: bool) -> string {
    out := format_text("p{}:\n", pc);
    if (item.op == ManagedNew) {
        out = format_text("{}  call void @chibi_managed.safepoint(ptr %ctx, ptr %managed.heap)\n", out);
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.right, "s", item.left));
        out = format_text("{}{}", out, Sized(format_text("bytes{}", pc), item.right));
        layout := "null";
        drop := "null";
        value := format_text("%a{}", pc);
        if (ManagedArray(item.right)) {
            layout = format_text("@chibi_managed.layout.array{}.{}", item.right, item.literal);
            drop = format_text("@chibi_managed.drop.array{}", item.right);
            out = format_text("{}  %owned{} = call {} @chibi_array.{}.copy(ptr %ctx, {} %a{})\n", out, pc, TypeName(item.right), item.right, TypeName(item.right), pc);
            value = format_text("%owned{}", pc);
        } else if (item.right >= RecordType) { layout = format_text("@chibi_managed.layout{}", item.right - RecordType); }
        out = format_text("{}  %cell{} = call ptr @chibi_managed.new(ptr %ctx, ptr %managed.heap, i64 %bytes{}, ptr {}, ptr {}, i32 {})\n", out, pc, pc, layout, drop, ManagedStorageClass(item.right));
        out = format_text("{}  %payload{} = getelementptr %chibi.managed.cell, ptr %cell{}, i32 1\n", out, pc, pc);
        out = format_text("{}  store {} {}, ptr %payload{}\n", out, TypeName(item.right), value, pc);
        pointer := abi.ManagedPointerType();
        out = format_text("{}  %root{} = insertvalue {} zeroinitializer, ptr %cell{}, 0\n", out, pc, pointer, pc);
        out = format_text("{}  %value{} = insertvalue {} %root{}, i64 {}, 2\n", out, pc, pointer, pc, item.literal);
        out = format_text("{}{}", out, Store(format_text("%value{}", pc), PointerType, "s", item.output));
    } else if (item.op == ManagedAddress) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), PointerType, "s", item.left));
        out = format_text("{}{}", out, Sized(format_text("bytes{}", pc), item.type - RefType));
        out = format_text("{}  %address{} = call ptr @chibi_managed.address(ptr %managed.heap, {} %a{}, i64 {}, i64 %bytes{}, i32 {})\n",
                          out, pc, abi.ManagedPointerType(), pc, item.literal, pc, ManagedStorageClass(item.type - RefType));
        out = format_text("{}{}", out, Store(format_text("%address{}", pc), item.type, "s", item.output));
    } else if (item.op == ManagedProject) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), PointerType, "s", item.left));
        out = format_text("{}{}", out, Sized(format_text("bytes{}", pc), item.right));
        out = format_text("{}  %address{} = call ptr @chibi_managed.address(ptr %managed.heap, {} %a{}, i64 {}, i64 %bytes{}, i32 {})\n",
                          out, pc, abi.ManagedPointerType(), pc, records[item.right - RecordType].identity, pc, RecordType);
        out = format_text("{}  %offset{} = extractvalue {} %a{}, 1\n", out, pc, abi.ManagedPointerType(), pc);
        out = format_text("{}  %field.offset{} = add i64 %offset{}, ptrtoint (ptr getelementptr ({}, ptr null, i32 0, i32 {}) to i64)\n", out, pc, pc, TypeName(item.right), item.target);
        out = format_text("{}  %field{} = insertvalue {} %a{}, i64 %field.offset{}, 1\n", out, pc, abi.ManagedPointerType(), pc, pc);
        out = format_text("{}  %projected{} = insertvalue {} %field{}, i64 {}, 2\n", out, pc, abi.ManagedPointerType(), pc, item.literal);
        out = format_text("{}{}", out, Store(format_text("%projected{}", pc), PointerType, "s", item.output));
    } else if (item.op == ManagedPin) {
        address := format_text("%s{}", item.left);
        if (item.target == 1) {
            out = format_text("{}{}", out, Load(format_text("pin{}", pc), item.type, "s", item.left));
            address = format_text("%pin{}", pc);
        }
        operation := "push";
        if (persistent) { operation = "hold"; }
        out = format_text("{}  call void @chibi_managed.{}(ptr %managed.heap, ptr %managed.pin{}, ptr {}, ptr @chibi_managed.trace.array)\n",
                          out, operation, item.right, address);
    } else {
        if (persistent) { out = format_text("{}  call void @chibi_managed.unhold(ptr %managed.pin{})\n", out, item.right); }
        else { out = format_text("{}  call void @chibi_managed.pop(ptr %managed.heap, ptr %managed.pin{})\n", out, item.right); }
    }
    return format_text("{}  br label %p{}\n", out, pc + 1);
}

ManagedTraceRuntime :: () -> string {
    text := strings.Join([
        "define internal void @chibi_managed.trace.pointer(ptr %heap, ptr %slot) {\n",
        "entry:\n",
        "  %value = load $P, ptr %slot\n",
        "  %cell = extractvalue $P %value, 0\n",
        "  call void @chibi_managed.mark(ptr %heap, ptr %cell)\n",
        "  ret void\n",
        "}\n",
        "define internal void @chibi_managed.array.owner(ptr %ctx, ptr %owner) {\n",
        "entry:\n",
        "  %absent = icmp eq ptr %owner, null\n",
        "  br i1 %absent, label %exit, label %validate\n",
        "validate:\n",
        "  %owner.at = getelementptr i8, ptr %owner, i64 $O\n",
        "  %actual = load ptr, ptr %owner.at\n",
        "  %heap = call ptr @chibi_managed.owner(ptr %ctx)\n",
        "  %same = icmp eq ptr %actual, %heap\n",
        "  br i1 %same, label %exit, label %bad\n",
        "bad:\n",
        "  call void @chibi_native_failure(i32 0)\n",
        "  unreachable\n",
        "exit:\n",
        "  ret void\n",
        "}\n",
        "define internal void @chibi_managed.trace.array(ptr %heap, ptr %slot) {\n",
        "entry:\n",
        "  %value = load $A, ptr %slot\n",
        "  %data = extractvalue $A %value, 2\n",
        "  %count = extractvalue $A %value, 0\n",
        "  %owner = extractvalue $A %value, 3\n",
        "  %borrowed = icmp eq ptr %owner, null\n",
        "  br i1 %borrowed, label %scan, label %validate\n",
        "validate:\n",
        "  %owner.at = getelementptr i8, ptr %owner, i64 $O\n",
        "  %actual = load ptr, ptr %owner.at\n",
        "  %same = icmp eq ptr %actual, %heap\n",
        "  br i1 %same, label %epoch, label %bad\n",
        "epoch:\n",
        "  %epoch.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 5\n",
        "  %current = load i64, ptr %epoch.at\n",
        "  %previous.at = getelementptr i8, ptr %owner, i64 $E\n",
        "  %previous = load i64, ptr %previous.at\n",
        "  %traced = icmp eq i64 %previous, %current\n",
        "  br i1 %traced, label %exit, label %remember\n",
        "remember:\n",
        "  store i64 %current, ptr %previous.at\n",
        "  br label %scan\n",
        "scan:\n",
        "  br label %items\n",
        "items:\n",
        "  %index = phi i32 [ 0, %scan ], [ %next, %trace ]\n",
        "  %done = icmp eq i32 %index, %count\n",
        "  br i1 %done, label %exit, label %trace\n",
        "trace:\n",
        "  %wide = zext i32 %index to i64\n",
        "  %at = getelementptr $P, ptr %data, i64 %wide\n",
        "  call void @chibi_managed.trace.pointer(ptr %heap, ptr %at)\n",
        "  %next = add i32 %index, 1\n",
        "  br label %items\n",
        "bad:\n",
        "  call void @chibi_native_failure(i32 0)\n",
        "  unreachable\n",
        "exit:\n",
        "  ret void\n",
        "}\n"
    ], "");
    text = strings.ReplaceAll(text, "$A", abi.ArrayType());
    text = strings.ReplaceAll(text, "$P", abi.ManagedPointerType());
    text = strings.ReplaceAll(text, "$O", format_text("{}", abi.ManagedArrayOwnerOffset));
    return strings.ReplaceAll(text, "$E", format_text("{}", abi.ManagedArrayEpochOffset));
}

ManagedPinsValid :: (code: Instruction[], slots: int[]) -> string {
    seen := resize([false], length(code));
    interior := resize([false], length(code));
    active: int[] = [];
    called := false;
    for (pc in 0..<length(code)) {
        item := code[pc];
        interior[pc] = length(active) > 0;
        if (item.op == ManagedPin) {
            array := ArrayType + PointerType;
            wanted := array;
            if (item.target == 1) { wanted += RefType; }
            if (called || item.type != wanted || !Typed(slots, item.left, wanted) ||
                item.target < 0 || item.target > 1 || item.output != 0 || item.literal != 0 ||
                !Index(item.right, length(code)) || seen[item.right]) {
                return "native collector pin differs from its owning array place";
            }
            seen[item.right] = true;
            active.append(item.right);
        } else if (item.op == ManagedUnpin) {
            if (!called || length(active) == 0 || active[length(active) - 1] != item.right ||
                item.type != 0 || item.output != 0 || item.left != 0 || item.target != 0 || item.literal != 0) {
                return "native collector pins must close in reverse order";
            }
            active = slice(active, 0, length(active) - 1);
            if (length(active) == 0) { called = false; }
        } else if (length(active) > 0) {
            if (called || (item.op != ClockSample && item.op != Call && item.op != ForeignCall && item.op != ManagedNew && item.op != Suspend && item.op != Delay && item.op != AwaitHandle && item.op != AwaitResult && item.op != Fail)) {
                return "native collector pins must bracket one collecting call";
            }
            called = true;
        }
    }
    if (length(active) > 0) { return "native collector pins must close before control flow leaves"; }
    for (item in code) {
        if ((item.op == Jump || item.op == Branch) && interior[item.target]) {
            return "native control flow cannot enter a collector pin region";
        }
    }
    return "";
}

ManagedComparison :: (item: Instruction, pc: int) -> string {
    out := Load(format_text("a{}", pc), PointerType, "s", item.left);
    out = format_text("{}{}", out, Load(format_text("b{}", pc), PointerType, "s", item.right));
    type := abi.ManagedPointerType();
    out = format_text("{}  %ar{} = extractvalue {} %a{}, 0\n  %br{} = extractvalue {} %b{}, 0\n", out, pc, type, pc, pc, type, pc);
    out = format_text("{}  %ao{} = extractvalue {} %a{}, 1\n  %bo{} = extractvalue {} %b{}, 1\n", out, pc, type, pc, pc, type, pc);
    out = format_text("{}  %same.root{} = icmp eq ptr %ar{}, %br{}\n", out, pc, pc, pc);
    out = format_text("{}  %same.offset{} = icmp eq i64 %ao{}, %bo{}\n", out, pc, pc, pc);
    out = format_text("{}  %same{} = and i1 %same.root{}, %same.offset{}\n", out, pc, pc, pc);
    value := format_text("%same{}", pc);
    if (item.op == Ne) {
        out = format_text("{}  %different{} = xor i1 %same{}, true\n", out, pc, pc);
        value = format_text("%different{}", pc);
    }
    return strings.Concatenate([out, Store(value, abi.BoolStorage, "s", item.output)]);
}

// Only the family adapter exports these hooks. A raw C/library bundle keeps
// its five-pointer context and cannot adopt managed cells accidentally.
ManagedFamilySymbols :: (runtime: bool, managed: bool) -> string {
    out: string[] = [format_text("\n@{} = external hidden global i64\n", abi.ManagedImageCounter())];
    if (!managed) { out.append(format_text("%chibi.managed.heap = type {}\n", abi.ManagedHeapType())); }
    out.append(format_text("define i64 @chibi_host_family_abi() {{\n  ret i64 {}\n}}\n", abi.ManagedFamilyABI));
    out.append("define i64 @chibi_host_family_size() {\n  %size = ptrtoint ptr getelementptr (%chibi.managed.heap, ptr null, i32 1) to i64\n  ret i64 %size\n}\n");
    out.append(format_text("define i64 @chibi_host_cells_pending() {{\n  %count = load atomic i64, ptr @{} acquire, align 8\n  ret i64 %count\n}}\n", abi.ManagedImageCounter()));
    out.append("define i32 @chibi_host_set_family(ptr %heap) {\nentry:\n  %present = icmp ne ptr %heap, null\n  br i1 %present, label %adopt, label %invalid\ninvalid:\n  ret i32 1\nadopt:\n");
    if (runtime) {
        out.append(format_text("  %at = getelementptr {}, ptr @chibi_context, i32 0, i32 {}\n", abi.ManagedContextType(), abi.ManagedOwnerField));
        out.append("  %old = load ptr, ptr %at\n  %empty = icmp eq ptr %old, null\n  %same = icmp eq ptr %old, %heap\n  %allowed = or i1 %empty, %same\n  br i1 %allowed, label %store, label %invalid\nstore:\n  store ptr %heap, ptr %at\n");
    }
    out.append("  ret i32 0\n}\n");
    out.append("define i32 @chibi_host_family_collect() {\n");
    if (managed) {
        out.append(format_text("  %at = getelementptr {}, ptr @chibi_context, i32 0, i32 {}\n", abi.ManagedContextType(), abi.ManagedOwnerField));
        out.append("  %heap = load ptr, ptr %at\n  %present = icmp ne ptr %heap, null\n  br i1 %present, label %collect, label %invalid\ninvalid:\n  ret i32 2\ncollect:\n  call void @chibi_managed.collect(ptr @chibi_context, ptr %heap)\n  ret i32 0\n");
    } else { out.append("  ret i32 1\n"); }
    out.append("}\n");
    return strings.Join(out, "");
}
