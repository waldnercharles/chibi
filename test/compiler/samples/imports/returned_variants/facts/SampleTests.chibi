package facts

// returned variants
@test
Calls :: () {
    r1: int = Total();
    e1: int = 241;
    assert(r1 == e1, "Total call 1");
    r2: int = Changed();
    e2: int = 17;
    assert(r2 == e2, "Changed call 2");
    a3_0: int[] = [5, 6];
    r3: int = CopiedHold(a3_0);
    e3: int = 5;
    assert(r3 == e3, "CopiedHold call 3");
}
