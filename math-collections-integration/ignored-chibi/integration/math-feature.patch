+++ b/packages/core/math/Math.chibi
@@ -0,0 +1,135 @@
+package math
+
+// Scalar number/f32 math. The recovered candidate remains held from SDK
+// shipping pending the current compiler, package and installed-SDK checks.
+// See docs/core-math.md. These functions use scalar values and retain no state.
+//
+// Interpolation and angle conventions reference Odin core:math at
+// 7e313bd6f1fa9ae887c7b522611481cbf2da4cac. This is an altered implementation.
+// Copyright (c) 2016-2025 Ginger Bill. All rights reserved.
+//
+// This software is provided 'as-is', without any express or implied
+// warranty. In no event will the authors be held liable for any damages
+// arising from the use of this software.
+//
+// Permission is granted to anyone to use this software for any purpose,
+// including commercial applications, and to alter it and redistribute it
+// freely, subject to the following restrictions:
+// 1. The origin of this software must not be misrepresented; you must not
+//    claim that you wrote the original software. If you use this software
+//    in a product, an acknowledgment in the product documentation would be
+//    appreciated but is not required.
+// 2. Altered source versions must be plainly marked as such, and must not be
+//    misrepresented as being the original software.
+// 3. This notice may not be removed or altered from any source distribution.
+
+// NaN and both infinities return false. Signed zero and subnormals are finite.
+pub IsFinite :: (value: number) -> bool {
+    return value >= -3.40282346638528859811704183484516925440e38 &&
+           value <= 3.40282346638528859811704183484516925440e38;
+}
+
+// Unclamped interpolation. Each operation rounds to number/f32 separately;
+// subtraction overflow and nonfinite operands follow floating arithmetic.
+pub Lerp :: (start: number, end: number, fraction: number) -> number {
+    span := end - start;
+    offset := span * fraction;
+    return start + offset;
+}
+
+// Returns the unclamped fraction of the range from start to end at value.
+// Every operation uses number/f32, including subtraction overflow.
+// Equal endpoints and nonfinite inputs follow ordinary floating arithmetic.
+pub InverseLerp :: (start: number, end: number, value: number) -> number {
+    return (value - start) / (end - start);
+}
+
+// Maps one range into another without clamping or a degenerate-range fallback.
+pub Remap :: (value: number, old_min: number, old_max: number, new_min: number, new_max: number) -> number {
+    return Lerp(new_min, new_max, InverseLerp(old_min, old_max, value));
+}
+
+// Value precedes edge, matching the retired behavior native's input order.
+// The result is 0 below the edge and 1 otherwise, including an unordered NaN.
+pub Step :: (value: number, edge: number) -> number {
+    if (value < edge) {
+        return 0;
+    }
+    return 1;
+}
+
+// Cubic progress easing, clamped to 0..1. Nonfinite input is invalid.
+pub SmoothStep :: (value: number) -> number {
+    assert(IsFinite(value), "SmoothStep needs a finite value");
+    if (value <= 0) {
+        return 0;
+    }
+    if (value >= 1) {
+        return 1;
+    }
+    return value * value * (3 - 2 * value);
+}
+
+// Rounds to a multiple of step, with half steps rounded away from zero.
+// Both operands and the result must be finite, and step must be nonzero.
+pub QuantizeAngle :: (angle: number, step: number) -> number {
+    assert(IsFinite(angle) && IsFinite(step) && step != 0,
+           "QuantizeAngle needs a finite angle and a finite nonzero step");
+    result := round(angle / step) * step;
+    assert(IsFinite(result), "QuantizeAngle produced nonfinite output");
+    return result;
+}
+
+// Interpolates through the shortest angular difference in radians. At a
+// half turn the negative direction wins. The result remains near start;
+// it is not normalized, and fraction may extrapolate beyond 0..1.
+// f64 intermediates keep the subtraction of finite number angles finite.
+pub AngleLerp :: (start: number, end: number, fraction: number) -> number {
+    assert(IsFinite(start) && IsFinite(end) && IsFinite(fraction),
+           "AngleLerp needs finite inputs");
+    if (fraction == 0) {
+        return start;
+    }
+    pi: f64 = 3.14159265358979323846264338327950288;
+    tau := 2 * pi;
+    distance := fmod(f64(end) - f64(start), tau);
+    if (distance < 0) {
+        distance += tau;
+    }
+    if (distance >= pi) {
+        distance -= tau;
+    }
+    result := number(f64(start) + distance * f64(fraction));
+    assert(IsFinite(result), "AngleLerp produced nonfinite output");
+    return result;
+}
+
+// 1-exp(-x) for nonnegative x. The polynomial avoids cancellation near zero;
+// its omitted term is below 9e-18 at the branch boundary.
+DecayFraction :: (x: f64) -> f64 {
+    if (x < 0.001) {
+        return x * (1 - x * (0.5 - x * (0.16666666666666666667 - x * 0.04166666666666666667)));
+    }
+    return 1 - exp(-x);
+}
+
+// First-order exponential following, using elapsed seconds and a decay rate
+// per second. Nonpositive rate or elapsed time leaves current unchanged.
+// A fixed target's distance decays exponentially; no velocity is retained.
+// This is the relation used by Bevy StableInterpolate::smooth_nudge, computed
+// here with f64 intermediates to retain small steps and avoid span overflow.
+pub Damp :: (current: number, target: number, decay_rate: number, elapsed: number) -> number {
+    assert(IsFinite(current) && IsFinite(target) && IsFinite(decay_rate) && IsFinite(elapsed),
+           "Damp needs finite inputs");
+    if (decay_rate <= 0 || elapsed <= 0 || current == target) {
+        return current;
+    }
+    decay := f64(decay_rate) * f64(elapsed);
+    if (decay < 0.693147180559945309417232121458176568) {
+        fraction := DecayFraction(decay);
+        return number(f64(current) + (f64(target) - f64(current)) * fraction);
+    }
+    // Reconstruct from the nearer endpoint. Subtracting exp(-decay) from 1
+    // can round to 1 while a large initial distance still has a finite tail.
+    return number(f64(target) + (f64(current) - f64(target)) * exp(-decay));
+}
diff --git a/packages/core/math/MathTests.chibi b/packages/core/math/MathTests.chibi
new file mode 100644
index 0000000000000000000000000000000000000000..dfa233917279169222e7738d9e458e619a9ae65f
--- /dev/null
+++ b/packages/core/math/MathTests.chibi
@@ -0,0 +1,144 @@
+package math
+
+MathClose :: (actual: number, expected: number, tolerance: number) -> bool {
+    return actual >= expected - tolerance && actual <= expected + tolerance;
+}
+
+@test
+RangeFractionsPreserveOrientationAndExtrapolation :: () {
+    assert(InverseLerp(2, 6, 2) == 0, "range start");
+    assert(InverseLerp(2, 6, 3) == 0.25, "quarter of the range");
+    assert(InverseLerp(2, 6, 6) == 1, "range end");
+    assert(InverseLerp(6, 2, 3) == 0.75, "reversed range orientation");
+    assert(InverseLerp(2, 6, 0) == -0.5, "below range");
+    assert(InverseLerp(2, 6, 8) == 1.5, "above range");
+    assert(InverseLerp(-1, 16777216, 16777215) == 1,
+           "range arithmetic stays single precision");
+}
+
+@test
+InterpolationAndRemappingUseUnclampedFractions :: () {
+    assert(Lerp(2, 6, 0) == 2, "start fraction");
+    assert(Lerp(2, 6, 0.25) == 3, "quarter interpolation");
+    assert(Lerp(6, 2, 0.75) == 3, "reversed interpolation");
+    assert(Lerp(2, 6, -0.5) == 0, "negative fraction extrapolates");
+    assert(Lerp(2, 6, 1.5) == 8, "fraction past one extrapolates");
+    assert(Remap(25, 0, 100, 10, 30) == 15, "quarter of a shifted output range");
+    assert(Remap(25, 100, 0, 10, 30) == 25, "reversed input range");
+    assert(Remap(125, 0, 100, 10, 30) == 35, "mapping extrapolates");
+}
+
+@test
+StepIncludesItsEdge :: () {
+    assert(Step(0.5, 1) == 0, "below edge");
+    assert(Step(1, 1) == 1, "edge belongs to the upper side");
+    assert(Step(1.5, 1) == 1, "above edge");
+    assert(Step(-1, 0) == 0 && Step(0, -1) == 1, "value precedes edge");
+}
+
+@test
+SmoothStepClampsAndEasesProgress :: () {
+    assert(SmoothStep(-1) == 0 && SmoothStep(0) == 0, "lower endpoint clamp");
+    assert(SmoothStep(1) == 1 && SmoothStep(2) == 1, "upper endpoint clamp");
+    assert(SmoothStep(0.5) == 0.5, "symmetric midpoint");
+    assert(SmoothStep(0.25) == 0.15625, "known cubic quarter");
+    assert(SmoothStep(0.75) == 0.84375, "known cubic three quarters");
+    assert(SmoothStep(0.125) < 0.125 && SmoothStep(0.875) > 0.875,
+           "endpoints ease more slowly than linear progress");
+    prior: number = 0;
+    index: int = 1;
+    while (index <= 16) {
+        value := SmoothStep(number(index) / 16);
+        assert(value >= prior, "smooth progress never goes backwards");
+        prior = value;
+        index += 1;
+    }
+}
+
+@test
+AngleQuantizationRoundsHalfStepsAwayFromZero :: () {
+    assert(QuantizeAngle(0.75, 0.5) == 1, "positive half step");
+    assert(QuantizeAngle(-0.75, 0.5) == -1, "negative half step");
+    assert(QuantizeAngle(3, -2) == 4, "negative step keeps its multiples");
+    assert(QuantizeAngle(0, 0.5) == 0, "zero is already quantized");
+    assert(QuantizeAngle(1.1, 0.5) == 1, "nearest multiple");
+}
+
+@test
+AngleInterpolationCrossesTheNearbyWrap :: () {
+    assert(MathClose(AngleLerp(3, -3, 0.5), 3.141592653589793, 0.000001),
+           "positive wrap midpoint is pi");
+    assert(MathClose(AngleLerp(-3, 3, 0.5), -3.141592653589793, 0.000001),
+           "negative wrap midpoint is minus pi");
+    assert(AngleLerp(2, -1, 0) == 2, "zero progress is identity");
+    assert(AngleLerp(1, 2, 2) == 3, "angular fractions extrapolate");
+    assert(MathClose(AngleLerp(0, 3.141592653589793, 0.5), -1.570796326794897, 0.000001),
+           "the half-turn tie takes the negative direction");
+}
+
+@test
+FiniteClassificationIncludesTheRepresentableBoundaries :: () {
+    assert(IsFinite(0) && IsFinite(-0.0), "both zero signs are finite");
+    assert(IsFinite(3.40282346638528859811704183484516925440e38), "largest finite number");
+    assert(IsFinite(-3.40282346638528859811704183484516925440e38), "lowest finite number");
+    assert(IsFinite(1.401298464324817070923729583289916131280e-45), "smallest positive subnormal");
+}
+
+@test
+ExponentialDampingHasElapsedTimeAndRateIdentity :: () {
+    assert(Damp(2, 8, 3, 0) == 2, "zero elapsed time");
+    assert(Damp(2, 8, 0, 1) == 2, "zero decay rate");
+    assert(Damp(2, 8, 3, -1) == 2, "negative elapsed time clamps to zero");
+    assert(Damp(2, 8, -1, 1) == 2, "negative rate clamps to zero");
+    assert(Damp(2, 2, 3, 1) == 2, "target equilibrium");
+}
+
+@test
+ExponentialDampingUsesThePhysicalHalfLife :: () {
+    // A rate of ln(2) halves the remaining distance in one second.
+    rate: number = 0.693147180559945309417232121458176568;
+    assert(MathClose(Damp(0, 8, rate, 1), 4, 0.000001), "one half life");
+    assert(MathClose(Damp(0, 8, rate, 2), 6, 0.000001), "two half lives");
+    once := Damp(0, 8, rate, 1);
+    half := Damp(0, 8, rate, 0.5);
+    twice := Damp(half, 8, rate, 0.5);
+    assert(MathClose(twice, once, 0.000001), "fixed-target time subdivision");
+    assert(MathClose(Damp(half, 0, rate, 0.5), 1.6568542494923802, 0.000001),
+           "retargeting starts at the current value");
+}
+
+@test
+ExponentialDampingKeepsTinyStepsAndExtremeFiniteRanges :: () {
+    tiny := Damp(0, 1, 1, 0.00000001);
+    assert(tiny > 0 && MathClose(tiny, 0.00000001, 0.00000000000001),
+           "small exponential differences do not round to zero early");
+    limit: number = 3.40282346638528859811704183484516925440e38;
+    middle := Damp(-limit, limit, 0.6931471805599453, 1);
+    assert(IsFinite(middle), "finite endpoints do not overflow their interpolation span");
+    assert(middle > -limit && middle < limit, "the result stays between the endpoints");
+    assert(Damp(-limit, limit, limit, limit) == limit, "complete decay reaches the target");
+    assert(MathClose(Damp(1e20, 0, 1, 40), 424.835434, 0.0001),
+           "large distances keep a finite exponential tail after the blend fraction rounds to one");
+}
+
+@test
+PreciseMathKernelsKeepDoubleArgumentsAndHugeFinitePhases :: () {
+    sine := sin_precise(f64(1e20));
+    cosine := cos_precise(f64(1e20));
+    // Independent high-precision phase reduction and Taylor-series values.
+    assert(sine > -0.645251285265782 && sine < -0.645251285265779,
+           "f64 sine uses the full finite phase");
+    assert(cosine > 0.763970404441727 && cosine < 0.763970404441730,
+           "f64 cosine uses the full finite phase");
+    remainder := fmod(f64(1e20), f64(6.283185307179586476925286766559));
+    // Exact decimal remainder of the binary64 input operands.
+    assert(remainder > 1.895589910316636 && remainder < 1.895589910316639,
+           "floating remainder preserves low phase bits beyond the quotient's integer precision");
+    assert(fmod(-7.0, 2.5) == -2, "number remainder follows the dividend sign");
+    assert(fmod(number(7.5)) == 0.5, "number remainder defaults to a unit divisor");
+    assert(fmod(f64(7.5)) == f64(0.5), "f64 remainder has the same unit divisor default");
+    assert(MathClose(sin_precise(1.0), 0.8414709848078965, 0.0000001),
+           "number sine calls its native precision");
+    assert(MathClose(cos_precise(1.0), 0.5403023058681397, 0.0000001),
+           "number cosine calls its native precision");
+}
diff --git a/packages/core/math/Spring.chibi b/packages/core/math/Spring.chibi
new file mode 100644
index 0000000000000000000000000000000000000000..d3bc9752f7fb7fceb92d7aaef167bae87c615699
--- /dev/null
+++ b/packages/core/math/Spring.chibi
@@ -0,0 +1,123 @@
+package math
+
+// The spring is a value. Changing a target does not reset either field.
+pub Spring :: struct {
+    position: number;
+    velocity: number;
+}
+
+// sin(x)/x without division by a tiny phase near critical damping or dt=0.
+SpringSinc :: (phase: f64) -> f64 {
+    if phase > -0.0001 && phase < 0.0001 {
+        square := phase * phase;
+        return 1 - square / 6 + square * square / 120;
+    }
+    return sin_precise(phase) / phase;
+}
+
+SpringSincLoss :: (phase: f64) -> f64 {
+    if phase > -0.001 && phase < 0.001 {
+        square := phase * phase;
+        return square * (0.16666666666666666667 - square / 120 + square * square / 5040);
+    }
+    return 1 - SpringSinc(phase);
+}
+
+// (1-exp(-x))/x. The series preserves tiny overdamped time steps.
+SpringDecayRatio :: (value: f64) -> f64 {
+    if value < 0.0001 {
+        return 1 - value / 2 + value * value / 6 - value * value * value / 24;
+    }
+    return (1 - exp(-value)) / value;
+}
+
+SpringDecayRatioLoss :: (value: f64) -> f64 {
+    if value < 0.001 {
+        return value * (0.5 - value / 6 + value * value / 24 - value * value * value / 120);
+    }
+    return 1 - SpringDecayRatio(value);
+}
+
+// 1-(1+x)*exp(-x), kept accurate even when a tiny movement of a distant
+// target is large enough to affect a number. Computing 1-A loses it then.
+SpringCriticalChange :: (value: f64) -> f64 {
+    if value < 0.001 {
+        return value * value * (0.5 - value / 3 + value * value / 8 -
+                                value * value * value / 30 + value * value * value * value / 144);
+    }
+    return DecayFraction(value) - value * exp(-value);
+}
+
+SpringResult :: (spring: Spring, target: number, position_factor: f64,
+                 position_change: f64, position_velocity: f64, velocity_position: f64,
+                 velocity_factor: f64) -> Spring {
+    offset := f64(spring.position) - f64(target);
+    next_position := f64(spring.position) - position_change * offset;
+    if position_change >= 0.5 {
+        next_position = f64(target) + position_factor * offset;
+    }
+    position := number(next_position + position_velocity * f64(spring.velocity));
+    velocity := number(velocity_position * offset + velocity_factor * f64(spring.velocity));
+    assert(IsFinite(position) && IsFinite(velocity), "AdvanceSpring produced nonfinite output");
+    return {position: position, velocity: velocity};
+}
+
+// Analytic solution of x'' + 2*zeta*omega*x' + omega^2*(x-target) = 0.
+// Frequency is cycles/second, damping is its dimensionless ratio, elapsed is seconds.
+// As in the retired native operation, frequency is at least .01 and damping
+// and elapsed are nonnegative. The target is constant during this interval.
+// Equations are derived independently from Ryan Juckett, Damped Springs:
+// https://www.ryanjuckett.com/damped-springs/ . No settling snap is applied.
+pub AdvanceSpring :: (spring: Spring, target: number, frequency: number,
+                      damping: number, elapsed: number) -> Spring {
+    assert(IsFinite(spring.position) && IsFinite(spring.velocity) && IsFinite(target) &&
+           IsFinite(frequency) && IsFinite(damping) && IsFinite(elapsed),
+           "AdvanceSpring needs finite inputs");
+    if elapsed <= 0 || (spring.position == target && spring.velocity == 0) {
+        return spring;
+    }
+    hz := f64(frequency);
+    if hz < 0.01 {
+        hz = 0.01;
+    }
+    ratio := f64(damping);
+    if ratio < 0 {
+        ratio = 0;
+    }
+    dt := f64(elapsed);
+    omega := hz * 6.283185307179586476925286766559;
+    square := omega * omega;
+    decay_rate := ratio * omega;
+    if ratio < 1 {
+        phase := omega * sqrt((1 - ratio) * (1 + ratio)) * dt;
+        decay := exp(-decay_rate * dt);
+        off_diagonal := decay * dt * SpringSinc(phase);
+        diagonal := decay * cos_precise(phase);
+        half_sine := sin_precise(phase / 2);
+        change := SpringCriticalChange(decay_rate * dt) +
+                  decay * (2 * half_sine * half_sine + decay_rate * dt * SpringSincLoss(phase));
+        return SpringResult(spring, target, diagonal + decay_rate * off_diagonal,
+                            change, off_diagonal, -square * off_diagonal,
+                            diagonal - decay_rate * off_diagonal);
+    }
+    if ratio == 1 {
+        decay := exp(-omega * dt);
+        off_diagonal := decay * dt;
+        return SpringResult(spring, target, decay + omega * off_diagonal,
+                            SpringCriticalChange(omega * dt), off_diagonal, -square * off_diagonal,
+                            decay - omega * off_diagonal);
+    }
+    // Rationalizing the slow root avoids cancellation at large damping.
+    sum := ratio + sqrt((ratio - 1) * (ratio + 1));
+    slow := -omega / sum;
+    fast := -omega * sum;
+    gap := slow - fast;
+    slow_decay := exp(slow * dt);
+    fast_decay := exp(fast * dt);
+    off_diagonal := slow_decay * dt * SpringDecayRatio(gap * dt);
+    change := SpringCriticalChange(-slow * dt) +
+              (-slow * dt) * slow_decay * SpringDecayRatioLoss(gap * dt);
+    return SpringResult(spring, target, slow_decay - slow * off_diagonal,
+                        change, off_diagonal, -square * off_diagonal,
+                        fast_decay + slow * off_diagonal);
+}
diff --git a/packages/core/math/SpringTests.chibi b/packages/core/math/SpringTests.chibi
new file mode 100644
index 0000000000000000000000000000000000000000..9c8b535177ad290b01ba457c3affe82ae7d36e5f
--- /dev/null
+++ b/packages/core/math/SpringTests.chibi
@@ -0,0 +1,82 @@
+package math
+
+SpringNear :: (actual: number, expected: number, tolerance: number) -> bool {
+    return actual >= expected - tolerance && actual <= expected + tolerance;
+}
+
+@test
+SpringZeroTimeAndEquilibrium :: () {
+    spring: Spring = {position: 3, velocity: -7};
+    zero := AdvanceSpring(spring, -20, 2, 0.5, 0);
+    negative := AdvanceSpring(spring, -20, 2, 0.5, -1);
+    assert(zero.position == 3 && zero.velocity == -7);
+    assert(negative.position == 3 && negative.velocity == -7);
+    equilibrium := AdvanceSpring({position: 3, velocity: 0}, 3, 1000, 2, 1000);
+    assert(equilibrium.position == 3 && equilibrium.velocity == 0);
+}
+
+@test
+SpringCriticalAnalyticReference :: () {
+    // Unit displacement, zero velocity, omega=2*pi after 1/8 second.
+    // Independent high-precision evaluation: x=(1+pi/4)*exp(-pi/4).
+    result := AdvanceSpring({position: 1, velocity: 0}, 0, 1, 1, 0.125);
+    assert(SpringNear(result.position, 0.8140312, 0.0000002));
+    assert(SpringNear(result.velocity, -2.2499645, 0.000001));
+}
+
+@test
+SpringUndampedQuarterPeriod :: () {
+    result := AdvanceSpring({position: 1, velocity: 0}, 0, 1, 0, 0.25);
+    assert(SpringNear(result.position, 0, 0.0000001));
+    assert(SpringNear(result.velocity, -6.2831853, 0.000001));
+}
+
+@test
+SpringSubdivisionAndRetargeting :: () {
+    ratios: number[] = [0, 0.5, 0.99999994, 1, 1.00000012, 2, 1000000];
+    for ratio in ratios {
+        initial: Spring = {position: -2, velocity: 3};
+        whole := AdvanceSpring(initial, 5, 2, ratio, 0.25);
+        first := AdvanceSpring(initial, 5, 2, ratio, 0.125);
+        halves := AdvanceSpring(first, 5, 2, ratio, 0.125);
+        assert(SpringNear(halves.position, whole.position, 0.000002));
+        assert(SpringNear(halves.velocity, whole.velocity, 0.00001));
+        retargeted := AdvanceSpring(first, -8, 2, ratio, 0);
+        assert(retargeted.position == first.position && retargeted.velocity == first.velocity);
+        continued := AdvanceSpring(first, -8, 2, ratio, 0.03125);
+        assert(IsFinite(continued.position) && IsFinite(continued.velocity));
+    }
+}
+
+@test
+SpringExtremeDampingAndSmallSteps :: () {
+    spring: Spring = {position: 1, velocity: 0};
+    slow := AdvanceSpring(spring, 0, 1, 100000000, 1);
+    assert(slow.position > 0.9999 && slow.position <= 1);
+    assert(slow.velocity < 0 && slow.velocity > -0.0001);
+    tiny := AdvanceSpring({position: 0, velocity: 1}, 0, 1, 2, 0.0000000001);
+    assert(tiny.position > 0 && tiny.position <= 0.0000000001);
+    assert(tiny.velocity > 0.99999 && tiny.velocity <= 1);
+    long := AdvanceSpring(spring, 0, 1, 1, 1000);
+    assert(long.position == 0 && long.velocity == 0);
+}
+
+@test
+SpringTinyMovementTowardADistantTarget :: () {
+    ratios: number[] = [0, 0.5, 1, 2, 1000000];
+    for ratio in ratios {
+        result := AdvanceSpring({position: 1, velocity: 0}, 1e20, 1, ratio, 1e-12);
+        assert(SpringNear(result.position, 1.0019739, 0.0000002));
+    }
+    settled := AdvanceSpring({position: 1e20, velocity: 0}, 1, 1, 1, 1000);
+    assert(settled.position == 1 && settled.velocity == 0);
+}
+
+@test
+SpringRetargetingContinuesItsExistingMomentum :: () {
+    first := AdvanceSpring({position: -2, velocity: 3}, 5, 2, 0.5, 0.125);
+    next := AdvanceSpring(first, -8, 2, 0.5, 0.03125);
+    // Independent complex-root evaluation, rounding the intermediate state to f32.
+    assert(SpringNear(next.position, 3.067892074584961, 0.000002));
+    assert(SpringNear(next.velocity, -14.758637428283691, 0.00001));
+}
diff --git a/packages/core/math/ease/Ease.chibi b/packages/core/math/ease/Ease.chibi
