package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("SurfaceMirror")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Appearance", data.Object([
                    data.Field.Named("color", data.Value.UInt(269819903)),
                    data.Field.Named("height", data.Value.Real(28.0)),
                    data.Field.Named("width", data.Value.Real(84.0))
                ])),
                data.Field.Named("Body", data.Object([])),
                data.Field.Named("Collider", data.Object([
                    data.Field.Named("category", data.Value.UInt(1)),
                    data.Field.Named("height", data.Value.Real(28.0)),
                    data.Field.Named("mask", data.Value.UInt(1)),
                    data.Field.Named("shape", data.Value.Text("Box")),
                    data.Field.Named("width", data.Value.Real(84.0))
                ])),
                data.Field.Named("Destructible", data.Object([
                    data.Field.Named("cell_size", data.Value.Real(4.0)),
                    data.Field.Named("min_fragment_cells", data.Value.UInt(1))
                ])),
                data.Field.Named("Material", data.Object([
                    data.Field.Named("absorption", data.Value.Real(1.0)),
                    data.Field.Named("albedo", data.Value.UInt(3233861887)),
                    data.Field.Named("scene", data.Value.UInt(269819903))
                ])),
                data.Field.Named("Reflection", data.Object([
                    data.Field.Named("offset", data.Value.Real(22.0)),
                    data.Field.Named("roughness", data.Value.Real(0.050000000000000003)),
                    data.Field.Named("strength", data.Value.Real(0.90000000000000002))
                ])),
                data.Field.Named("Transform", data.Object([
                    data.Field.Named("y", data.Value.Real(22.0))
                ]))
            ]))
        ])
    );
}
