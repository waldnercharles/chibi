package llvm_native

import abi "project:native_abi"
import strings "core:strings"

// A scalar backend. This is not the prepared/pin_value ABI: arguments and
// results are native LLVM values. Slots and locals are private stack storage,
// never observable pointers. A module that calls the runtime, through Format
// or Fail, takes its context, native_abi.ContextType(), as every function's
// hidden first parameter, as Odin's procedures take theirs.
pub Instruction :: struct {
    op: int;
    type: int;
    output: int;
    left: int;
    right: int;
    target: int;
    literal: i64;
}
// One function of a module: consecutive ranges of the module's parameter,
// slot, local, code and argument tables, in function order. A call's argument
// slots are arguments[first_argument + right, + target) of its own function.
pub Function :: struct {
    result: int;
    first_parameter: int;
    parameters: int;
    first_slot: int;
    slots: int;
    first_local: int;
    locals: int;
    first_code: int;
    code: int;
    first_argument: int;
    arguments: int;
}
pub Result :: union {
    Rejected(instruction: int, message: string) | Emitted(text: string)
}
// A record type: the module's field types fields[first, first + count), each
// a scalar. Type RecordType + r is records[r], an LLVM struct of its fields
// in order, passed and returned by value between the module's functions.
pub Record :: struct {
    first: int;
    count: int;
    // Stable nominal-and-layout identity for managed payloads; zero for an
    // untagged ordinary value. Local record ordinals never identify a cell.
    identity: i64;
}
pub RecordType: int : 32;
// An owning generational task observer, spelled i64 but never a numeric scalar.
pub TaskType: int : 15;
// Root cell, byte offset and stable semantic pointee identity. This owning
// language value is distinct from the caller-storage reference in RefType.
pub PointerType: int : 16;
// A traced array-cell pointer with a fixed i32 start/count window.
pub ViewType: int : 17;
// The source file of a module's line tables and its directory. An empty file
// emits no debug information, and the module is the same text as without it.
pub Source :: struct {
    file: string;
    directory: string;
}

// output = literal: a scalar's value or encoding, a record's zero, or a
// string's text, texts[literal] of the module's text table.
pub Constant: int : 0;
pub Argument: int : 1;
pub Local: int : 2;
pub Save: int : 3;
pub Publish: int : 4;
pub Return: int : 5;
pub End: int : 6;
pub Add: int : 7;
pub Sub: int : 8;
pub Mul: int : 9;
pub Div: int : 10;
pub Mod: int : 11;
pub Neg: int : 12;
pub BitAnd: int : 13;
pub BitOr: int : 14;
pub BitXor: int : 15;
pub BitNot: int : 16;
pub Shl: int : 17;
pub Shr: int : 18;
pub Lt: int : 19;
pub Le: int : 20;
pub Gt: int : 21;
pub Ge: int : 22;
pub Eq: int : 23;
pub Ne: int : 24;
pub Branch: int : 25;
pub Jump: int : 26;
pub Check: int : 27;
// output = callee(arguments...): left is the callee's function index, and
// the argument slots are this function's arguments[right, right + target).
pub Call: int : 28;
// output = type(left): right is the left slot's type. Between integer types,
// literal 0 clamps the value to type while 1 keeps its low bits. A float or
// double converts to an integer type in either mode by truncating toward
// zero, saturating at the type's bounds, with NaN as 0. An integer or a float
// converts to double, and a double to float, rounding to nearest.
pub Convert: int : 29;
// output = the left slot's record with field `literal` replaced by the right
// slot's value; type is the record type.
pub Insert: int : 30;
// output = field `literal` of the left slot's record, whose type is right;
// type is the field's type.
pub Extract: int : 31;
// output = the byte count of the left slot's string, an int.
pub TextLength: int : 32;
// output = the byte of the left slot's string at the right slot's int index,
// 0 to 255, or -1 outside the string, an int.
pub TextByte: int : 33;
// output = the left slot's string without its first bytes, as many as the
// right slot's int, clamped to the string.
pub TextDrop: int : 34;
// output = the first bytes of the left slot's string, as many as the right
// slot's int, clamped to the string. Both slices are views of the string's
// bytes.
pub TextTake: int : 35;
// output = format_text(arguments...), a string the runtime makes: the
// argument slots are this function's arguments[right, right + target), a
// string format then scalars/text or collection counts, as a call's are.
// Literal bits 1..12 mark immutable record-name text arguments, whose modifiers
// are ignored; other bits are zero. These tags need a program/family context.
pub Format: int : 36;
// Ends the call from the VM with the failure of the assert at source bytes
// [left, right) of the function whose stable ID is `literal`: the context's
// failure names it, a native_abi.FailureType() constant, and this function,
// and each call it is in, returns its result's zero. In program mode, target
// is one plus the diagnostic's text-table index, or zero for no diagnostic.
pub Fail: int : 37;
// An array type is ArrayType plus its element's type, a scalar, a string or a
// record, and an array holds no array: its length, capacity, elements and
// nullable backing owner, by value. Its zero, the Constant of literal
// 0, is the empty array, which owns no memory. The runtime context allocates
// an array's elements and ends the program on an index outside the array
// (D9). ArrayCopy still eagerly copies source values. ValueCopy can share
// a counted backing; mutation detaches when that backing has another owner.
pub ArrayType: int : 1024;
// output = the length of the left slot's array, an int.
pub ArrayLength: int : 38;
// output = the left slot's array element at the right slot's int index, of
// type; an index outside the array ends the program. Literal1 resolves a
// logical place: unavailable is generic failure0, not expression bounds1.
pub ArrayGet: int : 39;
// Bounds-only logical-place validation, producing bool without reading a leaf.
pub ArrayGetPlaceCheck: int : 2;
// output = the left slot's array with its element at the right slot's int
// index replaced by the value in slot `target`; type is the array type. An
// index outside the array ends the program, unless literal is ArraySetUnchanged.
// Every mode consumes the incoming element owner, including an ignored value.
pub ArraySet: int : 40;
pub ArraySetUnchanged: int : 1;
// Source logical-place writes report generic reference unavailability.
pub ArraySetPlace: int : 2;
// output = the left slot's array with the right slot's value appended; type
// is the array type. The elements move to a larger allocation when they are
// full.
pub ArrayPush: int : 41;
// output = an array of its own elements equal to the left slot's; type is
// the array type.
pub ArrayCopy: int : 42;
// output = the left slot's array with the right slot's array's elements
// after its own; type is the array type. Like ArrayPush, it changes the
// elements the left slot holds, and moves them when they do not fit.
pub ArrayExtend: int : 43;
// output = a new array of the elements of the left slot's array from the
// right slot's int start, as many as the int count in slot `target`, each
// clamped to the array.
pub ArraySlice: int : 44;
// output = a new array of the right slot's int length, 0 if it is negative:
// the first elements of the left slot's array, then zeros. Literal0 admits
// zero growth; ArrayResizeInitialized rejects growth of record elements.
pub ArrayResize: int : 45;
pub ArrayResizeInitialized: int : 1;
// BoolStorage output gives membership; IntStorage gives the first equal
// index or -1. Literal is the element type. Numbers/bool/strings require
// target0; records/unions require target=1+their validated value-shape index.
// Strings compare bytes, floats use IEEE equality, unions only active payloads.
pub ArrayContains: int : 46;
// output = the left slot's array without its element at the right slot's int
// index, or as it is for an index outside it; type is the array type. The
// elements after the removed move down in place.
pub ArrayRemove: int : 47;
// output = an int array of the bytes of the left slot's string, each from 0 to
// 255; type is the int array type. It allocates through the context.
pub ArrayBytes: int : 48;
// output = symbol(arguments...) for a C function the module declares and the
// linker resolves, as an Odin foreign procedure is: `symbol` is
// texts[literal], and the argument slots are this function's
// arguments[right, right + target), each a number or a bool, as is the result,
// the instruction's type. It passes no context and never fails. A small
// integer or bool carries the extension the C ABI asks of its caller. An
// argument may be a string, passed as the pointer to its NUL-ended bytes. With
// `left` selects native_abi.ForeignDirect/Indirect or their Void modes.
// An indirect call consumes its first argument as the address and has empty
// symbol text. Void calls emit the true C ABI and produce an internal zero int.
pub ForeignCall: int : 49;
// A module's retained states: scalars that outlive a call, which a host that
// replaces the module reads out and sets in the new one. StateLoad declares
// state `target` and gives its value: the states are numbered in code order,
// `type` is a number, bool, string or numeric/bool array, and texts[right] is its name. With left
// zero, literal is its initial number/bool. Otherwise left-1 is a slot of its
// initial value, used only while the state's initialized marker is false.
// StateStore gives state `target` the left slot's value, of its type.
pub StateLoad: int : 50;
pub StateStore: int : 51;
// A reference type is RefType plus the type it refers to, a pointer to a
// local of the caller that a function reads and writes in place, as a C++
// reference or an Odin `^T` parameter does. Only a parameter, a local and a
// slot hold one: the callee's references point at locals of its callers, so
// none outlives its call, and no field, array element or result is one.
pub RefType: int : 1048576;
// output = the address of the local `left`, a reference to its type; type is
// the reference type.
pub LocalAddress: int : 52;
// output = the value the left slot's reference refers to; type is the value's.
pub Deref: int : 53;
// Writes the right slot's value to where the left slot's reference points;
// type is the value's. It gives nothing.
pub Poke: int : 54;
// output = the address of a C-ABI function that calls function `left`, a word;
// type is the word. The function's parameters and result are numbers or
// bools, which C passes and returns as it does for any function. A module
// that takes the runtime context passes the program's own, the global
// @chibi_context its start module defines, and a failure the function records
// waits there for the start module to report; C gets the result's zero.
// Literal CallbackVoid discards an internal int result and returns void to C;
// CallbackValue preserves the scalar result. Right and target are zero.
pub FunctionAddress: int : 55;
// One past the last instruction; bump it with each new one.
// output = a string of the bytes of the left slot's array of bytes (u8), a
// copy the runtime's allocation holds and no owner frees, as ArrayBytes
// allocates; type is the string type. It allocates through the context.
pub ArrayText: int : 56;
// Gives the left slot's array's elements back to the context's `release`, once
// nothing refers to them: a variable that owned the array is overwritten or
// out of scope, or a fresh array was read and is dead. It gives nothing. An
// array with no elements owns no memory and is skipped. The elements it
// refers to own nothing the drop frees (D10, native drops).
pub ArrayDrop: int : 57;
// A string whose owner is not null holds one reference to it, a runtime
// pin_text_owner: an atomic count, the length and the bytes, which ArrayText
// makes with a count of 1. TextRetain adds a reference for the left slot's
// string, and TextRelease gives one back, returning the owner to the context's
// `release` when it was the last. A null owner (a literal, or text the host
// owns and outlives the call) has nothing to count. Neither gives anything.
pub TextRetain: int : 58;
pub TextRelease: int : 59;
// A map type is MapType + value * 16 + key (Maps.chibi, docs/native-maps.md): an
// LLVM { i32, i32, i32, i32, ptr, ptr }, its live count, physical span,
// entries capacity, index slots, insertion-ordered entries and index, by value.
// Its key is a bool, an integer or a string; values are scalars, strings or
// records with scalar leaves. Its zero,
// the Constant of literal 0, is the empty map, which owns no memory. A map is a
// value, so a producer acquires another owner with ValueCopy, and every
// instruction that changes a map consumes the one it reads. The instructions
// that read a map name its type: in `type` when they give a map, in `literal`
// when they do not.
pub MapType: int : 2048;
// output = the entry count of the left slot's map, an int.
pub MapLength: int : 60;
// output = the value of the right slot's key in the left slot's map, of type,
// or the value type's zero when the map has no such key.
pub MapGet: int : 61;
// MapGet target mode: a missing aggregate key returns its zero initializer.
// Source optional maps use this for Nil; ordinary record/union maps use 0.
pub MapGetZero: int : 1;
// output = whether the left slot's map has the right slot's key, a bool.
pub MapHas: int : 62;
// output = the left slot's map with the right slot's key given the value in slot
// `target`; type is the map type. A new key goes last, and an old one keeps its
// place. The map takes one reference of a string key and one of a string value;
// a key already present gives the new key's back. Literal 1 gives back the
// allocations a growth replaces and consumes the input owner. A shared
// input detaches first; literal 0 retains its prior share when detaching.
pub MapSet: int : 63;
// output = the left slot's map without the right slot's key, or as it is
// for a key it lacks. Indexed maps mark dead entries and compact amortized; it
// borrows the key. Literal 1 gives back the allocations the removal replaces.
pub MapDelete: int : 64;
// output = a map of its own allocations equal to the left slot's; type is the
// map type. It clones only the immediate entries and shares counted children;
// ValueCopy instead shares the entries too.
pub MapCopy: int : 65;
// Gives the left slot's map's allocations, and each string it holds, back to the
// context. It gives nothing; type is the map type.
pub MapDrop: int : 66;
// output = the key at a live physical position in insertion order, of type;
// an out-of-span or dead position ends the program. Iterate MapSpan/MapLiveAt.
pub MapKeyAt: int : 67;
// output = the value of the entry at the right slot's int position, of type.
pub MapValueAt: int : 68;
// output = the physical entry span, including dead positions, for map iteration.
pub MapSpan: int : 69;
// output = whether the right slot's int position in the entry span is live.
// A position outside the span is false, so no key or value is read there.
pub MapLiveAt: int : 70;
// output = the address of field `literal` of the record local `left`, whose
// type is `right`, or with a target of 1 of the record the reference parameter
// `left` points to, whose type is a reference to `right`: a reference to the
// field's type; type is that reference type. The field is a scalar or array,
// and the reference lives as long as the local does.
pub FieldAddress: int : 71;
// An independent owned value in output: a managed aggregate or an
// array of counted elements, or a map. Owned backing can be shared until mutation;
// a null-owner array imports its caller-owned storage. Use ArrayLoan before
// exposing shared backing to a mutable foreign call; raw ForeignCall does not
// supply uniqueness or write a replaced descriptor back to its source.
pub ValueCopy: int : 72;
// Releases one owned value from the left slot; it gives no value.
pub ValueDrop: int : 73;
// A foreign buffer loan owns the evaluated array in left until its call.
// Target 0 records its canonical descriptor address in right; target 1 moves
// an owned temporary; target 2 copies a borrowed non-place value. Modes 1/2
// repeat left in right. The C call makes matching places unique only after
// all arguments have finished, preserving aliases and replaced places.
pub ArrayLoan: int : 74;
pub ArrayLoanPlace: int : 0;
pub ArrayLoanMove: int : 1;
pub ArrayLoanValue: int : 2;
// Right is RefMap and literal is the immutable key slot. The immediately
// preceding MapGet captures the array, including the empty missing-key
// default. No entry address survives later arguments. String keys own one
// reference until the call resolves the entry.
pub ArrayLoanMap: int : 3;
// Borrows an existing descriptor entry at left map/right key; literal is its
// map type. Target 0 observes an array entry. Target 1 takes a RefMap, detaches
// and publishes its canonical owner, then returns an array descriptor or the
// immediate map field of a one-field carrier. Resolve after callbacks and
// immediately update the descriptor. Map mutation invalidates the address.
pub MapValueAddress: int : 75;
// A new scalar managed cell initialized from left, whose value type is right.
// The result is PointerType, literal its stable semantic pointee identity.
pub ManagedNew: int : 76;
// Resolve left's PointerType descriptor after validating owner, semantic
// identity literal and byte range. Type is RefType plus its scalar pointee.
pub ManagedAddress: int : 77;
// Pin the array descriptor at left's RefType+array address across one
// collecting operation. Right names its static stack root node. Unpin uses
// that same node ID; function exit restores its incoming root boundary.
pub ManagedPin: int : 78;
pub ManagedUnpin: int : 79;
// A waiting function is a coroutine: its body holds a Suspend, an AwaitHandle or an
// awaited Call. Suspend gives up the function's turn; it resumes at the next
// instruction on the scheduler's next update (`yield`).
pub Suspend: int : 80;
// Waits for the task whose handle (a word) is `left` to finish or be cancelled. It
// gives nothing: the task's result, `T | Cancelled`, needs a union the native
// lane does not have for it yet.
pub AwaitHandle: int : 81;
// Cancels the task whose handle (a word) is `left`: its coroutine is destroyed.
pub Cancel: int : 82;
// End a standalone program with the core:testing failure kind in literal.
// It never returns; embedded/library modes have no typed failure ABI yet.
pub TypedFail: int : 84;
// Shortens the left task's deadline to its start plus the right f64 duration.
pub CancelAfter: int : 85;
// Suspends for the left f64 duration in the program's clock domain.
pub Delay: int : 86;
// output = sqrt(left), preserving the scalar f32 math contract.
pub Sqrt: int : 87;
// output owns a new observer of the left slot's task; TaskType only.
pub TaskCopy: int : 88;
// Consume and clear the left task slot. Active execution remains program-owned.
pub TaskDrop: int : 89;
// output is bool: true only while the left task is running.
pub TaskRunning: int : 90;
// Await left, then output a result union: tag field 0, optional payload field 1.
// right is its canonical native success type (0 for void); target is its
// success tag ordinal (0 or 1). A cancelled result never reads the promise.
pub AwaitResult: int : 91;
// Borrow left string for synchronous host output; output is int 0.
pub Print: int : 92;
// output = left(bool) ? right : target, all operands already evaluated.
// The selected values share type and are numeric or bool, never managed.
pub Select: int : 93;
// Resolve field target of record type right from left managed descriptor.
// The output preserves its root and carries the field's stable literal tag.
pub ManagedProject: int : 94;
// Consume one array descriptor, clamp the int index in right to 0..length,
// and insert target's element. Existing elements move without changing owners.
pub ArrayInsert: int : 95;
// Consume one array descriptor and reverse its elements without changing owners.
pub ArrayReverse: int : 96;
// Sample the explicitly owned clock grant once, into an i64/u64/int/int record.
pub ClockSample: int : 97;
// Make/Slice use argument slots [right,right+2) for first/end; target is the
// element type. Every operation's literal is its full expected array-cell tag.
// They produce an ordinary optional record with tag0 and payload1 fields.
pub ViewMake: int : 98;
// Length's right is element metadata. Get reads right's int index. Set reads
// [right,right+2) index/value arguments and has no output. Clone gives an array.
pub ViewLength: int : 99;
pub ViewGet: int : 100;
pub ViewSet: int : 101;
pub ViewClone: int : 102;
pub ViewSlice: int : 103;
// Frame-only cleanup membership. target0 names an owning slot, target1 a
// canonical local. Pin type is its value type; unpin type is zero.
pub OwnerPin: int : 104;
pub OwnerUnpin: int : 105;
// Borrow right's record element from the array at left (RefType + target),
// or its one-field wrapper's array/map descriptor. Modes 0 and 1 publish
// unique backing first; full-record Observe mode 2 only checks and borrows. Consume
// the address before callbacks or changes to its parent, as MapValueAddress.
pub ArrayValueAddress: int : 106;
pub ArrayAddressBracket: int : 0;
pub ArrayAddressMethod: int : 1;
// Full-record projection only: borrow without detaching or changing backing.
// The address lasts until the owner changes; consume it before source calls.
pub ArrayAddressObserve: int : 2;
// Deferred callback requests are tested on the common path. Poll never
// suspends; current owning descriptors already have stable registrations.
pub ManagedPending: int : 107;
pub ManagedPoll: int : 108;
// A strict half-open byte range of left's string. Right/target are int
// start/end slots. The result is exactly {int tag, string payload}; invalid
// bounds give all-zero absence. Mode 0 acquires a nonempty span's owner,
// copying uncounted host/literal bytes before they can escape;
// mode 1 independently copies its bytes. Valid empty results have tag 1.
pub TextRange: int : 109;
pub TextRangeView: int : 0;
pub TextRangeCopy: int : 1;
// An independently copied immutable string from left; no other operands.
pub TextClone: int : 110;
// target0/1 registers a fresh slot/canonical local; target2/3 clears it.
// left is the location index, type its array or scoped RefArray type. Each
// distinct location occupies one initialized entry in the function root table.
pub ManagedTrack: int : 111;
pub ManagedTrackSlot: int : 0;
pub ManagedTrackLocal: int : 1;
pub ManagedClearSlot: int : 2;
pub ManagedClearLocal: int : 3;
// IEEE floating absolute value; no library import or side effects.
pub FloatAbs: int : 112;
pub InstructionCount: int : 113;
// A Call's `literal`: an ordinary call, an awaited call (the callee is a waiting
// function, run inline in the waiting caller, giving its result), or a spawn (the
// callee is a waiting function, started as a task of its own, giving an owning
// TaskType observer).
pub CallPlain: int : 0;
pub CallAwaited: int : 1;
pub CallSpawned: int : 2;
// Source void has no success payload, despite the ramp's internal int result.
pub CallSpawnedVoid: int : 6;

Index :: (value: int, count: int) -> bool {
    return value >= 0 && value < count;
}
Typed :: (slots: int[], slot: int, type: int) -> bool {
    return Index(slot, length(slots)) && slots[slot] == type;
}
Produces :: (op: int) -> bool {
    if (ViewOperation(op)) { return op != ViewSet; }
    return op == ManagedPending || TextSequenceOperation(op) || op == ArrayValueAddress || op == ClockSample || op == ManagedProject || op == ArrayInsert || op == ArrayReverse || op == Select || op == ManagedNew || op == ManagedAddress || op == Print || op == TaskCopy || op == TaskRunning || op == AwaitResult || op <= Local || op == LocalAddress || op == FieldAddress || op == Deref || (op >= Add && op <= Ne) || (op >= Call && op <= Format) || (op >= ArrayLength && op <= ArrayBytes) || op == ArrayText ||
           op == ForeignCall || op == StateLoad || op == FunctionAddress || op == Sqrt || op == FloatAbs || op == ValueCopy || op == ArrayLoan || (MapOperation(op) && op != MapDrop);
}
Comparison :: (op: int) -> bool {
    return op >= Lt && op <= Ne;
}
Unary :: (op: int) -> bool {
    return op == Neg || op == BitNot || op == Sqrt || op == FloatAbs;
}
ReadsLeft :: (op: int) -> bool {
    if (ViewOperation(op)) { return true; }
    return TextSequenceOperation(op) || op == ArrayValueAddress || op == ManagedProject || op == ArrayInsert || op == ArrayReverse || op == Select || op == ManagedNew || op == ManagedAddress || op == ManagedPin || op == Print || op == Save || op == Publish || op == Branch || (op >= Add && op <= Ne) || (op >= Convert && op <= TextTake) ||
           (op >= ArrayLength && op <= ArrayBytes) || op == ArrayText || op == ArrayDrop || op == TextRetain ||
           op == TextRelease || op == StateStore || op == Deref || op == Poke || op == ValueCopy || op == ValueDrop || op == ArrayLoan || op == AwaitHandle || op == Cancel ||
           op == CancelAfter || op == Delay || op == Sqrt || op == FloatAbs || (op >= TaskCopy && op <= AwaitResult) || MapOperation(op);
}
Integer :: (type: int) -> bool {
    return abi.IntegerBits(type) > 0;
}
// Whether `literal` is a value of `type`: 0 or 1 for bool, for an integer
// type its range, except that a 64-bit unsigned value is its bit pattern, and
// for a float or double its IEEE encoding.
Fits :: (literal: i64, type: int) -> bool {
    if (type == abi.FloatStorage) {
        return literal >= 0 && literal < i64(1) << u32(32);
    }
    if (type == abi.DoubleStorage) {
        return true;
    }
    if (!Integer(type)) {
        return literal == 0 || literal == 1;
    }
    bits := abi.IntegerBits(type);
    if (bits == 64) {
        return true;
    }
    if (abi.Unsigned(type)) {
        return literal >= 0 && literal < (i64(1) << u32(bits));
    }
    half := i64(1) << u32(bits - 1);
    return literal >= 0 - half && literal < half;
}
ReadsRight :: (op: int) -> bool {
    if (op == ViewGet) { return true; }
    return op == TextRange || op == ArrayValueAddress || op == Select || (op >= Add && op <= Ne && !Unary(op)) || op == Insert || op == Poke || (op >= TextByte && op <= TextTake) ||
           ArrayReadsRight(op) || (op >= MapGet && op <= MapDelete && op != MapCopy && op != MapDrop) || op == MapKeyAt ||
           op == MapValueAt || op == MapLiveAt || op == MapValueAddress || op == CancelAfter || op == ArrayLoan;
}
// Whether an array instruction reads a right slot: an index, an element,
// another array or a length.
ArrayReadsRight :: (op: int) -> bool {
    return op == ArrayInsert || (op >= ArrayGet && op <= ArrayRemove && op != ArrayCopy);
}
// Whether an instruction reads the slot its target names: an array store's
// value or a slice's count.
ReadsTarget :: (op: int) -> bool {
    return op == TextRange || op == ArrayInsert || op == Select || op == ArraySet || op == ArraySlice || op == MapSet;
}
// Whether an array instruction calls the runtime context: an index check, or
// an allocation.
ArrayCalls :: (op: int) -> bool {
    return TextSequenceOperation(op) || op == ArrayValueAddress || op == ArrayGet || op == ArraySet || op == ArrayPush || op == ArrayCopy || op == ArrayExtend ||
           op == ArraySlice || op == ArrayResize || op == ArrayBytes || op == ArrayText || op == ArrayDrop ||
           op == TextRelease || op == ArrayRemove || op == ArrayLoan || op == ArrayInsert || op == ArrayReverse;
}
// Whether an instruction reads argument slots: a call's or a format's.
ReadsArguments :: (op: int) -> bool {
    return op == Call || op == Format || op == ForeignCall || ViewArguments(op);
}
ArgumentCount :: (item: Instruction) -> int {
    if (ViewArguments(item.op)) { return 2; }
    return item.target;
}
// The element type of array type `type`, or 0 when it is no array of a
// scalar, a string or one of the module's records.
ElementType :: (records: Record[], type: int) -> int {
    element := type - ArrayType;
    if (element <= 0 || element >= ArrayType || element == TaskType || element == ViewType || !Valued(records, element)) {
        return 0;
    }
    return element;
}
// Whether a parameter, local or slot holds `type`: a value, or a reference to
// one.
Held :: (records: Record[], type: int) -> bool {
    if (type >= RefType) {
        return type - RefType != TaskType && Valued(records, type - RefType);
    }
    return Valued(records, type);
}
// Whether `type` is a scalar, a string, one of the module's records or an
// array of one of them.
Valued :: (records: Record[], type: int) -> bool {
    if (type == PointerType || type == ViewType) { return true; }
    if (type == TaskType) { return true; }
    if (type >= MapType) {
        return MapShaped(records, type);
    }
    if (type >= ArrayType) {
        return ElementType(records, type) != 0;
    }
    return abi.ScalarType(type) != "" || type == abi.TextStorage || Index(type - RecordType, length(records));
}
// The LLVM type of a scalar, string, record or array type the module holds.
TypeName :: (type: int) -> string {
    if (type == ViewType) { return abi.ManagedViewType(); }
    if (type == PointerType) { return abi.ManagedPointerType(); }
    if (type == TaskType) { return "i64"; }
    if (type >= RefType) {
        return "ptr";
    }
    if (type >= MapType) {
        return abi.MapType();
    }
    if (type >= ArrayType) {
        return abi.ArrayType();
    }
    if (type >= RecordType) {
        return format_text("%record{}", type - RecordType);
    }
    if (type == abi.TextStorage) {
        return abi.TextType();
    }
    return abi.ScalarType(type);
}
// The type of field `field` of record type `type`, or 0 when `type` is no
// record of the module or has no such field.
FieldType :: (records: Record[], fields: int[], type: int, field: i64) -> int {
    if (!Index(type - RecordType, length(records))) {
        return 0;
    }
    record := records[type - RecordType];
    if (field < 0 || field >= i64(record.count)) {
        return 0;
    }
    return fields[record.first + int(field)];
}
// Records partition the field table in order, each with at least one scalar or
// string field.
RecordLayout :: (records: Record[], fields: int[]) -> bool {
    first: int = 0;
    for (record in records) {
        if (record.first != first || record.count < 1 || record.count > length(fields) - first) {
            return false;
        }
        first += record.count;
    }
    if (first != length(fields)) {
        return false;
    }
    for (type in fields) {
        if (type == TaskType || !Valued(records, type)) {
            return false;
        }
    }
    // Only inline record edges affect LLVM's finite by-value layout. Each
    // field is visited once, even when many parents share a deep child DAG.
    incoming := resize([int(0)], length(records));
    for (type in fields) {
        if (type >= RecordType && type < ArrayType) { incoming[type - RecordType] += 1; }
    }
    ready: int[] = [];
    for (index in 0..<length(records)) {
        if (incoming[index] == 0) { ready.append(index); }
    }
    at := 0;
    while (at < length(ready)) {
        record := records[ready[at]];
        for (field in record.first..<record.first + record.count) {
            type := fields[field];
            if (type < RecordType || type >= ArrayType) { continue; }
            child := type - RecordType;
            incoming[child] -= 1;
            if (incoming[child] == 0) { ready.append(child); }
        }
        at += 1;
    }
    return length(ready) == length(records);
}
// Whether the backend computes `op` in `type`: every operation on integers,
// IEEE arithmetic other than remainders and every comparison on floats,
// equality and negation on bool, and equality on strings.
Computes :: (op: int, type: int) -> bool {
    if (type == abi.TextStorage || type == PointerType) {
        return op == Eq || op == Ne;
    }
    if (Integer(type)) {
        return true;
    }
    if (abi.Floating(type)) {
        return op == Add || op == Sub || op == Mul || op == Div || op == Mod || op == Neg || Comparison(op);
    }
    return type == abi.BoolStorage && (op == Eq || op == Ne || op == BitNot);
}
// The conversions the backend implements, as the runtime's casts: integers
// to one another and to double, float and double to one another and to the
// integers. An integer becomes a float only through double.
Converts :: (from: int, to: int) -> bool {
    if (to == abi.FloatStorage) {
        return from == abi.DoubleStorage;
    }
    if (to == abi.DoubleStorage) {
        return Integer(from) || from == abi.FloatStorage;
    }
    return Integer(to) && (Integer(from) || abi.Floating(from));
}
// Each instruction's immediate dominator (`parent`; the entry's is itself) and
// place in reverse postorder (`order`), both -1 for an instruction control
// never reaches. A dominator comes before what it dominates in that order.
Dominance :: struct {
    parent: int[];
    order: int[];
}
// Cooper, Harvey and Kennedy's iteration over reverse postorder ("A Simple,
// Fast Dominance Algorithm"): a few linear passes over structured code, so
// each operand's check walks up the tree instead of searching the function.
Dominators :: (code: Instruction[]) -> Dominance {
    count := length(code);
    parent: int[] = [];
    order: int[] = [];
    seen: bool[] = [];
    // Each instruction's successors: a jump's or branch's target, and the
    // next instruction where control falls through; -1 for none. Valid code's
    // last instruction cannot fall through.
    jumps: int[] = [];
    falls: int[] = [];
    for (pc in 0..<count) {
        item := code[pc];
        target := -1;
        next := pc + 1;
        if (item.op == Jump || item.op == Branch) {
            target = item.target;
        }
        if (item.op == Jump || item.op == Return || item.op == End || item.op == Fail || item.op == TypedFail) {
            next = -1;
        }
        jumps.append(target);
        falls.append(next);
        parent.append(-1);
        order.append(-1);
        seen.append(false);
    }
    if (count == 0) {
        none: Dominance = {parent: parent, order: order};
        return none;
    }
    // Postorder by a depth-first walk of the code: each frame's instruction
    // and the next edge it tries.
    postorder: int[] = [];
    stack: int[] = [0];
    edges: int[] = [0];
    depth := 1;
    seen[0] = true;
    while (depth > 0) {
        pc := stack[depth - 1];
        edge := edges[depth - 1];
        if (edge == 2) {
            postorder.append(pc);
            depth -= 1;
            continue;
        }
        edges[depth - 1] = edge + 1;
        next := jumps[pc];
        if (edge == 1) {
            next = falls[pc];
        }
        if (next < 0 || seen[next]) {
            continue;
        }
        seen[next] = true;
        if (depth == length(stack)) {
            stack.append(next);
            edges.append(0);
        } else {
            stack[depth] = next;
            edges[depth] = 0;
        }
        depth += 1;
    }
    reached := length(postorder);
    for (index in 0..<reached) {
        order[postorder[reached - 1 - index]] = index;
    }
    // The reached predecessors of each instruction, `firsts[pc]` up to
    // `firsts[pc + 1]` in `predecessors`.
    firsts: int[] = [0];
    for (pc in 0..<count) {
        firsts.append(0);
    }
    for (pc in postorder) {
        if (jumps[pc] >= 0) {
            firsts[jumps[pc] + 1] += 1;
        }
        if (falls[pc] >= 0) {
            firsts[falls[pc] + 1] += 1;
        }
    }
    for (pc in 0..<count) {
        firsts[pc + 1] += firsts[pc];
    }
    cursor := firsts;
    predecessors: int[] = [];
    for (index in 0..<firsts[count]) {
        predecessors.append(0);
    }
    for (pc in postorder) {
        if (jumps[pc] >= 0) {
            predecessors[cursor[jumps[pc]]] = pc;
            cursor[jumps[pc]] += 1;
        }
        if (falls[pc] >= 0) {
            predecessors[cursor[falls[pc]]] = pc;
            cursor[falls[pc]] += 1;
        }
    }
    parent[0] = 0;
    changed := true;
    while (changed) {
        changed = false;
        for (index in 1..<reached) {
            pc := postorder[reached - 1 - index];
            chosen := -1;
            for (at in firsts[pc]..<firsts[pc + 1]) {
                other := predecessors[at];
                if (parent[other] < 0) {
                    continue;
                }
                if (chosen < 0) {
                    chosen = other;
                    continue;
                }
                // The nearest common dominator of `other` and `chosen`.
                while (other != chosen) {
                    while (order[other] > order[chosen]) {
                        other = parent[other];
                    }
                    while (order[chosen] > order[other]) {
                        chosen = parent[chosen];
                    }
                }
            }
            if (parent[pc] != chosen) {
                parent[pc] = chosen;
                changed = true;
            }
        }
    }
    dominance: Dominance = {parent: parent, order: order};
    return dominance;
}
// Every scalar slot is single-definition in the shared frontend's code.
// Check dominance too: an arbitrary branch may not bypass its definition.
// This check includes every reachable input edge, not just lexical instruction
// order; a use control never reaches is dominated by every earlier
// instruction.
Dominates :: (dominance: Dominance, definition: int, use: int) -> bool {
    if (definition < 0 || definition >= use) {
        return false;
    }
    if (dominance.order[use] < 0) {
        return true;
    }
    if (dominance.order[definition] < 0) {
        return false;
    }
    at := use;
    while (dominance.order[at] > dominance.order[definition]) {
        at = dominance.parent[at];
    }
    return at == definition;
}
// values[first, first + count), which the caller has bounded.
Part :: (values: int[], first: int, count: int) -> int[] {
    part: int[] = [];
    for (index in 0..<count) {
        part.append(values[first + index]);
    }
    return part;
}
Codes :: (code: Instruction[], first: int, count: int) -> Instruction[] {
    part: Instruction[] = [];
    for (index in 0..<count) {
        part.append(code[first + index]);
    }
    return part;
}
// Functions partition every table in order, so no range overlaps another or
// leaves a row unowned. Each count is checked before it is summed.
Layout :: (functions: Function[], parameters: int[], slots: int[], locals: int[], code: Instruction[],
           arguments: int[]) -> bool {
    if (length(functions) < 1) {
        return false;
    }
    at: Function = {result: 0, first_parameter: 0, parameters: 0, first_slot: 0, slots: 0, first_local: 0,
                    locals: 0, first_code: 0, code: 0, first_argument: 0, arguments: 0};
    for (item in functions) {
        // Each count is checked against what remains of its table, so no
        // sum wraps.
        if (item.parameters < 0 || item.slots < 0 || item.locals < 0 || item.code < 1 || item.arguments < 0 ||
            item.parameters > length(parameters) - at.first_parameter || item.slots > length(slots) - at.first_slot ||
            item.locals > length(locals) - at.first_local || item.code > length(code) - at.first_code ||
            item.arguments > length(arguments) - at.first_argument || item.first_parameter != at.first_parameter ||
            item.first_slot != at.first_slot || item.first_local != at.first_local ||
            item.first_code != at.first_code || item.first_argument != at.first_argument) {
            return false;
        }
        at.first_parameter += item.parameters;
        at.first_slot += item.slots;
        at.first_local += item.locals;
        at.first_code += item.code;
        at.first_argument += item.arguments;
    }
    return at.first_parameter == length(parameters) && at.first_slot == length(slots) &&
           at.first_local == length(locals) && at.first_code == length(code) &&
           at.first_argument == length(arguments);
}
// Collection descriptors keep their count by value when each argument is
// evaluated. Formatting never reads their backing storage.
FormatTag :: (type: int) -> int {
    if (type >= ArrayType && type < MapType) { return abi.FormatArrayTag; }
    if (type >= MapType && type < RefType) { return abi.FormatMapTag; }
    return abi.ValueTag(type);
}
// A format reads a string format, then scalar/text values or collection counts.
FormatValid :: (slots: int[], arguments: int[], item: Instruction) -> bool {
    if (item.type != abi.TextStorage || item.left != 0 || item.target < 1 || item.right < 0 ||
        item.right > length(arguments) - item.target ||
        !Typed(slots, arguments[item.right], abi.TextStorage) || item.literal < 0 ||
        (item.literal & ~abi.FormatRecordMask) != 0) {
        return false;
    }
    for (argument in 1..<13) {
        if (abi.FormatRecordArgument(item.literal, argument) &&
            (argument >= item.target || !Typed(slots, arguments[item.right + argument], abi.TextStorage))) {
            return false;
        }
    }
    for (index in 1..<item.target) {
        slot := arguments[item.right + index];
        if (!Index(slot, length(slots)) || FormatTag(slots[slot]) == 0) {
            return false;
        }
    }
    return true;
}
// Primitive arrays keep their schema-qualified per-key ABI. Managed
// elements instead use complete structural snapshots.
StateArray :: (type: int) -> bool {
    return type >= ArrayType && type < MapType && abi.ScalarType(type - ArrayType) != "";
}
// A load names a retained state and its initializer; a store owns a copy.
StateValid :: (slots: int[], texts: string[], item: Instruction, layout: ValueLayout, composites: bool) -> bool {
    aggregate := false;
    if (composites && item.type >= RecordType && item.type < MapType) {
        held := item.type;
        if (held >= ArrayType) { held -= ArrayType; }
        if (held < RecordType || Index(held - RecordType, length(layout.valid))) {
            aggregate = ValueValid(layout, held);
        }
    }
    if ((abi.ScalarType(item.type) == "" && item.type != abi.TextStorage && !StateArray(item.type) && !aggregate) || item.target < 0) {
        return false;
    }
    if (item.op == StateStore) {
        return Typed(slots, item.left, item.type);
    }
    return Index(item.right, length(texts)) &&
           ((item.left == 0 && !StateArray(item.type) && Fits(item.literal, item.type)) ||
            (item.left > 0 && item.literal == 0 && Typed(slots, item.left - 1, item.type)));
}
// Whether a reference instruction names a local of the type its reference
// type refers to, a reference slot, or a reference slot and a value slot.
ReferenceValid :: (slots: int[], locals: int[], item: Instruction) -> bool {
    if (item.op == LocalAddress) {
        return item.type > RefType && Typed(locals, item.left, item.type - RefType);
    }
    if (item.op == Deref) {
        return item.type < RefType && Typed(slots, item.left, RefType + item.type);
    }
    return item.type < RefType && Typed(slots, item.left, RefType + item.type) && Typed(slots, item.right, item.type);
}
// Whether a function address names a function C can call: a word whose
// parameters and result are numbers or bools.
FunctionAddressValid :: (functions: Function[], parameters: int[], item: Instruction) -> bool {
    if (!Index(item.left, length(functions)) || item.type != abi.WordStorage || item.right != 0 || item.target != 0 ||
        (item.literal != i64(abi.CallbackValue) && item.literal != i64(abi.CallbackVoid))) {
        return false;
    }
    callee := functions[item.left];
    if (abi.ScalarType(callee.result) == "" || (item.literal == i64(abi.CallbackVoid) && callee.result != abi.IntStorage)) {
        return false;
    }
    for (index in 0..<callee.parameters) {
        if (abi.ScalarType(parameters[callee.first_parameter + index]) == "") {
            return false;
        }
    }
    return true;
}
// The C-ABI adapter of function `function`, which a function address names:
// the same parameters and result with the extensions C asks of its caller, and
// the program's context first when the module takes one.
CallbackSymbol :: (function: int, callback: int) -> string {
    suffix := "";
    if (callback == abi.CallbackVoid) { suffix = ".void"; }
    return format_text("chibi_callback.{}{}", function, suffix);
}
CallbackAdapter :: (functions: Function[], parameters: int[], function: int, callback: int, mode: int, runtime: bool) -> string {
    callee := functions[function];
    listed: string[] = [];
    passed: string[] = [];
    if (runtime) {
        passed.append("ptr @chibi_context");
    }
    for (index in 0..<callee.parameters) {
        type := parameters[callee.first_parameter + index];
        listed.append(format_text("{}{} %a{}", TypeName(type), CExtension(type), index));
        passed.append(format_text("{} %a{}", TypeName(type), index));
    }
    result := TypeName(callee.result);
    extension := CExtension(callee.result);
    if (callback == abi.CallbackVoid) { result = "void"; extension = ""; }
    out := format_text("define internal{} {} @{}({}) #0 {\nentry:\n", extension,
                       result, CallbackSymbol(function, callback), strings.Join(listed, ", "));
    out = format_text("{}  %result = call {} @{}({})\n", out, TypeName(callee.result), Symbol(function, mode),
                      strings.Join(passed, ", "));
    if (callback == abi.CallbackVoid) { return format_text("{}  ret void\n}\n", out); }
    return format_text("{}  ret {} %result\n}\n", out, result);
}
// The adapters of the functions whose address the module takes, once each.
CallbackAdapters :: (functions: Function[], parameters: int[], code: Instruction[], mode: int, runtime: bool) -> string {
    taken := resize([int(0)], length(functions));
    out: string[] = [];
    for (item in code) {
        if (item.op == FunctionAddress) {
            callback := int(item.literal);
            flag := 1 << u32(callback);
            if ((taken[item.left] & flag) != 0) { continue; }
            taken[item.left] |= flag;
            out.append(format_text("\n{}", CallbackAdapter(functions, parameters, item.left, callback, mode, runtime)));
        }
    }
    return strings.Join(out, "");
}
// Whether each function is a coroutine: it suspends, awaits a task, or awaits a call.
WaitingFunctions :: (functions: Function[], code: Instruction[]) -> bool[] {
    waiting: bool[] = [];
    for (shape in functions) {
        found := false;
        for (item in Codes(code, shape.first_code, shape.code)) {
            if (item.op == Suspend || item.op == AwaitHandle || item.op == AwaitResult || item.op == Delay || (item.op == Call && item.literal == i64(CallAwaited))) {
                found = true;
            }
        }
        waiting.append(found);
    }
    return waiting;
}
// Whether any function waits or starts a task.
Tasks :: (code: Instruction[]) -> bool {
    for (item in code) {
        if (item.op == TaskCopy || item.op == TaskDrop || item.op == TaskRunning || item.op == AwaitResult || item.op == Suspend || item.op == AwaitHandle || item.op == Cancel || item.op == CancelAfter || item.op == Delay ||
            (item.op == Call && item.literal != i64(CallPlain))) {
            return true;
        }
    }
    return false;
}
// A call names another function of the module, with its result type and one
// argument slot of each parameter's type. A spawn gives an owning task observer.
CallValid :: (functions: Function[], parameters: int[], slots: int[], arguments: int[], item: Instruction) -> bool {
    if (!Index(item.left, length(functions))) {
        return false;
    }
    callee := functions[item.left];
    wanted := callee.result;
    if (item.literal == i64(CallSpawnedVoid) && callee.result != abi.IntStorage) { return false; }
    if (item.literal == i64(CallSpawned) || item.literal == i64(CallSpawnedVoid)) {
        wanted = TaskType;
    }
    if (item.type != wanted || item.target != callee.parameters || item.right < 0 ||
        item.right > length(arguments) - item.target) {
        return false;
    }
    for (index in 0..<item.target) {
        if (!Typed(slots, arguments[item.right + index], parameters[callee.first_parameter + index])) {
            return false;
        }
    }
    return true;
}
Validate :: (functions: Function[], function: int, module_parameters: int[], module_slots: int[],
             module_locals: int[], module_code: Instruction[], module_arguments: int[], records: Record[],
             fields: int[], field_tags: i64[], texts: string[], mode: int, waiting: bool[], lifecycle: ValueLayout,
             managed_records: ManagedRecordLayout, family: bool, snapshots: bool, clock_owner: bool,
             value_shapes: SnapshotShapes) -> Result {
    shape := functions[function];
    parameters := Part(module_parameters, shape.first_parameter, shape.parameters);
    slots := Part(module_slots, shape.first_slot, shape.slots);
    locals := Part(module_locals, shape.first_local, shape.locals);
    code := Codes(module_code, shape.first_code, shape.code);
    arguments := Part(module_arguments, shape.first_argument, shape.arguments);
    result := shape.result;
    // The exported entry takes and returns scalars: no foreign aggregate or
    // string ABI is promised.
    exported := function == 0 && mode != NoEntry;
    if (!Valued(records, result) || (exported && abi.ScalarType(result) == "") ||
        (mode == MainEntry && exported && (length(parameters) != 0 || result != 6))) {
        return Result.Rejected(-1, "unsupported native scalar signature or table size");
    }
    for (type in parameters) {
        if (type == TaskType || type == RefType + TaskType) {
            return Result.Rejected(-1, "native task parameters require cancellation unwind support");
        }
        if (waiting[function] && !TaskFrameValue(records, lifecycle, managed_records, type, false, ProgramMode(mode) || family)) {
            return Result.Rejected(-1, "native waiting parameters need scalar values; managed values and dependencies are not supported yet");
        }
        if (!Held(records, type) || (exported && abi.ScalarType(type) == "")) {
            return Result.Rejected(-1, "unsupported native scalar parameter");
        }
    }
    plain_references := false;
    for (type in slots) {
        plain_references = plain_references || (waiting[function] && TaskPlainReference(lifecycle, type));
        if (waiting[function] && !TaskFrameValue(records, lifecycle, managed_records, type, true, ProgramMode(mode) || family)) {
            return Result.Rejected(-1, "native waiting frames cannot own managed values or pointers yet");
        }
        if (!Held(records, type)) {
            return Result.Rejected(-1, "native scalar slot cannot hold a managed value or pointer");
        }
    }
    for (type in locals) {
        if (waiting[function] && TaskPlainReference(lifecycle, type)) {
            return Result.Rejected(-1, "native waiting record references require immediate managed payload access");
        }
        if (waiting[function] && !TaskFrameValue(records, lifecycle, managed_records, type, true, ProgramMode(mode) || family)) {
            return Result.Rejected(-1, "native waiting frames cannot own managed values or pointers yet");
        }
        if (!Held(records, type)) {
            return Result.Rejected(-1, "native scalar local cannot hold a managed value or pointer");
        }
    }
    if (waiting[function] && !TaskPromiseValue(records, lifecycle, managed_records, result, ProgramMode(mode) || family)) {
        return Result.Rejected(-1, "native waiting results require a pointer-free value and program-owned cleanup");
    }
    definitions: int[] = [];
    loan_uses: bool[] = [];
    pins := false;
    owner_pins := false;
    for (slot in slots) {
        definitions.append(int(-1));
    }
    base := shape.first_code;
    pc: int = 0;
    while (pc < length(code)) {
        item := code[pc];
        pins = pins || item.op == ManagedPin || item.op == ManagedUnpin;
        owner_pins = owner_pins || item.op == OwnerPin || item.op == OwnerUnpin;
        if (item.op < Constant || item.op >= InstructionCount ||
            (item.op > Cancel && item.op < CancelAfter && item.op != TypedFail)) {
            return Result.Rejected(base + pc, "unsupported native scalar instruction");
        }
        if (item.op == ManagedPending || item.op == ManagedPoll || item.op == ManagedTrack) {
            if ((!ProgramMode(mode) && !family) || !ManagedPollValid(item, slots, locals)) {
                return Result.Rejected(base + pc, "native deferred collection differs from its owning roots");
            }
        }
        if ((item.op == OwnerPin || item.op == OwnerUnpin) &&
            (!waiting[function] || (!ProgramMode(mode) && !family))) {
            return Result.Rejected(base + pc, "native owned frames require a program-owned waiting function");
        }
        if (Produces(item.op)) {
            output := item.type;
            if (Comparison(item.op)) {
                output = 1;
            }
            if (!Typed(slots, item.output, output) || definitions[item.output] != -1) {
                return Result.Rejected(base + pc, "native scalar output has an invalid type or multiple definitions");
            }
            definitions[item.output] = pc;
        }
        // A record's only constant is its zero, and a string's is a text of
        // the table.
        if (item.op == Constant && ((abi.ScalarType(item.type) != "" && !Fits(item.literal, item.type)) ||
                                    ((item.type >= RecordType || item.type == TaskType || item.type == PointerType || item.type == ViewType) && item.literal != 0) ||
                                    (item.type == abi.TextStorage &&
                                     (item.literal < 0 || item.literal >= i64(length(texts)))))) {
            return Result.Rejected(base + pc, "native constant is outside its type");
        }
        if (item.op == Argument && !Typed(parameters, item.left, item.type)) {
            return Result.Rejected(base + pc, "native argument type differs from its signature");
        }
        if (item.op == ManagedNew || item.op == ManagedAddress || item.op == ManagedProject) {
            if (!ProgramMode(mode) && !family) {
                return Result.Rejected(base + pc, "native managed pointers require a standalone collector owner");
            }
            if (item.literal == 0 || (item.target != 0 && item.op != ManagedProject)) {
                return Result.Rejected(base + pc, "native managed pointer identity is invalid");
            }
            if (item.op == ManagedNew &&
                (item.type != PointerType || !ManagedPayload(records, managed_records, lifecycle, item.right, item.literal) ||
                 !Typed(slots, item.left, item.right))) {
                return Result.Rejected(base + pc, "native managed cell initializer differs from its scalar type");
            }
            if (item.op == ManagedAddress &&
                (item.type < RefType || !ManagedTarget(records, managed_records, lifecycle, item.type - RefType, item.literal) ||
                 !Typed(slots, item.left, PointerType) || item.right != 0)) {
                return Result.Rejected(base + pc, "native managed pointer resolution differs from its scalar target");
            }
            if (item.op == ManagedProject &&
                (item.type != PointerType || !Typed(slots, item.left, PointerType) ||
                 !ManagedRecord(records, managed_records, item.right) ||
                 FieldType(records, fields, item.right, i64(item.target)) == 0 ||
                 field_tags[records[item.right - RecordType].first + item.target] != item.literal)) {
                return Result.Rejected(base + pc, "native managed projection differs from its typed record field");
            }
        }
        if (item.op == ClockSample) {
            if ((!ProgramMode(mode) && !family) || !clock_owner) {
                return Result.Rejected(base + pc, "native clock sampling requires an explicit seven-slot clock owner");
            }
            if (item.left != 0 || item.right != 0 || item.target != 0 || item.literal != 0 ||
                !ClockRecord(records, fields, item.type)) {
                return Result.Rejected(base + pc, "native clock sample differs from its four-field transport record");
            }
        }
        if (item.op == Local && !Typed(locals, item.left, item.type)) {
            return Result.Rejected(base + pc, "native local read has an invalid type");
        }
        if ((item.op == LocalAddress || item.op == Deref || item.op == Poke) &&
            !ReferenceValid(slots, locals, item)) {
            return Result.Rejected(base + pc, "native reference differs from its operands");
        }
        if (item.op == Save && (!Typed(slots, item.left, item.type) ||
                                !Typed(locals, item.target, item.type))) {
            return Result.Rejected(base + pc, "native local write has an invalid type");
        }
        if (item.op == Publish && (item.type != result || item.target != 0 ||
                                   !Typed(slots, item.left, result))) {
            return Result.Rejected(base + pc, "native return value differs from its signature");
        }
        if (item.op >= Add && item.op <= Ne) {
            if (!Computes(item.op, item.type) || !Typed(slots, item.left, item.type) ||
                (ReadsRight(item.op) && !Typed(slots, item.right, item.type))) {
                return Result.Rejected(base + pc, "native scalar operand type mismatch");
            }
        }
        if (item.op == Convert && (!Converts(item.right, item.type) || !Typed(slots, item.left, item.right) ||
                                   (item.literal != 0 && item.literal != 1))) {
            return Result.Rejected(base + pc, "native conversion is not one the backend implements");
        }
        if (item.op == Sqrt && (item.type != abi.FloatStorage || !Typed(slots, item.left, item.type))) {
            return Result.Rejected(base + pc, "native square root requires an f32 operand");
        }
        if (item.op == FloatAbs && (!abi.Floating(item.type) || !Typed(slots, item.left, item.type) ||
                                   item.right != 0 || item.target != 0 || item.literal != 0)) {
            return Result.Rejected(base + pc, "native floating absolute value requires one f32 or f64 operand");
        }
        if (item.op == Select && ((!Integer(item.type) && !abi.Floating(item.type) && item.type != abi.BoolStorage) || !Typed(slots, item.left, abi.BoolStorage) ||
                                 !Typed(slots, item.right, item.type) || !Typed(slots, item.target, item.type) ||
                                 item.literal != 0)) {
            return Result.Rejected(base + pc, "native selection differs from its condition or values");
        }
        if (item.op == FieldAddress) {
            field := FieldType(records, fields, item.right, item.literal);
            held := item.right;
            if (item.target == 1) {
                held = RefType + item.right;
            }
            if (field == 0 || item.type != RefType + field || (abi.ScalarType(field) == "" && ElementType(records, field) == 0 &&
                 !(field >= RecordType && field < ArrayType && ValueValid(lifecycle, field))) ||
                (item.target != 0 && item.target != 1) || !Typed(locals, item.left, held)) {
                return Result.Rejected(base + pc, "native field reference differs from its record");
            }
        }
        if (item.op == ArrayValueAddress) {
            element := ElementType(records, item.target);
            record := element >= RecordType && element < ArrayType && item.type == RefType + element;
            member := NestedArrayElement(records, fields, item.target);
            if ((!record && (member == 0 || item.type != RefType + member)) || !ValueValid(lifecycle, element) ||
                !Typed(slots, item.left, RefType + item.target) || !Typed(slots, item.right, abi.IntStorage) ||
                (item.literal != i64(ArrayAddressBracket) && item.literal != i64(ArrayAddressMethod) &&
                 (!record || item.literal != i64(ArrayAddressObserve)))) {
                return Result.Rejected(base + pc, "native nested array reference differs from its wrapper");
            }
        }
        if (item.op == Insert) {
            field := FieldType(records, fields, item.type, item.literal);
            if (field == 0 || !Typed(slots, item.left, item.type) || !Typed(slots, item.right, field)) {
                return Result.Rejected(base + pc, "native field write differs from its record");
            }
        }
        if (item.op == Extract) {
            field := FieldType(records, fields, item.right, item.literal);
            if (field == 0 || field != item.type || !Typed(slots, item.left, item.right)) {
                return Result.Rejected(base + pc, "native field read differs from its record");
            }
        }
        if (item.op == ArrayDrop && (!Index(item.left, length(slots)) || ElementType(records, slots[item.left]) == 0 ||
                                     item.type != slots[item.left])) {
            return Result.Rejected(base + pc, "native array drop differs from its operand");
        }
        if (item.op == Print && (item.type != abi.IntStorage || !Typed(slots, item.left, abi.TextStorage) ||
                                item.right != 0 || item.target != 0 || item.literal != 0)) {
            return Result.Rejected(base + pc, "native print requires one string operand");
        }
        if ((item.op == TextRetain || item.op == TextRelease) &&
            (!Index(item.left, length(slots)) || slots[item.left] != abi.TextStorage)) {
            return Result.Rejected(base + pc, "native text reference differs from its operand");
        }
        if (item.op == ArrayLoan) {
            if (length(loan_uses) == 0) { loan_uses = resize([false], length(slots)); }
            element := ElementType(records, item.type);
            if (element == abi.BoolStorage || abi.ScalarType(element) == "" || !Typed(slots, item.left, item.type) ||
                item.target < ArrayLoanPlace || item.target > ArrayLoanMap ||
                (item.target != ArrayLoanMap && item.literal != 0) ||
                (item.target == ArrayLoanPlace && !Typed(slots, item.right, RefType + item.type)) ||
                ((item.target == ArrayLoanMove || item.target == ArrayLoanValue) && item.right != item.left)) {
                return Result.Rejected(base + pc, "native foreign buffer loan differs from its array or place");
            }
            if (item.target == ArrayLoanMap) {
                mapped := 0;
                if (Index(item.right, length(slots))) { mapped = slots[item.right] - RefType; }
                if (!MapShaped(records, mapped) || MapValue(mapped) != item.type ||
                    item.literal < 0 || item.literal >= i64(length(slots)) || !Typed(slots, int(item.literal), MapKey(mapped)) || pc < 1) {
                    return Result.Rejected(base + pc, "native map buffer loan differs from its capture");
                }
                read := code[pc - 1];
                if (read.op != MapGet || read.output != item.left || read.type != item.type ||
                    read.literal != i64(mapped) || read.right != int(item.literal) || read.target != 0) {
                    return Result.Rejected(base + pc, "native map buffer loan differs from its capture");
                }
            }
        }
        if ((item.op == ValueCopy || item.op == ValueDrop) &&
            (!Typed(slots, item.left, item.type) ||
             (ElementType(records, item.type) != 0 && item.type != ArrayType + PointerType && !ValueValid(lifecycle, item.type - ArrayType)) ||
             (ElementType(records, item.type) == 0 &&
              !MapPayloadValid(records, lifecycle, item.type) &&
              (item.type < RecordType || item.type >= ArrayType || !ValueValid(lifecycle, item.type) || !lifecycle.owned[item.type - RecordType])) ||
             item.right != 0 || item.target != 0 || item.literal != 0 || (item.op == ValueDrop && item.output != 0))) {
            return Result.Rejected(base + pc, "native value lifecycle requires an array or managed aggregate operand");
        }
        if ((item.op == ArrayPush || item.op == ArrayExtend) && item.literal != 0 && item.literal != 1) {
            return Result.Rejected(base + pc, "native array growth ownership is not 0 or 1");
        }
        if (((item.op >= ArrayLength && item.op <= ArrayBytes) || item.op == ArrayText || item.op == ArrayInsert || item.op == ArrayReverse) && !ArrayValid(records, slots, item, value_shapes.nodes)) {
            return Result.Rejected(base + pc, "native array operation differs from its operands");
        }
        if (MapOperation(item.op) && !MapValid(records, fields, lifecycle, slots, item)) {
            return Result.Rejected(base + pc, "native map operation differs from its operands");
        }
        if (ViewOperation(item.op) && !ViewValid(records, fields, lifecycle, slots, arguments, item)) {
            return Result.Rejected(base + pc, "native view operation differs from its operands");
        }
        if (TextSequenceOperation(item.op) && !TextSequenceValid(records, fields, slots, item)) {
            return Result.Rejected(base + pc, "native text sequence differs from its operands");
        }
        if (item.op >= TextLength && item.op <= TextTake && !TextValid(slots, item)) {
            return Result.Rejected(base + pc, "native text read differs from its operands");
        }
        if (item.op == Format && !FormatValid(slots, arguments, item)) {
            return Result.Rejected(base + pc, "native format differs from its operands");
        }
        if (item.op == Format && !ProgramMode(mode) && !family) {
            if (item.literal != 0) {
                return Result.Rejected(base + pc, "aggregate formatting requires a standalone or execution-family context");
            }
            for (argument in 1..<item.target) {
                if (FormatTag(slots[arguments[item.right + argument]]) >= abi.FormatArrayTag) {
                    return Result.Rejected(base + pc, "aggregate formatting requires a standalone or execution-family context");
                }
            }
        }
        if ((item.op == StateLoad || item.op == StateStore) && !StateValid(slots, texts, item, lifecycle, snapshots || ProgramMode(mode))) {
            return Result.Rejected(base + pc, "native retained state differs from its operands");
        }
        foreign_abi := InvalidForeignABI;
        if (item.op == ForeignCall) {
            foreign_abi = ForeignABI(slots, arguments, texts, item);
            if (foreign_abi == InvalidForeignABI) {
                return Result.Rejected(base + pc, "native foreign call differs from its operands");
            }
            if (!ProgramMode(mode) && !abi.ForeignIsIndirect(item.left) && ClockFactorySymbol(texts[int(item.literal)])) {
                return Result.Rejected(base + pc, "native clock grant factories belong to the embedding executable");
            }
        }
        if (item.op == ForeignCall && length(loan_uses) > 0) {
            for (index in 0..<item.target) {
                slot := arguments[item.right + index];
                definition := definitions[slot];
                if (definition < 0 || code[definition].op != ArrayLoan) { continue; }
                if (loan_uses[slot]) {
                    return Result.Rejected(base + pc, "native foreign buffer loan belongs to one call argument");
                }
                loan_uses[slot] = true;
            }
        }
        if (item.op == FunctionAddress && !FunctionAddressValid(functions, module_parameters, item)) {
            return Result.Rejected(base + pc, "native function address differs from its function");
        }
        if (item.op == FunctionAddress && waiting[item.left]) {
            return Result.Rejected(base + pc, "native function address cannot name a waiting function");
        }
        if (item.op == Call && !CallValid(functions, module_parameters, slots, arguments, item)) {
            return Result.Rejected(base + pc, "native call differs from its callee's signature");
        }
        if (item.op == Call && ((item.literal != i64(CallPlain) && item.literal != i64(CallAwaited) &&
                                 item.literal != i64(CallSpawned) && item.literal != i64(CallSpawnedVoid)) ||
                                (item.literal != i64(CallPlain) && !waiting[item.left]))) {
            return Result.Rejected(base + pc, "native awaited call or spawn names a function that does not wait");
        }
        if (item.op == Call && item.literal == i64(CallPlain) && waiting[item.left]) {
            return Result.Rejected(base + pc, "native plain call cannot name a waiting function");
        }
        if ((item.op == AwaitHandle || item.op == Cancel || item.op == CancelAfter || item.op == TaskCopy ||
             item.op == TaskDrop || item.op == TaskRunning) && !Typed(slots, item.left, TaskType)) {
            return Result.Rejected(base + pc, "native task operation requires a task handle");
        }
        if (((item.op == TaskCopy || item.op == TaskDrop) && item.type != TaskType) ||
            (item.op == TaskRunning && item.type != abi.BoolStorage) ||
            (item.op == AwaitResult && !TaskResultValid(records, fields, slots, lifecycle, managed_records, ProgramMode(mode) || family, item))) {
            return Result.Rejected(base + pc, "native task observer or result differs from its type");
        }
        if ((item.op == CancelAfter && !Typed(slots, item.right, abi.DoubleStorage)) ||
            (item.op == Delay && !Typed(slots, item.left, abi.DoubleStorage))) {
            return Result.Rejected(base + pc, "native timed task operation requires an f64 duration");
        }
        // C calls complete synchronously. Scalar arguments/results live in the
        // coroutine's existing scalar slots; borrowed strings/array buffers
        // retain the separate lifetime gate. Typed source effects are unchanged.
        if (waiting[function] && ((item.op == Fail && !ProgramMode(mode) && !family) ||
            (item.op == ForeignCall && foreign_abi != ScalarForeignABI))) {
            return Result.Rejected(base + pc, "native waiting function cannot fail, format or borrow foreign buffers yet");
        }
        if (item.op == Fail && (item.left < 0 || item.right < item.left)) {
            return Result.Rejected(base + pc, "native failure names no source range");
        }
        if (item.op == Fail && (item.target < 0 || item.target > length(texts) ||
                               (!ProgramMode(mode) && item.target != 0))) {
            return Result.Rejected(base + pc, "native assertion has invalid diagnostic metadata");
        }
        if (item.op == TypedFail) {
            if (!ProgramMode(mode)) {
                return Result.Rejected(base + pc, "typed failures require a standalone native program");
            }
            if (item.type != 0 || item.output != 0 || item.left != 0 || item.right != 0 || item.target != 0 ||
                item.literal < 1 || item.literal > 7) {
                return Result.Rejected(base + pc, "native typed failure has no valid failure kind");
            }
        }
        if ((item.op == Branch || item.op == Jump) && !Index(item.target, length(code))) {
            return Result.Rejected(base + pc, "native branch target is out of range");
        }
        if (item.op == Branch && !Typed(slots, item.left, 1)) {
            return Result.Rejected(base + pc, "native branch requires bool");
        }
        if (pc + 1 == length(code) && item.op != Return && item.op != End && item.op != Jump && item.op != Fail &&
            item.op != TypedFail) {
            return Result.Rejected(base + pc, "native scalar code falls outside its body");
        }
        pc += 1;
    }
    if (length(loan_uses) > 0) {
        for (loan in code) {
            if (loan.op == ArrayLoan && !loan_uses[loan.output]) {
                return Result.Rejected(base, "native foreign buffer loan belongs to one call argument");
            }
        }
    }
    if (pins) {
        error := ManagedPinsValid(code, slots);
        if (error != "") { return Result.Rejected(base, error); }
    }
    if (owner_pins) {
        error := TaskOwnersValid(code, slots, locals, records, lifecycle);
        if (error != "") { return Result.Rejected(base, error); }
    }
    if (plain_references) {
        error := TaskReferencesValid(lifecycle, slots, code, arguments, definitions);
        if (error != "") { return Result.Rejected(base, error); }
    }
    dominance := Dominators(code);
    pc = 0;
    while (pc < length(code)) {
        item := code[pc];
        if (item.op == StateLoad && item.left > 0 && !Dominates(dominance, definitions[item.left - 1], pc)) {
            return Result.Rejected(base + pc, "native retained initializer is not defined on every path");
        }
        if ((ReadsLeft(item.op) || (item.op == OwnerPin && item.target == 0)) && !Dominates(dominance, definitions[item.left], pc)) {
            return Result.Rejected(base + pc, "native scalar left operand is not defined on every path");
        }
        if (ReadsRight(item.op) && !Dominates(dominance, definitions[item.right], pc)) {
            return Result.Rejected(base + pc, "native scalar right operand is not defined on every path");
        }
        if (ReadsTarget(item.op) && !Dominates(dominance, definitions[item.target], pc)) {
            return Result.Rejected(base + pc, "native scalar operand is not defined on every path");
        }
        if (item.op == ArrayLoan && item.target == ArrayLoanMap && !Dominates(dominance, definitions[int(item.literal)], pc)) {
            return Result.Rejected(base + pc, "native map buffer key is not defined on every path");
        }
        if (item.op == ManagedTrack && item.target == ManagedTrackSlot && !Dominates(dominance, definitions[item.left], pc)) {
            return Result.Rejected(base + pc, "native collector root is not defined on every path");
        }
        if (ReadsArguments(item.op)) {
            for (index in 0..<ArgumentCount(item)) {
                if (!Dominates(dominance, definitions[arguments[item.right + index]], pc)) {
                    return Result.Rejected(base + pc, "native call argument is not defined on every path");
                }
            }
        }
        pc += 1;
    }
    return Result.Emitted("");
}
// Whether an array instruction reads the slots of its operands' types. The
// array is the left slot's: ArrayLength reads any array and gives an int,
// ArrayGet one of type's elements. ArrayContains reads the array and one
// element, literal its type. A BoolStorage result gives membership;
// IntStorage gives the first matching index or -1. Composite search requires
// target=1+its validated value-shape index. The
// others give the array type itself, ArraySet reading an int index right and a
// value in slot `target`, ArrayPush a value right, ArrayExtend another array,
// ArraySlice an int start right and an int count in slot `target`, and
// ArrayResize and ArrayRemove an int right.
ArrayValid :: (records: Record[], slots: int[], item: Instruction, nodes: SnapshotShapeNode[]) -> bool {
    if (!Index(item.left, length(slots))) {
        return false;
    }
    held := slots[item.left];
    if (item.op == ArrayBytes) {
        return item.type == ArrayType + abi.IntStorage && held == abi.TextStorage;
    }
    if (item.op == ArrayText) {
        return item.type == abi.TextStorage && held == ArrayType + abi.ByteStorage;
    }
    if (item.op == ArrayLength) {
        return item.type == abi.IntStorage && ElementType(records, held) != 0;
    }
    if (item.op == ArrayGet) {
        if (item.literal == i64(ArrayGetPlaceCheck)) {
            return item.type == abi.BoolStorage && ElementType(records, held) != 0 && Typed(slots, item.right, abi.IntStorage);
        }
        return item.type < ArrayType && item.type > 0 && held == ArrayType + item.type &&
               ElementType(records, held) != 0 && Typed(slots, item.right, abi.IntStorage) &&
               (item.literal == 0 || item.literal == 1);
    }
    if (item.op == ArrayContains) {
        // Bool gives membership; int gives the first matching index or -1.
        searched := ElementType(records, held);
        if ((item.type != abi.BoolStorage && item.type != abi.IntStorage) || searched == 0 || searched == PointerType ||
            item.literal != i64(searched) || !Typed(slots, item.right, searched)) { return false; }
        if (searched < RecordType) { return item.target == 0; }
        return Index(item.target - 1, length(nodes)) && nodes[item.target - 1].type == searched &&
               (nodes[item.target - 1].kind == SnapshotRecord || nodes[item.target - 1].kind == SnapshotUnion);
    }
    element := ElementType(records, item.type);
    if (element == 0 || held != item.type) {
        return false;
    }
    if (item.op == ArrayInsert) {
        return item.literal == 0 && Typed(slots, item.right, abi.IntStorage) && Typed(slots, item.target, element);
    }
    if (item.op == ArrayReverse) { return item.literal == 0 && item.right == 0 && item.target == 0; }
    if (item.op == ArraySet) {
        return (item.literal >= 0 && item.literal <= i64(ArraySetPlace)) &&
               Typed(slots, item.right, abi.IntStorage) && Typed(slots, item.target, element);
    }
    if (item.op == ArrayPush) {
        return Typed(slots, item.right, element);
    }
    if (item.op == ArrayExtend) {
        return Typed(slots, item.right, item.type);
    }
    if (item.op == ArraySlice) {
        return Typed(slots, item.right, abi.IntStorage) && Typed(slots, item.target, abi.IntStorage);
    }
    if (item.op == ArrayResize) {
        return Typed(slots, item.right, abi.IntStorage) && item.target == 0 &&
               (item.literal == 0 || (item.literal == i64(ArrayResizeInitialized) && element >= RecordType));
    }
    if (item.op == ArrayRemove) {
        return Typed(slots, item.right, abi.IntStorage);
    }
    return true;
}
// Whether a text instruction reads a string and an int, or only a string for
// TextLength, to give its type: an int, or for a slice a string.
TextValid :: (slots: int[], item: Instruction) -> bool {
    output := abi.TextStorage;
    if (item.op <= TextByte) {
        output = abi.IntStorage;
    }
    return item.type == output && Typed(slots, item.left, abi.TextStorage) &&
           (item.op == TextLength || Typed(slots, item.right, abi.IntStorage));
}
Operation :: (op: int, type: int) -> string {
    if (abi.Floating(type)) {
        // Ordered comparisons are false for NaN; != is unordered, so true.
        operations := ["fadd", "fsub", "fmul", "fdiv", "frem", "", "", "", "", "", "", "", "fcmp olt", "fcmp ole",
                       "fcmp ogt", "fcmp oge", "fcmp oeq", "fcmp une"];
        return operations[op - Add];
    }
    if (abi.Unsigned(type) && op >= Lt && op <= Ge) {
        predicates := ["icmp ult", "icmp ule", "icmp ugt", "icmp uge"];
        return predicates[op - Lt];
    }
    if (op == Add) {
        return "add";
    }
    if (op == Sub) {
        return "sub";
    }
    if (op == Mul) {
        return "mul";
    }
    if (op == BitAnd) {
        return "and";
    }
    if (op == BitOr) {
        return "or";
    }
    if (op == BitXor) {
        return "xor";
    }
    if (op == Lt) {
        return "icmp slt";
    }
    if (op == Le) {
        return "icmp sle";
    }
    if (op == Gt) {
        return "icmp sgt";
    }
    if (op == Ge) {
        return "icmp sge";
    }
    if (op == Eq) {
        return "icmp eq";
    }
    return "icmp ne";
}
Load :: (name: string, type: int, bank: string, index: int) -> string {
    return format_text("  %{} = load {}, ptr %{}{}\n", name, TypeName(type), bank, index);
}
Store :: (value: string, type: int, bank: string, index: int) -> string {
    return format_text("  store {} {}, ptr %{}{}\n", TypeName(type), value, bank, index);
}
// Integer operations never fail: x / 0 is 0, x % 0 is x, MIN / -1 wraps to
// MIN and MIN % -1 is 0, and a shift count at or past the width, read
// unsigned, gives 0, or the sign fill for a signed >>. The divisor and count
// are made safe for LLVM before the operation, so no result is poison and no
// path traps.
Total :: (item: Instruction, pc: int) -> string {
    t := abi.ScalarType(item.type);
    bits := abi.IntegerBits(item.type);
    if ((item.op == Div || item.op == Mod) && abi.Unsigned(item.type)) {
        guard := format_text("  %zero{} = icmp eq {} %b{}, 0\n  %d{} = select i1 %zero{}, {} 1, {} %b{}\n", pc, t, pc, pc,
                             pc, t, t, pc);
        if (item.op == Div) {
            return format_text("{}  %q{} = udiv {} %a{}, %d{}\n  %v{} = select i1 %zero{}, {} 0, {} %q{}\n", guard, pc, t,
                               pc, pc, pc, pc, t, t, pc);
        }
        return format_text("{}  %q{} = urem {} %a{}, %d{}\n  %v{} = select i1 %zero{}, {} %a{}, {} %q{}\n", guard, pc, t,
                           pc, pc, pc, pc, t, pc, t, pc);
    }
    if (item.op == Div || item.op == Mod) {
        // format_text renders at most twelve arguments, so each line is its own.
        guards := format_text("  %zero{} = icmp eq {} %b{}, 0\n  %negone{} = icmp eq {} %b{}, -1\n", pc, t, pc, pc, t, pc);
        guards = format_text("{}  %unsafe{} = or i1 %zero{}, %negone{}\n  %d{} = select i1 %unsafe{}, {} 1, {} %b{}\n",
                             guards, pc, pc, pc, pc, pc, t, t, pc);
        if (item.op == Div) {
            quotient := format_text("  %q{} = sdiv {} %a{}, %d{}\n  %negated{} = sub {} 0, %a{}\n", pc, t, pc, pc, pc, t, pc);
            quotient = format_text("{}  %w{} = select i1 %negone{}, {} %negated{}, {} %q{}\n", quotient, pc, pc, t, pc, t,
                                   pc);
            return format_text("{}{}  %v{} = select i1 %zero{}, {} 0, {} %w{}\n", guards, quotient, pc, pc, t, t, pc);
        }
        remainder := format_text("  %q{} = srem {} %a{}, %d{}\n  %w{} = select i1 %negone{}, {} 0, {} %q{}\n", pc, t, pc,
                                 pc, pc, pc, t, t, pc);
        return format_text("{}{}  %v{} = select i1 %zero{}, {} %a{}, {} %w{}\n", guards, remainder, pc, pc, t, pc, t, pc);
    }
    wide := format_text("  %wide{} = icmp uge {} %b{}, {}\n", pc, t, pc, bits);
    if (item.op == Shr && !abi.Unsigned(item.type)) {
        return format_text("{}  %count{} = select i1 %wide{}, {} {}, {} %b{}\n  %v{} = ashr {} %a{}, %count{}\n", wide, pc,
                           pc, t, bits - 1, t, pc, pc, t, pc, pc);
    }
    operation := "shl";
    if (item.op == Shr) {
        operation = "lshr";
    }
    shifted := format_text("  %count{} = and {} %b{}, {}\n  %q{} = {} {} %a{}, %count{}\n", pc, t, pc, bits - 1, pc,
                           operation, t, pc, pc);
    return format_text("{}{}  %v{} = select i1 %wide{}, {} 0, {} %q{}\n", wide, shifted, pc, pc, t, t, pc);
}
// The least and greatest values of an integer type, as LLVM literals.
Least :: (type: int) -> string {
    if (abi.Unsigned(type)) {
        return "0";
    }
    lows := ["-128", "-32768", "-2147483648", "-9223372036854775808"];
    return lows[Width(type)];
}
Greatest :: (type: int) -> string {
    if (abi.Unsigned(type)) {
        highs := ["255", "65535", "4294967295", "18446744073709551615"];
        return highs[Width(type)];
    }
    highs := ["127", "32767", "2147483647", "9223372036854775807"];
    return highs[Width(type)];
}
// 0 to 3 for 8 to 64 bits.
Width :: (type: int) -> int {
    bits := abi.IntegerBits(type);
    if (bits == 8) {
        return 0;
    }
    if (bits == 16) {
        return 1;
    }
    if (bits == 32) {
        return 2;
    }
    return 3;
}
// The intrinsic that converts a float or double to an integer type, as the
// runtime does: truncating toward zero, saturating, with NaN as 0.
Saturating :: (from: int, to: int) -> string {
    sign := "s";
    if (abi.Unsigned(to)) {
        sign = "u";
    }
    bits := "f32";
    if (from == abi.DoubleStorage) {
        bits = "f64";
    }
    return format_text("llvm.fpto{}i.sat.{}.{}", sign, abi.ScalarType(to), bits);
}
// The conversion of a floating value, or of an integer to double.
Floated :: (item: Instruction, pc: int) -> string {
    source := abi.ScalarType(item.right);
    target := abi.ScalarType(item.type);
    if (Integer(item.type)) {
        return format_text("  %v{} = call {} @{}({} %a{})\n", pc, target, Saturating(item.right, item.type), source, pc);
    }
    operation := "fptrunc";
    if (item.right == abi.FloatStorage) {
        operation = "fpext";
    } else if (Integer(item.right) && abi.Unsigned(item.right)) {
        operation = "uitofp";
    } else if (Integer(item.right)) {
        operation = "sitofp";
    }
    return format_text("  %v{} = {} {} %a{} to {}\n", pc, operation, source, pc, target);
}
// An integer conversion widens its operand to i65, which holds every value of
// every integer type, then clamps it to the target's range or keeps its low
// bits. A clamp never becomes a plain truncation.
Conversion :: (item: Instruction, pc: int) -> string {
    if (abi.Floating(item.right) || abi.Floating(item.type)) {
        return Floated(item, pc);
    }
    source := abi.ScalarType(item.right);
    extend := "sext";
    if (abi.Unsigned(item.right)) {
        extend = "zext";
    }
    out := format_text("  %x{} = {} {} %a{} to i65\n", pc, extend, source, pc);
    value := format_text("%x{}", pc);
    if (item.literal == 0) {
        out = format_text("{}  %below{} = icmp slt i65 %x{}, {}\n  %raised{} = select i1 %below{}, i65 {}, i65 %x{}\n", out,
                          pc, pc, Least(item.type), pc, pc, Least(item.type), pc);
        out = format_text("{}  %above{} = icmp sgt i65 %raised{}, {}\n  %clamped{} = select i1 %above{}, i65 {}, i65 %raised{}\n",
                          out, pc, pc, Greatest(item.type), pc, pc, Greatest(item.type), pc);
        value = format_text("%clamped{}", pc);
    }
    return format_text("{}  %v{} = trunc i65 {} to {}\n", out, pc, value, abi.ScalarType(item.type));
}
// A float or double constant as `name`, from its encoding's bits, so every
// value, NaN and signed zero included, is exact.
Encoded :: (literal: i64, type: int, name: string) -> string {
    if (type == abi.FloatStorage) {
        return format_text("  %{} = bitcast i32 {} to float\n", name, Spelled(literal, abi.UintStorage));
    }
    return format_text("  %{} = bitcast i64 {} to double\n", name, literal);
}
// The zero a slot, local or result starts as, which is also a record's
// constant. A string's is empty text.
Zero :: (type: int) -> string {
    if (type >= RecordType || type == abi.TextStorage || type == PointerType || type == ViewType) {
        return "zeroinitializer";
    }
    if (abi.Floating(type)) {
        return "0.0";
    }
    return "0";
}
// A literal as LLVM spells it: the signed value of its bits at its width.
Spelled :: (literal: i64, type: int) -> i64 {
    bits := abi.IntegerBits(type);
    if (bits == 0 || bits == 64 || !abi.Unsigned(type) || literal < (i64(1) << u32(bits - 1))) {
        return literal;
    }
    return literal - (i64(1) << u32(bits));
}
EmitInstruction :: (item: Instruction, pc: int, result: int, records: Record[], fields: int[], texts: string[],
                    coroutine: bool, program: bool, scoped: bool, record_owners: bool[], guarded: bool = false) -> string {
    out := format_text("p{}:\n", pc);
    type := TypeName(item.type);
    if (item.op == Constant && item.type == abi.TextStorage) {
        literal := int(item.literal);
        text := format_text("{ ptr @{}, i32 {}, ptr null }", TextSymbol(literal), strings.ByteLength(texts[literal]));
        out = format_text("{}{}", out, Store(text, item.type, "s", item.output));
    } else if (item.op == Constant && (item.type >= RecordType || item.type == PointerType || item.type == ViewType)) {
        out = format_text("{}{}", out, Store(Zero(item.type), item.type, "s", item.output));
    } else if (item.op == Constant && abi.Floating(item.type)) {
        out = format_text("{}{}", out, Encoded(item.literal, item.type, format_text("v{}", pc)));
        out = format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    } else if (item.op == Constant) {
        out = format_text("{}{}", out, Store(format_text("{}", Spelled(item.literal, item.type)), item.type, "s", item.output));
    } else if (item.op == Argument) {
        out = format_text("{}{}", out, Store(format_text("%arg{}", item.left), item.type, "s", item.output));
    } else if (item.op == Local) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.type, "l", item.left));
        out = format_text("{}{}", out, Store(format_text("%a{}", pc), item.type, "s", item.output));
    } else if (item.op == Save) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.type, "s", item.left));
        out = format_text("{}{}", out, Store(format_text("%a{}", pc), item.type, "l", item.target));
        if (item.type == TaskType) { out = format_text("{}{}", out, Store("0", TaskType, "s", item.left)); }
    } else if (item.op == Publish) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.type, "s", item.left));
        if (coroutine) {
            // coro.promise observers read the complete payload after this ramp
            // returns. Keep every field even when local tracing reads only one.
            out = format_text("{}  store volatile {} %a{}, ptr %result0\n", out, type, pc);
        } else { out = format_text("{}{}", out, Store(format_text("%a{}", pc), item.type, "result", 0)); }
        if (item.type == TaskType) { out = format_text("{}{}", out, Store("0", TaskType, "s", item.left)); }
    } else if ((item.op == Return || item.op == End) && coroutine) {
        // The result is in the promise; the coroutine finishes at its final suspension.
        return format_text("{}  br label %coro.final\n", out);
    } else if (item.op == Return || item.op == End) {
        out = format_text("{}{}", out, Load(format_text("return{}", pc), result, "result", 0));
        return format_text("{}{}", out, format_text("  ret {} %return{}\n", TypeName(result), pc));
    } else if (item.op == TypedFail) {
        return format_text("{}  call void @chibi_native_failure(i32 {})\n  unreachable\n", out, item.literal);
    } else if (item.op == Branch) {
        if (scoped && item.target <= pc) { out = format_text("{}  call void @chibi_native_step()\n", out); }
        out = format_text("{}{}", out, Load(format_text("a{}", pc), 1, "s", item.left));
        return format_text("{}{}", out, format_text("  br i1 %a{}, label %p{}, label %p{}\n", pc, item.target, pc + 1));
    } else if (item.op == Jump) {
        if (scoped && item.target <= pc) { out = format_text("{}  call void @chibi_native_step()\n", out); }
        return format_text("{}{}", out, format_text("  br label %p{}\n", item.target));
    } else if (item.op == Check && scoped) {
        out = format_text("{}  call void @chibi_native_step()\n", out);
    } else if (item.op == Check) {
        // CHECKs, not LLVM instructions, consume the caller's positive bound.
        // Compare before subtracting: exactly N CHECKs may pass a budget N.
        out = format_text("{}  %remaining{} = load i32, ptr %budget0\n  %available{} = icmp sgt i32 %remaining{}, 0\n  br i1 %available{}, label %budget_ok{}, label %trap\nbudget_ok{}:\n  %next_budget{} = sub i32 %remaining{}, 1\n  store i32 %next_budget{}, ptr %budget0\n",
                          out, pc, pc, pc, pc, pc, pc, pc, pc, pc);
    } else if (item.op == Convert) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.right, "s", item.left));
        out = format_text("{}{}", out, Conversion(item, pc));
        out = format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    } else if (item.op == Insert) {
        field := FieldType(records, fields, item.type, item.literal);
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.type, "s", item.left));
        out = format_text("{}{}", out, Load(format_text("b{}", pc), field, "s", item.right));
        out = format_text("{}  %v{} = insertvalue {} %a{}, {} %b{}, {}\n", out, pc, type, pc, TypeName(field), pc,
                          item.literal);
        out = format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    } else if (item.op == Extract) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.right, "s", item.left));
        out = format_text("{}  %v{} = extractvalue {} %a{}, {}\n", out, pc, TypeName(item.right), pc, item.literal);
        out = format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    } else if (item.op == LocalAddress) {
        out = format_text("{}{}", out, Store(format_text("%l{}", item.left), item.type, "s", item.output));
    } else if (item.op == FieldAddress) {
        // A reference parameter's local holds the record's address; any other
        // local is the record.
        base_address := format_text("%l{}", item.left);
        if (item.target == 1) {
            out = format_text("{}  %field_base{} = load ptr, ptr %l{}\n", out, pc, item.left);
            base_address = format_text("%field_base{}", pc);
        }
        out = format_text("{}  %v{} = getelementptr inbounds {}, ptr {}, i32 0, i32 {}\n", out, pc, TypeName(item.right),
                           base_address, item.literal);
        out = format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    } else if (item.op == ArrayValueAddress) {
        out = format_text("{}{}", out, ArrayValueReference(item, pc, program));
    } else if (item.op == Deref) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), RefType + item.type, "s", item.left));
        out = format_text("{}  %v{} = load {}, ptr %a{}\n", out, pc, type, pc);
        out = format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    } else if (item.op == Poke) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), RefType + item.type, "s", item.left));
        out = format_text("{}{}", out, Load(format_text("b{}", pc), item.type, "s", item.right));
        out = format_text("{}  store {} %b{}, ptr %a{}\n", out, type, pc, pc);
    } else if (item.op == StateLoad) {
        out = format_text("{}{}", out, StateRead(item, pc, record_owners));
    } else if (item.op == StateStore) {
        out = format_text("{}{}", out, StateWrite(item, pc, record_owners));
    } else if (item.op == ArrayDrop) {
        out = format_text("{}{}", out, ArrayDropped(item, pc));
    } else if (item.op == TextRetain || item.op == TextRelease) {
        out = format_text("{}{}", out, TextCounted(item, pc));
    } else if (item.op == ValueCopy) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.type, "s", item.left));
        if (item.type >= MapType && item.type < RefType) {
            out = format_text("{}  %copied{} = call {} @chibi_map.share({} %a{})\n", out, pc, type, type, pc);
            out = format_text("{}{}", out, Store(format_text("%copied{}", pc), item.type, "s", item.output));
        } else if (item.type >= ArrayType && item.type < MapType) {
            out = format_text("{}  %copied{} = call {} @chibi_array.{}.copy(ptr %ctx, {} %a{})\n", out, pc, type, item.type, type, pc);
            out = format_text("{}{}", out, Store(format_text("%copied{}", pc), item.type, "s", item.output));
        } else {
            out = format_text("{}{}", out, Store(format_text("%a{}", pc), item.type, "s", item.output));
            out = format_text("{}  call void @chibi_value.{}.keep_at(ptr %ctx, ptr %s{})\n", out, item.type, item.output);
        }
    } else if (item.op == ValueDrop) {
        if (item.type >= MapType && item.type < RefType) {
            out = format_text("{}{}", out, Load(format_text("a{}", pc), item.type, "s", item.left));
            out = format_text("{}  call void @chibi_map.{}.drop(ptr %ctx, {} %a{})\n", out, item.type, type, pc);
        } else if (item.type >= ArrayType && item.type < MapType) {
            out = format_text("{}{}", out, ArrayDropped(item, pc));
        } else {
            out = format_text("{}  call void @chibi_value.{}.drop_at(ptr %ctx, ptr %s{})\n", out, item.type, item.left);
        }
    } else if (item.op == ArrayBytes) {
        out = format_text("{}{}", out, ArrayBytesRead(item, pc));
    } else if (item.op == ArrayText) {
        out = format_text("{}{}", out, ArrayTextRead(item, pc, guarded));
    } else if MapOperation(item.op) {
        out = format_text("{}{}", out, MapRead(item, pc));
    } else if ((item.op >= ArrayLength && item.op <= ArrayRemove) || item.op == ArrayInsert || item.op == ArrayReverse) {
        out = format_text("{}{}", out, ArrayRead(item, pc, record_owners, program));
    } else if (item.op == Select) {
        out = format_text("{}{}", out, Load(format_text("c{}", pc), abi.BoolStorage, "s", item.left));
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.type, "s", item.right));
        out = format_text("{}{}", out, Load(format_text("b{}", pc), item.type, "s", item.target));
        out = format_text("{}  %v{} = select i1 %c{}, {} %a{}, {} %b{}\n", out, pc, pc, type, pc, type, pc);
        out = format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    } else if (item.op == Print) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), abi.TextStorage, "s", item.left));
        out = format_text("{}  %bytes{} = extractvalue {} %a{}, 0\n  %length{} = extractvalue {} %a{}, 1\n", out, pc, abi.TextType(), pc, pc, abi.TextType(), pc);
        out = format_text("{}  call void @chibi_print_string(ptr %ctx, ptr %bytes{}, i32 %length{})\n", out, pc, pc);
        out = format_text("{}{}", out, Store("0", abi.IntStorage, "s", item.output));
    } else if (TextSequenceOperation(item.op)) {
        out = format_text("{}{}", out, TextSequenceInstruction(item, pc));
    } else if (item.op >= TextLength && item.op <= TextTake) {
        out = format_text("{}{}", out, TextRead(item, pc));
    } else if (item.type == PointerType) {
        out = format_text("{}{}", out, ManagedComparison(item, pc));
    } else if (item.type == abi.TextStorage) {
        // Strings are equal when their bytes are; != negates that.
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.type, "s", item.left));
        out = format_text("{}{}", out, Load(format_text("b{}", pc), item.type, "s", item.right));
        name := format_text("v{}", pc);
        if (item.op == Ne) {
            name = format_text("e{}", pc);
        }
        out = format_text("{}  %{} = call i1 @chibi_scalar.text_equal({} %a{}, {} %b{})\n", out, name, type, pc, type, pc);
        if (item.op == Ne) {
            out = format_text("{}  %v{} = xor i1 %e{}, true\n", out, pc, pc);
        }
        out = format_text("{}{}", out, Store(format_text("%v{}", pc), 1, "s", item.output));
    } else {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.type, "s", item.left));
        if (Unary(item.op)) {
            if (item.op == Sqrt) {
                out = format_text("{}  %v{} = call float @llvm.sqrt.f32(float %a{})\n", out, pc, pc);
            } else if (item.op == FloatAbs) {
                suffix := "f64";
                if (item.type == abi.FloatStorage) { suffix = "f32"; }
                out = format_text("{}  %v{} = call {} @llvm.fabs.{}({} %a{})\n", out, pc, type, suffix, type, pc);
            } else if (item.op == Neg && abi.Floating(item.type)) {
                // Flips the sign bit, as the VMs' negation does: -0.0 for 0.0.
                out = format_text("{}{}", out, format_text("  %v{} = fneg {} %a{}\n", pc, type, pc));
            } else if (item.op == Neg) {
                out = format_text("{}{}", out, format_text("  %v{} = sub {} 0, %a{}\n", pc, type, pc));
            } else {
                out = format_text("{}{}", out, format_text("  %v{} = xor {} %a{}, -1\n", pc, type, pc));
            }
        } else {
            out = format_text("{}{}", out, Load(format_text("b{}", pc), item.type, "s", item.right));
            if (Integer(item.type) && (item.op == Div || item.op == Mod || item.op == Shl || item.op == Shr)) {
                out = format_text("{}{}", out, Total(item, pc));
            } else {
                out = format_text("{}{}", out, format_text("  %v{} = {} {} %a{}, %b{}\n", pc, Operation(item.op, item.type),
                                                           type, pc, pc));
            }
        }
        output := item.type;
        if (Comparison(item.op)) {
            output = 1;
        }
        out = format_text("{}{}", out, Store(format_text("%v{}", pc), output, "s", item.output));
    }
    return format_text("{}{}", out, format_text("  br label %p{}\n", pc + 1));
}

// The operation of the context at field `field`, loaded as `name`.
ContextCall :: (name: string, field: int, guarded: bool = false) -> string {
    if (guarded && (field == 2 || field == 4)) {
        operation := "allocate";
        if (field == 4) { operation = "release"; }
        return format_text("  %{} = getelementptr i8, ptr @chibi_managed.{}, i64 0\n", name, operation);
    }
    out := format_text("  %{}.at = getelementptr inbounds {}, ptr %ctx, i32 0, i32 {}\n", name, abi.ContextType(), field);
    return format_text("{}  %{} = load ptr, ptr %{}.at\n", out, name, name);
}
// The context's allocate of `bytes`, an i64 value, as `name`.
Allocated :: (name: string, bytes: string, guarded: bool = false) -> string {
    out := ContextCall(format_text("{}.allocate", name), 2, guarded);
    return format_text("{}  %{} = call ptr %{}.allocate(ptr %ctx, i64 {})\n", out, name, name, bytes);
}
// The byte size of one `type`, an i64 named `name`.
Sized :: (name: string, type: int) -> string {
    out := format_text("  %{}.at = getelementptr {}, ptr null, i32 1\n", name, TypeName(type));
    return format_text("{}  %{} = ptrtoint ptr %{}.at to i64\n", out, name, name);
}
// A reference added to, or given back from, the owner of the string in the
// left slot, by the module's helpers.
TextCounted :: (item: Instruction, pc: int) -> string {
    text := abi.TextType();
    out := Load(format_text("t{}", pc), abi.TextStorage, "s", item.left);
    out = format_text("{}  %owner{} = extractvalue {} %t{}, 2\n", out, pc, text, pc);
    if (item.op == TextRetain) {
        return format_text("{}  call void @chibi_scalar.retain(ptr %owner{})\n", out, pc);
    }
    return format_text("{}  call void @chibi_scalar.free(ptr %ctx, ptr %owner{})\n", out, pc);
}
// Whether an array of `type` holds strings, which each hold a reference.
Holding :: (type: int) -> bool {
    return type == ArrayType + abi.TextStorage;
}
ArrayRefs :: (record_owners: bool[], type: int, data: string, count: string, keep: bool) -> string {
    if (Holding(type)) {
        if (keep) { return format_text("  call void @chibi_scalar.retain_range(ptr {}, i32 {})\n", data, count); }
        return format_text("  call void @chibi_scalar.free_range(ptr %ctx, ptr {}, i32 {})\n", data, count);
    }
    element := type - ArrayType;
    if (element < RecordType || element >= ArrayType || element - RecordType >= length(record_owners) ||
        !record_owners[element - RecordType]) {
        return "";
    }
    operation := "drop";
    if (keep) { operation = "copy"; }
    return format_text("  call void @chibi_value.{}.{}_range(ptr %ctx, ptr {}, i32 {})\n", element, operation, data, count);
}
// A piece's helper closure: ownership instructions, container payloads and
// recursively owned fields. One worklist serves both value and array modules.
ValueUse :: struct { records: bool[]; ranges: bool[]; by_value: bool[]; arrays: int[]; maps: int[]; }
ValueClosure :: struct { used: ValueUse; owners: bool[]; pending: int[]; maps: u32[]; }
// Map payloads are immediate storage types below MapType, never recursively
// packed map encodings. Their key/value pair indexes a fixed 4KiB bitset.
ValueReach :: (build: ^ValueClosure, held: int, range: bool, by_value: bool) {
    type := held;
    if (type >= MapType && type < RefType) {
        if (length(build^.maps) == 0) { build^.maps = resize([u32(0)], MapType / 2); }
        index := type - MapType;
        word := index / 32;
        bit := u32(1) << u32(index % 32);
        if ((build^.maps[word] & bit) == 0) {
            build^.maps[word] = build^.maps[word] | bit;
            build^.used.maps.append(type);
            build^.pending.append(type);
        }
        return;
    }
    ranged := range;
    if (type >= ArrayType && type < MapType) {
        build^.used.arrays[type - ArrayType] = build^.used.arrays[type - ArrayType] | ArrayAllocation | ArrayCloning | ArrayDropping | ArraySharing;
        type -= ArrayType;
        ranged = true;
    }
    if (type < RecordType || type >= ArrayType || !build^.owners[type - RecordType]) { return; }
    index := type - RecordType;
    if (ranged) { build^.used.ranges[index] = true; }
    if (by_value) { build^.used.by_value[index] = true; }
    if (!build^.used.records[index]) {
        build^.used.records[index] = true;
        build^.pending.append(type);
    }
}
ValueUses :: (code: Instruction[], records: Record[], fields: int[], owners: bool[], promises: int[]) -> ValueUse {
    build: ValueClosure = {used: {records: resize([false], length(records)), ranges: resize([false], length(records)),
                                  by_value: resize([false], length(records)), arrays: ArrayUses(code, promises), maps: []},
                           owners: owners, pending: [], maps: []};
    for (type in promises) {
        if (type >= RecordType && type < ArrayType) { ValueReach(&build, type, false, true); }
    }
    for (item in code) {
        mapped := MapInstructionType(item);
        if (mapped != 0) { ValueReach(&build, mapped, false, false); continue; }
        type := 0;
        if (item.op == OwnerPin || item.op == ValueCopy || item.op == ValueDrop || item.op == StateLoad || item.op == StateStore) { type = item.type; }
        if (item.op == AwaitResult) { type = item.right; }
        if (type >= RecordType && type < ArrayType) {
            ValueReach(&build, type, false, item.op == OwnerPin || item.op == AwaitResult);
        }
    }
    for (index in 0..<length(build.used.arrays)) {
        if (build.used.arrays[index] != 0 && index >= RecordType && index < ArrayType) {
            ValueReach(&build, index, true, false);
        }
    }
    at := 0;
    while (at < length(build.pending)) {
        type := build.pending[at];
        if (type >= MapType) {
            value := MapValue(type);
            ValueReach(&build, value, false, value >= RecordType && value < ArrayType);
        } else {
            record := records[type - RecordType];
            for (field in record.first..<record.first + record.count) {
                ValueReach(&build, fields[field], false, false);
            }
        }
        at += 1;
    }
    return build.used;
}
ValueModule :: (used: ValueUse, records: Record[], fields: int[], layout: ValueLayout, drain: bool = true) -> string {
    out: string[] = [];
    queued := false;
    for (index in 0..<length(records)) {
        if (!used.records[index]) { continue; }
        type := RecordType + index;
        queued = queued || layout.backed[index];
        out.append(ValueRecordAt(type, records, fields, layout, true));
        out.append(ValueRecordAt(type, records, fields, layout, false));
        if (used.by_value[index]) {
            out.append(ValueRecordCopy(type));
            out.append(ValueRecordDrop(type));
        }
        if (used.ranges[index]) {
            out.append(ValueRecordRange(type, true, layout.backed[index]));
            out.append(ValueRecordRange(type, false, layout.backed[index]));
        }
    }
    if (queued && drain) { out.append(ValueDrain()); }
    return strings.Join(out, "");
}
// The helpers a module that counts references calls: one reference added to or
// given back from an owner (null has none), and the same for the owner of each
// of `count` strings from `data` on.
TextHelpers :: (guarded: bool = false) -> string {
    out := "define internal void @chibi_scalar.retain(ptr %owner) {\nentry:\n  %counted = icmp ne ptr %owner, null\n";
    out = format_text("{}  br i1 %counted, label %count, label %done\ncount:\n", out);
    out = format_text("{}  %before = atomicrmw add ptr %owner, i64 1 monotonic\n  br label %done\ndone:\n  ret void\n}}\n", out);
    out = format_text("{}define internal void @chibi_scalar.free(ptr %ctx, ptr %owner) {{\nentry:\n", out);
    out = format_text("{}  %counted = icmp ne ptr %owner, null\n  br i1 %counted, label %count, label %done\ncount:\n", out);
    out = format_text("{}  %before = atomicrmw sub ptr %owner, i64 1 acq_rel\n  %last = icmp eq i64 %before, 1\n", out);
    out = format_text("{}  br i1 %last, label %release, label %done\nrelease:\n", out);
    if (guarded) { out = strings.Concatenate([out, ContextCall("give", 4, true)]); }
    else { out = format_text("{}  %at = getelementptr inbounds {}, ptr %ctx, i32 0, i32 4\n  %give = load ptr, ptr %at\n", out, abi.ContextType()); }
    out = format_text("{}  call void %give(ptr %ctx, ptr %owner)\n  br label %done\ndone:\n  ret void\n}}\n", out);
    out = format_text("{}define internal void @chibi_scalar.retain_range(ptr %data, i32 %count) {{\nentry:\n  br label %head\n", out);
    out = format_text("{}head:\n  %index = phi i32 [ 0, %entry ], [ %next, %body ]\n  %end = icmp eq i32 %index, %count\n", out);
    out = format_text("{}  br i1 %end, label %done, label %body\nbody:\n  %offset = zext i32 %index to i64\n", out);
    out = format_text("{}  %at = getelementptr inbounds {}, ptr %data, i64 %offset, i32 2\n  %owner = load ptr, ptr %at\n", out, abi.TextType());
    out = format_text("{}  call void @chibi_scalar.retain(ptr %owner)\n  %next = add i32 %index, 1\n  br label %head\ndone:\n  ret void\n}}\n", out);
    out = format_text("{}define internal void @chibi_scalar.free_range(ptr %ctx, ptr %data, i32 %count) {{\nentry:\n  br label %head\n", out);
    out = format_text("{}head:\n  %index = phi i32 [ 0, %entry ], [ %next, %body ]\n  %end = icmp eq i32 %index, %count\n", out);
    out = format_text("{}  br i1 %end, label %done, label %body\nbody:\n  %offset = zext i32 %index to i64\n", out);
    out = format_text("{}  %at = getelementptr inbounds {}, ptr %data, i64 %offset, i32 2\n  %owner = load ptr, ptr %at\n", out, abi.TextType());
    return format_text("{}  call void @chibi_scalar.free(ptr %ctx, ptr %owner)\n  %next = add i32 %index, 1\n  br label %head\ndone:\n  ret void\n}}\n", out);
}
// Whether `code` counts references, so the module has the helpers.
Counts :: (code: Instruction[]) -> bool {
    for (item in code) {
        if ((item.op == ValueCopy || item.op == ValueDrop) && item.type >= MapType && item.type < RefType) {
            if (MapHolds(item.type)) { return true; }
            continue;
        }
        if (TextSequenceOperation(item.op) || item.op == ArrayValueAddress || item.op == OwnerPin || item.op == TextRetain || item.op == TextRelease || item.op == ValueCopy || item.op == ValueDrop || item.op == ArrayDrop || Holding(item.type) ||
            ((item.op == StateLoad || item.op == StateStore) && (item.type == abi.TextStorage || item.type >= RecordType))) {
            return true;
        }
        if (MapOperation(item.op) && MapHolds(MapUsed(item))) {
            return true;
        }
    }
    return false;
}
// The context's release of the elements of the array in the left slot, unless
// it has none.
ArrayDropped :: (item: Instruction, pc: int) -> string {
    out := Load(format_text("a{}", pc), item.type, "s", item.left);
    return format_text("{}  call void @chibi_array.{}.drop(ptr %ctx, {} %a{})\n", out, item.type, abi.ArrayType(), pc);
}
// An array's length, an element, an element's replacement or an append, or a
// copy of its elements. A read or write is only inside the array, so none
// passes the elements, and an append that fills the array moves its elements
// to an allocation twice the size, or four elements.
ArrayRead :: (item: Instruction, pc: int, record_owners: bool[], program: bool) -> string {
    array := abi.ArrayType();
    // Every array type is the same LLVM type.
    out := Load(format_text("a{}", pc), ArrayType + abi.IntStorage, "s", item.left);
    out = format_text("{}  %length{} = extractvalue {} %a{}, 0\n", out, pc, array, pc);
    if (item.op == ArrayLength) {
        return format_text("{}{}", out, Store(format_text("%length{}", pc), item.type, "s", item.output));
    }
    if (item.op == ArrayCopy) {
        return format_text("{}{}", out, ArrayCopied(item, pc));
    }
    if (item.op == ArrayPush) {
        return format_text("{}{}", out, ArrayPushed(item, pc));
    }
    if (item.op == ArrayExtend) {
        return format_text("{}{}", out, ArrayExtended(item, pc, record_owners));
    }
    if (item.op == ArraySlice) {
        return format_text("{}{}", out, ArraySliced(item, pc, record_owners));
    }
    if (item.op == ArrayResize) {
        return format_text("{}{}", out, ArrayResized(item, pc, record_owners, program));
    }
    if (item.op == ArrayContains) {
        return format_text("{}{}", out, ArrayFound(item, pc));
    }
    if (item.op == ArrayRemove) {
        return format_text("{}{}", out, ArrayRemoved(item, pc, record_owners));
    }
    if (item.op == ArrayInsert) { return format_text("{}{}", out, ArrayInserted(item, pc)); }
    if (item.op == ArrayReverse) { return format_text("{}{}", out, ArrayReversed(item, pc)); }
    element := item.type;
    if (item.op == ArraySet) {
        element = item.type - ArrayType;
    }
    type := TypeName(element);
    out = format_text("{}{}", out, Load(format_text("b{}", pc), abi.IntStorage, "s", item.right));
    out = format_text("{}  %in{} = icmp ult i32 %b{}, %length{}\n", out, pc, pc, pc);
    out = format_text("{}  br i1 %in{}, label %inside{}, label %outside{}\noutside{}:\n", out, pc, pc, pc, pc);
    forgiving := item.op == ArraySet && item.literal == i64(ArraySetUnchanged);
    if (forgiving) {
        // The prepared item owns its leaves even when no element is replaced.
        out = format_text("{}{}", out, ArrayRefs(record_owners, item.type, format_text("%s{}", item.target), "1", false));
        out = format_text("{}{}", out, Store(format_text("%a{}", pc), item.type, "s", item.output));
        out = format_text("{}  br label %array_done{}\ninside{}:\n", out, pc, pc);
    } else if ((item.op == ArrayGet && item.literal != 0) ||
               (item.op == ArraySet && item.literal == i64(ArraySetPlace))) {
        if (program) { out = format_text("{}  call void @chibi_native_reference_unavailable()\n", out); }
        else { out = format_text("{}  call void @llvm.trap()\n", out); }
        out = format_text("{}  unreachable\ninside{}:\n", out, pc);
    } else {
        out = format_text("{}{}", out, ContextCall(format_text("index{}", pc), 3));
        out = format_text("{}  call void %index{}(ptr %ctx, i32 %b{}, i32 %length{})\n  unreachable\ninside{}:\n", out, pc, pc,
                          pc, pc);
    }
    if (item.op == ArrayGet && item.literal == i64(ArrayGetPlaceCheck)) {
        return format_text("{}{}", out, Store("true", abi.BoolStorage, "s", item.output));
    }
    writable := format_text("%a{}", pc);
    if (item.op == ArraySet) {
        out = format_text("{}  %unique{} = call {} @chibi_array.{}.unique(ptr %ctx, {} %a{}, i32 %length{}, i1 true)\n", out, pc, array, item.type, array, pc, pc);
        writable = format_text("%unique{}", pc);
    }
    out = format_text("{}  %data{} = extractvalue {} {}, 2\n  %offset{} = zext i32 %b{} to i64\n", out, pc, array, writable, pc, pc);
    out = format_text("{}  %at{} = getelementptr inbounds {}, ptr %data{}, i64 %offset{}\n", out, pc, type, pc, pc);
    if (item.op == ArraySet) {
        out = format_text("{}{}", out, ArrayRefs(record_owners, item.type, format_text("%at{}", pc), "1", false));
    }
    if (item.op == ArrayGet) {
        out = format_text("{}  %v{} = load {}, ptr %at{}\n", out, pc, type, pc);
        return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    }
    out = format_text("{}{}", out, Load(format_text("c{}", pc), element, "s", item.target));
    out = format_text("{}  store {} %c{}, ptr %at{}\n", out, type, pc, pc);
    out = format_text("{}{}", out, Store(writable, item.type, "s", item.output));
    if (forgiving) { out = format_text("{}  br label %array_done{}\narray_done{}:\n", out, pc, pc); }
    return out;
}
// The array of the elements of the array loaded as %a<pc> with the value in
// the right slot after them, in the allocation the elements already have
// when it has room.
ArrayPushed :: (item: Instruction, pc: int) -> string {
    array := abi.ArrayType();
    element := item.type - ArrayType;
    out := Load(format_text("c{}", pc), element, "s", item.right);
    out = format_text("{}  %next{} = add i32 %length{}, 1\n", out, pc, pc);
    out = format_text("{}  %unique{} = call {} @chibi_array.{}.unique(ptr %ctx, {} %a{}, i32 %next{}, i1 {})\n",
                      out, pc, array, item.type, array, pc, pc, item.literal == 1);
    out = format_text("{}  %data{} = extractvalue {} %unique{}, 2\n  %offset{} = zext i32 %length{} to i64\n", out, pc, array, pc, pc, pc);
    out = format_text("{}  %at{} = getelementptr inbounds {}, ptr %data{}, i64 %offset{}\n", out, pc, TypeName(element), pc, pc);
    out = format_text("{}  store {} %c{}, ptr %at{}\n", out, TypeName(element), pc, pc);
    out = format_text("{}  %v{} = insertvalue {} %unique{}, i32 %next{}, 0\n", out, pc, array, pc, pc);
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}
// The array of the elements of the array loaded as %a<pc> followed by those of
// the array in the right slot, in the allocation the first has when it has
// room, and otherwise in one of twice the size, or as many elements as it
// needs.
ArrayExtended :: (item: Instruction, pc: int, record_owners: bool[]) -> string {
    array := abi.ArrayType();
    element := item.type - ArrayType;
    out := Load(format_text("o{}", pc), item.type, "s", item.right);
    out = format_text("{}  %extra{} = extractvalue {} %o{}, 0\n  %source{} = extractvalue {} %o{}, 2\n", out, pc, array, pc, pc, array, pc);
    out = format_text("{}  %total{} = add i32 %length{}, %extra{}\n", out, pc, pc, pc);
    // A self-extension must keep the old source alive if uniqueness/growth
    // replaces it. Without growth the non-overlapping tail can copy in place.
    out = format_text("{}  %owner{} = extractvalue {} %a{}, 3\n  %other{} = extractvalue {} %o{}, 3\n", out, pc, array, pc, pc, array, pc);
    out = format_text("{}  %capacity{} = extractvalue {} %a{}, 1\n  %grow{} = icmp ugt i32 %total{}, %capacity{}\n", out, pc, array, pc, pc, pc, pc);
    out = format_text("{}  %same{} = icmp eq ptr %owner{}, %other{}\n  %owned{} = icmp ne ptr %owner{}, null\n", out, pc, pc, pc, pc, pc);
    out = format_text("{}  %alias{} = and i1 %same{}, %owned{}\n  %growing{} = and i1 %alias{}, %grow{}\n", out, pc, pc, pc, pc, pc, pc);
    out = format_text("{}  %lease{} = and i1 %growing{}, {}\n  br i1 %lease{}, label %keep{}, label %ready{}\nkeep{}:\n", out, pc, pc, item.literal == 1, pc, pc, pc, pc);
    out = format_text("{}  call void @chibi_scalar.retain(ptr %other{})\n  br label %ready{}\nready{}:\n", out, pc, pc, pc);
    out = format_text("{}  %unique{} = call {} @chibi_array.{}.unique(ptr %ctx, {} %a{}, i32 %total{}, i1 {})\n", out, pc, array, item.type, array, pc, pc, item.literal == 1);
    out = format_text("{}  %data{} = extractvalue {} %unique{}, 2\n  %offset{} = zext i32 %length{} to i64\n", out, pc, array, pc, pc, pc);
    out = format_text("{}  %at{} = getelementptr inbounds {}, ptr %data{}, i64 %offset{}\n", out, pc, TypeName(element), pc, pc);
    out = format_text("{}{}", out, Sized(format_text("width{}", pc), element));
    out = format_text("{}  %added{} = zext i32 %extra{} to i64\n  %bytes{} = mul i64 %added{}, %width{}\n", out, pc, pc, pc, pc, pc);
    out = format_text("{}  call void @chibi_scalar.copy(ptr %at{}, ptr %source{}, i64 %bytes{})\n", out, pc, pc, pc);
    out = format_text("{}{}", out, ArrayRefs(record_owners, item.type, format_text("%at{}", pc), format_text("%extra{}", pc), true));
    out = format_text("{}  br i1 %lease{}, label %release{}, label %done{}\nrelease{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}  call void @chibi_array.{}.drop(ptr %ctx, {} %o{})\n  br label %done{}\ndone{}:\n", out, item.type, array, pc, pc, pc);
    out = format_text("{}  %v{} = insertvalue {} %unique{}, i32 %total{}, 0\n", out, pc, array, pc, pc);
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}
// A new array of the elements of the array loaded as %a<pc> from the start in
// the right slot, as many as the count in slot `target`, each clamped to the
// array, or the empty array for none.
ArraySliced :: (item: Instruction, pc: int, record_owners: bool[]) -> string {
    array := abi.ArrayType();
    element := item.type - ArrayType;
    type := TypeName(element);
    out := Load(format_text("b{}", pc), abi.IntStorage, "s", item.right);
    out = format_text("{}{}", out, Load(format_text("c{}", pc), abi.IntStorage, "s", item.target));
    out = format_text("{}  %data{} = extractvalue {} %a{}, 2\n", out, pc, array, pc);
    out = format_text("{}  %below{} = icmp slt i32 %b{}, 0\n  %low{} = select i1 %below{}, i32 0, i32 %b{}\n", out, pc,
                      pc, pc, pc, pc);
    out = format_text("{}  %over{} = icmp sgt i32 %low{}, %length{}\n  %first{} = select i1 %over{}, i32 %length{}, i32 %low{}\n",
                      out, pc, pc, pc, pc, pc, pc, pc);
    out = format_text("{}  %room{} = sub i32 %length{}, %first{}\n", out, pc, pc, pc);
    out = format_text("{}  %less{} = icmp slt i32 %c{}, 0\n  %want{} = select i1 %less{}, i32 0, i32 %c{}\n", out, pc,
                      pc, pc, pc, pc);
    out = format_text("{}  %more{} = icmp sgt i32 %want{}, %room{}\n  %n{} = select i1 %more{}, i32 %room{}, i32 %want{}\n",
                      out, pc, pc, pc, pc, pc, pc, pc);
    out = format_text("{}  %none{} = icmp eq i32 %n{}, 0\n", out, pc, pc);
    out = format_text("{}  br i1 %none{}, label %done{}, label %clone{}\nclone{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}{}", out, Sized(format_text("width{}", pc), element));
    out = format_text("{}  %count{} = zext i32 %n{} to i64\n  %bytes{} = mul i64 %count{}, %width{}\n", out, pc, pc, pc,
                      pc, pc);
    out = format_text("{}{}", out, format_text("  %allocated{} = call {} @chibi_array.{}.allocate(ptr %ctx, i32 %n{}, i32 %n{})\n  %fresh{} = extractvalue {} %allocated{}, 2\n", pc, array, item.type, pc, pc, pc, array, pc));
    out = format_text("{}  %skip{} = zext i32 %first{} to i64\n", out, pc, pc);
    out = format_text("{}  %from{} = getelementptr inbounds {}, ptr %data{}, i64 %skip{}\n", out, pc, type, pc, pc);
    out = format_text("{}  call void @chibi_scalar.copy(ptr %fresh{}, ptr %from{}, i64 %bytes{})\n", out, pc, pc, pc);
    out = format_text("{}{}", out, ArrayRefs(record_owners, item.type, format_text("%fresh{}", pc), format_text("%n{}", pc), true));
    out = format_text("{}  br label %done{}\ndone{}:\n", out, pc, pc);
    out = format_text("{}  %v{} = phi {} [ zeroinitializer, %p{} ], [ %allocated{}, %clone{} ]\n", out, pc, array, pc, pc, pc);
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}
// A new array of the length in the right slot, 0 if it is negative: the first
// elements of the array loaded as %a<pc>, then zeros.
ArrayResized :: (item: Instruction, pc: int, record_owners: bool[], program: bool) -> string {
    array := abi.ArrayType();
    element := item.type - ArrayType;
    out := Load(format_text("b{}", pc), abi.IntStorage, "s", item.right);
    out = format_text("{}  %data{} = extractvalue {} %a{}, 2\n", out, pc, array, pc);
    out = format_text("{}  %below{} = icmp slt i32 %b{}, 0\n  %n{} = select i1 %below{}, i32 0, i32 %b{}\n", out, pc, pc,
                      pc, pc, pc);
    beginning := format_text("p{}", pc);
    if (item.literal == i64(ArrayResizeInitialized)) {
        out = format_text("{}  %fits{} = icmp ule i32 %n{}, %length{}\n  br i1 %fits{}, label %resize_valid{}, label %resize_invalid{}\nresize_invalid{}:\n", out, pc, pc, pc, pc, pc, pc, pc);
        if (program) { out = format_text("{}  call void @chibi_native_failure(i32 0)\n", out); }
        else {
            out = format_text("{}  %resize.failure{} = getelementptr inbounds {}, ptr %ctx, i32 0, i32 1\n  store ptr @chibi_scalar.resize_failure, ptr %resize.failure{}\n  br label %failed\n", out, pc, abi.ContextType(), pc);
        }
        if (program) { out = format_text("{}  unreachable\n", out); }
        out = format_text("{}resize_valid{}:\n", out, pc);
        beginning = format_text("resize_valid{}", pc);
    }
    out = format_text("{}  %none{} = icmp eq i32 %n{}, 0\n", out, pc, pc);
    out = format_text("{}  br i1 %none{}, label %done{}, label %make{}\nmake{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}{}", out, Sized(format_text("width{}", pc), element));
    out = format_text("{}  %count{} = zext i32 %n{} to i64\n  %bytes{} = mul i64 %count{}, %width{}\n", out, pc, pc, pc,
                      pc, pc);
    out = format_text("{}{}", out, format_text("  %allocated{} = call {} @chibi_array.{}.allocate(ptr %ctx, i32 %n{}, i32 %n{})\n  %fresh{} = extractvalue {} %allocated{}, 2\n", pc, array, item.type, pc, pc, pc, array, pc));
    out = format_text("{}  %short{} = icmp ult i32 %n{}, %length{}\n", out, pc, pc, pc);
    out = format_text("{}  %kept{} = select i1 %short{}, i32 %n{}, i32 %length{}\n", out, pc, pc, pc, pc);
    out = format_text("{}  %keep{} = zext i32 %kept{} to i64\n  %held{} = mul i64 %keep{}, %width{}\n", out, pc, pc, pc,
                      pc, pc);
    out = format_text("{}  call void @chibi_scalar.copy(ptr %fresh{}, ptr %data{}, i64 %held{})\n", out, pc, pc, pc);
    out = format_text("{}{}", out, ArrayRefs(record_owners, item.type, format_text("%fresh{}", pc), format_text("%kept{}", pc), true));
    out = format_text("{}  %rest{} = getelementptr inbounds i8, ptr %fresh{}, i64 %held{}\n", out, pc, pc, pc);
    out = format_text("{}  %fill{} = sub i64 %bytes{}, %held{}\n", out, pc, pc, pc);
    out = format_text("{}  call void @chibi_scalar.zero(ptr %rest{}, i64 %fill{})\n", out, pc, pc);
    out = format_text("{}  br label %done{}\ndone{}:\n", out, pc, pc);
    out = format_text("{}  %v{} = phi {} [ zeroinitializer, %{} ], [ %allocated{}, %make{} ]\n", out, pc, array, beginning, pc, pc);
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}
// A new int array of the bytes of the left slot's string, none when it is
// empty: each byte widens to an int in turn.
ArrayBytesRead :: (item: Instruction, pc: int) -> string {
    array := abi.ArrayType();
    text := abi.TextType();
    out := Load(format_text("t{}", pc), abi.TextStorage, "s", item.left);
    out = format_text("{}  %data{} = extractvalue {} %t{}, 0\n  %n{} = extractvalue {} %t{}, 1\n", out, pc, text, pc, pc, text,
                      pc);
    out = format_text("{}  %none{} = icmp eq i32 %n{}, 0\n", out, pc, pc);
    out = format_text("{}  br i1 %none{}, label %done{}, label %make{}\nmake{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}{}", out, format_text("  %allocated{} = call {} @chibi_array.{}.allocate(ptr %ctx, i32 %n{}, i32 %n{})\n  %fresh{} = extractvalue {} %allocated{}, 2\n", pc, array, item.type, pc, pc, pc, array, pc));
    out = format_text("{}  br label %scan{}\nscan{}:\n", out, pc, pc);
    out = format_text("{}  %at{} = phi i32 [ 0, %make{} ], [ %next{}, %body{} ]\n", out, pc, pc, pc, pc);
    out = format_text("{}  %end{} = icmp eq i32 %at{}, %n{}\n", out, pc, pc, pc);
    out = format_text("{}  br i1 %end{}, label %done{}, label %body{}\nbody{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}  %offset{} = zext i32 %at{} to i64\n", out, pc, pc);
    out = format_text("{}  %from{} = getelementptr inbounds i8, ptr %data{}, i64 %offset{}\n", out, pc, pc, pc);
    out = format_text("{}  %byte{} = load i8, ptr %from{}\n  %wide{} = zext i8 %byte{} to i32\n", out, pc, pc, pc, pc);
    out = format_text("{}  %to{} = getelementptr inbounds i32, ptr %fresh{}, i64 %offset{}\n  store i32 %wide{}, ptr %to{}\n",
                      out, pc, pc, pc, pc, pc);
    out = format_text("{}  %next{} = add i32 %at{}, 1\n  br label %scan{}\ndone{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}  %v{} = phi {} [ zeroinitializer, %p{} ], [ %allocated{}, %scan{} ]\n", out, pc, array, pc, pc, pc);
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}
// A new string of the bytes of the left slot's array of bytes, empty when the
// array is: they are copied to an allocation of the context's that the string
// owns, with a count of 1, and none for an empty string.
ArrayTextRead :: (item: Instruction, pc: int, guarded: bool = false) -> string {
    array := abi.ArrayType();
    out := Load(format_text("a{}", pc), ArrayType + abi.ByteStorage, "s", item.left);
    out = format_text("{}  %n{} = extractvalue {} %a{}, 0\n  %data{} = extractvalue {} %a{}, 2\n", out, pc, array, pc, pc,
                      array, pc);
    out = format_text("{}{}", out, TextCopiedBytes(pc, guarded));
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}
// Whether an element of the array loaded as %a<pc> equals the value in the
// right slot, found by looking at each in turn.
ArrayFound :: (item: Instruction, pc: int) -> string {
    array := abi.ArrayType();
    element := int(item.literal);
    type := TypeName(element);
    out := "";
    aggregate := item.target > 0;
    if (aggregate) {
        out = format_text("  store {} zeroinitializer, ptr %equal{}\n", ValueEqualityStorage(), pc);
    } else { out = Load(format_text("w{}", pc), element, "s", item.right); }
    out = format_text("{}  %data{} = extractvalue {} %a{}, 2\n", out, pc, array, pc);
    out = format_text("{}  br label %scan{}\nscan{}:\n", out, pc, pc);
    out = format_text("{}  %at{} = phi i32 [ 0, %p{} ], [ %next{}, %step{} ]\n", out, pc, pc, pc, pc);
    out = format_text("{}  %end{} = icmp eq i32 %at{}, %length{}\n", out, pc, pc, pc);
    out = format_text("{}  br i1 %end{}, label %missing{}, label %look{}\nlook{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}  %offset{} = zext i32 %at{} to i64\n", out, pc, pc);
    out = format_text("{}  %place{} = getelementptr inbounds {}, ptr %data{}, i64 %offset{}\n", out, pc, type, pc, pc);
    if (!aggregate) { out = format_text("{}  %item{} = load {}, ptr %place{}\n", out, pc, type, pc); }
    if (aggregate) {
        out = format_text("{}  %same{} = call i1 @chibi_value_equal.{}(ptr %ctx, ptr %equal{}, ptr %place{}, ptr %s{})\n",
                          out, pc, item.target - 1, pc, pc, item.right);
    } else if (element == abi.TextStorage) {
        out = format_text("{}  %same{} = call i1 @chibi_scalar.text_equal({} %item{}, {} %w{})\n", out, pc, type, pc, type,
                          pc);
    } else if (abi.Floating(element)) {
        out = format_text("{}  %same{} = fcmp oeq {} %item{}, %w{}\n", out, pc, type, pc, pc);
    } else {
        out = format_text("{}  %same{} = icmp eq {} %item{}, %w{}\n", out, pc, type, pc, pc);
    }
    out = format_text("{}  br i1 %same{}, label %found{}, label %step{}\nstep{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}  %next{} = add i32 %at{}, 1\n  br label %scan{}\nmissing{}:\n  br label %done{}\nfound{}:\n", out, pc,
                      pc, pc, pc, pc, pc);
    out = format_text("{}  br label %done{}\ndone{}:\n", out, pc, pc);
    if (item.type == abi.IntStorage) {
        out = format_text("{}  %v{} = phi i32 [ -1, %missing{} ], [ %at{}, %found{} ]\n", out, pc, pc, pc, pc);
    } else { out = format_text("{}  %v{} = phi i1 [ false, %missing{} ], [ true, %found{} ]\n", out, pc, pc, pc); }
    if (aggregate) { out = format_text("{}  call void @chibi_value_equal.release(ptr %ctx, ptr %equal{})\n", out, pc); }
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}
// The array loaded as %a<pc> without its element at the index in the right
// slot, the elements after it moved down, if the index is inside it.
ArrayRemoved :: (item: Instruction, pc: int, record_owners: bool[]) -> string {
    array := abi.ArrayType();
    element := item.type - ArrayType;
    out := Load(format_text("b{}", pc), abi.IntStorage, "s", item.right);
    out = format_text("{}  %in{} = icmp ult i32 %b{}, %length{}\n", out, pc, pc, pc);
    out = format_text("{}  br i1 %in{}, label %cut{}, label %kept{}\ncut{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}  %unique{} = call {} @chibi_array.{}.unique(ptr %ctx, {} %a{}, i32 %length{}, i1 true)\n", out, pc, array, item.type, array, pc, pc);
    out = format_text("{}  %data{} = extractvalue {} %unique{}, 2\n", out, pc, array, pc);
    out = format_text("{}{}", out, Sized(format_text("width{}", pc), element));
    out = format_text("{}  %after{} = add i32 %b{}, 1\n  %tail{} = sub i32 %length{}, %after{}\n", out, pc, pc, pc, pc, pc);
    out = format_text("{}  %to{} = zext i32 %b{} to i64\n  %from{} = zext i32 %after{} to i64\n", out, pc, pc, pc, pc);
    out = format_text("{}  %hole{} = getelementptr inbounds {}, ptr %data{}, i64 %to{}\n", out, pc, TypeName(element), pc, pc);
    out = format_text("{}{}", out, ArrayRefs(record_owners, item.type, format_text("%hole{}", pc), "1", false));
    out = format_text("{}  %next{} = getelementptr inbounds {}, ptr %data{}, i64 %from{}\n", out, pc, TypeName(element), pc, pc);
    out = format_text("{}  %count{} = zext i32 %tail{} to i64\n  %bytes{} = mul i64 %count{}, %width{}\n", out, pc, pc, pc, pc, pc);
    out = format_text("{}  call void @chibi_scalar.copy(ptr %hole{}, ptr %next{}, i64 %bytes{})\n", out, pc, pc, pc);
    out = format_text("{}  %shorter{} = sub i32 %length{}, 1\n", out, pc, pc);
    out = format_text("{}  %trimmed{} = insertvalue {} %unique{}, i32 %shorter{}, 0\n  br label %kept{}\nkept{}:\n", out, pc, array, pc, pc, pc, pc);
    out = format_text("{}  %v{} = phi {} [ %a{}, %p{} ], [ %trimmed{}, %cut{} ]\n", out, pc, array, pc, pc, pc, pc);
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}
// An array of its own allocation holding the elements of the array loaded as
// %a<pc>, or the empty array for an empty one.
ArrayCopied :: (item: Instruction, pc: int) -> string {
    out := format_text("  %v{} = call {} @chibi_array.{}.clone(ptr %ctx, {} %a{}, i32 %length{})\n", pc, abi.ArrayType(), item.type, abi.ArrayType(), pc, pc);
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}

// A string's byte count, a byte or a slice. A byte is read only inside the
// string, and a slice clamps its count to the string's bytes, so neither
// reads nor points past them.
TextRead :: (item: Instruction, pc: int) -> string {
    text := abi.TextType();
    out := Load(format_text("a{}", pc), abi.TextStorage, "s", item.left);
    out = format_text("{}  %length{} = extractvalue {} %a{}, 1\n", out, pc, text, pc);
    if (item.op == TextLength) {
        return format_text("{}{}", out, Store(format_text("%length{}", pc), item.type, "s", item.output));
    }
    out = format_text("{}{}", out, Load(format_text("b{}", pc), abi.IntStorage, "s", item.right));
    if (item.op == TextByte) {
        // A negative index is outside too, read unsigned.
        out = format_text("{}  %inside{} = icmp ult i32 %b{}, %length{}\n  br i1 %inside{}, label %read{}, label %byte{}\n",
                          out, pc, pc, pc, pc, pc, pc);
        out = format_text("{}read{}:\n  %bytes{} = extractvalue {} %a{}, 0\n  %offset{} = zext i32 %b{} to i64\n", out, pc,
                          pc, text, pc, pc, pc);
        out = format_text("{}  %at{} = getelementptr inbounds i8, ptr %bytes{}, i64 %offset{}\n", out, pc, pc, pc);
        out = format_text("{}  %loaded{} = load i8, ptr %at{}\n  %wide{} = zext i8 %loaded{} to i32\n  br label %byte{}\n",
                          out, pc, pc, pc, pc, pc);
        out = format_text("{}byte{}:\n  %v{} = phi i32 [ %wide{}, %read{} ], [ -1, %p{} ]\n", out, pc, pc, pc, pc, pc);
        return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    }
    // The count, clamped to 0 through the byte count.
    out = format_text("{}  %negative{} = icmp slt i32 %b{}, 0\n  %low{} = select i1 %negative{}, i32 0, i32 %b{}\n", out,
                      pc, pc, pc, pc, pc);
    out = format_text("{}  %over{} = icmp ugt i32 %low{}, %length{}\n  %n{} = select i1 %over{}, i32 %length{}, i32 %low{}\n",
                      out, pc, pc, pc, pc, pc, pc, pc);
    if (item.op == TextTake) {
        out = format_text("{}  %v{} = insertvalue {} %a{}, i32 %n{}, 1\n", out, pc, text, pc, pc);
        return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    }
    out = format_text("{}  %bytes{} = extractvalue {} %a{}, 0\n  %offset{} = zext i32 %n{} to i64\n", out, pc, text, pc,
                      pc, pc);
    out = format_text("{}  %start{} = getelementptr inbounds i8, ptr %bytes{}, i64 %offset{}\n", out, pc, pc, pc);
    out = format_text("{}  %rest{} = sub i32 %length{}, %n{}\n", out, pc, pc, pc);
    out = format_text("{}  %moved{} = insertvalue {} %a{}, ptr %start{}, 0\n", out, pc, text, pc, pc);
    out = format_text("{}  %v{} = insertvalue {} %moved{}, i32 %rest{}, 1\n", out, pc, text, pc, pc);
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}

// How a module exports function 0: as `chibi_scalar`, as `main` for a
// zero-argument int entry, or not at all, as a library, which exports only
// its manifest.
ScalarEntry: int : 0;
MainEntry: int : 1;
NoEntry: int : 2;
// A scalar entry that is a coroutine: its ramp is internal and chibi_scalar is a
// function that runs it and the tasks until it finishes.
CoroutineEntry: int : 3;
ProgramEntry: int : 4;
ProgramCoroutineEntry: int : 5;
ProgramMode :: (mode: int) -> bool {
    return mode == ProgramEntry || mode == ProgramCoroutineEntry;
}
RuntimeScopeNone: int : 0;
RuntimeScopeBudget: int : 1;
RuntimeScopeTest: int : 2;
// Unarmed programs retain their fast loops. Test scopes additionally refuse
// task effects; ordinary quota scopes still allow them. One foreign-call scan
// determines both needs from the validated source closure.
ProgramScope :: (code: Instruction[], texts: string[]) -> int {
    found := RuntimeScopeNone;
    for (item in code) {
        if (item.op != ForeignCall || abi.ForeignIsIndirect(item.left)) { continue; }
        name := texts[int(item.literal)];
        if (name == "chibi_native_test_begin") { return RuntimeScopeTest; }
        if (name == "chibi_native_scope_begin") { found = RuntimeScopeBudget; }
    }
    return found;
}
// The entry's symbol, or an internal function's.
Symbol :: (function: int, mode: int) -> string {
    if (function == 0 && mode == MainEntry) {
        return "main";
    }
    if (function == 0 && (mode == ScalarEntry || mode == ProgramEntry)) {
        return "chibi_scalar";
    }
    if (function == 0 && (mode == CoroutineEntry || mode == ProgramCoroutineEntry)) {
        return "chibi_scalar.ramp";
    }
    return format_text("chibi_scalar.{}", function);
}
// Arguments load in call order, so evaluation order stays visible at O0. A
// module that calls the runtime passes its context first. After a call of a
// function that can fail, the caller fails when the context names a failure.
CallInstruction :: (functions: Function[], parameters: int[], arguments: int[], item: Instruction, pc: int,
                    mode: int, runtime: bool, checked: bool) -> string {
    callee := functions[item.left];
    out := format_text("p{}:\n", pc);
    listed: string[] = [];
    if (runtime) {
        listed.append("ptr %ctx");
    }
    for (index in 0..<item.target) {
        type := parameters[callee.first_parameter + index];
        out = format_text("{}{}", out, Load(format_text("c{}_{}", pc, index), type, "s", arguments[item.right + index]));
        listed.append(format_text("{} %c{}_{}", TypeName(type), pc, index));
    }
    list := strings.Join(listed, ", ");
    out = format_text("{}  %v{} = call {} @{}({})\n", out, pc, TypeName(item.type), Symbol(item.left, mode), list);
    out = format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    if (!checked) {
        return format_text("{}  br label %p{}\n", out, pc + 1);
    }
    out = format_text("{}  %failure{}.at = getelementptr inbounds {}, ptr %ctx, i32 0, i32 1\n", out, pc,
                      abi.ContextType());
    out = format_text("{}  %failure{} = load ptr, ptr %failure{}.at\n", out, pc, pc);
    out = format_text("{}  %failed{} = icmp ne ptr %failure{}, null\n", out, pc, pc);
    return format_text("{}  br i1 %failed{}, label %failed, label %p{}\n", out, pc, pc + 1);
}
// The extension the C ABI asks of the caller for a bool or an integer under
// 32 bits, as an attribute with its leading space, and none for other types.
CExtension :: (type: int) -> string {
    if (type == abi.BoolStorage) {
        return " zeroext";
    }
    if (Integer(type) && abi.IntegerBits(type) < 32) {
        if (abi.Unsigned(type)) {
            return " zeroext";
        }
        return " signext";
    }
    return "";
}
// Whether an argument of a foreign call is a number, a bool or a string, whose
// data pointer the callee reads.
ForeignArgument :: (type: int) -> bool {
    return abi.ScalarType(type) != "" || type == abi.TextStorage ||
           (type >= ArrayType && type < MapType && type != ArrayType + PointerType);
}
// The type of an argument in a foreign declaration or call: a string is the
// pointer to its bytes.
ForeignType :: (type: int) -> string {
    if (type == abi.TextStorage || (type >= ArrayType && type < MapType)) {
        return "ptr";
    }
    return format_text("{}{}", TypeName(type), CExtension(type));
}
// One validation pass also identifies whether all arguments travel by value.
// A synchronous scalar C call needs no buffer lease in a coroutine frame.
InvalidForeignABI: int : 0;
ScalarForeignABI: int : 1;
BorrowedForeignABI: int : 2;
ForeignABI :: (slots: int[], arguments: int[], texts: string[], item: Instruction) -> int {
    if (item.literal < 0 || item.literal >= i64(length(texts)) || abi.ScalarType(item.type) == "") {
        return InvalidForeignABI;
    }
    symbol := texts[int(item.literal)];
    indirect := abi.ForeignIsIndirect(item.left);
    if (!abi.ForeignCallMode(item.left) || (abi.ForeignIsVoid(item.left) && item.type != abi.IntStorage)) {
        return InvalidForeignABI;
    }
    if (indirect && symbol != "") {
        return InvalidForeignABI;
    }
    if (!indirect && (!Identifier(symbol) || symbol == "main" || symbol == "chibi_scalar")) {
        return InvalidForeignABI;
    }
    if (item.right < 0 || item.target < 0 || item.target > length(arguments) - item.right) {
        return InvalidForeignABI;
    }
    if (indirect && (item.target < 1 || !Typed(slots, arguments[item.right], abi.WordStorage))) {
        return InvalidForeignABI;
    }
    // These program-owned helpers have a fixed ABI, regardless of the caller's
    // frame. A source declaration cannot change their result or add arguments.
    if (!indirect && (symbol == "chibi_native_test_index" || symbol == "chibi_native_test_begin" ||
                      symbol == "chibi_native_test_end" || symbol == "chibi_native_scope_end") &&
        (abi.ForeignIsVoid(item.left) || item.type != abi.IntStorage || item.target != 0)) {
        return InvalidForeignABI;
    }
    if (!indirect && (symbol == "chibi_native_scope_begin" || symbol == "chibi_native_test_expect")) {
        parameter := abi.IntStorage;
        if (symbol == "chibi_native_scope_begin") { parameter = abi.WordStorage; }
        if (abi.ForeignIsVoid(item.left) || item.type != abi.IntStorage || item.target != 1 ||
            !Typed(slots, arguments[item.right], parameter)) { return InvalidForeignABI; }
    }
    if (!indirect && (symbol == "chibi_native_test_busy" || symbol == "chibi_native_step")) {
        count := 0;
        if (symbol == "chibi_native_test_busy") { count = 1; }
        if (!abi.ForeignIsVoid(item.left) || item.target != count ||
            (count == 1 && !Typed(slots, arguments[item.right], abi.IntStorage))) { return InvalidForeignABI; }
    }
    capability := ScalarForeignABI;
    for (index in 0..<item.target) {
        slot := arguments[item.right + index];
        if (!Index(slot, length(slots)) || !ForeignArgument(slots[slot])) {
            return InvalidForeignABI;
        }
        if (abi.ScalarType(slots[slot]) == "") { capability = BorrowedForeignABI; }
    }
    return capability;
}
// The declaration of each foreign symbol functions [first, last) call, once.
ForeignDeclarations :: (functions: Function[], first: int, last: int, slots: int[], code: Instruction[],
                        arguments: int[], texts: string[]) -> string {
    out: string[] = [];
    for (function in first..<last) {
        shape := functions[function];
        for (pc in 0..<shape.code) {
            item := code[shape.first_code + pc];
            if (item.op != ForeignCall || abi.ForeignIsIndirect(item.left)) {
                continue;
            }
            listed: string[] = [];
            for (index in 0..<item.target) {
                listed.append(ForeignType(slots[shape.first_slot + arguments[shape.first_argument + item.right + index]]));
            }
            result := TypeName(item.type);
            extension := CExtension(item.type);
            if (abi.ForeignIsVoid(item.left)) { result = "void"; extension = ""; }
            declaration := format_text("declare{} {} @{}({})\n", extension, result,
                                       texts[int(item.literal)], strings.Join(listed, ", "));
            if (!out.contains(declaration)) {
                out.append(declaration);
                if (ClockFactorySymbol(texts[int(item.literal)])) { out.append("; chibi-clock-host\n"); }
            }
        }
    }
    return strings.Join(out, "");
}
// The most bytes of a string a foreign call passes as a cstring, without its
// NUL: the stack buffer holds a copy of the string and its end.
CstringCapacity: int : 4096;
// How many of a foreign call's arguments are strings.
ForeignTexts :: (slots: int[], arguments: int[], item: Instruction) -> int {
    count: int = 0;
    for (index in 0..<item.target) {
        if (slots[arguments[item.right + index]] == abi.TextStorage) {
            count += 1;
        }
    }
    return count;
}
// Whether any of functions [first, last) passes a string to a foreign call.
Cstrings :: (functions: Function[], first: int, last: int, slots: int[], code: Instruction[],
             arguments: int[]) -> bool {
    for (function in first..<last) {
        shape := functions[function];
        own_slots := Part(slots, shape.first_slot, shape.slots);
        own := Part(arguments, shape.first_argument, shape.arguments);
        for (pc in 0..<shape.code) {
            item := code[shape.first_code + pc];
            if (item.op == ForeignCall && ForeignTexts(own_slots, own, item) > 0) {
                return true;
            }
        }
    }
    return false;
}
// Copies a string's bytes to `to` and ends them with a NUL, or returns false at
// a NUL the string holds, which C would read as its end. A loop of its own, in
// a function that disables the library calls, like the array copy.
CstringHelper :: () -> string {
    out := "define internal i1 @chibi_scalar.cstring(ptr %to, ptr %from, i32 %length) #1 {\nentry:\n  br label %head\n";
    out = format_text("{}head:\n  %at = phi i32 [ 0, %entry ], [ %next, %store ]\n  %done = icmp eq i32 %at, %length\n", out);
    out = format_text("{}  br i1 %done, label %exit, label %body\nbody:\n  %wide = zext i32 %at to i64\n", out);
    out = format_text("{}  %source = getelementptr inbounds i8, ptr %from, i64 %wide\n  %byte = load i8, ptr %source\n", out);
    out = format_text("{}  %zero = icmp eq i8 %byte, 0\n  br i1 %zero, label %bad, label %store\nstore:\n", out);
    out = format_text("{}  %target = getelementptr inbounds i8, ptr %to, i64 %wide\n  store i8 %byte, ptr %target\n", out);
    out = format_text("{}  %next = add i32 %at, 1\n  br label %head\nexit:\n  %last = zext i32 %length to i64\n", out);
    out = format_text("{}  %end = getelementptr inbounds i8, ptr %to, i64 %last\n  store i8 0, ptr %end\n  ret i1 true\nbad:\n  ret i1 false\n}\n", out);
    return out;
}
// A call of a foreign symbol, or through an address: the arguments load in
// order, and nothing else is passed. A string is copied with its NUL to one of
// the function's stack buffers, so the callee reads a C string; a string too
// long for the buffer, or holding a NUL, traps.
ForeignInstruction :: (slots: int[], arguments: int[], texts: string[], code: Instruction[], origins: int[], item: Instruction, pc: int) -> string {
    out := format_text("p{}:\n{}", pc, ForeignArrays(slots, arguments, code, origins, item, pc));
    listed: string[] = [];
    callee := format_text("@{}", texts[int(item.literal)]);
    buffer: int = 0;
    for (index in 0..<item.target) {
        slot := arguments[item.right + index];
        type := slots[slot];
        name := format_text("c{}_{}", pc, index);
        out = format_text("{}{}", out, Load(name, type, "s", slot));
        if (abi.ForeignIsIndirect(item.left) && index == 0) {
            callee = format_text("%callee{}", pc);
            out = format_text("{}  {} = inttoptr i64 %{} to ptr\n", out, callee, name);
            // A missing symbol is a null address, which traps instead of jumping to 0.
            out = format_text("{}  %null{} = icmp eq ptr {}, null\n  br i1 %null{}, label %trap, label %call{}\ncall{}:\n", out, pc,
                              callee, pc, pc, pc);
            continue;
        }
        if (type >= ArrayType && type < MapType) {
            out = format_text("{}  %{}.data = extractvalue {} %{}, 2\n", out, name, TypeName(type), name);
            listed.append(format_text("ptr %{}.data", name));
            continue;
        }
        if (type == abi.TextStorage) {
            out = format_text("{}  %{}.data = extractvalue {} %{}, 0\n", out, name, TypeName(type), name);
            out = format_text("{}  %{}.length = extractvalue {} %{}, 1\n", out, name, TypeName(type), name);
            out = format_text("{}  %{}.fits = icmp ult i32 %{}.length, {}\n", out, name, name, CstringCapacity);
            out = format_text("{}  br i1 %{}.fits, label %{}.copy, label %trap\n{}.copy:\n", out, name, name, name);
            out = format_text("{}  %{}.ok = call i1 @chibi_scalar.cstring(ptr %cstr{}, ptr %{}.data, i32 %{}.length)\n", out, name,
                              buffer, name, name);
            out = format_text("{}  br i1 %{}.ok, label %{}.ready, label %trap\n{}.ready:\n", out, name, name, name);
            listed.append(format_text("ptr %cstr{}", buffer));
            buffer += 1;
            continue;
        }
        listed.append(format_text("{}{} %{}", TypeName(type), CExtension(type), name));
    }
    if (abi.ForeignIsVoid(item.left)) {
        out = format_text("{}  call void {}({})\n{}", out, callee, strings.Join(listed, ", "),
                          Store("0", abi.IntStorage, "s", item.output));
    } else {
        out = format_text("{}  %v{} = call{} {} {}({})\n", out, pc, CExtension(item.type), TypeName(item.type), callee,
                          strings.Join(listed, ", "));
        out = format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    }
    return format_text("{}  br label %p{}\n", out, pc + 1);
}
// Fail names its failure in the context, then the function fails.
FailInstruction :: (function: int, pc: int) -> string {
    out := format_text("p{}:\n  %fail{}.at = getelementptr inbounds {}, ptr %ctx, i32 0, i32 1\n", pc, pc,
                       abi.ContextType());
    return format_text("{}  store ptr @{}, ptr %fail{}.at\n  br label %failed\n", out, FailureSymbol(function, pc), pc);
}
// The constant that names the failure of instruction `pc` of `function`.
FailureSymbol :: (function: int, pc: int) -> string {
    return format_text("chibi_scalar.failure.{}.{}", function, pc);
}
// The coroutine intrinsics require LLVM 22 or later.
CoroutineDeclarations :: () -> string {
    return strings.Join(["declare token @llvm.coro.id(i32, ptr, ptr, ptr)\n",
                         "declare i1 @llvm.coro.alloc(token)\n",
                         "declare i64 @llvm.coro.size.i64()\n",
                         "declare ptr @llvm.coro.begin(token, ptr)\n",
                         "declare i8 @llvm.coro.suspend(token, i1)\n",
                         "declare ptr @llvm.coro.free(token, ptr)\n",
                         "declare void @llvm.coro.end(ptr, i1, token)\n",
                         "declare void @llvm.coro.resume(ptr)\n",
                         "declare void @llvm.coro.destroy(ptr)\n",
                         "declare i1 @llvm.coro.done(ptr)\n",
                         "declare ptr @llvm.coro.promise(ptr, i32, i1)\n"], "");
}
// chibi_scalar when the entry waits: it starts the entry as a task and updates the
// tasks until the entry has finished, then gives its result.
CoroutineEntryFunction :: (result: int, waiting: bool, timed: bool) -> string {
    type := TypeName(result);
    out := format_text("define {} @chibi_scalar(ptr %ctx) #0 {{\nentry:\n", type);
    if (!waiting) {
        return format_text("{}  %result = call {} @chibi_scalar.ramp(ptr %ctx)\n  %cancelled = call i32 @chibi_host_tasks_cancel_all()\n  ret {} %result\n}}\n", out, type, type);
    }
    out = format_text("{}  %handle = call i64 @chibi_tasks.begin(ptr %ctx, i32 {})\n  %frame = call ptr @chibi_scalar.ramp(ptr %ctx)\n  call void @chibi_tasks.attach(i64 %handle, ptr %frame)\n  store i64 0, ptr @chibi_tasks.current\n", out, result);
    out = format_text("{}  br label %loop\nloop:\n  %done = call i1 @llvm.coro.done(ptr %frame)\n", out);
    idle := "";
    if (timed) { idle = "  call void @chibi_tasks.idle()\n"; }
    out = format_text("{}  br i1 %done, label %finished, label %tick\ntick:\n{}  call void @chibi_tasks.update()\n  br label %loop\n", out, idle);
    out = format_text("{}finished:\n  %promise = call ptr @llvm.coro.promise(ptr %frame, i32 8, i1 false)\n", out);
    return format_text("{}  %result = load {}, ptr %promise\n  %cancelled = call i32 @chibi_host_tasks_cancel_all()\n  ret {} %result\n}}\n", out, type, type);
}
// A coroutine's start, in the entry block: the promise is the result's slot, the
// frame comes from the context's allocate and goes back to its release.
CoroutinePrologue :: (roots: string, guarded: bool = false) -> string {
    out := "  %coro.id = call token @llvm.coro.id(i32 8, ptr %result0, ptr null, ptr null)\n";
    out = format_text("{}  %coro.need = call i1 @llvm.coro.alloc(token %coro.id)\n", out);
    out = format_text("{}  br i1 %coro.need, label %coro.alloc, label %coro.begin\ncoro.alloc:\n", out);
    out = format_text("{}  %coro.size = call i64 @llvm.coro.size.i64()\n", out);
    out = format_text("{}{}", out, Allocated("coro.mem", "%coro.size", guarded));
    out = format_text("{}  br label %coro.begin\ncoro.begin:\n", out);
    out = format_text("{}  %coro.frame = phi ptr [ null, %entry ], [ %coro.mem, %coro.alloc ]\n", out);
    out = format_text("{}  %coro.hdl = call ptr @llvm.coro.begin(token %coro.id, ptr %coro.frame)\n", out);
    return format_text("{}{}  br label %p0\n", out, roots);
}
// A coroutine's end: the final suspension keeps the frame, and so the promise,
// for whoever reads the result; destroying it comes here to release the frame.
CoroutineEpilogue :: (final_cleanup: string, cancel_cleanup: string, guarded: bool = false) -> string {
    out := format_text("coro.final:\n{}", final_cleanup);
    out = format_text("{}  %coro.last = call i8 @llvm.coro.suspend(token none, i1 true)\n", out);
    out = format_text("{}  switch i8 %coro.last, label %coro.suspend [ i8 0, label %trap\n                                     i8 1, label %coro.cleanup ]\n", out);
    out = format_text("{}coro.cleanup:\n{}  %coro.free = call ptr @llvm.coro.free(token %coro.id, ptr %coro.hdl)\n", out, cancel_cleanup);
    out = format_text("{}  %coro.owned = icmp ne ptr %coro.free, null\n", out);
    out = format_text("{}  br i1 %coro.owned, label %coro.release, label %coro.suspend\ncoro.release:\n", out);
    out = format_text("{}{}", out, ContextCall("coro.release.call", 4, guarded));
    out = format_text("{}  call void %coro.release.call(ptr %ctx, ptr %coro.free)\n", out);
    out = format_text("{}  br label %coro.suspend\ncoro.suspend:\n", out);
    return format_text("{}  call void @llvm.coro.end(ptr %coro.hdl, i1 false, token none)\n  ret ptr %coro.hdl\n", out);
}
// `yield`: give up the turn, to resume at the next instruction on the next update.
SuspendInstruction :: (pc: int, testing: bool) -> string {
    out := format_text("p{}:\n{}  %suspend{} = call i8 @llvm.coro.suspend(token none, i1 false)\n", pc, TaskTestGuard(testing, TaskWaitEffect), pc);
    return format_text("{}  switch i8 %suspend{}, label %coro.suspend [ i8 0, label %p{}\n                                      i8 1, label %coro.cleanup ]\n",
                       out, pc, pc + 1);
}
// The ramp call of a waiting callee: its frame, as `v{pc}`.
RampCall :: (functions: Function[], parameters: int[], arguments: int[], item: Instruction, pc: int, mode: int,
             spawned: bool, testing: bool) -> string {
    callee := functions[item.left];
    out := format_text("p{}:\n", pc);
    if (spawned) {
        out = format_text("{}{}", out, TaskTestGuard(testing, TaskSpawnEffect));
        kind := callee.result;
        if (item.literal == i64(CallSpawnedVoid)) { kind = 0; }
        out = format_text("{}  %parent{} = load i64, ptr @chibi_tasks.current\n  %task{} = call i64 @chibi_tasks.begin(ptr %ctx, i32 {})\n", out, pc, pc, kind);
    }
    listed: string[] = ["ptr %ctx"];
    for (index in 0..<item.target) {
        type := parameters[callee.first_parameter + index];
        out = format_text("{}{}", out, Load(format_text("c{}_{}", pc, index), type, "s", arguments[item.right + index]));
        listed.append(format_text("{} %c{}_{}", TypeName(type), pc, index));
    }
    return format_text("{}  %v{} = call ptr @{}({})\n", out, pc, Symbol(item.left, mode), strings.Join(listed, ", "));
}
// `await F(arguments)` in a coroutine: F runs to its first suspension, and the
// caller waits for it, resuming it each time it is resumed itself. Destroying
// the caller destroys F's frame first.
AwaitedCallInstruction :: (functions: Function[], parameters: int[], arguments: int[], item: Instruction, pc: int,
                           mode: int, testing: bool, owners: bool[]) -> string {
    out := RampCall(functions, parameters, arguments, item, pc, mode, false, testing);
    out = format_text("{}  br label %p{}.test\np{}.test:\n", out, pc, pc);
    out = format_text("{}  %done{} = call i1 @llvm.coro.done(ptr %v{})\n", out, pc, pc);
    out = format_text("{}  br i1 %done{}, label %p{}.finished, label %p{}.wait\np{}.wait:\n", out, pc, pc, pc, pc);
    out = format_text("{}{}", out, TaskTestGuard(testing, TaskWaitEffect));
    out = format_text("{}  %suspend{} = call i8 @llvm.coro.suspend(token none, i1 false)\n", out, pc);
    out = format_text("{}  switch i8 %suspend{}, label %coro.suspend [ i8 0, label %p{}.resume\n                                      i8 1, label %p{}.destroy ]\n",
                      out, pc, pc, pc);
    out = format_text("{}p{}.resume:\n  call void @llvm.coro.resume(ptr %v{})\n  br label %p{}.test\n", out, pc, pc, pc);
    out = format_text("{}p{}.destroy:\n  call void @llvm.coro.destroy(ptr %v{})\n  br label %coro.cleanup\n", out, pc, pc);
    out = format_text("{}p{}.finished:\n  %promise{} = call ptr @llvm.coro.promise(ptr %v{}, i32 8, i1 false)\n", out, pc, pc, pc);
    out = format_text("{}  %result{} = load {}, ptr %promise{}\n", out, pc, TypeName(item.type), pc);
    if (ValueOwned(item.type, owners) || item.type == PointerType) {
        out = format_text("{}  store {} zeroinitializer, ptr %promise{}\n", out, TypeName(item.type), pc);
    }
    out = format_text("{}  call void @llvm.coro.destroy(ptr %v{})\n", out, pc);
    out = format_text("{}{}", out, Store(format_text("%result{}", pc), item.type, "s", item.output));
    return format_text("{}  br label %p{}\n", out, pc + 1);
}
// `F(arguments)` of a waiting F, not awaited: F runs to its first suspension and
// is added to the scheduler; the task's handle is the result.
SpawnedCallInstruction :: (functions: Function[], parameters: int[], arguments: int[], item: Instruction, pc: int,
                           mode: int, testing: bool) -> string {
    out := RampCall(functions, parameters, arguments, item, pc, mode, true, testing);
    out = format_text("{}  call void @chibi_tasks.attach(i64 %task{}, ptr %v{})\n  store i64 %parent{}, ptr @chibi_tasks.current\n", out, pc, pc, pc);
    out = format_text("{}{}", out, Store(format_text("%task{}", pc), item.type, "s", item.output));
    return format_text("{}  br label %p{}\n", out, pc + 1);
}
// `await handle` as a statement: when the task has not finished, the coroutine
// records that it waits for it and suspends; the scheduler resumes it once the
// task has finished or been cancelled.
AwaitHandleInstruction :: (item: Instruction, pc: int, testing: bool) -> string {
    out := format_text("p{}:\n{}", pc, TaskTestGuard(testing, TaskWaitEffect));
    out = format_text("{}{}", out, Load(format_text("h{}", pc), TaskType, "s", item.left));
    out = format_text("{}  %finished{} = call i1 @chibi_tasks.finished(i64 %h{})\n", out, pc, pc);
    out = format_text("{}  br i1 %finished{}, label %p{}, label %p{}.wait\np{}.wait:\n", out, pc, pc + 1, pc, pc);
    out = format_text("{}  call void @chibi_tasks.wait(i64 %h{})\n", out, pc);
    out = format_text("{}  %suspend{} = call i8 @llvm.coro.suspend(token none, i1 false)\n", out, pc);
    return format_text("{}  switch i8 %suspend{}, label %coro.suspend [ i8 0, label %p{}\n                                      i8 1, label %coro.cleanup ]\n",
                       out, pc, pc + 1);
}
EmitFunction :: (functions: Function[], function: int, parameters: int[], slots: int[], locals: int[],
                 code: Instruction[], arguments: int[], records: Record[], fields: int[], texts: string[],
                 mode: int, step_budget: int, runtime: bool, fallible: bool[], shared: bool, waiting: bool[], scoped: bool, testing: bool, record_owners: bool[], managed: bool, managed_records: ManagedRecordLayout, guarded: bool = false) -> string {
    shape := functions[function];
    coroutine := waiting[function];
    result := shape.result;
    // A function another piece of the module calls is a hidden symbol the
    // link joins; the others stay internal to their piece.
    linkage := "";
    if (function != 0 || mode == NoEntry || mode == CoroutineEntry || mode == ProgramCoroutineEntry) {
        linkage = "internal ";
        if (shared) {
            linkage = "hidden ";
        }
    }
    listed: string[] = [];
    if (runtime) {
        listed.append("ptr %ctx");
    }
    for (index in 0..<shape.parameters) {
        listed.append(format_text("{} %arg{}", TypeName(parameters[shape.first_parameter + index]), index));
    }
    // A coroutine's ramp returns its frame, a pointer.
    returns := TypeName(result);
    attributes := "";
    if (coroutine) {
        returns = "ptr";
        attributes = " presplitcoroutine";
    }
    gc_owners: ManagedOwnerLayout = {slots: [], locals: [], count: 0, ranges: []};
    if (managed) { gc_owners = ManagedOwnerLocations(shape, code, length(records)); }
    out: string[] = [ManagedOwnerTrace(gc_owners, function), format_text("define {}{} @{}({}) #0{} {\nentry:\n", linkage, returns,
                                 Symbol(function, mode), strings.Join(listed, ", "), attributes)];
    out.append(format_text("  %budget0 = alloca i32\n  store i32 {}, ptr %budget0\n", step_budget));
    for (index in 0..<shape.slots) {
        out.append(format_text("  %s{} = alloca {}\n", index, TypeName(slots[shape.first_slot + index])));
        if (slots[shape.first_slot + index] == TaskType) { out.append(Store("0", TaskType, "s", index)); }
    }
    for (index in 0..<shape.locals) {
        type := locals[shape.first_local + index];
        out.append(format_text("  %l{} = alloca {}\n", index, TypeName(type)));
        out.append(Store(Zero(type), type, "l", index));
    }
    out.append(format_text("  %result0 = alloca {}\n", TypeName(result)));
    out.append(Store(Zero(result), result, "result", 0));
    owner_locations: TaskOwnerLocation[] = [];
    if (coroutine) {
        owner_locations = TaskOwnerLocations(shape, code);
        out.append(TaskOwnerPrologue(owner_locations));
    }
    frame_roots: ManagedFrameRoots = {prologue: "", attach: "", cleanup: "", destroy: ""};
    if (managed && coroutine) {
        frame_roots = ManagedFrame(shape, slots, locals, managed_records);
        out.append(frame_roots.prologue);
    }
    if (managed) {
        if (!coroutine) { out.append(ManagedRoots(shape, slots, locals, managed_records.traced)); }
        for (pc in 0..<shape.code) {
            item := code[shape.first_code + pc];
            if (item.op == ManagedPin) {
                if (coroutine) {
                    out.append(format_text("  %managed.pin{} = alloca %chibi.managed.persistent\n  store %chibi.managed.persistent zeroinitializer, ptr %managed.pin{}\n", item.right, item.right));
                } else { out.append(format_text("  %managed.pin{} = alloca %chibi.managed.root\n", item.right)); }
            }
        }
    }
    owner_roots := ManagedOwnerRoots(gc_owners, coroutine, function);
    out.append(owner_roots.prologue);
    frame_roots.attach = strings.Concatenate([frame_roots.attach, owner_roots.attach]);
    frame_roots.cleanup = strings.Concatenate([frame_roots.cleanup, owner_roots.cleanup]);
    // A format's values and result live in the entry block, so a loop
    // reuses them.
    for (pc in 0..<shape.code) {
        item := code[shape.first_code + pc];
        if (item.op == Format) {
            out.append(format_text("  %values{} = alloca [{} x {}]\n  %text{} = alloca {}\n", pc, item.target,
                                   abi.ValueType(), pc, abi.TextType()));
        }
        if (item.op == ArrayContains && item.target > 0) {
            out.append(format_text("  %equal{} = alloca {}\n", pc, ValueEqualityStorage()));
        }
        if (item.op == StateStore && item.type >= RecordType && item.type < ArrayType && record_owners[item.type - RecordType]) {
            out.append(format_text("  %state.owned{} = alloca {}\n", pc, TypeName(item.type)));
        }
    }
    // A foreign call's string arguments are copied into buffers of the entry
    // block, shared by the function's calls.
    own_slots := Part(slots, shape.first_slot, shape.slots);
    own := Part(arguments, shape.first_argument, shape.arguments);
    buffers: int = 0;
    loan_origins: int[] = [];
    for (pc in 0..<shape.code) {
        item := code[shape.first_code + pc];
        if (item.op == ArrayLoan) {
            if (length(loan_origins) == 0) {
                loan_origins = resize([int(0)], shape.slots);
                for (index in 0..<shape.slots) { loan_origins[index] = -1; }
            }
            loan_origins[item.output] = shape.first_code + pc;
        }
        if (item.op == ForeignCall) {
            texted := ForeignTexts(own_slots, own, item);
            if (texted > buffers) {
                buffers = texted;
            }
        }
    }
    for (index in 0..<buffers) {
        out.append(format_text("  %cstr{} = alloca [{} x i8]\n", index, CstringCapacity + 1));
    }
    if (coroutine) {
        out.append(CoroutinePrologue(frame_roots.attach, guarded));
    } else {
        out.append("  br label %p0\n");
    }
    for (pc in 0..<shape.code) {
        item := code[shape.first_code + pc];
        if (item.op == ManagedPending || item.op == ManagedPoll || item.op == ManagedTrack) {
            out.append(ManagedPollInstruction(item, pc, gc_owners));
        } else if ((item.op >= ManagedNew && item.op <= ManagedUnpin) || item.op == ManagedProject) {
            out.append(ManagedInstruction(item, pc, records, coroutine));
        } else if (ViewOperation(item.op)) {
            out.append(ViewInstruction(item, pc, own, record_owners));
        } else if (managed && (item.op == Return || item.op == End) && !coroutine) {
            returned := EmitInstruction(item, pc, result, records, fields, texts, coroutine, ProgramMode(mode), scoped, record_owners, guarded);
            out.append(strings.ReplaceAll(returned, "  ret ", strings.Concatenate([ManagedUnroots(function == 0 && mode == ProgramEntry), "  ret "])));
        } else if (item.op == Call && item.literal == i64(CallAwaited)) {
            out.append(AwaitedCallInstruction(functions, parameters, own, item, pc, mode, testing, record_owners));
        } else if (item.op == Call && (item.literal == i64(CallSpawned) || item.literal == i64(CallSpawnedVoid))) {
            out.append(SpawnedCallInstruction(functions, parameters, own, item, pc, mode, testing));
        } else if (item.op == Suspend) {
            out.append(SuspendInstruction(pc, testing));
        } else if (item.op == AwaitResult) {
            out.append(TaskResultInstruction(item, pc, testing, record_owners));
        } else if (item.op == TaskCopy || item.op == TaskDrop || item.op == TaskRunning) {
            out.append(format_text("p{}:\n", pc));
            if (item.op == TaskRunning) { out.append(TaskTestGuard(testing, TaskWaitEffect)); }
            out.append(Load(format_text("h{}", pc), TaskType, "s", item.left));
            if (item.op == TaskCopy) {
                out.append(format_text("  call void @chibi_tasks.retain(i64 %h{})\n", pc));
                out.append(Store(format_text("%h{}", pc), TaskType, "s", item.output));
            } else if (item.op == TaskDrop) {
                out.append(Store("0", TaskType, "s", item.left));
                out.append(format_text("  call void @chibi_tasks.release(i64 %h{})\n", pc));
            } else {
                out.append(format_text("  %done{} = call i1 @chibi_tasks.finished(i64 %h{})\n  %running{} = xor i1 %done{}, true\n", pc, pc, pc, pc));
                out.append(Store(format_text("%running{}", pc), abi.BoolStorage, "s", item.output));
            }
            out.append(format_text("  br label %p{}\n", pc + 1));
        } else if (item.op == AwaitHandle) {
            out.append(AwaitHandleInstruction(item, pc, testing));
        } else if (item.op == Cancel) {
            out.append(format_text("p{}:\n", pc));
            out.append(TaskTestGuard(testing, TaskWaitEffect));
            out.append(Load(format_text("h{}", pc), TaskType, "s", item.left));
            out.append(format_text("  call void @chibi_tasks.cancel(i64 %h{})\n  br label %p{}\n", pc, pc + 1));
        } else if (item.op == CancelAfter) {
            out.append(format_text("p{}:\n", pc));
            out.append(TaskTestGuard(testing, TaskWaitEffect));
            out.append(Load(format_text("h{}", pc), TaskType, "s", item.left));
            out.append(Load(format_text("duration{}", pc), abi.DoubleStorage, "s", item.right));
            out.append(format_text("  call void @chibi_tasks.cancel_after(i64 %h{}, double %duration{})\n  br label %p{}\n", pc, pc, pc + 1));
        } else if (item.op == Delay) {
            out.append(DelayInstruction(item, pc, testing));
        } else if (item.op == Call) {
            out.append(CallInstruction(functions, parameters, own, item, pc, mode, runtime,
                                       fallible[item.left]));
        } else if (item.op == ClockSample) {
            out.append(ClockInstruction(item, pc));
        } else if (item.op == ArrayLoan) {
            out.append(LoanInstruction(own_slots, item, pc));
        } else if (item.op == ForeignCall) {
            out.append(ForeignInstruction(own_slots, own, texts, code, loan_origins, item, pc));
        } else if (item.op == FunctionAddress) {
            out.append(format_text("p{}:\n  %v{} = ptrtoint ptr @{} to i64\n", pc, pc, CallbackSymbol(item.left, int(item.literal))));
            out.append(Store(format_text("%v{}", pc), item.type, "s", item.output));
            out.append(format_text("  br label %p{}\n", pc + 1));
        } else if (item.op == OwnerPin || item.op == OwnerUnpin) {
            out.append(TaskOwnerInstruction(item, pc, locals, shape.first_local));
        } else if (item.op == Fail) {
            out.append(FailInstruction(function, pc));
        } else if (item.op == Format) {
            out.append(FormatInstruction(own_slots, own, item, pc));
        } else {
            out.append(EmitInstruction(item, pc, result, records, fields, texts, coroutine, ProgramMode(mode), scoped, record_owners, guarded));
        }
    }
    // A function fails with its result's zero, which no caller reads; a coroutine
    // that fails finishes.
    if (fallible[function] && coroutine) {
        out.append("failed:\n  br label %coro.final\n");
    } else if (fallible[function]) {
        out.append("failed:\n");
        if (managed) { out.append(ManagedUnroots(function == 0 && mode == ProgramEntry)); }
        out.append(format_text("  ret {} {}\n", TypeName(result), Zero(result)));
    }
    if (coroutine) {
        out.append(CoroutineEpilogue(strings.Concatenate([TaskOwnerCleanup(owner_locations, "final"), TaskFrameCleanup(shape, locals, code, "final"), ManagedFramePins(shape, code, "final"), frame_roots.cleanup]),
                                     strings.Concatenate([TaskOwnerCleanup(owner_locations, "cancel"), TaskFrameCleanup(shape, locals, code, "cancel"), ManagedFramePins(shape, code, "cancel"), frame_roots.cleanup,
                                                          TaskPromiseCleanup(result, ValueOwned(result, record_owners)), frame_roots.destroy]), guarded));
    }
    out.append("trap:\n  call void @llvm.trap()\n  unreachable\n}\n");
    return strings.Join(out, "");
}

// Each argument becomes a runtime value in the format's array, in order, and
// the context's format_text writes the string it makes.
FormatInstruction :: (slots: int[], arguments: int[], item: Instruction, pc: int) -> string {
    value := abi.ValueType();
    text := abi.TextType();
    out := format_text("p{}:\n", pc);
    for (index in 0..<item.target) {
        slot := arguments[item.right + index];
        type := slots[slot];
        name := format_text("f{}_{}", pc, index);
        out = format_text("{}{}", out, Load(name, type, "s", slot));
        tag := FormatTag(type);
        if (abi.FormatRecordArgument(item.literal, index)) { tag = abi.FormatRecordTag; }
        empty := format_text("{ i32 {}, i32 0, i64 0, ptr null }", tag);
        if (tag == abi.FormatArrayTag || tag == abi.FormatMapTag) {
            out = format_text("{}  %{}.count = extractvalue {} %{}, 0\n", out, name, TypeName(type), name);
            out = format_text("{}  %{}.value = insertvalue {} {}, i32 %{}.count, 1\n", out, name, value, empty, name);
        } else if (type == abi.TextStorage) {
            out = format_text("{}  %{}.bytes = extractvalue {} %{}, 0\n  %{}.length = extractvalue {} %{}, 1\n", out,
                              name, text, name, name, text, name);
            out = format_text("{}  %{}.sized = insertvalue {} {}, i32 %{}.length, 1\n", out, name, value, empty, name);
            out = format_text("{}  %{}.value = insertvalue {} %{}.sized, ptr %{}.bytes, 3\n", out, name, value, name,
                              name);
        } else {
            out = format_text("{}{}", out, ToWord(format_text("{}.word", name), format_text("%{}", name), type));
            out = format_text("{}  %{}.value = insertvalue {} {}, i64 %{}.word, 2\n", out, name, value, empty, name);
        }
        out = format_text("{}  %{}.at = getelementptr inbounds [{} x {}], ptr %values{}, i64 0, i64 {}\n", out, name,
                          item.target, value, pc, index);
        out = format_text("{}  store {} %{}.value, ptr %{}.at\n", out, value, name, name);
    }
    out = format_text("{}  %format{}.at = getelementptr inbounds {}, ptr %ctx, i32 0, i32 0\n", out, pc,
                      abi.ContextType());
    out = format_text("{}  %format{} = load ptr, ptr %format{}.at\n", out, pc, pc);
    out = format_text("{}  call void %format{}(ptr %ctx, ptr %values{}, i32 {}, ptr %text{})\n", out, pc, pc,
                      item.target, pc);
    out = format_text("{}  %v{} = load {}, ptr %text{}\n", out, pc, text, pc);
    out = format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    return format_text("{}  br label %p{}\n", out, pc + 1);
}
// Whether `code` calls the runtime.
pub Runtime :: (code: Instruction[]) -> bool {
    if (Tasks(code)) {
        return true;
    }
    for (item in code) {
        if (item.op == ManagedPending || item.op == ManagedPoll || item.op == ManagedTrack || item.op == OwnerPin || item.op == ClockSample || item.op == ManagedProject || item.op == ManagedNew || item.op == ManagedAddress || item.op == ManagedPin || item.op == ManagedUnpin || item.op == Print || item.op == Format || item.op == Fail || item.op == ValueCopy || item.op == ValueDrop || ArrayCalls(item.op) || MapCalls(item) ||
            ((item.op == StateLoad || item.op == StateStore) && (item.type == abi.TextStorage || item.type >= RecordType))) {
            return true;
        }
    }
    return false;
}
// Whether each function can fail: it has a Fail, or calls a function that
// can.
Fallible :: (functions: Function[], code: Instruction[]) -> bool[] {
    fallible: bool[] = [];
    for (shape in functions) {
        fallible.append(false);
    }
    changed := true;
    while (changed) {
        changed = false;
        for (function in 0..<length(functions)) {
            shape := functions[function];
            for (item in Codes(code, shape.first_code, shape.code)) {
                if (!fallible[function] && (item.op == Fail || (item.op == ArrayResize && item.literal == i64(ArrayResizeInitialized)) ||
                    (item.op == Call && item.literal == i64(CallPlain) && fallible[item.left]))) {
                    fallible[function] = true;
                    changed = true;
                }
            }
        }
    }
    return fallible;
}
// Each Fail's constant in functions [first, last): its function's stable ID
// and its source range.
Failures :: (functions: Function[], code: Instruction[], texts: string[], first: int, last: int, program: bool) -> string {
    out: string[] = [];
    resize_failure := false;
    for (function in first..<last) {
        shape := functions[function];
        for (pc in 0..<shape.code) {
            item := code[shape.first_code + pc];
            if (!program && item.op == ArrayResize && item.literal == i64(ArrayResizeInitialized)) { resize_failure = true; }
            if (item.op == Fail) {
                type := abi.FailureType();
                metadata := "";
                if (program) {
                    type = abi.ProgramFailureType();
                    pointer := "null";
                    count := 0;
                    if (item.target > 0) {
                        pointer = format_text("@{}", TextSymbol(item.target - 1));
                        count = strings.ByteLength(texts[item.target - 1]);
                    }
                    metadata = format_text(", ptr {}, i32 {}", pointer, count);
                }
                out.append(format_text("@{} = private unnamed_addr constant {} { i64 {}, i32 {}, i32 {}{} }\n",
                                       FailureSymbol(function, pc), type, item.literal, item.left, item.right, metadata));
            }
        }
    }
    if (resize_failure) {
        out.append(format_text("@chibi_scalar.resize_failure = private constant {} zeroinitializer\n", abi.FailureType()));
    }
    return strings.Join(out, "");
}

// The symbol of retained state `index`.
StateSymbol :: (index: int) -> string {
    return format_text("chibi_scalar.retained.{}", index);
}
// The type of a retained state's global: a float or double as the integer of
// its bits, so a global's initial value is a decimal.
StateStorage :: (type: int) -> string {
    if (type == abi.FloatStorage) {
        return "i32";
    }
    if (type == abi.DoubleStorage) {
        return "i64";
    }
    return TypeName(type);
}
// The value of retained state `item.target`, as a `type` value `name`.
StateValue :: (name: string, item: Instruction) -> string {
    out := format_text("  %{}.stored = load {}, ptr @{}\n", name, StateStorage(item.type), StateSymbol(item.target));
    if (item.type == abi.TextStorage || item.type >= RecordType) {
        return format_text("  %{} = load {}, ptr @{}\n", name, TypeName(item.type), StateSymbol(item.target));
    }
    if (abi.Floating(item.type)) {
        return format_text("{}  %{} = bitcast {} %{}.stored to {}\n", out, name, StateStorage(item.type), name,
                           abi.ScalarType(item.type));
    }
    return format_text("{}  %{} = add {} %{}.stored, 0\n", out, name, abi.ScalarType(item.type), name);
}
StateRead :: (item: Instruction, pc: int, owners: bool[]) -> string {
    out := "";
    if (item.left > 0) {
        symbol := StateSymbol(item.target);
        out = format_text("  %ready{} = load i1, ptr @{}.ready\n  br i1 %ready{}, label %state{}, label %initial{}\ninitial{}:\n",
                          pc, symbol, pc, pc, pc, pc);
        out = format_text("{}{}", out, Load(format_text("initial.value{}", pc), item.type, "s", item.left - 1));
        value := format_text("%initial.value{}", pc);
        if (item.type >= ArrayType) {
            out = format_text("{}  %initial.owned{} = call {} @chibi_array.{}.copy(ptr %ctx, {} {})\n",
                out, pc, abi.ArrayType(), item.type, abi.ArrayType(), value);
            value = format_text("%initial.owned{}", pc);
        }
        if (abi.Floating(item.type)) {
            out = format_text("{}  %bits{} = bitcast {} {} to {}\n", out, pc, TypeName(item.type), value, StateStorage(item.type));
            value = format_text("%bits{}", pc);
        }
        out = format_text("{}  store {} {}, ptr @{}\n", out, StateStorage(item.type), value, symbol);
        if (item.type >= RecordType && item.type < ArrayType && owners[item.type - RecordType]) {
            out = format_text("{}  call void @chibi_value.{}.keep_at(ptr %ctx, ptr @{})\n", out, item.type, symbol);
        }
        out = format_text("{}  store i1 true, ptr @{}.ready\n  br label %state{}\nstate{}:\n", out, symbol, pc, pc);
    }
    out = format_text("{}{}", out, StateValue(format_text("v{}", pc), item));
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}
StateWrite :: (item: Instruction, pc: int, owners: bool[]) -> string {
    out := Load(format_text("a{}", pc), item.type, "s", item.left);
    value := format_text("%a{}", pc);
    if (abi.Floating(item.type)) {
        out = format_text("{}  %b{} = bitcast {} %a{} to {}\n", out, pc, abi.ScalarType(item.type), pc,
                          StateStorage(item.type));
        value = format_text("%b{}", pc);
    }
    if (item.type == abi.TextStorage) {
        symbol := StateSymbol(item.target);
        out = format_text("{}  %held{} = extractvalue {} {}, 2\n  call void @chibi_scalar.retain(ptr %held{})\n", out,
                          pc, abi.TextType(), value, pc);
        out = format_text("{}  %previous{} = load {}, ptr @{}\n  %released{} = extractvalue {} %previous{}, 2\n", out,
                          pc, abi.TextType(), symbol, pc, abi.TextType(), pc);
        out = format_text("{}  call void @chibi_scalar.free(ptr %ctx, ptr %released{})\n", out, pc);
    } else if (item.type >= ArrayType) {
        out = format_text("{}  %owned{} = call {} @chibi_array.{}.copy(ptr %ctx, {} {})\n", out, pc,
            abi.ArrayType(), item.type, abi.ArrayType(), value);
        out = format_text("{}  %previous{} = load {}, ptr @{}\n  call void @chibi_array.{}.drop(ptr %ctx, {} %previous{})\n",
            out, pc, abi.ArrayType(), StateSymbol(item.target), item.type, abi.ArrayType(), pc);
        value = format_text("%owned{}", pc);
    } else if (item.type >= RecordType && owners[item.type - RecordType]) {
        name := TypeName(item.type);
        out = format_text("{}  store {} {}, ptr %state.owned{}\n", out, name, value, pc);
        out = format_text("{}  call void @chibi_value.{}.keep_at(ptr %ctx, ptr %state.owned{})\n", out, item.type, pc);
        out = format_text("{}  call void @chibi_value.{}.drop_at(ptr %ctx, ptr @{})\n", out, item.type, StateSymbol(item.target));
        out = format_text("{}  %next{} = load {}, ptr %state.owned{}\n", out, pc, name, pc);
        value = format_text("%next{}", pc);
    }
    return format_text("{}  store {} {}, ptr @{}\n  store i1 true, ptr @{}.ready\n", out, StateStorage(item.type), value,
                      StateSymbol(item.target), StateSymbol(item.target));
}
// The module's retained states, in the order their loads are in the code.
RetainedStates :: (code: Instruction[]) -> Instruction[] {
    states: Instruction[] = [];
    for (item in code) {
        if (item.op == StateLoad) {
            states.append(item);
        }
    }
    return states;
}
// Each state's global, with `linkage`, which starts at its value. A state's
// load numbers it by its place among the loads, and a store names a state of
// the module.
StateGlobals :: (code: Instruction[], linkage: string) -> string {
    out: string[] = [];
    for (item in RetainedStates(code)) {
        initial := item.literal;
        if (item.type == abi.FloatStorage) {
            initial = Spelled(initial, abi.UintStorage);
        } else if (abi.ScalarType(item.type) != "" && !abi.Floating(item.type)) {
            initial = Spelled(initial, item.type);
        }
        value := format_text("{}", initial);
        if (item.type == abi.TextStorage || item.type >= RecordType) {
            value = "zeroinitializer";
        }
        out.append(format_text("@{} = {} global {} {}\n", StateSymbol(item.target), linkage, StateStorage(item.type), value));
        ready := "true";
        if (item.left > 0) {
            ready = "false";
        }
        out.append(format_text("@{}.ready = {} global i1 {}\n", StateSymbol(item.target), linkage, ready));
    }
    return strings.Join(out, "");
}
// Whether the module's states are numbered in order and every store names one.
StatesNumbered :: (code: Instruction[]) -> bool {
    states := RetainedStates(code);
    for (index in 0..<length(states)) {
        if (states[index].target != index) {
            return false;
        }
    }
    for (item in code) {
        if (item.op == StateStore && (item.target >= length(states) || states[item.target].type != item.type)) {
            return false;
        }
    }
    return true;
}
// Whether `code` moves array elements, which the module's copy does.
Copies :: (code: Instruction[]) -> bool {
    for (item in code) {
        if (TextSequenceOperation(item.op) ||
            item.op == ArrayInsert || item.op == ArrayReverse || item.op == ArrayPush || item.op == ArrayCopy || (item.op >= ArrayExtend && item.op <= ArrayRemove && item.op != ArrayContains) ||
            MapOperation(item.op)) {
            return true;
        }
    }
    return false;
}
// Whether `code` makes zeros for a longer array, which the module's zero does.
Zeroes :: (code: Instruction[]) -> bool {
    for (item in code) {
        if (item.op == ArrayResize || MapOperation(item.op)) {
            return true;
        }
    }
    return false;
}
// Fills `bytes` bytes with zero, a byte at a time, in a function that disables
// the library calls for the reason ArrayCopyHelper gives.
ArrayZeroHelper :: () -> string {
    out := "define internal void @chibi_scalar.zero(ptr %at, i64 %bytes) #1 {\nentry:\n  br label %head\n";
    out = format_text("{}head:\n  %index = phi i64 [ 0, %entry ], [ %next, %body ]\n  %done = icmp eq i64 %index, %bytes\n", out);
    out = format_text("{}  br i1 %done, label %exit, label %body\nbody:\n", out);
    out = format_text("{}  %place = getelementptr inbounds i8, ptr %at, i64 %index\n  store i8 0, ptr %place\n", out);
    return format_text("{}  %next = add i64 %index, 1\n  br label %head\nexit:\n  ret void\n}\n", out);
}
// Copies `bytes` bytes from one allocation to another, a byte at a time, from
// the front, so a copy down a few elements within an allocation is safe. It is
// a loop of its own, in a function that disables the library calls
// (attribute #1), so the optimizer does not turn it into a call of memcpy,
// which a program with no C library and an object with no undefined symbols
// lack.
ArrayCopyHelper :: () -> string {
    out := "define internal void @chibi_scalar.copy(ptr %to, ptr %from, i64 %bytes) #1 {\nentry:\n  br label %head\n";
    out = format_text("{}head:\n  %at = phi i64 [ 0, %entry ], [ %next, %body ]\n  %done = icmp eq i64 %at, %bytes\n", out);
    out = format_text("{}  br i1 %done, label %exit, label %body\nbody:\n", out);
    out = format_text("{}  %source = getelementptr inbounds i8, ptr %from, i64 %at\n  %byte = load i8, ptr %source\n", out);
    out = format_text("{}  %target = getelementptr inbounds i8, ptr %to, i64 %at\n  store i8 %byte, ptr %target\n", out);
    return format_text("{}  %next = add i64 %at, 1\n  br label %head\nexit:\n  ret void\n}\n", out);
}
// The symbol of text `index` of the module's table.
TextSymbol :: (index: int) -> string {
    return format_text("chibi_scalar.text.{}", index);
}
// `text` as the bytes of an LLVM c"" string: printable ASCII but `"` and `\`
// as itself, and every other byte as two hex digits after a `\`. Each run of
// bytes kept as themselves is one slice.
Escaped :: (text: string) -> string {
    digits := "0123456789ABCDEF";
    parts: string[] = [];
    bytes := strings.Bytes(text);
    start := 0;
    for (index in 0..<length(bytes)) {
        value := bytes[index];
        if (value < 32 || value >= 127 || value == 34 || value == 92) {
            parts.append(strings.Slice(text, start, index - start));
            parts.append(format_text("\\{}{}", strings.Slice(digits, value / 16, 1), strings.Slice(digits, value % 16, 1)));
            start = index + 1;
        }
    }
    parts.append(strings.Slice(text, start, length(bytes) - start));
    return strings.Join(parts, "");
}
// Whether `code` compares strings.
Compares :: (code: Instruction[]) -> bool {
    for (item in code) {
        if (item.type == abi.TextStorage && (item.op == Eq || item.op == Ne)) {
            return true;
        }
        if (item.op == ArrayContains && item.literal == i64(abi.TextStorage)) {
            return true;
        }
        if (MapOperation(item.op) && MapKey(MapUsed(item)) == abi.TextStorage) {
            return true;
        }
    }
    return false;
}
// Whether two strings hold the same bytes, as the runtime compares them:
// their lengths, then each byte in turn. It reads no byte of an empty string,
// so the zero string's missing bytes are never read.
TextEqual :: () -> string {
    text := abi.TextType();
    out := format_text("define internal i1 @chibi_scalar.text_equal({} %a, {} %b) #0 {\nentry:\n", text, text);
    out = format_text("{}  %a.bytes = extractvalue {} %a, 0\n  %a.length = extractvalue {} %a, 1\n", out, text, text);
    out = format_text("{}  %b.bytes = extractvalue {} %b, 0\n  %b.length = extractvalue {} %b, 1\n", out, text, text);
    out = format_text("{}  %same = icmp eq i32 %a.length, %b.length\n  br i1 %same, label %head, label %differ\n", out);
    out = format_text("{}head:\n  %index = phi i32 [ 0, %entry ], [ %next, %byte ]\n", out);
    out = format_text("{}  %done = icmp eq i32 %index, %a.length\n  br i1 %done, label %equal, label %byte\n", out);
    out = format_text("{}byte:\n  %offset = zext i32 %index to i64\n", out);
    out = format_text("{}  %a.at = getelementptr inbounds i8, ptr %a.bytes, i64 %offset\n", out);
    out = format_text("{}  %b.at = getelementptr inbounds i8, ptr %b.bytes, i64 %offset\n", out);
    out = format_text("{}  %a.byte = load i8, ptr %a.at\n  %b.byte = load i8, ptr %b.at\n", out);
    out = format_text("{}  %next = add i32 %index, 1\n  %matches = icmp eq i8 %a.byte, %b.byte\n", out);
    out = format_text("{}  br i1 %matches, label %head, label %differ\nequal:\n  ret i1 true\n", out);
    return format_text("{}differ:\n  ret i1 false\n}\n", out);
}
// The LLVM intrinsics `code` calls, each declared once.
Declarations :: (code: Instruction[]) -> string {
    out: string[] = [];
    for (item in code) {
        if (item.op == FloatAbs) {
            suffix := "f64";
            if (item.type == abi.FloatStorage) { suffix = "f32"; }
            declaration := format_text("declare {} @llvm.fabs.{}({})\n", TypeName(item.type), suffix, TypeName(item.type));
            if (!out.contains(declaration)) { out.append(declaration); }
            continue;
        }
        if (item.op == Sqrt) {
            declaration := "declare float @llvm.sqrt.f32(float)\n";
            if (!out.contains(declaration)) {
                out.append(declaration);
            }
            continue;
        }
        if (item.op != Convert || !abi.Floating(item.right) || !Integer(item.type)) {
            continue;
        }
        declaration := format_text("declare {} @{}({})\n", abi.ScalarType(item.type), Saturating(item.right, item.type),
                                   abi.ScalarType(item.right));
        if (!out.contains(declaration)) {
            out.append(declaration);
        }
    }
    return strings.Join(out, "");
}
Module :: (target: abi.Target, functions: Function[], parameters: int[], slots: int[], locals: int[],
           code: Instruction[], arguments: int[], records: Record[], fields: int[], field_tags: i64[], texts: string[], source: Source,
           names: string[], lines: int[], columns: int[], mode: int, step_budget: int, family: bool = false, snapshots: bool = false, clock_owner: bool = false) -> Result {
    empty: SnapshotShapes = {nodes: [], edges: [], roots: []};
    return ModuleValues(target, functions, parameters, slots, locals, code, arguments, records, fields, field_tags, texts,
        source, names, lines, columns, mode, step_budget, family, snapshots, clock_owner, empty, []);
}
ModuleValues :: (target: abi.Target, functions: Function[], parameters: int[], slots: int[], locals: int[],
           code: Instruction[], arguments: int[], records: Record[], fields: int[], field_tags: i64[], texts: string[], source: Source,
           names: string[], lines: int[], columns: int[], mode: int, step_budget: int, family: bool, snapshots: bool, clock_owner: bool, value_shapes: SnapshotShapes, field_names: string[]) -> Result {
    if (length(value_shapes.nodes) != 0 || length(value_shapes.edges) != 0 || length(value_shapes.roots) != 0) {
        error := SnapshotShapesValid(records, fields, field_names, RetainedStates(code), value_shapes);
        if (error != "") { return Result.Rejected(-1, error); }
    }
    if (step_budget <= 0) {
        return Result.Rejected(-1, "native CHECK budget must be positive");
    }
    if (!abi.Supported(target)) {
        return Result.Rejected(-1, "unsupported native target");
    }
    if (abi.Same(target, abi.WebAssembly32()) && Tasks(code)) {
        return Result.Rejected(-1, "native WebAssembly tasks have no runtime yet");
    }
    if (!Layout(functions, parameters, slots, locals, code, arguments)) {
        return Result.Rejected(-1, "unsupported native scalar signature or table size");
    }
    if (!RecordLayout(records, fields)) {
        return Result.Rejected(-1, "native records differ from their field table");
    }
    // All later metadata indexing uses this same canonical flat field extent.
    if (length(field_tags) != 0 && length(field_tags) != length(fields)) {
        return Result.Rejected(-1, "native managed field identities differ from the field table");
    }
    managed_records := ManagedRecordLayouts(records, fields);
    for (index in 0..<length(records)) {
        record := records[index];
        if (ManagedTraced(RecordType + index, managed_records.traced) &&
            !managed_records.traceable[index] && !ViewOptional(records, fields, RecordType + index, ViewType)) {
            return Result.Rejected(-1, "native managed pointer aggregate roots require scalar or pointer-only inline records");

        }
        if (record.identity == 0) { continue; }
        // The explicit family adapter supplies a program owner and pins the
        // image while its immutable typed callbacks remain in live cells.
        if (!ProgramMode(mode) && !family) {
            return Result.Rejected(-1, "native managed record layouts require a standalone or execution-family owner");
        }
        if ((!managed_records.flat[index] && !managed_records.plain[index]) || length(field_tags) == 0) {
            return Result.Rejected(-1, "native managed record metadata requires scalar or pointer fields");
        }
        whole := managed_records.plain[index] && field_tags[record.first] == 0;
        if (managed_records.flat[index]) {
            for (field in record.first..<record.first + record.count) {
                if ((field_tags[field] == 0) != whole) { return Result.Rejected(-1, "native managed field identity is invalid"); }
            }
        }
    }
    managed := ManagedRootTypes(parameters, managed_records.traced) || ManagedRootTypes(slots, managed_records.traced) ||
               ManagedRootTypes(locals, managed_records.traced);
    for (part in 0..<4) {
        types := parameters;
        if (part == 1) { types = slots; }
        if (part == 2) { types = locals; }
        if (part == 3) { types = fields; }
        for (type in types) {
            held := type;
            if (held >= RefType) { held -= RefType; }
            if (held >= ArrayType && held < MapType && ManagedTraced(held - ArrayType, managed_records.traced)) {
                return Result.Rejected(-1, "native pointer-record array roots are not implemented yet");
            }
        }
    }
    for (shape in functions) { managed = managed || ManagedStorage(shape.result) || ManagedTraced(shape.result, managed_records.traced); }
    polling := false;
    for (item in code) { polling = polling || item.op == ManagedPending || item.op == ManagedPoll || item.op == ManagedTrack; }
    managed = managed || polling;
    if (managed && abi.Same(target, abi.WebAssembly32())) {
        return Result.Rejected(-1, "native WebAssembly managed pointers have no collector owner yet");
    }
    if (managed && !ProgramMode(mode) && !family) {
        return Result.Rejected(-1, "native managed pointers require a standalone collector owner");
    }
    if (managed && !family && (ManagedStorage(functions[0].result) || ManagedTraced(functions[0].result, managed_records.traced))) {
        return Result.Rejected(-1, "a standalone entry cannot export managed pointers");
    }
    if (source.file != "" && abi.DebugFormat(target) == "") {
        return Result.Rejected(-1, "native line tables are Linux x86-64 only");
    }
    if (source.file != "" && !Placed(names, lines, columns, length(functions), length(code))) {
        return Result.Rejected(-1, "native line table differs from its module");
    }
    waiting := WaitingFunctions(functions, code);
    lifecycle := ValueLayouts(records, fields);
    promises: int[] = [];
    text_promise := false;
    for (function in 0..<length(functions)) {
        switch Validate(functions, function, parameters, slots, locals, code, arguments, records, fields, field_tags, texts,
                        mode, waiting, lifecycle, managed_records, family, snapshots, clock_owner || !abi.Same(target, abi.WebAssembly32()), value_shapes) {
            case .Rejected(instruction, message):
                return Result.Rejected(instruction, message);
            case .Emitted(text):
                result := functions[function].result;
                if (waiting[function] && TaskOwnedType(records, lifecycle, result)) {
                    promises.append(result);
                    text_promise = text_promise || result == abi.TextStorage;
                }
                continue;
        }
    }
    if (!StatesNumbered(code)) {
        return Result.Rejected(-1, "native retained states differ from their loads");
    }
    // A program's main has no context to pass.
    runtime := Runtime(code) || managed || snapshots || clock_owner;
    guarded := managed || (family && runtime);
    if (runtime && mode == MainEntry) {
        return Result.Rejected(-1, "a native program cannot call the runtime yet");
    }
    // A waiting entry is a coroutine that chibi_scalar runs with the tasks.
    if (Tasks(code) && (mode == ScalarEntry || mode == ProgramEntry)) {
        if (mode == ProgramEntry) { mode = ProgramCoroutineEntry; } else { mode = CoroutineEntry; }
    }
    debug := source.file != "";
    scope := RuntimeScopeNone;
    if (ProgramMode(mode)) { scope = ProgramScope(code, texts); }
    scoped := scope != RuntimeScopeNone;
    testing := scope == RuntimeScopeTest;
    formatting := false;
    numeric_formatting := false;
    clocked := false;
    for (shape in functions) {
        for (pc in shape.first_code..<shape.first_code + shape.code) {
            item := code[pc];
            if (item.op == ClockSample) { clocked = true; }
            if (item.op != Format) { continue; }
            formatting = true;
            // A bool can use numeric modifiers too. Text and collection
            // summaries omit the number renderer and its CRT dependency.
            for (index in 1..<item.target) {
                slot := arguments[shape.first_argument + item.right + index];
                type := slots[shape.first_slot + slot];
                if (type != abi.TextStorage && abi.ValueTag(type) != 0) { numeric_formatting = true; }
            }
        }
    }
    comparison_roots: int[] = [];
    comparison_marks: int[] = [];
    if (length(value_shapes.nodes) > 0) {
        comparison_marks = resize([int(0)], length(value_shapes.nodes));
        for (item in code) {
            if (item.op == ArrayContains && item.target > 0 && comparison_marks[item.target - 1] == 0) {
                comparison_marks[item.target - 1] = -1;
                comparison_roots.append(item.target - 1);
            }
        }
    }
    compares := Compares(code);
    fallible := Fallible(functions, code);
    // A program splits into pieces that opt and llc compile at once; a
    // library's manifests and line tables' metadata name every function, so
    // those stay one piece.
    bounds := Pieces(functions, mode != NoEntry && !debug && !Tasks(code));
    pieces := length(bounds) - 1;
    home: int[] = [];
    for (piece in 0..<pieces) {
        for (function in bounds[piece]..<bounds[piece + 1]) {
            home.append(piece);
        }
    }
    // The functions another piece calls or takes the address of.
    shared := resize([false], length(functions));
    for (function in 0..<length(functions)) {
        shape := functions[function];
        for (pc in shape.first_code..<shape.first_code + shape.code) {
            item := code[pc];
            if ((item.op == Call || item.op == FunctionAddress) && home[item.left] != home[function]) {
                shared[item.left] = true;
            }
        }
    }
    states := RetainedStates(code);
    record_owners := lifecycle.owned;
    out: string[] = [];
    for (piece in 0..<pieces) {
        first := bounds[piece];
        last := bounds[piece + 1];
        held := code;
        if (pieces > 1) {
            start := functions[first].first_code;
            held = Codes(code, start, functions[last - 1].first_code + functions[last - 1].code - start);
            // native_link.Pieces splits a module at this line.
            if (piece > 0) {
                out.append("; chibi-piece\n");
            }
        }
        // No host-derived data layout: the explicit LLVM target selects it. No
        // raw pointer or foreign ABI is admitted yet, and records stay internal.
        out.append(format_text("target triple = \"{}\"\n\n", target.triple));
        if (piece == 0 && guarded) { out.append("; chibi-managed\n"); }
        if (piece == 0 && family) { out.append("; chibi-family\n"); }
        if (piece == 0 && formatting) { out.append("; chibi-format\n"); }
        if (piece == 0 && numeric_formatting) { out.append("; chibi-format-numbers\n"); }
        foreign_declarations := ForeignDeclarations(functions, first, last, slots, code, arguments, texts);
        if (guarded) {
            // LLVM requires sized named types before their first GEP use.
            out.append("declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)\n");
            out.append(ManagedRuntime());
            out.append(ManagedPointerRuntime());
            if (polling) { out.append(ManagedPollRuntime(target, foreign_declarations)); }
            if (ViewTypes(parameters) || ViewTypes(slots) || ViewTypes(locals) || ViewTypes(fields)) {
                out.append(ViewTraceRuntime());
            }
        }
        for (index in 0..<length(records)) {
            record := records[index];
            types: string[] = [];
            for (field in 0..<record.count) {
                types.append(TypeName(fields[record.first + field]));
            }
            out.append(format_text("%record{} = type { {} }\n", index, strings.Join(types, ", ")));
        }
        if (managed && length(managed_records.flat) > 0) {
            // Each object emits only the metadata its constructors and local
            // inline roots use. Other pieces' cells carry their own callbacks.
            record_roots := resize([false], length(records));
            for (function in first..<last) {
                shape := functions[function];
                if (ManagedTraced(shape.result, managed_records.traced)) {
                    record_roots[shape.result - RecordType] = true;
                }
                for (part in 0..<2) {
                    types := slots;
                    begin := shape.first_slot;
                    count := shape.slots;
                    if (part == 1) { types = locals; begin = shape.first_local; count = shape.locals; }
                    for (at in begin..<begin + count) {
                        if (ManagedTraced(types[at], managed_records.traced)) { record_roots[types[at] - RecordType] = true; }
                    }
                }
            }
            for (item in held) {
                if (item.op == ManagedNew && item.right >= RecordType && item.right < ArrayType) { record_roots[item.right - RecordType] = true; }
                if (item.op == ManagedTrack) {
                    type := item.type;
                    if (type >= RefType) { type -= RefType; }
                    if (ManagedTraced(type, managed_records.traced)) { record_roots[type - RecordType] = true; }
                }
            }
            counter := "null";
            if (family) { counter = strings.Concatenate(["@", abi.ManagedImageCounter()]); }
            out.append(ManagedRecordModule(records, fields, field_tags, managed_records, record_roots, counter));
        }
        if (managed) {
            counter := "null";
            if (family) { counter = strings.Concatenate(["@", abi.ManagedImageCounter()]); }
            out.append(ManagedArrayModule(held, counter));
            out.append(ViewModule(held));
        }
        // One piece holds every text; each of several, the ones it reads.
        wanted := resize([false], length(texts));
        for (index in 0..<length(texts)) {
            wanted[index] = pieces == 1;
        }
        for (item in held) {
            if (item.op == Constant && item.type == abi.TextStorage) {
                wanted[int(item.literal)] = true;
            }
            if (item.op == Fail && item.target > 0) { wanted[item.target - 1] = true; }
        }
        for (index in 0..<length(texts)) {
            if (wanted[index]) {
                out.append(format_text("@{} = private unnamed_addr constant [{} x i8] c\"{}\\00\"\n", TextSymbol(index),
                                       strings.ByteLength(texts[index]) + 1, Escaped(texts[index])));
            }
        }
        // The first of several pieces defines the retained states, which the
        // others declare.
        if (pieces == 1) {
            out.append(StateGlobals(code, "internal"));
        } else if (piece == 0) {
            out.append(StateGlobals(code, "hidden"));
        } else {
            out.append(StateDeclarations(states, held));
        }
        if (ProgramMode(mode)) {
            out.append("declare void @chibi_native_step()\ndeclare void @chibi_native_failure(i32) noreturn\ndeclare void @chibi_native_reference_unavailable() noreturn\ndeclare void @chibi_native_map_owner_unavailable() noreturn\ndeclare void @chibi_native_array_mutation_unavailable() noreturn\n");
        } else if (family && guarded) {
            out.append("declare void @chibi_native_failure(i32) noreturn\n");
        }
        if (HasClockSample(held)) { out.append("; chibi-clock\n"); out.append(ClockRuntime()); }
        out.append(MathImports(target, held));
        printed := false;
        for (item in held) { printed = printed || item.op == Print; }
        if (printed) { out.append("declare void @chibi_print_string(ptr, ptr, i32)\n"); }
        out.append(format_text("{}declare void @llvm.trap()\n{}{}", Failures(functions, code, texts, first, last, ProgramMode(mode)),
                               Declarations(held), foreign_declarations));
        if (Tasks(held)) {
            out.append(CoroutineDeclarations());
            if (testing) { out.append("declare void @chibi_native_test_busy(i32)\n"); }
        }
        out.append(Callees(functions, parameters, held, home, piece, mode, runtime));
        for (function in first..<last) {
            text := EmitFunction(functions, function, parameters, slots, locals, code, arguments, records, fields,
                                 texts, mode, step_budget, runtime, fallible, shared[function], waiting, scoped, testing, record_owners, managed, managed_records, guarded);
            if (debug) {
                text = Located(text, Subprogram(function), Location(length(functions), compares,
                                                                    functions[function].first_code));
            }
            out.append(format_text("\n{}", text));
        }
        if (Tasks(held)) {
            timed := false;
            for (item in held) {
                timed = timed || item.op == CancelAfter || item.op == Delay;
            }
            out.append(format_text("\n{}", TaskScheduler(timed, guarded)));
            if (timed) {
                out.append(TaskTiming(target, foreign_declarations));
            }
            if (mode == CoroutineEntry || mode == ProgramCoroutineEntry) {
                entry_text := CoroutineEntryFunction(functions[0].result, waiting[0], timed);
                if (managed) {
                    cleanup := "  %managed.owner = call ptr @chibi_managed.owner(ptr %ctx)\n  call void @chibi_managed.collect(ptr %ctx, ptr %managed.owner)\n  ret ";
                    entry_text = strings.ReplaceAll(entry_text, "  ret ", cleanup);
                }
                out.append(format_text("\n{}", entry_text));
            }
        }
        callbacks := CallbackAdapters(functions, parameters, held, mode, runtime);
        if (callbacks != "") {
            if (runtime) {
                context_type := abi.ContextType();
                if (family || clock_owner || clocked) { context_type = abi.ClockContextType(); }
                out.append(format_text("\n@chibi_context = external global {}\n", context_type));
            }
            out.append(callbacks);
        }
        if (piece > 0 && length(comparison_roots) > 0) {
            declared := false;
            for (item in held) {
                if (item.op != ArrayContains || item.target <= 0) { continue; }
                root := item.target - 1;
                if (comparison_marks[root] == piece) { continue; }
                comparison_marks[root] = piece;
                if (!declared) { out.append("declare hidden void @chibi_value_equal.release(ptr, ptr)\n"); declared = true; }
                out.append(format_text("declare hidden i1 @chibi_value_equal.{}(ptr, ptr, ptr, ptr)\n", root));
            }
        }
        // Each piece has its own copy of the helpers its functions call.
        if (Compares(held)) {
            text := TextEqual();
            if (debug) {
                text = Located(text, Subprogram(length(functions)), Location(length(functions), true, length(code)));
            }
            out.append(format_text("\n{}", text));
        }
        value_uses := ValueUses(held, records, fields, record_owners, promises);
        array_helpers := ArrayModule(value_uses.arrays, record_owners, lifecycle.backed, guarded);
        out.append(array_helpers);
        value_comparisons := piece == 0 && length(comparison_roots) > 0;
        if (value_comparisons) {
            if (!snapshots) { out.append(SnapshotQueueRuntime(guarded)); }
            out.append(ValueEqualityModule(value_shapes, comparison_roots, guarded));
        }
        copies := Copies(held) || array_helpers != "" || length(value_uses.maps) != 0 || snapshots || value_comparisons;
        if (mode == NoEntry) {
            // The library's retained-text migration also copies bytes, using
            // the same freestanding helper as array operations.
            for (retained in states) { copies = copies || retained.type == abi.TextStorage; }
        }
        map_helpers := MapModule(value_uses.maps, records, fields, ProgramMode(mode), record_owners, lifecycle.backed, guarded);
        out.append(map_helpers);
        out.append(TextSequenceModule(held, guarded));
        if (copies) {
            out.append(format_text("\n{}", ArrayCopyHelper()));
        }
        if (Zeroes(held) || value_comparisons || length(value_uses.maps) != 0) {
            out.append(format_text("\n{}", ArrayZeroHelper()));
        }
        value_helpers := ValueModule(value_uses, records, fields, lifecycle, map_helpers == "");
        if (Counts(held) || text_promise || value_helpers != "" || array_helpers != "") {
            out.append(format_text("\n{}{}", TextHelpers(guarded), value_helpers));
        }
        cstrings := Cstrings(functions, first, last, slots, code, arguments);
        if (cstrings) {
            out.append(format_text("\n{}", CstringHelper()));
        }
        // Recursion is unchecked, as Rust's is: each function probes every page
        // of its frame, so running out of stack faults in the guard page below
        // it, which the host reports as a stack overflow.
        out.append("\nattributes #0 = { ");
        out.append(abi.StackProbe(target));
        out.append(" }\n");
        if (copies || cstrings || Tasks(held)) {
            out.append("attributes #1 = { noinline nounwind \"no-builtins\" }\n");
        }
        // Which source function each symbol is, for a backtrace or an
        // allocation profile to read: `; chibi-function INDEX NAME`.
        if (length(names) == length(functions)) {
            for (function in first..<last) {
                out.append(format_text("; chibi-function {} {}\n", function, names[function]));
            }
        }
        if (debug) {
            out.append(format_text("\n{}", Metadata(target, functions, source, names, lines, columns, mode, compares)));
        }
    }
    return Result.Emitted(strings.Join(out, ""));
}

// Instructions per piece of a split module, and the most pieces: about
// 37 for the compiler's 300,000, enough to keep 14 cores busy as the pieces
// finish unevenly. The count depends on the module alone, never on the
// machine, so every build of the same sources writes the same pieces.
PieceInstructions: int : 8192;
MostPieces: int : 64;
// Where each piece's functions start, then the function count: contiguous
// runs in source order, so neighbouring functions, which call each other
// most, share a piece, each of about the same instruction count.
Pieces :: (functions: Function[], split: bool) -> int[] {
    total := 0;
    for (shape in functions) {
        total += shape.code;
    }
    count := (total + PieceInstructions - 1) / PieceInstructions;
    if (count > MostPieces) {
        count = MostPieces;
    }
    bounds: int[] = [0];
    if (split && count > 1) {
        held := 0;
        for (function in 0..<length(functions) - 1) {
            held += functions[function].code;
            if (length(bounds) < count && held * count >= total * length(bounds)) {
                bounds.append(function + 1);
            }
        }
    }
    bounds.append(length(functions));
    return bounds;
}
// The declarations of the functions in other pieces that `held`, piece
// `piece`'s code, calls or takes the address of, in function order.
Callees :: (functions: Function[], parameters: int[], held: Instruction[], home: int[], piece: int, mode: int,
            runtime: bool) -> string {
    wanted := resize([false], length(functions));
    for (item in held) {
        if ((item.op == Call || item.op == FunctionAddress) && home[item.left] != piece) {
            wanted[item.left] = true;
        }
    }
    out: string[] = [];
    for (function in 0..<length(functions)) {
        if (!wanted[function]) {
            continue;
        }
        shape := functions[function];
        listed: string[] = [];
        if (runtime) {
            listed.append("ptr");
        }
        for (index in 0..<shape.parameters) {
            listed.append(TypeName(parameters[shape.first_parameter + index]));
        }
        linkage := "hidden ";
        if (function == 0 && mode != NoEntry) {
            linkage = "";
        }
        out.append(format_text("declare {}{} @{}({})\n", linkage, TypeName(shape.result), Symbol(function, mode),
                               strings.Join(listed, ", ")));
    }
    return strings.Join(out, "");
}
// The retained states `held` reads or writes, which another piece defines.
StateDeclarations :: (states: Instruction[], held: Instruction[]) -> string {
    wanted := resize([false], length(states));
    for (item in held) {
        if (item.op == StateLoad || item.op == StateStore) {
            wanted[item.target] = true;
        }
    }
    out: string[] = [];
    for (index in 0..<length(states)) {
        if (wanted[index]) {
            out.append(format_text("@{} = external hidden global {}\n@{}.ready = external hidden global i1\n", StateSymbol(index),
                                   StateStorage(states[index].type), StateSymbol(index)));
        }
    }
    return strings.Join(out, "");
}

// Whether line tables name every function and place every instruction.
Placed :: (names: string[], lines: int[], columns: int[], functions: int, code: int) -> bool {
    if (length(names) != functions || length(lines) != code || length(columns) != code) {
        return false;
    }
    for (name in names) {
        if (name == "") {
            return false;
        }
    }
    for (index in 0..<code) {
        if (lines[index] < 0 || columns[index] < 0) {
            return false;
        }
    }
    return true;
}
// Debug metadata numbers: the compile unit and its file, the two module flags,
// the one subroutine type and its empty tuple, a subprogram for each function
// then the string comparison helper, and a location for each code
// instruction then the helper's.
FirstSubprogram: int : 6;
Subprogram :: (function: int) -> int {
    return FirstSubprogram + function;
}
Location :: (functions: int, compares: bool, instruction: int) -> int {
    first := Subprogram(functions);
    if (compares) {
        first += 1;
    }
    return first + instruction;
}
// One function's IR with each instruction at its source position. The
// function is in its subprogram; label p<pc> starts code instruction pc's
// position, and the entry and trap blocks are at its first instruction's. A
// helper without p labels is wholly at `first`.
Located :: (text: string, scope: int, first: int) -> string {
    out: string[] = [];
    at := first;
    pc := 0;
    for (line in strings.Split(text, "\n")) {
        placed := line;
        if (strings.HasPrefix(line, "define ")) {
            placed = strings.Join([strings.TrimSuffix(line, " {"), format_text(" !dbg !{} ", scope), "{"], "");
        } else if (strings.HasPrefix(line, "p") && strings.HasSuffix(line, ":")) {
            at = first + pc;
            pc += 1;
        } else if (line == "trap:") {
            at = first;
        } else if (strings.HasPrefix(line, "  ")) {
            placed = format_text("{}, !dbg !{}", line, at);
        }
        out.append(placed);
    }
    return strings.Join(out, "\n");
}
// The line tables' metadata. DWARF names no Chibi language, so the unit is
// C99's, as Odin's is; only line tables are emitted, as rustc's
// line-tables-only does, so the subroutine type lists no types. The exported
// entry is external and every other function local to the unit; the string
// comparison helper is artificial, at line 0.
Metadata :: (target: abi.Target, functions: Function[], source: Source, names: string[], lines: int[], columns: int[],
             mode: int, compares: bool) -> string {
    out: string[] = ["!llvm.dbg.cu = !{!0}\n!llvm.module.flags = !{!2, !3}\n"];
    out.append("!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: \"chibi\", isOptimized: false, runtimeVersion: 0, emissionKind: LineTablesOnly)\n");
    out.append(format_text("!1 = !DIFile(filename: \"{}\", directory: \"{}\")\n!2 = {}\n", Escaped(source.file),
                           Escaped(source.directory), abi.DebugFormat(target)));
    out.append("!3 = !{i32 2, !\"Debug Info Version\", i32 3}\n!4 = !DISubroutineType(types: !5)\n");
    out.append("!5 = !{}\n");
    for (function in 0..<length(functions)) {
        line := lines[functions[function].first_code];
        flags := "DISPFlagDefinition";
        if (function != 0 || mode == NoEntry) {
            flags = "DISPFlagLocalToUnit | DISPFlagDefinition";
        }
        out.append(format_text("!{} = distinct !DISubprogram(name: \"{}\", linkageName: \"{}\", scope: !1, file: !1, line: {}, type: !4, scopeLine: {}, spFlags: {}, unit: !0)\n",
                               Subprogram(function), Escaped(names[function]), Symbol(function, mode), line, line,
                               flags));
    }
    if (compares) {
        out.append(format_text("!{} = distinct !DISubprogram(name: \"chibi_scalar.text_equal\", scope: !1, file: !1, line: 0, type: !4, scopeLine: 0, flags: DIFlagArtificial, spFlags: DISPFlagLocalToUnit | DISPFlagDefinition, unit: !0)\n",
                               Subprogram(length(functions))));
    }
    for (function in 0..<length(functions)) {
        shape := functions[function];
        for (pc in shape.first_code..<shape.first_code + shape.code) {
            out.append(format_text("!{} = !DILocation(line: {}, column: {}, scope: !{})\n",
                                   Location(length(functions), compares, pc), lines[pc], columns[pc],
                                   Subprogram(function)));
        }
    }
    if (compares) {
        code := 0;
        for (shape in functions) {
            code += shape.code;
        }
        out.append(format_text("!{} = !DILocation(line: 0, scope: !{})\n", Location(length(functions), true, code),
                               Subprogram(length(functions))));
    }
    return strings.Join(out, "");
}
pub Emit :: (target: abi.Target, functions: Function[], parameters: int[], slots: int[], locals: int[],
             code: Instruction[], arguments: int[], records: Record[], fields: int[], texts: string[],
             source: Source, names: string[], lines: int[], columns: int[], main: bool, step_budget: int) -> Result {
    mode := ScalarEntry;
    if (main) {
        mode = MainEntry;
    }
    return Module(target, functions, parameters, slots, locals, code, arguments, records, fields, [], texts, source, names,
                  lines, columns, mode, step_budget);
}

// Standalone programs use one runtime scope across every function and loop.
// Embedded modules keep Emit's caller-provided CHECK budget and context ABI.
pub EmitProgram :: (target: abi.Target, functions: Function[], parameters: int[], slots: int[], locals: int[],
             code: Instruction[], arguments: int[], records: Record[], fields: int[], texts: string[],
             source: Source, names: string[], lines: int[], columns: int[]) -> Result {
    return Module(target, functions, parameters, slots, locals, code, arguments, records, fields, [], texts, source, names,
                  lines, columns, ProgramEntry, 1);
}

// Managed record programs retain stable pointee and field identities in a
// parallel immutable table. All-zero field tags on a plain numeric aggregate
// expose only its whole cell payload; projectable fields require nonzero tags.
// Ordinary scalar/record callers need no metadata.
pub EmitProgramTyped :: (target: abi.Target, functions: Function[], parameters: int[], slots: int[], locals: int[],
             code: Instruction[], arguments: int[], records: Record[], fields: int[], field_tags: i64[], texts: string[],
             source: Source, names: string[], lines: int[], columns: int[]) -> Result {
    if (length(field_tags) != length(fields)) {
        return Result.Rejected(-1, "native managed field identities differ from the field table");
    }
    return Module(target, functions, parameters, slots, locals, code, arguments, records, fields, field_tags, texts, source,
                  names, lines, columns, ProgramEntry, 1);
}

// The caller owns seven context slots, including an immutable borrowed clock grant.
// Generic Wasm programs retain their older runtime prefix and cannot sample clocks.
// Plain records need no field tags; Module checks any supplied managed metadata.
pub EmitClockProgramTyped :: (target: abi.Target, functions: Function[], parameters: int[], slots: int[], locals: int[],
             code: Instruction[], arguments: int[], records: Record[], fields: int[], field_tags: i64[], texts: string[],
             source: Source, names: string[], lines: int[], columns: int[]) -> Result {
    return Module(target, functions, parameters, slots, locals, code, arguments, records, fields, field_tags, texts, source,
                  names, lines, columns, ProgramEntry, 1, false, false, true);
}

// Structural search requires the caller's validated value graph. The
// ordinary scalar-context entry keeps its five callbacks; a standalone
// program owns its existing runtime scope. Clock ownership stays explicit.
pub EmitValuesTyped :: (target: abi.Target, functions: Function[], parameters: int[], slots: int[], locals: int[],
                        code: Instruction[], arguments: int[], records: Record[], fields: int[], field_tags: i64[], texts: string[],
                        source: Source, names: string[], lines: int[], columns: int[], field_names: string[],
                        shapes: SnapshotShapes, program: bool, clock_owner: bool) -> Result {
    if (length(field_tags) != length(fields)) {
        return Result.Rejected(-1, "native managed field identities differ from the field table");
    }
    if (clock_owner && !program) {
        return Result.Rejected(-1, "native clock sampling requires an explicit seven-slot clock owner");
    }
    mode := ScalarEntry;
    if (program) { mode = ProgramEntry; }
    return ModuleValues(target, functions, parameters, slots, locals, code, arguments, records, fields, field_tags, texts,
                        source, names, lines, columns, mode, 1, false, false, clock_owner, shapes, field_names);
}

// Whether `name` can end a C symbol: an ASCII letter or `_`, then letters,
// digits and `_`.
Identifier :: (name: string) -> bool {
    bytes := strings.Bytes(name);
    for (index in 0..<length(bytes)) {
        value := bytes[index];
        letter := (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95;
        if (!letter && (index == 0 || value < 48 || value > 57)) {
            return false;
        }
    }
    return length(bytes) > 0;
}
// The manifest types of a function's parameters, then its result, or none
// when a word cannot carry one of them, such as a string or a record, or the
// entry ABI takes fewer parameters.
ExportTypes :: (shape: Function, parameters: int[]) -> int[] {
    types: int[] = [];
    if (shape.parameters > abi.ExportParameters) {
        return types;
    }
    for (index in 0..<shape.parameters) {
        types.append(abi.ExportType(parameters[shape.first_parameter + index]));
    }
    types.append(abi.ExportType(shape.result));
    for (type in types) {
        if (type == 0) {
            return [];
        }
    }
    return types;
}
// `word`, an i64, as a value `name` of storage `type`.
FromWord :: (name: string, word: string, type: int) -> string {
    if (type == abi.FloatStorage) {
        return format_text("  %{}.bits = trunc i64 {} to i32\n  %{} = bitcast i32 %{}.bits to float\n", name, word,
                           name, name);
    }
    if (type == abi.DoubleStorage) {
        return format_text("  %{} = bitcast i64 {} to double\n", name, word);
    }
    if (abi.IntegerBits(type) == 64) {
        return format_text("  %{} = add i64 {}, 0\n", name, word);
    }
    return format_text("  %{} = trunc i64 {} to {}\n", name, word, abi.ScalarType(type));
}
// The value `value` of storage `type` as an i64 `name`: an integer sign- or
// zero-extended, a bool as 0 or 1, and a float or double as its bits.
ToWord :: (name: string, value: string, type: int) -> string {
    if (type == abi.FloatStorage) {
        return format_text("  %{}.bits = bitcast float {} to i32\n  %{} = zext i32 %{}.bits to i64\n", name, value,
                           name, name);
    }
    if (type == abi.DoubleStorage) {
        return format_text("  %{} = bitcast double {} to i64\n", name, value);
    }
    if (abi.IntegerBits(type) == 64) {
        return format_text("  %{} = add i64 {}, 0\n", name, value);
    }
    extend := "sext";
    if (type == abi.BoolStorage || abi.Unsigned(type)) {
        extend = "zext";
    }
    return format_text("  %{} = {} {} {} to i64\n", name, extend, abi.ScalarType(type), value);
}
// Function `function`'s export entry, which takes the call's context, reads
// its arguments from words and writes its result as one. It passes the
// context on when the module calls the runtime.
ExportEntry :: (functions: Function[], function: int, parameters: int[], runtime: bool) -> string {
    shape := functions[function];
    out := format_text("define internal void @chibi_scalar.export.{}(ptr %ctx, ptr %in, ptr %out) #0 {\nentry:\n",
                       function);
    listed: string[] = [];
    if (runtime) {
        listed.append("ptr %ctx");
    }
    for (index in 0..<shape.parameters) {
        type := parameters[shape.first_parameter + index];
        out = format_text("{}  %w{}.at = getelementptr inbounds i64, ptr %in, i64 {}\n", out, index, index);
        out = format_text("{}  %w{} = load i64, ptr %w{}.at\n", out, index, index);
        out = format_text("{}{}", out, FromWord(format_text("a{}", index), format_text("%w{}", index), type));
        listed.append(format_text("{} %a{}", TypeName(type), index));
    }
    out = format_text("{}  %r = call {} @{}({})\n", out, TypeName(shape.result), Symbol(function, NoEntry),
                      strings.Join(listed, ", "));
    out = format_text("{}{}", out, ToWord("word", "%r", shape.result));
    return format_text("{}  store i64 %word, ptr %out\n  ret void\n}\n", out);
}
// The most words a state function takes or gives: its record's scalar fields.
StateWords: int : 64;
// A scalar field of a state record, reached through the record fields whose
// indices are `path` (`0, 2`), and named by their dotted names; or a scalar
// parameter or result, named `#<index>`, with no path.
Leaf :: struct {
    path: string;
    name: string;
    type: int;
}
NewLeaf :: (path: string, name: string, type: int) -> Leaf {
    leaf: Leaf = {path: path, name: name, type: type};
    return leaf;
}
// The scalar leaves of a value of `type`, in field order, appended to
// `leaves`; a field that is a string or an array is a leaf whose type has no
// word. `path` and `name` reach `type` from the value.
Leaves :: (records: Record[], fields: int[], field_names: string[], type: int, path: string, name: string,
           leaves: Leaf[]) -> Leaf[] {
    if (type < RecordType || type >= ArrayType) {
        leaves.append(NewLeaf(path, name, type));
        return leaves;
    }
    record := records[type - RecordType];
    for (index in 0..<record.count) {
        step := format_text("{}", index);
        field_name := field_names[record.first + index];
        if (path != "") {
            step = format_text("{}, {}", path, index);
        }
        if (name != "") {
            field_name = format_text("{}.{}", name, field_name);
        }
        leaves = Leaves(records, fields, field_names, fields[record.first + index], step, field_name, leaves);
    }
    return leaves;
}
// The leaves of a function's parameter `index` of `type`.
ParameterLeaves :: (records: Record[], fields: int[], field_names: string[], type: int, index: int) -> Leaf[] {
    leaves: Leaf[] = [];
    name := "";
    if (type < RecordType || type >= ArrayType) {
        name = format_text("#{}", index);
    }
    return Leaves(records, fields, field_names, type, "", name, leaves);
}
// Whether every leaf is a scalar a word carries, and there are not too many.
Carried :: (leaves: Leaf[]) -> bool {
    if (length(leaves) > StateWords) {
        return false;
    }
    for (leaf in leaves) {
        if (abi.ExportType(leaf.type) == 0) {
            return false;
        }
    }
    return true;
}
// The leaves of all of a function's parameters, in order.
InputLeaves :: (shape: Function, parameters: int[], records: Record[], fields: int[], field_names: string[]) -> Leaf[] {
    leaves: Leaf[] = [];
    for (index in 0..<shape.parameters) {
        leaves.extend(ParameterLeaves(records, fields, field_names, parameters[shape.first_parameter + index], index));
    }
    return leaves;
}
// The leaves of a function's result.
OutputLeaves :: (shape: Function, records: Record[], fields: int[], field_names: string[]) -> Leaf[] {
    return ParameterLeaves(records, fields, field_names, shape.result, 0);
}
// Whether a function is a state function: a record is among its parameters
// or is its result, and it is made only of scalars a word carries, so a host
// can pass a record of them through words that it names. The Frame of a game
// loop is one: it takes its state and gives the next.
Stateful :: (shape: Function, parameters: int[], records: Record[], fields: int[], field_names: string[]) -> bool {
    if (length(field_names) != length(fields)) {
        return false;
    }
    held := shape.result >= RecordType && shape.result < ArrayType;
    for (index in 0..<shape.parameters) {
        type := parameters[shape.first_parameter + index];
        held = held || (type >= RecordType && type < ArrayType);
    }
    return held && Carried(InputLeaves(shape, parameters, records, fields, field_names)) &&
           Carried(OutputLeaves(shape, records, fields, field_names));
}
// Function `function`'s state entry: like ExportEntry, but a record parameter
// is built from the words of its leaves, in field order, and a record result
// is written as the words of its leaves.
StateEntry :: (functions: Function[], function: int, parameters: int[], records: Record[], fields: int[],
               field_names: string[], runtime: bool) -> string {
    shape := functions[function];
    out := format_text("define internal void @chibi_scalar.state.{}(ptr %ctx, ptr %in, ptr %out) #0 {\nentry:\n",
                       function);
    listed: string[] = [];
    if (runtime) {
        listed.append("ptr %ctx");
    }
    word: int = 0;
    for (index in 0..<shape.parameters) {
        type := parameters[shape.first_parameter + index];
        value := "zeroinitializer";
        for (leaf in ParameterLeaves(records, fields, field_names, type, index)) {
            out = format_text("{}  %w{}.at = getelementptr inbounds i64, ptr %in, i64 {}\n", out, word, word);
            out = format_text("{}  %w{} = load i64, ptr %w{}.at\n", out, word, word);
            out = format_text("{}{}", out, FromWord(format_text("l{}", word), format_text("%w{}", word), leaf.type));
            if (leaf.path == "" && type < RecordType) {
                value = format_text("%l{}", word);
            } else {
                out = format_text("{}  %s{} = insertvalue {} {}, {} %l{}, {}\n", out, word, TypeName(type), value,
                                  TypeName(leaf.type), word, leaf.path);
                value = format_text("%s{}", word);
            }
            word += 1;
        }
        listed.append(format_text("{} {}", TypeName(type), value));
    }
    out = format_text("{}  %r = call {} @{}({})\n", out, TypeName(shape.result), Symbol(function, NoEntry),
                      strings.Join(listed, ", "));
    result := 0;
    for (leaf in OutputLeaves(shape, records, fields, field_names)) {
        value := "%r";
        if (leaf.path != "") {
            value = format_text("%f{}", result);
            out = format_text("{}  {} = extractvalue {} %r, {}\n", out, value, TypeName(shape.result), leaf.path);
        }
        out = format_text("{}{}", out, ToWord(format_text("o{}", result), value, leaf.type));
        out = format_text("{}  %o{}.at = getelementptr inbounds i64, ptr %out, i64 {}\n", out, result, result);
        out = format_text("{}  store i64 %o{}, ptr %o{}.at\n", out, result, result);
        result += 1;
    }
    return format_text("{}  ret void\n}\n", out);
}
// The globals of function `function`'s state schema: the manifest types of
// its input leaves then its output leaves, and the NUL-ended names of each in
// the same order.
StateSchema :: (function: int, inputs: Leaf[], outputs: Leaf[]) -> string {
    types: string[] = [];
    names := "";
    bytes: int = 0;
    for (leaf in inputs) {
        types.append(format_text("i8 {}", abi.ExportType(leaf.type)));
        names = format_text("{}{}\\00", names, Escaped(leaf.name));
        bytes += strings.ByteLength(leaf.name) + 1;
    }
    for (leaf in outputs) {
        types.append(format_text("i8 {}", abi.ExportType(leaf.type)));
        names = format_text("{}{}\\00", names, Escaped(leaf.name));
        bytes += strings.ByteLength(leaf.name) + 1;
    }
    out := format_text("@chibi_scalar.state.types.{} = private unnamed_addr constant [{} x i8] [{}]\n", function,
                       length(types), strings.Join(types, ", "));
    return format_text("{}@chibi_scalar.state.names.{} = private unnamed_addr constant [{} x i8] c\"{}\"\n", out,
                       function, bytes, names);
}
// The state functions of a library, in a manifest of their own,
// `chibi_state_<library>`, so the player's binding of its exports never sees
// them: { i32 abi, i32 count, ptr states }, each state { ptr name, i64 id,
// ptr types, ptr names, i32 inputs, i32 outputs, ptr entry }. The types are
// the manifest types of the input leaves then the output leaves, and the names
// are their NUL-ended names in the same order. A library with none has no
// such manifest.
StateManifest :: (name: string, names: string[], ids: i64[], functions: Function[], parameters: int[],
                  records: Record[], fields: int[], field_names: string[], runtime: bool) -> string {
    out: string[] = [];
    states: string[] = [];
    for (function in 0..<length(functions)) {
        shape := functions[function];
        if (!Stateful(shape, parameters, records, fields, field_names)) {
            continue;
        }
        inputs := InputLeaves(shape, parameters, records, fields, field_names);
        outputs := OutputLeaves(shape, records, fields, field_names);
        out.append(format_text("@chibi_scalar.state.name.{} = private unnamed_addr constant [{} x i8] c\"{}\\00\"\n",
                               function, strings.ByteLength(names[function]) + 1, Escaped(names[function])));
        out.append(StateSchema(function, inputs, outputs));
        out.append("\n");
        out.append(StateEntry(functions, function, parameters, records, fields, field_names, runtime));
        states.append(format_text("%chibi.state { ptr @chibi_scalar.state.name.{}, i64 {}, ptr @chibi_scalar.state.types.{}, ptr @chibi_scalar.state.names.{}, i32 {}, i32 {}, ptr @chibi_scalar.state.{} }",
                                  function, ids[function], function, function, length(inputs), length(outputs),
                                  function));
    }
    if (length(states) == 0) {
        return strings.Join(out, "");
    }
    out.append("\n%chibi.state = type { ptr, i64, ptr, ptr, i32, i32, ptr }\n");
    out.append(format_text("@chibi_scalar.states = private constant [{} x %chibi.state] [{}]\n", length(states),
                           strings.Join(states, ", ")));
    out.append(format_text("@chibi_state_{} = constant %chibi.manifest { i32 1, i32 {}, ptr @chibi_scalar.states }\n",
                           name, length(states)));
    return strings.Join(out, "");
}
// The retained states of a library, in a manifest of their own,
// `chibi_retained_<library>`: { i32 abi, i32 count, ptr types, ptr names, ptr
// get, ptr set }. The types are the manifest types of the states in code
// order and the names their NUL-ended names. `get` writes the states' values
// as words to its result, and `set` reads them from its arguments, as an
// export entry does, so a host moves them from one build of a library to the
// next. This legacy ABI exposes only eager numeric/bool globals. Lazy states
// and strings use the native host's per-key API, never borrowed handles in
// the bulk word manifest. A module outside that contract has no manifest.
RetainedManifest :: (name: string, code: Instruction[], texts: string[], characters: bool[]) -> string {
    states := RetainedStates(code);
    if (length(states) == 0 || characters.contains(true)) {
        return "";
    }
    for (item in states) {
        if (item.left != 0 || abi.ScalarType(item.type) == "") {
            return "";
        }
    }
    types: string[] = [];
    names: string[] = [];
    bytes: int = 0;
    get: string[] = ["\ndefine internal void @chibi_scalar.retained.get(ptr %ctx, ptr %in, ptr %out) #0 {\nentry:\n"];
    set: string[] = ["define internal void @chibi_scalar.retained.set(ptr %ctx, ptr %in, ptr %out) #0 {\nentry:\n"];
    for (item in states) {
        index := item.target;
        label := texts[item.right];
        types.append(format_text("i8 {}", abi.ExportType(item.type)));
        names.append(format_text("{}\\00", Escaped(label)));
        bytes += strings.ByteLength(label) + 1;
        get.append(StateValue(format_text("g{}", index), item));
        get.append(ToWord(format_text("w{}", index), format_text("%g{}", index), item.type));
        get.append(format_text("  %o{}.at = getelementptr inbounds i64, ptr %out, i64 {}\n  store i64 %w{}, ptr %o{}.at\n",
                               index, index, index, index));
        set.append(format_text("  %i{}.at = getelementptr inbounds i64, ptr %in, i64 {}\n  %i{} = load i64, ptr %i{}.at\n",
                               index, index, index, index));
        set.append(FromWord(format_text("v{}", index), format_text("%i{}", index), item.type));
        value := format_text("%v{}", index);
        if (abi.Floating(item.type)) {
            set.append(format_text("  %b{} = bitcast {} %v{} to {}\n", index, abi.ScalarType(item.type), index,
                                   StateStorage(item.type)));
            value = format_text("%b{}", index);
        }
        set.append(format_text("  store {} {}, ptr @{}\n  store i1 true, ptr @{}.ready\n", StateStorage(item.type), value, StateSymbol(index), StateSymbol(index)));
    }
    out := get;
    out.append("  ret void\n}\n\n");
    out.extend(set);
    out.append("  ret void\n}\n");
    out.append(format_text("@chibi_scalar.retained.types = private unnamed_addr constant [{} x i8] [{}]\n",
                           length(types), strings.Join(types, ", ")));
    out.append(format_text("@chibi_scalar.retained.names = private unnamed_addr constant [{} x i8] c\"{}\"\n", bytes,
                           strings.Join(names, "")));
    out.append(format_text("@chibi_retained_{} = constant { i32, i32, ptr, ptr, ptr, ptr } { i32 1, i32 {}, ptr @chibi_scalar.retained.types, ptr @chibi_scalar.retained.names, ptr @chibi_scalar.retained.get, ptr @chibi_scalar.retained.set }\n",
                           name, length(states)));
    return strings.Join(out, "");
}
// Copy a retained string into the incoming generation. Constants can point
// into the old object's mapping, so retaining its owner alone is insufficient.
RetainedTextCopy :: (guarded: bool = false) -> string {
    return strings.Join([
        "define internal void @chibi_scalar.retained.copy(ptr %ctx, ptr %to, ptr %from) {\nentry:\n",
        "  %source = load { ptr, i32, ptr }, ptr %from\n  %bytes = extractvalue { ptr, i32, ptr } %source, 0\n",
        "  %length = extractvalue { ptr, i32, ptr } %source, 1\n  %wide = zext i32 %length to i64\n",
        "  %size = add i64 %wide, 17\n",
        Allocated("owner", "%size", guarded),
        "  store i64 1, ptr %owner\n  %size.at = getelementptr inbounds i8, ptr %owner, i64 8\n",
        "  store i32 %length, ptr %size.at\n  %data = getelementptr inbounds i8, ptr %owner, i64 12\n",
        "  call void @chibi_scalar.copy(ptr %data, ptr %bytes, i64 %wide)\n",
        "  %old = load { ptr, i32, ptr }, ptr %to\n  %released = extractvalue { ptr, i32, ptr } %old, 2\n",
        "  call void @chibi_scalar.free(ptr %ctx, ptr %released)\n",
        "  %a = insertvalue { ptr, i32, ptr } zeroinitializer, ptr %data, 0\n",
        "  %b = insertvalue { ptr, i32, ptr } %a, i32 %length, 1\n",
        "  %value = insertvalue { ptr, i32, ptr } %b, ptr %owner, 2\n",
        "  store { ptr, i32, ptr } %value, ptr %to\n  ret void\n}\n"
    ], "");
}

// FNV-1a over the bytes of `name`, which a host compares in place of the name
// it cannot read.
NameHash :: (name: string) -> i64 {
    hash: u64 = 0xcbf29ce484222325;
    prime: u64 = 1099511628211;
    for (byte in strings.Bytes(name)) {
        hash = (hash ^ u64(byte)) * prime;
    }
    return i64(wrap: hash);
}
// Whether a host calls function `shape` through a plain C-ABI wrapper: up to
// eight parameters and a result that are each a 32- or 64-bit integer, a float
// or a double.
HostCallable :: (shape: Function, parameters: int[]) -> bool {
    if (shape.parameters > abi.ExportParameters) {
        return false;
    }
    types: int[] = [shape.result];
    for (index in 0..<shape.parameters) {
        types.append(parameters[shape.first_parameter + index]);
    }
    for (type in types) {
        if (abi.Floating(type) || (Integer(type) && abi.IntegerBits(type) >= 32)) {
            continue;
        }
        return false;
    }
    return true;
}
// A function of the state accessors that `switch`es on its index argument to a
// constant `result` of `type` for each state, and gives 0 for an index outside them.
HostTable :: (symbol: string, type: string, results: string[]) -> string {
    cases: string[] = [];
    arms: string[] = [];
    for (index in 0..<length(results)) {
        cases.append(format_text("i32 {}, label %c{}", index, index));
        arms.append(format_text("c{}:\n  ret {} {}\n", index, type, results[index]));
    }
    out: string[] = [format_text("define {} @{}(i32 %i) #0 {\nentry:\n  switch i32 %i, label %none [{}]\n", type,
                                 symbol, strings.Join(cases, " "))];
    out.extend(arms);
    out.append(format_text("none:\n  ret {} 0\n}\n", type));
    return strings.Join(out, "");
}
// The block of ConvertWord that carries a word of storage `source` as one of
// storage `target`, as the language converts: an integer clamps to the new
// range, a float truncates toward zero and saturates, NaN is 0, and a bool is
// a number's inequality to zero or 0 and 1. `from` and `to` are the export types.
ConvertBlock :: (from: int, to: int, source: int, target: int) -> string {
    pc := from * 16 + to;
    out := format_text("f{}t{}:\n", from, to);
    if (from == to) {
        return format_text("{}  ret i64 %v\n", out);
    }
    decoded := source;
    if (source == abi.BoolStorage) {
        out = format_text("{}{}  %a{} = zext i1 %b{} to i32\n", out, FromWord(format_text("b{}", pc), "%v", source), pc, pc);
        decoded = abi.IntStorage;
    } else {
        out = format_text("{}{}", out, FromWord(format_text("a{}", pc), "%v", source));
    }
    if (target == abi.BoolStorage) {
        if (abi.Floating(decoded)) {
            out = format_text("{}  %w{} = fcmp une {} %a{}, 0.0\n", out, pc, abi.ScalarType(decoded), pc);
        } else {
            out = format_text("{}  %w{} = icmp ne {} %a{}, 0\n", out, pc, abi.ScalarType(decoded), pc);
        }
        return format_text("{}{}  ret i64 %r{}\n", out, ToWord(format_text("r{}", pc), format_text("%w{}", pc), target), pc);
    }
    item: Instruction = {op: Convert, type: target, output: 0, left: 0, right: decoded, target: 0, literal: 0};
    out = format_text("{}{}", out, Conversion(item, pc));
    return format_text("{}{}  ret i64 %r{}\n", out, ToWord(format_text("r{}", pc), format_text("%v{}", pc), target), pc);
}
// A function that carries a state's word from export type %from to %to, a
// pair of the numbers and bools, and any other pair unchanged.
ConvertWord :: () -> string {
    storages := abi.ExportOrder();
    sources: string[] = [];
    arms: string[] = [];
    for (from in 1..length(storages)) {
        targets: string[] = [];
        sources.append(format_text("i32 {}, label %src{}", from, from));
        arms.append(format_text("src{}:\n", from));
        for (to in 1..length(storages)) {
            targets.append(format_text("i32 {}, label %f{}t{}", to, from, to));
        }
        arms.append(format_text("  switch i32 %to, label %same [{}]\n", strings.Join(targets, " ")));
    }
    for (from in 1..length(storages)) {
        for (to in 1..length(storages)) {
            arms.append(ConvertBlock(from, to, storages[from - 1], storages[to - 1]));
        }
    }
    head := format_text("define i64 @chibi_scalar.convert(i32 %from, i32 %to, i64 %v) #0 {\nentry:\n  switch i32 %from, label %same [{}]\n",
                        strings.Join(sources, " "));
    return format_text("{}{}same:\n  ret i64 %v\n}\n", head, strings.Join(arms, ""));
}
// The saturating intrinsics ConvertWord calls, each declared once.
ConvertDeclarations :: () -> string {
    items: Instruction[] = [];
    for (source in [abi.FloatStorage, abi.DoubleStorage]) {
        for (target in abi.ExportOrder()) {
            if (Integer(target)) {
                item: Instruction = {op: Convert, type: target, output: 0, left: 0, right: source, target: 0, literal: 0};
                items.append(item);
            }
        }
    }
    return Declarations(items);
}
// Plain C-ABI symbols let the foreign-call host use a library without walking
// its manifest. Scalar states move as words; text/array getters borrow a
// descriptor address until the matching setter copies into its own context.
// Hosts check type/schema before any setters. Setters return 1 on success,
// and 0 for an unknown index, invalid char or incompatible conversion.
RetainedArrayTag: int : 13;
RetainedCharTag: int : 14;
HostSymbols :: (names: string[], functions: Function[], parameters: int[], code: Instruction[], texts: string[],
                runtime: bool, waiting: bool[], characters: bool[], roots: int[], layout: ValueLayout) -> string {
    out: string[] = [];
    for (function in 0..<length(functions)) {
        shape := functions[function];
        if (waiting[function] || !HostCallable(shape, parameters)) {
            continue;
        }
        listed: string[] = [];
        passed: string[] = [];
        for (index in 0..<shape.parameters) {
            type := TypeName(parameters[shape.first_parameter + index]);
            listed.append(format_text("{} %a{}", type, index));
            passed.append(format_text("{} %a{}", type, index));
        }
        if (runtime) {
            passed = extend(["ptr @chibi_context"], passed);
        }
        out.append(format_text("\ndefine {} @chibi_host_call_{}({}) #0 {\nentry:\n  %r = call {} @{}({})\n  ret {} %r\n}\n",
                               TypeName(shape.result), names[function], strings.Join(listed, ", "), TypeName(shape.result),
                               Symbol(function, NoEntry), strings.Join(passed, ", "), TypeName(shape.result)));
    }
    if (runtime) {
        out.append("\ndefine i32 @chibi_host_failed() #0 {\nentry:\n  %at = getelementptr inbounds { ptr, ptr, ptr, ptr, ptr }, ptr @chibi_context, i32 0, i32 1\n  %failure = load ptr, ptr %at\n  %failed = icmp ne ptr %failure, null\n  %status = zext i1 %failed to i32\n  ret i32 %status\n}\n");
    }
    states := RetainedStates(code);
    types: string[] = [];
    hashes: string[] = [];
    schemas: string[] = [];
    for (item, index in states) {
        tag := SnapshotStateTag(item, index, roots, characters);
        schema: i64 = 0;
        if (tag == RetainedSnapshotTag) {
            schema = NameHash("chibi.retained.snapshot.v2");
        } else if (StateArray(item.type)) {
            tag = RetainedArrayTag;
            schema = NameHash(format_text("chibi.retained.array.v1.{}", abi.ExportType(item.type - ArrayType)));
        } else if (index < length(characters) && characters[index]) {
            tag = RetainedCharTag;
            schema = NameHash("chibi.retained.char.v1");
        }
        types.append(format_text("{}", tag));
        schemas.append(format_text("{}", schema));
        hashes.append(format_text("{}", NameHash(texts[item.right])));
    }
    released: string[] = ["\ndefine i32 @chibi_host_retained_release() #0 {\nentry:\n"];
    for (item in states) {
        if (item.type == abi.TextStorage) {
            released.append(format_text("  %text{} = load {}, ptr @{}\n  %owner{} = extractvalue {} %text{}, 2\n", item.target, abi.TextType(), StateSymbol(item.target), item.target, abi.TextType(), item.target));
            released.append(format_text("  call void @chibi_scalar.free(ptr @chibi_context, ptr %owner{})\n  store {} zeroinitializer, ptr @{}\n", item.target, abi.TextType(), StateSymbol(item.target)));
        } else if (item.type >= ArrayType) {
            released.append(format_text("  %array{} = load {}, ptr @{}\n  call void @chibi_array.{}.drop(ptr @chibi_context, {} %array{})\n  store {} zeroinitializer, ptr @{}\n",
                item.target, abi.ArrayType(), StateSymbol(item.target), item.type, abi.ArrayType(), item.target, abi.ArrayType(), StateSymbol(item.target)));
        } else if (item.type >= RecordType) {
            if (layout.owned[item.type - RecordType]) {
                released.append(format_text("  call void @chibi_value.{}.drop_at(ptr @chibi_context, ptr @{})\n", item.type, StateSymbol(item.target)));
            }
            released.append(format_text("  store {} zeroinitializer, ptr @{}\n", TypeName(item.type), StateSymbol(item.target)));
        }
    }
    released.append("  ret i32 0\n}\n");
    out.extend(released);
    count := length(states);
    out.append(format_text("\ndefine i32 @chibi_host_retained_count() #0 {\nentry:\n  ret i32 {}\n}\n", count));
    out.append("\n");
    out.append(HostTable("chibi_host_retained_type", "i32", types));
    out.append("\n");
    out.append(HostTable("chibi_host_retained_hash", "i64", hashes));
    out.append(HostTable("chibi_host_retained_schema", "i64", schemas));
    if (count == 0) {
        out.append("\ndefine i32 @chibi_host_retained_ready(i32 %i) #0 {\nentry:\n  ret i32 0\n}\n");
        out.append("\ndefine i64 @chibi_host_retained_get(i32 %i) #0 {\nentry:\n  ret i64 0\n}\n");
        out.append("\ndefine i32 @chibi_host_retained_set(i32 %i, i64 %v) #0 {\nentry:\n  ret i32 0\n}\n");
        out.append("\ndefine i32 @chibi_host_retained_set_as(i32 %i, i32 %from, i64 %v) #0 {\nentry:\n  ret i32 0\n}\n");
        return strings.Join(out, "");
    }
    read: string[] = [];
    write: string[] = [];
    ready: string[] = [];
    cases: string[] = [];
    for (item in states) {
        index := item.target;
        cases.append(format_text("i32 {}, label %c{}", index, index));
        ready.append(format_text("c{}:\n  %v{} = load i1, ptr @{}.ready\n  %r{} = zext i1 %v{} to i32\n  ret i32 %r{}\n", index, index, StateSymbol(index), index, index, index));
        read.append(format_text("c{}:\n", index));
        write.append(format_text("c{}:\n", index));
        if (index < length(roots) && roots[index] >= 0) {
            read.append(format_text("  ret i64 ptrtoint (ptr @chibi_snapshot.view.{} to i64)\n", index));
            // Older per-key hosts lack a whole-transaction schema contract.
            // They reject this image instead of accepting an opaque handle.
            write.append("  ret i32 0\n");
            continue;
        } else if (item.type == abi.TextStorage) {
            read.append(format_text("  %w{} = ptrtoint ptr @{} to i64\n  ret i64 %w{}\n", index, StateSymbol(index), index));
            write.append(format_text("  %source{} = inttoptr i64 %v to ptr\n  call void @chibi_scalar.retained.copy(ptr @chibi_context, ptr @{}, ptr %source{})\n", index, StateSymbol(index), index));
        } else if (StateArray(item.type)) {
            read.append(format_text("  %w{} = ptrtoint ptr @{} to i64\n  ret i64 %w{}\n", index, StateSymbol(index), index));
            // The incoming allocator owns every migrated byte. Preserve a
            // nonnull empty buffer without copying unused spare capacity.
            write.append(format_text("  %source{} = inttoptr i64 %v to ptr\n  %given{} = load {}, ptr %source{}\n", index, index, abi.ArrayType(), index));
            write.append(format_text("  %length{} = extractvalue {} %given{}, 0\n  %data{} = extractvalue {} %given{}, 2\n", index, abi.ArrayType(), index, index, abi.ArrayType(), index));
            write.append(format_text("  %nonnull{} = icmp ne ptr %data{}, null\n  %minimum{} = zext i1 %nonnull{} to i32\n  %empty{} = icmp eq i32 %length{}, 0\n  %capacity{} = select i1 %empty{}, i32 %minimum{}, i32 %length{}\n", index, index, index, index, index, index, index, index, index, index));
            write.append(format_text("  %copied{} = call {} @chibi_array.{}.clone(ptr @chibi_context, {} %given{}, i32 %capacity{})\n", index, abi.ArrayType(), item.type, abi.ArrayType(), index, index));
            write.append(format_text("  %previous{} = load {}, ptr @{}\n  call void @chibi_array.{}.drop(ptr @chibi_context, {} %previous{})\n  store {} %copied{}, ptr @{}\n", index, abi.ArrayType(), StateSymbol(index), item.type, abi.ArrayType(), index, abi.ArrayType(), index, StateSymbol(index)));
        } else {
            if (index < length(characters) && characters[index]) {
                write.append(format_text("  %within{} = icmp ule i64 %v, 1114111\n  %range{} = and i64 %v, -2048\n  %scalar{} = icmp ne i64 %range{}, 55296\n  %valid{} = and i1 %within{}, %scalar{}\n  br i1 %valid{}, label %character{}, label %none\ncharacter{}:\n",
                    index, index, index, index, index, index, index, index, index, index));
            }
            read.append(StateValue(format_text("g{}", index), item));
            read.append(ToWord(format_text("w{}", index), format_text("%g{}", index), item.type));
            read.append(format_text("  ret i64 %w{}\n", index));
            write.append(FromWord(format_text("v{}", index), "%v", item.type));
            value := format_text("%v{}", index);
            if (abi.Floating(item.type)) {
                write.append(format_text("  %bits{} = bitcast {} {} to {}\n", index, TypeName(item.type), value, StateStorage(item.type)));
                value = format_text("%bits{}", index);
            }
            write.append(format_text("  store {} {}, ptr @{}\n", StateStorage(item.type), value, StateSymbol(index)));
        }
        write.append(format_text("  store i1 true, ptr @{}.ready\n  ret i32 1\n", StateSymbol(index)));
    }
    dispatch := strings.Join(cases, " ");
    out.append(format_text("\ndefine i32 @chibi_host_retained_ready(i32 %i) #0 {\nentry:\n  switch i32 %i, label %none [{}]\n{}none:\n  ret i32 0\n}\n", dispatch, strings.Join(ready, "")));
    out.append(format_text("\ndefine i64 @chibi_host_retained_get(i32 %i) #0 {\nentry:\n  switch i32 %i, label %none [{}]\n{}none:\n  ret i64 0\n}\n", dispatch, strings.Join(read, "")));
    out.append(format_text("\ndefine i32 @chibi_host_retained_set(i32 %i, i64 %v) #0 {\nentry:\n  switch i32 %i, label %none [{}]\n{}none:\n  ret i32 0\n}\n", dispatch, strings.Join(write, "")));
    out.append(format_text("\n{}\n{}", ConvertDeclarations(), ConvertWord()));
    out.append("\ndefine i32 @chibi_host_retained_set_as(i32 %i, i32 %from, i64 %v) #0 {\nentry:\n");
    out.append("  %to = call i32 @chibi_host_retained_type(i32 %i)\n");
    out.append("  %same = icmp eq i32 %from, %to\n  br i1 %same, label %direct, label %checked\ndirect:\n  %kept = call i32 @chibi_host_retained_set(i32 %i, i64 %v)\n  ret i32 %kept\nchecked:\n");
    out.append("  %from.low = icmp uge i32 %from, 1\n  %from.high = icmp ule i32 %from, 11\n  %to.low = icmp uge i32 %to, 1\n  %to.high = icmp ule i32 %to, 11\n  %from.scalar = and i1 %from.low, %from.high\n  %to.scalar = and i1 %to.low, %to.high\n  %convertible = and i1 %from.scalar, %to.scalar\n  br i1 %convertible, label %convert, label %none\nnone:\n  ret i32 0\nconvert:\n");
    out.append("  %w = call i64 @chibi_scalar.convert(i32 %from, i32 %to, i64 %v)\n");
    out.append("  %r = call i32 @chibi_host_retained_set(i32 %i, i64 %w)\n  ret i32 %r\n}\n");
    return strings.Join(out, "");
}
// COFF exports are explicit. Libraries have no debug metadata, so these
// module-local metadata IDs start at zero without sharing another namespace.
WindowsLibraryExports :: (symbols: string[]) -> string {
    references: string[] = [];
    declarations: string[] = [];
    for (symbol, index in symbols) {
        references.append(format_text("!{}", index));
        declarations.append(strings.Concatenate([format_text("!{} = !", index), "{!\"/export:", Escaped(symbol), "\"}\n"]));
    }
    return strings.Concatenate(["\n!llvm.linker.options = !{", strings.Join(references, ", "), "}\n", strings.Join(declarations, "")]);
}

// A library module: each function is internal, and the symbols it exports are
// its manifest, `chibi_natives_<library>`, a constant execution_native_manifest
// (src/execution/native.h) listing an entry for each function whose
// parameters and result words carry, under its name and stable ID, and the
// plain C-ABI symbols of HostSymbols.
pub EmitLibrary :: (target: abi.Target, name: string, names: string[], ids: i64[], functions: Function[],
                    parameters: int[], slots: int[], locals: int[], code: Instruction[], arguments: int[],
                    records: Record[], fields: int[], texts: string[], step_budget: int, field_names: string[], entries: int = -1) -> Result {
    characters: bool[] = [];
    return EmitLibraryStates(target, name, names, ids, functions, parameters, slots, locals, code, arguments,
        records, fields, texts, step_budget, field_names, entries, characters);
}
// Managed value snapshots require complete structural metadata. Existing
// library/family APIs retain their prior closed retained-value contracts.
pub EmitSnapshotLibrary :: (target: abi.Target, name: string, names: string[], ids: i64[], functions: Function[],
                           parameters: int[], slots: int[], locals: int[], code: Instruction[], arguments: int[],
                           records: Record[], fields: int[], texts: string[], step_budget: int, field_names: string[], entries: int,
                           state_characters: bool[], shapes: SnapshotShapes) -> Result {
    return LibraryStates(target, name, names, ids, functions, parameters, slots, locals, code, arguments,
        records, fields, [], texts, step_budget, field_names, entries, state_characters, false, true, shapes);
}
// The source compiler preserves nominal retained char leaves here. Keep the
// older entry usable by raw native clients without array-valued defaults,
// which the verified bootstrap compiler cannot lower.
// Dynamic char initializers must already hold a Unicode scalar; source
// CharChecked conversions establish that invariant before StateLoad.
pub EmitLibraryStates :: (target: abi.Target, name: string, names: string[], ids: i64[], functions: Function[],
                          parameters: int[], slots: int[], locals: int[], code: Instruction[], arguments: int[],
                          records: Record[], fields: int[], texts: string[], step_budget: int, field_names: string[], entries: int,
                          state_characters: bool[]) -> Result {
    empty: SnapshotShapes = {nodes: [], edges: [], roots: []};
    return LibraryStates(target, name, names, ids, functions, parameters, slots, locals, code, arguments,
        records, fields, [], texts, step_budget, field_names, entries, state_characters, false, false, empty);
}
// A shared program supplies one execution-family owner before calling exports.
pub EmitFamilyLibraryStates :: (target: abi.Target, name: string, names: string[], ids: i64[], functions: Function[],
                                parameters: int[], slots: int[], locals: int[], code: Instruction[], arguments: int[],
                                records: Record[], fields: int[], field_tags: i64[], texts: string[], step_budget: int, field_names: string[], entries: int,
                                state_characters: bool[]) -> Result {
    empty: SnapshotShapes = {nodes: [], edges: [], roots: []};
    return LibraryStates(target, name, names, ids, functions, parameters, slots, locals, code, arguments,
        records, fields, field_tags, texts, step_budget, field_names, entries, state_characters, true, false, empty);
}
// Snapshot roots use the same family allocator and keep GC-bearing values
// closed; the transaction copies only the validated reference-counted graph.
pub EmitFamilySnapshotLibrary :: (target: abi.Target, name: string, names: string[], ids: i64[], functions: Function[],
                                 parameters: int[], slots: int[], locals: int[], code: Instruction[], arguments: int[],
                                 records: Record[], fields: int[], field_tags: i64[], texts: string[], step_budget: int,
                                 field_names: string[], entries: int, state_characters: bool[], shapes: SnapshotShapes) -> Result {
    return LibraryStates(target, name, names, ids, functions, parameters, slots, locals, code, arguments,
        records, fields, field_tags, texts, step_budget, field_names, entries, state_characters, true, true, shapes);
}

// The same graph can describe retained snapshots and comparison-only values.
// Only snapshot roots request migration helpers or the transaction interface.
pub EmitValuesLibrary :: (target: abi.Target, name: string, names: string[], ids: i64[], functions: Function[],
                          parameters: int[], slots: int[], locals: int[], code: Instruction[], arguments: int[],
                          records: Record[], fields: int[], field_tags: i64[], texts: string[], step_budget: int,
                          field_names: string[], entries: int, state_characters: bool[], shapes: SnapshotShapes,
                          family: bool, snapshots: bool) -> Result {
    return LibraryStates(target, name, names, ids, functions, parameters, slots, locals, code, arguments,
        records, fields, field_tags, texts, step_budget, field_names, entries, state_characters, family, snapshots, shapes);
}

LibraryStates :: (target: abi.Target, name: string, names: string[], ids: i64[], functions: Function[],
                          parameters: int[], slots: int[], locals: int[], code: Instruction[], arguments: int[],
                          records: Record[], fields: int[], field_tags: i64[], texts: string[], step_budget: int, field_names: string[], entries: int,
                          state_characters: bool[], family: bool, snapshots: bool, shapes: SnapshotShapes) -> Result {
    windows := abi.Same(target, abi.WindowsX64());
    if (!abi.Same(target, abi.LinuxX64()) && !abi.Same(target, abi.MacOSArm64()) && !windows) {
        return Result.Rejected(-1, "native libraries require Linux x86-64, macOS arm64 or Windows x86-64");
    }
    if (!Identifier(name) || length(names) != length(functions) || length(ids) != length(functions)) {
        return Result.Rejected(-1, "native library needs an identifier and a name and ID for each function");
    }
    states := RetainedStates(code);
    if (snapshots) {
        error := SnapshotShapesValid(records, fields, field_names, states, shapes);
        if (error != "") { return Result.Rejected(-1, error); }
    }
    if (length(state_characters) != 0 && length(state_characters) != length(states)) {
        return Result.Rejected(-1, "native character state metadata differs from retained state");
    }
    for (character, index in state_characters) {
        // Full shapes own nominal identity. A supplied legacy vector must
        // agree rather than silently overriding or losing that identity.
        if (snapshots && shapes.roots[index] >= 0) {
            root := shapes.nodes[shapes.roots[index]];
            nominal := root.kind == SnapshotScalar && root.extra == RetainedCharTag;
            if (character != nominal) {
                return Result.Rejected(-1, "native character state metadata differs from snapshot shape");
            }
        }
        if (character && states[index].type != abi.IntStorage) {
            return Result.Rejected(-1, "native character state requires int storage");
        }
        if (character && states[index].left == 0 &&
            (states[index].literal < 0 || states[index].literal > 1114111 ||
             (states[index].literal >= 55296 && states[index].literal <= 57343))) {
            return Result.Rejected(-1, "native character state initial value is not a Unicode scalar");
        }
    }
    // Package generations distinguish real entries from their fixed-ABI stubs:
    // bit 0 is Main, bit 1 is Frame; -1 derives runnable ordinary library entries.
    if (entries < -1 || entries > 3) {
        return Result.Rejected(-1, "native generation entry mask is out of bounds");
    }
    if (entries >= 0 && (!names.contains("Main") || !names.contains("Frame"))) {
        return Result.Rejected(-1, "native generation needs both host entry adapters");
    }
    if (entries >= 0) {
        for (index in 0..<length(names)) {
            if ((names[index] == "Main" || names[index] == "Frame") &&
                (functions[index].result != abi.IntStorage || functions[index].parameters != 0)) {
                return Result.Rejected(-1, "native generation entry adapters require zero arguments and int results");
            }
        }
    }
    for (index in 0..<length(names)) {
        for (other in 0..<index) {
            if (names[other] == names[index] || ids[other] == ids[index]) {
                return Result.Rejected(-1, "native library names each function once");
            }
        }
    }
    module := "";
    // A library has no line tables yet.
    source: Source = {file: "", directory: ""};
    no_positions: int[] = [];
    switch ModuleValues(target, functions, parameters, slots, locals, code, arguments, records, fields, field_tags, texts, source,
                  names, no_positions, no_positions, NoEntry, step_budget, family, snapshots, false, shapes, field_names) {
        case .Rejected(instruction, message):
            return Result.Rejected(instruction, message);
        case .Emitted(text):
            module = text;
    }
    runtime := Runtime(code) || snapshots;
    retained_text := false;
    for (item in RetainedStates(code)) {
        retained_text = retained_text || item.type == abi.TextStorage;
    }
    runtime = runtime || retained_text;
    // The manifests are joined apart, so the module's text is copied once.
    out: string[] = ["\n%chibi.export = type { ptr, i64, ptr, i32, i32, ptr }\n%chibi.manifest = type { i32, i32, ptr }\n"];
    exports: string[] = [];
    waiting := WaitingFunctions(functions, code);
    dll_exports: string[] = [];
    host_entries := entries;
    if (entries < 0) { host_entries = 0; }
    if (entries >= 0) {
        for (index in 0..<length(names)) {
            if ((names[index] == "Main" || names[index] == "Frame") && waiting[index]) {
                return Result.Rejected(-1, "native generation entry adapters cannot wait");
            }
        }
    }
    if (windows) {
        dll_exports.extend([format_text("chibi_natives_{},data", name), "chibi_host_retained_release", "chibi_host_retained_count",
                       "chibi_host_retained_type", "chibi_host_retained_hash", "chibi_host_retained_schema", "chibi_host_retained_ready", "chibi_host_retained_get",
                       "chibi_host_retained_set", "chibi_host_retained_set_as"]);
        if (runtime) { dll_exports.append("chibi_host_failed"); }
        if (waiting.contains(true)) {
            dll_exports.extend(["chibi_host_tasks_pending", "chibi_host_tasks_poll", "chibi_host_tasks_cancel_all"]);
        }
    }
    for (function in 0..<length(functions)) {
        if (waiting[function]) { continue; }
        if (entries < 0 && functions[function].parameters == 0 && functions[function].result == abi.IntStorage) {
            if (names[function] == "Main") { host_entries |= 1; }
            if (names[function] == "Frame") { host_entries |= 2; }
        }
        if (windows && HostCallable(functions[function], parameters)) {
            dll_exports.append(strings.Concatenate(["chibi_host_call_", names[function]]));
        }
        types := ExportTypes(functions[function], parameters);
        if (length(types) == 0) {
            continue;
        }
        out.append(format_text("@chibi_scalar.export.name.{} = private unnamed_addr constant [{} x i8] c\"{}\\00\"\n",
                               function, strings.ByteLength(names[function]) + 1, Escaped(names[function])));
        listed: string[] = [];
        for (type in types) {
            listed.append(format_text("i8 {}", type));
        }
        out.append(format_text("@chibi_scalar.export.types.{} = private unnamed_addr constant [{} x i8] [{}]\n",
                               function, length(types), strings.Join(listed, ", ")));
        out.append("\n");
        out.append(ExportEntry(functions, function, parameters, runtime));
        exports.append(format_text("%chibi.export { ptr @chibi_scalar.export.name.{}, i64 {}, ptr @chibi_scalar.export.types.{}, i32 {}, i32 1, ptr @chibi_scalar.export.{} }",
                                   function, ids[function], function, functions[function].parameters, function));
    }
    out.append(format_text("\ndefine i32 @chibi_host_entries() #0 {{\nentry:\n  ret i32 {}\n}}\n", host_entries));
    if (windows) { dll_exports.append("chibi_host_entries"); }
    out.append(format_text("\n@chibi_scalar.exports = private constant [{} x %chibi.export] [{}]\n",
                           length(exports), strings.Join(exports, ", ")));
    out.append(format_text("@chibi_natives_{} = constant %chibi.manifest { i32 {}, i32 {}, ptr @chibi_scalar.exports }\n",
                           name, abi.ExportAbi, length(exports)));
    state_manifest := StateManifest(name, names, ids, functions, parameters, records, fields, field_names, runtime);
    out.append(state_manifest);
    if (windows && state_manifest != "") { dll_exports.append(format_text("chibi_state_{},data", name)); }
    if (retained_text) {
        out.append(RetainedTextCopy(family));
    }
    retained_manifest := "";
    if (!snapshots) { retained_manifest = RetainedManifest(name, code, texts, state_characters); }
    out.append(retained_manifest);
    if (windows && retained_manifest != "") { dll_exports.append(format_text("chibi_retained_{},data", name)); }
    if (runtime && !strings.Contains(module, "@chibi_context = external global")) {
        context_type := abi.ContextType();
        if (family) { context_type = abi.ClockContextType(); }
        out.append(format_text("\n@chibi_context = external global {}\n", context_type));
    }
    if (family) {
        if (HasClockSample(code)) {
            out.append(ClockBindingSymbols());
            if (windows) { dll_exports.append("chibi_host_set_clock"); }
        }
        managed := strings.Contains(module, "; chibi-managed\n");
        out.append(ManagedFamilySymbols(runtime, managed));
        if (windows) {
            dll_exports.extend(["chibi_host_family_abi", "chibi_host_family_size", "chibi_host_set_family",
                                "chibi_host_cells_pending", "chibi_host_family_collect"]);
        }
    }
    layout := ValueLayouts(records, fields);
    out.append(HostSymbols(names, functions, parameters, code, texts, runtime, waiting, state_characters, shapes.roots, layout));
    if (snapshots) {
        out.append(strings.Concatenate([SnapshotMemoRuntime(family), SnapshotQueueRuntime(family), SnapshotSchemaRuntime(),
            SnapshotValuesModule(records, fields, shapes, states, family), SnapshotTransactionRuntime(family), SnapshotTables(shapes)]));
        out.append(SnapshotViews(shapes.roots));
        out.append(SnapshotHost(states, shapes, state_characters, layout));
        if (windows) {
            dll_exports.extend(["chibi_host_retained_begin", "chibi_host_retained_accept", "chibi_host_retained_stage", "chibi_host_retained_finish"]);
        }
    }
    if (windows) { out.append(WindowsLibraryExports(dll_exports)); }
    return Result.Emitted(format_text("{}{}", module, strings.Join(out, "")));
}

// Native maps, docs/native-maps.md. The header holds live count, physical span,
// entry capacity, index slot count, entries and index. Each insertion-ordered
// entry is {key, value, hash}, hash 0 marks a dead entry. Robin Hood slots hold
// {hash, entry + 1}; they keep a dead entry's hash until a compaction rebuilds
// the index, so lookup stopping distances stay valid. Each mutation consumes
// the map it reads. A string key/value passed to MapSet is one owned reference.

// The most entries a map keeps without an index: a scan of that many keys beats
// a hash.
MapScanned: int : 8;
// Doubling beyond this bound would overflow an i32 slot count.
MapLimit: int : 1073741824;

// The key and value types of map type `type`.
MapKey :: (type: int) -> int {
    return (type - MapType) % 16;
}
MapValue :: (type: int) -> int {
    return (type - MapType) / 16;
}
// The type of the map from `key` to `value`.
pub MapOf :: (key: int, value: int) -> int {
    return MapType + value * 16 + key;
}
// Whether a map may be keyed by `key`: a bool, an integer or a string. A float
// is not, as NaN equals nothing.
MapKeyed :: (key: int) -> bool {
    return key == abi.BoolStorage || Integer(key) || key == abi.TextStorage;
}
// Array payloads share the same descriptor and element lifecycle as locals.
MapArrayValue :: (type: int) -> bool {
    return type >= ArrayType && type < MapType;
}
MapPayloadOwned :: (type: int, owners: bool[]) -> bool {
    return MapArrayValue(type) || ValueOwned(type, owners);
}
MapShaped :: (records: Record[], type: int) -> bool {
    if (type < MapType || type >= RefType) {
        return false;
    }
    value := MapValue(type);
    return MapKeyed(MapKey(type)) && (abi.ScalarType(value) != "" || value == abi.TextStorage ||
                                    (MapArrayValue(value) && ElementType(records, value) != 0) ||
                                    (value >= RecordType && value < ArrayType && value - RecordType < length(records)));
}
// Map instructions share dependency discovery and validation even when an
// opcode occupies a later reserved slot.
MapOperation :: (op: int) -> bool {
    return (op >= MapLength && op <= MapLiveAt) || op == MapValueAddress;
}
// The map type an instruction works on: a change gives it as its type, and a
// read has it in its literal.
MapUsed :: (item: Instruction) -> int {
    if (item.op == MapSet || item.op == MapDelete || item.op == MapCopy || item.op == MapDrop) {
        return item.type;
    }
    return int(item.literal);
}
// Both dedicated map operations and generic value ownership name the same
// typed helper dependency. Only the latter carries it directly in type.
MapInstructionType :: (item: Instruction) -> int {
    if (MapOperation(item.op)) { return MapUsed(item); }
    if ((item.op == ValueCopy || item.op == ValueDrop) && item.type >= MapType && item.type < RefType) { return item.type; }
    return 0;
}
// Whether an instruction names the context: it allocates, gives back, or ends
// the program on an index outside the map.
MapCalls :: (item: Instruction) -> bool {
    op := item.op;
    return op == MapSet || op == MapDelete || op == MapCopy || op == MapDrop || op == MapKeyAt || op == MapValueAt ||
           (op == MapValueAddress && item.target == 1);
}
MapPayloadValid :: (records: Record[], lifecycle: ValueLayout, type: int) -> bool {
    if (!MapShaped(records, type)) { return false; }
    element := MapValue(type);
    if (MapArrayValue(element)) { element -= ArrayType; }
    return ValueValid(lifecycle, element);
}
// The first field of a physical collection carrier is the immediate map.
// Other record payloads do not need canonical descriptor-address helpers.
MapCarrierElement :: (records: Record[], fields: int[], type: int) -> int {
    if (type < RecordType || type >= ArrayType || !Index(type - RecordType, length(records))) { return 0; }
    record := records[type - RecordType];
    if (record.count != 1) { return 0; }
    member := fields[record.first];
    if (!MapShaped(records, member)) { return 0; }
    return member;
}
// Whether a map instruction reads the operands of its type: the map in the left
// slot, a key or an index in the right, and MapSet's value in slot `target`.
MapValid :: (records: Record[], fields: int[], lifecycle: ValueLayout, slots: int[], item: Instruction) -> bool {
    used := MapUsed(item);
    input := used;
    if (item.op == MapValueAddress && item.target == 1) { input += RefType; }
    if (!MapPayloadValid(records, lifecycle, used) || !Typed(slots, item.left, input)) {
        return false;
    }
    key := MapKey(used);
    value := MapValue(used);
    if (item.op == MapLength || item.op == MapSpan) {
        return item.type == abi.IntStorage;
    }
    if (item.op == MapGet) {
        return item.type == value && Typed(slots, item.right, key) &&
               (item.target == 0 || (item.target == MapGetZero && value >= RecordType && value < ArrayType));
    }
    if (item.op == MapValueAddress) {
        projected := value;
        if (item.target == 1 && value >= RecordType && value < ArrayType) {
            projected = MapCarrierElement(records, fields, value);
            if (projected == 0) { return false; }
        } else if (!MapArrayValue(value)) { return false; }
        return item.type == RefType + projected && Typed(slots, item.right, key) &&
               (item.target == 0 || item.target == 1);
    }
    if (item.op == MapHas) {
        return item.type == abi.BoolStorage && Typed(slots, item.right, key);
    }
    if (item.op == MapSet) {
        return (item.literal == 0 || item.literal == 1) && Typed(slots, item.right, key) && Typed(slots, item.target, value);
    }
    if (item.op == MapDelete) {
        return (item.literal == 0 || item.literal == 1) && Typed(slots, item.right, key);
    }
    if (item.op == MapLiveAt) {
        return item.type == abi.BoolStorage && Typed(slots, item.right, abi.IntStorage);
    }
    if (item.op == MapKeyAt) {
        return item.type == key && Typed(slots, item.right, abi.IntStorage);
    }
    if (item.op == MapValueAt) {
        return item.type == value && Typed(slots, item.right, abi.IntStorage);
    }
    return true;
}
// Whether a map of `type` holds strings, which each hold a reference.
MapHolds :: (type: int) -> bool {
    return MapKey(type) == abi.TextStorage || MapValue(type) == abi.TextStorage;
}

// The instruction in `item` as LLVM text: the map is loaded as %m<pc>, and its
// helpers are the ones of its type, below.
MapRead :: (item: Instruction, pc: int) -> string {
    used := MapUsed(item);
    map := abi.MapType();
    key := MapKey(used);
    value := MapValue(used);
    owns := "false";
    if (item.literal == 1 && (item.op == MapSet || item.op == MapDelete)) {
        owns = "true";
    }
    out := Load(format_text("m{}", pc), used, "s", item.left);
    if (item.op == MapValueAddress && item.target == 1) {
        out = Load(format_text("owner{}", pc), RefType + used, "s", item.left);
        out = format_text("{}{}", out, Load(format_text("k{}", pc), key, "s", item.right));
        // A one-map-field carrier begins with that descriptor at offset zero.
        // Validation admits this projection only for canonical target 1.
        out = format_text("{}  %v{} = call ptr @chibi_map.{}.reference(ptr %ctx, ptr %owner{}, {} %k{})\n", out, pc, used, pc, TypeName(key), pc);
        return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    }
    if (item.op == MapLength || item.op == MapSpan) {
        field := 0;
        if (item.op == MapSpan) {
            field = 1;
        }
        out = format_text("{}  %v{} = extractvalue {} %m{}, {}\n", out, pc, map, pc, field);
    } else if (item.op == MapGet || item.op == MapHas || item.op == MapValueAddress) {
        out = format_text("{}{}", out, Load(format_text("k{}", pc), key, "s", item.right));
        fallback := "";
        if (item.op == MapValueAddress) { fallback = ", i1 true"; }
        else if (item.op == MapGet && value >= RecordType && value < ArrayType) {
            fallback = ", i1 false";
            if (item.target == MapGetZero) { fallback = ", i1 true"; }
        }
        out = format_text("{}  %v{} = call {} @chibi_map.{}.{}({} %m{}, {} %k{}{})\n", out, pc, TypeName(item.type), used,
                          MapHelper(item.op), map, pc, TypeName(key), pc, fallback);
    } else if (item.op == MapSet) {
        out = format_text("{}{}", out, Load(format_text("k{}", pc), key, "s", item.right));
        out = format_text("{}{}", out, Load(format_text("c{}", pc), value, "s", item.target));
        out = format_text("{}  %v{} = call {} @chibi_map.{}.set(ptr %ctx, {} %m{}, {} %k{}, {} %c{}, i1 {})\n", out, pc, map,
                          used, map, pc, TypeName(key), pc, TypeName(value), pc, owns);
    } else if (item.op == MapDelete) {
        out = format_text("{}{}", out, Load(format_text("k{}", pc), key, "s", item.right));
        out = format_text("{}  %v{} = call {} @chibi_map.{}.delete(ptr %ctx, {} %m{}, {} %k{}, i1 {})\n", out, pc, map,
                          used, map, pc, TypeName(key), pc, owns);
    } else if (item.op == MapCopy) {
        out = format_text("{}  %v{} = call {} @chibi_map.{}.copy(ptr %ctx, {} %m{})\n", out, pc, map, used, map, pc);
    } else if (item.op == MapDrop) {
        return format_text("{}  call void @chibi_map.{}.drop(ptr %ctx, {} %m{})\n", out, used, map, pc);
    } else {
        // An entry by position, for a loop over the map's insertion order.
        pair := format_text("{ {}, {}, i32 }", TypeName(key), TypeName(value));
        field := 0;
        if (item.op == MapValueAt) {
            field = 1;
        }
        out = format_text("{}{}", out, Load(format_text("b{}", pc), abi.IntStorage, "s", item.right));
        out = format_text("{}  %length{} = extractvalue {} %m{}, 1\n  %in{} = icmp ult i32 %b{}, %length{}\n", out, pc, map,
                          pc, pc, pc, pc);
        if (item.op == MapLiveAt) {
            out = format_text("{}  br i1 %in{}, label %inside{}, label %after{}\ninside{}:\n", out, pc, pc, pc, pc);
        } else {
            out = format_text("{}  br i1 %in{}, label %inside{}, label %outside{}\noutside{}:\n", out, pc, pc, pc, pc);
            out = format_text("{}{}", out, ContextCall(format_text("index{}", pc), 3));
            out = format_text("{}  call void %index{}(ptr %ctx, i32 %b{}, i32 %length{})\n  unreachable\ninside{}:\n", out, pc,
                              pc, pc, pc);
        }
        out = format_text("{}  %data{} = extractvalue {} %m{}, 4\n  %offset{} = zext i32 %b{} to i64\n", out, pc, map, pc,
                          pc, pc);
        out = format_text("{}  %hash.at{} = getelementptr inbounds {}, ptr %data{}, i64 %offset{}, i32 2\n", out, pc, pair, pc, pc);
        out = format_text("{}  %hash{} = load i32, ptr %hash.at{}\n  %live{} = icmp ne i32 %hash{}, 0\n", out, pc, pc, pc, pc);
        if (item.op == MapLiveAt) {
            out = format_text("{}  br label %after{}\nafter{}:\n  %v{} = phi i1 [ false, %p{} ], [ %live{}, %inside{} ]\n", out, pc, pc, pc, pc, pc, pc);
        } else {
            out = format_text("{}  br i1 %live{}, label %live.entry{}, label %outside{}\nlive.entry{}:\n", out, pc, pc, pc, pc);
            out = format_text("{}  %at{} = getelementptr inbounds {}, ptr %data{}, i64 %offset{}, i32 {}\n", out, pc, pair,
                              pc, pc, field);
            out = format_text("{}  %v{} = load {}, ptr %at{}\n", out, pc, TypeName(item.type), pc);
        }
    }
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}
// The name of the helper a read instruction calls.
MapHelper :: (op: int) -> string {
    if (op == MapValueAddress) { return "address"; }
    if (op == MapGet) {
        return "get";
    }
    return "has";
}

// A copied payload acquires its owned leaves before another map can drop
// them. `tag` makes the returned copied value unique within the helper.
MapOwner :: (call: string, value: string, tag: string, type: int, pending: bool = false) -> string {
    if (type != abi.TextStorage) {
        module := "chibi_value";
        if (MapArrayValue(type)) { module = "chibi_array"; }
        if (call == "retain") {
            return format_text("  %c.{} = call {} @{}.{}.copy(ptr %ctx, {} {})\n", tag,
                               TypeName(type), module, type, TypeName(type), value);
        }
        if (pending) {
            return format_text("  call void @{}.{}.drop_into(ptr %ctx, {} {}, ptr %pending)\n", module, type, TypeName(type), value);
        }
        return format_text("  call void @{}.{}.drop(ptr %ctx, {} {})\n", module, type, TypeName(type), value);
    }
    text := abi.TextType();
    out := format_text("  %o.{} = extractvalue {} {}, 2\n", tag, text, value);
    if (call == "retain") {
        return format_text("{}  call void @chibi_scalar.retain(ptr %o.{})\n", out, tag);
    }
    return format_text("{}  call void @chibi_scalar.free(ptr %ctx, ptr %o.{})\n", out, tag);
}
// The reference changes for the live entry just copied or being dropped.
// Copy's `ymove` block ends in `yretained`, which its loop's phi names.
MapEach :: (call: string, entries: string, prefix: string, key: int, value: int, owners: bool[], backed: bool[], pending: bool) -> string {
    offset := "%xoff";
    if (call == "retain") {
        offset = "%woff";
    }
    out := "";
    if (key == abi.TextStorage) {
        out = format_text("  %{}k = getelementptr inbounds $E, ptr {}, i64 {}, i32 0\n", prefix, entries, offset);
        out = format_text("{}  %{}kv = load $K, ptr %{}k\n{}", out, prefix, prefix,
                          MapOwner(call, format_text("%{}kv", prefix), format_text("{}k", prefix), key));
    }
    if (MapPayloadOwned(value, owners)) {
        out = format_text("{}  %{}v = getelementptr inbounds $E, ptr {}, i64 {}, i32 1\n", out, prefix, entries, offset);
        queued := false;
        if (pending && length(backed) > 0) {
            if (MapArrayValue(value)) { queued = ArrayBacked(value, backed); }
            else if (value >= RecordType && value < ArrayType) { queued = backed[value - RecordType]; }
        }
        if (queued && value >= RecordType && value < ArrayType) {
            // Record drop_into borrows its in-place fields; unlike an array
            // descriptor it takes an address, not a copied record argument.
            out = format_text("{}  call void @chibi_value.{}.drop_into(ptr %ctx, ptr %{}v, ptr %pending)\n", out, value, prefix);
        } else {
            out = format_text("{}  %{}vv = load $V, ptr %{}v\n{}", out, prefix, prefix,
                              MapOwner(call, format_text("%{}vv", prefix), format_text("{}v", prefix), value, queued));
        }
        if (value != abi.TextStorage && call == "retain") {
            out = format_text("{}  store $V %c.{}v, ptr %{}v\n", out, prefix, prefix);
        }
    }
    if (call == "retain") {
        out = format_text("{}  br label %yretained\nyretained:\n", out);
    }
    return out;
}

// The helpers every map type shares: the context's allocation, a hash, the
// index's Robin Hood placement and its rebuild.
MapShared :: (guarded: bool = false) -> string {
    allocate := "  %at = getelementptr inbounds { ptr, ptr, ptr, ptr, ptr }, ptr %ctx, i32 0, i32 2\n  %make = load ptr, ptr %at";
    release := "  %at = getelementptr inbounds { ptr, ptr, ptr, ptr, ptr }, ptr %ctx, i32 0, i32 4\n  %release = load ptr, ptr %at";
    if (guarded) {
        allocate = ContextCall("make", 2, true);
        release = ContextCall("release", 4, true);
    }
    text := strings.Join([
        "define internal ptr @chibi_map.allocate(ptr %ctx, i64 %bytes) {",
        "entry:",
        allocate,
        "  %fresh = call ptr %make(ptr %ctx, i64 %bytes)",
        "  ret ptr %fresh",
        "}",
        "define internal void @chibi_map.give(ptr %ctx, ptr %memory) {",
        "entry:",
        "  %held = icmp ne ptr %memory, null",
        "  br i1 %held, label %give, label %done",
        "give:",
        release,
        "  call void %release(ptr %ctx, ptr %memory)",
        "  br label %done",
        "done:",
        "  ret void",
        "}",
        "define internal i32 @chibi_map.mix(i64 %wide) {",
        "entry:",
        "  %a = lshr i64 %wide, 30",
        "  %b = xor i64 %wide, %a",
        "  %c = mul i64 %b, -4658895280553007687",
        "  %d = lshr i64 %c, 27",
        "  %e = xor i64 %c, %d",
        "  %f = mul i64 %e, -7723592293110705685",
        "  %g = lshr i64 %f, 31",
        "  %h = xor i64 %f, %g",
        "  %hash = trunc i64 %h to i32",
        "  ret i32 %hash",
        "}",
        "define internal i64 @chibi_map.text_hash({ ptr, i32, ptr } %text) {",
        "entry:",
        "  %bytes = extractvalue { ptr, i32, ptr } %text, 0",
        "  %length = extractvalue { ptr, i32, ptr } %text, 1",
        "  br label %head",
        "head:",
        "  %at = phi i32 [ 0, %entry ], [ %next, %body ]",
        "  %hash = phi i64 [ -3750763034362895579, %entry ], [ %mixed, %body ]",
        "  %end = icmp eq i32 %at, %length",
        "  br i1 %end, label %done, label %body",
        "body:",
        "  %offset = zext i32 %at to i64",
        "  %place = getelementptr inbounds i8, ptr %bytes, i64 %offset",
        "  %byte = load i8, ptr %place",
        "  %wide = zext i8 %byte to i64",
        "  %folded = xor i64 %hash, %wide",
        "  %mixed = mul i64 %folded, 1099511628211",
        "  %next = add i32 %at, 1",
        "  br label %head",
        "done:",
        "  ret i64 %hash",
        "}",
        "define internal void @chibi_map.place(ptr %index, i32 %slots, i32 %hash, i32 %entry1) {",
        "entry:",
        "  %mask = sub i32 %slots, 1",
        "  %start = and i32 %hash, %mask",
        "  br label %walk",
        "walk:",
        "  %pos = phi i32 [ %start, %entry ], [ %pnext, %cont ]",
        "  %dist = phi i32 [ 0, %entry ], [ %dnext, %cont ]",
        "  %h = phi i32 [ %hash, %entry ], [ %hn, %cont ]",
        "  %e = phi i32 [ %entry1, %entry ], [ %en, %cont ]",
        "  %poff = zext i32 %pos to i64",
        "  %sp = getelementptr inbounds { i32, i32 }, ptr %index, i64 %poff",
        "  %sea = getelementptr inbounds { i32, i32 }, ptr %sp, i32 0, i32 1",
        "  %sh = load i32, ptr %sp",
        "  %se = load i32, ptr %sea",
        "  %empty = icmp eq i32 %se, 0",
        "  br i1 %empty, label %put, label %resident",
        "put:",
        "  store i32 %h, ptr %sp",
        "  store i32 %e, ptr %sea",
        "  ret void",
        "resident:",
        "  %home = and i32 %sh, %mask",
        "  %gap = sub i32 %pos, %home",
        "  %rdist = and i32 %gap, %mask",
        "  %closer = icmp ult i32 %rdist, %dist",
        "  br i1 %closer, label %swap, label %cont",
        "swap:",
        "  store i32 %h, ptr %sp",
        "  store i32 %e, ptr %sea",
        "  br label %cont",
        "cont:",
        "  %hn = phi i32 [ %h, %resident ], [ %sh, %swap ]",
        "  %en = phi i32 [ %e, %resident ], [ %se, %swap ]",
        "  %dc = phi i32 [ %dist, %resident ], [ %rdist, %swap ]",
        "  %pn = add i32 %pos, 1",
        "  %pnext = and i32 %pn, %mask",
        "  %dnext = add i32 %dc, 1",
        "  br label %walk",
        "}",
        "define internal i32 @chibi_map.slots(i32 %capacity) {",
        "entry:",
        "  %cap = zext i32 %capacity to i64",
        "  %want = shl i64 %cap, 2",
        "  br label %head",
        "head:",
        "  %s = phi i64 [ 1, %entry ], [ %double, %body ]",
        "  %have = mul i64 %s, 3",
        "  %enough = icmp uge i64 %have, %want",
        "  br i1 %enough, label %done, label %body",
        "body:",
        "  %double = shl i64 %s, 1",
        "  br label %head",
        "done:",
        "  %slots = trunc i64 %s to i32",
        "  ret i32 %slots",
        "}",
        "define internal i32 @chibi_map.capacity(i32 %count) {",
        "entry:",
        "  %double = shl i32 %count, 1",
        "  %tiny = icmp ult i32 %double, 4",
        "  %wanted = select i1 %tiny, i32 4, i32 %double",
        "  %over = icmp ugt i32 %wanted, $LIMIT",
        "  %capacity = select i1 %over, i32 $LIMIT, i32 %wanted",
        "  ret i32 %capacity",
        "}"
    ], "\n");
    return strings.ReplaceAll(text, "$LIMIT", format_text("{}", MapLimit));
}

// The helpers of map type `type`, named `@chibi_map.<type>.<helper>`: hash,
// same, find, get, has, set, delete, copy and drop.
MapHelpers :: (type: int, native_program: bool, owners: bool[], backed: bool[], carrier: bool) -> string {
    key := MapKey(type);
    value := MapValue(type);
    keyed := key == abi.TextStorage;
    valued := MapPayloadOwned(value, owners);
    prehash := "  %wide = zext $K %key to i64";
    same := "  %same = icmp eq $K %a, %b";
    missing := "  ret $V zeroinitializer";
    fallback := "";
    if (value >= RecordType && value < ArrayType) {
        missing = "  call void @llvm.trap()\n  unreachable";
        if (native_program) { missing = "  call void @chibi_native_failure(i32 2)\n  unreachable"; }
        fallback = ", i1 %zero_default";
        missing = format_text("  br i1 %zero_default, label %zero, label %absent\nzero:\n  ret $V zeroinitializer\nabsent:\n{}", missing);
    }
    if (keyed) {
        prehash = "  %wide = call i64 @chibi_map.text_hash($K %key)";
        same = "  %same = call i1 @chibi_scalar.text_equal($K %a, $K %b)";
    } else if (abi.IntegerBits(key) == 64) {
        prehash = "  %wide = add i64 %key, 0";
    }
    // What replacing a value, or deleting an entry, gives back.
    replaced: string[] = [];
    deleted: string[] = [];
    if (valued) {
        replaced.append(format_text("  %old = load $V, ptr %rv\n{}", MapOwner("release", "%old", "rv", value)));
        deleted.append(format_text("  %dv = getelementptr inbounds $E, ptr %hole, i32 0, i32 1\n  %dvv = load $V, ptr %dv\n{}",
                                   MapOwner("release", "%dvv", "dv", value)));
    }
    if (keyed) {
        replaced.append(MapOwner("release", "%key", "rk", key));
        deleted.append(format_text("  %dk = getelementptr inbounds $E, ptr %hole, i32 0, i32 0\n  %dkv = load $K, ptr %dk\n{}",
                                   MapOwner("release", "%dkv", "dk", key)));
    }
    address := "";
    if (MapArrayValue(value) || carrier) {
        unavailable := "  call void @llvm.trap()\n  unreachable";
        if (native_program) { unavailable = "  call void @chibi_native_failure(i32 0)\n  unreachable"; }
        address = strings.Join([
            "define internal ptr @chibi_map.$N.address($M %m, $K %wanted, i1 %required) {",
            "entry:",
            "  %used = extractvalue $M %m, 1",
            "  %slots = extractvalue $M %m, 3",
            "  %entries = extractvalue $M %m, 4",
            "  %index = extractvalue $M %m, 5",
            "  %hash = call i32 @chibi_map.$N.hash($K %wanted)",
            "  %at = call i32 @chibi_map.$N.find(ptr %entries, ptr %index, i32 %used, i32 %slots, $K %wanted, i32 %hash)",
            "  %present = icmp sge i32 %at, 0",
            "  br i1 %present, label %hit, label %miss",
            "hit:",
            "  %off = zext i32 %at to i64",
            "  %ve = getelementptr inbounds $E, ptr %entries, i64 %off, i32 1",
            "  ret ptr %ve",
            "miss:", "  br i1 %required, label %failure, label %absent",
            "absent:", "  ret ptr null", "failure:", unavailable, "}"
        ], "\n");
    }
    text := strings.Join([
        "$ADDRESS",
        "define internal i32 @chibi_map.$N.hash($K %key) {",
        "entry:",
        "$PREHASH",
        "  %raw = call i32 @chibi_map.mix(i64 %wide)",
        "  %zero = icmp eq i32 %raw, 0",
        "  %hash = select i1 %zero, i32 1, i32 %raw",
        "  ret i32 %hash",
        "}",
        "define internal i1 @chibi_map.$N.same($K %a, $K %b) {",
        "entry:",
        "$SAME",
        "  ret i1 %same",
        "}",
        "define internal i32 @chibi_map.$N.find(ptr %entries, ptr %index, i32 %used, i32 %slots, $K %wanted, i32 %hash) {",
        "entry:",
        "  %indexed = icmp ne ptr %index, null",
        "  br i1 %indexed, label %probe, label %scan",
        "scan:",
        "  %at = phi i32 [ 0, %entry ], [ %next, %step ]",
        "  %end = icmp eq i32 %at, %used",
        "  br i1 %end, label %absent, label %look",
        "look:",
        "  %off = zext i32 %at to i64",
        "  %he = getelementptr inbounds $E, ptr %entries, i64 %off, i32 2",
        "  %eh = load i32, ptr %he",
        "  %alike = icmp eq i32 %eh, %hash",
        "  br i1 %alike, label %test, label %step",
        "test:",
        "  %ke = getelementptr inbounds $E, ptr %entries, i64 %off, i32 0",
        "  %k = load $K, ptr %ke",
        "  %eq = call i1 @chibi_map.$N.same($K %k, $K %wanted)",
        "  br i1 %eq, label %found, label %step",
        "step:",
        "  %next = add i32 %at, 1",
        "  br label %scan",
        "found:",
        "  ret i32 %at",
        "absent:",
        "  ret i32 -1",
        "probe:",
        "  %mask = sub i32 %slots, 1",
        "  %start = and i32 %hash, %mask",
        "  br label %walk",
        "walk:",
        "  %pos = phi i32 [ %start, %probe ], [ %pnext, %skip ]",
        "  %dist = phi i32 [ 0, %probe ], [ %dnext, %skip ]",
        "  %poff = zext i32 %pos to i64",
        "  %sp = getelementptr inbounds { i32, i32 }, ptr %index, i64 %poff",
        "  %sea = getelementptr inbounds { i32, i32 }, ptr %sp, i32 0, i32 1",
        "  %sh = load i32, ptr %sp",
        "  %se = load i32, ptr %sea",
        "  %empty = icmp eq i32 %se, 0",
        "  br i1 %empty, label %absent, label %resident",
        "resident:",
        "  %home = and i32 %sh, %mask",
        "  %gap = sub i32 %pos, %home",
        "  %rdist = and i32 %gap, %mask",
        "  %closer = icmp ult i32 %rdist, %dist",
        "  br i1 %closer, label %absent, label %compare",
        "compare:",
        "  %salike = icmp eq i32 %sh, %hash",
        "  br i1 %salike, label %live, label %skip",
        "live:",
        "  %idx = sub i32 %se, 1",
        "  %ioff = zext i32 %idx to i64",
        "  %lhe = getelementptr inbounds $E, ptr %entries, i64 %ioff, i32 2",
        "  %leh = load i32, ptr %lhe",
        "  %lalive = icmp eq i32 %leh, %hash",
        "  br i1 %lalive, label %test2, label %skip",
        "test2:",
        "  %tke = getelementptr inbounds $E, ptr %entries, i64 %ioff, i32 0",
        "  %tk = load $K, ptr %tke",
        "  %teq = call i1 @chibi_map.$N.same($K %tk, $K %wanted)",
        "  br i1 %teq, label %hit, label %skip",
        "hit:",
        "  ret i32 %idx",
        "skip:",
        "  %pn = add i32 %pos, 1",
        "  %pnext = and i32 %pn, %mask",
        "  %dnext = add i32 %dist, 1",
        "  br label %walk",
        "}",
        "define internal $V @chibi_map.$N.get($M %m, $K %wanted$GET_DEFAULT) {",
        "entry:",
        "  %used = extractvalue $M %m, 1",
        "  %slots = extractvalue $M %m, 3",
        "  %entries = extractvalue $M %m, 4",
        "  %index = extractvalue $M %m, 5",
        "  %hash = call i32 @chibi_map.$N.hash($K %wanted)",
        "  %at = call i32 @chibi_map.$N.find(ptr %entries, ptr %index, i32 %used, i32 %slots, $K %wanted, i32 %hash)",
        "  %present = icmp sge i32 %at, 0",
        "  br i1 %present, label %hit, label %miss",
        "hit:",
        "  %off = zext i32 %at to i64",
        "  %ve = getelementptr inbounds $E, ptr %entries, i64 %off, i32 1",
        "  %v = load $V, ptr %ve",
        "  ret $V %v",
        "miss:",
        "$MISSING",
        "}",
        "define internal i1 @chibi_map.$N.has($M %m, $K %wanted) {",
        "entry:",
        "  %used = extractvalue $M %m, 1",
        "  %slots = extractvalue $M %m, 3",
        "  %entries = extractvalue $M %m, 4",
        "  %index = extractvalue $M %m, 5",
        "  %hash = call i32 @chibi_map.$N.hash($K %wanted)",
        "  %at = call i32 @chibi_map.$N.find(ptr %entries, ptr %index, i32 %used, i32 %slots, $K %wanted, i32 %hash)",
        "  %present = icmp sge i32 %at, 0",
        "  ret i1 %present",
        "}",
        "define internal ptr @chibi_map.$N.index(ptr %ctx, ptr %entries, i32 %used, i32 %slots) {",
        "entry:",
        "  %count = zext i32 %slots to i64",
        "  %bytes = shl i64 %count, 3",
        "  %fresh = call ptr @chibi_map.allocate(ptr %ctx, i64 %bytes)",
        "  call void @chibi_scalar.zero(ptr %fresh, i64 %bytes)",
        "  br label %head",
        "head:",
        "  %i = phi i32 [ 0, %entry ], [ %next, %step ]",
        "  %end = icmp eq i32 %i, %used",
        "  br i1 %end, label %done, label %look",
        "look:",
        "  %off = zext i32 %i to i64",
        "  %he = getelementptr inbounds $E, ptr %entries, i64 %off, i32 2",
        "  %h = load i32, ptr %he",
        "  %alive = icmp ne i32 %h, 0",
        "  br i1 %alive, label %put, label %step",
        "put:",
        "  %e1 = add i32 %i, 1",
        "  call void @chibi_map.place(ptr %fresh, i32 %slots, i32 %h, i32 %e1)",
        "  br label %step",
        "step:",
        "  %next = add i32 %i, 1",
        "  br label %head",
        "done:",
        "  ret ptr %fresh",
        "}",
        "define internal $M @chibi_map.$N.set_unique(ptr %ctx, $M %m, $K %key, $V %value, i1 %owns) {",
        "entry:",
        "  %count = extractvalue $M %m, 0",
        "  %used = extractvalue $M %m, 1",
        "  %cap = extractvalue $M %m, 2",
        "  %slots = extractvalue $M %m, 3",
        "  %entries = extractvalue $M %m, 4",
        "  %index = extractvalue $M %m, 5",
        "  %hash = call i32 @chibi_map.$N.hash($K %key)",
        "  %at = call i32 @chibi_map.$N.find(ptr %entries, ptr %index, i32 %used, i32 %slots, $K %key, i32 %hash)",
        "  %present = icmp sge i32 %at, 0",
        "  br i1 %present, label %replace, label %insert",
        "replace:",
        "  %roff = zext i32 %at to i64",
        "  %rv = getelementptr inbounds $E, ptr %entries, i64 %roff, i32 1",
        "$REPLACED",
        "  store $V %value, ptr %rv",
        "  ret $M %m",
        "insert:",
        "  %atlimit = icmp uge i32 %count, $LIMIT",
        "  br i1 %atlimit, label %limit, label %available",
        "limit:",
        "  %limit.at = getelementptr inbounds { ptr, ptr, ptr, ptr, ptr }, ptr %ctx, i32 0, i32 3",
        "  %limit.fail = load ptr, ptr %limit.at",
        "  call void %limit.fail(ptr %ctx, i32 %count, i32 $LIMIT)",
        "  unreachable",
        "available:",
        "  %full = icmp eq i32 %used, %cap",
        "  br i1 %full, label %grow, label %room",
        "grow:",
        "  %newcap = call i32 @chibi_map.capacity(i32 %count)",
        "  %wat = getelementptr $E, ptr null, i32 1",
        "  %width = ptrtoint ptr %wat to i64",
        "  %fresh = call ptr @chibi_map.entries(ptr %ctx, i32 %newcap, i64 %width)",
        "  br label %ghead",
        "ghead:",
        "  %r = phi i32 [ 0, %grow ], [ %rnext, %gstep ]",
        "  %w = phi i32 [ 0, %grow ], [ %wnext, %gstep ]",
        "  %rend = icmp eq i32 %r, %used",
        "  br i1 %rend, label %grown, label %glook",
        "glook:",
        "  %roff2 = zext i32 %r to i64",
        "  %rhe = getelementptr inbounds $E, ptr %entries, i64 %roff2, i32 2",
        "  %reh = load i32, ptr %rhe",
        "  %ralive = icmp ne i32 %reh, 0",
        "  br i1 %ralive, label %gmove, label %gstep",
        "gmove:",
        "  %src = getelementptr inbounds $E, ptr %entries, i64 %roff2",
        "  %pair = load $E, ptr %src",
        "  %woff = zext i32 %w to i64",
        "  %dst = getelementptr inbounds $E, ptr %fresh, i64 %woff",
        "  store $E %pair, ptr %dst",
        "  %wmoved = add i32 %w, 1",
        "  br label %gstep",
        "gstep:",
        "  %wnext = phi i32 [ %w, %glook ], [ %wmoved, %gmove ]",
        "  %rnext = add i32 %r, 1",
        "  br label %ghead",
        "grown:",
        "  %had = icmp ne ptr %entries, null",
        "  %freeold = and i1 %had, %owns",
        "  br i1 %freeold, label %giveback, label %regrown",
        "giveback:",
        "  call void @chibi_map.entries_give(ptr %ctx, ptr %entries)",
        "  br label %regrown",
        "regrown:",
        "  %hasindex = icmp ne ptr %index, null",
        "  %freeindex = and i1 %hasindex, %owns",
        "  br i1 %freeindex, label %giveindex, label %room",
        "giveindex:",
        "  call void @chibi_map.give(ptr %ctx, ptr %index)",
        "  br label %room",
        "room:",
        "  %buffer = phi ptr [ %entries, %available ], [ %fresh, %regrown ], [ %fresh, %giveindex ]",
        "  %space = phi i32 [ %cap, %available ], [ %newcap, %regrown ], [ %newcap, %giveindex ]",
        "  %used1 = phi i32 [ %used, %available ], [ %w, %regrown ], [ %w, %giveindex ]",
        "  %slots1 = phi i32 [ %slots, %available ], [ 0, %regrown ], [ 0, %giveindex ]",
        "  %index1 = phi ptr [ %index, %available ], [ null, %regrown ], [ null, %giveindex ]",
        "  %coff = zext i32 %used1 to i64",
        "  %ek = getelementptr inbounds $E, ptr %buffer, i64 %coff, i32 0",
        "  %ev = getelementptr inbounds $E, ptr %buffer, i64 %coff, i32 1",
        "  %eh2 = getelementptr inbounds $E, ptr %buffer, i64 %coff, i32 2",
        "  store $K %key, ptr %ek",
        "  store $V %value, ptr %ev",
        "  store i32 %hash, ptr %eh2",
        "  %used2 = add i32 %used1, 1",
        "  %count2 = add i32 %count, 1",
        "  %big = icmp ugt i32 %used2, $SCANNED",
        "  br i1 %big, label %indexed, label %out",
        "indexed:",
        "  %has = icmp ne ptr %index1, null",
        "  br i1 %has, label %add, label %build",
        "add:",
        "  call void @chibi_map.place(ptr %index1, i32 %slots1, i32 %hash, i32 %used2)",
        "  br label %out",
        "build:",
        "  %slots2 = call i32 @chibi_map.slots(i32 %space)",
        "  %made = call ptr @chibi_map.$N.index(ptr %ctx, ptr %buffer, i32 %used2, i32 %slots2)",
        "  br label %out",
        "out:",
        "  %final = phi ptr [ null, %room ], [ %index1, %add ], [ %made, %build ]",
        "  %fslots = phi i32 [ 0, %room ], [ %slots1, %add ], [ %slots2, %build ]",
        "  %m1 = insertvalue $M %m, i32 %count2, 0",
        "  %m2 = insertvalue $M %m1, i32 %used2, 1",
        "  %m3 = insertvalue $M %m2, i32 %space, 2",
        "  %m4 = insertvalue $M %m3, i32 %fslots, 3",
        "  %m5 = insertvalue $M %m4, ptr %buffer, 4",
        "  %m6 = insertvalue $M %m5, ptr %final, 5",
        "  ret $M %m6",
        "}",
        "define internal $M @chibi_map.$N.delete_unique(ptr %ctx, $M %m, $K %wanted, i1 %owns) {",
        "entry:",
        "  %count = extractvalue $M %m, 0",
        "  %used = extractvalue $M %m, 1",
        "  %cap = extractvalue $M %m, 2",
        "  %slots = extractvalue $M %m, 3",
        "  %entries = extractvalue $M %m, 4",
        "  %index = extractvalue $M %m, 5",
        "  %hash = call i32 @chibi_map.$N.hash($K %wanted)",
        "  %at = call i32 @chibi_map.$N.find(ptr %entries, ptr %index, i32 %used, i32 %slots, $K %wanted, i32 %hash)",
        "  %present = icmp sge i32 %at, 0",
        "  br i1 %present, label %cut, label %kept",
        "cut:",
        "  %coff = zext i32 %at to i64",
        "  %hole = getelementptr inbounds $E, ptr %entries, i64 %coff",
        "$DELETED",
        "  %n = sub i32 %count, 1",
        "  %scanned = icmp eq ptr %index, null",
        "  br i1 %scanned, label %shift, label %mark",
        "shift:",
        "  %wat = getelementptr $E, ptr null, i32 1",
        "  %width = ptrtoint ptr %wat to i64",
        "  %after = add i32 %at, 1",
        "  %tail = sub i32 %used, %after",
        "  %noff = zext i32 %after to i64",
        "  %next = getelementptr inbounds $E, ptr %entries, i64 %noff",
        "  %tn = zext i32 %tail to i64",
        "  %tbytes = mul i64 %tn, %width",
        "  call void @chibi_scalar.copy(ptr %hole, ptr %next, i64 %tbytes)",
        "  %shorter = sub i32 %used, 1",
        "  %s1 = insertvalue $M %m, i32 %n, 0",
        "  %s2 = insertvalue $M %s1, i32 %shorter, 1",
        "  ret $M %s2",
        "mark:",
        "  %hh = getelementptr inbounds $E, ptr %hole, i32 0, i32 2",
        "  store i32 0, ptr %hh",
        "  %dead = sub i32 %used, %n",
        "  %dead2 = shl i32 %dead, 1",
        "  %crowded = icmp ugt i32 %dead2, %n",
        "  br i1 %crowded, label %compact, label %marked",
        "marked:",
        "  %k1 = insertvalue $M %m, i32 %n, 0",
        "  ret $M %k1",
        "compact:",
        "  br label %chead",
        "chead:",
        "  %r = phi i32 [ 0, %compact ], [ %rnext, %cstep ]",
        "  %w = phi i32 [ 0, %compact ], [ %wnext, %cstep ]",
        "  %rend = icmp eq i32 %r, %used",
        "  br i1 %rend, label %packed, label %clook",
        "clook:",
        "  %roff = zext i32 %r to i64",
        "  %rhe = getelementptr inbounds $E, ptr %entries, i64 %roff, i32 2",
        "  %reh = load i32, ptr %rhe",
        "  %ralive = icmp ne i32 %reh, 0",
        "  br i1 %ralive, label %cmove, label %cstep",
        "cmove:",
        "  %src = getelementptr inbounds $E, ptr %entries, i64 %roff",
        "  %pair = load $E, ptr %src",
        "  %woff = zext i32 %w to i64",
        "  %dst = getelementptr inbounds $E, ptr %entries, i64 %woff",
        "  store $E %pair, ptr %dst",
        "  %wmoved = add i32 %w, 1",
        "  br label %cstep",
        "cstep:",
        "  %wnext = phi i32 [ %w, %clook ], [ %wmoved, %cmove ]",
        "  %rnext = add i32 %r, 1",
        "  br label %chead",
        "packed:",
        "  %wanted.capacity = call i32 @chibi_map.capacity(i32 %n)",
        "  %smaller = icmp ult i32 %wanted.capacity, %cap",
        "  %capacity = select i1 %smaller, i32 %wanted.capacity, i32 %cap",
        "  %still = icmp ugt i32 %w, $SCANNED",
        "  br i1 %still, label %refill, label %unindex",
        "refill:",
        "  %packedslots = call i32 @chibi_map.slots(i32 %capacity)",
        "  %sbytes0 = zext i32 %packedslots to i64",
        "  %sbytes = shl i64 %sbytes0, 3",
        "  call void @chibi_scalar.zero(ptr %index, i64 %sbytes)",
        "  br label %fhead",
        "fhead:",
        "  %fi = phi i32 [ 0, %refill ], [ %fnext, %fstep ]",
        "  %fend = icmp eq i32 %fi, %w",
        "  br i1 %fend, label %refilled, label %fput",
        "fput:",
        "  %foff = zext i32 %fi to i64",
        "  %fhe = getelementptr inbounds $E, ptr %entries, i64 %foff, i32 2",
        "  %fh = load i32, ptr %fhe",
        "  %fe = add i32 %fi, 1",
        "  call void @chibi_map.place(ptr %index, i32 %packedslots, i32 %fh, i32 %fe)",
        "  br label %fstep",
        "fstep:",
        "  %fnext = add i32 %fi, 1",
        "  br label %fhead",
        "refilled:",
        "  %c1 = insertvalue $M %m, i32 %n, 0",
        "  %c2 = insertvalue $M %c1, i32 %w, 1",
        "  %c3 = insertvalue $M %c2, i32 %capacity, 2",
        "  %c4 = insertvalue $M %c3, i32 %packedslots, 3",
        "  ret $M %c4",
        "unindex:",
        "  br i1 %owns, label %giveback, label %dropped",
        "giveback:",
        "  call void @chibi_map.give(ptr %ctx, ptr %index)",
        "  br label %dropped",
        "dropped:",
        "  %u1 = insertvalue $M %m, i32 %n, 0",
        "  %u2 = insertvalue $M %u1, i32 %w, 1",
        "  %u3 = insertvalue $M %u2, i32 %capacity, 2",
        "  %u4 = insertvalue $M %u3, i32 0, 3",
        "  %u5 = insertvalue $M %u4, ptr null, 5",
        "  ret $M %u5",
        "kept:",
        "  ret $M %m",
        "}",
        "define internal $M @chibi_map.$N.copy(ptr %ctx, $M %m) {",
        "entry:",
        "  %count = extractvalue $M %m, 0",
        "  %used = extractvalue $M %m, 1",
        "  %entries = extractvalue $M %m, 4",
        "  %none = icmp eq i32 %count, 0",
        "  br i1 %none, label %empty, label %clone",
        "empty:",
        "  ret $M zeroinitializer",
        "clone:",
        "  %wat = getelementptr $E, ptr null, i32 1",
        "  %width = ptrtoint ptr %wat to i64",
        "  %fresh = call ptr @chibi_map.entries(ptr %ctx, i32 %count, i64 %width)",
        "  br label %yhead",
        "yhead:",
        "  %r = phi i32 [ 0, %clone ], [ %rnext, %ystep ]",
        "  %w = phi i32 [ 0, %clone ], [ %wnext, %ystep ]",
        "  %rend = icmp eq i32 %r, %used",
        "  br i1 %rend, label %copied, label %ylook",
        "ylook:",
        "  %roff = zext i32 %r to i64",
        "  %rhe = getelementptr inbounds $E, ptr %entries, i64 %roff, i32 2",
        "  %reh = load i32, ptr %rhe",
        "  %ralive = icmp ne i32 %reh, 0",
        "  br i1 %ralive, label %ymove, label %ystep",
        "ymove:",
        "  %src = getelementptr inbounds $E, ptr %entries, i64 %roff",
        "  %pair = load $E, ptr %src",
        "  %woff = zext i32 %w to i64",
        "  %dst = getelementptr inbounds $E, ptr %fresh, i64 %woff",
        "  store $E %pair, ptr %dst",
        "$RETAINED",
        "  %wmoved = add i32 %w, 1",
        "  br label %ystep",
        "ystep:",
        "  %wnext = phi i32 [ %w, %ylook ], [ %wmoved, %yretained ]",
        "  %rnext = add i32 %r, 1",
        "  br label %yhead",
        "copied:",
        "  %big = icmp ugt i32 %count, $SCANNED",
        "  br i1 %big, label %indexed, label %done",
        "indexed:",
        "  %slots = call i32 @chibi_map.slots(i32 %count)",
        "  %made = call ptr @chibi_map.$N.index(ptr %ctx, ptr %fresh, i32 %count, i32 %slots)",
        "  br label %done",
        "done:",
        "  %final = phi ptr [ null, %copied ], [ %made, %indexed ]",
        "  %fslots = phi i32 [ 0, %copied ], [ %slots, %indexed ]",
        "  %m1 = insertvalue $M zeroinitializer, i32 %count, 0",
        "  %m2 = insertvalue $M %m1, i32 %count, 1",
        "  %m3 = insertvalue $M %m2, i32 %count, 2",
        "  %m4 = insertvalue $M %m3, i32 %fslots, 3",
        "  %m5 = insertvalue $M %m4, ptr %fresh, 4",
        "  %m6 = insertvalue $M %m5, ptr %final, 5",
        "  ret $M %m6",
        "}"
    ], "\n");
    released := MapEach("release", "%entries", "x", key, value, owners, backed, true);
    text = strings.Concatenate([text, "\n", MapOwnedDrop(type, released), "\n", MapUnique(type)]);
    if (MapArrayValue(value) || carrier) { text = strings.Concatenate([text, "\n", MapReference(type)]); }
    text = strings.ReplaceAll(text, "$ADDRESS", address);
    text = strings.ReplaceAll(text, "$SCANNED", format_text("{}", MapScanned));
    text = strings.ReplaceAll(text, "$LIMIT", format_text("{}", MapLimit));
    text = strings.ReplaceAll(text, "$PREHASH", prehash);
    text = strings.ReplaceAll(text, "$SAME", same);
    text = strings.ReplaceAll(text, "$MISSING", missing);
    text = strings.ReplaceAll(text, "$GET_DEFAULT", fallback);
    text = strings.ReplaceAll(text, "$REPLACED", strings.TrimSuffix(strings.Join(replaced, ""), "\n"));
    text = strings.ReplaceAll(text, "$DELETED", strings.TrimSuffix(strings.Join(deleted, ""), "\n"));
    text = strings.ReplaceAll(text, "$RETAINED", strings.TrimSuffix(MapEach("retain", "%fresh", "r", key, value, owners, backed, false), "\n"));
    text = strings.ReplaceAll(text, "$M", abi.MapType());
    text = strings.ReplaceAll(text, "$E", format_text("{ {}, {}, i32 }", TypeName(key), TypeName(value)));
    text = strings.ReplaceAll(text, "$K", TypeName(key));
    text = strings.ReplaceAll(text, "$V", TypeName(value));
    return format_text("{}\n", strings.ReplaceAll(text, "$N", format_text("{}", type)));
}
// The typed map helpers in the shared ownership dependency closure, once each.
MapModule :: (types: int[], records: Record[], fields: int[], native_program: bool, owners: bool[], backed: bool[], guarded: bool = false) -> string {
    if (length(types) == 0) {
        return "";
    }
    out: string[] = [MapShared(guarded), MapOwnersRuntime(), ValueDrain()];
    for (type in types) {
        out.append(MapHelpers(type, native_program, owners, backed, MapCarrierElement(records, fields, MapValue(type)) != 0));
    }
    return format_text("\n{}", strings.Join(out, "\n"));
}

// LLVM may lower floating remainder to libm. Declare that system dependency
// even when optimization later folds a call, so linking never relies on luck.
MathImports :: (target: abi.Target, code: Instruction[]) -> string {
    single := false;
    wide := false;
    for (item in code) {
        if (item.op == Mod && item.type == abi.FloatStorage) { single = true; }
        if (item.op == Mod && item.type == abi.DoubleStorage) { wide = true; }
    }
    library_name := "m";
    prefix := "";
    if (abi.Same(target, abi.WindowsX64())) { library_name = "ucrtbase"; } else if (abi.Same(target, abi.MacOSArm64())) { library_name = "System"; prefix = "_"; } else if (abi.Same(target, abi.WebAssembly32())) { return ""; }
    out := "";
    if (single) { out = format_text("; chibi-import system:{} {}fmodf\n", library_name, prefix); }
    if (wide) { out = format_text("{}; chibi-import system:{} {}fmod\n", out, library_name, prefix); }
    return out;
}
