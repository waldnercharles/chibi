package encoding_hex

import bytes "core:bytes"

EncodedIs :: (data: u8[], expected: string) -> bool {
    result := Encode(data);
    if (result.error) {
        return false;
    }
    return result.text == expected;
}

UpperEncodedIs :: (data: u8[], expected: string) -> bool {
    result := EncodeUpper(data);
    if (result.error) {
        return false;
    }
    return result.text == expected;
}

DecodedIs :: (text: string, expected: u8[]) -> bool {
    result := Decode(text);
    if (result.error) {
        return false;
    }
    if (length(result.data) != length(expected)) {
        return false;
    }
    index: int = 0;
    while (index < length(result.data)) {
        if (result.data[index] != expected[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

RejectedAt :: (text: string, expected_kind: int, expected_offset: int) -> bool {
    result := Decode(text);
    failed := result.error;
    if (failed) {
        if (length(result.data) != 0) {
            return false;
        }
        return failed.kind == expected_kind && failed.offset == expected_offset;
    }
    return false;
}

@test
Rfc4648Base16Vectors :: () {
    inputs := ["", "f", "fo", "foo", "foob", "fooba", "foobar"];
    lower := ["", "66", "666f", "666f6f", "666f6f62", "666f6f6261", "666f6f626172"];
    upper := ["", "66", "666F", "666F6F", "666F6F62", "666F6F6261", "666F6F626172"];
    index: int = 0;
    while (index < length(inputs)) {
        data := bytes.FromString(inputs[index]);
        assert(EncodedIs(data, lower[index]));
        assert(UpperEncodedIs(data, upper[index]));
        assert(DecodedIs(lower[index], data));
        assert(DecodedIs(upper[index], data));
        index += 1;
    }
    return;
}

@test
BinaryAndMixedCaseHex :: () {
    data: u8[] = [0, 1, 15, 16, 127, 128, 255];
    assert(EncodedIs(data, "00010f107f80ff"));
    assert(UpperEncodedIs(data, "00010F107F80FF"));
    assert(DecodedIs("00010f107F80fF", data));
    encoded := Encode(data);
    data[0] = 255;
    if (encoded.error) {
        assert(false);
    }
    assert(encoded.text == "00010f107f80ff");
    return;
}

@test
AllByteValuesHaveIndependentHexOracle :: () {
    text := "";
    data := resize([u8(0)], 256);
    index: int = 0;
    while (index < 256) {
        data[index] = u8(index);
        index += 1;
    }
    assert(EncodedIs(data, text));
    assert(DecodedIs(text, data));
    return;
}

@test
MalformedHexReturnsExactErrors :: () {
    assert(RejectedAt("f", InvalidLength, 1));
    assert(RejectedAt("123", InvalidLength, 3));
    assert(RejectedAt("g0", InvalidCharacter, 0));
    assert(RejectedAt("0x", InvalidCharacter, 1));
    assert(RejectedAt(" 0", InvalidCharacter, 0));
    assert(RejectedAt("0\n", InvalidCharacter, 1));
    assert(RejectedAt("00:0", InvalidCharacter, 2));
    assert(RejectedAt("z", InvalidCharacter, 0));
    nul: u8[] = [48, 0];
    non_ascii: u8[] = [255, 48];
    assert(RejectedAt(bytes.ToString(nul), InvalidCharacter, 1));
    assert(RejectedAt(bytes.ToString(non_ascii), InvalidCharacter, 0));
    return;
}

@test
HexEncodedSizeDoesNotWrap :: () {
    assert(EncodedSize(0) == 0);
    assert(EncodedSize(1) == 2);
    assert(EncodedSize(1073741823) == 2147483646);
    assert(EncodedSize(1073741824) == -1);
    assert(EncodedSize(2147483647) == -1);
    assert(EncodedSize(-1) == -1);
    return;
}

@test
PublicHexReturnsNamedOutputsAndTypedErrors :: () {
    encoded := Encode([u8(0), 255]);
    if (encoded.error) {
        assert(false, "small public hex encode must succeed");
    }
    assert(encoded.text == "00ff");
    upper := EncodeUpper([u8(255)]);
    if (upper.error) {
        assert(false);
    }
    assert(upper.text == "FF");
    decoded := Decode("00fF");
    if (decoded.error) {
        assert(false, "valid public hex decode must succeed");
    }
    assert(length(decoded.data) == 2);
    assert(decoded.data[0] == 0 && decoded.data[1] == 255);
    rejected := Decode("00f!");
    assert(length(rejected.data) == 0, "failure must not return a partial prefix");
    failed := rejected.error;
    if (failed) {
        assert(failed.kind == InvalidCharacter && failed.offset == 3);
    } else {
        assert(false, "malformed hex needs a typed error");
    }
    empty := Decode("");
    if (empty.error) {
        assert(false, "empty decode is successful");
    }
    assert(length(empty.data) == 0);
    return;
}
