+void cf_gles_canvas_copy_depth(CF_Canvas source, CF_Canvas destination, int x, int y, int width, int height)
+{
+	CF_GL_Canvas* src = (CF_GL_Canvas*)(uintptr_t)source.id;
+	CF_GL_Canvas* dst = (CF_GL_Canvas*)(uintptr_t)destination.id;
+	CF_ASSERT(src && dst && src != dst && src->has_depth && dst->has_depth);
+	CF_ASSERT(src->w == dst->w && src->h == dst->h && src->depth_format == dst->depth_format);
+	CF_ASSERT(x >= 0 && y >= 0 && width > 0 && height > 0 && x <= src->w - width && y <= src->h - height);
+	// A blit must not inherit the last draw's crop. Disable unconditionally: GL
+	// state may outlive or differ from the backend cache. Then restore the
+	// cached state so it matches GL on the next draw.
+	bool scissor = g_ctx.current_state.scissor_enabled;
+	glDisable(GL_SCISSOR_TEST);
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, src->fbo);
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, dst->fbo);
+	glBlitFramebuffer(x, y, x + width, y + height,
+		x, y, x + width, y + height, GL_DEPTH_BUFFER_BIT, GL_NEAREST);
+	glBindFramebuffer(GL_FRAMEBUFFER, g_ctx.fbo);
+	if (scissor) glEnable(GL_SCISSOR_TEST);
+	CF_POLL_OPENGL_ERROR();
 }
 
