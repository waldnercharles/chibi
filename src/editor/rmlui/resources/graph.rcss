/* The behavior graph canvas (studio_graph.c), ported from the Studio prototype's
   graph styles. This document lives in its own context whose dp ratio is the
   zoom, so every length here is in graph units and scales with the view. */

body.graph-canvas {
    background-color: var(--canvas);
    /* Node categories. */
    --n-event: #7a2f42;
    --n-flow: #46464e;
    --n-pure: #2f4a36;
    --n-function: #2d4f7a;
    --n-variable: #5a3a2c;
    --n-literal: #6b5530;
    --n-expr: #245e6c;
    --n-call: #2d5a3c;
    --node: #2b2b2fef;
    --node-edge: #0c0c0e;
    --selected-object: #e0701c;
    --active-object: #ffa53a;
}

#back, #front { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; pointer-events: none; }
#world { position: absolute; left: 0dp; top: 0dp; width: 0dp; height: 0dp; }
.wires { display: block; position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; pointer-events: none; }
.stage { position: absolute; left: 0dp; top: 0dp; width: 0dp; height: 0dp; }

.gnode {
    position: absolute; min-width: 140dp; max-width: 340dp;
    background-color: var(--node); border: 1dp var(--node-edge); border-radius: var(--r-lg);
    color: var(--fg); font-size: 12dp;
}
.gnode[data-selected] { border-color: var(--selected-object); z-index: 2; }
.gnode[data-active] { border-color: var(--active-object); }
.gnode[data-dim] { opacity: 0.45; }
.gnode[data-breakpoint] .gnode-head { border-left: 4dp #e5534b; }
.gnode[data-disabled] { opacity: 0.5; }

.gnode-head {
    display: flex; align-items: center; gap: 6dp; height: 24dp; padding: 0dp 8dp;
    border-radius: 5dp 5dp 0dp 0dp; color: #ffffff; background-color: var(--n-pure);
}
.gnode-head .icon { color: #ffffffcc; font-size: 12dp; width: 14dp; }
.gnode-head .title { display: block; flex: 1 1 auto; white-space: nowrap; overflow: hidden; font-weight: 600; line-height: 24dp; }
.gnode-head .symbol { display: block; font-weight: 700; font-size: 14dp; line-height: 24dp; }
.gnode[data-kind=event] .gnode-head { background-color: var(--n-event); }
.gnode[data-kind=flow] .gnode-head { background-color: var(--n-flow); }
.gnode[data-kind=function] .gnode-head { background-color: var(--n-function); }
.gnode[data-kind=variable] .gnode-head { background-color: var(--n-variable); }
.gnode[data-kind=literal] .gnode-head { background-color: var(--n-literal); }
.gnode[data-kind=call] .gnode-head { background-color: var(--n-call); }
.gnode[data-kind=expression] .gnode-head { background-color: var(--n-expr); }

/* Rows sit on a fixed pitch, which is what arrange assumes: row i's socket is at
   head (24) + pad (4) + (i + 0.5) * 22 from the node's top. Execution pins pair
   up first, then data outputs, then data inputs (Blender's order). */
.gnode-body { display: block; padding: 4dp 0dp 6dp; }
.grow { position: relative; display: flex; align-items: center; gap: 6dp; height: 22dp; padding: 0dp 10dp; }
.grow.out { justify-content: flex-end; }
.grow.exec { padding: 0dp; gap: 12dp; }
.ghalf { position: relative; display: flex; align-items: center; gap: 6dp; height: 22dp; }
.ghalf.in { padding-left: 10dp; }
.ghalf.out { padding-right: 10dp; margin-left: auto; justify-content: flex-end; }
.gpin-label { display: block; flex: 0 0 auto; color: var(--fg-2); white-space: nowrap; overflow: hidden; line-height: 22dp; }
[data-hover] > .gpin-label { color: var(--fg); }
.grow .field { flex: 1 1 auto; min-width: 0dp; height: 18dp; }
.grow.out .field { flex: 0 0 64dp; }
.grow .field .part { height: 16dp; line-height: 16dp; }
.grow .segmented { height: 18dp; }
.grow .check { flex: 0 0 auto; }
/* Editors and chips fill the row to the node's edge, so their right edges align. */
.grow .chip {
    display: block; flex: 1 1 auto; min-width: 0dp; height: 18dp; padding: 0dp 6dp; border-radius: 3dp;
    background-color: var(--field-edit); color: #c6b8ea; font-size: 11dp; line-height: 18dp;
    white-space: nowrap; overflow: hidden;
}
.grow .chip.source { color: var(--tok-name); }

/* A socket is a 16 dp hit area centered on the node edge; kit_dot draws it. */
.socket { position: absolute; top: 3dp; width: 16dp; height: 16dp; }
.in > .socket { left: -8dp; }
.out > .socket { right: -8dp; }
.socket kit-dot { position: absolute; left: 3dp; top: 3dp; width: 10dp; height: 10dp; }

/* Level of detail: far out, pins and values give way to titles. */
body.far .gpin-label, body.far .grow .field, body.far .grow .chip, body.far .grow .check, body.far .grow .segmented { visibility: hidden; }
body.far .gnode-head .title { font-size: 16dp; }

.gcomment { position: absolute; border: 1dp #8a8a9666; border-radius: var(--r-lg); background-color: #8a8a961f; }
.gcomment-title {
    display: block; height: 28dp; padding: 0dp 10dp; line-height: 28dp; font-size: 14dp; font-weight: 600;
    color: var(--fg); white-space: nowrap; overflow: hidden; cursor: move;
}
body.far .gcomment-title { font-size: 28dp; height: 44dp; line-height: 44dp; }

/* Centered on the wire's middle by the negative margins. */
.gconversion {
    position: absolute; display: block; height: 16dp; margin-top: -8dp; margin-left: -40dp; width: 80dp;
    border-radius: 8dp; background-color: #1d1d20e6; border: 1dp #ffffff1c;
    color: var(--fg-2); font-size: 10dp; line-height: 14dp; text-align: center; white-space: nowrap; overflow: hidden;
}

.marquee { position: absolute; border: 1dp #ffffff66; background-color: #ffffff0d; }
.link-error {
    position: absolute; padding: 2dp 8dp; border-radius: var(--r); background-color: var(--notice);
    color: var(--notice-fg); font-size: 11dp; line-height: 16dp; white-space: nowrap;
}
