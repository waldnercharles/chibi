+// Every project package is a checked root, even when another project package
+// does not import it. Collection packages enter the compile only through an
+// import from one of those roots. Keep graph indices and dependency order;
+// snapshot validation still checks the complete structural graph.
+ActivePackageOrder :: (documents: snapshot.Document[], packages: graph.Package[], files_of: int[],
+                       order: int[], edges: graph.Edge[], root: int) -> int[] {
+    active := resize([false], length(packages));
+    pending: int[] = [];
+    package: int = 0;
+    while (package < length(packages)) {
+        identity := documents[files_of[packages[package].member_start]].identity;
+        // paths[0] still names the requested root, including a direct compile
+        // of a collection package with no project package in its snapshot.
+        if (package == root || strings.HasPrefix(identity, "project:")) {
+            active[package] = true;
+            pending.append(package);
+        }
+        package += 1;
+    }
+    next: int = 0;
+    while (next < length(pending)) {
+        for (edge in edges) {
+            if (edge.from == pending[next] && !active[edge.to]) {
+                active[edge.to] = true;
+                pending.append(edge.to);
+            }
+        }
+        next += 1;
+    }
+    selected: int[] = [];
+    for (listed in order) {
+        if (active[listed]) {
+            selected.append(listed);
+        }
+    }
+    return selected;
+}
