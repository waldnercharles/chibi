package encoding_base64

import bytes "core:bytes"
import strings "core:strings"

// RFC 4648 sections 4 and 5. Standard Base64 is padded; Base64url is raw.
// Decoders accept only canonical input, without whitespace or mixed alphabets.
// All offsets count bytes. Missing trailing input is reported at its length.
// https://www.rfc-editor.org/rfc/rfc4648.html
pub InvalidCharacter: int : 1;
pub InvalidLength: int : 2;
pub InvalidPadding: int : 3;
pub NonCanonical: int : 4;
pub OutputTooLarge: int : 5;

pub Error :: struct {
    kind: int;
    offset: int;
}

Validation :: struct {
    kind: int;
    offset: int;
    digits: int;
}

// Return -1 before any overflowing arithmetic or allocation.
EncodedSize :: (count: int, url: bool) -> int {
    if (count < 0) {
        return -1;
    }
    groups := count / 3;
    tail := count % 3;
    extra: int = 0;
    if (tail != 0) {
        extra = 4;
        if (url) {
            extra = tail + 1;
        }
    }
    if (groups > (2147483647 - extra) / 4) {
        return -1;
    }
    return groups * 4 + extra;
}

EncodeProfile :: (data: u8[], url: bool) -> (text: string, error: Error?) {
    size := EncodedSize(length(data), url);
    if (size < 0) {
        failed: Error = {kind: OutputTooLarge, offset: -1};
        return ("", failed);
    }
    alphabet: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    if (url) {
        alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    }
    out := resize([u8(0)], size);
    index: int = 0;
    write: int = 0;
    while (index < length(data)) {
        remaining := length(data) - index;
        block := int(data[index]) << 16;
        if (remaining > 1) {
            block |= int(data[index + 1]) << 8;
        }
        if (remaining > 2) {
            block |= int(data[index + 2]);
        }
        emitted: int = 4;
        if (url && remaining < 3) {
            emitted = remaining + 1;
        }
        out[write] = u8(strings.ByteAt(alphabet, (block >> 18) & 63));
        out[write + 1] = u8(strings.ByteAt(alphabet, (block >> 12) & 63));
        if (emitted > 2) {
            out[write + 2] = 61;
            if (remaining > 1) {
                out[write + 2] = u8(strings.ByteAt(alphabet, (block >> 6) & 63));
            }
        }
        if (emitted > 3) {
            out[write + 3] = 61;
            if (remaining > 2) {
                out[write + 3] = u8(strings.ByteAt(alphabet, block & 63));
            }
        }
        index += 3;
        write += emitted;
    }
    return (bytes.ToString(out), nil);
}

Digit :: (value: int, url: bool) -> int {
    if (value >= 65 && value <= 90) {
        return value - 65;
    }
    if (value >= 97 && value <= 122) {
        return value - 97 + 26;
    }
    if (value >= 48 && value <= 57) {
        return value - 48 + 52;
    }
    if (url) {
        if (value == 45) {
            return 62;
        }
        if (value == 95) {
            return 63;
        }
        return -1;
    }
    if (value == 43) {
        return 62;
    }
    if (value == 47) {
        return 63;
    }
    return -1;
}

Validate :: (text: string, url: bool) -> Validation {
    count := strings.ByteLength(text);
    digits: int = 0;
    padding: int = 0;
    index: int = 0;
    while (index < count) {
        value := strings.ByteAt(text, index);
        if (value == 61) {
            if (url || index % 4 < 2 || padding == 2) {
                return {kind: InvalidPadding, offset: index, digits: 0};
            }
            padding += 1;
        } else {
            // Once padding starts, no data may follow it.
            if (padding != 0) {
                return {kind: InvalidPadding, offset: index, digits: 0};
            }
            if (Digit(value, url) < 0) {
                return {kind: InvalidCharacter, offset: index, digits: 0};
            }
            digits += 1;
        }
        index += 1;
    }
    tail := digits % 4;
    if (url) {
        if (tail == 1) {
            return {kind: InvalidLength, offset: count, digits: 0};
        }
    } else {
        if (count % 4 != 0 || tail == 1) {
            return {kind: InvalidPadding, offset: count, digits: 0};
        }
        expected: int = 0;
        if (tail != 0) {
            expected = 4 - tail;
        }
        if (padding != expected) {
            return {kind: InvalidPadding, offset: count, digits: 0};
        }
    }
    if (tail == 2 || tail == 3) {
        mask: int = 15;
        if (tail == 3) {
            mask = 3;
        }
        if ((Digit(strings.ByteAt(text, digits - 1), url) & mask) != 0) {
            return {kind: NonCanonical, offset: digits - 1, digits: 0};
        }
    }
    return {kind: 0, offset: -1, digits: digits};
}

DecodeProfile :: (text: string, url: bool) -> (data: u8[], error: Error?) {
    validated := Validate(text, url);
    if (validated.kind != 0) {
        failed: Error = {kind: validated.kind, offset: validated.offset};
        return ([], failed);
    }
    size := (validated.digits / 4) * 3;
    tail := validated.digits % 4;
    if (tail != 0) {
        size += tail - 1;
    }
    out := resize([u8(0)], size);
    index: int = 0;
    write: int = 0;
    while (index < validated.digits) {
        remaining := validated.digits - index;
        a := Digit(strings.ByteAt(text, index), url);
        b := Digit(strings.ByteAt(text, index + 1), url);
        out[write] = u8((a << 2) | (b >> 4));
        write += 1;
        if (remaining > 2) {
            c := Digit(strings.ByteAt(text, index + 2), url);
            out[write] = u8(((b & 15) << 4) | (c >> 2));
            write += 1;
            if (remaining > 3) {
                d := Digit(strings.ByteAt(text, index + 3), url);
                out[write] = u8(((c & 3) << 6) | d);
                write += 1;
            }
        }
        // Avoid advancing beyond the int index domain on a final raw group.
        if (remaining < 4) {
            break;
        }
        index += 4;
    }
    return (out, nil);
}

// Independent output. O(n) time and storage; the string conversion copies once.
// Output size errors have offset -1. Allocation follows runtime policy.
pub Encode :: (data: u8[]) -> (text: string, error: Error?) {
    result := EncodeProfile(data, false);
    return (result.text, result.error);
}

// URL and filename safe alphabet, without '=' padding.
pub EncodeUrl :: (data: u8[]) -> (text: string, error: Error?) {
    result := EncodeProfile(data, true);
    return (result.text, result.error);
}

// Validate the complete input before allocating output. O(n) time and storage.
// A malformed input returns no partial data. Error offsets count input bytes.
pub Decode :: (text: string) -> (data: u8[], error: Error?) {
    result := DecodeProfile(text, false);
    return (result.data, result.error);
}

pub DecodeUrl :: (text: string) -> (data: u8[], error: Error?) {
    result := DecodeProfile(text, true);
    return (result.data, result.error);
}
