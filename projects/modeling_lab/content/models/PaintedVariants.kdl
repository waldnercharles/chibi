version 3
name "PaintedVariants"
domain "model"
id_counter 25
description "Two references reuse one model source, with independently overridden body slots."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Instance"
                reference_asset "PaintedModule"
                inputs {
                    Body id=5 declaration_id=3 type="const char *" type_name="MaterialAsset" default="ModelOrangePaint"
                }
                outputs {
                    Geometry id=4
                }
            }
            - {
                id 6
                type "Model Translate"
                inputs {
                    Offset {
                        default x=-48.0 y=0.0 z=0.0
                    }
                }
            }
            - {
                id 10
                type "Model Instance"
                reference_asset "PaintedModule"
                inputs {
                    Body id=12 declaration_id=3 type="const char *" type_name="MaterialAsset" default="ModelPartBands"
                }
                outputs {
                    Geometry id=11
                }
            }
            - {
                id 13
                type "Model Rotate"
                inputs {
                    Angles {
                        default x=0.0 y=0.4 z=0.2
                    }
                }
            }
            - {
                id 17
                type "Model Translate"
                inputs {
                    Offset {
                        default x=48.0 y=0.0 z=0.0
                    }
                }
            }
            - id=21 type="Model Union"
        }
        (array)edges {
            - from="3.Geometry" to="6.Geometry"
            - from="6.Geometry" to="21.A"
            - from="10.Geometry" to="13.Geometry"
            - from="13.Geometry" to="17.Geometry"
            - from="17.Geometry" to="21.B"
            - from="21.Geometry" to="1.Geometry"
        }
    }
}
