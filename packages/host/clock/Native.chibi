package clock

import target "core:target"

when target.Native == 1 {
    when target.Os == target.Web { ClockRangeError: int : 68; }
    else { ClockRangeError: int : 34; }
    // The private native transport is copied by value, never allocated. The
    // provider uses 0/1/2 for OK/unavailable/failed; -1 means no grant.
    NativeClockSample :: struct {
        nanoseconds: i64;
        domain: u64;
        status: int;
        platform_error: int;
    }
    Sample :: () -> (nanoseconds: i64, domain: u64, status: int, platform_error: int) {
        raw := RawSample();
        valid := raw.status >= -1 && raw.status <= 2;
        assert(valid, "clock provider returned an invalid status");
        if raw.status == -1 { return (0, 0, Denied, 0); }
        if raw.status == 1 { return (0, 0, Unavailable, 0); }
        if raw.status == 2 { return (0, 0, Failed, raw.platform_error); }
        if raw.nanoseconds < 0 { return (0, 0, Failed, ClockRangeError); }
        return (raw.nanoseconds, raw.domain, 0, 0);
    }
}
