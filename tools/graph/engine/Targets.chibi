            "third-party/include/chibi/desktop_vendor/SDL3_Headers/1",
            "third-party/include/chibi/desktop_vendor/SDL3_Headers/2"
        ];
    }
    return [];
}

// The macros a target's compiles define, before its include directories.
pub Defines :: (target: string) -> string[] {
    if (target == "chibi_asset_kdl") {
        return ["BUILDING_KDL=1", "KDL_STATIC_LIB=1"];
    }
    if (target == "chibi_asset_text") {
        return ["KDL_STATIC_LIB=1"];
    }
    if (target == "chibi_execution_sljit") {
        return ["SLJIT_WX_EXECUTABLE_ALLOCATOR=1"];
    }
    if (target == "chibi_execution") {
        return ["CHIBI_HAVE_SJLIT=1"];
    }
    if (target == "chibi_syntax_runtime") {
        return ["_DARWIN_C_SOURCE", "_DEFAULT_SOURCE"];
    }
    if (target == "chibi_task_scheduler") {
        return ["ENKITS_TASK_PRIORITIES_NUM=3"];
    }
    if (target == "chibi_task_pool_runtime") {
        return ["CHIBI_HAS_ENKITS=1", "ENKITS_TASK_PRIORITIES_NUM=3"];
    }
    if (target == "chibi_platform") {
        return [
            "CF_RUNTIME_SHADER_COMPILATION", "CF_STATIC", "CHIBI_DISTRIBUTION", "IMGUI_USE_WCHAR32",
            "ImDrawIdx=unsigned int"
        ];
    }
    if (target == "chibi_model_import") {
        return ["CF_RUNTIME_SHADER_COMPILATION", "CF_STATIC", "IMGUI_USE_WCHAR32", "ImDrawIdx=unsigned int"];
    }
    if (target == "chibi_ui_host") {
        return [
            "CF_RUNTIME_SHADER_COMPILATION", "CF_STATIC", "IMGUI_USE_WCHAR32", "ImDrawIdx=unsigned int",
            "RMLUI_STATIC_LIB"
        ];
    }
    if (target == "chibi_renderer") {
        return ["CF_RUNTIME_SHADER_COMPILATION", "CF_STATIC", "IMGUI_USE_WCHAR32", "ImDrawIdx=unsigned int"];
    }
    if (target == "chibi_project_preparation") {
        return ["CF_RUNTIME_SHADER_COMPILATION", "CF_STATIC", "IMGUI_USE_WCHAR32", "ImDrawIdx=unsigned int"];
    }
    return [];
}

// Options a target adds after the profile's flags. The graph drives Clang
// and GCC, which both take them: fields and math keep floating-point
// contraction off so their results match on every backend, vendored C
// compiles without warnings, and on Linux execution puts each function and
// object in its own section, so the compiler host's link can discard the
// prepared writer it does not call.
pub Options :: (target: string) -> string[] {
    if (target == "chibi_fields") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_fmt") {
        return ["-w"];
    }
    if (target == "chibi_json") {
        return ["-w"];
    }
    if (target == "chibi_asset_kdl") {
        return ["-w"];
    }
    if (target == "chibi_execution_sljit") {
        return ["-w"];
    }
    if (target == "chibi_execution" && build.platform() == "Linux") {
        return ["-ffunction-sections", "-fdata-sections"];
    }
    if (target == "chibi_math_capabilities") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_scene_authoring") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_syntax_runtime") {
        return ["-w"];
    }
    if (target == "chibi_box2d") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_box3d") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_ui_syntax") {
        return ["-w"];
    }
    if (target == "chibi_material_runtime") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_engine") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_renderer") {
        return ["-Wno-macro-redefined"];
    }
    return [];
}

// Options one source adds after its target's, as CMake's COMPILE_OPTIONS
// source property adds them: the transform and particle kernels keep
// floating-point contraction off, as fields does, and generated parsers
// compile without warnings.
pub SourceOptions :: (target: string, file: string) -> string[] {
    if (target == "chibi_spatial_runtime" && file == "src/runtime/visual_transform.c") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_spatial_runtime" && file == "src/runtime/transform_propagation.c") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_particle_runtime" && file == "src/runtime/particles.c") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_language_syntax" && file == "src/language/src/parser.c") {
        return ["-w"];
    }
    if (target == "chibi_project_document" && strings.HasPrefix(file, "src/assets/project_parser")) {
        return ["-w"];
    }
    return [];
}

// Include directories one source adds before its target's, as CMake's
// INCLUDE_DIRECTORIES source property adds them: each tree-sitter grammar
// includes its own parser headers.
pub SourceIncludes :: (target: string, file: string) -> string[] {
    if (target == "chibi_ui_syntax" && strings.HasPrefix(file, "third-party/source/tree_sitter_css/")) {
        return ["third-party/source/tree_sitter_css/src"];
    }
    if (target == "chibi_ui_syntax" && strings.HasPrefix(file, "third-party/source/tree_sitter_html/")) {
        return ["third-party/source/tree_sitter_html/src"];
    }
    return [];
}

// The C standard a target compiles with, its CMake C_STANDARD with GNU
// extensions: Box2D and Box3D declare C17.
pub Standard :: (target: string) -> string {
    if (target == "chibi_box2d" || target == "chibi_box3d") {
        return "gnu17";
    }
    return "gnu23";
}

// The C++ standard a target's C++ sources compile with, its CMake
// CXX_STANDARD with GNU extensions, or empty for none: enkiTS declares C++11
// and the UI host, over RmlUi, C++17.
pub CxxStandard :: (target: string) -> string {
    if (target == "chibi_task_scheduler") {
        return "gnu++11";
    }
    if (target == "chibi_ui_host") {
        return "gnu++17";
    }
    return "";
}

// The name a target's headers are staged under, its CMake EXPORT_NAME when
// that is not the target's name without chibi_, and the target an export
// name stages.
pub ExportName :: (target: string) -> string {
    if (target == "chibi_ui_host") {
        return "ui";
    }
    if (target == "chibi_renderer") {
        return "render";
    }
    return "";
}
pub ExportTarget :: (component: string) -> string {
    if (component == "ui") {
        return "chibi_ui_host";
    }
    if (component == "render") {
        return "chibi_renderer";
    }
    return Join(["chibi_", component]);
}

// Whether names hold name.
Listed :: (names: string[], name: string) -> bool {
    for (listed in names) {
        if (listed == name) {
            return true;
        }
    }
    return false;
}

// Whether a target compiles as position-independent code, its CMake
// POSITION_INDEPENDENT_CODE.
pub PositionIndependent :: (target: string) -> bool {
    return target == "chibi_box2d" || target == "chibi_box3d" || target == "chibi_task_scheduler";
}

// The program that writes a target's `build/` sources before it compiles, or
// empty: reflect writes the native type and binding tables.
pub Generator :: (target: string) -> string {
    if (target == "chibi_native_types" || target == "chibi_native_bindings") {
        return "reflect";
    }
    return "";
}

// Files a target embeds as byte arrays: `OUTPUT=SYMBOL=INPUT` writes the
// generated source OUTPUT, a `build/` path as Files names it, defining SYMBOL
// with the bytes of INPUT below the source root, as cmake/embed_binary.cmake
// does.
pub Embeds :: (target: string) -> string[] {
    if (target == "chibi_component_presentation") {
        return [
            "build/sdk/generated/authoring/engine_components.c=component_presentation_engine_kdl=src/authoring/engine_components.kdl"
        ];
    }
    if (target == "chibi_builtin_fonts") {
        return [
            "build/sdk/generated/fonts/editor_nerd_symbols_font.c=editor_nerd_symbols_font=third_party/fonts/nerd-fonts-symbols-only/SymbolsNerdFont-Regular.ttf",
            "build/sdk/generated/fonts/editor_ui_font.c=editor_ui_font=third_party/fonts/inter/Inter.ttf",
            "build/sdk/generated/fonts/editor_ui_bold_font.c=editor_ui_bold_font=third_party/fonts/inter/Inter-Bold.ttf",
            "build/sdk/generated/fonts/editor_ui_medium_font.c=editor_ui_medium_font=third_party/fonts/inter/Inter-Medium.ttf",
            "build/sdk/generated/fonts/editor_ui_semibold_font.c=editor_ui_semibold_font=third_party/fonts/inter/Inter-SemiBold.ttf",
            "build/sdk/generated/fonts/editor_ui_numeric_font.c=editor_ui_numeric_font=third_party/fonts/inter/Inter-Numeric.ttf",
            "build/sdk/generated/fonts/studio_regular_font.c=studio_regular_font=third_party/fonts/geist/Geist-Regular.ttf",
            "build/sdk/generated/fonts/studio_medium_font.c=studio_medium_font=third_party/fonts/geist/Geist-Medium.ttf",
            "build/sdk/generated/fonts/studio_semibold_font.c=studio_semibold_font=third_party/fonts/geist/Geist-SemiBold.ttf",
            "build/sdk/generated/fonts/studio_bold_font.c=studio_bold_font=third_party/fonts/geist/Geist-Bold.ttf",
            "build/sdk/generated/fonts/studio_numeric_font.c=studio_numeric_font=third_party/fonts/geist/Geist-Numeric.ttf",
            "build/sdk/generated/fonts/editor_noto_sans_font.c=editor_noto_sans_font=third_party/fonts/noto-sans/NotoSans-Regular.ttf",
            "build/sdk/generated/fonts/editor_noto_sans_semibold_font.c=editor_noto_sans_semibold_font=third_party/fonts/noto-sans/NotoSans-SemiBold.ttf",
            "build/sdk/generated/fonts/editor_noto_sans_bold_font.c=editor_noto_sans_bold_font=third_party/fonts/noto-sans/NotoSans-Bold.ttf",
            "build/sdk/generated/fonts/editor_inconsolata_font.c=editor_inconsolata_font=third_party/fonts/inconsolata/Inconsolata-Regular.ttf",
            "build/sdk/generated/fonts/editor_code_font.c=editor_code_font=third_party/fonts/jetbrains-mono/JetBrainsMono-Regular.ttf"
        ];
    }
    return [];
}

// The executables the graph builds; every other target is a library.
pub Programs :: () -> string[] {
    return ["reflect", "chibi-build-host", "chibi-compiler-host", "chibi"];
}

// The libraries whose objects executables link directly, as CMake's OBJECT
// libraries, rather than archive.
pub ObjectLibrary :: (target: string) -> bool {
    return target == "chibi_build_host" || target == "chibi_compiler_host";
}

// The object libraries an executable links, whose objects come before its
// own, as CMake orders them.
pub LinkedObjects :: (target: string) -> string[] {
    if (target == "chibi-build-host") {
        return ["chibi_build_host"];
    }
    if (target == "chibi-compiler-host") {
        return ["chibi_compiler_host"];
    }
    return [];
}

// Options an executable's link adds after the profile's, its CMake
// LINK_OPTIONS: the compiler host drops what it does not call.
pub LinkOptions :: (target: string) -> string[] {
    if (target == "chibi-compiler-host" && build.platform() == "Darwin") {
        return ["-Wl,-dead_strip"];
    }
    if (target == "chibi-compiler-host") {
        return ["-Wl,--gc-sections"];
    }
    return [];
}

// What an executable links after its output, in CMake's order, which may
// name a library twice: the graph's libraries by name, and `-l` and other
// options as they are.
pub Links :: (target: string) -> string[] {
    if (target == "reflect") {
        return ["chibi_capabilities", "chibi_types", "chibi_support", "-lm"];
    }
    if (target == "chibi-build-host") {
        return [
            "chibi_support", "chibi_source_catalog", "chibi_authoring", "chibi_compiler", "chibi_language",
            "chibi_language_syntax", "chibi_syntax_runtime", "chibi_reference_index", "chibi_json",
            "chibi_input_map", "chibi_prototype_document", "chibi_scene_document", "chibi_asset_text",
            "chibi_asset_kdl", "chibi_asset_values", "chibi_scene_runtime", "chibi_behavior_runtime",
            "chibi_execution", "chibi_ecs", "chibi_execution_sljit", "chibi_events", "chibi_ui_document",
            "chibi_text_source", "chibi_text_search", "chibi_ui_document_values", "chibi_text_capabilities",
            "chibi_fmt", "chibi_array_capabilities", "chibi_native_capabilities", "chibi_capabilities",
            "chibi_types", "chibi_support", "-lm"
        ];
    }
    if (target == "chibi-compiler-host") {
        return [
            "chibi_asset_text", "chibi_asset_values", "chibi_json", "chibi_native_prepared",
            "chibi_behavior_runtime", "chibi_execution", "chibi_ecs", "chibi_execution_sljit", "chibi_events",
            "chibi_text_capabilities", "chibi_fmt", "chibi_array_capabilities", "chibi_native_capabilities",
            "chibi_capabilities", "chibi_value_document", "chibi_types", "chibi_asset_json", "chibi_json",
            "chibi_language_syntax", "chibi_syntax_runtime", "chibi_asset_values", "chibi_support", "-lm",
            "chibi_asset_kdl"
        ];
    }
    if (target == "chibi") {
        return [
            "chibi_project_document", "chibi_support", "chibi_json", "chibi_asset_text", "chibi_asset_values",
            "chibi_asset_kdl", "chibi_language_syntax", "chibi_support", "-lm", "chibi_syntax_runtime"
        ];
    }
    return [];
}
