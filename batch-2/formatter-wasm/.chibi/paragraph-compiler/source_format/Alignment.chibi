package source_format

import strings "core:strings"
import syntax "project:compiler_syntax"
import diag "project:syntax_diagnostics"
import tk "project:source_tokenizer"
import directives "project:source_directives"

// Modes 0 inherits the original boolean; the resolved modes are off, preserve
// manual columns and align consecutive rows. Anchor kinds are shared with Layout.
AlignmentMode :: (kind: int, options: Options) -> int {
    mode: int = 1;
    legacy := false;
    switch kind {
        case AnchorField: mode = options.field_type_alignment; legacy = options.align_field_types;
        case AnchorConstant: mode = options.constant_alignment; legacy = options.align_constants;
        case AnchorValue: mode = options.record_value_alignment; legacy = options.align_struct_literal_values;
        case AnchorAssign: mode = options.assignment_alignment; legacy = options.align_assignments;
        case AnchorComment: mode = options.comment_alignment; legacy = options.align_trailing_comments;
        case: assert(false, "known alignment anchor");
    }
    if (mode == 0) {
        if (legacy) { return 3; }
        return 1;
    }
    return mode;
}

// Layout supplies line classes, so an across-empty-lines preference cannot
// accidentally cross an unrelated code statement. Prefix counts make each gap
// query constant time even for a very large source with distant anchors.
AlignmentGap :: (before: int, after: int, code: int[], comments: int[], blanks: int[],
                 options: Options) -> bool {
    if (after <= before) { return false; }
    if (after == before + 1) { return true; }
    first := before + 1;
    if (code[after] != code[first]) { return false; }
    if (!options.alignment_across_comments && comments[after] != comments[first]) { return false; }
    if (!options.alignment_across_blank_lines && blanks[after] != blanks[first]) { return false; }
    return true;
}

// A pass is linear in anchors and output lines. Padding is accumulated by
// anchor index, then applied to subsequent columns once, avoiding a quadratic
// update when many manually padded anchors share one physical line.
AlignColumnKind :: (out: ^(string[]), kind: int, pieces: int[], lines: int[], columns: ^(int[]),
                    kinds: int[], margins: int[], scopes: int[], original_columns: int[],
                    original_spaces: int[], operator_widths: int[], code: int[], comments: int[],
                    blanks: int[], line_count: int, options: Options) {
    mode := AlignmentMode(kind, options);
    if (mode == 1) { return; }
    selected: int[] = [];
    for (index in 0..<length(pieces)) {
        if (kinds[index] == kind) { selected.append(index); }
    }
    if (length(selected) == 0) { return; }
    shifts := resize([int(0)], line_count);
    deltas := resize([int(0)], length(pieces));
    first: int = 0;
    while (first < length(selected)) {
        end := first + 1;
        while (end < length(selected)) {
            previous := selected[end - 1];
            current := selected[end];
            if (margins[previous] != margins[current] || scopes[previous] != scopes[current] ||
                !AlignmentGap(lines[previous], lines[current], code, comments, blanks, options)) { break; }
            end += 1;
        }
        target: int = 0;
        manual := false;
        index := first;
        while (index < end) {
            anchor := selected[index];
            marker: int = 0;
            if (kind == AnchorAssign && options.alignment_compound == 1 && operator_widths[anchor] > 0) {
                marker = operator_widths[anchor] - 1;
            }
            value := columns^[anchor] + shifts[lines[anchor]] + marker;
            if (mode == 2) {
                value = original_columns[anchor] + marker;
                manual = manual || original_spaces[anchor] > 1;
            }
            if (value > target) { target = value; }
            index += 1;
        }
        permitted := (mode == 2 && manual) || (mode == 3 && end - first > 1);
        if (options.alignment_max_column > 0 && target > options.alignment_max_column) { permitted = false; }
        index = first;
        while (index < end && permitted) {
            anchor := selected[index];
            marker: int = 0;
            if (kind == AnchorAssign && options.alignment_compound == 1 && operator_widths[anchor] > 0) {
                marker = operator_widths[anchor] - 1;
            }
            pad := target - columns^[anchor] - shifts[lines[anchor]] - marker;
            if (pad < 0 || (options.alignment_max_padding > 0 && pad > options.alignment_max_padding)) {
                permitted = false;
            }
            index += 1;
        }
        if (permitted) {
            index = first;
            while (index < end) {
                anchor := selected[index];
                marker: int = 0;
                if (kind == AnchorAssign && options.alignment_compound == 1 && operator_widths[anchor] > 0) {
                    marker = operator_widths[anchor] - 1;
                }
                pad := target - columns^[anchor] - shifts[lines[anchor]] - marker;
                if (pad > 0) {
                    out^[pieces[anchor]] = strings.Concatenate([out^[pieces[anchor]], strings.Repeat(" ", pad)]);
                    shifts[lines[anchor]] += pad;
                    deltas[anchor] += pad;
                }
                index += 1;
            }
        }
        first = end;
    }
    line: int = -1;
    shift: int = 0;
    for (index in 0..<length(pieces)) {
        if (lines[index] != line) { line = lines[index]; shift = 0; }
        shift += deltas[index];
        columns^[index] += shift;
    }
}

// One output-order anchor table serves all kinds. There are five fixed passes;
// each scans the table and line prefixes once, independent of identifier length.
AlignColumns :: (out: ^(string[]), pieces: int[], lines: int[], columns: ^(int[]), kinds: int[],
                 margins: int[], scopes: int[], original_columns: int[], original_spaces: int[],
                 operator_widths: int[], line_kinds: int[], options: Options) {
    if (length(pieces) == 0) { return; }
    code := resize([int(0)], length(line_kinds) + 1);
    comments := resize([int(0)], length(line_kinds) + 1);
    blanks := resize([int(0)], length(line_kinds) + 1);
    for (index in 0..<length(line_kinds)) {
        code[index + 1] = code[index];
        comments[index + 1] = comments[index];
        blanks[index + 1] = blanks[index];
        if (line_kinds[index] == 2) { code[index + 1] += 1; }
        else if (line_kinds[index] == 1) { comments[index + 1] += 1; }
        else { blanks[index + 1] += 1; }
    }
    for (kind in [AnchorField, AnchorConstant, AnchorValue, AnchorAssign, AnchorComment]) {
        AlignColumnKind(out, kind, pieces, lines, columns, kinds, margins, scopes, original_columns,
                        original_spaces, operator_widths, code, comments, blanks, length(line_kinds), options);
    }
}

// A table row is one array/record expression directly contained in an array.
// It is not a call's argument list or an arbitrary nested expression.
DataRow :: (rows: diag.Node[], node: int) -> bool {
    kind := KindOf(rows, node);
    return (kind == diag.ArrayExpression || kind == diag.StructExpression) &&
           ParentKind(rows, node) == diag.ArrayExpression;
}

// Preserve authored horizontal gaps inside hand-arranged rows while letting
// Layout own the indentation before the first token of each row.
DataPreserveGaps :: (rows: diag.Node[], tokens: Token[]) -> bool[] {
    result := resize([false], length(tokens));
    owner := resize([int(0)], length(rows));
    for (node in 0..<length(rows)) {
        parent := rows[node].parent;
        if (parent >= 0) { owner[node] = owner[parent]; }
        if (DataRow(rows, node)) { owner[node] = node + 1; }
    }
    for (index in 1..<length(tokens)) {
        current := tokens[index].node;
        previous := tokens[index - 1].node;
        result[index] = owner[current] != 0 && owner[current] == owner[previous] &&
                        rows[current].row == rows[previous].row;
    }
    return result;
}
