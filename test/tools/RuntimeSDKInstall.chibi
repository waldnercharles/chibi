package toolchain

import sdk "graph:sdk"
import strings "core:strings"
import files "graph:install"

// The native dispatcher appends this check to tools/toolchain/RuntimeSDK.chibi
// and supplies a scratch directory. These are small filesystem/package
// boundaries; they do not construct engine libraries or an SDK product.
InstallCheck :: (condition: bool, message: string) -> bool {
    if (!condition) {
        build.report(RuntimeJoin(["runtime install check: ", message]));
    }
    return condition;
}

InstallFixture :: (prefix: string, marker: string) -> string {
    if (!build.make_directory(RuntimeJoin([prefix, "/bin"])) ||
        !build.make_directory(RuntimeJoin([prefix, "/share/chibi"])) ||
        !build.copy_file(build.find_executable("true"), RuntimeJoin([prefix, "/bin/chibi-player"])) ||
        !build.write_file(RuntimeJoin([prefix, "/marker"]), marker)) {
        return "";
    }
    id := sdk.JsonQuote(build.hash_text(marker));
    formats := "{\"execution\":{\"version\":1}}";
    engine := sdk.JsonObject(["project_version", "build_id", "artifact_formats"], ["1", id, formats]);
    if (!build.write_file(RuntimeJoin([prefix, "/share/chibi/engine.json"]), engine)) {
        return "";
    }
    targets: string[] = [];
    for (name in sdk.RuntimeTargets()) {
        targets.append(sdk.JsonQuote(RuntimeJoin(["Chibi::", name])));
    }
    requirements := sdk.JsonObject(["project_format", "artifact_formats", "system", "pointer_bits"],
                                   ["1", formats, sdk.JsonQuote(build.platform()), "64"]);
    manifest := sdk.JsonObject(["manifest_format", "kind", "package_version", "engine", "files",
                                "products", "targets", "requirements"], ["1", sdk.JsonQuote("runtime"), sdk.JsonQuote("0.1.0"),
                                                                         sdk.JsonObject(["manifest", "build_id"], [sdk.JsonQuote("share/chibi/engine.json"), id]),
                                                                         RuntimeFiles(prefix, ""), "{\"chibi-player\":\"bin/chibi-player\"}", sdk.JsonArray(targets), requirements]);
    manifest = RuntimeExtend(manifest, ["build_id"], [sdk.JsonQuote(build.hash_text(manifest))]);
    if (!build.write_file(RuntimeJoin([prefix, "/share/chibi/package.json"]), manifest)) {
        return "";
    }
    return manifest;
}

Build :: () -> int {
    arguments := build.arguments();
    if (length(arguments) != 1) {
        return 2;
    }
    work := arguments[0];
    if (!InstallCheck(RuntimePath("include/chibi/café/雪.h") && !RuntimePath("../outside") &&
                      !RuntimePath("/absolute") && !RuntimePath("a//b") && !RuntimePath("a/./b") &&
                      !RuntimePath("a\\b"), "package path contract")) {
        return 3;
    }
    original := RuntimeJoin([work, "/original"]);
    previous := InstallFixture(original, "first");
    if (!InstallCheck(previous != "" && RuntimeVerify(original) == previous, "valid package rejected")) {
        return 4;
    }
    if (!build.write_file(RuntimeJoin([original, "/marker"]), "changed") ||
        !InstallCheck(RuntimeVerify(original) == "", "changed installed bytes accepted")) {
        return 5;
    }
    if (!InstallCheck(RuntimeAssemble(build.root(), RuntimeJoin([work, "/missing-build"]),
                                      RuntimeJoin([work, "/missing-vendor"]), original) == 2 &&
                      build.read_file(RuntimeJoin([original, "/marker"])) == "changed", "invalid prior package overwritten")) {
        return 6;
    }
    previous = InstallFixture(original, "restored");
    rollback := RuntimeJoin([work, "/rollback"]);
    if (!build.reserve_directory(rollback) ||
        !InstallCheck(!RuntimePublish(rollback, original, previous) && RuntimeVerify(original) == previous &&
                      build.file_kind(rollback) == "", "failed publication did not restore prior package")) {
        return 7;
    }
    stale := RuntimeJoin([work, "/stale-preimage"]);
    competing := InstallFixture(original, "concurrent generation");
    if (!build.reserve_directory(stale) || InstallFixture(RuntimeJoin([stale, "/package"]), "unpublished") == "" ||
        !InstallCheck(!RuntimePublish(stale, original, previous) && RuntimeVerify(original) == competing &&
                      build.file_kind(stale) == "", "changed prior generation was deleted")) {
        return 12;
    }
    previous = competing;
    replacement := RuntimeJoin([work, "/replacement"]);
    if (!build.reserve_directory(replacement)) {
        return 8;
    }
    next := InstallFixture(RuntimeJoin([replacement, "/package"]), "second");
    if (!InstallCheck(next != previous && RuntimePublish(replacement, original, previous) &&
                      RuntimeVerify(original) == next && build.file_kind(replacement) == "", "managed replacement failed")) {
        return 9;
    }
    occupied := RuntimeJoin([work, "/occupied"]);
    fresh := RuntimeJoin([work, "/fresh"]);
    if (!build.make_directory(occupied) || !build.write_file(RuntimeJoin([occupied, "/unrelated"]), "keep") ||
        !build.reserve_directory(fresh) || InstallFixture(RuntimeJoin([fresh, "/package"]), "fresh") == "" ||
        !InstallCheck(!RuntimePublish(fresh, occupied, "") &&
                      build.read_file(RuntimeJoin([occupied, "/unrelated"])) == "keep", "competing prefix overwritten")) {
        return 10;
    }
    if (build.run(["ln", "-s", "marker", RuntimeJoin([original, "/link"])]) != 0 ||
        !InstallCheck(RuntimeVerify(original) == "", "symlink package accepted")) {
        return 11;
    }
    build.report("runtime installer paths, inventory, replacement, rollback and competing output passed");
    return 0;
}
