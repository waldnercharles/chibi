package nested_map_copies
foreign { chibi_value_test_allocations :: () -> i64 }
Main :: () -> int {
    text := text_from_bytes([u8(111), 108, 100]);
    values: [int:[int:string]] = [1:[2:text]];
    rows: [int:int][] = [[1:7]];
    before := chibi_value_test_allocations();
    sum := 0;
    for index in 0..<4096 {
        snapshot := values;
        inner := snapshot[1];
        copied_rows := rows;
        row := copied_rows[0];
        sum += text_byte_length(inner[2]) + row[1];
    }
    copy_calls := chibi_value_test_allocations();
    assert(sum == 40960);
    assert(copy_calls == before, "nested map copies and payload reads share owners without allocation");
    changed := values;
    inner := changed[1];
    inner[2] = "new";
    changed[1] = inner;
    completed := chibi_value_test_allocations();
    assert(completed - copy_calls == 2, "one modified leaf detaches each shared map exactly once");
    assert(values[1][2] == "old" && changed[1][2] == "new");
    return 0;
}
