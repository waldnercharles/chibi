version 1
name "HRCLabVolume"
(array)entities {
    - {
        name "Camera"
        prototype "HRCLabCamera"
        components {
            GameTransform x=0.0 y=0.0
        }
    }
    - {
        name "HRC"
        prototype "HRCLabHRC"
        components {
            GameTransform x=0.0 y=0.0
        }
    }
    - {
        name "Emitter"
        prototype "HRCLabEmitter"
        components {
            GameTransform x=-340.0 y=0.0
            GameAppearance width=24.0 height=24.0 shape="Circle"
        }
    }
    - {
        name "Smoke"
        prototype "HRCLabSmoke"
        components {
            GameTransform x=-60.0 y=0.0
            GameFluidVolume width=220.0 height=360.0 absorption=0.008 visibility=0.018
        }
    }
    - {
        name "Liquid"
        prototype "HRCLabLiquid"
        components {
            GameTransform x=130.0 y=-40.0
            GameFluidVolume width=100.0 height=220.0 absorption=0.04 visibility=0.02
        }
    }
    - {
        name "Receiver"
        prototype "HRCLabReceiver"
        components {
            GameTransform x=330.0 y=0.0
            GameAppearance width=100.0 height=420.0
        }
    }
    - {
        name "Backdrop"
        prototype "HRCLabReceiver"
        components {
            GameTransform x=0.0 y=0.0
            GameAppearance width=960.0 height=540.0 shape="Box" layer=-100
            GameMaterial absorption=0.0 albedo=0xd0d0d0ff scene=0x6b6b6bff edge_light=0.0
        }
    }
}
