// Surface light seed: averages received light over open space in square
// canvas blocks. u_out holds light times openness in RGB and the open fraction
// in A; u_out_dirs holds the per-quadrant arriving luminance times openness.
//
// Dispatched at ceil(canvas / block). Blurring these images gives, for a solid
// pixel, the light in the open space around it, how far that space is, and the
// directions the light arrives from.

layout(set = 0, binding = 0) uniform sampler2D u_fluence;
layout(set = 0, binding = 1) uniform sampler2D u_scene;
layout(set = 0, binding = 2) uniform sampler2D u_dirs;

layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D u_out;
layout(set = 1, binding = 1, rgba16f) uniform writeonly image2D u_out_dirs;

layout(set = 2, binding = 0) uniform Params
{
	int u_canvas_w;
	int u_canvas_h;
	int u_out_w;
	int u_out_h;
	int u_block;
};

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main()
{
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (p.x >= u_out_w || p.y >= u_out_h) return;
	ivec2 last = ivec2(u_canvas_w - 1, u_canvas_h - 1);
	bool full_resolution = all(equal(textureSize(u_fluence, 0), ivec2(u_canvas_w, u_canvas_h)));
	vec4 sum = vec4(0), dirs = vec4(0);
	for (int y = 0; y < u_block; y++) {
		for (int x = 0; x < u_block; x++) {
			ivec2 q = min(p * u_block + ivec2(x, y), last);
			float open = 1.0 - clamp(texelFetch(u_scene, q, 0).a, 0.0, 1.0);
			vec2 uv = (vec2(q) + 0.5) / vec2(u_canvas_w, u_canvas_h);
			vec3 light;
			vec4 direction;
			if (full_resolution) {
				light = max(texelFetch(u_fluence, q, 0).rgb, vec3(0));
				direction = texelFetch(u_dirs, q, 0);
			} else {
				light = max(texture(u_fluence, uv).rgb, vec3(0));
				direction = texture(u_dirs, uv);
			}
			sum += vec4(light * open, open);
			dirs += max(direction, vec4(0)) * open;
		}
	}
	float area = float(u_block * u_block);
	imageStore(u_out, p, sum / area);
	imageStore(u_out_dirs, p, dirs / area);
}
