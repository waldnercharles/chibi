-    if (bytes > INT_MAX) {
-        return "String iterator exceeds its byte cursor range";
-    }
-    string_snapshot *cursor = arena_alloc(storage, sizeof *cursor + bytes + 1);
-    cursor->bytes = (int)bytes;
-    if (bytes) {
-        memcpy(cursor->text, text.bytes, bytes);
