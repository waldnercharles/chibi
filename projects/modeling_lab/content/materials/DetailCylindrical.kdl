version 3
name "DetailCylindrical"
domain "material"
id_counter 24
description "Repeating checker wrap around the named part's Y axis with two texture repeats along its length."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 1
                type "Shader Surface Output"
                inputs {
                    "Base Color" {
                        default x=1.0 y=1.0 z=1.0
                    }
                    Emission {
                        default x=0.0 y=0.0 z=0.0
                    }
                    Normal {
                        default x=0.0 y=0.0 z=0.0
                    }
                }
            }
            - {
                id 10
                type "Shader Cylindrical Mapping"
                inputs {
                    Scale {
                        default x=4.0 y=0.05
                    }
                }
            }
            - {
                id 16
                type "Shader Image Texture"
                inputs Image="content/images/DetailChecker.png"
            }
        }
        (array)edges {
            - from="10.UV" to="16.UV"
            - from="16.Color" to="1.Base Color"
        }
    }
}
