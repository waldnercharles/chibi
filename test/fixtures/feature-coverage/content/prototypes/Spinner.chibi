package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Spinner")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Appearance", data.Object([
                    data.Field.Named("color", data.Value.UInt(3785972735)),
                    data.Field.Named("height", data.Value.Real(8.0)),
                    data.Field.Named("width", data.Value.Real(32.0))
                ])),
                data.Field.Named("Body", data.Object([
                    data.Field.Named("allow_rotation", data.Value.Bool(true)),
                    data.Field.Named("type", data.Value.Text("Dynamic"))
                ])),
                data.Field.Named("Collider", data.Object([
                    data.Field.Named("category", data.Value.UInt(1)),
                    data.Field.Named("height", data.Value.Real(8.0)),
                    data.Field.Named("mask", data.Value.UInt(1)),
                    data.Field.Named("shape", data.Value.Text("Box")),
                    data.Field.Named("width", data.Value.Real(32.0))
                ])),
                data.Field.Named("Joint", data.Object([
                    data.Field.Named("motor", data.Value.Bool(true)),
                    data.Field.Named("speed", data.Value.Real(1.0)),
                    data.Field.Named("strength", data.Value.Real(1000000.0))
                ])),
                data.Field.Named("Orientation", data.Object([])),
                data.Field.Named("Transform", data.Object([
                    data.Field.Named("x", data.Value.Real(-96.0)),
                    data.Field.Named("y", data.Value.Real(64.0))
                ]))
            ]))
        ])
    );
}
