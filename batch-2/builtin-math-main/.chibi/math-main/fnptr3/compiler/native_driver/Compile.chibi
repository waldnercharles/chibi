package native_driver

import compiler "project:package_compiler"
import facts "project:scalar_facts"
import abi "project:native_abi"
import scalar "project:scalar_llvm"
import strings "core:strings"

// The native compiler's pure core: the sources of a program's closure in, one
// LLVM module or the first rejection out. It touches no file and no global, so
// Main runs it natively and the VM-hosted compiler runs it as an entry.

// A large program's module is several pieces, each after the first begun by
// a `; chibi-piece` line (llvm_native's Pieces).
pub Output :: union {
    Rejected(message: string) | Emitted(text: string)
}

Target :: (triple: string) -> abi.Target {
    if (strings.HasPrefix(triple, "aarch64-apple")) {
        return abi.MacOSArm64();
    }
    if (strings.HasPrefix(triple, "x86_64-pc-windows")) {
        return abi.WindowsX64();
    }
    return abi.LinuxX64();
}

// The function whose declaration lies last before byte `at` of `text`.
FunctionAt :: (text: string, at: int) -> string {
    lines := strings.SplitLines(strings.Slice(text, 0, at));
    index := length(lines) - 1;
    while (index >= 0) {
        line := lines[index];
        marker := strings.Index(line, " :: (");
        if (marker > 0 && !strings.HasPrefix(line, " ") && !strings.HasPrefix(line, "/")) {
            return strings.TrimPrefix(strings.Slice(line, 0, marker), "pub ");
        }
        index -= 1;
    }
    return "(entry)";
}

// The file and line byte `at` of the joined sources lies in; each source is
// followed by a newline when it lacks one, as the producer joins them.
Where :: (paths: string[], sources: string[], at: int) -> string {
    offset := 0;
    for (index in 0..<length(paths)) {
        size := strings.ByteLength(sources[index]);
        if (!strings.HasSuffix(sources[index], "\n")) {
            size += 1;
        }
        if (at < offset + size) {
            line := strings.Count(strings.Slice(sources[index], 0, at - offset), "\n") + 1;
            return format_text("{}:{}", paths[index], line);
        }
        offset += size;
    }
    return "?";
}

// `paths[0]` and `sources[0]` are the entry file, the others its closure: project
// packages by project-relative path and collection packages by path under their
// `directories`. The program starts at the function `chosen` of the first file,
// or at its first function when `chosen` is "". A rejection message reads
// `rejected FUNCTION: MESSAGE`.
pub Module :: (collections: string[], directories: string[], paths: string[], sources: string[], triple: string,
               chosen: string) -> Output {
    os := 1;
    arch := 1;
    if (strings.HasPrefix(triple, "aarch64-apple")) {
        os = 2;
        arch = 2;
    } else if (strings.HasPrefix(triple, "x86_64-pc-windows")) {
        os = 3;
    }
    rows := compiler.CollectScalarProgram("/project", collections, directories, paths, sources, TargetFacts(), Names(),
                                          Natives(), Ports(), Identities(), os, arch, chosen);
    if (length(rows) < 2 || rows[1].kind == facts.RejectionRow) {
        rejected := rows[length(rows) - 1];
        return Output.Rejected(strings.Concatenate(["rejected ", FunctionAt(rows[0].text, rejected.start), ": ",
                                                    rejected.text, " (", Where(paths, sources, rejected.start), ")"]));
    }
    switch scalar.EmitFor(Target(triple), rows) {
        case .Rejected(rejected):
            return Output.Rejected(strings.Concatenate(["rejected (module): ", rejected[length(rejected) - 1].text]));
        case .Invalid(message):
            return Output.Rejected(strings.Concatenate(["rejected (module): ", message]));
        case .Emitted(text):
            return Output.Emitted(text);
    }
}

// The compiler host's entry: the module's bytes, or a 0 byte and then the
// rejection's text.
pub Compile :: (core: string, paths: string[], sources: string[], triple: string) -> u8[] {
    switch Module(["core"], [core], paths, sources, triple, "") {
        case .Rejected(message):
            flagged: u8[] = [0];
            for (byte in strings.Bytes(message)) {
                flagged.append(u8(byte));
            }
            return flagged;
        case .Emitted(text):
            module: u8[] = [];
            for (item in strings.Bytes(text)) {
                module.append(u8(item));
            }
            return module;
    }
}
