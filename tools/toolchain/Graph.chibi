package toolchain

import c "graph:c"
import engine "graph:engine"
import strings "core:strings"

// Builds the engine libraries the Chibi graph owns (PLAN.md M6), beside the
// CMake build. Run through the build host with `--collection graph=tools/graph`:
//   Support -- --build DIR --compiler PATH --compiler-id ID --build-type TYPE
//     [--architecture ARCH] [--sysroot DIR] [--warnings on|off] [--sanitizers LIST]
//     [--debug-compilation-dir DIR] [--launcher PATH] --archiver PATH
//     --ranlib PATH [--jobs N]
// Every path is absolute. Reports how many sources it compiled.

// The value after `--name`, or fallback when the option is absent.
Option :: (arguments: string[], name: string, fallback: string) -> string {
    for (i in 0..<length(arguments) - 1) {
        if (arguments[i] == name) {
            return arguments[i + 1];
        }
    }
    return fallback;
}

// The number a decimal option holds, or -1 when it holds something else.
Count :: (text: string) -> int {
    value := 0;
    for (byte in strings.Bytes(text)) {
        if (byte < 48 || byte > 57 || value > 10000) {
            return -1;
        }
        value = value * 10 + byte - 48;
    }
    return value;
}

Support :: () -> int {
    arguments := build.arguments();
    build_dir := Option(arguments, "--build", "");
    jobs := Count(Option(arguments, "--jobs", "8"));
    profile: engine.Profile = {
        compiler: Option(arguments, "--compiler", ""),
        compiler_id: Option(arguments, "--compiler-id", ""),
        build_type: Option(arguments, "--build-type", ""),
        architecture: Option(arguments, "--architecture", ""),
        sysroot: Option(arguments, "--sysroot", ""),
        warnings: Option(arguments, "--warnings", "on") == "on",
        sanitizers: Option(arguments, "--sanitizers", ""),
        debug_compilation_dir: Option(arguments, "--debug-compilation-dir", "")
    };
    tools: c.Tools = {
        launcher: Option(arguments, "--launcher", ""),
        compiler: profile.compiler,
        archiver: Option(arguments, "--archiver", ""),
        ranlib: Option(arguments, "--ranlib", ""),
        jobs: jobs
    };
    if (!strings.HasPrefix(build_dir, "/") || !strings.HasPrefix(profile.compiler, "/") ||
        tools.archiver == "" || tools.ranlib == "" || jobs < 1) {
        build.report("graph: --build, --compiler, --archiver and --ranlib are required, and --jobs must be positive");
        return 2;
    }
    source_root := build.root();
    if (!c.StageHeaders(strings.Join([source_root, "/src"], ""), engine.SupportHeaders(),
                        engine.PublicHeaders(build_dir, "support"))) {
        build.report("graph: staging chibi_support's headers failed");
        return 1;
    }
    compiled := c.StaticLibrary(tools, engine.Support(source_root, build_dir),
                                engine.SupportSources(source_root), engine.SupportFlags(build_dir, profile));
    if (compiled < 0) {
        build.report("graph: chibi_support failed");
        return 1;
    }
    build.report(format_text("graph: chibi_support compiled {0} of 5 sources", compiled));
    return 0;
}
