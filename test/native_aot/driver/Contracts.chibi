package native_aot

// Test adapters only. Assertions live in the C/pico tooling cases.
InspectTool :: () -> int {
    arguments := build.arguments();
    build.report(Tool(arguments[0]));
    return 0;
}

InspectCleanup :: () -> int {
    arguments := build.arguments();
    if (Cleanup(arguments[0])) {
        return 0;
    }
    return 1;
}

InspectInterruption :: () -> int {
    return build.run(build.arguments());
}

// Bit i is set when argument i names a module whose target Target admits.
InspectTargets :: () -> int {
    admitted := 0;
    bit := 1;
    for (path in build.arguments()) {
        if (Target(build.read_file(path)) >= 0) {
            admitted += bit;
        }
        bit *= 2;
    }
    return admitted;
}

// Bit i is set when argument i names a source LibraryName reads as Mix's.
InspectLibraryNames :: () -> int {
    named := 0;
    bit := 1;
    for (path in build.arguments()) {
        if (LibraryName(build.read_file(path)) == "Mix") {
            named += bit;
        }
        bit *= 2;
    }
    return named;
}
