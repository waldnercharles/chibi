package crc32

@test
IeeeMatchesPublishedAndBinaryAnswers :: () {
    empty: u8[] = [];
    digits: u8[] = [49, 50, 51, 52, 53, 54, 55, 56, 57];
    assert(Ieee(empty) == u32(0));
    assert(Ieee(digits) == u32(0xcbf43926));
    // Binary and UTF-8 byte vectors independently checked with Python zlib.crc32.
    zeros: u8[] = [0, 0, 0, 0];
    binary: u8[] = [0, 1, 127, 128, 255];
    utf8: u8[] = [65, 0, 195, 169, 240, 159, 152, 128];
    assert(Ieee(zeros) == u32(0x2144df1c));
    assert(Ieee(binary) == u32(0x37b2c8d3));
    assert(Ieee(utf8) == u32(0x4e57e6bf));
    assert(length(binary) == 5 && binary[0] == 0 && binary[4] == 255);
    return;
}

@test
EverySplitContinuesTheSameIeeeChecksum :: () {
    data: u8[] = [0, 1, 127, 128, 255, 0, 65, 195, 169, 240, 159, 152, 128];
    empty: u8[] = [];
    expected := Ieee(data);
    split := 0;
    while split <= length(data) {
        prefix: u8[] = [];
        suffix: u8[] = [];
        index := 0;
        while index < length(data) {
            if index < split {
                prefix.append(data[index]);
            } else {
                suffix.append(data[index]);
            }
            index += 1;
        }
        first := UpdateIeee(u32(0), prefix);
        assert(UpdateIeee(first, empty) == first);
        assert(UpdateIeee(first, suffix) == expected);
        split += 1;
    }
    assert(UpdateIeee(u32(0x12345678), empty) == u32(0x12345678));
    return;
}

@test
AllByteValuesMatchIndependentIeeeAnswer :: () {
    data: u8[] = [];
    index := 0;
    while index < 256 {
        data.append(u8(index));
        index += 1;
    }
    // Python zlib.crc32(bytes(range(256))).
    assert(Ieee(data) == u32(0x29058c73));
    return;
}
