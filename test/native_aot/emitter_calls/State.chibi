package llvm_native_calls

import native "project:llvm_native"
import abi "project:native_abi"
import strings "core:strings"

// Frame(state, dt) takes a record of an int and an f64, and an int, and gives
// the record with its int field advanced by dt. These are emitter semantics:
// the state manifest a host that swaps generations reads.
Frame :: () -> native.Instruction[] {
    return [Code(native.Check, 0, 0, 0, 0, 0, 0),
            Code(native.Argument, 32, 0, 0, 0, 0, 0),
            Code(native.Argument, 6, 1, 1, 0, 0, 0),
            Code(native.Extract, 6, 2, 0, 32, 0, 0),
            Code(native.Add, 6, 3, 2, 1, 0, 0),
            Code(native.Insert, 32, 4, 0, 3, 0, 0),
            Code(native.Publish, 32, 0, 4, 0, 0, 0),
            Code(native.Return, 0, 0, 0, 0, 0, 0)];
}
FrameLibrary :: (names: string[]) -> native.Result {
    empty: int[] = [];
    locals: int[] = [];
    texts: string[] = [];
    ids: i64[] = [5];
    return native.EmitLibrary(abi.LinuxX64(), "State", ["Frame"], ids, [Function(32, 2, 0, 5, 0, 8, 0, 0)],
                              [32, 6], [32, 6, 6, 6, 32], locals, Frame(), empty, [{first: 0, count: 2}], [6, 11],
                              texts, 1, names);
}
// A state function leaves the player's export manifest alone and has a
// manifest of its own, whose entry builds the record from words and writes the
// result record's fields as words, under a schema of types and field names.
@test
StateFunctionsHaveTheirOwnManifest :: () {
    text := Emitted(FrameLibrary(["hp", "speed"]));
    assert(strings.Contains(text, "@chibi_scalar.exports = private constant [0 x %chibi.export] []\n"));
    assert(strings.Contains(text, "@chibi_state_State = constant %chibi.manifest { i32 1, i32 1, ptr @chibi_scalar.states }\n"));
    assert(strings.Contains(text, "@chibi_scalar.state.types.0 = private unnamed_addr constant [5 x i8] [i8 1, i8 11, i8 1, i8 1, i8 11]\n"));
    assert(strings.Contains(text, "@chibi_scalar.state.names.0 = private unnamed_addr constant [21 x i8] c\"hp\\00speed\\00#1\\00hp\\00speed\\00\"\n"));
    assert(strings.Contains(text, "%chibi.state { ptr @chibi_scalar.state.name.0, i64 5, ptr @chibi_scalar.state.types.0, ptr @chibi_scalar.state.names.0, i32 3, i32 2, ptr @chibi_scalar.state.0 }"));
}
@test
StateEntryBuildsAndWritesRecords :: () {
    text := Emitted(FrameLibrary(["hp", "speed"]));
    assert(strings.Contains(text, "define internal void @chibi_scalar.state.0(ptr %ctx, ptr %in, ptr %out) #0 {\nentry:\n"));
    assert(strings.Contains(text, "%s0 = insertvalue %record0 zeroinitializer, i32 %l0, 0\n"));
    assert(strings.Contains(text, "%s1 = insertvalue %record0 %s0, double %l1, 1\n"));
    assert(strings.Contains(text, "%r = call %record0 @chibi_scalar.0(%record0 %s1, i32 %l2)\n"));
    assert(strings.Contains(text, "%f0 = extractvalue %record0 %r, 0\n"));
    assert(strings.Contains(text, "%f1 = extractvalue %record0 %r, 1\n"));
    assert(strings.Contains(text, "store i64 %o1, ptr %o1.at\n"));
}
// Without field names, a record has no schema to migrate by, so the library
// has no state manifest.
@test
UnnamedRecordsAreNotState :: () {
    names: string[] = [];
    text := Emitted(FrameLibrary(names));
    assert(!strings.Contains(text, "chibi_state_"));
}
