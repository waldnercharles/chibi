package windows_dll_builder

import link "project:native_link"
import host "project:native_link_host"
import os "core:os"
import strings "core:strings"

// Build both runtime forms with the production PE link and shared-context
// paths. The Windows client loads two copies and checks their private globals.
Main :: () -> int {
    arguments := os.Arguments();
    if (length(arguments) != 2) { return 2; }
    llvm := arguments[0];
    directory := arguments[1];
    made := os.MakeDirectory(directory);
    if (made != nil) { return 2; }
    triple := "x86_64-pc-windows-msvc";
    for (context in [false, true]) {
        name := "plain";
        if (context) { name = "context"; }
        output := strings.Concatenate([directory, "/generation ", name, ".dll"]);
        source := strings.Concatenate([output, ".ll"]);
        object := strings.Concatenate([output, ".o"]);
        module := link.SharedContext(triple, context);
        if (module == "") { return 2; }
        module = strings.Concatenate([module,
            "@fixture_state = private global i32 0\n",
            "define dllexport i32 @fixture_tick() {\n  %old = load i32, ptr @fixture_state\n",
            "  %next = add i32 %old, 1\n  store i32 %next, ptr @fixture_state\n  ret i32 %next\n}\n",
            "define dllexport i64 @fixture_arguments() {\n  %count = call i64 @chibi_argument_count()\n  ret i64 %count\n}\n"]);
        if (context) {
            module = strings.Concatenate([module,
                "define dllexport i32 @fixture_context() {\n",
                "  %allocate.at = getelementptr { ptr, ptr, ptr, ptr, ptr }, ptr @chibi_context, i32 0, i32 2\n",
                "  %allocate = load ptr, ptr %allocate.at\n  %memory = call ptr %allocate(ptr @chibi_context, i64 16)\n",
                "  %valid = icmp ne ptr %memory, null\n  br i1 %valid, label %allocated, label %failed\n",
                "allocated:\n  %word = load i64, ptr %memory\n  %zero = icmp eq i64 %word, 0\n",
                "  %release.at = getelementptr { ptr, ptr, ptr, ptr, ptr }, ptr @chibi_context, i32 0, i32 4\n",
                "  %release = load ptr, ptr %release.at\n  call void %release(ptr @chibi_context, ptr %memory)\n",
                "  %result = zext i1 %zero to i32\n  ret i32 %result\nfailed:\n  ret i32 0\n}\n"]);
        } else {
            module = strings.Concatenate([module, "define dllexport i32 @fixture_context() { ret i32 0 }\n"]);
        }
        written := os.WriteText(source, module);
        if (written != nil) { return 2; }
        // Runtime shims follow native_driver's llc-only start-object path.
        compiled := host.Object(llvm, source, object, 2);
        if (compiled != nil) { return 1; }
        plan := link.Program(triple, llvm, [object], [], [], [], output, "", true);
        plan.shared = true;
        plan.imports = link.SystemImports(strings.SplitLines(module));
        linked := host.Link(plan);
        if (linked != nil) { return 1; }
    }
    return 0;
}
