version 3
name "Capsule"
domain "model"
id_counter 7
description "Radius around a finite Y-axis segment."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Capsule"
                inputs Radius=16.0 "Half Segment"=16.0
            }
        }
        (array)edges {
            - from="3.Geometry" to="1.Geometry"
        }
    }
}
