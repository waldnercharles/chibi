package union_members

import reader "project:signature_reader"
import named "project:named_binding"
import constructors "project:type_constructors"
import binding "project:lexical_binding"
import syntax "project:syntax_diagnostics"
import strings "core:strings"

// Complete catalog order, including native records and internal constructors.
// Type/ID pools use the same representation as named binding; graph rows are
// raw metadata, not precomputed ownership edges or cycle decisions.
Definition :: struct { id_slot: int; field_start: int; field_count: int; variant_start: int; variant_count: int; }
Field :: struct { type: int; }
Variant :: struct { type: int; tagged: bool; field_start: int; field_count: int; }
Capability :: struct { result_start: int; result_count: int; }
Environment :: union {
    Tables(reader: reader.Environment, types: named.Type[], ids: uint64[],
           definitions: Definition[], variants: Variant[], fields: Field[],
           capabilities: Capability[], capability_fields: Field[])
}
DeclaredField :: struct { name: string; id_slot: int; type: int; offset: int; writable: bool; has_default: bool; }
DeclaredVariant :: struct { name: string; tag_slot: int; type: int; tagged: bool; is_literal: bool;
    literal: string; field_start: int; field_count: int; }
Update :: union {
    Added(plan: constructors.Plan)
    | Replaced(id: uint64, variants: DeclaredVariant[], fields: DeclaredField[], types: named.Type[], ids: uint64[])
}
Members :: union { Built(environment: Environment, updates: Update[], diagnostics: syntax.Diagnostic[], uses: named.Use[]) }

Validation :: union { Checked(root: int, error: int, states: int[]) }
MaxDepth: int : 256;

// All helpers reachable from the depth-256 traversal use the existing
// unlimited callable depth setting; imported convenience helpers retain their
// ordinary depth64 and therefore are not called on a deep traversal frame.
CycleID :: pure fn(ids: uint64[], slot: int) -> uint64 {
    depth_limit 0;
    if (slot < 0) { return 0; }
    return ids[slot];
}
CycleType :: pure fn(types: named.Type[], ids: uint64[], index: int) -> named.Value {
    depth_limit 0;
    row := types[index];
    return named.Value.Typed(row.storage, row.container, row.flags,
        CycleID(ids, row.nominal_slot), CycleID(ids, row.parameter_slot));
}

// Walk discovers owned edges from metadata, including array/optional nominal
// payloads. Visiting/done checks precede the depth guard, exactly as in C.
Walk :: pure fn(types: named.Type[], ids: uint64[], definitions: Definition[], variants: Variant[], fields: Field[],
                value: named.Value, states: int[], depth: int) -> Validation {
    depth_limit 0;
    switch value { case .Typed(storage, container, flags, nominal, parameter):
        if (storage != 15 && storage != 18) { return Validation.Checked(-1, 0, states); }
        found: int = -1;
        index: int = 0;
        while (index < length(definitions) && found < 0) {
            if (CycleID(ids, definitions[index].id_slot) == nominal) { found = index; }
            index += 1;
        }
        if (found < 0) { return Validation.Checked(-1, 0, states); }
        if (states[found] == 1) { return Validation.Checked(-1, 1, states); }
        if (states[found] == 2) { return Validation.Checked(-1, 0, states); }
        if (depth == MaxDepth) { return Validation.Checked(-1, 2, states); }
        updated := states;
        updated[found] = 1;
        definition := definitions[found];
        index = 0;
        while (index < definition.field_count) {
            row := fields[definition.field_start + index];
            switch Walk(types, ids, definitions, variants, fields, CycleType(types, ids, row.type), updated, depth + 1) {
                case .Checked(root, error, next_states):
                    if (error != 0) { return Validation.Checked(-1, error, next_states); }
                    updated = next_states;
            }
            index += 1;
        }
        index = 0;
        while (index < definition.variant_count) {
            variant := variants[definition.variant_start + index];
            if (!variant.tagged) {
                switch Walk(types, ids, definitions, variants, fields, CycleType(types, ids, variant.type), updated, depth + 1) {
                    case .Checked(root, error, next_states):
                        if (error != 0) { return Validation.Checked(-1, error, next_states); }
                        updated = next_states;
                }
            }
            field_index: int = 0;
            while (field_index < variant.field_count) {
                row := fields[variant.field_start + field_index];
                switch Walk(types, ids, definitions, variants, fields, CycleType(types, ids, row.type), updated, depth + 1) {
                    case .Checked(root, error, next_states):
                        if (error != 0) { return Validation.Checked(-1, error, next_states); }
                        updated = next_states;
                }
                field_index += 1;
            }
            index += 1;
        }
        updated[found] = 2;
        return Validation.Checked(-1, 0, updated);
    }
}
Validate :: pure fn(types: named.Type[], ids: uint64[], definitions: Definition[], variants: Variant[], fields: Field[],
                    roots: int[], states: int[]) -> Validation {
    updated := states;
    index: int = 0;
    while (index < length(roots)) {
        switch Walk(types, ids, definitions, variants, fields, CycleType(types, ids, roots[index]), updated, 0) {
            case .Checked(root, error, next_states):
                if (error != 0) { return Validation.Checked(index, error, next_states); }
                updated = next_states;
        }
        index += 1;
    }
    return Validation.Checked(-1, 0, updated);
}

Eligible :: union { Declaration(symbol: int, value: named.Value, diagnostics: syntax.Diagnostic[]) }
EligibleUnion :: pure fn(environment: Environment, tree: reader.Tree, node: int, scope: int, document: int) -> Eligible {
    token := reader.Field(tree, node, "name");
    switch reader.Name(tree, token, document) { case .Name(name, diagnostics):
        switch environment { case .Tables(reading, types, ids, definitions, variants, fields, capabilities, capability_fields):
            switch reading { case .Tables(names, constructor_tables, pointer_size):
                switch names { case .Tables(lexical, name_types, name_ids, merged, own, native, symbol_types, imports, exports, uses,
                                           identity, package_scope, has_native, has_documents, entity_id):
                    symbol := binding.FindName(lexical, scope, name);
                    if (symbol >= 0) {
                        switch lexical { case .Tables(scopes, symbols, functions, lexical_ids, keys):
                            item := symbols[symbol];
                            value := named.TypeAt(name_types, name_ids, symbol_types[symbol]);
                            location := reader.Request(tree, token, scope, document, "");
                            switch value { case .Typed(storage, container, flags, nominal, parameter):
                                if (item.kind == 13 && storage == 18 && item.document == location.document && item.start == location.start) {
                                    return Eligible.Declaration(symbol, value, diagnostics);
                                }
                            }
                        }
                    }
                }
            }
        }
        return Eligible.Declaration(-1, named.Builtin("invalid"), diagnostics);
    }
}
// Preserve original variant metadata selections when a constructor flattens
// an earlier declaration. Tagged child payload spans remain raw catalog facts.
Append :: pure fn(environment: Environment, plan: constructors.Plan) -> Environment {
    switch plan { case .Constructed(value, publish, id, name, definition_value, size, internal, selected, selected_fields, output_ids, diagnostics):
        if (!publish) { return environment; }
        switch environment { case .Tables(reading, types, ids, definitions, variants, fields, capabilities, capability_fields):
            new_types := types;
            new_ids := ids;
            new_variants := variants;
            variant_start := length(new_variants);
            index: int = 0;
            while (index < length(selected)) {
                item := selected[index];
                payload := named.Value.Typed(item.storage, item.container, item.flags,
                    named.IDAt(output_ids, item.nominal_slot), named.IDAt(output_ids, item.parameter_slot));
                field_start: int = 0;
                field_count: int = 0;
                tagged := false;
                if (item.catalog_type >= 0) {
                    previous := definitions[item.catalog_type];
                    source_variant := variants[previous.variant_start + item.variant];
                    field_start = source_variant.field_start;
                    field_count = source_variant.field_count;
                    tagged = source_variant.tagged;
                }
                switch reader.AddType(new_types, new_ids, payload) { case .Added(rows, pool, type_index):
                    new_types = rows;
                    new_ids = pool;
                    row: Variant = {type: type_index, tagged: tagged, field_start: field_start, field_count: field_count};
                    new_variants = array_add(new_variants, row);
                }
                index += 1;
            }
            new_fields := fields;
            field_start := length(new_fields);
            index = 0;
            while (index < length(selected_fields)) {
                selection := selected_fields[index];
                payload := named.Builtin("invalid");
                if (selection.capability >= 0) {
                    original := capabilities[selection.capability];
                    row := capability_fields[original.result_start + selection.parameter];
                    payload = named.TypeAt(types, ids, row.type);
                } else {
                    switch reading { case .Tables(names, constructor_tables, pointer_size):
                        switch names { case .Tables(lexical, name_types, name_ids, merged, own, native, symbol_types, imports, exports, uses,
                                                   identity, package_scope, has_native, has_documents, entity_id):
                            payload = named.TypeAt(name_types, name_ids, symbol_types[selection.symbol]);
                        }
                    }
                }
                switch reader.AddType(new_types, new_ids, payload) { case .Added(rows, pool, type_index):
                    new_types = rows;
                    new_ids = pool;
                    row: Field = {type: type_index};
                    new_fields = array_add(new_fields, row);
                }
                index += 1;
            }
            id_slot := length(new_ids);
            new_ids = array_add(new_ids, id);
            row: Definition = {id_slot: id_slot, field_start: field_start, field_count: length(selected_fields),
                variant_start: variant_start, variant_count: length(selected)};
            new_definitions := array_add(definitions, row);
            return Environment.Tables(reading, new_types, new_ids, new_definitions, new_variants, new_fields, capabilities, capability_fields);
        }
    }
}
Absorb :: pure fn(environment: Environment, result: reader.Reading) -> Members {
    switch result { case .Read(value, has_unit, unit, updated, diagnostics, uses, publications):
        current := environment;
        updates: Update[] = [];
        foreach (plan in publications) {
            current = Append(current, plan);
            updates = array_add(updates, Update.Added(plan));
        }
        switch current { case .Tables(old_reading, types, ids, definitions, variants, fields, capabilities, capability_fields):
            return Members.Built(Environment.Tables(updated, types, ids, definitions, variants, fields, capabilities, capability_fields), updates, diagnostics, uses);
        }
    }
}
Combine :: pure fn(earlier: Members, later: Members) -> Members {
    switch earlier { case .Built(old_environment, old_updates, old_diagnostics, old_uses):
        switch later { case .Built(environment, updates, diagnostics, uses):
            all_updates := old_updates;
            all_diagnostics := old_diagnostics;
            all_uses := old_uses;
            foreach (item in updates) { all_updates = array_add(all_updates, item); }
            foreach (item in diagnostics) { all_diagnostics = array_add(all_diagnostics, item); }
            foreach (item in uses) { all_uses = array_add(all_uses, item); }
            return Members.Built(environment, all_updates, all_diagnostics, all_uses);
        }
    }
}
Errors :: pure fn(result: Members, errors: syntax.Diagnostic[]) -> Members {
    switch result { case .Built(environment, updates, diagnostics, uses):
        all_diagnostics := diagnostics;
        foreach (item in errors) { all_diagnostics = array_add(all_diagnostics, item); }
        return Members.Built(environment, updates, all_diagnostics, uses);
    }
}
OneError :: pure fn(result: Members, tree: reader.Tree, node: int, document: int, message: string) -> Members {
    errors: syntax.Diagnostic[] = [];
    errors = array_add(errors, reader.Diagnostic(tree, node, document, message));
    return Errors(result, errors);
}

Replace :: pure fn(environment: Environment, id: uint64, declared_variants: DeclaredVariant[], declared_fields: DeclaredField[],
                   payload_types: named.Type[], payload_ids: uint64[]) -> Environment {
    switch environment { case .Tables(reading, types, ids, definitions, variants, fields, capabilities, capability_fields):
        new_types := types;
        new_ids := ids;
        new_fields := fields;
        field_start := length(new_fields);
        foreach (item in declared_fields) {
            switch reader.AddType(new_types, new_ids, named.TypeAt(payload_types, payload_ids, item.type)) {
                case .Added(rows, pool, type_index):
                    new_types = rows;
                    new_ids = pool;
                    row: Field = {type: type_index};
                    new_fields = array_add(new_fields, row);
            }
        }
        new_variants := variants;
        variant_start := length(new_variants);
        foreach (item in declared_variants) {
            switch reader.AddType(new_types, new_ids, named.TypeAt(payload_types, payload_ids, item.type)) {
                case .Added(rows, pool, type_index):
                    new_types = rows;
                    new_ids = pool;
                    row: Variant = {type: type_index, tagged: item.tagged,
                        field_start: field_start + item.field_start, field_count: item.field_count};
                    new_variants = array_add(new_variants, row);
            }
        }
        new_definitions := definitions;
        index: int = 0;
        while (index < length(new_definitions)) {
            item := new_definitions[index];
            if (named.IDAt(new_ids, item.id_slot) == id) {
                row: Definition = {id_slot: item.id_slot, field_start: item.field_start, field_count: item.field_count,
                    variant_start: variant_start, variant_count: length(declared_variants)};
                new_definitions[index] = row;
            }
            index += 1;
        }
        switch reading { case .Tables(names, constructor_tables, pointer_size):
            switch constructor_tables { case .Tables(ctor_types, ctor_ids, ctor_definitions, ctor_variants, ctor_capabilities, functions, symbols, results):
                rows := ctor_types;
                pool := ctor_ids;
                alternatives := ctor_variants;
                start := length(alternatives);
                foreach (item in declared_variants) {
                    switch reader.AddType(rows, pool, named.TypeAt(payload_types, payload_ids, item.type)) {
                        case .Added(next_rows, next_pool, type_index):
                            rows = next_rows;
                            tag_slot := length(next_pool);
                            pool = array_add(next_pool, named.IDAt(payload_ids, item.tag_slot));
                            row: constructors.RawVariant = {tag_slot: tag_slot, type: type_index};
                            alternatives = array_add(alternatives, row);
                    }
                }
                definitions_copy := ctor_definitions;
                index = 0;
                while (index < length(definitions_copy)) {
                    item := definitions_copy[index];
                    if (named.IDAt(pool, item.id_slot) == id) {
                        row: constructors.Definition = {id_slot: item.id_slot, variant_start: start, variant_count: length(declared_variants)};
                        definitions_copy[index] = row;
                    }
                    index += 1;
                }
                new_reading := reader.Environment.Tables(names,
                    constructors.Environment.Tables(rows, pool, definitions_copy, alternatives, ctor_capabilities, functions, symbols, results), pointer_size);
                return Environment.Tables(new_reading, new_types, new_ids, new_definitions, new_variants, new_fields, capabilities, capability_fields);
            }
        }
    }
}
BuildUnion :: pure fn(initial: Members, tree: reader.Tree, node: int, scope: int, document: int,
                      union_value: named.Value) -> Members {
    current := initial;
    variants: DeclaredVariant[] = [];
    fields: DeclaredField[] = [];
    types: named.Type[] = [];
    ids: uint64[] = [];
    union_id := uint64(0);
    switch union_value { case .Typed(storage, container, flags, nominal, parameter): union_id = nominal; }
    switch tree { case .Raw(nodes, field_names, named_flags, extra_flags, source):
        child := nodes[node].first_child;
        while (child >= 0) {
            if (named_flags[child] && reader.Kind(tree, child, "union_variant")) {
                literal_node := reader.Field(tree, child, "literal");
                name_node := reader.Field(tree, child, "name");
                if (literal_node >= 0) { name_node = literal_node; }
                switch reader.Name(tree, name_node, document) { case .Name(name, errors):
                    current = Errors(current, errors);
                    tag := binding.ID("union-literal", name);
                    payload := named.Value.Typed(13, 0, 1024, 0, tag);
                    if (literal_node < 0) {
                        key := strings.Slice(format_text("{}:{}", union_id, name), 0, 511);
                        tag = binding.ID("union-variant", key);
                        switch union_value { case .Typed(storage, container, flags, nominal, parameter):
                            payload = named.Value.Typed(storage, container, flags, nominal, tag);
                        }
                    }
                    foreach (item in variants) {
                        if (named.IDAt(ids, item.tag_slot) == tag) {
                            current = OneError(current, tree, child, document, format_text("Duplicate union alternative '{}'", name));
                        }
                    }
                    first_field := length(fields);
                    parameters := reader.Field(tree, child, "parameters");
                    if (parameters >= 0) {
                        parameter_node := nodes[parameters].first_child;
                        while (parameter_node >= 0) {
                            if (named_flags[parameter_node] && !extra_flags[parameter_node]) {
                                token := reader.Field(tree, parameter_node, "name");
                                switch reader.Name(tree, token, document) { case .Name(field_name, field_errors):
                                    current = Errors(current, field_errors);
                                    value := named.Builtin("invalid");
                                    switch current { case .Built(environment, updates, diagnostics, uses):
                                        switch environment { case .Tables(reading, graph_types, graph_ids, definitions, graph_variants, graph_fields, capabilities, capability_fields):
                                            result := reader.Type(reading, tree, reader.Field(tree, parameter_node, "type"), scope, document);
                                            switch result { case .Read(resolved, has_unit, unit, updated, type_errors, type_uses, publications): value = resolved; }
                                            current = Combine(current, Absorb(environment, result));
                                        }
                                    }
                                    switch value { case .Typed(storage, container, flags, nominal, type_parameter):
                                        if ((flags & 20) != 0) {
                                            current = OneError(current, tree, parameter_node, document, "Union payloads require an owned value type");
                                        }
                                    }
                                    switch reader.AddType(types, ids, value) { case .Added(rows, pool, type_index):
                                        types = rows;
                                        id_slot := length(pool);
                                        ids = array_add(pool, binding.ID("union-field", field_name));
                                        row: DeclaredField = {name: field_name, id_slot: id_slot, type: type_index,
                                            offset: length(fields) - first_field, writable: false, has_default: false};
                                        fields = array_add(fields, row);
                                    }
                                }
                            }
                            parameter_node = nodes[parameter_node].next_sibling;
                        }
                    }
                    switch reader.AddType(types, ids, payload) { case .Added(rows, pool, type_index):
                        types = rows;
                        tag_slot := length(pool);
                        ids = array_add(pool, tag);
                        literal := "";
                        if (literal_node >= 0) { literal = name; }
                        row: DeclaredVariant = {name: name, tag_slot: tag_slot, type: type_index,
                            tagged: literal_node < 0, is_literal: literal_node >= 0, literal: literal,
                            field_start: first_field, field_count: length(fields) - first_field};
                        variants = array_add(variants, row);
                    }
                }
            }
            child = nodes[child].next_sibling;
        }
    }
    if (length(variants) == 0) { current = OneError(current, tree, node, document, "A union needs at least one alternative"); }
    switch current { case .Built(environment, updates, diagnostics, uses):
        updated := Replace(environment, union_id, variants, fields, types, ids);
        all_updates := array_add(updates, Update.Replaced(union_id, variants, fields, types, ids));
        return Members.Built(updated, all_updates, diagnostics, uses);
    }
}
Build :: pure fn(environment: Environment, tree: reader.Tree, body: int, scope: int, document: int) -> Members {
    updates: Update[] = [];
    diagnostics: syntax.Diagnostic[] = [];
    uses: named.Use[] = [];
    current := Members.Built(environment, updates, diagnostics, uses);
    if (body < 0) { return current; }
    switch tree { case .Raw(nodes, field_names, named_flags, extra_flags, source):
        child := nodes[body].first_child;
        while (child >= 0) {
            if (named_flags[child] && reader.Kind(tree, child, "union_declaration")) {
                switch current { case .Built(live, current_updates, current_diagnostics, current_uses):
                    switch EligibleUnion(live, tree, child, scope, document) { case .Declaration(symbol, value, errors):
                        current = Errors(current, errors);
                        if (symbol >= 0) { current = BuildUnion(current, tree, child, scope, document, value); }
                    }
                }
            }
            child = nodes[child].next_sibling;
        }
        states: int[] = [];
        switch current { case .Built(live, current_updates, current_diagnostics, current_uses):
            switch live { case .Tables(reading, types, ids, definitions, variants, fields, capabilities, capability_fields):
                states = resize([int(0)], length(definitions));
            }
        }
        child = nodes[body].first_child;
        while (child >= 0) {
            if (named_flags[child] && reader.Kind(tree, child, "union_declaration")) {
                switch current { case .Built(live, current_updates, current_diagnostics, current_uses):
                    switch EligibleUnion(live, tree, child, scope, document) { case .Declaration(symbol, value, errors):
                        current = Errors(current, errors);
                        if (symbol >= 0) {
                            switch live { case .Tables(reading, types, ids, definitions, variants, fields, capabilities, capability_fields):
                                switch reader.AddType(types, ids, value) { case .Added(rows, pool, type_index):
                                    roots: int[] = [type_index];
                                    switch Validate(rows, pool, definitions, variants, fields, roots, states) { case .Checked(root, error, next_states):
                                        states = next_states;
                                        if (error != 0) {
                                            message := "Recursive owned union payloads are not supported";
                                            if (error == 2) { message = "Union payload nesting exceeds the supported depth"; }
                                            return OneError(current, tree, child, document, message);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            child = nodes[child].next_sibling;
        }
    }
    return current;
}
