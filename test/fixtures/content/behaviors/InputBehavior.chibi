InputBehavior :: behavior {
    import_component_write_1 :: (import_arg_0: Velocity) -> (Value: Velocity) {
        self.Velocity = import_arg_0
        return import_arg_0
    }

    action set_gamevelocity = import_component_write_1(MovementActions.Movement_Velocity(input.Direction, self.Movement))
    on Input as input {
        if self.Dash {
            if 0.0 < self.Dash.remaining {
            } else {
                set_gamevelocity()
            }
        } else {
            set_gamevelocity()
        }
    }
    after set_gamevelocity {
        await Face_Direction(input.Direction)
    }
    Face_Direction :: (Direction: struct<CF_V2> = null) {
        if self.Orientation {
            if 0.0 >= abs(Direction.x) + abs(Direction.y) {
                return
            } else {
                self.Orientation = DirectionMath.Direction_Orientation(Direction.x, Direction.y)
                return
            }
        } else {
            return
        }
    }
}
