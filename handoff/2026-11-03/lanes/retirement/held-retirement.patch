-    }
-    if (!authored) {
-        return NULL;
-    }
-    struct prepared_record_cache *cache = &c->records[index];
-    if (w->storage == &c->plan->storage) {
-        return type->record;
-    }
-    if (cache->owner != w->storage) {
-        cache->owned = copy_record(c, type->record, cache->validation_work);
