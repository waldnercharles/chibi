<div class="outliner-panel">
  <use ui="List" id="outliner-list" data-drop="prototype" data-event-drop="emit('outliner.drop', '', ev.type, ev.payload)" data-event-scroll="emit('outliner.scroll')">
    <use ui="TreeRow" class="outliner-root" data-if="view.root" data-alias-item="outliner.root" data-event-dblclick="emit('outliner.collapse')"><span class="meta">{{ outliner.count }}</span><div class="view-toggles"></div></use>
    <div class="outliner-row" data-for="row : view.rows">
      <use ui="TreeRow" data-when="!row.renaming" data-alias-item="row" data-attr-data-id="row.id" data-attr-data-drop="row.drop" data-event-drop="emit('outliner.drop', row.id, ev.type, ev.payload)" data-event-click="emit('outliner.click', row.id)" data-event-dblclick="emit('studio.rename')" data-event-contextmenu="emit('outliner.menu', row.id)">
        <div class="inline row" data-if="row.behaviors != ''"><span class="icon">&#xebb9;</span><span class="meta">{{ row.behaviors }}</span></div>
        <div class="view-toggles">
          <button class="btn icon-only toggle" data-attr-data-state="row.hidden ? 'on' : ''" data-attr-data-tip="row.hidden ? 'Show in Editor' : 'Hide in Editor'" data-attr-data-kbd="row.hidden ? commands.showAll.shortcut : commands.hideSelected.shortcut" data-attr-data-tip-about="outliner.isolate" data-event-click="emit('outliner.eye', row.id); stopPropagation()" data-event-dblclick="stopPropagation()"><span class="icon">{{ row.hidden ? '&#xeae7;' : '&#xea70;' }}</span></button>
          <button class="btn icon-only toggle" data-attr-data-state="row.locked ? 'on' : ''" data-attr-data-tip="row.locked ? 'Unlock' : 'Lock'" data-tip-about="A locked object can't be picked in the Scene" data-event-click="emit('outliner.lock', row.id); stopPropagation()" data-event-dblclick="stopPropagation()"><span class="icon">{{ row.locked ? '&#xea75;' : '&#xeb74;' }}</span></button>
        </div>
      </use>
      <div class="tree-row object-rename" data-when="row.renaming">
        <span class="icon">{{ row.icon }}</span>
        <div class="field text"><input type="text" class="part value" autofocus="" data-value-lazy="outliner.rename" data-event-change="emit('outliner.rename', ev.value)" data-keys="Enter:outliner.renameEnter Escape:outliner.renameCancel"/></div>
      </div>
    </div>
  </use>
  <div class="outliner-empty" data-if="outliner.empty != ''">{{ outliner.empty }}</div>
  <use ui="Menu" id="outliner-menu">
    <use ui="MenuGroup" data-alias-group="outliner.menu"/>
    <use ui="MenuCommand" data-alias-command="commands.frame"/>
    <use ui="MenuCommand" data-alias-command="commands.duplicate"/>
    <use ui="MenuCommand" data-alias-command="commands.rename"/>
    <use ui="MenuSeparator"/>
    <use ui="MenuCommand" data-alias-command="commands.cut"/>
    <use ui="MenuCommand" data-alias-command="commands.copy"/>
    <use ui="MenuCommand" data-alias-command="commands.paste"/>
    <use ui="MenuSeparator"/>
    <use ui="MenuItem" data-alias-item="outliner.menu.prototype" data-event-click="emit('outliner.openPrototype')"/>
    <use ui="MenuItem" data-if="outliner.menu.actor" data-alias-item="outliner.menu.spawnBreak" data-event-click="emit('outliner.spawnBreak')"/>
    <use ui="MenuCommand" data-if="outliner.menu.live" data-alias-command="commands.keepChanges"/>
    <use ui="MenuCommand" data-if="!outliner.menu.live" data-alias-command="commands.applyOverrides"/>
    <use ui="MenuCommand" data-if="!outliner.menu.live" data-alias-command="commands.saveAsPrototype"/>
    <use ui="MenuCommand" data-alias-command="commands.hideSelected"/>
    <use ui="MenuSeparator"/>
    <use ui="MenuCommand" data-alias-command="commands.delete"/>
  </use>
</div>
