// Scene-linear HDR to display: bloom, exposure, then the Environment's tone map.
// Auto exposure moves the adapted mean log2 luminance to middle gray.
layout(set = 2, binding = 1) uniform sampler2D bloom_low;
layout(set = 2, binding = 2) uniform sampler2D bloom_high;
layout(set = 2, binding = 3) uniform sampler2D adapted;
layout(set = 3, binding = 1) uniform shd_uniforms {
    float exposure;
    float strength;
    float level_mix;
    int auto_exposure;
    int tone_mapping;
};

#include "tonemap.shd"

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 uv = params.uv;
    vec3 scene = finite_hdr(texture(u_image, uv).rgb);
    vec3 bloom = vec3(0);
    if (strength > 0.0) {
        bloom = mix(finite_hdr(texture(bloom_low, uv).rgb), finite_hdr(texture(bloom_high, uv).rgb), level_mix);
    }
    float ev = exposure;
    if (auto_exposure != 0) {
        vec4 stored = texelFetch(adapted, ivec2(0), 0);
        ev += log2(0.18) - (stored.r + stored.g);
    }
    vec3 hdr = (scene + bloom * strength) * exp2(ev);
    vec3 mapped = tone_mapping == 0 ? agx(hdr) : srgb_encode(pbr_neutral(hdr));
    return vec4(clamp(mapped, vec3(0), vec3(1)), 1);
}
