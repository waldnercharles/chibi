version 3
name "RainParticles"
domain "shader-library"
id_counter 60000
description "A 16-column falling lattice. Index selects the column and row; each drop wraps vertically using the explicit field clock. This scene uses no game rules or simulation particles."
(array)graphs {
    - kind="event" name="Functions"
    - {
        id 1
        kind "function"
        name "Fall"
        entry_id 10
        return_id 100
        call_depth_limit 64
        (array)nodes {
            - {
                id 10
                type "Function Entry"
                (array)outputs {
                    - id=11 name="Index" type="number" kind="data"
                    - id=12 name="Count" type="number" kind="data"
                    - id=13 name="Seed" type="number" kind="data"
                    - id=14 name="Spacing" type="number" kind="data" default=6.0
                    - id=15 name="Height" type="number" kind="data" default=25.0
                    - id=16 name="Speed" type="number" kind="data" default=0.2
                    - id=17 name="DropSize" type="number" kind="data" default=1.0
                    - {
                        id 18
                        name "Tint"
                        type "struct"
                        type_name "ShaderVec4"
                        kind "data"
                        default x=0.35 y=0.7 z=1.3 w=0.85
                    }
                }
            }
            - {
                id 100
                type "Return"
                (array)inputs {
                    - id=101 name="Position" type="struct" type_name="ShaderVec3" kind="data"
                    - id=102 name="Size" type="number" kind="data"
                    - id=103 name="Color" type="struct" type_name="ShaderVec4" kind="data"
                }
            }
            - {
                id 200
                type "Behavior Expression"
                reference_name "vec3((fract(index / 16) * 16 - 7.5) * spacing, (fract(index / max(count, 1) + seed * 0.173 - time * speed) * 2 - 1) * height, (index / 16 - fract(index / 16) - 3.5) * spacing)"
                inputs {
                    index id=201 type="number"
                    count id=202 type="number"
                    seed id=203 type="number"
                    time id=204 type="number"
                    spacing id=205 type="number"
                    height id=206 type="number"
                    speed id=207 type="number"
                }
                outputs {
                    Result id=208 type="struct" type_name="ShaderVec3"
                }
            }
            - id=300 type="Shader Time"
        }
        (array)edges {
            - from="10.Index" to="200.index"
            - from="10.Count" to="200.count"
            - from="10.Seed" to="200.seed"
            - from="10.Spacing" to="200.spacing"
            - from="10.Height" to="200.height"
            - from="10.Speed" to="200.speed"
            - from="10.DropSize" to="100.Size"
            - from="10.Tint" to="100.Color"
            - from="200.Result" to="100.Position"
            - from="300.Value" to="200.time"
        }
    }
    - id=1000 kind="function" math_expression="vec3((fract(index / 16) * 16 - 7.5) * spacing, (fract(index / max(count, 1) + seed * 0.173 - time * speed) * 2 - 1) * height, (index / 16 - fract(index / 16) - 3.5) * spacing)" expression_mode=1 entry_id=50000
}
