-            return sign && (int64_t)x == low && (int64_t)y == -1 &&
-                           (i->op == BF_DIV || i->target >= 0)
-                     ? EXECUTION_INTEGER_OVERFLOW
-                     : -1;
-        default: assert(false); return -1;
-    }
