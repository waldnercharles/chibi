package sdk

import strings "core:strings"

// Compatibility output for CMake consumers. Construction and installation stay
// in the authored SDK route; these files describe an already installed prefix.
// No source/build path, CMake invocation or configured CMake input is consumed.
CMakeJoin :: (parts: string[]) -> string {
    return strings.Join(parts, "");
}

PropertyName :: (property: string) -> string {
    at := strings.Index(property, "=");
    if (at < 0) {
        return "";
    }
    return strings.Slice(property, 0, at);
}
PropertyValue :: (property: string) -> string {
    at := strings.Index(property, "=");
    if (at < 0) {
        return "";
    }
    return strings.Slice(property, at + 1, strings.ByteLength(property));
}
CMakeQuoted :: (value: string) -> string {
    return strings.ReplaceAll(strings.ReplaceAll(value, "\\", "\\\\"), "\"", "\\\"");
}
PropertyLine :: (target: string, property: string, prefix_variable: string) -> string {
    value := strings.ReplaceAll(CMakeQuoted(PropertyValue(property)), "@prefix", CMakeJoin(["${", prefix_variable, "}"]));
    return CMakeJoin(["set_property(TARGET Chibi::", target, " PROPERTY ", PropertyName(property), " \"", value, "\")"]);
}

// Names may already be imported by an earlier find_package call. A partial set
// is a contract error; a complete set needs no redeclaration.
ImportGuard :: (names: string[]) -> string[] {
    targets: string[] = [];
    for (name in names) {
        targets.append(CMakeJoin(["Chibi::", name]));
    }
    return [
        CMakeJoin(["set(_chibi_expected \"", strings.Join(targets, ";"), "\")"]),
        "set(_chibi_defined \"\")",
        "set(_chibi_missing \"\")",
        "foreach(_chibi_target IN LISTS _chibi_expected)",
        "    if(TARGET ${_chibi_target})",
        "        list(APPEND _chibi_defined ${_chibi_target})",
        "    else()",
        "        list(APPEND _chibi_missing ${_chibi_target})",
        "    endif()",
        "endforeach()",
        "if(_chibi_defined AND _chibi_missing)",
        "    message(FATAL_ERROR \"Only part of the Chibi import contract is defined: ${_chibi_missing}\")",
        "endif()",
        "if(NOT _chibi_missing)",
        "    return()",
        "endif()"
    ];
}

// The platform overrides replace complete properties, preserving link order.
ConsumerProperties :: (name: string, platform: string) -> string[] {
    result: string[] = [];
    overrides := PlatformProperties(name, platform);
    for (property in Properties(name)) {
        selected := property;
        for (override in overrides) {
            if (PropertyName(property) == PropertyName(override)) {
                selected = override;
            }
        }
        result.append(selected);
    }
    return result;
}

pub Targets :: (platform: string) -> string {
    if (!Supported(platform)) {
        return "";
    }
    names := RuntimeTargets();
    lines := ["# Generated by the Chibi SDK contract."];
    lines.extend(ImportGuard(names));
    lines.append("get_filename_component(_IMPORT_PREFIX \"${CMAKE_CURRENT_LIST_DIR}/../../..\" ABSOLUTE)");
    for (name in names) {
        kind := "STATIC";
        if (Interface(name)) {
            kind = "INTERFACE";
        }
        lines.append(CMakeJoin(["add_library(Chibi::", name, " ", kind, " IMPORTED)"]));
    }
    for (name in names) {
        archive := Library(name);
        if (archive != "") {
            lines.append(PropertyLine(name, CMakeJoin(["IMPORTED_LOCATION=@prefix/", archive]), "_IMPORT_PREFIX"));
            language := "C";
            if (name == "ui") {
                language = "C;CXX";
            }
            if (name == "render" && platform == "Darwin") {
                language = "C;OBJC";
            }
            lines.append(PropertyLine(name, CMakeJoin(["IMPORTED_LINK_INTERFACE_LANGUAGES=", language]), "_IMPORT_PREFIX"));
        }
        for (property in ConsumerProperties(name, platform)) {
            lines.append(PropertyLine(name, property, "_IMPORT_PREFIX"));
        }
    }
    for (name in names) {
        archive := Library(name);
        if (archive != "") {
            lines.extend([
                CMakeJoin(["if(NOT EXISTS \"${_IMPORT_PREFIX}/", archive, "\")"]),
                CMakeJoin(["    message(FATAL_ERROR \"Installed Chibi archive is missing: ", archive, "\")"]),
                "endif()"
            ]);
        }
    }
    lines.append("unset(_IMPORT_PREFIX)");
    return CMakeJoin([strings.Join(lines, "\n"), "\n"]);
}

// This is the explicit macOS vendor contract. Linux must supply and validate its
// own system library roles before Supported can admit it.
pub Vendor :: (platform: string) -> string {
    if (!Supported(platform)) {
        return "";
    }
    names := VendorTargets(platform);
    lines := ["# Generated by the Chibi SDK vendor contract."];
    lines.extend(ImportGuard(names));
    lines.extend([
        "include(CMakeFindDependencyMacro)",
        "find_dependency(Threads)",
        "get_filename_component(_chibi_vendor_prefix \"${CMAKE_CURRENT_LIST_DIR}/../../..\" ABSOLUTE)"
    ]);
    for (name in names) {
        kind := "STATIC";
        if (VendorLibrary(name, platform) == "") {
            kind = "INTERFACE";
        }
        lines.append(CMakeJoin(["add_library(Chibi::", name, " ", kind, " IMPORTED)"]));
    }
    for (name in names) {
        archive := VendorLibrary(name, platform);
        if (archive != "") {
            lines.append(PropertyLine(name, CMakeJoin(["IMPORTED_LOCATION=@prefix/", archive]), "_chibi_vendor_prefix"));
        }
        if (name == "vendor_enkits") {
            lines.append(PropertyLine(name, "IMPORTED_LINK_INTERFACE_LANGUAGES=CXX", "_chibi_vendor_prefix"));
        }
        for (property in VendorProperties(name, platform)) {
            lines.append(PropertyLine(name, property, "_chibi_vendor_prefix"));
        }
        if (archive != "") {
            lines.extend([
                CMakeJoin(["if(NOT EXISTS \"${_chibi_vendor_prefix}/", archive, "\")"]),
                CMakeJoin(["    message(FATAL_ERROR \"Installed Chibi vendor archive is missing: ", archive, "\")"]),
                "endif()"
            ]);
        }
    }
    lines.append("unset(_chibi_vendor_prefix)");
    return CMakeJoin([strings.Join(lines, "\n"), "\n"]);
}

CMakeVersionValid :: (version: string) -> bool {
    parts := strings.Split(version, ".");
    if (length(parts) != 3) {
        return false;
    }
    for (part in parts) {
        if (part == "") {
            return false;
        }
        for (byte in strings.Bytes(part)) {
            if (byte < 48 || byte > 57) {
                return false;
            }
        }
    }
    return true;
}

pub Config :: (version: string, platform: string, pointer_bits: int) -> string {
    if (!Supported(platform) || !CMakeVersionValid(version) || (pointer_bits != 32 && pointer_bits != 64)) {
        return "";
    }
    lines := [
        "# Generated by the Chibi SDK contract.",
        "get_filename_component(PACKAGE_PREFIX_DIR \"${CMAKE_CURRENT_LIST_DIR}/../../..\" ABSOLUTE)",
        CMakeJoin(["set(Chibi_VERSION \"", version, "\")"]),
        CMakeJoin(["set(Chibi_SYSTEM \"", platform, "\")"]),
        format_text("set(Chibi_POINTER_BITS {0})", pointer_bits),
        "if(CMAKE_SYSTEM_NAME AND NOT CMAKE_SYSTEM_NAME STREQUAL Chibi_SYSTEM)",
        "    set(Chibi_FOUND FALSE)",
        "    set(Chibi_NOT_FOUND_MESSAGE \"The installed Chibi SDK is for ${Chibi_SYSTEM}\")",
        "    return()",
        "endif()",
        "if(CMAKE_SIZEOF_VOID_P)",
        "    math(EXPR _chibi_pointer_bits \"${CMAKE_SIZEOF_VOID_P} * 8\")",
        "    if(NOT _chibi_pointer_bits EQUAL Chibi_POINTER_BITS)",
        "        set(Chibi_FOUND FALSE)",
        "        set(Chibi_NOT_FOUND_MESSAGE \"The installed Chibi SDK uses ${Chibi_POINTER_BITS}-bit pointers\")",
        "        return()",
        "    endif()",
        "endif()",
        "set(Chibi_WEB_THREADS OFF)",
        "set(Chibi_WEB_WORKERS 4)",
        "include(\"${CMAKE_CURRENT_LIST_DIR}/ChibiVendorDependencies.cmake\")",
        "include(\"${CMAKE_CURRENT_LIST_DIR}/ChibiTargets.cmake\")",
        "set(Chibi_RESOURCE_DIR \"${PACKAGE_PREFIX_DIR}/share/chibi\")",
        "set(Chibi_CORE_SOURCE_DIR \"${Chibi_RESOURCE_DIR}/core\")"
    ];
    for (name in RuntimeTargets()) {
        lines.append(CMakeJoin(["set(Chibi_", name, "_FOUND TRUE)"]));
    }
    lines.extend([
        "foreach(_chibi_component IN LISTS Chibi_FIND_COMPONENTS)",
        "    if(NOT TARGET Chibi::${_chibi_component})",
        "        set(Chibi_${_chibi_component}_FOUND FALSE)",
        "        if(Chibi_FIND_REQUIRED_${_chibi_component})",
        "            set(Chibi_FOUND FALSE)",
        "            set(Chibi_NOT_FOUND_MESSAGE \"Required Chibi component '${_chibi_component}' is unavailable in this SDK configuration\")",
        "        endif()",
        "    endif()",
        "endforeach()"
    ]);
    return CMakeJoin([strings.Join(lines, "\n"), "\n"]);
}

pub ConfigVersion :: (version: string, pointer_bits: int) -> string {
    if (!CMakeVersionValid(version) || (pointer_bits != 32 && pointer_bits != 64)) {
        return "";
    }
    lines := [
        "# Generated by the Chibi SDK contract. Exact version compatibility.",
        CMakeJoin(["set(PACKAGE_VERSION \"", version, "\")"]),
        "set(PACKAGE_VERSION_COMPATIBLE FALSE)",
        "set(PACKAGE_VERSION_EXACT FALSE)",
        "if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)",
        "    set(PACKAGE_VERSION_COMPATIBLE TRUE)",
        "endif()",
        "if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)",
        "    set(PACKAGE_VERSION_EXACT TRUE)",
        "endif()",
        "if(CMAKE_SIZEOF_VOID_P)",
        format_text("    if(NOT CMAKE_SIZEOF_VOID_P EQUAL {0})", pointer_bits / 8),
        CMakeJoin(["        set(PACKAGE_VERSION \"${PACKAGE_VERSION} (", format_text("{0}", pointer_bits), "bit)\")"]),
        "        set(PACKAGE_VERSION_UNSUITABLE TRUE)",
        "    endif()",
        "endif()"
    ];
    return CMakeJoin([strings.Join(lines, "\n"), "\n"]);
}
