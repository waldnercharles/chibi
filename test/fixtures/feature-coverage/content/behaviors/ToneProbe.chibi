ToneProbe :: behavior {
    on Begin :: () {
        set_audio_source(0)
        await play_tone(440.0, 220.0, 0.1, 0.2, 0.0, 0.0)
        await set_master_volume(0.8)
        await set_sound_volume(0.5)
        await set_music_volume(0.5)
        await play_sound("Tone")
        await play_music("Tone")
        await stop_music()
    }

    on Tick :: () {
        signal := get_audio_analysis()
        print_string(format_text("Audio {} {}", signal.Bass, signal.Treble))
    }
}
