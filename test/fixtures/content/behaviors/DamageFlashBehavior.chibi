behavior "DamageFlashBehavior" {
    action set_material_parameter = engine["Set Material Parameter"](engine["Self"](), "Flash", Value: float = 3.0)
    on Begin {
        set_material_parameter()
    }
    on Damage {
        set_material_parameter()
    }
    after set_material_parameter {
        await delay(0.18)
        engine["Set Material Parameter"](engine["Self"](), "Flash", Value: float = 0.0)
    }
}
