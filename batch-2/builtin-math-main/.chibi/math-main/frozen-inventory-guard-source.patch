index 000000000..8a42d1b05
--- /dev/null
+++ b/tools/compiler/math_types/Functions.chibi
@@ -0,0 +1,113 @@
+package math_types
+
+// Accepted describes the success payload only. Recoverable operations still
+// need the language's agreed error-result adapter at the compiler boundary.
+// This package does not choose a public optional, union or multi-result ABI.
+pub Recoverable :: (name: string) -> bool {
+    return name == "normalize" || name == "normalize_or" || name == "inverse" || name == "quat_normalize";
+}
+
+UnaryMemberwise :: (name: string) -> bool {
+    return name == "abs" || name == "sign" || name == "floor" || name == "ceil" ||
+           name == "round" || name == "fract" || name == "sqrt" || name == "exp" ||
+           name == "exp2" || name == "log" || name == "log2" || name == "sin" ||
+           name == "cos" || name == "tan" || name == "asin" || name == "acos" ||
+           name == "atan" || name == "saturate";
+}
+BinaryMemberwise :: (name: string) -> bool {
+    return name == "mod" || name == "min" || name == "max" || name == "pow" ||
+           name == "atan2" || name == "step";
+}
+TernaryMemberwise :: (name: string) -> bool {
+    return name == "clamp" || name == "mix" || name == "smoothstep";
+}
+
+Memberwise :: (arguments: int[]) -> Result {
+    kind := Scalar;
+    for (argument in arguments) {
+        problem := ScalarError(argument);
+        if (problem != "") {
+            return Result.Rejected(problem);
+        }
+        if (argument != Scalar && !IsVector(argument)) {
+            return Result.Rejected("memberwise math functions take f32 scalars and vectors");
+        }
+        if (IsVector(argument)) {
+            if (kind != Scalar && kind != argument) {
+                return Result.Rejected("memberwise math operands differ in vector width");
+            }
+            kind = argument;
+        }
+    }
+    return Result.Accepted(kind);
+}
+
+pub Function :: (name: string, arguments: int[]) -> Result {
+    arity: int = 0;
+    if (UnaryMemberwise(name)) {
+        arity = 1;
+    } else if (BinaryMemberwise(name)) {
+        arity = 2;
+    } else if (TernaryMemberwise(name)) {
+        arity = 3;
+    }
+    if (arity != 0) {
+        if (length(arguments) != arity) {
+            return Result.Rejected(format_text("{} needs {} arguments", name, arity));
+        }
+        return Memberwise(arguments);
+    }
+    if (name == "length" || name == "normalize" || name == "normalize_or_zero") {
+        if (length(arguments) != 1 || !IsVector(arguments[0])) {
+            return Result.Rejected(format_text("{} takes one vector", name));
+        }
+        if (name == "length") {
+            return Result.Accepted(Scalar);
+        }
+        return Result.Accepted(arguments[0]);
+    }
+    if (name == "distance" || name == "dot" || name == "reflect" || name == "normalize_or") {
+        if (length(arguments) != 2 || !IsVector(arguments[0]) || arguments[0] != arguments[1]) {
+            return Result.Rejected(format_text("{} takes two vectors of one width", name));
+        }
+        if (name == "distance" || name == "dot") {
+            return Result.Accepted(Scalar);
+        }
+        return Result.Accepted(arguments[0]);
+    }
+    if (name == "cross") {
+        if (length(arguments) != 2 || arguments[0] != Vec3 || arguments[1] != Vec3) {
+            return Result.Rejected("cross takes two vec3 operands");
+        }
+        return Result.Accepted(Vec3);
+    }
+    if (name == "refract") {
+        if (length(arguments) != 3 || !IsVector(arguments[0]) || arguments[0] != arguments[1] ||
+            arguments[2] != Scalar) {
+            return Result.Rejected("refract takes two vectors of one width and an f32 ratio");
+        }
+        return Result.Accepted(arguments[0]);
+    }
+    if (name == "transpose" || name == "determinant" || name == "inverse") {
+        if (length(arguments) != 1 || !IsMatrix(arguments[0])) {
+            return Result.Rejected(format_text("{} takes one matrix", name));
+        }
+        if (name == "determinant") {
+            return Result.Accepted(Scalar);
+        }
+        return Result.Accepted(arguments[0]);
+    }
+    if (name == "matrix_comp_mult") {
+        if (length(arguments) != 2 || !IsMatrix(arguments[0]) || arguments[0] != arguments[1]) {
+            return Result.Rejected("matrix_comp_mult takes two matrices of one width");
+        }
+        return Result.Accepted(arguments[0]);
+    }
+    if (name == "quat_conjugate" || name == "quat_normalize") {
+        if (length(arguments) != 1 || arguments[0] != Quat) {
+            return Result.Rejected(format_text("{} takes one quaternion", name));
+        }
+        return Result.Accepted(Quat);
+    }
+    return Result.Rejected(format_text("unknown built-in math function '{}'", name));
+}
diff --git a/tools/compiler/math_types/Types.chibi b/tools/compiler/math_types/Types.chibi
new file mode 100644
index 000000000..f47672f39
--- /dev/null
+++ b/tools/compiler/math_types/Types.chibi
@@ -0,0 +1,293 @@
+package math_types
+
+import strings "core:strings"
+
+// These are source math categories, not catalog, storage or bytecode IDs.
+// Callers canonicalize aliases and resolve contextual literals/conversions
+// before asking this package to check an operation. Scalar means f32 only.
+pub Unknown: int : 0;
+pub Scalar: int : 1;
+pub Vec2: int : 2;
+pub Vec3: int : 3;
+pub Vec4: int : 4;
+pub Quat: int : 5;
+pub Mat2: int : 6;
+pub Mat3: int : 7;
+pub Mat4: int : 8;
+pub Double: int : 9;
+pub Integer: int : 10;
+pub Boolean: int : 11;
+
+pub Result :: union {
+    Accepted(kind: int) | Rejected(message: string)
+}
+pub SwizzleResult :: union {
+    Accepted(kind: int, components: int[]) | Rejected(message: string)
+}
+
+pub Kind :: (name: string) -> int {
+    if (name == "number" || name == "f32") {
+        return Scalar;
+    }
+    if (name == "vec2") {
+        return Vec2;
+    }
+    if (name == "vec3") {
+        return Vec3;
+    }
+    if (name == "vec4") {
+        return Vec4;
+    }
+    if (name == "quat") {
+        return Quat;
+    }
+    if (name == "mat2") {
+        return Mat2;
+    }
+    if (name == "mat3") {
+        return Mat3;
+    }
+    if (name == "mat4") {
+        return Mat4;
+    }
+    if (name == "f64") {
+        return Double;
+    }
+    if (name == "bool") {
+        return Boolean;
+    }
+    if (name == "int" || name == "i8" || name == "u8" || name == "i16" || name == "u16" ||
+        name == "i32" || name == "u32" || name == "i64" || name == "u64") {
+        return Integer;
+    }
+    return Unknown;
+}
+pub Name :: (kind: int) -> string {
+    if (kind == Scalar) {
+        return "number";
+    }
+    if (kind == Vec2) {
+        return "vec2";
+    }
+    if (kind == Vec3) {
+        return "vec3";
+    }
+    if (kind == Vec4) {
+        return "vec4";
+    }
+    if (kind == Quat) {
+        return "quat";
+    }
+    if (kind == Mat2) {
+        return "mat2";
+    }
+    if (kind == Mat3) {
+        return "mat3";
+    }
+    if (kind == Mat4) {
+        return "mat4";
+    }
+    if (kind == Double) {
+        return "f64";
+    }
+    if (kind == Integer) {
+        return "an integer";
+    }
+    if (kind == Boolean) {
+        return "bool";
+    }
+    return "an unsupported type";
+}
+pub IsVector :: (kind: int) -> bool {
+    return kind >= Vec2 && kind <= Vec4;
+}
+pub IsMatrix :: (kind: int) -> bool {
+    return kind >= Mat2 && kind <= Mat4;
+}
+pub Width :: (kind: int) -> int {
+    if (IsVector(kind)) {
+        return kind;
+    }
+    if (IsMatrix(kind)) {
+        return kind - Mat2 + 2;
+    }
+    return 0;
+}
+pub Components :: (kind: int) -> int {
+    if (kind == Scalar) {
+        return 1;
+    }
+    if (kind == Quat) {
+        return 4;
+    }
+    width := Width(kind);
+    if (IsMatrix(kind)) {
+        return width * width;
+    }
+    return width;
+}
+ScalarError :: (kind: int) -> string {
+    if (kind == Double) {
+        return "math components require explicit f32(value) narrowing from f64";
+    }
+    if (kind == Integer) {
+        return "math components need a resolved f32 value; convert the integer with f32(value)";
+    }
+    return "";
+}
+
+// Empty text accepts the constructor. A single f32 splats a vector or
+// initializes a matrix diagonal. Other scalar/vector arguments fill in
+// component order, column-first for a matrix. Quaternions take four scalars.
+pub Constructor :: (kind: int, arguments: int[], positional: bool) -> string {
+    if (!IsVector(kind) && !IsMatrix(kind) && kind != Quat) {
+        return "constructor needs a built-in vector, quaternion or matrix type";
+    }
+    if (!positional) {
+        return "built-in math constructors take positional arguments";
+    }
+    supplied: int = 0;
+    for (argument in arguments) {
+        problem := ScalarError(argument);
+        if (problem != "") {
+            return problem;
+        }
+        if (argument == Scalar) {
+            supplied += 1;
+        } else if (IsVector(argument) && kind != Quat) {
+            supplied += Components(argument);
+        } else {
+            if (kind == Quat) {
+                return "quat takes four f32 components in x, y, z, w order";
+            }
+            return "vector and matrix constructors take f32 scalars and vectors";
+        }
+    }
+    if (kind != Quat && length(arguments) == 1 && arguments[0] == Scalar) {
+        return "";
+    }
+    if (supplied != Components(kind)) {
+        return format_text("{} needs {} components; these arguments supply {}", Name(kind), Components(kind), supplied);
+    }
+    return "";
+}
+
+// Accepted is the successful payload kind, not an error-result ABI.
+// Scalar math belongs to the numeric checker. This entry checks operations
+// involving at least one built-in vector, quaternion or matrix. The caller
+// must also inspect BinaryRecoverable before constructing the result type.
+pub BinaryRecoverable :: (operator: string, left: int, right: int) -> bool {
+    return operator == "*" && left == Quat && right == Vec3;
+}
+pub Binary :: (operator: string, left: int, right: int) -> Result {
+    problem := ScalarError(left);
+    if (problem == "") {
+        problem = ScalarError(right);
+    }
+    if (problem != "") {
+        return Result.Rejected(problem);
+    }
+    if (operator == "==" || operator == "!=") {
+        if (left == right && (IsVector(left) || IsMatrix(left) || left == Quat)) {
+            return Result.Accepted(Boolean);
+        }
+        return Result.Rejected("math equality requires operands of the same built-in type");
+    }
+    if (left == Quat || right == Quat) {
+        if (operator == "*" && left == Quat && (right == Quat || right == Vec3)) {
+            return Result.Accepted(right);
+        }
+        return Result.Rejected("quat supports quaternion composition and quat * vec3 rotation");
+    }
+    if (operator != "+" && operator != "-" && operator != "*" && operator != "/") {
+        return Result.Rejected("math values support + - * / == and !=; compare components instead");
+    }
+    if (IsVector(left) && right == Scalar) {
+        return Result.Accepted(left);
+    }
+    if (left == Scalar && IsVector(right)) {
+        return Result.Accepted(right);
+    }
+    if (IsVector(left) && left == right) {
+        return Result.Accepted(left);
+    }
+    if (IsMatrix(left) && right == Scalar && (operator == "*" || operator == "/")) {
+        return Result.Accepted(left);
+    }
+    if (left == Scalar && IsMatrix(right) && operator == "*") {
+        return Result.Accepted(right);
+    }
+    if (IsMatrix(left) && left == right && (operator == "+" || operator == "-" || operator == "*")) {
+        return Result.Accepted(left);
+    }
+    if (IsMatrix(left) && IsVector(right) && operator == "*" && Width(left) == Width(right)) {
+        return Result.Accepted(right);
+    }
+    if (IsVector(left) && IsMatrix(right) && operator == "*") {
+        return Result.Rejected("a matrix multiplies a column vector on its right; write matrix * vector");
+    }
+    return Result.Rejected(format_text("cannot apply {} to {} and {}", operator, Name(left), Name(right)));
+}
+pub Negate :: (kind: int) -> Result {
+    if (IsVector(kind) || IsMatrix(kind)) {
+        return Result.Accepted(kind);
+    }
+    return Result.Rejected("unary math negation needs a vector or matrix");
+}
+
+Component :: (byte: int) -> int {
+    if (byte == 120 || byte == 114) {
+        return 0;
+    }
+    if (byte == 121 || byte == 103) {
+        return 1;
+    }
+    if (byte == 122 || byte == 98) {
+        return 2;
+    }
+    if (byte == 119 || byte == 97) {
+        return 3;
+    }
+    return -1;
+}
+PositionAlphabet :: (byte: int) -> bool {
+    return byte == 120 || byte == 121 || byte == 122 || byte == 119;
+}
+pub Swizzle :: (kind: int, member: string, writable: bool) -> SwizzleResult {
+    if (!IsVector(kind)) {
+        return SwizzleResult.Rejected("swizzles require a vector");
+    }
+    count := strings.ByteLength(member);
+    if (count < 1 || count > 4) {
+        return SwizzleResult.Rejected("a swizzle needs one to four components");
+    }
+    position := PositionAlphabet(strings.ByteAt(member, 0));
+    components: int[] = [];
+    seen: int = 0;
+    index: int = 0;
+    while (index < count) {
+        byte := strings.ByteAt(member, index);
+        component := Component(byte);
+        if (component < 0) {
+            return SwizzleResult.Rejected("swizzles use xyzw or rgba components");
+        }
+        if (PositionAlphabet(byte) != position) {
+            return SwizzleResult.Rejected("a swizzle cannot mix xyzw and rgba components");
+        }
+        if (component >= Width(kind)) {
+            return SwizzleResult.Rejected(format_text("{} has no component '{}'", Name(kind), strings.Slice(member, index, 1)));
+        }
+        bit := 1 << u32(component);
+        if (writable && (seen & bit) != 0) {
+            return SwizzleResult.Rejected("a writable swizzle cannot repeat a destination component");
+        }
+        seen |= bit;
+        components.append(component);
+        index += 1;
+    }
+    result: int = Scalar;
+    if (count > 1) {
+        result = count;
+    }
+    return SwizzleResult.Accepted(result, components);
+}
