                reference_name "x = -60 * cos(elapsed * (2 * pi / 8))"
                inputs {
                    Exec id=86 kind="exec"
                    x {
                        id 83
                        type "float"
                        binding kind="component_field" component="GAME.GameTransform" field="x"
                    }
                    elapsed {
                        id 84
                        type "double"
                        binding kind="variable" source_asset="SdfSuzanneOppositeCircle" name="elapsed"
                    }
                }
                outputs {
                    Then id=87 kind="exec"
