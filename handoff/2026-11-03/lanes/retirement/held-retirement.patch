-    sha256_begin(&hash);
-    unsigned char *buffer = xmalloc(BUILD_IO_COPY_CHUNK);
-    while (!(error = io_ready(deadline, cancelled))) {
-        ssize_t count = read(fd, buffer, BUILD_IO_COPY_CHUNK);
-        if (count < 0 && errno == EINTR) {
-            continue;
-        }
-        if (count < 0) {
-            error = "build file hash failed";
-        }
-        if (count <= 0) {
-            break;
