@@ -113,6 +114,27 @@ bool DataViewAttributeIf::Update(DataModel& model)
 
 DataViewValue::DataViewValue(Element* element) : DataViewAttribute(element, "value", SortOffset_DataValue) {}
 
+bool DataViewValue::Update(DataModel& model)
+{
+	Variant variant;
+	Element* element = GetElement();
+	DataExpressionInterface expr_interface(&model, element);
+	if (!element || !GetExpression().Run(expr_interface, variant))
+		return false;
+
+	// As Vue's v-model does, leave the text of an input being edited alone until the value it shows changes.
+	const String value = variant.Get<String>();
+	const bool unchanged = shown && value == previous;
+	previous = value;
+	shown = true;
+	Context* context = element->GetContext();
+	if ((unchanged && context && context->GetFocusElement() == element) || element->GetAttribute<String>("value", "") == value)
+		return false;
+
+	element->SetAttribute("value", value);
+	return true;
+}
