package managed_task_failure

foreign import libc "system:c"
foreign libc {
    fopen :: (path: cstring, mode: cstring) -> rawptr
    fclose :: (stream: rawptr) -> i32
    access :: (path: cstring, mode: i32) -> i32
}
Make :: (value: int) -> ^int { return &value; }
Ready :: () {
    stream := fopen("managed-ready", "wb");
    assert(stream != 0);
    closed := fclose(stream);
    assert(closed == 0);
}
Allowed :: () -> bool { return access("allow-managed-task", 0) == 0; }
Promise :: () -> ^int { if false { yield } return Make(42); }
Worker :: () -> int {
    promised := Promise();
    while !Allowed() { yield }
    joined := await promised;
    if joined is Cancelled { return 1; }
    else { assert(joined^ != 42, "retired managed task fails in its original generation"); }
    return 0;
}
Main :: () -> int { worker := Worker(); Ready(); return 0; }
Frame :: () -> int { return 0; }
