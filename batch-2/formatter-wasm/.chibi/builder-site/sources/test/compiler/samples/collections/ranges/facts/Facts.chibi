package facts
Sum :: (first: int, last: int) -> int {
    total: int = 0;
    for i in first..last { total += i; }
    return total;
}
Below :: (n: int) -> int {
    total: int = 0;
    for i in 0..<n { if (i == 2) { continue; } total += i; }
    return total;
}
Down :: (n: int) -> int {
    total: int = 0;
    for < i in 0..n { total = total * 10 + i; if (i == 1) { break; } }
    return total;
}
DownBelow :: (n: int) -> int {
    total: int = 0;
    for < i in 0..<n { total = total * 10 + i; }
    return total;
}
Count :: (first: int, last: int) -> int {
    count: int = 0;
    for i in first..last { count += 1; }
    for < i in first..last { count += 1; }
    return count;
}
Small :: (b: u8) -> int {
    total: int = 0;
    for i in 0..b { total += 1; }
    return total;
}
Keys :: (xs: int[]) -> int {
    total: int = 0;
    for x, i in xs { total += i * x; }
    return total;
}
Back :: (xs: int[]) -> int {
    total: int = 0;
    for < x, i in xs { total = total * 100 + x * 10 + i; }
    return total;
}
