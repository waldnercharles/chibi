package prepared_writer

import strings "core:strings"

// Prepared format v19, written exactly as execution_prepared_write encodes a
// module of authored functions, or of a behavior's states and event handlers.
// Every 64-bit payload (ids, layouts, scalar bits, union tags) is an index into
// the module's `wide` pool, whose entry 0 is zero for an absent payload.
// Nested values, table items and per-function tables are ranges of flat pools.
//
// Every table stays in Write; helpers encode one row, taking single records,
// scalars, text and the pools they index. Each encodes a row's fields in as
// few Words or Ints calls as it can, since a call that returns an array costs
// far more than a field.

Magic: uint64 : 0x4348494249505245;
Version: int : 19;

// A value. `wide` holds scalar bits, a union tag or a struct layout; nested
// struct fields, union payloads and array items are values[first, first + count),
// after the value itself. An absent authored struct still records its field
// count; an absent native one, a type header, records none.
pub Value :: struct {
    tag: int;
    container: int;
    type_name: string;
    has_type_name: bool;
    authored: bool;
    wide: int;
    text: string;
    has_text: bool;
    present: bool;
    first: int;
    count: int;
}
// Pin types the encoder distinguishes.
FlowTag: int : 0;
StructTag: int : 15;
UnionTag: int : 18;
NameTag: int : 12;
TextTag: int : 13;

pub Field :: struct {
    name: string;
    kind: int;
    type_name: string;
    has_type_name: bool;
    unit: string;
    has_unit: bool;
}
// An event the module handles; its payload fields are
// event_fields[first, first + count).
pub Event :: struct {
    id: int;
    abi: int;
    name: string;
    first: int;
    count: int;
}
pub EventField :: struct {
    name: string;
    nominal: int;
    has_default: bool;
    default_owner: bool;
    initial: int;
}
// A behavior's retained state and the value it starts with.
pub State :: struct {
    id: int;
    initial: int;
    shared: bool;
    contains_tasks: bool;
}
// A component a function reads or writes, and whether a binding owns it.
pub Component :: struct {
    id: int;
    binding: bool;
}
// An authored record requirement lists its fields; others resolve by identity.
pub Requirement :: struct {
    id: int;
    layout: int;
    storage: int;
    name: string;
    size: int;
    authored: bool;
    first: int;
    count: int;
}
pub Import :: struct {
    id: int;
    fingerprint: int;
}
// A function reference: own `index` in this module, or `function` (a wide id)
// in import `imported`. Null references have neither.
pub Reference :: struct {
    imported: int;
    own: int;
    function: int;
    role: int;
}
pub Source :: struct {
    graph: int;
    call: int;
    parent: int;
    asset: string;
    has_asset: bool;
    start: int;
    end: int;
    line: int;
    column: int;
}
pub Frame :: struct {
    source: int;
    depth: int;
    resume: int;
    source_index: int;
    stack: int;
}
pub Root :: struct {
    bank: int;
    index: int;
    shape: int;
}
pub Instruction :: struct {
    op: int;
    type: int;
    output: int;
    left: int;
    right: int;
    target: int;
    frame: int;
    source: int;
    stack: int;
    pin: int;
    offset: int;
    indirect: bool;
    component_index: int;
    node: int;
    value: int;
    layout: int;
    message: string;
    has_message: bool;
}
pub Local :: struct {
    kind: int;
    initial: int;
    frame: int;
    node: int;
    pin: int;
    offset: int;
    parameter: bool;
    array_default: bool;
    data_index: int;
}
pub Parameter :: struct {
    initial: int;
    frame: int;
    pin: int;
}
pub ResultLayout :: struct {
    index: int;
    name: string;
}
pub Data :: struct {
    kind: int;
    initial: int;
    size: int;
}
pub Host :: struct {
    capability: int;
    abi: int;
    first: int;
    result_first: int;
    result_count: int;
    outcome_first: int;
    outcome_count: int;
}
pub Call :: struct {
    function: int;
    first: int;
    count: int;
    result_first: int;
    result_count: int;
    task: bool;
}
pub Point :: struct {
    occurrence: int;
    meaning: int;
    start: int;
    end: int;
    line: int;
    column: int;
    kind: int;
    completion: bool;
}
pub Watch :: struct {
    origin: int;
    initial: int;
    ordinal: int;
    output: bool;
    reference: bool;
}
pub Span :: struct {
    first: int;
    count: int;
}
// Per-function tables, in spans[function.spans + table]. Kinds and slots are
// ints; defaults and roots name values; sources and stacks share `sources`.
// Component writes are ints naming component ids in `wide`.
ArgumentDefaults: int : 0;
ArgumentKinds: int : 1;
ResultDefaults: int : 2;
ResultKinds: int : 3;
VariableDefaults: int : 4;
Slots: int : 5;
SlotKinds: int : 6;
Roots: int : 7;
Instructions: int : 8;
Locals: int : 9;
Parameters: int : 10;
Frames: int : 11;
Sources: int : 12;
Stacks: int : 13;
Results: int : 14;
DataValues: int : 15;
Hosts: int : 16;
Calls: int : 17;
Definitions: int : 18;
Components: int : 19;
ComponentWrites: int : 20;
SourcePoints: int : 21;
SourceWatches: int : 22;
pub Tables: int : 23;
pub Function :: struct {
    argument_count: int;
    result_count: int;
    variable_count: int;
    root_steps: int;
    child_budget: int;
    depth_bound: int;
    pure_depth_limit: int;
    breakpoints: bool;
    batchable: bool;
    managed: bool;
    custom_lowering: bool;
    checkpoints: bool;
    pin_watches: bool;
    watch_size: int;
    component_bindings: bool;
    component_access: bool;
    spans: int;
}
// A module function entry: an exported function, or a handler of the event
// `event_id` names in `wide` (0 for none). No observer, action or captures.
// `body` and `subscription` index `references`.
pub Entry :: struct {
    id: int;
    kind: int;
    entry_name: string;
    has_entry: bool;
    event_id: int;
    event_abi: int;
    event_name: string;
    has_event_name: bool;
    continuation_wait: bool;
    effects: int;
    body: int;
    subscription: int;
}
pub Module :: union {
    Tables(id: uint64, owner_type: uint64, abi: uint64, pointer_size: int, wide: uint64[], values: Value[], ints: int[],
           requirements: Requirement[], fields: Field[], event_declarations: Event[],
           event_fields: EventField[], imports: Import[], functions: Function[], spans: Span[], roots: Root[],
           instructions: Instruction[], locals: Local[], parameters: Parameter[], frames: Frame[],
           sources: Source[], results: ResultLayout[], data: Data[], hosts: Host[], calls: Call[],
           references: Reference[], components: Component[], points: Point[], watches: Watch[],
           states: State[], entries: Entry[])
}

// Varints of 64-bit words: seven bits at a time from the low end, the high bit
// marking that more follow.
Words :: (words: uint64[]) -> byte[] {
    bytes: byte[] = [];
    for (word in words) {
        rest := word;
        while ((rest >> 7) != 0) {
            bytes = array_add(bytes, byte(wrap: rest | 128));
            rest = rest >> 7;
        }
        bytes = array_add(bytes, byte(wrap: rest));
    }
    return bytes;
}
// Zigzag varints of ints, which keep small negative values, such as -1 for
// none, one byte long.
Ints :: (values: int[]) -> byte[] {
    bytes: byte[] = [];
    for (value in values) {
        wide := int64(value);
        rest := uint64(wrap: wide << 1) ^ uint64(wrap: wide >> 63);
        while ((rest >> 7) != 0) {
            bytes = array_add(bytes, byte(wrap: rest | 128));
            rest = rest >> 7;
        }
        bytes = array_add(bytes, byte(wrap: rest));
    }
    return bytes;
}
// An int as its zigzag word, for a row of Words.
Zig :: (value: int) -> uint64 {
    wide := int64(value);
    return uint64(wrap: wide << 1) ^ uint64(wrap: wide >> 63);
}
Flag :: (value: bool) -> uint64 {
    if (value) {
        return 1;
    }
    return 0;
}
// The bytes of a string.
Raw :: (value: string) -> byte[] {
    bytes: byte[] = [];
    for (code in strings.Bytes(value)) {
        bytes = array_add(bytes, byte(wrap: code));
    }
    return bytes;
}
// Absent text is 0; otherwise its byte length plus one, then its bytes.
Text :: (value: string, present: bool) -> byte[] {
    if (!present) {
        return [0];
    }
    raw := Raw(value);
    return append(Words([uint64(length(raw) + 1)]), raw);
}
Zeros :: (count: int) -> byte[] {
    return resize([byte(0)], count);
}
// A value's own bytes; its nested values follow them. `bits` is its wide entry.
ValueHead :: (v: Value, bits: uint64) -> byte[] {
    bytes := append(Ints([v.tag, v.container]), Text(v.type_name, v.has_type_name));
    if (v.container != 0) {
        if (!v.present) {
            return append(bytes, Words([Flag(v.authored), 0]));
        }
        return append(bytes, Words([Flag(v.authored), 1, Zig(v.count)]));
    }
    if (v.tag == StructTag) {
        return append(bytes, Words([Flag(v.authored), bits, Flag(v.present), Zig(v.count)]));
    }
    if (v.tag == UnionTag) {
        if (!v.present) {
            return append(bytes, Words([Flag(v.authored), 0]));
        }
        return append(bytes, Words([Flag(v.authored), 1, bits, Zig(v.count)]));
    }
    if (v.tag == TextTag || v.tag == NameTag) {
        bytes = append(bytes, Words([Flag(v.authored)]));
        return append(bytes, Text(v.text, v.has_text));
    }
    return append(bytes, Words([Flag(v.authored), bits]));
}
// A value's bytes: its own, then those of the values nested in it, which
// `pool` already holds from starts[i] for sizes[i] bytes.
ValueBytes :: (v: Value, wide: uint64[], pool: byte[], starts: int[], sizes: int[]) -> byte[] {
    bytes := ValueHead(v, wide[v.wide]);
    aggregate := v.container != 0 || v.tag == StructTag || v.tag == UnionTag;
    if (!aggregate || !v.present) {
        return bytes;
    }
    nested := v.first;
    while (nested < v.first + v.count) {
        bytes = append(bytes, slice(pool, starts[nested], sizes[nested]));
        nested += 1;
    }
    return bytes;
}
// A zero flow value, as an empty observer type is written.
FlowValue :: () -> byte[] {
    return Ints([FlowTag, 0, 0, 0, 0]);
}
// A source with its asset's text already encoded; an absent asset is 0.
SourceBytes :: (v: Source, wide: uint64[], asset: byte[]) -> byte[] {
    if (!v.has_asset) {
        bytes := Words([wide[v.graph], wide[v.call], Zig(v.parent), 0]);
        return append(bytes, Ints([v.start, v.end, v.line, v.column]));
    }
    bytes := append(Words([wide[v.graph], wide[v.call], Zig(v.parent)]), asset);
    return append(bytes, Ints([v.start, v.end, v.line, v.column]));
}
ReferenceBytes :: (v: Reference, wide: uint64[]) -> byte[] {
    return Words([Zig(v.imported), Zig(v.own), wide[v.function], Zig(v.role)]);
}
PointBytes :: (v: Point, wide: uint64[]) -> byte[] {
    return Words([wide[v.occurrence], wide[v.meaning], Zig(v.start), Zig(v.end), Zig(v.line), Zig(v.column),
                  Zig(v.kind), Flag(v.completion)]);
}
// An instruction with its value, layout and message.
InstructionBytes :: (v: Instruction, wide: uint64[], pool: byte[], starts: int[], sizes: int[]) -> byte[] {
    bytes := Ints([v.op, v.type, v.output, v.left, v.right, v.target, v.frame, v.source, v.stack, v.pin]);
    bytes = append(bytes, Words([uint64(v.offset), Flag(v.indirect), Zig(v.component_index), wide[v.node]]));
    bytes = append(bytes, slice(pool, starts[v.value], sizes[v.value]));
    if (!v.has_message) {
        return append(bytes, Words([wide[v.layout], 0]));
    }
    bytes = append(bytes, Words([wide[v.layout]]));
    return append(bytes, Text(v.message, true));
}
LocalBytes :: (v: Local, wide: uint64[], pool: byte[], starts: int[], sizes: int[]) -> byte[] {
    bytes := append(Ints([v.kind]), slice(pool, starts[v.initial], sizes[v.initial]));
    return append(bytes, Words([Zig(v.frame), wide[v.node], Zig(v.pin), uint64(v.offset), Flag(v.parameter),
                                Flag(v.array_default), Zig(v.data_index)]));
}
HostBytes :: (v: Host, wide: uint64[]) -> byte[] {
    bytes := Words([wide[v.capability], wide[v.abi], Zig(v.first), Zig(v.result_first), Zig(v.result_count),
                    Zig(v.outcome_count)]);
    return append(bytes, Words(slice(wide, v.outcome_first, v.outcome_count)));
}
CallBytes :: (v: Call, target: Reference, wide: uint64[]) -> byte[] {
    bytes := ReferenceBytes(target, wide);
    return append(bytes, Words([Zig(v.first), Zig(v.count), Zig(v.result_first), Zig(v.result_count), Flag(v.task)]));
}
FunctionHead :: (v: Function) -> byte[] {
    return Words([Zig(v.argument_count), Zig(v.result_count), Zig(v.variable_count), uint64(v.root_steps),
                  uint64(v.child_budget), uint64(v.depth_bound), uint64(v.pure_depth_limit), Flag(v.breakpoints),
                  Flag(v.batchable), Flag(v.managed), Flag(v.custom_lowering), Flag(v.checkpoints),
                  Flag(v.pin_watches), uint64(v.watch_size), Flag(v.component_bindings), Flag(v.component_access)]);
}
// An entry before its body and subscription references.
EntryHead :: (v: Entry, wide: uint64[]) -> byte[] {
    // Event, event ABI, the observer's component, layout, field and offset,
    // then its type.
    bytes := append(Words([wide[v.id], wide[v.event_id], wide[v.event_abi], 0, 0, 0, 0]), FlowValue());
    // The observer's argument, action, parent and outcome, then no captures.
    bytes = append(bytes, Words([0, 0, 0, 0, 0, 0, Flag(v.continuation_wait), Zig(v.kind)]));
    bytes = append(bytes, Text(v.entry_name, v.has_entry));
    bytes = append(bytes, Text(v.event_name, v.has_event_name));
    return append(bytes, Words([wide[v.effects]]));
}
// An event declaration with its payload fields.
EventBytes :: (v: Event, fields: EventField[], wide: uint64[], pool: byte[], starts: int[], sizes: int[]) -> byte[] {
    bytes := append(Words([wide[v.id], wide[v.abi]]), Text(v.name, true));
    bytes = append(bytes, Ints([v.count]));
    index := v.first;
    while (index < v.first + v.count) {
        field := fields[index];
        bytes = append(bytes, Text(field.name, true));
        bytes = append(bytes, Words([wide[field.nominal], Flag(field.has_default), Flag(field.default_owner)]));
        bytes = append(bytes, slice(pool, starts[field.initial], sizes[field.initial]));
        index += 1;
    }
    return bytes;
}

// The complete inner module.
pub Write :: (module: Module) -> byte[] {
    switch module {
        case .Tables(id, owner_type, abi, pointer_size, wide, values, ints, requirements, fields, event_declarations,
                     event_fields, imports, functions, spans, roots, instructions, locals, parameters, frames,
                     sources, results, data, hosts, calls, references, components, points, watches, states,
                     entries):
            // Nested values follow their parent, so encoding from the last
            // value back finds every nested value already in the pool.
            pool: byte[] = [];
            starts := resize([int(0)], length(values));
            sizes := resize([int(0)], length(values));
            at := length(values) - 1;
            while (at >= 0) {
                start := length(pool);
                pool = append(pool, ValueBytes(values[at], wide, pool, starts, sizes));
                starts[at] = start;
                sizes[at] = length(pool) - start;
                at -= 1;
            }

            bytes := Words([Magic, uint64(Version), uint64(pointer_size), abi, id, owner_type,
                            Zig(length(requirements))]);
            for (requirement in requirements) {
                bytes = append(bytes, Words([wide[requirement.id], wide[requirement.layout],
                                             Zig(requirement.storage)]));
                bytes = append(bytes, Text(requirement.name, true));
                bytes = append(bytes, Words([uint64(requirement.size), Flag(requirement.authored)]));
                if (requirement.authored) {
                    bytes = append(bytes, Ints([requirement.count]));
                    index: int = 0;
                    while (index < requirement.count) {
                        field := fields[requirement.first + index];
                        bytes = append(bytes, Text(field.name, true));
                        bytes = append(bytes, Ints([field.kind]));
                        bytes = append(bytes, Text(field.type_name, field.has_type_name));
                        bytes = append(bytes, Text(field.unit, field.has_unit));
                        index += 1;
                    }
                }
            }
            bytes = append(bytes, Ints([length(event_declarations)]));
            for (declared in event_declarations) {
                bytes = append(bytes, EventBytes(declared, event_fields, wide, pool, starts, sizes));
            }
            bytes = append(bytes, Ints([length(imports)]));
            for (imported in imports) {
                bytes = append(bytes, Words([wide[imported.id], wide[imported.fingerprint]]));
            }

            // Consecutive sources of one asset share its encoded text.
            asset := "";
            asset_bytes := Text(asset, true);
            bytes = append(bytes, Ints([length(functions)]));
            for (function in functions) {
                bytes = append(bytes, FunctionHead(function));
                table: int = 0;
                while (table < Tables) {
                    span := spans[function.spans + table];
                    bytes = append(bytes, Ints([span.count]));
                    item := span.first;
                    last := span.first + span.count;
                    if (table == ArgumentDefaults || table == ResultDefaults || table == VariableDefaults) {
                        while (item < last) {
                            bytes = append(bytes, slice(pool, starts[item], sizes[item]));
                            item += 1;
                        }
                    } else if (table == ArgumentKinds || table == ResultKinds || table == Slots ||
                               table == SlotKinds) {
                        bytes = append(bytes, Ints(slice(ints, span.first, span.count)));
                    } else if (table == Roots) {
                        while (item < last) {
                            bytes = append(bytes, Ints([roots[item].bank, roots[item].index]));
                            bytes = append(bytes, slice(pool, starts[roots[item].shape], sizes[roots[item].shape]));
                            item += 1;
                        }
                    } else if (table == Instructions) {
                        while (item < last) {
                            bytes = append(bytes, InstructionBytes(instructions[item], wide, pool, starts, sizes));
                            item += 1;
                        }
                    } else if (table == Locals) {
                        while (item < last) {
                            bytes = append(bytes, LocalBytes(locals[item], wide, pool, starts, sizes));
                            item += 1;
                        }
                    } else if (table == Parameters) {
                        while (item < last) {
                            initial := parameters[item].initial;
                            bytes = append(bytes, slice(pool, starts[initial], sizes[initial]));
                            bytes = append(bytes, Ints([parameters[item].frame, parameters[item].pin]));
                            item += 1;
                        }
                    } else if (table == Frames) {
                        while (item < last) {
                            frame := frames[item];
                            source := sources[frame.source];
                            bytes = append(bytes, SourceBytes(source, wide, Text(source.asset, source.has_asset)));
                            bytes = append(bytes, Ints([frame.depth, frame.resume, frame.source_index, frame.stack]));
                            item += 1;
                        }
                    } else if (table == Sources || table == Stacks) {
                        while (item < last) {
                            if (sources[item].has_asset && sources[item].asset != asset) {
                                asset = sources[item].asset;
                                asset_bytes = Text(asset, true);
                            }
                            bytes = append(bytes, SourceBytes(sources[item], wide, asset_bytes));
                            item += 1;
                        }
                    } else if (table == Results) {
                        while (item < last) {
                            bytes = append(bytes, Ints([results[item].index]));
                            bytes = append(bytes, Text(results[item].name, true));
                            item += 1;
                        }
                    } else if (table == DataValues) {
                        while (item < last) {
                            bytes = append(bytes, Ints([data[item].kind]));
                            bytes = append(bytes, slice(pool, starts[data[item].initial], sizes[data[item].initial]));
                            bytes = append(bytes, Words([uint64(data[item].size)]));
                            item += 1;
                        }
                    } else if (table == Hosts) {
                        while (item < last) {
                            bytes = append(bytes, HostBytes(hosts[item], wide));
                            item += 1;
                        }
                        // Queries, commands and their banks follow host calls; calls follow them.
                        bytes = append(bytes, Zeros(6));
                    } else if (table == Calls) {
                        while (item < last) {
                            bytes = append(bytes, CallBytes(calls[item], references[calls[item].function], wide));
                            item += 1;
                        }
                    } else if (table == Definitions) {
                        while (item < last) {
                            bytes = append(bytes, ReferenceBytes(references[ints[item]], wide));
                            item += 1;
                        }
                    } else if (table == Components) {
                        while (item < last) {
                            bytes = append(bytes, Words([wide[components[item].id], Flag(components[item].binding)]));
                            item += 1;
                        }
                    } else if (table == ComponentWrites) {
                        while (item < last) {
                            bytes = append(bytes, Words([wide[ints[item]]]));
                            item += 1;
                        }
                        // No state selections follow component writes.
                        bytes = append(bytes, Zeros(1));
                    } else if (table == SourcePoints) {
                        while (item < last) {
                            bytes = append(bytes, PointBytes(points[item], wide));
                            item += 1;
                        }
                    } else {
                        while (item < last) {
                            watch := watches[item];
                            bytes = append(bytes, PointBytes(points[watch.origin], wide));
                            bytes = append(bytes, slice(pool, starts[watch.initial], sizes[watch.initial]));
                            bytes = append(bytes, Words([Zig(watch.ordinal), Flag(watch.output),
                                                         Flag(watch.reference)]));
                            item += 1;
                        }
                    }
                    table += 1;
                }
                // Points, watches and edges are debugger tables this module has none of.
                bytes = append(bytes, Zeros(3));
            }

            bytes = append(bytes, Ints([length(states)]));
            for (retained in states) {
                bytes = append(bytes, Words([wide[retained.id]]));
                bytes = append(bytes, slice(pool, starts[retained.initial], sizes[retained.initial]));
                bytes = append(bytes, Words([Flag(retained.shared), Flag(retained.contains_tasks)]));
            }
            bytes = append(bytes, Ints([length(entries)]));
            for (item in entries) {
                bytes = append(bytes, EntryHead(item, wide));
                bytes = append(bytes, ReferenceBytes(references[item.body], wide));
                bytes = append(bytes, ReferenceBytes(references[item.subscription], wide));
            }
            // No queries, query -1, no query variables or filter, bindings or actions.
            return append(bytes, Ints([0, -1, 0, 0, 0, 0]));
    }
}

// FNV-1a over the module bytes, as import fingerprints use; zero becomes one.
pub Fingerprint :: (bytes: byte[]) -> uint64 {
    hash: uint64 = 14695981039346656037;
    for (item in bytes) {
        hash = (hash ^ uint64(item)) * 1099511628211;
    }
    if (hash == 0) {
        return 1;
    }
    return hash;
}

Word :: (value: uint64) -> byte[] {
    bytes: byte[] = [];
    index: int = 0;
    rest := value;
    while (index < 8) {
        bytes = array_add(bytes, byte(wrap: rest));
        rest = rest >> 8;
        index += 1;
    }
    return bytes;
}
// CHIBICLO v1: header words "CHIBICLO", version, root id and row count, then
// rows sorted bytewise by name: id, name length, module length, name, module.
// Module bytes are data[starts[i], starts[i] + lengths[i]).
pub Closure :: (root: uint64, ids: uint64[], names: string[], data: byte[],
                starts: int[], lengths: int[]) -> byte[] {
    order: int[] = [];
    index: int = 0;
    while (index < length(names)) {
        at := length(order);
        order = array_add(order, index);
        while (at > 0 && strings.Compare(names[order[at - 1]], names[index]) > 0) {
            order[at] = order[at - 1];
            at -= 1;
        }
        order[at] = index;
        index += 1;
    }
    magic: byte[] = [67, 72, 73, 66, 73, 67, 76, 79];
    bytes := magic;
    bytes = append(bytes, Word(1));
    bytes = append(bytes, Word(root));
    bytes = append(bytes, Word(uint64(length(names))));
    for (row in order) {
        name := names[row];
        size := strings.ByteLength(name);
        bytes = append(bytes, Word(ids[row]));
        bytes = append(bytes, Word(uint64(size)));
        bytes = append(bytes, Word(uint64(lengths[row])));
        bytes = append(bytes, Raw(name));
        bytes = append(bytes, slice(data, starts[row], lengths[row]));
    }
    return bytes;
}
