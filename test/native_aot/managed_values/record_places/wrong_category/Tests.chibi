package record_place_category
import testing "core:testing"
Entry :: struct { values: int[]; }
@test
ElementPlaceIsNotAReadBoundsFailure :: () {
    testing.ExpectFailure(testing.Failure.IndexOutOfRange);
    rows: Entry[] = [];
    rows[0].values[0] = 9;
}

Inner :: struct { values:int[]; }
Nested :: struct { inner:Inner; }
@test
FieldReplacementIsNotAnExpressionReadBoundsFailure :: () {
    testing.ExpectFailure(testing.Failure.IndexOutOfRange);
    rows:Nested[]=[];
    rows[0].inner.values=[int(2)];
}
