package sdk

import engine "graph:engine"
import strings "core:strings"

// Public native runtime SDK contracts. Sources and owned header inventories stay
// in graph:engine. Properties describe installed consumers, not build flags.
// Component names are bare export names such as support, ui and render.
// @prefix is the installed prefix, substituted only by the output formatter.
// The initial vendor contract is macOS only; callers must reject other systems.
pub Supported :: (platform: string) -> bool {
    return platform == "Darwin";
}

pub RuntimeTargets :: () -> string[] {
    return [
        "arithmetic_capabilities",
        "array_capabilities",
        "asset_values",
        "audio_runtime",
        "behavior_runtime",
        "box2d",
        "box3d",
        "builtin_fonts",
        "capabilities",
        "comparison_capabilities",
        "conversion_capabilities",
        "core_capabilities",
        "declared_components",
        "ecs",
        "engine",
        "entity_runtime",
        "events",
        "execution",
        "execution_contract",
        "execution_sljit",
        "field_capabilities",
        "field_catalog",
        "fields",
        "fmt",
        "host_native_catalog",
        "host_native_default",
        "image_catalog",
        "input_action",
        "input_runtime",
        "json",
        "material_runtime",
        "math",
        "math_capabilities",
        "mesh_runtime",
        "model_bake",
        "model_runtime",
        "native_bindings",
        "native_capabilities",
        "native_prepared",
        "native_types",
        "particle_runtime",
        "physics3d_runtime",
        "physics_runtime",
        "platform",
        "player",
        "render",
        "save_runtime",
        "scene_runtime",
        "scheduling",
        "selection_capabilities",
        "set_capabilities",
        "shader_runtime",
        "spatial_runtime",
        "state_capabilities",
        "support",
        "task_pool_runtime",
        "task_scheduler",
        "tasks",
        "text_capabilities",
        "text_search",
        "tilemap_runtime",
        "types",
        "ui",
        "ui_document_values",
        "ui_documents",
        "ui_runtime",
        "url_runtime",
        "value_document",
        "vector_capabilities",
        "visibility_runtime",
        "visual_catalog"
    ];
}

Known :: (name: string) -> bool {
    for (target in RuntimeTargets()) {
        if (target == name) {
            return true;
        }
    }
    return false;
}

pub BuildTarget :: (name: string) -> string {
    if (!Known(name)) {
        return "";
    }
    return engine.ExportTarget(name);
}

pub Interface :: (name: string) -> bool {
    return name == "box2d" ||
           name == "box3d" ||
           name == "execution_contract" ||
           name == "execution_sljit" ||
           name == "input_action" ||
           name == "math" ||
           name == "task_scheduler" ||
           name == "tasks";
}

pub Library :: (name: string) -> string {
    target := BuildTarget(name);
    if (target == "" || Interface(name)) {
        return "";
    }
    return strings.Join(["lib/lib", target, ".a"], "");
}

pub Headers :: (name: string) -> string[] {
    target := BuildTarget(name);
    if (target == "") {
        return [];
    }
    return engine.PublicHeaders(target);
}

