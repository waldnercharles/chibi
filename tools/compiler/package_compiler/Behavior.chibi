package package_compiler

import snapshot "project:source_snapshot"
import raw "project:compiler_syntax"
import graph "project:package_graph"
import syntax "project:syntax_diagnostics"
import binding "project:lexical_binding"
import writer "project:prepared_writer"
import json "project:json_string"
import strings "core:strings"
import tk "project:source_tokenizer"

// Compiles a behavior asset to the prepared module of the game a target
// describes: its retained states, and its event handlers, which read and
// write those states and write fields of the owner's components. Its module,
// states and handlers take the IDs stage zero gives them.

// An event the game declares; its payload is event_fields[first, first + count).
pub GameEvent :: struct {
    name: string;
    id: u64;
    abi: u64;
    first: int;
    count: int;
}
pub GameEventField :: struct {
    name: string;
    storage: int;
    nominal: u64;
    has_default: bool;
    default_owner: bool;
}
// A type the game links, a component when `component` is its component ID;
// its fields are type_fields[first, first + count). A module requires every
// type but a namespace, such as SceneGlobals; types[underlying], when that is
// not -1, is the type it stands for.
pub GameType :: struct {
    required: bool;
    underlying: int;
    name: string;
    id: u64;
    layout: u64;
    storage: int;
    size: int;
    component: u64;
    first: int;
    count: int;
    relationship: bool;
    traits: int;
    error: bool;
}
// A game type's field: of the type types[record] when that is not -1; a
// constant whose value is its name; read by natives[read] when that is not
// -1, with the key `read_key` instead of the value when that is not "".
pub GameField :: struct {
    name: string;
    storage: int;
    offset: int;
    writable: bool;
    c_string: bool;
    record: int;
    constant: bool;
    read: int;
    read_key: string;
}
// A native that makes a record of type types[record] of its arguments;
// argument i gives the record's field make_fields[first + i].
pub NativeMake :: struct {
    native: int;
    record: int;
    first: int;
}
// A name the game binds in every behavior, of the type types[record] when
// that is not -1.
pub GameGlobal :: struct {
    name: string;
    storage: int;
    record: int;
}
// A native that combines numbers, and records of them field by field, for a
// binary operator: natives[native].
pub NumericOperator :: struct {
    native: int;
    operator: string;
}
// A behavior's retained state, with its nominal type and initial value.
StateDecl :: struct {
    name: string;
    id: u64;
    storage: int;
    record: int;
    bits: u64;
    text: string;
    node: int;
}
// State rows and every function's variable defaults retain the same header.
StateValue :: (kept: StateDecl, types: TypeDecl[], layouts: int[], wide: int) -> writer.Value {
    value := Header(kept.storage, 0, kept.record, types, layouts);
    value.wide = wide;
    value.text = kept.text;
    value.has_text = kept.storage == TextStorage;
    return value;
}
// What a module holds beyond its functions. A behavior's functions keep its
// states, and handled[i] is the event function i handles, -1 for none; its
// operators may combine records, and its globals are names.
Game :: union {
    Package
    | Library(entity: u64, operators: NumericOperator[], globals: GameGlobal[], makes: NativeMake[],
              make_fields: int[])
    | Behavior(kept: StateDecl[], handled: int[], declared: GameEvent[], payloads: GameEventField[],
               entity: u64, operators: NumericOperator[], globals: GameGlobal[], makes: NativeMake[],
               make_fields: int[])
}
// Prepared function kinds.
HandlerFunction: int : 1;
// The reference kind of a component field, as the reference intrinsics take it.
ComponentReference: int : 2;
// Effects a handler declares.
ReadEffect: int : 1;
WriteEffect: int : 2;
InvocationReadEffect: int : 64;

// A behavior's names: the game's globals, its states, then `self`, its owner,
// whatever global the game names so.
BehaviorNames :: (kept_states: StateDecl[], globals: GameGlobal[], owner_record: int) -> Name[] {
    names: Name[] = [];
    index: int = 0;
    while (index < length(globals)) {
        bound: Name = {owned: false, name: globals[index].name, place: GlobalPlace, index: index, storage: globals[index].storage,
                       container: 0, record: globals[index].record, writable: false, node: -1};
        names.append(bound);
        index += 1;
    }
    index = 0;
    while (index < length(kept_states)) {
        kept: Name = {owned: false, name: kept_states[index].name, place: StatePlace, index: index,
                      storage: kept_states[index].storage, container: 0, record: kept_states[index].record,
                      writable: true,
                      node: kept_states[index].node};
        names.append(kept);
        index += 1;
    }
    owner: Name = {owned: false, name: "self", place: SelfPlace, index: 0, storage: HandleStorage, container: 0,
                   record: owner_record,
                   writable: false, node: -1};
    return append(names, owner);
}
// The component of each component reference a body makes, or, when
// `written`, of each it writes through.
ComponentsOf :: (cells: Cell[], hosts: Host[], written: bool) -> u64[] {
    found: u64[] = [];
    for (host in hosts) {
        if (host.intrinsic == ReferenceMakeIntrinsic && cells[host.first + 2].constant == u64(ComponentReference) &&
            (host.written || !written)) {
            found.append(cells[host.first + 6].constant);
        }
    }
    return found;
}
// Each of `items` once, in order.
Distinct :: (items: u64[]) -> u64[] {
    kept: u64[] = [];
    for (item in items) {
        seen := false;
        for (known in kept) {
            if (known == item) {
                seen = true;
            }
        }
        if (!seen) {
            kept.append(item);
        }
    }
    return kept;
}
// A handler's effects, as stage zero's analysis gives them: reading a state
// reads what the invocation retains, storing one also reads it and writes,
// reading a component reads, and writing one reads and writes.
Effects :: (ops: Ops, code: Code[], reads_components: bool, writes_components: bool) -> int {
    effects: int = 0;
    if (reads_components) {
        effects = ReadEffect;
    }
    if (writes_components) {
        effects = ReadEffect | WriteEffect;
    }
    for (instruction in code) {
        if (instruction.op == ops.variable) {
            effects = effects | ReadEffect | InvocationReadEffect;
        } else if (instruction.op == ops.store || instruction.op == ops.store_value) {
            effects = effects | ReadEffect | InvocationReadEffect | WriteEffect;
        }
    }
    return effects;
}
// The game's types as shared native declarations, in order, a
// namespace as one no module requires; their fields are members, and a
// native type's parent is its underlying type.
NativeTypes :: (types: GameType[]) -> TypeDecl[] {
    declared: TypeDecl[] = [];
    for (linked in types) {
        kind := NativeDecl;
        if (!linked.required) {
            kind = NamespaceDecl;
        }
        if (linked.relationship) {
            kind = RelationshipDecl;
        }
        row: TypeDecl = {name: linked.name, type_name: linked.name, package: -1, node: -1, kind: kind,
                         first: linked.first, count: linked.count, size: linked.size, parent: linked.underlying,
                         storage: linked.storage, id: linked.id, layout: linked.layout, component: linked.component,
                         key: linked.traits, value_storage: 0, value_container: 0, value_record: -1, error: linked.error};
        declared.append(row);
    }
    // Optional query snapshots keep their underlying nominal component type
    // and layout, while semantic lookup remembers that a guard is required.
    index: int = 0;
    while (index < length(types)) {
        if (declared[index].kind == NativeDecl && declared[index].component != 0) {
            optional := declared[index];
            optional.kind = OptionalComponentDecl;
            optional.parent = index;
            optional.name = format_text("{}?", optional.name);
            declared.append(optional);
        }
        index += 1;
    }
    return declared;
}
NativeFields :: (type_fields: GameField[]) -> TypeMember[] {
    fields: TypeMember[] = [];
    for (linked in type_fields) {
        row: TypeMember = {name: linked.name, storage: linked.storage, container: 0, record: linked.record,
                           offset: linked.offset, writable: linked.writable, c_string: linked.c_string, constant: linked.constant,
                           read: linked.read, read_key: linked.read_key};
        fields.append(row);
    }
    return fields;
}
// The event named `name`, matched as the catalog matches names: an exact
// name first, else the one that matches loosely; -1 for none or several.
FindEvent :: (game_events: GameEvent[], name: string) -> int {
    found: int = -1;
    index: int = 0;
    while (index < length(game_events)) {
        if (game_events[index].name == name) {
            return index;
        }
        if (NameMatches(game_events[index].name, name)) {
            if (found != -1) {
                found = -2;
            } else {
                found = index;
            }
        }
        index += 1;
    }
    if (found < 0) {
        return -1;
    }
    return found;
}
// Whether every field of an event's payload is a scalar a handler can take.
ScalarPayload :: (declared: GameEvent, event_fields: GameEventField[]) -> bool {
    at := declared.first;
    while (at < declared.first + declared.count) {
        storage := event_fields[at].storage;
        if (storage == StructStorage || storage == UnionStorage || storage <= 0) {
            return false;
        }
        at += 1;
    }
    return true;
}
// A handler's payload parameters, or why the handler cannot take them.
Payload :: union {
    Failed(diagnostic: syntax.Diagnostic) | Bound(params: Param[])
}
// The handler's parameters, one per payload field in payload order. The
// handler names fields in any order; each it leaves out gets an unnamed
// parameter, as stage zero gives it.
PayloadParams :: (forest: snapshot.SnapshotNode[], source: string, handler: int, event_name: string,
                  declared: GameEvent, event_fields: GameEventField[]) -> Payload {
    listed: int[] = [];
    at: int = 0;
    while (at < declared.count) {
        listed.append(int(-1));
        at += 1;
    }
    parameter := FirstMember(forest, Field(forest, handler, syntax.FieldParameters));
    while (parameter >= 0) {
        name := Field(forest, parameter, syntax.FieldName);
        spelled := Text(forest, source, name);
        at = 0;
        while (at < declared.count && !NameMatches(event_fields[declared.first + at].name, spelled)) {
            at += 1;
        }
        if (at == declared.count) {
            return Payload.Failed(Diagnose(forest, name, 0,
                                           format_text("{} has no payload field '{}'", event_name, spelled)));
        }
        if (listed[at] >= 0) {
            return Payload.Failed(Diagnose(forest, name, 0, format_text("Payload field '{}' is listed twice",
                                                                        event_fields[declared.first + at].name)));
        }
        listed[at] = name;
        parameter = NextMember(forest, parameter);
    }
    params: Param[] = [];
    at = 0;
    while (at < declared.count) {
        param: Param = {name: "", storage: event_fields[declared.first + at].storage, container: 0, record: -1,
                        has_default: false, default_bits: 0, default_text: "", default_occurrence: 0,
                        reference: false, written: false, node: listed[at]};
        if (listed[at] >= 0) {
            param.name = Text(forest, source, listed[at]);
        }
        params.append(param);
        at += 1;
    }
    return Payload.Bound(params);
}
// A number or one signed number. Unary plus keeps its operand's value;
// minus stays attached for the literal readers. Other unary operators are
// expressions, not numeric literal defaults.
StateNumberNode :: (forest: snapshot.SnapshotNode[], source: string, node: int) -> int {
    if (Is(forest, node, syntax.Number)) {
        return node;
    }
    if (!Is(forest, node, syntax.UnaryExpression)) {
        return -1;
    }
    operand := Field(forest, node, syntax.FieldOperand);
    if (!Is(forest, operand, syntax.Number)) {
        return -1;
    }
    operator := Text(forest, source, Field(forest, node, syntax.FieldOperator));
    if (operator == "+") {
        return operand;
    }
    if (operator == "-") {
        return node;
    }
    return -1;
}
// A numeric literal's natural storage follows its spelling. Hexadecimal e
// is a digit; only decimal points and exponents select number storage.
StateNumberStorage :: (forest: snapshot.SnapshotNode[], source: string, node: int) -> int {
    digits := node;
    if (Is(forest, node, syntax.UnaryExpression)) {
        digits = Field(forest, node, syntax.FieldOperand);
    }
    spelling := Text(forest, source, digits);
    hexadecimal := strings.ByteLength(spelling) > 1 && strings.ByteAt(spelling, 0) == 48 &&
                   (strings.ByteAt(spelling, 1) == 120 || strings.ByteAt(spelling, 1) == 88);
    if (!hexadecimal) {
        index: int = 0;
        while (index < strings.ByteLength(spelling)) {
            digit := strings.ByteAt(spelling, index);
            if (digit == 46 || digit == 101 || digit == 69) {
                return FloatStorage;
            }
            index += 1;
        }
    }
    switch ParseNumber(forest, source, node) {
        case .Number(negative, magnitude):
            if (Fits(negative, magnitude, IntStorage)) {
                return IntStorage;
            }
            if (Fits(negative, magnitude, Int64Storage)) {
                return Int64Storage;
            }
        case .Invalid:
            return WordStorage;
    }
    return WordStorage;
}
StateRead :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Read(kept: StateDecl)
}
// The state declaration `member` of the document `document`, whose identity
// is `identity` and `qualifier` (a function's name and a dot, for a retained
// local) before the state's own name.
DeclaredState :: (forest: snapshot.SnapshotNode[], source: string, table: ^(TypeDecl[]), entity: u64, member: int,
                  document: int, identity: string, qualifier: string, ops: Ops) -> StateRead {
    name := Text(forest, source, Field(forest, member, syntax.FieldName));
    declared := StateType(forest, source, table, entity, member);
    if ((!Numeric(declared.storage) && declared.storage != BoolStorage && declared.storage != TextStorage &&
         declared.storage != HandleStorage) || declared.container != 0 ||
        CharType(table^, declared.storage, declared.container, declared.record) ||
        (declared.storage == HandleStorage && declared.record < 0)) {
        return StateRead.Failed(Diagnose(forest, member, document, "state type is not supported yet"));
    }
    bits: u64 = 0;
    initial := "";
    switch StateDefault(forest, source, name, declared.storage, Field(forest, member, syntax.FieldValue), ops) {
        case .Failed(diagnostic):
            return StateRead.Failed(snapshot.Stamp(diagnostic, document));
        case .Read(default_bits, default_text):
            bits = default_bits;
            initial = default_text;
    }
    kept: StateDecl = {name: name, id: binding.ID("symbol", format_text("{}:1:{}{}", identity, qualifier, name)),
                       storage: declared.storage, record: declared.record, bits: bits, text: initial,
                       node: Field(forest, member, syntax.FieldName)};
    return StateRead.Read(kept);
}
// A function's retained locals are states of its package's module, which
// carries every state as a variable of every function, as a behavior's
// functions do. `owners[i]` is the callable that declares `states[i]`, and a
// state's identity is its function's and its own name, so an edit that keeps
// both keeps the state.
Retained :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Read(states: StateDecl[], owners: int[])
}
RetainedLocals :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], callables: Callable[],
                   package_names: string[], table: ^(TypeDecl[]), ops: Ops) -> Retained {
    states: StateDecl[] = [];
    owners: int[] = [];
    for (at in 0..<length(documents)) {
        document := documents[at];
        for (offset in 0..<document.node_count) {
            member := document.node_start + offset;
            if (!Is(forest, member, syntax.StateDeclaration)) {
                continue;
            }
            function := forest[member].parent;
            while (function >= 0 && !Is(forest, function, syntax.FunctionDeclaration)) {
                function = forest[function].parent;
            }
            for (index in 0..<length(callables)) {
                if (function < 0 || callables[index].node != function) {
                    continue;
                }
                name := Text(forest, document.text, Field(forest, member, syntax.FieldName));
                for (position in 0..<length(states)) {
                    if (states[position].name == name && owners[position] == index) {
                        return Retained.Failed(Diagnose(forest, member, at, format_text("Duplicate declaration '{}'", name)));
                    }
                }
                qualifier := format_text("{}.", callables[index].name);
                switch DeclaredState(forest, document.text, table, 0, member, at, package_names[callables[index].owner_package],
                                     qualifier, ops) {
                    case .Failed(diagnostic):
                        return Retained.Failed(diagnostic);
                    case .Read(kept):
                        states.append(kept);
                        owners.append(index);
                }
            }
        }
    }
    return Retained.Read(states, owners);
}
// The retained locals of package `package`'s functions, in module order.
PackageStates :: (states: StateDecl[], owners: int[], callables: Callable[], package: int) -> StateDecl[] {
    kept: StateDecl[] = [];
    for (position in 0..<length(states)) {
        if (callables[owners[position]].owner_package == package) {
            kept.append(states[position]);
        }
    }
    return kept;
}
// The names callable `callable` of package `package` reads its own retained
// locals by, each the variable at its position among the package's states.
RetainedNames :: (states: StateDecl[], owners: int[], callables: Callable[], package: int, callable: int) -> Name[] {
    names: Name[] = [];
    index: int = 0;
    for (position in 0..<length(states)) {
        if (callables[owners[position]].owner_package != package) {
            continue;
        }
        if (owners[position] == callable) {
            kept: Name = {owned: false, name: states[position].name, place: StatePlace, index: index,
                          storage: states[position].storage, container: 0, record: states[position].record,
                          writable: true, node: states[position].node};
            names.append(kept);
        }
        index += 1;
    }
    return names;
}
// The written scalar type, or a literal initializer's natural type.
StateType :: (forest: snapshot.SnapshotNode[], source: string, types: ^(TypeDecl[]), entity: u64,
              member: int) -> ValueType {
    written := Field(forest, member, syntax.FieldType);
    value := Field(forest, member, syntax.FieldValue);
    if (written < 0) {
        if (Is(forest, value, syntax.Boolean)) {
            return {storage: BoolStorage, container: 0, record: -1};
        }
        if (Is(forest, value, syntax.String)) {
            return {storage: TextStorage, container: 0, record: -1};
        }
        literal := StateNumberNode(forest, source, value);
        if (literal >= 0) {
            return {storage: StateNumberStorage(forest, source, literal), container: 0, record: -1};
        }
        return {storage: 0, container: 0, record: -1};
    }
    spelled := Text(forest, source, Field(forest, written, syntax.FieldName));
    if ((spelled == "entity" || spelled == "number") && Field(forest, written, syntax.FieldTrait) < 0 &&
        Field(forest, written, syntax.FieldArguments) < 0 && !HasToken(forest, written, tk.Question) &&
        !HasToken(forest, written, tk.OpenBracket)) {
        if (spelled == "number") {
            return {storage: FloatStorage, container: 0, record: -1};
        }
        return {storage: HandleStorage, container: 0, record: TypeWithId(types^, entity)};
    }
    no_names: Name[] = [];
    return ReadType(forest, source, types, no_names, 0, written);
}
// A scalar state's literal default. Handles also admit an unwritten empty
// value; the other scalar types require an initializer, as stage zero does.
StateDefault :: (forest: snapshot.SnapshotNode[], source: string, name: string, storage: int,
                 value: int, ops: Ops) -> Default {
    if (value < 0) {
        if (storage == HandleStorage) {
            return Default.Read(0, "");
        }
        return Default.Failed({start: 0, end: 0, line: 1, column: 1, document: 0,
                               message: format_text("'{}' requires a default value", name)});
    }
    if (Is(forest, value, syntax.Nil) && Text(forest, source, value) == "null") {
        return Default.Read(0, "");
    }
    literal := StateNumberNode(forest, source, value);
    if (storage == HandleStorage && literal >= 0) {
        switch NumberBits(forest, source, literal) {
            case .Finite(double_bits, float_fits, float_bits):
                if ((double_bits & 0x7fffffffffffffff) == 0) {
                    return Default.Read(0, "");
                }
            case .OutOfRange:
                return Default.Failed(Diagnose(forest, value, 0, "Numeric literal is outside the range of its type"));
        }
        return Default.Failed(Diagnose(forest, value, 0, "entity default requires null or zero"));
    }
    if (storage == BoolStorage && Is(forest, value, syntax.Boolean)) {
        bits: u64 = 0;
        if (Text(forest, source, value) == "true") {
            bits = 1;
        }
        return Default.Read(bits, "");
    }
    if (storage == TextStorage && Is(forest, value, syntax.String)) {
        decoded := json.Value(Text(forest, source, value));
        if (!decoded.valid) {
            return Default.Failed(Diagnose(forest, value, 0, "Invalid string literal"));
        }
        return Default.Read(0, decoded.value);
    }
    if (Floating(storage) && literal >= 0) {
        switch FloatConstantStep(forest, source, 0, Typed(-1, NumberStorage, 0, literal), storage, ops,
                                 NoBases(), forest[value]) {
            case .Failed(diagnostic):
                return Default.Failed(diagnostic);
            case .Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, popped, result, retained, marks):
                return Default.Read(code[0].payload, "");
        }
    }
    if (Integer(storage)) {
        switch ParseNumber(forest, source, literal) {
            case .Number(negative, magnitude):
                if (Fits(negative, magnitude, storage)) {
                    return Default.Read(Bits(negative, magnitude), "");
                }
                return Default.Failed(Diagnose(forest, value, 0,
                                               format_text("Numeric literal is outside the range of {}",
                                                           TypeName(storage))));
            case .Invalid:
                return Default.Failed(Diagnose(forest, value, 0, "state default needs a literal of its declared type"));
        }
    }
    return Default.Failed(Diagnose(forest, value, 0, "state default needs a literal of its declared type"));
}
// A system's body reads its step from the execution context, including empty
// headers. Helpers receive it explicitly; it is not a mutable local.
SystemStepName :: (target: Target, storage: int) -> Name {
    return {owned: false, name: "dt", place: SystemStepPlace, index: target.delta_seconds_offset,
            storage: storage, container: 0, record: -1, writable: false, node: -1};
}
// `identity` names the source as the project does, such as
// "behaviors/Counter.chibi"; the module, states and handlers take their IDs
// from it. The target, natives, events, types, entity, operators, globals and
// record makes are the game's, as `chibi-compile --stage-one-input` exports
// them.
pub CompileBehavior :: (identity: string, source: string, target: Target, abi: u64, names: string[],
                        natives: Native[], ports: Port[], native_ids: u64[], game_events: GameEvent[],
                        event_fields: GameEventField[], types: GameType[], type_fields: GameField[],
                        entity: u64, operators: NumericOperator[], globals: GameGlobal[], makes: NativeMake[],
                        make_fields: int[]) -> (module: u64, bytes: u8[], error: syntax.Diagnostic?) {
    context: BodyContext = BodyContext.Unknown;
    switch CompileBehaviorResolved(identity, source, target, abi, names, LegacyNatives(natives, names), LegacyPorts(ports), native_ids,
                                   game_events, event_fields, types, type_fields, entity, operators, globals,
                                   makes, make_fields, resize([int(0)], length(natives)), context) {
        case .Rejected(diagnostic):
            return (0, [], diagnostic);
        case .Compiled(compiled_module, prepared):
            return (compiled_module, prepared, nil);
    }
}
CompileBehaviorResolved :: (identity: string, source: string, target: Target, abi: u64, names: string[],
                            natives: ResolvedNative[], ports: ResolvedPort[], native_ids: u64[], game_events: GameEvent[],
                            event_fields: GameEventField[], types: GameType[], type_fields: GameField[],
                            entity: u64, operators: NumericOperator[], globals: GameGlobal[], makes: NativeMake[],
                            make_fields: int[], native_effects: int[], context: BodyContext) -> Result {
    return CompileSources([identity], [source], target, abi, names, natives, ports, native_ids, game_events,
                          event_fields, types, type_fields, entity, operators, globals, makes, make_fields,
                          native_effects, context, false);
}
// Every source is declared before a body is emitted. Source-owned records
// replace their catalog row in place, preserving nominal indices in fields.
SourceTypes :: union {
    Failed(diagnostic: syntax.Diagnostic) | Read(types: TypeDecl[])
}
PromoteRecords :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], roots: int[],
                   types: TypeDecl[], members: TypeMember[], target: Target) -> SourceTypes {
    file: int = 0;
    while (file < length(documents)) {
        root := roots[file];
        source := documents[file].text;
        if (Is(forest, root, syntax.Library)) {
            namespace_name := Text(forest, source, Field(forest, root, syntax.FieldName));
            member := FirstMember(forest, Field(forest, root, syntax.FieldBody));
            while (member >= 0) {
                if (Is(forest, member, syntax.RecordDeclaration)) {
                    attributes := DeclarationAttributes(forest, source, file, member, "error");
                    if length(attributes) > 0 {
                        return SourceTypes.Failed(attributes[0]);
                    }
                    name := Text(forest, source, Field(forest, member, syntax.FieldName));
                    id := binding.ID("symbol", format_text("{}:1:{}", documents[file].identity, name));
                    found := TypeWithId(types, id);
                    if (found < 0 || types[found].type_name != format_text("{}.{}", namespace_name, name) ||
                        types[found].kind != NativeDecl || types[found].storage != StructStorage ||
                        Field(forest, member, syntax.FieldParameters) >= 0 ||
                        types[found].error != ErrorMarked(forest, source, member)) {
                        return SourceTypes.Failed(Diagnose(forest, member, file, "library record differs from the declaration catalog"));
                    }
                    declared := types[found];
                    item := FirstMember(forest, Field(forest, member, syntax.FieldBody));
                    count: int = 0;
                    while (item >= 0) {
                        storage := ScalarStorage(Text(forest, source, Field(forest, item, syntax.FieldType)));
                        if (count >= declared.count || storage == 0 || Field(forest, item, syntax.FieldValue) >= 0) {
                            return SourceTypes.Failed(Diagnose(forest, item, file, "library record needs scalar fields without defaults"));
                        }
                        field := members[declared.first + count];
                        if (field.name != Text(forest, source, Field(forest, item, syntax.FieldName)) ||
                            field.storage != storage || field.record >= 0) {
                            return SourceTypes.Failed(Diagnose(forest, item, file, "library record differs from the declaration catalog"));
                        }
                        count += 1;
                        item = NextMember(forest, item);
                    }
                    if (count == 0 || count != declared.count || LayoutHash(declared, members, types, target) != declared.layout) {
                        return SourceTypes.Failed(Diagnose(forest, member, file, "library record layout differs from the declaration catalog"));
                    }
                    declared.name = name;
                    declared.package = file;
                    declared.node = member;
                    declared.kind = RecordDecl;
                    declared.error = ErrorMarked(forest, source, member);
                    types[found] = declared;
                }
                member = NextMember(forest, member);
            }
        }
        file += 1;
    }
    return SourceTypes.Read(types);
}
SourceMembers :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Read(game: Game, callables: Callable[], params: Param[])
}
// Signatures may declare the sequence and optional types they use in `table`.
DeclareSource :: (forest: snapshot.SnapshotNode[], document: snapshot.Document, package: int, declaration: int,
                  aliases: Name[], table: ^(TypeDecl[]), callables: Callable[], params: Param[],
                  game_events: GameEvent[], event_fields: GameEventField[], entity: u64,
                  operators: NumericOperator[], globals: GameGlobal[], makes: NativeMake[], make_fields: int[],
                  ops: Ops) -> SourceMembers {
    source := document.text;
    identity := document.identity;
    solid := SolidOffsets(source);
    is_library := Is(forest, declaration, syntax.Library);
    is_system := Is(forest, declaration, syntax.System);
    kept_states: StateDecl[] = [];
    handled: int[] = [];
    member := FirstMember(forest, Field(forest, declaration, syntax.FieldBody));
    if (is_system) {
        tick := FindEvent(game_events, "Tick");
        if (tick < 0 || game_events[tick].count != 1 || event_fields[game_events[tick].first].name != "dt") {
            return SourceMembers.Failed(Diagnose(forest, declaration, package,
                                                 "systems require Tick(dt) in the target event catalog"));
        }
        callable: Callable = {name: Text(forest, source, Field(forest, declaration, syntax.FieldName)), package: package,
                              document: package, node: declaration, first: length(params), count: 0, result: 0,
                              result_container: 0, result_record: -1, results: 0, waits: false, identity: 0, owner_package: package};
        callables.append(callable);
        handled.append(tick);
    }
    while (member >= 0) {
        if (!is_library && Is(forest, member, syntax.StateDeclaration)) {
            name := Text(forest, source, Field(forest, member, syntax.FieldName));
            for (kept in kept_states) {
                if (kept.name == name) {
                    return SourceMembers.Failed(Diagnose(forest, member, package, format_text("Duplicate declaration '{}'", name)));
                }
            }
            switch DeclaredState(forest, source, table, entity, member, package, identity, "", ops) {
                case .Failed(diagnostic):
                    return SourceMembers.Failed(diagnostic);
                case .Read(kept):
                    kept_states.append(kept);
            }
        } else if (!is_library && Is(forest, member, syntax.Handler)) {
            if (Text(forest, source, Field(forest, member, syntax.FieldKind)) != "on" || Field(forest, member, syntax.FieldAlias) >= 0 ||
                !Is(forest, Field(forest, member, syntax.FieldName), syntax.Identifier)) {
                return SourceMembers.Failed(Diagnose(forest, member, package, "only `on Event` handlers are supported yet"));
            }
            name := Text(forest, source, Field(forest, member, syntax.FieldName));
            found := FindEvent(game_events, name);
            if (found < 0) {
                return SourceMembers.Failed(Diagnose(forest, member, package, format_text("Unknown event '{}'", name)));
            }
            if (!ScalarPayload(game_events[found], event_fields)) {
                return SourceMembers.Failed(Diagnose(forest, member, package, "events with record payloads are not supported yet"));
            }
            first := length(params);
            switch PayloadParams(forest, source, member, name, game_events[found], event_fields) {
                case .Failed(diagnostic):
                    return SourceMembers.Failed(snapshot.Stamp(diagnostic, package));
                case .Bound(added):
                    params.extend(added);
            }
            callable: Callable = {name: name, package: package, document: package, node: member, first: first,
                                  count: game_events[found].count, result: 0, result_container: 0, result_record: -1,
                                  results: 0, waits: false, identity: 0, owner_package: package};
            callables.append(callable);
            handled.append(found);
        } else if (Is(forest, member, syntax.FunctionDeclaration)) {
            name := Text(forest, source, Field(forest, member, syntax.FieldName));
            if (FindCallable(callables, package, name) >= 0 || FindType(table^, package, name) >= 0) {
                return SourceMembers.Failed(Diagnose(forest, member, package, format_text("Duplicate declaration '{}'", name)));
            }
            switch FunctionSignature(forest, source, identity, solid, table, aliases, package, package, member, name,
                                     length(params)) {
                case .Failed(diagnostic):
                    return SourceMembers.Failed(diagnostic);
                case .Read(procedure, added):
                    params.extend(added);
                    callables.append(procedure);
                    handled.append(int(-1));
            }
        } else if (!is_system && (!is_library || !Is(forest, member, syntax.RecordDeclaration))) {
            return SourceMembers.Failed(Diagnose(forest, member, package, "unsupported executable source member"));
        }
        member = NextMember(forest, member);
    }
    if (is_library) {
        return SourceMembers.Read(Game.Library(entity, operators, globals, makes, make_fields), callables, params);
    }
    return SourceMembers.Read(Game.Behavior(kept_states, handled, game_events, event_fields, entity, operators,
                                            globals, makes, make_fields), callables, params);
}
// The names a query in the source at `root` reads: its states, the game's
// globals and the owner, and a system's step.
SourceNames :: (forest: snapshot.SnapshotNode[], root: int, game: Game, types: TypeDecl[], target: Target) -> Name[] {
    names: Name[] = [];
    switch game {
        case .Package:
            return names;
        case .Library(owner, operators, globals, makes, fields):
            return BehaviorNames([], globals, TypeWithId(types, owner));
        case .Behavior(kept, handlers, declared_events, payloads, owner, operators, globals, makes, fields):
            names = BehaviorNames(kept, globals, TypeWithId(types, owner));
            if (Is(forest, root, syntax.System)) {
                tick := declared_events[FindEvent(declared_events, "Tick")];
                names.append(SystemStepName(target, payloads[tick.first].storage));
            }
    }
    return names;
}
// A system's step, and the rows of the system query enclosing a callable.
SystemNames :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], members: TypeMember[],
                query_specs: QuerySpec[], callable: Callable, game_events: GameEvent[],
                event_fields: GameEventField[], target: Target) -> Name[] {
    names: Name[] = [];
    if (Is(forest, callable.node, syntax.System)) {
        tick := game_events[FindEvent(game_events, "Tick")];
        names.append(SystemStepName(target, event_fields[tick.first].storage));
    }
    for (described in query_specs) {
        if (Is(forest, described.node, syntax.System) &&
            (callable.node == described.node || Ancestor(forest, Field(forest, described.node, syntax.FieldBody), callable.node))) {
            names.extend(QueryNames(forest, text, types, members, described));
        }
    }
    return names;
}
// The queries whose evaluators `document` declares, as its module owns them.
SourceQueries :: (queries: QuerySpec[], callables: Callable[], document: int) -> QuerySpec[] {
    owned: QuerySpec[] = [];
    for (described in queries) {
        if (callables[described.evaluator].document == document) {
            owned.append(described);
        }
    }
    return owned;
}
// Parsed roots, signatures and catalog types share one index space. Bodies
// establish exact imports; dependencies are assembled before their callers.
SourceNatives :: (documents: snapshot.Document[], callables: Callable[], natives: ResolvedNative[],
                  identities: u64[]) -> ResolvedNative[] {
    owned: u64[] = [];
    for (callable in callables) {
        owned.append(binding.ID("symbol", format_text("{}:1:{}:callable", documents[callable.document].identity,
                                                      callable.name)));
    }
    resolved: ResolvedNative[] = [];
    index: int = 0;
    for (native in natives) {
        row := native;
        for (id in owned) {
            row.source = row.source || identities[2 * index] == id;
        }
        resolved.append(row);
        index += 1;
    }
    return resolved;
}
CompileSources :: (identities: string[], sources: string[], target: Target, abi: u64, names: string[],
                   natives: ResolvedNative[], ports: ResolvedPort[], native_ids: u64[], game_events: GameEvent[],
                   event_fields: GameEventField[], types: GameType[], type_fields: GameField[],
                   entity: u64, operators: NumericOperator[], globals: GameGlobal[], makes: NativeMake[],
                   make_fields: int[], native_effects: int[], context: BodyContext, closure: bool) -> Result {
    ops := ResolveOps(names, true);
    if (abi == 0 || !Complete(ops) || !NativeInputValid(natives, ports, native_ids, native_effects) ||
        length(identities) == 0 || length(identities) != length(sources)) {
        return InputFailure(-1, "unsupported compiler input or target");
    }
    forest: snapshot.SnapshotNode[] = [];
    documents: snapshot.Document[] = [];
    roots: int[] = [];
    links: graph.Binding[] = [];
    module_ids: u64[] = [];
    index: int = 0;
    while (index < length(sources)) {
        id := binding.ID("module", identities[index]);
        for (known in module_ids) {
            if (known == id) {
                return InputFailure(index, "duplicate executable source identity");
            }
        }
        module_ids.append(id);
        top: int = -1;
        first := length(forest);
        switch raw.Parse(sources[index]) {
            case .Rejected(diagnostic):
                return Result.Rejected(snapshot.Stamp(diagnostic, index));
            case .Parsed(nodes, fields, is_named, is_extra, root):
                at: int = 0;
                while (at < length(nodes)) {
                    forest.append(snapshot.Node(nodes[at], fields[at], is_named[at], is_extra[at], first));
                    at += 1;
                }
                top = root + first;
        }
        root := FirstMember(forest, top);
        if ((!Is(forest, root, syntax.Behavior) && !Is(forest, root, syntax.System) && !Is(forest, root, syntax.Library)) ||
            NextMember(forest, root) >= 0) {
            return InputFailure(index, "an executable asset needs one behavior, system or library declaration");
        }
        if (Is(forest, root, syntax.Library)) {
            name := Text(forest, sources[index], Field(forest, root, syntax.FieldName));
            for (link in links) {
                if (link.name == name) {
                    return InputFailure(index, "duplicate library declaration");
                }
            }
            link: graph.Binding = {name: name, file: -1, target: index, import_index: -2};
            links.append(link);
        }
        roots.append(root);
        document: snapshot.Document = {original_path: identities[index], path: identities[index], directory: "",
                                       key: identities[index], identity: identities[index], text: sources[index], root: 0,
                                       syntax_root: top, header_start: 0, header_end: 0, header_line: 0, header_column: 0,
                                       header_document: index, node_start: first, node_count: length(forest) - first,
                                       first_import: 0, import_count: 0, has_key: true, has_syntax: true, has_header: false};
        documents.append(document);
        index += 1;
    }
    namespaces: graph.Binding[] = [];
    index = 0;
    while (index < length(documents)) {
        for (link in links) {
            bound: graph.Binding = {name: link.name, file: index, target: link.target, import_index: -2};
            namespaces.append(bound);
        }
        index += 1;
    }
    declared_types := CharTypes(NativeTypes(types));
    members := NativeFields(type_fields);
    switch DeclareMath(forest, documents, declared_types, members, target) {
        case .Failed(message):
            return InputFailure(0, message);
        case .Read(math_types, math_members):
            declared_types = math_types;
            members = math_members;
    }
    switch PromoteRecords(forest, documents, roots, declared_types, members, target) {
        case .Failed(diagnostic):
            return Result.Rejected(diagnostic);
        case .Read(promoted):
            declared_types = promoted;
    }
    // A library has no owner to query from.
    has_queries := false;
    index = 0;
    while (index < length(documents)) {
        if (!Is(forest, roots[index], syntax.Library)) {
            declared_types = DeclarePointers(forest, sources[index], declared_types, Aliases(namespaces, index),
                                             index, roots[index]);
        }
        node := documents[index].node_start;
        while (node < documents[index].node_start + documents[index].node_count) {
            if (Is(forest, node, syntax.QueryExpression) ||
                (Is(forest, node, syntax.System) && length(Members(forest, Field(forest, node, syntax.FieldParameters))) > 0)) {
                if (Is(forest, roots[index], syntax.Library)) {
                    return Result.Rejected(Diagnose(forest, node, index, "queries need a behavior or system source"));
                }
                has_queries = true;
            }
            node += 1;
        }
        index += 1;
    }
    if (has_queries) {
        declared_types = QueryPointers(declared_types, members);
    }
    query_specs: QuerySpec[] = [];
    games: Game[] = [];
    callables: Callable[] = [];
    params: Param[] = [];
    index = 0;
    while (index < length(documents)) {
        switch DeclareSource(forest, documents[index], index, roots[index], Aliases(namespaces, index),
                             &declared_types, callables, params, game_events, event_fields, entity, operators,
                             globals, makes, make_fields, ops) {
            case .Failed(diagnostic):
                return Result.Rejected(diagnostic);
            case .Read(game, declared, parameters):
                games.append(game);
                callables = declared;
                params = parameters;
        }
        // A source's evaluators follow its callables, which its module owns.
        if (has_queries && !Is(forest, roots[index], syntax.Library)) {
            first := documents[index].node_start;
            switch CollectQueries(forest, sources[index], identities[index], index, first,
                                  first + documents[index].node_count, declared_types, members, callables, params,
                                  natives, ports, query_specs,
                                  SourceNames(forest, roots[index], games[index], declared_types, target), entity,
                                  target, ops) {
                case .Failed(diagnostic):
                    return Result.Rejected(diagnostic);
                case .Collected(query_types, query_members, query_callables, query_params, descriptions):
                    declared_types = query_types;
                    members = query_members;
                    callables = query_callables;
                    params = query_params;
                    query_specs = descriptions;
            }
        }
        index += 1;
    }
    callables = WaitingCallables(forest, callables);
    switch TaskResultDeclarations(callables, params, declared_types, members) {
        case .Collected(task_types, task_members):
            declared_types = task_types;
            members = task_members;
    }
    natives = SourceNatives(documents, callables, natives, native_ids);
    bodies: Body[] = [];
    summaries: int[] = [];
    edges: graph.Edge[] = [];
    constants: ConstDecl[] = [];
    // A scoped parameter's `p^` reads and writes `p` in every body.
    scoped := forest;
    if (AnyReference(params)) {
        scoped = ScopedTargets(forest, documents, callables, params);
    }
    pass: int = 0;
    while (pass < 2) {
        solid: int[] = [];
        solid_document: int = -1;
        index = 0;
        while (index < length(callables)) {
            callable := callables[index];
            generic: int[] = [];
            if (pass > 0) {
                generic = GenericUpdates(scoped, bodies[index], summaries, context);
            }
            if (pass == 0 || length(generic) > 0) {
                game := games[callable.package];
                if (solid_document != callable.document) {
                    solid = SolidOffsets(documents[callable.document].text);
                    solid_document = callable.document;
                }
                undeclared := OccurrenceIn(DocumentHash(documents[callable.document].key), SymbolRecord, 0,
                                           solid[length(solid) - 1]);
                behaving: Name[] = [];
                switch game {
                    case .Package:
                        return InputFailure(callable.document, "invalid executable source mode");
                    case .Library(owner, operators, globals, makes, fields):
                        behaving = BehaviorNames([], globals, TypeWithId(declared_types, owner));
                    case .Behavior(kept, handlers, declared_events, payloads, owner, operators, globals, makes, fields):
                        behaving = BehaviorNames(kept, globals, TypeWithId(declared_types, owner));
                }
                meaning := binding.ID("symbol", format_text("{}:1:{}:callable", identities[callable.package], callable.name));
                if (Is(forest, callable.node, syntax.Handler)) {
                    meaning = game_events[FindEvent(game_events, callable.name)].id;
                } else if (Is(forest, callable.node, syntax.System)) {
                    meaning = game_events[FindEvent(game_events, "Tick")].id;
                }
                if (QueryEvaluator(query_specs, index) < 0) {
                    behaving.extend(SystemNames(forest, documents[callable.document].text, declared_types, members,
                                                query_specs, callable, game_events, event_fields, target));
                }
                body := FunctionBody(scoped, documents, callables, params, &declared_types, members, constants, natives,
                                     ports, native_ids, extend(Aliases(namespaces, callable.document), behaving),
                                     operators, makes, make_fields, index, solid, undeclared, meaning, context,
                                     generic, ops, target, SourceQueries(query_specs, callables, callable.document));
                switch body {
                    case .Failed(diagnostic):
                        return Result.Rejected(diagnostic);
                    case .Specialize(template, call, arguments, caller_names):
                        return InputFailure(callable.document, "unresolved generic call");
                    case .Inferred(value):
                        return InputFailure(callable.document, "expression inferred where a callable body was required");
                    case .Emitted(slots, locals, cells, code, calls, hosts, roots, points, watches, effects,
                                  direct_write, facts):
                        if (pass == 0) {
                            for (call in calls) {
                                target_package := callables[call.callee].package;
                                if (target_package != callable.package) {
                                    edge: graph.Edge = {from: callable.package, to: target_package, import_index: -1};
                                    edges.append(edge);
                                }
                            }
                        }
                }
                if (pass == 0) {
                    bodies.append(body);
                } else {
                    if (!StablePreparation(scoped, bodies[index], body, summaries, context)) {
                        return InputFailure(callable.document, "array update effects changed during preparation");
                    }
                    bodies[index] = body;
                }
            }
            index += 1;
        }
        if (pass == 0) {
            summaries = WriteSummaries(bodies);
        }
        pass += 1;
    }
    done := resize([false], length(documents));
    fingerprints := resize([u64(0)], length(documents));
    starts := resize([int(0)], length(documents));
    lengths := resize([int(0)], length(documents));
    effects := resize([int(0)], length(callables));
    data: u8[] = [];
    remaining := length(documents);
    while (remaining > 0) {
        progress := false;
        index = 0;
        while (index < length(documents)) {
            ready := !done[index];
            for (edge in edges) {
                if (edge.from == index && !done[edge.to]) {
                    ready = false;
                }
            }
            if (ready) {
                switch Assemble(forest, documents, index, index, identities, module_ids, fingerprints,
                                resize([true], length(documents)), namespaces, callables, params, declared_types,
                                members, constants, natives, ports, native_ids, native_effects, effects, ops,
                                target, abi, games[index], bodies, SourceQueries(query_specs, callables, index), []) {
                    case .Rejected(diagnostic):
                        return Result.Rejected(diagnostic);
                    case .Compiled(module, bytes, summaries):
                        effects = summaries;
                        fingerprints[index] = writer.Fingerprint(bytes);
                        if (!closure) {
                            return Result.Compiled(module, bytes);
                        }
                        starts[index] = length(data);
                        lengths[index] = length(bytes);
                        data.extend(bytes);
                }
                done[index] = true;
                remaining -= 1;
                progress = true;
            }
            index += 1;
        }
        if (!progress) {
            return InputFailure(-1, "cross-library import cycle has no publishable generation");
        }
    }
    return Result.Compiled(module_ids[0], writer.Closure(module_ids[0], module_ids, identities, data, starts, lengths));
}
CompileBehaviorsResolved :: (identities: string[], sources: string[], target: Target, abi: u64, names: string[],
                             natives: ResolvedNative[], ports: ResolvedPort[], native_ids: u64[], game_events: GameEvent[],
                             event_fields: GameEventField[], types: GameType[], type_fields: GameField[],
                             entity: u64, operators: NumericOperator[], globals: GameGlobal[], makes: NativeMake[],
                             make_fields: int[], native_effects: int[], context: BodyContext) -> u8[] {
    switch CompileSources(identities, sources, target, abi, names, natives, ports, native_ids, game_events,
                          event_fields, types, type_fields, entity, operators, globals, makes, make_fields,
                          native_effects, context, true) {
        case .Rejected(diagnostic):
            return [];
        case .Compiled(module, bytes):
            return bytes;
    }
}
BehaviorRejectionResolved :: (identities: string[], sources: string[], target: Target, abi: u64, names: string[],
                              natives: ResolvedNative[], ports: ResolvedPort[], native_ids: u64[], game_events: GameEvent[],
                              event_fields: GameEventField[], types: GameType[], type_fields: GameField[],
                              entity: u64, operators: NumericOperator[], globals: GameGlobal[], makes: NativeMake[],
                              make_fields: int[], native_effects: int[], context: BodyContext) -> string {
    switch CompileSources(identities, sources, target, abi, names, natives, ports, native_ids, game_events,
                          event_fields, types, type_fields, entity, operators, globals, makes, make_fields,
                          native_effects, context, true) {
        case .Rejected(diagnostic):
            if (diagnostic.document < 0 || diagnostic.document >= length(identities)) {
                return diagnostic.message;
            }
            return format_text("{}:{}:{}: {}", identities[diagnostic.document], diagnostic.line, diagnostic.column,
                               diagnostic.message);
        case .Compiled(module, bytes):
            return "";
    }
}

// Resolves only reflected native nominal ports. Unsupported ports remain in
// place, so their native indices stay stable and only a use is rejected.
CatalogRecordValid :: (types: TypeDecl[], record: int) -> bool {
    if (record < 0 || record >= length(types)) {
        return false;
    }
    first := types[record];
    at := record;
    depth: int = 0;
    while (depth < length(types)) {
        if (at < 0 || at >= length(types)) {
            return false;
        }
        declared := types[at];
        if ((declared.kind != NativeDecl && declared.kind != MathDecl) || declared.storage != first.storage || declared.size <= 0 ||
            declared.size != first.size || declared.layout != first.layout ||
            (declared.storage == StructStorage && declared.layout == 0)) {
            return false;
        }
        if (declared.parent < 0) {
            return true;
        }
        at = declared.parent;
        depth += 1;
    }
    return false;
}
CatalogPorts :: (ports: CatalogPort[], types: TypeDecl[], entity: u64) -> ResolvedPort[] {
    resolved: ResolvedPort[] = [];
    for (port in ports) {
        record: int = -1;
        storage := port.storage;
        if (port.container < 0 || port.container > ArrayContainer ||
            (storage < UnsupportedPort && storage != AnyPort) || storage > StructStorage) {
            storage = UnsupportedPort;
        }
        if (port.nominal != 0) {
            found := TypeWithId(types, port.nominal);
            duplicate := false;
            // A component's optional query view shares its identity.
            if (found >= 0) {
                at := found + 1;
                while (at < length(types)) {
                    duplicate = duplicate || (types[at].id == port.nominal && types[at].kind != OptionalComponentDecl);
                    at += 1;
                }
            }
            valid := found >= 0 && !duplicate && port.container == 0 &&
                     (storage == StructStorage || storage == HandleStorage);
            if (valid) {
                declared := types[found];
                valid = declared.storage == storage && CatalogRecordValid(types, found);
                if (storage == StructStorage) {
                    valid = valid && declared.size > 0 && declared.layout != 0;
                }
            }
            if (valid) {
                record = found;
            } else {
                storage = UnsupportedPort;
            }
        } else if (storage == StructStorage || storage == HandleStorage) {
            storage = UnsupportedPort;
        }
        if (port.default_owner) {
            owner := TypeWithId(types, entity);
            valid := storage == HandleStorage && port.container == 0 && owner >= 0 && record >= 0;
            if (valid) {
                canonical := Canonical(types, owner);
                valid = CatalogRecordValid(types, owner) && canonical >= 0 && canonical == Canonical(types, record);
            }
            if (!valid) {
                storage = UnsupportedPort;
            }
        }
        row: ResolvedPort = {name: port.name, storage: storage, container: port.container,
                             c_string: port.c_string, record: record, has_default: port.has_default,
                             default_owner: port.default_owner, default_supported: port.default_supported,
                             default_bits: port.default_bits, default_text: port.default_text};
        resolved.append(row);
    }
    return resolved;
}
// Legacy makers adapt ports the pure catalog cannot describe. Rich makers
// require all their ports, so an unsupported maker fails at its selected call.
CatalogMakes :: (makes: NativeMake[], natives: ResolvedNative[], ports: ResolvedPort[]) -> NativeMake[] {
    supported: NativeMake[] = [];
    for (make in makes) {
        if (make.native >= 0 && make.native < length(natives) && Supported(ports, natives[make.native])) {
            supported.append(make);
        }
    }
    return supported;
}
// Rich game entry points carry nominal ports and the real native effects;
// the pure package/bootstrap entry points keep their original record layouts.
pub CompileBehaviorsWithCatalog :: (identities: string[], sources: string[], target: Target, abi: u64,
                                    names: string[], natives: CatalogNative[], ports: CatalogPort[], native_ids: u64[],
                                    game_events: GameEvent[], event_fields: GameEventField[], types: GameType[],
                                    type_fields: GameField[], entity: u64, operators: NumericOperator[],
                                    globals: GameGlobal[], makes: NativeMake[], make_fields: int[],
                                    native_effects: int[]) -> u8[] {
    context: BodyContext = BodyContext.Known(native_effects);
    resolved := CatalogPorts(ports, NativeTypes(types), entity);
    resolved_natives := CatalogNatives(natives);
    if (!NativeInputValid(resolved_natives, resolved, native_ids, native_effects)) {
        return [];
    }
    return CompileBehaviorsResolved(identities, sources, target, abi, names, resolved_natives, resolved, native_ids,
                                    game_events, event_fields, types, type_fields, entity, operators, globals,
                                    CatalogMakes(makes, resolved_natives, resolved), make_fields, native_effects, context);
}
pub BehaviorRejectionWithCatalog :: (identities: string[], sources: string[], target: Target, abi: u64,
                                     names: string[], natives: CatalogNative[], ports: CatalogPort[], native_ids: u64[],
                                     game_events: GameEvent[], event_fields: GameEventField[], types: GameType[],
                                     type_fields: GameField[], entity: u64, operators: NumericOperator[],
                                     globals: GameGlobal[], makes: NativeMake[], make_fields: int[],
                                     native_effects: int[]) -> string {
    context: BodyContext = BodyContext.Known(native_effects);
    resolved := CatalogPorts(ports, NativeTypes(types), entity);
    resolved_natives := CatalogNatives(natives);
    if (!NativeInputValid(resolved_natives, resolved, native_ids, native_effects)) {
        return "unsupported compiler input or target";
    }
    return BehaviorRejectionResolved(identities, sources, target, abi, names, resolved_natives, resolved, native_ids,
                                     game_events, event_fields, types, type_fields, entity, operators, globals,
                                     CatalogMakes(makes, resolved_natives, resolved), make_fields, native_effects, context);
}
