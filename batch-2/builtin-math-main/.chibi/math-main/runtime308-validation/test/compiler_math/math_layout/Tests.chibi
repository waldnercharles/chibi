package math_layout

import math "project:math_types"

Expect :: (kind: int, packing: int, size: int, alignment: int, stride: int, column: int) {
    switch Layout(kind, packing) {
        case .Rejected(message):
            assert(false, "unexpected math layout rejection");
        case .Packed(actual_size, actual_alignment, actual_stride, actual_column):
            assert(actual_size == size, "packed size");
            assert(actual_alignment == alignment, "packed alignment");
            assert(actual_stride == stride, "array stride");
            assert(actual_column == column, "column stride");
    }
}

@test
pub CompactValues :: () {
    Expect(math.Vec2, Compact, 8, 4, 8, 0);
    Expect(math.Vec3, Compact, 12, 4, 12, 0);
    Expect(math.Vec4, Compact, 16, 4, 16, 0);
    Expect(math.Quat, Compact, 16, 4, 16, 0);
    Expect(math.Mat2, Compact, 16, 4, 16, 8);
    Expect(math.Mat3, Compact, 36, 4, 36, 12);
    Expect(math.Mat4, Compact, 64, 4, 64, 16);
}

@test
pub ShaderBufferPacking :: () {
    Expect(math.Scalar, Uniform, 4, 4, 16, 0);
    Expect(math.Vec2, Uniform, 8, 8, 16, 0);
    Expect(math.Vec3, Uniform, 12, 16, 16, 0);
    Expect(math.Vec3, Storage, 12, 16, 16, 0);
    Expect(math.Mat2, Uniform, 32, 16, 32, 16);
    Expect(math.Mat2, Storage, 16, 8, 16, 8);
    Expect(math.Mat3, Uniform, 48, 16, 48, 16);
    Expect(math.Mat3, Storage, 48, 16, 48, 16);
    Expect(math.Mat4, Uniform, 64, 16, 64, 16);
    Expect(math.Mat4, Storage, 64, 16, 64, 16);
}

@test
pub MatrixColumnsHavePadding :: () {
    assert(ComponentOffset(math.Mat3, Compact, 3) == 12, "compact second column");
    assert(ComponentOffset(math.Mat3, Uniform, 3) == 16, "uniform second column");
    assert(ComponentOffset(math.Mat3, Storage, 8) == 40, "last storage component");
    assert(ComponentOffset(math.Mat2, Uniform, 2) == 16, "std140 mat2 column");
    assert(ComponentOffset(math.Vec3, Uniform, 2) == 8, "vec3 z is not padding");
    assert(ComponentOffset(math.Quat, Storage, 3) == 12, "quaternion w");
}

@test
pub ArraysAlignAfterPrecedingFields :: () {
    // In { float lead; float samples[2]; }, samples begins at byte16 in
    // std140, despite the scalar element itself only needing alignment4.
    scalar_array := ArrayAlignment(math.Scalar, Uniform);
    assert(scalar_array == 16, "uniform scalar array base alignment");
    assert(Aligned(4, scalar_array) == 16, "array offset after a scalar field");
    assert(ArrayAlignment(math.Vec2, Uniform) == 16, "uniform vec2 array");
    assert(ArrayAlignment(math.Vec2, Storage) == 8, "storage vec2 array");
    assert(ArrayAlignment(math.Mat2, Storage) == 8, "storage mat2 array");
    assert(ArrayAlignment(math.Mat3, Compact) == 4, "compact matrix array");
    assert(ArrayAlignment(math.Double, Uniform) == -1, "f64 is not f32 math");
}

@test
pub RejectsInvalidLayoutInputs :: () {
    assert(ComponentOffset(math.Mat3, Uniform, -1) == -1, "negative component");
    assert(ComponentOffset(math.Mat3, Uniform, 9) == -1, "past last component");
    assert(ComponentOffset(math.Unknown, Uniform, 0) == -1, "unknown type");
    assert(ComponentOffset(math.Double, Uniform, 0) == -1, "f64 is not f32 math");
    assert(ComponentOffset(math.Vec3, 9, 0) == -1, "unknown packing");
}

pub Check :: () -> int {
    CompactValues();
    ShaderBufferPacking();
    MatrixColumnsHavePadding();
    ArraysAlignAfterPrecedingFields();
    RejectsInvalidLayoutInputs();
    return 0;
}
