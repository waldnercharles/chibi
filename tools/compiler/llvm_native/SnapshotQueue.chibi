package llvm_native

import strings "core:strings"

// Typed jobs borrow source and destination storage for one migration. The
// ring removes a job before calling it, so callbacks can grow the same queue.
// A false callback stops schema validation; value-copy callbacks return true.
SnapshotQueueRuntime :: (guarded: bool = false) -> string {
    return strings.Join([
        "%chibi.snapshot.queue = type { ptr, i32, i32, i32 }\n",
        "%chibi.snapshot.job = type { ptr, ptr, ptr, i32 }\n",
        "\n",
        "; A ring consumes each job before its callback can append or grow storage.\n",
        "; A deep one-child chain needs one allocation, rather than depth-sized history.\n",
        "define internal void @chibi_snapshot.queue.grow(ptr %ctx, ptr %queue) {\n",
        "entry:\n",
        "  %head.at = getelementptr %chibi.snapshot.queue, ptr %queue, i32 0, i32 1\n",
        "  %length.at = getelementptr %chibi.snapshot.queue, ptr %queue, i32 0, i32 2\n",
        "  %capacity.at = getelementptr %chibi.snapshot.queue, ptr %queue, i32 0, i32 3\n",
        "  %head = load i32, ptr %head.at\n",
        "  %length = load i32, ptr %length.at\n",
        "  %old.capacity = load i32, ptr %capacity.at\n",
        "  %bounded = icmp ult i32 %old.capacity, 1073741824\n",
        "  br i1 %bounded, label %size, label %oom\n",
        "size:\n",
        "  %first = icmp eq i32 %old.capacity, 0\n",
        "  %doubled = shl i32 %old.capacity, 1\n",
        "  %capacity = select i1 %first, i32 16, i32 %doubled\n",
        "  %end = getelementptr %chibi.snapshot.job, ptr null, i32 %capacity\n",
        "  %bytes = ptrtoint ptr %end to i64\n",
        ContextCall("allocate", 2, guarded),
        "  %data = call ptr %allocate(ptr %ctx, i64 %bytes)\n",
        "  %previous = load ptr, ptr %queue\n",
        "  %has.previous = icmp ne ptr %previous, null\n",
        "  br i1 %has.previous, label %copy, label %publish\n",
        "copy:\n",
        "  %room = sub i32 %old.capacity, %head\n",
        "  %wrapped = icmp ugt i32 %length, %room\n",
        "  %leading = select i1 %wrapped, i32 %room, i32 %length\n",
        "  %trailing = sub i32 %length, %leading\n",
        "  %first.source = getelementptr %chibi.snapshot.job, ptr %previous, i32 %head\n",
        "  %second.destination = getelementptr %chibi.snapshot.job, ptr %data, i32 %leading\n",
        "  %leading.end = getelementptr %chibi.snapshot.job, ptr null, i32 %leading\n",
        "  %trailing.end = getelementptr %chibi.snapshot.job, ptr null, i32 %trailing\n",
        "  %leading.bytes = ptrtoint ptr %leading.end to i64\n",
        "  %trailing.bytes = ptrtoint ptr %trailing.end to i64\n",
        "  call void @chibi_scalar.copy(ptr %data, ptr %first.source, i64 %leading.bytes)\n",
        "  call void @chibi_scalar.copy(ptr %second.destination, ptr %previous, i64 %trailing.bytes)\n",
        ContextCall("give", 4, guarded),
        "  call void %give(ptr %ctx, ptr %previous)\n",
        "  br label %publish\n",
        "publish:\n",
        "  store ptr %data, ptr %queue\n",
        "  store i32 0, ptr %head.at\n",
        "  store i32 %capacity, ptr %capacity.at\n",
        "  ret void\n",
        "oom:\n",
        "  call void @llvm.trap()\n",
        "  unreachable\n",
        "}\n",
        "\n",
        "define internal void @chibi_snapshot.queue.put(ptr %ctx, ptr %queue, ptr %source, ptr %destination, ptr %callback, i32 %count) {\n",
        "entry:\n",
        "  %head.at = getelementptr %chibi.snapshot.queue, ptr %queue, i32 0, i32 1\n",
        "  %length.at = getelementptr %chibi.snapshot.queue, ptr %queue, i32 0, i32 2\n",
        "  %capacity.at = getelementptr %chibi.snapshot.queue, ptr %queue, i32 0, i32 3\n",
        "  %length = load i32, ptr %length.at\n",
        "  %capacity = load i32, ptr %capacity.at\n",
        "  %full = icmp eq i32 %length, %capacity\n",
        "  br i1 %full, label %grow, label %store\n",
        "grow:\n",
        "  call void @chibi_snapshot.queue.grow(ptr %ctx, ptr %queue)\n",
        "  br label %store\n",
        "store:\n",
        "  %head = load i32, ptr %head.at\n",
        "  %available = load i32, ptr %capacity.at\n",
        "  %mask = sub i32 %available, 1\n",
        "  %tail = add i32 %head, %length\n",
        "  %index = and i32 %tail, %mask\n",
        "  %data = load ptr, ptr %queue\n",
        "  %at = getelementptr %chibi.snapshot.job, ptr %data, i32 %index\n",
        "  %from = insertvalue %chibi.snapshot.job zeroinitializer, ptr %source, 0\n",
        "  %to = insertvalue %chibi.snapshot.job %from, ptr %destination, 1\n",
        "  %call = insertvalue %chibi.snapshot.job %to, ptr %callback, 2\n",
        "  %job = insertvalue %chibi.snapshot.job %call, i32 %count, 3\n",
        "  store %chibi.snapshot.job %job, ptr %at\n",
        "  %next = add i32 %length, 1\n",
        "  store i32 %next, ptr %length.at\n",
        "  ret void\n",
        "}\n",
        "\n",
        "define internal i1 @chibi_snapshot.queue.drain(ptr %ctx, ptr %queue, ptr %session) {\n",
        "entry:\n",
        "  %head.at = getelementptr %chibi.snapshot.queue, ptr %queue, i32 0, i32 1\n",
        "  %length.at = getelementptr %chibi.snapshot.queue, ptr %queue, i32 0, i32 2\n",
        "  %capacity.at = getelementptr %chibi.snapshot.queue, ptr %queue, i32 0, i32 3\n",
        "  br label %next\n",
        "next:\n",
        "  %length = load i32, ptr %length.at\n",
        "  %empty = icmp eq i32 %length, 0\n",
        "  br i1 %empty, label %done, label %take\n",
        "take:\n",
        "  %head = load i32, ptr %head.at\n",
        "  %capacity = load i32, ptr %capacity.at\n",
        "  %data = load ptr, ptr %queue\n",
        "  %at = getelementptr %chibi.snapshot.job, ptr %data, i32 %head\n",
        "  %job = load %chibi.snapshot.job, ptr %at\n",
        "  %source = extractvalue %chibi.snapshot.job %job, 0\n",
        "  %destination = extractvalue %chibi.snapshot.job %job, 1\n",
        "  %callback = extractvalue %chibi.snapshot.job %job, 2\n",
        "  %count = extractvalue %chibi.snapshot.job %job, 3\n",
        "  %mask = sub i32 %capacity, 1\n",
        "  %increment = add i32 %head, 1\n",
        "  %following = and i32 %increment, %mask\n",
        "  %remaining = sub i32 %length, 1\n",
        "  store i32 %following, ptr %head.at\n",
        "  store i32 %remaining, ptr %length.at\n",
        "  %continued = call i1 %callback(ptr %ctx, ptr %session, ptr %source, ptr %destination, i32 %count)\n",
        "  br i1 %continued, label %next, label %rejected\n",
        "rejected:\n",
        "  store i32 0, ptr %head.at\n",
        "  store i32 0, ptr %length.at\n",
        "  ret i1 false\n",
        "done:\n",
        "  ret i1 true\n",
        "}\n",
        "\n",
        "define internal void @chibi_snapshot.queue.release(ptr %ctx, ptr %queue) {\n",
        "entry:\n",
        "  %data = load ptr, ptr %queue\n",
        "  %present = icmp ne ptr %data, null\n",
        "  br i1 %present, label %free, label %done\n",
        "free:\n",
        ContextCall("give", 4, guarded),
        "  call void %give(ptr %ctx, ptr %data)\n",
        "  br label %done\n",
        "done:\n",
        "  store %chibi.snapshot.queue zeroinitializer, ptr %queue\n",
        "  ret void\n",
        "}\n"
    ], "");
}
