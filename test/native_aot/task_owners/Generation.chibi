package owned_generation

foreign import libc "system:c"
foreign libc {
    fopen :: (path: cstring, mode: cstring) -> rawptr
    fwrite :: (data: cstring, size: u64, count: u64, stream: rawptr) -> u64
    fclose :: (stream: rawptr) -> i32
    access :: (path: cstring, mode: i32) -> i32
}
Payload :: struct { text: string; words: string[]; numbers: int[]; }
Promise :: struct { first: int; last: bool; }
RecordWorker :: () -> Promise { yield; return {first: 37, last: true}; }
CheckPromise :: (value: Promise) { assert(value.first == 37 && value.last); }
OwnedWorker :: () -> Payload { yield; return {text: Text(11), words: [Text(13)], numbers: [int(17)]}; }
MapWorker :: () -> [int: string] { if false { yield } return [1: Text(21)]; }
ObserverWorker :: (count: int) -> string { yield; return Text(count); }
CheckOwned :: (value: Payload) {
    assert(text_byte_length(value.text) == 11 && text_byte_length(value.words[0]) == 13 && value.numbers[0] == 17);
}
Text :: (count: int) -> string { return text_from_bytes(resize([u8(120)], count)); }
Exists :: (path: string) -> bool { return access(path, 0) == 0; }
Mark :: (path: string, text: string) {
    stream := fopen(path, "wb");
    assert(stream != 0);
    written := fwrite(text, 1, u64(text_byte_length(text)), stream);
    closed := fclose(stream);
    assert(written == u64(text_byte_length(text)) && closed == 0);
}
Broken :: (changed: ^Payload) {
    changed^.text = Text(17);
    changed^.words = [Text(19)];
    assert(false, "old owned generation failure");
}
Finish :: (payload: Payload) {
    size := text_byte_length(payload.text) + text_byte_length(payload.words[0]) +
            text_byte_length(payload.words[1]) + payload.numbers[1];
    Mark("old-done", format_text("old:{}", size));
}
Worker :: () -> int {
    payload: Payload = {text: text_from_bytes([u8(111), 108, 100]), words: [Text(3), Text(5)], numbers: [int(11), 37]};
    promise := RecordWorker();
    initial := await promise;
    if initial is Cancelled { return 1; }
    else { CheckPromise(initial); }
    owned := OwnedWorker();
    mapped := MapWorker();
    observers := [ObserverWorker(23), ObserverWorker(29)];
    shared_observers := observers;
    observers = [];
    first := await owned;
    if first is Cancelled { return 1; }
    else {
        changed := first;
        CheckOwned(changed);
        changed.text = Text(7);
        changed.words[0] = Text(9);
    }
    map_result := await mapped;
    if map_result is Cancelled { return 1; }
    else { value := map_result; value[1] = Text(41); assert(text_byte_length(value[1]) == 41); }
    while !Exists("allow-old") { yield; }
    repeated := await promise;
    if repeated is Cancelled { return 1; }
    else { CheckPromise(repeated); }
    again := await owned;
    if again is Cancelled { return 1; }
    else { CheckOwned(again); }
    map_again := await mapped;
    if map_again is Cancelled { return 1; }
    else { value := map_again; assert(text_byte_length(value[1]) == 21, "old map promise preserves independent joins after reload"); }
    observed := await shared_observers[0];
    if observed is Cancelled { return 1; }
    else { assert(text_byte_length(observed) == 23); }
    shared_observers[0] = shared_observers[0];
    for index in 0..<64 { shared_observers.set_array_elem(-1, shared_observers[0]); }
    repeated_observer := await shared_observers[0];
    if repeated_observer is Cancelled { return 1; }
    else { assert(text_byte_length(repeated_observer) == 23); }
    shared_observers.remove_item(shared_observers[0]);
    assert(length(shared_observers) == 1);
    after_removal := await shared_observers[0];
    if after_removal is Cancelled { return 1; }
    else { assert(text_byte_length(after_removal) == 29); }
    if Exists("failure-case") { Broken(&payload); }
    Finish(payload);
    return 0;
}
Main :: () -> int {
    worker := Worker();
    Mark("owner-ready", "ready");
    return 0;
}
Frame :: () -> int { return 0; }
