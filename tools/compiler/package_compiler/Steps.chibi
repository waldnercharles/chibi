package package_compiler

import snapshot "project:source_snapshot"
import syntax "project:syntax_diagnostics"
import strings "core:strings"

// The steps EmitBody takes for nodes other than control flow. Each reads the
// body's tables, which calls share rather than copy, and returns only what it
// adds, numbered from the sizes in `at`.

// Whether an array of this element type may hold its elements inline, with a
// nonzero stride, as the runtime decides: scalars and records of scalars may,
// while strings, unions and records with a string field are always boxed.
Packable :: (storage: int, record: int, types: TypeDecl[], members: TypeMember[]) -> bool {
    if (storage == TextStorage || storage == UnionStorage) {
        return false;
    }
    if (storage != StructStorage) {
        return true;
    }
    at := types[record].first;
    while (at < types[record].first + types[record].count) {
        if (members[at].storage == TextStorage) {
            return false;
        }
        at += 1;
    }
    return true;
}
// The slots ElementRead numbers from its `first`: zero, the lower check, the
// count and the upper check, then the slots of ElementLoad.
ElementSlots :: (storage: int, packable: bool, target: Target) -> Slot[] {
    number: Slot = {storage: IntStorage, kind: ValueKind};
    flag: Slot = {storage: BoolStorage, kind: ValueKind};
    checks: Slot[] = [number, flag, number, flag];
    return extend(checks, LoadSlots(storage, packable, target));
}
// Reads the element of the array in slot `array` at the index in slot
// `position` into the last of ElementSlots, after checking 0 <= index < count
// as stage zero does. `pc` is where its code starts; a packable record element
// needs the local `local`.
ElementRead :: (array: int, position: int, storage: int, packable: bool, first: int, pc: int, local: int,
                ops: Ops, target: Target, node: snapshot.SnapshotNode) -> Code[] {
    code: Code[] = [];
    constant := Instruction(ops.constant, IntStorage, first, 0, 0, 0, node);
    constant.value_storage = IntStorage;
    code.append(constant);
    code.append(Instruction(ops.ge, IntStorage, first + 1, position, first, -1, node));
    code.append(Instruction(ops.guard, 0, 0, first + 1, 0, target.argument_failure, node));
    code.append(Instruction(ops.guard, 0, 0, array, 0, target.argument_failure, node));
    count := Instruction(ops.load, IntStorage, first + 2, array, 0, 0, node);
    count.offset = target.count_offset;
    code.append(count);
    code.append(Instruction(ops.lt, IntStorage, first + 3, position, first + 2, -1, node));
    code.append(Instruction(ops.guard, 0, 0, first + 3, 0, target.argument_failure, node));
    return extend(code, ElementLoad(array, position, storage, packable, first + 4, pc + length(code), local, ops,
                                    target, node));
}
// The slots ElementLoad numbers from its `first`. For an element type that is
// never packed: the array's items, the item and the element. Otherwise: the
// array's items, data and stride, a zero word, whether the array is packed,
// the boxed and the actual element width, the index as a word, its byte
// offset, the base, the item, then for a record its boxed pointer and the
// element, and for any other element the payload offset, the offset to use,
// its address and the element.
LoadSlots :: (storage: int, packable: bool, target: Target) -> Slot[] {
    flag: Slot = {storage: BoolStorage, kind: ValueKind};
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    word: Slot = {storage: target.pointer_storage, kind: ValueKind};
    element: Slot = {storage: SlotStorage(storage, 0, target), kind: SlotKind(storage, 0)};
    if (!packable) {
        return [address, address, element];
    }
    slots: Slot[] = [address, address, word, word, flag, word, word, word, word, address, address];
    if (storage == StructStorage) {
        return extend(slots, [address, element]);
    }
    return extend(slots, [word, word, address, element]);
}
// Loads the element at the index in slot `position`, already checked, into
// the last of LoadSlots, as stage zero does: a packed array (nonzero stride)
// holds elements inline in `data`, and any other holds value headers in
// `items`. An element type that is never packed reads `items` alone. A packed
// record is the element itself, so the boxed pointer is loaded only past a
// branch, through local `local`; `pc` is where the code starts.
ElementLoad :: (array: int, position: int, storage: int, packable: bool, first: int, pc: int, local: int,
                ops: Ops, target: Target, node: snapshot.SnapshotNode) -> Code[] {
    code: Code[] = [];
    items := Instruction(ops.load, target.pointer_storage, first, array, 0, 0, node);
    items.offset = target.items_offset;
    code.append(items);
    if (!packable) {
        // The header's payload is the value, or a record's pointer.
        item := Instruction(ops.index, target.pointer_storage, first + 1, first, position, 0, node);
        item.offset = target.value_size;
        code.append(item);
        element := Instruction(ops.load, SlotStorage(storage, 0, target), first + 2, first + 1, 0, 0, node);
        element.offset = target.payload_offset;
        return append(code, element);
    }
    data := Instruction(ops.load, target.pointer_storage, first + 1, array, 0, 0, node);
    data.offset = target.data_offset;
    code.append(data);
    stride := Instruction(ops.load, target.pointer_storage, first + 2, array, 0, 0, node);
    stride.offset = target.stride_offset;
    code.append(stride);
    code.append(ConstantCode(ops, target.pointer_storage, 0, first + 3, node));
    code.append(Instruction(ops.ne, target.pointer_storage, first + 4, first + 2, first + 3, -1, node));
    code.append(ConstantCode(ops, target.pointer_storage, u64(target.value_size), first + 5, node));
    code.append(Instruction(ops.select, target.pointer_storage, first + 6, first + 4, first + 2, first + 5, node));
    code.append(CastCode(ops, target.pointer_storage, first + 7, position, 0, node));
    code.append(Instruction(ops.mul, target.pointer_storage, first + 8, first + 7, first + 6, -1, node));
    code.append(Instruction(ops.select, target.pointer_storage, first + 9, first + 4, first + 1, first, node));
    code.append(Instruction(ops.add, target.pointer_storage, first + 10, first + 9, first + 8, -1, node));
    if (storage == StructStorage) {
        code.append(Instruction(ops.save, target.pointer_storage, 0, first + 10, 0, local, node));
        code.append(Instruction(ops.branch_if, 0, 0, first + 4, 0, pc + length(code) + 3, node));
        pointer := Instruction(ops.load, target.pointer_storage, first + 11, first + 10, 0, 0, node);
        pointer.offset = target.payload_offset;
        code.append(pointer);
        code.append(Instruction(ops.save, target.pointer_storage, 0, first + 11, 0, local, node));
        return append(code, Instruction(ops.local, target.pointer_storage, first + 12, local, 0, 0, node));
    }
    code.append(ConstantCode(ops, target.pointer_storage, u64(target.payload_offset), first + 11, node));
    code.append(Instruction(ops.select, target.pointer_storage, first + 12, first + 4, first + 3, first + 11, node));
    code.append(Instruction(ops.add, target.pointer_storage, first + 13, first + 10, first + 12, -1, node));
    return append(code, Instruction(ops.load, SlotStorage(storage, 0, target), first + 14, first + 13, 0, 0, node));
}
// The locals ElementRead and ElementLoad need: one for a packable record
// element.
ElementLocals :: (storage: int, packable: bool, target: Target) -> Slot[] {
    if (storage == StructStorage && packable) {
        return [{storage: target.pointer_storage, kind: AddressKind}];
    }
    return [];
}

// Copies the record or array in slot `kept.slot` into a fresh snapshot cell
// and produces the copy's address.
RetainStep :: (kept: Value, ops: Ops, target: Target, at: Bases, item: snapshot.SnapshotNode) -> Step {
    code: Code[] = [];
    slots: Slot[] = [];
    locals: Slot[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    argument: Cell = {storage: kept.storage, container: kept.container, record: kept.record, constant: 0, variant: -1, kind: ValueKind};
    cells.append(argument);
    cells.append(argument);
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    slots.append(address);
    code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot, at.cell, 0, 0, item));
    write := Instruction(ops.write, target.pointer_storage, 0, kept.slot, at.slot, 0, item);
    write.offset = target.payload_offset;
    code.append(write);
    code.extend(SchemaWriteCode(kept, at.slot, ops, target, item));
    host: Host = {intrinsic: SnapshotIntrinsic, linked: -1, first: at.cell, result_first: at.cell + 1, result_count: 1,
                  written: false};
    hosts.append(host);
    code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, item));
    slots.append(address);
    code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot + 1, at.cell + 1, 0, 0, item));
    slots.append(address);
    load := Instruction(ops.load, target.pointer_storage, at.slot + 2, at.slot + 1, 0, 0, item);
    load.offset = target.payload_offset;
    code.append(load);
    root: Root = {slot: at.slot + 2, storage: kept.storage, container: kept.container, record: kept.record};
    roots.append(root);
    return CellSchemaStep(Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
                                       Typed(at.slot + 2, kept.storage, kept.container, kept.record), NoValue(), marks),
                          at.cell + 1, ops, target, at, item);
}

// The cell a fresh value moves into instead of a copy, and the code that
// gives the cell's header its payload as it stands.
MovedCell :: (value: Value) -> Cell {
    return {storage: value.storage, container: value.container, record: value.record, constant: 0, variant: -1,
            kind: ValueKind};
}
AddressSlot :: (target: Target) -> Slot {
    return {storage: target.pointer_storage, kind: AddressKind};
}
MoveCode :: (value: Value, ops: Ops, target: Target, slot: int, cell: int, item: snapshot.SnapshotNode) -> Code[] {
    write := Instruction(ops.write, target.pointer_storage, 0, value.slot, slot, 0, item);
    write.offset = target.payload_offset;
    code: Code[] = [Instruction(ops.host_slot, target.pointer_storage, slot, cell, 0, 0, item), write];
    return extend(code, SchemaWriteCode(value, slot, ops, target, item));
}

// A runtime native record schema travels beside its payload pointer. These
// helpers add no cells or locals, and keep the original step's numbering.
SchemaWriteCode :: (value: Value, address: int, ops: Ops, target: Target, node: snapshot.SnapshotNode) -> Code[] {
    if (value.storage != StructStorage || value.container != 0 || value.schema < 0) {
        return [];
    }
    write := Instruction(ops.write, target.pointer_storage, 0, value.schema, address, 0, node);
    write.offset = target.schema_offset;
    return [write];
}
ValueWriteCode :: (value: Value, cell: int, ops: Ops, target: Target, slot: int,
                   node: snapshot.SnapshotNode) -> Code[] {
    code := CellWrite(SlotStorage(value.storage, value.container, target), value.slot, cell, ops, target, slot, node);
    return extend(code, SchemaWriteCode(value, slot, ops, target, node));
}
CellSchemaStep :: (step: Step, cell: int, ops: Ops, target: Target, at: Bases, node: snapshot.SnapshotNode) -> Step {
    switch step {
        case .Failed(diagnostic):
            return Step.Failed(diagnostic);
        case .Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, popped, produced, retained, marks):
            body_code := code;
            body_slots := slots;
            value := produced;
            if (value.storage == StructStorage && value.container == 0) {
                first := at.slot + length(body_slots);
                body_code.append(Instruction(ops.host_slot, target.pointer_storage, first, cell, 0, 0, node));
                load := Instruction(ops.load, target.pointer_storage, first + 1, first, 0, 0, node);
                load.offset = target.schema_offset;
                body_code.append(load);
                body_slots.extend([AddressSlot(target), AddressSlot(target)]);
                value.schema = first + 1;
            }
            return Step.Emitted(body_code, body_slots, locals, cells, hosts, roots, calls, bound, next, popped, value, retained, marks);
    }
}
ArgumentSchemaStep :: (step: Step, argument: int, ops: Ops, target: Target, at: Bases,
                       node: snapshot.SnapshotNode) -> Step {
    switch step {
        case .Failed(diagnostic):
            return Step.Failed(diagnostic);
        case .Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, popped, produced, retained, marks):
            body_code := code;
            body_slots := slots;
            value := produced;
            if (value.storage == StructStorage && value.container == 0) {
                first := at.slot + length(body_slots);
                bank := Instruction(ops.context, target.pointer_storage, first, 0, 0, 0, node);
                bank.offset = target.arguments_offset;
                body_code.append(bank);
                body_code.append(ConstantCode(ops, IntStorage, u64(argument), first + 1, node));
                header := Instruction(ops.index, target.pointer_storage, first + 2, first, first + 1, 0, node);
                header.offset = target.value_size;
                body_code.append(header);
                load := Instruction(ops.load, target.pointer_storage, first + 3, first + 2, 0, 0, node);
                load.offset = target.schema_offset;
                body_code.append(load);
                body_slots.extend([AddressSlot(target), ValueLocal(IntStorage), AddressSlot(target), AddressSlot(target)]);
                value.schema = first + 3;
            }
            return Step.Emitted(body_code, body_slots, locals, cells, hosts, roots, calls, bound, next, popped, value, retained, marks);
    }
}

// A literal without context takes its storage from its spelling, as stage zero
// does. Other expressions supply their own type. Hexadecimal e is a digit;
// only decimal spellings have an exponent.
InferredNumberStorage :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> int {
    literal := Unparenthesized(forest, node);
    digits := literal;
    if (Is(forest, digits, "unary_expression")) {
        digits = Field(forest, digits, "operand");
        operator := Text(forest, text, Field(forest, literal, "operator"));
        if (operator != "-" && operator != "+") {
            return 0;
        }
        if (operator == "+") {
            literal = digits;
        }
    }
    if (!Is(forest, digits, "number")) {
        return 0;
    }
    spelling := Text(forest, text, digits);
    size := strings.ByteLength(spelling);
    hexadecimal := size > 2 && strings.ByteAt(spelling, 0) == 48 &&
                   (strings.ByteAt(spelling, 1) == 120 || strings.ByteAt(spelling, 1) == 88);
    if (!hexadecimal) {
        index: int = 0;
        while (index < size) {
            character := strings.ByteAt(spelling, index);
            if (character == 46 || character == 101 || character == 69) {
                return FloatStorage;
            }
            index += 1;
        }
    }
    switch ParseNumber(forest, text, literal) {
        case .Number(negative, magnitude):
            if (Fits(negative, magnitude, IntStorage)) {
                return IntStorage;
            }
            if (Fits(negative, magnitude, Int64Storage)) {
                return Int64Storage;
            }
        case .Invalid:
            return WordStorage;
    }
    // The constant emitter diagnoses a value beyond uint64's range.
    return WordStorage;
}

// Statements: local declarations, assignments, expression statements and
// returns, from scheduling to the value's store.
// A function's named results are locals from `named` on.
StatementStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, callables: Callable[],
                  params: Param[], types: TypeDecl[], members: TypeMember[], natives: ResolvedNative[], ports: ResolvedPort[],
                  identities: u64[], names: Name[], scope: int, package: int, values: Value[], top: int,
                  function: int, named: int, referenced: string[], mutated: string[], built: int[], addressed: string[],
                  generic_updates: int[], item: Work,
                  ops: Ops, target: Target, at: Bases) -> Step {
    callable := callables[function];
    node := forest[item.node];
    kind := node.kind;
    code: Code[] = [];
    slots: Slot[] = [];
    locals: Slot[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    popped: int = 0;
    produced := NoValue();
    retained := NoValue();
    // `xs.append(x)` and the other methods that change an array assign the
    // name its changed array, as `xs = append(xs, x)` does.
    changing := ChangedArray(forest, text, names, natives, ports, item.node) >= 0;
    if (item.phase == 0) {
        code.append(Instruction(ops.check, 0, 0, 0, 0, 0, node));
        if (kind == "assignment" && QueryReadonlyDestination(forest, text, types, members, names,
                                                             StatementTarget(forest, item.node))) {
            return Fail(forest, item.node, document, "Query value bindings are read-only; use a component pointer to modify storage");
        }
        value := Field(forest, item.node, "value");
        if (kind == "expression_statement") {
            value = FirstMember(forest, item.node);
        }
        if (kind == "delete_statement" ||
            (kind == "expression_statement" && MapMethod(forest, text, names, value, "delete"))) {
            return MapDeleteStep(forest, text, document, types, names, item, ops, node);
        }
        if (kind == "assignment" && PointerDestination(forest, text, types, members, names,
                                                       StatementTarget(forest, item.node))) {
            return PointerAssignmentStart(forest, text, document, types, members, names, item, ops, target, at);
        }
        expected := Visit(value);
        if (kind == "local_declaration") {
            declared := Field(forest, item.node, "type");
            if (declared >= 0) {
                hidden := PrivateType(forest, text, types, names, package, declared);
                if (hidden >= 0) {
                    return Fail(forest, hidden, document, PrivateMessage(Text(forest, text, hidden)));
                }
                resolved := ReadType(forest, text, types, names, package, declared);
                if (resolved.storage == 0) {
                    return Fail(forest, declared, document, "local type is not supported yet");
                }
                if (value < 0) {
                    if (resolved.storage != PointerStorage || resolved.container != 0 || resolved.record < 0 ||
                        types[resolved.record].key == 0) {
                        return Fail(forest, item.node, document, "non-null pointer local requires an initial value");
                    }
                    name_node := Field(forest, item.node, "name");
                    name := Text(forest, text, name_node);
                    if (Declared(names, scope, name)) {
                        return Fail(forest, name_node, document, format_text("Duplicate declaration '{}'", name));
                    }
                    constant := ConstantCode(ops, PointerStorage, 0, at.slot, node);
                    constant.value_record = resolved.record;
                    if (Holds(addressed, name)) {
                        return PointerPrefix([constant], [{storage: PointerStorage, kind: ValueKind}],
                                             ManagedBoxStep(types, members, Typed(at.slot, PointerStorage, 0, resolved.record),
                                                            name, name_node, 0, ops, target, SlotsPast(at, 1), node));
                    }
                    code.extend([constant, Instruction(ops.save, PointerStorage, 0, at.slot, 0, at.local, node),
                                 SymbolCode(ops, name_node, node)]);
                    binding: Name = {name: name, place: LocalPlace, index: at.local, storage: PointerStorage,
                                     container: 0, record: resolved.record, writable: true, node: name_node};
                    return Step.Emitted(code, [{storage: PointerStorage, kind: ValueKind}],
                                        [ValueLocal(PointerStorage)], [], [], [], [], [binding], [], 0,
                                        NoValue(), NoValue(), []);
                }
                expected = Expect(value, resolved.storage, resolved.container, resolved.record);
            } else {
                inferred := InferredNumberStorage(forest, text, value);
                if (inferred > 0) {
                    expected = Expect(value, inferred, 0, -1);
                }
            }
        } else if (kind == "return_statement") {
            expected = Expect(value, callable.result, callable.result_container, callable.result_record);
        } else if (kind == "assignment" || changing) {
            destination := StatementTarget(forest, item.node);
            operator := CompoundOperator(Text(forest, text, Field(forest, item.node, "operator")));
            whole := SelfComponent(forest, text, types, names, destination);
            owned: int = -1;
            if (Is(forest, destination, "member_expression")) {
                owned = SelfComponent(forest, text, types, names, Field(forest, destination, "object"));
            }
            other := EntityComponent(forest, text, types, members, names, destination);
            other_owned: int = -1;
            if (Is(forest, destination, "member_expression")) {
                other_owned = EntityComponent(forest, text, types, members, names,
                                              Field(forest, destination, "object"));
            }
            if (Is(forest, destination, "identifier")) {
                found := Lookup(names, Text(forest, text, destination));
                if (found >= 0) {
                    binding := names[found];
                    expected = Expect(value, binding.storage, binding.container, binding.record);
                    // A compound write reads a managed target, with its points,
                    // before its value, as stage zero caches the target.
                    if (binding.place == ManagedPlace && operator != "") {
                        code.extend(NamePoints(forest, text, names, ops, destination));
                        read := PointerContinue(ManagedReadStep(types, binding, ops, target, at, node), expected);
                        return PointerPrefix(code, [], PointerContinue(read, Resume(item.node, PointerCompoundPhase,
                                                                                    found, 0)));
                    }
                    // `xs = append(xs, x)` and `xs = extend(xs, ys)` on a
                    // local array update it in place.
                    update: int = -1;
                    array: int = -1;
                    argument: int = -1;
                    // A method call updates in place only as its own statement;
                    // `xs = xs.append(x)` is an error CallStep reports.
                    if (operator == "" &&
                        (changing || !Is(forest, Field(forest, value, "function"), "member_expression"))) {
                        switch InPlaceUpdate(forest, text, callables, natives, ports, identities, names, package,
                                             found, destination, value) {
                            case .NotApplicable:
                                update = -1;
                            case .InPlace(mode, receiver, supplied, native):
                                // Preparation keeps contextual element typing, but no
                                // body is published before its WRITE proof closes.
                                next.append(RecordSemantic(item.node, UpdateFact, supplied));
                                next.append(RecordSemantic(value, NativeFact, native));
                                if (!generic_updates.contains(item.node)) {
                                    update = mode;
                                    array = receiver;
                                    argument = supplied;
                                }
                        }
                    }
                    if (update >= 0) {
                        // Stage zero evaluates the target, the call and the
                        // array it updates, as their points show; it writes a
                        // parameter through the reference the target reads.
                        if (Parameter(forest, binding)) {
                            code.extend(NamePoints(forest, text, names, ops, destination));
                        } else {
                            code.append(ExpressionCode(ops, forest[destination]));
                        }
                        code.append(ExpressionCode(ops, forest[value]));
                        code.extend(NamePoints(forest, text, names, ops, array));
                        address := AddressSlot(target);
                        slots.extend([address, address]);
                        code.extend(CellRead(target.pointer_storage, binding.index, ops, target, at.slot,
                                             forest[array]));
                        receiver: Root = {slot: at.slot + 1, storage: binding.storage, container: ArrayContainer,
                                          record: binding.record};
                        roots.append(receiver);
                        if (ops.debug) {
                            code.append(WatchCode(ops, at.slot + 1, binding.storage, ArrayContainer, binding.record,
                                                  0, true, forest[array], target));
                            code.append(WatchCode(ops, at.slot + 1, binding.storage, ArrayContainer, binding.record,
                                                  0, false, forest[value], target));
                        }
                        container: int = 0;
                        if (update == 1) {
                            container = ArrayContainer;
                        }
                        next.append(Expect(argument, binding.storage, container, binding.record));
                        finish := Resume(item.node, PushPhase, found, update);
                        finish.c = array;
                        next.append(finish);
                        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
                                            NoValue(), retained, marks);
                    }
                    if (operator != "" || Parameter(forest, binding) || binding.place == ManagedPlace) {
                        code.extend(NamePoints(forest, text, names, ops, destination));
                    }
                }
            } else if (whole >= 0) {
                code.extend(TargetPoints(forest, text, names, ops, destination));
                // The target's owner is watched as `self`, in a slot before
                // the component step's.
                code.extend(OwnerWatch(ops, at.slot, forest[TargetRoot(forest, destination)]));
                shifted := SlotsPast(at, 1);
                // `self.C op= v` combines the owner's component with the value
                // and writes the result through the reference it read.
                write := Resume(item.node, ComponentAssignPhase, shifted.slot + ComponentReferenceSlot, whole);
                if (operator == "") {
                    return PrefixSlots([ValueLocal(HandleStorage)],
                                       ComponentMakeStep(code, types, whole, -1, [Visit(value), write], ops, target,
                                                         shifted, node));
                }
                combine := Resume(item.node, CombinePhase, 0, 0);
                return PrefixSlots([ValueLocal(HandleStorage)],
                                   ComponentReadStep(code, types, whole, true, -1, [Visit(value), combine, write], ops,
                                                     target, shifted, node));
            } else if (owned >= 0) {
                // `self.C.f = v` on a component of the owner.
                code.extend(TargetPoints(forest, text, names, ops, destination));
                member := Text(forest, text, Field(forest, destination, "member"));
                field := FindField(types, members, owned, member);
                if (field < 0) {
                    return Fail(forest, destination, document, format_text("Unknown field '{}'", member));
                }
                if (members[field].c_string) {
                    message := CStringMessage(forest, text, value, members[field].name);
                    if (message != "") {
                        return Fail(forest, value, document, message);
                    }
                }
                if (!members[field].writable) {
                    return Fail(forest, destination, document, "Assignment requires a writable value");
                }
                code.extend(OwnerWatch(ops, at.slot, forest[TargetRoot(forest, destination)]));
                return PrefixSlots([ValueLocal(HandleStorage)],
                                   ComponentReferenceStep(code, types, members, owned, field, -1, value,
                                                          operator != "", item, ops, target, SlotsPast(at, 1), node));
            } else if (other >= 0 || other_owned >= 0) {
                // `e.C = v` and `e.C.f = v` on a component of another entity:
                // the entity, then the reference to its component.
                component := other;
                field: int = -1;
                entity := Field(forest, destination, "object");
                if (other_owned >= 0) {
                    component = other_owned;
                    entity = Field(forest, entity, "object");
                    member := Text(forest, text, Field(forest, destination, "member"));
                    field = FindField(types, members, component, member);
                    if (field < 0) {
                        return Fail(forest, destination, document, format_text("Unknown field '{}'", member));
                    }
                    if (members[field].c_string) {
                        message := CStringMessage(forest, text, value, members[field].name);
                        if (message != "") {
                            return Fail(forest, value, document, message);
                        }
                    }
                    if (!members[field].writable) {
                        return Fail(forest, destination, document, "Assignment requires a writable value");
                    }
                }
                // The members above the entity have points; the entity has
                // its own as it is evaluated.
                at_member := destination;
                while (at_member != entity) {
                    code.append(ExpressionCode(ops, forest[at_member]));
                    at_member = Field(forest, at_member, "object");
                }
                write := Resume(item.node, EntityComponentPhase, component, field);
                if (operator != "") {
                    write.c = 1;
                }
                next.extend([Visit(entity), write]);
                return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
                                    NoValue(), retained, marks);
            } else if (Is(forest, destination, "member_expression")) {
                // `x.f = v` on a local record, written as stage zero writes it.
                object := Field(forest, destination, "object");
                found: int = -1;
                if (Is(forest, object, "identifier")) {
                    found = Lookup(names, Text(forest, text, object));
                }
                if (found >= 0 && !names[found].writable) {
                    return Fail(forest, destination, document, "Assignment requires a writable value");
                }
                if (found < 0 || (names[found].place != CellPlace && names[found].place != ReferencePlace) ||
                    names[found].storage != StructStorage || names[found].container != 0) {
                    return Fail(forest, destination, document, "field assignment needs a local record");
                }
                member := Text(forest, text, Field(forest, destination, "member"));
                field := FindField(types, members, names[found].record, member);
                if (field < 0) {
                    return Fail(forest, destination, document, format_text("Unknown field '{}'", member));
                }
                if (members[field].c_string) {
                    message := CStringMessage(forest, text, value, members[field].name);
                    if (message != "") {
                        return Fail(forest, value, document, message);
                    }
                }
                code.extend(TargetPoints(forest, text, names, ops, destination));
                next.append(Expect(value, members[field].storage, 0, -1));
                write := Resume(item.node, FieldPhase, found, field);
                if (operator != "") {
                    write.c = 1;
                }
                next.append(write);
                return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
                                    NoValue(), retained, marks);
            } else if (Is(forest, destination, "index_expression")) {
                // `xs[i] = x` on a local array stores in place.
                object := Field(forest, destination, "object");
                found: int = -1;
                if (Is(forest, object, "identifier")) {
                    found = Lookup(names, Text(forest, text, object));
                }
                if (found >= 0 && names[found].container == MapContainer) {
                    return MapStoreStep(forest, text, document, types, names, found, item, ops, node);
                }
                if (found < 0 || names[found].place != CellPlace || names[found].container != ArrayContainer ||
                    !names[found].writable) {
                    return Fail(forest, destination, document, "element assignment needs a local array");
                }
                binding := names[found];
                compound: int = 0;
                code.append(ExpressionCode(ops, forest[destination]));
                if (operator != "") {
                    compound = 1;
                }
                if (operator != "" || Parameter(forest, binding)) {
                    code.extend(NamePoints(forest, text, names, ops, object));
                }
                next.append(Expect(Field(forest, destination, "index"), IntStorage, 0, -1));
                next.append(Expect(value, binding.storage, 0, binding.record));
                next.append(Resume(item.node, StorePhase, found, compound));
                return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
                                    NoValue(), retained, marks);
            }
        }
        if (kind == "return_statement" && callable.results > 0) {
            return NamedReturnStep(forest, document, code, params, callable, named, value, item, ops, target, at, node);
        }
        if (kind == "return_statement" && value < 0) {
            if (callable.result != 0) {
                return Fail(forest, item.node, document, "return needs a value");
            }
            code.append(CompletionCode(ops, node));
            code.append(Instruction(ops.finish, 0, 0, 0, 0, 0, node));
        } else {
            next.append(expected);
            next.append(Resume(item.node, ValuePhase, 0, 0));
        }
    } else if (item.phase == ValuePhase) {
        popped = 1;
        result := values[top - 1];
        if (result.storage < 0 && result.storage != NumberStorage && !Single(result, ResultsStorage) &&
            !Single(result, FunctionResultsStorage) && kind != "expression_statement") {
            return Fail(forest, item.node, document, "call has no value");
        }
        if (kind == "local_declaration") {
            declared := Field(forest, item.node, "type");
            local := result;
            if (declared < 0 && result.storage == NumberStorage) {
                return Fail(forest, Field(forest, item.node, "value"), document,
                            "local initializer has no concrete numeric type");
            }
            if (declared >= 0) {
                resolved := ReadType(forest, text, types, names, package, declared);
                local = Typed(-1, resolved.storage, resolved.container, resolved.record);
            }
            if (result.container == 0 && local.container == 0 &&
                (Widens(result.storage, local.storage) || FloatWidens(result.storage, local.storage))) {
                widened: Slot = {storage: local.storage, kind: ValueKind};
                slots.append(widened);
                code.extend(NumberCode(ops, result.storage, local.storage, result.slot, at.slot + length(slots) - 1, node));
                result = Typed(at.slot + length(slots) - 1, local.storage, 0, -1);
            }
            if (!Accepts(types, local.storage, local.container, local.record, result)) {
                return Fail(forest, item.node, document, "local value differs from its type");
            }
            name := Text(forest, text, Field(forest, item.node, "name"));
            if (name == "") {
                return Fail(forest, Field(forest, item.node, "name"), document, "Invalid string or embedded NUL");
            }
            if (Declared(names, scope, name)) {
                return Fail(forest, Field(forest, item.node, "name"), document, format_text("Duplicate declaration '{}'", name));
            }
            if ((Single(result, ResultsStorage) || Single(result, FunctionResultsStorage)) && declared < 0) {
                // The local reads the call's result cells.
                binding: Name = {name: name, place: ResultsPlace, index: result.slot, storage: result.storage,
                                 container: 0, record: result.record, writable: false,
                                 node: Field(forest, item.node, "name")};
                bound.append(binding);
            } else if (Holds(addressed, name)) {
                return PointerPrefix(code, slots,
                                     ManagedBoxStep(types, members, Typed(result.slot, local.storage, local.container, local.record),
                                                    name, Field(forest, item.node, "name"), 1, ops, target,
                                                    SlotsPast(at, length(slots)), node));
            } else if (Pointer(local.storage, local.container)) {
                // The local is the cell that holds its own copy, or the value
                // itself when it is fresh, or when neither it nor what it
                // reads ever changes.
                code.append(SymbolCode(ops, Field(forest, item.node, "name"), node));
                if (Fresh(forest, text, callables, natives, types, names, package, Field(forest, item.node, "value")) ||
                    (!Holds(mutated, name) &&
                     Unchanging(forest, text, callables, natives, types, names, package, mutated, Field(forest, item.node, "value")))) {
                    cells.append(MovedCell(result));
                    slots.append(AddressSlot(target));
                    code.extend(MoveCode(result, ops, target, at.slot + length(slots) - 1,
                                         at.cell + length(cells) - 1, node));
                    produced = result;
                } else {
                    retained = result;
                }
                next.append(Resume(item.node, RetainedPhase, 0, 0));
            } else if (Holds(referenced, name)) {
                // A scoped argument lends it, so it lives in a data cell.
                return BoxStep(forest, text, local, result, item, ops, target, at, node);
            } else {
                locals.append(ValueLocal(local.storage));
                code.append(Instruction(ops.save, local.storage, 0, result.slot, 0, at.local, node));
                code.append(SymbolCode(ops, Field(forest, item.node, "name"), node));
                binding: Name = {name: name, place: LocalPlace, index: at.local, storage: local.storage, container: 0,
                                 record: local.record, writable: true, node: Field(forest, item.node, "name")};
                bound.append(binding);
            }
        } else if (kind == "assignment" || changing) {
            destination := StatementTarget(forest, item.node);
            found: int = -1;
            if (Is(forest, destination, "identifier")) {
                found = Lookup(names, Text(forest, text, destination));
            }
            if (found < 0 || names[found].place == ParameterPlace || Alias(names[found].place) ||
                names[found].place == SelfPlace) {
                return Fail(forest, destination, document, "assignment needs a local name");
            }
            if (names[found].place == ResultsPlace) {
                return Fail(forest, destination, document, "assigning a native's several results is not supported yet");
            }
            if (!names[found].writable) {
                return Fail(forest, destination, document, "Assignment requires a writable value");
            }
            binding := names[found];
            operator := CompoundOperator(Text(forest, text, Field(forest, item.node, "operator")));
            if (binding.container == 0 && MixedCompoundIntegers(operator, binding.storage, result)) {
                return Fail(forest, item.node, document,
                            format_text("Mismatched integer types {} and {}; convert one operand",
                                        TypeName(binding.storage), TypeName(result.storage)));
            }
            if (binding.place == ManagedPlace) {
                return ManagedAssignStep(types, binding, result, ops, target, at, node);
            }
            if (binding.place == ReferencePlace || binding.place == BoxPlace) {
                return WriteStep(PlaceAssignStep(forest, text, document, binding, result, item, ops, target, at, node),
                                 item.node, binding.place == ReferencePlace);
            }
            stored := result;
            if (binding.container == 0 && result.container == 0 &&
                (Widens(result.storage, binding.storage) || FloatWidens(result.storage, binding.storage))) {
                widened: Slot = {storage: binding.storage, kind: ValueKind};
                slots.append(widened);
                code.extend(NumberCode(ops, result.storage, binding.storage, result.slot, at.slot + length(slots) - 1, node));
                result = Typed(at.slot + length(slots) - 1, binding.storage, 0, -1);
                stored = result;
            }
            if (operator != "") {
                op := BinaryOp(ops, operator);
                if (op < 0 || Comparison(ops, op) || !Numeric(binding.storage) || binding.container != 0 ||
                    !Single(result, binding.storage)) {
                    return Fail(forest, item.node, document, "compound assignment needs number operands of its type");
                }
                if (!Computes(ops, op, binding.storage)) {
                    return Fail(forest, item.node, document, "unsupported arithmetic type");
                }
                current: Slot = {storage: binding.storage, kind: ValueKind};
                slots.append(current);
                read := ops.local;
                if (binding.place == StatePlace) {
                    read = ops.variable;
                }
                code.append(Instruction(read, binding.storage, at.slot + length(slots) - 1, binding.index, 0,
                                        0, node));
                // Stage zero watches the target it reads and the value it
                // stores.
                code.append(ScalarWatch(ops, at.slot + length(slots) - 1, binding.storage, 0, true,
                                        forest[destination]));
                slots.append(current);
                code.append(Instruction(op, binding.storage, at.slot + length(slots) - 1,
                                        at.slot + length(slots) - 2, result.slot, -1, node));
                code.append(ScalarWatch(ops, at.slot + length(slots) - 1, binding.storage, 0, true,
                                        forest[destination]));
                stored = Typed(at.slot + length(slots) - 1, binding.storage, 0, -1);
            }
            if (!Accepts(types, binding.storage, binding.container, binding.record, stored)) {
                return Fail(forest, item.node, document, "assigned value differs from its local");
            }
            if (binding.place == CellPlace) {
                // A fresh value replaces the cell's payload without a copy.
                if (Fresh(forest, text, callables, natives, types, names, package, StatementValue(forest, item.node))) {
                    produced = stored;
                } else {
                    retained = stored;
                }
                next.append(Resume(item.node, RetainedPhase, binding.index, 0));
            } else if (binding.place == StatePlace) {
                next.append(RecordSemantic(item.node, WriteFact, 0));
                if (binding.storage == TextStorage) {
                    // STORE_VALUE snapshots the descriptor and its bytes into
                    // the instance's storage, beyond this invocation's arena.
                    initial: Cell = {storage: TextStorage, container: 0, record: -1, constant: 0,
                                     variant: -1, kind: ValueKind};
                    cells.append(initial);
                    slots.append(AddressSlot(target));
                    code.extend(CellWrite(TextStorage, stored.slot, at.cell, ops, target,
                                          at.slot + length(slots) - 1, node));
                    code.append(Instruction(ops.store_value, 0, 0, at.cell, 0, binding.index, node));
                } else {
                    code.append(Instruction(ops.store, binding.storage, 0, stored.slot, 0, binding.index, node));
                }
            } else {
                code.append(Instruction(ops.save, binding.storage, 0, stored.slot, 0, binding.index, node));
            }
            if (!Parameter(forest, binding)) {
                code.append(SymbolCode(ops, binding.node, node));
            }
        } else if (kind == "return_statement") {
            if (result.container == 0 && callable.result_container == 0 &&
                (Widens(result.storage, callable.result) || FloatWidens(result.storage, callable.result))) {
                widened: Slot = {storage: callable.result, kind: ValueKind};
                slots.append(widened);
                code.extend(NumberCode(ops, result.storage, callable.result, result.slot, at.slot + length(slots) - 1, node));
                result = Typed(at.slot + length(slots) - 1, callable.result, 0, -1);
            }
            if (!Returns(types, callable.result, callable.result_container, callable.result_record, result) &&
                !Accepts(types, callable.result, callable.result_container, callable.result_record, result)) {
                return Fail(forest, item.node, document, "returned value differs from the result type");
            }
            if (Pointer(result.storage, result.container) &&
                (Fresh(forest, text, callables, natives, types, names, package, Field(forest, item.node, "value")) ||
                 BuiltName(forest, text, names, built, Field(forest, item.node, "value")))) {
                // A fresh value is already the copy a return would make, and
                // a built local already lies in the caller's storage.
                cells.append(MovedCell(result));
                slots.append(AddressSlot(target));
                code.extend(MoveCode(result, ops, target, at.slot + length(slots) - 1,
                                     at.cell + length(cells) - 1, node));
                produced = result;
                next.append(Resume(item.node, RetainedPhase, -1, 0));
            } else if (Pointer(result.storage, result.container)) {
                retained = result;
                next.append(Resume(item.node, RetainedPhase, -1, 0));
            } else {
                code.append(SymbolCode(ops, -1, forest[Field(forest, item.node, "value")]));
                code.append(CompletionCode(ops, node));
                code.append(Instruction(ops.result, result.storage, 0, result.slot, 0, 0, node));
                code.append(Instruction(ops.finish, 0, 0, 0, 0, 0, node));
            }
        }
    } else if (item.phase == FieldPhase) {
        popped = 1;
        binding := names[item.a];
        return WriteStep(EffectsStep(FieldStep(forest, text, document, binding, members[item.b], values[top - 1], item,
                                               ops, target, at, node), MemberEffects(types, binding.record)),
                         item.node, binding.place == ReferencePlace);
    } else if (item.phase == ComponentPhase) {
        return WriteStep(ComponentWriteStep(forest, text, document, members[item.b], values[top - 1], item, ops,
                                            target, at, node), item.node, true);
    } else if (item.phase == ComponentAssignPhase) {
        return WriteStep(ComponentAssignStep(forest, document, types, values[top - 1], item, ops, target, at, node),
                         item.node, true);
    } else if (item.phase == EntityComponentPhase) {
        return EntityComponentStep(forest, types, members, values[top - 1], item, ops, target, at, node);
    } else if (item.phase == ReturnsPhase) {
        return ResultsStep(forest, document, types, params, callable, named, values, top, item, ops, target, at, node);
    } else if (item.phase == MapStorePhase || item.phase == MapDeletePhase) {
        return MapUpdateStep(forest, text, document, types, names, values, top, item, ops, target, at, node);
    } else if (item.phase == RetainedPhase) {
        // A retained copy or a moved fresh value, in the last cell: bind it,
        // store it in a local's cell, or publish its header.
        popped = 1;
        kept := values[top - 1];
        address: Slot = {storage: target.pointer_storage, kind: AddressKind};
        if (kind == "local_declaration") {
            binding: Name = {name: Text(forest, text, Field(forest, item.node, "name")), place: CellPlace,
                             index: at.cell - 1, storage: kept.storage, container: kept.container, record: kept.record,
                             writable: true, node: Field(forest, item.node, "name")};
            bound.append(binding);
        } else if (kind == "assignment" || changing) {
            slots.append(address);
            code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot, item.a, 0, 0, node));
            write := Instruction(ops.write, target.pointer_storage, 0, kept.slot, at.slot, 0, node);
            write.offset = target.payload_offset;
            code.append(write);
            code.extend(SchemaWriteCode(kept, at.slot, ops, target, node));
        } else {
            // Copy the cell's whole header, type name and layout included,
            // into result zero.
            code.append(SymbolCode(ops, -1, forest[Field(forest, item.node, "value")]));
            code.append(CompletionCode(ops, node));
            slots.append(address);
            code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot, at.cell - 1, 0, 0, node));
            slots.append(address);
            context := Instruction(ops.context, target.pointer_storage, at.slot + 1, 0, 0, 0, node);
            context.offset = target.results_offset;
            code.append(context);
            zero: Slot = {storage: IntStorage, kind: ValueKind};
            slots.append(zero);
            constant := Instruction(ops.constant, IntStorage, at.slot + 2, 0, 0, 0, node);
            constant.value_storage = IntStorage;
            code.append(constant);
            slots.append(address);
            element := Instruction(ops.index, target.pointer_storage, at.slot + 3, at.slot + 1, at.slot + 2, 0, node);
            element.offset = target.value_size;
            code.append(element);
            header: int[] = [target.type_offset, target.container_offset, target.name_offset,
                             target.record_offset, target.schema_offset, target.payload_offset];
            part: int = 0;
            while (part < 6) {
                loaded := address;
                if (part < 2) {
                    loaded = zero;
                }
                slots.append(loaded);
                load := Instruction(ops.load, loaded.storage, at.slot + length(slots) - 1, at.slot, 0, 0, node);
                load.offset = header[part];
                code.append(load);
                store := Instruction(ops.write, loaded.storage, 0, at.slot + length(slots) - 1, at.slot + 3, 0, node);
                store.offset = header[part];
                code.append(store);
                part += 1;
            }
            code.append(Instruction(ops.finish, 0, 0, 0, 0, 0, node));
        }
    } else {
        // An in-place update of the local array names[item.a]: a push or an
        // extension, or an element store (compound when item.b is 1).
        binding := names[item.a];
        item_value := NoValue();
        index_value := NoValue();
        intrinsic := ArrayStoreIntrinsic;
        item_container: int = 0;
        if (item.phase == PushPhase) {
            popped = 1;
            item_value = values[top - 1];
            intrinsic = ArrayPushIntrinsic;
            if (item.b == 1) {
                intrinsic = ArrayExtendIntrinsic;
                item_container = ArrayContainer;
            }
        } else if (item.b == 1) {
            // Read the element at the index already evaluated, then combine.
            popped = 2;
            index_value = values[top - 2];
            operand := values[top - 1];
            op := BinaryOp(ops, CompoundOperator(Text(forest, text, Field(forest, item.node, "operator"))));
            if (op < 0 || Comparison(ops, op) || binding.storage != IntStorage || !Single(operand, IntStorage)) {
                return Fail(forest, item.node, document, "compound assignment needs int operands");
            }
            if (!Single(index_value, IntStorage)) {
                return Fail(forest, item.node, document, "index needs an int");
            }
            address: Slot = {storage: target.pointer_storage, kind: AddressKind};
            slots.append(address);
            code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot, binding.index, 0, 0, node));
            slots.append(address);
            load := Instruction(ops.load, target.pointer_storage, at.slot + 1, at.slot, 0, 0, node);
            load.offset = target.payload_offset;
            code.append(load);
            root: Root = {slot: at.slot + 1, storage: IntStorage, container: ArrayContainer, record: -1};
            roots.append(root);
            slots.extend(ElementSlots(IntStorage, true, target));
            code.extend(ElementRead(at.slot + 1, index_value.slot, IntStorage, true, at.slot + 2,
                                    at.pc + length(code), -1, ops, target, node));
            element := at.slot + length(slots) - 1;
            code.append(ScalarWatch(ops, element, IntStorage, 0, true,
                                    forest[Field(forest, item.node, "target")]));
            combined: Slot = {storage: IntStorage, kind: ValueKind};
            slots.append(combined);
            code.append(Instruction(op, IntStorage, element + 1, element, operand.slot, -1, node));
            item_value = Typed(element + 1, IntStorage, 0, -1);
        } else {
            popped = 2;
            index_value = values[top - 2];
            item_value = values[top - 1];
        }
        if (intrinsic == ArrayStoreIntrinsic && !Single(index_value, IntStorage)) {
            return Fail(forest, item.node, document, "index needs an int");
        }
        if (!SameType(binding.storage, item_container, binding.record, item_value)) {
            return Fail(forest, item.node, document, "array item differs from the array's type");
        }
        // The intrinsic takes the local's header address, then the index of a
        // store, then the item; it returns a bool.
        address_cell: Cell = {storage: target.pointer_storage, container: 0, record: -1, constant: 0, variant: -1, kind: AddressKind};
        cells.append(address_cell);
        sources: int[] = [-1];
        storages: int[] = [target.pointer_storage];
        if (intrinsic == ArrayStoreIntrinsic) {
            index_cell: Cell = {storage: IntStorage, container: 0, record: -1, constant: 0, variant: -1, kind: ValueKind};
            cells.append(index_cell);
            sources.append(index_value.slot);
            storages.append(IntStorage);
        }
        item_cell: Cell = {storage: binding.storage, container: item_container, record: binding.record, constant: 0, variant: -1,
                           kind: ValueKind};
        cells.append(item_cell);
        sources.append(item_value.slot);
        storages.append(SlotStorage(item_value.storage, item_value.container, target));
        done: Cell = {storage: BoolStorage, container: 0, record: -1, constant: 0, variant: -1, kind: ValueKind};
        cells.append(done);
        address: Slot = {storage: target.pointer_storage, kind: AddressKind};
        call := StatementValue(forest, item.node);
        if (item.phase == PushPhase && ops.debug) {
            code.append(WatchCode(ops, item_value.slot, item_value.storage, item_value.container,
                                  item_value.record, 1, false, forest[call], target));
        }
        slots.append(address);
        header_slot := at.slot + length(slots) - 1;
        code.append(Instruction(ops.host_slot, target.pointer_storage, header_slot, binding.index, 0, 0, node));
        sources[0] = header_slot;
        argument: int = 0;
        while (argument < length(sources)) {
            slots.append(address);
            code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot + length(slots) - 1,
                                    at.cell + argument, 0, 0, node));
            write := Instruction(ops.write, storages[argument], 0, sources[argument], at.slot + length(slots) - 1, 0, node);
            write.offset = target.payload_offset;
            code.append(write);
            argument += 1;
        }
        // A local the function returns grows in its caller's storage.
        if (built.contains(binding.node)) {
            intrinsic += InResult;
        }
        host: Host = {intrinsic: intrinsic, linked: -1, first: at.cell, result_first: at.cell + length(cells) - 1,
                      result_count: 1, written: false};
        hosts.append(host);
        code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, node));
        // The array a push leaves is the call's watched output.
        if (item.phase == PushPhase && ops.debug) {
            slots.append(address);
            reread := Instruction(ops.load, target.pointer_storage, at.slot + length(slots) - 1, header_slot, 0, 0, node);
            reread.offset = target.payload_offset;
            code.append(reread);
            code.append(WatchCode(ops, at.slot + length(slots) - 1, binding.storage, ArrayContainer,
                                  binding.record, 0, true, forest[call], target));
        }
        // A push or a plain element store stores a local array; a push then
        // evaluates it again.
        if ((item.phase == PushPhase || item.b == 0) && !Parameter(forest, binding)) {
            code.append(SymbolCode(ops, binding.node, node));
        }
        if (item.phase == PushPhase && !Parameter(forest, binding)) {
            code.extend(NamePoints(forest, text, names, ops, item.c));
        }
    }
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, popped, produced, retained, marks);
}

// The existing integer-literal semantic decision, shared with the narrow scalar
// proof producer. Context chooses storage; parsing, range checking and exact
// bits have one implementation. This does not infer a type from spelling.
IntegerLiteralResult :: union {
    Rejected(diagnostic: syntax.Diagnostic) | Checked(bits: u64)
}
ReadIntegerLiteral :: (forest: snapshot.SnapshotNode[], text: string, document: int, node: int,
                       storage: int) -> IntegerLiteralResult {
    parsed := ParseNumber(forest, text, node);
    if (!Floating(storage) && InferredNumberStorage(forest, text, node) == FloatStorage) {
        // A whole decimal such as 2.0 or 1e3 is the integer it spells.
        digits := node;
        if (Is(forest, node, "unary_expression")) {
            digits = Field(forest, node, "operand");
        }
        switch IntegralOf(Text(forest, text, digits)) {
            case .Fraction:
                return IntegerLiteralResult.Rejected(Diagnose(forest, node, document,
                                                              format_text("Numeric literal has a fraction, which {} cannot hold", TypeName(storage))));
            case .Large:
                return IntegerLiteralResult.Rejected(Diagnose(forest, node, document,
                                                              format_text("Numeric literal is outside the range of {}", TypeName(storage))));
            case .Whole(whole):
                parsed = Literal.Number(digits != node && whole != 0, whole);
        }
    }
    switch parsed {
        case .Invalid:
            return IntegerLiteralResult.Rejected(Diagnose(forest, node, document,
                                                          "only integer literals of 64 bits are supported"));
        case .Number(negative, magnitude):
            if (!Fits(negative, magnitude, storage)) {
                return IntegerLiteralResult.Rejected(Diagnose(forest, node, document,
                                                              format_text("Numeric literal is outside the range of {}", TypeName(storage))));
            }
            return IntegerLiteralResult.Checked(Bits(negative, magnitude));
    }
}

// Literals, names, parentheses, field reads and element reads.
ValueStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, callables: Callable[],
              params: Param[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], natives: ResolvedNative[],
              ports: ResolvedPort[], native_calls: NativeCallFact[], names: Name[], package: int,
              values: Value[], top: int, item: Work, ops: Ops,
              target: Target, at: Bases) -> Step {
    node := forest[item.node];
    kind := node.kind;
    code: Code[] = [];
    slots: Slot[] = [];
    locals: Slot[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    popped: int = 0;
    produced := NoValue();
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    // `nil` where a pointer is expected; `null` for an entity is below.
    if (kind == "nil" && item.storage == PointerStorage) {
        if (item.container != 0 || item.record < 0 || types[item.record].key == 0) {
            return Fail(forest, item.node, document, "nil requires a nullable pointer type");
        }
        constant := ConstantCode(ops, PointerStorage, 0, at.slot, node);
        constant.value_record = item.record;
        return Step.Emitted([constant], [{storage: PointerStorage, kind: ValueKind}], [], [], [], [], [], [], [],
                            0, Typed(at.slot, PointerStorage, 0, item.record), NoValue(), []);
    }
    if (item.phase == 0 && kind == "member_expression") {
        hidden := PrivateAccess(forest, text, callables, types, constants, names, package, item.node);
        if (hidden >= 0) {
            return Fail(forest, hidden, document, PrivateMessage(Text(forest, text, hidden)));
        }
    }
    if (kind == "nil" || (kind == "number" && item.storage == HandleStorage && item.container == 0)) {
        empty := kind == "nil" && Text(forest, text, item.node) == "null";
        if (kind == "number") {
            switch NumberBits(forest, text, item.node) {
                case .Finite(double_bits, float_fits, float_bits):
                    empty = (double_bits & 0x7fffffffffffffff) == 0;
                case .OutOfRange:
                    return Fail(forest, item.node, document, "Numeric literal is outside the range of its type");
            }
        }
        if (item.storage != HandleStorage || item.container != 0 || !empty) {
            if (kind == "number") {
                return Fail(forest, item.node, document, "entity value requires null or zero");
            }
            return Fail(forest, item.node, document, "unsupported nil or null value");
        }
        slots.append(ValueLocal(HandleStorage));
        code.append(ConstantCode(ops, HandleStorage, 0, at.slot, node));
        if (kind == "number") {
            code.extend(LiteralWatch(forest, ops, at.slot, HandleStorage, item.node));
        }
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
                            Typed(at.slot, HandleStorage, 0, item.record), NoValue(), marks);
    }
    if (kind == "number" && Floating(item.storage)) {
        // A literal where a floating value is expected is one.
        return FloatConstantStep(forest, text, document, Typed(-1, NumberStorage, 0, item.node), item.storage, ops, at,
                                 node);
    }
    if (kind == "number" && !Integer(item.storage)) {
        // An untyped literal: its use gives it a type.
        produced = Typed(-1, NumberStorage, 0, item.node);
    } else if (kind == "number" || kind == "boolean" || kind == "string") {
        storage := item.storage;
        payload: u64 = 0;
        literal := "";
        if (kind == "number") {
            switch ReadIntegerLiteral(forest, text, document, item.node, storage) {
                case .Rejected(diagnostic):
                    return Step.Failed(diagnostic);
                case .Checked(bits):
                    payload = bits;
            }
        } else if (kind == "boolean") {
            storage = BoolStorage;
            if (Text(forest, text, item.node) == "true") {
                payload = 1;
            }
        } else {
            // String literals are JSON strings.
            storage = TextStorage;
            decoded := compiler_json_value_string(Text(forest, text, item.node));
            if (!decoded.valid) {
                return Fail(forest, item.node, document, "Invalid string literal");
            }
            literal = decoded.value;
        }
        slot: Slot = {storage: storage, kind: ValueKind};
        slots.append(slot);
        constant := ConstantCode(ops, storage, payload, at.slot, node);
        constant.text = literal;
        constant.has_text = kind == "string";
        code.append(constant);
        if (kind == "number") {
            code.extend(LiteralWatch(forest, ops, at.slot, storage, item.node));
        }
        produced = Typed(at.slot, storage, 0, -1);
    } else if (item.phase == 0 && (kind == "identifier" || kind == "member_expression") &&
               ConstantOf(forest, text, constants, names, package, item.node) >= 0) {
        // A package constant is its value.
        declared := constants[ConstantOf(forest, text, constants, names, package, item.node)];
        slot: Slot = {storage: declared.storage, kind: ValueKind};
        slots.append(slot);
        code.append(ConstantCode(ops, declared.storage, declared.bits, at.slot, node));
        produced = Typed(at.slot, declared.storage, 0, -1);
    } else if (kind == "identifier") {
        wanted := Text(forest, text, item.node);
        found := Lookup(names, wanted);
        if (found < 0 || Alias(names[found].place)) {
            return Fail(forest, item.node, document, format_text("Unknown name '{}'", wanted));
        }
        binding := names[found];
        if (binding.place == SystemStepPlace) {
            read := Instruction(ops.context, DoubleStorage, at.slot, 0, 0, 0, node);
            read.offset = binding.index;
            code := [read, Instruction(ops.convert, FloatStorage, at.slot + 1, at.slot, 0, 0, node)];
            slots := [ValueLocal(DoubleStorage), ValueLocal(FloatStorage)];
            if (binding.storage == DoubleStorage) {
                code.append(Instruction(ops.convert, DoubleStorage, at.slot + 2, at.slot + 1, 0, 0, node));
                slots.append(ValueLocal(DoubleStorage));
            }
            return Step.Emitted(code, slots, [], [], [], [], [], [], [], 0,
                                Typed(at.slot + length(slots) - 1, binding.storage, 0, -1), NoValue(), []);
        }
        if (binding.place == QuerySnapshotPlace) {
            return QuerySnapshotReadStep(binding, names, ops, target, at, node);
        }
        if (binding.place == QueryFieldPlace) {
            read := QueryFieldReadStep(binding, QueryFieldRow(types, members, binding.node),
                                       values, top, item, ops, target, at, node);
            if (item.phase != 0 && binding.storage == PointerStorage && binding.record >= 0 &&
                types[binding.record].key != 0 && QueryAccessPresent(forest, text, types, names, item.node)) {
                element := PointerElement(types, Typed(-1, PointerStorage, 0, binding.record));
                return PointerNarrow(read, FindPointer(types, element, false));
            }
            return read;
        }
        narrowed: int = -1;
        if (Single(Typed(-1, binding.storage, binding.container, binding.record), PointerStorage) &&
            binding.record >= 0 && types[binding.record].key != 0 &&
            (PointerPresent(forest, text, binding, item.node) || QueryAccessPresent(forest, text, types, names, item.node))) {
            element := PointerElement(types, Typed(-1, PointerStorage, 0, binding.record));
            narrowed = FindPointer(types, element, false);
        }
        if (binding.place == ResultsPlace) {
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
                                Typed(binding.index, binding.storage, 0, binding.record), NoValue(), marks);
        }
        if (binding.place == GlobalPlace) {
            return Fail(forest, item.node, document,
                        format_text("reading the global '{}' is not supported yet", wanted));
        }
        if (binding.place == ManagedPlace) {
            read := ManagedReadStep(types, binding, ops, target, at, node);
            if (narrowed >= 0) {
                return PointerNarrow(read, narrowed);
            }
            return read;
        }
        if (binding.place == ReferencePlace || binding.place == BoxPlace) {
            read := PlaceReadStep(binding, ops, target, at, node);
            if (binding.place == ReferencePlace) {
                read = CellSchemaStep(read, at.cell + 1, ops, target, at, node);
            }
            if (binding.place == BoxPlace) {
                read = CellSchemaStep(read, binding.index, ops, target, at, node);
            }
            if (narrowed >= 0) {
                return PointerNarrow(read, narrowed);
            }
            return read;
        }
        if (binding.place == LocalPlace || binding.place == StatePlace || binding.place == SelfPlace) {
            op := ops.local;
            if (binding.place == StatePlace) {
                op = ops.variable;
            } else if (binding.place == SelfPlace) {
                op = ops.owner;
            }
            slot: Slot = {storage: binding.storage, kind: ValueKind};
            slots.append(slot);
            code.append(Instruction(op, binding.storage, at.slot, binding.index, 0, 0, node));
        } else {
            slots.append(address);
            if (binding.place == CellPlace) {
                code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot, binding.index, 0, 0, node));
                slots.append(address);
                load := Instruction(ops.load, target.pointer_storage, at.slot + 1, at.slot, 0, 0, node);
                load.offset = target.payload_offset;
                code.append(load);
            } else {
                read := Instruction(ops.array, target.pointer_storage, at.slot, binding.index, 0, ops.argument, node);
                read.value_storage = binding.storage;
                read.value_container = binding.container;
                read.value_record = binding.record;
                code.append(read);
            }
            root: Root = {slot: at.slot + length(slots) - 1, storage: binding.storage, container: binding.container,
                          record: binding.record};
            roots.append(root);
        }
        produced = Typed(at.slot + length(slots) - 1, binding.storage, binding.container, binding.record);
        if (narrowed >= 0) {
            produced.record = narrowed;
        }
        if (produced.storage == StructStorage && produced.container == 0) {
            read := Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, produced, NoValue(), marks);
            if (binding.place == CellPlace) {
                return CellSchemaStep(read, binding.index, ops, target, at, node);
            }
            if (binding.place == ParameterPlace) {
                return ArgumentSchemaStep(read, binding.index, ops, target, at, node);
            }
        }
    } else if (kind == "parenthesized_expression") {
        next.append(Expect(Field(forest, item.node, "expression"), item.storage, item.container, item.record));
    } else if (item.phase == 0 && kind == "member_expression" &&
               UnionOf(forest, text, types, names, package, item.node) >= 0) {
        // A variant without a payload: the constructor takes only its tag.
        sum_type := UnionOf(forest, text, types, names, package, item.node);
        member := Text(forest, text, Field(forest, item.node, "member"));
        variant := FindVariant(types, sum_type, member);
        if (variant < 0) {
            return Fail(forest, item.node, document, format_text("Unknown variant '{}'", member));
        }
        if (types[variant].count != 0) {
            return Fail(forest, item.node, document, format_text("variant '{}' needs its payload", member));
        }
        tag: Cell = {storage: WordStorage, container: 0, record: -1, constant: 0, variant: variant, kind: ValueKind};
        cells.append(tag);
        made: Cell = {storage: UnionStorage, container: 0, record: sum_type, constant: 0, variant: -1, kind: ValueKind};
        cells.append(made);
        host: Host = {intrinsic: UnionMakeIntrinsic, linked: -1, first: at.cell, result_first: at.cell + 1,
                      result_count: 1, written: false};
        hosts.append(host);
        code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, node));
        slots.append(address);
        code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot, at.cell + 1, 0, 0, node));
        value: Slot = {storage: UnionStorage, kind: ValueKind};
        slots.append(value);
        load := Instruction(ops.load, UnionStorage, at.slot + 1, at.slot, 0, 0, node);
        load.offset = target.payload_offset;
        code.append(load);
        produced = Typed(at.slot + 1, UnionStorage, 0, sum_type);
    } else if (item.phase == 0 && kind == "member_expression" &&
               KeyedMember(forest, text, types, members, names, item.node) >= 0) {
        // A global's keyed field, such as a scene binding, a native reads by
        // its key.
        field := members[KeyedMember(forest, text, types, members, names, item.node)];
        port := ports[natives[field.read].first];
        key: Value = {slot: at.slot, storage: port.storage, container: port.container, record: port.record, schema: -1};
        constant := ConstantCode(ops, key.storage, 0, at.slot, node);
        constant.text = field.read_key;
        constant.has_text = true;
        shifted: Bases = {pc: at.pc + 1, slot: at.slot + 1, local: at.local, cell: at.cell, host: at.host,
                          call: at.call};
        switch NativeReadStep(forest, document, item.node, types, natives, ports, key, field, ops, target, shifted) {
            case .Failed(diagnostic):
                return Step.Failed(diagnostic);
            case .Emitted(read_code, read_slots, read_locals, read_cells, read_hosts, read_roots, read_calls,
                          read_bound, read_next, read_popped, read_value, read_retain, read_marks):
                read := Typed(read_value.slot, read_value.storage, 0, field.record);
                read.schema = read_value.schema;
                return Step.Emitted(extend([constant], read_code), extend([ValueLocal(key.storage)], read_slots),
                                    read_locals, read_cells, read_hosts, read_roots, read_calls, read_bound,
                                    read_next, 0, read, NoValue(), read_marks);
        }
    } else if (item.phase == 0 && kind == "member_expression" &&
               ConstantMember(forest, text, types, members, names, item.node) >= 0) {
        // A constant member of a global, such as an input action, is its name.
        field := members[ConstantMember(forest, text, types, members, names, item.node)];
        slots.append(ValueLocal(field.storage));
        constant := ConstantCode(ops, field.storage, 0, at.slot, node);
        constant.text = field.name;
        constant.has_text = true;
        code.append(constant);
        produced = Typed(at.slot, field.storage, 0, field.record);
    } else if (item.phase == 0 && kind == "member_expression" &&
               SelfComponent(forest, text, types, names, item.node) >= 0) {
        return ComponentReadStep([], types, SelfComponent(forest, text, types, names, item.node), false, -1, [],
                                 ops, target, at, node);
    } else if (item.phase == 0) {
        next.append(Visit(Field(forest, item.node, "object")));
        // An index's type is a map's key type or an array's int.
        if (kind == "index_expression") {
            next.append(Resume(item.node, KeyPhase, 0, 0));
        } else {
            next.append(Resume(item.node, 1, 0, 0));
        }
    } else if (item.phase == KeyPhase) {
        // The object is ready, so the index takes a map's key type or an
        // array's int.
        index := Field(forest, item.node, "index");
        if (IsMap(values[top - 1])) {
            next.append(Expect(index, types[values[top - 1].record].key, 0, -1));
        } else {
            next.append(Expect(index, IntStorage, 0, -1));
        }
        next.append(Resume(item.node, 1, 0, 0));
    } else if (kind == "member_expression") {
        popped = 1;
        object := values[top - 1];
        member := Text(forest, text, Field(forest, item.node, "member"));
        if (Single(object, QueryStorage) && object.record >= 0) {
            if (types[object.record].kind != QueryDecl) {
                return Fail(forest, item.node, document, "Query description fields are available through iteration");
            }
            field := FindField(types, members, object.record, member);
            if (field < 0) {
                return Fail(forest, item.node, document, format_text("Unknown query row field '{}'", member));
            }
            declared := members[field];
            read := QueryGetStep(object, field - types[object.record].first,
                                 {storage: declared.storage, container: declared.container, record: declared.record},
                                 1, ops, target, at, node);
            if (declared.storage == PointerStorage && declared.record >= 0 && types[declared.record].key != 0 &&
                QueryAccessPresent(forest, text, types, names, item.node)) {
                element := PointerElement(types, Typed(-1, PointerStorage, 0, declared.record));
                return PointerNarrow(read, FindPointer(types, element, false));
            }
            return read;
        }
        if (Single(object, StructStorage) && object.record >= 0 && types[object.record].kind == OptionalComponentDecl) {
            if (!QueryAccessPresent(forest, text, types, names, Field(forest, item.node, "object"))) {
                return Fail(forest, item.node, document, "Optional component requires a presence guard before field access");
            }
            object.record = types[object.record].parent;
        }
        if (member == "") {
            return Fail(forest, Field(forest, item.node, "member"), document, "Invalid string or embedded NUL");
        }
        if (Single(object, PointerStorage)) {
            receiver := forest[Field(forest, item.node, "object")];
            return PointerPrefix([ExpressionCode(ops, receiver)], [],
                                 PointerContinue(PointerReadStep(types, object, 1, ops, target, at, receiver),
                                                 Resume(item.node, PointerMemberReadPhase, 0, 0)));
        }
        if (item.phase == PointerMemberReadPhase && ops.debug) {
            code.append(WatchCode(ops, object.slot, object.storage, object.container, object.record, 0, true,
                                  forest[Field(forest, item.node, "object")], target));
        }
        // A dereferenced pointer's member is its pointee's field, never the
        // name of the output that returned the pointer, as in stage zero.
        dereferenced := item.phase == PointerMemberReadPhase;
        source := ResultSourceCall(forest, text, names, Field(forest, item.node, "object"));
        called := ResultSourceCallable(forest, text, callables, natives, names, package, source);
        if (!dereferenced && called >= 0 && NamedResult(params, callables[called], member) == 0) {
            // A single named result is also an ordinary value. Its output
            // name projects that value before looking for a record field.
            named := params[callables[called].first + callables[called].count];
            projected := Typed(object.slot, named.storage, named.container, named.record);
            if (object.storage != named.storage) {
                slots = NumberSlots(object.storage, named.storage);
                code = NumberCode(ops, object.storage, named.storage, object.slot, at.slot, node);
                projected.slot = at.slot + length(slots) - 1;
            }
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1, projected,
                                NoValue(), marks);
        }
        origin := FindNativeCall(native_calls, source.node);
        if (!dereferenced && origin >= 0 && FindResult(ports, natives[native_calls[origin].native], member) == 0) {
            // Naming the sole output projects the call's ordinary value.
            // A local can have widened it since the initializer was emitted.
            fact := native_calls[origin];
            projected := Typed(object.slot, fact.storage, fact.container, fact.record);
            if (!NativeTakes(types, projected, object)) {
                numeric := object.container == 0 && fact.container == 0 &&
                           object.record < 0 && fact.record < 0 &&
                           (Integer(object.storage) || Floating(object.storage)) &&
                           (Integer(fact.storage) || Floating(fact.storage));
                if (!numeric) {
                    return Fail(forest, item.node, document, "named result differs from its declared type");
                }
                slots = NumberSlots(object.storage, fact.storage);
                code = NumberCode(ops, object.storage, fact.storage, object.slot, at.slot, node);
                projected.slot = at.slot + length(slots) - 1;
            }
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1, projected,
                                NoValue(), marks);
        }
        if (Single(object, ResultsStorage)) {
            // One of a native's results, read from its cell.
            called := natives[object.record];
            index := FindResult(ports, called, member);
            if (index == -2) {
                return Fail(forest, item.node, document, format_text("Ambiguous result '{}'", member));
            }
            if (index < 0) {
                return Fail(forest, item.node, document, format_text("Unknown result '{}'", member));
            }
            port := ports[called.first + called.parameters + index];
            slots.append(address);
            code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot, object.slot + index, 0, 0,
                                    node));
            loaded: Slot = {storage: SlotStorage(port.storage, port.container, target),
                            kind: SlotKind(port.storage, port.container)};
            slots.append(loaded);
            read := Instruction(ops.load, loaded.storage, at.slot + 1, at.slot, 0, 0, node);
            read.offset = target.payload_offset;
            code.append(read);
            if (Pointer(port.storage, port.container)) {
                root: Root = {slot: at.slot + 1, storage: port.storage, container: port.container, record: port.record};
                roots.append(root);
            }
            return CellSchemaStep(Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1,
                                               Typed(at.slot + 1, port.storage, port.container, port.record), NoValue(), marks),
                                  object.slot + index, ops, target, at, node);
        }
        if (Single(object, FunctionResultsStorage)) {
            // One of a function's named results, read from its cell.
            called := callables[object.record];
            index := NamedResult(params, called, member);
            if (index < 0) {
                return Fail(forest, item.node, document, format_text("Unknown result '{}'", member));
            }
            result := params[called.first + called.count + index];
            loaded: Slot = {storage: SlotStorage(result.storage, result.container, target),
                            kind: SlotKind(result.storage, result.container)};
            slots = [address, loaded];
            code = CellRead(loaded.storage, object.slot + index, ops, target, at.slot, node);
            if (Pointer(result.storage, result.container)) {
                root: Root = {slot: at.slot + 1, storage: result.storage, container: result.container,
                              record: result.record};
                roots.append(root);
            }
            return CellSchemaStep(Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1,
                                               Typed(at.slot + 1, result.storage, result.container, result.record),
                                               NoValue(), marks),
                                  object.slot + index, ops, target, at, node);
        }
        if (Single(object, HandleStorage) && OwnerHandle(types, names, object.record) &&
            Component(types, member) >= 0) {
            // A component of another entity, read as the owner's is.
            return ComponentReadStep([], types, Component(types, member), false, object.slot, [], ops, target, at,
                                     node);
        }
        found: int = -1;
        if (Single(object, StructStorage) ||
            (object.container == 0 && object.record >= 0 && types[object.record].kind == NativeDecl)) {
            found = FindField(types, members, object.record, member);
        }
        if (found < 0) {
            return Fail(forest, item.node, document, format_text("Unknown field '{}'", member));
        }
        field := members[found];
        read_effects := MemberEffects(types, object.record);
        if (field.read >= 0) {
            // A native reads the field, such as an input action's `pressed`.
            return EffectsStep(NativeReadStep(forest, document, item.node, types, natives, ports, object,
                                              field, ops, target, at), read_effects);
        }
        if (field.c_string) {
            return EffectsStep(NativeTextReadStep(object, field, ops, target, at, node), read_effects);
        }
        if (field.storage == StructStorage && field.record < 0) {
            return Fail(forest, item.node, document,
                        format_text("field '{}' has a type this compiler cannot read", member));
        }
        if (read_effects != 0) {
            next.append(RecordEffects(read_effects));
        }
        if (field.storage == StructStorage) {
            // A native record's record field lies inside it.
            word: Slot = {storage: target.pointer_storage, kind: ValueKind};
            slots.append(word);
            offset := ConstantCode(ops, target.pointer_storage, u64(field.offset), at.slot, node);
            code.append(offset);
            slots.append(address);
            code.append(Instruction(ops.add, target.pointer_storage, at.slot + 1, object.slot, at.slot, -1,
                                    node));
            nested := Typed(at.slot + 1, StructStorage, 0, field.record);
            nested.schema = object.schema;
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1, nested, NoValue(), marks);
        }
        slot: Slot = {storage: field.storage, kind: ValueKind};
        slots.append(slot);
        read := Instruction(ops.load, field.storage, at.slot, object.slot, 0, 0, node);
        read.offset = field.offset;
        code.append(read);
        produced = Typed(at.slot, field.storage, field.container, field.record);
    } else {
        popped = 2;
        array := values[top - 2];
        position := values[top - 1];
        if (IsMap(array)) {
            return MapReadStep(forest, document, types, array, position, ops, target, at, item.node);
        }
        if (array.container != ArrayContainer) {
            return Fail(forest, Field(forest, item.node, "object"), document, "indexing needs an array");
        }
        if (!Single(position, IntStorage)) {
            return Fail(forest, Field(forest, item.node, "index"), document, "index needs an int");
        }
        packable := Packable(array.storage, array.record, types, members);
        slots = ElementSlots(array.storage, packable, target);
        locals = ElementLocals(array.storage, packable, target);
        code = ElementRead(array.slot, position.slot, array.storage, packable, at.slot, at.pc, at.local, ops, target,
                           node);
        element := at.slot + length(slots) - 1;
        if (array.storage == StructStorage) {
            root: Root = {slot: element, storage: StructStorage, container: 0, record: array.record};
            roots.append(root);
        }
        produced = Typed(element, array.storage, 0, array.record);
    }
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, popped, produced, NoValue(), marks);
}

// The phase of an array literal whose element type its first item gives.
InferPhase: int : 2;
// Struct and array literals, built by the construct intrinsic: the value's
// header, then each array item, or each field as an offset cell and a value
// cell; it returns the new value.
LiteralStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, types: TypeDecl[],
                members: TypeMember[], values: Value[], top: int, built: int[], item: Work, ops: Ops, target: Target,
                at: Bases) -> Step {
    node := forest[item.node];
    array := node.kind == "array_expression";
    code: Code[] = [];
    slots: Slot[] = [];
    locals: Slot[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    if (array && item.container != ArrayContainer) {
        // With no type expected, the first item's type is the element type,
        // as in stage zero, and the other items take it.
        if (item.storage != 0) {
            return Fail(forest, item.node, document, "Array literal needs an explicit array type");
        }
        first := FirstMember(forest, item.node);
        if (item.phase == 0) {
            if (first < 0) {
                return Fail(forest, item.node, document, "Empty arrays need an explicit element type");
            }
            next.append(Visit(first));
            next.append(Resume(item.node, InferPhase, 0, 0));
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, NoValue(), NoValue(),
                                marks);
        }
        element := values[top - 1];
        if (element.storage == NumberStorage) {
            return Fail(forest, first, document, "an untyped number needs a type; give the array an integer type");
        }
        if (element.storage <= 0) {
            return Fail(forest, first, document, "array item has no value type");
        }
        if (element.container != 0) {
            return Fail(forest, first, document, "arrays of arrays are not supported yet");
        }
        count: int = 1;
        member := NextMember(forest, first);
        while (member >= 0) {
            next.append(Expect(member, element.storage, 0, element.record));
            count += 1;
            member = NextMember(forest, member);
        }
        rest := Expect(item.node, element.storage, ArrayContainer, element.record);
        rest.phase = 1;
        rest.a = count;
        next.append(rest);
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, NoValue(), NoValue(), marks);
    }
    if (!array && (item.storage != StructStorage || item.container != 0)) {
        return Fail(forest, item.node, document, "Struct literal needs an explicit record type");
    }
    record := item.record;
    if (item.phase == 0) {
        count: int = 0;
        member := FirstMember(forest, item.node);
        while (member >= 0) {
            if (array) {
                next.append(Expect(member, item.storage, 0, record));
            } else {
                name := Text(forest, text, Field(forest, member, "name"));
                if (name == "") {
                    return Fail(forest, Field(forest, member, "name"), document, "Invalid string or embedded NUL");
                }
                if (FindField(types, members, record, name) < 0) {
                    return Fail(forest, member, document, format_text("Unknown field '{}'", name));
                }
                earlier := FirstMember(forest, item.node);
                while (earlier != member) {
                    if (Text(forest, text, Field(forest, earlier, "name")) == name) {
                        return Fail(forest, member, document, format_text("Duplicate literal member '{}'", name));
                    }
                    earlier = NextMember(forest, earlier);
                }
                field := members[FindField(types, members, record, name)];
                if (field.c_string) {
                    message := CStringMessage(forest, text, Field(forest, member, "value"), field.name);
                    if (message != "") {
                        return Fail(forest, Field(forest, member, "value"), document, message);
                    }
                }
                next.append(Expect(Field(forest, member, "value"), field.storage, field.container, field.record));
            }
            count += 1;
            member = NextMember(forest, member);
        }
        if (!array && count != types[record].count) {
            field_index := types[record].first;
            while (field_index < types[record].first + types[record].count) {
                field := members[field_index];
                provided := false;
                for (given in Members(forest, item.node)) {
                    if (Text(forest, text, Field(forest, given, "name")) == field.name) {
                        provided = true;
                    }
                }
                if (!provided && (field.storage != PointerStorage || field.record < 0 || types[field.record].key == 0)) {
                    return Fail(forest, item.node, document, "Struct literal needs every field");
                }
                field_index += 1;
            }
        }
        rest := Expect(item.node, item.storage, item.container, record);
        rest.phase = 1;
        rest.a = count;
        next.append(rest);
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, NoValue(), NoValue(), marks);
    }
    header: Cell = {storage: item.storage, container: item.container, record: record, constant: 0, variant: -1, kind: ValueKind};
    cells.append(header);
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    member := FirstMember(forest, item.node);
    index: int = 0;
    while (member >= 0) {
        value := values[top - item.a + index];
        if (array && !Accepts(types, item.storage, 0, record, value)) {
            return Fail(forest, member, document, "array item differs from the array's type");
        }
        if (!array) {
            found := FindField(types, members, record, Text(forest, text, Field(forest, member, "name")));
            field := members[found];
            if (!Accepts(types, field.storage, field.container, field.record, value)) {
                return Fail(forest, member, document, "field value differs from its type");
            }
            // Each field's value is watched as the literal's input, numbered
            // by the field's place in the record.
            code.append(WatchCode(ops, value.slot, value.storage, value.container, value.record,
                                  found - types[record].first, false, forest[item.node], target));
            offset: Cell = {storage: WordStorage, container: 0, record: -1, constant: u64(field.offset), variant: -1,
                            kind: ValueKind};
            cells.append(offset);
        }
        content: Cell = {storage: value.storage, container: 0, record: value.record, constant: 0, variant: -1, kind: ValueKind};
        cells.append(content);
        slots.append(address);
        code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot + length(slots) - 1,
                                at.cell + length(cells) - 1, 0, 0, forest[member]));
        write := Instruction(ops.write, SlotStorage(value.storage, 0, target), 0, value.slot,
                             at.slot + length(slots) - 1, 0, forest[member]);
        write.offset = target.payload_offset;
        code.append(write);
        code.extend(SchemaWriteCode(value, at.slot + length(slots) - 1, ops, target, forest[member]));
        index += 1;
        member = NextMember(forest, member);
    }
    cells.append(header);
    // A literal the function returns, or one that starts a local it returns,
    // is built in the caller's storage.
    intrinsic := ConstructIntrinsic;
    if ((array && BuiltLiteral(forest, built, item.node)) || Returned(forest, item.node)) {
        intrinsic += InResult;
    }
    host: Host = {intrinsic: intrinsic, linked: -1, first: at.cell, result_first: at.cell + length(cells) - 1,
                  result_count: 1, written: false};
    hosts.append(host);
    code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, node));
    slots.append(address);
    code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot + length(slots) - 1,
                            at.cell + length(cells) - 1, 0, 0, node));
    slots.append(address);
    made := at.slot + length(slots) - 1;
    load := Instruction(ops.load, target.pointer_storage, made, made - 1, 0, 0, node);
    load.offset = target.payload_offset;
    code.append(load);
    root: Root = {slot: made, storage: item.storage, container: item.container, record: record};
    roots.append(root);
    return CellSchemaStep(Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, item.a,
                                       Typed(made, item.storage, item.container, record), NoValue(), marks),
                          at.cell + length(cells) - 1, ops, target, at, node);
}

// `node` without the parentheses around it.
Unparenthesized :: (forest: snapshot.SnapshotNode[], node: int) -> int {
    at := node;
    while (Is(forest, at, "parenthesized_expression")) {
        at = Field(forest, at, "expression");
    }
    return at;
}
// A provable literal at an explicit foreign C-string boundary.
CStringMessage :: (forest: snapshot.SnapshotNode[], text: string, node: int, boundary: string) -> string {
    at := Unparenthesized(forest, node);
    if (Is(forest, at, "named_argument")) {
        at = Unparenthesized(forest, Field(forest, at, "value"));
    }
    if (!Is(forest, at, "string")) {
        return "";
    }
    decoded := compiler_json_value_string(Text(forest, text, at));
    if (!decoded.valid) {
        return "";
    }
    return CStringTextMessage(decoded.value, boundary);
}
CStringTextMessage :: (text: string, boundary: string) -> string {
    index: int = 0;
    while (index < strings.ByteLength(text)) {
        if (strings.ByteAt(text, index) == 0) {
            return format_text("C-string boundary '{}' cannot accept NUL at byte {}", boundary, index);
        }
        index += 1;
    }
    return "";
}
// Supplied expressions keep their source order. Their parameter positions
// determine only the cells assembled after every expression is evaluated.
NativeArgument :: struct {
    node: int;
    parameter: int;
}
NativeBinding :: union {
    Failed(node: int, message: string) | Bound(arguments: NativeArgument[], total: int)
}
NativeValues :: union {
    Failed(node: int, message: string)
    | Bound(code: Code[], slots: Slot[], arguments: Value[], owners: Work[])
}
NativeNameStorage: int : 12;
NativeSources :: (forest: snapshot.SnapshotNode[], call: int, method: bool) -> int[] {
    sources: int[] = [];
    if (method) {
        sources.append(Field(forest, Field(forest, call, "function"), "object"));
    }
    argument := FirstMember(forest, Field(forest, call, "arguments"));
    while (argument >= 0) {
        sources.append(argument);
        argument = NextMember(forest, argument);
    }
    return sources;
}
NativeParameter :: (ports: ResolvedPort[], called: ResolvedNative, name: string, supplied: int) -> int {
    found: int = -1;
    index: int = 0;
    while (index < called.parameters) {
        candidate := ports[called.first + index].name;
        if (candidate == name) {
            return index;
        }
        if (NameMatches(candidate, name)) {
            if (found == -1) {
                found = index;
            } else {
                found = -2;
            }
        }
        index += 1;
    }
    if (found != -1 || !called.variadic || called.parameters == 0) {
        return found;
    }
    // A variadic Value0 also accepts Value1, Value2, ... as stage zero does.
    end := strings.ByteLength(name);
    digits := end;
    while (digits > 0 && strings.ByteAt(name, digits - 1) >= 48 && strings.ByteAt(name, digits - 1) <= 57) {
        digits -= 1;
    }
    if (digits == end) {
        return -1;
    }
    ordinal: int = 0;
    at := digits;
    while (at < end) {
        digit := strings.ByteAt(name, at) - 48;
        if (ordinal > supplied / 10 || digit > supplied - ordinal * 10) {
            return -1;
        }
        ordinal = ordinal * 10 + digit;
        at += 1;
    }
    first := format_text("{}0", strings.Slice(name, 0, digits));
    if (!NameMatches(ports[called.first + called.parameters - 1].name, first)) {
        return -1;
    }
    return called.parameters - 1 + ordinal;
}
NativeProvided :: (arguments: NativeArgument[], parameter: int) -> int {
    index: int = 0;
    while (index < length(arguments)) {
        if (arguments[index].parameter == parameter) {
            return index;
        }
        index += 1;
    }
    return -1;
}
BindNative :: (forest: snapshot.SnapshotNode[], text: string, call: int, sources: int[],
               called: ResolvedNative, ports: ResolvedPort[]) -> NativeBinding {
    arguments: NativeArgument[] = [];
    total := called.parameters;
    if (called.variadic && total > 0) {
        total -= 1;
    }
    ordinal: int = 0;
    for (source in sources) {
        value := source;
        parameter := ordinal;
        if (Is(forest, source, "named_argument")) {
            if (Field(forest, source, "type") >= 0) {
                return NativeBinding.Failed(source, "typed native arguments are not supported yet");
            }
            name := Text(forest, text, Field(forest, source, "name"));
            parameter = NativeParameter(ports, called, name, length(sources));
            if (parameter < 0) {
                problem := format_text("Unknown argument '{}'", name);
                if (parameter == -2) {
                    problem = format_text("Ambiguous argument '{}'", name);
                }
                return NativeBinding.Failed(source, problem);
            }
            value = Field(forest, source, "value");
            if (value < 0) {
                value = Field(forest, source, "source");
            }
        }
        if (value < 0 || parameter < 0 ||
            (parameter >= called.parameters && (!called.variadic || called.parameters == 0))) {
            return NativeBinding.Failed(source, "Too many arguments");
        }
        if (NativeProvided(arguments, parameter) >= 0) {
            return NativeBinding.Failed(source, "Argument supplied more than once");
        }
        argument: NativeArgument = {node: value, parameter: parameter};
        arguments.append(argument);
        if (parameter >= total) {
            total = parameter + 1;
        }
        ordinal += 1;
    }
    if (called.variadic && called.parameters > 0 && total < called.parameters &&
        ports[called.first + called.parameters - 1].has_default) {
        total = called.parameters;
    }
    index: int = 0;
    while (index < total) {
        port := ports[NativePort(called, index)];
        if (NativeProvided(arguments, index) < 0 && !port.has_default) {
            return NativeBinding.Failed(call, format_text("Missing argument '{}'", port.name));
        }
        index += 1;
    }
    return NativeBinding.Bound(arguments, total);
}
// Numeric overload arguments retain their inferred literal type and watch;
// selection converts the value afterward. Other literals are contextual only
// when every viable overload declares the same type at their source position.
NativeExpectation :: (forest: snapshot.SnapshotNode[], text: string, call: int, sources: int[],
                      natives: ResolvedNative[], ports: ResolvedPort[], name: string, ordinal: int) -> Work {
    source := sources[ordinal];
    if (Is(forest, source, "named_argument")) {
        source = Field(forest, source, "value");
        if (source < 0) {
            source = Field(forest, sources[ordinal], "source");
        }
    }
    expected := Visit(source);
    first := true;
    exact := ExactNativeKind(natives, name, NativeFunctionKind) >= 0;
    for (candidate in natives) {
        if (NativeCandidate(candidate, name, NativeFunctionKind, exact)) {
            switch BindNative(forest, text, call, sources, candidate, ports) {
                case .Failed(problem, message):
                    continue;
                case .Bound(arguments, total):
                    port := ports[NativePort(candidate, arguments[ordinal].parameter)];
                    if (first) {
                        expected = Expect(source, port.storage, port.container, port.record);
                        first = false;
                    } else if (expected.storage != port.storage || expected.container != port.container ||
                               expected.record != port.record) {
                        return Visit(source);
                    }
            }
        }
    }
    if (expected.storage <= 0 || Numeric(expected.storage)) {
        return Visit(source);
    }
    return expected;
}
// Only constant syntax is inspected. A local whose runtime value happens to
// be zero remains an explicit entity argument.
NativeOwnerZero :: (forest: snapshot.SnapshotNode[], text: string, document: int, constants: ConstDecl[],
                    callables: Callable[], names: Name[], package: int, node: int) -> bool {
    at := Unparenthesized(forest, node);
    remaining := length(forest);
    while (at >= 0 && remaining > 0 && Is(forest, at, "call_expression")) {
        callee := Field(forest, at, "function");
        spelling := Text(forest, text, callee);
        converted := ScalarStorage(spelling);
        if (!Is(forest, callee, "identifier") || FindCallable(callables, package, spelling) >= 0 ||
            Lookup(names, spelling) >= 0 || !Integer(converted)) {
            return false;
        }
        argument := FirstMember(forest, Field(forest, at, "arguments"));
        if (argument < 0 || NextMember(forest, argument) >= 0) {
            return false;
        }
        if (Is(forest, argument, "named_argument")) {
            label := Text(forest, text, Field(forest, argument, "name"));
            if (label != "wrap" && label != "clamp") {
                return false;
            }
            argument = Field(forest, argument, "value");
        }
        at = Unparenthesized(forest, argument);
        remaining -= 1;
    }
    if (Is(forest, at, "nil")) {
        return Text(forest, text, at) == "null";
    }
    numeric := Is(forest, at, "number");
    if (Is(forest, at, "unary_expression")) {
        operator := Text(forest, text, Field(forest, at, "operator"));
        numeric = (operator == "+" || operator == "-") && Is(forest, Field(forest, at, "operand"), "number");
    }
    if (numeric) {
        switch NumberBits(forest, text, at) {
            case .Finite(bits, fits, single):
                return (bits & 0x7fffffffffffffff) == 0;
            case .OutOfRange:
                return false;
        }
    }
    switch FoldConstant(forest, text, document, constants, names, package, at, Int64Storage) {
        case .Folded(bits):
            return bits == 0;
        case .Failed(diagnostic):
            return false;
        case .Waiting:
            return false;
    }
}
NativeOwner :: (types: TypeDecl[], names: Name[], port: ResolvedPort) -> Value {
    owner := Lookup(names, "self");
    if (port.storage != HandleStorage || port.container != 0 || port.record < 0 || owner < 0 ||
        names[owner].place != SelfPlace || names[owner].record < 0) {
        return NoValue();
    }
    value := Typed(-1, names[owner].storage, names[owner].container, names[owner].record);
    if (!NativeTakes(types, NativePortType(port), value)) {
        return NoValue();
    }
    return NativePortType(port);
}
// Reorder evaluated values, then emit omitted values in parameter order.
NativeBoundValues :: (forest: snapshot.SnapshotNode[], text: string, document: int, call: int,
                      constants: ConstDecl[], callables: Callable[], types: TypeDecl[], names: Name[], package: int,
                      called: ResolvedNative, ports: ResolvedPort[], supplied: NativeArgument[], total: int,
                      values: Value[], first: int, ops: Ops, at: Bases) -> NativeValues {
    code: Code[] = [];
    slots: Slot[] = [];
    arguments: Value[] = [];
    sources: int[] = [];
    owners: Work[] = [];
    index: int = 0;
    while (index < total) {
        given := NativeProvided(supplied, index);
        argument := NoValue();
        source: int = -1;
        if (given >= 0) {
            argument = values[first + given];
            source = supplied[given].node;
        }
        arguments.append(argument);
        sources.append(source);
        index += 1;
    }
    // Provided literal retyping and owner substitution follow source order.
    for (given in supplied) {
        port := ports[NativePort(called, given.parameter)];
        argument := arguments[given.parameter];
        if (argument.storage == NumberStorage && port.storage <= 0) {
            return NativeValues.Failed(argument.record, "a number needs an integer type here");
        }
        if (argument.storage == NumberStorage && port.storage > 0 && port.container == 0) {
            if (port.storage == HandleStorage) {
                if (!NativeOwnerZero(forest, text, document, constants, callables, names, package, given.node)) {
                    return NativeValues.Failed(given.node, "entity value requires null or zero");
                }
                argument = NativePortType(port);
                argument.slot = at.slot + length(slots);
                slots.append(ValueLocal(HandleStorage));
                constant := ConstantCode(ops, HandleStorage, 0, argument.slot, forest[given.node]);
                constant.value_record = port.record;
                code.append(constant);
                watch := ScalarWatch(ops, argument.slot, HandleStorage, 0, true, forest[given.node]);
                watch.value_record = port.record;
                owner := Lookup(names, "self");
                if (port.default_owner && owner >= 0) {
                    watch.value_record = names[owner].record;
                }
                code.append(watch);
            } else {
                if (!Integer(port.storage) && !Floating(port.storage)) {
                    return NativeValues.Failed(given.node, "argument differs from its parameter type");
                }
                shifted: Bases = {pc: at.pc + length(code), slot: at.slot + length(slots), local: at.local,
                                  cell: at.cell, host: at.host, call: at.call};
                // Stage zero types an untyped literal at the parameter's type.
                switch NumberLiteralStep(forest, text, document, constants, names, package, argument, port.storage,
                                         ops, shifted, forest[given.node]) {
                    case .Failed(diagnostic):
                        return NativeValues.Failed(given.node, diagnostic.message);
                    case .Emitted(added_code, added_slots, added_locals, added_cells, added_hosts, added_roots,
                                  added_calls, added_names, next, popped, value, retained, marks):
                        code.extend(added_code);
                        slots.extend(added_slots);
                        argument = value;
                }
            }
        }
        if (port.default_owner && argument.storage == HandleStorage && argument.container == 0 &&
            NativeTakes(types, NativePortType(port), argument) &&
            NativeOwnerZero(forest, text, document, constants, callables, names, package, given.node)) {
            owner := NativeOwner(types, names, port);
            if (owner.storage == 0) {
                return NativeValues.Failed(given.node, "native owner argument requires a compatible self");
            }
            owner.slot = argument.slot;
            declared_owner := names[Lookup(names, "self")];
            owners.append(RecordOwnerArgument(given.node, argument.slot, declared_owner.record));
            code.append(SymbolCode(ops, declared_owner.node, forest[given.node]));
            argument = owner;
        }
        arguments[given.parameter] = argument;
    }
    index = 0;
    while (index < total) {
        port := ports[NativePort(called, index)];
        source := sources[index];
        if (source >= 0) {
            if (port.c_string) {
                message := CStringMessage(forest, text, source, port.name);
                if (message != "") {
                    return NativeValues.Failed(source, message);
                }
            }
        } else {
            site := Field(forest, call, "arguments");
            if (!port.has_default || !port.default_supported || port.storage <= 0 || port.container != 0 ||
                port.storage == StructStorage || port.storage == UnionStorage) {
                return NativeValues.Failed(call, format_text("default argument '{}' is not supported yet", port.name));
            }
            if (port.c_string) {
                message := CStringTextMessage(port.default_text, port.name);
                if (message != "") {
                    return NativeValues.Failed(call, message);
                }
            }
            value := NativePortType(port);
            value.slot = at.slot + length(slots);
            slots.append(ValueLocal(port.storage));
            code.append(ExpressionCode(ops, forest[site]));
            constant := ConstantCode(ops, port.storage, port.default_bits, value.slot, forest[site]);
            constant.value_record = port.record;
            constant.text = port.default_text;
            constant.has_text = port.storage == TextStorage || port.storage == NativeNameStorage;
            if (port.default_owner) {
                owner := NativeOwner(types, names, port);
                if (owner.storage == 0) {
                    return NativeValues.Failed(call, "native owner default requires a compatible self");
                }
                code.append(SymbolCode(ops, names[Lookup(names, "self")].node, forest[site]));
                constant = Instruction(ops.owner, HandleStorage, value.slot, 0, 0, 0, forest[site]);
            }
            code.append(constant);
            watch := DefaultWatch(ops, value.slot, port.storage, u64(0), forest[site]);
            watch.value_record = port.record;
            if (port.default_owner) {
                watch.value_record = names[Lookup(names, "self")].record;
            }
            code.append(watch);
            arguments[index] = value;
        }
        index += 1;
    }
    return NativeValues.Bound(code, slots, arguments, owners);
}
NativeCallPrefix :: (code: Code[], slots: Slot[], before: Work[], step: Step, popped: int) -> Step {
    switch step {
        case .Failed(diagnostic):
            return Step.Failed(diagnostic);
        case .Emitted(added_code, added_slots, locals, cells, hosts, roots, calls, bound, next, count, value,
                      retained, marks):
            return Step.Emitted(extend(code, added_code), extend(slots, added_slots), locals, cells, hosts,
                                roots, calls, bound, extend(before, next), popped, value, retained, marks);
    }
}
// Calls of the package's functions and of natives. Arguments go to fresh data
// cells and the result comes back in one. A native's inferred ports all take
// the one type its arguments give them.
CallStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, callables: Callable[],
             params: Param[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], natives: ResolvedNative[], ports: ResolvedPort[],
             makes: NativeMake[], make_fields: int[], names: Name[], package: int, values: Value[], top: int,
             built: int[], item: Work, ops: Ops, target: Target, at: Bases) -> Step {
    node := forest[item.node];
    code: Code[] = [];
    slots: Slot[] = [];
    locals: Slot[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    if (item.phase == 0) {
        callee := Field(forest, item.node, "function");
        hidden := PrivateAccess(forest, text, callables, types, constants, names, package, callee);
        if (hidden >= 0) {
            return Fail(forest, hidden, document, PrivateMessage(Text(forest, text, hidden)));
        }
        sum_type: int = -1;
        if (Is(forest, callee, "member_expression")) {
            sum_type = UnionOf(forest, text, types, names, package, callee);
        }
        if (sum_type >= 0) {
            // A variant with a payload: each argument is a payload field, in order.
            member := Text(forest, text, Field(forest, callee, "member"));
            variant := FindVariant(types, sum_type, member);
            if (variant < 0) {
                return Fail(forest, callee, document, format_text("Unknown variant '{}'", member));
            }
            count: int = 0;
            argument := FirstMember(forest, Field(forest, item.node, "arguments"));
            while (argument >= 0) {
                if (Is(forest, argument, "named_argument")) {
                    return Fail(forest, argument, document, "named payload arguments are not supported yet");
                }
                if (count >= types[variant].count) {
                    break;
                }
                field := members[types[variant].first + count];
                next.append(Expect(argument, field.storage, field.container, field.record));
                count += 1;
                argument = NextMember(forest, argument);
            }
            if (argument >= 0 || count != types[variant].count) {
                return Fail(forest, item.node, document, "variant payload needs one value per field");
            }
            finish := Resume(item.node, 1, variant, count);
            finish.c = 2;
            next.append(finish);
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, NoValue(), NoValue(), marks);
        }
        // An unbound prefix names a native namespace. An import alias or a
        // local receiver keeps its package or array-method meaning.
        qualified_native: bool = false;
        native_name: string = "";
        if (Is(forest, callee, "member_expression")) {
            prefix := Field(forest, callee, "object");
            if (Is(forest, prefix, "identifier") && Lookup(names, Text(forest, text, prefix)) < 0 &&
                QualifierOf(forest, text, names, package, prefix) < 0) {
                qualified_native = true;
                native_name = format_text("{}.{}", Text(forest, text, prefix),
                                          Text(forest, text, Field(forest, callee, "member")));
            }
        }
        // `xs.f(...)` calls the array function f with xs first. A method that
        // changes its array is a statement on the array's name.
        method: int = -1;
        if (!qualified_native && Is(forest, callee, "member_expression") &&
            QualifierOf(forest, text, names, package, Field(forest, callee, "object")) < 0) {
            method = ArrayMethod(natives, ports, Text(forest, text, Field(forest, callee, "member")));
        }
        if (method >= 0) {
            if (ArrayChanger(natives, method) &&
                ChangedArray(forest, text, names, natives, ports, forest[item.node].parent) < 0) {
                return Fail(forest, callee, document,
                            format_text("{} changes the array; call it as a statement on a name",
                                        Text(forest, text, Field(forest, callee, "member"))));
            }
            if (!natives[method].direct) {
                return Fail(forest, callee, document, "native binding cannot be called directly as data");
            }
            if (!Supported(ports, natives[method])) {
                return Fail(forest, callee, document,
                            format_text("native '{}' is not supported yet", natives[method].name));
            }
            sources := NativeSources(forest, item.node, true);
            switch BindNative(forest, text, item.node, sources, natives[method], ports) {
                case .Failed(problem, message):
                    return Fail(forest, problem, document, message);
                case .Bound(arguments, total):
                    for (argument in arguments) {
                        port := ports[NativePort(natives[method], argument.parameter)];
                        expected := Visit(argument.node);
                        if (port.storage > 0) {
                            expected = Expect(argument.node, port.storage, port.container, port.record);
                        }
                        next.append(expected);
                    }
            }
            finish := Resume(item.node, 1, method, length(sources));
            finish.c = 7;
            next.append(finish);
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, NoValue(), NoValue(), marks);
        }
        // `F(...)` calls this package's F or a native; a bound alias calls an
        // imported package's F; an unbound prefix qualifies a native's name.
        qualifier: int = -1;
        if (Is(forest, callee, "member_expression")) {
            qualifier = Field(forest, callee, "object");
            callee = Field(forest, callee, "member");
        }
        home := QualifierOf(forest, text, names, package, qualifier);
        if ((!qualified_native && home < 0) || !Is(forest, callee, "identifier")) {
            return Fail(forest, Field(forest, item.node, "function"), document, "call needs a function name");
        }
        callee_name := Text(forest, text, callee);
        found := CalledFunction(forest, text, callables, natives, names, package, item.node);
        if (qualified_native) {
            callee_name = native_name;
        }
        if (found == -2) {
            return Fail(forest, callee, document, format_text("Ambiguous function '{}'", callee_name));
        }
        // A source library qualifies its exported functions; genuine native
        // functions may share that prefix. Package aliases remain lexical.
        if (found < 0 && qualifier >= 0 && !qualified_native) {
            for (alias in names) {
                if (alias.place == LibraryPlace && alias.index == home) {
                    callee_name = format_text("{}.{}", Text(forest, text, qualifier), callee_name);
                    qualified_native = true;
                }
            }
        }
        conversion: int = 0;
        if (qualifier < 0 && found < 0) {
            conversion = ScalarStorage(callee_name);
            if (NumericConversionName(callee_name) && !Integer(conversion) && !Floating(conversion)) {
                return Fail(forest, callee, document,
                            format_text("numeric conversion '{}' is not supported yet", callee_name));
            }
        }
        if (Integer(conversion) || Floating(conversion)) {
            // Floating conversions use the existing runtime rounding operation.
            // `T(value)` clamps the value to T; `T(wrap: value)` keeps its
            // low bits. A constant value folds before it gets here.
            argument := FirstMember(forest, Field(forest, item.node, "arguments"));
            if (argument < 0 || NextMember(forest, argument) >= 0) {
                return Fail(forest, item.node, document, "Conversion takes one value");
            }
            mode: int = 0;
            value := argument;
            if (Is(forest, argument, "named_argument")) {
                if (Floating(conversion)) {
                    return Fail(forest, item.node, document, "wrap and clamp convert between integer types");
                }
                if (Text(forest, text, Field(forest, argument, "name")) != "wrap") {
                    return Fail(forest, Field(forest, argument, "name"), document,
                                "A conversion argument may only be named wrap");
                }
                mode = 1;
                value = Field(forest, argument, "value");
            }
            if (Floating(conversion) && mode != 0) {
                return Fail(forest, argument, document, "wrap and clamp apply only to integer conversions");
            }
            if (mode == 0) {
                next.append(Expect(value, conversion, 0, -1));
            } else {
                next.append(Visit(value));
            }
            finish := Resume(item.node, 1, conversion, mode);
            finish.c = 3;
            next.append(finish);
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, NoValue(), NoValue(), marks);
        }
        // `assert(condition, "message")` is a language intrinsic unless a
        // native shadows it. It emits a checked instruction, so a pure host
        // needs no native capability for it. A linked native whose intrinsic
        // is the assertion lowers the same way, whatever its name.
        assertion := FindNative(natives, callee_name);
        guard := (qualifier < 0 || qualified_native) && found < 0 && assertion >= 0 &&
                 natives[assertion].intrinsic == ops.guard;
        if (guard && !natives[assertion].direct) {
            return Fail(forest, callee, document, "native binding cannot be called directly as data");
        }
        if (guard || (qualifier < 0 && found < 0 && assertion < 0 && NameMatches("assert", callee_name))) {
            condition: int = -1;
            message: int = -1;
            index: int = 0;
            argument := FirstMember(forest, Field(forest, item.node, "arguments"));
            while (argument >= 0) {
                value := argument;
                position := index;
                if (Is(forest, argument, "named_argument")) {
                    label := Text(forest, text, Field(forest, argument, "name"));
                    value = Field(forest, argument, "value");
                    position = -1;
                    if (NameMatches("Condition", label)) {
                        position = 0;
                    } else if (NameMatches("Message", label)) {
                        position = 1;
                    }
                }
                if (position < 0) {
                    return Fail(forest, argument, document,
                                format_text("Unknown argument '{}'", Text(forest, text, Field(forest, argument, "name"))));
                }
                if (position > 1) {
                    return Fail(forest, argument, document, "Too many arguments");
                }
                if ((position == 0 && condition >= 0) || (position == 1 && message >= 0)) {
                    return Fail(forest, argument, document, "Argument supplied more than once");
                }
                if (position == 0) {
                    condition = value;
                } else {
                    message = value;
                }
                index += 1;
                argument = NextMember(forest, argument);
            }
            // Stage zero gives a missing condition false; stage one asks
            // for one.
            if (condition < 0) {
                return Fail(forest, item.node, document, "assert needs a condition");
            }
            if (message >= 0 && !Is(forest, Unparenthesized(forest, message), "string")) {
                return Fail(forest, message, document, "assert's message is a string constant");
            }
            if (guard) {
                next.append(RecordSemantic(item.node, NativeFact, assertion));
            }
            next.append(Expect(condition, BoolStorage, 0, -1));
            finish := Resume(item.node, 1, message, condition);
            finish.c = 6;
            next.append(finish);
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, NoValue(), NoValue(), marks);
        }
        native: int = -1;
        expected_count: int = 0;
        if (found >= 0) {
            expected_count = callables[found].count;
        } else if (qualifier >= 0 && !qualified_native) {
            return Fail(forest, Field(forest, item.node, "function"), document,
                        format_text("Unknown function '{}'", callee_name));
        } else {
            native = FindNative(natives, callee_name);
            if (native == -2 && FindNativeKind(natives, callee_name, NativeFunctionKind) == -2) {
                native = FirstNativeKind(natives, callee_name, NativeFunctionKind);
            }
            if (native == -2) {
                return Fail(forest, callee, document, format_text("Ambiguous function '{}'", callee_name));
            }
            if (native < 0) {
                return Fail(forest, callee, document, format_text("Unknown function '{}'", callee_name));
            }
            if (Overloaded(natives, callee_name)) {
                // Each argument's own type picks the overload.
                sources := NativeSources(forest, item.node, false);
                ordinal: int = 0;
                while (ordinal < length(sources)) {
                    next.append(NativeExpectation(forest, text, item.node, sources, natives, ports,
                                                  callee_name, ordinal));
                    ordinal += 1;
                }
                choose := Resume(item.node, 1, native, length(sources));
                choose.c = 4;
                next.append(choose);
                return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, NoValue(),
                                    NoValue(), marks);
            }
            if (!natives[native].direct) {
                return Fail(forest, callee, document, "native binding cannot be called directly as data");
            }
            make := FindMake(makes, native);
            if (make < 0 && !Supported(ports, natives[native])) {
                return Fail(forest, callee, document, format_text("native '{}' is not supported yet", callee_name));
            }
            expected_count = natives[native].parameters;
        }
        if (native >= 0) {
            sources := NativeSources(forest, item.node, false);
            switch BindNative(forest, text, item.node, sources, natives[native], ports) {
                case .Failed(problem, message):
                    return Fail(forest, problem, document, message);
                case .Bound(arguments, total):
                    for (argument in arguments) {
                        port := ports[NativePort(natives[native], argument.parameter)];
                        expected := Visit(argument.node);
                        if (port.storage > 0) {
                            expected = Expect(argument.node, port.storage, port.container, port.record);
                        }
                        next.append(expected);
                    }
            }
            finish := Resume(item.node, 1, native, length(sources));
            finish.c = 1;
            next.append(finish);
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, NoValue(), NoValue(), marks);
        }
        count: int = 0;
        argument := FirstMember(forest, Field(forest, item.node, "arguments"));
        while (argument >= 0) {
            // A callable takes neither yet; reject them before an argument
            // is read positionally.
            if (Is(forest, argument, "named_argument") || Is(forest, argument, "typed_argument")) {
                return Fail(forest, argument, document, format_text("unsupported syntax '{}'", forest[argument].kind));
            }
            expected := Visit(argument);
            if (found >= 0 && count < expected_count) {
                param := params[callables[found].first + count];
                expected = Expect(argument, param.storage, param.container, param.record);
                if (param.reference && Is(forest, argument, "address_expression")) {
                    // `&x` lends x's location for the call.
                    expected.node = Unparenthesized(forest, Field(forest, argument, "operand"));
                    expected.phase = ReferencePhase;
                } else if (param.reference) {
                    expected.phase = ScopedPhase;
                }
            }
            next.append(expected);
            count += 1;
            argument = NextMember(forest, argument);
        }
        // A variadic native's last parameter takes any number of arguments,
        // and an omitted argument of a function takes its default.
        arity := count == expected_count;
        if (found >= 0 && count < expected_count) {
            // Every omitted argument needs a default.
            arity = true;
            at_omitted := count;
            while (at_omitted < expected_count) {
                arity = arity && params[callables[found].first + at_omitted].has_default;
                at_omitted += 1;
            }
        }
        if (!arity) {
            return Fail(forest, item.node, document, "call has the wrong number of arguments");
        }
        finish := Resume(item.node, 1, found, count);
        next.append(finish);
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, NoValue(), NoValue(), marks);
    }
    if (item.c == 6) {
        // An assert fails with its message, or with its condition's source
        // when it gives none.
        said := Text(forest, text, Unparenthesized(forest, item.b));
        if (item.a >= 0) {
            decoded := compiler_json_value_string(Text(forest, text, Unparenthesized(forest, item.a)));
            if (!decoded.valid) {
                return Fail(forest, item.a, document, "Invalid string literal");
            }
            if (decoded.value != "") {
                said = strings.ReplaceAll(decoded.value, "\u0000", "\\0");
            }
        }
        check := Instruction(ops.guard, 0, 0, values[top - 1].slot, 0, target.assert_failure, node);
        check.message = format_text("Assertion failed: {}", said);
        check.has_message = true;
        code.append(check);
        // Like a call of a function with no result, it leaves no value.
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1, Typed(-1, -1, 0, -1),
                            NoValue(), marks);
    }
    if (item.c == 3) {
        // A conversion to types item.a in mode item.b. A constant converted
        // to an integer type folds before this, so an untyped one here
        // converts to a floating type, from int64 or a uint64 beyond it.
        value := values[top - 1];
        if (value.storage == NumberStorage) {
            storage := UntypedStorage(forest, text, value.record);
            typed := ConstantStep(forest, text, document, constants, names, package, value, storage, ops, at, node);
            switch typed {
                case .Failed(diagnostic):
                    return Step.Failed(diagnostic);
                case .Emitted(typed_code, typed_slots, typed_locals, typed_cells, typed_hosts, typed_roots, typed_calls,
                              typed_bound, typed_next, typed_popped, typed_value, typed_retain, typed_marks):
                    code = typed_code;
                    slots = typed_slots;
                    value = typed_value;
            }
        }
        if (value.container != 0 || (!Integer(value.storage) && !Floating(value.storage))) {
            return Fail(forest, item.node, document, "conversion needs a number");
        }
        if (value.storage == item.a) {
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1, value, NoValue(), marks);
        }
        if (Floating(item.a)) {
            output := at.slot + length(slots);
            slots.extend(NumberSlots(value.storage, item.a));
            code.extend(NumberCode(ops, value.storage, item.a, value.slot, output, node));
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1,
                                Typed(at.slot + length(slots) - 1, item.a, 0, -1), NoValue(), marks);
        }
        converted: Slot = {storage: item.a, kind: ValueKind};
        slots.append(converted);
        code.append(CastCode(ops, item.a, at.slot + length(slots) - 1, value.slot, item.b, node));
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1,
                            Typed(at.slot + length(slots) - 1, item.a, 0, -1), NoValue(), marks);
    }
    count := item.b;
    first := top - count;
    // An overload takes an untyped literal at the type of the one it chooses.
    at_argument := first;
    while (at_argument < top) {
        value := values[at_argument];
        // An overload ranks an untyped literal, not another constant expression.
        if (value.storage == NumberStorage &&
            ((item.c != 1 && item.c != 4 && item.c != 7) || (item.c == 4 && SignedLiteral(forest, text, value.record) < 0))) {
            return Fail(forest, value.record, document, "a number needs an integer type here");
        }
        at_argument += 1;
    }
    // Stage zero evaluates the default of each argument a call omits.
    if (item.c == 0 && item.a >= 0) {
        omitted := count;
        while (omitted < callables[item.a].count) {
            param := params[callables[item.a].first + omitted];
            if (callables[item.a].package == package) {
                code.append(OccurrenceCode(ops, ExpressionRecord, param.default_occurrence,
                                           forest[Field(forest, forest[param.node].parent, "value")]));
            } else {
                code.append(ExpressionCode(ops, forest[Field(forest, item.node, "arguments")]));
            }
            omitted += 1;
        }
    }
    if (item.c == 2) {
        // The constructor takes the variant's tag, then each payload field. A
        // returned variant is built in the caller's storage, so the return
        // need not copy it, with a mask of the payload values it keeps there:
        // the locals the function builds there. It copies the others.
        variant := types[item.a];
        returned := Returned(forest, item.node);
        keep: i64 = 0;
        argument_node := FirstMember(forest, Field(forest, item.node, "arguments"));
        position: int = 0;
        while (returned && count <= 64 && argument_node >= 0) {
            if (BuiltName(forest, text, names, built, argument_node)) {
                keep = keep | (i64(1) << u32(position));
            }
            position += 1;
            argument_node = NextMember(forest, argument_node);
        }
        tag: Cell = {storage: WordStorage, container: 0, record: -1, constant: 0, variant: item.a, kind: ValueKind};
        cells.append(tag);
        kept := returned && count <= 64;
        shift: int = 0;
        if (kept) {
            mask: Cell = {storage: WordStorage, container: 0, record: -1, constant: u64(wrap: keep), variant: -1,
                          kind: ValueKind};
            cells.append(mask);
            shift = 1;
        }
        address: Slot = {storage: target.pointer_storage, kind: AddressKind};
        index: int = 0;
        while (index < count) {
            argument := values[first + index];
            field := members[variant.first + index];
            if (!Accepts(types, field.storage, field.container, field.record, argument)) {
                return Fail(forest, item.node, document, "payload value differs from its field type");
            }
            cell: Cell = {storage: argument.storage, container: argument.container, record: argument.record,
                          constant: 0, variant: -1, kind: ValueKind};
            cells.append(cell);
            slots.append(address);
            code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot + index,
                                    at.cell + 1 + shift + index, 0, 0, node));
            write := Instruction(ops.write, SlotStorage(argument.storage, argument.container, target), 0, argument.slot,
                                 at.slot + index, 0, node);
            write.offset = target.payload_offset;
            code.append(write);
            index += 1;
        }
        made: Cell = {storage: UnionStorage, container: 0, record: variant.parent, constant: 0, variant: -1,
                      kind: ValueKind};
        cells.append(made);
        intrinsic := UnionMakeIntrinsic;
        if (kept) {
            intrinsic = UnionKeepIntrinsic + InResult;
        }
        host: Host = {intrinsic: intrinsic, linked: -1, first: at.cell, result_first: at.cell + 1 + shift + count,
                      result_count: 1, written: false};
        hosts.append(host);
        code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, node));
        slots.append(address);
        code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot + count, at.cell + 1 + shift + count,
                                0, 0, node));
        value: Slot = {storage: UnionStorage, kind: ValueKind};
        slots.append(value);
        load := Instruction(ops.load, UnionStorage, at.slot + count + 1, at.slot + count, 0, 0, node);
        load.offset = target.payload_offset;
        code.append(load);
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, count,
                            Typed(at.slot + count + 1, UnionStorage, 0, variant.parent), NoValue(), marks);
    }
    chosen := item.a;
    if (item.c == 4) {
        // An overloaded native: the one whose parameters take the arguments.
        callee := Field(forest, item.node, "function");
        chosen = Overload(forest, text, document, item.node, constants, callables, types, names, package,
                          natives, ports, NativeCallName(forest, text, item.node), NativeSources(forest, item.node, false),
                          values, first);
        if (chosen == -2) {
            if (Is(forest, callee, "member_expression")) {
                callee = Field(forest, callee, "member");
            }
            return Fail(forest, callee, document,
                        format_text("Ambiguous function '{}'", NativeCallName(forest, text, item.node)));
        }
        if (chosen < 0) {
            return Fail(forest, callee, document, "no overload of this native takes these arguments, or several do");
        }
        if (!Supported(ports, natives[chosen])) {
            return Fail(forest, callee, document, "this overload is not supported yet");
        }
    }
    linked := item.c == 1 || item.c == 4 || item.c == 7;
    inferred := NoValue();
    first_port: int = 0;
    if (linked) {
        if (!natives[chosen].direct) {
            return Fail(forest, item.node, document, "native binding cannot be called directly as data");
        }
        if (natives[chosen].intrinsic != 0) {
            return Fail(forest, item.node, document, "native intrinsic is not supported at this call");
        }
        first_port = natives[chosen].first;
    }
    // The given arguments, then the defaults of those the call omits.
    arguments: Value[] = slice(values, first, count);
    given: NativeArgument[] = [];
    if (linked) {
        switch BindNative(forest, text, item.node, NativeSources(forest, item.node, item.c == 7),
                          natives[chosen], ports) {
            case .Failed(problem, message):
                return Fail(forest, problem, document, message);
            case .Bound(supplied, total):
                given = supplied;
                switch NativeBoundValues(forest, text, document, item.node, constants, callables, types, names,
                                         package, natives[chosen], ports, supplied, total, values, first,
                                         ops, at) {
                    case .Failed(problem, message):
                        return Fail(forest, problem, document, message);
                    case .Bound(added_code, added_slots, ordered, owners):
                        code.extend(added_code);
                        slots.extend(added_slots);
                        arguments = ordered;
                        next.extend(owners);
                }
        }
        make := FindMake(makes, chosen);
        if (make >= 0) {
            shifted: Bases = {pc: at.pc + length(code), slot: at.slot + length(slots), local: at.local,
                              cell: at.cell, host: at.host, call: at.call};
            return NativeCallPrefix(code, slots, next,
                                    MakeStep(forest, document, types, members, makes[make], make_fields,
                                             arguments, 0, length(arguments), item.node, ops, target, shifted, node),
                                    count);
        }
    } else {
        called := callables[item.a];
        while (length(arguments) < called.count) {
            param := params[called.first + length(arguments)];
            slots.append(ValueLocal(param.storage));
            constant := ConstantCode(ops, param.storage, param.default_bits, at.slot + length(slots) - 1, node);
            constant.text = param.default_text;
            constant.has_text = param.storage == TextStorage;
            constant.value_record = param.record;
            code.append(constant);
            if (called.package == package) {
                code.append(DefaultWatch(ops, at.slot + length(slots) - 1, param.storage,
                                         param.default_occurrence,
                                         forest[Field(forest, forest[param.node].parent, "value")]));
            } else {
                code.append(DefaultWatch(ops, at.slot + length(slots) - 1, param.storage, u64(0),
                                         forest[Field(forest, item.node, "arguments")]));
            }
            arguments.append(Typed(at.slot + length(slots) - 1, param.storage, param.container, param.record));
        }
    }
    if (linked && natives[chosen].name == "resize" && length(arguments) > 0) {
        element := arguments[0];
        if (NeedsPointerValue(types, members, element.storage, 0, element.record)) {
            return Fail(forest, item.node, document, "resize cannot create missing non-null pointer values");
        }
    }
    total := length(arguments);
    index: int = 0;
    while (index < total) {
        argument := arguments[index];
        expected := NoValue();
        if (linked) {
            port := ports[NativePort(natives[chosen], index)];
            expected = NativePortType(port);
            if (port.storage == AnyPort && argument.storage > 0) {
                expected = argument;
            } else if (port.storage == 0) {
                element := Typed(-1, argument.storage, 0, argument.record);
                if (argument.storage <= 0 || argument.container != port.container ||
                    (inferred.storage != 0 && !SameType(inferred.storage, 0, inferred.record, element))) {
                    return Fail(forest, item.node, document, "argument differs from its parameter type");
                }
                inferred = element;
                expected = Typed(-1, element.storage, port.container, element.record);
            }
        } else {
            param := params[callables[item.a].first + index];
            expected = Typed(-1, param.storage, param.container, param.record);
            if (param.reference) {
                expected = Typed(-1, ReferenceStorage, 0, -1);
            }
        }
        if (argument.container == 0 && expected.container == 0 && FloatWidens(argument.storage, expected.storage)) {
            slots.append(ValueLocal(expected.storage));
            code.append(Instruction(ops.convert, expected.storage, at.slot + length(slots) - 1, argument.slot, 0, 0, node));
            argument = Typed(at.slot + length(slots) - 1, expected.storage, 0, -1);
            arguments[index] = argument;
        }
        if (item.c == 4 && argument.container == 0 && expected.container == 0 && argument.storage != expected.storage &&
            Numeric(argument.storage) && Converts(argument.storage, expected.storage)) {
            // The overload stage zero ranks first takes the number converted.
            output := at.slot + length(slots);
            slots.extend(NumberSlots(argument.storage, expected.storage));
            code.extend(NumberCode(ops, argument.storage, expected.storage, argument.slot, output, node));
            argument = Typed(at.slot + length(slots) - 1, expected.storage, 0, -1);
            arguments[index] = argument;
        }
        takes := Accepts(types, expected.storage, expected.container, expected.record, argument);
        if (linked) {
            takes = NativeTakes(types, expected, argument);
        }
        if (!takes) {
            return Fail(forest, item.node, document, "argument differs from its parameter type");
        }
        if (linked) {
            // A fixed native port's declared header survives compatible aliases.
            argument = Typed(argument.slot, expected.storage, expected.container, expected.record);
            arguments[index] = argument;
        }
        cell: Cell = {storage: argument.storage, container: argument.container, record: argument.record, constant: 0, variant: -1,
                      kind: ValueKind};
        if (argument.storage == ReferenceStorage) {
            cell = ReferenceCell(target);
        }
        cells.append(cell);
        index += 1;
    }
    // Call address slots follow defaults and any floating widening temporaries.
    b := at.slot + length(slots);
    result := Typed(-1, -1, 0, -1);
    result_count: int = 0;
    named_results: bool = false;
    if (linked && natives[chosen].results > 1) {
        // Several results land in cells a local or `.name` reads.
        called := natives[chosen];
        at_result: int = 0;
        while (at_result < called.results) {
            port := ports[called.first + called.parameters + at_result];
            if (port.storage <= 0) {
                return Fail(forest, item.node, document, "native result type is not known");
            }
            cell: Cell = {storage: port.storage, container: port.container, record: port.record, constant: 0, variant: -1,
                          kind: ValueKind};
            cells.append(cell);
            at_result += 1;
        }
        result_count = called.results;
        result = Typed(at.cell + total, ResultsStorage, 0, chosen);
    } else if (linked && natives[chosen].results == 1) {
        port := ports[first_port + natives[chosen].parameters];
        result = NativePortType(port);
        if (port.storage == 0) {
            if (inferred.storage == 0) {
                return Fail(forest, item.node, document, "native result type is not known");
            }
            result = Typed(-1, inferred.storage, port.container, inferred.record);
        }
        result_count = 1;
    } else if (!linked && callables[item.a].results > 0) {
        // Named results keep their declared headers in the caller's cells.
        called := callables[item.a];
        at_result: int = 0;
        while (at_result < called.results) {
            named := params[called.first + called.count + at_result];
            cell: Cell = {storage: named.storage, container: named.container, record: named.record, constant: 0,
                          variant: -1, kind: ValueKind};
            cells.append(cell);
            at_result += 1;
        }
        result_count = called.results;
        result = Typed(at.cell + total, FunctionResultsStorage, 0, item.a);
        if (called.results == 1) {
            named := params[called.first + called.count];
            result = Typed(-1, named.storage, named.container, named.record);
        }
        named_results = true;
    } else if (!linked && callables[item.a].result != 0) {
        called := callables[item.a];
        result = Typed(-1, called.result, called.result_container, called.result_record);
        result_count = 1;
    }
    if (result.storage > 0 && !named_results) {
        cell: Cell = {storage: result.storage, container: result.container, record: result.record, constant: 0, variant: -1,
                      kind: ValueKind};
        cells.append(cell);
    }
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    index = 0;
    while (index < total) {
        argument := arguments[index];
        // Each argument is watched as the call's input; a scoped argument as the
        // value it reaches. EmitBody watches an overloaded native's supplied
        // arguments where they are written (OverloadArguments), so only its
        // omitted defaults are watched here.
        written := SlotStorage(argument.storage, argument.container, target);
        if (argument.storage == ReferenceStorage) {
            written = target.pointer_storage;
            code.append(ReferenceWatch(ops, params[callables[item.a].first + index], index, argument.slot,
                                       node, target));
        } else if (!ops.debug || item.c != 4 || NativeProvided(given, index) < 0) {
            code.append(WatchCode(ops, argument.slot, argument.storage, argument.container, argument.record,
                                  index, false, node, target));
        }
        slots.append(address);
        code.append(Instruction(ops.host_slot, target.pointer_storage, b + index, at.cell + index, 0, 0, node));
        write := Instruction(ops.write, written, 0, argument.slot, b + index, 0, node);
        write.offset = target.payload_offset;
        code.append(write);
        code.extend(SchemaWriteCode(argument, b + index, ops, target, node));
        index += 1;
    }
    if (linked) {
        host: Host = {intrinsic: 0, linked: chosen, first: at.cell, result_first: at.cell + total,
                      result_count: result_count, written: false};
        hosts.append(host);
        code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, node));
    } else {
        invocation: Invocation = {callee: item.a, first: at.cell, count: total, result_first: at.cell + total,
                                  result_count: result_count};
        calls.append(invocation);
        // Each invocation suspends the caller once; EmitBody numbers it.
        code.append(Instruction(ops.invoke, 0, 0, at.call, 0, 0, node));
    }
    if (result.storage > 0) {
        slots.append(address);
        code.append(Instruction(ops.host_slot, target.pointer_storage, b + total, at.cell + total, 0, 0, node));
        loaded: Slot = {storage: SlotStorage(result.storage, result.container, target),
                        kind: SlotKind(result.storage, result.container)};
        slots.append(loaded);
        read := Instruction(ops.load, loaded.storage, b + total + 1, b + total, 0, 0, node);
        read.offset = target.payload_offset;
        code.append(read);
        if (Pointer(result.storage, result.container)) {
            root: Root = {slot: b + total + 1, storage: result.storage, container: result.container,
                          record: result.record};
            roots.append(root);
        }
        result.slot = b + total + 1;
    }
    if (linked && result_count == 1) {
        next.append(RecordNativeCall(item.node, chosen, result));
    }
    return CellSchemaStep(Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, count, result, NoValue(), marks),
                          at.cell + total, ops, target, at, node);
}

// Unary operators and the binary operators other than logic.
OperatorStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, types: TypeDecl[], constants: ConstDecl[],
                 names: Name[], package: int, values: Value[], top: int, item: Work, ops: Ops, at: Bases) -> Step {
    node := forest[item.node];
    unary := node.kind == "unary_expression";
    code: Code[] = [];
    slots: Slot[] = [];
    locals: Slot[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    if (item.phase == 0 && !unary) {
        operator := Text(forest, text, Field(forest, item.node, "operator"));
        left := Field(forest, item.node, "left");
        right := Field(forest, item.node, "right");
        if ((operator == "==" || operator == "!=") && (Is(forest, left, "nil") || Is(forest, right, "nil"))) {
            nil_node := right;
            value := left;
            if (Is(forest, left, "nil")) {
                nil_node = left;
                value = right;
            }
            finish := Resume(item.node, PointerNilPhase, nil_node, 0);
            if (operator == "!=") {
                finish.c = 1;
            }
            return Step.Emitted([], [], [], [], [], [], [], [], [Visit(value), finish], 0, NoValue(), NoValue(), []);
        }
    }
    if (item.phase == 0) {
        if (unary) {
            next.append(Visit(Field(forest, item.node, "operand")));
        } else {
            next.append(Visit(Field(forest, item.node, "left")));
            next.append(Visit(Field(forest, item.node, "right")));
        }
        // The expected type stays with the node, for untyped literals.
        finish := Expect(item.node, item.storage, item.container, item.record);
        finish.phase = 1;
        next.append(finish);
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, NoValue(), NoValue(), marks);
    }
    operator := Text(forest, text, Field(forest, item.node, "operator"));
    if (node.kind == "assignment") {
        operator = CompoundOperator(operator);
    }
    flag: Slot = {storage: BoolStorage, kind: ValueKind};
    if (unary) {
        operand := values[top - 1];
        typed_here := Integer(item.storage) || Floating(item.storage);
        if (operand.storage == NumberStorage &&
            (operator == "+" || (operator == "-" && (!typed_here || ParsedLiteral(forest, text, item.node))))) {
            // A signed literal is a literal too: typed here when its use is,
            // else by its use. A minus on a grouped one negates it here.
            literal := Typed(-1, NumberStorage, 0, item.node);
            if (operator == "+") {
                literal = operand;
            }
            if (item.storage == HandleStorage && item.container == 0) {
                switch NumberBits(forest, text, literal.record) {
                    case .Finite(double_bits, float_fits, float_bits):
                        if ((double_bits & 0x7fffffffffffffff) != 0) {
                            return Fail(forest, item.node, document, "entity value requires null or zero");
                        }
                    case .OutOfRange:
                        return Fail(forest, item.node, document, "Numeric literal is outside the range of its type");
                }
                slots.append(ValueLocal(HandleStorage));
                code.append(ConstantCode(ops, HandleStorage, 0, at.slot, node));
                code.extend(LiteralWatch(forest, ops, at.slot, HandleStorage, literal.record));
                if (operator == "+") {
                    code.append(ScalarWatch(ops, at.slot, HandleStorage, 0, true, node));
                }
                return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1,
                                    Typed(at.slot, HandleStorage, 0, item.record), NoValue(), marks);
            }
            if (!typed_here && SignedLiteral(forest, text, item.node) >= 0) {
                // The type its use gives it watches each sign, a plus too.
                literal = Typed(-1, NumberStorage, 0, item.node);
            }
            if (Integer(item.storage) || Floating(item.storage)) {
                switch NumberLiteralStep(forest, text, document, constants, names, package, literal, item.storage, ops,
                                         at, node) {
                    case .Failed(diagnostic):
                        return Step.Failed(diagnostic);
                    case .Emitted(typed_code, typed_slots, typed_locals, typed_cells, typed_hosts, typed_roots,
                                  typed_calls, typed_bound, typed_next, typed_popped, typed_value, typed_retain,
                                  typed_marks):
                        literal = typed_value;
                        code = typed_code;
                        slots = typed_slots;
                }
            }
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1, literal, NoValue(),
                                marks);
        }
        if (operand.storage == NumberStorage && typed_here) {
            switch NumberLiteralStep(forest, text, document, constants, names, package, operand, item.storage, ops, at,
                                     node) {
                case .Failed(diagnostic):
                    return Step.Failed(diagnostic);
                case .Emitted(typed_code, typed_slots, typed_locals, typed_cells, typed_hosts, typed_roots, typed_calls,
                              typed_bound, typed_next, typed_popped, typed_value, typed_retain, typed_marks):
                    code = typed_code;
                    slots = typed_slots;
                    operand = typed_value;
            }
        }
        integer := Integer(operand.storage) && operand.container == 0;
        op: int = -1;
        left_slot := operand.slot;
        right_slot: int = 0;
        if (operator == "-" && (integer || Single(operand, FloatStorage) || Single(operand, DoubleStorage))) {
            output := at.slot + length(slots);
            slots.extend(NegationSlots(operand.storage, ops));
            code.extend(NegationCode(ops, operand.storage, operand.slot, output, node));
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1,
                                Typed(at.slot + length(slots) - 1, operand.storage, 0, -1), NoValue(), marks);
        } else if (operator == "~" && integer) {
            op = ops.bit_not;
        } else if ((operator == "!" || operator == "not") && Single(operand, BoolStorage)) {
            // Not is equality with false.
            slots.append(flag);
            code.append(ConstantCode(ops, BoolStorage, 0, at.slot + length(slots) - 1, node));
            right_slot = at.slot + length(slots) - 1;
            op = ops.eq;
        } else if (operator == "+" && integer) {
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1, operand, NoValue(),
                                marks);
        } else {
            return Fail(forest, item.node, document, "operator does not apply to this operand");
        }
        result: Slot = {storage: operand.storage, kind: ValueKind};
        slots.append(result);
        output := at.slot + length(slots) - 1;
        operation := Instruction(op, operand.storage, output, left_slot, right_slot, -1, node);
        if (op != ops.eq) {
            operation.right = 0;
            operation.target = 0;
        }
        code.append(operation);
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1,
                            Typed(output, operand.storage, 0, -1), NoValue(), marks);
    }
    op := BinaryOp(ops, operator);
    left := values[top - 2];
    right := values[top - 1];
    if (Single(left, StructStorage) || Single(right, StructStorage)) {
        // Records combine through a native, field by field.
        next.append(Resume(item.node, AggregatePhase, 0, 0));
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, NoValue(), NoValue(),
                            marks);
    }
    if (op == ops.shl || op == ops.shr) {
        return ShiftStep(forest, text, document, constants, names, package, left, right, item, op, ops, at);
    }
    // Untyped literals take the other operand's type, or the expected one
    // when both are untyped. A comparison of two expects no number, so each
    // takes its spelled type, as stage zero types it. Other integer operands
    // must have one type.
    wanted := item.storage;
    if (left.storage != NumberStorage) {
        wanted = left.storage;
    }
    if (right.storage != NumberStorage && left.storage == NumberStorage) {
        wanted = right.storage;
    }
    spelled := Comparison(ops, op) && !Integer(wanted) && !Floating(wanted);
    operands: Value[] = [left, right];
    side: int = 0;
    while (side < 2) {
        if (operands[side].storage == NumberStorage) {
            if (spelled) {
                wanted = InferredNumberStorage(forest, text, operands[side].record);
            }
            if (!Integer(wanted) && !Floating(wanted)) {
                return Fail(forest, operands[side].record, document, "a number needs an integer type here");
            }
            shifted: Bases = {pc: at.pc + length(code), slot: at.slot + length(slots), local: at.local, cell: at.cell,
                              host: at.host, call: at.call};
            switch NumberLiteralStep(forest, text, document, constants, names, package, operands[side], wanted, ops,
                                     shifted, node) {
                case .Failed(diagnostic):
                    return Step.Failed(diagnostic);
                case .Emitted(typed_code, typed_slots, typed_locals, typed_cells, typed_hosts, typed_roots, typed_calls,
                              typed_bound, typed_next, typed_popped, typed_value, typed_retain, typed_marks):
                    code.extend(typed_code);
                    slots.extend(typed_slots);
                    operands[side] = typed_value;
            }
        }
        side += 1;
    }
    left = operands[0];
    right = operands[1];
    if (Single(left, left.storage) && Single(right, right.storage) && Integer(left.storage) &&
        Integer(right.storage) && left.storage != right.storage) {
        // Two untyped literals compare at their common type.
        common := CommonInteger(left.storage, right.storage);
        if (!spelled || common < 0) {
            return Fail(forest, item.node, document,
                        format_text("Mismatched integer types {} and {}; convert one operand", TypeName(left.storage),
                                    TypeName(right.storage)));
        }
        widened: Slot = {storage: common, kind: ValueKind};
        if (left.storage != common) {
            slots.append(widened);
            code.append(CastCode(ops, common, at.slot + length(slots) - 1, left.slot, 0, node));
            left = Typed(at.slot + length(slots) - 1, common, 0, -1);
        }
        if (right.storage != common) {
            slots.append(widened);
            code.append(CastCode(ops, common, at.slot + length(slots) - 1, right.slot, 0, node));
            right = Typed(at.slot + length(slots) - 1, common, 0, -1);
        }
    }
    // An integer with a floating value becomes one, as stage zero converts it.
    if (Single(left, left.storage) && Single(right, right.storage) && Integer(left.storage) &&
        Floating(right.storage)) {
        code.extend(NumberCode(ops, left.storage, right.storage, left.slot, at.slot + length(slots), node));
        slots.extend(NumberSlots(left.storage, right.storage));
        left = Typed(at.slot + length(slots) - 1, right.storage, 0, -1);
    }
    if (Single(left, left.storage) && Single(right, right.storage) && Floating(left.storage) &&
        Integer(right.storage)) {
        code.extend(NumberCode(ops, right.storage, left.storage, right.slot, at.slot + length(slots), node));
        slots.extend(NumberSlots(right.storage, left.storage));
        right = Typed(at.slot + length(slots) - 1, left.storage, 0, -1);
    }
    // A float with a double becomes a double.
    if (Single(left, FloatStorage) && Single(right, DoubleStorage)) {
        slots.append(ValueLocal(DoubleStorage));
        code.append(Instruction(ops.convert, DoubleStorage, at.slot + length(slots) - 1, left.slot, 0, 0, node));
        left = Typed(at.slot + length(slots) - 1, DoubleStorage, 0, -1);
    }
    if (Single(left, DoubleStorage) && Single(right, FloatStorage)) {
        slots.append(ValueLocal(DoubleStorage));
        code.append(Instruction(ops.convert, DoubleStorage, at.slot + length(slots) - 1, right.slot, 0, 0, node));
        right = Typed(at.slot + length(slots) - 1, DoubleStorage, 0, -1);
    }
    numeric := Single(left, left.storage) && Single(right, left.storage) && Numeric(left.storage);
    equality := op == ops.eq || op == ops.ne;
    same := Single(right, left.storage) &&
            (Single(left, BoolStorage) || Single(left, TextStorage) ||
             (Single(left, HandleStorage) && left.record == right.record));
    if (Single(left, PointerStorage) && Single(right, PointerStorage) && left.record >= 0 && right.record >= 0) {
        same = types[left.record].id == types[right.record].id;
    }
    if (op < 0 || (!numeric && !(equality && same))) {
        return Fail(forest, item.node, document, "operator does not apply to these operands");
    }
    if (numeric && !Computes(ops, op, left.storage)) {
        return Fail(forest, item.node, document, "unsupported arithmetic type");
    }
    if ((op == ops.div || op == ops.mod) && Integer(left.storage) &&
        ZeroDivisor(forest, text, document, constants, names, package, item.node)) {
        return Fail(forest, item.node, document, "Constant division by zero");
    }
    storage := left.storage;
    operand_storage := left.storage;
    left_slot := left.slot;
    right_slot := right.slot;
    if (Comparison(ops, op)) {
        storage = BoolStorage;
    }
    if (equality && left.storage == TextStorage) {
        // Strings compare by content; inequality negates it.
        slots.append(flag);
        code.append(Instruction(ops.string_equal, BoolStorage, at.slot + length(slots) - 1, left_slot,
                                right_slot, 0, node));
        left_slot = at.slot + length(slots) - 1;
        operand_storage = BoolStorage;
        if (op == ops.eq) {
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 2,
                                Typed(left_slot, BoolStorage, 0, -1), NoValue(), marks);
        }
        slots.append(flag);
        code.append(ConstantCode(ops, BoolStorage, 0, at.slot + length(slots) - 1, node));
        right_slot = at.slot + length(slots) - 1;
        op = ops.eq;
    }
    slot: Slot = {storage: storage, kind: ValueKind};
    slots.append(slot);
    output := at.slot + length(slots) - 1;
    code.append(Instruction(op, operand_storage, output, left_slot, right_slot, -1, node));
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 2,
                        Typed(output, storage, 0, -1), NoValue(), marks);
}

// Compound arithmetic combines the same typed integers before any assignment
// widening. Plain assignment and shift-count typing have separate contracts.
MixedCompoundIntegers :: (operator: string, storage: int, value: Value) -> bool {
    compound := operator == "+" || operator == "-" || operator == "*" || operator == "/" || operator == "%" ||
                operator == "&" || operator == "|" || operator == "^";
    return compound && Integer(storage) && Single(value, value.storage) && Integer(value.storage) &&
           value.storage != storage;
}
// The untyped literal `literal` as a constant of the integer type `storage`.
ConstantStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, constants: ConstDecl[], names: Name[],
                 package: int, literal: Value, storage: int, ops: Ops, at: Bases, node: snapshot.SnapshotNode) -> Step {
    code: Code[] = [];
    slots: Slot[] = [];
    locals: Slot[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    spelled := SignedLiteral(forest, text, literal.record);
    if (spelled < 0) {
        // An untyped constant expression folds at the type its use gives it.
        bits: u64 = 0;
        switch FoldConstant(forest, text, document, constants, names, package, literal.record, storage) {
            case .Failed(diagnostic):
                return Step.Failed(diagnostic);
            case .Waiting:
                return Fail(forest, literal.record, document, "an untyped constant names no constant");
            case .Folded(folded):
                bits = folded;
        }
        slots.append(ValueLocal(storage));
        code = extend([ConstantCode(ops, storage, bits, at.slot, node)],
                      LiteralWatch(forest, ops, at.slot, storage, literal.record));
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
                            Typed(at.slot, storage, 0, -1), NoValue(), marks);
    }
    value_bits: u64 = 0;
    switch SignedConstant(forest, text, document, literal.record, storage) {
        case .Rejected(diagnostic):
            return Step.Failed(diagnostic);
        case .Checked(checked):
            value_bits = checked;
    }
    slots.append(ValueLocal(storage));
    code = extend([ConstantCode(ops, storage, value_bits, at.slot, node)],
                  LiteralWatch(forest, ops, at.slot, storage, Unparenthesized(forest, literal.record)));
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
                        Typed(at.slot, storage, 0, -1), NoValue(), marks);
}
// The grouped or signed literal `node` as a constant of the integer type
// `storage`. Stage zero folds the literal and its signs to one constant.
SignedConstant :: (forest: snapshot.SnapshotNode[], text: string, document: int, node: int,
                   storage: int) -> IntegerLiteralResult {
    exact: u64[] = [];
    switch ReadIntegerLiteral(forest, text, document, SignedLiteral(forest, text, node), storage) {
        case .Rejected(diagnostic):
            return IntegerLiteralResult.Rejected(diagnostic);
        case .Checked(checked):
            exact = ExactStored(checked, storage);
    }
    for (sign in Signs(forest, text, node)) {
        if (Text(forest, text, Field(forest, sign, "operator")) == "-") {
            if (!Signed(storage)) {
                return IntegerLiteralResult.Rejected(Diagnose(forest, sign, document, "Cannot negate an unsigned constant"));
            }
            exact = ExactNegate(exact);
        }
    }
    if (!ExactFits(exact, storage)) {
        return IntegerLiteralResult.Rejected(OutsideRange(forest, document, Unparenthesized(forest, node), storage));
    }
    return IntegerLiteralResult.Checked(ExactWrapped(exact, storage));
}
// The untyped literal `literal` typed as the number type `storage`.
NumberLiteralStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, constants: ConstDecl[],
                      names: Name[], package: int, literal: Value, storage: int, ops: Ops, at: Bases,
                      node: snapshot.SnapshotNode) -> Step {
    if (Floating(storage)) {
        return FloatConstantStep(forest, text, document, literal, storage, ops, at, node);
    }
    return ConstantStep(forest, text, document, constants, names, package, literal, storage, ops, at, node);
}
// Each sign around the grouped literal of `node`, whose value is in slot
// `slot`, as stage zero lowers it: a negation it watches, or a plus it
// watches unchanged. The negations write SignSlots from `slot + 1`.
SignCode :: (forest: snapshot.SnapshotNode[], text: string, ops: Ops, node: int, storage: int, slot: int,
             at_node: snapshot.SnapshotNode) -> Code[] {
    code: Code[] = [];
    value := slot;
    signs := Signs(forest, text, node);
    level := length(signs) - 1;
    while (level >= 0) {
        if (Text(forest, text, Field(forest, signs[level], "operator")) == "-") {
            code.extend(NegationCode(ops, storage, value, value + 1, at_node));
            value += length(NegationSlots(storage, ops));
        }
        code.extend(LiteralWatch(forest, ops, value, storage, signs[level]));
        level -= 1;
    }
    return code;
}
// The slots SignCode writes.
SignSlots :: (forest: snapshot.SnapshotNode[], text: string, ops: Ops, node: int, storage: int) -> Slot[] {
    slots: Slot[] = [];
    for (sign in Signs(forest, text, node)) {
        if (Text(forest, text, Field(forest, sign, "operator")) == "-") {
            slots.extend(NegationSlots(storage, ops));
        }
    }
    return slots;
}

// Whether `node` is a literal ParseNumber reads: a number, or `-` on one.
ParsedLiteral :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> bool {
    if (Is(forest, node, "unary_expression") && Text(forest, text, Field(forest, node, "operator")) == "-") {
        return Is(forest, Field(forest, node, "operand"), "number");
    }
    return Is(forest, node, "number");
}
// The ParsedLiteral inside the parentheses and signs around `node`, as stage
// zero types a grouped or signed literal; -1 for any other expression.
SignedLiteral :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> int {
    at := Unparenthesized(forest, node);
    while (!ParsedLiteral(forest, text, at)) {
        if (!Is(forest, at, "unary_expression")) {
            return -1;
        }
        operator := Text(forest, text, Field(forest, at, "operator"));
        if (operator != "-" && operator != "+") {
            return -1;
        }
        at = Unparenthesized(forest, Field(forest, at, "operand"));
    }
    return at;
}
// The signs around the SignedLiteral of `node`, outermost first.
Signs :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> int[] {
    signs: int[] = [];
    at := Unparenthesized(forest, node);
    while (!ParsedLiteral(forest, text, at)) {
        signs.append(at);
        at = Unparenthesized(forest, Field(forest, at, "operand"));
    }
    return signs;
}
// The slots NegationCode writes.
NegationSlots :: (storage: int, ops: Ops) -> Slot[] {
    if (Computes(ops, ops.neg, storage)) {
        return [ValueLocal(storage)];
    }
    return [ValueLocal(storage), ValueLocal(storage)];
}
// The negation of slot `input` of type `storage` into the NegationSlots from
// `output`, its last one the result. A signed or floating value negates; an
// unsigned one wraps, as zero less it.
NegationCode :: (ops: Ops, storage: int, input: int, output: int, node: snapshot.SnapshotNode) -> Code[] {
    if (Computes(ops, ops.neg, storage)) {
        return [Instruction(ops.neg, storage, output, input, 0, 0, node)];
    }
    return [ConstantCode(ops, storage, 0, output, node), Instruction(ops.sub, storage, output + 1, output, input, -1, node)];
}
// Whether `node` is a constant integer expression that folds to one
// constant: an operator or conversion over constants, but not a literal, a
// signed one or a constant alone. An untyped one where a floating value is expected stays
// a floating computation.
Folds :: (forest: snapshot.SnapshotNode[], text: string, constants: ConstDecl[], names: Name[], package: int,
          node: int, storage: int) -> bool {
    value := Unparenthesized(forest, node);
    if (!Floating(storage) && GroupedDecimal(forest, text, node)) {
        return true;
    }
    operator := Text(forest, text, Field(forest, value, "operator"));
    signed := (operator == "-" || operator == "+") && Is(forest, Field(forest, value, "operand"), "number");
    composite := Is(forest, value, "binary_expression") || Is(forest, value, "call_expression") ||
                 (Is(forest, value, "unary_expression") && !signed);
    if (!composite || !ConstantExpression(forest, text, constants, names, package, node)) {
        return false;
    }
    return ConstantType(forest, text, constants, names, package, node) != 0 || !Floating(storage);
}
// Whether `node` is a decimal literal with signs around it, which folds
// where an integer is expected and waits unvisited for its type where none is.
GroupedDecimal :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> bool {
    spelled := SignedLiteral(forest, text, node);
    return spelled >= 0 && spelled != Unparenthesized(forest, node) &&
           InferredNumberStorage(forest, text, spelled) == FloatStorage;
}
// Whether a conversion in the constant expression `node` names a callable its
// package declares instead, as `int(7)` does where a behavior declares `int`.
ShadowedConversion :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], package: int,
                       node: int) -> bool {
    value := Unparenthesized(forest, node);
    if (Is(forest, value, "unary_expression")) {
        return ShadowedConversion(forest, text, callables, package, Field(forest, value, "operand"));
    }
    if (Is(forest, value, "binary_expression")) {
        return ShadowedConversion(forest, text, callables, package, Field(forest, value, "left")) ||
               ShadowedConversion(forest, text, callables, package, Field(forest, value, "right"));
    }
    if (ConversionType(forest, text, value) == 0) {
        return false;
    }
    if (FindCallable(callables, package, Text(forest, text, Field(forest, value, "function"))) >= 0) {
        return true;
    }
    return ShadowedConversion(forest, text, callables, package, ConversionArgument(forest, value));
}
// The one argument of the conversion `node`, named or not.
ConversionArgument :: (forest: snapshot.SnapshotNode[], node: int) -> int {
    argument := FirstMember(forest, Field(forest, node, "arguments"));
    if (Is(forest, argument, "named_argument")) {
        return Field(forest, argument, "value");
    }
    return argument;
}
// Whether `node` divides by a constant expression equal to zero, which is an
// error for integers whether or not the dividend is constant. A divisor that
// does not evaluate has reported its own error.
ZeroDivisor :: (forest: snapshot.SnapshotNode[], text: string, document: int, constants: ConstDecl[], names: Name[],
                package: int, node: int) -> bool {
    if (!Is(forest, node, "binary_expression") && !Is(forest, node, "assignment")) {
        return false;
    }
    operator := Text(forest, text, Field(forest, node, "operator"));
    if (operator != "/" && operator != "%" && operator != "/=" && operator != "%=") {
        return false;
    }
    divisor := Field(forest, node, "right");
    if (Is(forest, node, "assignment")) {
        divisor = StatementValue(forest, node);
    }
    if (!ConstantExpression(forest, text, constants, names, package, divisor)) {
        return false;
    }
    storage := ConstantType(forest, text, constants, names, package, divisor);
    if (storage == 0) {
        storage = UntypedStorage(forest, text, divisor);
    }
    switch Evaluate(forest, text, document, constants, names, package, divisor, storage) {
        case .Failed(diagnostic):
            return false;
        case .Waiting:
            return false;
        case .Value(exact):
            return ExactZero(exact);
    }
}
// Whether `node` is the value of an integer `/=` or `%=` and a constant
// zero. A compound assignment visits its value at its target's type, or
// combines it in OperatorStep when it reads a component.
ZeroCompoundDivisor :: (forest: snapshot.SnapshotNode[], text: string, document: int, constants: ConstDecl[],
                        names: Name[], package: int, node: int) -> bool {
    statement := forest[node].parent;
    return Is(forest, statement, "assignment") && StatementValue(forest, statement) == node &&
           ZeroDivisor(forest, text, document, constants, names, package, statement);
}
// A constant expression as one constant of its type, or of the expected one
// when it is untyped. Body watches ordinary expressions; literal-shaped
// unary expressions keep their watch here. An untyped one with no integer
// type expected takes its type from its use.
FoldStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, constants: ConstDecl[], names: Name[],
             package: int, item: Work, ops: Ops, at: Bases) -> Step {
    code: Code[] = [];
    slots: Slot[] = [];
    locals: Slot[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    storage := ConstantType(forest, text, constants, names, package, item.node);
    if (storage == 0 && (!Integer(item.storage) || item.container != 0)) {
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
                            Typed(-1, NumberStorage, 0, item.node), NoValue(), marks);
    }
    if (storage == 0) {
        storage = item.storage;
    }
    if (GroupedDecimal(forest, text, item.node)) {
        switch SignedConstant(forest, text, document, item.node, storage) {
            case .Rejected(diagnostic):
                return Step.Failed(diagnostic);
            case .Checked(bits):
                slots.append(ValueLocal(storage));
                code.append(ConstantCode(ops, storage, bits, at.slot, forest[item.node]));
        }
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
                            Typed(at.slot, storage, 0, -1), NoValue(), marks);
    }
    switch FoldConstant(forest, text, document, constants, names, package, item.node, storage) {
        case .Failed(diagnostic):
            return Step.Failed(diagnostic);
        case .Waiting:
            return Fail(forest, item.node, document, "a constant is not folded yet");
        case .Folded(bits):
            slots.append(ValueLocal(storage));
            code.append(ConstantCode(ops, storage, bits, at.slot, forest[item.node]));
            if (NumberLiteral(forest, item.node)) {
                code.extend(LiteralWatch(forest, ops, at.slot, storage, item.node));
            }
    }
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, Typed(at.slot, storage, 0, -1),
                        NoValue(), marks);
}
// A shift has its left operand's type: an untyped one takes the expected
// type, else int, and the count never types it. The count must be unsigned
// and converts to that type, clamping as a conversion does, so a count at
// or past the width still gives 0, or the sign fill for `>>`.
ShiftStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, constants: ConstDecl[], names: Name[],
              package: int, left: Value, right: Value, item: Work, op: int, ops: Ops, at: Bases) -> Step {
    node := forest[item.node];
    code: Code[] = [];
    slots: Slot[] = [];
    locals: Slot[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    value := left;
    if (left.storage == NumberStorage) {
        storage := IntStorage;
        if (Integer(item.storage) && item.container == 0) {
            storage = item.storage;
        }
        switch ConstantStep(forest, text, document, constants, names, package, left, storage, ops, at, node) {
            case .Failed(diagnostic):
                return Step.Failed(diagnostic);
            case .Emitted(typed_code, typed_slots, typed_locals, typed_cells, typed_hosts, typed_roots, typed_calls,
                          typed_bound, typed_next, typed_popped, typed_value, typed_retain, typed_marks):
                code = typed_code;
                slots = typed_slots;
                value = typed_value;
        }
    }
    if (!Single(value, value.storage) || !Integer(value.storage)) {
        return Fail(forest, item.node, document, "operator does not apply to these operands");
    }
    count := right;
    count_slot := at.slot + length(slots);
    if (right.storage == NumberStorage) {
        written := UntypedStorage(forest, text, right.record);
        bits: u64 = 0;
        switch FoldConstant(forest, text, document, constants, names, package, right.record, written) {
            case .Failed(diagnostic):
                return Step.Failed(diagnostic);
            case .Waiting:
                return Fail(forest, right.record, document, "an untyped constant names no constant");
            case .Folded(folded):
                bits = folded;
        }
        exact := ExactStored(bits, written);
        if (ExactNegative(exact)) {
            return Fail(forest, Unparenthesized(forest, right.record), document, "Shift count must not be negative");
        }
        // Observe the written integer before the runtime count conversion.
        // Its value and type belong to the source expression, not the shift.
        if (ops.debug && Integer(written)) {
            slots.append(ValueLocal(written));
            code.append(ConstantCode(ops, written, bits, count_slot, node));
            code.extend(LiteralWatch(forest, ops, count_slot, written, right.record));
            count_slot += 1;
        }
        if (!ExactFits(exact, value.storage)) {
            exact = ExactMax(value.storage);
        }
        slots.append(ValueLocal(value.storage));
        code.append(ConstantCode(ops, value.storage, ExactWrapped(exact, value.storage), count_slot, node));
        if (!Integer(written)) {
            code.extend(LiteralWatch(forest, ops, count_slot, value.storage, right.record));
        }
        count = Typed(count_slot, value.storage, 0, -1);
    } else if (!Single(right, right.storage) || !Integer(right.storage)) {
        return Fail(forest, item.node, document, "operator does not apply to these operands");
    } else if (Signed(right.storage)) {
        return Fail(forest, Unparenthesized(forest, Field(forest, item.node, "right")), document,
                    "Shift count must be unsigned; convert it with u32(value)");
    } else if (right.storage != value.storage) {
        slots.append(ValueLocal(value.storage));
        code.append(CastCode(ops, value.storage, count_slot, right.slot, 0, node));
        count = Typed(count_slot, value.storage, 0, -1);
    }
    slots.append(ValueLocal(value.storage));
    output := at.slot + length(slots) - 1;
    code.append(Instruction(op, value.storage, output, value.slot, count.slot, -1, node));
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 2,
                        Typed(output, value.storage, 0, -1), NoValue(), marks);
}

// The head of a for loop over the copy in the last cell: an index local
// set to zero, or to the last index when `reverse`, then at `head` the bound
// check, the exit jump and the element load, which takes a second local for a
// packable record. Marks report the head, the exit jump and the index local.
ForStep :: (array: Value, packable: bool, reverse: bool, ops: Ops, target: Target, at: Bases,
            node: snapshot.SnapshotNode) -> Step {
    code: Code[] = [];
    slots: Slot[] = [];
    locals: Slot[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    number: Slot = {storage: IntStorage, kind: ValueKind};
    flag: Slot = {storage: BoolStorage, kind: ValueKind};
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    if (reverse) {
        // The copy's count is fixed, so the last index is read once.
        slots.append(address);
        slots.append(address);
        slots.append(number);
        slots.append(number);
        slots.append(number);
        code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot, at.cell - 1, 0, 0, node));
        start_load := Instruction(ops.load, target.pointer_storage, at.slot + 1, at.slot, 0, 0, node);
        start_load.offset = target.payload_offset;
        code.append(start_load);
        start_root: Root = {slot: at.slot + 1, storage: array.storage, container: ArrayContainer, record: array.record};
        roots.append(start_root);
        code.append(Instruction(ops.guard, 0, 0, at.slot + 1, 0, target.argument_failure, node));
        start_count := Instruction(ops.load, IntStorage, at.slot + 2, at.slot + 1, 0, 0, node);
        start_count.offset = target.count_offset;
        code.append(start_count);
        code.append(ConstantCode(ops, IntStorage, 1, at.slot + 3, node));
        code.append(Instruction(ops.sub, IntStorage, at.slot + 4, at.slot + 2, at.slot + 3, -1, node));
    } else {
        slots.append(number);
        constant := Instruction(ops.constant, IntStorage, at.slot, 0, 0, 0, node);
        constant.value_storage = IntStorage;
        code.append(constant);
    }
    locals.append(ValueLocal(IntStorage));
    code.append(Instruction(ops.save, IntStorage, 0, at.slot + length(slots) - 1, 0, at.local, node));
    // The head's slots follow the start's.
    b := at.slot + length(slots);
    head := at.pc + length(code);
    code.append(Instruction(ops.check, 0, 0, 0, 0, 0, node));
    slots.append(address);
    code.append(Instruction(ops.host_slot, target.pointer_storage, b, at.cell - 1, 0, 0, node));
    slots.append(address);
    load := Instruction(ops.load, target.pointer_storage, b + 1, b, 0, 0, node);
    load.offset = target.payload_offset;
    code.append(load);
    root: Root = {slot: b + 1, storage: array.storage, container: ArrayContainer, record: array.record};
    roots.append(root);
    code.append(Instruction(ops.guard, 0, 0, b + 1, 0, target.argument_failure, node));
    slots.append(number);
    count := Instruction(ops.load, IntStorage, b + 2, b + 1, 0, 0, node);
    count.offset = target.count_offset;
    code.append(count);
    slots.append(number);
    code.append(Instruction(ops.local, IntStorage, b + 3, at.local, 0, 0, node));
    if (reverse) {
        slots.append(number);
        code.append(ConstantCode(ops, IntStorage, 0, b + 4, node));
        slots.append(flag);
        code.append(Instruction(ops.ge, IntStorage, b + 5, b + 3, b + 4, -1, node));
    } else {
        slots.append(flag);
        code.append(Instruction(ops.lt, IntStorage, b + 4, b + 3, b + 2, -1, node));
    }
    code.append(Instruction(ops.branch_if, 0, 0, at.slot + length(slots) - 1, 0, at.pc + length(code) + 2,
                            node));
    leave := at.pc + length(code);
    code.append(Instruction(ops.jump, 0, 0, 0, 0, Pending, node));
    // The index is between zero and the count, so the element needs no check.
    first_load := at.slot + length(slots);
    slots.extend(LoadSlots(array.storage, packable, target));
    code.extend(ElementLoad(b + 1, b + 3, array.storage, packable, first_load,
                            at.pc + length(code), at.local + 1, ops, target, node));
    locals.extend(ElementLocals(array.storage, packable, target));
    element := at.slot + length(slots) - 1;
    if (array.storage == StructStorage) {
        element_root: Root = {slot: element, storage: StructStorage, container: 0, record: array.record};
        roots.append(element_root);
    }
    marks: int[] = [head, leave, at.local];
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
                        Typed(element, array.storage, 0, array.record), NoValue(), marks);
}

// `x.f = v` and `x.f op= v` on the local record `binding`, as stage zero
// writes a field: a narrower integer `v` converted first, a reference to the
// local's cell and then to the field, and a write through it, which copies
// the record with the new field, so no other value shares the old storage,
// and copies a string into it.
FieldStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, binding: Name, field: TypeMember,
              value: Value, item: Work, ops: Ops, target: Target, at: Bases,
              node: snapshot.SnapshotNode) -> Step {
    code: Code[] = [];
    slots: Slot[] = [];
    locals: Slot[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    operator := CompoundOperator(Text(forest, text, Field(forest, item.node, "operator")));
    if (item.c == 1 && field.container == 0 && MixedCompoundIntegers(operator, field.storage, value)) {
        return Fail(forest, item.node, document,
                    format_text("Mismatched integer types {} and {}; convert one operand",
                                TypeName(field.storage), TypeName(value.storage)));
    }
    stored := value;
    if (value.container == 0 && value.storage != field.storage && Converts(value.storage, field.storage)) {
        slots.extend(NumberSlots(value.storage, field.storage));
        code.extend(NumberCode(ops, value.storage, field.storage, value.slot, at.slot, node));
        stored = Typed(at.slot + length(slots) - 1, field.storage, 0, -1);
    }
    if (binding.place == ReferencePlace) {
        return ReferenceFieldStep(forest, text, document, binding, field, stored, code, slots, item, ops, target, at,
                                  node);
    }
    if (item.c == 1) {
        // The current field, read in place, combined with the value.
        op := BinaryOp(ops, CompoundOperator(Text(forest, text, Field(forest, item.node, "operator"))));
        if (op < 0 || Comparison(ops, op) || !(Integer(field.storage) || Floating(field.storage)) ||
            !Single(stored, field.storage)) {
            return Fail(forest, item.node, document, "compound assignment needs number operands of its type");
        }
        if (!Computes(ops, op, field.storage)) {
            return Fail(forest, item.node, document, "unsupported arithmetic type");
        }
        base := at.slot + length(slots);
        slots.append(address);
        code.append(Instruction(ops.host_slot, target.pointer_storage, base, binding.index, 0, 0, node));
        slots.append(address);
        record := Instruction(ops.load, target.pointer_storage, base + 1, base, 0, 0, node);
        record.offset = target.payload_offset;
        code.append(record);
        current: Slot = {storage: field.storage, kind: ValueKind};
        slots.append(current);
        read := Instruction(ops.load, field.storage, base + 2, base + 1, 0, 0, node);
        read.offset = field.offset;
        code.append(read);
        slots.append(current);
        code.append(Instruction(op, field.storage, base + 3, base + 2, stored.slot, -1, node));
        code.append(ScalarWatch(ops, base + 3, field.storage, 0, true,
                                forest[Field(forest, item.node, "target")]));
        stored = Typed(base + 3, field.storage, 0, -1);
    }
    if (!SameType(field.storage, 0, -1, stored)) {
        return Fail(forest, item.node, document, "field value differs from its type");
    }
    // Reference make: the context, the record's type, a value reference to
    // the local's cell, then unused component facts.
    first := at.cell;
    constants: u64[] = [0, 0, 0, 0xFFFFFFFFFFFFFFFF, 0, 0, 0, 0, 0];
    cells.extend(ReferenceCells(target, binding.record, constants, field));
    // The context and the local's cell address go into the make's cells.
    slots.append(address);
    holder := at.slot + length(slots) - 1;
    context := Instruction(ops.context, target.pointer_storage, holder, 0, 0, 1, node);
    code.append(context);
    slots.append(address);
    code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot + length(slots) - 1, binding.index,
                            0, 0, node));
    local := at.slot + length(slots) - 1;
    code.extend(CellWrite(target.pointer_storage, holder, first, ops, target, at.slot + length(slots), node));
    slots.append(address);
    code.extend(CellWrite(target.pointer_storage, local, first + 4, ops, target, at.slot + length(slots), node));
    slots.append(address);
    hosts.extend(FieldReferenceHosts(first));
    code.extend(ReferenceCode(ops, target, first, first + 14, at.host, at.slot + length(slots), node));
    slots.extend(FieldReferenceSlots(target));
    hosts.append(WriteHost(first));
    code.extend(ReferenceWriteCode(ops, target, first, at.slot + length(slots) - 1, stored.slot, field.storage,
                                   at.host + 2, at.slot + length(slots), node));
    slots.append(address);
    slots.append(address);
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1, NoValue(), NoValue(), marks);
}
// A cell's payload into a new slot: its address at `slot`, its value at
// `slot + 1`.
CellRead :: (storage: int, cell: int, ops: Ops, target: Target, slot: int, node: snapshot.SnapshotNode) -> Code[] {
    code: Code[] = [];
    code.append(Instruction(ops.host_slot, target.pointer_storage, slot, cell, 0, 0, node));
    read := Instruction(ops.load, storage, slot + 1, slot, 0, 0, node);
    read.offset = target.payload_offset;
    return append(code, read);
}
// A slot's value into a cell's payload, through the cell's address at `slot`.
CellWrite :: (storage: int, value: int, cell: int, ops: Ops, target: Target, slot: int,
              node: snapshot.SnapshotNode) -> Code[] {
    code: Code[] = [];
    code.append(Instruction(ops.host_slot, target.pointer_storage, slot, cell, 0, 0, node));
    write := Instruction(ops.write, storage, 0, value, slot, 0, node);
    write.offset = target.payload_offset;
    return append(code, write);
}
// The component of the owner `self.C` names, as an index into `types`; -1
// for any other node.
SelfComponent :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], names: Name[],
                  node: int) -> int {
    if (!Is(forest, node, "member_expression")) {
        return -1;
    }
    owner := Field(forest, node, "object");
    if (!Is(forest, owner, "identifier")) {
        return -1;
    }
    found := Lookup(names, Text(forest, text, owner));
    if (found < 0 || names[found].place != SelfPlace) {
        return -1;
    }
    component := FindNativeType(types, Text(forest, text, Field(forest, node, "member")));
    if (component < 0 || types[component].component == 0) {
        return -1;
    }
    return component;
}
// Whether a handle of `record` has the owner's entity type, the only handles
// whose components a behavior reaches, as stage zero requires.
OwnerHandle :: (types: TypeDecl[], names: Name[], record: int) -> bool {
    owner := Lookup(names, "self");
    return owner >= 0 && record >= 0 && Canonical(types, record) == Canonical(types, names[owner].record);
}
// The component `e.C` names on an entity other than the owner: a handle name
// or a global's keyed handle; -1 for any other node.
EntityComponent :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], members: TypeMember[],
                    names: Name[], node: int) -> int {
    if (!Is(forest, node, "member_expression")) {
        return -1;
    }
    owner := Field(forest, node, "object");
    handle := false;
    if (Is(forest, owner, "identifier")) {
        found := Lookup(names, Text(forest, text, owner));
        handle = found >= 0 && names[found].place != SelfPlace && names[found].place != GlobalPlace &&
                 names[found].storage == HandleStorage && names[found].container == 0 &&
                 OwnerHandle(types, names, names[found].record);
    } else if (Is(forest, owner, "member_expression")) {
        keyed := KeyedMember(forest, text, types, members, names, owner);
        handle = keyed >= 0 && members[keyed].storage == HandleStorage &&
                 OwnerHandle(types, names, members[keyed].record);
    }
    if (!handle) {
        return -1;
    }
    return Component(types, Text(forest, text, Field(forest, node, "member")));
}
// The field `g.F` names on the global `g` that a native reads by its key, as
// an index into `members`; -1 for any other node.
KeyedMember :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], members: TypeMember[],
                names: Name[], node: int) -> int {
    global := Field(forest, node, "object");
    if (!Is(forest, global, "identifier")) {
        return -1;
    }
    found := Lookup(names, Text(forest, text, global));
    if (found < 0 || names[found].place != GlobalPlace || names[found].record < 0) {
        return -1;
    }
    field := FindField(types, members, names[found].record, Text(forest, text, Field(forest, node, "member")));
    if (field < 0 || members[field].read < 0 || members[field].read_key == "") {
        return -1;
    }
    return field;
}
// The component type `name` names, -1 for none.
Component :: (types: TypeDecl[], name: string) -> int {
    found := FindNativeType(types, name);
    if (found < 0 || types[found].component == 0) {
        return -1;
    }
    return found;
}
// The constant field `g.F` names on the global `g`, as an index into
// `members`; -1 for any other node.
ConstantMember :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], members: TypeMember[],
                   names: Name[], node: int) -> int {
    global := Field(forest, node, "object");
    if (!Is(forest, global, "identifier")) {
        return -1;
    }
    found := Lookup(names, Text(forest, text, global));
    if (found < 0 || names[found].place != GlobalPlace || names[found].record < 0) {
        return -1;
    }
    field := FindField(types, members, names[found].record, Text(forest, text, Field(forest, node, "member")));
    if (field < 0 || !members[field].constant) {
        return -1;
    }
    return field;
}
// The native type named `name`, matched as the catalog matches names: an
// exact name first, else the one that matches loosely; -1 for none or
// several.
FindNativeType :: (types: TypeDecl[], name: string) -> int {
    found: int = -1;
    index: int = 0;
    while (index < length(types)) {
        if (types[index].kind == NativeDecl && types[index].name == name) {
            return index;
        }
        if (types[index].kind == NativeDecl && NameMatches(types[index].name, name)) {
            if (found != -1) {
                found = -2;
            } else {
                found = index;
            }
        }
        index += 1;
    }
    if (found < 0) {
        return -1;
    }
    return found;
}
// The cells of a reference make: its nine arguments, the context, the type
// of types[record] and then `facts`: the reference's kind and element, an
// address, the owner, and a component's ID, layout and size; then its result.
MakeCells :: (target: Target, record: int, facts: u64[]) -> Cell[] {
    kinds: int[] = [AddressKind, ValueKind, ValueKind, ValueKind, AddressKind, ValueKind, ValueKind, ValueKind,
                    ValueKind];
    storages: int[] = [target.pointer_storage, StructStorage, IntStorage, IntStorage, target.pointer_storage,
                       HandleStorage, WordStorage, WordStorage, WordStorage];
    cells: Cell[] = [];
    index: int = 0;
    while (index < 9) {
        record_index: int = -1;
        if (index == 1) {
            record_index = record;
        }
        cell: Cell = {storage: storages[index], container: 0, record: record_index, constant: facts[index],
                      variant: -1, kind: kinds[index]};
        cells.append(cell);
        index += 1;
    }
    return append(cells, ReferenceCell(target));
}
ReferenceCell :: (target: Target) -> Cell {
    return {storage: target.pointer_storage, container: 0, record: -1, constant: 0, variant: -1, kind: ReferenceKind};
}
// The make facts of a reference to the owner's component `declared`.
ComponentFacts :: (declared: TypeDecl) -> u64[] {
    return [0, 0, u64(ComponentReference), 0xFFFFFFFFFFFFFFFF, 0, 0, declared.component, declared.layout,
            u64(declared.size)];
}
// The cells of a field write through references: MakeCells, then the field
// reference's reference, type, offset and element flag and its result, and the
// write's reference, value and bool result.
ReferenceCells :: (target: Target, record: int, facts: u64[], field: TypeMember) -> Cell[] {
    made := ReferenceCell(target);
    typed: Cell = {storage: field.storage, container: 0, record: -1, constant: 0, variant: -1, kind: ValueKind};
    offset: Cell = {storage: WordStorage, container: 0, record: -1, constant: u64(field.offset), variant: -1,
                    kind: ValueKind};
    element: Cell = {storage: BoolStorage, container: 0, record: -1, constant: 0, variant: -1, kind: ValueKind};
    return extend(MakeCells(target, record, facts), [made, typed, offset, element, made, made, typed, element]);
}
// The reference make and the field reference, written through, over the
// cells from `first`.
FieldReferenceHosts :: (first: int) -> Host[] {
    make: Host = {intrinsic: ReferenceMakeIntrinsic, linked: -1, first: first, result_first: first + 9, result_count: 1,
                  written: true};
    field: Host = {intrinsic: ReferenceFieldIntrinsic, linked: -1, first: first + 10, result_first: first + 14,
                   result_count: 1, written: false};
    return [make, field];
}
WriteHost :: (first: int) -> Host {
    return {intrinsic: ReferenceWriteIntrinsic, linked: -1, first: first + 15, result_first: first + 17,
            result_count: 1, written: false};
}
// The make, its reference into the first cell of the host after it, a field
// reference or a read, then that host, whose result in cell `result` it
// leaves at slot + 4; the make's reference stays at slot + 1. `host` is the
// make's host.
ReferenceCode :: (ops: Ops, target: Target, first: int, result: int, host: int, slot: int,
                  node: snapshot.SnapshotNode) -> Code[] {
    code: Code[] = [Instruction(ops.host_call, 0, 0, target.data_failure, 0, host, node)];
    code.extend(CellRead(target.pointer_storage, first + 9, ops, target, slot, node));
    code.extend(CellWrite(target.pointer_storage, slot + 1, first + 10, ops, target, slot + 2, node));
    code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, host + 1, node));
    return extend(code, CellRead(target.pointer_storage, result, ops, target, slot + 3, node));
}
// The slots ReferenceCode uses for a field reference.
FieldReferenceSlots :: (target: Target) -> Slot[] {
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    reference: Slot = {storage: target.pointer_storage, kind: ReferenceKind};
    return [address, reference, address, address, reference];
}
// The write of `value` through the field reference at slot `reference`,
// with two address slots from `slot`. `host` is the write's host.
ReferenceWriteCode :: (ops: Ops, target: Target, first: int, reference: int, value: int, storage: int, host: int,
                       slot: int, node: snapshot.SnapshotNode) -> Code[] {
    code := CellWrite(target.pointer_storage, reference, first + 15, ops, target, slot, node);
    code.extend(CellWrite(storage, value, first + 16, ops, target, slot + 1, node));
    return append(code, Instruction(ops.host_call, 0, 0, target.data_failure, 0, host, node));
}
// The context and the owner into the cells of a make from `first`, through
// the four OwnerSlots from `slot`. The owner is the entity in slot `entity`,
// or the behavior's own when that is -1.
OwnerCode :: (ops: Ops, target: Target, first: int, entity: int, slot: int, node: snapshot.SnapshotNode) -> Code[] {
    owner := entity;
    code: Code[] = [Instruction(ops.context, target.pointer_storage, slot, 0, 0, 1, node)];
    if (owner < 0) {
        owner = slot + 1;
        code.append(Instruction(ops.owner, HandleStorage, owner, 0, 0, 0, node));
    }
    code.extend(CellWrite(target.pointer_storage, slot, first, ops, target, slot + 2, node));
    return extend(code, CellWrite(HandleStorage, owner, first + 5, ops, target, slot + 3, node));
}
OwnerSlots :: (target: Target) -> Slot[] {
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    owner: Slot = {storage: HandleStorage, kind: ValueKind};
    return [address, owner, address, address];
}
// `self.C.f = v` as stage zero orders it: the references to the owner's
// component types[component] and to its field members[field] first, after
// `before`; then the value, and the write in ComponentPhase. A `compound`
// assignment reads the field through the reference first and combines it
// with the value. Pushing onto `before` would make this step and its callers
// copy their arguments. `e.C.f = v` writes the component of the entity in
// slot `entity`, which it pops.
ComponentReferenceStep :: (before: Code[], types: TypeDecl[], members: TypeMember[], component: int, field: int,
                           entity: int, value: int, compound: bool, item: Work, ops: Ops, target: Target, at: Bases,
                           node: snapshot.SnapshotNode) -> Step {
    locals: Slot[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    marks: int[] = [];
    first := at.cell;
    declared := members[field];
    cells := ReferenceCells(target, component, ComponentFacts(types[component]), declared);
    code := OwnerCode(ops, target, first, entity, at.slot, node);
    popped: int = 0;
    if (entity >= 0) {
        popped = 1;
    }
    code.extend(ReferenceCode(ops, target, first, first + 14, at.host, at.slot + 4, node));
    slots := extend(OwnerSlots(target), FieldReferenceSlots(target));
    reference := at.slot + length(slots) - 1;
    write := Resume(item.node, ComponentPhase, first, field);
    write.c = reference;
    hosts := FieldReferenceHosts(first);
    if (!compound) {
        next: Work[] = [Expect(value, declared.storage, 0, -1), write];
        return Step.Emitted(extend(before, code), slots, locals, cells, hosts, roots, calls, bound, next, popped,
                            NoValue(), NoValue(), marks);
    }
    // The read takes the field reference and returns the field's value, in
    // cells after the write's.
    typed: Cell = {storage: declared.storage, container: 0, record: -1, constant: 0, variant: -1, kind: ValueKind};
    cells.extend([ReferenceCell(target), typed]);
    copy: Host = {intrinsic: ReferenceReadIntrinsic, linked: -1, first: first + 18, result_first: first + 19,
                  result_count: 1, written: false};
    hosts.append(copy);
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    current: Slot = {storage: declared.storage, kind: ValueKind};
    code.extend(CellWrite(target.pointer_storage, reference, first + 18, ops, target, reference + 1, node));
    code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host + 2, node));
    code.extend(CellRead(declared.storage, first + 19, ops, target, reference + 2, node));
    slots.extend([address, address, current]);
    next: Work[] = [Visit(value), Resume(item.node, CombinePhase, 0, 0), write];
    return Step.Emitted(extend(before, code), slots, locals, cells, hosts, roots, calls, bound, next, popped,
                        Typed(reference + 3, declared.storage, 0, -1), NoValue(), marks);
}
// Where ComponentReadStep leaves the make's reference, from its first slot.
ComponentReferenceSlot: int : 5;
// `self.C`: the owner's component types[component], read through a reference
// into a record of its own, as stage zero reads it, after `before`; `e.C`
// reads the component of the entity in slot `entity`, which it pops. A
// compound assignment writes through the reference, so its make is `written`,
// and schedules `next`.
ComponentReadStep :: (before: Code[], types: TypeDecl[], component: int, written: bool, entity: int, next: Work[],
                      ops: Ops, target: Target, at: Bases, node: snapshot.SnapshotNode) -> Step {
    locals: Slot[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    marks: int[] = [];
    first := at.cell;
    read: Cell = {storage: StructStorage, container: 0, record: component, constant: 0, variant: -1,
                  kind: ValueKind};
    cells := extend(MakeCells(target, component, ComponentFacts(types[component])), [ReferenceCell(target), read]);
    make: Host = {intrinsic: ReferenceMakeIntrinsic, linked: -1, first: first, result_first: first + 9, result_count: 1,
                  written: written};
    copy: Host = {intrinsic: ReferenceReadIntrinsic, linked: -1, first: first + 10, result_first: first + 11,
                  result_count: 1, written: false};
    code := OwnerCode(ops, target, first, entity, at.slot, node);
    code.extend(ReferenceCode(ops, target, first, first + 11, at.host, at.slot + 4, node));
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    reference: Slot = {storage: target.pointer_storage, kind: ReferenceKind};
    slots := extend(OwnerSlots(target), [address, reference, address, address, address]);
    value := at.slot + length(slots) - 1;
    roots: Root[] = [{slot: value, storage: StructStorage, container: 0, record: component}];
    popped: int = 0;
    if (entity >= 0) {
        popped = 1;
    }
    return CellSchemaStep(Step.Emitted(extend(before, code), slots, locals, cells, [make, copy], roots, calls, bound, next, popped,
                                       Typed(value, StructStorage, 0, component), NoValue(), marks), first + 11, ops, target, at, node);
}
// `self.C = v`: the reference to the owner's component types[component],
// made to be written through, after `before`; `next` writes the value.
// `e.C = v` makes the reference to the component of the entity in slot
// `entity`, which it pops.
ComponentMakeStep :: (before: Code[], types: TypeDecl[], component: int, entity: int, next: Work[], ops: Ops,
                      target: Target, at: Bases, node: snapshot.SnapshotNode) -> Step {
    locals: Slot[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    marks: int[] = [];
    first := at.cell;
    make: Host = {intrinsic: ReferenceMakeIntrinsic, linked: -1, first: first, result_first: first + 9, result_count: 1,
                  written: true};
    code := OwnerCode(ops, target, first, entity, at.slot, node);
    code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, node));
    code.extend(CellRead(target.pointer_storage, first + 9, ops, target, at.slot + 4, node));
    popped: int = 0;
    if (entity >= 0) {
        popped = 1;
    }
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    reference: Slot = {storage: target.pointer_storage, kind: ReferenceKind};
    slots := extend(OwnerSlots(target), [address, reference]);
    cells := MakeCells(target, component, ComponentFacts(types[component]));
    return Step.Emitted(extend(before, code), slots, locals, cells, [make], roots, calls, bound, next, popped,
                        NoValue(), NoValue(), marks);
}
// The second phase of `e.C = v`, `e.C op= v` and `e.C.f = v`, with the entity
// on top: the write of the component types[item.a], or of its field
// members[item.b], as the owner's is written; item.c marks a compound one.
EntityComponentStep :: (forest: snapshot.SnapshotNode[], types: TypeDecl[], members: TypeMember[], entity: Value,
                        item: Work, ops: Ops, target: Target, at: Bases, node: snapshot.SnapshotNode) -> Step {
    value := Field(forest, item.node, "value");
    if (item.b >= 0) {
        return ComponentReferenceStep([], types, members, item.a, item.b, entity.slot, value, item.c != 0, item, ops,
                                      target, at, node);
    }
    write := Resume(item.node, ComponentAssignPhase, at.slot + ComponentReferenceSlot, item.a);
    if (item.c == 0) {
        return ComponentMakeStep([], types, item.a, entity.slot, [Visit(value), write], ops, target, at, node);
    }
    return ComponentReadStep([], types, item.a, true, entity.slot,
                             [Visit(value), Resume(item.node, CombinePhase, 0, 0), write], ops, target, at, node);
}
// The type a native type stands for, as stage zero's canonical type: its
// underlying type, followed to the end.
Canonical :: (types: TypeDecl[], record: int) -> int {
    at := record;
    steps: int = 0;
    while (at >= 0 && at < length(types) && steps < length(types)) {
        if ((types[at].kind != NativeDecl && types[at].kind != OptionalComponentDecl) || types[at].parent < 0) {
            return at;
        }
        at = types[at].parent;
        steps += 1;
    }
    return -1;
}
// The write of `self.C = v` and `self.C op= v`: the record, of a type that
// stands for the same one as the component's, types[item.b], through the
// reference at slot item.a.
ComponentAssignStep :: (forest: snapshot.SnapshotNode[], document: int, types: TypeDecl[], value: Value, item: Work,
                        ops: Ops, target: Target, at: Bases, node: snapshot.SnapshotNode) -> Step {
    canonical := Canonical(types, value.record);
    if (!Single(value, StructStorage) || canonical < 0 || canonical != Canonical(types, item.b)) {
        return Fail(forest, item.node, document, "assigned value differs from its component");
    }
    locals: Slot[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    record: Cell = {storage: StructStorage, container: 0, record: item.b, constant: 0, variant: -1, kind: ValueKind};
    done: Cell = {storage: BoolStorage, container: 0, record: -1, constant: 0, variant: -1, kind: ValueKind};
    code := CellWrite(target.pointer_storage, item.a, at.cell, ops, target, at.slot, node);
    code.extend(CellWrite(target.pointer_storage, value.slot, at.cell + 1, ops, target, at.slot + 1, node));
    code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, node));
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    write: Host = {intrinsic: ReferenceWriteIntrinsic, linked: -1, first: at.cell, result_first: at.cell + 2,
                   result_count: 1, written: false};
    return Step.Emitted(code, [address, address], locals, [ReferenceCell(target), record, done], [write], roots, calls,
                        bound, next, 1, NoValue(), NoValue(), marks);
}
// The write of `self.C.f = v`: the value, in the field's storage, through the
// field reference at slot item.c over the cells from item.a. An integer
// becomes a floating field's value as stage zero converts it: exactly to a
// double, then to a float; a literal is a constant of the field's type.
ComponentWriteStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, field: TypeMember, value: Value,
                       item: Work, ops: Ops, target: Target, at: Bases, node: snapshot.SnapshotNode) -> Step {
    code: Code[] = [];
    slots: Slot[] = [];
    locals: Slot[] = [];
    cells: Cell[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    floating := field.storage == FloatStorage || field.storage == DoubleStorage;
    stored := value;
    if (Single(value, NumberStorage) && floating) {
        switch FloatConstantStep(forest, text, document, value, field.storage, ops, at, node) {
            case .Failed(diagnostic):
                return Step.Failed(diagnostic);
            case .Emitted(typed_code, typed_slots, typed_locals, typed_cells, typed_hosts, typed_roots, typed_calls,
                          typed_bound, typed_next, typed_popped, typed_value, typed_retain, typed_marks):
                code = typed_code;
                slots = typed_slots;
                stored = typed_value;
        }
    } else if (value.container == 0 && Converts(value.storage, field.storage)) {
        code = NumberCode(ops, value.storage, field.storage, value.slot, at.slot, node);
        slots = NumberSlots(value.storage, field.storage);
        stored = Typed(at.slot + length(slots) - 1, field.storage, 0, -1);
    }
    if (!SameType(field.storage, 0, -1, stored)) {
        return Fail(forest, item.node, document, "field value differs from its type");
    }
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    code.extend(ReferenceWriteCode(ops, target, item.a, item.c, stored.slot, field.storage, at.host,
                                   at.slot + length(slots), node));
    slots.append(address);
    slots.append(address);
    hosts: Host[] = [WriteHost(item.a)];
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1, NoValue(), NoValue(), marks);
}
// The bit patterns of the untyped literal at `node`: a number, or `-` on one.
NumberBits :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> FloatBits {
    if (Is(forest, node, "unary_expression")) {
        return LiteralBits(Text(forest, text, Field(forest, node, "operand")), true);
    }
    return LiteralBits(Text(forest, text, node), false);
}
// The untyped literal `literal` as a constant of the floating type `storage`.
FloatConstantStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, literal: Value, storage: int,
                      ops: Ops, at: Bases, node: snapshot.SnapshotNode) -> Step {
    locals: Slot[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    spelled := SignedLiteral(forest, text, literal.record);
    if (spelled < 0) {
        return Fail(forest, literal.record, document, "an untyped constant expression needs an integer type here");
    }
    bits: u64 = 0;
    switch NumberBits(forest, text, spelled) {
        case .OutOfRange:
            return Fail(forest, spelled, document, "Numeric literal is outside the range of its type");
        case .Finite(double_bits, float_fits, float_bits):
            if (storage == FloatStorage && !float_fits) {
                return Fail(forest, spelled, document, "Numeric literal is outside the range of number");
            }
            bits = double_bits;
            if (storage == FloatStorage) {
                bits = float_bits;
            }
    }
    code := extend(FoldedPoints(forest, text, ops, literal.record, spelled),
                   [ConstantCode(ops, storage, bits, at.slot, node)]);
    code.extend(LiteralWatch(forest, ops, at.slot, storage, spelled));
    slots: Slot[] = [ValueLocal(storage)];
    code.extend(SignCode(forest, text, ops, literal.record, storage, at.slot, node));
    slots.extend(SignSlots(forest, text, ops, literal.record, storage));
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
                        Typed(at.slot + length(slots) - 1, storage, 0, -1), NoValue(), marks);
}
// The points inside a grouped literal, which FoldStep leaves unvisited where
// no type is expected. Stage zero lowers one at a floating type, so each inner
// sign and the literal has its point; the outer sign has Body's.
FoldedPoints :: (forest: snapshot.SnapshotNode[], text: string, ops: Ops, node: int, spelled: int) -> Code[] {
    points: Code[] = [];
    signs := Signs(forest, text, node);
    if (!ops.debug || length(signs) == 0) {
        return points;
    }
    for (index in 1..<length(signs)) {
        points.append(ExpressionCode(ops, forest[signs[index]]));
    }
    points.append(ExpressionCode(ops, forest[spelled]));
    return points;
}
// Floating widening is lossless. Narrowing requires an explicit conversion.
FloatWidens :: (from: int, to: int) -> bool {
    return from == FloatStorage && to == DoubleStorage;
}
// Whether a number of type `from` converts to `to` implicitly: an integer
// widens or becomes a floating value, and f32 widens to f64. f64 becomes f32
// only through an explicit conversion.
Converts :: (from: int, to: int) -> bool {
    return Widens(from, to) || (Integer(from) && Floating(to)) || FloatWidens(from, to);
}
// The conversion of the number in slot `input` from `from` to `to`, through
// the NumberSlots from `slot`, as stage zero converts: an integer becomes a
// floating value exactly as a double first, the floating types convert to
// one another, and anything else casts.
NumberCode :: (ops: Ops, from: int, to: int, input: int, slot: int, node: snapshot.SnapshotNode) -> Code[] {
    if (Floating(from) && Floating(to)) {
        return [Instruction(ops.convert, to, slot, input, 0, 0, node)];
    }
    if (!Integer(from) || !Floating(to)) {
        return [CastCode(ops, to, slot, input, 0, node)];
    }
    exact := Instruction(ops.cast, DoubleStorage, slot, input, 0, 0, node);
    if (to == DoubleStorage) {
        return [exact];
    }
    return [exact, Instruction(ops.convert, FloatStorage, slot + 1, slot, 0, 0, node)];
}
NumberSlots :: (from: int, to: int) -> Slot[] {
    if (Integer(from) && to == FloatStorage) {
        return [ValueLocal(DoubleStorage), ValueLocal(FloatStorage)];
    }
    return [ValueLocal(to)];
}
// The index of the named result `name` of `called`, -1 when none.
NamedResult :: (params: Param[], called: Callable, name: string) -> int {
    index: int = 0;
    while (index < called.results) {
        if (params[called.first + called.count + index].name == name) {
            return index;
        }
        index += 1;
    }
    return -1;
}
// Follow declaration initializers, narrowing the visible prefix at each
// alias. A member consumes its source, so a projection is recognized once.
ResultSourceCall :: (forest: snapshot.SnapshotNode[], text: string, names: Name[], node: int) -> CallSource {
    visible := names;
    at := Unparenthesized(forest, node);
    remaining := length(names) + 1;
    while (at >= 0 && remaining > 0) {
        remaining -= 1;
        if (Is(forest, at, "call_expression")) {
            return {node: at, visible: length(visible)};
        }
        if (!Is(forest, at, "identifier")) {
            return {node: -1, visible: 0};
        }
        found := Lookup(visible, Text(forest, text, at));
        if (found < 0 || visible[found].node < 0) {
            return {node: -1, visible: 0};
        }
        declaration := forest[visible[found].node].parent;
        if (!Is(forest, declaration, "local_declaration")) {
            return {node: -1, visible: 0};
        }
        at = Unparenthesized(forest, Field(forest, declaration, "value"));
        visible = slice(visible, 0, found);
    }
    return {node: -1, visible: 0};
}
// Resolve an authored call using the names visible at its initializer.
ResultSourceCallable :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], natives: ResolvedNative[], names: Name[],
                         package: int, source: CallSource) -> int {
    if (source.node < 0) {
        return -1;
    }
    called := CalledFunction(forest, text, callables, natives, slice(names, 0, source.visible), package, source.node);
    if (called >= 0 && callables[called].results == 1) {
        return called;
    }
    return -1;
}
FindNativeCall :: (facts: NativeCallFact[], node: int) -> int {
    index := length(facts) - 1;
    while (index >= 0) {
        if (facts[index].node == node) {
            return index;
        }
        index -= 1;
    }
    return -1;
}
// Stage zero marks a component-typed value's field access as a read even
// when that value is a local copy. This does not introduce an ECS dependency.
MemberEffects :: (types: TypeDecl[], record: int) -> int {
    if (record >= 0 && types[record].component != 0) {
        return ReadEffect;
    }
    return 0;
}
// Record source effects without adding runtime instructions or changing the
// step's scheduled work.
EffectsStep :: (step: Step, effects: int) -> Step {
    if (effects == 0) {
        return step;
    }
    switch step {
        case .Failed(diagnostic):
            return Step.Failed(diagnostic);
        case .Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, popped, value, retained, marks):
            scheduled := extend([RecordEffects(effects)], next);
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, scheduled, popped, value,
                                retained, marks);
    }
}
// A resolved store through external storage contributes WRITE to preparation.
// Local boxes and copy-on-write record/array stores do not.
WriteStep :: (step: Step, node: int, writes: bool) -> Step {
    if (!writes) {
        return step;
    }
    switch step {
        case .Failed(diagnostic):
            return Step.Failed(diagnostic);
        case .Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, popped, value, retained, marks):
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound,
                                extend([RecordSemantic(node, WriteFact, 0)], next), popped, value, retained, marks);
    }
}
// Publishes named locals after all return assignments. Records are copied
// before their complete headers enter the result bank, preserving nominal
// layouts and nested owned values just as an unnamed record return does.
NamedResultsStep :: (before: Code[], ops: Ops, target: Target, params: Param[], callable: Callable, named: int,
                     at: Bases, node: snapshot.SnapshotNode) -> Step {
    code := before;
    slots: Slot[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    index: int = 0;
    while (index < callable.results) {
        result := params[callable.first + callable.count + index];
        first := at.slot + length(slots);
        if (result.storage != StructStorage) {
            slots.append(ValueLocal(result.storage));
            code.append(Instruction(ops.local, result.storage, first, named + index, 0, 0, node));
            code.append(Instruction(ops.result, result.storage, 0, first, 0, index, node));
        } else {
            cell: Cell = {storage: result.storage, container: result.container, record: result.record,
                          constant: 0, variant: -1, kind: ValueKind};
            input := at.cell + length(cells);
            cells.extend([cell, cell]);
            address := AddressSlot(target);
            slots.extend([address, address, address]);
            code.append(Instruction(ops.local, target.pointer_storage, first, named + index, 0, 0, node));
            read := Instruction(ops.load, target.pointer_storage, first + 1, first, 0, 0, node);
            read.offset = target.payload_offset;
            code.append(read);
            code.extend(CellWrite(target.pointer_storage, first + 1, input, ops, target, first + 2, node));
            host: Host = {intrinsic: SnapshotIntrinsic, linked: -1, first: input, result_first: input + 1,
                          result_count: 1, written: false};
            hosts.append(host);
            code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0,
                                    at.host + length(hosts) - 1, node));
            header := at.slot + length(slots);
            number := ValueLocal(IntStorage);
            slots.extend([address, address, number, address]);
            code.append(Instruction(ops.host_slot, target.pointer_storage, header, input + 1, 0, 0, node));
            context := Instruction(ops.context, target.pointer_storage, header + 1, 0, 0, 0, node);
            context.offset = target.results_offset;
            code.append(context);
            code.append(ConstantCode(ops, IntStorage, u64(index), header + 2, node));
            destination := Instruction(ops.index, target.pointer_storage, header + 3, header + 1, header + 2, 0,
                                       node);
            destination.offset = target.value_size;
            code.append(destination);
            offsets: int[] = [target.type_offset, target.container_offset, target.name_offset,
                              target.record_offset, target.payload_offset];
            part: int = 0;
            while (part < length(offsets)) {
                loaded := address;
                if (part < 2) {
                    loaded = number;
                }
                slots.append(loaded);
                value := at.slot + length(slots) - 1;
                load := Instruction(ops.load, loaded.storage, value, header, 0, 0, node);
                load.offset = offsets[part];
                code.append(load);
                store := Instruction(ops.write, loaded.storage, 0, value, header + 3, 0, node);
                store.offset = offsets[part];
                code.append(store);
                part += 1;
            }
        }
        index += 1;
    }
    code.append(Instruction(ops.finish, 0, 0, 0, 0, 0, node));
    return Step.Emitted(code, slots, [], cells, hosts, [], [], [], [], 0, NoValue(), NoValue(), []);
}
NamedReturnValues :: (forest: snapshot.SnapshotNode[], value: int) -> int[] {
    if (Is(forest, value, "argument_list")) {
        return Members(forest, value);
    }
    return [value];
}
// A bare return publishes the named locals. Explicit values assign them in
// order; each assignment completes before the next expression is evaluated.
NamedReturnStep :: (forest: snapshot.SnapshotNode[], document: int, before: Code[], params: Param[],
                    callable: Callable, named: int, value: int, item: Work, ops: Ops, target: Target, at: Bases,
                    node: snapshot.SnapshotNode) -> Step {
    if (value < 0) {
        return NamedResultsStep(extend(before, [CompletionCode(ops, node)]), ops, target, params, callable, named,
                                at, node);
    }
    returned := NamedReturnValues(forest, value);
    if (length(returned) != callable.results) {
        return Fail(forest, value, document, "a function with named results returns one value for each result");
    }
    for (argument in returned) {
        if (Is(forest, argument, "named_argument")) {
            return Fail(forest, value, document, "named return arguments are not supported yet");
        }
    }
    result := params[callable.first + callable.count];
    next: Work[] = [Expect(returned[0], result.storage, result.container, result.record),
                    Resume(item.node, ReturnsPhase, 0, 0)];
    return Step.Emitted(before, [], [], [], [], [], [], [], next, 0, NoValue(), NoValue(), []);
}
// Store one explicitly returned value. A record is retained before the next
// expression, so later assignments cannot change this result through an alias.
ResultsStep :: (forest: snapshot.SnapshotNode[], document: int, types: TypeDecl[], params: Param[], callable: Callable,
                named: int, values: Value[], top: int, item: Work, ops: Ops, target: Target, at: Bases,
                node: snapshot.SnapshotNode) -> Step {
    if (item.a == callable.results) {
        return NamedResultsStep([CompletionCode(ops, node)], ops, target, params, callable, named, at, node);
    }
    code: Code[] = [];
    slots: Slot[] = [];
    next: Work[] = [];
    result := params[callable.first + callable.count + item.a];
    returned := values[top - 1];
    returned_nodes := NamedReturnValues(forest, Field(forest, item.node, "value"));
    if (item.b == 0) {
        if (returned.container == 0 && Converts(returned.storage, result.storage)) {
            code.extend(NumberCode(ops, returned.storage, result.storage, returned.slot, at.slot, node));
            slots.extend(NumberSlots(returned.storage, result.storage));
            returned = Typed(at.slot + length(slots) - 1, result.storage, 0, -1);
        }
        if (!Returns(types, result.storage, result.container, result.record, returned)) {
            return Fail(forest, returned_nodes[item.a], document, "returned value differs from the result type");
        }
        if (result.storage == StructStorage) {
            next.append(Resume(item.node, ReturnsPhase, item.a, 1));
            return Step.Emitted(code, slots, [], [], [], [], [], [], next, 1, NoValue(), returned, []);
        }
    }
    code.append(SymbolCode(ops, result.node, forest[returned_nodes[item.a]]));
    if (result.storage == StructStorage) {
        header := at.slot + length(slots);
        slots.append(AddressSlot(target));
        code.append(Instruction(ops.local, target.pointer_storage, header, named + item.a, 0, 0, node));
        write := Instruction(ops.write, target.pointer_storage, 0, returned.slot, header, 0, node);
        write.offset = target.payload_offset;
        code.append(write);
    } else {
        code.append(Instruction(ops.save, result.storage, 0, returned.slot, 0, named + item.a, node));
    }
    index := item.a + 1;
    if (index < callable.results) {
        following := params[callable.first + callable.count + index];
        next.append(Expect(returned_nodes[index], following.storage, following.container, following.record));
    }
    next.append(Resume(item.node, ReturnsPhase, index, 0));
    return Step.Emitted(code, slots, [], [], [], [], [], [], next, 1, NoValue(), NoValue(), []);
}
// `step`, with `prefix` taking the slots before its own.
PrefixSlots :: (prefix: Slot[], step: Step) -> Step {
    switch step {
        case .Failed(diagnostic):
            return Step.Failed(diagnostic);
        case .Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, popped, value, retained, marks):
            return Step.Emitted(code, extend(prefix, slots), locals, cells, hosts, roots, calls, bound, next, popped,
                                value, retained, marks);
    }
}
// The number types this compiler emits.
Numeric :: (storage: int) -> bool {
    return Integer(storage) || Floating(storage);
}
// Whether a value combines through a numeric aggregate native: a number, or a
// record of numbers. Stage zero also takes records of such records, whose
// field types this compiler does not see.
NumericAggregate :: (types: TypeDecl[], members: TypeMember[], value: Value) -> bool {
    if (value.container != 0) {
        return false;
    }
    if (value.storage == NumberStorage || Numeric(value.storage)) {
        return true;
    }
    if (value.storage != StructStorage || types[value.record].count == 0) {
        return false;
    }
    at := types[value.record].first;
    while (at < types[value.record].first + types[value.record].count) {
        if (!Numeric(members[at].storage)) {
            return false;
        }
        at += 1;
    }
    return true;
}
// Whether the records types[left] and types[right] have as many fields, each
// of one named as a field of the other.
SameFields :: (types: TypeDecl[], members: TypeMember[], left: int, right: int) -> bool {
    if (types[left].count != types[right].count) {
        return false;
    }
    at := types[left].first;
    while (at < types[left].first + types[left].count) {
        if (FindField(types, members, right, members[at].name) < 0) {
            return false;
        }
        at += 1;
    }
    return true;
}
// The native that combines records for the binary `operator`: -1 for none,
// -2 for several.
FindAggregate :: (operators: NumericOperator[], operator: string) -> int {
    found: int = -1;
    for (candidate in operators) {
        if (candidate.operator == operator && found >= 0) {
            return -2;
        }
        if (candidate.operator == operator) {
            found = candidate.native;
        }
    }
    return found;
}
// `a op b` and `self.C op= b` when an operand is a record, as stage zero
// resolves it: the operator's numeric aggregate native combines records of
// numbers, and a record with a number, field by field. The result has the
// type of the first record operand; an untyped literal is a double.
AggregateStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, types: TypeDecl[],
                  members: TypeMember[], operators: NumericOperator[], natives: ResolvedNative[], values: Value[], top: int, item: Work,
                  ops: Ops, target: Target, at: Bases) -> Step {
    node := forest[item.node];
    locals: Slot[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    operator := Text(forest, text, Field(forest, item.node, "operator"));
    if (node.kind == "assignment") {
        operator = CompoundOperator(operator);
    }
    native := FindAggregate(operators, operator);
    if (native == -2) {
        return Fail(forest, item.node, document, "Ambiguous operator overload");
    }
    if (native >= 0 && (native >= length(natives) || !natives[native].direct || natives[native].intrinsic != 0)) {
        return Fail(forest, item.node, document, "native binding cannot be called directly as data");
    }
    left := values[top - 2];
    right := values[top - 1];
    records := Single(left, StructStorage) && Single(right, StructStorage);
    if (native < 0 || !NumericAggregate(types, members, left) || !NumericAggregate(types, members, right) ||
        (records && !SameFields(types, members, left.record, right.record))) {
        return Fail(forest, item.node, document, "operator does not apply to these operands");
    }
    result := right;
    if (Single(left, StructStorage)) {
        result = left;
    }
    // An untyped operand is a double constant first.
    code: Code[] = [];
    slots: Slot[] = [];
    operands: Value[] = [];
    pair: Value[] = [left, right];
    for (operand in pair) {
        value := operand;
        if (value.storage == NumberStorage) {
            shifted: Bases = {pc: at.pc, slot: at.slot + length(slots), local: at.local, cell: at.cell,
                              host: at.host, call: at.call};
            switch FloatConstantStep(forest, text, document, value, DoubleStorage, ops, shifted, node) {
                case .Failed(diagnostic):
                    return Step.Failed(diagnostic);
                case .Emitted(typed_code, typed_slots, typed_locals, typed_cells, typed_hosts, typed_roots,
                              typed_calls, typed_bound, typed_next, typed_popped, typed_value, typed_retain,
                              typed_marks):
                    code.extend(typed_code);
                    slots.extend(typed_slots);
                    value = typed_value;
            }
        }
        operands.append(value);
    }
    combined: Cell = {storage: StructStorage, container: 0, record: result.record, constant: 0, variant: -1,
                      kind: ValueKind};
    host: Host = {intrinsic: 0, linked: native, first: at.cell, result_first: at.cell + 2, result_count: 1,
                  written: false};
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    code.extend(CallCode(operands, at.cell, at.host, target.pointer_storage, at.slot + length(slots), ops,
                         target, node));
    slots.extend(CallSlots(2, address, target));
    made := at.slot + length(slots) - 1;
    root: Root = {slot: made, storage: StructStorage, container: 0, record: result.record};
    roots.append(root);
    return CellSchemaStep(Step.Emitted(code, slots, locals, CallCells(operands, combined), [host], roots, calls, bound, next, 2,
                                       Typed(made, StructStorage, 0, result.record), NoValue(), marks), at.cell + 2, ops, target, at, node);
}
// A native char pointer is read through its reflected field adapter.
NativeTextReadStep :: (object: Value, field: TypeMember, ops: Ops, target: Target, at: Bases,
                       node: snapshot.SnapshotNode) -> Step {
    first := at.cell;
    facts: u64[] = [0, 0, 0, 0xFFFFFFFFFFFFFFFF, 0, 0, 0, 0, 0];
    cells := ReferenceCells(target, object.record, facts, field);
    cells.extend([ReferenceCell(target), TypedCell(TextStorage, 0, -1),
                  TypedCell(StructStorage, 0, object.record)]);
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    slots: Slot[] = [address, address, address, address];
    code := CellWrite(target.pointer_storage, object.slot, first + 20, ops, target, at.slot, node);
    code.append(Instruction(ops.context, target.pointer_storage, at.slot, 0, 0, 1, node));
    code.extend(CellWrite(target.pointer_storage, at.slot, first, ops, target, at.slot + 1, node));
    code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot + 2, first + 20, 0, 0, node));
    code.extend(CellWrite(target.pointer_storage, at.slot + 2, first + 4, ops, target, at.slot + 3, node));
    hosts := FieldReferenceHosts(first);
    code.extend(ReferenceCode(ops, target, first, first + 14, at.host, at.slot + 4, node));
    slots.extend(FieldReferenceSlots(target));
    hosts.append(ReadThroughHost(first + 18));
    code.extend(ReadThroughCode(ops, target, TextStorage, 0, at.slot + 8, first + 18, at.host + 2,
                                at.slot + 9, node));
    slots.extend(ReadThroughSlots(TextStorage, 0, target));
    return Step.Emitted(code, slots, [], cells, hosts, [], [], [], [], 1,
                        Typed(at.slot + 11, TextStorage, 0, -1), NoValue(), []);
}
// `v.f`, where natives[f.read] reads the field: a call of it on `v`.
NativeReadStep :: (forest: snapshot.SnapshotNode[], document: int, site: int, types: TypeDecl[], natives: ResolvedNative[],
                   ports: ResolvedPort[], object: Value, field: TypeMember, ops: Ops, target: Target, at: Bases) -> Step {
    node := forest[site];
    called := natives[field.read];
    if (!called.direct) {
        return Fail(forest, site, document, "native binding cannot be called directly as data");
    }
    if (!Supported(ports, called) || called.parameters != 1 || called.results != 1) {
        return Fail(forest, site, document, "field getter's native is not supported yet");
    }
    input := ports[called.first];
    argument := NativePortType(input);
    inferred := NoValue();
    if (input.storage == AnyPort) {
        argument = object;
    } else if (input.storage == 0) {
        if (object.storage <= 0 || object.container != input.container) {
            return Fail(forest, site, document, "field getter's value differs from its parameter type");
        }
        inferred = Typed(-1, object.storage, 0, object.record);
        argument = object;
    }
    // The catalog reads this type's field with the getter, so a value of a
    // nominal type passes to a parameter of its plain storage.
    bare := argument.record < 0 && argument.storage == object.storage && argument.container == object.container;
    if (!bare && !NativeTakes(types, argument, object)) {
        return Fail(forest, site, document, "field getter's value differs from its parameter type");
    }
    argument.slot = object.slot;
    output := ports[called.first + called.parameters];
    result := NativePortType(output);
    if (output.storage == 0) {
        // An inferred result takes an inferred parameter's type, else the
        // type the catalog declares for the field.
        result = Typed(-1, field.storage, 0, field.record);
        if (inferred.storage != 0) {
            result = Typed(-1, inferred.storage, output.container, inferred.record);
        }
    }
    field_type := Typed(-1, field.storage, 0, field.record);
    if (!NativeTakes(types, result, field_type)) {
        return Fail(forest, site, document, "field getter's result differs from its field type");
    }
    locals: Slot[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    arguments: Value[] = [argument];
    read: Cell = {storage: result.storage, container: result.container, record: result.record, constant: 0, variant: -1,
                  kind: ValueKind};
    host: Host = {intrinsic: 0, linked: field.read, first: at.cell, result_first: at.cell + 1, result_count: 1,
                  written: false};
    value: Slot = {storage: SlotStorage(field.storage, 0, target), kind: SlotKind(field.storage, 0)};
    code := CallCode(arguments, at.cell, at.host, value.storage, at.slot, ops, target, node);
    if (Pointer(field.storage, 0)) {
        root: Root = {slot: at.slot + 2, storage: field.storage, container: 0, record: field.record};
        roots.append(root);
    }
    return CellSchemaStep(Step.Emitted(code, CallSlots(1, value, target), locals, CallCells(arguments, read), [host], roots, calls,
                                       bound, next, 1, Typed(at.slot + 2, field.storage, 0, field.record), NoValue(), marks),
                          at.cell + 1, ops, target, at, node);
}
// The type a fixed native port declares, including its catalog identity.
NativePortType :: (port: ResolvedPort) -> Value {
    return Typed(-1, port.storage, port.container, port.record);
}
// Native aliases pass the same underlying value. Distinct nominal types
// sharing a storage code do not become compatible.
NativeTakes :: (types: TypeDecl[], expected: Value, value: Value) -> bool {
    if (expected.storage != value.storage || expected.container != value.container) {
        return false;
    }
    if ((expected.record >= length(types)) || (value.record >= length(types))) {
        return false;
    }
    if (expected.record >= 0 && types[expected.record].kind == NativeDecl &&
        !CatalogRecordValid(types, expected.record)) {
        return false;
    }
    if (value.record >= 0 && types[value.record].kind == NativeDecl &&
        !CatalogRecordValid(types, value.record)) {
        return false;
    }
    if (expected.record == value.record) {
        return expected.record < 0 || Canonical(types, expected.record) >= 0;
    }
    if (expected.record < 0 || value.record < 0) {
        return false;
    }
    canonical := Canonical(types, expected.record);
    return canonical >= 0 && canonical == Canonical(types, value.record);
}
// Whether `value` returns as a result of the given type: one of the same
// type, or a record of a type that stands for the same one, as stage zero
// takes `return self.Transform + v` for a CF_V2 result.
Returns :: (types: TypeDecl[], storage: int, container: int, record: int, value: Value) -> bool {
    return NativeTakes(types, Typed(value.slot, storage, container, record), value);
}
// Whether the compiler passes each of a native's ports: a result takes a
// known or inferred type, never each value's own.
Supported :: (ports: ResolvedPort[], called: ResolvedNative) -> bool {
    if (!called.direct || called.intrinsic != 0) {
        return false;
    }
    port := called.first;
    while (port < called.first + called.parameters + called.results) {
        if (ports[port].storage == UnsupportedPort ||
            (port >= called.first + called.parameters && ports[port].storage == AnyPort)) {
            return false;
        }
        port += 1;
    }
    return true;
}
// Only ambiguous function lookup delegates selection to argument types.
Overloaded :: (natives: ResolvedNative[], name: string) -> bool {
    return FindNativeKind(natives, name, NativeFunctionKind) == -2;
}
// The one native named `name` whose parameters each take the argument of
// `values[first, first + count)` in its position, ranked as stage zero ranks
// them: by the cost of converting typed numbers, then of typing untyped
// literals; -1 for none, -2 for several of the least cost. A number converts
// implicitly, and an untyped literal takes any number parameter, or an
// entity one when it is zero.
Overload :: (forest: snapshot.SnapshotNode[], text: string, document: int, call: int, constants: ConstDecl[],
             callables: Callable[], types: TypeDecl[], names: Name[], package: int, natives: ResolvedNative[],
             ports: ResolvedPort[], name: string, sources: int[], values: Value[], first: int) -> int {
    found: int = -1;
    best_cost: int = 2147483647;
    best_literal_cost: int = 2147483647;
    exact := ExactNativeKind(natives, name, NativeFunctionKind) >= 0;
    index: int = 0;
    while (index < length(natives)) {
        candidate := natives[index];
        if (NativeCandidate(candidate, name, NativeFunctionKind, exact)) {
            switch BindNative(forest, text, call, sources, candidate, ports) {
                case .Failed(problem, message):
                    index += 1;
                    continue;
                case .Bound(arguments, total):
                    takes := true;
                    inferred := NoValue();
                    cost: int = 0;
                    literal_cost: int = 0;
                    at: int = 0;
                    while (takes && at < length(arguments)) {
                        given := arguments[at];
                        port := ports[NativePort(candidate, given.parameter)];
                        value := values[first + at];
                        takes = port.storage != UnsupportedPort;
                        if (takes && port.storage == 0) {
                            element := Typed(-1, value.storage, 0, value.record);
                            takes = value.storage > 0 && value.container == port.container &&
                                    (inferred.storage == 0 || SameType(inferred.storage, 0, inferred.record, element));
                            inferred = element;
                        } else if (takes && port.storage == AnyPort) {
                            takes = value.storage > 0;
                        } else if (takes && value.storage == NumberStorage) {
                            takes = port.container == 0 && (Numeric(port.storage) || port.storage == HandleStorage);
                            if (takes && port.storage == HandleStorage) {
                                takes = NativeOwnerZero(forest, text, document, constants, callables, names,
                                                        package, given.node);
                            }
                            literal_cost += LiteralCost(forest, text, value.record, port.storage);
                        } else if (takes && Converted(value, port)) {
                            cost += TypedCost(value.storage, port.storage);
                        } else if (takes) {
                            takes = NativeTakes(types, NativePortType(port), value);
                        }
                        at += 1;
                    }
                    if (takes && (cost < best_cost ||
                                  (cost == best_cost && literal_cost <= best_literal_cost))) {
                        if (cost == best_cost && literal_cost == best_literal_cost) {
                            found = -2;
                        } else {
                            found = index;
                            best_cost = cost;
                            best_literal_cost = literal_cost;
                        }
                    }
            }
        }
        index += 1;
    }
    return found;
}
// Whether the typed number `value` converts implicitly to another type of
// the native parameter `port`.
Converted :: (value: Value, port: ResolvedPort) -> bool {
    return value.container == 0 && port.container == 0 && value.storage != port.storage && Numeric(value.storage) &&
           Converts(value.storage, port.storage);
}
// What converting a typed number of type `from` costs an overload whose
// parameter has type `to`, as stage zero ranks them: 64-bit integers prefer
// f64 and other numbers prefer number.
TypedCost :: (from: int, to: int) -> int {
    preferred := FloatStorage;
    if (from == Int64Storage || from == WordStorage) {
        preferred = DoubleStorage;
    }
    if (to == preferred) {
        return 1;
    }
    return 2;
}
// What the untyped literal `node` costs an overload whose parameter has type
// `storage`, as stage zero ranks them: nothing at its spelled type, at number
// or at a type that is no number, and one at another number.
LiteralCost :: (forest: snapshot.SnapshotNode[], text: string, node: int, storage: int) -> int {
    if ((!Integer(storage) && !Floating(storage)) || storage == FloatStorage ||
        storage == InferredNumberStorage(forest, text, SignedLiteral(forest, text, node))) {
        return 0;
    }
    return 1;
}
// The record make of natives[native], -1 for none.
FindMake :: (makes: NativeMake[], native: int) -> int {
    index: int = 0;
    while (index < length(makes)) {
        if (makes[index].native == native) {
            return index;
        }
        index += 1;
    }
    return -1;
}
// A native that makes a record of its arguments, such as `vec2(x, y)`, as
// stage zero lowers it: a struct literal of the fields they give, in order.
MakeStep :: (forest: snapshot.SnapshotNode[], document: int, types: TypeDecl[], members: TypeMember[], make: NativeMake,
             make_fields: int[], values: Value[], first: int, count: int, call: int, ops: Ops, target: Target,
             at: Bases, node: snapshot.SnapshotNode) -> Step {
    locals: Slot[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    code: Code[] = [];
    slots: Slot[] = [];
    record := make.record;
    if (record < 0) {
        return Fail(forest, call, document, "the native makes a record this compiler does not see");
    }
    header: Cell = {storage: StructStorage, container: 0, record: record, constant: 0, variant: -1, kind: ValueKind};
    cells: Cell[] = [header];
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    index: int = 0;
    while (index < count) {
        position := make_fields[make.first + index];
        if (position < 0) {
            return Fail(forest, call, document, "a native's argument gives no field of its record");
        }
        field := members[types[record].first + position];
        value := values[first + index];
        if (field.container != 0 || value.container != 0) {
            return Fail(forest, call, document, "native record makers do not support array fields yet");
        }
        if (value.container == 0 && Converts(value.storage, field.storage)) {
            code.extend(NumberCode(ops, value.storage, field.storage, value.slot, at.slot + length(slots),
                                   node));
            slots.extend(NumberSlots(value.storage, field.storage));
            value = Typed(at.slot + length(slots) - 1, field.storage, 0, -1);
        }
        if (!NativeTakes(types, Typed(-1, field.storage, field.container, field.record), value)) {
            return Fail(forest, call, document, "argument differs from its parameter type");
        }
        offset: Cell = {storage: WordStorage, container: 0, record: -1, constant: u64(field.offset), variant: -1,
                        kind: ValueKind};
        content: Cell = {storage: value.storage, container: value.container, record: value.record,
                         constant: 0, variant: -1, kind: ValueKind};
        cells.extend([offset, content]);
        slots.append(address);
        code.extend(ValueWriteCode(value, at.cell + length(cells) - 1, ops, target, at.slot + length(slots) - 1, node));
        index += 1;
    }
    cells.append(header);
    host: Host = {intrinsic: ConstructIntrinsic, linked: -1, first: at.cell, result_first: at.cell + length(cells) - 1,
                  result_count: 1, written: false};
    code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, node));
    code.extend(CellRead(target.pointer_storage, at.cell + length(cells) - 1, ops, target,
                         at.slot + length(slots), node));
    slots.extend([address, address]);
    made := at.slot + length(slots) - 1;
    roots: Root[] = [{slot: made, storage: StructStorage, container: 0, record: record}];
    next.append(RecordNativeCall(call, make.native, Typed(made, StructStorage, 0, record)));
    return CellSchemaStep(Step.Emitted(code, slots, locals, cells, [host], roots, calls, bound, next, count,
                                       Typed(made, StructStorage, 0, record), NoValue(), marks),
                          at.cell + length(cells) - 1, ops, target, at, node);
}
// The cells of a native call: one for each argument, then its result.
CallCells :: (arguments: Value[], result: Cell) -> Cell[] {
    cells: Cell[] = [];
    for (argument in arguments) {
        cell: Cell = {storage: argument.storage, container: argument.container, record: argument.record, constant: 0,
                      variant: -1, kind: ValueKind};
        cells.append(cell);
    }
    return append(cells, result);
}
// Each argument into its cell from `first`, the call as host `host`, and its
// result, of slot storage `storage`, from the cell after them, through the
// CallSlots from `slot`.
CallCode :: (arguments: Value[], first: int, host: int, storage: int, slot: int, ops: Ops, target: Target,
             node: snapshot.SnapshotNode) -> Code[] {
    code: Code[] = [];
    index: int = 0;
    for (argument in arguments) {
        code.extend(ValueWriteCode(argument, first + index, ops, target, slot + index, node));
        index += 1;
    }
    code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, host, node));
    return extend(code, CellRead(storage, first + index, ops, target, slot + index, node));
}
// An address for each of `count` arguments and the result's, then the result.
CallSlots :: (count: int, result: Slot, target: Target) -> Slot[] {
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    slots: Slot[] = [];
    index: int = 0;
    while (index <= count) {
        slots.append(address);
        index += 1;
    }
    return append(slots, result);
}
// A record or array parameter the body writes, item.a: phase 0 reads it and
// copies it into a fresh cell; phase 1 binds its name to that cell.
ParameterStep :: (params: Param[], callable: Callable, item: Work, ops: Ops, target: Target, at: Bases,
                  node: snapshot.SnapshotNode) -> Step {
    code: Code[] = [];
    slots: Slot[] = [];
    locals: Slot[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    param := params[callable.first + item.a];
    if (item.b == 1) {
        return BoxParameterStep(param, item.a, ops, target, at, node);
    }
    if (item.phase == 1) {
        binding: Name = {name: param.name, place: CellPlace, index: at.cell - 1, storage: param.storage,
                         container: param.container, record: param.record, writable: true, node: param.node};
        bound.append(binding);
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 1, NoValue(), NoValue(),
                            marks);
    }
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    slots.append(address);
    read := Instruction(ops.array, target.pointer_storage, at.slot, item.a, 0, ops.argument, node);
    read.value_storage = param.storage;
    read.value_container = param.container;
    read.value_record = param.record;
    code.append(read);
    root: Root = {slot: at.slot, storage: param.storage, container: param.container, record: param.record};
    roots.append(root);
    next.append(Resume(item.node, 1, item.a, 0));
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, NoValue(),
                        Typed(at.slot, param.storage, param.container, param.record), marks);
}
// A match on the union in local `subject`, or, when `subject` is -1, in slot
// `from`, which it first saves to a new local. When the union holds variant
// types[variant], the names in `bindings` take its payload fields in order.
// A switch arm (`arm`) jumps past itself when the test fails, through the jump
// the mark reports, and watches the subject at `subject_node` it reads and
// the test of the pattern at `pattern_node`; an `is` expression produces the
// test, negated when `negated`. Bindings are not writable, so record and array payloads are read
// in place.
MatchStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, types: TypeDecl[],
              members: TypeMember[], names: Name[], scope: int, subject: int, from: int, variant: int,
              bindings: int, arm: bool, negated: bool, subject_node: int, pattern_node: int, ops: Ops,
              target: Target, at: Bases, node: snapshot.SnapshotNode) -> Step {
    code: Code[] = [];
    slots: Slot[] = [];
    locals: Slot[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    sum_type := types[variant].parent;
    value: Slot = {storage: UnionStorage, kind: ValueKind};
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    flag: Slot = {storage: BoolStorage, kind: ValueKind};
    source := subject;
    if (source < 0) {
        locals.append(ValueLocal(UnionStorage));
        source = at.local;
        code.append(Instruction(ops.save, UnionStorage, 0, from, 0, source, node));
    }
    slots.append(value);
    code.append(Instruction(ops.local, UnionStorage, at.slot, source, 0, 0, node));
    if (arm) {
        code.append(ScalarWatch(ops, at.slot, UnionStorage, 0, true, forest[subject_node]));
    }
    // The test takes the union and the tag and returns whether they match.
    held: Cell = {storage: UnionStorage, container: 0, record: sum_type, constant: 0, variant: -1, kind: ValueKind};
    tag: Cell = {storage: WordStorage, container: 0, record: -1, constant: 0, variant: variant, kind: ValueKind};
    answer: Cell = {storage: BoolStorage, container: 0, record: -1, constant: 0, variant: -1, kind: ValueKind};
    cells.append(held);
    cells.append(tag);
    cells.append(answer);
    slots.append(address);
    code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot + 1, at.cell, 0, 0, node));
    write := Instruction(ops.write, UnionStorage, 0, at.slot, at.slot + 1, 0, node);
    write.offset = target.payload_offset;
    code.append(write);
    test: Host = {intrinsic: UnionTestIntrinsic, linked: -1, first: at.cell, result_first: at.cell + 2, result_count: 1,
                  written: false};
    hosts.append(test);
    code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, node));
    slots.append(address);
    code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot + 2, at.cell + 2, 0, 0, node));
    slots.append(flag);
    read := Instruction(ops.load, BoolStorage, at.slot + 3, at.slot + 2, 0, 0, node);
    read.offset = target.payload_offset;
    code.append(read);
    if (arm) {
        code.append(ScalarWatch(ops, at.slot + 3, BoolStorage, 0, true, forest[pattern_node]));
    }
    marks: int[] = [];
    produced := Typed(at.slot + 3, BoolStorage, 0, -1);
    if (arm) {
        code.append(Instruction(ops.branch_if, 0, 0, at.slot + 3, 0, at.pc + length(code) + 2, node));
        marks.append(at.pc + length(code));
        code.append(Instruction(ops.jump, 0, 0, 0, 0, Pending, node));
        produced = NoValue();
    } else if (negated) {
        // Not is equality with false.
        slots.append(flag);
        constant := Instruction(ops.constant, BoolStorage, at.slot + 4, 0, 0, 0, node);
        constant.value_storage = BoolStorage;
        code.append(constant);
        slots.append(flag);
        code.append(Instruction(ops.eq, BoolStorage, at.slot + 5, at.slot + 3, at.slot + 4, -1, node));
        produced = Typed(at.slot + 5, BoolStorage, 0, -1);
    }
    // Each binding takes the payload field at its position.
    position: int = 0;
    binding := FirstMember(forest, bindings);
    while (binding >= 0) {
        field := members[types[variant].first + position];
        first := at.cell + length(cells);
        index: Cell = {storage: IntStorage, container: 0, record: -1, constant: u64(position), variant: -1,
                       kind: ValueKind};
        whole: Cell = {storage: BoolStorage, container: 0, record: -1, constant: 0, variant: -1, kind: ValueKind};
        payload: Cell = {storage: field.storage, container: field.container, record: field.record, constant: 0,
                         variant: -1, kind: ValueKind};
        cells.append(held);
        cells.append(tag);
        cells.append(index);
        cells.append(whole);
        cells.append(payload);
        slots.append(address);
        code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot + length(slots) - 1, first, 0, 0,
                                node));
        put := Instruction(ops.write, UnionStorage, 0, at.slot, at.slot + length(slots) - 1, 0, node);
        put.offset = target.payload_offset;
        code.append(put);
        get: Host = {intrinsic: UnionGetIntrinsic, linked: -1, first: first, result_first: first + 4, result_count: 1,
                     written: false};
        hosts.append(get);
        code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host + length(hosts) - 1,
                                node));
        name := Text(forest, text, binding);
        if (Declared(names, scope, name) || Lookup(bound, name) >= 0) {
            return Fail(forest, binding, document, format_text("Duplicate declaration '{}'", name));
        }
        code.append(SymbolCode(ops, binding, forest[binding]));
        if (Pointer(field.storage, field.container)) {
            view: Name = {name: name, place: CellPlace, index: first + 4, storage: field.storage,
                          container: field.container, record: field.record, writable: false, node: binding};
            bound.append(view);
        } else {
            slots.append(address);
            code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot + length(slots) - 1,
                                    first + 4, 0, 0, node));
            loaded: Slot = {storage: field.storage, kind: ValueKind};
            slots.append(loaded);
            take := Instruction(ops.load, field.storage, at.slot + length(slots) - 1, at.slot + length(slots) - 2, 0, 0, node);
            take.offset = target.payload_offset;
            code.append(take);
            locals.append(ValueLocal(field.storage));
            code.append(Instruction(ops.save, field.storage, 0, at.slot + length(slots) - 1, 0,
                                    at.local + length(locals) - 1, node));
            copy: Name = {name: name, place: LocalPlace, index: at.local + length(locals) - 1, storage: field.storage,
                          container: 0, record: field.record, writable: false, node: binding};
            bound.append(copy);
        }
        position += 1;
        binding = NextMember(forest, binding);
    }
    popped: int = 0;
    if (!arm) {
        popped = 1;
    }
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, popped, produced, NoValue(),
                        marks);
}

// `value is .V` and `value is not .V`. Bindings, `value is .V(a, b)`, are
// allowed only in an if or while condition, as stage zero allows them; they
// hold the payload where the test holds.
IsStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, types: TypeDecl[],
           members: TypeMember[], names: Name[], scope: int, values: Value[], top: int, item: Work, ops: Ops,
           target: Target, at: Bases) -> Step {
    held := values[top - 1];
    if (!Single(held, UnionStorage)) {
        return Fail(forest, Field(forest, item.node, "value"), document, "is needs a union value");
    }
    pattern := Field(forest, item.node, "type");
    if (!Is(forest, pattern, "variant_pattern") || Field(forest, item.node, "binding") >= 0) {
        return Fail(forest, pattern, document, "is pattern is not supported yet");
    }
    member := Text(forest, text, Field(forest, pattern, "name"));
    variant := FindVariant(types, held.record, member);
    if (variant < 0) {
        return Fail(forest, pattern, document, format_text("Unknown union variant '{}'", member));
    }
    bindings := Field(forest, pattern, "bindings");
    count: int = 0;
    binding := FirstMember(forest, bindings);
    while (binding >= 0) {
        count += 1;
        binding = NextMember(forest, binding);
    }
    if (count != 0 && count != types[variant].count) {
        return Fail(forest, pattern, document, "A union payload pattern must bind every field");
    }
    negated := Field(forest, item.node, "negated") >= 0;
    if (count != 0 && (negated || !BindingCondition(forest, text, item.node))) {
        return Fail(forest, FirstMember(forest, bindings), document,
                    "Pattern bindings require a matching if, while or switch arm");
    }
    return MatchStep(forest, text, document, types, members, names, scope, -1, held.slot, variant, bindings, false,
                     negated, -1, -1, ops, target, at, forest[item.node]);
}
