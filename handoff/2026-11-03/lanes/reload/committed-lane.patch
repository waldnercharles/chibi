+// Context failures return through every synchronous caller. Find only the
+// calls that need active owner cleanup, visiting each row and call edge once.
+FamilyFailures :: (rows: facts.Row[], heads: int[]) -> bool[] {
+    failed := resize([false], length(heads));
+    first := resize([int(0)], length(heads));
+    callers: int[] = [];
+    next: int[] = [];
+    pending: int[] = [];
+    for (function in 0..<length(heads)) {
+        for (index in heads[function] + 1..<Last(rows, heads, function)) {
+            row := rows[index];
+            if (row.kind == facts.UnwrapRow || row.kind == facts.AssertRow ||
+                (row.kind == facts.ConvertRow && row.value == facts.CheckedChar) ||
+                (row.kind == facts.ArrayRow && row.value == facts.ArrayResize)) {
+                if (!failed[function]) { failed[function] = true; pending.append(function); }
+            }
+            if (row.kind == facts.CallRow) {
+                callers.append(function);
+                next.append(first[row.value]);
+                first[row.value] = length(callers);
+            }
+        }
+    }
+    at := 0;
+    while (at < length(pending)) {
+        edge := first[pending[at]];
+        while (edge > 0) {
+            caller := callers[edge - 1];
+            if (!failed[caller]) { failed[caller] = true; pending.append(caller); }
+            edge = next[edge - 1];
+        }
+        at += 1;
+    }
+    return failed;
+}
