package package_compiler

import snapshot "project:source_snapshot"
import syntax "project:syntax_diagnostics"
import binding "project:lexical_binding"
import writer "project:prepared_writer"
import strings "core:strings"

// A query description and its rows have one runtime representation. Their
// nominal declaration keeps row fields typed without inventing a record ABI.
QueryStorage: int : 20;
QueryDecl: int : 7;
RelationshipDecl: int : 8;
OptionalComponentDecl: int : 9;
QueryDescriptorDecl: int : 10;
QueryFieldPlace: int : 11;
QueryVariablePlace: int : 12;
QuerySnapshotPlace: int : 13;
QuerySnapshotHeaderPlace: int : 14;
QueryMakeIntrinsic: int : 80;
QueryBeginIntrinsic: int : 81;
QueryNextIntrinsic: int : 82;
QueryEndIntrinsic: int : 83;
QueryGetIntrinsic: int : 84;
ComponentPointerIntrinsic: int : 85;
QueryCurrentIntrinsic: int : 86;
QueryTestIntrinsic: int : 87;
ComponentSnapshotIntrinsic: int : 88;
QueryMakePhase: int : 60;
QueryBindPhase: int : 61;
QueryGuardPhase: int : 62;
QueryFinishPhase: int : 63;
QueryReturnPhase: int : 64;
QueryIteratorPhase: int : 65;
QueryIteratorEndPhase: int : 66;
QueryProviderPhase: int : 69;
QueryMembershipPhase: int : 70;

QueryField :: struct {
    name: string;
    node: int;
    storage: int;
    container: int;
    record: int;
    component: int;
    variable: int;
    source: int;
    source_relationship: u64;
    source_traversal: int;
    optional: bool;
}
QueryTerm :: struct {
    kind: int;
    required: bool;
    node: int;
    left: int;
    right: int;
    root: bool;
    component: u64;
    source_variable: int;
    target_variable: int;
    source_relationship: u64;
    source_traversal: int;
}
QueryProvider :: struct {
    variable: int;
    relation: u64;
    traversal: int;
    valid: bool;
}
// One literal holds `relation`: storing a u64 into a local record's field
// would make every caller copy its arguments, as ConstantCode notes.
QueryProviderOf :: (variable: int, relation: u64, traversal: int, valid: bool) -> QueryProvider {
    return {variable: variable, relation: relation, traversal: traversal, valid: valid};
}
QuerySource :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], fields: QueryField[], source: int) -> QueryProvider {
    provider: QueryProvider = {variable: 0, relation: 0, traversal: 0, valid: true};
    if (source < 0 || Text(forest, text, source) == "self") {
        return provider;
    }
    name := Text(forest, text, source);
    if (Is(forest, source, "identifier")) {
        previous := QueryFieldIndex(fields, name);
        if (previous >= 0 && fields[previous].variable != 0) {
            provider.variable = fields[previous].variable;
            return provider;
        }
    } else if (Is(forest, source, "member_expression")) {
        owner := Text(forest, text, Field(forest, source, "object"));
        if (owner != "self") {
            previous := QueryFieldIndex(fields, owner);
            if (previous < 0 || fields[previous].variable == 0) {
                provider.valid = false;
                return provider;
            }
            provider.variable = fields[previous].variable;
        }
        name = Text(forest, text, Field(forest, source, "member"));
    } else if (Is(forest, source, "call_expression")) {
        function := Text(forest, text, Field(forest, source, "function"));
        if (function != "ancestor" && function != "self_or_ancestor") {
            provider.valid = false;
            return provider;
        }
        argument := FirstMember(forest, Field(forest, source, "arguments"));
        if (argument < 0 || NextMember(forest, argument) >= 0) {
            provider.valid = false;
            return provider;
        }
        name = Text(forest, text, argument);
        provider.traversal = 1;
        if (function == "self_or_ancestor") {
            provider.traversal = 2;
        }
    } else {
        provider.valid = false;
        return provider;
    }
    if (name == "ChildOf") {
        return QueryProviderOf(provider.variable, 0x84771d550890f1a1, provider.traversal, true);
    }
    relation := Relationship(types, name);
    if (relation < 0 || (types[relation].key & 1) == 0 ||
        (provider.traversal != 0 && (types[relation].key & 4) == 0)) {
        provider.valid = false;
        return provider;
    }
    return QueryProviderOf(provider.variable, types[relation].component, provider.traversal, true);
}
QuerySpec :: struct {
    node: int;
    evaluator: int;
    row: int;
    description: int;
    variables: int;
    first_capture: int;
    capture_count: int;
}
QueryDeclarations :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Collected(types: TypeDecl[], members: TypeMember[], callables: Callable[], params: Param[], queries: QuerySpec[])
}
QueryDispatch :: union {
    Handled(step: Step) | Ordinary
}
// Query evaluation is one expression-emission seam. Keeping it here also
// keeps ordinary body dispatch within the verifier's definition budget.
QueryStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, types: TypeDecl[], members: TypeMember[],
              params: Param[], queries: QuerySpec[], evaluating: int, names: Name[], values: Value[], top: int,
              item: Work, ops: Ops, target: Target, at: Bases) -> QueryDispatch {
    node := forest[item.node];
    kind := node.kind;
    if (evaluating >= 0 && (item.node == queries[evaluating].node || kind == "query_binding" ||
                            kind == "query_guard" || kind == "query_generator" || kind == "parameter" ||
                            item.phase == QueryReturnPhase)) {
        return QueryDispatch.Handled(QueryEvaluateStep(forest, text, document, types, queries, queries[evaluating],
                                                       members, names, values, top, item, ops, target, at));
    }
    if (kind == "query_expression") {
        return QueryDispatch.Handled(QueryExpressionStep(forest, document, params, queries, values, top, item, ops, target, at));
    }
    if (!item.capture && evaluating >= 0 && (item.phase == QueryMembershipPhase ||
                                             ((kind == "identifier" || kind == "member_expression" ||
                                               (kind == "call_expression" && Text(forest, text, Field(forest, item.node, "function")) == "has")) &&
                                              QueryBooleanPosition(forest, text, item.node)))) {
        term := QueryMembership(forest, text, types, members, params, queries[evaluating], item.node);
        if (term.kind >= 0) {
            return QueryDispatch.Handled(QueryMembershipStep(term, values, top, item, ops, target, at, node));
        }
    }
    if (!item.capture && kind == "member_expression" &&
        (item.phase == QueryPresencePhase || QueryPresence(forest, text, types, names, item.node) >= 0)) {
        component := item.a;
        if (item.phase == 0) {
            component = QueryPresence(forest, text, types, names, item.node);
        }
        return QueryDispatch.Handled(QueryPresenceStep(forest, types, component, values, top, item, ops, target, at));
    }
    if (kind == "call_expression" && Text(forest, text, Field(forest, item.node, "function")) == "changed") {
        return QueryDispatch.Handled(QueryChangedStep(forest, text, document, types, members, params, queries, item, ops, target, at));
    }
    return QueryDispatch.Ordinary;
}

// Query-only field metadata uses the existing flattened type-member bank:
// read is its syntax node, offset its source variable, c_string its optional
// flag. Query rows never interpret these as physical record offsets/getters.
QueryFields :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], members: TypeMember[],
                described: QuerySpec) -> QueryField[] {
    fields: QueryField[] = [];
    declared := types[described.row];
    index: int = 0;
    variables: int = 0;
    while (index < declared.count) {
        member := members[declared.first + index];
        component: int = -1;
        variable: int = 0;
        provider: QueryProvider = {variable: member.offset, relation: 0, traversal: 0, valid: true};
        if (Is(forest, member.read, "query_generator")) {
            variables += 1;
            variable = variables;
        } else if (Is(forest, member.read, "parameter")) {
            provider = QuerySource(forest, text, types, fields, Field(forest, member.read, "source"));
            component = member.record;
            if (member.storage == PointerStorage) {
                component = PointerElement(types, Typed(-1, PointerStorage, 0, member.record)).record;
            }
            if (component >= 0 && types[component].kind == OptionalComponentDecl) {
                component = types[component].parent;
            }
        }
        field: QueryField = {name: member.name, node: member.read, storage: member.storage, container: member.container,
                             record: member.record, component: component, variable: variable, source: member.offset,
                             source_relationship: provider.relation, source_traversal: provider.traversal,
                             optional: member.c_string};
        fields.append(field);
        index += 1;
    }
    return fields;
}
QueryLeaf :: (kind: int, component: u64, source: int, target: int, relation: u64,
              traversal: int, node: int) -> QueryTerm {
    return {kind: kind, required: false, node: node, left: -1, right: -1, root: false, component: component,
            source_variable: source, target_variable: target, source_relationship: relation, source_traversal: traversal};
}
QueryGuardTerms :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], fields: QueryField[],
                    captured: string[], node: int) -> QueryTerm[] {
    expression := Unparenthesized(forest, node);
    kind := forest[expression].kind;
    operator := Text(forest, text, Field(forest, expression, "operator"));
    if (kind == "call_expression") {
        function := Text(forest, text, Field(forest, expression, "function"));
        if (function == "has" || function == "all" || function == "any" || function == "not") {
            arguments := Members(forest, Field(forest, expression, "arguments"));
            if ((function == "has" || function == "not") && length(arguments) != 1) {
                return [QueryLeaf(6, 0, 0, 0, 0, 0, expression)];
            }
            terms: QueryTerm[] = [];
            for (argument in arguments) {
                added := QueryGuardTerms(forest, text, types, fields, captured, argument);
                previous := length(terms) - 1;
                offset := length(terms);
                for (original in added) {
                    moved := original;
                    if (moved.left >= 0) {
                        moved.left += offset;
                    }
                    if (moved.right >= 0) {
                        moved.right += offset;
                    }
                    terms.append(moved);
                }
                if (previous >= 0) {
                    group := QueryLeaf(1, 0, 0, 0, 0, 0, expression);
                    if (function == "any") {
                        group.kind = 2;
                    }
                    group.left = previous;
                    group.right = length(terms) - 1;
                    terms.append(group);
                }
            }
            if (function == "has" && length(terms) == 1) {
                leaf := terms[0];
                leaf.node = expression;
                return [leaf];
            }
            if (function == "not" || length(terms) == 0) {
                group := QueryLeaf(1, 0, 0, 0, 0, 0, expression);
                if (function == "not") {
                    group.kind = 3;
                    group.left = length(terms) - 1;
                }
                if (function == "any") {
                    group.kind = 2;
                }
                terms.append(group);
            }
            return terms;
        }
    }
    if ((kind == "unary_expression" && (operator == "!" || operator == "not")) ||
        (kind == "binary_expression" && (operator == "&&" || operator == "and" || operator == "||" || operator == "or"))) {
        child := Field(forest, expression, "left");
        if (kind == "unary_expression") {
            child = Field(forest, expression, "operand");
        }
        terms := QueryGuardTerms(forest, text, types, fields, captured, child);
        group := QueryLeaf(3, 0, 0, 0, 0, 0, expression);
        group.left = length(terms) - 1;
        if (kind == "binary_expression") {
            group.kind = 1;
            if (operator == "||" || operator == "or") {
                group.kind = 2;
            }
            right := QueryGuardTerms(forest, text, types, fields, captured, Field(forest, expression, "right"));
            offset := length(terms);
            for (original in right) {
                moved := original;
                if (moved.left >= 0) {
                    moved.left += offset;
                }
                if (moved.right >= 0) {
                    moved.right += offset;
                }
                terms.append(moved);
            }
            group.right = length(terms) - 1;
        }
        terms.append(group);
        return terms;
    }
    changed := kind == "call_expression" && Text(forest, text, Field(forest, expression, "function")) == "changed";
    tested := expression;
    if (changed) {
        tested = FirstMember(forest, Field(forest, expression, "arguments"));
    }
    component: int = -1;
    relation: int = -1;
    provider: QueryProvider = {variable: 0, relation: 0, traversal: 0, valid: true};
    if (Is(forest, tested, "identifier")) {
        name := Text(forest, text, tested);
        field := QueryFieldIndex(fields, name);
        if (field >= 0) {
            component = fields[field].component;
            provider = QueryProviderOf(fields[field].source, fields[field].source_relationship,
                                       fields[field].source_traversal, true);
        } else if (!Holds(captured, name)) {
            component = Component(types, name);
        }
    } else if (Is(forest, tested, "member_expression")) {
        name := Text(forest, text, Field(forest, tested, "member"));
        component = Component(types, name);
        relation = Relationship(types, name);
        object := Field(forest, tested, "object");
        provider = QuerySource(forest, text, types, fields, object);
        if (Is(forest, object, "identifier") && Holds(captured, Text(forest, text, object))) {
            provider.valid = false;
        }
    }
    if (provider.valid && component >= 0) {
        leaf_kind: int = 0;
        if (changed) {
            leaf_kind = 7;
        }
        return [QueryLeaf(leaf_kind, types[component].component, provider.variable, 0,
                          provider.relation, provider.traversal, expression)];
    }
    if (provider.valid && relation >= 0 && !changed && provider.relation == 0) {
        return [QueryLeaf(4, types[relation].component, provider.variable, 0, 0, 0, expression)];
    }
    return [QueryLeaf(6, 0, 0, 0, 0, 0, expression)];
}
QueryTerms :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], members: TypeMember[],
               params: Param[], described: QuerySpec) -> QueryTerm[] {
    terms: QueryTerm[] = [];
    captured: string[] = [];
    capture := described.first_capture;
    while (capture < described.first_capture + described.capture_count) {
        captured.append(params[capture].name);
        capture += 1;
    }
    fields := QueryFields(forest, text, types, members, described);
    prior: QueryField[] = [];
    for (clause in Members(forest, Field(forest, described.node, "parameters"))) {
        if (Is(forest, clause, "query_guard")) {
            guards := QueryGuardTerms(forest, text, types, prior, captured, Field(forest, clause, "condition"));
            offset := length(terms);
            index: int = 0;
            for (original in guards) {
                moved := original;
                if (moved.left >= 0) {
                    moved.left += offset;
                }
                if (moved.right >= 0) {
                    moved.right += offset;
                }
                moved.root = index == length(guards) - 1;
                terms.append(moved);
                index += 1;
            }
            continue;
        }
        field := fields[length(prior)];
        prior.append(field);
        if (field.variable != 0) {
            source := Field(forest, field.node, "source");
            relation := Relationship(types, Text(forest, text, Field(forest, source, "member")));
            term := QueryLeaf(5, types[relation].component, field.source, field.variable, 0, 0, field.node);
            term.root = true;
            terms.append(term);
        } else if (field.component >= 0 && !field.optional) {
            term := QueryLeaf(0, types[field.component].component, field.source, 0, field.source_relationship,
                              field.source_traversal, field.node);
            term.root = true;
            term.required = true;
            terms.append(term);
        } else if (Is(forest, field.node, "query_binding")) {
            // Computation stays in the ordered evaluator; this marker keeps
            // later membership tests from being hoisted ahead of it.
            term := QueryLeaf(6, 0, 0, 0, 0, 0, field.node);
            term.root = true;
            terms.append(term);
        }
    }
    return terms;
}
QueryPointers :: (types: TypeDecl[], members: TypeMember[]) -> TypeDecl[] {
    declared := types;
    for (native in types) {
        if (native.kind != NativeDecl || native.component == 0) {
            continue;
        }
        index := native.first;
        while (index < native.first + native.count) {
            field := members[index];
            EnsurePointer(&declared, {storage: field.storage, container: field.container, record: field.record}, false, 0);
            index += 1;
        }
    }
    return declared;
}
QueryRowName :: (types: TypeDecl[], fields: QueryField[], start: int) -> string {
    shape: u64 = 14695981039346656037;
    for (field in fields) {
        nominal: u64 = 0;
        layout: u64 = 0;
        component_layout: u64 = 0;
        flags: int = 0;
        if (field.optional) {
            flags = 2;
        }
        if (field.record >= 0) {
            nominal = types[field.record].id;
            layout = types[field.record].layout;
            if ((field.storage == PointerStorage && types[field.record].key != 0) ||
                types[field.record].kind == OptionalComponentDecl) {
                flags = flags | 2;
            }
            if (types[field.record].kind == QueryDecl) {
                flags = flags | 8192;
            }
            if (types[field.record].kind == QueryDescriptorDecl) {
                flags = flags | 4096;
            }
        }
        if (field.component >= 0) {
            component_layout = types[field.component].layout;
        }
        signature := format_text("{}:{}:{}:0:0:{}:{}:{}", field.storage, field.container, nominal, flags,
                                 layout, component_layout);
        shape = (shape ^ binding.ID(field.name, signature)) * 1099511628211;
    }
    return format_text("__query_row_0_{}_{}", start, shape);
}

FindQuery :: (queries: QuerySpec[], node: int) -> int {
    index: int = 0;
    while (index < length(queries)) {
        if (queries[index].node == node) {
            return index;
        }
        index += 1;
    }
    return -1;
}
QueryFieldIndex :: (fields: QueryField[], name: string) -> int {
    index: int = 0;
    while (index < length(fields)) {
        if (fields[index].name == name) {
            return index;
        }
        index += 1;
    }
    return -1;
}
Relationship :: (types: TypeDecl[], name: string) -> int {
    index: int = 0;
    while (index < length(types)) {
        if (types[index].kind == RelationshipDecl && NameMatches(types[index].name, name)) {
            return index;
        }
        index += 1;
    }
    return -1;
}
Ancestor :: (forest: snapshot.SnapshotNode[], ancestor: int, node: int) -> bool {
    at := node;
    while (at >= 0) {
        if (at == ancestor) {
            return true;
        }
        at = forest[at].parent;
    }
    return false;
}
QueryType :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], names: Name[], entity: u64,
              node: int) -> ValueType {
    if (node < 0) {
        return {storage: 0, container: 0, record: -1};
    }
    if (Text(forest, text, node) == "entity") {
        return {storage: HandleStorage, container: 0, record: TypeWithId(types, entity)};
    }
    if (Text(forest, text, node) == "s") {
        return {storage: FloatStorage, container: 0, record: -1};
    }
    if (TypePointerNode(forest, node) < 0 && HasToken(forest, node, "?")) {
        component := Component(types, Text(forest, text, Field(forest, node, "name")));
        index: int = 0;
        while (index < length(types)) {
            if (types[index].kind == OptionalComponentDecl && types[index].parent == component) {
                return {storage: StructStorage, container: 0, record: index};
            }
            index += 1;
        }
    }
    table := types;
    return ReadType(forest, text, &table, names, 0, node);
}
// Type query expressions through the ordinary body emitter. It performs no
// execution; its inferred result follows exactly the same operators, calls,
// indexing, dereferences and aggregate rules as an ordinary local initializer.
QueryValueType :: (forest: snapshot.SnapshotNode[], text: string, document: int, types: TypeDecl[], members: TypeMember[],
                   callables: Callable[], params: Param[], natives: ResolvedNative[], ports: ResolvedPort[], queries: QuerySpec[],
                   names: Name[], entity: u64, node: int, ops: Ops, target: Target) -> ValueType {
    none: ValueType = {storage: 0, container: 0, record: -1};
    if (node < 0) {
        return none;
    }
    if (Is(forest, node, "query_expression")) {
        found := FindQuery(queries, node);
        if (found >= 0) {
            return {storage: QueryStorage, container: 0, record: queries[found].description};
        }
        return none;
    }
    if (Is(forest, node, "number")) {
        return {storage: StateNumberStorage(forest, text, node), container: 0, record: -1};
    }
    expression: Callable = {name: "", package: document, document: document, node: node, first: 0, count: 0,
                            result: 0, result_container: 0, result_record: -1, results: 0, waits: false, identity: 0, owner_package: document};
    functions := append(callables, expression);
    expressions := ops;
    expressions.debug = false;
    table := types;
    switch EmitBody(forest, text, document, functions, params, &table, members, [], natives, ports, [], [], [], [], names,
                    "", SolidOffsets(text), 0, 0, length(functions) - 1, [], [], [], BodyContext.Unknown, [],
                    expressions, target, queries) {
        case .Specialize(template, call, arguments, caller_names):
            return none;
        case .Inferred(value):
            if (value.storage == NumberStorage) {
                return {storage: StateNumberStorage(forest, text, node), container: 0, record: -1};
            }
            return value;
        case .Failed(diagnostic):
            return none;
        case .Emitted(slots, locals, cells, code, calls, hosts, roots, points, watches, effects,
                      direct_write, facts):
            return none;
    }
}

// QueryScope reconstructs types, not runtime locations. Actual captures use
// the emitter's live names when the description is created.
QueryScopeName :: (forest: snapshot.SnapshotNode[], text: string, node: int, value: ValueType) -> Name {
    return {owned: false, name: Text(forest, text, node), place: LocalPlace, index: 0, storage: value.storage,
            container: value.container, record: value.record, writable: false, node: node};
}
// A positive payload pattern is visible in its matching body and in the
// right side of && after the pattern has matched. It never enters an else.
QueryPatternScope :: (forest: snapshot.SnapshotNode[], text: string, pattern: int, node: int) -> bool {
    if (Field(forest, pattern, "negated") >= 0) {
        return false;
    }
    current := pattern;
    while (forest[current].parent >= 0) {
        parent := forest[current].parent;
        if (Is(forest, parent, "parenthesized_expression")) {
            current = parent;
            continue;
        }
        if (Is(forest, parent, "binary_expression")) {
            operator := Text(forest, text, Field(forest, parent, "operator"));
            if (operator != "&&" && operator != "and") {
                return false;
            }
            if (Ancestor(forest, Field(forest, parent, "left"), current) &&
                Ancestor(forest, Field(forest, parent, "right"), node)) {
                return true;
            }
            current = parent;
            continue;
        }
        if (Field(forest, parent, "condition") != current) {
            return false;
        }
        if (Is(forest, parent, "if_statement")) {
            return Ancestor(forest, Field(forest, parent, "consequence"), node);
        }
        if (Is(forest, parent, "while_statement")) {
            return Ancestor(forest, Field(forest, parent, "body"), node);
        }
        return false;
    }
    return false;
}
QueryPatternNames :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], members: TypeMember[],
                      names: Name[], subject: ValueType, pattern: int) -> Name[] {
    if (subject.storage != UnionStorage || subject.container != 0 || subject.record < 0 ||
        !Is(forest, pattern, "variant_pattern")) {
        return names;
    }
    variant := FindVariant(types, subject.record, Text(forest, text, Field(forest, pattern, "name")));
    if (variant < 0) {
        return names;
    }
    scoped := names;
    index: int = 0;
    for (binding_node in Members(forest, Field(forest, pattern, "bindings"))) {
        if (index >= types[variant].count) {
            break;
        }
        member := members[types[variant].first + index];
        scoped.append(QueryScopeName(forest, text, binding_node,
                                     {storage: member.storage, container: member.container, record: member.record}));
        index += 1;
    }
    return scoped;
}
// The root of `node`'s source. Each source's nodes follow its root in source
// order, and offsets restart in every source, so a scan for what precedes
// `node` starts here.
QuerySourceRoot :: (forest: snapshot.SnapshotNode[], node: int) -> int {
    root := node;
    while (forest[root].parent >= 0) {
        root = forest[root].parent;
    }
    return root;
}
// Names visible at the query's creation site, in declaration order. Only
// lexical ancestors contribute, so sibling blocks, loops and arms stay out.
QueryScope :: (forest: snapshot.SnapshotNode[], text: string, document: int, types: TypeDecl[], members: TypeMember[],
               callables: Callable[], params: Param[], natives: ResolvedNative[], ports: ResolvedPort[], queries: QuerySpec[],
               globals: Name[], entity: u64, node: int, ops: Ops, target: Target) -> Name[] {
    names := globals;
    for (callable in callables) {
        if (!Ancestor(forest, Field(forest, callable.node, "body"), node)) {
            continue;
        }
        index: int = 0;
        while (index < callable.count) {
            param := params[callable.first + index];
            name: Name = {owned: false, name: param.name, place: ParameterPlace, index: index, storage: param.storage,
                          container: param.container, record: param.record, writable: false, node: param.node};
            names.append(name);
            index += 1;
        }
    }
    for (described in queries) {
        if (!Is(forest, described.node, "system") || !Ancestor(forest, Field(forest, described.node, "body"), node)) {
            continue;
        }
        for (field in QueryFields(forest, text, types, members, described)) {
            name: Name = {owned: false, name: field.name, place: QueryFieldPlace, index: 0, storage: field.storage,
                          container: field.container, record: field.record, writable: false, node: field.node};
            names.append(name);
        }
    }
    index := QuerySourceRoot(forest, node);
    while (index < length(forest) && forest[index].start < forest[node].start) {
        if (Is(forest, index, "local_declaration") && !Ancestor(forest, index, node)) {
            if (Ancestor(forest, forest[index].parent, node)) {
                value := QueryType(forest, text, types, names, entity, Field(forest, index, "type"));
                if (value.storage == 0) {
                    value = QueryValueType(forest, text, document, types, members, callables, params, natives, ports, queries, names,
                                           entity, Field(forest, index, "value"), ops, target);
                }
                names.append(QueryScopeName(forest, text, Field(forest, index, "name"), value));
            }
        } else if (Is(forest, index, "for_statement") && Ancestor(forest, Field(forest, index, "body"), node)) {
            if (Field(forest, index, "first") >= 0) {
                names.append(QueryScopeName(forest, text, Field(forest, index, "name"),
                                            {storage: IntStorage, container: 0, record: -1}));
            } else {
                iterable := QueryValueType(forest, text, document, types, members, callables, params, natives, ports, queries,
                                           names, entity, Field(forest, index, "value"), ops, target);
                if (iterable.container == MapContainer && iterable.record >= 0) {
                    map := types[iterable.record];
                    names.append(QueryScopeName(forest, text, Field(forest, index, "name"),
                                                {storage: map.value_storage, container: map.value_container, record: map.value_record}));
                    if (Field(forest, index, "key") >= 0) {
                        names.append(QueryScopeName(forest, text, Field(forest, index, "key"),
                                                    {storage: map.key, container: 0, record: -1}));
                    }
                } else if (iterable.container == ArrayContainer) {
                    names.append(QueryScopeName(forest, text, ItemField(forest, index),
                                                {storage: iterable.storage, container: 0, record: iterable.record}));
                    if (Field(forest, index, "key") >= 0) {
                        names.append(QueryScopeName(forest, text, Field(forest, index, "name"),
                                                    {storage: IntStorage, container: 0, record: -1}));
                    }
                } else if (Single(Typed(-1, iterable.storage, iterable.container, iterable.record), QueryStorage)) {
                    if (iterable.record >= 0 && types[iterable.record].kind == QueryDescriptorDecl) {
                        iterable.record = types[iterable.record].parent;
                    }
                    names.append(QueryScopeName(forest, text, Field(forest, index, "name"), iterable));
                }
            }
        } else if (Is(forest, index, "is_expression") && QueryPatternScope(forest, text, index, node)) {
            subject := QueryValueType(forest, text, document, types, members, callables, params, natives, ports, queries, names,
                                      entity, Field(forest, index, "value"), ops, target);
            names = QueryPatternNames(forest, text, types, members, names, subject, Field(forest, index, "type"));
        } else if (Is(forest, index, "switch_arm") && Ancestor(forest, Field(forest, index, "body"), node)) {
            selection := forest[index].parent;
            subject := QueryValueType(forest, text, document, types, members, callables, params, natives, ports, queries, names,
                                      entity, Field(forest, selection, "value"), ops, target);
            names = QueryPatternNames(forest, text, types, members, names, subject, Field(forest, index, "value"));
        }
        index += 1;
    }
    return names;
}

// Header evaluation may read values, but cannot change external storage or
// start work. Follow authored helper calls as well as their immediate native
// calls so moving an effect behind a helper does not evade this restriction.
QueryHelperLocal :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                     name: string, node: int) -> bool {
    owner: int = -1;
    index: int = 0;
    for (callable in callables) {
        if (Ancestor(forest, Field(forest, callable.node, "body"), node) &&
            (owner < 0 || forest[callable.node].start > forest[callables[owner].node].start)) {
            owner = index;
        }
        index += 1;
    }
    if (owner < 0) {
        return false;
    }
    callable := callables[owner];
    index = callable.first;
    while (index < callable.first + callable.count + callable.results) {
        if (params[index].name == name) {
            return true;
        }
        index += 1;
    }
    enclosing := forest[node].parent;
    while (enclosing >= 0) {
        if (Is(forest, enclosing, "query_expression")) {
            if (name == "self") {
                return true;
            }
            for (clause in Members(forest, Field(forest, enclosing, "parameters"))) {
                if (forest[clause].end <= forest[node].start &&
                    Text(forest, text, Field(forest, clause, "name")) == name) {
                    return true;
                }
            }
        }
        enclosing = forest[enclosing].parent;
    }
    index = QuerySourceRoot(forest, node);
    while (index < length(forest) && forest[index].start < forest[node].start) {
        if (Is(forest, index, "local_declaration") &&
            Ancestor(forest, Field(forest, callable.node, "body"), index) &&
            Ancestor(forest, forest[index].parent, node) && !Ancestor(forest, index, node) &&
            Text(forest, text, Field(forest, index, "name")) == name) {
            return true;
        }
        if (Is(forest, index, "for_statement") && Ancestor(forest, Field(forest, index, "body"), node) &&
            (Text(forest, text, Field(forest, index, "name")) == name ||
             Text(forest, text, Field(forest, index, "key")) == name)) {
            return true;
        }
        index += 1;
    }
    return false;
}
QueryImpure :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                natives: ResolvedNative[], names: Name[], root: int, system_header: bool) -> int {
    pending: int[] = [root];
    visited: int[] = [];
    while (length(pending) > 0) {
        node := pending[length(pending) - 1];
        pending = slice(pending, 0, length(pending) - 1);
        if (node < 0) {
            continue;
        }
        if (Is(forest, node, "type") || Is(forest, node, "argument_name")) {
            continue;
        }
        if (Is(forest, node, "identifier") && !Ancestor(forest, root, node) &&
            forest[node].field != "member" && forest[node].field != "function" && forest[node].field != "name") {
            spelling := Text(forest, text, node);
            found := Lookup(names, spelling);
            if (found >= 0 && names[found].place != AliasPlace &&
                !QueryHelperLocal(forest, text, callables, params, spelling, node)) {
                return node;
            }
        }
        if (Is(forest, node, "assignment")) {
            destination := StatementTarget(forest, node);
            base := RootOf(forest, destination);
            name := Text(forest, text, base);
            found := Lookup(names, name);
            own_local := !Ancestor(forest, root, node) && QueryHelperLocal(forest, text, callables, params, name, node);
            if (name == "self" || (found >= 0 && names[found].place == StatePlace && !own_local)) {
                return node;
            }
            for (callable in callables) {
                if (!Ancestor(forest, Field(forest, callable.node, "body"), node)) {
                    continue;
                }
                index: int = 0;
                while (index < callable.count) {
                    param := params[callable.first + index];
                    if (param.name == name && (param.reference || param.storage == PointerStorage)) {
                        return node;
                    }
                    index += 1;
                }
            }
        }
        if (Is(forest, node, "reference_argument")) {
            return node;
        }
        // Literal nested headers validate independently. A helper's nested
        // description can still hide reads, so follow its captures here.
        if (Is(forest, node, "query_expression") && Ancestor(forest, root, node)) {
            continue;
        }
        if (Is(forest, node, "call_expression")) {
            spelling := Text(forest, text, Field(forest, node, "function"));
            for (native in natives) {
                if (NameMatches(native.name, spelling) &&
                    ((native.effects & 62) != 0 || (system_header && (native.effects & 64) != 0))) {
                    return node;
                }
            }
            index: int = 0;
            for (callable in callables) {
                if (callable.name == spelling && Position(visited, index) < 0) {
                    visited.append(index);
                    pending.append(Field(forest, callable.node, "body"));
                }
                index += 1;
            }
        }
        for (child in Members(forest, node)) {
            pending.append(child);
        }
    }
    return -1;
}
QueryExcludes :: (forest: snapshot.SnapshotNode[], text: string, condition: int, membership: string, truth: bool) -> bool {
    node := Unparenthesized(forest, condition);
    if (Is(forest, node, "member_expression")) {
        return !truth && Text(forest, text, node) == membership;
    }
    if (Is(forest, node, "call_expression")) {
        function := Text(forest, text, Field(forest, node, "function"));
        arguments := Members(forest, Field(forest, node, "arguments"));
        if (function == "has" && length(arguments) == 1) {
            return QueryExcludes(forest, text, arguments[0], membership, truth);
        }
        if (function == "not" && length(arguments) == 1) {
            return QueryExcludes(forest, text, arguments[0], membership, !truth);
        }
        if (function != "all" && function != "any") {
            return false;
        }
        either := (truth && function == "all") || (!truth && function == "any");
        result := !either && length(arguments) > 0;
        for (argument in arguments) {
            excluded := QueryExcludes(forest, text, argument, membership, truth);
            if (either) {
                result = result || excluded;
            } else {
                result = result && excluded;
            }
        }
        return result;
    }
    if (Is(forest, node, "unary_expression")) {
        operator := Text(forest, text, Field(forest, node, "operator"));
        return (operator == "!" || operator == "not") &&
               QueryExcludes(forest, text, Field(forest, node, "operand"), membership, !truth);
    }
    if (!Is(forest, node, "binary_expression")) {
        return false;
    }
    operator := Text(forest, text, Field(forest, node, "operator"));
    conjunction := operator == "&&" || operator == "and";
    disjunction := operator == "||" || operator == "or";
    if (!conjunction && !disjunction) {
        return false;
    }
    left := QueryExcludes(forest, text, Field(forest, node, "left"), membership, truth);
    right := QueryExcludes(forest, text, Field(forest, node, "right"), membership, truth);
    if ((truth && conjunction) || (!truth && disjunction)) {
        return left || right;
    }
    return left && right;
}

// A description can construct another description from values bound earlier
// in its header. Collect those dependencies before inferring its row fields.
// Each declaration pass extends copies of its inputs: assigning to a
// parameter would make every caller copy its arguments.
CollectQuery :: (forest: snapshot.SnapshotNode[], text: string, identity: string, document: int, input_types: TypeDecl[],
                 input_members: TypeMember[], input_callables: Callable[], input_params: Param[], natives: ResolvedNative[],
                 ports: ResolvedPort[], input_queries: QuerySpec[], globals: Name[], enclosing: Name[], entity: u64,
                 node: int, system_header: bool, target: Target, ops: Ops) -> QueryDeclarations {
    types := input_types;
    members := input_members;
    callables := input_callables;
    params := input_params;
    queries := input_queries;
    if (FindQuery(queries, node) >= 0) {
        return QueryDeclarations.Collected(types, members, callables, params, queries);
    }
    names := QueryScope(forest, text, document, types, members, callables, params, natives, ports, queries, globals, entity, node, ops, target);
    names.extend(enclosing);
    creation_names := names;
    fields: QueryField[] = [];
    captures: int[] = [];
    variables: int = 0;
    list := Field(forest, node, "parameters");
    for (clause in Members(forest, list)) {
        expression := Field(forest, clause, "value");
        if (Is(forest, clause, "query_guard")) {
            expression = Field(forest, clause, "condition");
        }
        if (expression >= 0) {
            pending: int[] = [expression];
            while (length(pending) > 0) {
                nested := pending[length(pending) - 1];
                pending = slice(pending, 0, length(pending) - 1);
                if (Is(forest, nested, "query_expression")) {
                    scope := enclosing;
                    for (field in fields) {
                        named: Name = {owned: false, name: field.name, place: LocalPlace, index: 0,
                                       storage: field.storage, container: field.container, record: field.record,
                                       writable: false, node: Field(forest, field.node, "name")};
                        scope.append(named);
                    }
                    switch CollectQuery(forest, text, identity, document, types, members, callables, params, natives, ports,
                                        queries, globals, scope, entity, nested, system_header, target, ops) {
                        case .Failed(diagnostic):
                            return QueryDeclarations.Failed(diagnostic);
                        case .Collected(next_types, next_members, next_callables, next_params, next_queries):
                            types = next_types;
                            members = next_members;
                            callables = next_callables;
                            params = next_params;
                            queries = next_queries;
                    }
                    continue;
                }
                for (child in Members(forest, nested)) {
                    pending.append(child);
                }
            }
            impure := QueryImpure(forest, text, callables, params, natives, names, expression, system_header);
            if (impure >= 0) {
                return QueryDeclarations.Failed(Diagnose(forest, impure, document,
                                                         "Query headers require deterministic values without side effects or suspension"));
            }
        }
        if (expression >= 0) {
            pending: int[] = [expression];
            while (length(pending) > 0) {
                part := pending[length(pending) - 1];
                pending = slice(pending, 0, length(pending) - 1);
                if (Is(forest, part, "query_expression")) {
                    continue;
                }
                if (!Is(forest, node, "system") && Is(forest, part, "call_expression") &&
                    Text(forest, text, Field(forest, part, "function")) == "changed") {
                    return QueryDeclarations.Failed(Diagnose(forest, part, document,
                                                             "changed is only available in scheduled system queries"));
                }
                if (Is(forest, part, "address_expression")) {
                    operand := Unparenthesized(forest, Field(forest, part, "operand"));
                    base := RootOf(forest, operand);
                    if (Is(forest, base, "identifier")) {
                        found := Lookup(names, Text(forest, text, base));
                        if (found >= 0 && (names[found].storage != PointerStorage ||
                                           !Is(forest, operand, "member_expression")) &&
                            QueryFieldIndex(fields, names[found].name) < 0) {
                            return QueryDeclarations.Failed(Diagnose(forest, part, document,
                                                                     "Captured query values are read-only; capture an existing pointer instead"));
                        }
                    }
                }
                for (child in Members(forest, part)) {
                    pending.append(child);
                }
            }
        }
        if (Is(forest, clause, "query_guard")) {
            for (field in fields) {
                if (field.component < 0 || field.optional || field.source_relationship != 0) {
                    continue;
                }
                owner := "self";
                for (provider in fields) {
                    if (field.source != 0 && provider.variable == field.source) {
                        owner = provider.name;
                    }
                }
                membership := format_text("{}.{}", owner, types[field.component].name);
                if (QueryExcludes(forest, text, expression, membership, true)) {
                    return QueryDeclarations.Failed(Diagnose(forest, clause, document,
                                                             "A component cannot be both a parameter and excluded"));
                }
            }
            continue;
        }
        name_node := Field(forest, clause, "name");
        name := Text(forest, text, name_node);
        if (Is(forest, node, "system") && name == "dt") {
            return QueryDeclarations.Failed(Diagnose(forest, name_node, document,
                                                     "'dt' is the implicit system step and cannot be a query binding"));
        }
        if (QueryFieldIndex(fields, name) >= 0) {
            return QueryDeclarations.Failed(Diagnose(forest, name_node, document, format_text("Duplicate query binding '{}'", name)));
        }
        annotation := Field(forest, clause, "type");
        typed := QueryType(forest, text, types, names, entity, annotation);
        if (annotation >= 0 && typed.storage == 0) {
            return QueryDeclarations.Failed(Diagnose(forest, annotation, document,
                                                     format_text("Unknown query binding type '{}'", Text(forest, text, annotation))));
        }
        component: int = -1;
        variable: int = 0;
        source: int = 0;
        provider: QueryProvider = {variable: 0, relation: 0, traversal: 0, valid: true};
        if (Is(forest, clause, "query_generator")) {
            if (typed.storage != 0 && (typed.storage != HandleStorage || typed.record != TypeWithId(types, entity))) {
                return QueryDeclarations.Failed(Diagnose(forest, clause, document, "Relationship generator type must be entity"));
            }
            typed = {storage: HandleStorage, container: 0, record: TypeWithId(types, entity)};
            from := Field(forest, clause, "source");
            if (!Is(forest, from, "member_expression")) {
                return QueryDeclarations.Failed(Diagnose(forest, from, document, "Relationship generator requires entity.Relationship"));
            }
            relation := Relationship(types, Text(forest, text, Field(forest, from, "member")));
            if (relation < 0) {
                return QueryDeclarations.Failed(Diagnose(forest, from, document, "Unknown relation type"));
            }
            root_name := Text(forest, text, Field(forest, from, "object"));
            if (root_name != "self") {
                previous := QueryFieldIndex(fields, root_name);
                if (previous < 0 || fields[previous].variable == 0) {
                    return QueryDeclarations.Failed(Diagnose(forest, from, document, "Generator source must be an earlier entity binding"));
                }
                source = fields[previous].variable;
            }
            variables += 1;
            if (variables > 8) {
                return QueryDeclarations.Failed(Diagnose(forest, clause, document, "Query supports at most eight relation variables"));
            }
            variable = variables;
        } else if (Is(forest, clause, "query_binding")) {
            value := Field(forest, clause, "value");
            inferred := QueryValueType(forest, text, document, types, members, callables, params, natives, ports, queries, names, entity, value, ops, target);
            if (typed.storage == 0) {
                typed = inferred;
            }
        } else {
            pointee := typed;
            if (typed.storage == PointerStorage) {
                pointee = PointerElement(types, Typed(-1, typed.storage, 0, typed.record));
            }
            component = pointee.record;
            if (component >= 0 && types[component].kind == OptionalComponentDecl) {
                component = types[component].parent;
            }
            if (pointee.storage != StructStorage || component < 0 || types[component].component == 0) {
                return QueryDeclarations.Failed(Diagnose(forest, clause, document, "Query binding requires a component type"));
            }
            from := Field(forest, clause, "source");
            provider = QuerySource(forest, text, types, fields, from);
            if (!provider.valid) {
                return QueryDeclarations.Failed(Diagnose(forest, from, document,
                                                         "Component source requires an earlier entity binding or an exclusive relationship provider"));
            }
            source = provider.variable;
        }
        if (typed.storage == 0) {
            return QueryDeclarations.Failed(Diagnose(forest, clause, document, "Cannot infer query binding type"));
        }
        field: QueryField = {name: name, node: clause, storage: typed.storage, container: typed.container,
                             record: typed.record, component: component, variable: variable, source: source,
                             source_relationship: provider.relation, source_traversal: provider.traversal,
                             optional: Field(forest, clause, "type") >= 0 && HasToken(forest, Field(forest, clause, "type"), "?")};
        fields.append(field);
        local: Name = {owned: false, name: name, place: LocalPlace, index: length(fields) - 1, storage: typed.storage,
                       container: typed.container, record: typed.record, writable: false, node: name_node};
        names.append(local);
    }
    // Every free value is captured by value at description construction.
    // Member names, type names and function names are declarations, not reads.
    local_names: string[] = ["self"];
    captured_names: string[] = [];
    for (clause in Members(forest, list)) {
        expression := Field(forest, clause, "value");
        if (Is(forest, clause, "query_guard")) {
            expression = Field(forest, clause, "condition");
        }
        if (expression < 0) {
            expression = Field(forest, clause, "source");
        }
        pending: int[] = [];
        if (expression >= 0) {
            pending.append(expression);
        }
        while (length(pending) > 0) {
            item := pending[length(pending) - 1];
            pending = slice(pending, 0, length(pending) - 1);
            if (Is(forest, item, "type") || Is(forest, item, "argument_name")) {
                continue;
            }
            if (Is(forest, item, "query_expression")) {
                nested := FindQuery(queries, item);
                index: int = 0;
                while (nested >= 0 && index < queries[nested].capture_count) {
                    pending.append(params[queries[nested].first_capture + index].node);
                    index += 1;
                }
                continue;
            }
            if (Is(forest, item, "identifier") && forest[item].field != "member" &&
                forest[item].field != "function" && forest[item].field != "name") {
                spelling := Text(forest, text, item);
                if (!Holds(local_names, spelling) && !Holds(captured_names, spelling)) {
                    found := Lookup(creation_names, spelling);
                    if (found >= 0 && creation_names[found].place != AliasPlace) {
                        if (system_header && Lookup(enclosing, spelling) < 0) {
                            return QueryDeclarations.Failed(Diagnose(forest, item, document,
                                                                     "System query headers cannot capture invocation values or retained state"));
                        }
                        captured_names.append(spelling);
                        captures.append(item);
                    }
                }
            }
            for (child in Members(forest, item)) {
                pending.append(child);
            }
        }
        declared_name := Field(forest, clause, "name");
        if (declared_name >= 0) {
            local_names.append(Text(forest, text, declared_name));
        }
    }
    row := length(types);
    first := length(members);
    for (field in fields) {
        member: TypeMember = {name: field.name, storage: field.storage, container: field.container, record: field.record,
                              offset: field.source, writable: false, c_string: field.optional, constant: false, read: field.node, read_key: ""};
        members.append(member);
    }
    row_name := QueryRowName(types, fields, forest[node].start);
    id := binding.ID(identity, row_name);
    declared: TypeDecl = {name: "", type_name: row_name, package: document, node: node, kind: QueryDecl,
                          first: first, count: length(fields), size: target.pointer_size, parent: -1,
                          storage: QueryStorage, id: id, layout: 0, component: 0, key: 0, value_storage: 0,
                          value_container: 0, value_record: -1, error: false};
    types.append(declared);
    // A literal again: a copy of `declared` shares its u64 id, and writing
    // into that copy would make every caller copy its arguments.
    description: TypeDecl = {name: "", type_name: row_name, package: document, node: node, kind: QueryDescriptorDecl,
                             first: first, count: length(fields), size: target.pointer_size, parent: row,
                             storage: QueryStorage, id: id, layout: 0, component: 0, key: 0, value_storage: 0,
                             value_container: 0, value_record: -1, error: false};
    descriptor := length(types);
    types.append(description);
    param_first := length(params);
    for (capture in captures) {
        found := Lookup(creation_names, Text(forest, text, capture));
        named := creation_names[found];
        param: Param = {name: named.name, storage: named.storage, container: named.container, record: named.record,
                        has_default: false, default_bits: 0, default_text: "", default_occurrence: 0,
                        reference: false, node: capture};
        params.append(param);
    }
    accepted: Param = {name: "", storage: BoolStorage, container: 0, record: -1, has_default: false,
                       default_bits: 0, default_text: "", default_occurrence: 0, reference: false, node: node};
    params.append(accepted);
    for (field in fields) {
        result: Param = {name: "", storage: field.storage, container: field.container, record: field.record,
                         has_default: false, default_bits: 0, default_text: "", default_occurrence: 0,
                         reference: false, node: field.node};
        params.append(result);
    }
    evaluator := length(callables);
    // Evaluators are numbered within their source, as each compiles alone.
    numbered: int = 0;
    for (collected in queries) {
        if (callables[collected.evaluator].document == document) {
            numbered += 1;
        }
    }
    callable: Callable = {name: format_text("__query_evaluate_{}", numbered), package: document, document: document,
                          node: node, first: param_first, count: length(captures), result: 0,
                          result_container: 0, result_record: -1, results: length(fields) + 1, waits: false, identity: 0, owner_package: document};
    callables.append(callable);
    described: QuerySpec = {node: node, evaluator: evaluator, row: row, description: descriptor, variables: variables,
                            first_capture: param_first, capture_count: length(captures)};
    queries.append(described);
    return QueryDeclarations.Collected(types, members, callables, params, queries);
}
// Collects the queries of the source whose nodes are [node_start, node_end),
// after the ones already collected.
CollectQueries :: (forest: snapshot.SnapshotNode[], text: string, identity: string, document: int, node_start: int,
                   node_end: int, input_types: TypeDecl[], input_members: TypeMember[], input_callables: Callable[],
                   input_params: Param[], natives: ResolvedNative[], ports: ResolvedPort[], input_queries: QuerySpec[],
                   globals: Name[], entity: u64, target: Target, ops: Ops) -> QueryDeclarations {
    types := input_types;
    members := input_members;
    callables := input_callables;
    params := input_params;
    queries := input_queries;
    node := node_start;
    while (node < node_end) {
        if (forest[node].is_named && (Is(forest, node, "query_expression") ||
                                      (Is(forest, node, "system") && length(Members(forest, Field(forest, node, "parameters"))) > 0))) {
            switch CollectQuery(forest, text, identity, document, types, members, callables, params, natives, ports,
                                queries, globals, [], entity, node, Is(forest, node, "system"), target, ops) {
                case .Failed(diagnostic):
                    return QueryDeclarations.Failed(diagnostic);
                case .Collected(next_types, next_members, next_callables, next_params, next_queries):
                    types = next_types;
                    members = next_members;
                    callables = next_callables;
                    params = next_params;
                    queries = next_queries;
            }
        }
        node += 1;
    }
    return QueryDeclarations.Collected(types, members, callables, params, queries);
}

// Intrinsic calls keep one typed cell per argument and result. A slot of -2
// asks for the execution context; a slot of -1 leaves the header's constant.
QueryCallStep :: (intrinsic: int, arguments: Value[], initial: Cell[], result: ValueType, popped: int,
                  ops: Ops, target: Target, at: Bases, node: snapshot.SnapshotNode) -> Step {
    cells := initial;
    output_cell: Cell = {storage: result.storage, container: result.container, record: result.record,
                         constant: 0, variant: -1, kind: ValueKind};
    cells.append(output_cell);
    code: Code[] = [];
    slots: Slot[] = [];
    index: int = 0;
    for (argument in arguments) {
        value := argument.slot;
        if (value == -2) {
            context_cell := cells[index];
            context_cell.kind = AddressKind;
            cells[index] = context_cell;
            slots.append(AddressSlot(target));
            value = at.slot + length(slots) - 1;
            code.append(Instruction(ops.context, target.pointer_storage, value, 0, 0, 1, node));
        }
        if (value >= 0) {
            stored := argument;
            stored.slot = value;
            code.extend(ValueWriteCode(stored, at.cell + index, ops, target, at.slot + length(slots), node));
            slots.append(AddressSlot(target));
        }
        index += 1;
    }
    host: Host = {owned_arguments: false, command: 0, syntax_node: 0, intrinsic: intrinsic, linked: -1, first: at.cell, result_first: at.cell + length(initial),
                  result_count: 1, written: false};
    code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, node));
    storage := SlotStorage(result.storage, result.container, target);
    code.extend(CellRead(storage, at.cell + length(initial), ops, target, at.slot + length(slots), node));
    slots.append(AddressSlot(target));
    output_slot: Slot = {storage: storage, kind: SlotKind(result.storage, result.container)};
    slots.append(output_slot);
    produced := Typed(at.slot + length(slots) - 1, result.storage, result.container, result.record);
    roots: Root[] = [];
    if (Pointer(result.storage, result.container)) {
        root: Root = {slot: produced.slot, storage: result.storage, container: result.container, record: result.record};
        roots.append(root);
    }
    return CellSchemaStep(Step.Emitted(code, slots, [], cells, [host], roots, [], [], [], popped, produced, NoValue(), []),
                          at.cell + length(initial), ops, target, at, node);
}
QueryCell :: (storage: int, record: int, bits: u64) -> Cell {
    return {storage: storage, container: 0, record: record, constant: bits, variant: -1, kind: ValueKind};
}
QueryCurrentStep :: (record: int, ops: Ops, target: Target, at: Bases, node: snapshot.SnapshotNode) -> Step {
    return QueryCallStep(QueryCurrentIntrinsic, [Typed(-2, target.pointer_storage, 0, -1)],
                         [QueryCell(target.pointer_storage, -1, 0)],
                         {storage: QueryStorage, container: 0, record: record}, 0, ops, target, at, node);
}
QueryChangedStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, types: TypeDecl[], members: TypeMember[],
                     params: Param[], queries: QuerySpec[], item: Work, ops: Ops, target: Target, at: Bases) -> Step {
    base: int = 0;
    for (described in queries) {
        terms := QueryTerms(forest, text, types, members, params, described);
        index: int = 0;
        for (term in terms) {
            if (term.node == item.node && term.kind == 7) {
                return QueryCallStep(QueryTestIntrinsic,
                                     [Typed(-2, target.pointer_storage, 0, -1), Typed(-1, IntStorage, 0, -1)],
                                     [QueryCell(target.pointer_storage, -1, 0), QueryCell(IntStorage, -1, u64(base + index))],
                                     {storage: BoolStorage, container: 0, record: -1}, 0, ops, target, at, forest[item.node]);
            }
            index += 1;
        }
        base += length(terms) + 1;
    }
    return Fail(forest, item.node, document, "changed requires a component in a scheduled system query guard");
}
QueryGetStep :: (row: Value, index: int, field: ValueType, popped: int, ops: Ops, target: Target,
                 at: Bases, node: snapshot.SnapshotNode) -> Step {
    return QueryCallStep(QueryGetIntrinsic, [row, Typed(-1, IntStorage, 0, -1)],
                         [QueryCell(QueryStorage, row.record, 0), QueryCell(IntStorage, -1, u64(index))],
                         field, popped, ops, target, at, node);
}

// Cache an immutable aggregate's payload before later guards introduce
// branches. Its original header stays in the data bank for schema publication.
QuerySnapshotHeader :: (names: Name[], name: string) -> int {
    index := length(names) - 1;
    while (index >= 0) {
        if (names[index].place == QuerySnapshotHeaderPlace && names[index].name == name) {
            return names[index].index;
        }
        index -= 1;
    }
    return -1;
}
QuerySnapshotReadStep :: (binding: Name, names: Name[], ops: Ops, target: Target, at: Bases,
                          node: snapshot.SnapshotNode) -> Step {
    code := [Instruction(ops.local, target.pointer_storage, at.slot, binding.index, 0, 0, node)];
    root: Root = {slot: at.slot, storage: binding.storage, container: binding.container, record: binding.record};
    read := Step.Emitted(code, [AddressSlot(target)], [], [], [], [root], [], [], [], 0,
                         Typed(at.slot, binding.storage, binding.container, binding.record), NoValue(), []);
    return CellSchemaStep(read, QuerySnapshotHeader(names, binding.name), ops, target, at, node);
}

QueryReadonlyDestination :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], members: TypeMember[],
                             names: Name[], destination: int) -> bool {
    root := destination;
    first: int = -1;
    while (Is(forest, root, "member_expression")) {
        first = root;
        root = Field(forest, root, "object");
    }
    if (!Is(forest, root, "identifier")) {
        return false;
    }
    found := Lookup(names, Text(forest, text, root));
    if (found < 0) {
        return false;
    }
    bound := names[found];
    if (bound.place == QueryFieldPlace) {
        return bound.storage != PointerStorage || root == destination;
    }
    if (bound.storage != QueryStorage || bound.record < 0) {
        return false;
    }
    if (first < 0) {
        return true;
    }
    field := FindField(types, members, bound.record, Text(forest, text, Field(forest, first, "member")));
    if (field < 0) {
        return false;
    }
    return members[field].storage != PointerStorage || first == destination;
}

QueryAccessPresent :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], names: Name[], expression: int) -> bool {
    spelling := Text(forest, text, expression);
    binding: Name = {owned: false, name: spelling, place: LocalPlace, index: 0, storage: 0, container: 0, record: -1,
                     writable: false, node: -1};
    if (PointerPresent(forest, text, binding, expression)) {
        return true;
    }
    declaration := expression;
    field_name := spelling;
    if (Is(forest, expression, "member_expression")) {
        object := Field(forest, expression, "object");
        if (Is(forest, object, "identifier")) {
            found := Lookup(names, Text(forest, text, object));
            if (found >= 0 && names[found].storage == QueryStorage && names[found].record >= 0) {
                declaration = types[names[found].record].node;
                field_name = Text(forest, text, Field(forest, expression, "member"));
            }
        }
    }
    at := declaration;
    while (at >= 0) {
        if (Is(forest, at, "query_expression") || Is(forest, at, "system")) {
            for (clause in Members(forest, Field(forest, at, "parameters"))) {
                if (Is(forest, clause, "query_guard") &&
                    (declaration != expression || forest[clause].end <= forest[expression].start) &&
                    PointerGuard(forest, text, Field(forest, clause, "condition"), field_name, true)) {
                    return true;
                }
            }
            return false;
        }
        at = forest[at].parent;
    }
    return false;
}

QueryEvaluator :: (queries: QuerySpec[], function: int) -> int {
    index: int = 0;
    while (index < length(queries)) {
        if (queries[index].evaluator == function) {
            return index;
        }
        index += 1;
    }
    return -1;
}
QueryNames :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], members: TypeMember[],
               described: QuerySpec) -> Name[] {
    names: Name[] = [];
    index: int = 0;
    for (field in QueryFields(forest, text, types, members, described)) {
        name: Name = {owned: false, name: field.name, place: QueryFieldPlace, index: index, storage: field.storage,
                      container: field.container, record: field.record, writable: false, node: field.node};
        names.append(name);
        index += 1;
    }
    return names;
}
QueryFieldRow :: (types: TypeDecl[], members: TypeMember[], node: int) -> int {
    row: int = 0;
    for (declared in types) {
        if (declared.kind == QueryDecl) {
            field := declared.first;
            while (field < declared.first + declared.count) {
                if (members[field].read == node) {
                    return row;
                }
                field += 1;
            }
        }
        row += 1;
    }
    return -1;
}
QueryFieldReadPhase: int : 67;
QueryPresencePhase: int : 68;
QueryGuardContext :: (forest: snapshot.SnapshotNode[], node: int) -> bool {
    at := node;
    while (at >= 0) {
        if (Is(forest, at, "query_guard")) {
            return true;
        }
        if (Is(forest, at, "query_binding") || Is(forest, at, "block") ||
            Is(forest, at, "callable_body") || Is(forest, at, "system_body")) {
            return false;
        }
        at = forest[at].parent;
    }
    return false;
}
QueryGuardFunction :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> bool {
    if (!Is(forest, node, "call_expression") || !QueryGuardContext(forest, node)) {
        return false;
    }
    function := Text(forest, text, Field(forest, node, "function"));
    return function == "all" || function == "any" || function == "not";
}
QueryMembership :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], members: TypeMember[],
                    params: Param[], described: QuerySpec, node: int) -> QueryTerm {
    fields: QueryField[] = [];
    for (field in QueryFields(forest, text, types, members, described)) {
        if (forest[field.node].start < forest[node].start) {
            fields.append(field);
        }
    }
    captured: string[] = [];
    index := described.first_capture;
    while (index < described.first_capture + described.capture_count) {
        captured.append(params[index].name);
        index += 1;
    }
    terms := QueryGuardTerms(forest, text, types, fields, captured, node);
    if (length(terms) == 1 && (terms[0].kind == 0 || terms[0].kind == 4)) {
        return terms[0];
    }
    return QueryLeaf(-1, 0, 0, 0, 0, 0, node);
}
QueryMembershipStep :: (term: QueryTerm, values: Value[], top: int, item: Work, ops: Ops, target: Target,
                        at: Bases, node: snapshot.SnapshotNode) -> Step {
    if (item.phase == QueryMembershipPhase) {
        code: Code[] = [ConstantCode(ops, HandleStorage, 0, at.slot, node),
                        Instruction(ops.ne, HandleStorage, at.slot + 1, values[top - 1].slot, at.slot, -1, node)];
        return Step.Emitted(code, [ValueLocal(HandleStorage), ValueLocal(BoolStorage)], [], [], [], [], [], [], [],
                            1, Typed(at.slot + 1, BoolStorage, 0, -1), NoValue(), []);
    }
    owner := Instruction(ops.owner, HandleStorage, at.slot, 0, 0, 0, node);
    if (term.source_variable != 0) {
        owner = Instruction(ops.query_variable, HandleStorage, at.slot, 0, 0, term.source_variable, node);
    }
    arguments: Value[] = [Typed(-2, target.pointer_storage, 0, -1), Typed(at.slot, HandleStorage, 0, -1),
                          Typed(-1, WordStorage, 0, -1)];
    initial: Cell[] = [QueryCell(target.pointer_storage, -1, 0), QueryCell(HandleStorage, -1, 0),
                       QueryCell(WordStorage, -1, term.component)];
    intrinsic: int = 19;
    if (term.kind == 4) {
        intrinsic = 23;
        arguments.append(Typed(-1, IntStorage, 0, -1));
        initial.append(QueryCell(IntStorage, -1, 0));
    } else {
        arguments.append(Typed(-1, WordStorage, 0, -1));
        arguments.append(Typed(-1, IntStorage, 0, -1));
        initial.append(QueryCell(WordStorage, -1, term.source_relationship));
        initial.append(QueryCell(IntStorage, -1, u64(term.source_traversal)));
    }
    return PointerContinue(PointerPrefix([owner], [ValueLocal(HandleStorage)],
                                         QueryCallStep(intrinsic, arguments, initial, {storage: HandleStorage, container: 0, record: -1},
                                                       0, ops, target, SlotsPast(at, 1), node)), Resume(item.node, QueryMembershipPhase, 0, 0));
}
QueryBooleanPosition :: (forest: snapshot.SnapshotNode[], text: string, expression: int) -> bool {
    node := expression;
    while (node >= 0 && forest[node].parent >= 0) {
        parent := forest[node].parent;
        if (Is(forest, parent, "parenthesized_expression")) {
            node = parent;
            continue;
        }
        if (Is(forest, parent, "query_guard") || Is(forest, parent, "if_statement") ||
            Is(forest, parent, "while_statement")) {
            return Field(forest, parent, "condition") == node;
        }
        if (Is(forest, parent, "argument_list")) {
            call := forest[parent].parent;
            function := Text(forest, text, Field(forest, call, "function"));
            if (function != "has" && function != "all" && function != "any" && function != "not") {
                return false;
            }
            return QueryGuardContext(forest, call);
        }
        operator := Text(forest, text, Field(forest, parent, "operator"));
        if (Is(forest, parent, "unary_expression")) {
            return operator == "!" || operator == "not";
        }
        return Is(forest, parent, "binary_expression") &&
               (operator == "&&" || operator == "and" || operator == "||" || operator == "or");
    }
    return false;
}
// Nullable components use the same presence conversion in a header guard,
// a body condition and a short-circuit operand.
QueryBooleanStep :: (types: TypeDecl[], step: Step, ops: Ops, target: Target, at: Bases,
                     node: snapshot.SnapshotNode) -> Step {
    switch step {
        case .Failed(diagnostic):
            return Step.Failed(diagnostic);
        case .Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, popped, value, retained, marks):
            storage := value.storage;
            if (value.container != 0 || value.record < 0 ||
                (storage != PointerStorage && !IsBoxedOptional(types, {storage: value.storage, container: value.container,
                                                                       record: value.record}) &&
                 (storage != StructStorage || types[value.record].kind != OptionalComponentDecl))) {
                return step;
            }
            if (storage == StructStorage) {
                storage = target.pointer_storage;
            }
            null_slot := at.slot + length(slots);
            output := null_slot + 1;
            null_value := ConstantCode(ops, storage, 0, null_slot, node);
            if (storage == PointerStorage) {
                null_value.value_record = value.record;
            }
            rewritten := code;
            if ops.debug && IsBoxedOptional(types, {storage: value.storage, container: value.container, record: value.record}) {
                // Presence is a contextual conversion. The debugger observes
                // the optional expression itself, as the native frontend does.
                rewritten.append(WatchCode(ops, value.slot, value.storage, value.container, value.record,
                                           0, true, node, target));
            }
            rewritten.append(null_value);
            rewritten.append(Instruction(ops.ne, storage, output, value.slot, null_slot, -1, node));
            null_type := AddressSlot(target);
            if (storage == PointerStorage) {
                null_type = ValueLocal(PointerStorage);
            } else if (storage == UnionStorage) {
                null_type = ValueLocal(UnionStorage);
            }
            added := append(slots, null_type);
            added.append(ValueLocal(BoolStorage));
            return Step.Emitted(rewritten, added, locals, cells, hosts, roots, calls, bound, next, popped,
                                Typed(output, BoolStorage, 0, -1), retained, marks);
    }
}
// A component name in a Boolean position is a membership test. Selecting a
// field of the component still reads its value and may require a prior guard.
QueryPresence :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], names: Name[], node: int) -> int {
    if (!Is(forest, node, "member_expression")) {
        return -1;
    }
    owner := Field(forest, node, "object");
    if (!Is(forest, owner, "identifier")) {
        return -1;
    }
    // The dispatcher asks for every member expression, so the cheap tests come
    // first: a Boolean position, then a handle owner, and only then the
    // component, which scans every type.
    parent := forest[node].parent;
    boolean := Is(forest, parent, "query_guard") || Is(forest, parent, "if_statement") ||
               Is(forest, parent, "while_statement");
    if (!boolean && Is(forest, parent, "unary_expression")) {
        operator := Text(forest, text, Field(forest, parent, "operator"));
        boolean = operator == "!" || operator == "not";
    }
    if (!boolean && Is(forest, parent, "binary_expression")) {
        operator := Text(forest, text, Field(forest, parent, "operator"));
        boolean = operator == "&&" || operator == "||" || operator == "and" || operator == "or";
    }
    if (!boolean) {
        return -1;
    }
    found := Lookup(names, Text(forest, text, owner));
    if (found < 0 || names[found].storage != HandleStorage) {
        return -1;
    }
    return Component(types, Text(forest, text, Field(forest, node, "member")));
}
QueryPresenceStep :: (forest: snapshot.SnapshotNode[], types: TypeDecl[], component: int, values: Value[], top: int,
                      item: Work, ops: Ops, target: Target, at: Bases) -> Step {
    if (item.phase == 0) {
        return Step.Emitted([], [], [], [], [], [], [], [],
                            [Visit(Field(forest, item.node, "object")), Resume(item.node, QueryPresencePhase, component, 0)],
                            0, NoValue(), NoValue(), []);
    }
    return QueryCallStep(9,
                         [Typed(-2, target.pointer_storage, 0, -1), values[top - 1], Typed(-1, WordStorage, 0, -1)],
                         [QueryCell(target.pointer_storage, -1, 0), QueryCell(HandleStorage, -1, 0),
                          QueryCell(WordStorage, -1, types[component].component)],
                         {storage: BoolStorage, container: 0, record: -1}, 1, ops, target, at, forest[item.node]);
}
QueryFieldReadStep :: (binding: Name, row: int, values: Value[], top: int, item: Work, ops: Ops, target: Target,
                       at: Bases, node: snapshot.SnapshotNode) -> Step {
    if (item.phase == 0) {
        return PointerContinue(QueryCurrentStep(row, ops, target, at, node),
                               Resume(item.node, QueryFieldReadPhase, 0, 0));
    }
    return QueryGetStep(values[top - 1], binding.index,
                        {storage: binding.storage, container: binding.container, record: binding.record},
                        1, ops, target, at, node);
}

QueryExpressionStep :: (forest: snapshot.SnapshotNode[], document: int, params: Param[], queries: QuerySpec[], values: Value[], top: int,
                        item: Work, ops: Ops, target: Target, at: Bases) -> Step {
    node := forest[item.node];
    index := FindQuery(queries, item.node);
    if (index < 0) {
        return Fail(forest, item.node, document, "Query description was not declared");
    }
    described := queries[index];
    if (item.phase == 0) {
        next: Work[] = [];
        index: int = 0;
        while (index < described.capture_count) {
            capture := Visit(params[described.first_capture + index].node);
            capture.capture = true;
            next.append(capture);
            index += 1;
        }
        next.append(Resume(item.node, QueryMakePhase, 0, 0));
        return Step.Emitted([], [], [], [], [], [], [], [], next, 0, NoValue(), NoValue(), []);
    }
    arguments: Value[] = [Typed(-2, target.pointer_storage, 0, -1), Typed(-1, IntStorage, 0, -1)];
    initial: Cell[] = [QueryCell(target.pointer_storage, -1, 0), QueryCell(IntStorage, -1, u64(index))];
    first := top - described.capture_count;
    at_capture: int = 0;
    while (at_capture < described.capture_count) {
        capture := values[first + at_capture];
        arguments.append(capture);
        captured_cell: Cell = {storage: capture.storage, container: capture.container, record: capture.record,
                               constant: 0, variant: -1, kind: ValueKind};
        initial.append(captured_cell);
        at_capture += 1;
    }
    return QueryCallStep(QueryMakeIntrinsic, arguments, initial,
                         {storage: QueryStorage, container: 0, record: described.description},
                         described.capture_count, ops, target, at, node);
}

// A component's provider is selected by the structural row. Values snapshot
// the provider here; pointers retain its checked ECS identity through removal,
// migration and suspension, using the same managed-pointer capability as native.
QueryOwnedComponentStep :: (types: TypeDecl[], field: QueryField, entity: Value, popped: int, ops: Ops,
                            target: Target, at: Bases, node: snapshot.SnapshotNode) -> Step {
    arguments: Value[] = [Typed(-2, target.pointer_storage, 0, -1), entity,
                          Typed(-1, WordStorage, 0, -1), Typed(-1, StructStorage, 0, field.component),
                          Typed(-1, WordStorage, 0, -1), Typed(-1, WordStorage, 0, -1)];
    initial: Cell[] = [QueryCell(target.pointer_storage, -1, 0), QueryCell(HandleStorage, -1, 0),
                       QueryCell(WordStorage, -1, types[field.component].component), QueryCell(StructStorage, field.component, 0),
                       QueryCell(WordStorage, -1, types[field.component].layout),
                       QueryCell(WordStorage, -1, u64(types[field.component].size))];
    intrinsic := ComponentPointerIntrinsic;
    if (field.storage == StructStorage) {
        intrinsic = ComponentSnapshotIntrinsic;
    }
    return QueryCallStep(intrinsic, arguments, initial,
                         {storage: field.storage, container: 0, record: field.record}, popped,
                         ops, target, at, node);
}
QueryComponentStep :: (forest: snapshot.SnapshotNode[], types: TypeDecl[], field: QueryField, ops: Ops,
                       target: Target, at: Bases) -> Step {
    node := forest[field.node];
    source := Instruction(ops.owner, HandleStorage, at.slot, 0, 0, 0, node);
    if (field.source != 0) {
        source = Instruction(ops.query_variable, HandleStorage, at.slot, 0, 0, field.source, node);
    }
    source_slots: Slot[] = [ValueLocal(HandleStorage)];
    entity := Typed(at.slot, HandleStorage, 0, -1);
    if (field.source_relationship == 0) {
        return PointerPrefix([source], source_slots,
                             QueryOwnedComponentStep(types, field, entity, 0, ops, target, SlotsPast(at, 1), node));
    }
    arguments: Value[] = [Typed(-2, target.pointer_storage, 0, -1), entity,
                          Typed(-1, WordStorage, 0, -1), Typed(-1, WordStorage, 0, -1),
                          Typed(-1, IntStorage, 0, -1)];
    initial: Cell[] = [QueryCell(target.pointer_storage, -1, 0), QueryCell(HandleStorage, -1, 0),
                       QueryCell(WordStorage, -1, types[field.component].component),
                       QueryCell(WordStorage, -1, field.source_relationship),
                       QueryCell(IntStorage, -1, u64(field.source_traversal))];
    return PointerPrefix([source], source_slots,
                         QueryCallStep(19, arguments, initial, {storage: HandleStorage, container: 0, record: -1}, 0,
                                       ops, target, SlotsPast(at, 1), node));
}

QueryEvaluateStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, types: TypeDecl[],
                      queries: QuerySpec[], described: QuerySpec, members: TypeMember[], names: Name[], values: Value[], top: int,
                      item: Work, ops: Ops, target: Target, at: Bases) -> Step {
    node := forest[item.node];
    kind := node.kind;
    if (item.node == described.node && item.phase == 0) {
        next: Work[] = [];
        for (clause in Members(forest, Field(forest, item.node, "parameters"))) {
            next.append(Visit(clause));
        }
        next.append(Resume(item.node, QueryFinishPhase, 0, 0));
        return Step.Emitted([], [], [], [], [], [], [], [], next, 0, NoValue(), NoValue(), []);
    }
    if (item.phase == QueryFinishPhase) {
        code: Code[] = [ConstantCode(ops, BoolStorage, 1, at.slot, node),
                        Instruction(ops.result, BoolStorage, 0, at.slot, 0, 0, node)];
        next: Work[] = [];
        index: int = 0;
        for (field in QueryFields(forest, text, types, members, described)) {
            next.append(Visit(Field(forest, field.node, "name")));
            next.append(Resume(field.node, QueryReturnPhase, index + 1, 0));
            index += 1;
        }
        next.append(Resume(item.node, QueryFinishPhase, 0, 1));
        if (item.b != 0) {
            return Step.Emitted([Instruction(ops.finish, 0, 0, 0, 0, 0, node)], [], [], [], [], [], [], [], [],
                                0, NoValue(), NoValue(), []);
        }
        return Step.Emitted(code, [ValueLocal(BoolStorage)], [], [], [], [], [], [], next,
                            0, NoValue(), NoValue(), []);
    }
    if (item.phase == QueryReturnPhase) {
        value := values[top - 1];
        storage := SlotStorage(value.storage, value.container, target);
        // Stored result headers are already typed. Writing their payload
        // preserves nominal identity, array shape and authored layout.
        code: Code[] = [];
        slots: Slot[] = [];
        if (Pointer(value.storage, value.container)) {
            name := Text(forest, text, Field(forest, item.node, "name"));
            header := QuerySnapshotHeader(names, name);
            slots.append(AddressSlot(target));
            code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot, header, 0, 0, node));
            slots.append(AddressSlot(target));
            context := Instruction(ops.context, target.pointer_storage, at.slot + 1, 0, 0, 0, node);
            context.offset = target.results_offset;
            code.append(context);
            slots.append(ValueLocal(IntStorage));
            code.append(ConstantCode(ops, IntStorage, u64(item.a), at.slot + 2, node));
            slots.append(AddressSlot(target));
            indexed := Instruction(ops.index, target.pointer_storage, at.slot + 3, at.slot + 1, at.slot + 2, 0, node);
            indexed.offset = target.value_size;
            code.append(indexed);
            offsets: int[] = [target.type_offset, target.container_offset, target.name_offset,
                              target.record_offset, target.schema_offset, target.payload_offset];
            part: int = 0;
            for (offset in offsets) {
                copied := AddressSlot(target);
                if (part < 2) {
                    copied = ValueLocal(IntStorage);
                }
                slots.append(copied);
                load := Instruction(ops.load, copied.storage, at.slot + length(slots) - 1, at.slot, 0, 0, node);
                load.offset = offset;
                code.append(load);
                write := Instruction(ops.write, copied.storage, 0, at.slot + length(slots) - 1, at.slot + 3, 0, node);
                write.offset = offset;
                code.append(write);
                part += 1;
            }
        } else {
            context := Instruction(ops.context, target.pointer_storage, at.slot, 0, 0, 0, node);
            context.offset = target.results_offset;
            code.append(context);
            code.append(ConstantCode(ops, IntStorage, u64(item.a), at.slot + 1, node));
            indexed := Instruction(ops.index, target.pointer_storage, at.slot + 2, at.slot, at.slot + 1, 0, node);
            indexed.offset = target.value_size;
            code.append(indexed);
            write := Instruction(ops.write, value.storage, 0, value.slot, at.slot + 2, 0, node);
            write.offset = target.payload_offset;
            code.append(write);
            slots = [AddressSlot(target), ValueLocal(IntStorage), AddressSlot(target)];
        }
        return Step.Emitted(code, slots, [], [], [], [], [], [], [], 1, NoValue(), NoValue(), []);
    }
    if (kind == "query_guard") {
        if (item.phase == 0) {
            return Step.Emitted([], [], [], [], [], [], [], [],
                                [Expect(Field(forest, item.node, "condition"), BoolStorage, 0, -1),
                                 Resume(item.node, QueryGuardPhase, 0, 0)], 0, NoValue(), NoValue(), []);
        }
        condition := values[top - 1];
        if (!Single(condition, BoolStorage)) {
            return Fail(forest, item.node, document, "Query if condition must be bool");
        }
        code: Code[] = [Instruction(ops.branch_if, 0, 0, condition.slot, 0, at.pc + 4, node),
                        ConstantCode(ops, BoolStorage, 0, at.slot, node),
                        Instruction(ops.result, BoolStorage, 0, at.slot, 0, 0, node),
                        Instruction(ops.finish, 0, 0, 0, 0, 0, node)];
        return Step.Emitted(code, [ValueLocal(BoolStorage)], [], [], [], [], [], [], [], 1, NoValue(), NoValue(), []);
    }
    fields := QueryFields(forest, text, types, members, described);
    index := QueryFieldIndex(fields, Text(forest, text, Field(forest, item.node, "name")));
    if (index < 0) {
        return Fail(forest, item.node, document, "Unknown query field");
    }
    field := fields[index];
    if (item.phase == 0) {
        if (kind == "query_binding") {
            return Step.Emitted([], [], [], [], [], [], [], [],
                                [Expect(Field(forest, item.node, "value"), field.storage, field.container, field.record),
                                 Resume(item.node, QueryBindPhase, 0, 0)], 0, NoValue(), NoValue(), []);
        }
        if (kind == "query_generator") {
            variable := Instruction(ops.query_variable, HandleStorage, at.slot, 0, 0, field.variable, node);
            return Step.Emitted([variable], [ValueLocal(HandleStorage)], [], [], [], [], [], [],
                                [Resume(item.node, QueryBindPhase, 0, 0)], 0,
                                Typed(at.slot, HandleStorage, 0, field.record), NoValue(), []);
        }
        phase := QueryBindPhase;
        if (field.source_relationship != 0) {
            phase = QueryProviderPhase;
        }
        return PointerContinue(QueryComponentStep(forest, types, field, ops, target, at),
                               Resume(item.node, phase, 0, 0));
    }
    if (item.phase == QueryProviderPhase) {
        return PointerContinue(QueryOwnedComponentStep(types, field, values[top - 1], 1, ops, target, at, node),
                               Resume(item.node, QueryBindPhase, 0, 0));
    }
    value := values[top - 1];
    if (!Accepts(types, field.storage, field.container, field.record, value)) {
        return Fail(forest, item.node, document, "Query binding value differs from its type");
    }
    bound: Name = {owned: false, name: field.name, place: LocalPlace, index: at.local, storage: field.storage,
                   container: field.container, record: field.record, writable: false,
                   node: Field(forest, item.node, "name")};
    if (Pointer(field.storage, field.container)) {
        header := bound;
        header.place = QuerySnapshotHeaderPlace;
        header.index = at.cell - 1;
        bound.place = QuerySnapshotPlace;
        code: Code[] = [];
        slots: Slot[] = [];
        cells: Cell[] = [];
        if (field.component < 0) {
            header.index = at.cell;
            code = MoveCode(value, ops, target, at.slot, at.cell, node);
            slots.append(AddressSlot(target));
            cells.append(MovedCell(value));
        }
        code.append(Instruction(ops.save, target.pointer_storage, 0, value.slot, 0, at.local, node));
        return Step.Emitted(code, slots, [AddressSlot(target)], cells, [], [], [], [header, bound], [],
                            1, NoValue(), NoValue(), []);
    }
    code: Code[] = [Instruction(ops.save, field.storage, 0, value.slot, 0, at.local, node)];
    return Step.Emitted(code, [], [ValueLocal(field.storage)], [], [], [], [], [bound], [], 1, NoValue(), NoValue(), []);
}
