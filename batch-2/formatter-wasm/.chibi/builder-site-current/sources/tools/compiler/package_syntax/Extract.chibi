package package_syntax

import syntax "project:syntax_diagnostics"
import strings "core:strings"

File :: struct {
    path: string;
    directory: string;
    name: string;
    header_start: int;
    header_end: int;
    header_line: int;
    header_column: int;
    header_document: int;
}

pub Import :: struct {
    file: int;
    alias: string;
    explicit_alias: bool;
    range_start: int;
    range_end: int;
    range_line: int;
    range_column: int;
    range_document: int;
    path_start: int;
    path_end: int;
    path_line: int;
    path_column: int;
    path_document: int;
    alias_start: int;
    alias_end: int;
    alias_line: int;
    alias_column: int;
    alias_document: int;
    // Inside a `when` branch, so it binds only if the branch is kept.
    conditional: bool;
}

pub Result :: union {
    Accepted(file: File, imports: Import[])
    | Rejected(diagnostic: syntax.Diagnostic)
}

// Fields align with raw nodes and describe each node's edge from its
// parent. Package headers and imports use direct visible field edges.
FindField :: (nodes: syntax.Node[], fields: int[], node: int, field: int) -> int {
    child := nodes[node].first_child;
    while (child >= 0) {
        if (fields[child] == field) {
            return child;
        }
        child = nodes[child].next_sibling;
    }
    return -1;
}

// The header and imports of a parsed file; the parser has rejected syntax errors.
pub Extract :: (nodes: syntax.Node[], fields: int[], text: string,
                root: int, file: int, path: string, directory: string) -> Result {
    header := FindField(nodes, fields, root, syntax.FieldPackage);
    if (header < 0) {
        node := nodes[root];
        diagnostic: syntax.Diagnostic = {
            start: node.start, end: node.end, line: node.row + 1,
            column: node.column + 1, document: 0,
            message: "Expected package header"
        };
        return Result.Rejected(diagnostic);
    }

    nameNode := nodes[FindField(nodes, fields, header, syntax.FieldName)];
    name := strings.Slice(text, nameNode.start, nameNode.end - nameNode.start);
    if (name == "_") {
        diagnostic: syntax.Diagnostic = {
            start: nameNode.start, end: nameNode.end, line: nameNode.row + 1,
            column: nameNode.column + 1, document: 0,
            message: "A package needs a non-blank name"
        };
        return Result.Rejected(diagnostic);
    }

    descriptor: File = {
        path: path, directory: directory, name: name,
        header_start: nameNode.start, header_end: nameNode.end,
        header_line: nameNode.row + 1, header_column: nameNode.column + 1,
        header_document: 0
    };
    imports: Import[] = [];
    Imports(nodes, fields, text, file, root, false, &imports);
    return Result.Accepted(descriptor, imports);
}

// Appends the imports among `parent`'s children in source order, with those
// inside each `when` declaration's branches, all of which are conditional:
// the compiler keeps the ones of the branch the condition selects.
Imports :: (nodes: syntax.Node[], fields: int[], text: string, file: int, parent: int, conditional: bool,
            imports: ^(Import[])) {
    current := nodes[parent].first_child;
    while (current >= 0) {
        node := nodes[current];
        if (node.kind == syntax.WhenDeclaration || node.kind == syntax.DeclarationBlock) {
            Imports(nodes, fields, text, file, current, true, imports);
        } else if (node.kind == syntax.ImportDeclaration) {
            pathNode := nodes[FindField(nodes, fields, current, syntax.FieldPath)];
            alias := FindField(nodes, fields, current, syntax.FieldAlias);
            aliasName := "";
            aliasStart: int = 0;
            aliasEnd: int = 0;
            aliasLine: int = 0;
            aliasColumn: int = 0;
            if (alias >= 0) {
                aliasNode := nodes[alias];
                aliasName = strings.Slice(text, aliasNode.start, aliasNode.end - aliasNode.start);
                aliasStart = aliasNode.start;
                aliasEnd = aliasNode.end;
                aliasLine = aliasNode.row + 1;
                aliasColumn = aliasNode.column + 1;
            }
            imported: Import = {
                file: file, alias: aliasName, explicit_alias: alias >= 0,
                range_start: node.start, range_end: pathNode.end,
                range_line: node.row + 1, range_column: node.column + 1,
                range_document: 0,
                path_start: pathNode.start, path_end: pathNode.end,
                path_line: pathNode.row + 1, path_column: pathNode.column + 1,
                path_document: 0,
                alias_start: aliasStart, alias_end: aliasEnd,
                alias_line: aliasLine, alias_column: aliasColumn,
                alias_document: 0, conditional: conditional
            };
            imports.append(imported);
        }
        current = nodes[current].next_sibling;
    }
}
