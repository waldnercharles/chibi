            "public/ui_document_values"
        ];
    }
    if (target == "chibi_reference_index") {
        return ["public/reference_index", "public/support", "public/events", "public/types"];
    }
    if (target == "chibi_fmt") {
        return ["third_party/fmt"];
    }
    if (target == "chibi_json") {
        return ["third_party/yyjson", "public/json"];
    }
    if (target == "chibi_asset_json") {
        return ["public/asset_json", "public/asset_values", "public/support", "public/json"];
    }
    if (target == "chibi_asset_kdl") {
        return ["third_party/ckdl/include", "third_party/ckdl/src"];
    }
    if (target == "chibi_asset_text") {
        return [
            "public/asset_text", "private/asset_text", "third_party/ckdl/include", "public/asset_values",
            "public/support"
        ];
    }
    if (target == "chibi_text_capabilities") {
        return [
            "public/text_capabilities", "third_party/fmt", "public/native_capabilities", "public/capabilities",
            "public/types", "public/support", "public/execution_contract"
        ];
    }
    if (target == "chibi_array_capabilities") {
        return [
            "public/array_capabilities", "private/types", "public/native_capabilities", "public/capabilities",
            "public/types", "public/support", "public/execution_contract"
        ];
    }
    if (target == "chibi_field_capabilities") {
        return [
            "public/field_capabilities", "public/native_capabilities", "public/capabilities", "public/types",
            "public/support", "public/execution_contract", "public/fields", "public/tasks"
        ];
    }
    if (target == "chibi_input_map") {
        return [
            "public/input_map", "public/input_action", "public/types", "public/support", "public/asset_values",
            "public/asset_text"
        ];
    }
    return [];
}

// The macros a target's compiles define, before its include directories.
pub Defines :: (target: string) -> string[] {
    if (target == "chibi_asset_kdl") {
        return ["BUILDING_KDL=1", "KDL_STATIC_LIB=1"];
    }
    if (target == "chibi_asset_text") {
        return ["KDL_STATIC_LIB=1"];
    }
    return [];
}

// Options a target adds after the profile's flags. The graph drives Clang
// and GCC, which both take them: fields keeps floating-point contraction off
// so its results match on every backend, and vendored C compiles without
// warnings.
pub Options :: (target: string) -> string[] {
    if (target == "chibi_fields") {
        return ["-ffp-contract=off"];
    }
    if (target == "chibi_fmt") {
        return ["-w"];
    }
    if (target == "chibi_json") {
        return ["-w"];
    }
    if (target == "chibi_asset_kdl") {
        return ["-w"];
    }
    return [];
}

// Files a target embeds as byte arrays: `OUTPUT=SYMBOL=INPUT` writes the
// generated source OUTPUT, as Files names it, defining SYMBOL with the bytes
// of INPUT below the source root, as cmake/embed_binary.cmake does.
pub Embeds :: (target: string) -> string[] {
    if (target == "chibi_component_presentation") {
        return [
            "generated/authoring/engine_components.c=component_presentation_engine_kdl=src/authoring/engine_components.kdl"
        ];
    }
    if (target == "chibi_builtin_fonts") {
        return [
            "generated/fonts/editor_nerd_symbols_font.c=editor_nerd_symbols_font=third_party/fonts/nerd-fonts-symbols-only/SymbolsNerdFont-Regular.ttf",
            "generated/fonts/editor_ui_font.c=editor_ui_font=third_party/fonts/inter/Inter.ttf",
            "generated/fonts/editor_ui_bold_font.c=editor_ui_bold_font=third_party/fonts/inter/Inter-Bold.ttf",
            "generated/fonts/editor_ui_medium_font.c=editor_ui_medium_font=third_party/fonts/inter/Inter-Medium.ttf",
            "generated/fonts/editor_ui_semibold_font.c=editor_ui_semibold_font=third_party/fonts/inter/Inter-SemiBold.ttf",
            "generated/fonts/editor_ui_numeric_font.c=editor_ui_numeric_font=third_party/fonts/inter/Inter-Numeric.ttf",
            "generated/fonts/studio_regular_font.c=studio_regular_font=third_party/fonts/geist/Geist-Regular.ttf",
            "generated/fonts/studio_medium_font.c=studio_medium_font=third_party/fonts/geist/Geist-Medium.ttf",
            "generated/fonts/studio_semibold_font.c=studio_semibold_font=third_party/fonts/geist/Geist-SemiBold.ttf",
            "generated/fonts/studio_bold_font.c=studio_bold_font=third_party/fonts/geist/Geist-Bold.ttf",
            "generated/fonts/studio_numeric_font.c=studio_numeric_font=third_party/fonts/geist/Geist-Numeric.ttf",
            "generated/fonts/editor_noto_sans_font.c=editor_noto_sans_font=third_party/fonts/noto-sans/NotoSans-Regular.ttf",
            "generated/fonts/editor_noto_sans_semibold_font.c=editor_noto_sans_semibold_font=third_party/fonts/noto-sans/NotoSans-SemiBold.ttf",
            "generated/fonts/editor_noto_sans_bold_font.c=editor_noto_sans_bold_font=third_party/fonts/noto-sans/NotoSans-Bold.ttf",
            "generated/fonts/editor_inconsolata_font.c=editor_inconsolata_font=third_party/fonts/inconsolata/Inconsolata-Regular.ttf",
            "generated/fonts/editor_code_font.c=editor_code_font=third_party/fonts/jetbrains-mono/JetBrainsMono-Regular.ttf"
        ];
    }
    return [];
}

// The executables the graph builds; every other target is a library.
pub Programs :: () -> string[] {
    return ["reflect"];
}

// The libraries an executable links, in CMake's order, after the external
// libraries its profile names.
pub Links :: (target: string) -> string[] {
    if (target == "reflect") {
        return ["chibi_capabilities", "chibi_types", "chibi_support"];
    }
    return [];
}

// The system libraries an executable links last, as -lNAME on Unix.
pub SystemLibraries :: (target: string) -> string[] {
    if (target == "reflect") {
        return ["m"];
    }
    return [];
}
