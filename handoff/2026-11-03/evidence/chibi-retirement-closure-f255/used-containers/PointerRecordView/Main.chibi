package pointer_record_view
Row :: struct { number: int; }
Read :: (window: view (^Row)[]) -> int { return window[0].number; }
Main :: () -> int {
 row: Row = {number: 7}; values: (^Row)[] = [&row]; pointer := &values;
 selected := pointer.view(0..<1); if selected { return Read(selected); } return -1;
}
