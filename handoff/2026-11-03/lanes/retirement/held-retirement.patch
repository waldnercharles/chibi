-           pointers = count * sizeof(scalar_value *);
-    if (row > FLOW_SCRATCH_LIMIT || pointers > FLOW_SCRATCH_LIMIT ||
-        (row && edges > (FLOW_SCRATCH_LIMIT - pointers) / row)) {
