version 3
name "SdfQualityNarrowCut"
domain "shape"
bounds_x 140.0
bounds_y 140.0
id_counter 88
description "Sphere minus a narrow through-cylinder: silhouette and depth test."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Shader Shape Output"
            - id=3 type="Shader ObjectPosition"
            - {
                id 40
                type "Behavior Expression"
                reference_name "max(length(position) - 30, -(length(position.xz) - 3.5))"
                inputs {
                    position id=41 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=42 type="float"
                }
            }
        }
        (array)edges {
            - from="3.Value" to="40.position"
            - from="40.Result" to="1.Distance"
        }
    }
    - id=5 kind="function" math_expression="max(length(position) - 30, -(length(position.xz) - 3.5))" expression_mode=1 entry_id=44
}
