package native_driver

import compiler "project:package_compiler"
import facts "project:scalar_facts"
import abi "project:native_abi"
import scalar "project:scalar_llvm"
import strings "core:strings"
import syntax "project:syntax_diagnostics"

// The native compiler's pure core: the sources of a program's closure in, one
// LLVM module or the first rejection out. It touches no file and no global, so
// Main runs it natively and the VM-hosted compiler runs it as an entry.

// A large program's module is several pieces, each after the first begun by
// a `; chibi-piece` line (llvm_native's Pieces).
pub Output :: union {
    Rejected(message: string) | Emitted(text: string)
}

Target :: (triple: string) -> abi.Target {
    if (strings.HasPrefix(triple, "aarch64-apple")) {
        return abi.MacOSArm64();
    }
    if (strings.HasPrefix(triple, "x86_64-pc-windows")) {
        return abi.WindowsX64();
    }
    return abi.LinuxX64();
}

// The function whose declaration lies last before byte `at` of `text`.
FunctionAt :: (text: string, at: int) -> string {
    lines := strings.SplitLines(strings.Slice(text, 0, at));
    index := length(lines) - 1;
    while (index >= 0) {
        line := lines[index];
        marker := strings.Index(line, " :: (");
        if (marker > 0 && !strings.HasPrefix(line, " ") && !strings.HasPrefix(line, "/")) {
            return strings.TrimPrefix(strings.Slice(line, 0, marker), "pub ");
        }
        index -= 1;
    }
    return "(entry)";
}

// The file and line byte `at` of the joined sources lies in; each source is
// followed by a newline when it lacks one, as the producer joins them.
// source_size ends at the last retained document when parsing stopped early.
Where :: (collections: string[], directories: string[], paths: string[], sources: string[],
          os: int, arch: int, source_size: int, at: int) -> string {
    offset := 0;
    for (index in 0..<length(paths)) {
        text := sources[index];
        if (compiler.TargetPackagePath(collections, directories, paths[index])) {
            // Match the producer's actual source, not the on-disk target template.
            text = compiler.TargetPackageText(os, arch, TargetFacts().pointer_size * 8, 1);
        }
        size := strings.ByteLength(text);
        if (!strings.HasSuffix(text, "\n")) {
            size += 1;
        }
        if (at < offset + size || (at == source_size && at == offset + size)) {
            line := strings.Count(strings.Slice(text, 0, at - offset), "\n") + 1;
            return format_text("{}:{}", paths[index], line);
        }
        offset += size;
    }
    return "?";
}

// `paths[0]` and `sources[0]` are the entry file, the others its closure: project
// packages by project-relative path and collection packages by path under their
// `directories`. The program starts at the function `chosen` of the first file,
// or at its first function when `chosen` is "". With a `directory`, the module
// has line tables naming the source in it (Linux x86-64 only). A rejection
// message reads `rejected FUNCTION: MESSAGE`.
pub Module :: (collections: string[], directories: string[], paths: string[], sources: string[], triple: string,
               chosen: string, directory: string) -> Output {
    return ModuleWith(collections, directories, paths, sources, triple, chosen, directory, false);
}

// Package generations expose Main/Frame and retained states to the native host.
pub ModuleShared :: (collections: string[], directories: string[], paths: string[], sources: string[], triple: string,
                     chosen: string, directory: string) -> Output {
    if (directory != "") {
        return Output.Rejected("shared package generations have no line tables yet");
    }
    return ModuleWith(collections, directories, paths, sources, triple, chosen, "", true);
}

ModuleWith :: (collections: string[], directories: string[], paths: string[], sources: string[], triple: string,
               chosen: string, directory: string, shared: bool) -> Output {
    os := 1;
    arch := 1;
    if (strings.HasPrefix(triple, "aarch64-apple")) {
        os = 2;
        arch = 2;
    } else if (strings.HasPrefix(triple, "x86_64-pc-windows")) {
        os = 3;
    }
    rows := compiler.CollectScalarProgram("/project", collections, directories, paths, sources, TargetFacts(), Names(),
                                          Natives(), Ports(), Identities(), os, arch, chosen);
    return EmitRows(collections, directories, paths, sources, os, arch, rows, Target(triple), directory, shared);
}

// The parser distinguishes library declarations from package generations,
// including comments and nonstandard whitespace before the declaration.
LibrarySource :: (source: string) -> bool {
    switch compiler.ParseSyntax(source) {
        case .Rejected(diagnostic): return false;
        case .Parsed(nodes, fields, is_named, is_extra, root):
            child := nodes[root].first_child;
            while (child >= 0) {
                if (!is_extra[child] && is_named[child]) {
                    return nodes[child].kind == syntax.Library;
                }
                child = nodes[child].next_sibling;
            }
    }
    return false;
}

// The existing single-source library producer; package libraries and line
// tables are not supported here. The driver admits only Linux x86-64.
LibraryModule :: (path: string, source: string) -> Output {
    rows := compiler.CollectScalar("/project", path, source, TargetFacts(), Names(), Natives(), Ports(), Identities());
    return EmitRows([], [], [path], [source], 1, 1, rows, abi.LinuxX64(), "", false);
}

// Both producers return the same facts rows and rejection contract. A
// rejection names its file and line in the closure the producer read, with
// the target `os` and `arch` (core:target's numbers) that chose its text.
EmitRows :: (collections: string[], directories: string[], paths: string[], sources: string[], os: int, arch: int,
             rows: facts.Row[], target: abi.Target, directory: string, shared: bool) -> Output {
    if (length(rows) < 2 || rows[1].kind == facts.RejectionRow) {
        rejected := rows[length(rows) - 1];
        return Output.Rejected(strings.Concatenate(["rejected ", FunctionAt(rows[0].text, rejected.start), ": ",
                                                    rejected.text, " (", Where(collections, directories, paths, sources, os, arch,
                                                                              strings.ByteLength(rows[0].text), rejected.start), ")"]));
    }
    emitted: scalar.Result = scalar.Result.Invalid("");
    if (shared) {
        emitted = scalar.EmitShared(target, rows);
    } else if (directory == "") {
        emitted = scalar.EmitFor(target, rows);
    } else {
        emitted = scalar.EmitLines(rows, directory);
    }
    switch emitted {
        case .Rejected(rejected):
            return Output.Rejected(strings.Concatenate(["rejected (module): ", rejected[length(rejected) - 1].text]));
        case .Invalid(message):
            return Output.Rejected(strings.Concatenate(["rejected (module): ", message]));
        case .Emitted(text):
            return Output.Emitted(text);
    }
}

// The compiler host's entry: the module's bytes, or a 0 byte and then the
// rejection's text.
pub Compile :: (core: string, paths: string[], sources: string[], triple: string) -> u8[] {
    switch Module(["core"], [core], paths, sources, triple, "", "") {
        case .Rejected(message):
            flagged: u8[] = [0];
            for (byte in strings.Bytes(message)) {
                flagged.append(u8(byte));
            }
            return flagged;
        case .Emitted(text):
            module: u8[] = [];
            for (item in strings.Bytes(text)) {
                module.append(u8(item));
            }
            return module;
    }
}
