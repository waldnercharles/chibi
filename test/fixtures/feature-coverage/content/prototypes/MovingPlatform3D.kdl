name "MovingPlatform3D"
components {
    GAME.GameBody3D type="Kinematic"
    GAME.GameCollider3D {
        category 1
        mask 1
        size x=160.0 y=8.0 z=96.0
    }
    GAME.GameGeometry3D depth=96.0 height=8.0 width=160.0
    GAME.GameMaterial scene=0x4080bfff
    GAME.GameTransform3D {
        scale x=1.0 y=1.0 z=1.0
    }
}
