package facts
@error Failure :: struct { code: int; }
Read :: (fail: bool) -> (value: int, error: Failure?) { if fail { return(7, {code: 3}); } return(7, nil); }
Use :: (flag: bool) -> int { bad := Read(true); clean := Read(false); if clean.error {} if bad.error { if flag { bad := clean; if bad.error { return bad.error.code; } return 11; } return bad.error.code; } return 0; }
