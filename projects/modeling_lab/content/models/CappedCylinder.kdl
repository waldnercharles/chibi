version 3
name "CappedCylinder"
domain "model"
id_counter 7
description "Finite cylinder along local Y."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Cylinder"
                inputs Radius=23.0 "Half Height"=24.0
            }
        }
        (array)edges {
            - from="3.Geometry" to="1.Geometry"
        }
    }
}
