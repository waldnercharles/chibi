version 3
name "SdfOrbitCyanDepth"
domain "material"
id_counter 10
description "Fixed color emission for orbit light/depth proof. Authored separately from the nonemissive GI receivers."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 1
                type "Shader Surface Output"
                inputs {
                    "Base Color" {
                        default x=0.12 y=0.8 z=0.95
                    }
                    Emission {
                        default x=0.042 y=0.28 z=0.3325
                    }
                    Normal {
                        default x=0.0 y=0.0 z=0.0
                    }
                }
            }
        }
    }
}
