                            data.Field.Named("type", data.Value.Text("Model Sphere")),
                            data.Field.Named("x", data.Value.Real(280.0)),
                            data.Field.Named("y", data.Value.Real(850.0)),
                            data.Field.Named("inputs", data.Object([
                                data.Field.Named("Radius", data.Value.Real(10.0))
                            ]))
                        ]),
                        data.Object([
                            data.Field.Named("id", data.Value.UInt(900)),
                            data.Field.Named("type", data.Value.Text("Model Translate")),
                            data.Field.Named("x", data.Value.Real(580.0)),
                            data.Field.Named("y", data.Value.Real(650.0))
