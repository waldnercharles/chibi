version 3
name "Bronze"
domain "material"
id_counter 15000
description "Cast bronze with green patina gathering in noisy patches, where it turns rough and stops being metal."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 200
                type "Behavior Expression"
                reference_name "smoothstep(0.55, 0.75, noise(p, 0.05))"
                inputs {
                    p id=201 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=250 type="float"
                }
            }
            - {
                id 300
                type "Behavior Expression"
                reference_name "mix(vec3(0.78, 0.5, 0.28), vec3(0.22, 0.42, 0.36), patina)"
                inputs {
                    patina id=301 type="float"
                }
                outputs {
                    Result id=350 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 400
                type "Behavior Expression"
                reference_name "mix(1.0, 0.1, patina)"
                inputs {
                    patina id=401 type="float"
                }
                outputs {
                    Result id=450 type="float"
                }
            }
            - {
                id 500
                type "Behavior Expression"
                reference_name "mix(0.3, 0.8, patina)"
                inputs {
                    patina id=501 type="float"
                }
                outputs {
                    Result id=550 type="float"
                }
            }
            - {
                id 1100
                type "Shader Surface Output"
                inputs "Alpha Mode"=1
            }
            - id=2000 type="Shader WorldPosition"
        }
        (array)edges {
            - from="200.Result" to="300.patina"
            - from="200.Result" to="400.patina"
            - from="200.Result" to="500.patina"
            - from="300.Result" to="1100.Base Color"
            - from="400.Result" to="1100.Metallic"
            - from="500.Result" to="1100.Roughness"
            - from="2000.Value" to="200.p"
        }
    }
    - id=10000 kind="function" math_expression="smoothstep(0.55, 0.75, noise(p, 0.05))" expression_mode=1 entry_id=10001
    - id=11000 kind="function" math_expression="mix(vec3(0.78, 0.5, 0.28), vec3(0.22, 0.42, 0.36), patina)" expression_mode=1 entry_id=11001
    - id=12000 kind="function" math_expression="mix(1.0, 0.1, patina)" expression_mode=1 entry_id=12001
    - id=13000 kind="function" math_expression="mix(0.3, 0.8, patina)" expression_mode=1 entry_id=13001
}
