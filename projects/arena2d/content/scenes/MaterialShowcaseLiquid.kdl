            GameAppearance width=6.0 height=24.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Water"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=-50.0 y=-43.0
            GameFluidVolume {
                kind "Liquid"
                width 40.0
                height 38.0
                spacing 0.25
                mass 6.25e-05
                color 0x369de8ff
                velocity x=0.0 y=0.0
                absorption 0.08
                visibility 0.4
                refraction 0.0
                grain_radius 0.0
