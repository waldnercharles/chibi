package llvm_native

import abi "project:native_abi"
import strings "core:strings"

TaskWaitEffect: int : 0;
TaskSpawnEffect: int : 1;

// The existing lifecycle graph excludes collector edges and propagates owners
// once. Its table lookup also bounds shared record DAGs without expanding every
// root-to-leaf path. Pointer cells and arrays use separate persistent roots.
TaskFramePlain :: (layout: ValueLayout, type: int) -> bool {
    if (abi.ScalarType(type) != "") { return true; }
    index := type - RecordType;
    return type < ArrayType && Index(index, length(layout.valid)) && layout.valid[index] && !layout.owned[index];
}
TaskFrameTraced :: (layout: ManagedRecordLayout, type: int) -> bool {
    return type == PointerType || (ManagedTraced(type, layout.traced) && layout.traceable[type - RecordType]);
}
// A frame may keep a window independently of task promise admission. Exact
// optional/authored-union windows reuse their existing tag/window tracer.
TaskFrameRoot :: (records: Record[], fields: int[], managed: ManagedRecordLayout, type: int) -> bool {
    return TaskFrameTraced(managed, type) || type == ViewType || ViewOptional(records, fields, type, ViewType);
}
TaskFrameValue :: (records: Record[], fields: int[], layout: ValueLayout, managed: ManagedRecordLayout,
                    type: int, observer: bool, owned: bool) -> bool {
    if (owned && TaskFrameRoot(records, fields, managed, type)) { return true; }
    if (owned && TaskOwnedType(records, layout, type)) { return true; }
    if (owned && observer && type >= RefType && TaskOwnedType(records, layout, type - RefType) &&
        !ValueCollectorOwner(layout, type - RefType)) { return true; }
    if (type == TaskType) { return observer; }
    if (type == PointerType || type == ArrayType + PointerType) { return true; }
    if (observer && type >= RefType &&
        (TaskFramePlain(layout, type - RefType) || type == RefType + PointerType || type == RefType + ArrayType + PointerType)) { return true; }
    return TaskFramePlain(layout, type);
}
// This new reference domain is transient: only an immediate managed payload
// read, or write followed by its readback. No borrowed address survives a
// callback, suspension, loop edge or replacement of its original owner.
TaskPlainReference :: (layout: ValueLayout, type: int) -> bool {
    return type >= RefType + RecordType && type < RefType + ArrayType && TaskFramePlain(layout, type - RefType);
}
TaskReferencesValid :: (layout: ValueLayout, slots: int[], code: Instruction[], arguments: int[], definitions: int[]) -> string {
    failure := "native waiting record references require immediate managed payload access";
    for (slot in 0..<length(slots)) {
        if (!TaskPlainReference(layout, slots[slot]) || definitions[slot] < 0) { continue; }
        first := definitions[slot] + 1;
        if (code[definitions[slot]].op != ManagedAddress || first >= length(code)) { return failure; }
        access := code[first];
        if ((access.op != Deref && access.op != Poke) || access.left != slot) { return failure; }
    }
    for (pc in 0..<length(code)) {
        item := code[pc];
        if ((item.op == Jump || item.op == Branch) &&
            (code[item.target].op == Deref || code[item.target].op == Poke) &&
            TaskPlainReference(layout, slots[code[item.target].left])) { return failure; }
        if (ReadsLeft(item.op) && TaskPlainReference(layout, slots[item.left])) {
            first := definitions[item.left] + 1;
            immediate := pc == first && (item.op == Deref || item.op == Poke);
            readback := pc == first + 1 && code[first].op == Poke && item.op == Deref;
            if (!immediate && !readback) { return failure; }
        }
        if ((ReadsRight(item.op) && TaskPlainReference(layout, slots[item.right])) ||
            (ReadsTarget(item.op) && TaskPlainReference(layout, slots[item.target]))) { return failure; }
        if (ReadsArguments(item.op)) {
            for (index in 0..<ArgumentCount(item)) {
                if (TaskPlainReference(layout, slots[arguments[item.right + index]])) { return failure; }
            }
        }
    }
    return "";
}
// Canonical frame/cell addresses are stable. An address into array/map backing
// instead belongs to one linear projection/check/mutation region. Scratch
// reference locals transfer that address; they do not acquire its backing.
// Retired slots may keep unused bits. Only later reads are rejected.
TaskBackingReferencesValid :: (slots: int[], locals: int[], code: Instruction[], arguments: int[], owners: bool[]) -> string {
    failure := "native waiting backing references require immediate canonical access";
    refs := resize([int(0)], length(slots));
    borrowed := resize([int(0)], length(slots));
    local_refs := resize([int(0)], length(locals));
    writes := resize([int(0)], length(locals));
    saved := resize([int(-1)], length(locals));
    for (item, pc in code) {
        if (item.op == Save && item.type >= RefType) { writes[item.target] += 1; saved[item.target] = pc; }
    }
    starts: int[] = [];
    ends: int[] = [];
    region := -1;
    active := -1;
    token := 0;
    changed := false;
    for (item, pc in code) {
        left := ReadsLeft(item.op) || (item.op == OwnerPin && item.target == 0);
        right := ReadsRight(item.op);
        target := ReadsTarget(item.op);
        if ((left && refs[item.left] != 0 && active != item.left) ||
            (right && refs[item.right] != 0 && active != item.right) ||
            (target && refs[item.target] != 0 && active != item.target)) { return failure; }
        value := 0;
        if (left) { value = borrowed[item.left]; }
        if (item.op == StateLoad && item.left > 0) { value = borrowed[item.left - 1]; }
        if ((value != 0 && value != token) ||
            (right && borrowed[item.right] != 0 && borrowed[item.right] != token) ||
            (target && borrowed[item.target] != 0 && borrowed[item.target] != token)) { return failure; }
        if (changed && item.op != Poke && (value != 0 ||
            (right && borrowed[item.right] != 0) || (target && borrowed[item.target] != 0))) { return failure; }
        local := -1;
        if (item.op == Local || (item.op == FieldAddress && item.target == 1)) { local = item.left; }
        if (local >= 0 && local_refs[local] != 0 && active != length(slots) + local) { return failure; }
        if (item.op == OwnerPin && item.target == 1 && local_refs[item.left] != 0) { return failure; }
        // A loan/pin would save the address for hidden reads at a later call
        // or cancellation. Indexed loans carry a stable logical root instead.
        if ((item.op == ArrayLoan && refs[item.right] != 0) ||
            (item.op == ManagedPin && refs[item.left] != 0)) { return failure; }
        if (item.op == ArrayLoan && item.target == ArrayLoanMove && value != 0) { return failure; }
        if (item.op == ManagedTrack && item.target < ManagedClearSlot) {
            if ((item.target == ManagedTrackLocal && local_refs[item.left] != 0) ||
                (item.target == ManagedTrackSlot && (refs[item.left] != 0 || borrowed[item.left] != 0))) { return failure; }
        }
        used := (left && refs[item.left] != 0) || value != 0 ||
                (right && (refs[item.right] != 0 || borrowed[item.right] != 0)) ||
                (target && (refs[item.target] != 0 || borrowed[item.target] != 0)) ||
                (local >= 0 && local_refs[local] != 0);
        if (used) { ends[region] = pc; }
        if (item.op == ArrayValueAddress || item.op == MapValueAddress) {
            if (changed) { return failure; }
            if (refs[item.left] == 0) {
                region = length(starts); starts.append(pc); ends.append(pc);
            }
            active = item.output; token = item.output + 1; refs[item.output] = token;
            continue;
        }
        if (item.op == Save && item.type >= RefType && refs[item.left] != 0) {
            if (changed || writes[item.target] != 1) { return failure; }
            local_refs[item.target] = token;
            active = length(slots) + item.target;
            continue;
        }
        if (local >= 0 && local_refs[local] != 0) {
            if (changed) { return failure; }
            active = item.output; token = item.output + 1; refs[item.output] = token;
            continue;
        }
        if (item.op == Deref && refs[item.left] != 0) {
            if (changed) { return failure; }
            if (ValueOwned(item.type, owners)) { borrowed[item.output] = token; }
            continue;
        }
        if (item.op == Poke && refs[item.left] != 0) {
            active = -1; token = 0; region = -1; changed = false;
            continue;
        }
        if ((right && borrowed[item.right] != 0) || (target && borrowed[item.target] != 0)) {
            // Prepared elements own their values before borrowing a place.
            // Self-extension alone supplies its own source lease in the helper.
            if (item.op != ArrayExtend || value == 0 || item.left != item.right) { return failure; }
        }
        if ((item.op == Save || item.op == Publish || item.op == OwnerPin) && value != 0) { return failure; }
        mutation := item.op == ArraySet || item.op == ArrayPush || item.op == ArrayExtend ||
                    item.op == ArrayRemove || item.op == ArrayInsert || item.op == ArrayReverse ||
                    item.op == MapSet || item.op == MapDelete;
        if (value != 0 && (mutation || item.op == ArrayDrop || item.op == ValueDrop || item.op == MapDrop)) {
            changed = true;
            if (Produces(item.op)) { borrowed[item.output] = token; }
            continue;
        }
        if (item.op == TextRetain && value != 0) { borrowed[item.left] = 0; }
        copied := item.op == ValueCopy || item.op == ArrayCopy || item.op == ArraySlice ||
                  item.op == ArrayResize || item.op == ArrayText || item.op == MapCopy || item.op == TextClone ||
                  (item.op == ArrayLoan && item.target != ArrayLoanMove);
        if (value != 0 && Produces(item.op) && ValueOwned(item.type, owners) && !copied) { borrowed[item.output] = token; }
        // These operations cannot replace an enclosing owner. Copies acquire
        // independently owned values; resize leaves the old child for its drop.
        safe := item.op == Check || item.op == Constant || item.op == Local || item.op == LocalAddress ||
                item.op == FieldAddress || item.op == Deref || item.op == Extract ||
                (item.op >= Add && item.op <= Ne) || item.op == Convert || item.op == Select ||
                item.op == ValueCopy || item.op == ArrayCopy || item.op == ArraySlice || item.op == ArrayResize ||
                item.op == ArrayLength || item.op == ArrayGet || item.op == ArrayContains || item.op == ArrayBytes ||
                item.op == ArrayText || item.op == MapCopy || item.op == MapGet || item.op == MapHas ||
                item.op == MapLength || item.op == MapSpan || item.op == MapLiveAt || item.op == MapKeyAt ||
                item.op == MapValueAt || item.op == TextRetain || item.op == TextRelease ||
                (item.op >= TextLength && item.op <= TextTake) || item.op == TextClone ||
                item.op == OwnerPin || item.op == OwnerUnpin || item.op == ManagedPin || item.op == ManagedUnpin;
        if (!safe) { active = -1; token = 0; region = -1; changed = false; }
    }
    // Regions are disjoint, so marking their used spans visits at most code
    // instructions in total. Unused trailing reference storage has no span.
    interior := resize([false], length(code));
    for (region in 0..<length(starts)) {
        for (pc in starts[region] + 1..<ends[region] + 1) { interior[pc] = true; }
    }
    // Arguments may share spans. One prefix table avoids rescanning a wide
    // argument list for every call. Indexed-loan metadata is not an SSA read.
    passed := [int(0)];
    for (slot in arguments) {
        count := passed[length(passed) - 1];
        if (Index(slot, length(slots)) && (refs[slot] != 0 || borrowed[slot] != 0)) { count += 1; }
        passed.append(count);
    }
    for (item, pc in code) {
        if ((item.op == Branch || item.op == Jump) && interior[item.target]) { return failure; }
        if (ReadsArguments(item.op) && passed[item.right + ArgumentCount(item)] != passed[item.right]) { return failure; }
        // A backward edge must not turn an earlier, apparently stable local
        // read into a read of this iteration's retired scratch address.
        if ((item.op == Local || (item.op == FieldAddress && item.target == 1)) &&
            local_refs[item.left] != 0 && pc < saved[item.left]) { return failure; }
        if (item.op == ManagedTrack && item.target == ManagedTrackLocal && local_refs[item.left] != 0) { return failure; }
    }
    return "";
}
TaskPromiseValue :: (records: Record[], fields: int[], layout: ValueLayout, managed: ManagedRecordLayout, type: int, owned: bool) -> bool {
    return TaskFramePlain(layout, type) || (owned && (type == ArrayType + PointerType ||
           TaskOwnedType(records, layout, type) || TaskFrameRoot(records, fields, managed, type)));
}
TaskResultValid :: (records: Record[], fields: int[], slots: int[], layout: ValueLayout, managed: ManagedRecordLayout, owned: bool, item: Instruction) -> bool {
    record := item.type - RecordType;
    if (!Typed(slots, item.left, TaskType) || record < 0 || record >= length(records) ||
        item.literal != 0 || item.target < 0 || item.target > 1) { return false; }
    shape := records[record];
    count := 1;
    if (item.right != 0) { count = 2; }
    return shape.count == count && fields[shape.first] == abi.IntStorage &&
           (item.right == 0 || (TaskPromiseValue(records, fields, layout, managed, item.right, owned) &&
                               fields[shape.first + 1] == item.right));
}
// The pending wait owns an observer until the scheduler has resumed this
// continuation, so a successful promise remains live throughout its read.
TaskResultInstruction :: (item: Instruction, pc: int, testing: bool, owners: bool[]) -> string {
    type := TypeName(item.type);
    out := format_text("p{}:\n{}", pc, TaskTestGuard(testing, TaskWaitEffect));
    out = format_text("{}{}", out, Load(format_text("h{}", pc), TaskType, "s", item.left));
    out = format_text("{}  %done{} = call i1 @chibi_tasks.finished(i64 %h{})\n", out, pc, pc);
    out = format_text("{}  br i1 %done{}, label %p{}.result, label %p{}.wait\np{}.wait:\n", out, pc, pc, pc, pc);
    out = format_text("{}  call void @chibi_tasks.wait(i64 %h{})\n", out, pc);
    out = format_text("{}  %suspend{} = call i8 @llvm.coro.suspend(token none, i1 false)\n", out, pc);
    out = format_text("{}  switch i8 %suspend{}, label %coro.suspend [ i8 0, label %p{}.result\n                                      i8 1, label %coro.cleanup ]\n", out, pc, pc);
    out = format_text("{}p{}.result:\n  %frame{} = call ptr @chibi_tasks.result_frame(i64 %h{}, i32 {})\n", out, pc, pc, pc, item.right);
    out = format_text("{}  %success{} = icmp ne ptr %frame{}, null\n  br i1 %success{}, label %p{}.success, label %p{}.cancelled\n", out, pc, pc, pc, pc, pc);
    out = format_text("{}p{}.cancelled:\n  %cancelled{} = insertvalue {} zeroinitializer, i32 {}, 0\n", out, pc, pc, type, 1 - item.target);
    out = format_text("{}{}  br label %p{}\n", out, Store(format_text("%cancelled{}", pc), item.type, "s", item.output), pc + 1);
    out = format_text("{}p{}.success:\n  %tagged{} = insertvalue {} zeroinitializer, i32 {}, 0\n", out, pc, pc, type, item.target);
    value := format_text("%tagged{}", pc);
    if (item.right != 0) {
        out = format_text("{}  %promise{} = call ptr @llvm.coro.promise(ptr %frame{}, i32 8, i1 false)\n", out, pc, pc);
        out = format_text("{}  %payload{} = load {}, ptr %promise{}\n", out, pc, TypeName(item.right), pc);
        payload := format_text("%payload{}", pc);
        if (item.right == abi.TextStorage) {
            out = format_text("{}  %payload.owner{} = extractvalue {} {}, 2\n  call void @chibi_scalar.retain(ptr %payload.owner{})\n", out, pc, TypeName(item.right), payload, pc);
        } else if (ValueOwned(item.right, owners)) {
            helper := "chibi_value";
            if (item.right >= ArrayType) { helper = "chibi_array"; }
            out = format_text("{}  %payload.copy{} = call {} @{}.{}.copy(ptr %ctx, {} {})\n", out, pc, TypeName(item.right), helper, item.right, TypeName(item.right), payload);
            payload = format_text("%payload.copy{}", pc);
        }
        out = format_text("{}  %joined{} = insertvalue {} %tagged{}, {} {}, 1\n", out, pc, type, pc, TypeName(item.right), payload);
        value = format_text("%joined{}", pc);
    }
    return format_text("{}{}  br label %p{}\n", out, Store(value, item.type, "s", item.output), pc + 1);
}
// Final suspension keeps the promise owned by its frame. Destroy, whether
// after completion or cancellation, clears that slot before releasing it.
TaskPromiseCleanup :: (type: int, owned: bool) -> string {
    if (!owned) { return ""; }
    return strings.Concatenate([
        format_text("  %promise.value = load {}, ptr %result0\n  store {} zeroinitializer, ptr %result0\n", TypeName(type), TypeName(type)),
        TaskDropValue(type, "promise", "%promise.value")]);
}
// All owning observer locations are initialized to zero. Moving or dropping
// one clears it, making the same cleanup safe on normal and cancelled exits.
TaskFrameCleanup :: (shape: Function, locals: int[], code: Instruction[], prefix: string) -> string {
    out: string[] = [];
    for (index in 0..<shape.locals) {
        if (locals[shape.first_local + index] != TaskType) { continue; }
        out.append(format_text("  %{}.l{} = load i64, ptr %l{}\n  store i64 0, ptr %l{}\n  call void @chibi_tasks.release(i64 %{}.l{})\n", prefix, index, index, index, prefix, index));
    }
    for (pc in 0..<shape.code) {
        item := code[shape.first_code + pc];
        if (item.type != TaskType || (item.op != TaskCopy && item.op != Call)) { continue; }
        out.append(format_text("  %{}.s{} = load i64, ptr %s{}\n  store i64 0, ptr %s{}\n  call void @chibi_tasks.release(i64 %{}.s{})\n", prefix, item.output, item.output, item.output, prefix, item.output));
    }
    return strings.Join(out, "");
}

// Only closures that can arm a generated test scope carry these calls. The
// runtime returns while unarmed and stops the test at a named task command
// or spawn. It uses an unclassified failure, independent of ExpectFailure.
TaskTestGuard :: (testing: bool, kind: int) -> string {
    if (!testing) { return ""; }
    return format_text("  call void @chibi_native_test_busy(i32 {})\n", kind);
}
