function(snapshot_generated prefix path)
    file(SHA256 "${path}" checksum)
    if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.23)
        set(timestamp_format "%s.%f")
    else()
        set(timestamp_format "%s")
    endif()
    file(TIMESTAMP "${path}" stamp "${timestamp_format}" UTC)
    set(${prefix}_checksum "${checksum}" PARENT_SCOPE)
    set(${prefix}_stamp "${stamp}" PARENT_SCOPE)
endfunction()

function(assert_generation_unchanged prefix path)
    snapshot_generated(current "${path}")
    if(NOT current_checksum STREQUAL "${${prefix}_checksum}" OR
       NOT current_stamp STREQUAL "${${prefix}_stamp}")
        message(FATAL_ERROR "Unchanged generation rewrote ${path}")
    endif()
endfunction()
