version 3
name "DetailBarrel"
domain "model"
id_counter 14
description "Named cylindrical part for the shared cylindrical image mapping example."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 6
                type "Model Cylinder"
                inputs Radius=19.0 "Half Height"=24.0
            }
            - id=10 type="Model Part" reference_name="Barrel"
        }
        (array)edges {
            - from="6.Geometry" to="10.Geometry"
            - from="10.Geometry" to="1.Geometry"
        }
    }
}
