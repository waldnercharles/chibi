<div class="app-chrome">
  <header class="topbar">
    <div class="brand"><div class="mark"/></div>
    <nav id="menubar" class="menus"/>
    <!-- The menubar's menus, drawn natively in #menubar: each <li command>
         runs a Studio command by its id, each <li list> is a list Studio
         fills, a <li label> heads a group, <hr/> separates and a <menu> inside
         a menu is a submenu. -->
    <div id="menus">
      <menu label="File">
        <menu label="New">
          <li list="newProject"/>
          <hr/>
          <li command="newScene"/>
          <li command="newPrototype"/>
          <hr/>
          <li command="newBehavior"/>
          <li command="newEvent"/>
          <li command="newSystem"/>
          <li command="newLibrary"/>
          <hr/>
          <li command="newMaterial"/>
          <li command="newShape"/>
          <li command="newField"/>
          <li command="newShaderLibrary"/>
          <hr/>
          <li command="newUiWidget"/>
          <li command="newUiDocument"/>
          <li command="newStylesheet"/>
        </menu>
        <li command="search"/>
        <li list="projects"/>
        <hr/>
        <li command="save"/>
        <li command="reload"/>
        <li list="webProjects"/>
        <hr/>
        <li command="settings"/>
      </menu>
      <menu label="Edit">
        <li command="undo"/>
        <li command="redo"/>
        <hr/>
        <li command="cut"/>
        <li command="copy"/>
        <li command="paste"/>
        <li command="duplicate"/>
        <li command="rename"/>
        <li command="delete"/>
        <hr/>
        <li command="selectAll"/>
        <li command="deselect"/>
        <li command="find"/>
      </menu>
      <menu label="View">
        <li command="frame"/>
        <li command="frameAll"/>
        <li command="resetCamera"/>
        <hr/>
        <li command="hideSelected"/>
        <li command="hideUnselected"/>
        <li command="showAll"/>
        <hr/>
        <li command="showLiveValues"/>
        <hr/>
        <li label="Drawers"/>
        <li command="toggleAssets"/>
        <li command="toggleOutput"/>
        <li command="togglePerformance"/>
        <hr/>
        <li command="inspectElement"/>
        <hr/>
        <li label="Layout Mode"/>
        <li command="workspaceHorizontalSplit"/>
        <li command="workspaceVerticalSplit"/>
        <li command="toggleSidePane"/>
        <li command="maximize"/>
        <li command="resetLayout"/>
        <hr/>
        <li list="uiScale"/>
      </menu>
      <menu label="Object">
        <li list="add"/>
        <li command="duplicate"/>
        <li command="rename"/>
        <li command="delete"/>
        <hr/>
        <li command="openPrototype"/>
        <li command="applyOverrides"/>
        <li command="saveAsPrototype"/>
        <li command="addComponent"/>
        <hr/>
        <menu label="Transform">
          <li command="selectTool"/>
          <li command="moveTool"/>
          <li command="rotateTool"/>
          <li command="scaleTool"/>
          <hr/>
          <li command="grab"/>
          <li command="toggleSnap"/>
          <li command="finerGrid"/>
          <li command="coarserGrid"/>
        </menu>
        <hr/>
        <li command="keepChanges"/>
      </menu>
      <menu label="Play">
        <li command="play"/>
        <li command="stop"/>
        <li command="step"/>
        <hr/>
        <li list="debugger"/>
      </menu>
      <menu label="Help">
        <li command="keyboardShortcuts"/>
      </menu>
    </div>
    <div id="layout"/>
    <div class="sep"/>

    <div class="spacer"/>
    <div class="transport">
      <div id="play-target"/>
      <div class="group">
        <button class="btn icon-only" data-attr-data-tip="commands.play.label" data-attr-data-kbd="commands.play.shortcut" data-attr-data-state="editor.playing && !editor.paused ? 'on' : 'off'" data-event-click="emit('studio.play')" data-attrif-data-disabled="!commands.play.enabled"><span class="icon">{{ commands.play.icon }}</span></button>
        <button class="btn icon-only" data-attr-data-tip="commands.stop.label" data-attrif-data-disabled="!commands.stop.enabled" data-event-click="emit('studio.stop')"><span class="icon">{{ commands.stop.icon }}</span></button>
        <button class="btn icon-only" data-if="!editor.paused" data-attr-data-tip="commands.step.label" data-event-click="emit('studio.step')" data-attrif-data-disabled="!commands.step.enabled"><span class="icon">{{ commands.step.icon }}</span></button>
        <div id="debug-steps"/>
      </div>
    </div>
    <div class="spacer"/>
    <button class="btn collaboration-trigger" data-attr-data-tip="commands.collaboration.label" data-attr-data-state="collaboration.connected ? 'on' : 'off'" data-event-click="emit('studio.collaboration')"><span class="icon">{{ commands.collaboration.icon }}</span><span class="label">Collab</span></button>
    <div class="sep"/>
    <button class="btn icon-only side-pane" data-attr-data-tip="commands.toggleSidePane.label" data-attr-data-state="commands.toggleSidePane.checked ? 'on' : 'off'" data-event-click="emit('studio.toggleSidePane')"><span class="icon">{{ commands.toggleSidePane.icon }}</span></button>
    <button class="btn icon-only" data-attr-data-tip="commands.settings.label" data-attr-data-kbd="commands.settings.shortcut" data-event-click="emit('studio.settings')"><span class="icon">{{ commands.settings.icon }}</span></button>
    <button class="btn search-trigger" data-attr-data-tip="commands.search.label" data-attr-data-kbd="commands.search.shortcut" data-event-click="emit('studio.search')"><span class="icon">{{ commands.search.icon }}</span><span class="label">{{ commands.search.label }}</span><span class="kbd">{{ commands.search.shortcut }}</span></button>
  </header>
  <nav class="doc-tabs">
    <div class="btn doc-tab" data-for="tab, i : editor.tabs" data-attr-data-state="tab.active ? 'on' : 'off'">
      <span class="face" data-attr-data-tip="tab.path != '' ? tab.path : tab.label" data-event-click="emit('studio.selectTab', i)"><span class="icon">{{ tab.icon }}</span><span class="label">{{ tab.label }}</span><span class="dirty-dot" data-if="tab.dirty"/></span>
      <button class="btn sm icon-only doc-close" data-if="tab.closable" data-attr-data-tip="commands.closeTab.label" data-event-click="emit('studio.closeTab', i)"><span class="icon">&#xea76;</span></button>
    </div>
  </nav>
</div>
