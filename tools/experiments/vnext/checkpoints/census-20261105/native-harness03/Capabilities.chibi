package source_census

// Supplemental capability tests, never a replacement for exact Main.chibi.
ReadForward :: (input: BorrowedBytes, index: i64) -> i64 {
    return byte_read_checked(input, index);
}
pub ProbeRead :: (input: BorrowedBytes, index: i64) -> i64 {
    return ReadForward(input, index);
}
pub ProbeLength :: (input: BorrowedBytes) -> i64 { return byte_length(input); }
pub ProbeMerge :: (left: BorrowedBytes, right: BorrowedBytes, choose: bool, index: i64) -> i64 {
    selected := left;
    if (choose) { selected = right; }
    return ReadForward(selected, index);
}
pub ProbeSub :: (left: i64, right: i64) -> i64 { return left - right; }
pub ProbeLoops :: (outer: i64, inner: i64) -> i64 {
    i: i64 = 0;
    total: i64 = 0;
    while (outer > i) {
        j: i64 = 0;
        while (inner > j) { total = total + i + j; j = j + 1; }
        i = i + 1;
    }
    return total;
}
pub ProbeReport :: () -> i64 {
    return chibi_census_report(101, (0 - 202), 303, (0 - 404), 505, (0 - 606), 707, (0 - 808),
        909, (0 - 1010), 1111, (0 - 1212), 1313, (0 - 1414), 1515, (0 - 1616));
}
