+
+// Full-SDK composition consumes an existing, privately owned installation stage.
+// The packager owns that stage and publication; these entries never replace it.
+// Both entries take paired --prefix, --build-host, --compiler-host, --assembly
+// and --compiler-backend arguments. Preparation also takes --policy-source.
+// All roles name the fixed installed paths below the canonical prefix.
+// The cold inspection cache is the absent PREFIX.project-cache sibling inside
+// the packager's temporary parent. Inspect must leave it absent.
+InstalledEntries :: (stage: string) -> string[] {
+    entries: string[] = [];
+    for (path in ["libexec/chibi/chibi-build-host", "libexec/chibi/chibi-compiler-host",
+                  "bin/chibi-compile", "share/chibi/compiler", "share/chibi/core",
+                  "share/chibi/tools/toolchain/SDK.chibi", PolicyOutputs()[0]]) {
+        entries = build.concat(entries, [Join([path, "=", stage, "/", path])]);
+    }
+    return entries;
+}
+// Entry order and each directory's sorted walk define the producer row order.
+// Unrelated public files and the full package identity never enter this TSV.
+InstalledInventory :: (stage: string, entries: string[], inputs: bool) -> string {
+    text := "";
+    outputs := PolicyOutputs();
+    for (item in entries) {
+        path := build.before(item, "=");
+        if (!inputs || !PolicyHas(outputs, path)) {
+            text = Join([text, Inventory(stage, path)]);
+        }
+    }
+    if (!inputs) {
+        for (index in 1..<length(outputs)) {
+            text = Join([text, Inventory(stage, outputs[index])]);
+        }
+    }
+    return text;
+}
+InstalledArguments :: (arguments: string[], prepare: bool) -> bool {
+    keys := ["--prefix", "--build-host", "--compiler-host", "--assembly", "--compiler-backend"];
+    if (prepare) {
+        keys = build.concat(keys, ["--policy-source"]);
+    }
+    if (length(arguments) != length(keys) * 2) {
+        return false;
+    }
+    seen: string[] = [];
+    for (index in 0..<length(keys)) {
+        key := arguments[index * 2];
+        if (!PolicyHas(keys, key) || PolicyHas(seen, key) || arguments[index * 2 + 1] == "") {
+            return false;
+        }
+        seen = build.concat(seen, [key]);
+    }
+    stage := Option(arguments, "--prefix");
+    backend := Option(arguments, "--compiler-backend");
+    if (!strings.HasPrefix(stage, "/") || CanonicalPath(stage) != stage ||
+        build.file_kind(stage) != "directory" ||
+        (backend != "sljit" && backend != "bytecode") ||
+        (build.platform() != "Darwin" && build.platform() != "Linux")) {
+        return false;
+    }
+    roles := ["--build-host", "libexec/chibi/chibi-build-host",
+              "--compiler-host", "libexec/chibi/chibi-compiler-host",
+              "--assembly", "bin/chibi-compile"];
+    for (index in 0..<3) {
+        path := Join([stage, "/", roles[index * 2 + 1]]);
+        if (Option(arguments, roles[index * 2]) != path || CanonicalPath(path) != path ||
+            build.file_kind(path) != "file" || build.find_executable(path) == "") {
+            return false;
+        }
+    }
+    for (path in ["share/chibi/compiler", "share/chibi/core", "share/chibi/tools/toolchain/SDK.chibi"]) {
+        absolute := Join([stage, "/", path]);
+        if (CanonicalPath(absolute) != absolute || !SameTree(absolute, absolute)) {
+            return false;
+        }
+    }
+    if (build.file_kind(Join([stage, "/share/chibi/compiler"])) != "directory" ||
+        build.file_kind(Join([stage, "/share/chibi/core"])) != "directory" ||
+        build.file_kind(Join([stage, "/share/chibi/tools/toolchain/SDK.chibi"])) != "file") {
+        return false;
+    }
+    native_policy := Join([stage, "/share/chibi/compiler/NativeBuildFiles.txt"]);
+    if (build.file_kind(native_policy) != "file") { return false; }
+    for (relative in build.lines(build.read_file(native_policy))) {
+        if (relative != "" && build.file_kind(Join([stage, "/share/chibi/compiler/", relative])) != "") {
+            return false;
+        }
+    }
+    if (prepare) {
+        source := Option(arguments, "--policy-source");
+        return strings.HasPrefix(source, "/") && build.file_kind(source) == "file";
+    }
+    return true;
+}
+InstalledStable :: (stage: string, arguments: string[], values: string[], entries: string[]) -> bool {
+    for (key in ["source-sha256", "artifact-sha256", "build-host-sha256",
+                 "compiler-host-sha256", "assembly-sha256", "inputs-sha256"]) {
+        if (!PolicyHash(Option(values, key))) {
+            return false;
+        }
+    }
+    return build.join(PolicyValues(stage, arguments, InstalledInventory(stage, entries, true)), "\n") ==
+               build.join(values, "\n") &&
+           build.hash_file(Option(arguments, "--policy-source")) == Option(values, "source-sha256");
+}
+InstalledVerified :: (stage: string, arguments: string[], entries: string[]) -> bool {
+    values := PolicyValues(stage, arguments, InstalledInventory(stage, entries, true));
+    inventory := Join(["1\n", InstalledInventory(stage, entries, false)]);
+    outputs := PolicyOutputs();
+    witness := PolicyWitness(values);
+    receipt := PolicyReceiptText(values, entries);
+    return InstalledStable(stage, arguments, values, entries) &&
+           build.read_file(Join([stage, "/", outputs[2]])) == witness &&
+           build.read_file(Join([stage, "/", outputs[3]])) == receipt &&
+           build.read_file(Join([stage, "/share/chibi/compiler-tools.tsv"])) == inventory &&
+           PolicyInspect(stage, arguments, false) && PolicyInspect(stage, arguments, true) &&
+           InstalledStable(stage, arguments, values, entries) &&
+           build.read_file(Join([stage, "/", outputs[2]])) == witness &&
+           build.read_file(Join([stage, "/", outputs[3]])) == receipt &&
+           build.read_file(Join([stage, "/share/chibi/compiler-tools.tsv"])) == inventory &&
+           inventory == Join(["1\n", InstalledInventory(stage, entries, false)]);
+}
+PrepareInstalledProject :: () -> int {
+    arguments := build.arguments();
+    if (!InstalledArguments(arguments, true)) {
+        build.report("sdk: invalid installed Project preparation arguments or payload");
+        return 2;
+    }
+    stage := Option(arguments, "--prefix");
+    outputs := PolicyOutputs();
+    for (path in build.concat(outputs, ["share/chibi/compiler-tools.tsv", ".project-proof"])) {
+        if (build.file_kind(Join([stage, "/", path])) != "") {
+            build.report("sdk: installed Project preparation requires fresh outputs");
+            return 2;
+        }
+    }
+    entries := InstalledEntries(stage);
+    before := InstalledInventory(stage, entries, true);
+    if (!build.copy_file(Option(arguments, "--policy-source"), Join([stage, "/", outputs[0]])) ||
+        !VerifyInputs(stage) || before != InstalledInventory(stage, entries, true) ||
+        !PolicyExport(stage, Join([stage, "/", outputs[0]]), "Inspect", Join([stage, "/", outputs[1]]))) {
+        build.report("sdk: installed Project preparation failed");
+        return 1;
+    }
+    values := PolicyValues(stage, arguments, before);
+    if (!InstalledStable(stage, arguments, values, entries) || !PolicyProof(stage) ||
+        !InstalledStable(stage, arguments, values, entries) ||
+        !build.write_file(Join([stage, "/", outputs[2]]), PolicyWitness(values)) ||
+        !build.write_file(Join([stage, "/", outputs[3]]), PolicyReceiptText(values, entries)) ||
+        !build.write_file(Join([stage, "/share/chibi/compiler-tools.tsv"]),
+                          Join(["1\n", InstalledInventory(stage, entries, false)])) ||
+        !InstalledVerified(stage, arguments, entries)) {
+        build.report("sdk: installed Project witness, inventory or readiness failed");
+        return 1;
+    }
+    return 0;
+}
+VerifyInstalledProject :: () -> int {
+    arguments := build.arguments();
+    if (!InstalledArguments(arguments, false)) {
+        build.report("sdk: invalid installed Project verification arguments or payload");
+        return 2;
+    }
+    stage := Option(arguments, "--prefix");
+    arguments = build.concat(arguments, ["--policy-source", Join([stage, "/", PolicyOutputs()[0]])]);
+    if (!InstalledVerified(stage, arguments, InstalledEntries(stage))) {
+        build.report("sdk: installed Project verification failed");
+        return 1;
+    }
+    return 0;
+}
