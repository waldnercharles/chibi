+// Test-only physical layout transform. Each function keeps its entry and span;
+// reverse its remaining blocks, repacking both block-owned tables. ValueIDs,
+// operand IDs, edge/call IDs and their argument spans retain their identities.
+// Reversing twice is the identity, including instruction definition IDs.
+ReverseBlockLayout :: (original: typed.Module) -> typed.Module {
+    output := original;
+    blocks: typed.Block[] = [];
+    parameters: u32[] = [];
+    instructions: typed.Instruction[] = [];
+    values := original.values;
+    block_ids := resize([u32(0)], length(original.blocks));
+    for (function in original.functions) {
+        first := int(function.first_block);
+        count := int(function.block_count);
+        for (ordinal in 0..<count) {
+            old_index := first;
+            if (ordinal != 0) { old_index = first + count - ordinal; }
+            new_id := u32(length(blocks) + 1);
+            block_ids[old_index] = new_id;
+            block := original.blocks[old_index];
+            moved := block;
+            moved.first_parameter = 0;
+            if (block.parameter_count != 0) { moved.first_parameter = u32(length(parameters)); }
+            moved.first_instruction = u32(length(instructions));
+            for (at in int(block.first_parameter)..<int(block.first_parameter + block.parameter_count)) {
+                id := original.block_parameters[at];
+                parameters.append(id);
+                value := values[int(id) - 1];
+                value.definition = typed.BlockDefinition | new_id;
+                values[int(id) - 1] = value;
+            }
+            for (at in int(block.first_instruction)..<int(block.first_instruction + block.instruction_count)) {
+                instruction := original.instructions[at];
+                instructions.append(instruction);
+                if (instruction.result != 0) {
+                    value := values[int(instruction.result) - 1];
+                    value.definition = u32(length(instructions));
+                    values[int(instruction.result) - 1] = value;
+                }
+            }
+            blocks.append(moved);
+        }
+    }
+    edges := original.edges;
+    for (edge, index in original.edges) {
+        moved := edge;
+        moved.target = block_ids[int(edge.target) - 1];
+        edges[index] = moved;
+    }
+    output.blocks = blocks;
+    output.block_parameters = parameters;
+    output.instructions = instructions;
+    output.values = values;
+    output.edges = edges;
+    return output;
+}
+
+CheckBlockLayouts :: () {
+    sources: string[] = [
+        "package p\nF :: (b: bool, x: i64) -> i64 { if (b) { x = x + 1; } return x + 7; }\n",
+        "package p\nF :: (n: i64) -> i64 { x: i64 = 0; while (n > x) { x = x + 1; } return x + 7; }\n",
+        "package p\nF :: (n: i64) -> i64 { x: i64 = 0; while (n > x) { y: i64 = 0; while (n > y) { x = x + y; y = y + 1; } } return x; }\n",
+        "package p\nF :: (b: bool, x: i64) -> i64 { while (b) { if (x > 7) { return x; } x = Read(x); } return x; }\nRead :: (x: i64) -> i64 { if (x > 0) { return x + 1; } return 0; }\n"
+    ];
+    counts: int[] = [3, 4, 7, 9];
+    for (source, index in sources) {
+        original := Accepted(source);
+        assert(length(original.blocks) == counts[index], "independent source CFG block count");
+        moved := ReverseBlockLayout(original);
+        error := typed.Verify(moved);
+        assert(error == 0, "DAG and cyclic dominance do not depend on physical block order");
+        restored := ReverseBlockLayout(moved);
+        CheckEqual(original, restored);
+        CheckEqual(original, Accepted(source));
+    }
+    // Old blocks [entry, body, merge] become [entry, merge, body]. The
+    // merge use precedes the body's instructions physically, not semantically.
+    dag := ReverseBlockLayout(Accepted(sources[0]));
+    assert(dag.edges[0].target == 3 && dag.edges[1].target == 2 && dag.edges[2].target == 2,
+           "known permutation remaps both branch targets and the merge edge");
+    assert(dag.blocks[1].parameter_count == 1 && dag.blocks[2].parameter_count == 0,
+           "parameter-bearing merge moves with its owned span");
+}
