-                                 .compiler = sources,
-                                 .core = core,
-                                 .cache = cache,
-                                 .identity = identity };
-    /* A closure that is not at hand is recovered, and kept, now. */
-    compiler_host *host = compiler_bootstrap_identity(&input, error, size)
-                            ? NULL
-                            : compiler_bootstrap_load(&input, error, size);
