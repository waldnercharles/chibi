# Verify source and link ownership after all product targets have been declared.
function(chibi_require_no_editor target)
    set(pending ${target})
    set(visited)
    while(pending)
        list(POP_FRONT pending current)
        if(current IN_LIST visited OR NOT TARGET ${current})
            continue()
        endif()
        list(APPEND visited ${current})
        if(current STREQUAL "editor" OR current STREQUAL "chibi_rmlui" OR current STREQUAL "chibi_zep")
            message(FATAL_ERROR "${target} depends on editor target ${current}")
        endif()
        get_target_property(sources ${current} SOURCES)
        foreach(source IN LISTS sources)
            if(source MATCHES "(^|/)src/editor/")
                message(FATAL_ERROR "${target} reaches editor source ${source} through ${current}")
            endif()
        endforeach()
        foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(dependencies ${current} ${property})
            foreach(dependency IN LISTS dependencies)
                if(dependency MATCHES "(^|:)editor(>|$)" OR
                   dependency MATCHES "(^|:)chibi_(rmlui|zep)(>|$)")
                    message(FATAL_ERROR "${target} reaches editor dependency ${dependency} through ${current}")
                endif()
                if(dependency MATCHES "^\\$<LINK_ONLY:([^>]+)>$")
                    list(APPEND pending "${CMAKE_MATCH_1}")
                elseif(TARGET "${dependency}")
                    list(APPEND pending "${dependency}")
                endif()
            endforeach()
        endforeach()
    endwhile()
endfunction()

chibi_require_no_editor(core)
chibi_require_no_editor(studio_schema)
chibi_require_no_editor(automation)
chibi_require_no_editor(chibi_ctl)
