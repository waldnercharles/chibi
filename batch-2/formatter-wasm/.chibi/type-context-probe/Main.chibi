package type_context_probe
import style "project:source_type_style"
import strings "core:strings"
Main :: () {
    source := "package p\nimport strings \"core:strings\"\nimport target \"core:target\"\nwhen target.Os == target.Linux { Count :: () -> i8 { return 4; } } else { Count :: () -> f64 { return 4; } }\nMain :: () { value := Count(); size := strings.ByteLength(\"hello\"); }\n";
    dependency := "package strings\n\n// String operations compare, count and offset bytes.\n// Spaces and case use ASCII. Offsets are byte offsets, and -1 means not found.\n\n// Compiler text operations use bytes, including bytes inside UTF-8 sequences.\npub ByteLength :: (value: string) -> int {\n    return text_byte_length(value);\n}\n\n// Returns -1 outside the string; valid bytes are unsigned values from 0 to 255.\n// Reads the runtime's stored byte length.\npub ByteAt :: (value: string, index: int) -> int {\n    return text_byte_at(value, index);\n}\n\n// Every byte of the string, from 0 to 255, read in one pass.\npub Bytes :: (value: string) -> int[] {\n    return text_bytes(value);\n}\n\n// Start clamps to the string and count clamps to its remaining bytes.\npub Slice :: (value: string, start: int, count: int) -> string {\n    return text_slice(value, start, count);\n}\n\npub Compare :: (left: string, right: string) -> int {\n    leftLength := ByteLength(left);\n    rightLength := ByteLength(right);\n    index: int = 0;\n    while (index < leftLength && index < rightLength) {\n        a := ByteAt(left, index);\n        b := ByteAt(right, index);\n        if (a < b) {\n            return -1;\n        }\n        if (a > b) {\n            return 1;\n        }\n        index += 1;\n    }\n    if (leftLength < rightLength) {\n        return -1;\n    }\n    if (leftLength > rightLength) {\n        return 1;\n    }\n    return 0;\n}\n\npub IsIdentifier :: (value: string) -> bool {\n    size := ByteLength(value);\n    if (size == 0) {\n        return false;\n    }\n    index: int = 0;\n    while (index < size) {\n        byte := ByteAt(value, index);\n        letter := byte == 95 || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122);\n        if (!letter && !(index > 0 && byte >= 48 && byte <= 57)) {\n            return false;\n        }\n        index += 1;\n    }\n    return true;\n}\n\npub BaseName :: (path: string) -> string {\n    size := ByteLength(path);\n    start: int = 0;\n    index: int = 0;\n    while (index < size) {\n        if (ByteAt(path, index) == 47) {\n            start = index + 1;\n        }\n        index += 1;\n    }\n    return Slice(path, start, size - start);\n}\n\npub Contains :: (s: string, substr: string) -> bool {\n    return Index(s, substr) >= 0;\n}\n\npub ContainsAny :: (s: string, chars: string) -> bool {\n    return IndexAny(s, chars) >= 0;\n}\n\npub HasPrefix :: (s: string, prefix: string) -> bool {\n    size := ByteLength(prefix);\n    return ByteLength(s) >= size && Slice(s, 0, size) == prefix;\n}\n\npub HasSuffix :: (s: string, suffix: string) -> bool {\n    size := ByteLength(s);\n    count := ByteLength(suffix);\n    return size >= count && Slice(s, size - count, count) == suffix;\n}\n\npub IndexByte :: (s: string, c: int) -> int {\n    size := ByteLength(s);\n    i: int = 0;\n    while (i < size) {\n        if (ByteAt(s, i) == c) {\n            return i;\n        }\n        i += 1;\n    }\n    return -1;\n}\n\npub LastIndexByte :: (s: string, c: int) -> int {\n    i: int = ByteLength(s) - 1;\n    while (i >= 0) {\n        if (ByteAt(s, i) == c) {\n            return i;\n        }\n        i -= 1;\n    }\n    return -1;\n}\n\n// Verify hash hits byte for byte.\nMatchesAt :: (s: string, substr: string, start: int) -> bool {\n    i: int = 0;\n    while (i < ByteLength(substr)) {\n        if (ByteAt(s, start + i) != ByteAt(substr, i)) {\n            return false;\n        }\n        i += 1;\n    }\n    return true;\n}\n\n// Search from a byte offset without copying.\nIndexFrom :: (s: string, substr: string, start: int) -> int {\n    n := ByteLength(substr);\n    size := ByteLength(s);\n    if (n == 0) {\n        return start;\n    }\n    if (n > size - start) {\n        return -1;\n    }\n    if (n == 1) {\n        c := ByteAt(substr, 0);\n        i := start;\n        while (i < size) {\n            if (ByteAt(s, i) == c) {\n                return i;\n            }\n            i += 1;\n        }\n        return -1;\n    }\n    hash: i64 = 0;\n    pow: i64 = 1;\n    h: i64 = 0;\n    i: int = 0;\n    while (i < n) {\n        hash = (hash * 16777619 + i64(ByteAt(substr, i))) & 0xFFFFFFFF;\n        pow = (pow * 16777619) & 0xFFFFFFFF;\n        h = (h * 16777619 + i64(ByteAt(s, start + i))) & 0xFFFFFFFF;\n        i += 1;\n    }\n    i += start;\n    if (h == hash && MatchesAt(s, substr, start)) {\n        return start;\n    }\n    while (i < size) {\n        h = (h * 16777619 + i64(ByteAt(s, i)) - pow * i64(ByteAt(s, i - n))) & 0xFFFFFFFF;\n        i += 1;\n        if (h == hash && MatchesAt(s, substr, i - n)) {\n            return i - n;\n        }\n    }\n    return -1;\n}\n\n// Uses a 32-bit Rabin-Karp rolling hash. An empty substring is found at 0.\npub Index :: (s: string, substr: string) -> int {\n    return IndexFrom(s, substr, 0);\n}\n\n// Index's search from the end. An empty substring is found at the length of s.\npub LastIndex :: (s: string, substr: string) -> int {\n    n := ByteLength(substr);\n    size := ByteLength(s);\n    if (n == 0) {\n        return size;\n    }\n    if (n == 1) {\n        return LastIndexByte(s, ByteAt(substr, 0));\n    }\n    if (n == size) {\n        if (s == substr) {\n            return 0;\n        }\n        return -1;\n    }\n    if (n > size) {\n        return -1;\n    }\n    hash: i64 = 0;\n    pow: i64 = 1;\n    h: i64 = 0;\n    i: int = 0;\n    while (i < n) {\n        hash = (hash * 16777619 + i64(ByteAt(substr, n - 1 - i))) & 0xFFFFFFFF;\n        pow = (pow * 16777619) & 0xFFFFFFFF;\n        h = (h * 16777619 + i64(ByteAt(s, size - 1 - i))) & 0xFFFFFFFF;\n        i += 1;\n    }\n    i = size - n;\n    if (h == hash && Slice(s, i, n) == substr) {\n        return i;\n    }\n    i -= 1;\n    while (i >= 0) {\n        h = (h * 16777619 + i64(ByteAt(s, i)) - pow * i64(ByteAt(s, i + n))) & 0xFFFFFFFF;\n        if (h == hash && Slice(s, i, n) == substr) {\n            return i;\n        }\n        i -= 1;\n    }\n    return -1;\n}\n\n// The offset of the first byte of s that is any byte of chars.\npub IndexAny :: (s: string, chars: string) -> int {\n    size := ByteLength(s);\n    i: int = 0;\n    while (i < size) {\n        if (IndexByte(chars, ByteAt(s, i)) >= 0) {\n            return i;\n        }\n        i += 1;\n    }\n    return -1;\n}\n\npub LastIndexAny :: (s: string, chars: string) -> int {\n    i: int = ByteLength(s) - 1;\n    while (i >= 0) {\n        if (IndexByte(chars, ByteAt(s, i)) >= 0) {\n            return i;\n        }\n        i -= 1;\n    }\n    return -1;\n}\n\n// Non-overlapping occurrences. An empty substring occurs at every byte\n// boundary, one more than the byte length.\npub Count :: (s: string, substr: string) -> int {\n    n := ByteLength(substr);\n    if (n == 0) {\n        return ByteLength(s) + 1;\n    }\n    total: int = 0;\n    if (n == 1) {\n        c := ByteAt(substr, 0);\n        size := ByteLength(s);\n        i: int = 0;\n        while (i < size) {\n            if (ByteAt(s, i) == c) {\n                total += 1;\n            }\n            i += 1;\n        }\n        return total;\n    }\n    start: int = 0;\n    while (true) {\n        i := IndexFrom(s, substr, start);\n        if (i < 0) {\n            break;\n        }\n        total += 1;\n        start = i + n;\n    }\n    return total;\n}\n\n// Everything before the first c, or all of s when c is absent.\npub TruncateToByte :: (s: string, c: int) -> string {\n    n := IndexByte(s, c);\n    if (n < 0) {\n        return s;\n    }\n    return Slice(s, 0, n);\n}\n\n// ASCII letters match in either case; every other byte must be equal.\npub EqualFold :: (u: string, v: string) -> bool {\n    size := ByteLength(u);\n    if (size != ByteLength(v)) {\n        return false;\n    }\n    i: int = 0;\n    while (i < size) {\n        sr := ByteAt(u, i);\n        tr := ByteAt(v, i);\n        if (tr < sr) {\n            swap := sr;\n            sr = tr;\n            tr = swap;\n        }\n        if (tr != sr && !(sr >= 65 && sr <= 90 && tr == sr + 32)) {\n            return false;\n        }\n        i += 1;\n    }\n    return true;\n}\n\n// ASCII letters only; other bytes, including those of UTF-8 sequences, stay.\npub ToLower :: (s: string) -> string {\n    size := ByteLength(s);\n    result: string = \"\";\n    start: int = 0;\n    i: int = 0;\n    while (i < size) {\n        c := ByteAt(s, i);\n        if (c >= 65 && c <= 90) {\n            letter := Slice(\"abcdefghijklmnopqrstuvwxyz\", c - 65, 1);\n            result = format_text(\"{}{}{}\", result, Slice(s, start, i - start), letter);\n            start = i + 1;\n        }\n        i += 1;\n    }\n    if (start == 0) {\n        return s;\n    }\n    return format_text(\"{}{}\", result, Slice(s, start, size - start));\n}\n\npub ToUpper :: (s: string) -> string {\n    size := ByteLength(s);\n    result: string = \"\";\n    start: int = 0;\n    i: int = 0;\n    while (i < size) {\n        c := ByteAt(s, i);\n        if (c >= 97 && c <= 122) {\n            letter := Slice(\"ABCDEFGHIJKLMNOPQRSTUVWXYZ\", c - 97, 1);\n            result = format_text(\"{}{}{}\", result, Slice(s, start, i - start), letter);\n            start = i + 1;\n        }\n        i += 1;\n    }\n    if (start == 0) {\n        return s;\n    }\n    return format_text(\"{}{}\", result, Slice(s, start, size - start));\n}\n\n// Tab, line feed, vertical tab, form feed, carriage return and space.\npub IsAsciiSpace :: (c: int) -> bool {\n    return c == 32 || (c >= 9 && c <= 13);\n}\n\n// Removes the leading bytes that are bytes of cutset.\npub TrimLeft :: (s: string, cutset: string) -> string {\n    size := ByteLength(s);\n    i: int = 0;\n    while (i < size && IndexByte(cutset, ByteAt(s, i)) >= 0) {\n        i += 1;\n    }\n    return Slice(s, i, size - i);\n}\n\npub TrimRight :: (s: string, cutset: string) -> string {\n    i := ByteLength(s);\n    while (i > 0 && IndexByte(cutset, ByteAt(s, i - 1)) >= 0) {\n        i -= 1;\n    }\n    return Slice(s, 0, i);\n}\n\npub Trim :: (s: string, cutset: string) -> string {\n    return TrimRight(TrimLeft(s, cutset), cutset);\n}\n\npub TrimLeftSpace :: (s: string) -> string {\n    size := ByteLength(s);\n    i: int = 0;\n    while (i < size && IsAsciiSpace(ByteAt(s, i))) {\n        i += 1;\n    }\n    return Slice(s, i, size - i);\n}\n\npub TrimRightSpace :: (s: string) -> string {\n    i := ByteLength(s);\n    while (i > 0 && IsAsciiSpace(ByteAt(s, i - 1))) {\n        i -= 1;\n    }\n    return Slice(s, 0, i);\n}\n\npub TrimSpace :: (s: string) -> string {\n    return TrimRightSpace(TrimLeftSpace(s));\n}\n\npub TrimPrefix :: (s: string, prefix: string) -> string {\n    if (HasPrefix(s, prefix)) {\n        return Slice(s, ByteLength(prefix), ByteLength(s));\n    }\n    return s;\n}\n\npub TrimSuffix :: (s: string, suffix: string) -> string {\n    if (HasSuffix(s, suffix)) {\n        return Slice(s, 0, ByteLength(s) - ByteLength(suffix));\n    }\n    return s;\n}\n\n// The count bytes from offset, or all bytes from offset when count is below 1.\n// An offset outside s keeps all of s. A count past the end keeps the rest.\npub Cut :: (s: string, offset: int, count: int) -> string {\n    rest: string = s;\n    size := ByteLength(s);\n    if (offset >= 0 && offset < size) {\n        rest = Slice(s, offset, size - offset);\n    }\n    if (count < 1 || count >= ByteLength(rest)) {\n        return rest;\n    }\n    return Slice(rest, 0, count);\n}\n\n// Produces at most n parts, or every part when n is negative.\n// The last part holds the rest of s. Each other part keeps the first keep\n// bytes of the separator after it. An empty separator splits s into bytes.\nSplitKeeping :: (s: string, sep: string, keep: int, n: int) -> string[] {\n    parts: string[] = [];\n    size := ByteLength(sep);\n    limit := n;\n    if (size == 0) {\n        count := ByteLength(s);\n        if (limit < 0 || limit > count) {\n            limit = count;\n        }\n        while (length(parts) < limit - 1) {\n            parts.append(Slice(s, length(parts), 1));\n        }\n        if (limit > 0) {\n            parts.append(Slice(s, limit - 1, count));\n        }\n        return parts;\n    }\n    if (limit == 0) {\n        return parts;\n    }\n    start: int = 0;\n    while (limit < 0 || length(parts) < limit - 1) {\n        m := IndexFrom(s, sep, start);\n        if (m < 0) {\n            break;\n        }\n        parts.append(Slice(s, start, m - start + keep));\n        start = m + size;\n    }\n    if (start == 0) {\n        parts.append(s);\n        return parts;\n    }\n    parts.append(Slice(s, start, ByteLength(s) - start));\n    return parts;\n}\n\npub Split :: (s: string, sep: string) -> string[] {\n    return SplitKeeping(s, sep, 0, -1);\n}\n\npub SplitN :: (s: string, sep: string, n: int) -> string[] {\n    return SplitKeeping(s, sep, 0, n);\n}\n\npub SplitAfter :: (s: string, sep: string) -> string[] {\n    return SplitKeeping(s, sep, ByteLength(sep), -1);\n}\n\npub SplitAfterN :: (s: string, sep: string, n: int) -> string[] {\n    return SplitKeeping(s, sep, ByteLength(sep), n);\n}\n\n// Splits at line feeds; a line that ends in a carriage return loses it.\nSplitLinesKeeping :: (s: string, keep: int, n: int) -> string[] {\n    lines: string[] = [];\n    for (line in SplitKeeping(s, \"\\n\", keep, n)) {\n        lines.append(TrimSuffix(line, \"\\r\"));\n    }\n    return lines;\n}\n\npub SplitLines :: (s: string) -> string[] {\n    return SplitLinesKeeping(s, 0, -1);\n}\n\n// The lines of s as a reader sees them: split at line feeds, each without a\n// trailing carriage return, and no empty last line after a final terminator,\n// so \"\" has none and \"a\\n\" has one. SplitLines keeps that empty line.\npub Lines :: (s: string) -> string[] {\n    lines := SplitLines(s);\n    if (length(lines) > 0 && lines[length(lines) - 1] == \"\") {\n        return slice(lines, 0, length(lines) - 1);\n    }\n    return lines;\n}\n\npub SplitLinesN :: (s: string, n: int) -> string[] {\n    return SplitLinesKeeping(s, 0, n);\n}\n\npub SplitLinesAfter :: (s: string) -> string[] {\n    return SplitLinesKeeping(s, 1, -1);\n}\n\npub SplitLinesAfterN :: (s: string, n: int) -> string[] {\n    return SplitLinesKeeping(s, 1, n);\n}\n\n// The runs of bytes between ASCII spaces.\npub Fields :: (s: string) -> string[] {\n    fields: string[] = [];\n    size := ByteLength(s);\n    start: int = -1;\n    i: int = 0;\n    while (i < size) {\n        if (IsAsciiSpace(ByteAt(s, i))) {\n            if (start >= 0) {\n                fields.append(Slice(s, start, i - start));\n                start = -1;\n            }\n        } else if (start < 0) {\n            start = i;\n        }\n        i += 1;\n    }\n    if (start >= 0) {\n        fields.append(Slice(s, start, size - start));\n    }\n    return fields;\n}\n\n// Joins neighbours pairwise, so each byte is copied once per halving of the\n// part count rather than once per later part: joining a source's lines takes\n// O(bytes * log parts), not O(bytes * parts).\npub Join :: (a: string[], sep: string) -> string {\n    if (length(a) == 0) {\n        return \"\";\n    }\n    parts := a;\n    while (length(parts) > 1) {\n        merged: string[] = [];\n        i: int = 0;\n        while (i + 1 < length(parts)) {\n            merged.append(format_text(\"{}{}{}\", parts[i], sep, parts[i + 1]));\n            i += 2;\n        }\n        if (i < length(parts)) {\n            merged.append(parts[i]);\n        }\n        parts = merged;\n    }\n    return parts[0];\n}\n\npub Concatenate :: (a: string[]) -> string {\n    return Join(a, \"\");\n}\n\n// Doubles the result until it reaches the requested length.\n// A count below 1 gives an empty string.\npub Repeat :: (s: string, count: int) -> string {\n    if (count < 1) {\n        return \"\";\n    }\n    total: i64 = i64(ByteLength(s)) * i64(count);\n    result: string = s;\n    while (i64(ByteLength(result)) < total) {\n        rest: i64 = total - i64(ByteLength(result));\n        result = format_text(\"{}{}\", result, Slice(result, 0, int(rest)));\n    }\n    return result;\n}\n\n// Replaces the first n non-overlapping matches of old, or all of them when n is\n// negative. An empty old matches at every byte boundary.\npub Replace :: (s: string, old: string, new: string, n: int) -> string {\n    if (old == new || n == 0) {\n        return s;\n    }\n    matches := Count(s, old);\n    if (matches == 0) {\n        return s;\n    }\n    if (n > 0 && n < matches) {\n        matches = n;\n    }\n    size := ByteLength(s);\n    width := ByteLength(old);\n    result: string = \"\";\n    start: int = 0;\n    i: int = 0;\n    while (i < matches) {\n        j := start;\n        if (width == 0) {\n            if (i > 0) {\n                j += 1;\n            }\n        } else {\n            j += Index(Slice(s, start, size - start), old);\n        }\n        result = format_text(\"{}{}{}\", result, Slice(s, start, j - start), new);\n        start = j + width;\n        i += 1;\n    }\n    return format_text(\"{}{}\", result, Slice(s, start, size - start));\n}\n\npub ReplaceAll :: (s: string, old: string, new: string) -> string {\n    return Replace(s, old, new, -1);\n}\n\npub Remove :: (s: string, key: string, n: int) -> string {\n    return Replace(s, key, \"\", n);\n}\n\npub RemoveAll :: (s: string, key: string) -> string {\n    return Remove(s, key, -1);\n}\n\npub Parts :: struct {\n    head: string;\n    match: string;\n    tail: string;\n}\n\n// The text before the first sep, sep and the text after it; when sep is\n// absent, head is all of str and the others are empty.\npub Partition :: (str: string, sep: string) -> Parts {\n    i := Index(str, sep);\n    if (i < 0) {\n        return {head: str, match: \"\", tail: \"\"};\n    }\n    size := ByteLength(sep);\n    return {head: Slice(str, 0, i), match: sep, tail: Slice(str, i + size, ByteLength(str))};\n}\n";
    target_source := "package target\n\n// The platform a package compiles for, as constants. A compile that supplies a\n// platform replaces this file's text with the same declarations and its own\n// Os, Arch and PointerBits, so a package can select what depends on the target\n// with a `when` on them.\npub Linux: int : 1\npub Darwin: int : 2\npub Windows: int : 3\npub Web: int : 4\n\npub X86_64: int : 1\npub Arm64: int : 2\npub Wasm32: int : 3\n\npub Os: int : 0\npub Arch: int : 0\npub PointerBits: int : 0\n\n// 1 when the package compiles into a native program, 0 when it runs on the VM\n// (and in this file's own text), so a package can pick native code or the VM's\n// natives with a `when` on it.\npub Native: int : 0\n";
    paths := ["/formatter/Main.chibi", "/core/strings/Strings.chibi", "/core/target/Target.chibi"];
    sources := [source, dependency, target_source];
    for (selected in [int(0), 1]) {
        preferences := style.Defaults(); preferences.bindings = style.Explicit; preferences.analysis_target = selected;
        switch style.RewriteProjectWith(source, preferences, "/formatter", ["core"], ["/core"], paths, sources) {
            case .Rejected(message): print_string(message); assert(false, "real core context accepts preferences");
            case .Rewritten(text, changed, skipped, notes):
                print_string(format_text("target={} changed={} skipped={} notes={}\n{}", selected, changed, skipped, notes, text));
                expected := "value: i8 = Count()"; if (selected == 1) { expected = "value: f64 = Count()"; }
                assert(strings.Contains(text, expected) && strings.Contains(text, "size: int = strings.ByteLength"), "real core dependencies use selected target and compiler types");
                proof := style.ProveProjectFor(source, text, "/formatter", ["core"], ["/core"], paths, sources, selected);
                assert(proof.same, "rewrite proof uses the matching selected platform");
        }
    }
    preferences := style.Defaults(); preferences.bindings = style.OmitRedundant;
    switch style.RewriteProjectWith(target_source, preferences, "/formatter", ["core"], ["/core"], [paths[2]], [target_source]) {
        case .Rejected(message): assert(false, "target source remains available");
        case .Rewritten(text, changed, skipped, notes): assert(text == target_source && changed == 0 && notes != "", "synthesized byte ranges never edit the real target file");
    }
}
