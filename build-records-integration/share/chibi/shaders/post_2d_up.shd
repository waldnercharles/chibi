// Bloom upsample: a 3x3 tent filter of the level below, added to this level.
layout(set = 2, binding = 1) uniform sampler2D current;
layout(set = 3, binding = 1) uniform shd_uniforms {
    vec2 source_texel;
};

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 uv = params.uv, t = source_texel;
    vec3 s = texture(u_image, uv + t * vec2(-1, 1)).rgb + texture(u_image, uv + t * vec2(1, 1)).rgb +
             texture(u_image, uv + t * vec2(-1, -1)).rgb + texture(u_image, uv + t * vec2(1, -1)).rgb;
    s += 2.0 * (texture(u_image, uv + t * vec2(0, 1)).rgb + texture(u_image, uv + t * vec2(0, -1)).rgb +
                texture(u_image, uv + t * vec2(1, 0)).rgb + texture(u_image, uv + t * vec2(-1, 0)).rgb);
    s += 4.0 * texture(u_image, uv).rgb;
    return vec4(texture(current, uv).rgb + s / 16.0, 1);
}
