package remove_values

Box :: struct { values: number[]; label: string; }
Choice :: union { Empty | Value(value: number) | Boxes(values: Box[]) }

Cases :: () {
    values: int[] = [1, 2, 1];
    removed := remove_item(values, int(1));
    assert(length(values) == 3 && length(removed) == 2 && removed[0] == 2 && removed[1] == 1,
        "remove only the first matching value");
    missing := remove_item(values, int(9));
    missing[0] = 8;
    assert(values[0] == 1 && missing[0] == 8, "an absent value returns an independent array value");
    empty: int[] = [];
    assert(length(remove_item(empty, int(1))) == 0);
    text := text_from_bytes([u8(65), u8(0), u8(66)]);
    words: string[] = [text, "A", text];
    words = remove_item(words, text_from_bytes([u8(65), u8(0), u8(66)]));
    assert(length(words) == 2 && words[0] == "A" && text_byte_length(words[1]) == 3,
        "string equality includes bytes after NUL");
    nan := sqrt(-1.0);
    assert(nan != nan);
    numbers: number[] = [nan];
    assert(length(remove_item(numbers, nan)) == 1, "NaN never matches a scalar element");
    backing: number[] = [nan];
    shared: Box = {values: backing, label: text};
    boxes: Box[] = [shared];
    assert(length(remove_item(boxes, shared)) == 1,
        "the same shared array backing still compares its NaN element");
    separate: Box = {values: [nan], label: text};
    assert(length(remove_item(boxes, separate)) == 1,
        "distinct array backing has the same IEEE equality rule");
    ordinary: Box[] = [{values: [1.0, 2.0], label: text}, {values: [3.0], label: "kept"}];
    equal: Box = {values: [1.0, 2.0], label: text_from_bytes([u8(65), u8(0), u8(66)])};
    result := remove_item(ordinary, equal);
    assert(length(result) == 1 && result[0].label == "kept" && length(ordinary) == 2,
        "records compare owned leaves by value");
    alternatives: Choice[] = [Choice.Value(nan), Choice.Empty, Choice.Boxes(ordinary)];
    alternatives = remove_item(alternatives, Choice.Value(nan));
    assert(length(alternatives) == 3, "a NaN union payload does not match itself");
    alternatives = remove_item(alternatives, Choice.Empty);
    assert(length(alternatives) == 2, "only the active union alternative participates");
    alternatives = remove_item(alternatives, Choice.Boxes(ordinary));
    assert(length(alternatives) == 1);
}
Main :: () -> int { Cases(); return 0; }
