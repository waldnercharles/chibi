+    const uint8_t *library;
+    uint64_t library_length;
+    const uint8_t *symbol;
+    uint64_t symbol_length;
+    const uint32_t *parameter_types;
+    uint64_t parameter_count;
+    uint32_t result_type;
+    const void *address;
