// The public documentation site. chibi doc publishes exactly the pages listed
// here, in this order, and never scans the rest of docs/, which keeps research,
// evidence and internal records out of the site.
title "Chibi"
(array)sections {
    - {
        name "Overview"
        (array)pages {
            - {
                title "Chibi"
                source "README.md"
                output "index.html"
            }
        }
    }
    - {
        name "Learn"
        (array)pages {
            - {
                title "The Chibi language"
                source "docs/code-language.md"
                output "language.html"
            }
        }
    }
    - {
        name "Examples"
        (array)pages {
            - {
                title "Examples"
                source "docs/examples.md"
                output "examples.html"
            }
        }
    }
}
