package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Lighting")),
            data.Field.Named("components", data.Object([
                data.Field.Named("HRC2D", data.Object([
                    data.Field.Named("ambient", data.Value.Real(0.080000000000000002)),
                    data.Field.Named("bounce_hysteresis", data.Value.Real(1.0)),
                    data.Field.Named("bounce_intensity", data.Value.Real(1.0)),
                    data.Field.Named("falloff", data.Value.Real(1.0)),
                    data.Field.Named("feedback", data.Value.Bool(true)),
                    data.Field.Named("intensity", data.Value.Real(1.0)),
                    data.Field.Named("radiance_hysteresis", data.Value.Real(1.0)),
                    data.Field.Named("resolution", data.Value.Real(0.5)),
                    data.Field.Named("specular", data.Value.Real(1.0)),
                    data.Field.Named("surface_bevel", data.Value.Real(1.0)),
                    data.Field.Named("surface_depth_gain", data.Value.Real(1.0)),
                    data.Field.Named("surface_depth_history", data.Value.Real(0.65000000000000002)),
                    data.Field.Named("surface_depth_quality", data.Value.Text("Balanced")),
                    data.Field.Named("surface_depth_radius", data.Value.Real(128.0)),
                    data.Field.Named("surface_depth_visibility", data.Value.Text("Bounded segments")),
                    data.Field.Named("surface_mode", data.Value.Text("Depth thickness")),
                    data.Field.Named("surface_radius", data.Value.Real(24.0)),
                    data.Field.Named("surface_relief", data.Value.Real(1.5)),
                    data.Field.Named("surface_thickness", data.Value.Real(64.0)),
                    data.Field.Named("target_fps", data.Value.Real(60.0))
                ]))
            ]))
        ])
    );
}
