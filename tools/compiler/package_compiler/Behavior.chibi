package package_compiler

import snapshot "project:source_snapshot"
import raw "project:compiler_syntax"
import graph "project:package_graph"
import syntax "project:syntax_diagnostics"
import binding "project:lexical_binding"
import writer "project:prepared_writer"

// Compiles a behavior asset to the prepared module of the game a target
// describes: its retained states, and its event handlers, which read and
// write those states and write fields of the owner's components. Its module,
// states and handlers take the IDs stage zero gives them.

// An event the game declares; its payload is event_fields[first, first + count).
pub GameEvent :: struct {
    name: string;
    id: uint64;
    abi: uint64;
    first: int;
    count: int;
}
pub GameEventField :: struct {
    name: string;
    storage: int;
    nominal: uint64;
    has_default: bool;
    default_owner: bool;
}
// A type the game links, a component when `component` is its component ID;
// its fields are type_fields[first, first + count). A module requires every
// type but a namespace, such as SceneGlobals; types[underlying], when that is
// not -1, is the type it stands for.
pub GameType :: struct {
    required: bool;
    underlying: int;
    name: string;
    id: uint64;
    layout: uint64;
    storage: int;
    size: int;
    component: uint64;
    first: int;
    count: int;
}
// A game type's field: of the type types[record] when that is not -1; a
// constant whose value is its name; read by natives[read] when that is not
// -1, with the key `read_key` instead of the value when that is not "".
pub GameField :: struct {
    name: string;
    storage: int;
    offset: int;
    writable: bool;
    record: int;
    constant: bool;
    read: int;
    read_key: string;
}
// A native that makes a record of type types[record] of its arguments;
// argument i gives the record's field make_fields[first + i].
pub NativeMake :: struct {
    native: int;
    record: int;
    first: int;
}
// A name the game binds in every behavior, of the type types[record] when
// that is not -1.
pub GameGlobal :: struct {
    name: string;
    storage: int;
    record: int;
}
// A native that combines numbers, and records of them field by field, for a
// binary operator: natives[native].
pub NumericOperator :: struct {
    native: int;
    operator: string;
}
// A behavior's retained state, with the bits of its initial value.
StateDecl :: struct {
    name: string;
    id: uint64;
    storage: int;
    bits: uint64;
    node: int;
}
// What a module holds beyond its functions. A behavior's functions keep its
// states, and handled[i] is the event function i handles, -1 for none; its
// operators may combine records, and its globals are names.
Game :: union {
    Package
    | Behavior(kept: StateDecl[], handled: int[], declared: GameEvent[], payloads: GameEventField[],
               entity: uint64, operators: NumericOperator[], globals: GameGlobal[], makes: NativeMake[],
               make_fields: int[])
}
// Prepared function kinds.
HandlerFunction: int : 1;
// The reference kind of a component field, as the reference intrinsics take it.
ComponentReference: int : 2;
// Effects a handler declares.
ReadEffect: int : 1;
WriteEffect: int : 2;
InvocationReadEffect: int : 64;

// A behavior's names: the game's globals, its states, then `self`, its owner,
// whatever global the game names so.
BehaviorNames :: (kept_states: StateDecl[], globals: GameGlobal[]) -> Name[] {
    names: Name[] = [];
    index: int = 0;
    while (index < length(globals)) {
        bound: Name = {name: globals[index].name, place: GlobalPlace, index: index, storage: globals[index].storage,
                       container: 0, record: globals[index].record, writable: false, node: -1};
        names = array_add(names, bound);
        index += 1;
    }
    index = 0;
    while (index < length(kept_states)) {
        kept: Name = {name: kept_states[index].name, place: StatePlace, index: index,
                      storage: kept_states[index].storage, container: 0, record: -1, writable: true,
                      node: kept_states[index].node};
        names = array_add(names, kept);
        index += 1;
    }
    owner: Name = {name: "self", place: SelfPlace, index: 0, storage: HandleStorage, container: 0, record: -1,
                   writable: false, node: -1};
    return array_add(names, owner);
}
// The component of each component reference a body makes, or, when
// `written`, of each it writes through.
ComponentsOf :: (cells: Cell[], hosts: Host[], written: bool) -> uint64[] {
    found: uint64[] = [];
    for (host in hosts) {
        if (host.intrinsic == ReferenceMakeIntrinsic && cells[host.first + 2].constant == uint64(ComponentReference) &&
            (host.written || !written)) {
            found = array_add(found, cells[host.first + 6].constant);
        }
    }
    return found;
}
// Each of `items` once, in order.
Distinct :: (items: uint64[]) -> uint64[] {
    kept: uint64[] = [];
    for (item in items) {
        seen := false;
        for (known in kept) {
            if (known == item) {
                seen = true;
            }
        }
        if (!seen) {
            kept = array_add(kept, item);
        }
    }
    return kept;
}
// A handler's effects, as stage zero's analysis gives them: reading a state
// reads what the invocation retains, storing one also reads it and writes,
// reading a component reads, and writing one reads and writes.
Effects :: (ops: Ops, code: Code[], reads_components: bool, writes_components: bool) -> int {
    effects: int = 0;
    if (reads_components) {
        effects = ReadEffect;
    }
    if (writes_components) {
        effects = ReadEffect | WriteEffect;
    }
    for (instruction in code) {
        if (instruction.op == ops.variable) {
            effects = effects | ReadEffect | InvocationReadEffect;
        } else if (instruction.op == ops.store) {
            effects = effects | ReadEffect | InvocationReadEffect | WriteEffect;
        }
    }
    return effects;
}
// The game's types as native declarations of package 0, in order, a
// namespace as one no module requires; their fields are members, and a
// native type's parent is its underlying type.
NativeTypes :: (types: GameType[]) -> TypeDecl[] {
    declared: TypeDecl[] = [];
    for (linked in types) {
        kind := NativeDecl;
        if (!linked.required) {
            kind = NamespaceDecl;
        }
        row: TypeDecl = {name: linked.name, type_name: linked.name, package: 0, node: -1, kind: kind,
                         first: linked.first, count: linked.count, size: linked.size, parent: linked.underlying,
                         storage: linked.storage, id: linked.id, layout: linked.layout, component: linked.component,
                         key: 0, value_storage: 0, value_container: 0, value_record: -1};
        declared = array_add(declared, row);
    }
    return declared;
}
NativeFields :: (type_fields: GameField[]) -> TypeMember[] {
    fields: TypeMember[] = [];
    for (linked in type_fields) {
        row: TypeMember = {name: linked.name, storage: linked.storage, container: 0, record: linked.record,
                           offset: linked.offset, writable: linked.writable, constant: linked.constant,
                           read: linked.read, read_key: linked.read_key};
        fields = array_add(fields, row);
    }
    return fields;
}
// The event named `name`, matched as the catalog matches names: an exact
// name first, else the one that matches loosely; -1 for none or several.
FindEvent :: (game_events: GameEvent[], name: string) -> int {
    found: int = -1;
    index: int = 0;
    while (index < length(game_events)) {
        if (game_events[index].name == name) {
            return index;
        }
        if (NameMatches(game_events[index].name, name)) {
            if (found != -1) {
                found = -2;
            } else {
                found = index;
            }
        }
        index += 1;
    }
    if (found < 0) {
        return -1;
    }
    return found;
}
// Whether every field of an event's payload is a scalar a handler can take.
ScalarPayload :: (declared: GameEvent, event_fields: GameEventField[]) -> bool {
    at := declared.first;
    while (at < declared.first + declared.count) {
        storage := event_fields[at].storage;
        if (storage == StructStorage || storage == UnionStorage || storage <= 0) {
            return false;
        }
        at += 1;
    }
    return true;
}
// A handler's payload parameters, or why the handler cannot take them.
Payload :: union {
    Failed(diagnostic: syntax.Diagnostic) | Bound(params: Param[])
}
// The handler's parameters, one per payload field in payload order. The
// handler names fields in any order; each it leaves out gets an unnamed
// parameter, as stage zero gives it.
PayloadParams :: (forest: snapshot.SnapshotNode[], source: string, handler: int, event_name: string,
                  declared: GameEvent, event_fields: GameEventField[]) -> Payload {
    listed: int[] = [];
    at: int = 0;
    while (at < declared.count) {
        listed = array_add(listed, int(-1));
        at += 1;
    }
    parameter := FirstMember(forest, Field(forest, handler, "parameters"));
    while (parameter >= 0) {
        name := Field(forest, parameter, "name");
        spelled := Text(forest, source, name);
        at = 0;
        while (at < declared.count && !NameMatches(event_fields[declared.first + at].name, spelled)) {
            at += 1;
        }
        if (at == declared.count) {
            return Payload.Failed(Diagnose(forest, name, 0,
                                           format_text("{} has no payload field '{}'", event_name, spelled)));
        }
        if (listed[at] >= 0) {
            return Payload.Failed(Diagnose(forest, name, 0, format_text("Payload field '{}' is listed twice",
                                                                        event_fields[declared.first + at].name)));
        }
        listed[at] = name;
        parameter = NextMember(forest, parameter);
    }
    params: Param[] = [];
    at = 0;
    while (at < declared.count) {
        param: Param = {name: "", storage: event_fields[declared.first + at].storage, container: 0, record: -1,
                        has_default: false, default_bits: 0, default_text: "", default_occurrence: 0,
                        reference: false, node: listed[at]};
        if (listed[at] >= 0) {
            param.name = Text(forest, source, listed[at]);
        }
        params = array_add(params, param);
        at += 1;
    }
    return Payload.Bound(params);
}
// `identity` names the source as the project does, such as
// "behaviors/Counter.chibi"; the module, states and handlers take their IDs
// from it. The target, natives, events, types, entity, operators, globals and
// record makes are the game's, as `chibi-compile --stage-one-input` exports
// them.
pub CompileBehavior :: (identity: string, source: string, target: Target, abi: uint64, names: string[],
                        natives: Native[], ports: Port[], native_ids: uint64[], game_events: GameEvent[],
                        event_fields: GameEventField[], types: GameType[], type_fields: GameField[],
                        entity: uint64, operators: NumericOperator[], globals: GameGlobal[], makes: NativeMake[],
                        make_fields: int[]) -> Result {
    ops := ResolveOps(names, true);
    if (abi == 0 || !Complete(ops) || length(native_ids) != 2 * length(natives)) {
        return InputFailure(-1, "unsupported compiler input or target");
    }
    forest: snapshot.SnapshotNode[] = [];
    root: int = -1;
    switch raw.Parse(source) {
        case .Parsed(nodes, fields, is_named, is_extra, top):
            errors := syntax.Diagnose(nodes, top);
            if (length(errors) > 0) {
                return Result.Rejected(snapshot.Stamp(errors[0], 0));
            }
            index: int = 0;
            while (index < length(nodes)) {
                forest = array_add(forest, snapshot.Node(nodes[index], fields[index], is_named[index], is_extra[index],
                                                         0));
                index += 1;
            }
            root = top;
    }
    declaration := FirstMember(forest, root);
    if (!Is(forest, declaration, "behavior") || NextMember(forest, declaration) >= 0) {
        return InputFailure(0, "a behavior asset needs one behavior declaration");
    }
    declared_types := NativeTypes(types);
    members := NativeFields(type_fields);
    no_names: Name[] = [];
    solid := SolidOffsets(source);
    kept_states: StateDecl[] = [];
    callables: Callable[] = [];
    params: Param[] = [];
    handled: int[] = [];
    member := FirstMember(forest, Field(forest, declaration, "body"));
    while (member >= 0) {
        if (Is(forest, member, "state_declaration")) {
            name := Text(forest, source, Field(forest, member, "name"));
            declared := ReadType(forest, source, declared_types, no_names, 0, Field(forest, member, "type"));
            if (!Numeric(declared.storage) || declared.container != 0) {
                return Result.Rejected(Diagnose(forest, member, 0, "state needs a number type"));
            }
            bits: uint64 = 0;
            value := Field(forest, member, "value");
            if (value >= 0 && Floating(declared.storage)) {
                literal := Typed(-1, NumberStorage, 0, value);
                if (!Is(forest, value, "number") && !Is(forest, value, "unary_expression")) {
                    return Result.Rejected(Diagnose(forest, value, 0, "state value must be a number literal"));
                }
                switch FloatConstantStep(forest, source, 0, literal, declared.storage, ops, NoBases(), forest[value]) {
                    case .Failed(diagnostic):
                        return Result.Rejected(diagnostic);
                    case .Emitted(typed_code, typed_slots, typed_locals, typed_cells, typed_hosts, typed_roots,
                                  typed_calls, typed_bound, typed_next, typed_popped, typed_value, typed_retain,
                                  typed_marks):
                        bits = typed_code[0].payload;
                }
            } else if (value >= 0) {
                switch ParseNumber(forest, source, value) {
                    case .Invalid:
                        return Result.Rejected(Diagnose(forest, value, 0, "state value must be an integer literal"));
                    case .Number(negative, magnitude):
                        if (!Fits(negative, magnitude, declared.storage)) {
                            return Result.Rejected(Diagnose(forest, value, 0,
                                                            format_text("Numeric literal is outside the range of {}",
                                                                        TypeName(declared.storage))));
                        }
                        bits = Bits(negative, magnitude);
                }
            }
            kept: StateDecl = {name: name, id: binding.ID("symbol", format_text("{}:1:{}", identity, name)),
                               storage: declared.storage, bits: bits, node: Field(forest, member, "name")};
            kept_states = array_add(kept_states, kept);
        } else if (Is(forest, member, "handler")) {
            if (Text(forest, source, Field(forest, member, "kind")) != "on" || Field(forest, member, "alias") >= 0 ||
                !Is(forest, Field(forest, member, "name"), "identifier")) {
                return Result.Rejected(Diagnose(forest, member, 0, "only `on Event` handlers are supported yet"));
            }
            handled_name := Text(forest, source, Field(forest, member, "name"));
            found := FindEvent(game_events, handled_name);
            if (found < 0) {
                return Result.Rejected(Diagnose(forest, member, 0, format_text("Unknown event '{}'", handled_name)));
            }
            if (!ScalarPayload(game_events[found], event_fields)) {
                return Result.Rejected(Diagnose(forest, member, 0, "events with record payloads are not supported yet"));
            }
            first := length(params);
            switch PayloadParams(forest, source, member, handled_name, game_events[found], event_fields) {
                case .Failed(diagnostic):
                    return Result.Rejected(diagnostic);
                case .Bound(added):
                    params = append(params, added);
            }
            callable: Callable = {name: handled_name, package: 0, document: 0, node: member, first: first,
                                  count: game_events[found].count, result: 0, result_container: 0, result_record: -1,
                                  results: 0};
            callables = array_add(callables, callable);
            handled = array_add(handled, found);
        } else if (Is(forest, member, "function_declaration")) {
            // A member procedure, which the behavior's handlers call.
            name := Text(forest, source, Field(forest, member, "name"));
            switch FunctionSignature(forest, source, identity, solid, declared_types, no_names, 0, 0, member, name,
                                     length(params)) {
                case .Failed(diagnostic):
                    return Result.Rejected(diagnostic);
                case .Read(procedure, added):
                    params = append(params, added);
                    callables = array_add(callables, procedure);
                    handled = array_add(handled, int(-1));
            }
        } else {
            return Result.Rejected(Diagnose(forest, member, 0, "unsupported behavior member"));
        }
        member = NextMember(forest, member);
    }
    document: snapshot.Document = {original_path: identity, path: identity, directory: "", key: identity,
                                   identity: identity, text: source, root: 0, syntax_root: root, header_start: 0,
                                   header_end: 0, header_line: 0, header_column: 0, header_document: 0, node_start: 0,
                                   node_count: length(forest), first_import: 0, import_count: 0, has_key: true,
                                   has_syntax: true, has_header: false};
    links: graph.Binding[] = [];
    constants: ConstDecl[] = [];
    return Assemble(forest, [document], 0, 0, [identity], [binding.ID("module", identity)], [uint64(0)], [true], links,
                    callables, params, declared_types, members, constants, natives, ports, native_ids, ops, target, abi,
                    Game.Behavior(kept_states, handled, game_events, event_fields, entity, operators, globals, makes,
                                  make_fields));
}
// The modules of a project's behavior assets, `identities[i]` holding
// `sources[i]`, as a CHIBICLO closure rooted at the first, for a host that
// takes one byte[] result; empty when stage one rejects any of them, which
// BehaviorRejection then says why.
pub CompileBehaviors :: (identities: string[], sources: string[], target: Target, abi: uint64, names: string[],
                         natives: Native[], ports: Port[], native_ids: uint64[], game_events: GameEvent[],
                         event_fields: GameEventField[], types: GameType[], type_fields: GameField[],
                         entity: uint64, operators: NumericOperator[], globals: GameGlobal[], makes: NativeMake[],
                         make_fields: int[]) -> byte[] {
    if (length(identities) == 0 || length(identities) != length(sources)) {
        return [];
    }
    ids: uint64[] = [];
    data: byte[] = [];
    starts: int[] = [];
    lengths: int[] = [];
    index: int = 0;
    while (index < length(identities)) {
        switch CompileBehavior(identities[index], sources[index], target, abi, names, natives, ports, native_ids,
                               game_events, event_fields, types, type_fields, entity, operators,
                               globals, makes, make_fields) {
            case .Rejected(diagnostic):
                return [];
            case .Compiled(module, bytes):
                ids = array_add(ids, module);
                starts = array_add(starts, length(data));
                lengths = array_add(lengths, length(bytes));
                data = append(data, bytes);
        }
        index += 1;
    }
    return writer.Closure(ids[0], ids, identities, data, starts, lengths);
}
// The first of CompileBehaviors' behaviors stage one rejects, as
// "identity:line:column: message"; "" when it compiles them all.
pub BehaviorRejection :: (identities: string[], sources: string[], target: Target, abi: uint64, names: string[],
                          natives: Native[], ports: Port[], native_ids: uint64[], game_events: GameEvent[],
                          event_fields: GameEventField[], types: GameType[], type_fields: GameField[],
                          entity: uint64, operators: NumericOperator[], globals: GameGlobal[], makes: NativeMake[],
                          make_fields: int[]) -> string {
    if (length(identities) == 0 || length(identities) != length(sources)) {
        return "the behaviors' identities and sources differ in number, or there are none";
    }
    index: int = 0;
    while (index < length(identities)) {
        switch CompileBehavior(identities[index], sources[index], target, abi, names, natives, ports, native_ids,
                               game_events, event_fields, types, type_fields, entity, operators,
                               globals, makes, make_fields) {
            case .Rejected(diagnostic):
                return format_text("{}:{}:{}: {}", identities[index], diagnostic.line, diagnostic.column,
                                   diagnostic.message);
            case .Compiled(module, bytes):
                index += 1;
        }
    }
    return "";
}
