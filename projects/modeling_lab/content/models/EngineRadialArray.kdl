version 3
name "EngineRadialArray"
domain "model"
id_counter 16
description "Six bounded references, each with a stable array-index path, rotate around local Y."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Instance"
                reference_asset "EngineModule"
                inputs {
                    Radius id=5 declaration_id=3 type="float" default=10.0
                }
                outputs {
                    Geometry id=4
                }
            }
            - {
                id 6
                type "Model Translate"
                inputs {
                    Offset {
                        default x=40.0 y=0.0 z=0.0
                    }
                }
            }
            - {
                id 10
                type "Model Radial Array"
                inputs Count=6 "Angle Step"=1.0471976
            }
        }
        (array)edges {
            - from="3.Geometry" to="6.Geometry"
            - from="6.Geometry" to="10.Geometry"
            - from="10.Geometry" to="1.Geometry"
        }
    }
}
