-    int bank_count = acount(f->data_values), local_count = acount(f->locals);
-    if (bank_count > INT_MAX - local_count ||
-        values >= INT_MAX - bank_count - local_count) {
-        return;
-    }
-    if (!acount(f->host_calls)) {
