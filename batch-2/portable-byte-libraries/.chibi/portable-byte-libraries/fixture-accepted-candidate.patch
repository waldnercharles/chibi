--- /dev/null
+++ b/packages/core/math/bits/Tests.chibi
@@ -0,0 +1,114 @@
+package bits
+
+@test
+ZeroAndAllOnesHaveDefinedCounts :: () {
+    assert(CountOnes32(u32(0)) == 0);
+    assert(CountOnes64(u64(0)) == 0);
+    assert(LeadingZeros32(u32(0)) == 32);
+    assert(TrailingZeros32(u32(0)) == 32);
+    assert(LeadingZeros64(u64(0)) == 64);
+    assert(TrailingZeros64(u64(0)) == 64);
+    assert(CountOnes32(u32(0xffffffff)) == 32);
+    assert(CountOnes64(u64(0xffffffffffffffff)) == 64);
+    assert(LeadingZeros32(u32(0xffffffff)) == 0);
+    assert(TrailingZeros32(u32(0xffffffff)) == 0);
+    assert(LeadingZeros64(u64(0xffffffffffffffff)) == 0);
+    assert(TrailingZeros64(u64(0xffffffffffffffff)) == 0);
+    return;
+}
+
+@test
+EachSetBitHasItsPositionAndCount32 :: () {
+    position := 0;
+    while position < 32 {
+        word := u32(1) << u32(position);
+        assert(CountOnes32(word) == 1);
+        assert(CountOnes32(~word) == 31);
+        assert(LeadingZeros32(word) == 31 - position);
+        assert(TrailingZeros32(word) == position);
+        assert(Reverse32(word) == u32(1) << u32(31 - position));
+        position += 1;
+    }
+    return;
+}
+
+@test
+EachSetBitHasItsPositionAndCount64 :: () {
+    position := 0;
+    while position < 64 {
+        word := u64(1) << u32(position);
+        assert(CountOnes64(word) == 1);
+        assert(CountOnes64(~word) == 63);
+        assert(LeadingZeros64(word) == 63 - position);
+        assert(TrailingZeros64(word) == position);
+        assert(Reverse64(word) == u64(1) << u32(63 - position));
+        position += 1;
+    }
+    return;
+}
+
+@test
+PopulationCountsMixedBits :: () {
+    assert(CountOnes32(u32(0x55555555)) == 16);
+    assert(CountOnes32(u32(0xaaaaaaaa)) == 16);
+    assert(CountOnes32(u32(0x01010203)) == 5);
+    assert(CountOnes64(u64(0x5555555555555555)) == 32);
+    assert(CountOnes64(u64(0xaaaaaaaaaaaaaaaa)) == 32);
+    assert(CountOnes64(u64(0x0101020304050607)) == 13);
+    return;
+}
+
+@test
+ByteSwapAndReverseMatchLiteralAnswers :: () {
+    assert(ByteSwap16(u16(0x1234)) == u16(0x3412));
+    assert(ByteSwap32(u32(0x12345678)) == u32(0x78563412));
+    assert(ByteSwap64(u64(0x0123456789abcdef)) == u64(0xefcdab8967452301));
+    assert(Reverse32(u32(0x01234567)) == u32(0xe6a2c480));
+    assert(Reverse64(u64(0x0123456789abcdef)) == u64(0xf7b3d591e6a2c480));
+    assert(ByteSwap16(ByteSwap16(u16(0x8001))) == u16(0x8001));
+    assert(ByteSwap32(ByteSwap32(u32(0xfedcba98))) == u32(0xfedcba98));
+    assert(ByteSwap64(ByteSwap64(u64(0xfedcba9876543210))) == u64(0xfedcba9876543210));
+    assert(Reverse32(Reverse32(u32(0xfedcba98))) == u32(0xfedcba98));
+    assert(Reverse64(Reverse64(u64(0xfedcba9876543210))) == u64(0xfedcba9876543210));
+    return;
+}
+
+@test
+Rotation32UsesEveryBitAndReducesCounts :: () {
+    assert(RotateLeft32(u32(0x12345678), u32(0)) == u32(0x12345678));
+    assert(RotateLeft32(u32(0x12345678), u32(4)) == u32(0x23456781));
+    assert(RotateRight32(u32(0x12345678), u32(4)) == u32(0x81234567));
+    assert(RotateLeft32(u32(0x80000001), u32(1)) == u32(3));
+    assert(RotateRight32(u32(0x80000001), u32(1)) == u32(0xc0000000));
+    assert(RotateLeft32(u32(0x12345678), u32(32)) == u32(0x12345678));
+    assert(RotateRight32(u32(0x12345678), u32(32)) == u32(0x12345678));
+    assert(RotateLeft32(u32(0x12345678), u32(36)) == u32(0x23456781));
+    assert(RotateLeft32(u32(1), u32(0xffffffff)) == u32(0x80000000));
+    assert(RotateRight32(u32(1), u32(0xffffffff)) == u32(2));
+    count := 0;
+    while count < 32 {
+        assert(RotateRight32(RotateLeft32(u32(0xa507b18e), u32(count)), u32(count)) == u32(0xa507b18e));
+        count += 1;
+    }
+    return;
+}
+
+@test
+Rotation64UsesEveryBitAndReducesCounts :: () {
+    assert(RotateLeft64(u64(0x0123456789abcdef), u32(0)) == u64(0x0123456789abcdef));
+    assert(RotateLeft64(u64(0x0123456789abcdef), u32(8)) == u64(0x23456789abcdef01));
+    assert(RotateRight64(u64(0x0123456789abcdef), u32(8)) == u64(0xef0123456789abcd));
+    assert(RotateLeft64(u64(0x8000000000000001), u32(1)) == u64(3));
+    assert(RotateRight64(u64(0x8000000000000001), u32(1)) == u64(0xc000000000000000));
+    assert(RotateLeft64(u64(0x0123456789abcdef), u32(64)) == u64(0x0123456789abcdef));
+    assert(RotateRight64(u64(0x0123456789abcdef), u32(64)) == u64(0x0123456789abcdef));
+    assert(RotateLeft64(u64(0x0123456789abcdef), u32(72)) == u64(0x23456789abcdef01));
+    assert(RotateLeft64(u64(1), u32(0xffffffff)) == u64(0x8000000000000000));
+    assert(RotateRight64(u64(1), u32(0xffffffff)) == u64(2));
+    count := 0;
+    while count < 64 {
+        assert(RotateRight64(RotateLeft64(u64(0xa507b18e49c23f06), u32(count)), u32(count)) == u64(0xa507b18e49c23f06));
+        count += 1;
+    }
+    return;
+}
