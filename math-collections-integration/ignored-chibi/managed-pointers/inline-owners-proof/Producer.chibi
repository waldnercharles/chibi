// Real producer fixtures and all 169 malformed variants ported from the C
// scalar producer tests. Each variant changes the collected rows, never a
// separately invented representation fixture.

GuardsFixtureSource :: () -> string { return "package scalar\nMain :: () -> int { return Pick(1, 2); }\nPick :: (a: int, b: int) -> int {\n    if (a < b) { return Id(a); }\n    return b;\n}\nId :: (x: int) -> int { return x; }\n"; }
GuardsRows :: () -> facts.Row[] {
    rows := Produced(GuardsFixtureSource());
    ExpectKinds(rows, [facts.SourceRow, facts.DocumentRow, facts.FunctionRow, facts.ReturnRow, facts.LiteralRow, facts.LiteralRow, facts.CallRow, facts.FunctionRow, facts.ParameterRow, facts.ParameterRow, facts.IfRow, facts.ReadRow, facts.ReadRow, facts.CompareRow, facts.ReturnRow, facts.ReadRow, facts.CallRow, facts.EndRow, facts.ReturnRow, facts.ReadRow, facts.FunctionRow, facts.ParameterRow, facts.ReturnRow, facts.ReadRow]);
    ValidateRows(rows, "");
