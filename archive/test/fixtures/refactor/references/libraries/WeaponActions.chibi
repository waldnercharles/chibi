WeaponActions :: library {
    Spawn_Prototype_At :: (Prototype: Prototype, Transform: Transform = null) -> (Entity: entity = 0) {
        action spawn_prototype_action = spawn_prototype(Prototype)
        spawn_prototype_action()
        after spawn_prototype_action {
            spawn_prototype_action.Entity.Transform = transform_to_cf(Transform)
            return spawn_prototype_action.Entity
        }
    }
    Fire_Projectile :: (Origin: vec2 = null, Direction: vec2 = null, Damage: int = 0, Prototype: Prototype = Projectile, Shooter: entity = 0) -> (Entity: entity = 0) {
        action spawn_prototype_at = Spawn_Prototype_At(Prototype, transform_to_cf(Origin))
        spawn_prototype_at()
        after spawn_prototype_at {
            spawn_prototype_at.Entity.Velocity = vec2_norm(Direction).Result * spawn_prototype_at.Entity.Projectile.speed
            spawn_prototype_at.Entity.Orientation = DirectionMath.Direction_Orientation(vec2_norm(Direction).Result.x, vec2_norm(Direction).Result.y)
            spawn_prototype_at.Entity.Projectile.damage = Damage
            spawn_prototype_at.Entity.Collider.ignore_entity = Shooter
            return spawn_prototype_at.Entity
        }
    }
}
