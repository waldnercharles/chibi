diff --git a/include/cute_graphics.h b/include/cute_graphics.h
--- a/include/cute_graphics.h
+++ b/include/cute_graphics.h
@@ -1536,11 +1536,11 @@
  * @function CF_MAX_CANVAS_TARGETS
  * @category graphics
  * @brief    The maximum number of color targets a single canvas may have.
- * @remarks  Four is the portable guarantee: both SDL_GPU and WebGL2/GLES 3.0 support at least
- *           four simultaneous color attachments.
+ * @remarks  SDL_GPU supports eight. WebGL2/GLES 3.0 guarantee only four; there, a canvas with more
+ *           targets than the device's GL_MAX_DRAW_BUFFERS fails to create.
  * @related  CF_CanvasParams cf_make_canvas cf_canvas_get_target2
  */
-#define CF_MAX_CANVAS_TARGETS 4
+#define CF_MAX_CANVAS_TARGETS 8
 
 /**
  * @struct   CF_CanvasParams
diff --git a/src/cute_graphics_gles.cpp b/src/cute_graphics_gles.cpp
--- a/src/cute_graphics_gles.cpp
+++ b/src/cute_graphics_gles.cpp
@@ -1348,6 +1348,11 @@
 	int target_count = params.target_count > 1 ? params.target_count : 1;
 	if (target_count > CF_MAX_CANVAS_TARGETS) target_count = CF_MAX_CANVAS_TARGETS;
 	CF_ASSERT(target_count == 1 || params.sample_count == CF_SAMPLE_COUNT_1);
+	// GLES 3.0 guarantees four draw buffers; more depend on the device.
+	GLint max_buffers = 0, max_attachments = 0;
+	glGetIntegerv(GL_MAX_DRAW_BUFFERS, &max_buffers);
+	glGetIntegerv(GL_MAX_COLOR_ATTACHMENTS, &max_attachments);
+	if (target_count > max_buffers || target_count > max_attachments) return CF_Canvas{};
 	for (int i = 0; i < target_count; ++i) {
 		if (!cf_gles_texture_supports_format(params.targets[i].pixel_format, (CF_TextureUsageBits)params.targets[i].usage)) {
 			CF_ASSERT(!"Unsupported color target format for GLES backend.");
