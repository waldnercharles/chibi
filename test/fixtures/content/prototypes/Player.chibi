package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Player")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Appearance", data.Object([
                    data.Field.Named("antialias", data.Value.Real(1.0)),
                    data.Field.Named("color", data.Value.UInt(4294967295)),
                    data.Field.Named("glow_color", data.Value.UInt(4294967120)),
                    data.Field.Named("glow_radius", data.Value.Real(8.0)),
                    data.Field.Named("height", data.Value.Real(18.0)),
                    data.Field.Named("shape", data.Value.Text("Stroked Chevron")),
                    data.Field.Named("stroke_width", data.Value.Real(1.0)),
                    data.Field.Named("width", data.Value.Real(20.0))
                ])),
                data.Field.Named("Body", data.Object([
                    data.Field.Named("continuous", data.Value.Bool(true)),
                    data.Field.Named("type", data.Value.Text("Dynamic"))
                ])),
                data.Field.Named("Collider", data.Object([
                    data.Field.Named("category", data.Value.UInt(1)),
                    data.Field.Named("mask", data.Value.UInt(10)),
                    data.Field.Named("radius", data.Value.Real(12.0))
                ])),
                data.Field.Named("Health", data.Object([
                    data.Field.Named("current", data.Value.UInt(100)),
                    data.Field.Named("maximum", data.Value.UInt(100))
                ])),
                data.Field.Named("Input", data.Object([])),
                data.Field.Named("Material", data.Object([
                    data.Field.Named("absorption", data.Value.Real(1.0)),
                    data.Field.Named("albedo", data.Value.UInt(437918234)),
                    data.Field.Named("emission_color", data.Value.UInt(4294967295)),
                    data.Field.Named("emission_intensity", data.Value.Real(0.10000000000000001)),
                    data.Field.Named("emission_multiplier", data.Value.Real(1.0)),
                    data.Field.Named("scene", data.Value.UInt(4294967295))
                ])),
                data.Field.Named("Movement", data.Object([
                    data.Field.Named("speed", data.Value.Real(180.0))
                ])),
                data.Field.Named("Orientation", data.Object([])),
                data.Field.Named("Transform", data.Object([
                    data.Field.Named("x", data.Value.Real(320.0)),
                    data.Field.Named("y", data.Value.Real(-180.0))
                ])),
                data.Field.Named("Velocity", data.Object([])),
                data.Field.Named("Weapon", data.Object([
                    data.Field.Named("cooldown", data.Value.Real(0.25)),
                    data.Field.Named("damage", data.Value.UInt(10))
                ]))
            ])),
            data.Field.Named("behaviors", data.List([
                data.Value.Text("AutoWeaponBehavior"),
                data.Value.Text("HealthBehavior"),
                data.Value.Text("InputBehavior"),
                data.Value.Text("MovementTrailBehavior"),
                data.Value.Text("PlayerContactBehavior"),
                data.Value.Text("WeaponBehavior")
            ]))
        ])
    );
}
