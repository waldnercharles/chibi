version: 3
name: Basalt
domain: material
id_counter: 17237
description: 'Physically based basalt on the BasaltCave column grid: prisms with cross-joints, streaks, phenocrysts and relief.'
graphs:
- kind: event
  name: ""
  nodes:
  - id: 1
    type: Shader Surface Output
    inputs:
      Base Color:
        default: {x: 1.0, "y": 1.0, z: 1.0}
      Emission:
        default: {x: 0.0, "y": 0.0, z: 0.0}
      Normal:
        default: {x: 0.0, "y": 0.0, z: 0.0}
  - {id: 10, type: Shader WorldPosition}
  - id: 12
    type: Shader X
    inputs:
      Value:
        type: struct
        type_name: ShaderVec3
        binding: {kind: local, local_id: 17234}
  - id: 15
    type: Shader Z
    inputs:
      Value:
        type: struct
        type_name: ShaderVec3
        binding: {kind: local, local_id: 17234}
  - id: 16026
    type: Call Pure Function
    reference_id: 12137
    reference_name: Column Grid
    inputs:
      X: {type: float}
      Z: {type: float}
    outputs:
      Column: {type: float}
      Offset: {type: float}
      Half Width: {type: float}
      Across: {type: float}
      Along: {type: float}
  - id: 16034
    type: Call Pure Function
    reference_id: 14027
    reference_name: Prism Facet
    inputs:
      Column:
        type: float
        binding: {kind: local, local_id: 17230}
      Across:
        type: float
        binding: {kind: local, local_id: 17231}
      Half Width:
        type: float
        binding: {kind: local, local_id: 17235}
    outputs:
      Angle: {type: float}
  - id: 16039
    type: Call Pure Function
    reference_id: 14488
    reference_name: Cross Joints
    inputs:
      Column:
        type: float
        binding: {kind: local, local_id: 17230}
      Along: {type: float}
      Offset: {type: float}
      Across:
        type: float
        binding: {kind: local, local_id: 17231}
    outputs:
      Joint: {type: float}
      Block: {type: float}
      Block T: {type: float}
  - id: 16047
    type: Call Pure Function
    reference_id: 11473
    reference_name: Phenocrysts
    inputs:
      Position:
        type: struct
        type_name: ShaderVec3
        binding: {kind: local, local_id: 17234}
      Joint:
        type: float
        binding: {kind: local, local_id: 17232}
    outputs:
      Mask: {type: float}
      Tilt: {type: struct, type_name: ShaderVec3}
  - id: 16052
    type: Call Pure Function
    reference_id: 11006
    reference_name: Relief
    inputs:
      Position:
        type: struct
        type_name: ShaderVec3
        binding: {kind: local, local_id: 17234}
    outputs:
      Height: {type: float}
      Slope: {type: struct, type_name: ShaderVec3}
  - id: 16127
    type: Behavior Expression
    reference_id: 16056
    reference_name: smoothstep(0.25, 0.55, noise(vec3(x * 0.16, z * 0.012, 3), 1) * noise(vec3(x * 0.02, z * 0.004, 4), 1))
    inputs:
      x: {type: float}
      z: {type: float}
    outputs:
      Result: {type: float}
  - id: 16337
    type: Behavior Expression
    reference_id: 16273
    reference_name: (0.85 + 0.3 * noise(vec3(column, 0, 7), 1)) * (0.9 + 0.2 * noise(vec3(column, block, 8), 1))
    inputs:
      column:
        type: float
        binding: {kind: local, local_id: 17230}
      block: {type: float}
    outputs:
      Result: {type: float}
  - id: 16360
    type: Behavior Expression
    reference_id: 16341
    reference_name: smoothstep(0.8, 1, abs(across))
    inputs:
      across:
        type: float
        binding: {kind: local, local_id: 17231}
    outputs:
      Result: {type: float}
  - id: 16399
    type: Behavior Expression
    reference_id: 16363
    reference_name: (1 - 0.7 * joint) * (1 - 0.45 * groove)
    inputs:
      joint:
        type: float
        binding: {kind: local, local_id: 17232}
      groove:
        type: float
        binding: {kind: local, local_id: 17236}
    outputs:
      Result: {type: float}
  - id: 16486
    type: Behavior Expression
    reference_id: 16422
    reference_name: mix((vec3(0.068, 0.073, 0.08) + streaks * vec3(0.037, 0.007, -0.016)) * tint, vec3(0.12, 0.12, 0.115), crystal) * shade
    inputs:
      streaks: {type: float}
      tint: {type: float}
      crystal:
        type: float
        binding: {kind: local, local_id: 17233}
      shade: {type: float}
    outputs:
      Result: {type: struct, type_name: ShaderVec3}
  - id: 16754
    type: Behavior Expression
    reference_id: 16663
    reference_name: vec3(mix(mix(cos(facet), -0.85, smoothstep(0.86, 1, -across)), 0.85, smoothstep(0.86, 1, across)), sin(facet), mix((blockT - 0.5) * 0.2, mix(-0.7, 0.7, step(0.5, blockT)), joint))
    inputs:
      facet: {type: float}
      across:
        type: float
        binding: {kind: local, local_id: 17231}
      blockT: {type: float}
      joint:
        type: float
        binding: {kind: local, local_id: 17232}
    outputs:
      Result: {type: struct, type_name: ShaderVec3}
  - id: 16777
    type: Behavior Expression
    reference_id: 16760
    reference_name: prism + reliefSlope + crystalTilt
    inputs:
      prism: {type: struct, type_name: ShaderVec3}
      reliefSlope: {type: struct, type_name: ShaderVec3}
