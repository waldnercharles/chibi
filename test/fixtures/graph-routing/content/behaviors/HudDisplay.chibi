behavior "HudDisplay" {
    owner "ecs.entity";
    local player = cast<handle<"ecs.entity">>(get_global_variable(Name: "Player"));
    local hull = "current / max(maximum, 1)"(current: int = local.current, maximum: int = local.maximum);
    local current = get_component(Component: "GAME.GameHealth", Entity: local.player).Value.current;
    local maximum = get_component(Component: "GAME.GameHealth", Entity: local.player).Value.maximum;
    local alive = has_component(Component: "GAME.GameHealth", Entity: local.player);
    on Tick as tick(DeltaSeconds: float = 0.0) {
        if (local.alive) {
            await set_ui_value(Entity: 0, Element: "#hull .bar", Value: local.hull);
            await set_ui_text(Entity: 0, Element: "#hull .readout", Text: format_text(Format: "{} / {}", Arg0: int = local.current, Arg1: plain int = local.maximum));
            await set_ui_value(Entity: 0, Element: "#speed", Value: "length(vec2(velocity.x, velocity.y))"(velocity: struct<"GameVelocity"> = get_component(Component: "GAME.GameVelocity", Entity: local.player)));
            if (local.hull < 0.3) {
                set_ui_class(Entity: 0, Element: "#hull", Class: "critical", On: true);
            } else {
                set_ui_class(Entity: 0, Element: "#hull", Class: "critical", On: false);
            }
        } else {
            await set_ui_value(Entity: 0, Element: "#hull .bar", Value: 0.0);
            set_ui_text(Entity: 0, Element: "#status", Text: "Ship lost");
        }
    }
    on Repair as repair() {
        if (local.alive) {
            set_component(Component: "GAME.GameHealth", Entity: local.player, Value.current: int = local.maximum);
        } else {
        }
    }
    pure function "current / max(maximum, 1)"<T0: int, T1: int, T2: double>(current: T0 = 0, maximum: T1 = 0) -> (Result: T2 = 0.0) {
        depth_limit 64;
        return divide(A: double = convert<"To Real">(entry.current), B: double = max(A: double = convert<"To Real">(entry.maximum), B: double = real(Value: 1.0)))
    }
    pure function "length(vec2(velocity.x, velocity.y))"<T0: struct<"GameVelocity">, T1: double>(velocity: T0 = null) -> (Result: T1 = 0.0) {
        depth_limit 64;
        return vector_length(Value: make_cf_v2(x: entry.velocity.x, y: entry.velocity.y))
    }
}
