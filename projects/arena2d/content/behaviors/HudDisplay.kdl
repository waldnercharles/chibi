version 3
name "HudDisplay"
id_counter 220
description "Shows the Player's hull and speed on the HUD document, and repairs the hull when the player asks."
owner_type "ecs.entity"
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 1
                type "Event"
                reference_name "Tick"
                outputs {
                    DeltaSeconds id=3 type="float" kind="data"
                }
            }
            - {
                id 4
                type "Get Global Variable"
                inputs Name="Player"
                outputs {
                    Value type="handle" type_name="ecs.entity"
                }
            }
            - {
                id 7
                type "Has Component"
                inputs {
                    Component "GAME.GameHealth"
                    Entity {
                        binding kind="local" name="player"
                    }
                }
            }
            - {
                id 11
                type "Branch"
                inputs {
                    Condition {
                        binding kind="local" name="alive"
                    }
                }
            }
            - {
                id 16
                type "Get Component"
                inputs {
                    Component "GAME.GameHealth"
                    Entity {
                        binding kind="local" name="player"
                    }
                }
                outputs {
                    Value.current id=73
                    Value.maximum id=74
                }
            }
            - {
                id 38
                type "Behavior Expression"
                reference_name "current / max(maximum, 1)"
                inputs {
                    current {
                        id 211
                        type "int"
                        binding kind="local" name="current"
                    }
                    maximum {
                        id 212
                        type "int"
                        binding kind="local" name="maximum"
                    }
                }
                outputs {
                    Result id=40 type="double"
                }
            }
            - {
                id 62
                type "Set UI Value"
                inputs {
                    Element "#hull .bar"
                    Value {
                        binding kind="local" name="hull"
                    }
                }
            }
            - {
                id 69
                type "Format Text"
                inputs {
                    Format "{} / {}"
                    Arg0 {
                        type "int"
                        binding kind="local" name="current"
                    }
                    Arg1 {
                        id 75
                        type "int"
                        flags 0
                        binding kind="local" name="maximum"
                    }
                }
                outputs {
                    Result id=72
                }
            }
            - {
                id 76
                type "Set UI Text"
                inputs Element="#hull .readout"
            }
            - {
                id 82
                type "Get Component"
                inputs {
                    Component "GAME.GameVelocity"
                    Entity {
                        binding kind="local" name="player"
                    }
                }
            }
            - {
                id 100
                type "Behavior Expression"
                reference_name "length(vec2(velocity.x, velocity.y))"
                inputs {
                    velocity id=101 type="struct" type_name="GameVelocity"
                }
                outputs {
                    Result id=102 type="double"
                }
            }
            - {
                id 143
                type "Behavior Expression"
                reference_name "hull < 0.3"
                inputs {
                    Exec id=146 kind="exec"
                    hull {
                        id 144
                        type "double"
                        flags 0
                        binding kind="local" name="hull"
                    }
                }
                outputs {
                    True id=147 kind="exec"
                    False id=148 kind="exec"
                    Result id=145 type="bool"
                }
            }
            - {
                id 149
                type "Set UI Class"
                inputs Element="#hull" Class="critical"
            }
            - {
                id 156
                type "Set UI Class"
                inputs Element="#hull" Class="critical" On=#false
            }
            - {
                id 163
                type "Set UI Value"
                inputs Element="#hull .bar"
            }
            - {
                id 169
                type "Set UI Text"
                inputs Element="#status" Text="Ship lost"
            }
            - id=175 type="Event" reference_name="Repair"
            - {
                id 177
                type "Branch"
                inputs {
                    Condition {
                        binding kind="local" name="alive"
                    }
                }
            }
            - {
                id 182
                type "Set Component"
                inputs {
                    Component "GAME.GameHealth"
                    Entity {
                        binding kind="local" name="player"
                    }
                    current {
                        id 189
                        binding kind="local" name="maximum"
                    }
                }
                outputs {
                    Then id=187
                    Value id=188
                }
            }
            - {
                id 214
                type "Set UI Value"
                inputs Element="#speed"
            }
        }
        (array)edges {
            - from="1.Then" to="11.Exec"
            - from="4.Value" to="7.Entity"
            - from="4.Value" to="16.Entity"
            - from="4.Value" to="82.Entity"
            - from="4.Value" to="182.Entity"
            - from="7.Value" to="11.Condition"
            - from="7.Value" to="177.Condition"
            - from="11.True" to="62.Exec"
            - from="11.False" to="163.Exec"
            - from="16.Value.current" to="38.current"
            - from="16.Value.current" to="69.Arg0"
            - from="16.Value.maximum" to="38.maximum"
            - from="16.Value.maximum" to="69.Arg1"
            - from="16.Value.maximum" to="182.current"
            - from="38.Result" to="62.Value"
            - from="38.Result" to="143.hull"
            - from="62.Then" to="76.Exec"
            - from="69.Result" to="76.Text"
            - from="76.Then" to="214.Exec"
            - from="82.Value" to="100.velocity"
            - from="100.Result" to="214.Value"
            - from="143.True" to="149.Exec"
            - from="143.False" to="156.Exec"
            - from="163.Then" to="169.Exec"
            - from="175.Then" to="177.Exec"
            - from="177.True" to="182.Exec"
            - from="214.Then" to="143.Exec"
        }
        (array)locals {
            - id=61 name="player" from="4.Value"
            - id=68 name="hull" from="38.Result"
            - id=190 name="current" from="16.Value.current"
            - id=191 name="maximum" from="16.Value.maximum"
            - id=213 name="alive" from="7.Value"
        }
    }
    - id=20 kind="function" math_expression="current / max(maximum, 1)" entry_id=193
    - id=86 kind="function" math_expression="length(vec2(velocity.x, velocity.y))" entry_id=104
    - id=129 kind="function" math_expression="hull < 0.3" entry_id=130
}
