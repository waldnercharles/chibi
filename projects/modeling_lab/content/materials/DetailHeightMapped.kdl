                inputs Image="content/images/DetailHeight.png" "Color Space"=1
            }
            - {
                id 43
                type "Behavior Expression"
                reference_name "(color.x - 0.5) * 1.5"
                inputs {
                    color id=44 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=45 type="float"
                }
            }
            - {
                id 68
                type "Shader Bump"
                inputs Distance=0.01
            }
        }
        (array)edges {
            - from="10.UV" to="16.UV"
            - from="16.Color" to="43.color"
            - from="43.Result" to="68.Height"
            - from="68.Value" to="1.Normal"
