behavior "OrbitFlipperMotion" {
    owner "ecs.entity";
    state RestAngle: double = 0.0;
    state Stroke: double = 0.0;
    state RestX: float = 0.0;
    state RestY: float = 0.0;
    value turn_toward_stroke = "Turn toward stroke"(rest: double = &state.RestAngle, stroke: double = &state.Stroke, angle: double = &component("GAME.GameOrientation", "radians"), dt: float = &local.DeltaSeconds);
    action set_gamebody_angular_velocity = set_game_body_angular_velocity(Value: turn_toward_stroke, Target: 0);
    value pivot_velocity_x = "Pivot velocity X"(angle: double = &component("GAME.GameOrientation", "radians"), speed: double = &component("GAME.GameBody", "angular_velocity"), dt: float = &local.DeltaSeconds, origin: double = &state.RestX, rest: double = &state.RestAngle, position: double = &component("GAME.GameTransform", "x"));
    value pivot_velocity_y = "Pivot velocity Y"(angle: double = &component("GAME.GameOrientation", "radians"), speed: double = &component("GAME.GameBody", "angular_velocity"), dt: float = &local.DeltaSeconds, origin: double = &state.RestY, rest: double = &state.RestAngle, position: double = &component("GAME.GameTransform", "y"));
    local DeltaSeconds = tick.DeltaSeconds;
    on Begin as begin() {
        await set_variable<"RestAngle">(Value: double = &component("GAME.GameOrientation", "radians"));
        await set_variable<"RestX">(Value: float = &component("GAME.GameTransform", "x"));
        set_variable<"RestY">(Value: float = &component("GAME.GameTransform", "y"));
    }
    on Tick as tick(DeltaSeconds: float = 0.0) {
        if (&component("GAME.GameActionBinding", "pressed")) {
            await set_variable<"Stroke">(Value: double = 0.9);
            set_gamebody_angular_velocity();
        } else {
            await set_variable<"Stroke">(Value: double = 0.0);
            set_gamebody_angular_velocity();
        }
    }
    after set_gamebody_angular_velocity {
        set_component(Component: "GAME.GameVelocity", Entity: 0, Value.x: float = pivot_velocity_x, Value.y: float = pivot_velocity_y);
    }
    pure function "Turn toward stroke"<T0: double, T1: double, T2: double, T3: float, T4: double>(rest: T0 = 0.0, stroke: T1 = 0.0, angle: T2 = 0.0, dt: T3 = 0.0) -> (Result: T4 = 0.0) {
        depth_limit 64;
        value cosine = cosine(Value: entry.rest);
        value multiply = multiply(A: double = entry.stroke, B: double = cosine);
        value cosine_2 = cosine(Value: entry.rest);
        value abs = abs(Value: double = cosine_2);
        value divide = divide(A: double = multiply, B: double = abs);
        value subtract = subtract(A: double = entry.rest, B: double = divide);
        value subtract_2 = subtract(A: double = subtract, B: double = entry.angle);
        value divide_2 = divide(A: double = subtract_2, B: double = entry.dt);
        value real = real(Value: 16.0);
        value negate = negate(Value: double = real);
        value real_2 = real(Value: 16.0);
        value clamp = clamp(Value: double = divide_2, Min: double = negate, Max: double = real_2);
        result Result: double = clamp;
    }
    pure function "Pivot velocity X"<T0: double, T1: double, T2: float, T3: double, T4: double, T5: double, T6: double>(angle: T0 = 0.0, speed: T1 = 0.0, dt: T2 = 0.0, origin: T3 = 0.0, rest: T4 = 0.0, position: T5 = 0.0) -> (Result: T6 = 0.0) {
        depth_limit 64;
        value real = real(Value: 40.0);
        value multiply = multiply(A: double = entry.speed, B: double = entry.dt);
        value add = add(A: double = entry.angle, B: double = multiply);
        value cosine = cosine(Value: add);
        value cosine_2 = cosine(Value: entry.rest);
        value subtract = subtract(A: double = cosine, B: double = cosine_2);
        value multiply_2 = multiply(A: double = real, B: double = subtract);
        value add_2 = add(A: double = entry.origin, B: double = multiply_2);
        value subtract_2 = subtract(A: double = add_2, B: double = entry.position);
        value divide = divide(A: double = subtract_2, B: double = entry.dt);
        result Result: double = divide;
    }
    pure function "Pivot velocity Y"<T0: double, T1: double, T2: float, T3: double, T4: double, T5: double, T6: double>(angle: T0 = 0.0, speed: T1 = 0.0, dt: T2 = 0.0, origin: T3 = 0.0, rest: T4 = 0.0, position: T5 = 0.0) -> (Result: T6 = 0.0) {
        depth_limit 64;
        value real = real(Value: 40.0);
        value multiply = multiply(A: double = entry.speed, B: double = entry.dt);
        value add = add(A: double = entry.angle, B: double = multiply);
        value sine = sine(Value: add);
        value sine_2 = sine(Value: entry.rest);
        value subtract = subtract(A: double = sine, B: double = sine_2);
        value multiply_2 = multiply(A: double = real, B: double = subtract);
        value add_2 = add(A: double = entry.origin, B: double = multiply_2);
        value subtract_2 = subtract(A: double = add_2, B: double = entry.position);
        value divide = divide(A: double = subtract_2, B: double = entry.dt);
        result Result: double = divide;
    }
}
