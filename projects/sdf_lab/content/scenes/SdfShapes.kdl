version 1
name "SdfShapes"
(array)entities {
    - {
        name "Camera"
        prototype "SdfCamera"
        components {
            (object)GameCamera
        }
    }
    - {
        name "Cyan light"
        prototype "SdfLight"
        components {
            GameTransform x=-195.0 y=0.0
            GameMaterial emission_color=0x38d9edff
        }
    }
    - {
        name "Amber light"
        prototype "SdfLight"
        components {
            GameTransform x=195.0 y=0.0
            GameMaterial emission_color=0xffac54ff
        }
    }
    - {
        name "Rose light"
        prototype "SdfLight"
        components {
            GameTransform x=0.0 y=118.0
            GameMaterial emission_color=0xec749fff
        }
    }
    - {
        name "SdfSphere"
        prototype "SdfSphere"
        components {
            GameTransform x=-125.0 y=-65.0
            GameShader material="SdfCyan"
        }
    }
    - {
        name "SdfRoundedBox"
        prototype "SdfRoundedBox"
        components {
            GameTransform x=0.0 y=-65.0
            GameShader material="SdfIvory"
        }
    }
    - {
        name "SdfTorus"
        prototype "SdfTorus"
        components {
            GameTransform x=125.0 y=-65.0
            GameShader material="SdfAmber"
        }
    }
    - {
        name "SdfBoredBox"
        prototype "SdfBoredBox"
        components {
            GameTransform x=-125.0 y=65.0
            GameShader material="SdfRose"
        }
    }
    - {
        name "SdfIntersection"
        prototype "SdfIntersection"
        components {
            GameTransform x=0.0 y=65.0
            GameShader material="SdfIvory"
        }
    }
    - {
        name "SdfSmoothUnion"
        prototype "SdfSmoothUnion"
        components {
            GameTransform x=125.0 y=65.0
            GameShader material="SdfCyan"
        }
    }
}
