package toolchain

Join :: (parts: string[]) -> string {
    return build.join(parts, "");
}
Helper :: (name: string) -> string {
    return build.join([build.program_directory(), "..", name], "/");
}
Definition :: (argument: string) -> string {
    if (!build.starts_with(argument, "-D")) {
        return "";
    }
    return build.before(build.before(build.after(argument, "-D"), "="), ":");
}
Normalize :: (arguments: string[]) -> string[] {
    result: string[] = [];
    split := false;
    for (argument in arguments) {
        if (split) {
            result = build.concat(result, [Join(["-D", argument])]);
            split = false;
        } else if (argument == "-D") {
            split = true;
        } else {
            result = build.concat(result, [argument]);
        }
    }
    if (split) {
        result = build.concat(result, ["-D"]);
    }
    return result;
}
Cached :: (cache: string, name: string) -> string {
    prefix := Join([name, ":"]);
    for (line in build.lines(cache)) {
        if (build.starts_with(line, prefix)) {
            return build.after(line, "=");
        }
    }
    return "";
}
Contains :: (text: string, part: string) -> bool {
    return build.before(text, part) != text;
}
// The kind of file a path names once links are followed, "" for none.
Kind :: (path: string) -> string {
    resolved := build.resolve_path(path);
    if (resolved == "") {
        return "";
    }
    return build.file_kind(resolved);
}
// The separator that occurs first in text, or "" when none does.
Earliest :: (text: string, separators: string[]) -> string {
    found := "";
    prefix := text;
    for (separator in separators) {
        before := build.before(text, separator);
        if (before != prefix && build.starts_with(prefix, before)) {
            found = separator;
            prefix = before;
        }
    }
    return found;
}
// Text split into words as a POSIX shell splits it, without expansion,
// like Python's shlex.split: blanks separate words, single quotes keep
// their text, a backslash keeps the next byte, and inside double quotes
// only a double quote or backslash can be escaped. An unclosed quote or a
// trailing backslash splits into no words.
Words :: (text: string) -> string[] {
    unquoted := [" ", "\t", "\r", "\n", "'", "\"", "\\"];
    words: string[] = [];
    word := "";
    started := false;
    quote := "";
    rest := text;
    while (true) {
        separators := unquoted;
        if (quote == "'") {
            separators = ["'"];
        } else if (quote == "\"") {
            separators = ["\"", "\\"];
        }
        separator := Earliest(rest, separators);
        if (separator == "") {
            if (quote != "") {
                return [];
            }
            if (rest != "" || started) {
                words = build.concat(words, [Join([word, rest])]);
            }
            return words;
        }
        part := build.before(rest, separator);
        rest = build.after(rest, separator);
        word = Join([word, part]);
        started = started || part != "";
        if (separator == "\\") {
            if (rest == "") {
                return [];
            }
            escapable := unquoted;
            if (quote == "\"") {
                escapable = ["\"", "\\"];
            }
            escaped := "";
            for (candidate in escapable) {
                if (build.starts_with(rest, candidate)) {
                    escaped = candidate;
                }
            }
            // Outside quotes an ordinary byte stays at the front of rest.
            if (escaped != "") {
                word = Join([word, escaped]);
                rest = build.after(rest, escaped);
            } else if (quote == "\"") {
                word = Join([word, "\\"]);
            }
            started = true;
        } else if (separator == "'" || separator == "\"") {
            if (quote == "") {
                quote = separator;
            } else {
                quote = "";
            }
            started = true;
        } else if (started) {
            words = build.concat(words, [word]);
            word = "";
            started = false;
        }
    }
    return words;
}
// The SDK the -isysroot of a compiler driver's -### report names, followed
// through links, or "" when the driver cannot run or names no directory.
// The report is data, so it stays out of the build's output.
CompilerSDK :: (compiler: string) -> string {
    command := [compiler];
    if (Kind(compiler) != "file") {
        command = Words(compiler);
    }
    if (build.length(command) == 0 || build.find_executable(command[0]) == "") {
        return "";
    }
    build.probe(build.concat(command, ["-###", "-x", "c", "-fsyntax-only", "-"]));
    for (line in build.lines(build.last_stderr())) {
        if (!Contains(line, "-isysroot")) {
            continue;
        }
        words := Words(line);
        if (build.length(words) == 0) {
            return "";
        }
        index: int = 0;
        while (index < build.length(words) && words[index] != "-isysroot") {
            index += 1;
        }
        if (index + 1 < build.length(words) && Kind(words[index + 1]) == "directory") {
            return build.resolve_path(words[index + 1]);
        }
    }
    return "";
}
SourceOverride :: (name: string) -> bool {
    return build.starts_with(name, "FETCHCONTENT_SOURCE_DIR_") || name == "CHIBI_SJLIT_SOURCE_DIR";
}
// A set SLJIT source is private, and so is a FetchContent source outside
// BUILD/_deps. A missing source counts as private; CMake rejects it anyway.
PrivateSource :: (buildDir: string, name: string, value: string) -> bool {
    if (value == "") {
        return false;
    }
    if (name == "CHIBI_SJLIT_SOURCE_DIR") {
        return true;
    }
    source := build.resolve_path(value);
    dependencies := Join([build.resolve_path(buildDir), "/_deps"]);
    return source != dependencies && !build.starts_with(source, Join([dependencies, "/"]));
}
// Whether a definition or the build's cache selects private dependency
// sources, which immutable dependency packages cannot serve. Any
// FETCHCONTENT_* definition does; for source overrides a definition
// replaces the cached value. Entries follow CMake's NAME[:TYPE]=VALUE form.
PrivateSources :: (buildDir: string, arguments: string[]) -> bool {
    // Parallel arrays rather than a map, so a build host built before
    // the map syntax changed can still read this program.
    names: string[] = [];
    values: string[] = [];
    for (line in build.lines(build.read_file(Join([buildDir, "/CMakeCache.txt"])))) {
        name := build.before(line, ":");
        typed := build.after(line, ":");
        if (SourceOverride(name) && !Contains(name, "=") && !Contains(name, "#") &&
            Contains(typed, "=") && build.before(typed, "=") != "") {
            names = build.concat(names, [name]);
            values = build.concat(values, [build.after(typed, "=")]);
        }
    }
    for (argument in Normalize(arguments)) {
        definition := build.after(argument, "-D");
        head := build.before(definition, "=");
        name := build.before(head, ":");
        value := build.after(definition, "=");
        if (!build.starts_with(argument, "-D") || !Contains(definition, "=") || name == "" ||
            (head != name && build.after(head, ":") == "") || Contains(value, "\n")) {
            continue;
        }
        if (build.starts_with(name, "FETCHCONTENT_")) {
            return true;
        }
        if (SourceOverride(name)) {
            names = build.concat(names, [name]);
            values = build.concat(values, [value]);
        }
    }
    // A later definition replaces an earlier one.
    position := 0;
    for (name in names) {
        replaced := false;
        index := 0;
        for (other in names) {
            replaced = replaced || (index > position && other == name);
            index += 1;
        }
        if (!replaced && PrivateSource(buildDir, name, values[position])) {
            return true;
        }
        position += 1;
    }
    return false;
}
NativeArguments :: (buildDir: string, arguments: string[]) -> string[] {
    cachePath := Join([buildDir, "/CMakeCache.txt"]);
    cache := build.read_file(cachePath);
    selected := build.environment("CC") != "" ||
                build.environment("CXX") != "" ||
                build.environment("CMAKE_TOOLCHAIN_FILE") != "";
    for (argument in Normalize(arguments)) {
        name := Definition(argument);
        if (name == "CMAKE_C_COMPILER" || name == "CMAKE_CXX_COMPILER" ||
            name == "CMAKE_TOOLCHAIN_FILE" || argument == "--toolchain" ||
            build.starts_with(argument, "--toolchain=") || build.starts_with(argument, "-C")) {
            selected = true;
        }
    }
    result := arguments;
    if (build.platform() == "Linux" && !build.file_exists(cachePath) && !selected &&
        build.find_executable("clang") != "" && build.find_executable("clang++") != "") {
        result = build.concat(result, ["-DCMAKE_C_COMPILER=clang", "-DCMAKE_CXX_COMPILER=clang++"]);
    }
    return result;
}
NativeSDK :: (cache: string, arguments: string[]) -> string {
    sdk := build.environment("SDKROOT");
    compiler := build.environment("CC");
    if (compiler == "") {
        compiler = "cc";
    }
    cachedSDK := Cached(cache, "CMAKE_OSX_SYSROOT");
    cachedCompiler := Cached(cache, "CMAKE_C_COMPILER");
    if (cachedSDK != "") {
        sdk = cachedSDK;
    }
    if (cachedCompiler != "") {
        compiler = cachedCompiler;
    }
    for (argument in Normalize(arguments)) {
        name := Definition(argument);
        if (name == "CMAKE_OSX_SYSROOT") {
            sdk = build.after(argument, "=");
        }
        if (name == "CMAKE_C_COMPILER") {
            compiler = build.after(argument, "=");
        }
    }
    if (sdk != "") {
        return sdk;
    }
    sdk = CompilerSDK(compiler);
    if (sdk == "" && build.probe(["xcrun", "--show-sdk-path"]) == 0) {
        sdk = build.trim(build.last_stdout());
    }
    return sdk;
}
CacheRoot :: () -> string {
    root := build.environment("CHIBI_FETCHCONTENT_CACHE_DIR");
    if (root == "") {
        base := build.environment("XDG_CACHE_HOME");
        if (base != "") {
            root = Join([base, "/chibi-fetchcontent"]);
        } else {
            base = build.environment("HOME");
            if (base != "") {
                root = Join([base, "/.cache/chibi-fetchcontent"]);
            }
        }
    }
    if (root == "" || build.find_executable("python3") == "" || !build.make_directory(root)) {
        return "";
    }
    return build.resolve_path(root);
}
Signature :: (profile: string, buildDir: string, arguments: string[]) -> string {
    if (!build.file_exists(Join([buildDir, "/CMakeCache.txt"]))) {
        return "";
    }
    command := build.concat([
        "python3", Helper("configure_inputs.py"), "signature", build.root(), buildDir,
        profile, Join([build.program_directory(), "/Build.chibi"]), "--"
    ], arguments);
    if (build.run(command) != 0) {
        return "";
    }
    return build.trim(build.last_stdout());
}
Configure :: (profile: string, buildDir: string, arguments: string[]) -> int {
    stamp := Join([buildDir, "/.chibi-toolchain-config-inputs"]);
    signature := Signature(profile, buildDir, arguments);
    if (signature != "" && signature == build.trim(build.read_file(stamp))) {
        return 0;
    }
    if (!build.make_directory(buildDir)) {
        build.report("cannot create the build directory");
        return 1;
    }
    selected := NativeArguments(buildDir, arguments);
    if (build.platform() == "Darwin") {
        sdk := NativeSDK(build.read_file(Join([buildDir, "/CMakeCache.txt"])), selected);
        if (sdk == "") {
            build.report("cannot discover the selected compiler SDK");
            return 1;
        }
        selected = build.concat(selected, [Join(["-DCMAKE_OSX_SYSROOT=", sdk])]);
    }
    root := build.root();
    packageEnabled := build.environment("CHIBI_DEPENDENCY_PACKAGES");
    package: string = "";
    if (packageEnabled == "" || packageEnabled == "1") {
        normalized := Normalize(selected);
        if (build.length(normalized) > 0 && normalized[build.length(normalized) - 1] == "-D") {
            build.report("-D requires a definition");
            return 1;
        }
        packageEnabled = "1";
        if (PrivateSources(buildDir, selected)) {
            packageEnabled = "0";
        }
    }
    if (packageEnabled == "1") {
        status := build.run(build.concat([
            "python3", Helper("dependency_package.py"), "prepare", "--source-dir", root,
            "--build-dir", buildDir, "--profile", "native", "--"
        ], selected));
        if (status != 0) {
            build.report("dependency preparation failed");
            return status;
        }
        package = build.trim(build.last_stdout());
    } else {
        if (!build.write_file(Join([buildDir, "/.chibi-dependency-package.cmake"]),
                              "unset(CHIBI_DEPENDENCY_PACKAGE CACHE)\nunset(CHIBI_DEPENDENCY_SOURCE_ROOT CACHE)\n")) {
            return 1;
        }
    }
    cache := CacheRoot();
    if (cache != "" && build.run([
        "python3", Helper("fetchcontent_cache.py"), "fingerprint", "--source-dir", root
    ]) != 0) {
        cache = "";
    }
    if (package != "" || cache == "") {
        if (!build.write_file(Join([buildDir, "/.chibi-fetchcontent-cache.cmake"]), "")) {
            return 1;
        }
    } else {
        prepare := ["python3", Helper("fetchcontent_cache.py"), "prepare",
                    "--source-dir", root, "--build-dir", buildDir, "--cache-root", cache];
        for (argument in Normalize(selected)) {
            if (Definition(argument) == "CHIBI_ENABLE_TRACY") {
                value := build.after(argument, "=");
                if (value == "ON" || value == "TRUE" || value == "1") {
                    prepare = build.concat(prepare, ["--tracy"]);
                }
            }
        }
        status := build.run(prepare);
        if (status != 0) {
            return status;
        }
    }
    source := root;
    if (profile == "tool-host") {
        source = Join([root, "/sdk"]);
    }
    configure := ["cmake", "-S", source, "-B", buildDir];
    if (!build.file_exists(Join([buildDir, "/CMakeCache.txt"])) &&
        build.environment("CMAKE_GENERATOR") == "" && build.find_executable("ninja") != "") {
        configure = build.concat(configure, ["-G", "Ninja"]);
    }
    configure = build.concat(configure, ["-C", Join([buildDir, "/.chibi-fetchcontent-cache.cmake"]),
                                         "-C", Join([buildDir, "/.chibi-dependency-package.cmake"])]);
    status := build.run(build.concat(configure, selected));
    if (status != 0) {
        build.report("native configuration failed");
        return status;
    }
    if (package == "" && cache != "" && build.run([
        "python3", Helper("fetchcontent_cache.py"), "publish", "--source-dir", root,
        "--build-dir", buildDir, "--cache-root", cache
    ]) != 0) {
        build.report("warning: could not publish FetchContent source cache");
    }
    signature = Signature(profile, buildDir, arguments);
    if (signature != "" && !build.write_file(stamp, Join([signature, "\n"]))) {
        build.report("cannot save configuration input stamp");
        return 1;
    }
    return 0;
}
Build :: () -> int {
    arguments := build.arguments();
    if (build.length(arguments) < 2) {
        build.report("usage: native|tool-host BUILD_DIR [--target NAME] [--jobs N] [--configure-only] -- CMAKE_ARGUMENTS");
        return 2;
    }
    profile := arguments[0];
    if (profile != "native" && profile != "tool-host") {
        build.report("unknown build profile");
        return 2;
    }
    buildDir := arguments[1];
    configure: string[] = [];
    targets: string[] = [];
    jobs: string = "";
    configureOnly := false;
    tail := false;
    index: int = 2;
    while (index < build.length(arguments)) {
        argument := arguments[index];
        index += 1;
        if (tail) {
            configure = build.concat(configure, [argument]);
        } else if (argument == "--") {
            tail = true;
        } else if (argument == "--configure-only") {
            configureOnly = true;
        } else if ((argument == "--target" || argument == "--jobs") && index < build.length(arguments)) {
            if (argument == "--target") {
                targets = build.concat(targets, [arguments[index]]);
            } else {
                jobs = arguments[index];
            }
            index += 1;
        } else {
            build.report("invalid toolchain build option");
            return 2;
        }
    }
    if (profile == "tool-host") {
        configure = build.concat([
            "-DCHIBI_SDK_BUILD_COMPILER=ON", "-DCHIBI_SDK_BUILD_NATIVE=OFF", "-DCHIBI_SDK_BUILD_DESKTOP=OFF"
        ], configure);
        if (build.length(targets) == 0) {
            targets = ["chibi-build-host"];
        }
    }
    status := Configure(profile, buildDir, configure);
    if (status != 0 || configureOnly) {
        return status;
    }
    command := ["cmake", "--build", buildDir];
    if (build.length(targets) > 0) {
        command = build.concat(command, build.concat(["--target"], targets));
    }
    if (jobs != "") {
        command = build.concat(command, ["--parallel", jobs]);
    }
    status = build.run(command);
    if (status != 0) {
        build.report("native build failed");
    }
    return status;
}
