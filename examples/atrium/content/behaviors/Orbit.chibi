// Circle the spot the entity starts on, so its Trail draws a ring of light.
behavior Orbit {
    center := vec2(0, 0)
    angle := 0
    on Begin {
        center = self.Transform
    }
    on Tick(dt) {
        angle += dt * 1.6
        self.Transform = center + vec2(cos(angle) * 46, sin(angle) * 46)
    }
}
