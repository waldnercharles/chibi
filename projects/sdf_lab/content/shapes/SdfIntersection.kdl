version 3
name "SdfIntersection"
domain "shape"
bounds_x 48.0
bounds_y 48.0
id_counter 150
description "Intersection of a sphere and a thin slab."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Shader Shape Output"
            - id=3 type="Shader ObjectPosition"
            - {
                id 23
                type "Behavior Expression"
                reference_name "length(p) - 33"
                inputs {
                    p id=24 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=25 type="float"
                }
            }
            - {
                id 51
                type "Behavior Expression"
                reference_name "abs(p) - vec3(36, 13, 24)"
                inputs {
                    p id=52 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=53 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 88
                type "Behavior Expression"
                reference_name "length(max(offset, 0)) + min(max(max(offset.x, offset.y), offset.z), 0)"
                inputs {
                    offset id=89 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=90 type="float"
                }
            }
            - {
                id 146
                type "Behavior Expression"
                reference_name "max(sphere, slab)"
                inputs {
                    sphere id=147 type="float"
                    slab id=148 type="float"
                }
                outputs {
                    Result id=149 type="float"
                }
            }
        }
        (array)edges {
            - from="3.Value" to="23.p"
            - from="3.Value" to="51.p"
            - from="23.Result" to="146.sphere"
            - from="51.Result" to="88.offset"
            - from="88.Result" to="146.slab"
            - from="146.Result" to="1.Distance"
        }
    }
    - id=7 kind="function" math_expression="length(p) - 33" entry_id=8
    - id=26 kind="function" math_expression="abs(p) - vec3(36, 13, 24)" entry_id=27
    - id=54 kind="function" math_expression="length(max(offset, 0)) + min(max(max(offset.x, offset.y), offset.z), 0)" entry_id=92
    - id=134 kind="function" math_expression="max(sphere, slab)" entry_id=135
}
