package package_compiler

import snapshot "project:source_snapshot"
import syntax "project:syntax_diagnostics"

// Error category belongs to a declared type, independently of callable names.
ErrorMarked :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> bool {
    for child in Members(forest, node) {
        if Is(forest, child, "attribute") && Text(forest, text, Field(forest, child, "name")) == "error" {
            return true;
        }
    }
    return false;
}

DeclarationAttributes :: (forest: snapshot.SnapshotNode[], text: string, file: int, node: int,
                           allowed: string) -> syntax.Diagnostic[] {
    seen: string[] = [];
    for child in Members(forest, node) {
        if Is(forest, child, "attribute") {
            name := Text(forest, text, Field(forest, child, "name"));
            if name != allowed {
                return [Diagnose(forest, child, file, format_text("Unknown attribute '@{}'", name))];
            }
            for previous in seen {
                if previous == name {
                    return [Diagnose(forest, child, file, format_text("Duplicate attribute '@{}'", name))];
                }
            }
            seen.append(name);
        }
    }
    return [];
}

// Optional descriptors and existing native aliases retain their value's
// category. Owning a field or container of errors does not make a value an error.
ErrorBearing :: (types: TypeDecl[], value: ValueType) -> bool {
    current := value;
    visited: int[] = [];
    while current.container == 0 && (current.storage == StructStorage || current.storage == UnionStorage) &&
          current.record >= 0 {
        if visited.contains(current.record) { return false; }
        visited.append(current.record);
        declared := types[current.record];
        if declared.error { return true; }
        if declared.kind == OptionalDecl {
            current = {storage: declared.value_storage, container: declared.value_container, record: declared.value_record};
        } else if declared.kind == NativeDecl && declared.parent >= 0 {
            current.record = declared.parent;
        } else {
            return false;
        }
    }
    return false;
}

ErrorResult :: (types: TypeDecl[], params: Param[], callable: Callable) -> bool {
    last: ValueType = {storage: callable.result, container: callable.result_container, record: callable.result_record};
    if callable.results > 0 {
        result := params[callable.first + callable.count + callable.results - 1];
        last = {storage: result.storage, container: result.container, record: result.record};
    }
    return ErrorBearing(types, last);
}

FallibleBinding :: struct {
    name: string;
    node: int;
    scope: int;
    visible: int;
    until: int;
    returned: bool;
}
FallibleBind :: (name: string, node: int, scope: int, visible: int, until: int, returned: bool) -> FallibleBinding {
    return {name: name, node: node, scope: scope, visible: visible, until: until, returned: returned};
}

FallibleWithin :: (forest: snapshot.SnapshotNode[], node: int, scope: int) -> bool {
    at := node;
    while (at >= 0) {
        if (at == scope) { return true; }
        at = forest[at].parent;
    }
    return false;
}

// Binding identities are declaration nodes, not spellings. A local is visible
// after its initializer, and a loop binding only inside the loop's body.
FallibleBindings :: (forest: snapshot.SnapshotNode[], text: string, callable: Callable) -> FallibleBinding[] {
    bindings: FallibleBinding[] = [];
    for (field in ["parameters", "results"]) {
        list := Field(forest, callable.node, field);
        if (Is(forest, list, "parameter_list")) {
            for (parameter in Members(forest, list)) {
                name := Field(forest, parameter, "name");
                if (name >= 0) {
                    bindings.append(FallibleBind(Text(forest, text, name), name, callable.node,
                                                 0, forest[callable.node].end, field == "results"));
                }
            }
        }
    }
    body := Field(forest, callable.node, "body");
    work: int[] = [body];
    while (length(work) > 0) {
        node := work[length(work) - 1];
        work = slice(work, 0, length(work) - 1);
        if (Is(forest, node, "local_declaration")) {
            name := Field(forest, node, "name");
            bindings.append(FallibleBind(Text(forest, text, name), name, forest[node].parent,
                                         forest[node].end, forest[forest[node].parent].end, false));
        }
        if (Is(forest, node, "for_statement")) {
            for (field in ["name", "key"]) {
                name := Field(forest, node, field);
                if (name >= 0) {
                    loop_body := Field(forest, node, "body");
                    bindings.append(FallibleBind(Text(forest, text, name), name, loop_body,
                                                 forest[loop_body].start, forest[loop_body].end, false));
                }
            }
        }
        if (Is(forest, node, "if_statement") || Is(forest, node, "while_statement")) {
            condition := Field(forest, node, "condition");
            consequence := Field(forest, node, "consequence");
            if (consequence < 0) { consequence = Field(forest, node, "body"); }
            patterns: int[] = [condition];
            while (length(patterns) > 0) {
                pattern := patterns[length(patterns) - 1];
                patterns = slice(patterns, 0, length(patterns) - 1);
                if (Is(forest, pattern, "is_expression")) {
                    declared: int[] = [];
                    name := Field(forest, pattern, "binding");
                    if (name >= 0) { declared.append(name); }
                    variant := Field(forest, pattern, "type");
                    if (Is(forest, variant, "variant_pattern")) {
                        declared.extend(Members(forest, Field(forest, variant, "bindings")));
                    }
                    for (bound_name in declared) {
                        bindings.append(FallibleBind(Text(forest, text, bound_name), bound_name, consequence,
                                                     forest[consequence].start, forest[consequence].end, false));
                        bindings.append(FallibleBind(Text(forest, text, bound_name), bound_name, node,
                                                     forest[pattern].end, forest[condition].end, false));
                    }
                }
                patterns.extend(Members(forest, pattern));
            }
        }
        if (Is(forest, node, "switch_arm")) {
            pattern := Field(forest, node, "value");
            arm_body := Field(forest, node, "body");
            if (Is(forest, pattern, "variant_pattern")) {
                for (bound_name in Members(forest, Field(forest, pattern, "bindings"))) {
                    bindings.append(FallibleBind(Text(forest, text, bound_name), bound_name, arm_body,
                                                 forest[arm_body].start, forest[arm_body].end, false));
                }
            }
        }
        // Nested callable bodies own independent obligations.
        if (node >= 0 && !Is(forest, node, "function_declaration")) {
            work.extend(Members(forest, node));
        }
    }
    return bindings;
}

FallibleFindBinding :: (forest: snapshot.SnapshotNode[], text: string, bindings: FallibleBinding[], node: int) -> int {
    if (!Is(forest, node, "identifier")) { return -1; }
    name := Text(forest, text, node);
    scope := node;
    while (scope >= 0) {
        found: int = -1;
        for (binding, index in bindings) {
            if (binding.scope == scope && binding.name == name && binding.visible <= forest[node].start &&
                forest[node].end <= binding.until &&
                (found < 0 || bindings[found].visible < binding.visible)) {
                found = index;
            }
        }
        if (found >= 0) { return found; }
        scope = forest[scope].parent;
    }
    return -1;
}

FallibleDeclarationBinding :: (bindings: FallibleBinding[], node: int) -> int {
    for (binding, index in bindings) {
        if (binding.node == node) { return index; }
    }
    return -1;
}

FallibleNode :: struct {
    statement: int;
    first: int;
    second: int;
    guard: bool;
}
FallibleNodeFor :: (statement: int, first: int, second: int, guard: bool) -> FallibleNode {
    return {statement: statement, first: first, second: second, guard: guard};
}
FallibleLink :: (input: FallibleNode[], index: int, first: int, second: int) -> FallibleNode[] {
    nodes := input;
    row := nodes[index];
    row.first = first;
    row.second = second;
    nodes[index] = row;
    return nodes;
}
FallibleGraph :: union { Built(nodes: FallibleNode[], start: int) }

FallibleTruth :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> int {
    value := Unparenthesized(forest, node);
    if (Is(forest, value, "boolean")) {
        if (Text(forest, text, value) == "true") { return 1; }
        return 0;
    }
    if (Is(forest, value, "unary_expression") && Text(forest, text, Field(forest, value, "operator")) == "!") {
        truth := FallibleTruth(forest, text, Field(forest, value, "operand"));
        if (truth >= 0) { return 1 - truth; }
    }
    return -1;
}

FallibleBuildGraph :: (forest: snapshot.SnapshotNode[], text: string, statement: int, next: int,
                       leave: int, repeat: int, input: FallibleNode[]) -> FallibleGraph {
    nodes := input;
    if (statement < 0) { return FallibleGraph.Built(nodes, next); }
    kind := forest[statement].kind;
    if (kind == "block" || kind == "callable_body" || kind == "sequence_statement") {
        members := Members(forest, statement);
        start := next;
        index := length(members);
        while (index > 0) {
            index -= 1;
            switch FallibleBuildGraph(forest, text, members[index], start, leave, repeat, nodes) {
                case .Built(changed, head): nodes = changed; start = head;
            }
        }
        return FallibleGraph.Built(nodes, start);
    }
    if (kind == "switch_arm" || kind == "branch_statement") {
        return FallibleBuildGraph(forest, text, Field(forest, statement, "body"), next, leave, repeat, nodes);
    }
    current := length(nodes);
    nodes.append(FallibleNodeFor(statement, next, -1, false));
    if (kind == "return_statement" || kind == "goto_statement") {
        nodes = FallibleLink(nodes, current, -1, nodes[current].second);
    } else if (kind == "break_statement") {
        nodes = FallibleLink(nodes, current, leave, nodes[current].second);
    } else if (kind == "continue_statement") {
        nodes = FallibleLink(nodes, current, repeat, nodes[current].second);
    } else if (kind == "if_statement" || kind == "while_statement") {
        body := Field(forest, statement, "consequence");
        outgoing := next;
        loop_leave := leave;
        loop_repeat := repeat;
        if (kind == "while_statement") {
            body = Field(forest, statement, "body");
            outgoing = current;
            loop_leave = next;
            loop_repeat = current;
        }
        switch FallibleBuildGraph(forest, text, body, outgoing, loop_leave, loop_repeat, nodes) {
            case .Built(changed, head): nodes = changed; nodes = FallibleLink(nodes, current, head, nodes[current].second);
        }
        alternative := next;
        if (kind == "if_statement") {
            switch FallibleBuildGraph(forest, text, Field(forest, statement, "alternative"), next, leave, repeat, nodes) {
                case .Built(changed, head): nodes = changed; alternative = head;
            }
        }
        nodes = FallibleLink(nodes, current, nodes[current].first, alternative);
        truth := FallibleTruth(forest, text, Field(forest, statement, "condition"));
        if (truth == 0) { nodes = FallibleLink(nodes, current, alternative, -1); }
        if (truth == 1) { nodes = FallibleLink(nodes, current, nodes[current].first, -1); }
    } else if (kind == "for_statement") {
        guard := length(nodes);
        nodes.append(FallibleNodeFor(statement, next, -1, true));
        switch FallibleBuildGraph(forest, text, Field(forest, statement, "body"), guard, next, guard, nodes) {
            case .Built(changed, head): nodes = changed; nodes = FallibleLink(nodes, guard, nodes[guard].first, head);
        }
        nodes = FallibleLink(nodes, current, guard, nodes[current].second);
    } else if (kind == "switch_statement") {
        dispatch := next;
        arms := Members(forest, statement);
        // The subject is cached once. Candidate expressions run in source
        // order only while previous candidates have failed to match.
        exhaustive := false;
        has_default := false;
        booleans: int = 0;
        for (arm in arms) {
            if (Is(forest, arm, "switch_arm")) {
                pattern := Field(forest, arm, "value");
                exhaustive = exhaustive || Is(forest, pattern, "variant_pattern");
                truth := FallibleTruth(forest, text, pattern);
                if (truth >= 0) { booleans = booleans | (truth + 1); }
                if (pattern < 0) {
                    has_default = true;
                    switch FallibleBuildGraph(forest, text, Field(forest, arm, "body"), next, leave, repeat, nodes) {
                        case .Built(changed, head): nodes = changed; dispatch = head;
                    }
                }
            }
        }
        exhaustive = exhaustive || booleans == 3;
        last_case := true;
        index := length(arms);
        while (index > 0) {
            index -= 1;
            arm := arms[index];
            if (Is(forest, arm, "switch_arm") && Field(forest, arm, "value") >= 0) {
                switch FallibleBuildGraph(forest, text, Field(forest, arm, "body"), next, leave, repeat, nodes) {
                    case .Built(changed, head):
                        nodes = changed;
                        unmatched := dispatch;
                        if (last_case && !has_default && exhaustive) { unmatched = -1; }
                        link := length(nodes);
                        nodes.append(FallibleNodeFor(arm, head, unmatched, false));
                        dispatch = link;
                        last_case = false;
                }
            }
        }
        nodes = FallibleLink(nodes, current, dispatch, nodes[current].second);
    }
    return FallibleGraph.Built(nodes, current);
}

// Only pending incoming paths contribute aliases. Intersecting them prevents
// a read that names the error on one branch from hiding loss on another.
FallibleEval :: union {
    Evaluated(pending: bool, lost: bool, value: int, aliases: int[], pointers: int[], associated: bool[])
}
FallibleJoin :: (left_pending: bool, left: int[], left_pointers: int[], left_associated: bool[], right_pending: bool,
                 right: int[], right_pointers: int[], right_associated: bool[]) -> FallibleEval {
    aliases := left;
    pointers := left_pointers;
    associated := left_associated;
    for (index in 0..<length(aliases)) {
        // Read through each predecessor's intact pointer map before a join
        // discards differing targets. Cached address aliases can be stale.
        first := FallibleAlias(left, left_pointers, index);
        second := FallibleAlias(right, right_pointers, index);
        aliases[index] = first;
        if (right_pending && !left_pending) { aliases[index] = second; }
        else if (right_pending && left_pending) { aliases[index] = first & second; }
        if (left_pointers[index] != right_pointers[index]) { pointers[index] = -1; }
        associated[index] = left_associated[index] || right_associated[index];
    }
    return FallibleEval.Evaluated(left_pending || right_pending, false, 0, aliases, pointers, associated);
}

FallibleAlias :: (aliases: int[], pointers: int[], binding: int) -> int {
    if (binding < 0) { return 0; }
    at := binding;
    levels: int = 0;
    while (pointers[at] >= 0 && levels < length(pointers)) {
        at = pointers[at];
        levels += 1;
    }
    if (levels >= length(pointers) || aliases[at] == 0) { return 0; }
    return aliases[at] + levels * 8;
}

FallibleWriteAliases :: (input: int[], pointers: int[], associated: bool[], target: int, value: int) -> int[] {
    aliases := input;
    if (associated[target] && value == 0) {
        // The cell may hold this outcome on only some incoming paths. An
        // unknown merged pointer cannot retain a proof across its overwrite.
        // Known pointers follow live targets and normalize at the next join.
        for (index in 0..<length(aliases)) {
            if (pointers[index] < 0 && aliases[index] >= 8) { aliases[index] = 0; }
        }
    }
    aliases[target] = value;
    return aliases;
}

FallibleTarget :: (forest: snapshot.SnapshotNode[], text: string, bindings: FallibleBinding[],
                   pointers: int[], node: int) -> int {
    value := Unparenthesized(forest, node);
    if (Is(forest, value, "identifier")) { return FallibleFindBinding(forest, text, bindings, value); }
    if (Is(forest, value, "dereference_expression")) {
        target := FallibleTarget(forest, text, bindings, pointers, Field(forest, value, "operand"));
        if (target >= 0) { return pointers[target]; }
    }
    return -1;
}

FalliblePointer :: (forest: snapshot.SnapshotNode[], text: string, bindings: FallibleBinding[],
                    pointers: int[], node: int) -> int {
    value := Unparenthesized(forest, node);
    if (Is(forest, value, "address_expression")) {
        return FallibleTarget(forest, text, bindings, pointers, Field(forest, value, "operand"));
    }
    target := FallibleTarget(forest, text, bindings, pointers, value);
    if (target >= 0) { return pointers[target]; }
    return -1;
}

// mode 0 copies an alias, 1 inspects its value, 2 transfers it explicitly.
// Comparing an address does not inspect the error stored at that address.
FallibleExpression :: (forest: snapshot.SnapshotNode[], text: string, bindings: FallibleBinding[], source: int,
                       error_name: string, tuple: bool, node: int, mode: int, input_pending: bool,
                       input_aliases: int[], input_pointers: int[], input_associated: bool[]) -> FallibleEval {
    aliases := input_aliases;
    pointers := input_pointers;
    associated := input_associated;
    pending := input_pending;
    lost := false;
    value: int = 0;
    if (node < 0) { return FallibleEval.Evaluated(pending, lost, value, aliases, pointers, associated); }
    kind := forest[node].kind;
    if (kind == "identifier") {
        value = FallibleAlias(aliases, pointers, FallibleFindBinding(forest, text, bindings, node));
    } else if (kind == "parenthesized_expression") {
        return FallibleExpression(forest, text, bindings, source, error_name, tuple,
                                  Field(forest, node, "expression"), mode, pending, aliases, pointers, associated);
    } else if (kind == "member_expression" || kind == "dereference_expression" || kind == "address_expression") {
        operand := Field(forest, node, "object");
        if (kind != "member_expression") { operand = Field(forest, node, "operand"); }
        switch FallibleExpression(forest, text, bindings, source, error_name, tuple, operand, 0, pending, aliases, pointers, associated) {
            case .Evaluated(next_pending, next_lost, owner, changed, targets, changed_associated):
                pending = next_pending; lost = next_lost;
                aliases = changed; pointers = targets; associated = changed_associated;
                if (kind == "address_expression" && owner > 0) { value = owner + 8; }
                if (kind == "dereference_expression" && owner >= 8) { value = owner - 8; }
                if (kind == "member_expression") {
                    member := Text(forest, text, Field(forest, node, "member"));
                    if (owner > 0 && owner < 8 && member == error_name) { value = 2; }
                    else if ((owner & 2) != 0 && owner < 8) { pending = false; }
                }
        }
    } else if (kind == "binary_expression") {
        operator := Text(forest, text, Field(forest, node, "operator"));
        switch FallibleExpression(forest, text, bindings, source, error_name, tuple,
                                  Field(forest, node, "left"), 1, pending, aliases, pointers, associated) {
            case .Evaluated(next_pending, next_lost, ignored, changed, targets, changed_associated):
                pending = next_pending; lost = next_lost;
                aliases = changed; pointers = targets; associated = changed_associated;
        }
        skip := operator == "&&" || operator == "||" || operator == "and" || operator == "or" || operator == "??";
        truth := FallibleTruth(forest, text, Field(forest, node, "left"));
        runs := true;
        if (skip && truth >= 0 && operator != "??") {
            runs = truth == 1;
            if (operator == "||" || operator == "or") { runs = !runs; }
        }
        if (runs) {
            before := aliases;
            before_pointers := pointers;
            before_associated := associated;
            before_pending := pending;
            switch FallibleExpression(forest, text, bindings, source, error_name, tuple,
                                      Field(forest, node, "right"), 1, pending, aliases, pointers, associated) {
                case .Evaluated(next_pending, next_lost, ignored, changed, targets, changed_associated):
                    pending = next_pending; lost = lost || next_lost;
                    aliases = changed; pointers = targets; associated = changed_associated;
            }
            if (skip && truth < 0) {
                switch FallibleJoin(before_pending, before, before_pointers, before_associated, pending, aliases, pointers, associated) {
                    case .Evaluated(next_pending, ignored_lost, ignored, changed, targets, changed_associated):
                        pending = next_pending;
                        aliases = changed; pointers = targets; associated = changed_associated;
                }
            }
        }
    } else {
        children: int[] = [];
        child_mode: int = 1;
        if (kind == "call_expression") {
            children.append(Field(forest, node, "function"));
            children.extend(Members(forest, Field(forest, node, "arguments")));
            child_mode = 2;
        } else if (kind == "unary_expression") {
            children.append(Field(forest, node, "operand"));
        } else if (kind == "named_argument" || kind == "struct_field") {
            children.append(Field(forest, node, "value"));
            child_mode = 2;
        } else if (kind == "as_expression" || kind == "is_expression" || kind == "await_expression") {
            children.append(Field(forest, node, "value"));
        } else if (kind == "index_expression") {
            children.append(Field(forest, node, "object"));
            children.append(Field(forest, node, "index"));
        } else if (kind == "range_expression") {
            children.append(Field(forest, node, "start"));
            children.append(Field(forest, node, "end"));
        } else if (kind == "array_expression" || kind == "struct_expression" ||
                   kind == "argument_list" || kind == "map_expression" || kind == "map_entry") {
            children = Members(forest, node);
            child_mode = 2;
        }
        for (child in children) {
            switch FallibleExpression(forest, text, bindings, source, error_name, tuple,
                                      child, child_mode, pending, aliases, pointers, associated) {
                case .Evaluated(next_pending, next_lost, ignored, changed, targets, changed_associated):
                    pending = next_pending; lost = lost || next_lost;
                    aliases = changed; pointers = targets; associated = changed_associated;
            }
        }
        if (node == source) {
            lost = lost || pending;
            pending = true;
            aliases = resize([int(0)], length(aliases));
            associated = resize([false], length(associated));
            value = 2;
            if (tuple) { value = 1; }
        }
    }
    if ((mode == 1 && value > 0 && value < 8) || (mode == 2 && value > 0)) { pending = false; }
    return FallibleEval.Evaluated(pending, lost, value, aliases, pointers, associated);
}

// Computing a destination can call functions or inspect an index. Merely
// replacing the error slot itself does not read or acknowledge its old value.
FallibleAddress :: (forest: snapshot.SnapshotNode[], text: string, bindings: FallibleBinding[], source: int,
                    error_name: string, tuple: bool, destination: int, input_pending: bool,
                    input_aliases: int[], input_pointers: int[], input_associated: bool[]) -> FallibleEval {
    pending := input_pending;
    aliases := input_aliases;
    pointers := input_pointers;
    associated := input_associated;
    lost := false;
    node := Unparenthesized(forest, destination);
    expressions: int[] = [];
    if (Is(forest, node, "member_expression") || Is(forest, node, "index_expression")) {
        expressions.append(Field(forest, node, "object"));
    } else if (Is(forest, node, "dereference_expression")) {
        expressions.append(Field(forest, node, "operand"));
    }
    for (expression in expressions) {
        switch FallibleExpression(forest, text, bindings, source, error_name, tuple,
                                  expression, 0, pending, aliases, pointers, associated) {
            case .Evaluated(next_pending, next_lost, ignored, changed, targets, changed_associated):
                pending = next_pending; lost = lost || next_lost;
                aliases = changed; pointers = targets; associated = changed_associated;
        }
    }
    if (Is(forest, node, "index_expression")) {
        switch FallibleExpression(forest, text, bindings, source, error_name, tuple,
                                  Field(forest, node, "index"), 1, pending, aliases, pointers, associated) {
            case .Evaluated(next_pending, next_lost, ignored, changed, targets, changed_associated):
                pending = next_pending; lost = lost || next_lost;
                aliases = changed; pointers = targets; associated = changed_associated;
        }
    }
    return FallibleEval.Evaluated(pending, lost, 0, aliases, pointers, associated);
}

FallibleTransfer :: (forest: snapshot.SnapshotNode[], text: string, bindings: FallibleBinding[], source: int,
                     error_name: string, tuple: bool, current: FallibleNode, input_pending: bool,
                     input_aliases: int[], input_pointers: int[], input_associated: bool[]) -> FallibleEval {
    pending := input_pending;
    aliases := input_aliases;
    pointers := input_pointers;
    associated := input_associated;
    lost := false;
    node := current.statement;
    if (node < 0 || current.guard) { return FallibleEval.Evaluated(pending, lost, 0, aliases, pointers, associated); }
    kind := forest[node].kind;
    if (kind == "assignment") {
        switch FallibleAddress(forest, text, bindings, source, error_name, tuple,
                               Field(forest, node, "target"), pending, aliases, pointers, associated) {
            case .Evaluated(next_pending, next_lost, ignored, changed, targets, changed_associated):
                pending = next_pending; lost = next_lost;
                aliases = changed; pointers = targets; associated = changed_associated;
        }
    }
    expression: int = -1;
    mode: int = 1;
    if (kind == "local_declaration" || kind == "assignment" || kind == "return_statement") {
        expression = Field(forest, node, "value");
        mode = 0;
        if (kind == "return_statement") { mode = 2; }
    } else if (kind == "if_statement" || kind == "while_statement") {
        expression = Field(forest, node, "condition");
    } else if (kind == "switch_statement" || kind == "switch_arm" || kind == "for_statement") {
        expression = Field(forest, node, "value");
    } else if (kind == "reduce_statement" || kind == "cancel_statement") {
        expression = Field(forest, node, "value");
        mode = 2;
    } else if (kind == "delete_statement") {
        expression = Field(forest, node, "target");
    } else if (kind == "expression_statement") {
        expression = FirstMember(forest, node);
        mode = 0;
    }
    value: int = 0;
    switch FallibleExpression(forest, text, bindings, source, error_name, tuple,
                              expression, mode, pending, aliases, pointers, associated) {
        case .Evaluated(next_pending, next_lost, produced, changed, targets, changed_associated):
            pending = next_pending; lost = lost || next_lost; value = produced;
            aliases = changed; pointers = targets; associated = changed_associated;
    }
    if (kind == "for_statement" || kind == "cancel_statement") {
        for (field in ["first", "last", "duration"]) {
            switch FallibleExpression(forest, text, bindings, source, error_name, tuple,
                                      Field(forest, node, field), 1, pending, aliases, pointers, associated) {
                case .Evaluated(next_pending, next_lost, ignored, changed, targets, changed_associated):
                    pending = next_pending; lost = lost || next_lost;
                    aliases = changed; pointers = targets; associated = changed_associated;
            }
        }
    }
    if (kind == "local_declaration") {
        target := FallibleDeclarationBinding(bindings, Field(forest, node, "name"));
        if (target >= 0) {
            aliases = FallibleWriteAliases(aliases, pointers, associated, target, value);
            pointers[target] = FalliblePointer(forest, text, bindings, pointers, expression);
            associated[target] = associated[target] || value > 0;
        }
    } else if (kind == "assignment") {
        destination := Unparenthesized(forest, Field(forest, node, "target"));
        target := FallibleTarget(forest, text, bindings, pointers, destination);
        if (target >= 0) {
            aliases = FallibleWriteAliases(aliases, pointers, associated, target, value);
            pointers[target] = FalliblePointer(forest, text, bindings, pointers, expression);
            associated[target] = associated[target] || value > 0;
        } else if (Is(forest, destination, "member_expression")) {
            owner := FallibleTarget(forest, text, bindings, pointers, Field(forest, destination, "object"));
            member := Text(forest, text, Field(forest, destination, "member"));
            if (owner >= 0 && FallibleAlias(aliases, pointers, owner) == 1) {
                if (member == error_name) {
                    kept: int = 0;
                    if (value > 0) { kept = 1; }
                    aliases = FallibleWriteAliases(aliases, pointers, associated, owner, kept);
                    pointers[owner] = -1;
                    associated[owner] = associated[owner] || kept > 0;
                }
            } else if (value > 0) { pending = false; }
        } else if (Is(forest, destination, "dereference_expression")) {
            // Unknown merged pointees cannot prove the old alias survived.
            aliases = resize([int(0)], length(aliases));
        } else if (value > 0) { pending = false; }
    } else if (kind == "return_statement") {
        for (binding, index in bindings) {
            if (binding.returned && FallibleAlias(aliases, pointers, index) > 0) { pending = false; }
        }
        lost = lost || pending;
    }
    return FallibleEval.Evaluated(pending, lost, 0, aliases, pointers, associated);
}

FallibleOutcome :: (forest: snapshot.SnapshotNode[], text: string, callable: Callable, bindings: FallibleBinding[],
                    nodes: FallibleNode[], start: int, source: int, error_name: string, tuple: bool) -> bool {
    width := length(bindings);
    aliases := resize([int(0)], length(nodes) * width);
    pointers := resize([int(0)], length(nodes) * width);
    associated := resize([false], length(nodes) * width);
    for (index in 0..<length(pointers)) { pointers[index] = -1; }
    reached := resize([false], length(nodes));
    pending := resize([false], length(nodes));
    reached[start] = true;
    work: int[] = [start];
    lost := false;
    while (length(work) > 0) {
        current := work[length(work) - 1];
        work = slice(work, 0, length(work) - 1);
        local := slice(aliases, current * width, width);
        targets := slice(pointers, current * width, width);
        history := slice(associated, current * width, width);
        outgoing := pending[current];
        switch FallibleTransfer(forest, text, bindings, source, error_name, tuple, nodes[current], outgoing, local, targets, history) {
            case .Evaluated(next_pending, next_lost, ignored, changed, changed_targets, changed_associated):
                outgoing = next_pending; lost = lost || next_lost;
                local = changed; targets = changed_targets; history = changed_associated;
        }
        if (current == 0) {
            for (binding, index in bindings) {
                if (binding.returned && FallibleAlias(local, targets, index) > 0) { outgoing = false; }
            }
            lost = lost || outgoing;
        }
        for (destination in [nodes[current].first, nodes[current].second]) {
            if (destination >= 0) {
                changed := !reached[destination];
                merged := local;
                merged_targets := targets;
                merged_associated := history;
                next_pending := outgoing;
                if (reached[destination]) {
                    previous := slice(aliases, destination * width, width);
                    previous_targets := slice(pointers, destination * width, width);
                    previous_associated := slice(associated, destination * width, width);
                    switch FallibleJoin(pending[destination], previous, previous_targets, previous_associated,
                                         outgoing, local, targets, history) {
                        case .Evaluated(joined, ignored_lost, ignored, joined_aliases, joined_targets, joined_associated):
                            next_pending = joined; merged = joined_aliases; merged_targets = joined_targets;
                            merged_associated = joined_associated;
                    }
                    changed = pending[destination] != next_pending;
                    for (index in 0..<width) {
                        changed = changed || previous[index] != merged[index] || previous_targets[index] != merged_targets[index] ||
                                  previous_associated[index] != merged_associated[index];
                    }
                }
                if (changed) {
                    reached[destination] = true;
                    pending[destination] = next_pending;
                    for (index in 0..<width) {
                        aliases[destination * width + index] = merged[index];
                        pointers[destination * width + index] = merged_targets[index];
                        associated[destination * width + index] = merged_associated[index];
                    }
                    work.append(destination);
                }
            }
        }
    }
    return lost;
}

// Resolved call facts come from emission, including calls into imported source
// packages. No native source analyzer or spelling-based error inference runs.
FallibleBody :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], callables: Callable[],
                 params: Param[], types: TypeDecl[], callable: Callable, facts: SemanticFact[], generated_query: bool) -> syntax.Diagnostic[] {
    sources: SemanticFact[] = [];
    for (fact in facts) {
        if (fact.kind == CallFact && Is(forest, fact.node, "call_expression") &&
            fact.target >= 0 && fact.target < length(callables)) {
            producer := callables[fact.target];
            if (ErrorResult(types, params, producer)) {
                if (producer.waits) {
                    return [Diagnose(forest, fact.node, callable.document,
                                     "Task error result checking is not supported by stage one yet")];
                }
                duplicate := false;
                for (source in sources) { duplicate = duplicate || source.node == fact.node; }
                if (!duplicate) { sources.append(fact); }
            }
        }
    }
    if (length(sources) == 0) { return []; }
    // A generated system-query evaluator retains the system's source node,
    // but executes its header rather than that node's authored body.
    if (generated_query || Field(forest, callable.node, "body") < 0) {
        return [Diagnose(forest, sources[0].node, callable.document,
                         "Error result checking requires an authored function body in stage one")];
    }
    text := documents[callable.document].text;
    bindings := FallibleBindings(forest, text, callable);
    nodes: FallibleNode[] = [{statement: -1, first: -1, second: -1, guard: true}];
    start: int = 0;
    switch FallibleBuildGraph(forest, text, Field(forest, callable.node, "body"), 0, 0, 0, nodes) {
        case .Built(built, head): nodes = built; start = head;
    }
    // Gotos resolve once all label nodes exist, preserving ordinary control flow.
    for (node, index in nodes) {
        if (Is(forest, node.statement, "goto_statement")) {
            name := Text(forest, text, Field(forest, node.statement, "name"));
            for (label, target in nodes) {
                if (Is(forest, label.statement, "label_statement") &&
                    Text(forest, text, Field(forest, label.statement, "name")) == name) {
                    nodes = FallibleLink(nodes, index, target, nodes[index].second);
                }
            }
        }
    }
    for (source in sources) {
        producer := callables[source.target];
        error_name: string = "";
        if (producer.results > 0) { error_name = params[producer.first + producer.count + producer.results - 1].name; }
        if (FallibleOutcome(forest, text, callable, bindings, nodes, start, source.node, error_name, producer.results > 1)) {
            return [Diagnose(forest, source.node, callable.document,
                             "Error result is ignored on a reachable path; check, report, store or return it")];
        }
    }
    return [];
}
