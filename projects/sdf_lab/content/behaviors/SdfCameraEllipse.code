behavior "SdfCameraEllipse" {
    owner "ecs.entity";
    state elapsed: float = 0.0;
    on Tick as tick(DeltaSeconds: float = 0.0) {
        &state.elapsed += cast<double>(&delta);
        &component("GAME.GameTransform", "x") = 70 * cos(cast<double>(&state.elapsed) * (2 * pi / 16));
        &component("GAME.GameTransform", "y") = 40 * sin(cast<double>(&state.elapsed) * (2 * pi / 16));
    }
}
