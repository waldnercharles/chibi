behavior "ArenaEnemyVisualBehavior" {
    owner "ecs.entity";
    state "Bump Lift": float = 1.6;
    value random_range_vector = random_range_vector(Min: {
        x: 0.0,
        y: 0.0,
        z: 0.0
    }, Max: {
        x: 6.2831855,
        y: 6.2831855,
        z: 6.2831855
    });
    value random_range_vector_2 = random_range_vector(Min: {
        x: -10.0,
        y: -10.0,
        z: -10.0
    }, Max: {
        x: 10.0,
        y: 10.0,
        z: 10.0
    });
    on Begin as begin() {
        await set_game_visual_motion_rotation(Value: random_range_vector, Target: 0);
        set_game_visual_motion_angular_velocity(Value: random_range_vector_2, Target: 0);
    }
    on "Contact Begin" as contact_begin(Other: handle<"ecs.entity"> = 0, Point: struct<"CF_V2"> = null) {
        Bump(Strength: 1.0);
    }
    on Damaged as damaged(Amount: int = 0, Source: handle<"ecs.entity"> = 0) {
        Bump(Strength: 1.6);
    }
    function "Bump"(Strength: float = 1.0) -> () {
        depth_limit 32;
        value random_range = random_range(Min: -1.0, Max: 1.0);
        value make_cf_v3 = make_cf_v3(x: 0.36, y: 0.0, z: 0.5);
        value multiply = multiply(A: struct<"CF_V3"> = make_cf_v3, B: float = random_range);
        value multiply_2 = multiply(A: float = entry.Strength, B: float = &state."Bump Lift");
        after entry {
            await trigger_visual_reaction(Rotation: multiply, Lift: multiply_2, Target: 0);
            return();
        }
    }
}
