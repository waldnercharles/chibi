version 1
name "SdfAnalyticGradientStudy"
(array)entities {
    - {
        name "Camera"
        prototype "SdfOptimizationCamera"
        components {
            GameTransform x=0.0 y=0.0
            GameCamera width=500.0 height=320.0 focal_distance=700.0
            GameHRC2D surface_shadow_mode="Horizon8" ambient=0.22 fog=0.015 bounce_intensity=0.12
        }
    }
    - {
        name "Cyan light"
        prototype "SdfLight"
        components {
            GameTransform x=-215.0 y=-45.0
            GameMaterial emission_color=0x38d9edff
        }
    }
    - {
        name "Amber light"
        prototype "SdfLight"
        components {
            GameTransform x=215.0 y=45.0
            GameMaterial emission_color=0xffac54ff
        }
    }
    - {
        name "Rounded box rotated"
        prototype "SdfRoundedBox"
        components {
            GameTransform x=-150.0 y=-70.0
            GameOrientation radians=0.35
            GameVisualTransform scale=0.95 pitch=0.55 roll=0.25
            GameShader material="SdfCyan"
        }
    }
    - {
        name "Rounded box small tilted"
        prototype "SdfRoundedBox"
        components {
            GameTransform x=-50.0 y=-70.0
            GameOrientation radians=-0.45
            GameVisualTransform scale=0.65 pitch=-0.35 roll=-0.2
            GameShader material="SdfAmber"
        }
    }
    - {
        name "Torus opening"
        prototype "SdfTorus"
        components {
            GameTransform x=50.0 y=-70.0
            GameVisualTransform scale=0.95 pitch=0.65 roll=0.15
        }
    }
    - {
        name "Hard difference bore"
        prototype "SdfBoredBox"
        components {
            GameTransform x=150.0 y=-70.0
            GameVisualTransform scale=0.95 pitch=0.1 roll=-0.15
            GameShader material="SdfRose"
        }
    }
    - {
        name "Smooth union blend"
        prototype "SdfSmoothUnion"
        components {
            GameTransform x=-150.0 y=65.0
            GameVisualTransform scale=0.95 pitch=0.3 roll=0.2
            GameShader material="SdfAmber"
        }
    }
    - {
        name "Breathing sphere animated"
        prototype "SdfBreathingSphere"
        components {
            GameTransform x=-50.0 y=65.0
            GameVisualTransform scale=0.9
            GameShader material="SdfCyan"
        }
    }
    - {
        name "Parameterized CSG"
        prototype "SdfInstance"
        components {
            GameTransform x=50.0 y=65.0
            GameVisualTransform scale=1.05 pitch=0.6 roll=-0.2
            GameShader material="SdfInstanceTint" parameters="Radius 25\nBore 10\n(array)Tint 0.65 0.3 0.48\n"
        }
    }
    - {
        name "Noise fallback"
        prototype "SdfSphere"
        components {
            GameTransform x=150.0 y=65.0
            GameVisualTransform scale=0.95
            GameShader shape="SdfGradientNoise" material="SdfIvory"
        }
    }
}
