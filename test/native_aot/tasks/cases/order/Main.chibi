package task_order

Main :: () -> int {
    Worker(1, 3);
    Worker(2, 4);
    yield
    yield
    if (Log(0) != 1234) { return 1; }
    total := await Worker(5, 6);
    if (total != 11 || Log(0) != 123456) { return 2; }
    return 0;
}

Log :: (digit: int) -> int {
    order: retain int = 0;
    if (digit != 0) { order = order * 10 + digit; }
    return order;
}

Worker :: (first: int, second: int) -> int {
    Log(first);
    yield
    Log(second);
    return first + second;
}
