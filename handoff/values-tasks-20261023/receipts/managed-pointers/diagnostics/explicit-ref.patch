+                !similar_name(source, qualifier, defined, f->library) ||
+                !similar_name(source, name, defined, f->name)) {
+                continue;
+            }
+            exact &= same_name(source, qualifier, defined, f->library);
+            if (found && found_exact && !exact) {
+                continue;
+            }
+            if (found && found_exact == exact) {
+                *ambiguous = true;
+                continue;
+            }
