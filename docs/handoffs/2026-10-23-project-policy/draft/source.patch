diff --git a/src/host/build_pair.c b/src/host/build_pair.c
new file mode 100644
--- /dev/null
+++ b/src/host/build_pair.c
@@ -0,0 +1,195 @@
+#include "host/build_host_internal.h"
+#include "support/file_pair.h"
+#include "support/xalloc.h"
+
+#include <assert.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+
+static bool same_file(const struct stat *left, const struct stat *right)
+{
+    return left->st_dev == right->st_dev && left->st_ino == right->st_ino;
+}
+static bool entry(const char *path, bool source, struct stat *info, bool *present)
+{
+    if (!lstat(path, info)) {
+        *present = true;
+        return S_ISREG(info->st_mode);
+    }
+    *present = false;
+    return !source && errno == ENOENT;
+}
+/* All entries share one physical existing directory. Normalize only the
+ * parents; retain each requested leaf spelling for exclusive-move admission. */
+static bool raw_paths(const char *const input[4], char *paths[4], struct stat before[4], bool present[4])
+{
+    char *parent = NULL;
+    struct stat first = { 0 };
+    bool valid = true;
+    for (int i = 0; valid && i < 4; i++) {
+        const char *slash = strrchr(input[i], '/');
+        if (input[i][0] != '/' || !slash || !slash[1] ||
+            !strcmp(slash + 1, ".") || !strcmp(slash + 1, "..")) {
+            valid = false;
+            break;
+        }
+        size_t length = (size_t)(slash - input[i]);
+        char *prefix = xmalloc(length + 2);
+        memcpy(prefix, input[i], length);
+        prefix[length] = 0;
+        if (!length) {
+            strcpy(prefix, "/");
+        }
+        char *canonical = realpath(prefix, NULL);
+        free(prefix);
+        struct stat directory;
+        if (!canonical || stat(canonical, &directory) ||
+            !S_ISDIR(directory.st_mode) || (i && !same_file(&first, &directory))) {
+            free(canonical);
+            valid = false;
+            break;
+        }
+        if (!i) {
+            parent = canonical;
+            first = directory;
+        } else {
+            free(canonical);
+        }
+        size_t size = strlen(parent) + strlen(slash + 1) + 2;
+        paths[i] = xmalloc(size);
+        snprintf(paths[i], size, "%s%s%s", parent, !strcmp(parent, "/") ? "" : "/", slash + 1);
+        valid = entry(paths[i], !(i & 1), &before[i], &present[i]);
+        for (int j = 0; valid && j < i; j++) {
+            valid = strcmp(paths[i], paths[j]) &&
+                    !(present[i] && present[j] && same_file(&before[i], &before[j]));
+        }
+    }
+    free(parent);
+    return valid;
+}
+/* Preparation may create only its two empty backup reservations. Recheck
+ * every caller entry so a generated backup cannot occupy a requested name,
+ * including a previously absent case alias. No old bytes have moved yet. */
+static bool prepared_paths(
+    const file_pair *pair,
+    char *const paths[4],
+    const struct stat before[4],
+    const bool present[4]
+)
+{
+    struct stat backups[2];
+    for (int i = 0; i < 2; i++) {
+        if (lstat(pair->backup[i], &backups[i]) || !S_ISREG(backups[i].st_mode)) {
+            return false;
+        }
+    }
+    if (same_file(&backups[0], &backups[1])) {
+        return false;
+    }
+    for (int i = 0; i < 4; i++) {
+        struct stat after;
+        bool exists;
+        if (!entry(paths[i], !(i & 1), &after, &exists) ||
+            exists != present[i] || (exists && !same_file(&before[i], &after))) {
+            return false;
+        }
+        for (int j = 0; exists && j < 2; j++) {
+            if (same_file(&after, &backups[j])) {
+                return false;
+            }
+        }
+    }
+    return pair->existed[0] == present[1] && pair->existed[1] == present[3];
+}
+static void append(build_host *host, const char *text, size_t size)
+{
+    chibi_build_result *result = host->result;
+    assert(size < sizeof result->stderr_text - result->stderr_size);
+    memcpy(result->stderr_text + result->stderr_size, text, size);
+    result->stderr_size += size;
+    result->stderr_text[result->stderr_size] = 0;
+}
+const char *build_host_publish_pair(void *service, const pin_value *arguments, pin_value *results)
+{
+    build_host *host = service;
+    if (!host) {
+        return "build host service is unavailable";
+    }
+    const char *error = build_host_ready(host);
+    if (error) {
+        return error;
+    }
+    const char *input[4];
+    for (int i = 0; i < 4; i++) {
+        error = build_values_cstring(&host->values, arguments[i], &input[i]);
+        if (error) {
+            return error;
+        }
+    }
+    results[0].i = 1;
+    size_t remaining = sizeof host->result->stderr_text - host->result->stderr_size - 1;
+    const char *sources[] = { input[0], input[2] };
+    size_t evidence_size = 0;
+    char *evidence = host->result->stderr_truncated
+                       ? NULL
+                       : file_pair_source_diagnostic(sources, remaining, &evidence_size);
+    char *paths[4] = { 0 };
+    struct stat before[4];
+    bool present[4];
+    if (!raw_paths(input, paths, before, present)) {
+        if (evidence) {
+            append(host, evidence, evidence_size);
+        }
+        for (int i = 0; i < 4; i++) {
+            free(paths[i]);
+        }
+        bool reported = evidence != NULL;
+        free(evidence);
+        return reported ? "invalid build artifact-pair paths; staging retained" : "invalid build artifact-pair paths; staging retained; recovery paths exceed capture capacity";
+    }
+    file_pair_plan plan = { .source = { paths[0], paths[2] },
+                            .destination = { paths[1], paths[3] },
+                            .mode = FILE_PAIR_EXCLUSIVE };
+    /* Reserve the full result/diagnostic bound before backup preparation.
+     * Appending after admission cannot allocate, truncate, or check READY. */
+    if (host->result->stderr_truncated ||
+        file_pair_diagnostic_capacity(&plan) > remaining) {
+        if (evidence) {
+            append(host, evidence, evidence_size);
+        }
+        for (int i = 0; i < 4; i++) {
+            free(paths[i]);
+        }
+        bool reported = evidence != NULL;
+        free(evidence);
+        return reported
+                 ? "build artifact-pair diagnostic capacity exceeded; staging "
+                   "retained"
+                 : "build artifact-pair diagnostic capacity exceeded; staging "
+                   "retained; recovery paths exceed capture capacity";
+    }
+    file_pair pair;
+    if (file_pair_prepare(&pair, &plan)) {
+        if (!prepared_paths(&pair, paths, before, present)) {
+            pair.system_error = EINVAL;
+            file_pair_abort(&pair);
+        } else {
+            error = build_host_ready(host);
+            if (error) {
+                file_pair_abort(&pair);
+            } else {
+                results[0].i = file_pair_execute(&pair);
+            }
+        }
+    }
+    append(host, pair.diagnostic, pair.diagnostic_size);
+    file_pair_dispose(&pair);
+    free(evidence);
+    for (int i = 0; i < 4; i++) {
+        free(paths[i]);
+    }
+    return error;
+}
diff --git a/src/support/file_pair.c b/src/support/file_pair.c
new file mode 100644
--- /dev/null
+++ b/src/support/file_pair.c
@@ -0,0 +1,336 @@
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include "support/file_pair.h"
+
+#include "support/xalloc.h"
+
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#if defined(__linux__)
+#include <sys/syscall.h>
+#endif
+
+static bool fail(file_pair *pair, file_pair_operation operation, int entry)
+{
+    if (!(pair->plan.failures & FILE_PAIR_FAIL(operation, entry))) {
+        return false;
+    }
+    errno = EIO;
+    return true;
+}
+static void failure(file_pair *pair, file_pair_operation operation, int entry)
+{
+    if (!pair->system_error) {
+        pair->system_error = errno;
+        pair->failed_operation = operation;
+        pair->failed_entry = entry;
+    }
+}
+static int move(file_pair *pair, file_pair_operation operation, int entry, const char *source, const char *destination)
+{
+    if (fail(pair, operation, entry)) {
+        return -1;
+    }
+    if (operation == FILE_PAIR_BACKUP || pair->plan.mode == FILE_PAIR_NATIVE) {
+        return rename(source, destination);
+    }
+    switch (pair->plan.mode) {
+        case FILE_PAIR_EXCLUSIVE:
+#if defined(__APPLE__)
+            return renamex_np(source, destination, RENAME_EXCL);
+#elif defined(__linux__)
+            return (int)syscall(SYS_renameat2, AT_FDCWD, source, AT_FDCWD, destination, 1 /* RENAME_NOREPLACE */);
+#else
+            errno = ENOTSUP;
+            return -1;
+#endif
+        case FILE_PAIR_NATIVE: break;
+    }
+    assert(false);
+    return -1;
+}
+static bool remove_owned(file_pair *pair, file_pair_operation operation, int entry, const char *path)
+{
+    if (!fail(pair, operation, entry) && (!unlink(path) || errno == ENOENT)) {
+        return true;
+    }
+    failure(pair, operation, entry);
+    return false;
+}
+static size_t quoted_size(const char *path)
+{
+    size_t size = 2;
+    for (const unsigned char *at = (const unsigned char *)path; *at; at++) {
+        size += *at >= 32 && *at <= 126 && *at != '"' && *at != '\\' ? 1 : 4;
+    }
+    return size;
+}
+static char *quote(char *out, const char *path)
+{
+    static const char hex[] = "0123456789abcdef";
+    *out++ = '"';
+    for (const unsigned char *at = (const unsigned char *)path; *at; at++) {
+        if (*at >= 32 && *at <= 126 && *at != '"' && *at != '\\') {
+            *out++ = (char)*at;
+        } else {
+            *out++ = '\\';
+            *out++ = 'x';
+            *out++ = hex[*at >> 4];
+            *out++ = hex[*at & 15];
+        }
+    }
+    *out++ = '"';
+    *out++ = '\n';
+    *out = 0;
+    return out;
+}
+char *file_pair_source_diagnostic(const char *const sources[2], size_t limit, size_t *size)
+{
+    static const char
+        first[] = "artifact-pair not admitted; raw source arguments\nsource0 ";
+    static const char second[] = "source1 ";
+    *size = strlen(first) + quoted_size(sources[0]) + 1 + strlen(second) +
+            quoted_size(sources[1]) + 1;
+    if (*size > limit) {
+        return NULL;
+    }
+    char *text = xmalloc(*size + 1);
+    memcpy(text, first, strlen(first));
+    char *out = quote(text + strlen(first), sources[0]);
+    memcpy(out, second, strlen(second));
+    out = quote(out + strlen(second), sources[1]);
+    assert((size_t)(out - text) == *size);
+    return text;
+}
+size_t file_pair_diagnostic_capacity(const file_pair_plan *plan)
+{
+    size_t capacity = 1024;
+    for (int i = 0; i < 2; i++) {
+        capacity += quoted_size(plan->source[i]) +
+                    2 * quoted_size(plan->destination[i]) + strlen(".tmp.XXXXXX");
+    }
+    return capacity;
+}
+static void diagnose(file_pair *pair)
+{
+    pair->diagnostic_size = 0;
+    if (!pair->status) {
+        pair->diagnostic[0] = 0;
+        return;
+    }
+    int length = snprintf(
+        pair->diagnostic,
+        pair->diagnostic_capacity,
+        "artifact-pair status=%d operation=%d entry=%d errno=%d\n",
+        pair->status,
+        pair->failed_operation,
+        pair->failed_entry,
+        pair->system_error
+    );
+    assert(length > 0);
+    pair->diagnostic_size = (size_t)length;
+    for (int i = 0; i < 2; i++) {
+        length = snprintf(
+            pair->diagnostic + pair->diagnostic_size,
+            pair->diagnostic_capacity - pair->diagnostic_size,
+            "source%d consumed=%d retained=%d ",
+            i,
+            pair->consumed[i],
+            pair->retained_source[i]
+        );
+        pair->diagnostic_size += (size_t)length;
+        pair->diagnostic_size = (size_t)(quote(
+                                             pair->diagnostic + pair->diagnostic_size,
+                                             pair->plan.source[i]
+                                         ) -
+                                         pair->diagnostic);
+        length = snprintf(
+            pair->diagnostic + pair->diagnostic_size,
+            pair->diagnostic_capacity - pair->diagnostic_size,
+            "destination%d prior=%d published=%d ",
+            i,
+            pair->existed[i],
+            pair->published[i]
+        );
+        pair->diagnostic_size += (size_t)length;
+        pair->diagnostic_size = (size_t)(quote(
+                                             pair->diagnostic + pair->diagnostic_size,
+                                             pair->plan.destination[i]
+                                         ) -
+                                         pair->diagnostic);
+        length = snprintf(
+            pair->diagnostic + pair->diagnostic_size,
+            pair->diagnostic_capacity - pair->diagnostic_size,
+            "backup%d old-bytes=%d retained=%d ",
+            i,
+            pair->old_moved[i],
+            pair->retained_backup[i]
+        );
+        pair->diagnostic_size += (size_t)length;
+        pair->diagnostic_size = (size_t)(quote(pair->diagnostic + pair->diagnostic_size, pair->backup[i]) -
+                                         pair->diagnostic);
+    }
+    assert(pair->diagnostic_size < pair->diagnostic_capacity);
+}
+static bool cleanup(file_pair *pair)
+{
+    bool clean = true;
+    for (int i = 0; i < 2; i++) {
+        if (pair->admitted && !pair->consumed[i]) {
+            pair->retained_source[i] = !remove_owned(
+                pair,
+                FILE_PAIR_REMOVE_SOURCE,
+                i,
+                pair->plan.source[i]
+            );
+            clean &= !pair->retained_source[i];
+        }
+        if (!pair->reserved[i]) {
+            continue;
+        }
+        if (pair->old_moved[i] && !pair->committed) {
+            pair->retained_backup[i] = true;
+            clean = false;
+            continue;
+        }
+        pair->retained_backup[i] = !remove_owned(pair, FILE_PAIR_REMOVE_BACKUP, i, pair->backup[i]);
+        clean &= !pair->retained_backup[i];
+        if (!pair->retained_backup[i]) {
+            pair->reserved[i] = false;
+            pair->old_moved[i] = false;
+        }
+    }
+    return clean;
+}
+bool file_pair_prepare(file_pair *pair, const file_pair_plan *plan)
+{
+    *pair = (file_pair){ .plan = *plan, .status = 1, .failed_entry = -1 };
+    size_t capacity = file_pair_diagnostic_capacity(plan);
+    for (int i = 0; i < 2; i++) {
+        size_t size = strlen(plan->destination[i]) + sizeof ".tmp.XXXXXX";
+        pair->backup[i] = xmalloc(size);
+        snprintf(pair->backup[i], size, "%s.tmp.XXXXXX", plan->destination[i]);
+    }
+    pair->diagnostic = xmalloc(capacity);
+    pair->diagnostic_capacity = capacity;
+    for (int i = 0; i < 2; i++) {
+        struct stat info;
+        if (!lstat(plan->destination[i], &info)) {
+            pair->existed[i] = true;
+            if (!S_ISREG(info.st_mode)) {
+                errno = EINVAL;
+                failure(pair, FILE_PAIR_RESERVE, i);
+                file_pair_abort(pair);
+                return false;
+            }
+        } else if (errno != ENOENT) {
+            failure(pair, FILE_PAIR_RESERVE, i);
+            file_pair_abort(pair);
+            return false;
+        }
+    }
+    for (int i = 0; i < 2; i++) {
+        int fd = fail(pair, FILE_PAIR_RESERVE, i) ? -1 : mkstemp(pair->backup[i]);
+        if (fd < 0) {
+            failure(pair, FILE_PAIR_RESERVE, i);
+            file_pair_abort(pair);
+            return false;
+        }
+        pair->reserved[i] = true;
+        if (close(fd)) {
+            failure(pair, FILE_PAIR_RESERVE, i);
+            file_pair_abort(pair);
+            return false;
+        }
+    }
+    pair->prepared = true;
+    return true;
+}
+int file_pair_abort(file_pair *pair)
+{
+    assert(!pair->admitted);
+    cleanup(pair);
+    pair->status = 1;
+    diagnose(pair);
+    return pair->status;
+}
+int file_pair_execute(file_pair *pair)
+{
+    assert(pair->prepared && !pair->admitted);
+    pair->admitted = true;
+    bool valid = true;
+    for (int i = 0; valid && i < 2; i++) {
+        if (pair->existed[i]) {
+            valid = !move(pair, FILE_PAIR_BACKUP, i, pair->plan.destination[i], pair->backup[i]);
+            pair->old_moved[i] = valid;
+            if (!valid) {
+                failure(pair, FILE_PAIR_BACKUP, i);
+            }
+        }
+    }
+    for (int i = 0; valid && i < 2; i++) {
+        valid = !move(
+            pair,
+            FILE_PAIR_PUBLISH,
+            i,
+            pair->plan.source[i],
+            pair->plan.destination[i]
+        );
+        pair->published[i] = valid;
+        pair->consumed[i] = valid;
+        if (!valid) {
+            failure(pair, FILE_PAIR_PUBLISH, i);
+        }
+    }
+    pair->committed = valid;
+    pair->status = valid ? 0 : 1;
+    if (!valid) {
+        for (int i = 0; i < 2; i++) {
+            bool absent = true;
+            if (pair->published[i]) {
+                absent = remove_owned(pair, FILE_PAIR_REMOVE_NEW, i, pair->plan.destination[i]);
+                if (absent) {
+                    pair->published[i] = false;
+                } else {
+                    pair->status = 2;
+                }
+            }
+            if (pair->old_moved[i]) {
+                if (absent && !move(
+                                  pair,
+                                  FILE_PAIR_RESTORE,
+                                  i,
+                                  pair->backup[i],
+                                  pair->plan.destination[i]
+                              )) {
+                    pair->old_moved[i] = false;
+                    pair->reserved[i] = false;
+                } else {
+                    failure(pair, FILE_PAIR_RESTORE, i);
+                    pair->retained_backup[i] = true;
+                    pair->status = 2;
+                }
+            }
+        }
+    }
+    bool clean = cleanup(pair);
+    if (pair->committed && !clean) {
+        pair->status = 3;
+    }
+    diagnose(pair);
+    return pair->status;
+}
+void file_pair_dispose(file_pair *pair)
+{
+    free(pair->backup[0]);
+    free(pair->backup[1]);
+    free(pair->diagnostic);
+    *pair = (file_pair){ 0 };
+}
diff --git a/src/support/file_pair.h b/src/support/file_pair.h
new file mode 100644
--- /dev/null
+++ b/src/support/file_pair.h
@@ -0,0 +1,67 @@
+#ifndef CHIBI_SUPPORT_FILE_PAIR_INTERNAL_H
+#define CHIBI_SUPPORT_FILE_PAIR_INTERNAL_H
+
+#include <stdbool.h>
+#include <stddef.h>
+
+/* Private two-file transport. Callers own path storage through dispose.
+ * Native callers stage their own bytes; the host admits arbitrary paths.
+ * No operation changes cwd or interprets project/compiler metadata. */
+typedef enum
+{
+    FILE_PAIR_NATIVE,
+    FILE_PAIR_EXCLUSIVE
+} file_pair_mode;
+typedef enum
+{
+    FILE_PAIR_RESERVE,
+    FILE_PAIR_BACKUP,
+    FILE_PAIR_PUBLISH,
+    FILE_PAIR_REMOVE_NEW,
+    FILE_PAIR_RESTORE,
+    FILE_PAIR_REMOVE_SOURCE,
+    FILE_PAIR_REMOVE_BACKUP,
+    FILE_PAIR_OPERATION_COUNT
+} file_pair_operation;
+
+/* The private test dispatcher can fail a particular operation/entry without
+ * process-global callbacks or environment controls. Production passes zero. */
+#define FILE_PAIR_FAIL(OP, ENTRY) (1u << ((OP) * 2 + (ENTRY)))
+typedef struct
+{
+    const char *source[2], *destination[2];
+    file_pair_mode mode;
+    unsigned failures;
+} file_pair_plan;
+
+typedef struct
+{
+    file_pair_plan plan;
+    char *backup[2];
+    bool existed[2], reserved[2], old_moved[2], published[2];
+    bool consumed[2], retained_source[2], retained_backup[2];
+    bool admitted, committed, prepared;
+    int status, system_error, failed_operation, failed_entry;
+    char *diagnostic;
+    size_t diagnostic_capacity, diagnostic_size;
+} file_pair;
+
+/* Exact conservative diagnostic bound; includes escaped full path names. */
+size_t file_pair_diagnostic_capacity(const file_pair_plan *);
+/* Error-only pre-admission evidence. Returns allocated escaped source names
+ * if their complete block fits limit; otherwise NULL without allocation.
+ * Size always receives the required byte count, excluding NUL. */
+char *file_pair_source_diagnostic(const char *const sources[2], size_t limit, size_t *size);
+/* Reserves BOTH empty backup slots and all result/diagnostic storage before
+ * any old destination moves. Failure cleans only owned empty reservations;
+ * sources remain caller-owned. Full retained paths stay in this result. */
+bool file_pair_prepare(file_pair *, const file_pair_plan *);
+/* Reject a prepared but unadmitted transaction, cleaning empty reservations.
+ * Execute transfers disposable source ownership and defers cancellation.
+ * 0 committed/clean; 1 prior state restored; 2 restoration incomplete;
+ * 3 committed with housekeeping retained. Neither function allocates. */
+int file_pair_abort(file_pair *);
+int file_pair_execute(file_pair *);
+/* Frees storage only. Never removes retained files. */
+void file_pair_dispose(file_pair *);
+#endif
