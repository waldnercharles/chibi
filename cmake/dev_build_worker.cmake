cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/dev_snapshot.cmake")

function(chibi_build_fingerprint output source_digest config cmake build_dir)
    string(JSON build_config ERROR_VARIABLE config_error GET "${config}" build_config)
    if(config_error)
        set(build_config "")
    endif()
    set(cache_digest "missing")
    if(EXISTS "${build_dir}/CMakeCache.txt")
        file(SHA256 "${build_dir}/CMakeCache.txt" cache_digest)
    endif()
    string(SHA256 fingerprint "${source_digest}\n${build_config}\n${cmake}\n${cache_digest}")
    set(${output} "${fingerprint}" PARENT_SCOPE)
endfunction()

function(chibi_current_generation output source_dir source_digest resident application_hash)
    set(application "")
    set(manifest "${source_dir}/.chibi/application.current")
    if(NOT EXISTS "${manifest}")
        return()
    endif()
    file(STRINGS "${manifest}" application LIMIT_COUNT 1)
    if(NOT EXISTS "${application}")
        return()
    endif()
    if(IS_SYMLINK "${application}")
        return()
    endif()
    get_filename_component(directory "${application}" DIRECTORY)
    file(REAL_PATH "${application}" real_application)
    file(REAL_PATH "${directory}" real_directory)
    file(REAL_PATH "${source_dir}/.chibi/generations" generation_root)
    string(FIND "${real_directory}/" "${generation_root}/" in_generations)
    if(NOT in_generations EQUAL 0)
        return()
    endif()
    set(metadata "${directory}/.chibi-generation")
    if(NOT EXISTS "${metadata}")
        return()
    endif()
    file(READ "${metadata}" saved)
    file(SHA256 "${real_application}" staged_hash)
    if(saved STREQUAL "${source_digest}\n${resident}\n${application_hash}\n" AND
       staged_hash STREQUAL application_hash)
        set(${output} "${application}" PARENT_SCOPE)
    endif()
endfunction()

function(chibi_prune_generation path)
    file(LOCK "${path}/.lease" GUARD FUNCTION TIMEOUT 0 RESULT_VARIABLE locked)
    if(NOT locked STREQUAL "0")
        return()
    endif()
    file(REMOVE_RECURSE "${path}")
endfunction()

function(chibi_prune_generations root keep)
    set(current "")
    if(EXISTS "${source_dir}/.chibi/application.current")
        file(STRINGS "${source_dir}/.chibi/application.current" current LIMIT_COUNT 1)
        get_filename_component(current "${current}" DIRECTORY)
    endif()
    file(GLOB directories LIST_DIRECTORIES true "${root}/*")
    list(SORT directories ORDER DESCENDING)
    set(recent 0)
    foreach(path IN LISTS directories)
        if(NOT IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
            continue()
        endif()
        get_filename_component(name "${path}" NAME)
        string(LENGTH "${name}" length)
        if(NOT length EQUAL 32)
            continue()
        endif()
        string(SUBSTRING "${name}" 0 8 date)
        string(SUBSTRING "${name}" 8 1 separator1)
        string(SUBSTRING "${name}" 9 6 time)
        string(SUBSTRING "${name}" 15 1 separator2)
        string(SUBSTRING "${name}" 16 16 nonce)
        if(NOT date MATCHES "^[0-9]+$" OR NOT time MATCHES "^[0-9]+$" OR
           NOT nonce MATCHES "^[0-9a-f]+$" OR NOT separator1 STREQUAL "-" OR
           NOT separator2 STREQUAL "-")
            continue()
        endif()
        math(EXPR recent "${recent} + 1")
        if(recent LESS_EQUAL 8 OR path STREQUAL keep OR path STREQUAL current)
            continue()
        endif()
        chibi_prune_generation("${path}")
    endforeach()
endfunction()

file(READ "${DEV_CONFIG}" config)
string(JSON version GET "${config}" version)
if(NOT version EQUAL 1)
    message(FATAL_ERROR "Unsupported development descriptor version")
endif()
foreach(key source_dir build_dir cmake)
    string(JSON ${key} GET "${config}" "${key}")
endforeach()
file(MAKE_DIRECTORY "${build_dir}")
file(LOCK "${build_dir}/dev-build.lock" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE locked)
if(NOT locked STREQUAL "0")
    message(FATAL_ERROR "Another development build is active")
endif()
set(rebuild_marker "${build_dir}/dev-rebuild-required")
if(FORCE_REBUILD)
    file(WRITE "${rebuild_marker}" "Sources changed during the previous build.\n")
endif()
chibi_source_snapshot(before resident_sources "${config}")
set(compiled_snapshot "${build_dir}/dev-source-digest")
set(build_fingerprint_file "${build_dir}/dev-build-fingerprint")
# Apple ships GNU Make 3.81, which can compile an object and then miss the
# relink when both outputs share a timestamp second. Hashes detect that work
# is needed; clean-first prevents the old build tool from reusing those files.
if(EXISTS "${build_dir}/CMakeCache.txt")
    file(STRINGS "${build_dir}/CMakeCache.txt" generator REGEX "^CMAKE_GENERATOR:INTERNAL=")
    if(generator STREQUAL "CMAKE_GENERATOR:INTERNAL=Unix Makefiles")
        file(STRINGS "${build_dir}/CMakeCache.txt" make_program REGEX "^CMAKE_MAKE_PROGRAM:FILEPATH=")
        string(REGEX REPLACE "^[^=]*=" "" make_program "${make_program}")
        execute_process(COMMAND "${make_program}" --version OUTPUT_VARIABLE make_version)
        if(make_version MATCHES "GNU Make ([0-9.]+)")
            if(CMAKE_MATCH_1 VERSION_LESS "4.0")
                set(previous "")
                if(EXISTS "${compiled_snapshot}")
                    file(READ "${compiled_snapshot}" previous)
                endif()
                if(NOT previous STREQUAL before)
                    file(WRITE "${rebuild_marker}" "Changed sources require a clean build with GNU Make before 4.0.\n")
                endif()
            endif()
        endif()
    endif()
endif()
set(rebuild_args)
if(EXISTS "${rebuild_marker}")
    # Ninja tracks sub-second input timestamps and interrupted edges. Retrying
    # its incremental build preserves unchanged resident binaries; cleaning
    # those binaries would turn an application edit into a required restart.
    if(NOT generator STREQUAL "CMAKE_GENERATOR:INTERNAL=Ninja")
        list(APPEND rebuild_args --clean-first)
    endif()
    set(SKIP_BUILD OFF)
endif()
set(built FALSE)
if(NOT JOBS)
    set(JOBS 4)
endif()
if(NOT JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "JOBS must be a positive integer")
endif()
if(NOT SKIP_BUILD AND NOT EXISTS "${rebuild_marker}" AND EXISTS "${compiled_snapshot}" AND
   EXISTS "${build_fingerprint_file}")
    chibi_build_fingerprint(current_fingerprint "${before}" "${config}" "${cmake}" "${build_dir}")
    file(READ "${build_fingerprint_file}" previous_fingerprint)
    string(JSON host GET "${config}" host)
    string(JSON application GET "${config}" application)
    chibi_config_array(libraries "${config}" libraries)
    set(artifacts_exist TRUE)
    foreach(path IN ITEMS "${host}" "${application}" ${libraries})
        if(NOT EXISTS "${path}")
            set(artifacts_exist FALSE)
        endif()
    endforeach()
    if(current_fingerprint STREQUAL previous_fingerprint AND artifacts_exist)
        set(SKIP_BUILD ON)
    endif()
endif()
if(NOT SKIP_BUILD)
    execute_process(COMMAND "${cmake}" -S "${source_dir}" -B "${build_dir}"
        -DCHIBI_DEVELOPMENT_RELOAD=ON RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Development configure failed")
    endif()
    string(JSON build_config ERROR_VARIABLE config_error GET "${config}" build_config)
    set(config_args)
    if(NOT config_error AND build_config)
        list(APPEND config_args --config "${build_config}")
    endif()
    execute_process(COMMAND "${cmake}" --build "${build_dir}" --target chibi chibi_dll
        ${config_args} ${rebuild_args} --parallel "${JOBS}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Development build failed")
    endif()
    file(REMOVE "${rebuild_marker}")
    set(built TRUE)
endif()
# Reconfiguration can change dependency roots and artifact paths. A cached
# no-op does not configure, so its final snapshot below closes the short race
# between deciding to reuse a generation and publishing the result.
file(READ "${DEV_CONFIG}" current_config)
if(built)
    if(NOT config STREQUAL current_config)
        set(config "${current_config}")
    endif()
    chibi_source_snapshot(after resident_sources "${config}")
    if(NOT before STREQUAL after)
        file(WRITE "${rebuild_marker}" "Sources changed during the previous build.\n")
        chibi_write_generated("${RESULT}" "{\"status\":\"stale\"}\n")
        return()
    endif()
elseif(NOT config STREQUAL current_config)
    file(WRITE "${rebuild_marker}" "Development configuration changed during the previous build.\n")
    chibi_write_generated("${RESULT}" "{\"status\":\"stale\"}\n")
    return()
else()
    set(after "${before}")
endif()
foreach(key application host)
    string(JSON ${key} GET "${config}" "${key}")
endforeach()
chibi_config_array(libraries "${config}" libraries)
set(resident "${resident_sources}\n")
foreach(path IN ITEMS "${host}" ${libraries})
    file(SHA256 "${path}" hash)
    get_filename_component(name "${path}" NAME)
    string(APPEND resident "${name}\n${hash}\n")
endforeach()
string(SHA256 resident "${resident}")
file(SHA256 "${application}" application_hash)
set(generations "${source_dir}/.chibi/generations")
file(MAKE_DIRECTORY "${generations}")
file(LOCK "${source_dir}/.chibi/generations.lock" GUARD PROCESS TIMEOUT 30 RESULT_VARIABLE locked)
if(NOT locked STREQUAL "0")
    message(FATAL_ERROR "Could not lock development generations: ${locked}")
endif()
set(reused_application "")
if(NOT built)
    chibi_current_generation(reused_application "${source_dir}" "${after}" "${resident}" "${application_hash}")
endif()
if(reused_application)
    set(application "${reused_application}")
    get_filename_component(directory "${application}" DIRECTORY)
    get_filename_component(host_name "${host}" NAME)
    set(host "${directory}/${host_name}")
else()
    string(TIMESTAMP timestamp "%Y%m%d-%H%M%S" UTC)
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(directory "${generations}/${timestamp}-${nonce}")
    file(MAKE_DIRECTORY "${directory}")
    get_filename_component(application_stem "${application}" NAME_WE)
    get_filename_component(application_extension "${application}" LAST_EXT)
    # DYLD_LIBRARY_PATH can override even absolute dlopen paths by basename.
    # A distinct leaf name prevents lookup from finding an older staged module.
    set(application_name "${application_stem}-${nonce}${application_extension}")
    foreach(path IN ITEMS "${host}" "${application}" ${libraries})
        get_filename_component(name "${path}" NAME)
        if(path STREQUAL application)
            set(name "${application_name}")
        endif()
        execute_process(COMMAND "${cmake}" -E copy "${path}" "${directory}/${name}" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            file(REMOVE_RECURSE "${directory}")
            message(FATAL_ERROR "Could not stage ${path}")
        endif()
        if(path STREQUAL application)
            continue()
        endif()
        file(REAL_PATH "${path}" real)
        get_filename_component(parent "${path}" DIRECTORY)
        get_filename_component(name "${path}" NAME)
        file(GLOB siblings "${parent}/*")
        foreach(sibling IN LISTS siblings)
            if(IS_SYMLINK "${sibling}")
                file(REAL_PATH "${sibling}" sibling_real)
                if(sibling_real STREQUAL real)
                    get_filename_component(alias "${sibling}" NAME)
                    if(NOT alias STREQUAL name)
                        file(CREATE_LINK "${name}" "${directory}/${alias}" SYMBOLIC RESULT result)
                        if(NOT result STREQUAL "0")
                            file(REMOVE_RECURSE "${directory}")
                            message(FATAL_ERROR "Could not stage library alias ${alias}")
                        endif()
                    endif()
                endif()
            endif()
        endforeach()
    endforeach()
    file(WRITE "${directory}/.chibi-generation" "${after}\n${resident}\n${application_hash}\n")
endif()
# Do not publish outputs made from sources edited during artifact staging.
chibi_source_snapshot(final unused "${config}")
if(NOT final STREQUAL after)
    if(NOT reused_application)
        file(REMOVE_RECURSE "${directory}")
    endif()
    file(WRITE "${rebuild_marker}" "Sources changed during the previous build.\n")
    chibi_write_generated("${RESULT}" "{\"status\":\"stale\"}\n")
    return()
endif()
if(built)
    chibi_write_generated("${compiled_snapshot}" "${after}")
    chibi_build_fingerprint(compiled_fingerprint "${after}" "${config}" "${cmake}" "${build_dir}")
    chibi_write_generated("${build_fingerprint_file}" "${compiled_fingerprint}")
endif()
get_filename_component(host_name "${host}" NAME)
if(NOT reused_application)
    set(application "${directory}/${application_name}")
endif()
set(host "${directory}/${host_name}")
file(REAL_PATH "${DEV_CONFIG}" config_path)
set(source_digest "${after}")
set(result "{\"status\":\"ready\"}")
foreach(key application host directory resident source_digest)
    chibi_json_string(value "${${key}}")
    string(JSON result SET "${result}" "${key}" "${value}")
endforeach()
chibi_json_string(value "${config_path}")
string(JSON result SET "${result}" config "${value}")
chibi_prune_generations("${generations}" "${directory}")
chibi_write_generated("${RESULT}" "${result}\n")
