version 3
name "SurfaceActivity"
domain "material"
id_counter 300
description "A neutral lit receiver emits the local Surface Influence color."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=100 type="Shader Surface Influence" x=0.0 y=0.0
            - {
                id 200
                type "Shader Surface Output"
                x 300.0
                y 0.0
                inputs {
                    "Base Color" {
                        default x=0.18 y=0.18 z=0.18
                    }
                    Roughness 0.8
                }
            }
        }
        (array)edges {
            - from="100.Color" to="200.Emission"
        }
    }
}
