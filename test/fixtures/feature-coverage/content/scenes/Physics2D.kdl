version 1
name "Physics2D"
(array)entities {
    - {
        name "Ball"
        prototype "Ball"
        (array)behaviors "PhysicsProbe"
    }
    - name="Wall" prototype="Wall"
    - {
        name "Spinner"
        prototype "Spinner"
        components {
            GAME.GameJoint other="Wall"
        }
    }
    - name="Gravity" prototype="Gravity"
}
