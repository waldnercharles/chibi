// A preparing XP pickup preserves the dead enemy pose and material while
// emitting its actual primitive parts, then restores its ordinary flat outline
// pickup presentation.
ArenaDropBehavior :: behavior {

    on Begin :: () {
        if (f64(self.Pickup.state) == 3) {
            await Spawn_Surface_Pulse(Prototype: ArenaDeathPulse, Position: self.Transform);
            await Emit_Source_Frame(Position: self.Transform, Appearance: self.Geometry3D, Material: self.Shader, Orientation: self.Orientation, Visual: self.VisualTransform);
            self.Geometry3D = {
                primitive: 9,
                width: 5.0,
                depth: 5.0,
                height: 0.1,
                elevation: 5.0
            };
            self.Shader = {
                material: "ArenaExperience",
                shape: "",
                parameters: "",
                bounds_x: 0.0,
                bounds_y: 0.0
            };
            self.Orientation.radians = 0.0;
            await set_component(Component: VisualTransform, Entity: 0, Value.pitch: number = 0.0, Value.roll: number = 0.0, Value.scale: number = 1.0);
            self.Pickup.state = 0;
        } else {
        }
    }
    Emit_Source_Frame :: (Position: Transform = null, Appearance: Geometry3D = null, Material: Shader = null, Orientation: Orientation = null, Visual: VisualTransform = null) -> () {

        action forloop = for_loop(FirstIndex: 0, LastIndex: int(subtract(A: plain int = primitive_part(Appearance: Appearance, Index: 0).Count, B: plain int = 1)));
        forloop();
        after forloop.Body {
            await Spawn_Source_Beam(Position: Position, Appearance: Appearance, Material: Material, Orientation: Orientation, Visual: Visual, Center: primitive_part(Appearance: Appearance, Index: forloop.Index).Center, Center_Y: primitive_part(Appearance: Appearance, Index: forloop.Index).Elevation, Width: primitive_part(Appearance: Appearance, Index: forloop.Index).Width, Height: primitive_part(Appearance: Appearance, Index: forloop.Index).Height, Depth: primitive_part(Appearance: Appearance, Index: forloop.Index).Depth, Primitive: primitive_part(Appearance: Appearance, Index: forloop.Index).Primitive);
        }
        after forloop.Completed {
            return ();
        }
    }
    Spawn_Surface_Pulse :: (Prototype: Prototype = ArenaHitPulse, Position: Transform = null) -> () {

        action spawn_prototype_action = spawn_prototype(Prototype: Prototype);
        spawn_prototype_action();
        after spawn_prototype_action {
            spawn_prototype_action.Entity.Transform = Position;
            return ();
        }
    }
    Spawn_Source_Beam :: (Position: Transform = null, Appearance: Geometry3D = null, Material: Shader = null, Orientation: Orientation = null, Visual: VisualTransform = null, Center: vec2 = null, Center_Y: number = 0.0, Width: number = 0.0, Height: number = 0.0, Depth: number = 0.0, Primitive: int = 0) -> () {

        action spawn_prototype_action = spawn_prototype(Prototype: ArenaEnemyShard);
        spawn_prototype_action();
        after spawn_prototype_action {
            await set_component(Component: Transform, Entity: spawn_prototype_action.Entity, Value.x: number = number(f64(add(A: plain f64 = Position.x, B: plain f64 = transform_visual_offset(Offset: Center, Elevation: Center_Y, Heading: Orientation.radians, Visual: Visual).Offset.x))), Value.y: number = number(f64(add(A: plain f64 = Position.y, B: plain f64 = transform_visual_offset(Offset: Center, Elevation: Center_Y, Heading: Orientation.radians, Visual: Visual).Offset.y))));
            await set_component(Component: Geometry3D, Entity: spawn_prototype_action.Entity, Value.primitive: int = Primitive, Value.width: number = Width, Value.depth: number = Depth, Value.height: number = Height, Value.elevation: number = number(f64(add(A: plain f64 = Appearance.elevation, B: plain f64 = transform_visual_offset(Offset: Center, Elevation: Center_Y, Heading: Orientation.radians, Visual: Visual).Elevation))));
            await set_component(Component: Velocity, Entity: spawn_prototype_action.Entity, Value.x: number = number(f64(multiply(A: plain f64 = transform_visual_offset(Offset: Center, Elevation: Center_Y, Heading: Orientation.radians, Visual: Visual).Offset.x, B: plain f64 = 5.0))), Value.y: number = number(f64(multiply(A: plain f64 = transform_visual_offset(Offset: Center, Elevation: Center_Y, Heading: Orientation.radians, Visual: Visual).Offset.y, B: plain f64 = 5.0))));
            Shard := spawn_prototype_action.Entity
            Shard.Shader = Material;
            Shard.Orientation = Orientation;
            Shard.VisualTransform = Visual;
            return ();
        }
    }
}
