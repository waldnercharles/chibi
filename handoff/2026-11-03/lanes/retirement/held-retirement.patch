-    for (int pc = 0; pc < acount(f->instructions); pc++) {
-        if (f->instructions[pc].source == source &&
-            behavior_integer_reportable(f, &f->instructions[pc])) {
-            return f->instructions[pc].node_id;
-        }
-    }
