package source_parser_tests

import parser "project:source_parser"
import syntax "project:syntax_diagnostics"
import tk "project:source_tokenizer"
import strings "core:strings"

// Constructs the repository does not use, from the former Tree-sitter differential
// corpus (test/language/syntax_corpus), one short source each: the valid ones parse
// cleanly and the invalid ones are rejected with one diagnostic at the first token
// the grammar cannot read. Sources stay short because a test has a fixed instruction budget.
Accepts :: (text: string) {
    switch parser.Parse(text) {
        case .Parsed(nodes, fields, is_named, is_extra, root):
            assert(length(nodes) > 0, "the parser reads this source");
        case .Rejected(diagnostic):
            assert(false, "the parser reads this source");
    }
}

Rejects :: (text: string, line: int, column: int) {
    switch parser.Parse(text) {
        case .Parsed(nodes, fields, is_named, is_extra, root):
            assert(false, "the parser rejects this source");
        case .Rejected(diagnostic):
            assert(diagnostic.line == line, "diagnostic line");
            assert(diagnostic.column == column, "diagnostic column");
            assert(diagnostic.start >= 0 && diagnostic.end >= diagnostic.start, "diagnostic range");
            assert(diagnostic.document == 0 && diagnostic.message != "", "diagnostic message");
    }
}

@test
AcceptsAttributes :: () {
    Accepts("package p\n\n@a\n@b\nR :: struct {\n}\n");
}

@test
AcceptsErrorUnion :: () {
    Accepts("package p\n\n@error\npub Problem :: union {\n    A | B\n}\n");
}

@test
AcceptsForeignImport :: () {
    Accepts("package p\nforeign import libc \"system:c\"\n");
}

@test
AcceptsForeignBlock :: () {
    Accepts("package p\nforeign import probe \"libprobe.a\"\nforeign probe {\n    chibi_probe_add :: (a: i32, b: i32) -> i32\n    chibi_probe_reset :: ()\n    chibi_probe_open :: (flags: u32) -> rawptr\n}\n");
}

@test
AcceptsForceUnwrap :: () {
    Accepts("package p\nF :: (x: int?, y: int?) -> int {\n    return x! + y!;\n}\n");
}

@test
AcceptsOptionalMember :: () {
