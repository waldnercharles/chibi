package windows

import strings "core:strings"

// The Windows calls core:os needs, declared against kernel32 and called from
// native programs; the VM never runs foreign code. It mirrors core:sys/posix:
// the same names and shapes, so core:os picks one by `target.Os`.
//
// Paths and names are UTF-8 strings. The calls take UTF-16, so each string is
// converted with MultiByteToWideChar and back with WideCharToMultiByte, which
// keep Unicode paths. Each call borrows a NUL-terminated UTF-16 array. A call
// that fails returns false (or -1, or an empty result); the error
// code is not read yet. Arguments reads GetCommandLineW itself, so it works
// with any start module.

foreign import kernel32 "system:kernel32"
foreign import bcrypt "system:bcrypt"

foreign bcrypt {
    BCryptGenRandom :: (algorithm: rawptr, buffer: u8[], size: u32, flags: u32) -> i32
}

foreign kernel32 {
    MultiByteToWideChar :: (page: u32, flags: u32, text: u8[], length: i32, wide: u16[], size: i32) -> i32
    WideCharToMultiByte :: (page: u32, flags: u32, wide: u16[], length: i32, text: u8[], size: i32, fallback: rawptr, used: rawptr) -> i32
    GetFileAttributesW :: (path: u16[]) -> u32
    CreateDirectoryW :: (path: u16[], security: rawptr) -> i32
    DeleteFileW :: (path: u16[]) -> i32
    RemoveDirectoryW :: (path: u16[]) -> i32
    MoveFileExW :: (source: u16[], destination: u16[], flags: u32) -> i32
    CreateFileW :: (path: u16[], access: u32, share: u32, security: rawptr, creation: u32, flags: u32, template: rawptr) -> u64
    ReadFile :: (handle: u64, buffer: u8[], count: u32, read: u32[], overlapped: rawptr) -> i32
    WriteFile :: (handle: u64, buffer: u8[], count: u32, written: u32[], overlapped: rawptr) -> i32
    GetFileSizeEx :: (handle: u64, size: u8[]) -> i32
    GetFileInformationByHandle :: (handle: u64, information: u8[]) -> i32
    GetFileInformationByHandleEx :: (handle: u64, kind: i32, information: u8[], size: u32) -> i32
    GetFinalPathNameByHandleW :: (handle: u64, path: u16[], size: u32, flags: u32) -> u32
    GetCurrentDirectoryW :: (size: u32, path: u16[]) -> u32
    SetCurrentDirectoryW :: (path: u16[]) -> i32
    GetCurrentProcessId :: () -> u32
    GetCurrentProcess :: () -> u64
    GetProcessId :: (handle: u64) -> u32
    GetProcessTimes :: (handle: u64, created: u8[], exited: u8[], kernel: u8[], user: u8[]) -> i32
    GetTempPathW :: (size: u32, path: u16[]) -> u32
    GetTempFileNameW :: (path: u16[], prefix: u16[], unique: u32, name: u16[]) -> u32
    CopyFileW :: (source: u16[], destination: u16[], no_replace: i32) -> i32
    CloseHandle :: (handle: u64) -> i32
    GetEnvironmentVariableW :: (name: u16[], buffer: u16[], size: u32) -> u32
    GetEnvironmentStringsW :: () -> rawptr
    FreeEnvironmentStringsW :: (environment: rawptr) -> i32
    CompareStringOrdinal :: (left: rawptr, left_size: i32, right: u16[], right_size: i32, ignore_case: i32) -> i32
    FindFirstFileW :: (pattern: u16[], data: u16[]) -> u64
    FindNextFileW :: (handle: u64, data: u16[]) -> i32
    FindClose :: (handle: u64) -> i32
    GetCommandLineW :: () -> rawptr
    LoadLibraryW :: (path: u16[]) -> rawptr
    GetProcAddress :: (module: rawptr, name: cstring) -> rawptr
    FreeLibrary :: (module: rawptr) -> i32
    lstrlenW :: (text: rawptr) -> i32
    RtlMoveMemory :: (destination: u16[], source: rawptr, length: u64) -> i32
    GetStdHandle :: (which: i32) -> u64
    ExitProcess :: (code: u32) -> u32
    SetHandleInformation :: (handle: u64, mask: u32, flags: u32) -> i32
    CreatePipe :: (read: u64[], write: u64[], security: u8[], size: u32) -> i32
    PeekNamedPipe :: (pipe: u64, buffer: rawptr, size: u32, read: rawptr, available: u32[], left: rawptr) -> i32
    CreateProcessW :: (application: rawptr, command: u16[], process: rawptr, thread: rawptr, inherit: i32, flags: u32, environment: rawptr, directory: rawptr, startup: u8[], information: u8[]) -> i32
    WaitForSingleObject :: (handle: u64, milliseconds: u32) -> u32
    GetExitCodeProcess :: (handle: u64, code: u32[]) -> i32
    CreateJobObjectW :: (security: rawptr, name: rawptr) -> u64
    AssignProcessToJobObject :: (job: u64, process: u64) -> i32
    TerminateJobObject :: (job: u64, code: u32) -> i32
    TerminateProcess :: (process: u64, code: u32) -> i32
    ResumeThread :: (thread: u64) -> u32
    GetLastError :: () -> u32
}

pub KindNone: int : 0;
pub KindFile: int : 1;
pub KindDirectory: int : 2;
pub KindLink: int : 3;
pub KindOther: int : 4;

Utf8: u32 : 65001;
InvalidAttributes: u32 : 4294967295;
DirectoryAttribute: u32 : 16;
LinkAttribute: u32 : 1024;
ReadAccess: u32 : 2147483648;
WriteAccess: u32 : 1073741824;
ShareAll: u32 : 7;
ShareDelete: u32 : 4;
CreateAlways: u32 : 2;
OpenExisting: u32 : 3;
ReplaceExisting: u32 : 1;
ReadChunk: int : 65536;
FindDataUnits: int : 296;
ErrorFileNotFound: u32 : 2;
ErrorNoMoreFiles: u32 : 18;
FindNameUnit: int : 22;
FindNameUnits: int : 260;
Infinite: u32 : 4294967295;
UseStandardHandles: u32 : 256;
BackupSemantics: u32 : 33554432;
ReadOnlyAttribute: u32 : 1;
FileBasicInfo: i32 : 0;
FileInformationBytes: int : 52;
FileBasicBytes: int : 40;
FileTimeTicks: i64 : 10000000;
FileTimeEpochSeconds: i64 : 11644473600;
Slash: int : 47;
Backslash: int : 92;
CreateNew: u32 : 1;
CreateSuspended: u32 : 4;
NewProcessGroup: u32 : 512;
CreateNoWindow: u32 : 134217728;
KilledExit: u32 : 4294967287; // The DWORD representation of exit status -9.
WaitTimeout: u32 : 258;
MaxPathUnits: int : 260;
SystemPreferredRng: u32 : 2;
OrdinalEqual: i32 : 2;

// A zeroed block for a structure the program only passes along.
Block :: (size: int) -> u8[] {
    block: u8[] = [];
    for index in 0..<size {
        block.append(0);
    }
    return block;
}

// The UTF-16 units of `text` and a terminating NUL.
Wide :: (text: string) -> u16[] {
    // Counted Win32 text must not pass through the foreign CString's 4 KiB
    // bound: complete linker command lines can contain many Unicode paths.
    bytes := Block(text_byte_length(text) + 1);
    for index in 0..<text_byte_length(text) {
        byte := text_byte_at(text, index);
        assert(byte != 0, "the string contains no NUL");
        bytes[index] = u8(byte);
    }
    wide: u16[] = [];
    size := MultiByteToWideChar(Utf8, 0, bytes, i32(length(bytes)), wide, 0);
    for index in 0..<int(size) {
        wide.append(0);
    }
    converted := MultiByteToWideChar(Utf8, 0, bytes, i32(length(bytes)), wide, size);
    assert(converted == size, "the string converts");
    return wide;
}

// A successful open owns one loader reference. Symbol addresses stay valid
// until the matching CloseLibrary; a failed open or lookup returns null.
pub OpenLibrary :: (path: string) -> rawptr {
    return LoadLibraryW(Wide(path));
}
pub LibrarySymbol :: (module: rawptr, name: string) -> rawptr {
    return GetProcAddress(module, name);
}
pub CloseLibrary :: (module: rawptr) -> bool {
    return FreeLibrary(module) != 0;
}

// The current process cannot signal while this call runs. Its pseudo-handle
// is borrowed, so pausing needs no owned handle, timer or per-call allocation.
pub Pause :: (milliseconds: int) -> bool {
    if (milliseconds < 0) { return false; }
    return WaitForSingleObject(GetCurrentProcess(), u32(milliseconds)) == WaitTimeout;
}

// The text of the first `count` UTF-16 units of `wide`.
Narrow :: (wide: u16[], count: int) -> string {
    if count == 0 {
        return "";
    }
    none: u8[] = [];
    size := WideCharToMultiByte(Utf8, 0, wide, i32(count), none, 0, 0, 0);
    buffer := Block(int(size));
    converted := WideCharToMultiByte(Utf8, 0, wide, i32(count), buffer, size, 0, 0);
    return text_from_bytes(buffer);
}

// The attribute bits of the path, InvalidAttributes when it does not exist.
Attributes :: (path: string) -> u32 {
    return GetFileAttributesW(Wide(path));
}

// Whether the path names anything.
pub Exists :: (path: string) -> bool {
    return Attributes(path) != InvalidAttributes;
}

// What the path names, KindNone when nothing. A link is not followed.
pub Kind :: (path: string) -> int {
    attributes := Attributes(path);
    if attributes == InvalidAttributes {
        return KindNone;
    }
    if (attributes & LinkAttribute) != 0 {
        return KindLink;
    }
    if (attributes & DirectoryAttribute) != 0 {
        return KindDirectory;
    }
    return KindFile;
}

pub MakeDirectory :: (path: string) -> bool {
    for index in 1..<text_byte_length(path) {
        byte := text_byte_at(path, index);
        if byte == Slash || byte == Backslash {
            made := CreateDirectoryW(Wide(text_slice(path, 0, index)), 0);
        }
    }
    made := CreateDirectoryW(Wide(path), 0);
    attributes := Attributes(path);
    return attributes != InvalidAttributes && (attributes & DirectoryAttribute) != 0;
}

// Removes a file or link, or an empty directory.
pub Remove :: (path: string) -> bool {
    kind := Kind(path);
    if kind == KindNone {
        return true;
    }
    if kind == KindDirectory || (kind == KindLink && (Attributes(path) & DirectoryAttribute) != 0) {
        return RemoveDirectoryW(Wide(path)) != 0;
    }
    return DeleteFileW(Wide(path)) != 0;
}

// Renames, replacing an existing destination as rename does elsewhere.
pub Rename :: (source: string, destination: string) -> bool {
    return MoveFileExW(Wide(source), Wide(destination), ReplaceExisting) != 0;
}

// The file's size in bytes, -1 when it cannot be opened.
pub FileSize :: (path: string) -> int {
    handle := CreateFileW(Wide(path), ReadAccess, ShareAll, 0, OpenExisting, 0, 0);
    if ~handle == 0 {
        return -1;
    }
    size := Block(8);
    found := GetFileSizeEx(handle, size);
    closed := CloseHandle(handle);
    if found == 0 {
        return -1;
    }
    total := 0;
    for index in 0..<8 {
        total += int(size[index]) << u32(8 * index);
    }
    return total;
}

// The file's bytes, including NUL and malformed UTF-8; no bytes when it cannot
// be read (FileSize tells that from an empty file).
pub ReadBytes :: (path: string) -> u8[] {
    contents: u8[] = [];
    handle := CreateFileW(Wide(path), ReadAccess, ShareAll, 0, OpenExisting, 0, 0);
    if ~handle == 0 {
        return contents;
    }
    chunk := Block(ReadChunk);
    read: u32[] = [0];
    while true {
        if ReadFile(handle, chunk, u32(ReadChunk), read, 0) == 0 {
            contents = [];
            break;
        }
        count := int(read[0]);
        if count == 0 {
            break;
        }
        for index in 0..<count {
            contents.append(chunk[index]);
        }
    }
    closed := CloseHandle(handle);
    return contents;
}

// Replaces the file with the bytes; false when it cannot be written whole.
pub WriteBytes :: (path: string, data: u8[]) -> bool {
    handle := CreateFileW(Wide(path), WriteAccess, ShareAll, 0, CreateAlways, 0, 0);
    if ~handle == 0 {
        return false;
    }
    written: u32[] = [0];
    done := true;
    if length(data) > 0 {
        done = WriteFile(handle, data, u32(length(data)), written, 0) != 0 && int(written[0]) == length(data);
    }
    closed := CloseHandle(handle);
    return done && closed != 0;
}

// The bytes of the text, a copy.
Bytes :: (text: string) -> u8[] {
    data: u8[] = [];
    size := text_byte_length(text);
    for index in 0..<size {
        data.append(u8(text_byte_at(text, index)));
    }
    return data;
}

// Writes the line and a newline to standard error, as build reports do; false
// when it cannot be written whole.
pub Print :: (line: string) -> bool {
    data := Bytes(line);
    data.append(10);
    written: u32[] = [0];
    done := WriteFile(GetStdHandle(-12), data, u32(length(data)), written, 0);
    return done != 0 && int(written[0]) == length(data);
}

// Writes the text to standard output without a newline.
pub WriteOutput :: (text: string) -> bool {
    data := Bytes(text);
    written: u32[] = [0];
    offset := 0;
    while (offset < length(data)) {
        rest := data;
        if (offset != 0) {
            rest = slice(data, offset, length(data) - offset);
        }
        done := WriteFile(GetStdHandle(-11), rest, u32(length(rest)), written, 0);
        if (done == 0 || written[0] == 0) {
            return false;
        }
        offset += int(written[0]);
    }
    return true;
}

// Replaces the file with the text; false when it cannot be written whole.
pub WriteText :: (path: string, text: string) -> bool {
    return WriteBytes(path, Bytes(text));
}

pub IsFile :: (path: string) -> bool {
    return Kind(path) == KindFile;
}

pub IsDirectory :: (path: string) -> bool {
    return Kind(path) == KindDirectory;
}

// Ends the process with the exit status; it does not return.
pub Exit :: (code: int) -> int {
    return int(ExitProcess(u32(code)));
}

// The text of the bytes, which may hold NUL and malformed UTF-8.
pub Text :: (data: u8[]) -> string {
    return text_from_bytes(data);
}

// The file's text, "" when it cannot be read.
pub ReadText :: (path: string) -> string {
    return text_from_bytes(ReadBytes(path));
}

// Inspect an owned OS snapshot so an empty value differs from a missing name,
// without relying on GetEnvironmentVariable's ambiguous zero/last-error state.
pub HasEnv :: (name: string) -> bool {
    if name == "" { return false; }
    environment := GetEnvironmentStringsW();
    if environment == 0 { return false; }
    wanted := Wide(strings.Concatenate([name, "="]));
    size := length(wanted) - 1;
    cursor := u64(environment);
    found := false;
    while true {
        count := lstrlenW(cursor);
        if count == 0 { break; }
        if count >= size && CompareStringOrdinal(cursor, i32(size), wanted, i32(size), 1) == OrdinalEqual {
            found = true;
            break;
        }
        cursor += u64(count + 1) * 2;
    }
    freed := FreeEnvironmentStringsW(environment);
    return found;
}

// The environment variable's value, "" when it is unset or empty.
pub Getenv :: (name: string) -> string {
    none: u16[] = [];
    wide := Wide(name);
    size := GetEnvironmentVariableW(wide, none, 0);
    if size == 0 {
        return "";
    }
    buffer: u16[] = [];
    for index in 0..<int(size) {
        buffer.append(0);
    }
    count := GetEnvironmentVariableW(wide, buffer, size);
    return Narrow(buffer, int(count));
}

// A completed search differs from an open/read/close failure. Capture the
// native error before converting names or making any other OS call.
pub ListChecked :: (path: string) -> (names: string[], complete: bool) {
    names: string[] = [];
    data: u16[] = [];
    for index in 0..<FindDataUnits {
        data.append(0);
    }
    pattern := Wide(path);
    pattern[length(pattern) - 1] = 92;
    pattern.append(42);
    pattern.append(0);
    handle := FindFirstFileW(pattern, data);
    if ~handle == 0 {
        error := GetLastError();
        // A valid empty directory can have no wildcard match. A vanished or
        // inaccessible directory must still fail instead of becoming empty.
        return (names, error == ErrorFileNotFound && Kind(path) == KindDirectory);
    }
    more := true;
    error: u32 = 0;
    while more {
        count := 0;
        while count < FindNameUnits && data[FindNameUnit + count] != 0 {
            count += 1;
        }
        name: u16[] = [];
        for index in 0..<count {
            name.append(data[FindNameUnit + index]);
        }
        text := Narrow(name, count);
        if text != "." && text != ".." {
            names.append(text);
        }
        more = FindNextFileW(handle, data) != 0;
        if (!more) { error = GetLastError(); }
    }
    closed := FindClose(handle);
    if (error != ErrorNoMoreFiles || closed == 0) { return ([], false); }
    return (names, true);
}

// Preserve the raw platform API's empty-on-failure behavior. Fallible callers
// use ListChecked so an incomplete inventory is never accepted as empty.
pub List :: (path: string) -> string[] {
    return ListChecked(path).names;
}

// The program's arguments, the first being how it was started, split from the
// command line by the C runtime's rules: spaces and tabs separate them outside
// quotes, a quote toggles quoting, 2n backslashes before a quote are n
// backslashes and a toggle, 2n+1 are n backslashes and a literal quote. The
// program name keeps its backslashes.
pub Arguments :: () -> string[] {
    source := GetCommandLineW();
    size := int(lstrlenW(source));
    wide: u16[] = [];
    for index in 0..<size {
        wide.append(0);
    }
    moved := RtlMoveMemory(wide, source, u64(size) * 2);
    return Split(Narrow(wide, size));
}

// The arguments of the command line `line`.
pub Split :: (line: string) -> string[] {
    arguments: string[] = [];
    size := text_byte_length(line);
    at := 0;
    first := true;
    while at < size {
        while at < size && (text_byte_at(line, at) == 32 || text_byte_at(line, at) == 9) {
            at += 1;
        }
        if at >= size {
            break;
        }
        current: u8[] = [];
        quoted := false;
        while at < size {
            byte := text_byte_at(line, at);
            if !quoted && (byte == 32 || byte == 9) {
                break;
            }
            if byte == 92 && !first {
                slashes := 0;
                while at < size && text_byte_at(line, at) == 92 {
                    slashes += 1;
                    at += 1;
                }
                if at < size && text_byte_at(line, at) == 34 {
                    for index in 0..<(slashes / 2) {
                        current.append(92);
                    }
                    if slashes % 2 == 1 {
                        current.append(34);
                        at += 1;
                    }
                } else {
                    for index in 0..<slashes {
                        current.append(92);
                    }
                }
                continue;
            }
            if byte == 34 {
                quoted = !quoted;
                at += 1;
                continue;
            }
            current.append(u8(byte));
            at += 1;
        }
        first = false;
        arguments.append(text_from_bytes(current));
    }
    return arguments;
}

// A finished child process: its exit status (-1 when it could not be waited
// for, 127 when the program could not be started) and, for Capture, what it
// wrote.
pub Output :: struct {
    status: int;
    stdout: string;
    stderr: string;
}

// The argument quoted for a command line, by the C runtime's rules: an argument
// with a space, tab or quote, or an empty one, is quoted; backslashes before a
// quote, and at the end of a quoted argument, are doubled.
Quoted :: (argument: string) -> u8[] {
    out: u8[] = [];
    size := text_byte_length(argument);
    bare := size > 0;
    for index in 0..<size {
        byte := text_byte_at(argument, index);
        if byte == 32 || byte == 9 || byte == 34 {
            bare = false;
        }
    }
    if bare {
        for index in 0..<size {
            out.append(u8(text_byte_at(argument, index)));
        }
        return out;
    }
    out.append(34);
    slashes := 0;
    for index in 0..<size {
        byte := text_byte_at(argument, index);
        if byte == 92 {
            slashes += 1;
            continue;
        }
        if byte == 34 {
            for each in 0..<(slashes * 2 + 1) {
                out.append(92);
            }
            out.append(34);
            slashes = 0;
            continue;
        }
        for each in 0..<slashes {
            out.append(92);
        }
        slashes = 0;
        out.append(u8(byte));
    }
    for each in 0..<(slashes * 2) {
        out.append(92);
    }
    out.append(34);
    return out;
}

// The command line of the command's arguments, separated by spaces.
CommandLine :: (command: string[]) -> string {
    line: u8[] = [];
    for argument in command {
        if length(line) > 0 {
            line.append(32);
        }
        line.extend(Quoted(argument));
    }
    return text_from_bytes(line);
}

// A SECURITY_ATTRIBUTES whose handles a child inherits.
Inheritable :: () -> u8[] {
    attributes := Block(24);
    attributes[0] = 24;
    attributes[16] = 1;
    return attributes;
}

// The 64-bit integer at `at` in `bytes`, little endian.
Word64 :: (bytes: u8[], at: int) -> u64 {
    value: u64 = 0;
    for index in 0..<8 {
        value = value | (u64(bytes[at + index]) << u32(8 * index));
    }
    return value;
}

// The bytes with the 64-bit integer stored at `at`, little endian. Arrays are
// values, so the caller keeps what this returns.
Put64 :: (bytes: u8[], at: int, value: u64) -> u8[] {
    changed := bytes;
    for index in 0..<8 {
        changed[at + index] = u8((value >> u32(8 * index)) & 255);
    }
    return changed;
}

// A standard handle made inheritable, or 0 when this process has none, so a
// child can be given it.
Shared :: (handle: u64) -> u64 {
    if handle == 0 || ~handle == 0 {
        return 0;
    }
    marked := SetHandleInformation(handle, 1, 1);
    if marked == 0 {
        return 0;
    }
    return handle;
}

// The PROCESS_INFORMATION of a new child, empty when CreateProcessW fails.
Launch :: (command: string[], input: u64, output: u64, errors: u64, flags: u32) -> u8[] {
    if length(command) == 0 {
        empty: u8[] = [];
        return empty;
    }
    startup := Block(104);
    startup[0] = 104;
    startup[61] = 1;
    startup = Put64(startup, 80, input);
    startup = Put64(startup, 88, output);
    startup = Put64(startup, 96, errors);
    information := Block(24);
    started := CreateProcessW(0, Wide(CommandLine(command)), 0, 0, 1, flags, 0, 0, startup, information);
    if started == 0 {
        empty: u8[] = [];
        return empty;
    }
    return information;
}

// The synchronous callers do not need the child's initial thread handle.
Create :: (command: string[], input: u64, output: u64, errors: u64) -> int {
    information := Launch(command, input, output, errors, 0);
    if length(information) == 0 {
        return -1;
    }
    thread := Word64(information, 8);
    closed := CloseHandle(thread);
    return int(Word64(information, 0));
}

// Starts the program with the command's arguments, keeping this process's
// standard streams, and returns its process handle; -1 when it cannot be
// started.
pub Spawn :: (command: string[]) -> int {
    return Create(command, Shared(GetStdHandle(-10)), Shared(GetStdHandle(-11)), Shared(GetStdHandle(-12)));
}

// Waits for the process, closes its handle and returns its exit status.
pub Wait :: (process: int) -> int {
    waited := WaitForSingleObject(u64(process), Infinite);
    code: u32[] = [0];
    found := GetExitCodeProcess(u64(process), code);
    closed := CloseHandle(u64(process));
    if waited != 0 || found == 0 {
        return -1;
    }
    return int(code[0]);
}

// Runs the program, keeping the standard streams, and returns its exit status;
// 127 when it cannot be started.
pub Run :: (command: string[]) -> int {
    process := Spawn(command);
    if process < 0 {
        return 127;
    }
    return Wait(process);
}

// How many bytes are waiting in the pipe; -1 once it is closed or broken.
Waiting :: (pipe: u64) -> int {
    available: u32[] = [0];
    if PeekNamedPipe(pipe, 0, 0, 0, available, 0) == 0 {
        return -1;
    }
    return int(available[0]);
}

// Up to `count` of the bytes waiting in the pipe.
Take :: (pipe: u64, count: int) -> u8[] {
    wanted := count;
    if wanted > 4096 {
        wanted = 4096;
    }
    chunk := Block(wanted);
    read: u32[] = [0];
    taken: u8[] = [];
    if ReadFile(pipe, chunk, u32(wanted), read, 0) != 0 {
        for index in 0..<int(read[0]) {
            taken.append(chunk[index]);
        }
    }
    return taken;
}

// Runs the program with its standard output and error read into the result.
// Both pipes are read together, so a child filling one cannot stop on the other.
pub Capture :: (command: string[]) -> Output {
    result: Output = {status: 127, stdout: "", stderr: ""};
    if length(command) == 0 {
        return result;
    }
    out_read: u64[] = [0];
    out_write: u64[] = [0];
    err_read: u64[] = [0];
    err_write: u64[] = [0];
    made := CreatePipe(out_read, out_write, Inheritable(), 0);
    made = made * CreatePipe(err_read, err_write, Inheritable(), 0);
    if made == 0 {
        return result;
    }
    process := Create(command, Shared(GetStdHandle(-10)), out_write[0], err_write[0]);
    closed := CloseHandle(out_write[0]);
    closed = CloseHandle(err_write[0]);
    standard: u8[] = [];
    errors: u8[] = [];
    if process >= 0 {
        open_out := true;
        open_err := true;
        while open_out || open_err {
            before := length(standard) + length(errors);
            if open_out {
                waiting := Waiting(out_read[0]);
                if waiting < 0 {
                    open_out = false;
                } else if waiting > 0 {
                    standard.extend(Take(out_read[0], waiting));
                }
            }
            if open_err {
                waiting := Waiting(err_read[0]);
                if waiting < 0 {
                    open_err = false;
                } else if waiting > 0 {
                    errors.extend(Take(err_read[0], waiting));
                }
            }
            if length(standard) + length(errors) == before && (open_out || open_err) {
                // Nothing waiting: let the child run for a moment.
                waited := WaitForSingleObject(u64(process), 10);
            }
        }
        result.status = Wait(process);
    }
    closed = CloseHandle(out_read[0]);
    closed = CloseHandle(err_read[0]);
    result.stdout = text_from_bytes(standard);
    result.stderr = text_from_bytes(errors);
    return result;
}

pub Platform :: () -> string {
    return "Windows";
}

// The unsigned DWORD at the Win32 structure's byte offset.
Word32 :: (bytes: u8[], at: int) -> u64 {
    value: u64 = 0;
    for index in 0..<4 {
        value = value | (u64(bytes[at + index]) << u32(8 * index));
    }
    return value;
}

// FILETIME's 100 ns ticks since 1601, as Unix seconds.nanoseconds. No access
// time enters a stamp, so reading or hashing a file leaves its stamp alone.
FileTime :: (ticks: u64) -> string {
    nanoseconds := SignedDecimal((i64(ticks) % FileTimeTicks) * 100);
    while text_byte_length(nanoseconds) < 9 {
        nanoseconds = strings.Concatenate(["0", nanoseconds]);
    }
    return strings.Concatenate([SignedDecimal(i64(ticks) / FileTimeTicks - FileTimeEpochSeconds), ".", nanoseconds]);
}

// Same fields as POSIX stamps: volume:file-id:size:mode:modified:changed.
// Identity and size come from BY_HANDLE_FILE_INFORMATION. FILE_BASIC_INFO
// supplies the metadata change time, which LastWriteTime alone misses.
// These are metadata, not a content hash: two writes within the filesystem's
// timestamp resolution may keep the same stamp when their sizes match.
pub Stamp :: (path: string) -> string {
    handle := CreateFileW(Wide(path), 0, ShareAll, 0, OpenExisting, BackupSemantics, 0);
    if ~handle == 0 {
        return "";
    }
    information := Block(FileInformationBytes);
    basic := Block(FileBasicBytes);
    found := GetFileInformationByHandle(handle, information);
    changed := GetFileInformationByHandleEx(handle, FileBasicInfo, basic, u32(FileBasicBytes));
    closed := CloseHandle(handle);
    if found == 0 || changed == 0 || closed == 0 {
        return "";
    }
    identity := (Word32(information, 44) << u32(32)) | Word32(information, 48);
    size := (Word32(information, 32) << u32(32)) | Word32(information, 36);
    attributes := u32(Word32(information, 0));
    mode := "100666";
    if (attributes & DirectoryAttribute) != 0 {
        mode = "40777";
    }
    if (attributes & ReadOnlyAttribute) != 0 {
        mode = "100444";
        if (attributes & DirectoryAttribute) != 0 {
            mode = "40555";
        }
    }
    return strings.Concatenate([UnsignedDecimal(Word32(information, 28)), ":", UnsignedDecimal(identity), ":",
                                UnsignedDecimal(size), ":", mode, ":", FileTime(Word64(basic, 16)), ":", FileTime(Word64(basic, 24))]);
}

// The kernel copies into a private directory beside the destination, then
// renames the complete file. A failed copy leaves the old destination intact.
pub Copy :: (source: string, destination: string) -> bool {
    attributes := Attributes(source);
    if attributes == InvalidAttributes || (attributes & DirectoryAttribute) != 0 {
        return false;
    }
    work := strings.Concatenate([destination, ".copy-", SignedDecimal(i64(int(GetCurrentProcessId())))]);
    if !Reserve(work) {
        return false;
    }
    temporary := strings.Concatenate([work, "/file"]);
    copied := CopyFileW(Wide(source), Wide(temporary), 1) != 0;
    if copied {
        copied = Rename(temporary, destination);
    }
    removed := Remove(temporary);
    closed := Remove(work);
    return copied && removed && closed;
}

// A 128-bit system nonce avoids a shared counter or a tempfile-to-directory
// conversion window. Exclusive creation never replaces somebody else's path.
pub TemporaryDirectory :: (parent: string) -> string {
    random := Block(16);
    if BCryptGenRandom(0, random, 16, SystemPreferredRng) != 0 {
        return "";
    }
    hexadecimal := "0123456789abcdef";
    name := Block(32);
    for index in 0..<16 {
        name[2 * index] = u8(text_byte_at(hexadecimal, int(random[index] >> 4)));
        name[2 * index + 1] = u8(text_byte_at(hexadecimal, int(random[index] & 15)));
    }
    path := strings.Concatenate([parent, "/work-", text_from_bytes(name)]);
    if !Reserve(path) {
        return "";
    }
    return path;
}

// CreateDirectoryW refuses every existing path, unlike MakeDirectory.
pub Reserve :: (path: string) -> bool {
    return CreateDirectoryW(Wide(path), 0) != 0;
}

// Without MOVEFILE_REPLACE_EXISTING, the kernel rejects every occupied name,
// including an empty directory. No check-then-rename race can replace one.
pub Publish :: (source: string, destination: string) -> bool {
    if Kind(source) != KindDirectory {
        return false;
    }
    return MoveFileExW(Wide(source), Wide(destination), 0) != 0;
}

pub RealPath :: (path: string) -> string {
    handle := CreateFileW(Wide(path), 0, ShareAll, 0, OpenExisting, BackupSemantics, 0);
    if ~handle == 0 {
        return "";
    }
    none: u16[] = [];
    size := GetFinalPathNameByHandleW(handle, none, 0, 0);
    if size == 0 {
        closed := CloseHandle(handle);
        return "";
    }
    buffer := resize([u16(0)], int(size) + 1);
    count := GetFinalPathNameByHandleW(handle, buffer, u32(length(buffer)), 0);
    closed := CloseHandle(handle);
    if count == 0 || int(count) >= length(buffer) || closed == 0 {
        return "";
    }
    normalized := strings.ReplaceAll(Narrow(buffer, int(count)), "\\", "/");
    if strings.HasPrefix(normalized, "//?/UNC/") {
        return strings.Concatenate(["//", strings.TrimPrefix(normalized, "//?/UNC/")]);
    }
    return strings.TrimPrefix(normalized, "//?/");
}

pub ChangeDirectory :: (path: string) -> bool {
    converted := Wide(path);
    return length(converted) > 0 && SetCurrentDirectoryW(converted) != 0;
}

pub Root :: () -> string {
    none: u16[] = [];
    size := GetCurrentDirectoryW(0, none);
    if size == 0 {
        return "";
    }
    buffer := resize([u16(0)], int(size));
    count := GetCurrentDirectoryW(size, buffer);
    if count == 0 || count >= size {
        return "";
    }
    return strings.ReplaceAll(Narrow(buffer, int(count)), "\\", "/");
}

// Look only on PATH, or use a name containing a directory as supplied. Windows
// native programs use .exe or .com; command scripts require an explicit shell.
pub FindExecutable :: (name: string) -> string {
    if name == "" {
        return "";
    }
    directories := strings.Split(Getenv("PATH"), ";");
    explicit := strings.ContainsAny(name, "/\\:");
    if explicit {
        directories = [""];
    }
    for directory in directories {
        folder := strings.Trim(directory, "\"");
        candidate := name;
        if !explicit {
            if folder == "" {
                folder = ".";
            }
            candidate = strings.Concatenate([folder, "/", name]);
        }
        for suffix in ["", ".exe", ".com"] {
            path := strings.Concatenate([candidate, suffix]);
            attributes := Attributes(path);
            if attributes != InvalidAttributes && (attributes & DirectoryAttribute) == 0 {
                return path;
            }
        }
    }
    return "";
}

pub StillRunning: int : 65536;

// A parent's creation time isolates its ownership files from recycled PIDs.
// Each file holds a PID and the parent's opaque OS job descriptor, never a
// Chibi memory pointer. It is only read by this process while claiming a child.
ProcessIdentity :: () -> string {
    created := Block(8);
    exited := Block(8);
    kernel := Block(8);
    user := Block(8);
    if GetProcessTimes(GetCurrentProcess(), created, exited, kernel, user) == 0 {
        return "";
    }
    return strings.Concatenate(["chibi-", UnsignedDecimal(u64(GetCurrentProcessId())), "-", UnsignedDecimal(Word64(created, 0))]);
}

ProcessFolder :: () -> string {
    identity := ProcessIdentity();
    if identity == "" {
        return "";
    }
    none: u16[] = [];
    size := GetTempPathW(0, none);
    if size == 0 {
        return "";
    }
    buffer := resize([u16(0)], int(size) + 1);
    count := GetTempPathW(u32(length(buffer)), buffer);
    if count == 0 || int(count) >= length(buffer) {
        return "";
    }
    return strings.Concatenate([strings.TrimRight(Narrow(buffer, int(count)), "/\\"), "/", identity]);
}

ProcessPath :: (folder: string, process: int, suffix: string) -> string {
    return strings.Concatenate([folder, "/", SignedDecimal(i64(process)), suffix]);
}

Close :: (handle: u64) {
    if handle != 0 && ~handle != 0 {
        closed := CloseHandle(handle);
    }
}

// Creates one ownership marker without replacing an earlier invocation's file.
RecordProcess :: (path: string, pid: u32, job: u64, piped: bool) -> bool {
    handle := CreateFileW(Wide(path), WriteAccess, 0, 0, CreateNew, 0, 0);
    if ~handle == 0 {
        return false;
    }
    data := Block(16);
    for index in 0..<4 {
        data[index] = u8((pid >> u32(index * 8)) & 255);
    }
    if piped { data[4] = 1; }
    data = Put64(data, 8, job);
    written: u32[] = [0];
    status := WriteFile(handle, data, 16, written, 0);
    closed := CloseHandle(handle);
    if status == 0 || written[0] != 16 || closed == 0 {
        removed := Remove(path);
        return false;
    }
    return true;
}

// Exclusive marker access makes concurrent Wait/Kill calls reject a handle
// already being consumed. A foreign or completed handle never reaches Close.
ProcessClaim :: struct {
    marker: u64;
    job: u64;
    piped: bool;
}

ClaimProcess :: (folder: string, process: int) -> ProcessClaim {
    claim: ProcessClaim = {marker: 0, job: 0, piped: false};
    if folder == "" || process <= 0 {
        return claim;
    }
    pid := GetProcessId(u64(process));
    if pid == 0 {
        return claim;
    }
    handle := CreateFileW(Wide(ProcessPath(folder, process, ".state")), ReadAccess, ShareDelete, 0, OpenExisting, 0, 0);
    if ~handle == 0 {
        return claim;
    }
    size := Block(8);
    data := Block(16);
    count: u32[] = [0];
    sized := GetFileSizeEx(handle, size);
    read := ReadFile(handle, data, 16, count, 0);
    if sized == 0 || Word64(size, 0) != 16 || read == 0 || count[0] != 16 ||
       Word32(data, 0) != u64(pid) || Word32(data, 4) > 1 || Word64(data, 8) == 0 {
        Close(handle);
        return claim;
    }
    claim.marker = handle;
    claim.job = Word64(data, 8);
    claim.piped = Word32(data, 4) == 1;
    return claim;
}

StartingProcess :: struct {
    information: u8[];
    input: u64;
    output: u64;
    errors: u64;
    job: u64;
    waiting: string;
    marker: string;
}

AbandonProcess :: (starting: StartingProcess, folder: string) {
    process: u64 = 0;
    if length(starting.information) != 0 {
        process = Word64(starting.information, 0);
        stopped := TerminateProcess(process, 127);
        waited := WaitForSingleObject(process, Infinite);
        Close(Word64(starting.information, 8));
    }
    Close(starting.job);
    Close(starting.input);
    Close(starting.output);
    Close(starting.errors);
    if starting.waiting != "" {
        removed := Remove(starting.waiting);
    }
    if starting.marker != "" {
        removed := Remove(starting.marker);
    }
    Close(process);
    removed := RemoveDirectoryW(Wide(folder));
}

// Launch suspended so the job owns the child before any descendants can start.
// Retain the job handle until reap: closing the last handle removes its name
// even while associated processes still live, so reopening by name is unsafe.
pub Start :: (command: string[], piped: bool) -> int {
    return StartProcess(command, piped, "", "");
}

// The caller owns the files, including cleanup after a failed launch. Empty
// stdout inherits this process's stdout; stderr must name a distinct file.
// Wait/Kill never report or remove redirected output. Windows already inherits
// containing parent jobs, including when POSIX's attached group option is false.
pub StartRedirected :: (command: string[], stdout_path: string, stderr_path: string, attached: bool = false) -> int {
    if stderr_path == "" || (stdout_path == stderr_path && stdout_path != "NUL") { return -1; }
    return StartProcess(command, false, stdout_path, stderr_path);
}

StartProcess :: (command: string[], piped: bool, stdout_path: string, stderr_path: string) -> int {
    if length(command) == 0 {
        return -1;
    }
    folder := ProcessFolder();
    if folder == "" || !MakeDirectory(folder) {
        return -1;
    }
    starting: StartingProcess = {information: [], input: 0, output: 0, errors: 0, job: 0, waiting: "", marker: ""};
    starting.input = CreateFileW(Wide("NUL"), ReadAccess, ShareAll, 0, OpenExisting, 0, 0);
    if ~starting.input == 0 || Shared(starting.input) == 0 {
        AbandonProcess(starting, folder);
        return -1;
    }
    output: u64 = 0;
    errors: u64 = 0;
    if piped {
        name := resize([u16(0)], MaxPathUnits);
        if GetTempFileNameW(Wide(folder), Wide("out"), 0, name) == 0 {
            AbandonProcess(starting, folder);
            return -1;
        }
        end := 0;
        while end < length(name) && name[end] != 0 {
            end += 1;
        }
        starting.waiting = Narrow(name, end);
        starting.output = CreateFileW(Wide(starting.waiting), WriteAccess, ShareAll, 0, OpenExisting, 0, 0);
        if ~starting.output == 0 || Shared(starting.output) == 0 {
            AbandonProcess(starting, folder);
            return -1;
        }
        output = starting.output;
        errors = output;
    } else if stderr_path != "" {
        if stdout_path != "" {
            starting.output = CreateFileW(Wide(stdout_path), WriteAccess, ShareAll, 0, CreateAlways, 0, 0);
            if ~starting.output == 0 || Shared(starting.output) == 0 {
                AbandonProcess(starting, folder);
                return -1;
            }
            output = starting.output;
        } else {
            output = Shared(GetStdHandle(-11));
        }
        starting.errors = CreateFileW(Wide(stderr_path), WriteAccess, ShareAll, 0, CreateAlways, 0, 0);
        if ~starting.errors == 0 || Shared(starting.errors) == 0 {
            AbandonProcess(starting, folder);
            return -1;
        }
        errors = starting.errors;
    } else {
        output = Shared(GetStdHandle(-11));
        errors = Shared(GetStdHandle(-12));
    }
    launch_flags := CreateSuspended | NewProcessGroup;
    if stderr_path != "" || piped { launch_flags |= CreateNoWindow; }
    starting.information = Launch(command, starting.input, output, errors, launch_flags);
    if length(starting.information) == 0 {
        AbandonProcess(starting, folder);
        return -1;
    }
    process := int(Word64(starting.information, 0));
    pid := u32(Word32(starting.information, 16));
    job := CreateJobObjectW(0, 0);
    if job == 0 {
        AbandonProcess(starting, folder);
        return -1;
    }
    starting.job = job;
    if AssignProcessToJobObject(job, u64(process)) == 0 {
        AbandonProcess(starting, folder);
        return -1;
    }
    marker := ProcessPath(folder, process, ".state");
    if !RecordProcess(marker, pid, job, piped) {
        AbandonProcess(starting, folder);
        return -1;
    }
    starting.marker = marker;
    if piped {
        published := ProcessPath(folder, process, ".out");
        if MoveFileExW(Wide(starting.waiting), Wide(published), 0) == 0 {
            AbandonProcess(starting, folder);
            return -1;
        }
        starting.waiting = published;
    }
    if ResumeThread(Word64(starting.information, 8)) == InvalidAttributes {
        AbandonProcess(starting, folder);
        return -1;
    }
    Close(Word64(starting.information, 8));
    Close(starting.input);
    Close(starting.output);
    Close(starting.errors);
    return process;
}

// Report in bounded chunks, preserving NUL bytes and combined output order.
ReportProcess :: (path: string) -> bool {
    if !Exists(path) {
        return true;
    }
    handle := CreateFileW(Wide(path), ReadAccess, ShareAll, 0, OpenExisting, 0, 0);
    if ~handle == 0 {
        return false;
    }
    data := Block(ReadChunk);
    read: u32[] = [0];
    written: u32[] = [0];
    complete := true;
    while true {
        if ReadFile(handle, data, u32(ReadChunk), read, 0) == 0 {
            complete = false;
            break;
        }
        if read[0] == 0 {
            break;
        }
        if WriteFile(GetStdHandle(-12), data, read[0], written, 0) == 0 || written[0] != read[0] {
            complete = false;
            break;
        }
    }
    Close(handle);
    removed := Remove(path);
    return complete && removed;
}

// Timeouts preserve ownership. Completion consumes a handle exactly once.
pub WaitFor :: (process: int, timeout_ms: int) -> int {
    if process < 0 {
        return 127;
    }
    folder := ProcessFolder();
    claim := ClaimProcess(folder, process);
    if claim.marker == 0 {
        return -1;
    }
    return WaitClaimed(folder, process, claim, timeout_ms);
}

WaitClaimed :: (folder: string, process: int, claim: ProcessClaim, timeout_ms: int) -> int {
    timeout := Infinite;
    if timeout_ms >= 0 {
        timeout = u32(timeout_ms);
    }
    waited := WaitForSingleObject(u64(process), timeout);
    if waited == WaitTimeout {
        Close(claim.marker);
        return StillRunning;
    }
    code: u32[] = [0];
    found := GetExitCodeProcess(u64(process), code);
    reported := true;
    if claim.piped { reported = ReportProcess(ProcessPath(folder, process, ".out")); }
    removed := Remove(ProcessPath(folder, process, ".state"));
    // Drop the ownership marker before the OS can reuse the process handle.
    // ShareDelete permits this removal while other claim readers stay excluded.
    Close(claim.marker);
    Close(claim.job);
    Close(u64(process));
    directory := RemoveDirectoryW(Wide(folder));
    if waited != 0 || found == 0 || !reported || !removed {
        return -1;
    }
    return int(wrap: code[0]);
}

pub Kill :: (process: int) -> int {
    if process < 0 {
        return 127;
    }
    folder := ProcessFolder();
    claim := ClaimProcess(folder, process);
    if claim.marker == 0 {
        return -1;
    }
    // The root may have exited while descendants still belong to its job.
    // Stop that job before reaping the root, preserving a completed root's code.
    stopped := TerminateJobObject(claim.job, KilledExit);
    if stopped == 0 {
        failure := GetLastError();
        Print(strings.Concatenate(["windows: cannot terminate process job: Win32 error ", UnsignedDecimal(u64(failure))]));
        Close(claim.marker);
        return -1;
    }
    return WaitClaimed(folder, process, claim, -1);
}
