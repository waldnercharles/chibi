behavior "HudDisplay" {
    owner "ecs.entity";
    value get_global_variable: float = get_global_variable(Name: "Score");
    value format_text = format_text(Format: "{:08.0f}", Arg0: float = get_global_variable);
    value get_global_variable_2: double = get_global_variable(Name: "Lives");
    value format_text_2 = format_text(Format: "BALLS   {:.0f}", Arg0: double = get_global_variable_2);
    value get_global_variable_3: float = get_global_variable(Name: "Rank");
    value format_text_3 = format_text(Format: "RANK   {:.0f}", Arg0: float = get_global_variable_3);
    value get_global_variable_4: float = get_global_variable(Name: "Charge");
    value get_global_variable_5: float = get_global_variable(Name: "Hits");
    value format_text_4 = format_text(Format: "TARGET PRACTICE\n{:.0f} / 8 HITS", Arg0: float = get_global_variable_5);
    on Tick as tick(DeltaSeconds: float = 0.0) {
        await set_ui_text(Entity: 0, Element: "#score", Text: format_text);
        await set_ui_text(Entity: 0, Element: "#lives", Text: format_text_2);
        await set_ui_text(Entity: 0, Element: "#rank", Text: format_text_3);
        await set_ui_value(Entity: 0, Element: "#charge", Value: get_global_variable_4);
        if (get_global_variable_2 <= 0) {
            set_ui_text(Entity: 0, Element: "#mission", Text: "GAME OVER");
        } else {
            set_ui_text(Entity: 0, Element: "#mission", Text: format_text_4);
        }
    }
}
