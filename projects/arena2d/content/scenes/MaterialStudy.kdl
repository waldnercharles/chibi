version 1
name "MaterialStudy"
(array)entities {
    - name="Camera" prototype="MaterialStudyCamera"
    - name="Materials" prototype="MaterialStudyWorld"
    - name="Free motion" prototype="FreeMotionSystem"
    - {
        name "Marker"
        prototype "DriftingMarker"
        components {
            GameTransform x=-180.0 y=225.0
        }
    }
    - {
        name "Solid sample"
        prototype "MaterialSpecimen"
        components {
            GameTransform x=0.0 y=115.0
        }
    }
    - {
        name "Cut sample"
        prototype "MaterialSpecimen"
        components {
            GameTransform x=0.0 y=-120.0
        }
        (array)behaviors "CutMaterial"
    }
}
