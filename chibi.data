- id: 407
  kind: function
  name: Roll Gain
  math_expression: max(Acceleration, 0) * max(Delta, 0)
  entry_id: 1127
- id: 437
  kind: function
  name: Desired Roll
  math_expression: Strafe * max(Speed, 0) * (pi / 180) * (1 - min(max(Rocking, 0), 0.85) * cos(Position * 4))
  entry_id: 1153
- id: 517
  kind: function
  name: Roll Velocity
  math_expression: (Velocity + Gain * Desired) / (1 + Gain)
  entry_id: 1227
- id: 550
  kind: function
  name: Roll Position
  math_expression: Position + NewVelocity * max(Delta, 0)
  entry_id: 1255
