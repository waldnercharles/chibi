package toolchain

import strings "core:strings"
import files "graph:install"
import engine "graph:engine"

// Install the graph-built private compiler tools into a fresh prefix. This is
// the compiler-tools part of SDK packaging, without public libraries/headers.
//   CompilerTools -- --build ABS --output ABS --third-party ABS
// The dependency archive must be the one both executable link records name.
// Publication refuses existing prefixes; a failed preparation removes only the
// sibling stage this invocation reserved. No compiler/bootstrap bytes change.
Join :: (parts: string[]) -> string {
    return strings.Join(parts, "");
}
Option :: (arguments: string[], name: string) -> string {
    for (i in 0..<length(arguments) - 1) {
        if (arguments[i] == name) {
            return arguments[i + 1];
        }
    }
    return "";
}
// Every item is DESTINATION=SOURCE, with absolute source paths.
Entries :: (root: string, build_dir: string, third_party: string) -> string[] {
    return [
        Join(["libexec/chibi/chibi-build-host=", build_dir, "/sdk/chibi-build-host"]),
        Join(["libexec/chibi/chibi-compiler-host=", build_dir, "/sdk/chibi-compiler-host"]),
        Join(["share/chibi/compiler=", build_dir, "/share/chibi/compiler"]),
        Join(["share/chibi/core=", build_dir, "/share/chibi/core"]),
        Join(["share/chibi/tools/native_aot=", build_dir, "/share/chibi/tools/native_aot"]),
        Join(["share/chibi/tools/toolchain/Build.chibi=", root, "/tools/toolchain/Build.chibi"]),
        Join(["share/chibi/tools/toolchain/Graph.chibi=", root, "/tools/toolchain/Graph.chibi"]),
        Join(["share/chibi/tools/toolchain/SDK.chibi=", root, "/tools/toolchain/SDK.chibi"]),
        Join(["share/chibi/tools/toolchain/StageOne.chibi=", root, "/tools/toolchain/StageOne.chibi"]),
        Join(["share/chibi/tools/configure_inputs.py=", root, "/tools/configure_inputs.py"]),
        Join(["share/chibi/graph=", root, "/tools/graph"]),
        Join(["share/chibi/licenses/chibi/LICENSE.md=", root, "/LICENSE.md"]),
        Join(["share/chibi/licenses/chibi/COPYING=", root, "/COPYING"]),
        Join(["share/chibi/licenses/chibi/COPYING.LESSER=", root, "/COPYING.LESSER"]),
        Join(["share/chibi/licenses/chibi/COPYING.EXAMPLES=", root, "/COPYING.EXAMPLES"]),
        Join(["share/chibi/licenses/chibi/docs/distribution-licensing.md=", root, "/docs/distribution-licensing.md"]),
        Join(["share/chibi/licenses/fmt/LICENSE=", root, "/third_party/fmt/LICENSE"]),
        Join(["share/chibi/licenses/fmt/README.md=", root, "/third_party/fmt/README.md"]),
        Join(["share/chibi/licenses/yyjson/LICENSE=", root, "/third_party/yyjson/LICENSE"]),
        Join(["share/chibi/licenses/ckdl/COPYING=", root, "/third_party/ckdl/COPYING"]),
        Join(["share/chibi/licenses/vendor/tree_sitter/LICENSE=", third_party, "/share/chibi/licenses/vendor/tree_sitter/LICENSE"]),
        Join(["share/chibi/licenses/vendor/sljit/LICENSE=", third_party, "/share/chibi/licenses/vendor/sljit/LICENSE"])
    ];
}
// The installed build host must compile and execute the SDK's new bindings,
// with its own executable-relative compiler resources.
Verify :: () -> int {
    reserved := Join([build.root(), "/.compiler-tools-probe"]);
    published := Join([reserved, ".published"]);
    if (!build.reserve_directory(reserved)) {
        return 1;
    }
    if (!build.publish_directory(reserved, published)) {
        build.remove(reserved);
        return 1;
    }
    if (!build.remove(published)) {
        return 1;
    }
    return 0;
}
Prepare :: (stage: string, entries: string[]) -> bool {
    for (item in entries) {
        if (!files.CopyTree(build.after(item, "="), Join([stage, "/", build.before(item, "=")]))) {
            build.report(Join(["sdk: cannot copy ", build.after(item, "=")]));
            return false;
        }
    }
    compiler := Join([stage, "/share/chibi/compiler"]);
    if (build.run([Join([stage, "/libexec/chibi/chibi-compiler-host"]),
                   "--bootstrap", Join([compiler, "/bootstrap"]),
                   "--compiler", compiler, "--core", Join([stage, "/share/chibi/core"])]) != 0) {
        build.report("sdk: staged compiler resources failed recovery");
        return false;
    }
    if (build.run([Join([stage, "/libexec/chibi/chibi-build-host"]),
                   "--root", stage, "--source", Join([stage, "/share/chibi/tools/toolchain/SDK.chibi"]),
                   "--core", Join([stage, "/share/chibi/core"]),
                   "--collection", Join(["graph=", stage, "/share/chibi/graph"]), "--entry", "Verify", "--timeout-ms", "120000"]) != 0) {
        build.report("sdk: staged build host failed capability verification");
        return false;
    }
    return build.write_file(Join([stage, "/share/chibi/compiler-tools.tsv"]), Join(["1\n", files.Inventory(stage, "")]));
}
CompilerTools :: () -> int {
    arguments := build.arguments();
    build_dir := Option(arguments, "--build");
    output := Option(arguments, "--output");
    third_party := Option(arguments, "--third-party");
    if (!strings.HasPrefix(build_dir, "/") || !strings.HasPrefix(output, "/") ||
        !strings.HasPrefix(third_party, "/") || strings.HasSuffix(output, "/") ||
        strings.HasSuffix(output, "/.") || strings.HasSuffix(output, "/..")) {
        build.report("sdk: --build, --output and --third-party must be absolute paths; output must name a fresh prefix");
        return 2;
    }
    if (build.file_kind(output) != "") {
        build.report("sdk: output already exists");
        return 2;
    }
    root := build.root();
    output = files.CanonicalPath(output);
    if (output == "") {
        build.report("sdk: output has an invalid directory ancestor");
        return 2;
    }
    stage := files.CanonicalPath(Join([output, ".chibi-stage"]));
    if (stage == "") {
        build.report("sdk: staging has an invalid directory ancestor");
        return 2;
    }
    entries := Entries(root, build_dir, third_party);
    for (item in entries) {
        source := build.after(item, "=");
        if (build.file_kind(source) == "directory" &&
            (files.Inside(output, source) || files.Inside(stage, source))) {
            build.report("sdk: output or staging lies inside a distribution input");
            return 2;
        }
    }
    if (!files.SameTree(Join([root, "/tools/compiler"]), Join([build_dir, "/share/chibi/compiler"])) ||
        !files.SameTree(Join([root, "/packages/core"]), Join([build_dir, "/share/chibi/core"]))) {
        build.report("sdk: graph compiler/core resources are missing or stale; rebuild the private hosts");
        return 1;
    }
    for (host in ["chibi-build-host", "chibi-compiler-host"]) {
        record := build.read_file(Join([build_dir, "/sdk/", host, ".chibi-record"]));
        for (library_name in ["tree_sitter", "sljit"]) {
            archive := Join([third_party, "/lib/chibi-vendor/libchibi_vendor_", library_name, ".a"]);
            found := false;
            for (line in build.lines(record)) {
                found = found || line == archive;
            }
            if (!found) {
                build.report("sdk: dependency archive differs from the graph executable link record");
                return 1;
            }
        }
    }
    for (item in entries) {
        source := build.after(item, "=");
        kind := build.file_kind(source);
        if (kind != "file" && kind != "directory") {
            build.report(Join(["sdk: missing distribution input ", source]));
            return 1;
        }
    }
    if (!build.make_directory(files.Parent(output))) {
        build.report("sdk: cannot create output parent");
        return 1;
    }
    if (!build.reserve_directory(stage)) {
        build.report("sdk: cannot reserve staging directory; existing staging is preserved");
        return 1;
    }
    if (!Prepare(stage, entries) || !build.publish_directory(stage, output)) {
        if (!files.RemoveTree(stage)) {
            build.report(Join(["sdk: incomplete staging directory retained at ", stage]));
        }
        build.report("sdk: compiler-tools publication failed");
        return 1;
    }
    build.report(Join(["sdk: installed compiler tools at ", output]));
    return 0;
}

// Install the Release graph products into PREFIX, overlaying what is there, as
// the layout the launcher and private hosts read: products in bin, hosts in
// libexec/chibi, resources in share/chibi.
//   Install -- --build ABS --prefix ABS
InstallEntries :: (root: string, build_dir: string, third_party: string) -> string[] {
    entries := Entries(root, build_dir, third_party);
    entries.extend([
        Join(["bin/chibi=", build_dir, "/sdk/chibi"]),
        Join(["bin/chibi-compile=", build_dir, "/sdk/chibi-compile"]),
        Join(["bin/chibi-player=", build_dir, "/sdk/chibi-player"]),
        Join(["share/chibi/engine.json=", build_dir, "/share/chibi/engine.json"]),
        Join(["share/chibi/apps=", build_dir, "/share/chibi/apps"]),
        Join(["share/chibi/shaders=", build_dir, "/share/chibi/shaders"])
    ]);
    return entries;
}
Install :: () -> int {
    arguments := build.arguments();
    build_dir := Option(arguments, "--build");
    prefix := Option(arguments, "--prefix");
    if (!strings.HasPrefix(build_dir, "/") || !strings.HasPrefix(prefix, "/")) {
        build.report("sdk: --build and --prefix must be absolute paths");
        return 2;
    }
    entries := InstallEntries(build.root(), build_dir, engine.ThirdParty(build.root(), "", ""));
    for (item in entries) {
        if (build.file_kind(build.after(item, "=")) == "") {
            build.report(Join(["sdk: missing install input ", build.after(item, "=")]));
            return 1;
        }
    }
    for (item in entries) {
        if (!files.CopyTree(build.after(item, "="), Join([prefix, "/", build.before(item, "=")]))) {
            build.report(Join(["sdk: cannot install ", build.before(item, "=")]));
            return 1;
        }
    }
    build.report(Join(["sdk: installed at ", prefix]));
    return 0;
}
