version: 3
name: BloomCircuitGoal
id_counter: 69
owner_type: ecs.entity
graphs:
- kind: event
  name: ""
  nodes:
  - id: 1
    type: Event
    reference_name: Tick
    outputs:
      DeltaSeconds: {type: float, kind: data}
  - id: 4
    type: Find Nearest Entity
    inputs:
      Position:
        default: {x: 0.0, "y": 2.51}
      Radius: 10000.0
      Categories: 1
  - id: 13
    type: GetEntity_GameExperience
    outputs:
      Value.current: {id: 34}
  - id: 28
    type: Set UI Text
    inputs: {Element: '#goal', Text: CIRCUIT COMPLETE!  All 8 blooms collected.}
  - id: 49
    type: Behavior Expression
    reference_id: 35
    reference_name: Collected >= 8
    inputs:
      Exec: {id: 52, kind: exec}
      Collected: {id: 50, type: double, flags: 0}
