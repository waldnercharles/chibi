version 3
name "SdfBreathingSphere"
domain "shape"
bounds_x 48.0
bounds_y 48.0
id_counter 57
description "The field's radius changes with simulation time; it is not a rigid transform or a rebuilt mesh."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Shader Shape Output"
            - id=3 type="Shader ObjectPosition"
            - id=5 type="Shader Time"
            - {
                id 35
                type "Behavior Expression"
                reference_name "27 + 8 * sin(time * 1.5)"
                inputs {
                    time id=36 type="float"
                }
                outputs {
                    Result id=37 type="float"
                }
            }
            - {
                id 53
                type "Behavior Expression"
                reference_name "length(p) - radius"
                inputs {
                    p id=54 type="struct" type_name="ShaderVec3"
                    radius id=55 type="float"
                }
                outputs {
                    Result id=56 type="float"
                }
            }
        }
        (array)edges {
            - from="3.Value" to="53.p"
            - from="5.Value" to="35.time"
            - from="35.Result" to="53.radius"
            - from="53.Result" to="1.Distance"
        }
    }
    - id=7 kind="function" math_expression="27 + 8 * sin(time * 1.5)" expression_mode=1 entry_id=8
    - id=38 kind="function" math_expression="length(p) - radius" expression_mode=1 entry_id=39
}
