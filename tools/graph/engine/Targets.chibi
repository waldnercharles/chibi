            "CHIBI_PACKAGE_SNAPSHOT_BYTES=bytes:tools/compiler/source_snapshot/Snapshot.chibi",
            "CHIBI_PACKAGE_SYNTAX_BYTES=bytes:tools/compiler/package_syntax/Extract.chibi",
            "CHIBI_PREPARED_WRITER_BYTES=bytes:tools/compiler/prepared_writer/Writer.chibi",
            "CHIBI_RECORD_MEMBERS_BYTES=bytes:tools/compiler/record_members/Members.chibi",
            "CHIBI_COMPOSITIONAL_RECORDS_BYTES=bytes:test/language/fixtures/compositional_records/Values.chibi",
            "CHIBI_SCALAR_CASES_BYTES=bytes:test/scalar_facts/cases/Cases.chibi",
            "CHIBI_SCALAR_FACTS_BYTES=bytes:tools/compiler/scalar_facts/Facts.chibi",
            "CHIBI_SCALAR_IR_BYTES=bytes:tools/compiler/constant_ir/IR.chibi",
            "CHIBI_SCALAR_LLVM_BYTES=bytes:tools/compiler/scalar_llvm/Emit.chibi",
            "CHIBI_SCALAR_LOWERING_BYTES=bytes:tools/compiler/scalar_lowering/Lower.chibi",
            "CHIBI_SCALAR_PROOF_BYTES=bytes:tools/compiler/constant_admissibility/Proof.chibi",
            "CHIBI_SHADER_SOURCE_BYTES=bytes:tools/compiler/shader_source/SourceMap.chibi",
            "CHIBI_SHADER_LOWER_BYTES=bytes:tools/compiler/shader_source/Lower.chibi",
            "CHIBI_SIGNATURE_READER_BYTES=bytes:tools/compiler/signature_reader/Reader.chibi",
            "CHIBI_SOURCE_TOKENIZER_BYTES=bytes:tools/compiler/source_tokenizer/Tokenizer.chibi",
            "CHIBI_SYNTAX_DIAGNOSTICS_BYTES=bytes:tools/compiler/syntax_diagnostics/Diagnostics.chibi",
            "CHIBI_TYPE_CONSTRUCTORS_BYTES=bytes:tools/compiler/type_constructors/Constructors.chibi",
            "CHIBI_TYPE_RELATIONS_BYTES=bytes:tools/compiler/type_relations/Relations.chibi",
            "CHIBI_UNION_MEMBERS_BYTES=bytes:tools/compiler/union_members/Members.chibi",
            "CHIBI_UNIT_ALGEBRA_BYTES=bytes:tools/compiler/unit_algebra/Units.chibi",
            "CHIBI_UNIT_ANALYSIS_BYTES=bytes:tools/compiler/unit_analysis/Analysis.chibi",
            "CHIBI_BUILD_WORKFLOW_SOURCE=cstring:test/language/BuildWorkflow.chibi"
        ];
    }
    if (target == "chibi_tools_testing") {
        return ["CHIBI_EXPORT_COMPILER_ARGUMENTS=compiler:-UNDEBUG"];
    }
    return [];
}

// The program that writes a target's `build/` sources before it compiles, or
// empty: reflect writes the native type and binding tables.
pub Generator :: (target: string) -> string {
    if (target == "chibi_native_types" || target == "chibi_native_bindings") {
        return "reflect";
    }
    return "";
}

// Files a target embeds as byte arrays: `OUTPUT=SYMBOL=INPUT` writes the
// generated source OUTPUT, a `build/` path as Files names it, defining SYMBOL
// with the bytes of INPUT below the source root, as cmake/embed_binary.cmake
// does.
pub Embeds :: (target: string) -> string[] {
    if (target == "chibi_builtin_fonts") {
        return [
            "build/sdk/generated/fonts/editor_nerd_symbols_font.c=editor_nerd_symbols_font=third_party/fonts/nerd-fonts-symbols-only/SymbolsNerdFont-Regular.ttf",
            "build/sdk/generated/fonts/editor_ui_font.c=editor_ui_font=third_party/fonts/inter/Inter.ttf",
            "build/sdk/generated/fonts/editor_ui_bold_font.c=editor_ui_bold_font=third_party/fonts/inter/Inter-Bold.ttf",
            "build/sdk/generated/fonts/editor_ui_medium_font.c=editor_ui_medium_font=third_party/fonts/inter/Inter-Medium.ttf",
            "build/sdk/generated/fonts/editor_ui_semibold_font.c=editor_ui_semibold_font=third_party/fonts/inter/Inter-SemiBold.ttf",
            "build/sdk/generated/fonts/editor_ui_numeric_font.c=editor_ui_numeric_font=third_party/fonts/inter/Inter-Numeric.ttf",
            "build/sdk/generated/fonts/studio_regular_font.c=studio_regular_font=third_party/fonts/geist/Geist-Regular.ttf",
            "build/sdk/generated/fonts/studio_medium_font.c=studio_medium_font=third_party/fonts/geist/Geist-Medium.ttf",
            "build/sdk/generated/fonts/studio_semibold_font.c=studio_semibold_font=third_party/fonts/geist/Geist-SemiBold.ttf",
            "build/sdk/generated/fonts/studio_bold_font.c=studio_bold_font=third_party/fonts/geist/Geist-Bold.ttf",
            "build/sdk/generated/fonts/studio_numeric_font.c=studio_numeric_font=third_party/fonts/geist/Geist-Numeric.ttf",
            "build/sdk/generated/fonts/editor_noto_sans_font.c=editor_noto_sans_font=third_party/fonts/noto-sans/NotoSans-Regular.ttf",
            "build/sdk/generated/fonts/editor_noto_sans_semibold_font.c=editor_noto_sans_semibold_font=third_party/fonts/noto-sans/NotoSans-SemiBold.ttf",
            "build/sdk/generated/fonts/editor_noto_sans_bold_font.c=editor_noto_sans_bold_font=third_party/fonts/noto-sans/NotoSans-Bold.ttf",
            "build/sdk/generated/fonts/editor_inconsolata_font.c=editor_inconsolata_font=third_party/fonts/inconsolata/Inconsolata-Regular.ttf",
            "build/sdk/generated/fonts/editor_code_font.c=editor_code_font=third_party/fonts/jetbrains-mono/JetBrainsMono-Regular.ttf"
        ];
    }
    return [];
}

// The directory below the build directory CMake writes an executable to, as
// the CMake subdirectory that declares it or its RUNTIME_OUTPUT_DIRECTORY
// places it; empty for the build directory itself.
pub ProgramDirectory :: (target: string) -> string {
    if (target == "chibi-compile" || target == "chibi-build-host" ||
        target == "chibi-compiler-host" || target == "chibi") {
        return "sdk";
    }
    if (target == "test_language") {
        return "test/language";
    }
    if (target == "policy_worker" || target == "test_tools" || target == "benchmark_trials") {
        return "test/tools";
    }
    return "";
}

// Files a target installs into the build tree, `DESTINATION=SOURCE`, as root
// CMakeLists.txt configures them: a directory SOURCE copies every file below
// it. The launcher's players, `chibi version`, `chibi test` and `chibi doc`
// read ../share/chibi as installed ones do.
// build/sdk/chibi_engine_metadata.json is the build identity (Identity).
pub Resources :: (target: string) -> string[] {
    if (target == "chibi-build-host") {
        return [
            "build/share/chibi/compiler=tools/compiler",
            "build/share/chibi/core=packages/core",
            "build/share/chibi/tools/native_aot=tools/native_aot"
        ];
    }
    if (target == "chibi") {
        return [
            "build/share/chibi/engine.json=build/sdk/chibi_engine_metadata.json",
            "build/share/chibi/apps/chibi=apps/chibi",
            "build/share/chibi/core=packages/core"
        ];
    }
    return [];
}

// Source lists a target's tests read, `OUTPUT=ROOT`: every .chibi file below
// ROOT, by absolute path, sorted, as
// test/language/CMakeLists.txt writes the language corpus.
pub SourceLists :: (target: string) -> string[] {
    if (target == "test_language") {
        return ["build/test/language/corpus.txt=test/fixtures"];
    }
    return [];
}

// The artifact formats the build identity records, as
// sdk/artifact_formats.cmake lists them: `NAME SOURCE HEADER MACRO`,
// then VALUE_WIRE for a format that encodes through types/value_wire and
// EXECUTION_CODECS for the prepared function and record codecs. Paths are
// below src/.
pub ArtifactFormats :: () -> string[] {
    return [
        "execution execution/prepared.c execution/prepared.h EXECUTION_PREPARED_VERSION VALUE_WIRE EXECUTION_CODECS",
        "player runtime/player_prepared.c runtime/player_prepared.h PLAYER_PREPARED_VERSION VALUE_WIRE",
        "events runtime/event_catalog.c runtime/event_catalog.h EVENT_CATALOG_VERSION VALUE_WIRE",
        "field runtime/fields/prepared.c runtime/fields/prepared.h FIELD_PREPARED_VERSION",
        "material_fields runtime/material_field_prepared.c runtime/material_field_prepared.h MATERIAL_FIELDS_PREPARED_VERSION",
        "scene runtime/scenes/prepared.c runtime/scenes/prepared.h SCENE_PREPARED_VERSION VALUE_WIRE",
        "ui runtime/ui/documents.c runtime/ui/documents.h UI_DOCUMENT_VERSION VALUE_WIRE",
        "font runtime/ui/font.c runtime/ui/font.h UI_FONT_PREPARED_VERSION VALUE_WIRE",
        "shader runtime/shaders/prepared.c runtime/shaders/prepared.h SHADER_PREPARED_VERSION VALUE_WIRE",
        "model runtime/models/prepared.c runtime/models/prepared.h MODEL_PREPARED_VERSION VALUE_WIRE",
        "mesh runtime/geometry/mesh_prepared.c runtime/geometry/mesh_prepared.h RENDER_MESH_PREPARED_VERSION VALUE_WIRE",
        "image runtime/images/catalog.c runtime/images/catalog.h RENDER_IMAGE_PREPARED_VERSION VALUE_WIRE",
        "sky runtime/images/sky.c runtime/images/sky.h RENDER_SKY_PREPARED_VERSION VALUE_WIRE",
        "parts render/scene3d_parts.c render/scene3d_parts.h RENDER_PARTS_PREPARED_VERSION VALUE_WIRE",
        "shader_values render/shader_values.c render/shader_catalog.h SHADER_VALUES_PREPARED_VERSION"
    ];
}

// The programs an executable runs, built with it as CMake's add_dependencies
// builds them: test_tools runs the workers and tools whose paths it compiles
// in, and the launcher the compiler and player beside it.
pub Runs :: (target: string) -> string[] {
    if (target == "chibi_asset_compiler_host") {
        return ["chibi-build-host", "chibi-compiler-host"];
    }
    if (target == "chibi") {
        return ["chibi-compile"];
    }
    if (target == "test_tools") {
        return ["policy_worker", "benchmark_trials", "chibi-build-host", "chibi-compiler-host", "chibi-compile"];
    }
    return [];
}

// The executables the graph builds; every other target is a library.
pub Programs :: () -> string[] {
    programs := [
        "reflect", "chibi-build-host", "chibi-compiler-host", "chibi", "test_host", "concurrent_runner",
        "policy_worker", "benchmark_trials"
    ];
    if (os.Platform() == "Darwin" || os.Platform() == "Linux") {
        programs.extend(["chibi-compile", "test_language", "test_tools"]);
    }
    return programs;
}

// Whether an executable links with the C++ compiler, as CMake does when a
// library it links has C++ sources.
pub LinksCxx :: (target: string) -> bool {
    return target == "chibi" || target == "chibi-compile" || target == "test_language" ||
           target == "test_tools";
}

// The libraries whose objects executables link directly, as CMake's OBJECT
// libraries, rather than archive.
pub ObjectLibrary :: (target: string) -> bool {
    return target == "chibi_application" || target == "chibi_build_host" || target == "chibi_asset_compiler_consumer" || target == "test_behavior_consumer" ||
           Listed(ToolConsumers(), target);
}

// The object libraries an executable links, whose objects come before its
// own, as CMake orders them.
pub LinkedObjects :: (target: string) -> string[] {
    if (target == "chibi") {
        return ["chibi_application"];
    }
    if (target == "chibi-build-host") {
        return ["chibi_build_host"];
    }
    if (target == "chibi-compiler-host") {
        return [];
    }
    if (target == "test_language") {
        return ["chibi_asset_compiler_consumer", "test_behavior_consumer"];
    }
    if (target == "test_tools") {
        return [
            "chibi_scene_consumer",
            "chibi_sdk_contracts", "chibi_program_consumer", "chibi_shader_bake_consumer",
            "chibi_native_consumer",
            "chibi_asset_values_consumer", "chibi_ui_document_consumer", "chibi_particle_consumer",
            "chibi_image_preparation_consumer", "chibi_source_runtime_consumer",
            "chibi_source_features_consumer", "chibi_build_host"
        ];
    }
    return [];
}

// Options an executable's link adds after the profile's, its CMake
// LINK_OPTIONS: the compiler host drops what it does not call.
pub LinkOptions :: (target: string) -> string[] {
    if ((target == "chibi-compiler-host" || target == "test_language") && os.Platform() == "Darwin") {
        return ["-Wl,-dead_strip"];
    }
    if (target == "chibi-compiler-host") {
        return ["-Wl,--gc-sections"];
    }
    // SDL's interface link option, which CMake puts among the link flags.
    if (target == "test_tools") {
        if (os.Platform() == "Linux") {
            return ["-pthread"];
        }
        return ["-lpthread"];
    }
    return [];
}

// What an executable links after its output, in CMake's order, which may
// name a library twice: the graph's libraries by name, the third-party
// archive's as `third-party/` paths, and options and framework names as they
// are.
pub Links :: (target: string) -> string[] {
    if (target == "reflect") {
        return ["chibi_capabilities", "chibi_capabilities", "chibi_types", "chibi_support", "-lm"];
    }
    if (target == "chibi-build-host") {
        return [
            "chibi_compiler_host",
            "chibi_support", "chibi_value_document", "chibi_asset_json", "chibi_language_syntax",
            "third-party/lib/chibi-vendor/libchibi_vendor_tree_sitter.a",
            "chibi_asset_values", "chibi_json", "chibi_native_prepared",
            "chibi_behavior_runtime", "chibi_execution", "chibi_ecs",
            "third-party/lib/chibi-vendor/libchibi_vendor_sljit.a", "chibi_events",
            "chibi_text_capabilities", "chibi_fmt", "chibi_array_capabilities", "chibi_native_capabilities",
            "chibi_capabilities", "chibi_types", "chibi_support", "-lm"
        ];
    }
    if (target == "chibi-compiler-host") {
        return [
            "chibi_compiler_host",
            "chibi_asset_values", "chibi_json",
            "chibi_native_prepared", "chibi_behavior_runtime", "chibi_execution", "chibi_ecs",
            "third-party/lib/chibi-vendor/libchibi_vendor_sljit.a", "chibi_events",
            "chibi_text_capabilities", "chibi_fmt", "chibi_array_capabilities", "chibi_native_capabilities",
            "chibi_capabilities", "chibi_value_document", "chibi_types", "chibi_asset_json",
            "chibi_asset_values", "chibi_json", "chibi_language_syntax", "chibi_support", "-lm",
            "third-party/lib/chibi-vendor/libchibi_vendor_tree_sitter.a"
        ];
    }
    if (target == "chibi" && os.Platform() == "Darwin") {
        return [
            "chibi_program", "chibi_project_compilation", "chibi_source_catalog",
            "chibi_asset_compiler_host", "chibi_compiler_host", "chibi_asset_json", "chibi_native_prepared",
            "chibi_player", "chibi_engine", "chibi_scheduling",
            "chibi_visual_catalog",
            "chibi_model_runtime",
            "chibi_declared_components", "chibi_authoring", "chibi_reference_index", "chibi_compiler", "chibi_language",
            "chibi_ui_authoring", "chibi_ui_document", "chibi_text_source",
            "chibi_text_search", "chibi_ui_document_values",
            "chibi_builtin_fonts",
            "chibi_ui_documents", "chibi_image_preparation", "chibi_image_catalog",
            "chibi_host_native_default", "chibi_host_native_catalog",
            "chibi_field_capabilities", "chibi_state_capabilities", "chibi_selection_capabilities",
            "chibi_set_capabilities", "chibi_comparison_capabilities", "chibi_conversion_capabilities",
            "chibi_native_bindings", "chibi_audio_runtime", "chibi_url_runtime", "chibi_vector_capabilities",
            "chibi_math_capabilities", "chibi_arithmetic_capabilities", "chibi_ui_runtime",
            "chibi_value_document", "chibi_asset_values", "chibi_physics3d_runtime",
            "third-party/lib/chibi-vendor/libchibi_vendor_box3d.a", "chibi_visibility_runtime",
            "chibi_physics_runtime", "chibi_material_runtime", "chibi_entity_runtime", "chibi_scene_runtime",
            "chibi_tilemap_runtime", "chibi_particle_runtime", "chibi_save_runtime", "chibi_field_catalog",
            "chibi_fields", "chibi_shader_runtime", "chibi_mesh_runtime",
            "third-party/lib/chibi-vendor/libchibi_vendor_box2d.a", "chibi_input_runtime",
            "chibi_behavior_runtime", "chibi_events", "chibi_spatial_runtime", "chibi_native_types",
            "chibi_core_capabilities", "chibi_execution", "chibi_ecs",
            "third-party/lib/chibi-vendor/libchibi_vendor_sljit.a", "chibi_text_capabilities", "chibi_fmt",
            "chibi_array_capabilities", "chibi_task_pool_runtime",
            "third-party/lib/chibi-vendor/libchibi_vendor_enkits.a", "-lc++", "chibi_compiler_syntax",
            "chibi_language_syntax", "third-party/lib/chibi-vendor/libchibi_vendor_tree_sitter.a",
            "chibi_compiler_json", "chibi_json", "chibi_native_capabilities", "chibi_capabilities",
            "chibi_types", "chibi_support", "-lm"
        ];
    }
    if (target == "chibi" && os.Platform() == "Linux") {
        links := ["chibi_program"];
        links.extend(LinuxLinks("chibi-compile"));
        return links;
    }
    if (os.Platform() == "Linux") {
        links: string[] = [];
        if (target == "test_language" || target == "test_tools") {
            links.append("chibi_program");
        }
        links.extend(LinuxLinks(target));
        return links;
    }
    if (target == "chibi-compile" && os.Platform() == "Darwin") {
        return [
            "chibi_project_compilation", "chibi_behavior_runtime",
            "chibi_asset_json", "chibi_project_compilation",
            "chibi_asset_compiler_host", "chibi_compiler_host", "chibi_asset_json", "chibi_native_prepared",
            "chibi_player", "chibi_engine", "chibi_scheduling",
            "chibi_visual_catalog", "chibi_host_native_default",
            "chibi_host_native_catalog", "chibi_native_bindings", "chibi_audio_runtime", "chibi_url_runtime",
