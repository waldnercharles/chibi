package scalar_llvm

import facts "project:scalar_facts"
import native "project:llvm_native"
import abi "project:native_abi"
import strings "core:strings"

// Internal consumer result, not another source/facts representation. Rejections
// preserve the exact producer rows, including their source and diagnostic.
pub Result :: union {
    Rejected(rows: facts.Row[]) | Invalid(message: string) | Emitted(text: string)
}

// The offset each source line starts at, for one-based line/column checks.
LineStarts :: (text: string) -> int[] {
    starts: int[] = [0];
    bytes := strings.Bytes(text);
    for (index in 0..<length(bytes)) {
        if (bytes[index] == 10) {
            starts.append(index + 1);
        }
    }
    return starts;
}
// A half-open range of the source, at its recorded one-based line and column.
Positioned :: (row: facts.Row, starts: int[], size: int) -> bool {
    if (row.start < 0 || row.end < row.start || row.end > size || row.line < 1 || row.line > length(starts)) {
        return false;
    }
    first := starts[row.line - 1];
    return first <= row.start && (row.line == length(starts) || row.start < starts[row.line]) &&
           row.column == row.start - first + 1;
}
Located :: (row: facts.Row, starts: int[], size: int) -> bool {
    return row.end > row.start && Positioned(row, starts, size);
}
Within :: (inner: facts.Row, outer: facts.Row) -> bool {
    return inner.start >= outer.start && inner.end <= outer.end;
}
Unlocated :: (row: facts.Row) -> bool {
    return row.start == 0 && row.end == 0 && row.line == 0 && row.column == 0;
}
Scalar :: (type: int) -> bool {
    return type >= facts.IntType && type <= facts.DoubleType;
}
// Whether a record field or union payload may have `type`: a scalar or a
// string.
Stored :: (records: int[], type: int) -> bool {
    // Nested maps and task observers need recursive ownership before admission.
    return type != facts.TaskType && type < facts.MapType && Valued(records, type);
}
// Whether the record or union of type RecordType + `from` holds the one of
// type RecordType + `wanted` by value, directly or through others it holds by
// value. An array holds its elements apart, so it breaks a cycle. `depth`
// bounds the walk for cycles that do not reach `wanted`.
Nests :: (rows: facts.Row[], records: int[], from: int, wanted: int, depth: int) -> bool {
    head := records[from];
    end := After(rows, head);
    if (depth > length(records) || end < 0) {
        return true;
    }
    for (row in head + 1..<end) {
        member := rows[row];
        if (member.kind != facts.MemberRow || member.type < facts.RecordType || member.type >= facts.ArrayType) {
            continue;
        }
        held := member.type - facts.RecordType;
        if (held == wanted || Nests(rows, records, held, wanted, depth + 1)) {
            return true;
        }
    }
    return false;
}
// Whether `type` is a scalar, a string or one of the module's records and
// unions, or an array of one of them, whose Record and Union rows are at
// `records`.
Valued :: (records: int[], type: int) -> bool {
    if (type >= facts.MapType) {
        key := (type - facts.MapType) % 16;
        value := (type - facts.MapType) / 16;
        return (Integer(key) || key == facts.BoolType || key == facts.StringType) &&
               ((value >= facts.IntType && value <= facts.StringType) ||
                (value >= facts.ArrayType && value < facts.MapType && Element(records, value) != 0) ||
                (value >= facts.RecordType && value < facts.ArrayType && value - facts.RecordType < length(records)));
    }
    if (type >= facts.ArrayType) {
        return Element(records, type) != 0;
    }
    return Scalar(type) || type == facts.StringType || type == facts.TaskType || type == facts.PointerType || type == facts.ViewType ||
           (type >= facts.RecordType && type - facts.RecordType < length(records));
}
// The element type of array type `type`, or 0 when it is no array of a
// scalar, a string, or a record or union of the module.
Element :: (records: int[], type: int) -> int {
    element := type - facts.ArrayType;
    if (type >= facts.MapType || element < facts.IntType || element >= facts.ArrayType ||
        element == facts.TaskType || element == facts.ViewType || !Valued(records, element)) {
        return 0;
    }
    return element;
}
// The type of field `field` of record type `type`, or 0 when `type` is no
// record of the module or has no such field.
MemberType :: (rows: facts.Row[], records: int[], type: int, field: int) -> int {
    if (type < facts.RecordType || type - facts.RecordType >= length(records)) {
        return 0;
    }
    head := records[type - facts.RecordType];
    if (rows[head].kind != facts.RecordRow || field < 0 || field >= rows[head].count) {
        return 0;
    }
    return rows[head + 1 + field].type;
}
// The Union row of union type `type`, or -1 when `type` is no union of the
// module.
UnionHead :: (rows: facts.Row[], records: int[], type: int) -> int {
    if (type < facts.RecordType || type - facts.RecordType >= length(records)) {
        return -1;
    }
    head := records[type - facts.RecordType];
    if (rows[head].kind != facts.UnionRow) {
        return -1;
    }
    return head;
}
// The Variant row of variant `variant` of the union at `head`, or -1 when it
// has no such variant.
VariantOf :: (rows: facts.Row[], head: int, variant: int) -> int {
    if (variant < 0 || variant >= rows[head].count) {
        return -1;
    }
    at := head + 1;
    for (index in 0..<variant) {
        at += rows[at].count + 1;
    }
    return at;
}
// The type of payload `payload` of union type `type`, or 0 when `type` is no
// union of the module or has no such payload.
PayloadType :: (rows: facts.Row[], records: int[], type: int, payload: int) -> int {
    head := UnionHead(rows, records, type);
    if (head < 0) {
        return 0;
    }
    at := head + 1;
    for (variant in 0..<rows[head].count) {
        for (field in at + 1..<at + rows[at].count + 1) {
            if (rows[field].value == payload) {
                return rows[field].type;
            }
        }
        at += rows[at].count + 1;
    }
    return 0;
}
Integer :: (type: int) -> bool {
    return facts.Bits(type) != 0;
}
Number :: (type: int) -> bool {
    return Integer(type) || facts.Floating(type);
}
// Whether the operation `operator` applies to `type`: every arithmetic
// operator to integers; floats also have the native fmod remainder.
Computes :: (operator: int, type: int) -> bool {
    if (facts.Floating(type)) {
        return (operator >= facts.Add && operator <= facts.Remainder) || operator == facts.ReversedRemainder;
    }
    return Integer(type) && operator >= facts.Add && operator <= facts.ShiftRight;
}
// The conversions the runtime implements: integers to one another and to
// double, float and double to one another and to the integers.
Converts :: (from: int, to: int) -> bool {
    if (to == facts.FloatType) {
        return from == facts.DoubleType;
    }
    if (to == facts.DoubleType) {
        return Integer(from) || from == facts.FloatType;
    }
    return Integer(to) && Number(from);
}
// Result-bank projection has no native cell pointers: one plain record value.
ClockSampleType :: (rows: facts.Row[], records: int[], type: int) -> bool {
    if (type < facts.RecordType || type >= facts.ArrayType || type - facts.RecordType >= length(records)) { return false; }
    head := records[type - facts.RecordType];
    if (rows[head].kind != facts.RecordRow || rows[head].count != 4) { return false; }
    expected := [facts.Int64Type, facts.WordType, facts.IntType, facts.IntType];
    for (field, index in expected) {
        member := rows[head + 1 + index];
        if (member.type != field || member.literal != 0) { return false; }
    }
    return true;
}
// The backend's storage ordinal of a value type: the storages of int, bool,
// i8, u8, i16, u16, u32, i64, u64, number, f64 and string in facts type
// order. Record r is the backend's record r.
NativeType :: (type: int) -> int {
    if (type >= facts.ReferenceType) { return native.RefType + NativeType(type - facts.ReferenceType); }
    if (type == facts.TaskType) { return native.TaskType; }
    if (type == facts.PointerType) { return native.PointerType; }
    if (type == facts.ViewType) { return native.ViewType; }
    if (type >= facts.MapType) {
        return native.MapOf(NativeType((type - facts.MapType) % 16), NativeType((type - facts.MapType) / 16));
    }
    if (type >= facts.ArrayType) {
        return native.ArrayType + NativeType(type - facts.ArrayType);
    }
    if (type >= facts.RecordType) {
        return native.RecordType + type - facts.RecordType;
    }
    storages: int[] = [6, 1, 2, 3, 4, 5, 7, 8, 9, 10, 11, abi.TextStorage];
    return storages[type - facts.IntType];
}
// A rejection keeps exactly its source and one located diagnostic.
ValidRejection :: (rows: facts.Row[], starts: int[], size: int) -> string {
    rejection := rows[1];
    if (length(rows) != 2 || rejection.type != 0 || rejection.value != 0 || rejection.count != 0 ||
        rejection.literal != 0 || rejection.name != "" || rejection.text == "") {
        return "noncanonical rejected scalar module";
    }
    if (!Positioned(rejection, starts, size)) {
        return format_text("invalid scalar diagnostic position for: {}", rejection.text);
    }
    return "";
}
// The row after the segment at `at`, a row of `kind` and its `count`
// operands, when they lie within `rows`; otherwise -1.
Span :: (rows: facts.Row[], at: int, kind: int) -> int {
    if (at >= length(rows) || rows[at].kind != kind) {
        return -1;
    }
    count := rows[at].count;
    if (count < 1 || count > length(rows) - at - 1) {
        return -1;
    }
    return at + count + 1;
}
// Whether `kind` is a statement row with operands of its own.
Statement :: (kind: int) -> bool {
    return kind == facts.LocalRow || kind == facts.AssignRow || kind == facts.IfRow || kind == facts.ReturnRow ||
           kind == facts.WhileRow || kind == facts.ForRow || kind == facts.SwitchRow || kind == facts.AssertRow || kind == facts.ScopeRow;
}
// Whether `kind` is an if statement's, a switch's or a loop's row, which an
// End row closes.
Opens :: (kind: int) -> bool {
    return kind == facts.IfRow || kind == facts.SwitchRow || kind == facts.ScopeRow || Loop(kind);
}
// Whether `kind` is a loop's row.
Loop :: (kind: int) -> bool {
    return kind == facts.WhileRow || kind == facts.ForRow;
}
// The type of member `index` of record type `type`, or -1 when `type` is no record of the module or has no such
// member.
RecordMemberType :: (rows: facts.Row[], records: int[], type: int, index: i64) -> int {
    if (type < facts.RecordType || type - facts.RecordType >= length(records)) {
        return -1;
    }
    head := records[type - facts.RecordType];
    if (rows[head].kind != facts.RecordRow || index < 0 || index >= i64(rows[head].count)) {
        return -1;
    }
    return rows[head + 1 + int(index)].type;
}
// The payload type of exactly Nil | Some(value), or 0 for another union.
OptionalPayloadType :: (rows: facts.Row[], records: int[], type: int) -> int {
    head := UnionHead(rows, records, type);
    if (head < 0 || rows[head].count != 2) { return 0; }
    none := VariantOf(rows, head, 0);
    some := VariantOf(rows, head, 1);
    if (rows[none].name != "Nil" || rows[none].count != 0 || rows[some].name != "Some" || rows[some].count != 1) { return 0; }
    return rows[some + 1].type;
}
// Whether `row` is a loop over an array, and whether it also names the index.
Arrayed :: (row: facts.Row) -> bool {
    return row.kind == facts.ForRow && (row.literal == i64(facts.RangeArray) ||
                                      row.literal == i64(facts.RangeArray + facts.RangeKeyed) ||
                                      row.literal == i64(facts.RangeArray + facts.RangeReverse) ||
                                      row.literal == i64(facts.RangeArray + facts.RangeKeyed + facts.RangeReverse));
}
MapIterated :: (row: facts.Row) -> bool {
    return row.kind == facts.ForRow && (row.literal == i64(facts.RangeMap) ||
                                      row.literal == i64(facts.RangeMap + facts.RangeKeyed));
}
Keyed :: (row: facts.Row) -> bool {
    return row.kind == facts.ForRow && (row.literal == i64(facts.RangeArray + facts.RangeKeyed) ||
                                      row.literal == i64(facts.RangeArray + facts.RangeKeyed + facts.RangeReverse) ||
                                      row.literal == i64(facts.RangeMap + facts.RangeKeyed));
}
// The first loop binding: an array element, a map value, or a keyed map's key.
IterationType :: (row: facts.Row) -> int {
    if (MapIterated(row)) {
        if (Keyed(row)) { return (row.type - facts.MapType) % 16; }
        return (row.type - facts.MapType) / 16;
    }
    return row.type;
}
// Whether the variable `variable` of the function whose Function row is
// rows[head] is a reference parameter.
Referenced :: (rows: facts.Row[], head: int, variable: int) -> bool {
    if (variable >= rows[head].count) {
        return false;
    }
    return facts.ReferenceParameter(rows[head + 1 + variable].literal);
}
// The row after the declaration at `at`: a Record row and its members, or a
// Union row and its variants, each with its members; -1 when a count is
// empty or negative, runs past `rows`, or a union's variant row is missing.
// Each count is compared with the rows that remain, so no sum wraps.
After :: (rows: facts.Row[], at: int) -> int {
    count := rows[at].count;
    if (count < 1 || count > length(rows) - at - 1) {
        return -1;
    }
    if (rows[at].kind == facts.RecordRow) {
        return at + count + 1;
    }
    next := at + 1;
    for (variant in 0..<count) {
        if (next >= length(rows) || rows[next].kind != facts.VariantRow || rows[next].count < 0 ||
            rows[next].count > length(rows) - next - 1) {
            return -1;
        }
        next += rows[next].count + 1;
    }
    return next;
}
// The row index of each Record and Union row from row 2, up to the first row
// that is neither or whose declaration's counts are invalid, which
// ValidRecords rejects.
Records :: (rows: facts.Row[]) -> int[] {
    records: int[] = [];
    at: int = 2;
    while (at < length(rows) && (rows[at].kind == facts.RecordRow || rows[at].kind == facts.UnionRow)) {
        records.append(at);
        at = After(rows, at);
        if (at < 0) {
            break;
        }
    }
    return records;
}
// The row after the last declaration, where functions start.
Start :: (rows: facts.Row[], records: int[]) -> int {
    if (length(records) == 0) {
        return 2;
    }
    return After(rows, records[length(records) - 1]);
}
// Each record has at least one uniquely named scalar field, each a Member
// row within its declaration, each union is valid, and a function follows the
// last; record and union names are unique too.
ValidRecords :: (rows: facts.Row[], records: int[], starts: int[], size: int) -> string {
    for (index in 0..<length(records)) {
        head := records[index];
        record := rows[head];
        for (earlier in 0..<index) {
            if (rows[records[earlier]].name == record.name) {
                return "invalid scalar record row";
            }
        }
        if (record.kind == facts.UnionRow) {
            error := ValidUnion(rows, records, head, starts, size);
            if (error != "") {
                return error;
            }
            if (Nests(rows, records, index, index, 0)) {
                return "invalid scalar union row";
            }
            continue;
        }
        if (record.count < 1 || record.count >= length(rows) - head - 1 ||
            record.name == "" || record.text != "" || record.type != 0 || record.value != 0 ||
            !Located(record, starts, size)) {
            return "invalid scalar record row";
        }
        for (field in 0..<record.count) {
            member := rows[head + 1 + field];
            if (member.kind != facts.MemberRow || member.name == "" || member.text != "" || !Stored(records, member.type) ||
                member.value != field || member.count != 0 ||
                (record.literal == 0 && (member.type == facts.PointerType ||
                    (member.literal != 0 && (member.literal != i64(facts.CharNominal) || member.type != facts.IntType)))) ||
                (record.literal != 0 && (member.literal == 0 || (!Scalar(member.type) && member.type != facts.PointerType))) || !Located(member, starts, size) ||
                !Within(member, record)) {
                return "invalid scalar record member row";
            }
            for (earlier in 0..<field) {
                if (rows[head + 1 + earlier].name == member.name) {
                    return "invalid scalar record member row";
                }
            }
        }
        if (Nests(rows, records, index, index, 0)) {
            return "invalid scalar record row";
        }
    }
    return "";
}
// A union at `head` has at least one uniquely named variant, in order, each
// a Variant row within its declaration with its uniquely named scalar
// payloads, each a Member row within its variant numbered across the union,
// and a function follows it.
ValidUnion :: (rows: facts.Row[], records: int[], head: int, starts: int[], size: int) -> string {
    declared := rows[head];
    beyond := After(rows, head);
    if (beyond < 0 || beyond >= length(rows) || declared.name == "" || declared.text != "" || declared.type != 0 ||
        declared.value != 0 || !Located(declared, starts, size)) {
        return "invalid scalar union row";
    }
    variants: int[] = [];
    payloads: int = 0;
    at := head + 1;
    for (ordinal in 0..<declared.count) {
        variant := rows[at];
        if (variant.name == "" || variant.text != "" || variant.type != 0 || variant.value != ordinal ||
            variant.literal != 0 || !Located(variant, starts, size) || !Within(variant, declared)) {
            return "invalid scalar union variant row";
        }
        for (earlier in variants) {
            if (rows[earlier].name == variant.name) {
                return "invalid scalar union variant row";
            }
        }
        variants.append(at);
        for (field in at + 1..<at + variant.count + 1) {
            member := rows[field];
            if (member.kind != facts.MemberRow || member.name == "" || member.text != "" || !Stored(records, member.type) ||
                member.value != payloads || member.count != 0 || member.literal != 0 ||
                !Located(member, starts, size) || !Within(member, variant)) {
                return "invalid scalar union member row";
            }
            for (earlier in at + 1..<field) {
                if (rows[earlier].name == member.name) {
                    return "invalid scalar union member row";
                }
            }
            payloads += 1;
        }
        at += variant.count + 1;
    }
    if (declared.literal != 0 && !ManagedOptional(rows, records, facts.RecordType + SortedIndex(records, head))) {
        return "invalid managed optional cell layout";
    }
    return "";
}
// The row index of each function from `start`, after checking the module's
// row layout and every count before it is used: each function's
// statements, with their operands, until the next function, each Else in an
// open if statement before its End, each Case in an open switch before any
// statement of the switch, each Break and Continue in an open loop, and every
// if statement, switch and loop closed. Empty when invalid.
Heads :: (rows: facts.Row[], start: int) -> int[] {
    heads: int[] = [];
    empty: int[] = [];
    at := start;
    while (at < length(rows)) {
        function := rows[at];
        if (function.kind != facts.FunctionRow || function.count < 0 || function.count > length(rows) - at - 2) {
            return empty;
        }
        heads.append(at);
        at += function.count + 1;
        statements: int = 0;
        // Each open if statement's, switch's or loop's row kind, an if
        // statement's Else kind once its else has begun or a switch's Case
        // kind once its first arm has, and how many are loops.
        open: int[] = [];
        loops: int = 0;
        while (at < length(rows) && rows[at].kind != facts.FunctionRow) {
            kind := rows[at].kind;
            top := length(open) - 1;
            if (kind == facts.CaseRow) {
                if (top < 0 || (open[top] != facts.SwitchRow && open[top] != facts.CaseRow)) {
                    return empty;
                }
                statements += 1;
                open[top] = kind;
                next := at + 1;
                if (rows[at].count != 0) {
                    next = Span(rows, at, kind);
                }
                if (next < 0) {
                    return empty;
                }
                at = next;
                continue;
            }
            if (kind != facts.EndRow && top >= 0 && open[top] == facts.SwitchRow) {
                return empty;
            }
            if (kind == facts.ElseRow || kind == facts.EndRow) {
                if (rows[at].count != 0 || top < 0 || (kind == facts.ElseRow && open[top] != facts.IfRow)) {
                    return empty;
                }
                if (kind == facts.ElseRow) {
                    open[top] = kind;
                } else {
                    if (Loop(open[top])) {
                        loops -= 1;
                    }
                    open = slice(open, 0, top);
                }
                at += 1;
                continue;
            }
            if (kind == facts.BreakRow || kind == facts.ContinueRow) {
                if (rows[at].count != 0 || loops == 0) {
                    return empty;
                }
                statements += 1;
                at += 1;
                continue;
            }
            if (!Statement(kind)) {
                return empty;
            }
            if (kind == facts.ScopeRow) {
                if (rows[at].count != 0) { return empty; }
                statements += 1;
                open.append(kind);
                at += 1;
                continue;
            }
            next := Span(rows, at, kind);
            if (next < 0) {
                return empty;
            }
            statements += 1;
            if (Opens(kind)) {
                open.append(kind);
            }
            if (Loop(kind)) {
                loops += 1;
            }
            at = next;
        }
        if (statements == 0 || length(open) != 0) {
            return empty;
        }
    }
    return heads;
}
// The row after the last of function `function`'s rows in a valid layout.
Last :: (rows: facts.Row[], heads: int[], function: int) -> int {
    if (function + 1 < length(heads)) {
        return heads[function + 1];
    }
    return length(rows);
}
// The operands a Text row's operator consumes: its string, then its index,
// or its start and count; 0 for no operator. A TextFormat row's count says
// how many it consumes.
TextOperands :: (operator: int) -> int {
    if (operator == facts.TextLength || operator == facts.TextPrint) {
        return 1;
    }
    if (operator == facts.TextByte) {
        return 2;
    }
    if (operator == facts.TextSlice) {
        return 3;
    }
    return 0;
}
// Whether `type` is an array or map: a container tracked by value ownership.
ArrayTyped :: (type: int) -> bool {
    return type >= facts.ArrayType && type < native.RefType;
}
// Whether the operand row gives a new array that whoever takes it owns, rather
// than one a variable or a lent argument holds.
FreshArray :: (operand: facts.Row) -> bool {
    if (operand.kind == facts.ViewRow) { return facts.ViewOperation(operand.value) == facts.ViewClone; }
    if (operand.kind == facts.CallRow) {
        return ArrayTyped(operand.type) || operand.type == facts.StringType || operand.type == facts.TaskType;
    }
    if (operand.kind == facts.TextRow) {
        return operand.value == facts.TextFormat;
    }
    if (operand.kind == facts.MapRow) {
        return operand.value == facts.MapNew || operand.value == facts.MapCopy ||
               ((operand.value == facts.MapGet || operand.value == facts.MapKeyAt || operand.value == facts.MapValueAt) &&
                (operand.type == facts.StringType || (operand.type >= facts.ArrayType && operand.type < facts.MapType)));
    }
    if (operand.kind != facts.ArrayRow || operand.literal != 0) {
        return false;
    }
    value := operand.value;
    return value == facts.ArrayNew || value == facts.ArrayCopy || value == facts.ArrayWith || value == facts.ArrayJoin ||
           value == facts.ArraySlice || value == facts.ArrayResize || value == facts.ArrayBytes || value == facts.ArrayText ||
           value == facts.ArrayWithout || value == facts.ArrayWithoutItem || value == facts.ArrayLoan || value == facts.ArrayInserted || value == facts.ArrayReversed || value == facts.ArrayReplaced;
}
// Whether the native `type` is owned by whoever holds it: an array, or a string.
Owning :: (type: int) -> bool {
    return ArrayTyped(type) || type == abi.TextStorage || type == native.TaskType;
}
// The instruction that gives back a reference to a `type` that is Owning.
Giving :: (type: int, slot: int) -> native.Instruction {
    if (type == native.TaskType) { return Op(native.TaskDrop, type, 0, slot, 0, 0); }
    if (type == abi.TextStorage) {
        return Op(native.TextRelease, type, 0, slot, 0, 0);
    }
    if (type >= native.MapType) {
        return Op(native.MapDrop, type, 0, slot, 0, 0);
    }
    return Op(native.ArrayDrop, type, 0, slot, 0, 0);
}
// The statement row after the one at `at`, past its operands.
Following :: (rows: facts.Row[], at: int) -> int {
    return at + rows[at].count + 1;
}
// How many of the operands of the statement at `at` read variable `v`.
ReadCount :: (rows: facts.Row[], at: int, v: int) -> int {
    found := 0;
    for (operand in at + 1..<at + 1 + rows[at].count) {
        if ((rows[operand].kind == facts.ReadRow || rows[operand].kind == facts.RefRow) && rows[operand].value == v) {
            found += 1;
        }
    }
    return found;
}
// The End row that closes the open statement at `at`.
Closed :: (rows: facts.Row[], at: int) -> int {
    depth := 0;
    next := at;
    while (next < length(rows)) {
        if (Opens(rows[next].kind)) {
            depth += 1;
        } else if (rows[next].kind == facts.EndRow) {
            depth -= 1;
            if (depth == 0) {
                return next;
            }
        }
        next = Following(rows, next);
    }
    return length(rows);
}
// The row that ends the block of statements starting at `from`: the End, Else
// or Case row of the statement it lies in, or `limit`.
BlockEnd :: (rows: facts.Row[], from: int, limit: int) -> int {
    depth := 0;
    next := from;
    while (next < limit) {
        kind := rows[next].kind;
        if (depth == 0 && (kind == facts.EndRow || kind == facts.ElseRow || kind == facts.CaseRow)) {
            return next;
        }
        if (Opens(kind)) {
            depth += 1;
        } else if (kind == facts.EndRow) {
            depth -= 1;
        }
        next = Following(rows, next);
    }
    return limit;
}
// What the statements in [from, to), whole, do first with variable `v`: 0
// nothing on some path, so what follows decides; 1 read it, or leave it for a
// jump to decide; 2 overwrite it, or return, on every path. `nested` says the
// statements lie inside a loop, if or switch the scan is looking through.
Touches :: (rows: facts.Row[], records: int[], from: int, to: int, v: int, nested: bool) -> int {
    at := from;
    while (at < to) {
        kind := rows[at].kind;
        if (kind == facts.ReturnRow) {
            if (ReadCount(rows, at, v) > 0) {
                return 1;
            }
            return 2;
        }
        if (kind == facts.BreakRow || kind == facts.ContinueRow) {
            // A jump out of the scanned statements leaves it to what follows
            // them; inside a statement scanned whole, it goes where the scan
            // looks anyway.
            if (nested) {
                return 0;
            }
            return 1;
        }
        if (!Opens(kind)) {
            if (ReadCount(rows, at, v) > 0) {
                return 1;
            }
            if (kind == facts.AssignRow && rows[at].value == v) {
                return 2;
            }
            at = Following(rows, at);
            continue;
        }
        if (ReadCount(rows, at, v) > 0) {
            return 1;
        }
        found := Inside(rows, records, at, v, nested);
        if (found == 1) {
            return 1;
        }
        if (found == 2) {
            return 2;
        }
        at = Closed(rows, at) + 1;
    }
    return 0;
}
// What the body of the open statement at `at` does first with `v`, as Touches
// gives it, over the paths through it: the arms of an if or switch together, or
// a loop's body, which may not run, so only a read in it counts.
Inside :: (rows: facts.Row[], records: int[], at: int, v: int, nested: bool) -> int {
    end := Closed(rows, at);
    body := Following(rows, at);
    if (rows[at].kind == facts.ScopeRow) { return Touches(rows, records, body, end, v, nested); }
    if (Loop(rows[at].kind)) {
        if (Touches(rows, records, body, end, v, true) == 1) {
            return 1;
        }
        return 0;
    }
    if (rows[at].kind == facts.IfRow) {
        stop := BlockEnd(rows, body, end);
        first := Touches(rows, records, body, stop, v, nested);
        second := 0;
        if (stop < end && rows[stop].kind == facts.ElseRow) {
            second = Touches(rows, records, Following(rows, stop), end, v, nested);
        }
        if (first == 1 || second == 1) {
            return 1;
        }
        if (first == 2 && second == 2) {
            return 2;
        }
        return 0;
    }
    // A switch: each Case row starts an arm. It has every path when an arm is
    // the default or the arms are all the union's variants.
    arms := 0;
    ended := 0;
    defaulted := false;
    next := body;
    while (next < end) {
        if (rows[next].kind != facts.CaseRow) {
            next = Following(rows, next);
            continue;
        }
        if (rows[next].count == 0) {
            defaulted = true;
        }
        start := Following(rows, next);
        stop := BlockEnd(rows, start, end);
        found := Touches(rows, records, start, stop, v, nested);
        if (found == 1) {
            return 1;
        }
        if (found == 2) {
            ended += 1;
        }
        arms += 1;
        next = stop;
    }
    head := UnionHead(rows, records, rows[at].type);
    exhaustive := defaulted || (head >= 0 && arms == rows[head].count);
    if (exhaustive && arms > 0 && ended == arms) {
        return 2;
    }
    return 0;
}
// Whether variable `v` is dead once the operands of the statement at `at` are
// evaluated: no path reads it before it is overwritten or the function ends.
// A jump out of a loop counts as a read, and so does the end of a loop body
// unless the variable, one of `opened` at the row of `opened_at`, was declared
// inside the loop.
Dead :: (rows: facts.Row[], records: int[], at: int, last: int, v: int, openers: int[], opened: int[],
         opened_at: int[]) -> bool {
    kind := rows[at].kind;
    // The statement's operands are already evaluated, and a return ends the
    // function after them.
    if (kind == facts.ReturnRow) {
        return true;
    }
    cur := Following(rows, at);
    if (Opens(kind)) {
        found := Inside(rows, records, at, v, false);
        if (found == 1) {
            return false;
        }
        if (found == 2) {
            return true;
        }
        cur = Closed(rows, at) + 1;
    }
    return DeadFrom(rows, records, cur, last, v, openers, opened, opened_at);
}
// Whether variable `v` is dead from the row `cur` on, as Dead says it.
DeadFrom :: (rows: facts.Row[], records: int[], cur_from: int, last: int, v: int, openers: int[], opened: int[],
             opened_at: int[]) -> bool {
    cur := cur_from;
    for (turn in 0..<last) {
        stop := BlockEnd(rows, cur, last);
        found := Touches(rows, records, cur, stop, v, false);
        if (found == 1) {
            return false;
        }
        if (found == 2 || stop >= last) {
            return true;
        }
        // The block ended: continue after the statement it belongs to, unless
        // that runs again.
        opener := openers[stop] - 1;
        if (opener >= 0 && Loop(rows[opener].kind)) {
            // Falling off a loop body runs the loop again. A variable declared
            // in the body is declared anew before anything reads it.
            for (index in 0..<length(opened)) {
                if (opened[index] == v && opened_at[index] > opener) {
                    return true;
                }
            }
            return false;
        }
        if (opener < 0) {
            return false;
        }
        cur = Closed(rows, opener) + 1;
    }
    return false;
}
// `values` without `removed`.
Without :: (values: int[], removed: int) -> int[] {
    kept: int[] = [];
    for (value in values) {
        if (value != removed) {
            kept.append(value);
        }
    }
    return kept;
}
// What dropping variables takes: instructions, and the types of the slots they use.
Drops :: struct {
    code: native.Instruction[];
    slot_types: int[];
}
// Both helpers take FACTS type IDs, which NativeType converts at emission.
// Copy can replace borrowed array descriptors, so callers must use `value`.
HeldValue :: struct {
    code: native.Instruction[];
    slot_types: int[];
    value: int;
}
KeepValue :: (managed: bool[], type: int, held: int, next: int) -> HeldValue {
    found: HeldValue = {code: [], slot_types: [], value: held};
    if (type == facts.StringType) {
        found.code.append(Op(native.TextRetain, abi.TextStorage, 0, held, 0, 0));
    } else if (TrackedRecord(managed, type) || (type >= facts.ArrayType && type < facts.MapType)) {
        found.code.append(Op(native.ValueCopy, NativeType(type), next, held, 0, 0));
        found.slot_types.append(NativeType(type));
        found.value = next;
    }
    return found;
}
// Drop uses the same per-type lifecycle as array and map payloads.
DropValue :: (managed: bool[], type: int, held: int) -> Drops {
    found: Drops = {code: [], slot_types: []};
    if (type == facts.StringType) {
        found.code.append(Op(native.TextRelease, abi.TextStorage, 0, held, 0, 0));
    } else if (TrackedRecord(managed, type) || (type >= facts.ArrayType && type < facts.MapType)) {
        found.code.append(Op(native.ValueDrop, NativeType(type), 0, held, 0, 0));
    }
    return found;
}
TrackedRecord :: (managed: bool[], type: int) -> bool {
    return type >= facts.RecordType && type < facts.ArrayType &&
           type - facts.RecordType < length(managed) && managed[type - facts.RecordType];
}
// The arrays a union type holds in its payloads: for each, the variant's tag,
// the payload's field in the union's record and the array's native type.
Payloads :: struct {
    tags: int[];
    fields: int[];
    types: int[];
}
UnionPayloads :: (rows: facts.Row[], records: int[], type: int) -> Payloads {
    found: Payloads = {tags: [], fields: [], types: []};
    head := UnionHead(rows, records, type);
    if (head < 0) {
        return found;
    }
    at := head + 1;
    for (ordinal in 0..<rows[head].count) {
        variant := rows[at];
        for (field in at + 1..<at + variant.count + 1) {
            member := NativeType(rows[field].type);
            if (ArrayTyped(member)) {
                found.tags.append(ordinal);
                found.fields.append(rows[field].value + 1);
                found.types.append(member);
            }
        }
        at += variant.count + 1;
    }
    return found;
}
// Whether `type` is a union that holds an array in some payload.
HoldsArrays :: (rows: facts.Row[], records: int[], type: int) -> bool {
    payloads := UnionPayloads(rows, records, type);
    return length(payloads.tags) > 0;
}
// The instructions that drop the arrays the union of record `type` holds, as the
// variant its tag names does: each payload array is dropped when the tag is its
// variant's. The union is in slot `held`, or in the local `place` when `held`
// is -1 (loaded into the slot `next`). `base` is where the instructions go in the
// function's code, which the branches over each drop aim at.
UnionDrop :: (payloads: Payloads, type: int, place: int, held: int, next: int, base: int) -> Drops {
    found: Drops = {code: [], slot_types: []};
    source := held;
    at := next;
    if (source < 0) {
        found.code.append(Op(native.Local, type, at, place, 0, 0));
        found.slot_types.append(type);
        source = at;
        at += 1;
    }
    integer := NativeType(facts.IntType);
    for (index in 0..<length(payloads.tags)) {
        tag := Op(native.Extract, integer, at, source, type, 0);
        tag.literal = i64(0);
        expected := Op(native.Constant, integer, at + 1, 0, 0, 0);
        expected.literal = i64(payloads.tags[index]);
        // Skip the payload's drop but for the tag's variant: the six
        // instructions below, from the tag to the drop.
        past := base + length(found.code) + 6;
        payload := Op(native.Extract, payloads.types[index], at + 3, source, type, 0);
        payload.literal = i64(payloads.fields[index]);
        found.code.extend([tag, expected, Op(native.Ne, integer, at + 2, at, at + 1, 0),
                           Op(native.Branch, 0, 0, at + 2, 0, past), payload,
                           Giving(payloads.types[index], at + 3)]);
        found.slot_types.extend([integer, integer, abi.BoolStorage, payloads.types[index]]);
        at += 4;
    }
    return found;
}
// The instructions that drop the arrays of the owning variables vars[from...],
// latest first, but for `skips` and any whose type is 0 (an array that moved
// into a record), each read from its local into slots from
// `slot`; with `held`, then the hidden array locals of the open loops that own
// theirs. A variable of a union type drops the arrays its variant holds. Dropped
// gives their slots' types, in the same order; `base` is where the code goes.
DropAll :: (rows: facts.Row[], records: int[], managed: bool[], vars: int[], types: int[], places: int[], from: int, skips: int[],
            frames: Frame[], held: bool, slot: int, base: int) -> Drops {
    found: Drops = {code: [], slot_types: []};
    at := length(vars) - 1;
    next := slot;
    while (at >= from) {
        if (types[at] != 0 && !Holds(skips, vars[at])) {
            payloads := UnionPayloads(rows, records, types[at]);
            if (TrackedRecord(managed, types[at])) {
                found.code.append(Op(native.Local, types[at], next, places[vars[at]], 0, 0));
                found.slot_types.append(types[at]);
                glue := DropValue(managed, types[at], next);
                found.code.extend(glue.code);
                found.slot_types.extend(glue.slot_types);
                next += 1 + length(glue.slot_types);
            } else if (length(payloads.tags) > 0) {
                glue := UnionDrop(payloads, types[at], places[vars[at]], -1, next, base + length(found.code));
                found.code.extend(glue.code);
                found.slot_types.extend(glue.slot_types);
                next += length(glue.slot_types);
            } else {
                found.code.extend([Op(native.Local, types[at], next, places[vars[at]], 0, 0), Giving(types[at], next)]);
                found.slot_types.append(types[at]);
                next += 1;
                if (types[at] == native.TaskType) {
                    found.slot_types.append(native.TaskType);
                    found.code.extend([Op(native.Constant, native.TaskType, next, 0, 0, 0),
                                       Op(native.Save, native.TaskType, 0, next, 0, places[vars[at]])]);
                    next += 1;
                }
            }
        }
        at -= 1;
    }
    if (held) {
        for (frame in frames) {
            if (frame.held >= 0) {
                found.code.extend([Op(native.Local, frame.held_type, next, frame.held, 0, 0),
                                   Giving(frame.held_type, next)]);
                found.slot_types.append(frame.held_type);
                next += 1;
            }
        }
    }
    return found;
}
Holds :: (values: int[], wanted: int) -> bool {
    for (value in values) {
        if (value == wanted) {
            return true;
        }
    }
    return false;
}
// The operands an Array row's operator consumes: ArrayNew's elements, one
// array, an array and an index, an element or another array, or an array and
// two ints or an index and an element; 0 for no operator.
ArrayOperands :: (operand: facts.Row) -> int {
    extra := 0;
    if (operand.literal == i64(facts.NestedArrayPlace)) {
        if (!ArrayChanges(operand.value) && operand.value != facts.ArrayResize) { return 0; }
        extra = 1;
    }
    if (operand.value == facts.ArrayInsert || operand.value == facts.ArrayInserted ||
        operand.value == facts.ArrayReplace || operand.value == facts.ArrayReplaced) { return 3 + extra; }
    if (operand.value == facts.ArrayReverse || operand.value == facts.ArrayReversed) { return 1 + extra; }
    if (operand.value == facts.ArrayPlaceGet || operand.value == facts.ArrayPlaceCheck || operand.value == facts.ArrayWithoutItem) { return 2; }
    if (operand.value == facts.ArrayNew) { return operand.count; }
    consumed: int[] = [0, 0, 1, 2, 3, 2, 1, 2, 3, 2, 2, 2, 2, 2, 1, 1, 2, 1];
    if (operand.value < facts.ArrayNew || operand.value > facts.ArrayLoan) { return 0; }
    return consumed[operand.value] + extra;
}
// The one-field physical wrapper carries exactly one immediate primitive
// array. It never carries a managed cell or another aggregate to trace.
NestedArrayMember :: (rows: facts.Row[], records: int[], type: int) -> int {
    wrapper := Element(records, type);
    if (wrapper < facts.RecordType || wrapper >= facts.ArrayType || wrapper - facts.RecordType >= length(records)) { return 0; }
    head := records[wrapper - facts.RecordType];
    if (rows[head].kind != facts.RecordRow || rows[head].count != 1) { return 0; }
    inner := rows[head + 1].type;
    if (inner < facts.ArrayType || inner >= facts.MapType ||
        (!Scalar(inner - facts.ArrayType) && inner - facts.ArrayType != facts.StringType)) { return 0; }
    return inner;
}
// Whether the operator changes the elements of the array it consumes.
ArrayChanges :: (operator: int) -> bool {
    return operator == facts.ArraySet || operator == facts.ArrayPush || operator == facts.ArrayExtend ||
           operator == facts.ArrayRemove || operator == facts.ArrayInsert || operator == facts.ArrayReverse ||
           operator == facts.ArrayReplace;
}
MappedArrayChange :: (value: int) -> bool {
    return value >= facts.MapArrayPush && value <= facts.MapArrayResize;
}
// The postfix operands of one map operator; -1 means no such operator.
MapOperands :: (operand: facts.Row) -> int {
    if (operand.value == facts.MapNew) {
        return operand.count;
    }
    if (operand.value == facts.MapLength || operand.value == facts.MapCopy || operand.value == facts.MapSpan) {
        return 1;
    }
    if (operand.value == facts.MapSet) {
        return 3;
    }
    if (MappedArrayChange(operand.value)) {
        if (operand.value == facts.MapArraySet) { return 4; }
        return 3;
    }
    if (operand.value >= facts.MapGet && operand.value <= facts.MapValueAt) {
        return 2;
    }
    return -1;
}
// Validate maps independently of array encoding and mutation rules. Each change
// must end an assignment of the map it first reads, so no descriptor aliases
// an allocation while another descriptor mutates it.
ValidMap :: (rows: facts.Row[], records: int[], at: int, row: int, last: int, operand: facts.Row, stack: int[],
             floor: int) -> string {
    consumed := MapOperands(operand);
    base := length(stack) - consumed;
    mismatch := "scalar map operation differs from its operands";
    changed := operand.value == facts.MapSet || operand.value == facts.MapDelete || MappedArrayChange(operand.value);
    mapped := operand.type;
    if (operand.value != facts.MapNew && operand.value != facts.MapCopy && !changed) {
        if (operand.literal < i64(facts.MapType) || operand.literal >= i64(facts.ReferenceType)) {
            return mismatch;
        }
        mapped = int(operand.literal);
    } else if (operand.literal != 0) {
        return mismatch;
    }
    if (operand.name != "" || consumed < 0 || operand.count != consumed || base < floor ||
        mapped < facts.MapType || !Valued(records, mapped)) {
        return mismatch;
    }
    key := (mapped - facts.MapType) % 16;
    value := (mapped - facts.MapType) / 16;
    if (operand.value == facts.MapNew) {
        if (consumed % 2 != 0) {
            return mismatch;
        }
        for (index in 0..<consumed) {
            wanted := key;
            if (index % 2 == 1) {
                wanted = value;
            }
            if (stack[base + index] != wanted) {
                return mismatch;
            }
        }
        return "";
    }
    input := mapped;
    if (changed) { input += facts.ReferenceType; }
    if (stack[base] != input) {
        return mismatch;
    }
    if ((operand.value == facts.MapLength || operand.value == facts.MapSpan) && operand.type != facts.IntType) {
        return mismatch;
    }
    if ((operand.value == facts.MapHas || operand.value == facts.MapLiveAt) && operand.type != facts.BoolType) {
        return mismatch;
    }
    if ((operand.value == facts.MapGet || operand.value == facts.MapValueAt) && operand.type != value) {
        return mismatch;
    }
    if (operand.value == facts.MapKeyAt && operand.type != key) {
        return mismatch;
    }
    if (consumed >= 2) {
        wanted := key;
        if (operand.value == facts.MapLiveAt || operand.value == facts.MapKeyAt || operand.value == facts.MapValueAt) {
            wanted = facts.IntType;
        }
        if (stack[base + 1] != wanted) {
            return mismatch;
        }
    }
    if (operand.value == facts.MapSet && stack[base + 2] != value) {
        return mismatch;
    }
    if (MappedArrayChange(operand.value)) {
        element := Element(records, value);
        wanted := facts.IntType;
        if (operand.value == facts.MapArrayPush) { wanted = element; }
        if (operand.value == facts.MapArrayExtend) { wanted = value; }
        if (element == 0 || stack[base + 2] != wanted ||
            (operand.value == facts.MapArraySet && stack[base + 3] != element)) { return mismatch; }
    }
    if (changed && (rows[at].kind != facts.AssignRow || base != 0 || row != last - 1 ||
                    rows[at + 1].kind != facts.RefRow || rows[at + 1].value != rows[at].value)) {
        return "scalar map change is not the assignment of its map";
    }
    return "";
}

// Whether the Array row at `row` of the operands of the statement at `at`,
// which end before `last`, reads operands of its types from `stack`, none
// below `floor`. A change of an array is the last operand of an Assign to the
// variable its first operand reads, or the second last, before the Update of
// the array's field of that variable's record.
ArrayPlaceMember :: (rows: facts.Row[], records: int[], operand: facts.Row) -> int {
    if (operand.literal == i64(facts.NestedArrayPlace)) { return NestedArrayMember(rows, records, operand.type); }
    if (operand.literal == i64(facts.OptionalArrayPlace)) { return OptionalPayloadType(rows, records, operand.type); }
    if (operand.literal != 0) { return MemberType(rows, records, operand.type, int(operand.literal) - 1); }
    return operand.type;
}
ValidArray :: (rows: facts.Row[], records: int[], at: int, row: int, last: int, operand: facts.Row, stack: int[],
               floor: int) -> string {
    consumed := ArrayOperands(operand);
    base := length(stack) - consumed;
    mismatch := "scalar array operation differs from its operands";
    if (operand.name != "" || (consumed == 0 && operand.value != facts.ArrayNew) || operand.count != consumed ||
        base < floor) {
        return mismatch;
    }
    operator := operand.value;
    placed := operand.literal != 0 || ((ArrayChanges(operator) || operator == facts.ArrayResize) &&
              stack[base] == facts.ReferenceType + operand.type);
    if (placed) {
        optional := operand.literal == i64(facts.OptionalArrayPlace);
        nested := operand.literal == i64(facts.NestedArrayPlace);
        if (operand.literal != 0 && !nested) {
            mismatch = format_text("{} at {}..{} (parent {}, field {}, operator {}): {}", mismatch,
                operand.start, operand.end, operand.type, operand.literal - 1, operator,
                strings.Slice(rows[0].text, operand.start, operand.end - operand.start));
            if (!optional && (operand.literal < 1 || operand.literal > i64(2147483647))) { return mismatch; }
        }
        field := ArrayPlaceMember(rows, records, operand);
        element := Element(records, field);
        assigned := rows[at].kind == facts.AssignRow && rows[at].type == operand.type &&
            rows[at + 1].kind == facts.RefRow && rows[at + 1].type == operand.type &&
            rows[at + 1].literal == 0 && rows[at + 1].value == rows[at].value;
        borrowed := operand.literal == 0 && operator == facts.ArrayPush && Scalar(element) &&
            rows[at].kind == facts.LocalRow && rows[at].literal == i64(facts.Captured) &&
            rows[at].type == operand.type && rows[at].count == 4 &&
            rows[at + 1].kind == facts.ReadRow && rows[at + 1].type == facts.PointerType &&
            rows[at + 2].kind == facts.ManagedRow && rows[at + 2].value == facts.ManagedBorrow &&
            rows[at + 2].type == facts.ReferenceType + operand.type &&
            rows[at + 3].kind == facts.ReadRow && rows[at + 3].type == element;
        if (optional && (operator != facts.ArraySet || !Scalar(element))) { return mismatch; }
        if ((!ArrayChanges(operator) && operator != facts.ArrayResize) || element == 0 ||
            stack[base] != facts.ReferenceType + operand.type || base != 0 || row != last - 1 ||
            (!assigned && !borrowed)) { return mismatch; }
        argument := base + 1;
        if (nested) {
            if (stack[argument] != facts.IntType) { return mismatch; }
            argument += 1;
        }
        if (operator == facts.ArrayReverse) { return ""; }
        wanted := facts.IntType;
        if (operator == facts.ArrayPush) { wanted = element; }
        if (operator == facts.ArrayExtend) { wanted = field; }
        if (stack[argument] != wanted ||
            ((operator == facts.ArraySet || operator == facts.ArrayInsert || operator == facts.ArrayReplace) && stack[argument + 1] != element)) { return mismatch; }
        return "";
    }
    if (operator == facts.ArrayLength) {
        if (operand.type != facts.IntType || Element(records, stack[base]) == 0) {
            return mismatch;
        }
        return "";
    }
    if (operator == facts.ArrayPlaceCheck) {
        if (operand.type != facts.BoolType || Element(records, stack[base]) == 0 || stack[base + 1] != facts.IntType) { return mismatch; }
        return "";
    }
    if (operator == facts.ArrayGet || operator == facts.ArrayPlaceGet) {
        if (operand.type >= facts.ArrayType || Element(records, stack[base]) != operand.type ||
            stack[base + 1] != facts.IntType) {
            return mismatch;
        }
        return "";
    }
    if (operator == facts.ArrayContains) {
        searched := Element(records, stack[base]);
        if (operand.type != facts.BoolType || searched == 0 || searched >= facts.RecordType ||
            stack[base + 1] != searched) {
            return mismatch;
        }
        return "";
    }
    if (operator == facts.ArrayText) {
        if (operand.type != facts.StringType || Element(records, stack[base]) != facts.ByteType) {
            return mismatch;
        }
        return "";
    }
    element := Element(records, operand.type);
    if (element == 0) {
        return mismatch;
    }
    if (operator == facts.ArrayBytes) {
        if (element != facts.IntType || stack[base] != facts.StringType) {
            return mismatch;
        }
        return "";
    }
    if (operator == facts.ArrayLoan) {
        if (!Scalar(element) || element == facts.BoolType ||
            (stack[base] != operand.type && stack[base] != facts.ReferenceType + operand.type)) { return mismatch; }
        return "";
    }
    if (operator == facts.ArrayNew) {
        for (index in 0..<consumed) {
            if (stack[base + index] != element) {
                return mismatch;
            }
        }
        return "";
    }
    if (stack[base] != operand.type) {
        return mismatch;
    }
    // What follows the array: nothing, an int, an element, another array, or
    // two ints.
    if (operator == facts.ArraySlice) {
        if (stack[base + 1] != facts.IntType || stack[base + 2] != facts.IntType) {
            return mismatch;
        }
    } else if (operator == facts.ArraySet || operator == facts.ArrayInsert || operator == facts.ArrayInserted ||
               operator == facts.ArrayReplace || operator == facts.ArrayReplaced) {
        if (stack[base + 1] != facts.IntType || stack[base + 2] != element) {
            return mismatch;
        }
    } else if (operator == facts.ArrayPush || operator == facts.ArrayWith || operator == facts.ArrayWithoutItem) {
        if (stack[base + 1] != element ||
            (operator == facts.ArrayWithoutItem && !Retainable(rows, records, element))) {
            return mismatch;
        }
    } else if (operator == facts.ArrayExtend || operator == facts.ArrayJoin) {
        if (stack[base + 1] != operand.type) {
            return mismatch;
        }
    } else if (operator == facts.ArrayResize || operator == facts.ArrayRemove || operator == facts.ArrayWithout) {
        if (stack[base + 1] != facts.IntType) {
            return mismatch;
        }
    }
    if (!ArrayChanges(operator)) {
        return "";
    }
    first := rows[at + 1];
    if (rows[at].kind != facts.AssignRow || first.kind != facts.ReadRow || first.value != rows[at].value) {
        return "scalar array change is not the assignment of its array";
    }
    if (base == 0 && row == last - 1) {
        return "";
    }
    // An array field of the variable's record: the record's read, a second read
    // and the field, then the change, and the record's Update of that field.
    if (base == 1 && row == last - 2 && rows[at + 2].kind == facts.ReadRow && rows[at + 2].value == first.value &&
        rows[at + 3].kind == facts.FieldRow && rows[row + 1].kind == facts.UpdateRow &&
        rows[row + 1].value == rows[at + 3].value) {
        return "";
    }
    return "scalar array change is not the assignment of its array";
}
// The operands after the statement row at `at`, as a typed evaluation stack:
// each operand pushes one value; a comparison or binary arithmetic pops two
// values of one type, unary arithmetic and a conversion one, and a call its
// arguments in order. A logical pops its left bool, and its right rows must
// push exactly one bool above what lies under it, which is its value, without
// consuming anything below. A read names a `visible` variable of its type.
// They must leave one value of type `result`, and each lies within `scope`.
ValidOperands :: (rows: facts.Row[], records: int[], heads: int[], at: int, result: int, scope: facts.Row,
                  variables: int[], visible: int[], bindings: int[], starts: int[], size: int) -> string {
    stack: int[] = [];
    first := at + 1;
    last := first + rows[at].count;
    // Each open logical's first row after its right operands, and the stack
    // height it leaves its value at.
    ends: int[] = [];
    depths: int[] = [];
    results: int[] = [];
    for (row in first..<last + 1) {
        while (length(ends) > 0 && ends[length(ends) - 1] == row) {
            depth := depths[length(depths) - 1];
            if (length(stack) != depth + 1 || stack[depth] != results[length(results) - 1]) {
                if (results[length(results) - 1] == facts.BoolType) { return "scalar logic differs from its bool operands"; }
                return "scalar coalescing RHS differs from its result";
            }
            ends = slice(ends, 0, length(ends) - 1);
            depths = slice(depths, 0, length(depths) - 1);
            results = slice(results, 0, length(results) - 1);
        }
        if (row == last) {
            break;
        }
        floor: int = 0;
        if (length(depths) > 0) {
            floor = depths[length(depths) - 1];
        }
        operand := rows[row];
        if (operand.kind == facts.OperandSwapRow) {
            if (operand.type != 0 || operand.literal != 0 || operand.name != "" || operand.text != "" ||
                !Located(operand, starts, size) || !Within(operand, scope) || operand.value < 0 ||
                operand.count <= operand.value || operand.count >= length(stack) - floor) {
                return "scalar operand exchange differs from its evaluation stack";
            }
            left := length(stack) - 1 - operand.value;
            right := length(stack) - 1 - operand.count;
            held := stack[left];
            stack[left] = stack[right];
            stack[right] = held;
            continue;
        }
        // Only a string literal has text, and a foreign call the library it links.
        // A reference's literal selects a record field; its type and index are checked below.
        texted := (operand.kind == facts.LiteralRow && operand.type == facts.StringType) ||
                  operand.kind == facts.ForeignRow;
        managed_borrow := operand.kind == facts.ManagedRow && operand.value == facts.ManagedBorrow &&
                          operand.type >= facts.ReferenceType && ManagedValue(rows, records, operand.type - facts.ReferenceType, operand.literal);
        if ((!texted && operand.text != "") || (!Valued(records, operand.type) && !managed_borrow) || !Located(operand, starts, size) ||
            !Within(operand, scope) ||
            (operand.kind != facts.LiteralRow && operand.kind != facts.RefRow && operand.kind != facts.MapRow && operand.kind != facts.ArrayRow && operand.kind != facts.CallRow && operand.kind != facts.AwaitResultRow && operand.kind != facts.ForeignRow && operand.kind != facts.ManagedRow && operand.kind != facts.ManagedAddressRow && operand.kind != facts.ManagedFieldRow && operand.kind != facts.TextRow && operand.kind != facts.ViewRow && operand.literal != 0) ||
            (operand.kind == facts.CallRow && (operand.literal < 0 || operand.literal > i64(facts.CallSpawned)))) {
            return "invalid scalar operand row";
        }
        if (operand.kind == facts.LiteralRow) {
            if (operand.name != "" || operand.count != 0 || operand.value != 0 ||
                !facts.Fits(operand.literal, operand.type)) {
                return "noncanonical scalar literal";
            }
        } else if (operand.kind == facts.ViewRow) {
            base := length(stack) - ViewOperands(operand);
            if (base < floor || !ValidView(rows, records, operand, stack, base)) {
                return "view operation differs from its typed operands";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.ManagedAddressRow) {
            if (operand.name != "" || operand.type != facts.PointerType || operand.literal == 0 ||
                !Holds(visible, operand.value) || !ManagedValue(rows, records, variables[operand.value], operand.literal) ||
                (Scalar(variables[operand.value]) && operand.count != 0) ||
                (!Scalar(variables[operand.value]) && operand.count != variables[operand.value])) {
                return "managed address differs from its scalar variable";
            }
        } else if (operand.kind == facts.ManagedFieldRow) {
            field := MemberType(rows, records, operand.type, operand.value);
            if (operand.name != "" || operand.count != 1 || operand.literal == 0 || field == 0 ||
                rows[records[operand.type - facts.RecordType]].literal == 0 ||
                rows[records[operand.type - facts.RecordType] + 1 + operand.value].literal != operand.literal ||
                length(stack) <= floor || stack[length(stack) - 1] != facts.PointerType) {
                return "managed projection differs from its typed record field";
            }
            stack = slice(stack, 0, length(stack) - 1);
        } else if (operand.kind == facts.ManagedRow) {
            count := 1;
            if (operand.value == facts.ManagedWrite) { count = 2; }
            base := length(stack) - count;
            target := operand.type;
            if (managed_borrow) { target -= facts.ReferenceType; }
            if (operand.name != "" || operand.count != count || !ManagedValue(rows, records, target, operand.literal) ||
                (operand.value != facts.ManagedRead && operand.value != facts.ManagedWrite && !managed_borrow) ||
                base < floor || stack[base] != facts.PointerType ||
                (count == 2 && stack[base + 1] != target)) {
                return "managed access differs from its scalar pointer target";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.ReadRow) {
            if (operand.name != "" || operand.count != 0 || !Holds(visible, operand.value) ||
                variables[operand.value] != operand.type) {
                return "scalar read differs from its variable";
            }
        } else if (operand.kind == facts.OperandBindRow) {
            base := length(stack) - 1;
            if (operand.name != "" || operand.count != 1 || base < floor || !Holds(visible, operand.value) ||
                SortedIndex(bindings, operand.value) < 0 || variables[operand.value] != operand.type ||
                operand.type == facts.TaskType || operand.type == facts.PointerType || operand.type >= facts.MapType ||
                stack[base] != operand.type) {
                return "scalar pattern binding differs from its local";
            }
            stack = slice(stack, 0, base);
            continue;
        } else if (operand.kind == facts.RefRow) {
            // A literal of 1 + n makes it a reference to field n of the record variable, a number or a bool.
            field := -1;
            if (operand.literal != 0 && Holds(visible, operand.value)) {
                field = RecordMemberType(rows, records, variables[operand.value], operand.literal - 1);
            }
            if (operand.name != "" || operand.count != 0 || operand.type == facts.TaskType || !Holds(visible, operand.value) ||
                (operand.literal == 0 && variables[operand.value] != operand.type) ||
                (operand.literal != 0 && (field < 0 || field != operand.type ||
                 (!Number(field) && field != facts.BoolType &&
                  !(Element(records, field) > 0 && Scalar(Element(records, field)) && Element(records, field) != facts.BoolType))))) {
                return "scalar reference differs from its variable";
            }
            stack.append(facts.ReferenceType + operand.type);
            continue;
        } else if (operand.kind == facts.FieldReferenceRow) {
            base := length(stack) - 1;
            parent := 0;
            if (base >= floor && stack[base] >= facts.ReferenceType) { parent = stack[base] - facts.ReferenceType; }
            field := operand.type;
            if (operand.name != "" || operand.count != 1 || base < floor ||
                (!Scalar(field) && field != facts.StringType && Element(records, field) == 0 &&
                 !(field >= facts.RecordType && field < facts.ArrayType && field - facts.RecordType < length(records))) ||
                RecordMemberType(rows, records, parent, i64(operand.value)) != field) {
                return "scalar field reference differs from its record";
            }
            stack = slice(stack, 0, base);
            stack.append(facts.ReferenceType + operand.type);
            continue;
        } else if (operand.kind == facts.LogicalRow) {
            base := length(stack) - 1;
            if (operand.count < 1 || operand.count > last - row - 1) {
                return "scalar logic differs from its bool operands";
            }
            end := row + operand.count + 1;
            if (operand.name != "" || (length(ends) > 0 && end > ends[length(ends) - 1]) || base < floor) {
                return "scalar logic differs from its bool operands";
            }
            if (operand.value == facts.LogicalCoalesce) {
                if ((!Number(operand.type) && operand.type != facts.BoolType) ||
                    OptionalPayloadType(rows, records, stack[base]) != operand.type) {
                    return "scalar coalescing differs from its optional payload";
                }
            } else if (operand.type != facts.BoolType || stack[base] != facts.BoolType ||
                       (operand.value != facts.LogicalAnd && operand.value != facts.LogicalOr)) {
                return "scalar logic differs from its bool operands";
            }
            stack = slice(stack, 0, base);
            ends.append(end);
            depths.append(base);
            results.append(operand.type);
            continue;
        } else if (operand.kind == facts.CompareRow) {
            base := length(stack) - 2;
            if (operand.name != "" || operand.count != 2 || operand.type != facts.BoolType ||
                operand.value < facts.Less || operand.value > facts.NotEqual || base < floor ||
                (!Number(stack[base]) &&
                 ((stack[base] != facts.BoolType && stack[base] != facts.StringType && stack[base] != facts.PointerType) ||
                  operand.value < facts.Equal)) ||
                stack[base + 1] != stack[base]) {
                return "scalar comparison differs from its operands";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.ArithmeticRow) {
            base := length(stack) - 2;
            if (operand.name != "" || operand.count != 2 || !Computes(operand.value, operand.type) || base < floor ||
                stack[base] != operand.type || stack[base + 1] != operand.type) {
                return "scalar arithmetic differs from its number operands";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.UnaryRow) {
            base := length(stack) - 1;
            negates := (Integer(operand.type) && (operand.value == facts.Negate || operand.value == facts.Complement)) ||
                       (facts.Floating(operand.type) && operand.value == facts.Negate);
            nots := operand.type == facts.BoolType && operand.value == facts.Not;
            roots := operand.type == facts.FloatType && operand.value == facts.SquareRoot;
            if (operand.name != "" || operand.count != 1 || (!negates && !nots && !roots) || base < floor ||
                stack[base] != operand.type) {
                return "scalar arithmetic differs from its number operands";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.SelectRow) {
            base := length(stack) - 3;
            if (operand.name != "" || operand.value != 0 || operand.count != 3 || !Scalar(operand.type) ||
                base < floor || stack[base] != facts.BoolType || stack[base + 1] != operand.type ||
                stack[base + 2] != operand.type) {
                return "scalar selection differs from its condition or values";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.ConvertRow) {
            base := length(stack) - 1;
            checked_char := operand.value == facts.CheckedChar;
            if (operand.name != "" || operand.count != 1 ||
                (operand.value != facts.Clamp && operand.value != facts.Wrap && !checked_char) || base < floor ||
                (checked_char && (operand.type != facts.IntType || !Integer(stack[base]))) ||
                (!checked_char && !Converts(stack[base], operand.type))) {
                return "scalar conversion is not one the runtime implements";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.FunctionAddressRow) {
            if (operand.value < 0 || operand.value >= length(heads)) {
                return "scalar function address names no function of the module";
            }
            taken := rows[heads[operand.value]];
            if (operand.name != taken.name || operand.count != 0 || operand.type != facts.WordType || !Scalar(taken.type)) {
                return "scalar function address differs from its function";
            }
            for (argument in 0..<taken.count) {
                parameter := rows[heads[operand.value] + 1 + argument];
                if (!Scalar(parameter.type) || facts.ReferenceParameter(parameter.literal)) {
                    return "scalar function address needs a function of numbers and bools";
                }
            }
        } else if (operand.kind == facts.YieldRow) {
            if (operand.name != "" || operand.count != 0 || operand.value != 0 || operand.type != facts.IntType) {
                return "scalar yield differs from its operands";
            }
        } else if (operand.kind == facts.CancelAfterRow || operand.kind == facts.DelayRow) {
            count: int = 1;
            if (operand.kind == facts.CancelAfterRow) { count = 2; }
            base := length(stack) - count;
            if (operand.name != "" || operand.count != count || operand.value != 0 || base < floor ||
                stack[base + count - 1] != facts.DoubleType || operand.type != facts.IntType) {
                return "scalar timed task operation differs from its operands";
            }
            if (count == 2 && stack[base] != facts.TaskType) {
                return "scalar timed cancellation needs a task handle";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.AwaitRow || operand.kind == facts.CancelRow) {
            base := length(stack) - 1;
            if (operand.name != "" || operand.count != 1 || operand.value != 0 || base < floor ||
                stack[base] != facts.TaskType || operand.type != facts.IntType) {
                return "scalar task operation differs from its operands";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.TaskRunningRow) {
            base := length(stack) - 1;
            if (operand.name != "" || operand.count != 1 || operand.value != 0 || base < floor ||
                stack[base] != facts.TaskType || operand.type != facts.BoolType) {
                return "scalar running test needs a task observer";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.AwaitResultRow) {
            base := length(stack) - 1;
            if (operand.name != "" || operand.count != 1 || base < floor || stack[base] != facts.TaskType ||
                operand.value < 0 || operand.value >= length(heads) || operand.literal < 0 || operand.literal > 1 ||
                UnionHead(rows, records, operand.type) < 0) {
                return "scalar task result differs from its task and union";
            }
            callee := rows[heads[operand.value]];
            union_at := UnionHead(rows, records, operand.type);
            success := VariantOf(rows, union_at, int(operand.literal));
            cancelled := VariantOf(rows, union_at, 1 - int(operand.literal));
            wanted := 1;
            if (callee.value == facts.FunctionVoid) { wanted = 0; }
            if (rows[union_at].count != 2 || success < 0 || cancelled < 0 || rows[success].count != wanted ||
                rows[cancelled].count != 0 || (wanted == 1 && PayloadType(rows, records, operand.type, 0) != callee.type)) {
                return "scalar task result success type differs from its waiting function";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.CallRow) {
            if (operand.value < 0 || operand.value >= length(heads)) {
                return "scalar call names no function of the module";
            }
            callee := rows[heads[operand.value]];
            base := length(stack) - operand.count;
            wanted_type := callee.type;
            if (operand.literal == i64(facts.CallSpawned)) {
                wanted_type = facts.TaskType;
            }
            if (operand.name != callee.name || operand.type != wanted_type || operand.count != callee.count ||
                base < floor) {
                return "scalar call differs from its callee's signature";
            }
            for (argument in 0..<operand.count) {
                parameter := rows[heads[operand.value] + 1 + argument];
                wanted := parameter.type;
                if (facts.ReferenceParameter(parameter.literal)) {
                    wanted += facts.ReferenceType;
                }
                if (stack[base + argument] != wanted) {
                    return "scalar call argument differs from its parameter";
                }
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.ForeignRow) {
            base := length(stack) - operand.count;
            indirect := operand.value == 1;
            if ((operand.literal != 0 && (operand.literal != i64(facts.ForeignReversed) || indirect || operand.count != 2)) ||
                (operand.value != 0 && !indirect) || (indirect && (operand.name != "" || operand.text != "" || operand.count < 1)) ||
                (!indirect && operand.name == "") || !Scalar(operand.type) ||
                operand.count < 0 || base < floor) {
                return "scalar foreign call differs from its operands";
            }
            if (indirect && stack[base] != facts.WordType) {
                return "scalar foreign call through an address needs a word";
            }
            for (argument in 0..<operand.count) {
                given := stack[base + argument];
                if (!Scalar(given) && given != facts.StringType &&
                    !(given >= facts.ArrayType && Scalar(Element(records, given)) && Element(records, given) != facts.BoolType)) {
                    return "scalar foreign call takes numbers, bools, strings and arrays of numbers";
                }
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.ClockSampleRow) {
            if (operand.name != "" || operand.value != 0 || operand.count != 0 || !ClockSampleType(rows, records, operand.type)) {
                return "scalar clock sample differs from its four-field transport record";
            }
        } else if (operand.kind == facts.ZeroRow) {
            captured_union := rows[at].kind == facts.LocalRow && rows[at].literal == i64(facts.PatternStorage) &&
                              rows[at].count == 1 && UnionHead(rows, records, operand.type) >= 0;
            if (operand.name != "" || operand.count != 0 || operand.value != 0 ||
                (MemberType(rows, records, operand.type, 0) == 0 && !captured_union)) {
                return "scalar record zero names no record";
            }
        } else if (operand.kind == facts.FieldRow) {
            base := length(stack) - 1;
            if (operand.name != "" || operand.count != 1 || base < floor ||
                MemberType(rows, records, stack[base], operand.value) != operand.type) {
                return "scalar field read differs from its record";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.UpdateRow) {
            base := length(stack) - 2;
            field := MemberType(rows, records, operand.type, operand.value);
            if (operand.name != "" || operand.count != 2 || field == 0 || base < floor ||
                stack[base] != operand.type || stack[base + 1] != field) {
                return "scalar field write differs from its record";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.MakeRow) {
            head := UnionHead(rows, records, operand.type);
            variant: int = -1;
            if (head >= 0) {
                variant = VariantOf(rows, head, operand.value);
            }
            base := length(stack) - operand.count;
            if (operand.name != "" || variant < 0 || operand.count != rows[variant].count || base < floor) {
                return "scalar variant differs from its union";
            }
            for (field in 0..<operand.count) {
                if (stack[base + field] != rows[variant + 1 + field].type) {
                    return "scalar variant differs from its union";
                }
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.TagRow) {
            base := length(stack) - 1;
            if (operand.name != "" || operand.count != 1 || operand.value != 0 || operand.type != facts.IntType ||
                base < floor || UnionHead(rows, records, stack[base]) < 0) {
                return "scalar tag reads no union";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.PayloadRow) {
            base := length(stack) - 1;
            if (operand.name != "" || operand.count != 1 || base < floor ||
                PayloadType(rows, records, stack[base], operand.value) != operand.type) {
                return "scalar payload read differs from its union";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.UnwrapRow) {
            base := length(stack) - 1;
            if (operand.name != "" || operand.count != 1 || operand.value != 0 || base < floor) {
                return "scalar force unwrap differs from its optional";
            }
            if (OptionalPayloadType(rows, records, stack[base]) != operand.type) {
                return "scalar force unwrap differs from its optional";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.OptionalFieldRow) {
            base := length(stack) - 1;
            if (operand.name != "" || operand.count != 1 || base < floor) {
                return "scalar optional field differs from its record";
            }
            field := RecordMemberType(rows, records, OptionalPayloadType(rows, records, stack[base]), i64(operand.value));
            if ((!Number(field) && field != facts.BoolType) || OptionalPayloadType(rows, records, operand.type) != field) {
                return "scalar optional field differs from its record";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.MapRow) {
            error := ValidMap(rows, records, at, row, last, operand, stack, floor);
            if (error != "") {
                return error;
            }
            stack = slice(stack, 0, length(stack) - MapOperands(operand));
        } else if (operand.kind == facts.ArrayRow) {
            error := ValidArray(rows, records, at, row, last, operand, stack, floor);
            if (error != "") {
                return error;
            }
            stack = slice(stack, 0, length(stack) - ArrayOperands(operand));
        } else if (operand.kind == facts.TextRow) {
            formats := operand.value == facts.TextFormat;
            consumed := TextOperands(operand.value);
            output := facts.IntType;
            if (operand.value == facts.TextSlice || formats) {
                output = facts.StringType;
            }
            if (formats && operand.count >= 1) {
                consumed = operand.count;
            }
            orders := 1;
            if (!formats && consumed == 2) { orders = 2; }
            if (!formats && consumed == 3) { orders = 6; }
            if (operand.literal < 0 || operand.literal >= i64(orders)) {
                return "scalar text read differs from its operands";
            }
            base := length(stack) - consumed;
            if (operand.name != "" || consumed == 0 || operand.count != consumed || operand.type != output ||
                base < floor || stack[base + facts.TextArgument(consumed, int(operand.literal), 0)] != facts.StringType) {
                return "scalar text read differs from its operands";
            }
            // Collection arguments contribute only their by-value counts.
            // The other text natives still take ints after their string.
            for (parameter in 1..<consumed) {
                index := facts.TextArgument(consumed, int(operand.literal), parameter);
                given := stack[base + index];
                collection := Element(records, given) > 0 ||
                              (given >= facts.MapType && given < facts.ReferenceType && Valued(records, given));
                if ((formats && (given < facts.IntType || given > facts.StringType) && !collection) ||
                    (!formats && given != facts.IntType)) {
                    return "scalar text read differs from its operands";
                }
            }
            stack = slice(stack, 0, base);
        } else {
            return "invalid scalar operand row";
        }
        produced := operand.type;
        if (operand.kind == facts.ManagedFieldRow) { produced = facts.PointerType; }
        stack.append(produced);
    }
    // A range's two bounds, or one value.
    wanted: int = 1;
    if (rows[at].kind == facts.ForRow && !Arrayed(rows[at]) && !MapIterated(rows[at])) {
        wanted = 2;
    }
    if (length(stack) != wanted || stack[0] != result || stack[wanted - 1] != result) {
        if (rows[at].kind == facts.ForRow) {
            return "scalar range differs from its int bounds";
        }
        if (rows[at].kind == facts.IfRow || rows[at].kind == facts.WhileRow || rows[at].kind == facts.AssertRow) {
            return "scalar condition is not one bool";
        }
        if (rows[at].kind == facts.SwitchRow) {
            return "scalar switch value is not one integer";
        }
        if (rows[at].kind == facts.CaseRow) {
            return "scalar case value differs from its switch value";
        }
        if (rows[at].kind == facts.ReturnRow) {
            return "scalar return differs from its function's result";
        }
        return "scalar value differs from its variable";
    }
    return "";
}
// The least start of what follows the row at `at`: a consequence, an arm's
// or a loop's body follows the row's start and every one of its operands.
Operated :: (rows: facts.Row[], at: int) -> int {
    earliest := rows[at].start;
    for (operand in at + 1..<at + rows[at].count + 1) {
        if (rows[operand].end > earliest) {
            earliest = rows[operand].end;
        }
    }
    return earliest;
}
// One function's signature and statements. Each statement lies within the
// statements it is among, after the one before it; an if statement's
// consequence or a loop's body follows its condition or bounds, an else
// follows its consequence, a switch's arms follow its value and one another,
// each its value's type and at most one the default, and an End has its if
// statement's, switch's or loop's range. A variable is visible from its declaration to the end of the
// statements it is declared among, a For row's only in its body, and the
// body ends in a terminating statement.
ValidFunction :: (rows: facts.Row[], records: int[], heads: int[], function: int, starts: int[], size: int,
                  is_library: bool, identified: bool) -> string {
    head := heads[function];
    declaration := rows[head];
    boxes := ManagedVariables(rows, head, Last(rows, heads, function));
    if (boxes.error != "") { return boxes.error; }
    if (declaration.name == "" || declaration.text != "" || !Valued(records, declaration.type) ||
        (declaration.value != 0 && (declaration.value != facts.FunctionVoid || declaration.type != facts.IntType)) ||
        (declaration.literal != 0) != identified || !Located(declaration, starts, size)) {
        return "invalid scalar function row";
    }
    variables: int[] = [];
    visible: int[] = [];
    bindings: int[] = [];
    for (index in 0..<declaration.count) {
        param := rows[head + 1 + index];
        if (param.type == facts.TaskType) { return "scalar task parameters require cancellation unwind support"; }
        reference := facts.ReferenceParameter(param.literal);
        if (reference && ManagedVariable(boxes.boxed, index)) {
            return "a borrowed reference cannot be promoted to an escaping managed cell";
        }
        if (param.kind != facts.ParameterRow || param.name == "" || param.text != "" || !Valued(records, param.type) ||
            param.value != index || param.count != 0 ||
            (param.literal != i64(facts.ParameterValue) && param.literal != i64(facts.ParameterOwnedArray) && !reference) ||
            (reference && (identified || function == 0)) ||
            (param.literal == i64(facts.ParameterOwnedArray) && !ArrayTyped(NativeType(param.type))) ||
            !Located(param, starts, size) ||
            !Within(param, declaration)) {
            return "invalid scalar parameter row";
        }
        variables.append(param.type);
        visible.append(index);
    }
    // Each open if statement's, switch's or loop's row; an if statement's
    // Else row or a switch's current Case row, or -1; whether an if
    // statement's consequence ends, or whether each arm of a switch before its
    // current one does; whether a switch has a default arm; whether a Break
    // leaves a loop; and how many variables were visible before it. A For
    // row's variable is never assigned.
    opens: int[] = [];
    alternatives: int[] = [];
    consequences: bool[] = [];
    defaults: bool[] = [];
    broken: bool[] = [];
    marks: int[] = [];
    fixed: int[] = [];
    // Whether the last statement of the statements being read terminates,
    // and the least start of the next statement.
    ends := false;
    earliest := declaration.start;
    at := head + declaration.count + 1;
    last := Last(rows, heads, function);
    while (at < last) {
        row := rows[at];
        top := length(opens) - 1;
        container := declaration;
        if (top >= 0) {
            container = rows[opens[top]];
            if (alternatives[top] >= 0) {
                container = rows[alternatives[top]];
            }
        }
        ranged := row.kind == facts.ForRow;
        arrayed := Arrayed(row);
        mapped := MapIterated(row);
        // A local holding the union a switch is on, followed by that switch.
        subject := row.kind == facts.LocalRow && row.literal == i64(facts.SwitchSubject);
        captured := row.kind == facts.LocalRow && row.literal == i64(facts.Captured);
        retained := row.kind == facts.LocalRow &&
                    (row.literal == i64(facts.Retained) || row.literal == i64(facts.Retained | facts.CharNominal));
        if (retained && ManagedVariable(boxes.boxed, row.value)) {
            return "native retained managed cells require execution-family roots and generation pinning";
        }
        if (retained && row.literal == i64(facts.Retained | facts.CharNominal) && row.type != facts.IntType) {
            return "invalid scalar statement row";
        }
        if (retained && row.literal == i64(facts.Retained | facts.CharNominal) && row.count == 1 &&
            at + 1 < length(rows) && rows[at + 1].kind == facts.LiteralRow &&
            (rows[at + 1].literal < 0 || rows[at + 1].literal > 1114111 ||
             (rows[at + 1].literal >= 55296 && rows[at + 1].literal <= 57343))) {
            return "native character state initial value is not a Unicode scalar";
        }
        if (retained && identified && (!Scalar(row.type) || row.count != 1 || rows[at + 1].kind != facts.LiteralRow)) {
            return "native library retained states require scalar literal initializers; use a package generation for other retained values";
        }
        if (retained && row.type >= facts.RecordType && !Retainable(rows, records, row.type)) {
            return "native retained values require owned scalars, strings, records, unions or arrays";
        }
        if (retained && !RetainedInitializer(rows, at)) {
            return "native retained initializers require constant values and empty arrays";
        }
        pattern_loop := row.kind == facts.WhileRow && row.literal == i64(facts.PatternLoop);
        if (pattern_loop) {
            if (top < 0 || rows[opens[top]].kind != facts.ScopeRow) { return "invalid scalar pattern loop"; }
            prefix := Following(rows, opens[top]);
            if (prefix == at) { return "invalid scalar pattern loop"; }
            while (prefix < at) {
                if (rows[prefix].kind != facts.LocalRow || rows[prefix].literal != i64(facts.PatternStorage)) {
                    return "invalid scalar pattern loop";
                }
                prefix = Following(rows, prefix);
            }
        }
        pattern_storage := row.kind == facts.LocalRow && row.literal == i64(facts.PatternStorage);
        if (pattern_storage && (top < 0 || rows[opens[top]].kind != facts.ScopeRow ||
            row.type == facts.TaskType || row.type == facts.PointerType || row.type >= facts.MapType)) {
            return "invalid scalar pattern storage";
        }
        declares := row.kind == facts.LocalRow || ranged;
        typed := declares || row.kind == facts.AssignRow || row.kind == facts.SwitchRow || row.kind == facts.CaseRow;
        if ((row.text != "" && row.kind != facts.AssertRow) || (row.literal != 0 && !ranged && !subject && !retained && !captured && !pattern_storage && !pattern_loop) || !Located(row, starts, size) ||
            (row.kind != facts.EndRow && row.start < earliest) || (!declares && row.name != "") ||
            (!typed && row.type != 0) || (!declares && row.kind != facts.AssignRow && row.value != 0)) {
            return "invalid scalar statement row";
        }
        if (row.kind == facts.EndRow) {
            opened := rows[opens[top]];
            if (row.start != opened.start || row.end != opened.end || row.line != opened.line ||
                row.column != opened.column) {
                return "invalid scalar statement row";
            }
            if (opened.kind == facts.IfRow) {
                ends = alternatives[top] >= 0 && consequences[top] && ends;
            } else if (opened.kind == facts.SwitchRow) {
                ends = defaults[top] && consequences[top] && ends;
            } else if (opened.kind != facts.ScopeRow) {
                // Only a while loop on the literal true that nothing breaks
                // out of ends.
                condition := rows[opens[top] + 1];
                ends = opened.kind == facts.WhileRow && opened.count == 1 && condition.kind == facts.LiteralRow &&
                       condition.literal == 1 && !broken[top];
            }
            visible = slice(visible, 0, marks[top]);
            opens = slice(opens, 0, top);
            alternatives = slice(alternatives, 0, top);
            consequences = slice(consequences, 0, top);
            defaults = slice(defaults, 0, top);
            broken = slice(broken, 0, top);
            marks = slice(marks, 0, top);
            earliest = row.end;
            at += 1;
            continue;
        }
        if (row.kind == facts.CaseRow) {
            // An arm lies within its switch, after the arm before it, and
            // its value is of the switch's type.
            opened := rows[opens[top]];
            if (!Within(row, opened) || row.type != opened.type || (row.count == 0 && defaults[top])) {
                return "invalid scalar statement row";
            }
            consequences[top] = consequences[top] && (alternatives[top] < 0 || ends);
            defaults[top] = defaults[top] || row.count == 0;
            alternatives[top] = at;
            visible = slice(visible, 0, marks[top]);
            if (row.count != 0) {
                error := ValidOperands(rows, records, heads, at, row.type, row, variables, visible, bindings, starts, size);
                if (error != "") {
                    return error;
                }
            }
            ends = false;
            earliest = Operated(rows, at);
            at += row.count + 1;
            continue;
        }
        if (!Within(row, container)) {
            return "invalid scalar statement row";
        }
        if (row.kind == facts.ElseRow) {
            alternatives[top] = at;
            consequences[top] = ends;
            visible = slice(visible, 0, marks[top]);
            ends = false;
            earliest = row.start;
            at += 1;
            continue;
        }
        if (row.kind == facts.BreakRow || row.kind == facts.ContinueRow) {
            loop := top;
            while (!Loop(rows[opens[loop]].kind)) {
                loop -= 1;
            }
            if (row.kind == facts.BreakRow) {
                broken[loop] = true;
            }
            ends = false;
            earliest = row.end;
            at += 1;
            continue;
        }
        if (row.kind == facts.ScopeRow) {
            if (row.count != 0) { return "invalid scalar scope row"; }
            opens.append(at);
            alternatives.append(-1);
            consequences.append(false);
            defaults.append(false);
            broken.append(false);
            marks.append(length(visible));
            earliest = row.start;
            at += 1;
            continue;
        }
        result := declaration.type;
        if (row.kind == facts.IfRow || row.kind == facts.WhileRow || row.kind == facts.AssertRow) {
            result = facts.BoolType;
        } else if (row.kind == facts.SwitchRow) {
            if (facts.Bits(row.type) == 0) {
                return "scalar switch value is not one integer";
            }
            result = row.type;
        } else if (declares) {
            if (row.name == "" || !Valued(records, row.type) || row.value != length(variables) ||
                (ranged && !arrayed && !mapped && (row.type != facts.IntType || row.literal < 0 ||
                                        row.literal > i64(facts.RangeExclusive + facts.RangeReverse))) ||
                (arrayed && (row.type >= facts.ArrayType || !Valued(records, facts.ArrayType + row.type))) ||
                (mapped && row.type < facts.MapType) ||
                (retained && !Retainable(rows, records, row.type)) ||
                (subject && (UnionHead(rows, records, row.type) < 0 || at + row.count + 1 >= last ||
                             rows[at + row.count + 1].kind != facts.SwitchRow ||
                             rows[at + row.count + 1].start != row.start || rows[at + row.count + 1].end != row.end))) {
                return "invalid scalar local row";
            }
            result = row.type;
            if (arrayed) {
                result = facts.ArrayType + row.type;
            }
        } else if (row.kind == facts.AssignRow) {
            if (!Holds(visible, row.value) || Holds(fixed, row.value) || variables[row.value] != row.type) {
                return "scalar assignment differs from its variable";
            }
            result = row.type;
        }
        error := ValidOperands(rows, records, heads, at, result, row, variables, visible, bindings, starts, size);
        if (error != "") {
            return error;
        }
        ends = row.kind == facts.ReturnRow;
        earliest = row.end;
        // A switch's subject local shares its range with the switch, and the
        // copies of written array parameters share the one byte that opens the
        // body: no statement starts there but the next copy.
        if (subject || captured || (row.kind == facts.LocalRow && row.end - row.start == 1)) {
            earliest = row.start;
        }
        if (row.kind == facts.LocalRow) {
            variables.append(row.type);
            visible.append(row.value);
            if (pattern_storage) { bindings.append(row.value); }
        } else if (Opens(row.kind)) {
            opens.append(at);
            alternatives.append(-1);
            consequences.append(row.kind == facts.SwitchRow);
            defaults.append(false);
            broken.append(false);
            marks.append(length(visible));
            if (ranged) {
                variables.append(IterationType(row));
                visible.append(row.value);
                fixed.append(row.value);
            }
            if (Keyed(row)) {
                second := facts.IntType;
                if (mapped) { second = (row.type - facts.MapType) / 16; }
                variables.append(second);
                visible.append(row.value + 1);
                fixed.append(row.value + 1);
            }
            earliest = Operated(rows, at);
        }
        at += row.count + 1;
    }
    if (!ends) {
        return "scalar function can end without returning";
    }
    return "";
}
// This validates the representation, not the truth of fabricated
// accepted rows. The caller must bind the actual trusted producer artifact,
// source bytes and unchanged result envelope. No source parsing occurs here.
pub Validate :: (rows: facts.Row[]) -> string {
    return ValidateWith(rows, false);
}
// Index of an item in an ascending table, or -1. Slot and variable IDs are
// appended in definition order, so tracking references needs no hashing.
SortedIndex :: (items: int[], wanted: int) -> int {
    low := 0;
    high := length(items);
    while (low < high) {
        middle := low + (high - low) / 2;
        if (items[middle] < wanted) { low = middle + 1; }
        else { high = middle; }
    }
    if (low < length(items) && items[low] == wanted) { return low; }
    return -1;
}

// Follow value edges once, including array recursion. Pointer, view, task and
// map storage remains outside retained snapshot ownership.
Retainable :: (rows: facts.Row[], records: int[], type: int) -> bool {
    if (Scalar(type) || type == facts.StringType) { return true; }
    root := type;
    if (root >= facts.ArrayType && root < facts.MapType) {
        root -= facts.ArrayType;
        if (Scalar(root) || root == facts.StringType) { return true; }
    }
    if (root < facts.RecordType || root >= facts.ArrayType || root - facts.RecordType >= length(records)) { return false; }
    pending := [type];
    seen := resize([false], facts.MapType);
    at := 0;
    while (at < length(pending)) {
        current := pending[at];
        at += 1;
        if (current <= 0 || current >= facts.MapType) { return false; }
        if (seen[current]) { continue; }
        seen[current] = true;
        if (Scalar(current) || current == facts.StringType) { continue; }
        if (current >= facts.ArrayType) { pending.append(current - facts.ArrayType); continue; }
        if (current < facts.RecordType || current - facts.RecordType >= length(records)) { return false; }
        head := records[current - facts.RecordType];
        for (field in head + 1..<After(rows, head)) {
            if (rows[field].kind == facts.MemberRow) { pending.append(rows[field].type); }
        }
    }
    return true;
}
// Initializers have no side effects or allocation. Their constant record
// construction is repeated, but every leaf initializes its state only once.
RetainedInitializer :: (rows: facts.Row[], at: int) -> bool {
    for (index in at + 1..<at + 1 + rows[at].count) {
        kind := rows[index].kind;
        if (kind == facts.ArrayRow && rows[index].value == facts.ArrayNew && rows[index].count == 0) { continue; }
        if (kind != facts.LiteralRow && kind != facts.ZeroRow && kind != facts.UpdateRow && kind != facts.MakeRow && kind != facts.ConvertRow) {
            return false;
        }
    }
    return rows[at].count > 0;
}

RetainedCode :: struct {
    types: int[];
    code: native.Instruction[];
    texts: string[];
    value: int;
    states: int;
    array_fields: int[];
    array_states: int[];
    characters: bool[];
}
// Direct array leaves are indexed once when their binding is lowered.
RetainedArrayState :: (variables: int[], fields: int[], states: int[], variable: int, field: int) -> int {
    low := 0;
    high := length(variables);
    while (low < high) {
        middle := low + (high - low) / 2;
        if (variables[middle] < variable || (variables[middle] == variable && fields[middle] < field)) { low = middle + 1; }
        else { high = middle; }
    }
    if (low < length(variables) && variables[low] == variable && fields[low] == field) { return states[low]; }
    return -1;
}
// Flatten records once during lowering; the frame executes one load/store
// per scalar or string leaf. StateLoad.left is its initializer slot plus one.
RetainedValue :: (rows: facts.Row[], records: int[], type: int, value: int, name: string,
                  state_index: int, text: int, slot: int, read: bool, character: bool = false) -> RetainedCode {
    lowered: RetainedCode = {types: [], code: [], texts: [], value: value, states: 0, array_fields: [], array_states: [], characters: []};
    native_type := NativeType(type);
    opaque := type >= facts.RecordType && type < facts.ArrayType && rows[records[type - facts.RecordType]].kind == facts.UnionRow;
    if (type < facts.RecordType || (type >= facts.ArrayType && type < facts.MapType) || opaque) {
        if (read) {
            lowered.types.append(native_type);
            lowered.code.append(Op(native.StateLoad, native_type, slot, value + 1, text, state_index));
            lowered.texts.append(name);
            lowered.value = slot;
            lowered.characters.append(character);
            if (type >= facts.ArrayType) { lowered.array_fields.append(-1); lowered.array_states.append(state_index); }
        } else {
            lowered.code.append(Op(native.StateStore, native_type, 0, value, 0, state_index));
        }
        lowered.states = 1;
        return lowered;
    }
    if (read) {
        lowered.types.append(native_type);
        lowered.code.append(Op(native.Constant, native_type, slot, 0, 0, 0));
        lowered.value = slot;
    }
    head := records[type - facts.RecordType];
    for (field in head + 1..<After(rows, head)) {
        member := rows[field];
        if (member.kind != facts.MemberRow) {
            continue;
        }
        current := slot + length(lowered.types);
        lowered.types.append(NativeType(member.type));
        extract := Op(native.Extract, NativeType(member.type), current, value, native_type, 0);
        extract.literal = i64(member.value);
        lowered.code.append(extract);
        if (read && member.type >= facts.ArrayType && member.type < facts.MapType) {
            lowered.array_fields.append(member.value);
            lowered.array_states.append(state_index + lowered.states);
        }
        leaf := RetainedValue(rows, records, member.type, current, format_text("{}.{}", name, member.name),
                              state_index + lowered.states, text + length(lowered.texts), current + 1, read, member.literal == i64(facts.CharNominal));
        lowered.types.extend(leaf.types);
        lowered.code.extend(leaf.code);
        lowered.texts.extend(leaf.texts);
        lowered.characters.extend(leaf.characters);
        lowered.states += leaf.states;
        if (read) {
            next := slot + length(lowered.types);
            lowered.types.append(native_type);
            insert := Op(native.Insert, native_type, next, lowered.value, leaf.value, 0);
            insert.literal = i64(member.value);
            lowered.code.append(insert);
            lowered.value = next;
        }
    }
    return lowered;
}

// Validate, or for `shared` the rows of a package that a shared library holds:
// every function is a library function, though the rows are a package's, which
// name no library and carry no stable IDs.
WaitingOperand :: (row: facts.Row) -> bool {
    return row.kind == facts.YieldRow || row.kind == facts.AwaitRow || row.kind == facts.AwaitResultRow || row.kind == facts.DelayRow ||
           (row.kind == facts.CallRow && row.literal == i64(facts.CallAwaited));
}
ValidateWith :: (rows: facts.Row[], shared: bool) -> string {
    if (length(rows) < 2) {
        return "scalar module row count is out of bounds";
    }
    source := rows[0];
    if (source.kind != facts.SourceRow || source.type != 0 || source.value != 0 || source.count != 0 ||
        source.literal != 0 || source.name == "" || !Unlocated(source)) {
        return "noncanonical scalar source row";
    }
    size := strings.ByteLength(source.text);
    starts := LineStarts(source.text);
    if (rows[1].kind == facts.RejectionRow) {
        return ValidRejection(rows, starts, size);
    }
    document := rows[1];
    if (document.kind != facts.DocumentRow || document.type != 0 || document.value != 0 || document.count != 0 ||
        document.literal != 0 || document.name == "" || !Unlocated(document)) {
        return "noncanonical accepted scalar module";
    }
    identified := document.text != "";
    is_library := identified || shared;
    records := Records(rows);
    error := ValidRecords(rows, records, starts, size);
    if (error != "") {
        return error;
    }
    heads := Heads(rows, Start(rows, records));
    if (length(heads) == 0) {
        if (shared && !identified && length(rows) == 2) { return ""; }
        return "invalid scalar module layout";
    }
    first := rows[heads[0]];
    if (!is_library && (first.count != 0 || first.type != facts.IntType)) {
        return "scalar module entry must take no parameters and return int";
    }
    waiting := resize([false], length(heads));
    task_calls := false;
    for (function in 0..<length(heads)) {
        failure := ValidFunction(rows, records, heads, function, starts, size, is_library, identified);
        if (failure != "") {
            return failure;
        }
        waits := false;
        head := heads[function];
        for (at in head + rows[head].count + 1..<Last(rows, heads, function)) {
            row := rows[at];
            waits = waits || WaitingOperand(row);
            task_calls = task_calls || (row.kind == facts.CallRow && row.literal == i64(facts.CallSpawned));
        }
        if (waits && !Scalar(rows[head].type)) {
            return "scalar waiting results require numeric or bool values yet";
        }
        if (rows[head].value == facts.FunctionVoid && !waits) {
            return "scalar void task metadata names a function that does not wait";
        }
        waiting[function] = waits;
        task_calls = task_calls || waits;
    }
    if (task_calls) {
        // ValidFunction has checked each function index. Coroutine ramps return
        // frames, so plain calls and C-ABI function addresses cannot use them.
        for (row in rows) {
            if (row.kind == facts.FunctionAddressRow && waiting[row.value]) {
                return "scalar function address cannot name a waiting function";
            }
            if (row.kind == facts.AwaitResultRow && !waiting[row.value]) {
                return "scalar task result names a function that does not wait";
            }
            if (row.kind == facts.CallRow) {
                if (row.literal == i64(facts.CallPlain) && waiting[row.value]) {
                    return "scalar plain call cannot name a waiting function";
                }
                if (row.literal != i64(facts.CallPlain) && !waiting[row.value]) {
                    return "scalar awaited call or spawn names a function that does not wait";
                }
            }
        }
    }
    if (shared && !identified) {
        for (function in 0..<length(heads)) {
            declaration := rows[heads[function]];
            if (declaration.name == "Main" || declaration.name == "Frame") {
                if (waiting[function]) {
                    return "native package generation Main and Frame cannot wait";
                }
                if (declaration.count != 0 || declaration.type != facts.IntType) {
                    return format_text("No runnable {}: native package generations require Main and Frame with a zero-argument int ABI", declaration.name);
                }
            }
        }
    }
    return "";
}

// The native comparison of a facts operator: facts.Less through
// facts.NotEqual are in the order of native.Lt through native.Ne.
Comparison :: (operator: int) -> int {
    return native.Lt + operator - facts.Less;
}
// The native operation of a facts arithmetic operator.
Arithmetic :: (operator: int) -> int {
    if (operator == facts.ReversedRemainder) { return native.Mod; }
    operations := [native.Add, native.Sub, native.Mul, native.Div, native.Mod, native.BitAnd, native.BitOr,
                   native.BitXor, native.Shl, native.Shr];
    return operations[operator - facts.Add];
}
Unary :: (operator: int) -> int {
    if (operator == facts.SquareRoot) {
        return native.Sqrt;
    }
    if (operator == facts.Negate) {
        return native.Neg;
    }
    return native.BitNot;
}
// An open if statement, switch or loop while emitting: its row kind; an if
// statement's jump past its consequence, or -1 once its else has begun, a
// loop's jump out, or a switch's jump to the test after its current arm's,
// or -1; its consequence's jump past its alternative, or a For row's jump out
// at its bound, or -1; whether its consequence ends, or whether each of a
// switch's arms so far does; a loop's first instruction; a For row's index
// and bound locals, or a switch's value local; whether a For row stops at its
// bound, whether it counts down, and its jump out when its range is empty, or
// -1; its first pending break or continue; and a switch's first arm exit,
// whether an arm has begun, and its default arm's first instruction, or -1;
// and how many owning variables were open when it began, and the hidden local
// of the array an Arrayed loop visits when the loop owns it, or -1, and its type.
Frame :: struct {
    kind: int;
    skip: int;
    leave: int;
    ends: bool;
    head: int;
    index: int;
    bound: int;
    counted: bool;
    reverse: bool;
    escape: int;
    empty: int;
    exits: int;
    armed: bool;
    fallback: int;
    owned: int;
    held: int;
    held_type: int;
    pattern_first: int;
}
// The native array instruction of `operand`, an Array row other than
// ArrayNew, over the operand slots stack[base...].
ArrayLowered :: (operand: facts.Row, type: int, slot: int, stack: int[], base: int) -> native.Instruction {
    if (operand.value == facts.ArrayLength) {
        return Op(native.ArrayLength, type, slot, stack[base], 0, 0);
    }
    if (operand.value == facts.ArrayPlaceCheck) {
        item := Op(native.ArrayGet, abi.BoolStorage, slot, stack[base], stack[base + 1], 0);
        item.literal = i64(native.ArrayGetPlaceCheck);
        return item;
    }
    if (operand.value == facts.ArrayGet || operand.value == facts.ArrayPlaceGet) {
        item := Op(native.ArrayGet, type, slot, stack[base], stack[base + 1], 0);
        if (operand.value == facts.ArrayPlaceGet) { item.literal = 1; }
        return item;
    }
    if (operand.value == facts.ArraySet || operand.value == facts.ArrayReplace || operand.value == facts.ArrayReplaced) {
        item := Op(native.ArraySet, type, slot, stack[base], stack[base + 1], stack[base + 2]);
        item.literal = i64(native.ArraySetPlace);
        if (operand.value != facts.ArraySet) { item.literal = i64(native.ArraySetUnchanged); }
        return item;
    }
    if (operand.value == facts.ArrayInsert || operand.value == facts.ArrayInserted) {
        return Op(native.ArrayInsert, type, slot, stack[base], stack[base + 1], stack[base + 2]);
    }
    if (operand.value == facts.ArrayReverse || operand.value == facts.ArrayReversed) {
        return Op(native.ArrayReverse, type, slot, stack[base], 0, 0);
    }
    if (operand.value == facts.ArrayPush) {
        return Op(native.ArrayPush, type, slot, stack[base], stack[base + 1], 0);
    }
    if (operand.value == facts.ArrayExtend) {
        return Op(native.ArrayExtend, type, slot, stack[base], stack[base + 1], 0);
    }
    if (operand.value == facts.ArraySlice) {
        return Op(native.ArraySlice, type, slot, stack[base], stack[base + 1], stack[base + 2]);
    }
    if (operand.value == facts.ArrayResize) {
        return Op(native.ArrayResize, type, slot, stack[base], stack[base + 1], 0);
    }
    if (operand.value == facts.ArrayContains) {
        return Op(native.ArrayContains, type, slot, stack[base], stack[base + 1], 0);
    }
    if (operand.value == facts.ArrayRemove) {
        return Op(native.ArrayRemove, type, slot, stack[base], stack[base + 1], 0);
    }
    if (operand.value == facts.ArrayBytes) {
        return Op(native.ArrayBytes, type, slot, stack[base], 0, 0);
    }
    if (operand.value == facts.ArrayText) {
        return Op(native.ArrayText, type, slot, stack[base], 0, 0);
    }
    // Source copies use value ownership. Their foreign writes carry loans;
    // explicit native ArrayCopy stays a physical clone for raw ABI callers.
    return Op(native.ValueCopy, type, slot, stack[base], 0, 0);
}
// The native instruction for a map operator other than its literal.
MapLowered :: (operand: facts.Row, type: int, slot: int, stack: int[], base: int) -> native.Instruction {
    op := native.MapLength;
    if (operand.value == facts.MapGet) { op = native.MapGet; }
    else if (operand.value == facts.MapSet) { op = native.MapSet; }
    else if (operand.value == facts.MapHas) { op = native.MapHas; }
    else if (operand.value == facts.MapDelete) { op = native.MapDelete; }
    else if (operand.value == facts.MapCopy) { op = native.MapCopy; }
    else if (operand.value == facts.MapSpan) { op = native.MapSpan; }
    else if (operand.value == facts.MapLiveAt) { op = native.MapLiveAt; }
    else if (operand.value == facts.MapKeyAt) { op = native.MapKeyAt; }
    else if (operand.value == facts.MapValueAt) { op = native.MapValueAt; }
    right := 0;
    target := 0;
    if (MapOperands(operand) >= 2) {
        right = stack[base + 1];
    }
    if (operand.value == facts.MapSet) {
        target = stack[base + 2];
    }
    item := Op(op, type, slot, stack[base], right, target);
    if (operand.literal != 0) {
        item.literal = i64(NativeType(int(operand.literal)));
    }
    return item;
}

// One native instruction without a literal.
Op :: (op: int, type: int, output: int, left: int, right: int, target: int) -> native.Instruction {
    return {op: op, type: type, output: output, left: left, right: right, target: target, literal: 0};
}
// `code` with the branch or jump at `at` sent to `target`.
Aimed :: (code: native.Instruction[], at: int, target: int) -> native.Instruction[] {
    output := code;
    jump := output[at];
    jump.target = target;
    output[at] = jump;
    return output;
}
// `code` with the branch or jump at `at` sent to the instruction after its
// last.
Patched :: (code: native.Instruction[], at: int) -> native.Instruction[] {
    return Aimed(code, at, length(code));
}
// Explicit backend-fixture policy: the entry is chibi_scalar() -> i32, which
// takes the context first when the module calls the runtime, and the other
// functions are internal. Every function starts with one CHECK under
// budget 1, and loops and recursion run unchecked, as Odin's and Rust's do.
// Neither the export name nor the budget is inferred from source identity,
// and no general runtime/default budget is introduced. Each operand row is
// one slot, defined in row order, so evaluation order is the rows'. Each
// variable is a native local, parameters moved into theirs first, so
// assigning one needs no other form. An if statement's condition branches
// into its consequence, and otherwise jumps past it, to its alternative or
// past its End; a consequence that does not end jumps past the alternative.
// A logical, as stage one emits it, saves its left bool in a local of its
// own, which decides it unless its right operand's value replaces it. A loop
// is lowered as the range step lowers it: a while loop tests its condition
// at its head, and a For row keeps its index and its other bound in locals of
// their own, tests the index at its head and steps it at the end of each
// pass, where a continue goes; a break and the failed test leave the loop.
// An assert's condition branches past a Fail of its call's range and its
// function's stable ID, which a package's functions lack, so theirs is 0.
// A switch, as the switch step lowers it, saves its value in a local, and
// each value arm tests it in turn, entering its arm on equality and otherwise
// jumping to the next test; a default arm is jumped over where it stands and
// entered when the last test fails. Each arm that does not end leaves the
// switch. Each record is the backend's record of its fields' types: a Zero
// row is its constant, an Update row an Insert and a Field row an Extract.
// Each union is the backend's record of its tag, an int, then all its
// payloads: a Make row inserts its tag and payloads into the zero constant,
// and a Tag or Payload row extracts its field. A string literal is a
// constant of the module's text table, one entry per distinct text.
pub EmitFor :: (target: abi.Target, rows: facts.Row[]) -> Result {
    return Lower(target, rows, "", false, false, false);
}
// Emit the rows of a package as a shared library, the generation of an Edit and
// Continue loop: its functions are the library's, named by the package's.
pub EmitShared :: (target: abi.Target, rows: facts.Row[]) -> Result {
    return Lower(target, rows, "", false, true, false);
}
// Native watch supplies and retains an execution-family owner explicitly.
pub EmitFamilyShared :: (target: abi.Target, rows: facts.Row[]) -> Result {
    return Lower(target, rows, "", false, true, false, true);
}
// Emit with line tables: each instruction is at the position of the
// statement row it lowers, the function's own row before its first, and the
// source row names the file, which is in `directory`.
pub EmitLines :: (rows: facts.Row[], directory: string) -> Result {
    return Lower(abi.LinuxX64(), rows, directory, true, false, false);
}
// The native driver links the process runtime that owns shared failure scopes.
pub EmitProgramFor :: (target: abi.Target, rows: facts.Row[], directory: string) -> Result {
    return Lower(target, rows, directory, directory != "", false, true);
}
// Explicit seven-slot embedding boundary; ordinary Wasm emission has no clock owner.
pub EmitClockProgramFor :: (target: abi.Target, rows: facts.Row[], directory: string) -> Result {
    return Lower(target, rows, directory, directory != "", false, true, false, true);
}
Lower :: (target: abi.Target, rows: facts.Row[], directory: string, debug: bool, shared: bool, program: bool, family: bool = false, clock_owner: bool = false) -> Result {
    error := ValidateWith(rows, shared);
    if (error != "") {
        return Result.Invalid(error);
    }
    if (rows[1].kind == facts.RejectionRow) {
        return Result.Rejected(rows);
    }
    pointer_program := false;
    for (row in rows) {
        pointer_program = pointer_program || row.type == facts.PointerType || row.type == facts.ViewType || row.kind == facts.ViewRow || row.type == facts.ArrayType + facts.PointerType ||
                          row.kind == facts.ManagedRow || row.kind == facts.ManagedAddressRow || row.kind == facts.ManagedFieldRow;
    }
    if (pointer_program && !program && !family) {
        return Result.Invalid("managed pointer roots require a standalone native program");
    }
    state_characters: bool[] = [];
    if (!program) {
        for (row in rows) {
            if (row.kind == facts.UnwrapRow) {
                return Result.Invalid("typed failures require a standalone native program");
            }
        }
    }
    generation := shared && rows[1].text == "";
    functions: native.Function[] = [];
    parameters: int[] = [];
    slots: int[] = [];
    locals: int[] = [];
    code: native.Instruction[] = [];
    arguments: int[] = [];
    records: native.Record[] = [];
    fields: int[] = [];
    field_tags: i64[] = [];
    field_names: string[] = [];
    texts: string[] = [];
    pattern_empty_text := -1;
    states: int = 0;
    names: string[] = [];
    ids: i64[] = [];
    lines: int[] = [];
    columns: int[] = [];
    declared := Records(rows);
    for (head in declared) {
        record: native.Record = {first: length(fields), count: 0, identity: rows[head].literal};
        if (rows[head].kind == facts.UnionRow) {
            fields.append(NativeType(facts.IntType));
            if (pointer_program) { field_tags.append(0); }
            field_names.append("tag");
        }
        // A record's fields, or each of a union's variants and its payloads.
        for (field in head + 1..<After(rows, head)) {
            if (rows[field].kind == facts.MemberRow) {
                fields.append(NativeType(rows[field].type));
                if (pointer_program) { field_tags.append(rows[field].literal); }
                field_names.append(rows[field].name);
            }
        }
        record.count = length(fields) - record.first;
        records.append(record);
    }
    value_layout := native.ValueLayouts(records, fields);
    managed := value_layout.owned;
    comparison_sites: int[] = [];
    comparison_types: bool[] = [];
    heads := Heads(rows, Start(rows, declared));
    // The open statement an End, Else or Case row belongs to, plus one; 0 for
    // any other row.
    openers: int[] = resize([int(0)], length(rows));
    // The open statement each row lies in, plus one; 0 at the top level.
    parents: int[] = resize([int(0)], length(rows));
    for (function in 0..<length(heads)) {
        head := heads[function];
        declaration := rows[head];
        // Package generations have no prepared-artifact identities. These IDs
        // belong only to this generation; retained states still use their names.
        id := declaration.literal;
        if (generation) {
            id = i64(function);
        }
        ids.append(id);
        result := NativeType(declaration.type);
        shape: native.Function = {result: result, first_parameter: length(parameters),
                                  parameters: declaration.count, first_slot: length(slots), slots: 0,
                                  first_local: length(locals), locals: 0, first_code: length(code), code: 0,
                                  first_argument: length(arguments), arguments: 0};
        body: native.Instruction[] = [Op(native.Check, 0, 0, 0, 0, 0)];
        names.append(declaration.name);
        line := declaration.line;
        column := declaration.column;
        // Each variable's local, and the next slot and local.
        places: int[] = [];
        // The variables that are retained states, and their states.
        retained_variables: int[] = [];
        retained_published: int[] = [];
        retained_states: int[] = [];
        retained_types: int[] = [];
        retained_array_variables: int[] = [];
        retained_array_fields: int[] = [];
        retained_array_states: int[] = [];
        reference_slots: int[] = [];
        reference_variables: int[] = [];
        slot: int = 0;
        local: int = 0;
        // The variables that own their arrays, in the order they opened and
        // with their native array types, and the slots of fresh arrays no one
        // owns yet (D10, native drops).
        owned_vars: int[] = [];
        owned_types: int[] = [];
        fresh: int[] = [];
        pointer_boxes: ManagedBoxes = {boxed: [], tags: [], records: [], error: ""};
        if (pointer_program) { pointer_boxes = ManagedVariables(rows, head, Last(rows, heads, function)); }
        next_root := 0;
        deferred_boxes: int[] = [];
        deferred_values: int[] = [];
        // The variables of switch subjects that a call just made, which no one
        // else holds: the arm that binds a payload of one owns it.
        temp_subjects: int[] = [];
        // The row of each local variable's declaration.
        decl_vars: int[] = [];
        decl_rows: int[] = [];
        // Synchronous values can borrow until a scoped call changes them.
        // Waiting values acquire independent owners at entry: their caller
        // may finish after the first suspension.
        addressed_parameters := resize([false], declaration.count);
        waiting_function := false;
        for (index in head + declaration.count + 1..<Last(rows, heads, function)) {
            operand := rows[index];
            waiting_function = waiting_function || WaitingOperand(operand);
            if ((operand.kind == facts.RefRow || operand.kind == facts.AssignRow) && operand.value < declaration.count) {
                addressed_parameters[operand.value] = true;
            }
        }
        for (index in 0..<declaration.count) {
            type := NativeType(rows[head + 1 + index].type);
            if (Referenced(rows, head, index)) {
                type += native.RefType;
            }
            parameters.append(type);
            slots.append(type);
            boxed := ManagedVariable(pointer_boxes.boxed, index);
            local_type := type;
            if (boxed) { local_type = native.PointerType; }
            locals.append(local_type);
            body.append(Op(native.Argument, type, slot, index, 0, 0));
            if (boxed) {
                deferred_boxes.append(index);
                deferred_values.append(slot);
            } else { body.append(Op(native.Save, type, 0, slot, 0, local)); }
            places.append(local);
            if ((type == abi.TextStorage || TrackedRecord(managed, type)) && (addressed_parameters[index] || waiting_function)) {
                if (type == abi.TextStorage) { body.append(Op(native.TextRetain, type, 0, slot, 0, 0)); }
                else {
                    glue := KeepValue(managed, type, slot, slot + 1);
                    slots.extend(glue.slot_types);
                    body.extend(glue.code);
                    body.append(Op(native.Save, type, 0, glue.value, 0, local));
                    slot += length(glue.slot_types);
                }
                owned_vars.append(index);
                owned_types.append(type);
            }
            if (waiting_function && (type == native.ArrayType + native.PointerType ||
                (ArrayTyped(type) && native.TaskOwnedType(records, value_layout, type))) &&
                rows[head + 1 + index].literal != i64(facts.ParameterOwnedArray)) {
                // A suspended callee owns its value parameter independently of
                // the caller's lifetime, including discarded task observers.
                kept := KeepValue(managed, rows[head + 1 + index].type, slot, slot + 1);
                slots.extend(kept.slot_types);
                body.extend(kept.code);
                body.append(Op(native.Save, type, 0, kept.value, 0, local));
                slot += length(kept.slot_types);
                owned_vars.append(index);
                owned_types.append(type);
            }
            if (rows[head + 1 + index].literal == i64(facts.ParameterOwnedArray) && !boxed) {
                // A parameter the function changes is its own container.
                owned_vars.append(index);
                owned_types.append(type);
            }
            slot += 1;
            local += 1;
        }
        // Every array parameter is in its canonical place before a promoted
        // numeric parameter can allocate and collect moved argument owners.
        for (index in 0..<length(deferred_boxes)) {
            variable := deferred_boxes[index];
            value := deferred_values[index];
            slots.append(native.PointerType);
            glue := ManagedPinOwners(owned_vars, owned_types, places, locals, shape.first_local,
                fresh, slots, shape.first_slot, [], slot + 1, next_root, waiting_function, records, value_layout);
            next_root = glue.next;
            slots.extend(glue.types);
            body.extend(glue.before);
            made := Op(native.ManagedNew, native.PointerType, slot, value, NativeType(rows[head + 1 + variable].type), 0);
            made.literal = pointer_boxes.tags[variable];
            body.append(made);
            body.extend(glue.after);
            body.append(Op(native.Save, native.PointerType, 0, slot, 0, places[variable]));
            if (rows[head + 1 + variable].literal == i64(facts.ParameterOwnedArray)) {
                body.append(Giving(NativeType(rows[head + 1 + variable].type), value));
            }
            slot += 1 + length(glue.types);
        }
        // Each open if statement, switch or loop; each pending break or
        // continue: its jump and whether it continues; and each switch arm's
        // pending exit. A logical's own pending jumps are its operand's, not
        // these.
        frames: Frame[] = [];
        jumps: int[] = [];
        continuing: bool[] = [];
        arms: int[] = [];
        // Whether control cannot reach the next instruction.
        ends := false;
        integer := NativeType(facts.IntType);
        at := head + declaration.count + 1;
        last := Last(rows, heads, function);
        walk := at;
        open_rows: int[] = [];
        // The variables of a union type that something other than a call's
        // result or a variant made fresh is stored in, or that anything reads
        // but for its tag and
        // payloads: the union such a variable holds may share its payloads
        // with another place.
        stale_unions: int[] = [];
        while (walk < last) {
            kind := rows[walk].kind;
            parents[walk] = 0;
            if (length(open_rows) > 0) {
                parents[walk] = open_rows[length(open_rows) - 1] + 1;
            }
            if ((kind == facts.LocalRow || kind == facts.AssignRow) && rows[walk].count > 0 &&
                rows[walk + rows[walk].count].kind != facts.CallRow && rows[walk + rows[walk].count].kind != facts.MakeRow &&
                UnionHead(rows, declared, rows[walk].type) >= 0) {
                stale_unions.append(rows[walk].value);
            }
            for (operand in walk + 1..<walk + 1 + rows[walk].count) {
                if (rows[operand].kind == facts.ReadRow && UnionHead(rows, declared, rows[operand].type) >= 0 &&
                    (operand + 1 >= walk + 1 + rows[walk].count ||
                     (rows[operand + 1].kind != facts.TagRow && rows[operand + 1].kind != facts.PayloadRow &&
                      rows[operand + 1].kind != facts.OptionalFieldRow))) {
                    stale_unions.append(rows[operand].value);
                }
            }
            if (kind == facts.EndRow) {
                openers[walk] = open_rows[length(open_rows) - 1] + 1;
                open_rows = slice(open_rows, 0, length(open_rows) - 1);
            } else if (kind == facts.ElseRow || kind == facts.CaseRow) {
                openers[walk] = open_rows[length(open_rows) - 1] + 1;
            } else if (Opens(kind)) {
                open_rows.append(walk);
            }
            walk = Following(rows, walk);
        }
        while (at < last) {
            row := rows[at];
            while (length(lines) < length(code) + length(body)) {
                lines.append(line);
                columns.append(column);
            }
            if (row.line > 0) {
                line = row.line;
                column = row.column;
            }
            top := length(frames) - 1;
            if (row.kind == facts.ScopeRow) {
                frame: Frame = {kind: row.kind, skip: -1, leave: -1, ends: false, head: 0, index: 0,
                                bound: 0, counted: false, reverse: false, escape: length(jumps), empty: -1,
                                exits: 0, armed: false, fallback: -1, owned: length(owned_vars), held: -1, held_type: 0, pattern_first: -1};
                frames.append(frame);
                at += 1;
                continue;
            }
            if (row.kind == facts.ElseRow) {
                frame := frames[top];
                if (!ends) {
                    drops := DropAll(rows, declared, managed, owned_vars, owned_types, places, frame.owned, [], frames, false, slot, length(body));
                    slots.extend(drops.slot_types);
                    slot += length(drops.slot_types);
                    body.extend(drops.code);
                    frame.leave = length(body);
                    body.append(Op(native.Jump, 0, 0, 0, 0, 0));
                }
                owned_vars = slice(owned_vars, 0, frame.owned);
                owned_types = slice(owned_types, 0, frame.owned);
                body = Patched(body, frame.skip);
                frame.skip = -1;
                frame.ends = ends;
                frames[top] = frame;
                ends = false;
                at += 1;
                continue;
            }
            if (row.kind == facts.CaseRow || (row.kind == facts.EndRow && frames[top].kind == facts.SwitchRow)) {
                // The arm before ends here: it leaves the switch unless it
                // ends, and its failed test reaches the next.
                frame := frames[top];
                if (frame.armed && !ends) {
                    drops := DropAll(rows, declared, managed, owned_vars, owned_types, places, frame.owned, [], frames, false, slot, length(body));
                    slots.extend(drops.slot_types);
                    slot += length(drops.slot_types);
                    body.extend(drops.code);
                    arms.append(length(body));
                    body.append(Op(native.Jump, 0, 0, 0, 0, 0));
                }
                owned_vars = slice(owned_vars, 0, frame.owned);
                owned_types = slice(owned_types, 0, frame.owned);
                frame.ends = frame.ends && (!frame.armed || ends);
                frame.armed = true;
                ends = false;
                if (row.kind == facts.EndRow) {
                    // When every test fails, the default arm runs, if any.
                    if (frame.skip >= 0) {
                        target := length(body);
                        if (frame.fallback >= 0) {
                            target = frame.fallback;
                        }
                        body = Aimed(body, frame.skip, target);
                    }
                    for (exit_at in frame.exits..<length(arms)) {
                        body = Patched(body, arms[exit_at]);
                    }
                    arms = slice(arms, 0, frame.exits);
                    frames = slice(frames, 0, top);
                    ends = frame.fallback >= 0 && frame.ends;
                    at += 1;
                    continue;
                }
                if (frame.skip >= 0) {
                    body = Patched(body, frame.skip);
                }
                frame.skip = -1;
                if (row.count == 0) {
                    frame.skip = length(body);
                    body.append(Op(native.Jump, 0, 0, 0, 0, 0));
                    frame.fallback = length(body);
                    frames[top] = frame;
                    at += 1;
                    continue;
                }
                frames[top] = frame;
            }
            if (row.kind == facts.EndRow) {
                frame := frames[top];
                frames = slice(frames, 0, top);
                at += 1;
                if (!ends) {
                    drops := DropAll(rows, declared, managed, owned_vars, owned_types, places, frame.owned, [], frames, false, slot, length(body));
                    slots.extend(drops.slot_types);
                    slot += length(drops.slot_types);
                    body.extend(drops.code);
                }
                owned_vars = slice(owned_vars, 0, frame.owned);
                owned_types = slice(owned_types, 0, frame.owned);
                if (frame.kind == facts.ScopeRow) { continue; }
                if (frame.kind == facts.IfRow) {
                    if (frame.skip >= 0) {
                        body = Patched(body, frame.skip);
                        ends = false;
                    } else {
                        if (frame.leave >= 0) {
                            body = Patched(body, frame.leave);
                        }
                        ends = frame.ends && ends;
                    }
                    continue;
                }
                // A pass ends at its step, which a continue also reaches; a
                // For row's index steps toward its bound and stops on
                // reaching it when that ends the range, so it never wraps.
                for (escape in frame.escape..<length(jumps)) {
                    if (continuing[escape]) {
                        body = Patched(body, jumps[escape]);
                    }
                }
                if (frame.pattern_first >= 0) {
                    // Continue edges converge here after dropping body locals.
                    // Clear captures before a side-effectful next subject read;
                    // the final false test is released by its enclosing Scope.
                    drops := DropAll(rows, declared, managed, owned_vars, owned_types, places,
                                     frame.pattern_first, [], frames, false, slot, length(body));
                    slots.extend(drops.slot_types);
                    body.extend(drops.code);
                    slot += length(drops.slot_types);
                    for (owner in frame.pattern_first..<frame.owned) {
                        type := owned_types[owner];
                        if (type == 0) { continue; }
                        slots.append(type);
                        zero := Op(native.Constant, type, slot, 0, 0, 0);
                        if (type == abi.TextStorage) {
                            if (pattern_empty_text < 0) { pattern_empty_text = length(texts); texts.append(""); }
                            zero.literal = i64(pattern_empty_text);
                        }
                        body.extend([zero, Op(native.Save, type, 0, slot, 0, places[owned_vars[owner]])]);
                        slot += 1;
                    }
                }
                if (frame.kind == facts.ForRow) {
                    index := slot;
                    slots.append(integer);
                    body.append(Op(native.Local, integer, index, frame.index, 0, 0));
                    slot += 1;
                    if (frame.counted) {
                        slots.extend([integer, abi.BoolStorage]);
                        body.extend([Op(native.Local, integer, slot, frame.bound, 0, 0),
                                     Op(native.Eq, integer, slot + 1, index, slot, 0)]);
                        frame.leave = length(body);
                        body.append(Op(native.Branch, 0, 0, slot + 1, 0, 0));
                        slot += 2;
                    }
                    step := native.Add;
                    if (frame.reverse) {
                        step = native.Sub;
                    }
                    one := Op(native.Constant, integer, slot, 0, 0, 0);
                    one.literal = 1;
                    slots.extend([integer, integer]);
                    body.extend([one, Op(step, integer, slot + 1, index, slot, 0),
                                 Op(native.Save, integer, 0, slot + 1, 0, frame.index)]);
                    slot += 2;
                }
                body.append(Op(native.Jump, 0, 0, 0, 0, frame.head));
                exits: int[] = [frame.skip, frame.leave, frame.empty];
                for (pending in exits) {
                    if (pending >= 0) {
                        body = Patched(body, pending);
                    }
                }
                for (escape in frame.escape..<length(jumps)) {
                    if (!continuing[escape]) {
                        body = Patched(body, jumps[escape]);
                    }
                }
                jumps = slice(jumps, 0, frame.escape);
                continuing = slice(continuing, 0, frame.escape);
                if (frame.held >= 0) {
                    slots.append(frame.held_type);
                    body.extend([Op(native.Local, frame.held_type, slot, frame.held, 0, 0),
                                 Giving(frame.held_type, slot)]);
                    slot += 1;
                }
                ends = false;
                continue;
            }
            if (row.kind == facts.BreakRow || row.kind == facts.ContinueRow) {
                loop := top;
                while (!Loop(frames[loop].kind)) {
                    loop -= 1;
                }
                drops := DropAll(rows, declared, managed, owned_vars, owned_types, places, frames[loop].owned, [], frames, false, slot, length(body));
                slots.extend(drops.slot_types);
                slot += length(drops.slot_types);
                body.extend(drops.code);
                if (row.kind == facts.ContinueRow && frames[loop].kind == facts.WhileRow && frames[loop].pattern_first < 0) {
                    body.append(Op(native.Jump, 0, 0, 0, 0, frames[loop].head));
                } else {
                    jumps.append(length(body));
                    continuing.append(row.kind == facts.ContinueRow);
                    body.append(Op(native.Jump, 0, 0, 0, 0, 0));
                }
                ends = true;
                at += 1;
                continue;
            }
            // A while loop's condition runs on each pass.
            start := length(body);
            stack: int[] = [];
            // Fresh arrays this statement's rows read and no longer need.
            pending: int[] = [];
            // The slots that read an owning variable's array, and the variables;
            // and the variables whose array a record took without a copy.
            reads: int[] = [];
            read_vars: int[] = [];
            escaped: int[] = [];
            // The strings this statement's rows store in a record, union or
            // array, which each takes a reference to.
            stored: int[] = [];
            moving: int = -1;
            // Every slot that reads a variable, and the slots that take a
            // union's payload and the variable of that union.
            any_slots: int[] = [];
            any_vars: int[] = [];
            payload_slots: int[] = [];
            payload_vars: int[] = [];
            payload_fields: int[] = [];
            // Each open logical's row after its right operands, its local,
            // its jump past them and its slot.
            closes: int[] = [];
            answers: int[] = [];
            escapes: int[] = [];
            outputs: int[] = [];
            // Fresh strings in a conditional RHS are released on that path,
            // before its skip target joins. Nested RHSs own suffixes here.
            logical_strings: int[] = [];
            logical_first: int[] = [];
            first := at + 1;
            // Borrowed strings need an owner before a later operand can
            // replace their source. A scoped string can alias another scoped
            // parameter; ordinary locals only alias their own variable.
            string_references: bool[] = [];
            scoped_string_reference := false;
            for (index in first..<first + row.count) {
                operand := rows[index];
                if (operand.kind == facts.RefRow && operand.type == facts.StringType) {
                    if (length(string_references) == 0) { string_references = resize([false], length(places)); }
                    string_references[operand.value] = true;
                    scoped_string_reference = scoped_string_reference || Referenced(rows, head, operand.value);
                }
            }
            for (index in first..<first + row.count + 1) {
                while (length(closes) > 0 && closes[length(closes) - 1] == index) {
                    open := length(closes) - 1;
                    right := stack[length(stack) - 1];
                    stack = slice(stack, 0, length(stack) - 1);
                    answer_type := slots[shape.first_slot + outputs[open]];
                    body.append(Op(native.Save, answer_type, 0, right, 0, answers[open]));
                    for (temporary in logical_first[open]..<length(logical_strings)) {
                        body.append(Op(native.TextRelease, abi.TextStorage, 0, logical_strings[temporary], 0, 0));
                    }
                    logical_strings = slice(logical_strings, 0, logical_first[open]);
                    logical_first = slice(logical_first, 0, open);
                    body = Patched(body, escapes[open]);
                    body.append(Op(native.Local, answer_type, outputs[open], answers[open], 0, 0));
                    stack.append(outputs[open]);
                    closes = slice(closes, 0, open);
                    answers = slice(answers, 0, open);
                    escapes = slice(escapes, 0, open);
                    outputs = slice(outputs, 0, open);
                }
                if (index == first + row.count) {
                    break;
                }
                operand := rows[index];
                if (operand.kind == facts.OperandSwapRow) {
                    left := length(stack) - 1 - operand.value;
                    right := length(stack) - 1 - operand.count;
                    held := stack[left];
                    stack[left] = stack[right];
                    stack[right] = held;
                    continue;
                }
                if (operand.kind == facts.OperandBindRow) {
                    held := stack[length(stack) - 1];
                    stack = slice(stack, 0, length(stack) - 1);
                    type := NativeType(operand.type);
                    if (Owning(type) || TrackedRecord(managed, operand.type)) {
                        if (Holds(fresh, held)) { fresh = Without(fresh, held); }
                        else {
                            kept := KeepValue(managed, operand.type, held, slot);
                            slots.extend(kept.slot_types);
                            body.extend(kept.code);
                            slot += length(kept.slot_types);
                            held = kept.value;
                        }
                        old := slot;
                        slots.append(type);
                        body.append(Op(native.Local, type, old, places[operand.value], 0, 0));
                        dropped := DropValue(managed, operand.type, old);
                        slots.extend(dropped.slot_types);
                        body.extend(dropped.code);
                        slot += 1 + length(dropped.slot_types);
                    }
                    body.append(Op(native.Save, type, 0, held, 0, places[operand.value]));
                    continue;
                }
                type := NativeType(operand.type);
                slots.append(type);
                if (operand.kind == facts.LogicalRow) {
                    left := stack[length(stack) - 1];
                    stack = slice(stack, 0, length(stack) - 1);
                    locals.append(type);
                    if (operand.value == facts.LogicalCoalesce) {
                        // Nil alone visits the fallback. Reading the by-value
                        // payload on Nil is safe and is overwritten on that path.
                        slots.extend([abi.IntStorage, abi.IntStorage, abi.BoolStorage, type]);
                        tag := Op(native.Extract, abi.IntStorage, slot + 1, left, slots[shape.first_slot + left], 0);
                        zero := Op(native.Constant, abi.IntStorage, slot + 2, 0, 0, 0);
                        payload := Op(native.Extract, type, slot + 4, left, slots[shape.first_slot + left], 0);
                        payload.literal = 1;
                        body.extend([tag, zero, Op(native.Ne, abi.IntStorage, slot + 3, slot + 1, slot + 2, 0), payload,
                                     Op(native.Save, type, 0, slot + 4, 0, local)]);
                        escapes.append(length(body));
                        body.append(Op(native.Branch, 0, 0, slot + 3, 0, 0));
                        slot += 4;
                    } else if (operand.value == facts.LogicalAnd) {
                        body.append(Op(native.Save, type, 0, left, 0, local));
                        body.append(Op(native.Branch, 0, 0, left, 0, length(body) + 2));
                        escapes.append(length(body));
                        body.append(Op(native.Jump, 0, 0, 0, 0, 0));
                    } else {
                        body.append(Op(native.Save, type, 0, left, 0, local));
                        escapes.append(length(body));
                        body.append(Op(native.Branch, 0, 0, left, 0, 0));
                    }
                    closes.append(index + operand.count + 1);
                    logical_first.append(length(logical_strings));
                    answers.append(local);
                    output := slot;
                    if (operand.value == facts.LogicalCoalesce) { output -= 4; }
                    outputs.append(output);
                    local += 1;
                    slot += 1;
                    continue;
                }
                item: native.Instruction = {op: native.Constant, type: type, output: slot, left: 0, right: 0,
                                            target: 0, literal: operand.literal};
                retained_element := false;
                retained_record := false;
                retained_array := false;
                mutated_owned := false;
                array_place := false;
                extra := 0;
                if (operand.kind == facts.LiteralRow && operand.type == facts.StringType) {
                    // A repeated literal or default shares one entry.
                    item.literal = i64(length(texts));
                    for (index in 0..<length(texts)) {
                        if (texts[index] == operand.text) {
                            item.literal = i64(index);
                            break;
                        }
                    }
                    if (item.literal == i64(length(texts))) {
                        texts.append(operand.text);
                    }
                } else if (operand.kind == facts.ViewRow) {
                    op := facts.ViewOperation(operand.value);
                    element := NativeType(facts.ViewElement(operand.value));
                    base := length(stack) - ViewOperands(operand);
                    operation := native.ViewMake;
                    switch op {
                        case facts.ViewMake: operation = native.ViewMake;
                        case facts.ViewLength: operation = native.ViewLength;
                        case facts.ViewGet: operation = native.ViewGet;
                        case facts.ViewSet: operation = native.ViewSet;
                        case facts.ViewClone: operation = native.ViewClone;
                        case facts.ViewSlice: operation = native.ViewSlice;
                        case: assert(false, "validated view operation");
                    }
                    item = Op(operation, type, slot, stack[base], 0, 0);
                    item.literal = operand.literal;
                    if (op == facts.ViewMake || op == facts.ViewSet || op == facts.ViewSlice) {
                        item.right = shape.arguments;
                        arguments.extend([stack[base + 1], stack[base + 2]]);
                        shape.arguments += 2;
                        if (op == facts.ViewSet) { item.type = element; item.output = 0; }
                        else { item.target = element; }
                    } else if (op == facts.ViewGet) { item.right = stack[base + 1]; }
                    else if (op == facts.ViewLength) { item.right = element; }
                    if (op == facts.ViewSet) {
                        body.append(item);
                        item = Op(native.Constant, abi.IntStorage, slot, 0, 0, 0);
                    }
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.ManagedAddressRow) {
                    item = Op(native.Local, native.PointerType, slot, places[operand.value], 0, 0);
                } else if (operand.kind == facts.ManagedFieldRow) {
                    slots[length(slots) - 1] = native.PointerType;
                    type = native.PointerType;
                    base := length(stack) - 1;
                    item = Op(native.ManagedProject, native.PointerType, slot, stack[base], NativeType(operand.type), operand.value);
                    item.literal = operand.literal;
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.ManagedRow) {
                    count := 1;
                    if (operand.value == facts.ManagedWrite) { count = 2; }
                    base := length(stack) - count;
                    target := type;
                    if (operand.value == facts.ManagedBorrow) { target -= native.RefType; }
                    address := Op(native.ManagedAddress, native.RefType + target, slot, stack[base], 0, 0);
                    address.literal = operand.literal;
                    if (operand.value == facts.ManagedBorrow) { item = address; }
                    else {
                        slots[length(slots) - 1] = native.RefType + target;
                        body.append(address);
                        if (operand.value == facts.ManagedWrite) {
                            if (target >= native.ArrayType && target < native.MapType) {
                                // Acquire the incoming owner before releasing
                                // the old backing, including self-assignment.
                                incoming := stack[base + 1];
                                if (Holds(fresh, incoming)) { fresh = Without(fresh, incoming); }
                                else {
                                    slots.append(target);
                                    body.append(Op(native.ValueCopy, target, slot + 1 + extra, incoming, 0, 0));
                                    incoming = slot + 1 + extra;
                                    extra += 1;
                                }
                                previous := slot + 1 + extra;
                                slots.append(target);
                                body.extend([Op(native.Deref, target, previous, slot, 0, 0), Giving(target, previous),
                                    Op(native.Poke, target, 0, slot, incoming, 0)]);
                                extra += 1;
                            } else { body.append(Op(native.Poke, target, 0, slot, stack[base + 1], 0)); }
                        }
                        slots.append(target);
                        item = Op(native.Deref, target, slot + 1 + extra, slot, 0, 0);
                        slot += 1 + extra;
                        extra = 0;
                    }
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.ReadRow && ManagedVariable(pointer_boxes.boxed, operand.value)) {
                    slots[length(slots) - 1] = native.PointerType;
                    slots.extend([native.RefType + type, type]);
                    body.append(Op(native.Local, native.PointerType, slot, places[operand.value], 0, 0));
                    address := Op(native.ManagedAddress, native.RefType + type, slot + 1, slot, 0, 0);
                    address.literal = pointer_boxes.tags[operand.value];
                    body.append(address);
                    item = Op(native.Deref, type, slot + 2, slot + 1, 0, 0);
                    slot += 2;
                } else if (operand.kind == facts.ReadRow && Referenced(rows, head, operand.value)) {
                    // The reference is read from its local, then what it
                    // refers to.
                    slots[length(slots) - 1] = native.RefType + type;
                    body.append(Op(native.Local, native.RefType + type, slot, places[operand.value], 0, 0));
                    slots.append(type);
                    item = Op(native.Deref, type, slot + 1, slot, 0, 0);
                    slot += 1;
                } else if (operand.kind == facts.RefRow) {
                    reference_slots.append(slot);
                    reference_variables.append(operand.value);
                    slots[length(slots) - 1] = native.RefType + type;
                    if (ManagedVariable(pointer_boxes.boxed, operand.value)) {
                        slots[length(slots) - 1] = native.PointerType;
                        slots.append(native.RefType + type);
                        body.append(Op(native.Local, native.PointerType, slot, places[operand.value], 0, 0));
                        item = Op(native.ManagedAddress, native.RefType + type, slot + 1, slot, 0, 0);
                        item.literal = pointer_boxes.tags[operand.value];
                        if (operand.literal != 0) {
                            record := pointer_boxes.records[operand.value];
                            field := int(operand.literal) - 1;
                            tag := rows[declared[record - facts.RecordType] + 1 + field].literal;
                            slots[length(slots) - 1] = native.PointerType;
                            projected := Op(native.ManagedProject, native.PointerType, slot + 1, slot, NativeType(record), field);
                            projected.literal = tag;
                            body.append(projected);
                            slots.append(native.RefType + type);
                            item = Op(native.ManagedAddress, native.RefType + type, slot + 2, slot + 1, 0, 0);
                            item.literal = tag;
                            slot += 1;
                        }
                        slot += 1;
                    } else if (operand.literal != 0) {
                        // The address of a field of the variable's record, or of the record a reference parameter
                        // points to.
                        held := locals[shape.first_local + places[operand.value]];
                        item = Op(native.FieldAddress, native.RefType + type, slot, places[operand.value], held, 0);
                        if (Referenced(rows, head, operand.value)) {
                            item.right = held - native.RefType;
                            item.target = 1;
                        }
                        item.literal = operand.literal - 1;
                    } else if (Referenced(rows, head, operand.value)) {
                        item = Op(native.Local, native.RefType + type, slot, places[operand.value], 0, 0);
                    } else {
                        item = Op(native.LocalAddress, native.RefType + type, slot, places[operand.value], 0, 0);
                    }
                } else if (operand.kind == facts.FieldReferenceRow) {
                    input := stack[length(stack) - 1];
                    parent := slots[shape.first_slot + input] - native.RefType;
                    locals.append(native.RefType + parent);
                    body.append(Op(native.Save, native.RefType + parent, 0, input, 0, local));
                    slots[length(slots) - 1] = native.RefType + type;
                    item = Op(native.FieldAddress, native.RefType + type, slot, local, parent, 1);
                    item.literal = i64(operand.value);
                    local += 1;
                    origin := SortedIndex(reference_slots, input);
                    if (origin >= 0) {
                        reference_slots.append(slot);
                        reference_variables.append(reference_variables[origin]);
                    }
                    stack = slice(stack, 0, length(stack) - 1);
                } else if (operand.kind == facts.ReadRow) {
                    item = Op(native.Local, type, slot, places[operand.value], 0, 0);
                    any_slots.append(slot);
                    any_vars.append(operand.value);
                    if ((Owning(type) || TrackedRecord(managed, type)) && Holds(owned_vars, operand.value)) {
                        reads.append(slot);
                        read_vars.append(operand.value);
                    }
                } else if (operand.kind == facts.CompareRow) {
                    base := length(stack) - 2;
                    item = Op(Comparison(operand.value), slots[shape.first_slot + stack[base]], slot, stack[base],
                              stack[base + 1], 0);
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.ArithmeticRow) {
                    base := length(stack) - 2;
                    left := stack[base];
                    right := stack[base + 1];
                    if (operand.value == facts.ReversedRemainder) { left = stack[base + 1]; right = stack[base]; }
                    item = Op(Arithmetic(operand.value), type, slot, left, right, 0);
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.UnaryRow) {
                    base := length(stack) - 1;
                    item = Op(Unary(operand.value), type, slot, stack[base], 0, 0);
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.SelectRow) {
                    base := length(stack) - 3;
                    item = Op(native.Select, type, slot, stack[base], stack[base + 1], stack[base + 2]);
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.ConvertRow) {
                    base := length(stack) - 1;
                    item = Op(native.Convert, type, slot, stack[base], slots[shape.first_slot + stack[base]], 0);
                    item.literal = i64(operand.value);
                    if (operand.value == facts.CheckedChar) {
                        // As CharConversionStep does, compare the original
                        // integer as u64 before narrowing. Signed negatives
                        // keep their high bits and fail the upper bound.
                        slots[length(slots) - 1] = abi.WordStorage;
                        slots.extend([abi.WordStorage, abi.BoolStorage, abi.WordStorage, abi.WordStorage,
                                      abi.WordStorage, abi.BoolStorage, type]);
                        wide := Op(native.Convert, abi.WordStorage, slot, stack[base], item.right, 0);
                        wide.literal = i64(facts.Wrap);
                        maximum := Op(native.Constant, abi.WordStorage, slot + 1, 0, 0, 0);
                        maximum.literal = 0x10FFFF;
                        mask := Op(native.Constant, abi.WordStorage, slot + 3, 0, 0, 0);
                        mask.literal = -2048;
                        surrogate := Op(native.Constant, abi.WordStorage, slot + 5, 0, 0, 0);
                        surrogate.literal = 0xD800;
                        failed := Op(native.Fail, 0, 0, operand.start, operand.end, 0);
                        failed.literal = declaration.literal;
                        if (program) {
                            failed = Op(native.TypedFail, 0, 0, 0, 0, 0);
                            failed.literal = 4;
                        }
                        body.extend([wide, maximum, Op(native.Le, abi.WordStorage, slot + 2, slot, slot + 1, 0),
                                     Op(native.Branch, 0, 0, slot + 2, 0, length(body) + 5), failed,
                                     mask, Op(native.BitAnd, abi.WordStorage, slot + 4, slot, slot + 3, 0),
                                     surrogate, Op(native.Ne, abi.WordStorage, slot + 6, slot + 4, slot + 5, 0),
                                     Op(native.Branch, 0, 0, slot + 6, 0, length(body) + 11), failed]);
                        slot += 7;
                        item.output = slot;
                        item.literal = i64(facts.Clamp);
                    }
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.FunctionAddressRow) {
                    item = Op(native.FunctionAddress, type, slot, operand.value, 0, 0);
                } else if (operand.kind == facts.YieldRow) {
                    // The turn is given up first; the row gives int 0, the constant.
                    if (pointer_program || waiting_function) {
                        glue := ManagedPinOwners(owned_vars, owned_types, places, locals, shape.first_local,
                            fresh, slots, shape.first_slot, frames, slot + 1 + extra, next_root, waiting_function, records, value_layout);
                        next_root = glue.next;
                        slots.extend(glue.types);
                        extra += length(glue.types);
                        body.extend(glue.before);
                        body.append(Op(native.Suspend, 0, 0, 0, 0, 0));
                        body.extend(glue.after);
                    } else { body.append(Op(native.Suspend, 0, 0, 0, 0, 0)); }
                } else if (operand.kind == facts.CancelAfterRow) {
                    base := length(stack) - 2;
                    body.append(Op(native.CancelAfter, 0, 0, stack[base], stack[base + 1], 0));
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.DelayRow) {
                    base := length(stack) - 1;
                    if (pointer_program || waiting_function) {
                        glue := ManagedPinOwners(owned_vars, owned_types, places, locals, shape.first_local,
                            fresh, slots, shape.first_slot, frames, slot + 1 + extra, next_root, waiting_function, records, value_layout);
                        next_root = glue.next;
                        slots.extend(glue.types);
                        extra += length(glue.types);
                        body.extend(glue.before);
                        body.append(Op(native.Delay, 0, 0, stack[base], 0, 0));
                        body.extend(glue.after);
                    } else { body.append(Op(native.Delay, 0, 0, stack[base], 0, 0)); }
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.AwaitRow || operand.kind == facts.CancelRow) {
                    base := length(stack) - 1;
                    task_op := native.Cancel;
                    if (operand.kind == facts.AwaitRow) {
                        task_op = native.AwaitHandle;
                    }
                    if ((pointer_program || waiting_function) && task_op == native.AwaitHandle) {
                        glue := ManagedPinOwners(owned_vars, owned_types, places, locals, shape.first_local,
                            fresh, slots, shape.first_slot, frames, slot + 1 + extra, next_root, waiting_function, records, value_layout);
                        next_root = glue.next;
                        slots.extend(glue.types);
                        extra += length(glue.types);
                        body.extend(glue.before);
                        body.append(Op(task_op, 0, 0, stack[base], 0, 0));
                        body.extend(glue.after);
                    } else { body.append(Op(task_op, 0, 0, stack[base], 0, 0)); }
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.TaskRunningRow || operand.kind == facts.AwaitResultRow) {
                    base := length(stack) - 1;
                    item = Op(native.TaskRunning, type, slot, stack[base], 0, 0);
                    if (operand.kind == facts.AwaitResultRow) {
                        callee := rows[heads[operand.value]];
                        success := NativeType(callee.type);
                        if (callee.value == facts.FunctionVoid) { success = 0; }
                        item = Op(native.AwaitResult, type, slot, stack[base], success, int(operand.literal));
                    }
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.CallRow) {
                    item = Op(native.Call, type, slot, operand.value, shape.arguments, operand.count);
                    item.literal = operand.literal;
                    if (operand.literal == i64(facts.CallSpawned) && rows[heads[operand.value]].value == facts.FunctionVoid) {
                        item.literal = i64(native.CallSpawnedVoid);
                    }
                    base := length(stack) - operand.count;
                    for (argument in 0..<operand.count) {
                        arguments.append(stack[base + argument]);
                        // A call lends its arguments, and a fresh one dies with
                        // it, but for a parameter the callee changes: that one
                        // is the callee's own.
                        if (Holds(fresh, stack[base + argument]) &&
                            ArrayTyped(slots[shape.first_slot + stack[base + argument]])) {
                            if (rows[heads[operand.value] + 1 + argument].literal == i64(facts.ParameterOwnedArray)) {
                                fresh = Without(fresh, stack[base + argument]);
                            } else {
                                pending.append(stack[base + argument]);
                            }
                        }
                    }
                    shape.arguments += operand.count;
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.ClockSampleRow) {
                    item = Op(native.ClockSample, type, slot, 0, 0, 0);
                } else if (operand.kind == facts.ForeignRow) {
                    item = Op(native.ForeignCall, type, slot, operand.value, shape.arguments, operand.count);
                    item.literal = i64(length(texts));
                    texts.append(operand.name);
                    base := length(stack) - operand.count;
                    for (argument in 0..<operand.count) {
                        selected := argument;
                        if (operand.literal == i64(facts.ForeignReversed)) { selected = 1 - argument; }
                        passed := stack[base + selected];
                        arguments.append(passed);
                        if (Holds(fresh, passed) && ArrayTyped(slots[shape.first_slot + passed])) {
                            pending.append(passed);
                        }
                    }
                    shape.arguments += operand.count;
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.OptionalFieldRow) {
                    base := length(stack) - 1;
                    held := stack[base];
                    source_type := slots[shape.first_slot + held];
                    source_fact := facts.RecordType + source_type - native.RecordType;
                    record := NativeType(OptionalPayloadType(rows, declared, source_fact));
                    field := NativeType(OptionalPayloadType(rows, declared, operand.type));
                    slots[length(slots) - 1] = abi.IntStorage;
                    slots.extend([record, field, type, type, type]);
                    payload := Op(native.Extract, record, slot + 1, held, source_type, 0);
                    payload.literal = 1;
                    selected := Op(native.Extract, field, slot + 2, slot + 1, record, 0);
                    selected.literal = i64(operand.value);
                    body.extend([Op(native.Extract, abi.IntStorage, slot, held, source_type, 0), payload, selected,
                                 Op(native.Constant, type, slot + 3, 0, 0, 0),
                                 Op(native.Insert, type, slot + 4, slot + 3, slot, 0)]);
                    item = Op(native.Insert, type, slot + 5, slot + 4, slot + 2, 0);
                    item.literal = 1;
                    slot += 5;
                    if (TrackedRecord(managed, source_type) && Holds(fresh, held)) {
                        dropped := DropValue(managed, source_type, held);
                        slots.extend(dropped.slot_types);
                        body.extend(dropped.code);
                        extra += length(dropped.slot_types);
                        fresh = Without(fresh, held);
                    }
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.FieldRow || operand.kind == facts.TagRow ||
                           operand.kind == facts.PayloadRow || operand.kind == facts.UnwrapRow) {
                    // A union's tag is its field 0, and its payloads follow.
                    base := length(stack) - 1;
                    if (operand.kind == facts.UnwrapRow) {
                        // The payload is read only on Some, after the typed failure exit.
                        held := stack[base];
                        slots[length(slots) - 1] = integer;
                        slots.extend([integer, abi.BoolStorage, type]);
                        tag := Op(native.Extract, integer, slot, held, slots[shape.first_slot + held], 0);
                        some := Op(native.Constant, integer, slot + 1, 0, 0, 0);
                        some.literal = 1;
                        failed := Op(native.TypedFail, 0, 0, 0, 0, 0);
                        failed.literal = 7;
                        body.extend([tag, some, Op(native.Eq, integer, slot + 2, slot, slot + 1, 0),
                                     Op(native.Branch, 0, 0, slot + 2, 0, length(body) + 5), failed]);
                        slot += 3;
                    }
                    if (operand.kind == facts.PayloadRow) {
                        for (at_read in 0..<length(any_slots)) {
                            if (any_slots[at_read] == stack[base]) {
                                payload_slots.append(slot);
                                payload_vars.append(any_vars[at_read]);
                                payload_fields.append(operand.value + 1);
                            }
                        }
                    }
                    item = Op(native.Extract, type, slot, stack[base], slots[shape.first_slot + stack[base]], 0);
                    item.literal = i64(operand.value);
                    if (operand.kind == facts.PayloadRow || operand.kind == facts.UnwrapRow) {
                        item.literal += 1;
                    }
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.MakeRow) {
                    // The zero union with its tag, then each payload in its
                    // field; the last Insert is the operand's value.
                    variant := VariantOf(rows, declared[operand.type - facts.RecordType], operand.value);
                    base := length(stack) - operand.count;
                    for (field in 0..<operand.count) {
                        input := stack[base + field];
                        held := slots[shape.first_slot + input];
                        member := rows[variant + 1 + field].type;
                        if (!TrackedRecord(managed, held) && !(TrackedRecord(managed, type) &&
                            member >= facts.ArrayType && member < facts.MapType)) { continue; }
                        if (Holds(fresh, input)) { fresh = Without(fresh, input); }
                        else {
                            kept := KeepValue(managed, member, input, slot + 1 + extra);
                            slots.extend(kept.slot_types);
                            body.extend(kept.code);
                            extra += length(kept.slot_types);
                            stack[base + field] = kept.value;
                        }
                    }
                    tag := Op(native.Constant, integer, slot + 1 + extra, 0, 0, 0);
                    tag.literal = i64(operand.value);
                    slots.extend([integer, type]);
                    body.extend([Op(native.Constant, type, slot, 0, 0, 0), tag]);
                    item = Op(native.Insert, type, slot + 2 + extra, slot, slot + 1 + extra, 0);
                    slot += 2 + extra;
                    extra = 0;
                    for (field in 0..<operand.count) {
                        for (at_read in 0..<length(reads)) {
                            if (reads[at_read] == stack[base + field] && !TrackedRecord(managed, type) &&
                                !TrackedRecord(managed, slots[shape.first_slot + stack[base + field]])) {
                                escaped.append(read_vars[at_read]);
                            }
                        }
                        if (slots[shape.first_slot + stack[base + field]] == abi.TextStorage) {
                            stored.append(stack[base + field]);
                        }
                        body.append(item);
                        slots.append(type);
                        item = Op(native.Insert, type, slot + 1, slot, stack[base + field], 0);
                        item.literal = i64(rows[variant + 1 + field].value + 1);
                        slot += 1;
                    }
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.UpdateRow) {
                    base := length(stack) - 2;
                    for (at_read in 0..<length(reads)) {
                        if (reads[at_read] == stack[base + 1] && !TrackedRecord(managed, type) &&
                            !TrackedRecord(managed, slots[shape.first_slot + stack[base + 1]])) {
                            escaped.append(read_vars[at_read]);
                        }
                    }
                    if (slots[shape.first_slot + stack[base + 1]] == abi.TextStorage && !TrackedRecord(managed, type)) {
                        stored.append(stack[base + 1]);
                    }
                    item = Op(native.Insert, type, slot, stack[base], stack[base + 1], 0);
                    item.literal = i64(operand.value);
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.MapRow) {
                    base := length(stack) - MapOperands(operand);
                    op := operand.value;
                    if (MappedArrayChange(op)) {
                        array_type := (operand.type - facts.MapType) / 16;
                        array := NativeType(array_type);
                        incoming := stack[base + 2];
                        if (op == facts.MapArraySet) { incoming = stack[base + 3]; }
                        if (op == facts.MapArrayPush || op == facts.MapArraySet) {
                            if (Holds(fresh, incoming)) { fresh = Without(fresh, incoming); }
                            else {
                                kept := KeepValue(managed, array_type - facts.ArrayType, incoming, slot + 1 + extra);
                                slots.extend(kept.slot_types);
                                body.extend(kept.code);
                                extra += length(kept.slot_types);
                                incoming = kept.value;
                            }
                        }
                        current := slot + extra;
                        slots.extend([type, native.RefType + array, array, array]);
                        address := Op(native.MapValueAddress, native.RefType + array, current + 2, current + 1, stack[base + 1], 0);
                        address.literal = i64(type);
                        change := Op(native.ArrayPush, array, current + 4, current + 3, incoming, 0);
                        change.literal = 1;
                        if (op == facts.MapArrayExtend) { change.op = native.ArrayExtend; }
                        else if (op == facts.MapArrayRemove) { change.op = native.ArrayRemove; change.literal = 0; }
                        else if (op == facts.MapArrayResize) { change.op = native.ArrayResize; change.literal = 0; }
                        else if (op == facts.MapArraySet) {
                            change.op = native.ArraySet;
                            change.right = stack[base + 2];
                            change.target = incoming;
                            change.literal = 0;
                        }
                        // All source operands have run. Resolve the current
                        // entry, then replace its descriptor without callbacks.
                        body.extend([Op(native.Deref, type, current + 1, stack[base], 0, 0), address,
                                     Op(native.Deref, array, current + 3, current + 2, 0, 0), change]);
                        if (op == facts.MapArrayResize) { body.append(Giving(array, current + 3)); }
                        body.append(Op(native.Poke, array, 0, current + 2, current + 4, 0));
                        if (op == facts.MapArrayExtend && Holds(fresh, stack[base + 2])) { pending.append(stack[base + 2]); }
                        item = Op(native.Deref, type, slot, stack[base], 0, 0);
                        extra += 4;
                    } else if (op == facts.MapNew) {
                        // Take every owned reference before inserting. A
                        // duplicate literal key may replace and release an
                        // earlier value during the first sequence of sets.
                        for (index in 0..<operand.count) {
                            kept := stack[base + index];
                            held := slots[shape.first_slot + kept];
                            if (TrackedRecord(managed, held) || (held >= native.ArrayType && held < native.MapType)) {
                                if (Holds(fresh, kept)) { fresh = Without(fresh, kept); }
                                else {
                                    owned_type := held;
                                    if (held >= native.ArrayType) { owned_type = (operand.type - facts.MapType) / 16; }
                                    owned := KeepValue(managed, owned_type, kept, slot + 1 + extra);
                                    slots.extend(owned.slot_types);
                                    body.extend(owned.code);
                                    extra += length(owned.slot_types);
                                    stack[base + index] = owned.value;
                                }
                            }
                            if (slots[shape.first_slot + kept] == abi.TextStorage) {
                                if (Holds(fresh, kept)) {
                                    fresh = Without(fresh, kept);
                                } else {
                                    body.append(Op(native.TextRetain, abi.TextStorage, 0, kept, 0, 0));
                                }
                            }
                        }
                        item = Op(native.Constant, type, slot, 0, 0, 0);
                        for (pair in 0..<operand.count / 2) {
                            key := stack[base + pair * 2];
                            value := stack[base + pair * 2 + 1];
                            body.append(item);
                            slots.append(type);
                            item = Op(native.MapSet, type, slot + 1 + extra, slot, key, value);
                            item.literal = 1;
                            slot += 1 + extra;
                            extra = 0;
                        }
                    } else {
                        if (op == facts.MapSet) {
                            kept := stack[base + 2];
                            held := slots[shape.first_slot + kept];
                            if (TrackedRecord(managed, held) || (held >= native.ArrayType && held < native.MapType)) {
                                if (Holds(fresh, kept)) { fresh = Without(fresh, kept); }
                                else {
                                    owned_type := held;
                                    if (held >= native.ArrayType) { owned_type = (operand.type - facts.MapType) / 16; }
                                    owned := KeepValue(managed, owned_type, kept, slot + 1 + extra);
                                    slots.extend(owned.slot_types);
                                    body.extend(owned.code);
                                    extra += length(owned.slot_types);
                                    stack[base + 2] = owned.value;
                                }
                            }
                        }
                        if (op == facts.MapSet || op == facts.MapDelete) {
                            slots.append(type);
                            body.append(Op(native.Deref, type, slot, stack[base], 0, 0));
                            stack[base] = slot;
                            slot += 1 + extra;
                            extra = 0;
                        }
                        item = MapLowered(operand, type, slot, stack, base);
                        if (op == facts.MapSet) {
                            for (kept in [stack[base + 1], stack[base + 2]]) {
                                if (slots[shape.first_slot + kept] == abi.TextStorage) {
                                    stored.append(kept);
                                }
                            }
                        }
                        if (op == facts.MapSet || op == facts.MapDelete) {
                            item.literal = 1;
                        }
                        if (op != facts.MapSet && op != facts.MapDelete && Holds(fresh, stack[base])) {
                            pending.append(stack[base]);
                        }
                        retained_record = (op == facts.MapGet || op == facts.MapValueAt) && TrackedRecord(managed, type);
                        retained_array = (op == facts.MapGet || op == facts.MapValueAt) &&
                                         type >= native.ArrayType && type < native.MapType;
                        // A string read borrows from its map. Retain it before
                        // a fresh input map is dropped, then track the result
                        // as fresh so the statement either keeps or releases it.
                        if ((op == facts.MapGet || op == facts.MapKeyAt || op == facts.MapValueAt) && type == abi.TextStorage) {
                            body.append(item);
                            slots.append(type);
                            body.append(Op(native.TextRetain, type, 0, slot, 0, 0));
                            item = Op(native.Local, type, slot + 1, local, 0, 0);
                            locals.append(type);
                            body.append(Op(native.Save, type, 0, slot, 0, local));
                            local += 1;
                            slot += 1;
                        }
                    }
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.ArrayRow &&
                           (operand.literal != 0 || ((ArrayChanges(operand.value) || operand.value == facts.ArrayResize) &&
                            slots[shape.first_slot + stack[length(stack) - ArrayOperands(operand)]] == native.RefType + type))) {
                    array_place = true;
                    base := length(stack) - ArrayOperands(operand);
                    root := stack[base];
                    nested := operand.literal == i64(facts.NestedArrayPlace);
                    fielded := operand.literal != 0 && !nested;
                    member := ArrayPlaceMember(rows, declared, operand);
                    array := NativeType(member);
                    element := member - facts.ArrayType;
                    op := operand.value;
                    // Appended/replaced elements transfer one owned value.
                    first_argument := base + 1;
                    if (nested) { first_argument += 1; }
                    argument := root;
                    if (operand.count > first_argument - base) { argument = stack[first_argument]; }
                    if (op == facts.ArraySet || op == facts.ArrayInsert || op == facts.ArrayReplace) { argument = stack[first_argument + 1]; }
                    if (op == facts.ArrayPush || op == facts.ArraySet || op == facts.ArrayInsert || op == facts.ArrayReplace) {
                        if (Holds(fresh, argument)) { fresh = Without(fresh, argument); }
                        else {
                            kept := KeepValue(managed, element, argument, slot + 1 + extra);
                            slots.extend(kept.slot_types);
                            body.extend(kept.code);
                            extra += length(kept.slot_types);
                            argument = kept.value;
                        }
                    }
                    if (op == facts.ArrayExtend && Holds(fresh, argument)) { pending.append(argument); }
                    // Capture the canonical address before arguments, and
                    // resolve its current descriptor after all their effects.
                    address := root;
                    current := slot + 1 + extra;
                    if (nested) {
                        // Drop the extra global lease before outer uniqueness;
                        // source value aliases keep their own backing owners.
                        state_index := RetainedArrayState(retained_array_variables, retained_array_fields, retained_array_states,
                            rows[at].value, -1);
                        if (state_index >= 0) {
                            slots.append(type);
                            body.extend([Op(native.Constant, type, current, 0, 0, 0),
                                Op(native.StateStore, type, 0, current, 0, state_index)]);
                            current += 1;
                            extra += 1;
                        }
                        address = current;
                        slots.append(native.RefType + array);
                        selected := Op(native.ArrayValueAddress, native.RefType + array, address, root, stack[base + 1], type);
                        selected.literal = i64(native.ArrayAddressMethod);
                        if (op == facts.ArraySet) { selected.literal = i64(native.ArrayAddressBracket); }
                        body.append(selected);
                        current += 1;
                        extra += 1;
                    } else if (fielded) {
                        locals.append(native.RefType + type);
                        body.append(Op(native.Save, native.RefType + type, 0, root, 0, local));
                        address = current;
                        slots.append(native.RefType + array);
                        field := Op(native.FieldAddress, native.RefType + array, address, local, type, 1);
                        field.literal = operand.literal - 1;
                        if (operand.literal == i64(facts.OptionalArrayPlace)) { field.literal = 1; }
                        body.append(field);
                        current += 1;
                        extra += 1;
                        local += 1;
                    }
                    changed := current + 1;
                    slots.extend([array, array]);
                    body.append(Op(native.Deref, array, current, address, 0, 0));
                    mutation := Op(native.ArrayPush, array, changed, current, argument, 0);
                    mutation.literal = 1;
                    if (op == facts.ArrayExtend) { mutation.op = native.ArrayExtend; }
                    if (op == facts.ArrayRemove) { mutation.op = native.ArrayRemove; mutation.literal = 0; }
                    if (op == facts.ArrayResize) { mutation.op = native.ArrayResize; mutation.literal = 0; }
                    if (op == facts.ArraySet) {
                        mutation = Op(native.ArraySet, array, changed, current, stack[first_argument], argument);
                        mutation.literal = i64(native.ArraySetPlace);
                    }
                    if (op == facts.ArrayReplace) {
                        mutation = Op(native.ArraySet, array, changed, current, stack[first_argument], argument);
                        mutation.literal = i64(native.ArraySetUnchanged);
                    }
                    if (op == facts.ArrayInsert) { mutation = Op(native.ArrayInsert, array, changed, current, stack[first_argument], argument); }
                    if (op == facts.ArrayReverse) { mutation = Op(native.ArrayReverse, array, changed, current, 0, 0); }
                    state_index := RetainedArrayState(retained_array_variables, retained_array_fields, retained_array_states,
                        rows[at].value, int(operand.literal) - 1);
                    state_type := array;
                    if (operand.literal == i64(facts.OptionalArrayPlace)) {
                        retained := SortedIndex(retained_variables, rows[at].value);
                        if (retained >= 0 && UnionHead(rows, declared, retained_types[retained]) >= 0) {
                            state_index = retained_states[retained];
                            state_type = NativeType(retained_types[retained]);
                        }
                    }
                    if (state_index >= 0 && op != facts.ArrayResize) {
                        // No source code runs before the following mutation
                        // and publication. Keep the local owner while dropping
                        // the extra global lease, so unique backing can grow.
                        slots.append(state_type);
                        body.extend([Op(native.Constant, state_type, changed + 1, 0, 0, 0),
                            Op(native.StateStore, state_type, 0, changed + 1, 0, state_index)]);
                        extra += 1;
                    }
                    body.append(mutation);
                    // Resize returns an independent backing rather than
                    // consuming its input, unlike the in-place operations.
                    if (op == facts.ArrayResize) { body.append(Giving(array, current)); }
                    body.append(Op(native.Poke, array, 0, address, changed, 0));
                    extra += 2;
                    item = Op(native.Deref, type, slot, root, 0, 0);
                    retained_record = fielded;
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.ArrayRow) {
                    base := length(stack) - ArrayOperands(operand);
                    // The arrays this row only reads: a fresh one dies with it.
                    op := operand.value;
                    // The copy of an owning variable's array that is the last
                    // thing to read it is that array, moved: the variable is
                    // emptied so that nothing drops it twice.
                    moving = -1;
                    if (op == facts.ArrayCopy) {
                        for (at_read in 0..<length(reads)) {
                            if (reads[at_read] == stack[base] && ReadCount(rows, at, read_vars[at_read]) == 1 &&
                                Dead(rows, declared, at, last, read_vars[at_read], openers, decl_vars, decl_rows)) {
                                moving = read_vars[at_read];
                            }
                        }
                    }
                    for (at_var in 0..<length(owned_vars)) {
                        if (owned_vars[at_var] == moving && owned_types[at_var] == 0) {
                            moving = -1;
                        }
                    }
                    if (op == facts.ArrayLength || op == facts.ArrayGet || op == facts.ArrayPlaceGet || op == facts.ArrayPlaceCheck || op == facts.ArrayContains ||
                        op == facts.ArraySlice || op == facts.ArrayResize || op == facts.ArrayWith ||
                        op == facts.ArrayJoin || op == facts.ArrayCopy || op == facts.ArrayText) {
                        if (Holds(fresh, stack[base])) {
                            pending.append(stack[base]);
                        }
                    }
                    // A later operand can replace even a borrowed element's
                    // array or slot, so acquire its value at the read.
                    retained_element = (op == facts.ArrayGet || op == facts.ArrayPlaceGet) && type == abi.TextStorage;
                    retained_record = (op == facts.ArrayGet || op == facts.ArrayPlaceGet) && TrackedRecord(managed, type);
                    // The record bytes are loaded before a temporary array drops.
                    // A scalar projection never owns or drops its managed siblings.
                    if (retained_record && index + 1 < first + row.count &&
                        rows[index + 1].kind == facts.FieldRow &&
                        (Number(rows[index + 1].type) || rows[index + 1].type == facts.BoolType)) {
                        retained_record = false;
                    }
                    if ((op == facts.ArrayJoin || op == facts.ArrayExtend) && Holds(fresh, stack[base + 1])) {
                        pending.append(stack[base + 1]);
                    }
                    // The strings an array takes as elements.
                    if (op == facts.ArrayNew) {
                        for (element in 0..<operand.count) {
                            if (TrackedRecord(managed, type - native.ArrayType)) {
                                input := stack[base + element];
                                if (Holds(fresh, input)) { fresh = Without(fresh, input); }
                                else {
                                    kept := KeepValue(managed, type - native.ArrayType, input, slot + 1 + extra);
                                    slots.extend(kept.slot_types);
                                    body.extend(kept.code);
                                    extra += length(kept.slot_types);
                                    stack[base + element] = kept.value;
                                }
                            }
                            if (slots[shape.first_slot + stack[base + element]] == abi.TextStorage) {
                                stored.append(stack[base + element]);
                            }
                        }
                    }
                    if ((op == facts.ArrayPush || op == facts.ArrayWith) &&
                        slots[shape.first_slot + stack[base + 1]] == abi.TextStorage) {
                        stored.append(stack[base + 1]);
                    }
                    if ((op == facts.ArrayPush || op == facts.ArrayWith) && TrackedRecord(managed, type - native.ArrayType)) {
                        input := stack[base + 1];
                        if (Holds(fresh, input)) { fresh = Without(fresh, input); }
                        else {
                            kept := KeepValue(managed, type - native.ArrayType, input, slot + 1 + extra);
                            slots.extend(kept.slot_types);
                            body.extend(kept.code);
                            extra += length(kept.slot_types);
                            stack[base + 1] = kept.value;
                        }
                    }
                    if ((op == facts.ArraySet || op == facts.ArrayInsert || op == facts.ArrayInserted ||
                         op == facts.ArrayReplaced || op == facts.ArrayReplace) &&
                        slots[shape.first_slot + stack[base + 2]] == abi.TextStorage) {
                        stored.append(stack[base + 2]);
                    }
                    if (operand.value == facts.ArrayLoan) {
                        input := stack[base];
                        held := slots[shape.first_slot + input];
                        if (held == native.RefType + type) {
                            body.append(Op(native.Deref, type, slot, input, 0, 0));
                            slots.append(type);
                            item = Op(native.ArrayLoan, type, slot + 1, slot, input, 0);
                            slot += 1;
                            if (length(retained_variables) > 0) {
                                origin := SortedIndex(reference_slots, input);
                                if (origin >= 0 && SortedIndex(retained_variables, reference_variables[origin]) >= 0) {
                                    reference_slots.append(slot);
                                    reference_variables.append(reference_variables[origin]);
                                }
                            }
                        } else {
                            mode := 2;
                            if (Holds(fresh, input)) { mode = 1; fresh = Without(fresh, input); }
                            item = Op(native.ArrayLoan, type, slot, input, input, mode);
                        }
                    } else if (operand.value == facts.ArrayNew) {
                        // The empty array, then each element appended.
                        item = Op(native.Constant, type, slot, 0, 0, 0);
                        for (element in 0..<operand.count) {
                            body.append(item);
                            slots.append(type);
                            item = Op(native.ArrayPush, type, slot + 1 + extra, slot, stack[base + element], 0);
                            item.literal = 1;
                            slot += 1 + extra;
                            extra = 0;
                        }
                    } else if (operand.value == facts.ArrayWith || operand.value == facts.ArrayJoin ||
                               operand.value == facts.ArrayWithout || operand.value == facts.ArrayWithoutItem || operand.value == facts.ArrayInserted ||
                               operand.value == facts.ArrayReversed || operand.value == facts.ArrayReplaced) {
                        // Functional changes acquire one owning descriptor;
                        // a fresh input can transfer that owner directly.
                        input := stack[base];
                        if ((operand.value == facts.ArrayWithout || operand.value == facts.ArrayWithoutItem || operand.value == facts.ArrayInserted ||
                             operand.value == facts.ArrayReversed || operand.value == facts.ArrayReplaced) && Holds(fresh, input)) {
                            fresh = Without(fresh, input);
                        } else {
                            body.append(Op(native.ValueCopy, type, slot, input, 0, 0));
                            slots.append(type);
                            input = slot;
                            slot += 1 + extra;
                            extra = 0;
                        }
                        change := native.ArrayPush;
                        right := 0;
                        target := 0;
                        if (operand.count > 1) { right = stack[base + 1]; }
                        if (operand.value == facts.ArrayJoin) { change = native.ArrayExtend; }
                        if (operand.value == facts.ArrayWithout) { change = native.ArrayRemove; }
                        if (operand.value == facts.ArrayWithoutItem) {
                            element := type - native.ArrayType;
                            found_slot := slot + 1 + extra;
                            found := Op(native.ArrayContains, abi.IntStorage, found_slot, input, right, 0);
                            found.literal = i64(element);
                            slots.append(abi.IntStorage);
                            extra += 1;
                            if (element >= native.RecordType) {
                                if (length(comparison_types) == 0) { comparison_types = resize([false], native.ArrayType); }
                                comparison_types[element] = true;
                            }
                            // Composite equality allocates only traversal scratch.
                            // Its allocator can synchronously collect this family.
                            if (element >= native.RecordType && pointer_program) {
                                glue := ManagedPinOwners(owned_vars, owned_types, places, locals, shape.first_local,
                                    fresh, slots, shape.first_slot, frames, slot + 1 + extra, next_root, false, records, value_layout);
                                next_root = glue.next;
                                slots.extend(glue.types);
                                extra += length(glue.types);
                                body.extend(glue.before);
                                comparison_sites.append(shape.first_code + length(body));
                                body.append(found);
                                body.extend(glue.after);
                            } else {
                                if (element >= native.RecordType) { comparison_sites.append(shape.first_code + length(body)); }
                                body.append(found);
                            }
                            if (Holds(fresh, right)) { pending.append(right); }
                            right = found_slot;
                            change = native.ArrayRemove;
                        }
                        if (operand.value == facts.ArrayInserted) { change = native.ArrayInsert; target = stack[base + 2]; }
                        if (operand.value == facts.ArrayReversed) { change = native.ArrayReverse; }
                        if (operand.value == facts.ArrayReplaced) { change = native.ArraySet; target = stack[base + 2]; }
                        item = Op(change, type, slot, input, right, target);
                        if (change == native.ArrayPush || change == native.ArrayExtend) { item.literal = 1; }
                        if (operand.value == facts.ArrayReplaced) { item.literal = i64(native.ArraySetUnchanged); }
                    } else {
                        if ((op == facts.ArrayPush || op == facts.ArrayExtend || op == facts.ArraySet || op == facts.ArrayRemove) &&
                            base == 0 && index == first + row.count - 1 && length(retained_array_variables) > 0) {
                            origin := SortedIndex(any_slots, stack[base]);
                            if (origin >= 0 && any_vars[origin] == rows[at].value) {
                                state_index := RetainedArrayState(retained_array_variables, retained_array_fields, retained_array_states,
                                    rows[at].value, -1);
                                if (state_index >= 0) {
                                    // A later argument may replace the binding.
                                    // Resolve its current owning local only now.
                                    current := slot + 1 + extra;
                                    slots.extend([type, type]);
                                    body.extend([Op(native.Local, type, current, places[rows[at].value], 0, 0),
                                        Op(native.Constant, type, current + 1, 0, 0, 0),
                                        Op(native.StateStore, type, 0, current + 1, 0, state_index)]);
                                    stack[base] = current;
                                    extra += 2;
                                }
                            }
                        }
                        item = ArrayLowered(operand, type, slot, stack, base);
                        if (moving >= 0) {
                            item = Op(native.Local, type, slot, places[moving], 0, 0);
                        }
                        // A variable that owns its array may give back the old
                        // elements when they grow; an array field may not, as a
                        // copy of its record shares them.
                        if ((op == facts.ArrayPush || op == facts.ArrayExtend) && rows[at].kind == facts.AssignRow &&
                            base == 0 && index == first + row.count - 1 && (Holds(owned_vars, rows[at].value) || Referenced(rows, head, rows[at].value))) {
                            item.literal = 1;
                        }
                        if (operand.value == facts.ArrayContains) {
                            // The element type its array holds.
                            item.literal = i64(slots[shape.first_slot + stack[base]] - native.ArrayType);
                        }
                    }
                    if ((op == facts.ArrayPush || op == facts.ArrayExtend || op == facts.ArraySet ||
                         op == facts.ArrayRemove) && Holds(fresh, stack[base])) {
                        fresh = Without(fresh, stack[base]);
                        if (op == facts.ArrayPush || op == facts.ArrayExtend) { item.literal = 1; }
                        mutated_owned = true;
                    }
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.TextRow && operand.value == facts.TextFormat) {
                    // The format and its arguments are argument slots, as a
                    // call's are.
                    item = Op(native.Format, type, slot, 0, shape.arguments, operand.count);
                    base := length(stack) - operand.count;
                    for (argument in 0..<operand.count) {
                        passed := stack[base + argument];
                        arguments.append(passed);
                        if (ArrayTyped(slots[shape.first_slot + passed]) && Holds(fresh, passed)) {
                            pending.append(passed);
                        }
                    }
                    shape.arguments += operand.count;
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.TextRow) {
                    base := length(stack) - operand.count;
                    value := stack[base + facts.TextArgument(operand.count, int(operand.literal), 0)];
                    item = Op(native.TextLength, type, slot, value, 0, 0);
                    if (operand.value == facts.TextPrint) { item.op = native.Print; }
                    if (operand.value == facts.TextByte) {
                        offset := stack[base + facts.TextArgument(operand.count, int(operand.literal), 1)];
                        item = Op(native.TextByte, type, slot, value, offset, 0);
                    }
                    // A slice drops the bytes before its start, then takes its
                    // count of those after it.
                    if (operand.value == facts.TextSlice) {
                        slots.append(type);
                        start := stack[base + facts.TextArgument(operand.count, int(operand.literal), 1)];
                        count := stack[base + facts.TextArgument(operand.count, int(operand.literal), 2)];
                        body.append(Op(native.TextDrop, type, slot, value, start, 0));
                        item = Op(native.TextTake, type, slot + 1, slot, count, 0);
                        slot += 1;
                    }
                    stack = slice(stack, 0, base);
                }
                if (operand.kind == facts.ArrayRow && !array_place && operand.literal == 0 &&
                    (operand.value == facts.ArraySet || operand.value == facts.ArrayInsert || operand.value == facts.ArrayInserted ||
                     operand.value == facts.ArrayReplaced || operand.value == facts.ArrayReplace) &&
                    TrackedRecord(managed, slots[shape.first_slot + item.target])) {
                    // The replaced element may be the incoming value itself.
                    if (Holds(fresh, item.target)) { fresh = Without(fresh, item.target); }
                    else {
                        kept := KeepValue(managed, slots[shape.first_slot + item.target], item.target, slot + 1);
                        slots.extend(kept.slot_types);
                        body.extend(kept.code);
                        extra += length(kept.slot_types);
                        item.target = kept.value;
                    }
                }
                // Update owns its base and incoming field before replacing
                // the previous field. Copy may change an imported descriptor.
                if (operand.kind == facts.UpdateRow) {
                    member := MemberType(rows, declared, operand.type, operand.value);
                    if (TrackedRecord(managed, type)) {
                        if (Holds(fresh, item.left)) { fresh = Without(fresh, item.left); }
                        else {
                            kept := KeepValue(managed, operand.type, item.left, slot + 1 + extra);
                            slots.extend(kept.slot_types);
                            body.extend(kept.code);
                            extra += length(kept.slot_types);
                            item.left = kept.value;
                        }
                        if (Holds(fresh, item.right)) { fresh = Without(fresh, item.right); }
                        else {
                            kept := KeepValue(managed, member, item.right, slot + 1 + extra);
                            slots.extend(kept.slot_types);
                            body.extend(kept.code);
                            extra += length(kept.slot_types);
                            item.right = kept.value;
                        }
                        if (member == facts.StringType || TrackedRecord(managed, member) || ArrayTyped(member)) {
                            old := slot + 1 + extra;
                            slots.append(NativeType(member));
                            extract := Op(native.Extract, NativeType(member), old, item.left, type, 0);
                            extract.literal = i64(operand.value);
                            body.append(extract);
                            dropped := DropValue(managed, member, old);
                            body.extend(dropped.code);
                            extra += 1;
                        }
                    } else if (TrackedRecord(managed, member)) {
                        if (Holds(fresh, item.right)) { fresh = Without(fresh, item.right); }
                        else {
                            kept := KeepValue(managed, member, item.right, slot + 1 + extra);
                            slots.extend(kept.slot_types);
                            body.extend(kept.code);
                            extra += length(kept.slot_types);
                            item.right = kept.value;
                        }
                    }
                }
                for (kept in stored) {
                    if (Holds(fresh, kept)) {
                        fresh = Without(fresh, kept);
                    } else {
                        body.append(Op(native.TextRetain, abi.TextStorage, 0, kept, 0, 0));
                    }
                }
                stored = [];
                if ((pointer_program || waiting_function) && (item.op == native.ClockSample || item.op == native.Call || item.op == native.ForeignCall || item.op == native.AwaitResult || item.op == native.Format)) {
                    glue := ManagedPinOwners(owned_vars, owned_types, places, locals, shape.first_local,
                        fresh, slots, shape.first_slot, frames, slot + 1 + extra, next_root, waiting_function, records, value_layout);
                    next_root = glue.next;
                    slots.extend(glue.types);
                    extra += length(glue.types);
                    body.extend(glue.before);
                    body.append(item);
                    body.extend(glue.after);
                } else { body.append(item); }
                produced := slot;
                if ((operand.kind == facts.ManagedRow && operand.value != facts.ManagedBorrow ||
                    operand.kind == facts.ReadRow && ManagedVariable(pointer_boxes.boxed, operand.value)) &&
                    type >= native.ArrayType && type < native.MapType) {
                    // The cell may be replaced by a later operand. Keep this
                    // evaluated value independently before any callback.
                    kept := KeepValue(managed, operand.type, produced, slot + 1 + extra);
                    slots.extend(kept.slot_types);
                    body.extend(kept.code);
                    extra += length(kept.slot_types);
                    produced = kept.value;
                    fresh.append(produced);
                }
                if (operand.kind == facts.ReadRow && type == abi.TextStorage && length(string_references) > 0 &&
                    (string_references[operand.value] || (scoped_string_reference && Referenced(rows, head, operand.value)))) {
                    body.append(Op(native.TextRetain, abi.TextStorage, 0, slot, 0, 0));
                    if (length(closes) > 0) { logical_strings.append(slot); }
                    else { fresh.append(slot); }
                }
                if (operand.kind == facts.ReadRow && TrackedRecord(managed, type)) {
                    // Later operands can replace the source through a scoped
                    // call. Projected reads copy only the selected field;
                    // direct returns use the existing owned-variable move.
                    projected := index + 1 < first + row.count &&
                                 (rows[index + 1].kind == facts.FieldRow || rows[index + 1].kind == facts.PayloadRow ||
                                  rows[index + 1].kind == facts.TagRow || rows[index + 1].kind == facts.UnwrapRow ||
                                  rows[index + 1].kind == facts.OptionalFieldRow);
                    if (!projected && !(row.kind == facts.ReturnRow && row.count == 1)) {
                        kept := KeepValue(managed, operand.type, slot, slot + 1 + extra);
                        slots.extend(kept.slot_types);
                        body.extend(kept.code);
                        extra += length(kept.slot_types);
                        produced = kept.value;
                        fresh.append(produced);
                    }
                }
                if (operand.kind == facts.UpdateRow && TrackedRecord(managed, type)) { fresh.append(produced); }
                if ((operand.kind == facts.FieldRow || operand.kind == facts.PayloadRow || operand.kind == facts.TagRow ||
                     operand.kind == facts.UnwrapRow) &&
                    TrackedRecord(managed, item.right)) {
                    // A later operand may replace even a non-temporary base.
                    kept := KeepValue(managed, operand.type, produced, slot + 1 + extra);
                    slots.extend(kept.slot_types);
                    body.extend(kept.code);
                    extra += length(kept.slot_types);
                    produced = kept.value;
                    if (type == abi.TextStorage && length(closes) > 0) { logical_strings.append(produced); }
                    else if (type == abi.TextStorage || TrackedRecord(managed, type) ||
                             (type >= native.ArrayType && type < native.MapType)) { fresh.append(produced); }
                    if (Holds(fresh, item.left)) {
                        dropped := DropValue(managed, item.right, item.left);
                        slots.extend(dropped.slot_types);
                        body.extend(dropped.code);
                        extra += length(dropped.slot_types);
                        fresh = Without(fresh, item.left);
                    }
                }
                if (item.op == native.Call) {
                    for (argument in 0..<item.target) {
                        passed := arguments[shape.first_argument + item.right + argument];
                        held := slots[shape.first_slot + passed];
                        if (TrackedRecord(managed, held) && Holds(fresh, passed)) {
                            dropped := DropValue(managed, held, passed);
                            slots.extend(dropped.slot_types);
                            body.extend(dropped.code);
                            extra += length(dropped.slot_types);
                            fresh = Without(fresh, passed);
                        }
                    }
                    if (TrackedRecord(managed, type)) { fresh.append(produced); }
                }
                if (operand.kind == facts.MakeRow && TrackedRecord(managed, type)) { fresh.append(produced); }
                if (operand.kind == facts.ViewRow && facts.ViewOperation(operand.value) == facts.ViewSlice &&
                    TrackedRecord(managed, type)) { fresh.append(produced); }
                if (retained_record) {
                    kept := KeepValue(managed, operand.type, produced, slot + 1 + extra);
                    slots.extend(kept.slot_types);
                    body.extend(kept.code);
                    extra += length(kept.slot_types);
                    produced = kept.value;
                    fresh.append(produced);
                }
                if (retained_array) {
                    kept := KeepValue(managed, operand.type, produced, slot + 1 + extra);
                    slots.extend(kept.slot_types);
                    body.extend(kept.code);
                    extra += length(kept.slot_types);
                    produced = kept.value;
                }
                if (retained_element) {
                    body.append(Op(native.TextRetain, abi.TextStorage, 0, slot, 0, 0));
                }
                for (spent in pending) {
                    held_type := slots[shape.first_slot + spent];
                    if (TrackedRecord(managed, held_type)) { body.append(Op(native.ValueDrop, held_type, 0, spent, 0, 0)); }
                    else { body.append(Giving(held_type, spent)); }
                    fresh = Without(fresh, spent);
                }
                pending = [];
                fresh_value := (FreshArray(operand) && !array_place) || retained_element || mutated_owned;
                if (fresh_value && length(closes) > 0 && type == abi.TextStorage) {
                    logical_strings.append(produced);
                } else if (fresh_value) {
                    fresh.append(produced);
                } else if ((operand.kind == facts.CallRow || operand.kind == facts.MakeRow) &&
                           !TrackedRecord(managed, type) && HoldsArrays(rows, declared, type)) {
                    // A union that holds arrays and that nothing else holds.
                    fresh.append(slot);
                }
                stack.append(produced);
                slot += 1 + extra;
                if (moving >= 0) {
                    for (at_var in 0..<length(owned_vars)) {
                        if (owned_vars[at_var] == moving) {
                            slots.append(owned_types[at_var]);
                            body.extend([Op(native.Constant, owned_types[at_var], slot, 0, 0, 0),
                                         Op(native.Save, owned_types[at_var], 0, slot, 0, places[moving])]);
                            slot += 1;
                        }
                    }
                    moving = -1;
                }
                if (length(retained_variables) > 0 && (item.op == native.ClockSample || item.op == native.Call || item.op == native.ForeignCall)) {
                    // A scoped call or writable foreign loan can mutate a
                    // retained local. Publish it before later expression calls
                    // or control-flow exits, while the binding is in scope.
                    for (argument in 0..<item.target) {
                        // A readonly alias cannot replace a recursive call's
                        // state with the outer invocation's cached snapshot.
                        // Filter before deduplication: a later alias may write.
                        if (item.op == native.Call && rows[heads[item.left] + 1 + argument].literal ==
                            i64(facts.ParameterReadonlyReference)) { continue; }
                        passed := arguments[shape.first_argument + item.right + argument];
                        origin := SortedIndex(reference_slots, passed);
                        if (origin < 0) { continue; }
                        variable := reference_variables[origin];
                        retained := SortedIndex(retained_variables, variable);
                        if (retained < 0 || retained_published[retained] == index + 1) { continue; }
                        retained_published[retained] = index + 1;
                        held_type := NativeType(retained_types[retained]);
                        slots.append(held_type);
                        body.append(Op(native.Local, held_type, slot, places[variable], 0, 0));
                        lowered := RetainedValue(rows, declared, retained_types[retained], slot, "", retained_states[retained], 0, slot + 1, false);
                        slots.extend(lowered.types);
                        body.extend(lowered.code);
                        slot += 1 + length(lowered.types);
                    }
                }
            }
            value := stack[0];
            ends = false;
            // A record that took an owning variable's array without a copy now
            // shares it, so the variable no longer drops it. (A return drops
            // around them.)
            if (row.kind != facts.ReturnRow) {
                for (taken in escaped) {
                    for (at_var in 0..<length(owned_vars)) {
                        if (owned_vars[at_var] == taken) {
                            owned_types[at_var] = 0;
                        }
                    }
                }
            }
            // A statement that keeps a string takes a reference to it: a fresh
            // string moves in, any other is retained. A variable it replaces
            // gives its reference back, after the new one is taken. Every fresh
            // string left over, a temporary, is released here, after the
            // statement's rows have read it and before it branches or stores.
            keeps := false;
            if ((slots[shape.first_slot + value] == abi.TextStorage || slots[shape.first_slot + value] == native.TaskType) &&
                (row.kind == facts.LocalRow || row.kind == facts.AssignRow || row.kind == facts.ReturnRow)) {
                held_by := -1;
                for (at_read in 0..<length(reads)) {
                    if (reads[at_read] == value) {
                        held_by = read_vars[at_read];
                    }
                }
                if (row.kind == facts.LocalRow && (row.name == "_" || row.literal == i64(facts.Retained) ||
                    row.literal == i64(facts.Retained | facts.CharNominal))) {
                    keeps = false;
                } else if (row.kind == facts.ReturnRow && held_by >= 0 && Holds(owned_vars, held_by)) {
                    // The variable returned moves out.
                    keeps = false;
                } else if (Holds(fresh, value)) {
                    fresh = Without(fresh, value);
                    keeps = true;
                } else {
                    if (slots[shape.first_slot + value] == native.TaskType) {
                        slots.append(native.TaskType);
                        body.append(Op(native.TaskCopy, native.TaskType, slot, value, 0, 0));
                        value = slot;
                        slot += 1;
                    } else { body.append(Op(native.TextRetain, abi.TextStorage, 0, value, 0, 0)); }
                    keeps = true;
                }
            }
            if (keeps && row.kind == facts.AssignRow && !Referenced(rows, head, row.value) &&
                Holds(owned_vars, row.value)) {
                held_type := slots[shape.first_slot + value];
                slots.append(held_type);
                body.extend([Op(native.Local, held_type, slot, places[row.value], 0, 0), Giving(held_type, slot)]);
                slot += 1;
            }
            record_keeps := TrackedRecord(managed, slots[shape.first_slot + value]) &&
                            (row.kind == facts.LocalRow || row.kind == facts.AssignRow || row.kind == facts.ReturnRow);
            if (record_keeps && row.kind == facts.LocalRow && (row.name == "_" || row.literal == i64(facts.Retained) ||
                row.literal == i64(facts.Retained | facts.CharNominal))) {
                record_keeps = false;
            }
            if (record_keeps) {
                type := slots[shape.first_slot + value];
                returning_owner := false;
                if (row.kind == facts.ReturnRow) {
                    for (at_read in 0..<length(reads)) {
                        returning_owner = returning_owner || (reads[at_read] == value && Holds(owned_vars, read_vars[at_read]));
                    }
                }
                if (Holds(fresh, value)) { fresh = Without(fresh, value); }
                else if (!returning_owner) {
                    kept := KeepValue(managed, type, value, slot);
                    slots.extend(kept.slot_types);
                    body.extend(kept.code);
                    value = kept.value;
                    slot += length(kept.slot_types);
                }
                if (row.kind == facts.AssignRow && !Referenced(rows, head, row.value) && Holds(owned_vars, row.value)) {
                    slots.append(type);
                    body.append(Op(native.Local, type, slot, places[row.value], 0, 0));
                    dropped := DropValue(managed, type, slot);
                    slots.extend(dropped.slot_types);
                    body.extend(dropped.code);
                    slot += 1 + length(dropped.slot_types);
                }
            }
            leftover: int[] = [];
            for (temporary in fresh) {
                if (slots[shape.first_slot + temporary] == abi.TextStorage || slots[shape.first_slot + temporary] == native.TaskType) {
                    body.append(Giving(slots[shape.first_slot + temporary], temporary));
                } else if (TrackedRecord(managed, slots[shape.first_slot + temporary])) {
                    dropped := DropValue(managed, slots[shape.first_slot + temporary], temporary);
                    slots.extend(dropped.slot_types);
                    body.extend(dropped.code);
                    slot += length(dropped.slot_types);
                } else {
                    leftover.append(temporary);
                }
            }
            fresh = leftover;
            if (MapIterated(row)) {
                // A traversal saves one descriptor. A fresh temporary or a
                // producer's snapshot owns it until every exit leaves the loop.
                map := NativeType(row.type);
                element := NativeType((row.type - facts.MapType) / 16);
                key := NativeType((row.type - facts.MapType) % 16);
                frame: Frame = {kind: row.kind, skip: -1, leave: -1, ends: false, head: 0, index: local + 1,
                                bound: local, counted: false, reverse: false, escape: length(jumps), empty: -1,
                                exits: 0, armed: false, fallback: -1, owned: length(owned_vars), held: -1, held_type: 0, pattern_first: -1};
                if (Holds(fresh, stack[0])) {
                    fresh = Without(fresh, stack[0]);
                    frame.held = local;
                    frame.held_type = map;
                }
                locals.extend([map, integer, element]);
                if (Keyed(row)) {
                    locals.append(key);
                    places.extend([local + 3, local + 2]);
                } else {
                    places.append(local + 2);
                }
                slots.append(integer);
                body.extend([Op(native.Save, map, 0, stack[0], 0, local), Op(native.Constant, integer, slot, 0, 0, 0),
                             Op(native.Save, integer, 0, slot, 0, local + 1)]);
                slot += 1;
                frame.head = length(body);
                span := Op(native.MapSpan, integer, slot + 2, slot + 1, 0, 0);
                span.literal = i64(map);
                slots.extend([integer, map, integer, abi.BoolStorage]);
                body.extend([Op(native.Local, integer, slot, local + 1, 0, 0),
                             Op(native.Local, map, slot + 1, local, 0, 0), span,
                             Op(native.Lt, integer, slot + 3, slot, slot + 2, 0),
                             Op(native.Branch, 0, 0, slot + 3, 0, length(body) + 6)]);
                frame.skip = length(body);
                body.append(Op(native.Jump, 0, 0, 0, 0, 0));
                live := Op(native.MapLiveAt, abi.BoolStorage, slot + 4, slot + 1, slot, 0);
                live.literal = i64(map);
                slots.append(abi.BoolStorage);
                body.extend([live, Op(native.Branch, 0, 0, slot + 4, 0, length(body) + 3)]);
                // A tombstone takes the same step as continue, without
                // entering the body or reading its dead key/value.
                jumps.append(length(body));
                continuing.append(true);
                body.append(Op(native.Jump, 0, 0, 0, 0, 0));
                get := Op(native.MapValueAt, element, slot + 5, slot + 1, slot, 0);
                get.literal = i64(map);
                slots.append(element);
                body.extend([get, Op(native.Save, element, 0, slot + 5, 0, local + 2)]);
                if (Keyed(row)) {
                    read_key := Op(native.MapKeyAt, key, slot + 6, slot + 1, slot, 0);
                    read_key.literal = i64(map);
                    slots.append(key);
                    body.extend([read_key, Op(native.Save, key, 0, slot + 6, 0, local + 3)]);
                    slot += 1;
                    local += 1;
                }
                slot += 6;
                local += 3;
                frames.append(frame);
            } else if (Arrayed(row)) {
                // The array and the index of the next element are locals of
                // their own, before the element's variable.
                array := NativeType(facts.ArrayType + row.type);
                element := NativeType(row.type);
                reverse := (row.literal & i64(facts.RangeReverse)) != 0;
                frame: Frame = {kind: row.kind, skip: -1, leave: -1, ends: false, head: 0, index: local + 1,
                                bound: local, counted: false, reverse: reverse, escape: length(jumps), empty: -1,
                                exits: 0, armed: false, fallback: -1, owned: length(owned_vars), held: -1, held_type: 0, pattern_first: -1};
                // A loop over a fresh array owns it, in a local of its own.
                if (Holds(fresh, stack[0])) {
                    fresh = Without(fresh, stack[0]);
                    frame.held = local;
                    frame.held_type = array;
                }
                locals.extend([array, integer, element]);
                places.append(local + 2);
                if (Keyed(row)) {
                    places.append(local + 1);
                }
                body.append(Op(native.Save, array, 0, stack[0], 0, local));
                if (reverse) {
                    // Length zero starts at the signed sentinel -1. The
                    // head rejects it before any element access.
                    one := Op(native.Constant, integer, slot + 1, 0, 0, 0);
                    one.literal = 1;
                    slots.extend([integer, integer, integer]);
                    body.extend([Op(native.ArrayLength, integer, slot, stack[0], 0, 0), one,
                                 Op(native.Sub, integer, slot + 2, slot, slot + 1, 0),
                                 Op(native.Save, integer, 0, slot + 2, 0, local + 1)]);
                    slot += 3;
                } else {
                    slots.append(integer);
                    body.extend([Op(native.Constant, integer, slot, 0, 0, 0),
                                 Op(native.Save, integer, 0, slot, 0, local + 1)]);
                    slot += 1;
                }
                frame.head = length(body);
                if (reverse) {
                    slots.extend([integer, integer, abi.BoolStorage]);
                    body.extend([Op(native.Local, integer, slot, local + 1, 0, 0),
                                 Op(native.Constant, integer, slot + 1, 0, 0, 0),
                                 Op(native.Ge, integer, slot + 2, slot, slot + 1, 0),
                                 Op(native.Branch, 0, 0, slot + 2, 0, length(body) + 5)]);
                    slot += 3;
                } else {
                    slots.extend([integer, array, integer, abi.BoolStorage]);
                    body.extend([Op(native.Local, integer, slot, local + 1, 0, 0),
                                 Op(native.Local, array, slot + 1, local, 0, 0),
                                 Op(native.ArrayLength, integer, slot + 2, slot + 1, 0, 0),
                                 Op(native.Lt, integer, slot + 3, slot, slot + 2, 0),
                                 Op(native.Branch, 0, 0, slot + 3, 0, length(body) + 6)]);
                    slot += 4;
                }
                frame.skip = length(body);
                body.append(Op(native.Jump, 0, 0, 0, 0, 0));
                slots.extend([array, integer, element]);
                body.extend([Op(native.Local, array, slot, local, 0, 0), Op(native.Local, integer, slot + 1, local + 1, 0, 0),
                             Op(native.ArrayGet, element, slot + 2, slot, slot + 1, 0),
                             Op(native.Save, element, 0, slot + 2, 0, local + 2)]);
                slot += 3;
                local += 3;
                frames.append(frame);
            } else if (row.kind == facts.ForRow) {
                exclusive := row.literal == i64(facts.RangeExclusive) ||
                             row.literal == i64(facts.RangeExclusive + facts.RangeReverse);
                reverse := row.literal >= i64(facts.RangeReverse);
                frame: Frame = {kind: row.kind, skip: -1, leave: -1, ends: false, head: 0, index: local,
                                bound: local + 1, counted: reverse || !exclusive, reverse: reverse,
                                escape: length(jumps), empty: -1, exits: 0, armed: false,
                                fallback: -1, owned: length(owned_vars), held: -1, held_type: 0, pattern_first: -1};
                begin := stack[0];
                stop := stack[1];
                if (reverse) {
                    begin = stack[1];
                    stop = stack[0];
                }
                if (reverse && exclusive) {
                    // Counting down from below the last bound needs a range
                    // that is not empty, or it would wrap.
                    slots.extend([abi.BoolStorage, integer, integer]);
                    body.append(Op(native.Lt, integer, slot, stack[0], stack[1], 0));
                    body.append(Op(native.Branch, 0, 0, slot, 0, length(body) + 2));
                    frame.empty = length(body);
                    one := Op(native.Constant, integer, slot + 1, 0, 0, 0);
                    one.literal = 1;
                    body.extend([Op(native.Jump, 0, 0, 0, 0, 0), one,
                                 Op(native.Sub, integer, slot + 2, stack[1], slot + 1, 0)]);
                    begin = slot + 2;
                    slot += 3;
                }
                locals.extend([integer, integer]);
                places.append(local);
                local += 2;
                body.extend([Op(native.Save, integer, 0, begin, 0, frame.index),
                             Op(native.Save, integer, 0, stop, 0, frame.bound)]);
                frame.head = length(body);
                compare := native.Lt;
                if (reverse) {
                    compare = native.Ge;
                } else if (!exclusive) {
                    compare = native.Le;
                }
                slots.extend([integer, integer, abi.BoolStorage]);
                body.extend([Op(native.Local, integer, slot, frame.index, 0, 0),
                             Op(native.Local, integer, slot + 1, frame.bound, 0, 0),
                             Op(compare, integer, slot + 2, slot, slot + 1, 0),
                             Op(native.Branch, 0, 0, slot + 2, 0, length(body) + 5)]);
                frame.skip = length(body);
                body.append(Op(native.Jump, 0, 0, 0, 0, 0));
                slot += 3;
                frames.append(frame);
            } else if (row.kind == facts.ReturnRow) {
                // Every owning variable of every open scope drops, but the one
                // the result is: a returned variable's array moves to the caller.
                moved := escaped;
                for (at_read in 0..<length(reads)) {
                    if (reads[at_read] == value) {
                        moved.append(read_vars[at_read]);
                    }
                }
                drops := DropAll(rows, declared, managed, owned_vars, owned_types, places, 0, moved, frames, true, slot, length(body));
                slots.extend(drops.slot_types);
                slot += length(drops.slot_types);
                body.extend(drops.code);
                body.extend([Op(native.Publish, result, 0, value, 0, 0), Op(native.Return, 0, 0, 0, 0, 0)]);
                ends = true;
            } else if (row.kind == facts.AssertRow) {
                fail := Op(native.Fail, 0, 0, row.start, row.end, 0);
                fail.literal = declaration.literal;
                if (program && row.text != "") {
                    texts.append(row.text);
                    fail.target = length(texts);
                }
                if (waiting_function) {
                    glue := ManagedPinOwners(owned_vars, owned_types, places, locals, shape.first_local,
                        fresh, slots, shape.first_slot, frames, slot, next_root, waiting_function, records, value_layout);
                    next_root = glue.next;
                    slots.extend(glue.types);
                    slot += length(glue.types);
                    body.append(Op(native.Branch, 0, 0, value, 0, length(body) + length(glue.before) + length(glue.after) + 2));
                    body.extend(glue.before);
                    body.append(fail);
                    body.extend(glue.after);
                } else {
                    // A failed synchronous assertion exits this frame just as
                    // a return does. Condition evaluation and its borrowed
                    // arguments have finished before the owners are released.
                    skip_failure := length(body);
                    body.append(Op(native.Branch, 0, 0, value, 0, 0));
                    drops := DropAll(rows, declared, managed, owned_vars, owned_types, places, 0, [], frames, true, slot, length(body));
                    slots.extend(drops.slot_types);
                    slot += length(drops.slot_types);
                    body.extend(drops.code);
                    body.append(fail);
                    body = Patched(body, skip_failure);
                }
            } else if (row.kind == facts.LocalRow && (row.literal == i64(facts.Retained) ||
                       row.literal == i64(facts.Retained | facts.CharNominal))) {
                type := NativeType(row.type);
                lowered := RetainedValue(rows, declared, row.type, value, format_text("{}.{}", declaration.name, row.name),
                                         states, length(texts), slot, true, row.literal == i64(facts.Retained | facts.CharNominal));
                state_characters.extend(lowered.characters);
                if (rows[1].text != "") {
                    // The legacy word manifest reads defaults before Frame.
                    // Its validated scalar literal is an eager global, while
                    // package generations keep per-key lazy initialization.
                    load := lowered.code[0];
                    load.left = 0;
                    load.literal = rows[at + 1].literal;
                    lowered.code[0] = load;
                }
                slots.extend(lowered.types);
                body.extend(lowered.code);
                texts.extend(lowered.texts);
                slot += length(lowered.types);
                states += lowered.states;
                locals.append(type);
                places.append(local);
                retained_variables.append(row.value);
                retained_published.append(0);
                retained_states.append(states - lowered.states);
                retained_types.append(row.type);
                for (field in 0..<length(lowered.array_fields)) {
                    retained_array_variables.append(row.value);
                    retained_array_fields.append(lowered.array_fields[field]);
                    retained_array_states.append(lowered.array_states[field]);
                }
                body.append(Op(native.Save, type, 0, lowered.value, 0, local));
                local += 1;
                // The frame's snapshot and the global state own independent
                // references, so replacement cannot invalidate local copies.
                if (type == abi.TextStorage) {
                    body.append(Op(native.TextRetain, type, 0, lowered.value, 0, 0));
                    owned_vars.append(row.value);
                    owned_types.append(type);
                } else if (TrackedRecord(managed, type) || (type >= native.ArrayType && type < native.MapType)) {
                    kept := KeepValue(managed, row.type, lowered.value, slot);
                    slots.extend(kept.slot_types);
                    body.extend(kept.code);
                    body.append(Op(native.Save, type, 0, kept.value, 0, places[row.value]));
                    slot += length(kept.slot_types);
                    owned_vars.append(row.value);
                    owned_types.append(type);
                }
            } else if (row.kind == facts.LocalRow) {
                type := NativeType(row.type);
                decl_vars.append(row.value);
                decl_rows.append(at);
                boxed := ManagedVariable(pointer_boxes.boxed, row.value);
                local_type := type;
                if (boxed) { local_type = native.PointerType; }
                locals.append(local_type);
                places.append(local);
                if (boxed) {
                    slots.append(native.PointerType);
                    glue := ManagedPinOwners(owned_vars, owned_types, places, locals, shape.first_local,
                        fresh, slots, shape.first_slot, frames, slot + 1, next_root, waiting_function, records, value_layout);
                    next_root = glue.next;
                    slots.extend(glue.types);
                    body.extend(glue.before);
                    made := Op(native.ManagedNew, native.PointerType, slot, value, type, 0);
                    made.literal = pointer_boxes.tags[row.value];
                    body.append(made);
                    body.extend(glue.after);
                    body.append(Op(native.Save, native.PointerType, 0, slot, 0, local));
                    slot += 1 + length(glue.types);
                } else if (type == native.TaskType && row.name == "_") {
                    slots.append(type);
                    body.extend([Op(native.Constant, type, slot, 0, 0, 0), Op(native.Save, type, 0, slot, 0, local)]);
                    slot += 1;
                } else { body.append(Op(native.Save, type, 0, value, 0, local)); }
                // A variable holding a fresh array owns it; a discarded call
                // result is dropped at once; any other array is borrowed.
                if (ArrayTyped(type) && Holds(fresh, value)) {
                    fresh = Without(fresh, value);
                    if (boxed || row.name == "_") {
                        body.append(Giving(type, value));
                    } else {
                        owned_vars.append(row.value);
                        owned_types.append(type);
                    }
                }
                if (keeps || record_keeps) {
                    owned_vars.append(row.value);
                    owned_types.append(type);
                }
                // A variable holding a fresh union that holds arrays owns it, unless it is
                // read for more than its tag and payloads or addressed; a discarded one is
                // dropped at once.
                if (Holds(fresh, value) && !ArrayTyped(type) && HoldsArrays(rows, declared, type)) {
                    fresh = Without(fresh, value);
                    if (row.name == "_") {
                        glue := UnionDrop(UnionPayloads(rows, declared, type), type, 0, value, slot, length(body));
                        slots.extend(glue.slot_types);
                        slot += length(glue.slot_types);
                        body.extend(glue.code);
                    } else if (!Holds(stale_unions, row.value) && !Referenced(rows, head, row.value)) {
                        owned_vars.append(row.value);
                        owned_types.append(type);
                    }
                }
                // The arm that binds an array payload of an owned union takes it over when
                // nothing reads the union's payloads after the switch: the binding owns the array
                // and the union's field is emptied, so that its drop frees nothing twice.
                for (at_payload in 0..<length(payload_slots)) {
                    if (payload_slots[at_payload] != value || !ArrayTyped(type) || Holds(owned_vars, row.value)) {
                        continue;
                    }
                    source := payload_vars[at_payload];
                    union_at := -1;
                    for (at_own in 0..<length(owned_vars)) {
                        if (owned_vars[at_own] == source && owned_types[at_own] != 0 && !ArrayTyped(owned_types[at_own])) {
                            union_at = at_own;
                        }
                    }
                    if (union_at < 0) {
                        continue;
                    }
                    taken := Holds(temp_subjects, source);
                    if (!taken && parents[at] > 0 && rows[parents[at] - 1].kind == facts.SwitchRow) {
                        taken = DeadFrom(rows, declared, Closed(rows, parents[at] - 1) + 1, last, source, openers,
                                         decl_vars, decl_rows);
                    }
                    if (taken) {
                        owned_vars.append(row.value);
                        owned_types.append(type);
                        union_type := owned_types[union_at];
                        slots.extend([union_type, type, union_type]);
                        empty := Op(native.Constant, type, slot + 1, 0, 0, 0);
                        emptied := Op(native.Insert, union_type, slot + 2, slot, slot + 1, 0);
                        emptied.literal = i64(payload_fields[at_payload]);
                        body.extend([Op(native.Local, union_type, slot, places[source], 0, 0), empty, emptied,
                                     Op(native.Save, union_type, 0, slot + 2, 0, places[source])]);
                        slot += 3;
                    }
                }
                if (row.literal == i64(facts.SwitchSubject)) {
                    // A call's result: the arm that binds a payload takes it over.
                    if (rows[first + row.count - 1].kind == facts.CallRow) {
                        temp_subjects.append(row.value);
                    }
                }
                local += 1;
            } else if (row.kind == facts.AssignRow && ManagedVariable(pointer_boxes.boxed, row.value)) {
                type := NativeType(row.type);
                slots.extend([native.PointerType, native.RefType + type]);
                body.append(Op(native.Local, native.PointerType, slot, places[row.value], 0, 0));
                address := Op(native.ManagedAddress, native.RefType + type, slot + 1, slot, 0, 0);
                address.literal = pointer_boxes.tags[row.value];
                body.append(address);
                if (type >= native.ArrayType && type < native.MapType) {
                    incoming := value;
                    next := slot + 2;
                    if (Holds(fresh, incoming)) { fresh = Without(fresh, incoming); }
                    else {
                        slots.append(type);
                        body.append(Op(native.ValueCopy, type, next, incoming, 0, 0));
                        incoming = next;
                        next += 1;
                    }
                    slots.append(type);
                    body.extend([Op(native.Deref, type, next, slot + 1, 0, 0), Giving(type, next),
                        Op(native.Poke, type, 0, slot + 1, incoming, 0)]);
                    slot = next + 1;
                } else {
                    body.append(Op(native.Poke, type, 0, slot + 1, value, 0));
                    slot += 2;
                }
            } else if (row.kind == facts.AssignRow && Referenced(rows, head, row.value)) {
                // The value goes where the reference points.
                type := NativeType(row.type);
                slots.append(native.RefType + type);
                body.append(Op(native.Local, native.RefType + type, slot, places[row.value], 0, 0));
                if (TrackedRecord(managed, type)) {
                    pointer := slot;
                    slots.append(type);
                    body.append(Op(native.Deref, type, slot + 1, pointer, 0, 0));
                    dropped := DropValue(managed, row.type, slot + 1);
                    slots.extend(dropped.slot_types);
                    body.extend(dropped.code);
                    body.append(Op(native.Poke, type, 0, pointer, value, 0));
                    slot += 2 + length(dropped.slot_types);
                } else if (type == abi.TextStorage || (ArrayTyped(type) && Holds(fresh, value))) {
                    // A replacement owns fresh allocations. The old container must
                    // be dropped after the value has finished reading it.
                    // In-place MapSet/Delete results are consumed descriptors,
                    // not fresh allocations, and already release their growth.
                    if (type != abi.TextStorage) { fresh = Without(fresh, value); }
                    slots.append(type);
                    body.extend([Op(native.Deref, type, slot + 1, slot, 0, 0), Giving(type, slot + 1)]);
                    body.append(Op(native.Poke, type, 0, slot, value, 0));
                    slot += 2;
                } else {
                    body.append(Op(native.Poke, type, 0, slot, value, 0));
                    slot += 1;
                }
            } else if (row.kind == facts.AssignRow) {
                type := NativeType(row.type);
                // An owning variable given a fresh array drops its old one,
                // after the new one is made, so `a = f(a)` reads it first.
                if (ArrayTyped(type) && Holds(owned_vars, row.value) && Holds(fresh, value)) {
                    fresh = Without(fresh, value);
                    slots.append(type);
                    body.extend([Op(native.Local, type, slot, places[row.value], 0, 0),
                                 Giving(type, slot)]);
                    slot += 1;
                } else if (!ArrayTyped(type) && Holds(owned_vars, row.value) && Holds(fresh, value) &&
                           HoldsArrays(rows, declared, type)) {
                    fresh = Without(fresh, value);
                    glue := UnionDrop(UnionPayloads(rows, declared, type), type, places[row.value], -1, slot, length(body));
                    slots.extend(glue.slot_types);
                    slot += length(glue.slot_types);
                    body.extend(glue.code);
                }
                body.append(Op(native.Save, type, 0, value, 0, places[row.value]));
                // A retained variable's state follows it.
                for (retained in 0..<length(retained_variables)) {
                    if (retained_variables[retained] == row.value) {
                        slots.append(type);
                        body.append(Op(native.Local, type, slot, places[row.value], 0, 0));
                        lowered := RetainedValue(rows, declared, row.type, slot, "", retained_states[retained], 0, slot + 1, false);
                        slots.extend(lowered.types);
                        body.extend(lowered.code);
                        slot += 1 + length(lowered.types);
                    }
                }
            } else if (row.kind == facts.SwitchRow) {
                type := NativeType(row.type);
                locals.append(type);
                body.append(Op(native.Save, type, 0, value, 0, local));
                frame: Frame = {kind: row.kind, skip: -1, leave: -1, ends: true, head: 0, index: local, bound: 0,
                                counted: false, reverse: false, escape: length(jumps), empty: -1,
                                exits: length(arms), armed: false, fallback: -1, owned: length(owned_vars), held: -1, held_type: 0, pattern_first: -1};
                frames.append(frame);
                local += 1;
            } else if (row.kind == facts.CaseRow) {
                // Equal to the switch's value, the arm runs; otherwise the
                // test after it does.
                frame := frames[top];
                type := NativeType(row.type);
                slots.extend([type, abi.BoolStorage]);
                body.extend([Op(native.Local, type, slot, frame.index, 0, 0), Op(native.Eq, type, slot + 1, slot, value, 0),
                             Op(native.Branch, 0, 0, slot + 1, 0, length(body) + 4)]);
                frame.skip = length(body);
                body.append(Op(native.Jump, 0, 0, 0, 0, 0));
                frames[top] = frame;
                slot += 2;
            } else {
                frame: Frame = {kind: row.kind, skip: length(body) + 1, leave: -1, ends: false, head: start, index: 0,
                                bound: 0, counted: false, reverse: false, escape: length(jumps), empty: -1, exits: 0,
                                armed: false, fallback: -1, owned: length(owned_vars), held: -1, held_type: 0, pattern_first: -1};
                if (row.kind == facts.WhileRow && row.literal == i64(facts.PatternLoop)) {
                    frame.pattern_first = frames[top].owned;
                }
                body.extend([Op(native.Branch, 0, 0, value, 0, length(body) + 2), Op(native.Jump, 0, 0, 0, 0, 0)]);
                frames.append(frame);
            }
            at = first + row.count;
        }
        // An endless loop's exit, which nothing reaches, still needs an
        // instruction to name.
        for (item in body) {
            if ((item.op == native.Branch || item.op == native.Jump) && item.target == length(body)) {
                body.append(Op(native.End, 0, 0, 0, 0, 0));
                break;
            }
        }
        while (length(lines) < length(code) + length(body)) {
            lines.append(line);
            columns.append(column);
        }
        shape.slots = slot;
        shape.locals = local;
        shape.code = length(body);
        code.extend(body);
        functions.append(shape);
    }
    entries := -1;
    if (generation) {
        entries = 0;
        if (names.contains("Main")) { entries |= 1; }
        if (names.contains("Frame")) { entries |= 2; }
        // The host always calls the same C ABI. An absent source entry does
        // nothing, so adding/removing Frame never restarts Main on an edit.
        for (name in ["Main", "Frame"]) {
            if (names.contains(name)) { continue; }
            shape: native.Function = {result: abi.IntStorage, first_parameter: length(parameters), parameters: 0,
                                      first_slot: length(slots), slots: 1, first_local: length(locals), locals: 0,
                                      first_code: length(code), code: 4, first_argument: length(arguments), arguments: 0};
            ids.append(i64(length(functions)));
            names.append(name);
            slots.append(abi.IntStorage);
            code.extend([Op(native.Check, 0, 0, 0, 0, 0), Op(native.Constant, abi.IntStorage, 0, 0, 0, 0),
                         Op(native.Publish, abi.IntStorage, 0, 0, 0, 0), Op(native.Return, 0, 0, 0, 0, 0)]);
            functions.append(shape);
        }
    }
    source: native.Source = {file: "", directory: ""};
    if (debug) {
        source = {file: rows[0].name, directory: directory};
    }
    // A library's Document row names it; a package generation has its own
    // manifest name, not a prepared artifact's stable library identity.
    value_shapes: native.SnapshotShapes = {nodes: [], edges: [], roots: []};
    if (length(comparison_sites) > 0) {
        roots := resize([int(0)], states);
        characters := state_characters;
        for (item in code) { if (item.op == native.StateLoad) { roots[item.target] = item.type; } }
        searched: int[] = [];
        for (wanted, type in comparison_types) {
            if (wanted) { roots.append(type); characters.append(false); searched.append(type); }
        }
        value_shapes = ValueShapeGraph(rows, declared, roots, characters);
        indices := resize([int(0)], native.ArrayType);
        for (type, index in searched) { indices[type] = value_shapes.roots[states + index] + 1; }
        for (site in comparison_sites) {
            item := code[site];
            item.target = indices[int(item.literal)];
            code[site] = item;
        }
        value_shapes.roots = slice(value_shapes.roots, 0, states);
    }
    emitted: native.Result = native.Result.Rejected(-1, "");
    if (rows[1].text == "" && !generation && length(comparison_sites) > 0) {
        tags := field_tags;
        if (length(tags) == 0) { tags = resize([i64(0)], length(fields)); }
        emitted = native.EmitValuesTyped(target, functions, parameters, slots, locals, code, arguments, records, fields,
            tags, texts, source, names, lines, columns, field_names, value_shapes, program, clock_owner);
    } else if (rows[1].text == "" && !generation && program) {
        if (clock_owner) {
            emitted = native.EmitClockProgramTyped(target, functions, parameters, slots, locals, code, arguments, records, fields,
                                                  field_tags, texts, source, names, lines, columns);
        } else if (pointer_program) {
            emitted = native.EmitProgramTyped(target, functions, parameters, slots, locals, code, arguments, records, fields,
                                             field_tags, texts, source, names, lines, columns);
        } else {
            emitted = native.EmitProgram(target, functions, parameters, slots, locals, code, arguments, records, fields, texts,
                                         source, names, lines, columns);
        }
    } else if (rows[1].text == "" && !generation) {
        emitted = native.Emit(target, functions, parameters, slots, locals, code, arguments, records, fields, texts,
                              source, names, lines, columns, false, 1);
    } else {
        library_name := rows[1].text;
        if (generation) {
            library_name = "generation";
        }
        shapes := value_shapes;
        if (length(comparison_sites) == 0) { shapes = RetainedShapeGraph(rows, declared, code, states, state_characters); }
        snapshots := false;
        for (root in shapes.roots) { snapshots = snapshots || root >= 0; }
        if (length(comparison_sites) > 0) {
            emitted = native.EmitValuesLibrary(target, library_name, names, ids, functions, parameters, slots, locals,
                code, arguments, records, fields, field_tags, texts, 1, field_names, entries, state_characters, shapes, family, snapshots);
        } else if (snapshots && family) {
            emitted = native.EmitFamilySnapshotLibrary(target, library_name, names, ids, functions, parameters, slots, locals,
                code, arguments, records, fields, field_tags, texts, 1, field_names, entries, state_characters, shapes);
        } else if (snapshots) {
            emitted = native.EmitSnapshotLibrary(target, library_name, names, ids, functions, parameters, slots, locals,
                code, arguments, records, fields, texts, 1, field_names, entries, state_characters, shapes);
        } else if (family) {
            emitted = native.EmitFamilyLibraryStates(target, library_name, names, ids, functions, parameters, slots, locals,
                code, arguments, records, fields, field_tags, texts, 1, field_names, entries, state_characters);
        } else {
            emitted = native.EmitLibraryStates(target, library_name, names, ids, functions, parameters, slots, locals,
                code, arguments, records, fields, texts, 1, field_names, entries, state_characters);
        }
    }
    switch emitted {
        case .Rejected(instruction, message):
            return Result.Invalid(message);
        case .Emitted(text):
            return Result.Emitted(Linked(text, rows, target));
    }
}
// The module's text with a comment naming each library a foreign call needs,
// once, for the driver to link: `; chibi-library PATH`, the path as the source
// spells it. A system library also gets a `; chibi-import PATH SYMBOL` comment
// per symbol the module calls, which a Windows link needs to write the library's
// import definition. A foreign block with no library declares symbols of the
// program's own objects, such as its start module: each gets `; chibi-self
// SYMBOL`, and no stub or import library lists it.
Linked :: (text: string, rows: facts.Row[], target: abi.Target) -> string {
    paths: string[] = [];
    imports: string[] = [];
    for (original in rows) {
        row := original;
        // Scalar libm capabilities use the C math ABI. Each target owns that
        // same ABI in its system library; emitted calls retain their symbols.
        if (row.kind == facts.ForeignRow && row.text == "system:m") {
            if (abi.Same(target, abi.MacOSArm64())) { row.text = "system:System"; row.name = format_text("_{}", row.name); }
            if (abi.Same(target, abi.WindowsX64())) { row.text = "system:ucrtbase"; }
        }
        if (row.kind == facts.ForeignRow && row.text != "" && !paths.contains(row.text)) {
            paths.append(row.text);
        }
        if (row.kind == facts.ForeignRow && strings.HasPrefix(row.text, "system:")) {
            line := format_text("; chibi-import {} {}\n", row.text, row.name);
            if (!imports.contains(line)) {
                imports.append(line);
            }
        }
        if (row.kind == facts.ForeignRow && row.text == "" && row.name != "") {
            line := format_text("; chibi-self {}\n", row.name);
            if (!imports.contains(line)) {
                imports.append(line);
            }
        }
    }
    // The comments are joined apart, so the module's text is copied once.
    comments: string[] = [];
    for (path in paths) {
        comments.append(format_text("; chibi-library {}\n", path));
    }
    comments.extend(imports);
    return format_text("{}{}", text, strings.Join(comments, ""));
}

// Emit and EmitBytes are the Linux x86-64 entries `chibi build` calls.
pub Emit :: (rows: facts.Row[]) -> Result {
    return EmitFor(abi.LinuxX64(), rows);
}
pub EmitBytes :: (rows: facts.Row[]) -> u8[] {
    return EmitBytesFor(abi.LinuxX64(), rows);
}

// Existing compiler-host --output-bytes rejects an empty result before file
// publication. Emit retains typed diagnostics; this entry adds no host codec.
pub EmitBytesFor :: (target: abi.Target, rows: facts.Row[]) -> u8[] {
    return Bytes(EmitFor(target, rows));
}
pub EmitLinesBytes :: (rows: facts.Row[], directory: string) -> u8[] {
    return Bytes(EmitLines(rows, directory));
}
Bytes :: (result: Result) -> u8[] {
    output: u8[] = [];
    switch result {
        case .Rejected(rejected):
            return output;
        case .Invalid(message):
            return output;
        case .Emitted(text):
            for (item in strings.Bytes(text)) {
                output.append(u8(item));
            }
            return output;
    }
}
