    type: Call Function
    reference_id: 2015
    reference_name: Advance Wave
    inputs:
      Arena Center: {type: struct, type_name: CF_V2, kind: data}
  edges:
  - {from: 2027.Then, to: 2029.Exec}
  - {from: 2029.Then, to: 2044.Exec}
  - {from: 2032.Then, to: 2034.Exec}
  - {from: 2040.Result, to: 2044.Condition}
  - {from: 2044.True, to: 2051.Exec}
  - {from: 2049.Value, to: 2051.Arena Center, conversion: game_transform_to_cf}
