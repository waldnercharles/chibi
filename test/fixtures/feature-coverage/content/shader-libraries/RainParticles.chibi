package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("version", data.Value.UInt(3)),
            data.Field.Named("name", data.Value.Text("RainParticles")),
            data.Field.Named("domain", data.Value.Text("shader-library")),
            data.Field.Named("id_counter", data.Value.UInt(60000)),
            data.Field.Named("description", data.Value.Text("A 16-column falling lattice. Index selects the column and row; each drop wraps vertically using the explicit field clock. This scene uses no game rules or simulation particles.")),
            data.Field.Named("graphs", data.List([
                data.Object([
                    data.Field.Named("kind", data.Value.Text("event")),
                    data.Field.Named("name", data.Value.Text("Functions"))
                ]),
                data.Object([
                    data.Field.Named("id", data.Value.UInt(1)),
                    data.Field.Named("kind", data.Value.Text("function")),
                    data.Field.Named("name", data.Value.Text("Fall")),
                    data.Field.Named("entry_id", data.Value.UInt(10)),
                    data.Field.Named("return_id", data.Value.UInt(100)),
                    data.Field.Named("call_depth_limit", data.Value.UInt(64)),
                    data.Field.Named("nodes", data.List([
                        data.Object([
                            data.Field.Named("id", data.Value.UInt(10)),
                            data.Field.Named("type", data.Value.Text("Function Entry")),
                            data.Field.Named("outputs", data.List([
                                data.Object([
                                    data.Field.Named("id", data.Value.UInt(11)),
                                    data.Field.Named("name", data.Value.Text("Index")),
                                    data.Field.Named("type", data.Value.Text("float")),
                                    data.Field.Named("kind", data.Value.Text("data"))
                                ]),
                                data.Object([
                                    data.Field.Named("id", data.Value.UInt(12)),
                                    data.Field.Named("name", data.Value.Text("Count")),
                                    data.Field.Named("type", data.Value.Text("float")),
                                    data.Field.Named("kind", data.Value.Text("data"))
                                ]),
                                data.Object([
                                    data.Field.Named("id", data.Value.UInt(13)),
                                    data.Field.Named("name", data.Value.Text("Seed")),
                                    data.Field.Named("type", data.Value.Text("float")),
                                    data.Field.Named("kind", data.Value.Text("data"))
                                ]),
                                data.Object([
                                    data.Field.Named("id", data.Value.UInt(14)),
                                    data.Field.Named("name", data.Value.Text("Spacing")),
                                    data.Field.Named("type", data.Value.Text("float")),
                                    data.Field.Named("kind", data.Value.Text("data")),
                                    data.Field.Named("default", data.Value.Real(6.0))
                                ]),
                                data.Object([
                                    data.Field.Named("id", data.Value.UInt(15)),
                                    data.Field.Named("name", data.Value.Text("Height")),
                                    data.Field.Named("type", data.Value.Text("float")),
                                    data.Field.Named("kind", data.Value.Text("data")),
                                    data.Field.Named("default", data.Value.Real(25.0))
                                ]),
                                data.Object([
                                    data.Field.Named("id", data.Value.UInt(16)),
                                    data.Field.Named("name", data.Value.Text("Speed")),
                                    data.Field.Named("type", data.Value.Text("float")),
                                    data.Field.Named("kind", data.Value.Text("data")),
                                    data.Field.Named("default", data.Value.Real(0.20000000000000001))
                                ]),
                                data.Object([
                                    data.Field.Named("id", data.Value.UInt(17)),
                                    data.Field.Named("name", data.Value.Text("DropSize")),
                                    data.Field.Named("type", data.Value.Text("float")),
                                    data.Field.Named("kind", data.Value.Text("data")),
                                    data.Field.Named("default", data.Value.Real(1.0))
                                ]),
                                data.Object([
                                    data.Field.Named("id", data.Value.UInt(18)),
                                    data.Field.Named("name", data.Value.Text("Tint")),
                                    data.Field.Named("type", data.Value.Text("struct")),
                                    data.Field.Named("type_name", data.Value.Text("ShaderVec4")),
                                    data.Field.Named("kind", data.Value.Text("data")),
                                    data.Field.Named("default", data.Object([
                                        data.Field.Named("x", data.Value.Real(0.34999999999999998)),
                                        data.Field.Named("y", data.Value.Real(0.69999999999999996)),
                                        data.Field.Named("z", data.Value.Real(1.3)),
                                        data.Field.Named("w", data.Value.Real(0.84999999999999998))
                                    ]))
                                ])
                            ]))
                        ]),
                        data.Object([
                            data.Field.Named("id", data.Value.UInt(100)),
                            data.Field.Named("type", data.Value.Text("Return")),
                            data.Field.Named("inputs", data.List([
                                data.Object([
                                    data.Field.Named("id", data.Value.UInt(101)),
                                    data.Field.Named("name", data.Value.Text("Position")),
                                    data.Field.Named("type", data.Value.Text("struct")),
                                    data.Field.Named("type_name", data.Value.Text("ShaderVec3")),
                                    data.Field.Named("kind", data.Value.Text("data"))
                                ]),
                                data.Object([
                                    data.Field.Named("id", data.Value.UInt(102)),
                                    data.Field.Named("name", data.Value.Text("Size")),
                                    data.Field.Named("type", data.Value.Text("float")),
                                    data.Field.Named("kind", data.Value.Text("data"))
                                ]),
                                data.Object([
                                    data.Field.Named("id", data.Value.UInt(103)),
                                    data.Field.Named("name", data.Value.Text("Color")),
                                    data.Field.Named("type", data.Value.Text("struct")),
                                    data.Field.Named("type_name", data.Value.Text("ShaderVec4")),
                                    data.Field.Named("kind", data.Value.Text("data"))
                                ])
                            ]))
                        ]),
                        data.Object([
                            data.Field.Named("id", data.Value.UInt(200)),
                            data.Field.Named("type", data.Value.Text("Behavior Expression")),
                            data.Field.Named("reference_name", data.Value.Text("vec3((fract(index / 16) * 16 - 7.5) * spacing, (fract(index / max(count, 1) + seed * 0.173 - time * speed) * 2 - 1) * height, (index / 16 - fract(index / 16) - 3.5) * spacing)")),
                            data.Field.Named("inputs", data.Object([
                                data.Field.Named("index", data.Object([
                                    data.Field.Named("id", data.Value.UInt(201)),
                                    data.Field.Named("type", data.Value.Text("float"))
                                ])),
                                data.Field.Named("count", data.Object([
                                    data.Field.Named("id", data.Value.UInt(202)),
                                    data.Field.Named("type", data.Value.Text("float"))
                                ])),
                                data.Field.Named("seed", data.Object([
                                    data.Field.Named("id", data.Value.UInt(203)),
                                    data.Field.Named("type", data.Value.Text("float"))
                                ])),
                                data.Field.Named("time", data.Object([
                                    data.Field.Named("id", data.Value.UInt(204)),
                                    data.Field.Named("type", data.Value.Text("float"))
                                ])),
                                data.Field.Named("spacing", data.Object([
                                    data.Field.Named("id", data.Value.UInt(205)),
                                    data.Field.Named("type", data.Value.Text("float"))
                                ])),
                                data.Field.Named("height", data.Object([
                                    data.Field.Named("id", data.Value.UInt(206)),
                                    data.Field.Named("type", data.Value.Text("float"))
                                ])),
                                data.Field.Named("speed", data.Object([
                                    data.Field.Named("id", data.Value.UInt(207)),
                                    data.Field.Named("type", data.Value.Text("float"))
                                ]))
                            ])),
                            data.Field.Named("outputs", data.Object([
                                data.Field.Named("Result", data.Object([
                                    data.Field.Named("id", data.Value.UInt(208)),
                                    data.Field.Named("type", data.Value.Text("struct")),
                                    data.Field.Named("type_name", data.Value.Text("ShaderVec3"))
                                ]))
                            ]))
                        ]),
                        data.Object([
                            data.Field.Named("id", data.Value.UInt(300)),
                            data.Field.Named("type", data.Value.Text("Shader Time"))
                        ])
                    ])),
                    data.Field.Named("edges", data.List([
                        data.Object([
                            data.Field.Named("from", data.Value.Text("10.Index")),
                            data.Field.Named("to", data.Value.Text("200.index"))
                        ]),
                        data.Object([
                            data.Field.Named("from", data.Value.Text("10.Count")),
                            data.Field.Named("to", data.Value.Text("200.count"))
                        ]),
                        data.Object([
                            data.Field.Named("from", data.Value.Text("10.Seed")),
                            data.Field.Named("to", data.Value.Text("200.seed"))
                        ]),
                        data.Object([
                            data.Field.Named("from", data.Value.Text("10.Spacing")),
                            data.Field.Named("to", data.Value.Text("200.spacing"))
                        ]),
                        data.Object([
                            data.Field.Named("from", data.Value.Text("10.Height")),
                            data.Field.Named("to", data.Value.Text("200.height"))
                        ]),
                        data.Object([
                            data.Field.Named("from", data.Value.Text("10.Speed")),
                            data.Field.Named("to", data.Value.Text("200.speed"))
                        ]),
                        data.Object([
                            data.Field.Named("from", data.Value.Text("10.DropSize")),
                            data.Field.Named("to", data.Value.Text("100.Size"))
                        ]),
                        data.Object([
                            data.Field.Named("from", data.Value.Text("10.Tint")),
                            data.Field.Named("to", data.Value.Text("100.Color"))
                        ]),
                        data.Object([
                            data.Field.Named("from", data.Value.Text("200.Result")),
                            data.Field.Named("to", data.Value.Text("100.Position"))
                        ]),
                        data.Object([
                            data.Field.Named("from", data.Value.Text("300.Value")),
                            data.Field.Named("to", data.Value.Text("200.time"))
                        ])
                    ]))
                ]),
                data.Object([
                    data.Field.Named("id", data.Value.UInt(1000)),
                    data.Field.Named("kind", data.Value.Text("function")),
                    data.Field.Named("math_expression", data.Value.Text("vec3((fract(index / 16) * 16 - 7.5) * spacing, (fract(index / max(count, 1) + seed * 0.173 - time * speed) * 2 - 1) * height, (index / 16 - fract(index / 16) - 3.5) * spacing)")),
                    data.Field.Named("expression_mode", data.Value.UInt(1)),
                    data.Field.Named("entry_id", data.Value.UInt(50000))
                ])
            ]))
        ])
    );
}
