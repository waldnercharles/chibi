<div class="gallery">
  <div class="menu-group">MenuOption</div>
  <use ui="MenuOption" value="first">First</use>
  <use ui="MenuOption" value="second">Second</use>
  <div class="menu-sep"/>
  <div class="menu-group">MenuCheck</div>
  <use ui="MenuCheck">Check</use>
  <div class="menu-sep"/>
  <div class="menu-group">Switch</div>
  <div class="sample"><use ui="Switch"/><use ui="Switch" checked=""/></div>
  <div class="menu-group">Segmented</div>
  <div class="sample">
    <use ui="Segmented">
      <label><input type="radio" name="size" value="small"/><span class="face">Small</span></label>
      <label><input type="radio" name="size" value="medium" checked=""/><span class="face">Medium</span></label>
      <label><input type="radio" name="size" value="large"/><span class="face">Large</span></label>
    </use>
  </div>
  <div class="menu-group">Select</div>
  <div class="sample">
    <use ui="Select">
      <select>
        <option value="low">Low</option>
        <option value="high" selected="">High</option>
        <option value="ultra">Ultra</option>
      </select>
    </use>
  </div>
  <div class="menu-group">Slider</div>
  <div class="sample"><use ui="Slider" min="0" max="10" step="1" value="4"/></div>
  <div class="menu-group">SidebarNav</div>
  <use ui="SidebarNav">
    <label class="nav-item"><input type="radio" name="page" value="audio" checked=""/><span class="nav-face"><span class="icon">&#xf03d8;</span><span class="label">Display</span></span></label>
    <label class="nav-item"><input type="radio" name="page" value="video"/><span class="nav-face"><span class="icon">&#xf097b;</span><span class="label">Controls</span><span class="dot"/></span></label>
    <label class="nav-item"><input type="radio" name="page" value="game"/><span class="nav-face"><span class="icon">&#xf0297;</span><span class="label">Gameplay</span><span class="count">3</span></span></label>
  </use>
  <div class="menu-group">NumberFlow</div>
  <div class="sample">
    <use ui="Slider" min="0" max="2000" step="125" data-value="save.galleryCount"/>
    <number-flow data-attr-value="save.galleryCount == '' ? 0 : save.galleryCount" grouping=""/>
  </div>
  <div class="menu-group">MorphText</div>
  <div class="sample">
    <use ui="Segmented">
      <label><input type="radio" data-checked="save.galleryWord" value="Play"/><span class="face">Play</span></label>
      <label><input type="radio" data-checked="save.galleryWord" value="Pause"/><span class="face">Pause</span></label>
      <label><input type="radio" data-checked="save.galleryWord" value="Stop"/><span class="face">Stop</span></label>
    </use>
    <morph-text>{{ save.galleryWord == '' ? 'Play' : save.galleryWord }}</morph-text>
  </div>
  <div class="menu-group">VirtualList</div>
  <div class="sample list-sample">
    <use ui="VirtualList" id="list">
      <div class="list-row" data-for="row, i : self.rows">Row {{ self.first + i + 1 }} of {{ self.total }}</div>
    </use>
  </div>
  <div class="menu-group">Presence</div>
  <div class="sample"><use ui="Switch" data-checked="save.galleryShown"/><span class="shown" data-if="save.galleryShown" presence>Shown</span></div>
</div>
