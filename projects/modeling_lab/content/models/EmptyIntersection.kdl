version 3
name "EmptyIntersection"
domain "model"
id_counter 14
description "Disjoint solids produce a valid empty model with no draw submission."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Sphere"
                inputs Radius=18.0
            }
            - {
                id 6
                type "Model Translate"
                inputs {
                    Offset {
                        default x=60.0 y=0.0 z=0.0
                    }
                }
            }
            - id=10 type="Model Intersection"
        }
        (array)edges {
            - from="3.Geometry" to="6.Geometry"
            - from="3.Geometry" to="10.A"
            - from="6.Geometry" to="10.B"
            - from="10.Geometry" to="1.Geometry"
        }
    }
}
