include(CMakeFindDependencyMacro)
get_filename_component(_chibi_vendor_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
add_library(Chibi::vendor_sljit STATIC IMPORTED)
set_target_properties(Chibi::vendor_sljit PROPERTIES IMPORTED_LOCATION "${_chibi_vendor_prefix}/lib/chibi-vendor/libchibi_vendor_sljit.a")
set_property(TARGET Chibi::vendor_sljit PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_chibi_vendor_prefix}/include/chibi/vendor/sljit/1")
add_library(Chibi::vendor_tree_sitter STATIC IMPORTED)
set_target_properties(Chibi::vendor_tree_sitter PROPERTIES IMPORTED_LOCATION "${_chibi_vendor_prefix}/lib/chibi-vendor/libchibi_vendor_tree_sitter.a")
set_property(TARGET Chibi::vendor_tree_sitter PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_chibi_vendor_prefix}/include/chibi/vendor/tree_sitter/1")
add_library(Chibi::vendor_box2d STATIC IMPORTED)
set_target_properties(Chibi::vendor_box2d PROPERTIES IMPORTED_LOCATION "${_chibi_vendor_prefix}/lib/chibi-vendor/libchibi_vendor_box2d.a")
set_property(TARGET Chibi::vendor_box2d PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_chibi_vendor_prefix}/include/chibi/vendor/box2d/1")
set_property(TARGET Chibi::vendor_box2d PROPERTY INTERFACE_LINK_LIBRARIES [==[m]==])
add_library(Chibi::vendor_box3d STATIC IMPORTED)
set_target_properties(Chibi::vendor_box3d PROPERTIES IMPORTED_LOCATION "${_chibi_vendor_prefix}/lib/chibi-vendor/libchibi_vendor_box3d.a")
set_property(TARGET Chibi::vendor_box3d PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_chibi_vendor_prefix}/include/chibi/vendor/box3d/1")
find_dependency(Threads)
set_property(TARGET Chibi::vendor_box3d PROPERTY INTERFACE_LINK_LIBRARIES [==[m;Threads::Threads]==])
add_library(Chibi::vendor_enkits STATIC IMPORTED)
set_target_properties(Chibi::vendor_enkits PROPERTIES IMPORTED_LOCATION "${_chibi_vendor_prefix}/lib/chibi-vendor/libchibi_vendor_enkits.a")
set_property(TARGET Chibi::vendor_enkits PROPERTY IMPORTED_LINK_INTERFACE_LANGUAGES CXX)
set_property(TARGET Chibi::vendor_enkits PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_chibi_vendor_prefix}/include/chibi/vendor/enkits/1")
set_property(TARGET Chibi::vendor_enkits PROPERTY INTERFACE_COMPILE_DEFINITIONS [==[ENKITS_TASK_PRIORITIES_NUM=3]==])
find_dependency(Threads)
set_property(TARGET Chibi::vendor_enkits PROPERTY INTERFACE_LINK_LIBRARIES [==[Threads::Threads;c++]==])
