version 3
name "ProfileWing"
domain "model"
id_counter 14
description "A convex four-point wing profile, extruded symmetrically along Z. The independent mesh control uses explicit triangles."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Profile Polygon"
                inputs {
                    Vertices {
                        (array)default {
                            - x=-45.0 y=-6.0
                            - x=30.0 y=-14.0
                            - x=58.0 y=4.0
                            - x=-45.0 y=12.0
                        }
                    }
                }
            }
            - {
                id 6
                type "Model Extrude"
                inputs "Half Depth"=6.0
            }
            - {
                id 10
                type "Model Part"
                reference_name "Wing housing"
                inputs {
                    Material id=13
                }
                outputs {
                    Geometry id=12
                }
            }
        }
        (array)edges {
            - from="3.Profile" to="6.Profile"
            - from="6.Geometry" to="10.Geometry"
            - from="10.Geometry" to="1.Geometry"
        }
    }
}
