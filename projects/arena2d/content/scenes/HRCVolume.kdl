version 1
name "HRCVolume"
(array)entities {
    - {
        name "Camera"
        prototype "Camera"
        components {
            GameTransform x=0.0 y=0.0
        }
    }
    - {
        name "HRC"
        prototype "HRC"
        components {
            GameTransform x=0.0 y=0.0
        }
    }
    - {
        name "Source"
        prototype "Crystal"
        components {
            GameTransform x=-330.0 y=0.0
            GameAppearance width=28.0 height=28.0 color=0xffffffff
            GameMaterial emission_color=0xffffffff emission_intensity=0.1 absorption=0.0 scene=0xffffffff edge_light=0.0
        }
    }
    - {
        name "Cloud band"
        prototype "Cloud"
        components {
            GameTransform x=-130.0 y=0.0
            GameFluidVolume width=180.0 height=360.0 absorption=0.018 visibility=0.03
        }
    }
    - {
        name "Liquid band"
        prototype "Liquid"
        components {
            GameTransform x=60.0 y=0.0
            GameFluidVolume width=70.0 height=260.0 absorption=0.08 visibility=0.02
        }
    }
    - {
        name "Upper mist"
        prototype "Cloud"
        components {
            GameTransform x=20.0 y=145.0
            GameFluidVolume width=240.0 height=80.0 absorption=0.025 visibility=0.05
        }
    }
    - {
        name "Receiver"
        prototype "HardRock"
        components {
            GameTransform x=300.0 y=0.0
            GameAppearance width=180.0 height=380.0
            GameMaterial absorption=0.25 edge_light=0.0
        }
    }
}
