-                return error;
-            }
-            out->type_name = f->type_name;
-            break;
-        }
-        case PIN_HANDLE:
-        case PIN_TASK: out->u64 = *(const uint64_t *)src; break;
-        case PIN_QUERY:
-        case PIN_POINTER:
-        case PIN_UNION: out->ptr = *(void *const *)src; break;
-        case PIN_ENUM: {
-            out->e = 0;
