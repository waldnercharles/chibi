-    int first = 0, end = count;
-    while (first < end) {
-        int middle = first + (end - first) / 2;
-        if ((uintptr_t)checks[middle].record < (uintptr_t)record) {
-            first = middle + 1;
-        } else {
-            end = middle;
-        }
-    }
-    return first < count && checks[first].record == record ? first : -1;
-}
