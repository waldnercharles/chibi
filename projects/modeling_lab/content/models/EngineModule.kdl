version 3
name "EngineModule"
domain "model"
id_counter 40
description "A reusable engine body with a public radius and independently named shell and collar."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Parameter"
                reference_name "Radius"
                inputs Default=14.0 Minimum=9.0 Maximum=24.0
            }
            - {
                id 8
                type "Model Cylinder"
                inputs "Half Height"=16.0
            }
            - {
                id 12
                type "Model Cylinder"
                inputs Radius=8.0 "Half Height"=22.0
            }
            - id=16 type="Model Difference"
            - {
                id 20
                type "Model Part"
                reference_name "Engine shell"
                inputs {
                    Material id=38
                }
                outputs {
                    Geometry id=22
                }
            }
            - {
                id 23
                type "Model Torus"
                inputs "Minor Radius"=2.5
            }
            - {
                id 27
                type "Model Translate"
                inputs {
                    Offset {
                        default x=0.0 y=16.0 z=0.0
                    }
                }
            }
            - {
                id 31
                type "Model Part"
                reference_name "Front collar"
                inputs {
                    Material id=39
                }
                outputs {
                    Geometry id=33
                }
            }
            - id=34 type="Model Union"
        }
        (array)edges {
            - from="3.Value" to="8.Radius"
            - from="3.Value" to="23.Major Radius"
            - from="8.Geometry" to="16.A"
            - from="12.Geometry" to="16.B"
            - from="16.Geometry" to="20.Geometry"
            - from="20.Geometry" to="34.A"
            - from="23.Geometry" to="27.Geometry"
            - from="27.Geometry" to="31.Geometry"
            - from="31.Geometry" to="34.B"
            - from="34.Geometry" to="1.Geometry"
        }
    }
}
