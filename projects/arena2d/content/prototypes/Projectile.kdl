name "Projectile"
components {
    GAME.GameAppearance antialias=1.0 color=0x00ffffff height=4.0 shape="Capsule" width=16.0
    GAME.GameBody continuous=#true type="Kinematic"
    GAME.GameCollider category=4 mask=10 pierce_fragments=#true radius=2.0 sensor=#true
    GAME.GameIgniter heat=2.5
    GAME.GameMaterial absorption=0.1 emission_color=0x00ffffff emission_intensity=0.1 emission_multiplier=1.0 scene=0x00ffffff
    (object)GAME.GameOrientation
    GAME.GameProjectile damage=1 lifetime=2.5 speed=400.0
    (object)GAME.GameTransform
    (object)GAME.GameVelocity
}
(array)behaviors "ProjectileEffects" "ProjectileHit" "ProjectileLifecycle"
