version 1
name "MaterialShowcaseOrganicStrain"
(array)entities {
    - name="Materials" prototype="MaterialShowcaseOrganicStrainWorld"
    - {
        name "Camera"
        prototype "MaterialShowcaseEntity"
        components {
            GameCamera width=260.0 height=180.0
        }
    }
    - {
        name "Floor"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=0.0 y=64.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=204.0 height=8.0 category=8 mask=15 friction=0.6
            GameAppearance width=204.0 height=8.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Left wall"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=-100.0 y=-4.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=8.0 height=144.0 category=8 mask=15 friction=0.6
            GameAppearance width=8.0 height=144.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Right wall"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=100.0 y=-4.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=8.0 height=144.0 category=8 mask=15 friction=0.6
            GameAppearance width=8.0 height=144.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Ceiling"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=0.0 y=-72.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=204.0 height=8.0 category=8 mask=15 friction=0.6
            GameAppearance width=204.0 height=8.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Contact pillar"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=0.0 y=42.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=28.0 height=36.0 category=8 mask=15 friction=0.6
            GameAppearance width=28.0 height=36.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Organic specimen"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=0.0 y=0.0
            GameFluidVolume {
                kind "Liquid"
                width 42.0
                height 34.0
                spacing 0.25
                mass 6.25e-05
                color 0x87cc8aff
                velocity x=0.0 y=0.0
                absorption 0.08
                visibility 0.4
                refraction 0.0
                grain_radius 0.0
            }
            MaterialConstitutive density=0.001 bulk_modulus=10.0 shear_modulus=6.0
        }
    }
}
