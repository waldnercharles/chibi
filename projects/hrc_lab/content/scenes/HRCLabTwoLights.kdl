            GameTransform x=0 y=0
            GameAppearance antialias=0.25 border_color=0 border_width=0 color=2302559999 glow_color=0 glow_radius=0 height=104 layer=0 shape="Circle" stroke_width=0 width=104
            GameMaterial absorption=1 albedo=2631721215 border_albedo=0 border_emission_color=0 border_filter=0 border_scene=0 edge_light=0 emission_color=0 emission_intensity=0 emission_multiplier=1 filter=0 scene=286397183
