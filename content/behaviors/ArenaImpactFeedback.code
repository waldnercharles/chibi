behavior "ArenaImpactFeedback" {
    owner "ecs.entity";
    state "Death Handled": bool = false;
    action spawn_surface_pulse_2 = "Spawn Surface Pulse"(Prototype: "ArenaDeathPulse", Position: &component("GAME.GameTransform"));
    value has_gameencountermember = has_game_encounter_member();
    on Damaged as damaged(Amount: int = 0, Source: handle<"ecs.entity"> = 0) {
        if (cast<double>(&component("GAME.GameHealth", "current")) > 0) {
            "Spawn Surface Pulse"(Prototype: "ArenaHitPulse", Position: &component("GAME.GameTransform"));
        } else {
        }
    }
    on Died as died(Source: handle<"ecs.entity"> = 0) {
        if (&state."Death Handled") {
        } else {
            await set_variable<"Death Handled">(Value: bool = true);
            if (has_gameencountermember) {
                if (cast<double>(&component("GAME.GameEncounterMember", "role")) == 1) {
                    "Prepare Enemy Experience"(Position: &component("GAME.GameTransform"), Appearance: &component("GAME.GameGeometry3D"), Material: &component("GAME.GameShader"), Orientation: &component("GAME.GameOrientation"), Visual: &component("GAME.GameVisualTransform"));
                } else {
                    spawn_surface_pulse_2();
                }
            } else {
                spawn_surface_pulse_2();
            }
        }
    }
    function "Spawn Surface Pulse"(Prototype: name = "ArenaHitPulse", Position: struct<"GameTransform"> = null) -> () {
        depth_limit 64;
        action spawn_prototype = engine["Spawn Prototype"](Prototype: entry.Prototype);
        after entry {
            spawn_prototype();
        }
        after spawn_prototype {
            await set_entity_game_transform(Entity: spawn_prototype.Entity, Value: entry.Position);
            return();
        }
    }
    function "Prepare Enemy Experience"(Position: struct<"GameTransform"> = null, Appearance: struct<"GameGeometry3D"> = null, Material: struct<"GameShader"> = null, Orientation: struct<"GameOrientation"> = null, Visual: struct<"GameVisualTransform"> = null) -> () {
        depth_limit 64;
        action spawn_prototype = engine["Spawn Prototype"](Prototype: "ArenaExperience");
        local Experience = spawn_prototype.Entity;
        after entry {
            spawn_prototype();
        }
        after spawn_prototype {
            await set_entity_game_transform(Entity: &local.Experience, Value: entry.Position);
            await set_entity_game_geometry3_d(Entity: &local.Experience, Value: entry.Appearance);
            await set_entity_game_shader(Entity: &local.Experience, Value: entry.Material);
            await set_entity_game_orientation(Entity: &local.Experience, Value: entry.Orientation);
            await set_entity_game_visual_transform(Entity: &local.Experience, Value: entry.Visual);
            await set_game_pickup_state(Value: 3, Target: &local.Experience);
            return();
        }
    }
}
