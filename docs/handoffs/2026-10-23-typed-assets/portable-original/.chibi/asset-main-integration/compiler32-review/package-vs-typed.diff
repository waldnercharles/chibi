+    | Bound(code: Code[], slots: Slot[], arguments: Value[], owners: Work[])
+}
+NativeNameStorage: int : 12;
+NativeSources :: (forest: snapshot.SnapshotNode[], call: int, method: bool) -> int[] {
+    sources: int[] = [];
+    if (method) {
+        sources.append(Field(forest, Field(forest, call, "function"), "object"));
+    }
+    argument := FirstMember(forest, Field(forest, call, "arguments"));
+    while (argument >= 0) {
+        sources.append(argument);
+        argument = NextMember(forest, argument);
+    }
+    return sources;
+}
+NativeParameter :: (ports: ResolvedPort[], called: ResolvedNative, name: string, supplied: int) -> int {
+    found: int = -1;
+    index: int = 0;
+    while (index < called.parameters) {
+        candidate := ports[called.first + index].name;
+        if (candidate == name) {
+            return index;
+        }
+        if (NameMatches(candidate, name)) {
+            if (found == -1) {
+                found = index;
+            } else {
+                found = -2;
+            }
+        }
+        index += 1;
+    }
+    if (found != -1 || !called.variadic || called.parameters == 0) {
+        return found;
+    }
+    // A variadic Value0 also accepts Value1, Value2, ... as stage zero does.
+    end := strings.ByteLength(name);
+    digits := end;
+    while (digits > 0 && strings.ByteAt(name, digits - 1) >= 48 && strings.ByteAt(name, digits - 1) <= 57) {
+        digits -= 1;
+    }
+    if (digits == end) {
+        return -1;
+    }
+    ordinal: int = 0;
+    at := digits;
+    while (at < end) {
+        digit := strings.ByteAt(name, at) - 48;
+        if (ordinal > supplied / 10 || digit > supplied - ordinal * 10) {
+            return -1;
+        }
+        ordinal = ordinal * 10 + digit;
+        at += 1;
+    }
+    first := format_text("{}0", strings.Slice(name, 0, digits));
+    if (!NameMatches(ports[called.first + called.parameters - 1].name, first)) {
+        return -1;
+    }
+    return called.parameters - 1 + ordinal;
+}
+NativeProvided :: (arguments: NativeArgument[], parameter: int) -> int {
+    index: int = 0;
+    while (index < length(arguments)) {
+        if (arguments[index].parameter == parameter) {
+            return index;
+        }
+        index += 1;
+    }
+    return -1;
+}
+BindNative :: (forest: snapshot.SnapshotNode[], text: string, call: int, sources: int[],
+               called: ResolvedNative, ports: ResolvedPort[]) -> NativeBinding {
+    arguments: NativeArgument[] = [];
+    total := called.parameters;
+    if (called.variadic && total > 0) {
+        total -= 1;
+    }
+    ordinal: int = 0;
+    for (source in sources) {
+        value := source;
+        parameter := ordinal;
+        if (Is(forest, source, "named_argument")) {
+            if (Field(forest, source, "type") >= 0) {
+                return NativeBinding.Failed(source, "typed native arguments are not supported yet");
+            }
+            name := Text(forest, text, Field(forest, source, "name"));
+            parameter = NativeParameter(ports, called, name, length(sources));
+            if (parameter < 0) {
+                problem := format_text("Unknown argument '{}'", name);
+                if (parameter == -2) {
+                    problem = format_text("Ambiguous argument '{}'", name);
+                }
+                return NativeBinding.Failed(source, problem);
+            }
+            value = Field(forest, source, "value");
+            if (value < 0) {
+                value = Field(forest, source, "source");
+            }
+        }
+        if (value < 0 || parameter < 0 ||
+            (parameter >= called.parameters && (!called.variadic || called.parameters == 0))) {
+            return NativeBinding.Failed(source, "Too many arguments");
+        }
+        if (NativeProvided(arguments, parameter) >= 0) {
+            return NativeBinding.Failed(source, "Argument supplied more than once");
+        }
+        argument: NativeArgument = {node: value, parameter: parameter};
+        arguments.append(argument);
+        if (parameter >= total) {
+            total = parameter + 1;
+        }
+        ordinal += 1;
+    }
+    if (called.variadic && called.parameters > 0 && total < called.parameters &&
+        ports[called.first + called.parameters - 1].has_default) {
+        total = called.parameters;
+    }
+    index: int = 0;
+    while (index < total) {
+        port := ports[NativePort(called, index)];
+        if (NativeProvided(arguments, index) < 0 && !port.has_default) {
+            return NativeBinding.Failed(call, format_text("Missing argument '{}'", port.name));
+        }
+        index += 1;
+    }
+    return NativeBinding.Bound(arguments, total);
+}
+// Numeric overload arguments retain their inferred literal type and watch;
+// selection converts the value afterward. Other literals are contextual only
+// when every viable overload declares the same type at their source position.
+NativeExpectation :: (forest: snapshot.SnapshotNode[], text: string, call: int, sources: int[],
+                      natives: ResolvedNative[], ports: ResolvedPort[], name: string, ordinal: int) -> Work {
+    source := sources[ordinal];
+    if (Is(forest, source, "named_argument")) {
+        source = Field(forest, source, "value");
+        if (source < 0) {
+            source = Field(forest, sources[ordinal], "source");
+        }
+    }
+    expected := Visit(source);
+    first := true;
+    exact := ExactNativeKind(natives, name, NativeFunctionKind) >= 0;
+    for (candidate in natives) {
+        if (NativeCandidate(candidate, name, NativeFunctionKind, exact)) {
+            switch BindNative(forest, text, call, sources, candidate, ports) {
+                case .Failed(problem, message):
+                    continue;
+                case .Bound(arguments, total):
+                    port := ports[NativePort(candidate, arguments[ordinal].parameter)];
+                    if (first) {
+                        expected = Expect(source, port.storage, port.container, port.record);
+                        first = false;
+                    } else if (expected.storage != port.storage || expected.container != port.container ||
+                               expected.record != port.record) {
+                        return Visit(source);
+                    }
+            }
+        }
+    }
+    if (expected.storage <= 0 || Numeric(expected.storage)) {
+        return Visit(source);
+    }
+    return expected;
+}
+// Only constant syntax is inspected. A local whose runtime value happens to
+// be zero remains an explicit entity argument.
+NativeOwnerZero :: (forest: snapshot.SnapshotNode[], text: string, document: int, constants: ConstDecl[],
+                    callables: Callable[], names: Name[], package: int, node: int) -> bool {
+    at := Unparenthesized(forest, node);
+    remaining := length(forest);
+    while (at >= 0 && remaining > 0 && Is(forest, at, "call_expression")) {
+        callee := Field(forest, at, "function");
+        spelling := Text(forest, text, callee);
+        converted := ScalarStorage(spelling);
+        if (!Is(forest, callee, "identifier") || FindCallable(callables, package, spelling) >= 0 ||
+            Lookup(names, spelling) >= 0 || !Integer(converted)) {
+            return false;
+        }
+        argument := FirstMember(forest, Field(forest, at, "arguments"));
+        if (argument < 0 || NextMember(forest, argument) >= 0) {
+            return false;
+        }
+        if (Is(forest, argument, "named_argument")) {
+            label := Text(forest, text, Field(forest, argument, "name"));
+            if (label != "wrap" && label != "clamp") {
+                return false;
+            }
+            argument = Field(forest, argument, "value");
+        }
+        at = Unparenthesized(forest, argument);
+        remaining -= 1;
+    }
+    if (Is(forest, at, "nil")) {
+        return Text(forest, text, at) == "null";
+    }
+    numeric := Is(forest, at, "number");
+    if (Is(forest, at, "unary_expression")) {
+        operator := Text(forest, text, Field(forest, at, "operator"));
+        numeric = (operator == "+" || operator == "-") && Is(forest, Field(forest, at, "operand"), "number");
+    }
+    if (numeric) {
+        switch NumberBits(forest, text, at) {
+            case .Finite(bits, fits, single):
+                return (bits & 0x7fffffffffffffff) == 0;
+            case .OutOfRange:
+                return false;
+        }
+    }
+    switch FoldConstant(forest, text, document, constants, names, package, at, Int64Storage) {
+        case .Folded(bits):
+            return bits == 0;
+        case .Failed(diagnostic):
+            return false;
+        case .Waiting:
+            return false;
+    }
+}
+NativeOwner :: (types: TypeDecl[], names: Name[], port: ResolvedPort) -> Value {
+    owner := Lookup(names, "self");
+    if (port.storage != HandleStorage || port.container != 0 || port.record < 0 || owner < 0 ||
+        names[owner].place != SelfPlace || names[owner].record < 0) {
+        return NoValue();
+    }
+    value := Typed(-1, names[owner].storage, names[owner].container, names[owner].record);
+    if (!NativeTakes(types, NativePortType(port), value)) {
+        return NoValue();
+    }
+    return NativePortType(port);
+}
+// Reorder evaluated values, then emit omitted values in parameter order.
+NativeBoundValues :: (forest: snapshot.SnapshotNode[], text: string, document: int, call: int,
+                      constants: ConstDecl[], callables: Callable[], types: TypeDecl[], names: Name[], package: int,
+                      called: ResolvedNative, ports: ResolvedPort[], supplied: NativeArgument[], total: int,
+                      values: Value[], first: int, ops: Ops, at: Bases) -> NativeValues {
+    code: Code[] = [];
+    slots: Slot[] = [];
+    arguments: Value[] = [];
+    sources: int[] = [];
+    owners: Work[] = [];
+    index: int = 0;
+    while (index < total) {
+        given := NativeProvided(supplied, index);
+        argument := NoValue();
+        source: int = -1;
+        if (given >= 0) {
+            argument = values[first + given];
+            source = supplied[given].node;
+        }
+        arguments.append(argument);
+        sources.append(source);
+        index += 1;
+    }
+    // Provided literal retyping and owner substitution follow source order.
+    for (given in supplied) {
+        port := ports[NativePort(called, given.parameter)];
+        argument := arguments[given.parameter];
+        if (argument.storage == NumberStorage && port.storage <= 0) {
+            return NativeValues.Failed(argument.record, "a number needs an integer type here");
+        }
+        if (argument.storage == NumberStorage && port.storage > 0 && port.container == 0) {
+            if (port.storage == HandleStorage) {
+                if (!NativeOwnerZero(forest, text, document, constants, callables, names, package, given.node)) {
+                    return NativeValues.Failed(given.node, "entity value requires null or zero");
+                }
+                argument = NativePortType(port);
+                argument.slot = at.slot + length(slots);
+                slots.append(ValueLocal(HandleStorage));
+                constant := ConstantCode(ops, HandleStorage, 0, argument.slot, forest[given.node]);
+                constant.value_record = port.record;
+                code.append(constant);
+                watch := ScalarWatch(ops, argument.slot, HandleStorage, 0, true, forest[given.node]);
+                watch.value_record = port.record;
+                owner := Lookup(names, "self");
+                if (port.default_owner && owner >= 0) {
+                    watch.value_record = names[owner].record;
+                }
+                code.append(watch);
+            } else {
+                if (!Integer(port.storage) && !Floating(port.storage)) {
+                    return NativeValues.Failed(given.node, "argument differs from its parameter type");
+                }
+                shifted: Bases = {pc: at.pc + length(code), slot: at.slot + length(slots), local: at.local,
+                                  cell: at.cell, host: at.host, call: at.call};
+                storage := InferredNumberStorage(forest, text, argument.record);
+                typed := Fail(forest, given.node, document, "");
+                if (Floating(storage)) {
+                    typed = FloatConstantStep(forest, text, document, argument, storage, ops, shifted,
+                                              forest[given.node]);
+                } else {
+                    typed = ConstantStep(forest, text, document, argument, storage, ops, shifted,
+                                         forest[given.node]);
+                }
+                switch typed {
+                    case .Failed(diagnostic):
+                        return NativeValues.Failed(given.node, diagnostic.message);
+                    case .Emitted(added_code, added_slots, added_locals, added_cells, added_hosts, added_roots,
+                                  added_calls, added_names, next, popped, value, retained, marks):
+                        code.extend(added_code);
+                        slots.extend(added_slots);
+                        argument = value;
+                }
+                if (argument.storage != port.storage) {
+                    code.extend(NumberCode(ops, argument.storage, port.storage, argument.slot,
+                                           at.slot + length(slots), forest[given.node]));
+                    slots.extend(NumberSlots(argument.storage, port.storage));
+                    argument = Typed(at.slot + length(slots) - 1, port.storage, 0, -1);
+                }
+            }
+        }
+        if (port.default_owner && argument.storage == HandleStorage && argument.container == 0 &&
+            NativeTakes(types, NativePortType(port), argument) &&
+            NativeOwnerZero(forest, text, document, constants, callables, names, package, given.node)) {
+            owner := NativeOwner(types, names, port);
+            if (owner.storage == 0) {
+                return NativeValues.Failed(given.node, "native owner argument requires a compatible self");
+            }
+            owner.slot = argument.slot;
+            declared_owner := names[Lookup(names, "self")];
+            owners.append(RecordOwnerArgument(given.node, argument.slot, declared_owner.record));
+            code.append(SymbolCode(ops, declared_owner.node, forest[given.node]));
+            argument = owner;
+        }
+        arguments[given.parameter] = argument;
+    }
+    index = 0;
+    while (index < total) {
+        port := ports[NativePort(called, index)];
+        source := sources[index];
+        if (source >= 0) {
+            if (port.c_string) {
+                message := CStringMessage(forest, text, source, port.name);
+                if (message != "") {
+                    return NativeValues.Failed(source, message);
+                }
+            }
+        } else {
+            site := Field(forest, call, "arguments");
+            if (!port.has_default || !port.default_supported || port.storage <= 0 || port.container != 0 ||
+                port.storage == StructStorage || port.storage == UnionStorage) {
+                return NativeValues.Failed(call, format_text("default argument '{}' is not supported yet", port.name));
+            }
+            if (port.c_string) {
+                message := CStringTextMessage(port.default_text, port.name);
+                if (message != "") {
+                    return NativeValues.Failed(call, message);
+                }
+            }
+            value := NativePortType(port);
+            value.slot = at.slot + length(slots);
+            slots.append(ValueLocal(port.storage));
+            code.append(ExpressionCode(ops, forest[site]));
+            constant := ConstantCode(ops, port.storage, port.default_bits, value.slot, forest[site]);
+            constant.value_record = port.record;
+            constant.text = port.default_text;
+            constant.has_text = port.storage == TextStorage || port.storage == NativeNameStorage;
+            if (port.default_owner) {
+                owner := NativeOwner(types, names, port);
+                if (owner.storage == 0) {
+                    return NativeValues.Failed(call, "native owner default requires a compatible self");
+                }
+                code.append(SymbolCode(ops, names[Lookup(names, "self")].node, forest[site]));
+                constant = Instruction(ops.owner, HandleStorage, value.slot, 0, 0, 0, forest[site]);
+            }
+            code.append(constant);
+            watch := DefaultWatch(ops, value.slot, port.storage, uint64(0), forest[site]);
+            watch.value_record = port.record;
+            if (port.default_owner) {
+                watch.value_record = names[Lookup(names, "self")].record;
+            }
+            code.append(watch);
+            arguments[index] = value;
+        }
+        index += 1;
+    }
+    return NativeValues.Bound(code, slots, arguments, owners);
+}
+NativeCallPrefix :: (code: Code[], slots: Slot[], before: Work[], step: Step, popped: int) -> Step {
+    switch step {
+        case .Failed(diagnostic):
+            return Step.Failed(diagnostic);
