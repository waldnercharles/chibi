package native_link

// The process-local test scope: a matching typed failure ends this one test
// successfully. Each native test has its own process; nothing unwinds.
FailureRuntime :: (windows: bool, context: bool, static_linux: bool) -> string {
    platform := "";
    if (windows) {
        if (!context) {
            platform = "declare dllimport ptr @GetStdHandle(i32)\ndeclare dllimport i32 @WriteFile(ptr, ptr, i32, ptr, ptr)\n";
        }
        platform = Join([platform, "define internal void @chibi_failure_write(ptr %bytes, i32 %count) {\n  %error = call ptr @GetStdHandle(i32 -12)\n  %written = alloca i32\n  %ignored = call i32 @WriteFile(ptr %error, ptr %bytes, i32 %count, ptr %written, ptr null)\n  ret void\n}\ndefine internal void @chibi_failure_exit(i32 %status) noreturn {\n  call void @ExitProcess(i32 %status)\n  unreachable\n}\n"]);
    } else if (static_linux) {
        platform = "define internal void @chibi_failure_write(ptr %bytes, i32 %count) {\n  %wide = zext i32 %count to i64\n  %ignored = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 1, i64 2, ptr %bytes, i64 %wide)\n  ret void\n}\ndefine internal void @chibi_failure_exit(i32 %status) noreturn {\n  %wide = sext i32 %status to i64\n  call void asm sideeffect \"syscall\", \"{rax},{rdi},~{rcx},~{r11},~{memory}\"(i64 231, i64 %wide)\n  unreachable\n}\n";
    } else {
        platform = "declare i64 @write(i32, ptr, i64)\ndeclare void @_exit(i32) noreturn\ndefine internal void @chibi_failure_write(ptr %bytes, i32 %count) {\n  %wide = zext i32 %count to i64\n  %ignored = call i64 @write(i32 2, ptr %bytes, i64 %wide)\n  ret void\n}\ndefine internal void @chibi_failure_exit(i32 %status) noreturn {\n  call void @_exit(i32 %status)\n  unreachable\n}\n";
    }
    return Join([platform,
        "@chibi_failure_name.0 = private constant [15 x i8] c\"another failure\"\n",
        "@chibi_failure_name.1 = private constant [15 x i8] c\"IndexOutOfRange\"\n",
        "@chibi_failure_name.2 = private constant [12 x i8] c\"MapKeyAbsent\"\n",
        "@chibi_failure_name.3 = private constant [14 x i8] c\"ViewOutOfRange\"\n",
        "@chibi_failure_name.4 = private constant [15 x i8] c\"AssertionFailed\"\n",
        "@chibi_failure_name.5 = private constant [15 x i8] c\"BudgetExhausted\"\n",
        "@chibi_failure_name.6 = private constant [13 x i8] c\"DepthExceeded\"\n",
        "@chibi_failure_name.7 = private constant [12 x i8] c\"UnwrappedNil\"\n",
        "@chibi_failure_names = private constant [8 x ptr] [ptr @chibi_failure_name.0, ptr @chibi_failure_name.1, ptr @chibi_failure_name.2, ptr @chibi_failure_name.3, ptr @chibi_failure_name.4, ptr @chibi_failure_name.5, ptr @chibi_failure_name.6, ptr @chibi_failure_name.7]\n",
        "@chibi_failure_lengths = private constant [8 x i32] [i32 15, i32 15, i32 12, i32 14, i32 15, i32 15, i32 13, i32 12]\n",
        "@chibi_failure_failure = private constant [16 x i8] c\"native failure: \"\n",
        "@chibi_failure_expected = private constant [9 x i8] c\"expected \"\n",
        "@chibi_failure_instead = private constant [21 x i8] c\", but it failed with \"\n",
        "@chibi_failure_returned = private constant [24 x i8] c\", but the test returned\\0A\"\n",
        "@chibi_failure_newline = private constant [1 x i8] c\"\\0A\"\n",
        "@chibi_failure_invalid = private constant [54 x i8] c\"ExpectFailure needs a running test and a failure kind\\0A\"\n",
        "\n",
        "@chibi_test_active = internal global i1 false\n",
        "@chibi_test_expected = internal global i32 0\n",
        "@chibi_native_remaining = internal global i64 0\n",
        "@chibi_native_bounded = internal global i1 false\n",
        "\n",
        "define internal void @chibi_failure_name(i32 %kind) {\n",
        "  %valid = icmp ult i32 %kind, 8\n",
        "  %safe = select i1 %valid, i32 %kind, i32 0\n",
        "  %name.at = getelementptr [8 x ptr], ptr @chibi_failure_names, i32 0, i32 %safe\n",
        "  %name = load ptr, ptr %name.at\n",
        "  %length.at = getelementptr [8 x i32], ptr @chibi_failure_lengths, i32 0, i32 %safe\n",
        "  %length = load i32, ptr %length.at\n",
        "  call void @chibi_failure_write(ptr %name, i32 %length)\n",
        "  ret void\n",
        "}\n",
        "define void @chibi_native_failure(i32 %kind) noreturn {\n",
        "entry:\n",
        "  %expected = load i32, ptr @chibi_test_expected\n",
        "  %same = icmp eq i32 %expected, %kind\n",
        "  %active = load i1, ptr @chibi_test_active\n",
        "  %armed = icmp ne i32 %expected, 0\n",
        "  %matches = and i1 %same, %armed\n",
        "  %passed = and i1 %active, %matches\n",
        "  br i1 %passed, label %pass, label %report\n",
        "pass:\n",
        "  call void @chibi_failure_exit(i32 0)\n",
        "  unreachable\n",
        "report:\n",
        "  br i1 %armed, label %wrong, label %ordinary\n",
        "wrong:\n",
        "  call void @chibi_failure_write(ptr @chibi_failure_expected, i32 9)\n",
        "  call void @chibi_failure_name(i32 %expected)\n",
        "  call void @chibi_failure_write(ptr @chibi_failure_instead, i32 21)\n",
        "  br label %actual\n",
        "ordinary:\n",
        "  call void @chibi_failure_write(ptr @chibi_failure_failure, i32 16)\n",
        "  br label %actual\n",
        "actual:\n",
        "  call void @chibi_failure_name(i32 %kind)\n",
        "  call void @chibi_failure_write(ptr @chibi_failure_newline, i32 1)\n",
        "  %budget = icmp eq i32 %kind, 5\n",
        "  %status = select i1 %budget, i32 125, i32 134\n",
        "  call void @chibi_failure_exit(i32 %status)\n",
        "  unreachable\n",
        "}\n",
        "define i32 @chibi_native_test_begin() {\n",
        "  store i1 true, ptr @chibi_test_active\n",
        "  store i32 0, ptr @chibi_test_expected\n",
        "  store i64 100000000, ptr @chibi_native_remaining\n",
        "  store i1 true, ptr @chibi_native_bounded\n",
        "  ret i32 0\n",
        "}\n",
        "define i32 @chibi_native_test_end() {\n",
        "entry:\n",
        "  %expected = load i32, ptr @chibi_test_expected\n",
        "  store i1 false, ptr @chibi_test_active\n",
        "  store i1 false, ptr @chibi_native_bounded\n",
        "  %armed = icmp ne i32 %expected, 0\n",
        "  br i1 %armed, label %missing, label %pass\n",
        "missing:\n",
        "  call void @chibi_failure_write(ptr @chibi_failure_expected, i32 9)\n",
        "  call void @chibi_failure_name(i32 %expected)\n",
        "  call void @chibi_failure_write(ptr @chibi_failure_returned, i32 24)\n",
        "  ret i32 1\n",
        "pass:\n",
        "  ret i32 0\n",
        "}\n",
        "define i32 @chibi_native_test_expect(i32 %kind) {\n",
        "entry:\n",
        "  %active = load i1, ptr @chibi_test_active\n",
        "  %positive = icmp sgt i32 %kind, 0\n",
        "  %bounded = icmp slt i32 %kind, 8\n",
        "  %valid = and i1 %positive, %bounded\n",
        "  %allowed = and i1 %valid, %active\n",
        "  br i1 %allowed, label %store, label %invalid\n",
        "store:\n",
        "  store i32 %kind, ptr @chibi_test_expected\n",
        "  ret i32 0\n",
        "invalid:\n",
        "  call void @chibi_failure_write(ptr @chibi_failure_invalid, i32 54)\n",
        "  call void @chibi_failure_exit(i32 134)\n",
        "  unreachable\n",
        "}\n",
        "define i32 @chibi_native_scope_begin(i64 %steps) {\n",
        "  store i64 %steps, ptr @chibi_native_remaining\n",
        "  store i1 true, ptr @chibi_native_bounded\n",
        "  ret i32 0\n",
        "}\n",
        "define i32 @chibi_native_scope_end() {\n",
        "  store i1 false, ptr @chibi_native_bounded\n",
        "  ret i32 0\n",
        "}\n",
        "define void @chibi_native_step() {\n",
        "entry:\n",
        "  %remaining = load i64, ptr @chibi_native_remaining\n",
        "  %limited = load i1, ptr @chibi_native_bounded\n",
        "  br i1 %limited, label %bounded, label %done\n",
        "bounded:\n",
        "  %available = icmp ne i64 %remaining, 0\n",
        "  br i1 %available, label %step, label %exhausted\n",
        "step:\n",
        "  %next = sub i64 %remaining, 1\n",
        "  store i64 %next, ptr @chibi_native_remaining\n",
        "  br label %done\n",
        "exhausted:\n",
        "  call void @chibi_native_failure(i32 5)\n",
        "  unreachable\n",
        "done:\n",
        "  ret void\n",
        "}\n",
    ]);
}
