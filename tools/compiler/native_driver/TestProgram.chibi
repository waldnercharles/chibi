package native_driver

import compiler "project:package_compiler"
import facts "project:scalar_facts"
import strings "core:strings"

TestProgram :: struct {
    rows: facts.Row[];
    sources: string[];
    names: string[];
    labels: string[];
    effects: int[];
}

// The first files are the tested package, including its generated entry and
// dispatcher. Imported documents follow, so one joined-byte boundary identifies
// private wrappers without conflating names in other packages.
TestProgramRows :: (collected: compiler.ScalarCollection, paths: string[], sources: string[],
                    main_name: string, dispatcher: string, label: string) -> TestProgram {
    root_end := 0;
    root := Directory(paths[0]);
    for (index in 0..<length(paths)) {
        if (Directory(paths[index]) != root) { break; }
        root_end += strings.ByteLength(sources[index]);
        if (!strings.HasSuffix(sources[index], "\n")) { root_end += 1; }
    }
    // The ordinary finder groups project exports by their owning namespace.
    // Sort package IDs once, then group concrete ordinals with counting offsets.
    // Core imports do not become tests; an explicit core-root invocation keeps
    // its existing selected-package label.
    package_names := resize([""], length(collected.test_packages));
    for (identity, package in collected.test_packages) {
        if (package == collected.test_root) { package_names[package] = label; }
        else if (strings.HasPrefix(identity, "project:")) {
            relative := strings.TrimPrefix(identity, "project:");
            if (relative == "") { relative = "project"; }
            package_names[package] = relative;
        }
    }
    offsets := resize([int(0)], length(package_names));
    from: int[] = [];
    for (selected in collected.tests) {
        if (offsets[selected.package] == 0) { from.append(selected.package); }
        offsets[selected.package] += 1;
    }
    to := resize([int(0)], length(from));
    width := 1;
    while (width < length(from)) {
        first := 0;
        while (first < length(from)) {
            middle := first + width;
            if (middle > length(from)) { middle = length(from); }
            end := middle + width;
            if (end > length(from)) { end = length(from); }
            left := first;
            right := middle;
            at := first;
            while (at < end) {
                if (right >= end || (left < middle && strings.Compare(package_names[from[left]], package_names[from[right]]) <= 0)) {
                    to[at] = from[left]; left += 1;
                } else { to[at] = from[right]; right += 1; }
                at += 1;
            }
            first = end;
        }
        previous := from; from = to; to = previous;
        width *= 2;
    }
    total := 0;
    for (package in from) {
        count := offsets[package];
        offsets[package] = total;
        total += count;
    }
    positions: int[] = [];
    for (selected in collected.tests) {
        positions.append(offsets[selected.package]);
        offsets[selected.package] += 1;
    }
    names := resize([""], length(collected.tests));
    labels := resize([""], length(collected.tests));
    masks := resize([int(0)], length(collected.tests));
    targets := resize([int(0)], length(collected.tests));
    dispatcher_head := -1;
    dispatcher_function := -1;
    entry_function := -1;
    function := 0;
    test := 0;
    awaits := false;
    for (row, index in collected.rows) {
        if (row.kind != facts.FunctionRow) { continue; }
        if (test < length(collected.tests) && collected.tests[test].function == function) {
            position := positions[test];
            names[position] = row.name;
            labels[position] = package_names[collected.tests[test].package];
            masks[position] = collected.effects[function];
            targets[position] = function;
            awaits = awaits || collected.waiting[function];
            test += 1;
        }
        if (row.start < root_end) {
            if (row.name == dispatcher) { dispatcher_function = function; dispatcher_head = index; }
            else if (row.name == main_name) { entry_function = function; }
        }
        function += 1;
    }
    assert(test == length(collected.tests) && function == length(collected.effects) &&
           function == length(collected.waiting) && dispatcher_function >= 0 && entry_function >= 0,
           "typed test metadata follows the collected functions");

    // The private source contains one checked branch. Clone its facts for the
    // actual concrete test set, including generic specializations. Regenerate
    // only this virtual file and rebase later locations; authored files stay
    // byte-for-byte identical and never pass through a second compiler.
    template_at := dispatcher_head + 2;
    assert(collected.rows[dispatcher_head].count == 1 &&
           collected.rows[template_at].kind == facts.IfRow && collected.rows[template_at].count == 3 &&
           collected.rows[template_at + 1].kind == facts.ReadRow &&
           collected.rows[template_at + 2].kind == facts.LiteralRow &&
           collected.rows[template_at + 3].kind == facts.CompareRow &&
           collected.rows[template_at + 4].kind == facts.LocalRow &&
           collected.rows[template_at + 5].kind == facts.LiteralRow &&
           collected.rows[template_at + 6].kind == facts.EndRow &&
           collected.rows[template_at + 7].kind == facts.ReturnRow,
           "the generated dispatcher owns one checked branch template");
    file := -1;
    file_start := 0;
    for (source, index in sources) {
        span := strings.ByteLength(source);
        if (!strings.HasSuffix(source, "\n")) { span += 1; }
        if (collected.rows[dispatcher_head].start < file_start + span) { file = index; break; }
        file_start += span;
    }
    assert(file >= 0, "dispatcher belongs to its virtual source file");
    template := collected.rows[template_at];
    token := collected.rows[template_at + 2];
    prefix_size := template.start - file_start - template.column + 1;
    parts := [strings.Slice(sources[file], 0, prefix_size)];
    lines: string[] = [];
    for (index in 0..<length(names)) {
        line := TestPlaceholder(index);
        parts.append(line);
        lines.append(line);
    }
    parts.append("}\n");
    expanded := strings.Concatenate(parts);
    file_end := file_start + strings.ByteLength(sources[file]);
    shifted := strings.ByteLength(expanded) - strings.ByteLength(sources[file]);
    added_lines := length(names) - 1;
    changed_sources := sources;
    joined := collected.rows[0].text;
    if (shifted != 0) {
        changed_sources[file] = expanded;
        parts = [];
        for (source in changed_sources) {
            parts.append(source);
            if (!strings.HasSuffix(source, "\n")) { parts.append("\n"); }
        }
        joined = strings.Concatenate(parts);
    }

    rows: facts.Row[] = [];
    line_size := strings.ByteLength(lines[0]);
    function = -1;
    at := 0;
    count_bound := false;
    while (at < length(collected.rows)) {
        if (at == template_at) {
            advance := 0;
            for (target, index in targets) {
                // Only the rendered ordinal changes width within a branch.
                extra := strings.ByteLength(lines[index]) - line_size;
                for (step in 0..<7) {
                    changed := collected.rows[template_at + step];
                    if (changed.start > token.start) { changed.start += extra; changed.column += extra; }
                    if (changed.end > token.start) { changed.end += extra; }
                    changed.start += advance;
                    changed.end += advance;
                    changed.line += index;
                    if (step == 2) { changed.literal = i64(index); }
                    else if (step == 4) { changed.value = index + 1; }
                    else if (step == 5) {
                        changed.kind = facts.CallRow;
                        changed.value = target;
                        changed.name = names[index];
                        if (collected.waiting[target]) { changed.literal = i64(facts.CallAwaited); }
                    }
                    rows.append(changed);
                }
                advance += strings.ByteLength(lines[index]);
            }
            at += 7;
            continue;
        }
        row := collected.rows[at];
        if (row.kind == facts.FunctionRow) { function += 1; }
        if (at == 0) { row.text = joined; }
        else if (at == dispatcher_head) {
            row.end += shifted;
            if (awaits) { row.value = facts.FunctionVoid; }
        } else if ((function == dispatcher_function && row.kind != facts.ParameterRow) ||
                   (row.start >= file_end && row.end > row.start)) {
            row.start += shifted;
            row.end += shifted;
            row.line += added_lines;
        }
        if (function == entry_function && row.kind == facts.CompareRow && row.value == facts.GreaterEqual) {
            assert(!count_bound && length(rows) > 0 && rows[length(rows) - 1].kind == facts.LiteralRow,
                   "generated entry has one literal count bound");
            rows[length(rows) - 1].literal = i64(length(names));
            count_bound = true;
        } else if (awaits && function == entry_function && row.kind == facts.CallRow && row.value == dispatcher_function) {
            row.literal = i64(facts.CallAwaited);
        }
        rows.append(row);
        at += 1;
    }
    assert(count_bound, "generated entry uses the concrete test count");
    return {rows: rows, sources: changed_sources, names: names, labels: labels, effects: masks};
}
