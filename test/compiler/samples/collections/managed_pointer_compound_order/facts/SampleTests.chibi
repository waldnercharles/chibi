package facts

// managed pointer compound order
@test
Calls :: () {
    r1: int = Through();
    e1: int = 311;
    assert(r1 == e1, "Through call 1");
    r2: int = Local();
    e2: int = 310;
    assert(r2 == e2, "Local call 2");
    r3: int = Member();
    e3: int = 311;
    assert(r3 == e3, "Member call 3");
    r4: int = Owned();
    e4: int = 310;
    assert(r4 == e4, "Owned call 4");
}
