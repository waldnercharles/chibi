package scalar_llvm

import facts "project:scalar_facts"
import native "project:llvm_native"
import abi "project:native_abi"
import strings "core:strings"

// Internal consumer result, not another source/facts representation. Rejections
// preserve the exact producer rows, including their source and diagnostic.
pub Result :: union {
    Rejected(rows: facts.Row[]) | Invalid(message: string) | Emitted(text: string)
}

// The most rows a module of the facts bounds holds: its source and document,
// then per function its signature, parameters, guards with their arms' returns,
// final return and operands.
MaxRows: int : 2 + facts.MaxFunctions * (2 + facts.MaxParameters + 2 * facts.MaxGuards + facts.MaxOperands);

// The offset each source line starts at, for one-based line/column checks.
LineStarts :: (text: string) -> int[] {
    starts: int[] = [0];
    bytes := strings.Bytes(text);
    for (index in 0..<length(bytes)) {
        if (bytes[index] == 10) {
            starts.append(index + 1);
        }
    }
    return starts;
}
// A half-open range of the source, at its recorded one-based line and column.
Positioned :: (row: facts.Row, starts: int[], size: int) -> bool {
    if (row.start < 0 || row.end < row.start || row.end > size || row.line < 1 || row.line > length(starts)) {
        return false;
    }
    first := starts[row.line - 1];
    return first <= row.start && (row.line == length(starts) || row.start < starts[row.line]) &&
           row.column == row.start - first + 1;
}
Located :: (row: facts.Row, starts: int[], size: int) -> bool {
    return row.end > row.start && Positioned(row, starts, size);
}
Within :: (inner: facts.Row, outer: facts.Row) -> bool {
    return inner.start >= outer.start && inner.end <= outer.end;
}
Unlocated :: (row: facts.Row) -> bool {
    return row.start == 0 && row.end == 0 && row.line == 0 && row.column == 0;
}
Scalar :: (type: int) -> bool {
    return type >= facts.IntType && type <= facts.WordType;
}
Integer :: (type: int) -> bool {
    return facts.Bits(type) != 0;
}
// The backend's storage ordinal of a scalar type: the storages of int, bool,
// int8, byte, int16, uint16, uint, int64 and uint64 in facts type order.
NativeType :: (type: int) -> int {
    storages: int[] = [6, 1, 2, 3, 4, 5, 7, 8, 9];
    return storages[type - facts.IntType];
}
// A rejection keeps exactly its source and one located diagnostic.
ValidRejection :: (rows: facts.Row[], starts: int[], size: int) -> string {
    rejection := rows[1];
    if (length(rows) != 2 || rejection.type != 0 || rejection.value != 0 || rejection.count != 0 ||
        rejection.literal != 0 || rejection.name != "" || rejection.text == "") {
        return "noncanonical rejected scalar module";
    }
    if (!Positioned(rejection, starts, size)) {
        return "invalid scalar diagnostic position";
    }
    return "";
}
// The row after the segment at `at`, a row of `kind` and its `count`
// operands, when its count is within the bounds with `used` operands before
// it; otherwise -1.
Span :: (rows: facts.Row[], at: int, kind: int, used: int) -> int {
    if (at >= length(rows) || rows[at].kind != kind) {
        return -1;
    }
    count := rows[at].count;
    if (count < 1 || count > facts.MaxOperands - used || count > length(rows) - at - 1) {
        return -1;
    }
    return at + count + 1;
}
// The row index of each function, after checking the module's row layout and
// every count against the facts bounds before it is used. Empty when invalid.
Heads :: (rows: facts.Row[]) -> int[] {
    heads: int[] = [];
    empty: int[] = [];
    at: int = 2;
    while (at < length(rows)) {
        function := rows[at];
        if (function.kind != facts.FunctionRow || function.count < 0 || function.count > facts.MaxParameters ||
            length(heads) >= facts.MaxFunctions || at + function.count + 1 >= length(rows)) {
            return empty;
        }
        heads.append(at);
        at += function.count + 1;
        used: int = 0;
        guards: int = 0;
        while (at < length(rows) && rows[at].kind == facts.GuardRow && guards < facts.MaxGuards) {
            arm := Span(rows, at, facts.GuardRow, used);
            if (arm < 0) {
                return empty;
            }
            used += rows[at].count;
            next := Span(rows, arm, facts.ReturnRow, used);
            if (next < 0) {
                return empty;
            }
            used += rows[arm].count;
            guards += 1;
            at = next;
        }
        at = Span(rows, at, facts.ReturnRow, used);
        if (at < 0) {
            return empty;
        }
    }
    return heads;
}
// The segment rows of the function at `head` of a valid layout: each guard
// and its arm's return, then the final return.
Segments :: (rows: facts.Row[], head: int) -> int[] {
    segments: int[] = [];
    at := head + rows[head].count + 1;
    while (rows[at].kind == facts.GuardRow) {
        segments.append(at);
        at += rows[at].count + 1;
        segments.append(at);
        at += rows[at].count + 1;
    }
    segments.append(at);
    return segments;
}
// The operands after the segment row at `at`, as a typed evaluation stack:
// each operand pushes one value; a comparison or binary arithmetic pops two
// integers of one type, unary arithmetic and a conversion one, and a call its
// arguments in order. They must leave one value of type `result`, and each
// lies within `scope`.
ValidOperands :: (rows: facts.Row[], heads: int[], head: int, at: int, result: int, scope: facts.Row, starts: int[],
                  size: int) -> string {
    declaration := rows[head];
    stack: int[] = [];
    first := at + 1;
    for (row in first..<first + rows[at].count) {
        operand := rows[row];
        if (operand.text != "" || !Scalar(operand.type) || !Located(operand, starts, size) ||
            !Within(operand, scope) || (operand.kind != facts.LiteralRow && operand.literal != 0)) {
            return "invalid scalar operand row";
        }
        if (operand.kind == facts.LiteralRow) {
            if (operand.name != "" || operand.count != 0 || operand.value != 0 ||
                !facts.Fits(operand.literal, operand.type)) {
                return "noncanonical scalar literal";
            }
        } else if (operand.kind == facts.ReadRow) {
            if (operand.name != "" || operand.count != 0 || operand.value < 0 || operand.value >= declaration.count ||
                rows[head + 1 + operand.value].type != operand.type) {
                return "scalar read differs from its parameter";
            }
        } else if (operand.kind == facts.CompareRow) {
            base := length(stack) - 2;
            if (operand.name != "" || operand.count != 2 || operand.type != facts.BoolType ||
                operand.value < facts.Less || operand.value > facts.NotEqual || base < 0 ||
                !Integer(stack[base]) || stack[base + 1] != stack[base]) {
                return "scalar comparison differs from its integer operands";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.ArithmeticRow) {
            base := length(stack) - 2;
            if (operand.name != "" || operand.count != 2 || !Integer(operand.type) ||
                operand.value < facts.Add || operand.value > facts.ShiftRight || base < 0 ||
                stack[base] != operand.type || stack[base + 1] != operand.type) {
                return "scalar arithmetic differs from its integer operands";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.UnaryRow) {
            base := length(stack) - 1;
            if (operand.name != "" || operand.count != 1 || !Integer(operand.type) ||
                operand.value < facts.Negate || operand.value > facts.Complement || base < 0 ||
                stack[base] != operand.type) {
                return "scalar arithmetic differs from its integer operands";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.ConvertRow) {
            base := length(stack) - 1;
            if (operand.name != "" || operand.count != 1 || !Integer(operand.type) ||
                (operand.value != facts.Clamp && operand.value != facts.Wrap) || base < 0 || !Integer(stack[base])) {
                return "scalar conversion is not between integer types";
            }
            stack = slice(stack, 0, base);
        } else if (operand.kind == facts.CallRow) {
            if (operand.value < 0 || operand.value >= length(heads)) {
                return "scalar call names no function of the module";
            }
            callee := rows[heads[operand.value]];
            if (operand.name != callee.name || operand.type != callee.type || operand.count != callee.count ||
                operand.count > length(stack)) {
                return "scalar call differs from its callee's signature";
            }
            base := length(stack) - operand.count;
            for (argument in 0..<operand.count) {
                if (stack[base + argument] != rows[heads[operand.value] + 1 + argument].type) {
                    return "scalar call argument differs from its parameter";
                }
            }
            stack = slice(stack, 0, base);
        } else {
            return "invalid scalar operand row";
        }
        stack.append(operand.type);
    }
    if (length(stack) != 1 || stack[0] != result) {
        if (rows[at].kind == facts.GuardRow) {
            return "scalar condition is not one bool";
        }
        return "scalar return differs from its function's result";
    }
    return "";
}
// One function's signature and segments. A guard's condition lies before its
// arm, its arm within it, and each segment after the one before it.
ValidFunction :: (rows: facts.Row[], heads: int[], function: int, starts: int[], size: int) -> string {
    head := heads[function];
    declaration := rows[head];
    if (declaration.name == "" || declaration.text != "" || !Scalar(declaration.type) || declaration.value != 0 ||
        declaration.literal != 0 || !Located(declaration, starts, size)) {
        return "invalid scalar function row";
    }
    for (index in 0..<declaration.count) {
        param := rows[head + 1 + index];
        if (param.kind != facts.ParameterRow || param.name == "" || param.text != "" || !Scalar(param.type) ||
            param.value != index || param.count != 0 || param.literal != 0 || !Located(param, starts, size) ||
            !Within(param, declaration)) {
            return "invalid scalar parameter row";
        }
    }
    segments := Segments(rows, head);
    // The least start of the next segment, and the end of the last guard.
    earliest: int = 0;
    guarded: int = 0;
    for (index in 0..<length(segments)) {
        at := segments[index];
        segment := rows[at];
        if (segment.name != "" || segment.text != "" || segment.type != 0 || segment.value != 0 ||
            segment.literal != 0 || !Located(segment, starts, size) || !Within(segment, declaration) || segment.start < earliest) {
            return "invalid scalar return row";
        }
        error := "";
        if (segment.kind == facts.GuardRow) {
            arm := rows[segments[index + 1]];
            condition := segment;
            condition.end = arm.start;
            if (!Within(arm, segment)) {
                return "invalid scalar return row";
            }
            error = ValidOperands(rows, heads, head, at, facts.BoolType, condition, starts, size);
            earliest = segment.start;
            guarded = segment.end;
        } else {
            error = ValidOperands(rows, heads, head, at, declaration.type, segment, starts, size);
            earliest = segment.end;
            if (guarded > earliest) {
                earliest = guarded;
            }
        }
        if (error != "") {
            return error;
        }
    }
    return "";
}
// This validates the bounded representation, not the truth of fabricated
// accepted rows. The caller must bind the actual trusted producer artifact,
// source bytes and unchanged result envelope. No source parsing occurs here.
pub Validate :: (rows: facts.Row[]) -> string {
    if (length(rows) < 2 || length(rows) > MaxRows) {
        return "scalar module row count is out of bounds";
    }
    source := rows[0];
    if (source.kind != facts.SourceRow || source.type != 0 || source.value != 0 || source.count != 0 ||
        source.literal != 0 || source.name == "" || !Unlocated(source)) {
        return "noncanonical scalar source row";
    }
    size := strings.ByteLength(source.text);
    starts := LineStarts(source.text);
    // A rejection may hold any source, including one past the bound.
    if (rows[1].kind == facts.RejectionRow) {
        return ValidRejection(rows, starts, size);
    }
    if (size > facts.MaxSource) {
        return format_text("scalar consumer source exceeds {} bytes", facts.MaxSource);
    }
    document := rows[1];
    if (document.kind != facts.DocumentRow || document.type != 0 || document.value != 0 || document.count != 0 ||
        document.literal != 0 || document.name == "" || document.text != "" || !Unlocated(document)) {
        return "noncanonical accepted scalar module";
    }
    heads := Heads(rows);
    if (length(heads) == 0) {
        return "invalid scalar module layout";
    }
    first := rows[heads[0]];
    if (first.count != 0 || first.type != facts.IntType) {
        return "scalar module entry must take no parameters and return int";
    }
    for (function in 0..<length(heads)) {
        error := ValidFunction(rows, heads, function, starts, size);
        if (error != "") {
            return error;
        }
    }
    if (facts.Cycle(rows) >= 0) {
        return "scalar module calls are recursive";
    }
    return "";
}

// The native comparison of a facts operator: facts.Less through
// facts.NotEqual are in the order of native.Lt through native.Ne.
Comparison :: (operator: int) -> int {
    return native.Lt + operator - facts.Less;
}
// The native operation of a facts arithmetic operator.
Arithmetic :: (operator: int) -> int {
    operations := [native.Add, native.Sub, native.Mul, native.Div, native.Mod, native.BitAnd, native.BitOr,
                   native.BitXor, native.Shl, native.Shr];
    return operations[operator - facts.Add];
}
Unary :: (operator: int) -> int {
    if (operator == facts.Negate) {
        return native.Neg;
    }
    return native.BitNot;
}
// Explicit backend-fixture policy: the entry is chibi_scalar() -> i32 and the
// other functions are internal. Every function starts with one CHECK under
// budget 1. Neither the export name nor the budget is inferred from source
// identity, and no general runtime/default budget is introduced. Each operand
// row is one slot, defined in row order, so evaluation order is the rows'.
// A guard's condition ends in a branch to its arm, which follows the final
// return's code; when the condition is false, code continues after the
// branch, so an arm runs only when its guard holds.
pub Emit :: (rows: facts.Row[]) -> Result {
    error := Validate(rows);
    if (error != "") {
        return Result.Invalid(error);
    }
    if (rows[1].kind == facts.RejectionRow) {
        return Result.Rejected(rows);
    }
    functions: native.Function[] = [];
    parameters: int[] = [];
    slots: int[] = [];
    locals: int[] = [];
    code: native.Instruction[] = [];
    arguments: int[] = [];
    heads := Heads(rows);
    for (head in heads) {
        declaration := rows[head];
        result := NativeType(declaration.type);
        shape: native.Function = {result: result, first_parameter: length(parameters),
                                  parameters: declaration.count, first_slot: length(slots), slots: 0,
                                  first_local: 0, locals: 0, first_code: length(code), code: 0,
                                  first_argument: length(arguments), arguments: 0};
        for (index in 0..<declaration.count) {
            parameters.append(NativeType(rows[head + 1 + index].type));
        }
        check: native.Instruction = {op: native.Check, type: 0, output: 0, left: 0, right: 0, target: 0, literal: 0};
        straight: native.Instruction[] = [check];
        arms: native.Instruction[] = [];
        // Each guard's branch in `straight` and its arm's offset in `arms`.
        branches: int[] = [];
        targets: int[] = [];
        armed := false;
        slot: int = 0;
        for (at in Segments(rows, head)) {
            segment := rows[at];
            stack: int[] = [];
            part: native.Instruction[] = [];
            first := at + 1;
            for (index in first..<first + segment.count) {
                operand := rows[index];
                type := NativeType(operand.type);
                slots.append(type);
                item: native.Instruction = {op: native.Constant, type: type, output: slot, left: 0, right: 0,
                                            target: 0, literal: operand.literal};
                if (operand.kind == facts.ReadRow) {
                    item = {op: native.Argument, type: type, output: slot, left: operand.value, right: 0, target: 0,
                            literal: 0};
                } else if (operand.kind == facts.CompareRow) {
                    base := length(stack) - 2;
                    item = {op: Comparison(operand.value), type: slots[shape.first_slot + stack[base]], output: slot,
                            left: stack[base], right: stack[base + 1], target: 0, literal: 0};
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.ArithmeticRow) {
                    base := length(stack) - 2;
                    item = {op: Arithmetic(operand.value), type: type, output: slot, left: stack[base],
                            right: stack[base + 1], target: 0, literal: 0};
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.UnaryRow) {
                    base := length(stack) - 1;
                    item = {op: Unary(operand.value), type: type, output: slot, left: stack[base], right: 0,
                            target: 0, literal: 0};
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.ConvertRow) {
                    base := length(stack) - 1;
                    item = {op: native.Convert, type: type, output: slot, left: stack[base],
                            right: slots[shape.first_slot + stack[base]], target: 0, literal: int64(operand.value)};
                    stack = slice(stack, 0, base);
                } else if (operand.kind == facts.CallRow) {
                    item = {op: native.Call, type: type, output: slot, left: operand.value, right: shape.arguments,
                            target: operand.count, literal: 0};
                    base := length(stack) - operand.count;
                    for (argument in 0..<operand.count) {
                        arguments.append(stack[base + argument]);
                    }
                    shape.arguments += operand.count;
                    stack = slice(stack, 0, base);
                }
                part.append(item);
                stack.append(slot);
                slot += 1;
            }
            if (segment.kind == facts.GuardRow) {
                straight.extend(part);
                branches.append(length(straight));
                targets.append(length(arms));
                jump: native.Instruction = {op: native.Branch, type: 0, output: 0, left: stack[0], right: 0,
                                            target: 0, literal: 0};
                straight.append(jump);
                armed = true;
                continue;
            }
            publish: native.Instruction = {op: native.Publish, type: result, output: 0, left: stack[0], right: 0,
                                           target: 0, literal: 0};
            finish: native.Instruction = {op: native.Return, type: 0, output: 0, left: 0, right: 0, target: 0,
                                          literal: 0};
            part.extend([publish, finish]);
            if (armed) {
                arms.extend(part);
            } else {
                straight.extend(part);
            }
            armed = false;
        }
        for (index in 0..<length(branches)) {
            jump := straight[branches[index]];
            jump.target = length(straight) + targets[index];
            straight[branches[index]] = jump;
        }
        shape.slots = slot;
        shape.code = length(straight) + length(arms);
        code.extend(straight);
        code.extend(arms);
        functions.append(shape);
    }
    switch native.Emit(abi.LinuxX64(), functions, parameters, slots, locals, code, arguments, false, 1) {
        case .Rejected(instruction, message):
            return Result.Invalid(message);
        case .Emitted(text):
            return Result.Emitted(text);
    }
}

// Existing compiler-host --output-bytes rejects an empty result before file
// publication. Emit retains typed diagnostics; this entry adds no host codec.
pub EmitBytes :: (rows: facts.Row[]) -> byte[] {
    output: byte[] = [];
    switch Emit(rows) {
        case .Rejected(rejected):
            return output;
        case .Invalid(message):
            return output;
        case .Emitted(text):
            for (item in strings.Bytes(text)) {
                output.append(byte(item));
            }
            return output;
    }
}
