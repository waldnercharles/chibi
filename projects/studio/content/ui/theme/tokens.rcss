/* Roles and metrics: the dark palette on body, the light one on body.light, and
   body.comfortable's larger controls. */
body {
    /* Surfaces, darkest to lightest. */
    --app: #161618;
    --area: #28282b;
    --header: #2e2e31;
    --panel: #303034;
    --panel-head: #36363a;
    --field: #424247;
    --field-hover: #4b4b51;
    --field-press: #3a3a3f;
    --field-edit: #1d1d20;
    --input: #1d1d20;
    --popover: #1c1c1e;
    --viewport: #1e1e20;
    --canvas: #1c1c1e;
    /* Lines. */
    --line: #ffffff10;
    --line-strong: #ffffff1c;
    --edge: #0e0e10;
    --popover-edge: #ffffff1c;
    /* Text. */
    --fg: #e5e5e8;
    --fg-2: #adadb5;
    --fg-3: #7a7a83;
    --fg-off: #58585f;
    /* Roles. */
    --accent: #4772b3;
    --accent-hover: #5282c6;
    --accent-soft: #4772b33a;
    --selected: #1d314d;
    --active-row: #334d80;
    --hover: #ffffff0f;
    --press: #ffffff1a;
    --ring: #73abff;
    --override: #19b6b6;
    --danger: #e5534b;
    --warning: #d9a53d;
    --success: #57ab5a;
    --on-accent: #ffffff;
    --accent-fg: #9dbef5;       /* accent-tinted text and icons on neutral surfaces */
    --fill: #4772b3b8;          /* slider fill */
    --fill-hover: #4772b3d8;
    --input-hover: #232327;
    --panel-head-hover: #3a3a3f;
    --strong: #ffffff;          /* emphasized text: matches, active rows */
    --highlight: #d9a53d44;     /* search hits */
    --override-fg: #7fe0d4;
    --override-soft: #3db4a61f;
    --tooltip: #111113;
    --tooltip-edge: #333338;
    --backdrop: #0000004d;
    --item-selected: #ffffff12; /* keyboard selection in lists without accent fill */
    --scrollbar: #ffffff1f;
    --scrollbar-hover: #ffffff33;
    --axis-x: #e0727a;
    --axis-y: #82c46b;
    --link: #8fb4ee;
    --rail: #232326;            /* Properties context tabs */
    --floating: #2c2c30e6;      /* overlays on the viewport */
    --notice: #1a1612f0;
    --notice-fg: #ffad66;
    --accent-edge: #4772b3aa;
    --accent-wash: #4772b355;
    /* Code tokens (highlight.c). */
    --tok-number: #b5cea8;
    --tok-string: #ce9178;
    --tok-keyword: #c586c0;
    --tok-name: #9cdcfe;
    --tok-path: #8fb4ee;
    --tok-punct: #8b8b94;
    /* Metrics; body.comfortable scales controls, not text. */
    --h: 22dp;
    --text-line: 20dp; /* text line inside a bordered control */
    --h-sm: 18dp;
    --row: 22dp;
    --gap: 2dp;
    --header-h: 28dp;
    --r: 4dp;
    --r-lg: 6dp;

    font-family: Inter;
    font-size: 12dp;
    line-height: 16dp;
    color: var(--fg);
}
/* Light theme: the same roles on a zinc scale. The viewport keeps its dark canvas. */
body.light {
    --app: #c7c7cd; --area: #f4f4f5; --header: #e7e7ea; --panel: #ebebee; --panel-head: #e0e0e4;
    --field: #d9d9de; --field-hover: #cfcfd5; --field-press: #c6c6cd; --field-edit: #ffffff; --input: #ffffff;
    --popover: #ffffff; --canvas: #f7f7f8;
    --line: #00000010; --line-strong: #0000001f; --edge: #c2c2c8; --popover-edge: #00000024;
    --fg: #18181b; --fg-2: #52525b; --fg-3: #71717a; --fg-off: #a1a1aa;
    --accent: #3b6fc2; --accent-hover: #3264b3; --accent-soft: #3b6fc226; --selected: #d6e3f7; --active-row: #b8cff2;
    --hover: #0000000b; --press: #00000016; --ring: #3b82f6;
    --override: #0e9494; --danger: #d73a31; --warning: #b7791f; --success: #2f8f3a;
    --accent-fg: #2f5fa8; --fill: #3b6fc28c; --fill-hover: #3b6fc2b0; --input-hover: #fafafa; --panel-head-hover: #d8d8dd;
    --strong: #000000; --highlight: #e8b64a66; --override-fg: #0b7d73; --override-soft: #0e94941f;
    --tooltip: #18181b; --tooltip-edge: #18181b; --backdrop: #00000033; --item-selected: #0000000d;
    --scrollbar: #00000026; --scrollbar-hover: #00000040; --axis-x: #c2413b; --axis-y: #3f8f2f; --link: #2f5fa8;
    --rail: #e4e4e8; --floating: #ffffffe6; --notice: #fff4e5f0; --notice-fg: #9a4d00;
    --accent-edge: #3b6fc2aa; --accent-wash: #3b6fc244;
    --tok-number: #098658; --tok-string: #a31515; --tok-keyword: #af00db; --tok-name: #0451a5; --tok-path: #2f5fa8; --tok-punct: #6e6e76;
}
body.light .tooltip { color: #fafafa; }
body.light .tooltip .kbd { color: #a1a1aa; }
/* next-themes: a palette change must not animate element by element. */
body.theme-switching * { transition: none; }
body.comfortable { --h: 26dp; --text-line: 24dp; --h-sm: 20dp; --row: 26dp; --gap: 3dp; --header-h: 32dp; }

@media (theme: reduced-motion) {
    * { transition: none; }
}
