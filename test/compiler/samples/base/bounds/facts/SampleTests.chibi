package facts

// bounds
@test
Calls :: () {
    a1_0: int[] = [1, 2];
    a1_1: int = 1;
    r1: int = Pick(a1_0, a1_1);
    e1: int = 2;
    assert(r1 == e1, "Pick call 1");
}

// fails: array index out of range
@test
PickBeforeTheStartFails :: () {
    xs: int[] = [1, 2];
    Pick(xs, -1);
}

// fails: array index out of range
@test
PickFromEmptyFails :: () {
    xs: int[] = [];
    Pick(xs, 0);
}
