version 1
name "MaterialShowcaseThermalClosed"
(array)entities {
    - name="Materials" prototype="MaterialShowcaseThermalClosedWorld"
    - {
        name "Camera"
        prototype "MaterialShowcaseEntity"
        components {
            GameCamera width=260.0 height=180.0
        }
    }
    - {
        name "Floor"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=0.0 y=64.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=204.0 height=8.0 category=8 mask=15 friction=0.6
            GameAppearance width=204.0 height=8.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Left wall"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=-100.0 y=-4.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=8.0 height=144.0 category=8 mask=15 friction=0.6
            GameAppearance width=8.0 height=144.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Right wall"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=100.0 y=-4.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=8.0 height=144.0 category=8 mask=15 friction=0.6
            GameAppearance width=8.0 height=144.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Ceiling"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=0.0 y=-58.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=204.0 height=8.0 category=8 mask=15 friction=0.6
            GameAppearance width=204.0 height=8.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Barrier"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=0.0 y=3.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=6.0 height=114.0 category=8 mask=15 friction=0.6
            GameAppearance width=6.0 height=114.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
            GameDestructible cell_size=2.0 min_fragment_cells=6
            GameSubstance hardness=1.0 retain_chips=#false
            MaterialBreakProfile chip_speed=4.0 fragment_speed=3.0 release_speed=2.0 dust_limit=0 chunk_limit=0 smoke_count=0
        }
    }
    - {
        name "Coolant"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=-42.0 y=8.0
            GameFluidVolume {
                kind "Liquid"
                width 40.0
                height 64.0
                spacing 0.25
                mass 6.25e-05
                color 0x369de8ff
                velocity x=20.0 y=-2.0
                absorption 0.08
                visibility 0.4
                refraction 0.0
                grain_radius 0.0
            }
            MaterialConstitutive density=0.001 bulk_modulus=4.0 shear_modulus=0.0
            MaterialThermal capacity=128.0 conductivity=200.0
            GameIgniter heat=0.0
        }
    }
    - {
        name "Fuel"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=42.0 y=-8.0
            GameFluidVolume {
                kind "Liquid"
                width 40.0
                height 64.0
                spacing 0.25
                mass 6.25e-05
                color 0xf3b24aff
                velocity x=-20.0 y=2.0
                absorption 0.08
                visibility 0.4
                refraction 0.0
                grain_radius 0.0
            }
            MaterialConstitutive density=0.001 bulk_modulus=4.0 shear_modulus=0.0
            MaterialThermal capacity=1.0 conductivity=200.0
            GameIgniter heat=1.0
            GameFuel amount=0.0025
        }
    }
}
