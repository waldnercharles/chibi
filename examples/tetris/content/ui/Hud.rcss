body { color: #e8ecff; font-size: 20dp; }
div { display: block; }
#hud { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.label { color: #8a93c0; font-size: 16dp; }
.value { font-size: 24dp; margin-bottom: 12dp; }
#hold { position: absolute; left: 15%; top: 5.5%; }
#next { position: absolute; left: 72%; top: 5.5%; }
#stats { position: absolute; left: 72%; top: 33%; }
#over { position: absolute; left: 0; top: 42%; width: 100%; text-align: center; font-size: 36dp; color: #ffffff; }
#restart { position: absolute; left: 0; top: 50%; width: 100%; text-align: center; font-size: 20dp; color: #c8cce8; }
