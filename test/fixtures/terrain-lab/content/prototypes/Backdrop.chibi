package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Backdrop")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Appearance", data.Object([
                    data.Field.Named("color", data.Value.UInt(321336319)),
                    data.Field.Named("height", data.Value.Real(560.0)),
                    data.Field.Named("layer", data.Value.Int(-10)),
                    data.Field.Named("width", data.Value.Real(1600.0))
                ])),
                data.Field.Named("Transform", data.Object([]))
            ]))
        ])
    );
}
