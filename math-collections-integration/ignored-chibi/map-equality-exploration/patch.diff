+// The common map type of an equality's operands, or -1 for another expression.
+ScalarMapCompared :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], names: Name[],
+                      types: TypeDecl[], package: int, node: int) -> int {
+    if (!Is(forest, node, syntax.BinaryExpression) ||
+        (Operator(forest, node) != tk.CmpEq && Operator(forest, node) != tk.NotEq)) {
+        return -1;
+    }
+    left := ScalarMapShape(forest, text, callables, names, types, package, Field(forest, node, syntax.FieldLeft));
+    right := ScalarMapShape(forest, text, callables, names, types, package, Field(forest, node, syntax.FieldRight));
+    if (left < 0 || right < 0 || ScalarMapType(types, left) != ScalarMapType(types, right)) { return -1; }
+    return left;
+}
+ScalarMapComparison :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
+                        callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
+                        constants: ConstDecl[], node: int, record: int, rows: facts.Row[]) -> ScalarOperands {
+    output := rows;
+    left := Unparenthesized(forest, Field(forest, node, syntax.FieldLeft));
+    right := Field(forest, node, syntax.FieldRight);
+    // The left value must survive a call on the right that can replace it.
+    copied := Is(forest, left, syntax.Identifier) &&
+              NamePosition(AddressedNames(forest, text, right, []), Text(forest, text, left)) >= 0;
+    for (part in [left, right]) {
+        switch ScalarMapValue(forest, text, callables, params, callable, names, types, members, constants,
+                              part, record, copied && part == left, output) {
+            case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
+            case .Built(built): output = built;
+        }
+    }
+    compared := ScalarAt(forest, node, facts.MapRow, facts.BoolType, facts.MapEqual, 2, "");
+    compared.literal = i64(ScalarMapType(types, record));
+    output.append(compared);
+    if (Operator(forest, node) == tk.NotEq) {
+        output.append(ScalarAt(forest, node, facts.UnaryRow, facts.BoolType, facts.Not, 1, ""));
+    }
+    return ScalarOperands.Built(output);
+}
