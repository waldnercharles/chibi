package facts

// references
@test
Calls :: () {
    r1: int = Run();
    e1: int = 6121340;
    assert(r1 == e1, "Run call 1");
    a2_0: int = 1;
    r2: int = Inc(a2_0);
    e2: int = 2;
    assert(r2 == e2, "Inc call 2");
    r3: int = Count();
    e3: int = 12;
    assert(r3 == e3, "Count call 3");
    r4: int = Moved();
    e4: int = 1007;
    assert(r4 == e4, "Moved call 4");
}
