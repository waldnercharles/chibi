version 1
name "HRCLabPinhole"
(array)entities {
    - {
        name "Camera"
        prototype "HRCLabCamera"
        components {
            GameTransform x=0.0 y=0.0
        }
    }
    - {
        name "HRC"
        prototype "HRCLabHRC"
        components {
            GameTransform x=0.0 y=0.0
        }
    }
    - {
        name "Emitter"
        prototype "HRCLabEmitter"
        components {
            GameTransform x=-340.0 y=0.0
            GameAppearance width=24.0 height=24.0 shape="Circle"
        }
    }
    - {
        name "Upper occluder"
        prototype "HRCLabOccluder"
        components {
            GameTransform x=40.0 y=145.0
            GameAppearance width=180.0 height=200.0
        }
    }
    - {
        name "Lower occluder"
        prototype "HRCLabOccluder"
        components {
            GameTransform x=40.0 y=-145.0
            GameAppearance width=180.0 height=200.0
        }
    }
    - {
        name "Receiver"
        prototype "HRCLabReceiver"
        components {
            GameTransform x=320.0 y=0.0
            GameAppearance width=120.0 height=420.0
        }
    }
    - {
        name "Backdrop"
        prototype "HRCLabReceiver"
        components {
            GameTransform x=0.0 y=0.0
            GameAppearance width=960.0 height=540.0 shape="Box" layer=-100
            GameMaterial absorption=0.0 albedo=0xd0d0d0ff scene=0x6b6b6bff edge_light=0.0
        }
    }
}
