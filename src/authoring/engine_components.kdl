// The editor's tabs and icons for the engine's own components. A project's
// editor/Components.kdl overrides any of them. A component left out shows
// under Object without an icon.
components {
    GAME.EngineSystem icon="system"
    GAME.GameAim tab="Gameplay"
    GAME.GameAppearance icon="shape"
    GAME.GameBody tab="Physics"
    GAME.GameBody3D tab="Physics"
    GAME.GameCamera icon="camera"
    GAME.GameCharacter3D tab="Physics"
    GAME.GameCollider tab="Physics"
    GAME.GameCollider3D tab="Physics"
    GAME.GameCombustion tab="Gameplay"
    GAME.GameDash tab="Gameplay"
    GAME.GameDestructible tab="Physics" icon="diamond"
    GAME.GameDirectionalLight tab="Material" icon="light"
    GAME.GameDrive tab="Physics"
    GAME.GameEncounter tab="Gameplay"
    GAME.GameEncounterMember tab="Gameplay"
    GAME.GameEnvironment tab="Material"
    GAME.GameExperience tab="Gameplay"
    GAME.GameFluidVolume tab="Physics" icon="water"
    GAME.GameFog tab="Material"
    GAME.GameFragmentGlow tab="Material"
    GAME.GameFuel tab="Gameplay"
    GAME.GameGeometry3D tab="Material"
    GAME.GameGravity tab="Physics"
    GAME.GameGravity3D tab="Physics"
    GAME.GameHRC2D tab="Material" icon="light"
    GAME.GameHealth tab="Gameplay" icon="health"
    GAME.GameIgniter tab="Gameplay"
    GAME.GameInput tab="Gameplay" icon="gamepad"
    GAME.GameJoint3D tab="Physics"
    GAME.GameMaterial tab="Material"
    GAME.GameMaterialCavity tab="Physics"
    GAME.GameMaterialFrame tab="Physics"
    GAME.GameMeshAsset tab="Material"
    GAME.GameMeshParts tab="Material"
    GAME.GameMeshSurface2D tab="Material"
    GAME.GameMovement tab="Gameplay"
    GAME.GameParticleEmitter icon="emitter"
    GAME.GamePickup tab="Gameplay"
    GAME.GamePointLight tab="Material" icon="light"
    GAME.GameProjectile tab="Gameplay" icon="projectile"
    GAME.GameReflection tab="Material"
    GAME.GameRhythm tab="Gameplay"
    GAME.GameSdfSurface3D tab="Material"
    GAME.GameSensorContact tab="Physics"
    GAME.GameShader tab="Material"
    GAME.GameSpawnRequest tab="Gameplay"
    GAME.GameSpotLight tab="Material" icon="light"
    GAME.GameSprite tab="Material"
    GAME.GameTilemap tab="Material"
    GAME.GameStarfield2D tab="Material"
    GAME.GameSubstance tab="Physics"
    GAME.GameSurfaceInfluence tab="Material"
    GAME.GameSurfaceQuality tab="Material"
    GAME.GameTrail tab="Material"
    GAME.GameVelocity tab="Physics"
    GAME.GameVision tab="Gameplay"
    GAME.GameWeapon tab="Gameplay"
    GAME.MaterialBreakProfile tab="Physics"
    GAME.MaterialConstitutive tab="Physics"
    GAME.MaterialDestructionWorld tab="Physics"
    GAME.MaterialFluidWorld tab="Physics"
    GAME.MaterialTerrain tab="Material" icon="terrain"
    GAME.MaterialThermal tab="Physics"
}
