+    reply.mkdir(parents=True)
+    obj = put(build / "CMakeFiles/test_tools.dir/main.c.o", b"\x7fELFobject")
+    extra_obj = put(build / "sdk/CMakeFiles/extra.dir/extra.c.o", b"\x7fELFextra")
+    artifact = put(build / "test_tools")
+    compiler = "/usr/bin/clang-18"
+    targets = {
+        "test_tools": {"id": "t", "name": "test_tools", "type": "EXECUTABLE", "paths": {"build": "."},
+                       "sources": [{"path": "main.c", "compileGroupIndex": 0}, {"path": str(extra_obj), "isGenerated": True}],
+                       "artifacts": [{"path": "test_tools"}], "dependencies": [{"id": "e"}],
+                       "link": {"language": "C", "commandFragments": [{"fragment": "-g", "role": "flags"}]}},
+        "extra": {"id": "e", "name": "extra", "type": "OBJECT_LIBRARY", "paths": {"build": "sdk"},
+                  "sources": [{"path": str(extra), "compileGroupIndex": 0}]},
