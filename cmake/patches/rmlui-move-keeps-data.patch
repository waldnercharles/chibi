+// The element RemoveChildToMove detaches, which keeps its data model.
+static Element* moving_element = nullptr;
 
+ElementPtr Element::RemoveChildToMove(Element* child)
+{
+	moving_element = child;
+	ElementPtr result = RemoveChild(child);
+	moving_element = nullptr;
+	return result;
