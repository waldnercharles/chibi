package integer_arithmetic

Inner :: (a: u64, b: u64) -> u64 {
    return (a + b) * 3;
}

Fold :: () -> u64 {
    return Inner(9007199254740993, 9007199254740991);
}

@test
WideConstantFoldingIsExact :: () {
    actual: u64 = Fold();
    expected: u64 = 54043195528445952;
    assert(actual == expected);
    return;
}

// Locals whose initializers use only literals take their type from the
// literals' spelling, as a lone literal does: int, number, or a wider integer.
@test
LiteralOnlyInitializersDefaultToInt :: () {
    sum := 1 + 2;
    product := (3 + 4) * 5 - 6 / 2;
    shifted := 1 << 4;
    negated := -(2 + 3);
    checked: int = sum;
    assert(checked == 3);
    assert(product == 32);
    assert(shifted == 16);
    assert(negated == -5);
    total: int = 0;
    total += sum;
    assert(total == 3);
    return;
}

@test
LiteralOnlyInitializersWithFractionsDefaultToNumber :: () {
    half := 1.0 + 0.5;
    scaled := 2.0 * 3.0 - 1.0;
    checked: number = half;
    assert(checked == 1.5);
    assert(scaled == 5.0);
    return;
}

@test
LiteralOnlyInitializersWidenForLargeLiterals :: () {
    big := 4294967296 + 1;
    checked: i64 = big;
    assert(checked == 4294967297);
    return;
}

// Fixed runtime inputs and oracles from packed.c at 7c6ca2f5.
// Each operation reads ordinary typed parameters; no expected value is computed.

AddI8 :: (a: i8, b: i8) -> i8 {
    return a + b;
}

SubtractI8 :: (a: i8, b: i8) -> i8 {
    return a - b;
}

MultiplyI8 :: (a: i8, b: i8) -> i8 {
    return a * b;
}

LessI8 :: (a: i8, b: i8) -> bool {
    return a < b;
}

DivideI8 :: (a: i8, b: i8) -> i8 {
    return a / b;
}

RemainderI8 :: (a: i8, b: i8) -> i8 {
    return a % b;
}

@test
I8Addition :: () {
    left: i8 = -1;
    right: i8 = 1;
    actual: i8 = AddI8(left, right);
    expected: i8 = 0;
    assert(actual == expected);
    return;
}

@test
I8Subtraction :: () {
    left: i8 = 0;
    right: i8 = 1;
    actual: i8 = SubtractI8(left, right);
    expected: i8 = -1;
    assert(actual == expected);
    return;
}

@test
I8Multiplication :: () {
    left: i8 = -127;
    right: i8 = 3;
    actual: i8 = MultiplyI8(left, right);
    expected: i8 = -125;
    assert(actual == expected);
    return;
}

@test
I8Ordering :: () {
    left: i8 = -128;
    right: i8 = 1;
    actual: bool = LessI8(left, right);
    expected: bool = true;
    assert(actual == expected);
    return;
}

@test
I8Division :: () {
    left: i8 = -2;
    right: i8 = 2;
    actual: i8 = DivideI8(left, right);
    expected: i8 = -1;
    assert(actual == expected);
    return;
}

@test
I8Remainder :: () {
    left: i8 = -1;
    right: i8 = 2;
    actual: i8 = RemainderI8(left, right);
    expected: i8 = -1;
    assert(actual == expected);
    return;
}

@test
I8DivideByZero :: () {
    left: i8 = -128;
    right: i8 = 0;
    actual: i8 = DivideI8(left, right);
    expected: i8 = 0;
    assert(actual == expected);
    return;
}

@test
I8RemainderByZero :: () {
    left: i8 = -128;
    right: i8 = 0;
    actual: i8 = RemainderI8(left, right);
    expected: i8 = -128;
    assert(actual == expected);
    return;
}

@test
I8DivideMinimumByMinusOne :: () {
    left: i8 = -128;
    right: i8 = -1;
    actual: i8 = DivideI8(left, right);
    expected: i8 = -128;
    assert(actual == expected);
    return;
}

@test
I8RemainderMinimumByMinusOne :: () {
    left: i8 = -128;
    right: i8 = -1;
    actual: i8 = RemainderI8(left, right);
    expected: i8 = 0;
    assert(actual == expected);
    return;
}

