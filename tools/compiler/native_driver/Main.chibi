package native_driver

import link "project:native_link"
import host "project:native_link_host"
import route "project:driver_paths"
import os "core:os"
import strings "core:strings"
import facts "project:scalar_facts"

// The native compiler's driver: `STAGE --compiler DIR --core DIR --output FILE
// [--emit-llvm | --llvm DIR] [--package NAME | --source FILE | --root DIR] [--entry NAME] [--collection NAME=DIR]...
// [--target TRIPLE] [--level 0|2] [--lines] [--static | --shared] [--jobs N]`
// compiles package NAME of the project at DIR (default native_driver), or the
// one program FILE, and the core and collection packages it imports to the
// native program FILE. --level is opt's and llc's (default 2). --lines adds
// line tables (Linux x86-64). Linux links libc dynamically by default.
// --emit-llvm publishes the program's module bundle for an external linker;
// each `; chibi-piece` boundary starts an independent module. No tools run.
// --static refuses a program that needs libc,
// which a program that allocates does; --shared links a library source as a
// Linux shared object or macOS dylib, as the Edit and Continue host loads one. A
// `; chibi-library` line's archive (native_link.Archive) is linked after the
// objects. Without --entry the program starts at
// the first function of its first file; with it, at the function NAME of that
// file, as the build host's --entry does. Exit 0 succeeded, 1 the sources were rejected,
// 2 the arguments or the machine were unusable; a failed LLVM process keeps
// its exit status (128 + signal on POSIX). The first stderr line of a
// rejection is `native: rejected FUNCTION: MESSAGE`.
//
// Its inputs are independent files and its passes are transforms, so reading
// the closure and emitting each function group can run on worker threads once
// core:thread exists; the order of everything it writes is the source order.

// The entry comes first: a package set's entry is its first file's first function.
Main :: () -> int {
    arguments := os.Arguments();
    if (length(arguments) == 0 || arguments[0] == "--help" || arguments[0] == "--watch" ||
        !strings.HasPrefix(arguments[0], "--")) {
        return Cli(arguments);
    }
    return Build(arguments);
}

// The stage flags are also the native CLI build contract.
Build :: (arguments: string[]) -> int {
    project := Option(arguments, "--compiler", "");
    core := Option(arguments, "--core", "");
    output := Option(arguments, "--output", "");
    llvm := Option(arguments, "--llvm", "");
    package := Option(arguments, "--package", "native_driver");
    source := Option(arguments, "--source", "");
    root := Option(arguments, "--root", "");
    chosen := Option(arguments, "--entry", "");
    triple := Option(arguments, "--target", "x86_64-unknown-linux-gnu");
    level := Option(arguments, "--level", "2");
    lines := Flag(arguments, "--lines");
    shared := Flag(arguments, "--shared");
    emit_llvm := Flag(arguments, "--emit-llvm");
    linux := triple == "x86_64-unknown-linux-gnu";
    if (project == "" || core == "" || (output == "" && root == "") || (!emit_llvm && llvm == "") || (level != "0" && level != "2")) {
        os.Print("usage: --compiler DIR --core DIR --output FILE [--emit-llvm | --llvm DIR] [--package NAME | --source FILE | --root DIR] [--entry NAME] [--collection NAME=DIR]... [--target TRIPLE] [--level 0|2] [--lines] [--static | --shared] [--jobs N]");
        return 2;
    }
    if (lines && !linux) {
        os.Print("native: line tables are Linux x86-64 only so far");
        return 2;
    }
    if (shared && !SharedTarget(triple)) {
        os.Print("native: shared libraries require Linux x86-64 or macOS arm64");
        return 2;
    }
    if (shared && (lines || Flag(arguments, "--static"))) {
        os.Print("native: a shared library has no line tables or static link yet");
        return 2;
    }
    if (emit_llvm && (root != "" || shared || Flag(arguments, "--static"))) {
        os.Print("native: --emit-llvm takes --output and no --root, --shared or --static");
        return 2;
    }
    if (root != "") {
        if (output != "" || source != "" || Option(arguments, "--package", "") != "") {
            os.Print("native: --root takes no --output, --source or --package");
            return 2;
        }
        root = os.RealPath(root);
        if (root == "" || (!os.IsDirectory(root) && !os.IsFile(root))) {
            os.Print("native: --root must name an existing source file or package directory");
            return 2;
        }
        if (os.IsFile(root)) {
            source = root;
            root = strings.Slice(root, 0, strings.LastIndex(root, "/"));
        }
        project = root;
        package = ".";
    }
    collections: string[] = ["core"];
    directories: string[] = [core];
    for (declared in Values(arguments, "--collection")) {
        equals := strings.Index(declared, "=");
        if (equals <= 0) {
            os.Print(strings.Concatenate(["native: --collection takes NAME=DIR, not ", declared]));
            return 2;
        }
        name := strings.Slice(declared, 0, equals);
        directory := strings.Slice(declared, equals + 1, strings.ByteLength(declared) - equals - 1);
        if (!strings.HasPrefix(route.Visible(directory), "/") || Contains(collections, name)) {
            os.Print(strings.Concatenate(["native: --collection takes a new name and an absolute directory, not ", declared]));
            return 2;
        }
        collections.append(name);
        directories.append(directory);
    }
    gathered := Gather(project, collections, directories, package, source);
    if (gathered.problem != "") {
        os.Print(strings.Concatenate(["native: ", gathered.problem]));
        return 2;
    }
    // The entry's folder: line tables name it, and a library path in it is
    // relative to it.
    folder := strings.Concatenate([project, "/", package]);
    if (source != "") {
        folder = ".";
        slash := strings.LastIndex(source, "/");
        if (slash >= 0) {
            folder = strings.Slice(source, 0, slash);
        }
    }
    if (root != "") {
        folder = root;
    }
    diagnostic_project := os.RealPath(project);
    if (diagnostic_project == "") { diagnostic_project = project; }
    diagnostic_source := "";
    if (source != "") {
        diagnostic_source = os.RealPath(source);
        if (diagnostic_source == "") { diagnostic_source = source; }
    }
    options: DriverOptions = {level: level, lines: lines, static_link: Flag(arguments, "--static"),
                               shared: shared, folder: folder, project: diagnostic_project, source: diagnostic_source,
                               keep_module: root != "", emit_llvm: emit_llvm, cli_errors: false};
    if (root != "") {
        return CachedBuild(root, collections, directories, gathered, triple, chosen, llvm, Jobs(arguments), options, source);
    }
    return EmitOptions(collections, directories, gathered.paths, gathered.sources, triple, chosen, llvm, output,
                       Jobs(arguments), options);
}

// The options shared by native build, run and test. Only cached builds keep
// the source module beside their receipt.
DriverOptions :: struct {
    level: string;
    lines: bool;
    static_link: bool;
    shared: bool;
    folder: string;
    // Source identity is independent of the entry folder used for archives.
    project: string;
    source: string;
    keep_module: bool;
    // Emits the ordinary program module bundle for an external target linker.
    // Each `; chibi-piece` boundary begins an independent LLVM module.
    emit_llvm: bool;
    // Public run commands report a source assertion as command failure 1;
    // raw native programs retain their typed failure status 134.
    cli_errors: bool;
}

SharedTarget :: (triple: string) -> bool {
    target := link.TargetOf(triple);
    return target == link.LinuxX64 || target == link.MacOSArm64;
}

HostTarget :: (triple: string) -> bool {
    target := link.TargetOf(triple);
    return target >= 0 && target == link.TargetOf(HostTriple());
}

Emit :: (collections: string[], directories: string[], paths: string[], sources: string[], triple: string,
         chosen: string, llvm: string, output: string, jobs: int) -> int {
    return EmitOptions(collections, directories, paths, sources, triple, chosen, llvm, output, jobs,
                       {level: "2", lines: false, static_link: false, shared: false, folder: ".", project: ".", source: "", keep_module: false, emit_llvm: false, cli_errors: false});
}

// Emits into the caller's work directory; only a successful link replaces
// output. Invalid source and options leave any previous program untouched.
EmitOptions :: (collections: string[], directories: string[], paths: string[], sources: string[], triple: string,
                chosen: string, llvm: string, output: string, jobs: int, options: DriverOptions) -> int {
    return EmitCollected(collections, directories, paths, sources, triple, chosen, llvm, output, jobs, options, []);
}

// Tests already collected typed rows and effects in one pass. Reuse those rows
// through the ordinary module/backend boundary, including its option/tool checks.
EmitCollected :: (collections: string[], directories: string[], paths: string[], sources: string[], triple: string,
                  chosen: string, llvm: string, output: string, jobs: int, options: DriverOptions, rows: facts.Row[]) -> int {
    linux := triple == "x86_64-unknown-linux-gnu";
    windows := strings.HasPrefix(triple, "x86_64-pc-windows");
    shared := options.shared;
    if (triple == "wasm32-unknown-emscripten" && !options.emit_llvm) {
        os.Print("native: WebAssembly requires --emit-llvm and an external Wasm linker");
        return 2;
    }
    if (options.lines && !linux) {
        os.Print("native: line tables are Linux x86-64 only so far");
        return 2;
    }
    if (shared && !SharedTarget(triple)) {
        os.Print("native: shared libraries require Linux x86-64 or macOS arm64");
        return 2;
    }
    if ((options.level != "0" && options.level != "2") || (shared && (options.lines || options.static_link))) {
        os.Print("native: a shared library has no line tables or static link yet; --level is 0 or 2");
        return 2;
    }
    if (!options.emit_llvm) {
        tool_problem := LlvmProblem(llvm, triple);
        if (tool_problem != "") {
            os.Print(strings.Concatenate(["native: ", tool_problem]));
            return 2;
        }
    }
    directory := "";
    if (options.lines) {
        directory = route.Visible(options.folder);
    }
    visible: string[] = [];
    for (directory in directories) {
        visible.append(route.Visible(directory));
    }
    origins: DiagnosticOrigins = {root: options.project, source: options.source, directories: directories, entry: chosen,
                                  runtime_assertions: options.cli_errors};
    compiled: Output = Output.Rejected("");
    if (length(rows) > 0) {
        compiled = CollectedModule(collections, visible, paths, sources, triple, rows, directory, origins);
    } else if (shared) {
        if (chosen != "") {
            os.Print("native: a shared generation takes no --entry");
            return 1;
        }
        if (LibrarySource(sources[0])) {
            if (length(paths) != 1) {
                os.Print("native: a library declaration takes one source");
                return 1;
            }
            compiled = LibraryModule(paths[0], sources[0], triple, origins);
        } else {
            compiled = ModuleWith(collections, visible, paths, sources, triple, "", directory, true, origins);
        }
    } else {
        compiled = ModuleWith(collections, visible, paths, sources, triple, chosen, directory, false, origins);
    }
    pieces: string[] = [];
    switch compiled {
        case .Rejected(message):
            os.Print(strings.Concatenate(["native: ", message]));
            return 1;
        case .Emitted(text):
            pieces = Pieces(text);
    }
    if (options.emit_llvm) {
        text := strings.Join(pieces, "\n; chibi-piece\n");
        if (triple == "wasm32-unknown-emscripten") {
            text = strings.Concatenate([text, "\n; chibi-piece\n", link.WebAssemblyContext()]);
        }
        partial := strings.Concatenate([output, ".partial"]);
        if (os.WriteText(partial, text) != nil || os.Rename(partial, output) != nil) {
            os.Print("native: cannot publish the LLVM module bundle");
            DiscardPath(partial);
            return 2;
        }
        return 0;
    }
    // The `; chibi-library` and `; chibi-import` lines, which any piece may
    // hold: vendored archives link after the objects; declared system imports
    // supply Linux library names or Windows/macOS symbol stubs.
    markers: string[] = [];
    for (piece in pieces) {
        markers.extend(Markers(piece));
    }
    if (options.static_link && linux) {
        for (line in markers) {
            if (strings.HasPrefix(line, "; chibi-import system:m ")) {
                os.Print("native: static programs cannot link system math yet; omit --static");
                return 2;
            }
        }
    }
    archives: string[] = [];
    vendor := link.VendorDirectory(directories[0]);
    for (line in markers) {
        if (!strings.HasPrefix(line, "; chibi-library ")) {
            continue;
        }
        path := strings.TrimPrefix(line, "; chibi-library ");
        if (strings.HasPrefix(path, "system:")) {
            supported_math := (linux && path == "system:m") || (!linux && !windows && path == "system:System");
            if (path != "system:c" && !windows && !supported_math) {
                os.Print(strings.Concatenate(["native: system library ", path,
                                              " links on Windows only; link a prebuilt archive instead"]));
                return 2;
            }
            continue;
        }
        archive := os.RealPath(link.Archive(path, options.folder, vendor));
        if (archive == "" || !os.IsFile(archive)) {
            os.Print(strings.Concatenate(["native: the foreign library ", path, " is not a file"]));
            return 2;
        }
        if (!Contains(archives, archive)) {
            archives.append(archive);
        }
    }
    // A program that allocates or formats takes the runtime context, which the
    // start module supplies from libc's allocator on Linux, so it links libc
    // dynamically. Linux defaults to libc even without a context; --static
    // opts out. Windows uses kernel32, and macOS always links libSystem.
    // The entry is the first piece's, defined as `@chibi_scalar(ptr %ctx)`
    // when it takes the context (the other functions are `@chibi_scalar.N`).
    // Definitions start a line; a text constant never does.
    // A formatter used in any body piece needs the context callback.
    formatting := Contains(markers, "; chibi-format");
    numeric_formatting := Contains(markers, "; chibi-format-numbers");
    context := strings.Contains(pieces[0], "\ndefine i32 @chibi_scalar(ptr %ctx)");
    if (shared) {
        context = strings.Contains(pieces[0], "\n@chibi_context = external global ");
    }
    static := windows || (linux && options.static_link);
    if (options.static_link && linux && context) {
        os.Print("native: a program that allocates links libc dynamically; omit --static");
        return 2;
    }
    // A library's module is its manifest and functions, with no entry.
    is_library := strings.Contains(pieces[0], "\n@chibi_natives_");
    if (shared != is_library) {
        os.Print("native: --shared requires a library or a package generation");
        return 2;
    }
    // Each piece of the module is optimized and compiled to its own object,
    // as many at once as --jobs, by default every processor. Reject incompatible
    // options above before writing any intermediate output.
    if (options.keep_module && os.WriteText(strings.Concatenate([strings.Slice(output, 0, strings.LastIndex(output, "/")), "/source.ll"]),
                                           strings.Join(pieces, "\n; chibi-piece\n")) != nil) {
        os.Print("native: cannot write the source module");
        return 2;
    }
    files: string[] = [];
    objects: string[] = [];
    for (index in 0..<length(pieces)) {
        module := format_text("{}.{}.ll", output, index);
        if (os.WriteText(module, pieces[index]) != nil) {
            os.Print(strings.Concatenate(["native: cannot write ", module]));
            return 2;
        }
        files.append(module);
        objects.append(format_text("{}.{}.o", output, index));
    }
    optimization := 2;
    if (options.level == "0") {
        optimization = 0;
    }
    object_error := host.ObjectsResult(llvm, files, objects, optimization, jobs);
    if (object_error.kind != 0) {
        return ToolFailure(object_error.kind, object_error.code, "LLVM object emission failed");
    }
    files.extend(objects);
    start := "";
    if (shared) {
        start = link.SharedContext(triple, context);
    } else if (options.cli_errors) {
        start = link.RunStart(triple, static, context, formatting, numeric_formatting);
    } else {
        start = link.ProgramStart(triple, static, context, formatting, numeric_formatting);
    }
    if (start != "") {
        if (os.WriteText(strings.Concatenate([output, ".start.ll"]), start) != nil) {
            os.Print("native: cannot write the start module");
            return 2;
        }
        start_error := host.ObjectResult(llvm, strings.Concatenate([output, ".start.ll"]), strings.Concatenate([output, ".start.o"]), optimization);
        if (start_error.kind != 0) {
            return ToolFailure(start_error.kind, start_error.code, "LLVM start object emission failed");
        }
        objects.append(strings.Concatenate([output, ".start.o"]));
        files.extend([strings.Concatenate([output, ".start.ll"]), strings.Concatenate([output, ".start.o"])]);
    }
    plan := link.Program(triple, llvm, objects, archives, [], [], output, "", static || shared);
    plan.shared = shared;
    // Math instructions can lower to libm calls. Linux links that library by
    // name; macOS and Windows bind each symbol through their system stubs.
    markers.extend(Markers(start));
    plan.imports = link.SystemImports(markers);
    if (link.TargetOf(triple) == link.LinuxX64) {
        for (imported in plan.imports) { plan.libraries.append(imported.name); }
    }
    link_error := host.LinkResult(plan);
    if (link_error.kind != 0) {
        return ToolFailure(link_error.kind, link_error.code, "LLVM link failed");
    }
    for (name in files) {
        DiscardPath(name);
    }
    return 0;
}

// core:os returns a negative signal number on POSIX. Preserve the child's
// portable exit status; report other native statuses without truncating them.
ToolFailure :: (kind: int, code: int, message: string) -> int {
    os.Print(format_text("native: {} (kind {}, status {})", message, kind, code));
    if (kind == link.ToolFailed) {
        if (code > 0 && code <= 255) { return code; }
        if (code < 0 && code >= -127 && os.Platform() != "Windows") { return 128 - code; }
    }
    return 2;
}

// The modules of a text llvm_native split into pieces: a `; chibi-piece` line
// begins each after the first. A module it did not split is one piece.
Pieces :: (text: string) -> string[] {
    pieces: string[] = [];
    for (piece in strings.Split(text, "\n; chibi-piece\n")) {
        pieces.append(strings.Concatenate([piece, "\n"]));
    }
    // The last piece kept its own final line feed.
    last := length(pieces) - 1;
    pieces[last] = strings.TrimSuffix(pieces[last], "\n");
    return pieces;
}

// The --jobs to compile with, else Windows' processor-count environment value
// or getconf's online processors; 8 when the platform cannot supply a count.
Jobs :: (arguments: string[]) -> int {
    chosen := Option(arguments, "--jobs", "");
    if (chosen == "") {
        if (os.Platform() == "Windows") {
            chosen = os.Getenv("NUMBER_OF_PROCESSORS");
        } else {
            online := os.Capture(["getconf", "_NPROCESSORS_ONLN"]);
            chosen = strings.TrimSpace(online.stdout);
            if (online.status != 0) {
                chosen = "";
            }
        }
    }
    count := 0;
    for (byte in strings.Bytes(chosen)) {
        if (byte < 48 || byte > 57) {
            return 8;
        }
        count = count * 10 + byte - 48;
    }
    if (count < 1) {
        return 8;
    }
    return count;
}

// Whether `name` is among the arguments.
Flag :: (arguments: string[], name: string) -> bool {
    return Contains(arguments, name);
}

Option :: (arguments: string[], name: string, fallback: string) -> string {
    for (index in 0..<length(arguments) - 1) {
        if (arguments[index] == name) {
            return arguments[index + 1];
        }
    }
    return fallback;
}

// The value of every `name VALUE` pair, in order.
Values :: (arguments: string[], name: string) -> string[] {
    found: string[] = [];
    for (index in 0..<length(arguments) - 1) {
        if (arguments[index] == name) {
            found.append(arguments[index + 1]);
        }
    }
    return found;
}

// The names an import line of `text` takes from `collection`.
ImportedFrom :: (text: string, collection: string) -> string[] {
    found: string[] = [];
    prefix := strings.Concatenate([collection, ":"]);
    for (line in strings.SplitLines(text)) {
        // The indented imports of a `when` branch count too, so the snapshot
        // holds every package a kept branch may import.
        trimmed := strings.TrimSpace(line);
        if (!strings.HasPrefix(trimmed, "import ")) {
            continue;
        }
        parts := strings.Split(trimmed, "\"");
        if (length(parts) >= 3 && strings.HasPrefix(parts[1], prefix)) {
            found.append(strings.TrimPrefix(parts[1], prefix));
        }
    }
    return found;
}

// The .chibi files directly in a package folder, in the listing's order; test files
// (named ...Tests.chibi) only when `tests`.
PackageFiles :: (folder: string, tests: bool) -> string[] {
    files: string[] = [];
    listed := os.List(folder);
    // GatherWith reports this empty result as a package with no sources.
    if (listed.error != nil) { return files; }
    for (name in listed.names) {
        if (strings.HasSuffix(name, ".chibi") && (tests || !strings.HasSuffix(name, "Tests.chibi")) && os.IsFile(strings.Concatenate([folder, "/", name]))) {
            files.append(name);
        }
    }
    // core:os.List already returns deterministic byte order.
    return files;
}

// The sources of the closure: the package's own files, Main.chibi first (or the
// one file of `--source`), then each imported project package of the project
// folder and package of a collection, in the order first imported. `paths[i]` is
// the project-relative path of project files and the absolute path of collection
// files (core's included).
Inputs :: struct {
    paths: string[];
    sources: string[];
    problem: string;
}

Gather :: (project: string, collections: string[], directories: string[], package: string, source: string) -> Inputs {
    return GatherWith(project, collections, directories, package, source, {folder: "", collection: "", name: "", text: "", entry_name: "", entry_text: ""});
}

// A package under test: its folder, the test files it also takes, and one more file, `name`
// holding `text`, that is not on disk, the test dispatcher. A nonempty `entry_text` is the
// first file of the package under test, `entry_name`, also not on disk.
// `collection` identifies that package through its existing project/core route.
Extra :: struct {
    folder: string;
    collection: string;
    name: string;
    text: string;
    entry_name: string;
    entry_text: string;
}

GatherWith :: (project: string, collections: string[], directories: string[], package: string, source: string,
               extra: Extra) -> Inputs {
    found: Inputs = {paths: [], sources: [], problem: ""};
    seen: string[] = [strings.Concatenate(["project:", package])];
    folders: string[] = [strings.Concatenate([project, "/", package])];
    prefixes: string[] = [strings.Concatenate([package, "/"])];
    if (package == ".") {
        folders[0] = project;
        prefixes[0] = "";
    }
    if (extra.entry_text != "") {
        folders[0] = extra.folder;
        seen[0] = strings.Concatenate([extra.collection, ":", package]);
        if (extra.collection != "project") {
            prefixes[0] = strings.Concatenate([route.Visible(extra.folder), "/"]);
        }
    }
    kinds: string[] = ["project"];
    kinds.extend(collections);
    next := 0;
    while (next < length(folders)) {
        files := PackageFiles(folders[next], folders[next] == extra.folder);
        if (extra.folder != "" && folders[next] == extra.folder) {
            files.append(extra.name);
        }
        if (next == 0 && extra.entry_text != "") {
            // The generated entry belongs to the tested package itself.
            // Its real files and dispatcher follow in the same namespace.
            ordered: string[] = [extra.entry_name];
            ordered.extend(files);
            files = ordered;
        } else if (next == 0 && source != "") {
            // One program: its file alone, whatever else its folder holds.
            slash := strings.LastIndex(source, "/");
            folders[0] = ".";
            files = [source];
            if (slash >= 0) {
                folders[0] = strings.Slice(source, 0, slash);
                files = [strings.Slice(source, slash + 1, strings.ByteLength(source) - slash - 1)];
            }
            prefixes[0] = "";
        } else if (next == 0) {
            // Prefer Main.chibi for the default entry. An explicit entry name
            // is selected from this root package after all its files are read.
            if (Contains(files, "Main.chibi")) {
                ordered: string[] = ["Main.chibi"];
                for (file in files) {
                    if (file != "Main.chibi") {
                        ordered.append(file);
                    }
                }
                files = ordered;
            }
        }
        if (length(files) == 0) {
            found.problem = strings.Concatenate(["package directory has no sources: ", folders[next]]);
            return found;
        }
        for (file in files) {
            location := strings.Concatenate([folders[next], "/", file]);
            text := extra.text;
            if (next == 0 && extra.entry_text != "" && file == extra.entry_name) {
                text = extra.entry_text;
            } else if (extra.folder == "" || folders[next] != extra.folder || file != extra.name) {
                if (!os.Exists(location)) {
                    found.problem = strings.Concatenate(["cannot read ", location]);
                    return found;
                }
                read := os.ReadText(location);
                if (read.error != nil) {
                    found.problem = strings.Concatenate(["cannot read ", location]);
                    return found;
                }
                text = read.text;
            }
            found.paths.append(strings.Concatenate([prefixes[next], file]));
            found.sources.append(text);
            for (kind in kinds) {
                for (name in ImportedFrom(text, kind)) {
                    key := strings.Concatenate([kind, ":", name]);
                    known := false;
                    for (other in seen) {
                        known = known || other == key;
                    }
                    if (known) {
                        continue;
                    }
                    seen.append(key);
                    folder := "";
                    if (kind == "project") {
                        folder = project;
                        prefix := "";
                        if (name != ".") {
                            folder = strings.Concatenate([project, "/", name]);
                            prefix = strings.Concatenate([name, "/"]);
                        }
                        prefixes.append(prefix);
                    } else {
                        // A collection's package is its folder below the collection's
                        // directory, `NAME:.` the directory itself, and its files are
                        // named by absolute path.
                        root := directories[Position(collections, kind)];
                        folder = root;
                        if (name != ".") {
                            folder = strings.Concatenate([root, "/", name]);
                        }
                        prefixes.append(strings.Concatenate([route.Visible(folder), "/"]));
                    }
                    folders.append(folder);
                }
            }
        }
        next += 1;
    }
    return found;
}

// Whether `name` is in `names`.
Contains :: (names: string[], name: string) -> bool {
    for (other in names) {
        if (other == name) {
            return true;
        }
    }
    return false;
}

// Where `name` is in `names`; names holds it.
Position :: (names: string[], name: string) -> int {
    for (index in 0..<length(names)) {
        if (names[index] == name) {
            return index;
        }
    }
    return 0;
}

// The module's `; chibi-library` and `; chibi-import` lines, which name the
// system libraries and symbols it takes. One pass over the text: a module is
// megabytes and only these few lines matter.
Markers :: (module: string) -> string[] {
    found: string[] = [];
    needle := "; chibi-";
    width := strings.ByteLength(needle);
    size := strings.ByteLength(module);
    at := 0;
    while (at < size) {
        end := at;
        while (end < size && strings.ByteAt(module, end) != 10) {
            end += 1;
        }
        matched := end - at >= width;
        for (index in 0..<width) {
            matched = matched && strings.ByteAt(module, at + index) == strings.ByteAt(needle, index);
        }
        if (matched) {
            found.append(strings.Slice(module, at, end - at));
        }
        at = end + 1;
    }
    return found;
}
