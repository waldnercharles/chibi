package map_array_values

Value :: struct { name: string; items: int[]; }
Choice :: union { Empty | Some(value: Value) }
Text :: (value: int) -> string { return text_from_bytes([u8(65), 0, u8(value)]); }
Make :: (value: int) -> Value { return {name: Text(value), items: [value]}; }
Words :: () -> [int: string[]] { values: [int: string[]] = [1: [Text(1)]]; return values; }
Scoped :: (values: ^([int: string[]])) { values^[1].append(Text(9)); }
Changed :: (values: [int: string[]]) -> int { values[1].append(Text(8)); return length(values[1]); }
ReplaceWords :: (values: ^([int: string[]])) -> string { values^ = [1: [Text(10)]]; return Text(11); }
Main :: () -> int {
    borrowed := [Text(1)];
    words: [int: string[]] = [1: borrowed, 1: borrowed];
    borrowed[0] = Text(7);
    copied := words;
    incoming := Text(2);
    words[1].append(incoming);
    incoming = Text(3);
    words[1].extend([Text(4), Text(5)]);
    words[1][1] = Text(6);
    words[1].remove_index(0);
    assert(length(copied[1]) == 1 && copied[1][0] == Text(1));
    assert(length(words[1]) == 3 && words[1][0] == Text(6) && words[1][2] == Text(5));
    words[1].resize(5);
    assert(words[1][3] == "" && words[1][4] == "");
    count := Changed(copied);
    assert(count == 2 && length(copied[1]) == 1);
    Scoped(&copied);
    assert(copied[1][1] == Text(9));
    words[1].append(ReplaceWords(&words));
    assert(length(words[1]) == 2 && words[1][0] == Text(10) && words[1][1] == Text(11));
    words[1][0] = ReplaceWords(&words);
    assert(length(words[1]) == 1 && words[1][0] == Text(11));
    escaped := Words()[1];
    assert(escaped[0] == Text(1));
    flags: [string: bool[]] = ["flags": [true]];
    flags["flags"].append(false);
    flags["flags"][0] = false;
    assert(!flags["flags"][0] && !flags["flags"][1]);
    bytes: [int: u8[]] = [1: [u8(3)]];
    bytes[1].append(u8(255));
    assert(bytes[1][1] == u8(255));
    records: [int: Value[]] = [1: [Make(1)]];
    record_copy := records;
    value := Make(2);
    records[1].append(value);
    value.items[0] = 22;
    records[1].extend([Make(3)]);
    records[1][0] = Make(4);
    records[1].remove_index(1);
    assert(records[1][0].name == Text(4) && records[1][1].items[0] == 3);
    assert(record_copy[1][0].name == Text(1));
    records[1].resize(1);
    assert(length(records[1]) == 1 && records[1][0].name == Text(4));
    records[1].append(records[1][0]);
    assert(records[1][1].name == Text(4) && records[1][1].items[0] == 4);
    choices: [int: Choice[]] = [1: [Choice.Empty]];
    choices[1].append(Choice.Some(Make(5)));
    chosen := choices[1][1];
    switch chosen {
        case .Empty: assert(false);
        case .Some(held): assert(held.name == Text(5) && held.items[0] == 5);
    }
    for (index in 0..<128) { words[index] = [Text(index)]; }
    saved := words;
    for (index in 0..<128) { delete words[index]; }
    assert(saved[127][0] == Text(127));
    return 0;
}
