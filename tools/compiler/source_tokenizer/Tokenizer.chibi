package source_tokenizer

// A port of Odin's core:odin/tokenizer to Chibi source. Tokenize reads a whole
// text and returns aligned token columns that end with an EOF token. Offsets
// count bytes; rows and byte columns count from zero, as Tree-sitter's do.

// Token kinds, in the order of Odin's Token_Kind; KindNames spells each.
pub Invalid: int : 0;
pub EOF: int : 1;
pub Comment: int : 2;
pub Ident: int : 3;
pub Integer: int : 4;
pub Float: int : 5;
pub String: int : 6;
pub Eq: int : 7;
pub Not: int : 8;
pub At: int : 9;
pub Dollar: int : 10;
pub Question: int : 11;
pub Add: int : 12;
pub Sub: int : 13;
pub Mul: int : 14;
pub Quo: int : 15;
pub Mod: int : 16;
pub And: int : 17;
pub Or: int : 18;
pub Xor: int : 19;
pub Complement: int : 20;
pub Shl: int : 21;
pub Shr: int : 22;
pub CmpAnd: int : 23;
pub CmpOr: int : 24;
pub AddEq: int : 25;
pub SubEq: int : 26;
pub MulEq: int : 27;
pub QuoEq: int : 28;
pub ModEq: int : 29;
pub AndEq: int : 30;
pub OrEq: int : 31;
pub XorEq: int : 32;
pub ArrowRight: int : 33;
pub FatArrow: int : 34;
pub CmpEq: int : 35;
pub NotEq: int : 36;
pub Lt: int : 37;
pub Gt: int : 38;
pub LtEq: int : 39;
pub GtEq: int : 40;
pub OpenParen: int : 41;
pub CloseParen: int : 42;
pub OpenBracket: int : 43;
pub CloseBracket: int : 44;
pub OpenBrace: int : 45;
pub CloseBrace: int : 46;
pub Colon: int : 47;
pub Semicolon: int : 48;
pub Period: int : 49;
pub Comma: int : 50;
pub Ellipsis: int : 51;
pub ColonColon: int : 52;
pub ColonEq: int : 53;
// Keywords, in the order grammar.js lists them. Odin's names for `!`, `&` and
// `|` are taken, so the words `not`, `and` and `or` end in Keyword.
pub Package: int : 54;
pub Import: int : 55;
pub Behavior: int : 56;
pub Library: int : 57;
pub System: int : 58;
pub State: int : 59;
pub Retain: int : 60;
pub Action: int : 61;
pub Event: int : 62;
pub Disabled: int : 63;
pub On: int : 64;
pub After: int : 65;
pub As: int : 66;
pub Bind: int : 67;
pub Events: int : 68;
pub Union: int : 69;
pub Struct: int : 70;
pub Switch: int : 71;
pub Is: int : 72;
pub NotKeyword: int : 73;
pub AndKeyword: int : 74;
pub OrKeyword: int : 75;
pub Macro: int : 76;
pub Entry: int : 77;
pub Exit: int : 78;
pub Query: int : 79;
pub If: int : 80;
pub Else: int : 81;
pub While: int : 82;
pub For: int : 83;
pub In: int : 84;
pub Case: int : 85;
pub Sequence: int : 86;
pub Branch: int : 87;
pub Return: int : 88;
pub Reduce: int : 89;
pub Unordered: int : 90;
pub Goto: int : 91;
pub Break: int : 92;
pub Continue: int : 93;
pub Await: int : 94;
pub Yield: int : 95;
pub Cancel: int : 96;
pub True: int : 97;
pub False: int : 98;
pub Nil: int : 99;
pub Null: int : 100;
pub Plain: int : 101;
pub Service: int : 102;
pub Setting: int : 103;
pub Wildcard: int : 104;
pub From: int : 105;
pub Split: int : 106;
pub Component: int : 107;
pub Prototype: int : 108;
pub Relationship: int : 109;
pub Pub: int : 110;
pub Delete: int : 111;
pub Foreign: int : 112;
pub Emit: int : 113;
pub HalfOpenRange: int : 114;
pub Coalesce: int : 115;
pub Char: int : 116;
pub KindCount: int : 117;

// Byte classes.
SpaceClass: int : 1;
LetterClass: int : 2;
DigitClass: int : 3;

// What an open bracket holds, which decides where a statement can end.
Statements: int : 0; // the file, a block or a declaration body
Literal: int : 1; // a struct literal
Variants: int : 2; // a union's variants
Group: int : 3; // parentheses or brackets
Fields: int : 4; // a prototype's components and fields
Embedded: int : 5; // a literal that ends nothing: a prototype's component or a relationship

Quote: int : 34;
Apostrophe: int : 39;
Slash: int : 47;
Star: int : 42;
Backslash: int : 92;
Newline: int : 10;
CarriageReturn: int : 13;

// Odin's keyword table: FNV-1a hashes into a power-of-two table, here probed
// linearly because Chibi's keywords collide in Odin's 512 slots.
KeywordSlots: int : 512;
KeywordHashBasis: u64 : 0x811C9DC5;
KeywordHashPrime: u64 : 0x01000193;

pub Tokens :: union {
    Scanned(kinds: int[], starts: int[], ends: int[], rows: int[], columns: int[],
            errors: string[], error_offsets: int[], error_rows: int[], error_columns: int[])
}

// A token that can fail, as Scan returns it: its kind and end, and at most
// one error. A string stops at a failed escape with `partial` set and resumes
// after it.
Lexeme :: struct {
    kind: int;
    end: int;
    message: string;
    at: int;
    partial: bool;
}

pub KindNames :: () -> string[] {
    return ["Invalid", "EOF", "Comment", "Ident", "Integer", "Float", "String", "=",
            "!", "@", "$", "?", "+", "-", "*", "/", "%", "&", "|", "^", "~", "<<",
            ">>", "&&", "||", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "->",
            "=>", "==", "!=", "<", ">", "<=", ">=", "(", ")", "[", "]", "{", "}", ":",
            ";", ".", ",", "..", "::", ":=", "package", "import", "behavior",
            "library", "system", "state", "retain", "action", "event",
            "disabled", "on", "after", "as", "bind", "events", "union", "struct",
            "switch", "is", "not", "and", "or", "macro", "entry", "exit",
            "query", "if", "else", "while", "for", "in", "case", "sequence",
            "branch", "return", "reduce", "unordered", "goto", "break", "continue",
            "await", "yield", "cancel", "true", "false", "nil", "null", "plain",
            "service", "setting", "wildcard", "from", "split", "component",
            "prototype", "relationship", "pub", "delete", "foreign", "emit", "..<", "??", "Char"];
}

pub Tokenize :: (text: string) -> Tokens {
    bytes := text_bytes(text);
    count := length(bytes);
    classes := Classes();
    endings := Endings();
    names := KindNames();
    keywords := KeywordTable(names);
    kinds: int[] = [];
    starts: int[] = [];
    ends: int[] = [];
    rows: int[] = [];
    columns: int[] = [];
    errors: string[] = [];
    error_offsets: int[] = [];
    error_rows: int[] = [];
    error_columns: int[] = [];
    // The open brackets; the first `depth` entries are live.
    contexts: int[] = [Statements];
    depth: int = 1;
    // The end of the last token, and the row and offset of the line it ends on.
    offset: int = 0;
    row: int = 0;
    line: int = 0;
    // Odin's insert_semicolon: the last token can end a statement.
    insert := false;
    // The last two tokens other than comments; whether the last is a name
    // that starts a statement, as a label's does; whether a declaration's
    // type follows its name's `:`; and whether a brace now opens a value,
    // after a `return .Name` outcome or a typed constant's second `:`.
    previous: int = Invalid;
    before: int = Invalid;
    label := false;
    annotating := false;
    valued := false;
    // A `:: prototype` declaration whose body has not opened yet.
    prototyping := false;
    // Whether the last token other than a comment is a postfix dereference,
    // which ends an expression although its kind is the binary `^`.
    dereferenced := false;
    while (true) {
        // Odin's skip_whitespace, counting rows. Calls cost more than the
        // scanning, so the hot paths read class tables inline.
        start := offset;
        newline := false;
        while (start < count && classes[bytes[start]] == SpaceClass) {
            if (bytes[start] == Newline) {
                row += 1;
                line = start + 1;
            }
            newline = newline || bytes[start] == Newline || bytes[start] == CarriageReturn;
            start += 1;
        }
        column := start - line;
        kept := insert;
        top := contexts[depth - 1];
        if (insert && (top == Statements || top == Fields) && Terminates(bytes, start, newline)) {
            kinds.append(Semicolon);
            starts.append(start);
            ends.append(start);
            rows.append(row);
            columns.append(column);
            before = previous;
            previous = Semicolon;
            label = false;
            annotating = false;
            valued = false;
            dereferenced = false;
            kept = false;
        }
        insert = false;
        if (start >= count) {
            break;
        }
        c := bytes[start];
        next: int = -1;
        if (start + 1 < count) {
            next = bytes[start + 1];
        }
        kind: int = Invalid;
        end := start + 1;
        if (classes[c] == LetterClass) {
            end = ScanIdentifier(bytes, classes, start);
            kind = Keyword(keywords, names, bytes, start, end);
        } else {
            kind = Pair(c, next);
            if (kind == Ellipsis && ByteAt(bytes, start + 2) == 60) {
                kind = HalfOpenRange;
                end = start + 3;
            } else if (kind == GtEq && start + 2 < count && bytes[start + 2] == 62) {
                // `>=>` closes type arguments before `=>`.
                kind = Gt;
            } else if (kind == Ellipsis && start + 2 < count && bytes[start + 2] == 60) {
                kind = HalfOpenRange;
                end = start + 3;
            } else if (kind != Invalid) {
                end = start + 2;
            } else {
                kind = Single(c);
            }
        }
        if (kind == Invalid || (kind == Quo && (next == Slash || next == Star))) {
            lexeme := Scan(text, bytes, start);
            kind = lexeme.kind;
            while (true) {
                // Strings, numbers and characters fail on their line, and a
                // comment fails at its start.
                if (lexeme.message != "") {
                    errors.append(lexeme.message);
                    error_offsets.append(lexeme.at);
                    error_rows.append(row);
                    error_columns.append(lexeme.at - line);
                }
                if (!lexeme.partial) {
                    break;
                }
                lexeme = ScanString(bytes, start, lexeme.end);
            }
            end = lexeme.end;
        }
        kinds.append(kind);
        starts.append(start);
        ends.append(end);
        rows.append(row);
        columns.append(column);
        // An adjacent caret after an expression is postfix dereference;
        // spaced carets keep their existing binary xor meaning.
        dereference := kind == Xor && kept && start == offset;
        offset = end;
        if (kind == Comment) {
            at := start;
            while (at < end) {
                if (bytes[at] == Newline) {
                    row += 1;
                    line = at + 1;
                }
                at += 1;
            }
        }

        // Odin's parser skips newlines inside expressions by its expression
        // level; Chibi's grammar never ends a statement there, so the
        // tokenizer tracks brackets and inserts only between statements.
        opened: int = -1;
        if (kind == OpenParen || kind == OpenBracket) {
            opened = Group;
        } else if (kind == OpenBrace) {
            // After `p^` a brace opens a body, as after `p` or `p)`; only a
            // binary `^` leaves a value to follow.
            last := previous;
            if (dereferenced) {
                last = CloseParen;
            }
            opened = BraceHolds(top, last, valued, prototyping);
            prototyping = false;
        }
        if (opened >= 0) {
            if (depth == length(contexts)) {
                contexts.append(opened);
            } else {
                contexts[depth] = opened;
            }
            depth += 1;
        }
        closed: int = Statements;
        if ((kind == CloseParen || kind == CloseBracket || kind == CloseBrace) && depth > 1) {
            depth -= 1;
            closed = contexts[depth];
        }
        // A word after `.` is a member name, which can end a statement; an
        // attribute's name cannot.
        ends := endings[kind] || dereference || (previous == Period && kind >= Package && kind <= Emit);
        insert = (ends && previous != At) || (kind == CloseBrace && closed == Literal) ||
                 (kind == Colon && label);
        if (kind == Invalid) {
            // Odin keeps insert_semicolon across an illegal character.
            insert = kept;
        }
        if (kind != Comment) {
            valued = (kind == Ident && previous == Period && before == Return) ||
                     (kind == Colon && annotating);
            annotating = (kind == Colon && label) ||
                         (annotating && kind != Colon && kind != Eq && kind != ColonEq &&
                          kind != Semicolon && kind != OpenBrace);
            label = (kind == Ident || kind == String) && top == Statements &&
                    (previous == Invalid || previous == Semicolon || previous == Colon ||
                     previous == OpenBrace || previous == CloseBrace);
            prototyping = prototyping || (kind == Prototype && previous == ColonColon);
            dereferenced = dereference;
            before = previous;
            previous = kind;
        }
    }
    kinds.append(EOF);
    starts.append(count);
    ends.append(count);
    rows.append(row);
    columns.append(count - line);
    return Tokens.Scanned(kinds, starts, ends, rows, columns,
                          errors, error_offsets, error_rows, error_columns);
}

ByteAt :: (bytes: int[], offset: int) -> int {
    if (offset < length(bytes)) {
        return bytes[offset];
    }
    return -1;
}

IsSpace :: (c: int) -> bool {
    return c == 32 || (c >= 9 && c <= 13);
}

IsDigit :: (c: int) -> bool {
    return c >= 48 && c <= 57;
}

DigitValue :: (c: int) -> int {
    if (IsDigit(c)) {
        return c - 48;
    }
    if (c >= 65 && c <= 70) {
        return c - 55;
    }
    if (c >= 97 && c <= 102) {
        return c - 87;
    }
    return 16;
}

// Whether Tree-sitter's external scanner (src/language/src/scanner.c) ends
// a statement at `start`, the first byte after the last token and its
// spacing, which held a line break if `newline`: before `}`, at the end of the
// text, or after a line break, which comments can hold, unless the next line
// continues the expression. The terminator is empty and precedes comments.
Terminates :: (bytes: int[], start: int, newline: bool) -> bool {
    count := length(bytes);
    broken := newline;
    at := start;
    while (at + 1 < count && bytes[at] == Slash && (bytes[at + 1] == Slash || bytes[at + 1] == Star)) {
        if (bytes[at + 1] == Slash) {
            while (at < count && bytes[at] != Newline) {
                at += 1;
            }
        } else {
            at += 2;
            last: int = 0;
            while (at < count) {
                c := bytes[at];
                broken = broken || c == Newline || c == CarriageReturn;
                at += 1;
                if (last == Star && c == Slash) {
                    break;
                }
                last = c;
            }
        }
        while (at < count && IsSpace(bytes[at])) {
            broken = broken || bytes[at] == Newline || bytes[at] == CarriageReturn;
            at += 1;
        }
    }
    c := ByteAt(bytes, at);
    if (c == Slash) {
        // Division continues the expression.
        return false;
    }
    if (c == 123) {
        // A brace on the next line opens the header's body, as Odin's parser
        // also reads it; Tree-sitter's scanner differs only before a
        // statement that starts with a struct literal.
        return false;
    }
    if (c == 125 || c < 0) {
        return true;
    }
    return broken && !Continues(c);
}

// A line that starts with one of `+-*/%&|^!<>=.,?:([` continues the last one.
Continues :: (c: int) -> bool {
    return c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 38 ||
           c == 124 || c == 94 || c == 33 || c == 60 || c == 62 || c == 61 ||
           c == 46 || c == 44 || c == 63 || c == 58 || c == 40 || c == 91;
}

// Odin's insert_semicolon kinds, with Chibi's: a name, literal or closing
// bracket ends an expression, as does a contextual keyword, which can be a
// name, and `?`, `>` and `>>` end a type.
Endings :: () -> bool[] {
    endings := resize([false], KindCount);
    for (kind in [Ident, Integer, Float, String, Char, CloseParen, CloseBracket, Question, Gt, Shr,
                  True, False, Nil, Null, State, Event, Entry, Unordered, Break, Continue,
                  Yield, Return, Package, Import, Struct, From, Split, Component,
                  NotKeyword]) {
        endings[kind] = true;
    }
    return endings;
}

// Each byte's class: SpaceClass, LetterClass, DigitClass or 0.
Classes :: () -> int[] {
    classes := resize([int(0)], 256);
    c: int = 0;
    while (c < 256) {
        if (IsSpace(c)) {
            classes[c] = SpaceClass;
        } else if (c == 95 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)) {
            classes[c] = LetterClass;
        } else if (IsDigit(c)) {
            classes[c] = DigitClass;
        }
        c += 1;
    }
    return classes;
}

// A brace opens a struct literal inside an expression or where a value
// follows; a union's variants after `union`; a prototype's fields, whose
// components and a relationship's body are literals that end nothing; and
// otherwise statements.
BraceHolds :: (outer: int, previous: int, valued: bool, prototyping: bool) -> int {
    if (outer == Fields) {
        if (previous == Colon) {
            return Literal;
        }
        return Embedded;
    }
    if (outer != Statements || valued) {
        return Literal;
    }
    if (prototyping) {
        return Fields;
    }
    if (previous == Union) {
        return Variants;
    }
    if (previous == Relationship) {
        return Embedded;
    }
    if (ValueFollows(previous)) {
        return Literal;
    }
    return Statements;
}

// Assignments, a constant's `::`, `return`, `await`, `in`, and operators
// other than `>`, which can close a type's arguments before a body.
ValueFollows :: (kind: int) -> bool {
    if (kind == Eq) {
        return true;
    }
    if (kind == ColonEq) {
        return true;
    }
    if (kind == ColonColon) {
        return true;
    }
    if ((kind >= AddEq && kind <= XorEq)) {
        return true;
    }
    if (kind == Not) {
        return true;
    }
    if ((kind >= Add && kind <= Shl)) {
        return true;
    }
    if (kind == CmpAnd) {
        return true;
    }
    if (kind == CmpOr) {
        return true;
    }
    if (kind == CmpEq) {
        return true;
    }
    if (kind == NotEq) {
        return true;
    }
    if (kind == Lt) {
        return true;
    }
    if (kind == LtEq) {
        return true;
    }
    if (kind == GtEq) {
        return true;
    }
    if (kind == NotKeyword) {
        return true;
    }
    if (kind == AndKeyword) {
        return true;
    }
    if (kind == OrKeyword) {
        return true;
    }
    if (kind == Coalesce) {
        return true;
    }
    if (kind == Return) {
        return true;
    }
    if (kind == Await) {
        return true;
    }
    if (kind == In) {
        return true;
    }
    return false;
}

Done :: (kind: int, end: int) -> Lexeme {
    return {kind: kind, end: end, message: "", at: end, partial: false};
}

Failed :: (kind: int, end: int, message: string, at: int) -> Lexeme {
    return {kind: kind, end: end, message: message, at: at, partial: false};
}

// Odin's scan for the tokens that can fail. `offset` is at the token's
// first byte.
Scan :: (text: string, bytes: int[], offset: int) -> Lexeme {
    c := bytes[offset];
    if (IsDigit(c)) {
        return ScanNumber(bytes, offset);
    }
    if (c == Quote || c == Apostrophe) {
        return ScanString(bytes, offset, offset + 1);
    }
    if (c == Slash) {
        return ScanComment(bytes, offset);
    }
    return Illegal(text, bytes, offset);
}

ScanIdentifier :: (bytes: int[], classes: int[], offset: int) -> int {
    count := length(bytes);
    at := offset;
    while (at < count && (classes[bytes[at]] == LetterClass || classes[bytes[at]] == DigitClass)) {
        at += 1;
    }
    return at;
}

KeywordTable :: (names: string[]) -> int[] {
    table := resize([int(0)], KeywordSlots);
    kind: int = Package;
    while (kind <= Emit) {
        name := names[kind];
        hash: u64 = KeywordHashBasis;
        index: int = 0;
        while (index < text_byte_length(name)) {
            hash = ((hash ^ u64(text_byte_at(name, index))) * KeywordHashPrime) & 0xFFFFFFFF;
            index += 1;
        }
        slot := int(hash & 511);
        while (table[slot] != Invalid) {
            slot = (slot + 1) % KeywordSlots;
        }
        table[slot] = kind;
        kind += 1;
    }
    return table;
}

// The keyword `bytes[start:end]` spells, or Ident. Like Odin, only words of
// two to fifteen bytes are looked up.
Keyword :: (table: int[], names: string[], bytes: int[], start: int, end: int) -> int {
    if (end - start < 2 || end - start >= 16) {
        return Ident;
    }
    hash: u64 = KeywordHashBasis;
    index := start;
    while (index < end) {
        hash = ((hash ^ u64(bytes[index])) * KeywordHashPrime) & 0xFFFFFFFF;
        index += 1;
    }
    slot := int(hash & 511);
    while (table[slot] != Invalid) {
        kind := table[slot];
        if (Spells(names[kind], bytes, start, end)) {
            return kind;
        }
        slot = (slot + 1) % KeywordSlots;
    }
    return Ident;
}

Spells :: (name: string, bytes: int[], start: int, end: int) -> bool {
    if (text_byte_length(name) != end - start) {
        return false;
    }
    index: int = 0;
    while (index < end - start) {
        if (text_byte_at(name, index) != bytes[start + index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

// grammar.js's number: hexadecimal digits after 0x, or decimal digits with
// an optional fraction and exponent. Odin's checks report a prefix or an
// exponent without digits.
ScanNumber :: (bytes: int[], offset: int) -> Lexeme {
    at := offset + 1;
    marker := ByteAt(bytes, at);
    if (bytes[offset] == 48 && (marker == 120 || marker == 88)) {
        at += 1;
        digits := at;
        while (DigitValue(ByteAt(bytes, at)) < 16) {
            at += 1;
        }
        if (at == digits) {
            return Failed(Invalid, at, "illegal hexadecimal integer", at);
        }
        return Done(Integer, at);
    }
    kind: int = Integer;
    at = ScanMantissa(bytes, at);
    // A fraction needs a digit, so `0..n` stays a range.
    if (ByteAt(bytes, at) == 46 && IsDigit(ByteAt(bytes, at + 1))) {
        kind = Float;
        at = ScanMantissa(bytes, at + 1);
    }
    exponent := ByteAt(bytes, at);
    if (exponent == 101 || exponent == 69) {
        kind = Float;
        at += 1;
        sign := ByteAt(bytes, at);
        if (sign == 43 || sign == 45) {
            at += 1;
        }
        if (!IsDigit(ByteAt(bytes, at))) {
            return Failed(Float, at, "illegal floating-point exponent", at);
        }
        at = ScanMantissa(bytes, at);
    }
    return Done(kind, at);
}

ScanMantissa :: (bytes: int[], offset: int) -> int {
    count := length(bytes);
    at := offset;
    while (at < count && IsDigit(bytes[at])) {
        at += 1;
    }
    return at;
}

// The body of the string that opens at `start`, from `from` to its closing
// quote. Escapes are JSON's; a failed one stops the scan, which resumes at
// its end, so that every failure is reported as Odin reports them.
ScanString :: (bytes: int[], start: int, from: int) -> Lexeme {
    count := length(bytes);
    quote := bytes[start];
    kind := String;
    message := "String literal not terminated";
    if (quote == Apostrophe) {
        kind = Char;
        message = "Character literal not terminated";
    }
    at := from;
    while (at < count && bytes[at] != Newline) {
        c := bytes[at];
        at += 1;
        if (c == quote) {
            return Done(kind, at);
        }
        if (c == Backslash) {
            escape := ScanEscape(bytes, at);
            if (escape.message != "") {
                return {kind: kind, end: escape.end, message: escape.message,
                        at: escape.at, partial: true};
            }
            at = escape.end;
        }
    }
    return Failed(kind, at, message, start);
}

// The escape whose character is at `offset`, after its backslash. Like Odin,
// a failure leaves the offending character unread.
ScanEscape :: (bytes: int[], offset: int) -> Lexeme {
    c := ByteAt(bytes, offset);
    // " \ / b f n r t
    if (c == Quote || c == Backslash || c == Slash || c == 98 || c == 102 ||
        c == 110 || c == 114 || c == 116) {
        return Done(String, offset + 1);
    }
    if (c < 0) {
        return Failed(String, offset, "escape sequence was not terminated", offset);
    }
    if (c != 117) {
        return Failed(String, offset, "unknown escape sequence", offset);
    }
    at := offset + 1;
    while (at < offset + 5) {
        digit := ByteAt(bytes, at);
        if (digit < 0) {
            return Failed(String, at, "escape sequence was not terminated", at);
        }
        if (DigitValue(digit) >= 16) {
            return Failed(String, at, format_text("illegal character {} in escape sequence", digit), at);
        }
        at += 1;
    }
    return Done(String, at);
}

// A line comment runs to its line break; a block comment, which does not
// nest in Chibi, to the first `*/`.
ScanComment :: (bytes: int[], offset: int) -> Lexeme {
    count := length(bytes);
    at := offset + 2;
    if (bytes[offset + 1] == Slash) {
        while (at < count && bytes[at] != Newline) {
            at += 1;
        }
        return Done(Comment, at);
    }
    while (at + 1 < count) {
        if (bytes[at] == Star && bytes[at + 1] == Slash) {
            return Done(Comment, at + 2);
        }
        at += 1;
    }
    return Failed(Comment, count, "comment not terminated", offset);
}

// The two-character operator `c` and `next` spell, or Invalid.
Pair :: (c: int, next: int) -> int {
    if (next == 61) {
        if (c == 61) {
            return CmpEq;
        }
        if (c == 33) {
            return NotEq;
        }
        if (c == 43) {
            return AddEq;
        }
        if (c == 45) {
            return SubEq;
        }
        if (c == 42) {
            return MulEq;
        }
        if (c == 47) {
            return QuoEq;
        }
        if (c == 37) {
            return ModEq;
        }
        if (c == 38) {
            return AndEq;
        }
        if (c == 124) {
            return OrEq;
        }
        if (c == 94) {
            return XorEq;
        }
        if (c == 60) {
            return LtEq;
        }
        if (c == 62) {
            return GtEq;
        }
        if (c == 58) {
            return ColonEq;
        }
        return Invalid;
    }
    if (c == 45 && next == 62) {
        return ArrowRight;
    }
    if (c == 61 && next == 62) {
        return FatArrow;
    }
    if (c != next) {
        return Invalid;
    }
    if (c == 38) {
        return CmpAnd;
    }
    if (c == 124) {
        return CmpOr;
    }
    if (c == 60) {
        return Shl;
    }
    if (c == 62) {
        return Shr;
    }
    if (c == 58) {
        return ColonColon;
    }
    if (c == 46) {
        return Ellipsis;
    }
    if (c == 63) {
        return Coalesce;
    }
    return Invalid;
}

// The one-character token `c` is, or Invalid.
Single :: (c: int) -> int {
    if (c == 61) {
        return Eq;
    }
    if (c == 33) {
        return Not;
    }
    if (c == 64) {
        return At;
    }
    if (c == 36) {
        return Dollar;
    }
    if (c == 63) {
        return Question;
    }
    if (c == 43) {
        return Add;
    }
    if (c == 45) {
        return Sub;
    }
    if (c == 42) {
        return Mul;
    }
    if (c == 47) {
        return Quo;
    }
    if (c == 37) {
        return Mod;
    }
    if (c == 38) {
        return And;
    }
    if (c == 124) {
        return Or;
    }
    if (c == 94) {
        return Xor;
    }
    if (c == 126) {
        return Complement;
    }
    if (c == 60) {
        return Lt;
    }
    if (c == 62) {
        return Gt;
    }
    if (c == 40) {
        return OpenParen;
    }
    if (c == 41) {
        return CloseParen;
    }
    if (c == 91) {
        return OpenBracket;
    }
    if (c == 93) {
        return CloseBracket;
    }
    if (c == 123) {
        return OpenBrace;
    }
    if (c == 125) {
        return CloseBrace;
    }
    if (c == 58) {
        return Colon;
    }
    if (c == 59) {
        return Semicolon;
    }
    if (c == 46) {
        return Period;
    }
    if (c == 44) {
        return Comma;
    }
    return Invalid;
}

// A character no token starts with, read as UTF-8 so that the error names it
// as Odin's does and the Invalid token covers all of its bytes.
Illegal :: (text: string, bytes: int[], offset: int) -> Lexeme {
    c := bytes[offset];
    width: int = 1;
    value := c;
    if (c >= 0xC2 && c <= 0xDF) {
        width = 2;
        value = c - 0xC0;
    } else if (c >= 0xE0 && c <= 0xEF) {
        width = 3;
        value = c - 0xE0;
    } else if (c >= 0xF0 && c <= 0xF4) {
        width = 4;
        value = c - 0xF0;
    } else if (c >= 0x80) {
        return Failed(Invalid, offset + 1, "illegal UTF-8 encoding", offset);
    }
    index: int = 1;
    while (index < width) {
        part := ByteAt(bytes, offset + index);
        if (part < 0x80 || part > 0xBF) {
            return Failed(Invalid, offset + 1, "illegal UTF-8 encoding", offset);
        }
        value = value * 64 + part - 0x80;
        index += 1;
    }
    return Failed(Invalid, offset + width,
                  format_text("illegal character '{}': {}", text_slice(text, offset, width), value),
                  offset);
}
