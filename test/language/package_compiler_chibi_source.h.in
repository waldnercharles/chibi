static const char PACKAGE_COMPILER_REFERENCES_SOURCE[] = { @CHIBI_PACKAGE_COMPILER_REFERENCES_BYTES@ 0 };
static const char PACKAGE_COMPILER_POINTERS_SOURCE[] = { @CHIBI_PACKAGE_COMPILER_POINTERS_BYTES@ 0 };
static const char PACKAGE_COMPILER_TASKS_SOURCE[] = { @CHIBI_PACKAGE_COMPILER_TASKS_BYTES@ 0 };
static const char PACKAGE_COMPILER_TASK_RESULTS_SOURCE[] = { @CHIBI_PACKAGE_COMPILER_TASKRESULTS_BYTES@ 0 };
static const char PACKAGE_COMPILER_TREE_SOURCE[] = { @CHIBI_PACKAGE_COMPILER_TREE_BYTES@ 0 };
static const char PACKAGE_COMPILER_NUMBER_SOURCE[] = { @CHIBI_PACKAGE_COMPILER_NUMBER_BYTES@ 0 };
static const char PACKAGE_COMPILER_OPTIONAL_SOURCE[] = { @CHIBI_PACKAGE_COMPILER_OPTIONAL_BYTES@ 0 };
static const char PACKAGE_COMPILER_SEQUENCES_SOURCE[] = { @CHIBI_PACKAGE_COMPILER_SEQUENCES_BYTES@ 0 };
static const char PACKAGE_COMPILER_QUERYLOOPS_SOURCE[] = { @CHIBI_PACKAGE_COMPILER_QUERYLOOPS_BYTES@ 0 };
static const char PACKAGE_COMPILER_QUERIES_SOURCE[] = { @CHIBI_PACKAGE_COMPILER_QUERIES_BYTES@ 0 };
static const char PACKAGE_COMPILER_BEHAVIOR_SOURCE[] = { @CHIBI_PACKAGE_COMPILER_BEHAVIOR_BYTES@ 0 };
static const char PACKAGE_COMPILER_SCALAR_SOURCE[] = { @CHIBI_PACKAGE_COMPILER_SCALAR_BYTES@ 0 };
static const char SCALAR_FACTS_SOURCE[] = { @CHIBI_SCALAR_FACTS_BYTES@ 0 };
static const char SCALAR_LLVM_SOURCE[] = { @CHIBI_SCALAR_LLVM_BYTES@ 0 };
static const char LLVM_NATIVE_SOURCE[] = { @CHIBI_LLVM_NATIVE_BYTES@ 0 };
static const char NATIVE_ABI_SOURCE[] = { @CHIBI_NATIVE_ABI_BYTES@ 0 };
static const char SCALAR_CASES_SOURCE[] = { @CHIBI_SCALAR_CASES_BYTES@ 0 };
@CHIBI_EMITTER_TEST_SOURCES@

#define PACKAGE_COMPILER_SOURCE(PATH, VALUE) { PATH, VALUE, sizeof VALUE - 1 }
#define PACKAGE_COMPILER_SOURCE_INPUTS \
    PACKAGE_COMPILER_SOURCE("syntax_diagnostics/Diagnostics.chibi", SYNTAX_CHIBI_SOURCE), \
    PACKAGE_COMPILER_SOURCE("/sdk/core/strings/Strings.chibi", CORE_STRINGS_SOURCE), \
    PACKAGE_COMPILER_SOURCE("source_snapshot/Snapshot.chibi", PACKAGE_SNAPSHOT_CHIBI_SOURCE), \
    PACKAGE_COMPILER_SOURCE("compiler_syntax/Syntax.chibi", COMPILER_SYNTAX_CHIBI_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_routes/Routes.chibi", PACKAGE_ROUTES_CHIBI_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_syntax/Extract.chibi", PACKAGE_SYNTAX_CHIBI_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_graph/Graph.chibi", PACKAGE_GRAPH_CHIBI_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_paths/Paths.chibi", PACKAGE_PATHS_CHIBI_SOURCE), \
    PACKAGE_COMPILER_SOURCE("lexical_binding/Binding.chibi", LEXICAL_BINDING_CHIBI_SOURCE), \
    PACKAGE_COMPILER_SOURCE("prepared_writer/Writer.chibi", PREPARED_WRITER_CHIBI_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/Compile.chibi", PACKAGE_COMPILER_COMPILE_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/Body.chibi", PACKAGE_COMPILER_BODY_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/Fallible.chibi", PACKAGE_COMPILER_FALLIBLE_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/Steps.chibi", PACKAGE_COMPILER_STEPS_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/Maps.chibi", PACKAGE_COMPILER_MAPS_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/References.chibi", PACKAGE_COMPILER_REFERENCES_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/Pointers.chibi", PACKAGE_COMPILER_POINTERS_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/Tasks.chibi", PACKAGE_COMPILER_TASKS_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/TaskResults.chibi", PACKAGE_COMPILER_TASK_RESULTS_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/Tree.chibi", PACKAGE_COMPILER_TREE_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/Number.chibi", PACKAGE_COMPILER_NUMBER_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/Optional.chibi", PACKAGE_COMPILER_OPTIONAL_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/Sequences.chibi", PACKAGE_COMPILER_SEQUENCES_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/Queries.chibi", PACKAGE_COMPILER_QUERIES_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/QueryLoops.chibi", PACKAGE_COMPILER_QUERYLOOPS_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/Behavior.chibi", PACKAGE_COMPILER_BEHAVIOR_SOURCE), \
    PACKAGE_COMPILER_SOURCE("package_compiler/Scalar.chibi", PACKAGE_COMPILER_SCALAR_SOURCE), \
    PACKAGE_COMPILER_SOURCE("scalar_facts/Facts.chibi", SCALAR_FACTS_SOURCE)
/* The scalar consumer, prepared apart from the producer that made its rows. */
#define SCALAR_CONSUMER_SOURCE_INPUTS \
    PACKAGE_COMPILER_SOURCE("/sdk/core/strings/Strings.chibi", CORE_STRINGS_SOURCE), \
    PACKAGE_COMPILER_SOURCE("scalar_facts/Facts.chibi", SCALAR_FACTS_SOURCE), \
    PACKAGE_COMPILER_SOURCE("scalar_llvm/Emit.chibi", SCALAR_LLVM_SOURCE), \
    PACKAGE_COMPILER_SOURCE("llvm_native/Emit.chibi", LLVM_NATIVE_SOURCE), \
    PACKAGE_COMPILER_SOURCE("native_abi/Abi.chibi", NATIVE_ABI_SOURCE)
/* The authored scalar corpus: each case's source and expected result. */
#define SCALAR_CASES_SOURCE_INPUTS \
    PACKAGE_COMPILER_SOURCE("/sdk/core/strings/Strings.chibi", CORE_STRINGS_SOURCE), \
    PACKAGE_COMPILER_SOURCE("scalar_facts/Facts.chibi", SCALAR_FACTS_SOURCE), \
    PACKAGE_COMPILER_SOURCE("scalar_cases/Cases.chibi", SCALAR_CASES_SOURCE)

/* Every source file of the test-only authored emitter package. */
#define EMITTER_TEST_SOURCE_INPUTS \
@CHIBI_EMITTER_TEST_INPUTS@

#endif
