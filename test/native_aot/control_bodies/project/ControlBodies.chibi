package control_bodies

Nearest :: (outer: bool, inner: bool) -> int {
    if outer
        if inner return 1;
        else return 2;
    return 3;
}

@test
NearestIfOwnsElse :: () {
    assert(Nearest(true, true) == 1, "inner consequence");
    assert(Nearest(true, false) == 2, "inner alternative");
    assert(Nearest(false, true) == 3, "outer branch has no alternative");
}

@test
SingleStatementsHaveBlockScope :: () {
    value := 7;
    if true value := 11;
    else value := 12;
    while false value := 13;
    assert(value == 7, "body-local declarations do not replace the outer local");
}

@test
OnlyOneStatementBelongsToTheBody :: () {
    value := 0;
    if false value = 99;
    value += 2;
    while value < 4 value += 1;
    value += 10;
    assert(value == 14, "following statements run outside either body");
}

@test
NestedLoopBranchesKeepBreakAndContinue :: () {
    remaining := 4;
    sum := 0;
    while remaining > 0
        if remaining == 2 {
            remaining -= 1;
            continue;
        } else {
            sum += remaining;
            remaining -= 1;
        }
    assert(sum == 8, "continue targets the containing loop");
    while true
        if remaining == 3
            break;
        else
            remaining += 1;
    assert(remaining == 3, "break targets the containing loop");
}

@test
ElseChainsAndCommentsKeepTheirMeaning :: () {
    value := 0;
    if false // first arm
        value = 1;
    else if false /* second arm */
        value = 2;
    else
        // Final arm still owns the next statement.
        value = 3;
    assert(value == 3, "the final alternative runs");
}
