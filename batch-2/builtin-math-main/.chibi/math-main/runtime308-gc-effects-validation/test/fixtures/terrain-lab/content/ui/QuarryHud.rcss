div { display: block; }
#heading { position: absolute; top: 24dp; left: 30dp; }
#eyebrow { color: #72ead4; font-size: 22dp; letter-spacing: 1dp; }
#title { font-size: 44dp; font-weight: bold; margin-top: 5dp; color: #f5eadb; }
#subtitle { font-size: 26dp; color: #b7c9cb; margin-top: 3dp; }
#legend { position: absolute; top: 174dp; left: 30dp; color: #afc4c8; font-size: 22dp; }
.mint { color: #72ead4; }
.amber { color: #ffc383; }
.gap { color: #69818b; margin-left: 10dp; margin-right: 10dp; }
#instructions { position: absolute; bottom: 170dp; left: 30dp; color: #e0eeeb; font-size: 25dp; }
#storage { position: absolute; left: 30dp; right: 30dp; bottom: 20dp; padding: 12dp 18dp; background-color: #10222bf0; border: 1dp #45616c; }
#storage-controls { color: #72ead4; font-size: 25dp; }
#status { color: #f5eadb; font-size: 27dp; margin-top: 6dp; }
#detail { color: #9db7bf; font-size: 23dp; margin-top: 4dp; }
