// Ground with an open cave at the western entrance. Live cuts are separate.
QuarryShapes :: library {
    Quarry :: (X: number = 0.0, Y: number = 0.0) -> (Value: number = 0.0) {
        return field_subtract(0.0, field_min(field_subtract(0.0, field_box(X, field_subtract(Y, 4.0), 384.0, 68.0)), field_min(field_capsule(X, Y, -236.0, -80.0, -205.0, -9.0, 25.0), field_circle(field_add(X, 170.0), field_add(Y, 6.0), 40.0))))
    }
}
