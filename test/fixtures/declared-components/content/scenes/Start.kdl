version 1
name "Start"
(array)entities {
    - name="Camera" prototype="Camera"
    - name="Cell" prototype="Battery"
    - {
        name "Spare"
        prototype "Battery"
        components {
            Charge {
                level 1.5
                rate 0.5
                capacity 2.0
                drift x=1.0 y=-1.0
            }
        }
    }
}
