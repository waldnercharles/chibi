package strings

// A port of Odin's core:strings over bytes. Where Odin decodes runes, these
// procedures compare, count and offset bytes, and spaces and case are ASCII.
// Offsets are byte offsets, and -1 means not found.

// Compiler text operations use bytes, including bytes inside UTF-8 sequences.
ByteLength :: pure fn(value: string) -> int {
    return text_byte_length(value);
}

// Returns -1 outside the string; valid bytes are unsigned values from 0 to 255.
// Each call measures the string, so a loop over a long one should read Bytes.
ByteAt :: pure fn(value: string, index: int) -> int {
    return text_byte_at(value, index);
}

// Every byte of the string, from 0 to 255, read in one pass.
Bytes :: pure fn(value: string) -> int[] {
    return text_bytes(value);
}

// Start clamps to the string and count clamps to its remaining bytes.
Slice :: pure fn(value: string, start: int, count: int) -> string {
    return text_slice(value, start, count);
}

Compare :: pure fn(left: string, right: string) -> int {
    leftLength := ByteLength(left);
    rightLength := ByteLength(right);
    index: int = 0;
    while (index < leftLength && index < rightLength) {
        a := ByteAt(left, index);
        b := ByteAt(right, index);
        if (a < b) {
            return -1;
        }
        if (a > b) {
            return 1;
        }
        index += 1;
    }
    if (leftLength < rightLength) {
        return -1;
    }
    if (leftLength > rightLength) {
        return 1;
    }
    return 0;
}

IsIdentifier :: pure fn(value: string) -> bool {
    size := ByteLength(value);
    if (size == 0) {
        return false;
    }
    index: int = 0;
    while (index < size) {
        byte := ByteAt(value, index);
        letter := byte == 95 || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122);
        if (!letter && !(index > 0 && byte >= 48 && byte <= 57)) {
            return false;
        }
        index += 1;
    }
    return true;
}

BaseName :: pure fn(path: string) -> string {
    size := ByteLength(path);
    start: int = 0;
    index: int = 0;
    while (index < size) {
        if (ByteAt(path, index) == 47) {
            start = index + 1;
        }
        index += 1;
    }
    return Slice(path, start, size - start);
}

Contains :: pure fn(s: string, substr: string) -> bool {
    return Index(s, substr) >= 0;
}

ContainsAny :: pure fn(s: string, chars: string) -> bool {
    return IndexAny(s, chars) >= 0;
}

HasPrefix :: pure fn(s: string, prefix: string) -> bool {
    size := ByteLength(prefix);
    return ByteLength(s) >= size && Slice(s, 0, size) == prefix;
}

HasSuffix :: pure fn(s: string, suffix: string) -> bool {
    size := ByteLength(s);
    count := ByteLength(suffix);
    return size >= count && Slice(s, size - count, count) == suffix;
}

IndexByte :: pure fn(s: string, c: int) -> int {
    size := ByteLength(s);
    i: int = 0;
    while (i < size) {
        if (ByteAt(s, i) == c) {
            return i;
        }
        i += 1;
    }
    return -1;
}

LastIndexByte :: pure fn(s: string, c: int) -> int {
    i: int = ByteLength(s) - 1;
    while (i >= 0) {
        if (ByteAt(s, i) == c) {
            return i;
        }
        i -= 1;
    }
    return -1;
}

// Rabin-Karp with Odin's 32-bit rolling hash, kept in int64 and masked; pow
// is the prime to the substring's length. An empty substring is found at 0.
Index :: pure fn(s: string, substr: string) -> int {
    n := ByteLength(substr);
    size := ByteLength(s);
    if (n == 0) {
        return 0;
    }
    if (n == 1) {
        return IndexByte(s, ByteAt(substr, 0));
    }
    if (n == size) {
        if (s == substr) {
            return 0;
        }
        return -1;
    }
    if (n > size) {
        return -1;
    }
    hash: int64 = 0;
    pow: int64 = 1;
    h: int64 = 0;
    i: int = 0;
    while (i < n) {
        hash = (hash * 16777619 + ByteAt(substr, i)) & 0xFFFFFFFF;
        pow = (pow * 16777619) & 0xFFFFFFFF;
        h = (h * 16777619 + ByteAt(s, i)) & 0xFFFFFFFF;
        i += 1;
    }
    if (h == hash && Slice(s, 0, n) == substr) {
        return 0;
    }
    while (i < size) {
        h = (h * 16777619 + ByteAt(s, i) - pow * ByteAt(s, i - n)) & 0xFFFFFFFF;
        i += 1;
        if (h == hash && Slice(s, i - n, n) == substr) {
            return i - n;
        }
    }
    return -1;
}

// Index's search from the end. An empty substring is found at the length of s.
LastIndex :: pure fn(s: string, substr: string) -> int {
    n := ByteLength(substr);
    size := ByteLength(s);
    if (n == 0) {
        return size;
    }
    if (n == 1) {
        return LastIndexByte(s, ByteAt(substr, 0));
    }
    if (n == size) {
        if (s == substr) {
            return 0;
        }
        return -1;
    }
    if (n > size) {
        return -1;
    }
    hash: int64 = 0;
    pow: int64 = 1;
    h: int64 = 0;
    i: int = 0;
    while (i < n) {
        hash = (hash * 16777619 + ByteAt(substr, n - 1 - i)) & 0xFFFFFFFF;
        pow = (pow * 16777619) & 0xFFFFFFFF;
        h = (h * 16777619 + ByteAt(s, size - 1 - i)) & 0xFFFFFFFF;
        i += 1;
    }
    i = size - n;
    if (h == hash && Slice(s, i, n) == substr) {
        return i;
    }
    i -= 1;
    while (i >= 0) {
        h = (h * 16777619 + ByteAt(s, i) - pow * ByteAt(s, i + n)) & 0xFFFFFFFF;
        if (h == hash && Slice(s, i, n) == substr) {
            return i;
        }
        i -= 1;
    }
    return -1;
}

// The offset of the first byte of s that is any byte of chars.
IndexAny :: pure fn(s: string, chars: string) -> int {
    size := ByteLength(s);
    i: int = 0;
    while (i < size) {
        if (IndexByte(chars, ByteAt(s, i)) >= 0) {
            return i;
        }
        i += 1;
    }
    return -1;
}

LastIndexAny :: pure fn(s: string, chars: string) -> int {
    i: int = ByteLength(s) - 1;
    while (i >= 0) {
        if (IndexByte(chars, ByteAt(s, i)) >= 0) {
            return i;
        }
        i -= 1;
    }
    return -1;
}

// Non-overlapping occurrences. An empty substring occurs at every byte
// boundary, one more than the byte length.
Count :: pure fn(s: string, substr: string) -> int {
    n := ByteLength(substr);
    if (n == 0) {
        return ByteLength(s) + 1;
    }
    total: int = 0;
    if (n == 1) {
        c := ByteAt(substr, 0);
        size := ByteLength(s);
        i: int = 0;
        while (i < size) {
            if (ByteAt(s, i) == c) {
                total += 1;
            }
            i += 1;
        }
        return total;
    }
    rest: string = s;
    i := Index(rest, substr);
    while (i >= 0) {
        total += 1;
        rest = Slice(rest, i + n, ByteLength(rest));
        i = Index(rest, substr);
    }
    return total;
}

// Everything before the first c, or all of s when c is absent.
TruncateToByte :: pure fn(s: string, c: int) -> string {
    n := IndexByte(s, c);
    if (n < 0) {
        return s;
    }
    return Slice(s, 0, n);
}

// ASCII letters match in either case; every other byte must be equal.
EqualFold :: pure fn(u: string, v: string) -> bool {
    size := ByteLength(u);
    if (size != ByteLength(v)) {
        return false;
    }
    i: int = 0;
    while (i < size) {
        sr := ByteAt(u, i);
        tr := ByteAt(v, i);
        if (tr < sr) {
            swap := sr;
            sr = tr;
            tr = swap;
        }
        if (tr != sr && !(sr >= 65 && sr <= 90 && tr == sr + 32)) {
            return false;
        }
        i += 1;
    }
    return true;
}

// ASCII letters only; other bytes, including those of UTF-8 sequences, stay.
ToLower :: pure fn(s: string) -> string {
    size := ByteLength(s);
    result: string = "";
    start: int = 0;
    i: int = 0;
    while (i < size) {
        c := ByteAt(s, i);
        if (c >= 65 && c <= 90) {
            letter := Slice("abcdefghijklmnopqrstuvwxyz", c - 65, 1);
            result = format_text("{}{}{}", result, Slice(s, start, i - start), letter);
            start = i + 1;
        }
        i += 1;
    }
    if (start == 0) {
        return s;
    }
    return format_text("{}{}", result, Slice(s, start, size - start));
}

ToUpper :: pure fn(s: string) -> string {
    size := ByteLength(s);
    result: string = "";
    start: int = 0;
    i: int = 0;
    while (i < size) {
        c := ByteAt(s, i);
        if (c >= 97 && c <= 122) {
            letter := Slice("ABCDEFGHIJKLMNOPQRSTUVWXYZ", c - 97, 1);
            result = format_text("{}{}{}", result, Slice(s, start, i - start), letter);
            start = i + 1;
        }
        i += 1;
    }
    if (start == 0) {
        return s;
    }
    return format_text("{}{}", result, Slice(s, start, size - start));
}

// Tab, line feed, vertical tab, form feed, carriage return and space.
IsAsciiSpace :: pure fn(c: int) -> bool {
    return c == 32 || (c >= 9 && c <= 13);
}

// Removes the leading bytes that are bytes of cutset.
TrimLeft :: pure fn(s: string, cutset: string) -> string {
    size := ByteLength(s);
    i: int = 0;
    while (i < size && IndexByte(cutset, ByteAt(s, i)) >= 0) {
        i += 1;
    }
    return Slice(s, i, size - i);
}

TrimRight :: pure fn(s: string, cutset: string) -> string {
    i := ByteLength(s);
    while (i > 0 && IndexByte(cutset, ByteAt(s, i - 1)) >= 0) {
        i -= 1;
    }
    return Slice(s, 0, i);
}

Trim :: pure fn(s: string, cutset: string) -> string {
    return TrimRight(TrimLeft(s, cutset), cutset);
}

TrimLeftSpace :: pure fn(s: string) -> string {
    size := ByteLength(s);
    i: int = 0;
    while (i < size && IsAsciiSpace(ByteAt(s, i))) {
        i += 1;
    }
    return Slice(s, i, size - i);
}

TrimRightSpace :: pure fn(s: string) -> string {
    i := ByteLength(s);
    while (i > 0 && IsAsciiSpace(ByteAt(s, i - 1))) {
        i -= 1;
    }
    return Slice(s, 0, i);
}

TrimSpace :: pure fn(s: string) -> string {
    return TrimRightSpace(TrimLeftSpace(s));
}

TrimPrefix :: pure fn(s: string, prefix: string) -> string {
    if (HasPrefix(s, prefix)) {
        return Slice(s, ByteLength(prefix), ByteLength(s));
    }
    return s;
}

TrimSuffix :: pure fn(s: string, suffix: string) -> string {
    if (HasSuffix(s, suffix)) {
        return Slice(s, 0, ByteLength(s) - ByteLength(suffix));
    }
    return s;
}

// The count bytes from offset, or all bytes from offset when count is below 1.
// As in Odin, an offset outside s keeps all of s, and a count past the end
// keeps the rest.
Cut :: pure fn(s: string, offset: int, count: int) -> string {
    rest: string = s;
    size := ByteLength(s);
    if (offset >= 0 && offset < size) {
        rest = Slice(s, offset, size - offset);
    }
    if (count < 1 || count >= ByteLength(rest)) {
        return rest;
    }
    return Slice(rest, 0, count);
}

// Odin's _split: at most n parts, or every part when n is negative; the last
// part holds the rest of s. Each other part keeps the first keep bytes of the
// separator after it. An empty separator splits s into bytes.
SplitKeeping :: pure fn(s: string, sep: string, keep: int, n: int) -> string[] {
    parts: string[] = [];
    size := ByteLength(sep);
    limit := n;
    if (size == 0) {
        count := ByteLength(s);
        if (limit < 0 || limit > count) {
            limit = count;
        }
        while (length(parts) < limit - 1) {
            parts = array_add(parts, Slice(s, length(parts), 1));
        }
        if (limit > 0) {
            parts = array_add(parts, Slice(s, limit - 1, count));
        }
        return parts;
    }
    if (limit == 0) {
        return parts;
    }
    if (limit < 0) {
        limit = Count(s, sep) + 1;
    }
    rest: string = s;
    while (length(parts) < limit - 1) {
        m := Index(rest, sep);
        if (m < 0) {
            break;
        }
        parts = array_add(parts, Slice(rest, 0, m + keep));
        rest = Slice(rest, m + size, ByteLength(rest));
    }
    parts = array_add(parts, rest);
    return parts;
}

Split :: pure fn(s: string, sep: string) -> string[] {
    return SplitKeeping(s, sep, 0, -1);
}

SplitN :: pure fn(s: string, sep: string, n: int) -> string[] {
    return SplitKeeping(s, sep, 0, n);
}

SplitAfter :: pure fn(s: string, sep: string) -> string[] {
    return SplitKeeping(s, sep, ByteLength(sep), -1);
}

SplitAfterN :: pure fn(s: string, sep: string, n: int) -> string[] {
    return SplitKeeping(s, sep, ByteLength(sep), n);
}

// Splits at line feeds; a line that ends in a carriage return loses it.
SplitLinesKeeping :: pure fn(s: string, keep: int, n: int) -> string[] {
    lines: string[] = [];
    foreach (line in SplitKeeping(s, "\n", keep, n)) {
        lines = array_add(lines, TrimSuffix(line, "\r"));
    }
    return lines;
}

SplitLines :: pure fn(s: string) -> string[] {
    return SplitLinesKeeping(s, 0, -1);
}

SplitLinesN :: pure fn(s: string, n: int) -> string[] {
    return SplitLinesKeeping(s, 0, n);
}

SplitLinesAfter :: pure fn(s: string) -> string[] {
    return SplitLinesKeeping(s, 1, -1);
}

SplitLinesAfterN :: pure fn(s: string, n: int) -> string[] {
    return SplitLinesKeeping(s, 1, n);
}

// The runs of bytes between ASCII spaces.
Fields :: pure fn(s: string) -> string[] {
    fields: string[] = [];
    size := ByteLength(s);
    start: int = -1;
    i: int = 0;
    while (i < size) {
        if (IsAsciiSpace(ByteAt(s, i))) {
            if (start >= 0) {
                fields = array_add(fields, Slice(s, start, i - start));
                start = -1;
            }
        } else if (start < 0) {
            start = i;
        }
        i += 1;
    }
    if (start >= 0) {
        fields = array_add(fields, Slice(s, start, size - start));
    }
    return fields;
}

Join :: pure fn(a: string[], sep: string) -> string {
    if (length(a) == 0) {
        return "";
    }
    result: string = a[0];
    i: int = 1;
    while (i < length(a)) {
        result = format_text("{}{}{}", result, sep, a[i]);
        i += 1;
    }
    return result;
}

Concatenate :: pure fn(a: string[]) -> string {
    return Join(a, "");
}

// Doubles what it has built, as Odin copies. Where Odin panics on a negative
// count, a count below 1 gives an empty string, as Slice clamps counts.
Repeat :: pure fn(s: string, count: int) -> string {
    if (count < 1) {
        return "";
    }
    total: int64 = int64(ByteLength(s)) * count;
    result: string = s;
    while (ByteLength(result) < total) {
        rest: int64 = total - ByteLength(result);
        result = format_text("{}{}", result, Slice(result, 0, int(clamp: rest)));
    }
    return result;
}

// Replaces the first n non-overlapping matches of old, or all of them when n is
// negative. An empty old matches at every byte boundary.
Replace :: pure fn(s: string, old: string, new: string, n: int) -> string {
    if (old == new || n == 0) {
        return s;
    }
    matches := Count(s, old);
    if (matches == 0) {
        return s;
    }
    if (n > 0 && n < matches) {
        matches = n;
    }
    size := ByteLength(s);
    width := ByteLength(old);
    result: string = "";
    start: int = 0;
    i: int = 0;
    while (i < matches) {
        j := start;
        if (width == 0) {
            if (i > 0) {
                j += 1;
            }
        } else {
            j += Index(Slice(s, start, size - start), old);
        }
        result = format_text("{}{}{}", result, Slice(s, start, j - start), new);
        start = j + width;
        i += 1;
    }
    return format_text("{}{}", result, Slice(s, start, size - start));
}

ReplaceAll :: pure fn(s: string, old: string, new: string) -> string {
    return Replace(s, old, new, -1);
}

Remove :: pure fn(s: string, key: string, n: int) -> string {
    return Replace(s, key, "", n);
}

RemoveAll :: pure fn(s: string, key: string) -> string {
    return Remove(s, key, -1);
}

Parts :: struct {
    head: string;
    match: string;
    tail: string;
}

// The text before the first sep, sep and the text after it; when sep is
// absent, head is all of str and the others are empty.
Partition :: pure fn(str: string, sep: string) -> Parts {
    i := Index(str, sep);
    if (i < 0) {
        return {head: str, match: "", tail: ""};
    }
    size := ByteLength(sep);
    return {head: Slice(str, 0, i), match: sep, tail: Slice(str, i + size, ByteLength(str))};
}
