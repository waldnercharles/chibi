            "CHIBI_PORTABLE_PATH_SLASHPATH_SOURCES=test-sources:PORTABLE_PATH_SLASHPATH:path/slashpath:packages/core/path/slashpath",
            "CHIBI_PORTABLE_PATH_SLASHPATH_INPUTS=test-inputs:PORTABLE_PATH_SLASHPATH:path/slashpath:packages/core/path/slashpath",
            "CHIBI_PORTABLE_MATH_BITS_SOURCES=test-sources:PORTABLE_MATH_BITS:math/bits:packages/core/math/bits",
            "CHIBI_PORTABLE_MATH_BITS_INPUTS=test-inputs:PORTABLE_MATH_BITS:math/bits:packages/core/math/bits",
            "CHIBI_PORTABLE_HASH_FNV_SOURCES=test-sources:PORTABLE_HASH_FNV:hash/fnv:packages/core/hash/fnv",
