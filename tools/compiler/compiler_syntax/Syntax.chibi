package compiler_syntax

// Sibling packages are imported relatively, so programs outside tools/compiler,
// such as chibi fmt, can import this one from a collection of that directory.
import parser "../source_parser"

// The raw syntax tree of `text`: every token a leaf, with the kinds, fields,
// named and extra flags and byte ranges of src/language/grammar.js, or the
// diagnostic of the first token it cannot read. The authored parser reads it;
// no native service is involved.
pub Parse :: (text: string) -> parser.Tree {
    return parser.Parse(text);
}
