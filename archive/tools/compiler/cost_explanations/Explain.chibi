package cost_explanations

import strings "core:strings"

pub Function :: struct {
    id: u64;
    name: string;
    path: string;
    start: int;
    end: int;
    line: int;
    column: int;
    complete: bool;
}

pub Cost :: struct {
    function: int;
    kind: int;
    possible: bool;
    capability: u64;
    path: string;
    start: int;
    end: int;
    line: int;
    column: int;
    reason: string;
}

Decimal :: (value: u64) -> string {
    digits := "0123456789";
    parts: string[] = [];
    rest := value;
    while (true) {
        parts.append(strings.Slice(digits, int(rest % 10), 1));
        rest /= 10;
        if (rest == 0) {
            break;
        }
    }
    ordered: string[] = [];
    at := length(parts) - 1;
    while (at >= 0) {
        ordered.append(parts[at]);
        at -= 1;
    }
    return strings.Concatenate(ordered);
}

Quoted :: (text: string) -> string {
    parts: string[] = ["\""];
    hex := "0123456789abcdef";
    start: int = 0;
    at: int = 0;
    while (at < strings.ByteLength(text)) {
        value := strings.ByteAt(text, at);
        if (value == 34 || value == 92 || value < 32) {
            parts.append(strings.Slice(text, start, at - start));
            if (value < 32) {
                parts.append(format_text("\\u00{}{}", strings.Slice(hex, value >> 4, 1), strings.Slice(hex, value & 15, 1)));
            } else {
                parts.append("\\");
                parts.append(strings.Slice(text, at, 1));
            }
            start = at + 1;
        }
        at += 1;
    }
    parts.append(strings.Slice(text, start, at - start));
    parts.append("\"");
    return strings.Concatenate(parts);
}

Bytes :: (text: string) -> u8[] {
    out: u8[] = [];
    for (value in strings.Bytes(text)) {
        out.append(u8(value));
    }
    return out;
}

Located :: (path: string, start: int, end: int, line: int, column: int) -> bool {
    return path != "" && start >= 0 && end >= start && line > 0 && column > 0;
}

Source :: (path: string, start: int, end: int, line: int, column: int) -> string {
    if (!Located(path, start, end, line, column)) {
        return "null";
    }
    return format_text("{{\"path\":{},\"start\":{},\"end\":{},\"line\":{},\"column\":{}}", Quoted(path), start, end, line, column);
}

Location :: (path: string, start: int, end: int, line: int, column: int) -> string {
    if (!Located(path, start, end, line, column)) {
        return "source unavailable";
    }
    return format_text("{}:{}:{}", path, line, column);
}

KindSlot :: (kind: int) -> int {
    if (kind == 1) {
        return 0;
    }
    if (kind == 2) {
        return 1;
    }
    assert(kind == 4, "Unknown static cost kind");
    return 2;
}

KindName :: (kind: int) -> string {
    if (kind == 1) {
        return "allocation";
    }
    if (kind == 2) {
        return "copy";
    }
    return "escape";
}

Status :: (possible: bool) -> string {
    if (possible) {
        return "possible";
    }
    return "present";
}

JsonCost :: (cost: Cost) -> string {
    return format_text("{{\"kind\":{},\"status\":{},\"reason\":{},\"origin\":{{\"capability_id\":{},\"source\":{}}}}}",
                       Quoted(KindName(cost.kind)), Quoted(Status(cost.possible)), Quoted(cost.reason),
                       Quoted(Decimal(cost.capability)), Source(cost.path, cost.start, cost.end, cost.line, cost.column));
}

HumanCost :: (cost: Cost) -> string {
    return format_text("  {} {} at {}: {} [capability {}]\n", KindName(cost.kind), Status(cost.possible),
                       Location(cost.path, cost.start, cost.end, cost.line, cost.column), cost.reason,
                       Decimal(cost.capability));
}

JsonFunction :: (item: Function, costs: Cost[], first: int[], index: int) -> string {
    parts: string[] = [format_text("{{\"id\":{},\"name\":{},\"source\":{},\"traversal_complete\":{},\"costs\":[",
                                   Quoted(Decimal(item.id)), Quoted(item.name),
                                   Source(item.path, item.start, item.end, item.line, item.column), item.complete)];
    count: int = 0;
    slot: int = 0;
    while (slot < 6) {
        at := first[index * 6 + slot];
        if (at >= 0) {
            if (count > 0) {
                parts.append(",");
            }
            parts.append(JsonCost(costs[at]));
            count += 1;
        }
        slot += 1;
    }
    parts.append("]}");
    return strings.Concatenate(parts);
}

HumanFunction :: (item: Function, costs: Cost[], first: int[], index: int) -> string {
    completeness := "incomplete";
    if (item.complete) {
        completeness = "complete";
    }
    parts: string[] = [format_text("Entry {} [{}] at {}; traversal {}\n", item.name, Decimal(item.id),
                                   Location(item.path, item.start, item.end, item.line, item.column), completeness)];
    count: int = 0;
    slot: int = 0;
    while (slot < 6) {
        at := first[index * 6 + slot];
        if (at >= 0) {
            parts.append(HumanCost(costs[at]));
            count += 1;
        }
        slot += 1;
    }
    if (count == 0) {
        parts.append("  No allocation/copy/escape evidence recorded.\n");
    }
    return strings.Concatenate(parts);
}

// Input order selects the first evidence for each function, cost kind and certainty.
// Completeness describes traversal, never the absence of unknown native costs.
pub Report :: (functions: Function[], costs: Cost[], json: bool) -> u8[] {
    first: int[] = [];
    for (item in functions) {
        first.extend([-1, -1, -1, -1, -1, -1]);
    }
    index: int = 0;
    while (index < length(costs)) {
        cost := costs[index];
        assert(cost.function >= 0 && cost.function < length(functions), "Static cost has no function");
        slot := cost.function * 6 + KindSlot(cost.kind) * 2;
        if (cost.possible) {
            slot += 1;
        }
        if (first[slot] < 0) {
            first[slot] = index;
        }
        index += 1;
    }
    header := "Static allocation/copy report\nCoverage: finalized function bodies and linked callees. Binding, subscription, query evaluator roots and backend/activation setup are excluded.\nPresent means an operation exists in compiled code; a branch may not execute it.\nAllocation includes every dynamic storage request, including arenas and pools.\nRuntime traffic and backing allocations are unmeasured; lending causes and GC costs are unavailable.\nFirst evidence per kind and certainty. Traversal completeness covers the inspected graph only; unknown native costs remain unknown.\nNo zero-allocation guarantee.\n";
    if (json) {
        header = "{\"version\":1,\"mode\":\"static\",\"analysis_scope\":\"function_bodies_and_linked_callees\",\"excluded_roots\":[\"bindings\",\"subscriptions\",\"query_evaluators\"],\"backend_and_activation_setup\":\"unavailable\",\"present_meaning\":\"operation exists in compiled code; a branch may not execute it\",\"allocation_scope\":\"every dynamic storage request, including arenas and pools\",\"runtime_traffic\":\"unmeasured\",\"backing_allocations\":\"unmeasured\",\"lending_causes\":\"unavailable\",\"gc_costs\":\"unavailable\",\"evidence\":\"first_per_kind_and_certainty\",\"traversal_completeness\":\"inspected graph only; unknown native costs remain unknown\",\"zero_allocation_guarantee\":false,\"functions\":[";
    }
    out := Bytes(header);
    index = 0;
    while (index < length(functions)) {
        if (json) {
            if (index > 0) {
                out.extend(Bytes(","));
            }
            out.extend(Bytes(JsonFunction(functions[index], costs, first, index)));
        } else {
            out.extend(Bytes(HumanFunction(functions[index], costs, first, index)));
        }
        index += 1;
    }
    if (json) {
        out.extend(Bytes("]}\n"));
    } else if (length(functions) == 0) {
        out.extend(Bytes("No functions.\n"));
    }
    return out;
}
