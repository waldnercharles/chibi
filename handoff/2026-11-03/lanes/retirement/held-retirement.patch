-/* The native entry that runs `call` in place of a frame: one bound to its
- * callee when the call would pass its arguments directly, with nothing
- * inspecting it. A task and an inspected call keep their VM frame. */
-static const execution_native_export *native_call(
-    const behavior_function_context *root,
-    const behavior_function *function,
-    const behavior_function_context *context,
-    const behavior_function_invocation *call
-)
-{
-    const execution_natives *natives = root->activation->natives;
-    const execution_native_export *native = natives
-                                              ? execution_natives_find(natives, call->function)
-                                              : NULL;
-    return native && !behavior_function_inspection_required(function, context) &&
-                   program_call_views_allowed(context)
-             ? native
-             : NULL;
-}
-static void copy_failure(behavior_function_context *root, const behavior_function_context *source)
-{
-    if (root == source) {
-        return;
-    }
-    root->failure = source->failure;
-    root->node_id = source->node_id;
-    root->error_frame = source->error_frame;
-    root->error_source = source->error_source;
-    root->error_stack = source->error_stack;
-    root->error_pin = source->error_pin;
-    root->error_steps = source->error_steps;
-    root->error_status = source->error_status;
-    root->source_function = source->source_function;
-    if (source->error_message) {
-        size_t size = strlen(source->error_message) + 1;
-        arena *storage = root->value_storage ? root->value_storage
-                                             : &root->activation->calls->errors;
-        char *message = arena_alloc(storage, size);
-        memcpy(message, source->error_message, size);
-        root->error_message = message;
-    }
-}
-
-/* Fails `context`'s call as the VM's assert `failed` fails a frame of its
- * function: in a context bound to that function's instance, which observes
- * the failure, then hands it to the root. */
-static int native_failure(
-    struct behavior_function_calls *calls,
-    behavior_function_context *root,
-    behavior_function_context *context,
-    execution_native_assert failed
-)
-{
-    const behavior_function_instruction *i = &failed.function
-                                                  ->instructions[failed.pc];
-    behavior_function_context frame = *context;
-    frame.parent = context;
-    if (frame.bind_instance) {
-        frame.bind_instance(failed.function, &frame);
-    }
-    frame.source_function = failed.function;
-    frame.failure = (behavior_function_failure)i->target;
-    frame.error_message = i->message;
-    frame.node_id = i->node_id;
-    frame.error_frame = i->frame;
-    frame.error_source = i->source;
-    frame.error_stack = i->stack;
-    frame.error_pin = i->pin;
-    frame.error_steps = context->activation->steps;
-    if (frame.failure_observer) {
-        frame.failure_observer(failed.function, &frame, FLOW_ERR_INVALID_GRAPH);
-    }
-    if (frame.commit_instance) {
-        frame.commit_instance(&frame);
-    }
-    copy_failure(root, &frame);
-    return settle_calls(calls, FLOW_ERR_INVALID_GRAPH);
-}
