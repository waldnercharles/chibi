package facts

@error
Failure :: struct { kind: int; }

Read :: (error: Failure?) -> int {
    if (error) { return error.kind; }
    return 0;
}
Required :: (error: Failure) -> int { return error.kind; }
PassNarrowed :: (error: Failure?) -> int {
    if (error) { return Required(error); }
    return 0;
}
Maybe :: (present: bool) -> Failure? {
    if (present) { return {kind: 42}; }
    return nil;
}
Try :: () -> (value: int, error: Failure?) {
    value = 0;
    error = {kind: 42};
    return;
}

@test
OptionalParameter :: () {
    failure: Failure = {kind: 42};
    assert(Read(failure) == 42);
    assert(Read(nil) == 0);
}
@test
NarrowedArgument :: () {
    failure: Failure = {kind: 42};
    assert(PassNarrowed(failure) == 42);
    assert(PassNarrowed(nil) == 0);
}
@test
OptionalCallAndLocal :: () {
    result := Maybe(true);
    if (result) { assert(result.kind == 42); } else { assert(false); }
    empty := Maybe(false);
    assert(empty == nil);
}
@test
NamedOptionalResult :: () {
    result := Try();
    if (result.error) { assert(result.error.kind == 42); } else { assert(false); }
}
@test
ForceValues :: () {
    result := Main();
    assert(result == 0);
}
