library "WeaponActions" {
    pure function "Check Firing Interval"(Elapsed: float = 0.0, Cooldown: float = 0.0) -> (Ready: bool = false, Remainder: float = 0.0) {
        value max = max(entry.Cooldown, B: float = 0.01)
        value greater_or_equal = greater_or_equal(entry.Elapsed, max)
        value subtract = subtract(entry.Elapsed, max)
        result Ready: bool = greater_or_equal
        result Remainder: float = subtract
    }
    function "Fire Projectile"(Origin: struct<"CF_V2"> = null, Direction: struct<"CF_V2"> = null, Damage: int = 0, Prototype: name = "Projectile", Shooter: handle<"ecs.entity"> = 0) -> (Entity: handle<"ecs.entity"> = 0) {
        action spawn_prototype = engine["Spawn Prototype"](entry.Prototype)
        value getentity_gameprojectile = get_entity_game_projectile(spawn_prototype.Entity)
        value normalize_vector_2 = vec2_norm(entry.Direction)
        value multiply = multiply(normalize_vector_2.Result, getentity_gameprojectile.Value.speed)
        result Entity: handle<"ecs.entity"> = spawn_prototype.Entity
        after spawn_prototype {
            await set_entity_game_transform(spawn_prototype.Entity, entry.Origin)
            await set_entity_game_velocity(spawn_prototype.Entity, multiply)
            await set_entity_game_orientation(spawn_prototype.Entity, "DirectionMath"."Direction Orientation"(normalize_vector_2.Result.x, normalize_vector_2.Result.y))
            await set_game_projectile_damage(entry.Damage, spawn_prototype.Entity)
            await set_game_collider_ignore_entity(entry.Shooter, spawn_prototype.Entity)
            return
        }
        after entry {
            spawn_prototype()
        }
    }
}
