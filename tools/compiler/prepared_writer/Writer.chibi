package prepared_writer

import strings "core:strings"

// Prepared format v15, written exactly as execution_prepared_write encodes a
// module of authored functions. Records hold only text, int and bool fields,
// so every 64-bit payload (ids, layouts, scalar bits, union tags) is an index
// into the module's `wide` pool, whose entry 0 is zero for an absent payload.
// Nested values, table items and per-function tables are ranges of flat pools.
//
// Every table stays in Write; helpers take scalars, text and single records,
// and 64-bit fields arrive as values.

Magic: uint64 : 0x4348494249505245;
Version: int : 15;

// A value. `wide` holds scalar bits, a union tag or a struct layout; nested
// struct fields, union payloads and array items are values[first, first + count),
// after the value itself. An absent struct still records its field count.
Value :: struct {
    tag: int; container: int; type_name: string; has_type_name: bool; authored: bool;
    wide: int; text: string; has_text: bool; present: bool; first: int; count: int;
}
// Pin types the encoder distinguishes.
FlowTag: int : 0;
StructTag: int : 15;
UnionTag: int : 18;
NameTag: int : 12;
TextTag: int : 13;

Field :: struct { name: string; kind: int; }
// An authored record requirement lists its fields; others resolve by identity.
Requirement :: struct {
    id: int; layout: int; storage: int; name: string; size: int;
    authored: bool; first: int; count: int;
}
Import :: struct { id: int; fingerprint: int; }
// A function reference: own `index` in this module, or `function` (a wide id)
// in import `imported`, whose `own` the runtime writes as 0. Null references
// have neither.
Reference :: struct { imported: int; own: int; function: int; role: int; }
Source :: struct {
    graph: int; call: int; parent: int; asset: string; has_asset: bool;
    start: int; end: int; line: int; column: int;
}
Frame :: struct { source: int; depth: int; resume: int; source_index: int; stack: int; }
Root :: struct { bank: int; index: int; shape: int; }
Instruction :: struct {
    op: int; type: int; output: int; left: int; right: int; target: int;
    frame: int; source: int; stack: int; pin: int; offset: int; indirect: bool;
    component_index: int; node: int; value: int; layout: int; message: string;
    has_message: bool;
}
Local :: struct {
    kind: int; initial: int; frame: int; node: int; pin: int; offset: int;
    parameter: bool; array_default: bool; data_index: int;
}
Parameter :: struct { initial: int; frame: int; pin: int; }
ResultLayout :: struct { index: int; name: string; }
Data :: struct { kind: int; initial: int; size: int; }
Host :: struct {
    capability: int; abi: int; first: int; result_first: int; result_count: int;
    outcome_first: int; outcome_count: int;
}
Call :: struct { function: int; first: int; count: int; result_first: int; result_count: int; task: bool; }
Point :: struct {
    occurrence: int; meaning: int; start: int; end: int; line: int; column: int;
    kind: int; completion: bool;
}
Watch :: struct { origin: int; initial: int; ordinal: int; output: bool; reference: bool; }
Span :: struct { first: int; count: int; }
// Per-function tables, in spans[function.spans + table]. Kinds and slots are
// ints; defaults and roots name values; sources and stacks share `sources`.
ArgumentDefaults: int : 0;
ArgumentKinds: int : 1;
ResultDefaults: int : 2;
ResultKinds: int : 3;
VariableDefaults: int : 4;
Slots: int : 5;
SlotKinds: int : 6;
Roots: int : 7;
Instructions: int : 8;
Locals: int : 9;
Parameters: int : 10;
Frames: int : 11;
Sources: int : 12;
Stacks: int : 13;
Results: int : 14;
DataValues: int : 15;
Hosts: int : 16;
Calls: int : 17;
Definitions: int : 18;
SourcePoints: int : 19;
SourceWatches: int : 20;
Tables: int : 21;
Function :: struct {
    argument_count: int; result_count: int; variable_count: int;
    root_steps: int; child_budget: int; depth_bound: int; pure_depth_limit: int;
    breakpoints: bool; batchable: bool; managed: bool; custom_lowering: bool;
    checkpoints: bool; pin_watches: bool; watch_size: int;
    component_bindings: bool; component_access: bool; spans: int;
}
// A module function entry: no event, observer, action or captures. `body`
// and `subscription` index `references`.
Entry :: struct {
    id: int; kind: int; entry_name: string; has_entry: bool; continuation_wait: bool;
    effects: int; body: int; subscription: int;
}
Module :: union {
    Tables(id: uint64, owner_type: uint64, abi: uint64, wide: uint64[], values: Value[], ints: int[],
           requirements: Requirement[], fields: Field[], imports: Import[],
           functions: Function[], spans: Span[], roots: Root[], instructions: Instruction[],
           locals: Local[], parameters: Parameter[], frames: Frame[], sources: Source[],
           results: ResultLayout[], data: Data[], hosts: Host[], calls: Call[],
           references: Reference[], points: Point[], watches: Watch[], entries: Entry[])
}

U64 :: pure fn(value: uint64) -> byte[] {
    bytes: byte[] = [];
    rest := value;
    more := true;
    while (more) {
        low := rest & 127;
        rest = rest >> 7;
        more = rest != 0;
        if (more) { low = low | 128; }
        bytes = array_add(bytes, byte(wrap: low));
    }
    return bytes;
}
// Zigzag keeps small negative values, such as -1 for none, one byte long.
Int :: pure fn(value: int) -> byte[] {
    wide := int64(value);
    return U64(uint64(wrap: wide << 1) ^ uint64(wrap: wide >> 63));
}
Bool :: pure fn(value: bool) -> byte[] {
    if (value) { return U64(1); }
    return U64(0);
}
// Absent text is 0; otherwise its byte length plus one, then its bytes.
Text :: pure fn(value: string, present: bool) -> byte[] {
    if (!present) { return U64(0); }
    size := strings.ByteLength(value);
    bytes := U64(uint64(size + 1));
    index: int = 0;
    while (index < size) {
        bytes = array_add(bytes, byte(strings.ByteAt(value, index)));
        index += 1;
    }
    return bytes;
}
Zeros :: pure fn(count: int) -> byte[] {
    bytes: byte[] = [];
    while (length(bytes) < count) { bytes = array_add(bytes, byte(0)); }
    return bytes;
}
// A value's own bytes; its nested values follow them. `bits` is its wide entry.
ValueHead :: pure fn(v: Value, bits: uint64) -> byte[] {
    bytes := Int(v.tag);
    bytes = append(bytes, Int(v.container));
    bytes = append(bytes, Text(v.type_name, v.has_type_name));
    bytes = append(bytes, Bool(v.authored));
    if (v.container != 0) {
        bytes = append(bytes, Bool(v.present));
        if (!v.present) { return bytes; }
        return append(bytes, Int(v.count));
    }
    if (v.tag == StructTag) {
        bytes = append(bytes, U64(bits));
        bytes = append(bytes, Bool(v.present));
        return append(bytes, Int(v.count));
    }
    if (v.tag == UnionTag) {
        bytes = append(bytes, Bool(v.present));
        if (!v.present) { return bytes; }
        bytes = append(bytes, U64(bits));
        return append(bytes, Int(v.count));
    }
    if (v.tag == TextTag || v.tag == NameTag) {
        return append(bytes, Text(v.text, v.has_text));
    }
    return append(bytes, U64(bits));
}
// How many nested values follow a value's own bytes.
Nested :: pure fn(v: Value) -> int {
    aggregate := v.container != 0 || v.tag == StructTag || v.tag == UnionTag;
    if (aggregate && v.present) { return v.count; }
    return 0;
}
// A zero flow value, as an empty observer type is written.
FlowValue :: pure fn() -> byte[] {
    bytes := Int(FlowTag);
    bytes = append(bytes, Int(0));
    bytes = append(bytes, Text("", false));
    bytes = append(bytes, Bool(false));
    return append(bytes, U64(0));
}
SourceBytes :: pure fn(v: Source, graph: uint64, call: uint64) -> byte[] {
    bytes := U64(graph);
    bytes = append(bytes, U64(call));
    bytes = append(bytes, Int(v.parent));
    bytes = append(bytes, Text(v.asset, v.has_asset));
    bytes = append(bytes, Int(v.start));
    bytes = append(bytes, Int(v.end));
    bytes = append(bytes, Int(v.line));
    return append(bytes, Int(v.column));
}
ReferenceBytes :: pure fn(v: Reference, function: uint64) -> byte[] {
    bytes := Int(v.imported);
    bytes = append(bytes, Int(v.own));
    bytes = append(bytes, U64(function));
    return append(bytes, Int(v.role));
}
PointBytes :: pure fn(v: Point, occurrence: uint64, meaning: uint64) -> byte[] {
    bytes := U64(occurrence);
    bytes = append(bytes, U64(meaning));
    bytes = append(bytes, Int(v.start));
    bytes = append(bytes, Int(v.end));
    bytes = append(bytes, Int(v.line));
    bytes = append(bytes, Int(v.column));
    bytes = append(bytes, Int(v.kind));
    return append(bytes, Bool(v.completion));
}
// An instruction up to its value; the value and its layout follow.
InstructionHead :: pure fn(v: Instruction, node: uint64) -> byte[] {
    bytes := Int(v.op);
    bytes = append(bytes, Int(v.type));
    bytes = append(bytes, Int(v.output));
    bytes = append(bytes, Int(v.left));
    bytes = append(bytes, Int(v.right));
    bytes = append(bytes, Int(v.target));
    bytes = append(bytes, Int(v.frame));
    bytes = append(bytes, Int(v.source));
    bytes = append(bytes, Int(v.stack));
    bytes = append(bytes, Int(v.pin));
    bytes = append(bytes, U64(uint64(v.offset)));
    bytes = append(bytes, Bool(v.indirect));
    bytes = append(bytes, Int(v.component_index));
    return append(bytes, U64(node));
}
FunctionHead :: pure fn(v: Function) -> byte[] {
    bytes := Int(v.argument_count);
    bytes = append(bytes, Int(v.result_count));
    bytes = append(bytes, Int(v.variable_count));
    bytes = append(bytes, U64(uint64(v.root_steps)));
    bytes = append(bytes, U64(uint64(v.child_budget)));
    bytes = append(bytes, U64(uint64(v.depth_bound)));
    bytes = append(bytes, U64(uint64(v.pure_depth_limit)));
    bytes = append(bytes, Bool(v.breakpoints));
    bytes = append(bytes, Bool(v.batchable));
    bytes = append(bytes, Bool(v.managed));
    bytes = append(bytes, Bool(v.custom_lowering));
    bytes = append(bytes, Bool(v.checkpoints));
    bytes = append(bytes, Bool(v.pin_watches));
    bytes = append(bytes, U64(uint64(v.watch_size)));
    bytes = append(bytes, Bool(v.component_bindings));
    return append(bytes, Bool(v.component_access));
}
// An entry before its body and subscription references.
EntryHead :: pure fn(v: Entry, id: uint64, effects: uint64) -> byte[] {
    bytes := U64(id);
    // Event, event ABI and the observer's component, layout, field and offset.
    bytes = append(bytes, Zeros(6));
    bytes = append(bytes, FlowValue());
    bytes = append(bytes, Int(0));
    // Action, parent and outcome, then no captures.
    bytes = append(bytes, Zeros(3));
    bytes = append(bytes, Int(0));
    bytes = append(bytes, Int(0));
    bytes = append(bytes, Bool(v.continuation_wait));
    bytes = append(bytes, Int(v.kind));
    bytes = append(bytes, Text(v.entry_name, v.has_entry));
    bytes = append(bytes, Text("", false));
    return append(bytes, U64(effects));
}

// The complete inner module.
Write :: pure fn(module: Module) -> byte[] {
    switch module {
        case .Tables(id, owner_type, abi, wide, values, ints, requirements, fields, imports, functions, spans,
                     roots, instructions, locals, parameters, frames, sources, results, data,
                     hosts, calls, references, points, watches, entries):
            // Nested values follow their parent, so encoding from the last
            // value back finds every nested value already in the pool.
            pool: byte[] = [];
            starts := resize([int(0)], length(values));
            sizes := resize([int(0)], length(values));
            at := length(values) - 1;
            while (at >= 0) {
                v := values[at];
                start := length(pool);
                pool = append(pool, ValueHead(v, wide[v.wide]));
                nested: int = 0;
                count := Nested(v);
                while (nested < count) {
                    child := v.first + nested;
                    pool = append(pool, slice(pool, starts[child], sizes[child]));
                    nested += 1;
                }
                starts[at] = start;
                sizes[at] = length(pool) - start;
                at -= 1;
            }

            bytes := U64(Magic);
            bytes = append(bytes, U64(uint64(Version)));
            bytes = append(bytes, U64(8));
            bytes = append(bytes, U64(abi));
            bytes = append(bytes, U64(id));
            bytes = append(bytes, U64(owner_type));
            bytes = append(bytes, Int(length(requirements)));
            foreach (requirement in requirements) {
                bytes = append(bytes, U64(wide[requirement.id]));
                bytes = append(bytes, U64(wide[requirement.layout]));
                bytes = append(bytes, Int(requirement.storage));
                bytes = append(bytes, Text(requirement.name, true));
                bytes = append(bytes, U64(uint64(requirement.size)));
                bytes = append(bytes, Bool(requirement.authored));
                if (requirement.authored) {
                    bytes = append(bytes, Int(requirement.count));
                    index: int = 0;
                    while (index < requirement.count) {
                        field := fields[requirement.first + index];
                        bytes = append(bytes, Text(field.name, true));
                        bytes = append(bytes, Int(field.kind));
                        index += 1;
                    }
                }
            }
            bytes = append(bytes, Int(0));
            bytes = append(bytes, Int(length(imports)));
            foreach (imported in imports) {
                bytes = append(bytes, U64(wide[imported.id]));
                bytes = append(bytes, U64(wide[imported.fingerprint]));
            }

            bytes = append(bytes, Int(length(functions)));
            foreach (function in functions) {
                bytes = append(bytes, FunctionHead(function));
                table: int = 0;
                while (table < Tables) {
                    span := spans[function.spans + table];
                    bytes = append(bytes, Int(span.count));
                    index: int = 0;
                    while (index < span.count) {
                        item := span.first + index;
                        if (table == ArgumentDefaults || table == ResultDefaults ||
                            table == VariableDefaults) {
                            bytes = append(bytes, slice(pool, starts[item], sizes[item]));
                        } else if (table == ArgumentKinds || table == ResultKinds ||
                                   table == Slots || table == SlotKinds) {
                            bytes = append(bytes, Int(ints[item]));
                        } else if (table == Roots) {
                            root := roots[item];
                            bytes = append(bytes, Int(root.bank));
                            bytes = append(bytes, Int(root.index));
                            bytes = append(bytes, slice(pool, starts[root.shape], sizes[root.shape]));
                        } else if (table == Instructions) {
                            code := instructions[item];
                            bytes = append(bytes, InstructionHead(code, wide[code.node]));
                            bytes = append(bytes, slice(pool, starts[code.value], sizes[code.value]));
                            bytes = append(bytes, U64(wide[code.layout]));
                            bytes = append(bytes, Text(code.message, code.has_message));
                        } else if (table == Locals) {
                            local := locals[item];
                            bytes = append(bytes, Int(local.kind));
                            bytes = append(bytes, slice(pool, starts[local.initial], sizes[local.initial]));
                            bytes = append(bytes, Int(local.frame));
                            bytes = append(bytes, U64(wide[local.node]));
                            bytes = append(bytes, Int(local.pin));
                            bytes = append(bytes, U64(uint64(local.offset)));
                            bytes = append(bytes, Bool(local.parameter));
                            bytes = append(bytes, Bool(local.array_default));
                            bytes = append(bytes, Int(local.data_index));
                        } else if (table == Parameters) {
                            parameter := parameters[item];
                            bytes = append(bytes, slice(pool, starts[parameter.initial], sizes[parameter.initial]));
                            bytes = append(bytes, Int(parameter.frame));
                            bytes = append(bytes, Int(parameter.pin));
                        } else if (table == Frames) {
                            frame := frames[item];
                            source := sources[frame.source];
                            bytes = append(bytes, SourceBytes(source, wide[source.graph], wide[source.call]));
                            bytes = append(bytes, Int(frame.depth));
                            bytes = append(bytes, Int(frame.resume));
                            bytes = append(bytes, Int(frame.source_index));
                            bytes = append(bytes, Int(frame.stack));
                        } else if (table == Sources || table == Stacks) {
                            source := sources[item];
                            bytes = append(bytes, SourceBytes(source, wide[source.graph], wide[source.call]));
                        } else if (table == Results) {
                            bytes = append(bytes, Int(results[item].index));
                            bytes = append(bytes, Text(results[item].name, true));
                        } else if (table == DataValues) {
                            datum := data[item];
                            bytes = append(bytes, Int(datum.kind));
                            bytes = append(bytes, slice(pool, starts[datum.initial], sizes[datum.initial]));
                            bytes = append(bytes, U64(uint64(datum.size)));
                        } else if (table == Hosts) {
                            host := hosts[item];
                            bytes = append(bytes, U64(wide[host.capability]));
                            bytes = append(bytes, U64(wide[host.abi]));
                            bytes = append(bytes, Int(host.first));
                            bytes = append(bytes, Int(host.result_first));
                            bytes = append(bytes, Int(host.result_count));
                            bytes = append(bytes, Int(host.outcome_count));
                            outcome: int = 0;
                            while (outcome < host.outcome_count) {
                                bytes = append(bytes, U64(wide[host.outcome_first + outcome]));
                                outcome += 1;
                            }
                        } else if (table == Calls) {
                            call := calls[item];
                            target := references[call.function];
                            bytes = append(bytes, ReferenceBytes(target, wide[target.function]));
                            bytes = append(bytes, Int(call.first));
                            bytes = append(bytes, Int(call.count));
                            bytes = append(bytes, Int(call.result_first));
                            bytes = append(bytes, Int(call.result_count));
                            bytes = append(bytes, Bool(call.task));
                        } else if (table == Definitions) {
                            target := references[ints[item]];
                            bytes = append(bytes, ReferenceBytes(target, wide[target.function]));
                        } else if (table == SourcePoints) {
                            point := points[item];
                            bytes = append(bytes, PointBytes(point, wide[point.occurrence], wide[point.meaning]));
                        } else {
                            watch := watches[item];
                            origin := points[watch.origin];
                            bytes = append(bytes, PointBytes(origin, wide[origin.occurrence], wide[origin.meaning]));
                            bytes = append(bytes, slice(pool, starts[watch.initial], sizes[watch.initial]));
                            bytes = append(bytes, Int(watch.ordinal));
                            bytes = append(bytes, Bool(watch.output));
                            bytes = append(bytes, Bool(watch.reference));
                        }
                        index += 1;
                    }
                    // Queries, commands and their banks follow host calls; calls follow them.
                    if (table == Hosts) { bytes = append(bytes, Zeros(6)); }
                    // Components, component writes and state selections follow definitions.
                    if (table == Definitions) { bytes = append(bytes, Zeros(3)); }
                    table += 1;
                }
                // Points, watches and edges are debugger tables this module has none of.
                bytes = append(bytes, Zeros(3));
            }

            // No states.
            bytes = append(bytes, Int(0));
            bytes = append(bytes, Int(length(entries)));
            foreach (item in entries) {
                bytes = append(bytes, EntryHead(item, wide[item.id], wide[item.effects]));
                body := references[item.body];
                bytes = append(bytes, ReferenceBytes(body, wide[body.function]));
                subscription := references[item.subscription];
                bytes = append(bytes, ReferenceBytes(subscription, wide[subscription.function]));
            }
            // No queries, query -1, no query variables or filter, bindings or actions.
            bytes = append(bytes, Int(0));
            bytes = append(bytes, Int(-1));
            return append(bytes, Zeros(4));
    }
}

// FNV-1a over the module bytes, as import fingerprints use; zero becomes one.
Fingerprint :: pure fn(bytes: byte[]) -> uint64 {
    hash: uint64 = 14695981039346656037;
    foreach (item in bytes) {
        hash = (hash ^ uint64(item)) * 1099511628211;
    }
    if (hash == 0) { return 1; }
    return hash;
}

Word :: pure fn(value: uint64) -> byte[] {
    bytes: byte[] = [];
    index: int = 0;
    rest := value;
    while (index < 8) {
        bytes = array_add(bytes, byte(wrap: rest));
        rest = rest >> 8;
        index += 1;
    }
    return bytes;
}
// CHIBICLO v1: header words "CHIBICLO", version, root id and row count, then
// rows sorted bytewise by name: id, name length, module length, name, module.
// Module bytes are data[starts[i], starts[i] + lengths[i]).
Closure :: pure fn(root: uint64, ids: uint64[], names: string[], data: byte[],
                   starts: int[], lengths: int[]) -> byte[] {
    order: int[] = [];
    index: int = 0;
    while (index < length(names)) {
        at := length(order);
        order = array_add(order, index);
        while (at > 0 && strings.Compare(names[order[at - 1]], names[index]) > 0) {
            order[at] = order[at - 1];
            at -= 1;
        }
        order[at] = index;
        index += 1;
    }
    magic: byte[] = [67, 72, 73, 66, 73, 67, 76, 79];
    bytes := magic;
    bytes = append(bytes, Word(1));
    bytes = append(bytes, Word(root));
    bytes = append(bytes, Word(uint64(length(names))));
    foreach (row in order) {
        name := names[row];
        size := strings.ByteLength(name);
        bytes = append(bytes, Word(ids[row]));
        bytes = append(bytes, Word(uint64(size)));
        bytes = append(bytes, Word(uint64(lengths[row])));
        at: int = 0;
        while (at < size) {
            bytes = array_add(bytes, byte(strings.ByteAt(name, at)));
            at += 1;
        }
        bytes = append(bytes, slice(data, starts[row], lengths[row]));
    }
    return bytes;
}
