version 1
name "RenderingVisibility"
presentation "3d"
(array)entities {
    - name="View" prototype="RenderView"
    - {
        name "Visibility"
        prototype "Stage"
        components {
            GAME.GameFog {
                origin x=-200.0 y=-120.0
                columns 40
                rows 24
                cell_size 10.0
                color 0x102030ff
            }
            GAME.GameVision radius=85.0 remember=#true
            GAME.GameTransform x=-70.0
            GAME.GameEnvironment ambient_sky=0xffffffff ambient_ground=0xffffffff ambient_intensity=0.8 occlusion="Off"
        }
    }
    - {
        name "Visible"
        prototype "RenderSolid"
        components {
            GAME.GameTransform x=-70.0
            GAME.GameMaterial scene=0xffd060ff
            GAME.GameRenderState visibility_culled=#true
        }
    }
    - {
        name "OutsideSight"
        prototype "RenderSolid"
        components {
            GAME.GameTransform x=70.0
            GAME.GameMaterial scene=0x4080ffff
            GAME.GameRenderState visibility_culled=#true
        }
    }
    - {
        name "ExplicitlyHidden"
        prototype "RenderSolid"
        components {
            GAME.GameTransform x=-70.0 y=55.0
            GAME.GameMaterial scene=0xff3030ff
            GAME.GameRenderState hidden=#true
        }
    }
}
