 // Installs a target's resources into the build tree (Resources).
+// The source C facades remain native build inputs; the installed compiler
+// payload excludes only the paths shared with CMake and SDK admission.
+CopyCompilerFiles :: (from: string, to: string, relative: string, excluded: string[]) -> bool {
+    for (path in excluded) {
+        if (path != "" && path == relative) {
+            return true;
+        }
+    }
+    kind := build.file_kind(from);
+    if (kind == "file") {
+        destination := build.file_kind(to);
+        if (destination != "" && destination != "file") { return false; }
+        return CopyChanged(from, to);
+    }
+    if (kind != "directory" ||
+        (build.file_kind(to) != "" && build.file_kind(to) != "directory")) {
+        return false;
+    }
+    for (name in build.list_directory(from)) {
+        child := name;
+        if (relative != "") { child = Join([relative, "/", name]); }
+        if (!CopyCompilerFiles(Join([from, "/", name]), Join([to, "/", name]), child, excluded)) {
+            return false;
+        }
+    }
+    return true;
+}
+CopyCompilerPayload :: (from: string, build_dir: string) -> bool {
+    base := build.resolve_path(build_dir);
+    if (base == "" || build.file_kind(base) != "directory") { return false; }
+    to := base;
+    for (name in ["share", "chibi", "compiler"]) {
+        to = Join([to, "/", name]);
+        kind := build.file_kind(to);
+        if (kind != "" && kind != "directory") { return false; }
+    }
+    policy := Join([from, "/NativeBuildFiles.txt"]);
+    if (build.file_kind(policy) != "file") {
+        return false;
+    }
+    excluded := build.lines(build.read_file(policy));
+    // Do not delete through an old payload. A fresh output is required when
+    // former native-only copies remain, including linked or special entries.
+    for (relative in excluded) {
+        if (relative == "") { continue; }
+        if (build.file_kind(Join([to, "/", relative])) != "") {
+            build.report("graph: native-only compiler resources require a fresh build output");
+            return false;
+        }
+    }
+    return CopyCompilerFiles(from, to, "", excluded);
+}
