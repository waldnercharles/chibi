behavior "HudDisplay" {
    owner "ecs.entity";
    on Tick as tick(DeltaSeconds: float = 0.0) {
        player := cast<handle<"ecs.entity">>(get_global_variable(Name: "Player"))
        alive := has_component(Component: "Health", Entity: player)
        if (alive) {
            current := get_component(Component: "Health", Entity: player).Value.current
            maximum := get_component(Component: "Health", Entity: player).Value.maximum
            hull := "current / max(maximum, 1)"(current: int = current, maximum: int = maximum)
            await set_ui_value(Entity: 0, Element: "#hull .bar", Value: hull);
            await set_ui_text(Entity: 0, Element: "#hull .readout", Text: format_text(Format: "{} / {}", Arg0: int = current, Arg1: plain int = maximum));
            await set_ui_value(Entity: 0, Element: "#speed", Value: "length(vec2(velocity.x, velocity.y))"(velocity: struct<"Velocity"> = get_component(Component: "Velocity", Entity: player)));
            if (hull < 0.3) {
                set_ui_class(Entity: 0, Element: "#hull", Class: "critical", On: true);
            } else {
                set_ui_class(Entity: 0, Element: "#hull", Class: "critical", On: false);
            }
        } else {
            await set_ui_value(Entity: 0, Element: "#hull .bar", Value: 0.0);
            set_ui_text(Entity: 0, Element: "#status", Text: "Ship lost");
        }
    }
    on Repair as repair() {
        player := cast<handle<"ecs.entity">>(get_global_variable(Name: "Player"))
        alive := has_component(Component: "Health", Entity: player)
        if (alive) {
            maximum := get_component(Component: "Health", Entity: player).Value.maximum
            set_component(Component: "Health", Entity: player, Value.current: int = maximum);
        } else {
        }
    }
    "current / max(maximum, 1)" :: pure fn<T0: int, T1: int, T2: double>(current: T0 = 0, maximum: T1 = 0) -> (Result: T2 = 0.0) {
        depth_limit 64;
        return divide(A: double = convert<"To Real">(entry.current), B: double = max(A: double = convert<"To Real">(entry.maximum), B: double = real(Value: 1.0)))
    }
    "length(vec2(velocity.x, velocity.y))" :: pure fn<T0: struct<"Velocity">, T1: double>(velocity: T0 = null) -> (Result: T1 = 0.0) {
        depth_limit 64;
        return vector_length(Value: make_cf_v2(x: entry.velocity.x, y: entry.velocity.y))
    }
}
