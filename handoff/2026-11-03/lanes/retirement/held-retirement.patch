-
-    const pin_value *banks[] = { f->argument_defaults,
-                                 f->result_defaults,
-                                 f->variable_defaults,
-                                 f->command_arguments,
-                                 f->command_results };
-    int counts[] = { f->argument_count,
-                     f->result_count,
-                     f->variable_count,
-                     acount(f->command_arguments),
-                     acount(f->command_results) };
