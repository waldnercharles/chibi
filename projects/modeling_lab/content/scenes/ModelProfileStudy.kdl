version 1
name "ModelProfileStudy"
(array)entities {
    - {
        name "Camera"
        prototype "StudyCamera"
        components {
            GameCamera width=600.0 height=380.0
            GameHRC2D surface_relief=0.0 ambient=0.12
        }
    }
    - {
        name "Key"
        prototype "StudyLight"
        components {
            GameTransform x=-240.0 y=-114.0
        }
    }
    - {
        name "Fill"
        prototype "StudyLight"
        components {
            GameTransform x=240.0 y=114.0
        }
    }
    - {
        name "ProfileWing 1"
        prototype "ProfileWing"
        components {
            GameTransform x=-135.0 y=-55.0
        }
    }
    - {
        name "ProfileWingMesh 2"
        prototype "ProfileWingMesh"
        components {
            GameTransform x=-135.0 y=60.0
        }
    }
    - {
        name "ProfileBracket 3"
        prototype "ProfileBracket"
        components {
            GameTransform x=10.0 y=-50.0
        }
    }
    - {
        name "ProfileVessel 4"
        prototype "ProfileVessel"
        components {
            GameTransform x=135.0 y=-55.0
        }
    }
    - {
        name "ProfileRing 5"
        prototype "ProfileRing"
        components {
            GameTransform x=130.0 y=65.0
        }
    }
    - {
        name "ProfileWing 6"
        prototype "ProfileWing"
        components {
            GameTransform x=0.0 y=85.0
            GameVisualTransform roll=0.08 yaw=0.15 pitch=-0.12
        }
    }
}
