layout(set = 3, binding = 1) uniform shd_uniforms {
    vec2 source_texel;
    float threshold;
};

vec3 sample_bright(vec2 uv)
{
    vec3 c = texture(u_image, uv).rgb;
    if (isnan(c.r)) c.r = 0.0;
    if (isnan(c.g)) c.g = 0.0;
    if (isnan(c.b)) c.b = 0.0;
    c = clamp(c, vec3(0), vec3(65504));
    float peak = max(c.r, max(c.g, c.b));
    return threshold < 0.0 ? c : c * max(peak - threshold, 0.0) / max(peak, 0.00001);
}

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 d = source_texel * 0.5;
    vec2 uv = params.uv;
    vec3 c = sample_bright(uv + vec2(-d.x, -d.y));
    c += sample_bright(uv + vec2(d.x, -d.y));
    c += sample_bright(uv + vec2(-d.x, d.y));
    c += sample_bright(uv + d);
    return vec4(c * 0.25, 1);
}
