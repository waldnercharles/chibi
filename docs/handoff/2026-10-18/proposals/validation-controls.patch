+#!/usr/bin/env python3
+"""Synthetic mutation checks for the local verifier; never builds/runs Chibi."""
+import argparse
+from collections import Counter
+import copy
+import io
+import json
+import os
+from pathlib import Path
+import shlex
+import tempfile
+import traceback
+
+import audit_product_link as audit
+
+
+def put(path, data=b"fixture"):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(data)
+    return path
+
+
+def member(name, data):
+    header = f"{name:<16}{0:<12}{0:<6}{0:<6}{'100644':<8}{len(data):<10}`\n".encode()
+    assert len(header) == 60
+    return header + data + (b"\n" if len(data) & 1 else b"")
+
+
+class Checks:
+    def __init__(self, log):
+        self.log, self.count = log, 0
+
+    def passed(self, name, fn):
+        fn()
+        self.count += 1
+        self.log.write("PASS " + name + "\n")
+
+    def rejected(self, name, fn):
+        try:
+            fn()
+        except (audit.AuditError, ValueError, KeyError, IndexError):
+            self.count += 1
+            self.log.write("REJECTED " + name + "\n")
+            return
+        raise AssertionError("mutation was accepted: " + name)
+
+
+class FakeRunner:
+    def __init__(self, commands=""):
+        self.log, self.commands = io.StringIO(), commands
+
+    def run(self, tool, *args):
+        assert tool == "ninja"
+        return self.commands
+
+
