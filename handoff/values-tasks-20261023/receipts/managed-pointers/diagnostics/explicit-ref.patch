+            valid = !accept_migrated(sources[i], result, "Ref call", 33, &migrated[i], error, size);
+        }
+        afree(edits);
+    }
+    for (int i = 0; i < count; i++) {
+        if (syntax[i]) {
+            script_syntax_free(syntax[i]);
+        }
+        if (!valid) {
+            free(migrated[i]);
+        }
+    }
+    free(syntax);
+    afree(c.functions);
+    if (!valid) {
+        free(migrated);
+        return NULL;
+    }
+    return migrated;
