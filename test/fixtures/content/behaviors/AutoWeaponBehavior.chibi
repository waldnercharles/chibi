// Fires toward a nearby enemy on each complete cooldown interval, retaining
// unused time while preserving projectile defaults.
AutoWeaponBehavior :: behavior {
    // The last frame step, for actions and functions.
    Step: number = 0
    // Weapon
    Elapsed := 0.0
    on Tick :: (dt: number s) {
        Step = dt
        if find_nearest_entity(self.Transform, 600.0, 2, self).Found {
            await Fire_Ready_Projectiles(self.Transform, direction_to(self.Transform, find_nearest_entity(self.Transform, 600.0, 2, self).Position), self.Weapon.damage)
        }
    }
    Fire_Ready_Projectiles :: (Origin: vec2 = null, Direction: vec2 = null, Damage: int = 0) {
        Elapsed = Elapsed + Step
        while WeaponActions.Check_Firing_Interval(Elapsed, self.Weapon.cooldown).Ready {
            Elapsed = WeaponActions.Check_Firing_Interval(Elapsed, self.Weapon.cooldown).Remainder
            await WeaponActions.Fire_Projectile(Origin, Direction, Damage, Projectile, self)
        }
        return
    }
}
