package type_relations

import named "project:named_binding"

// Original catalog order and unprocessed metadata. Negative ID slots denote
// zero, as in named_binding. Nonnegative indices and spans are caller-valid.
// Flag masks and storage ordinals below mirror capabilities/catalog.h; these
// relations intentionally ignore different flag subsets in different branches.
pub Definition :: struct {
    id_slot: int;
    underlying_slot: int;
    variant_start: int;
    variant_count: int;
}
pub Variant :: struct {
    tag_slot: int;
    type: int;
    tagged: bool;
    is_literal: bool;
}
pub Environment :: union {
    Tables(types: named.Type[], ids: u64[], definitions: Definition[], variants: Variant[])
}

pub Equal :: (left: named.Value, right: named.Value) -> bool {
    switch left {
        case .Typed(a_storage, a_container, a_flags, a_nominal, a_parameter):
            switch right {
                case .Typed(b_storage, b_container, b_flags, b_nominal, b_parameter):
                    if (((a_flags | b_flags) & 64) != 0) {
                        return a_container == b_container && (a_flags & b_flags & 64) != 0 &&
                               (a_parameter == 0 || b_parameter == 0 || a_parameter == b_parameter) &&
                               (a_flags & 2) == (b_flags & 2);
                    }
                    return a_storage == b_storage && a_container == b_container && a_nominal == b_nominal &&
                           ((a_flags & 1024) == 0 || (b_flags & 1024) == 0 || a_parameter == b_parameter) &&
                           (a_flags & 10) == (b_flags & 10);
            }
    }
}
pub Numeric :: (value: named.Value) -> bool {
    switch value {
        case .Typed(storage, container, flags, nominal, parameter):
            return container == 0 && (nominal == 0 || (flags & 32) != 0) &&
                   storage >= 2 && storage <= 11 && (flags & 75) == 0;
    }
}
// Integers convert implicitly only when every value fits, and to a float
// always. f32 widens to f64; f64 narrows to f32 only explicitly, and a float
// becomes an integer only explicitly.
// Storage 2..9 alternates signed and unsigned 8, 16, 32 and 64-bit integers.
NumericImplicit :: (from: int, to: int) -> bool {
    if (to > 9) {
        return !(from == 11 && to == 10);
    }
    if (from > 9) {
        return false;
    }
    from_signed := from % 2 == 0;
    to_signed := to % 2 == 0;
    if (from_signed == to_signed) {
        return to >= from;
    }
    return !from_signed && to_signed && to > from;
}
pub Assignable :: (expected: named.Value, actual: named.Value) -> bool {
    switch expected {
        case .Typed(e_storage, e_container, expected_flags, e_nominal, e_parameter):
            switch actual {
                case .Typed(actual_storage, a_container, actual_flags, a_nominal, a_parameter):
                    e_flags := expected_flags;
                    a_flags := actual_flags;
                    a_storage := actual_storage;
                    if (((e_flags | a_flags) & 1) != 0) {
                        return true;
                    }
                    if ((e_flags & 2048) != 0) {
                        return Equal(named.Value.Typed(e_storage, e_container, e_flags & ~int(2050), e_nominal, e_parameter),
                                     named.Value.Typed(a_storage, a_container, a_flags & ~int(2050), a_nominal, a_parameter));
                    }
                    if (((e_flags | a_flags) & 16) != 0) {
                        return true;
                    }
                    e_flags = e_flags & ~int(32);
                    a_flags = a_flags & ~int(32);
                    if (((e_flags | a_flags) & 64) != 0) {
                        return e_container == a_container && (e_flags & a_flags & 64) != 0 &&
                               ((a_flags & 2) == 0 || (e_flags & 2) != 0) &&
                               (e_parameter == 0 || e_parameter == a_parameter);
                    }
                    if ((a_flags & 2) != 0 && (e_flags & 2) == 0) {
                        return false;
                    }
                    if ((e_flags & 2) != 0) {
                        e_flags = e_flags & ~int(2050);
                        a_flags = a_flags & ~int(2050);
                    }
                    if (Numeric(named.Value.Typed(e_storage, e_container, e_flags, e_nominal, e_parameter)) &&
                        Numeric(named.Value.Typed(a_storage, a_container, a_flags, a_nominal, a_parameter))) {
                        return NumericImplicit(a_storage, e_storage);
                    }
                    if ((e_storage == 12 || e_storage == 13) && (a_storage == 12 || a_storage == 13)) {
                        a_storage = e_storage;
                    }
                    e_flags = e_flags & ~int(4);
                    a_flags = a_flags & ~int(4);
                    if ((a_flags & 2) == 0) {
                        e_flags = e_flags & ~int(2);
                    }
                    return Equal(named.Value.Typed(e_storage, e_container, e_flags, e_nominal, e_parameter),
                                 named.Value.Typed(a_storage, a_container, a_flags, a_nominal, a_parameter));
            }
    }
}
FindDefinition :: (environment: Environment, id: u64) -> int {
    switch environment {
        case .Tables(types, ids, definitions, variants):
            index: int = 0;
            while (index < length(definitions)) {
                if (named.IDAt(ids, definitions[index].id_slot) == id) {
                    return index;
                }
                index += 1;
            }
            return -1;
    }
}
pub Canonical :: (environment: Environment, value: named.Value) -> named.Value {
    switch value {
        case .Typed(storage, container, flags, original_nominal, parameter):
            nominal := original_nominal;
            if (nominal == 0) {
                return value;
            }
            switch environment {
                case .Tables(types, ids, definitions, variants):
                    depth: int = 0;
                    while (depth <= length(definitions)) {
                        index := FindDefinition(environment, nominal);
                        if (index < 0) {
                            return named.Value.Typed(storage, container, flags, nominal, parameter);
                        }
                        underlying := named.IDAt(ids, definitions[index].underlying_slot);
                        if (underlying == 0) {
                            return named.Value.Typed(storage, container, flags, nominal, parameter);
                        }
                        if (depth == length(definitions)) {
                            break;
                        }
                        nominal = underlying;
                        depth += 1;
                    }
                    return named.Value.Typed(storage, container, flags | 1, nominal, parameter);
            }
    }
}
pub CatalogAssignable :: (environment: Environment, expected: named.Value, actual: named.Value) -> bool {
    switch expected {
        case .Typed(e_storage, e_container, e_flags, e_nominal, e_parameter):
            switch actual {
                case .Typed(a_storage, a_container, a_flags, a_nominal, a_parameter):
                    // Literal selection precedes even error recovery, exactly as in C.
                    if ((e_flags & 1024) != 0) {
                        return (a_flags & 1024) != 0 && e_parameter == a_parameter;
                    }
                    if ((e_flags & 256) != 0 && e_container == 0 && (a_flags & 1) == 0) {
                        if (e_nominal == a_nominal && (a_flags & 256) != 0 && e_container == a_container &&
                            ((a_flags & 2) == 0 || (e_flags & 2) != 0)) {
                            return true;
                        }
                        target := FindDefinition(environment, e_nominal);
                        source: int = -1;
                        if ((a_flags & 256) != 0 && (a_flags & 2048) == 0 && a_container == 0) {
                            source = FindDefinition(environment, a_nominal);
                        }
                        switch environment {
                            case .Tables(types, ids, definitions, variants):
                                if (source >= 0) {
                                    source_definition := definitions[source];
                                    index: int = 0;
                                    while (index < source_definition.variant_count) {
                                        found := false;
                                        if (target >= 0) {
                                            target_definition := definitions[target];
                                            member: int = 0;
                                            while (member < target_definition.variant_count) {
                                                if (named.IDAt(ids, variants[source_definition.variant_start + index].tag_slot) ==
                                                    named.IDAt(ids, variants[target_definition.variant_start + member].tag_slot)) {
                                                    found = true;
                                                }
                                                member += 1;
                                            }
                                        }
                                        if (!found) {
                                            return false;
                                        }
                                        index += 1;
                                    }
                                    return true;
                                }
                                if (target >= 0) {
                                    target_definition := definitions[target];
                                    index: int = 0;
                                    while (index < target_definition.variant_count) {
                                        member := variants[target_definition.variant_start + index];
                                        value := named.TypeAt(types, ids, member.type);
                                        if (!member.tagged && Equal(value, actual)) {
                                            switch value {
                                                case .Typed(storage, container, flags, nominal, parameter):
                                                    if (!member.is_literal || ((a_flags & 1024) != 0 && parameter == a_parameter)) {
                                                        return true;
                                                    }
                                            }
                                        }
                                        index += 1;
                                    }
                                }
                                return false;
                        }
                    }
                    return Assignable(Canonical(environment, expected), Canonical(environment, actual));
            }
    }
}
