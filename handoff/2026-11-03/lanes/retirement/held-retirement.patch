-            case NODE_COMMAND_YIELD:
-            case NODE_COMMAND_TASK_JOIN:
-            case NODE_COMMAND_TASK_CANCEL:
-            case NODE_COMMAND_TASK_RUNNING:
-            case NODE_COMMAND_TASK_CANCEL_AFTER: {
