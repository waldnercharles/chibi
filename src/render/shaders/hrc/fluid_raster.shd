// Compact density splats feed the same emission/absorption field as solids.
// Gas joins into a translucent density field. Liquid keeps a continuous surface.
// Authored exhaust uses smooth unions; combustion uses separate hot streaks.
struct Particle { vec4 position; vec4 color; vec4 optical; vec4 detail; };
layout(set = 0, binding = 0) readonly buffer Particles { Particle particles[]; };
layout(set = 0, binding = 1) readonly buffer Offsets { int offsets[]; };
layout(set = 0, binding = 2) readonly buffer Indices { int indices[]; };
layout(set = 1, binding = 0, rgba16f) uniform image2D u_scene;
layout(set = 1, binding = 1, rgba16f) uniform image2D u_emission;
layout(set = 1, binding = 2, rgba16f) uniform image2D u_absorption;
layout(set = 1, binding = 3, rgba16f) uniform image2D u_albedo;
layout(set = 1, binding = 4, rgba16f) uniform image2D u_normal;
layout(set = 1, binding = 5, rgba16f) uniform image2D u_visibility;
layout(set = 2, binding = 0) uniform Params {
    vec4 u_view;
    ivec2 u_dimensions;
    int u_tiles_x;
};
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, u_dimensions))) return;
    imageStore(u_visibility, pixel, vec4(0));
    int tile = int(gl_WorkGroupID.y) * u_tiles_x + int(gl_WorkGroupID.x);
    if (offsets[tile] == offsets[tile + 1]) return;
    vec2 world = u_view.xy + (vec2(pixel) + .5) * u_view.zw * vec2(1, -1);
    float gas = 0, liquid = 0, absorption = 0, liquid_absorption = 0;
    vec3 gas_visibility = vec3(0), liquid_visibility = vec3(0);
    float liquid_refraction = 0;
    float aa = max(u_view.z, u_view.w) * .5;
    float flame_distance = 1e20;
    vec4 flame_color = vec4(0);
    vec2 flame_optical = vec2(0);
    vec4 gas_color = vec4(0), liquid_color = vec4(0);
    vec3 emission = vec3(0);
    vec3 hot_emission = vec3(0);
    vec2 gradient = vec2(0);
    for (int i = offsets[tile]; i < offsets[tile + 1]; i++) {
        Particle p = particles[indices[i]];
        vec2 local = (world - p.position.xy) / p.position.z;
        if (p.optical.z > 0.0) {
            float d = length(world - p.position.xy) - p.position.z;
            float k = p.optical.z;
            float h = clamp(.5 + .5 * (d - flame_distance) / k, 0.0, 1.0);
            flame_distance = mix(d, flame_distance, h) - k * h * (1.0 - h);
            flame_color = mix(p.color, flame_color, h);
            flame_optical = mix(p.optical.xy, flame_optical, h);
            continue;
        }
        // Negative gas stretch marks a cold wisp. Area-preserving ellipses
        // follow velocity; the widened support connects neighboring parcels.
        bool wisp = p.position.w < .5 && p.detail.z < 0.0;
        if (wisp) {
            vec2 direction = p.detail.xy;
            local = vec2(dot(local, direction) / -p.detail.z,
                         dot(local, vec2(-direction.y, direction.x)) * -p.detail.z);
        }
        float q = max(0.0, 1.0 - dot(local, local));
        if (q <= 0.0) continue;
        float weight = q * q * q;
        if (wisp) weight /= 2.25;
        if (p.optical.w > .001) {
            vec2 offset = world - p.position.xy;
            float half_length = p.position.z * .12 * p.detail.z;
            offset -= p.detail.xy * clamp(dot(offset, p.detail.xy), -half_length, half_length);
            float radius = p.position.z * .16 * sqrt(p.optical.w);
            float core = (1.0 - smoothstep(-aa, aa, length(offset) - radius)) * p.color.a;
            // Overlapping burning samples cannot accumulate an unlimited glow.
            hot_emission = max(hot_emission, p.color.rgb * p.optical.y * core);
        } else {
            emission += p.color.rgb * p.optical.y * weight;
        }
        if (p.position.w < .5) {
            gas += weight;
            gas_color += p.color * weight;
            gas_visibility += p.color.rgb * p.detail.w * weight;
            absorption += p.optical.x * weight;
        } else {
            liquid += weight;
            liquid_color += p.color * weight;
            liquid_absorption += p.optical.x * weight;
            liquid_visibility += p.color.rgb * p.detail.w * weight;
            liquid_refraction += p.detail.z * weight;
            gradient -= 6.0 * q * q * local / p.position.z;
        }
    }
    float flame_alpha = (1.0 - smoothstep(-aa, aa, flame_distance)) * flame_color.a;
    if (gas + liquid + flame_alpha <= .00001) return;
    gas_color /= max(gas, .00001);
    liquid_color /= max(liquid, .00001);
    // A single dispersed parcel is nearly invisible; overlapping parcels stay
    // continuous. Broad support replaces the old four-lobe beaded contour.
    float gas_alpha = smoothstep(.25, 1.4, gas) *
                      (1.0 - exp(-gas * .5)) * gas_color.a;
    // Convert one screen pixel to density units using the analytic gradient.
    float density_aa = max(.0001, aa * length(gradient));
    float liquid_alpha = smoothstep(.6 - density_aa, .6 + density_aa, liquid) * liquid_color.a;
    absorption += liquid_absorption / max(liquid, .00001) * liquid_alpha;
    absorption += flame_optical.x * flame_alpha;
    emission += hot_emission + flame_color.rgb * flame_optical.y * flame_alpha;
    vec4 surface = vec4(liquid_color.rgb * liquid_alpha, liquid_alpha);
    surface += vec4(gas_color.rgb * gas_alpha, gas_alpha) * (1.0 - surface.a);
    surface += vec4(flame_color.rgb * flame_alpha, flame_alpha) * (1.0 - surface.a);

    // Gas overlaps the visible surface as a shallow volume. Preserve some
    // emissive detail for ship/projectile readability; AI never samples this.
    vec4 old_scene = imageLoad(u_scene,pixel);
    float visible = 1.0-old_scene.a;
    vec4 liquid_surface = vec4(liquid_color.rgb*liquid_alpha,liquid_alpha);
    vec4 flame_surface = vec4(flame_color.rgb * flame_alpha, flame_alpha);
    vec4 under = old_scene + (flame_surface + liquid_surface * (1.0 - flame_alpha)) * visible;
    float cover = gas_alpha*.8;
    imageStore(u_scene,pixel,vec4(under.rgb*(1.0-cover)+gas_color.rgb*gas_alpha,
                               under.a+gas_alpha*(1.0-under.a)));
    vec4 old_emission = imageLoad(u_emission,pixel);
    imageStore(u_emission,pixel,vec4(old_emission.rgb*(1.0-cover*.6)+emission,
                                   max(old_emission.a,surface.a)));
    vec4 old_albedo = imageLoad(u_albedo,pixel);
    imageStore(u_albedo,pixel,old_albedo*(1.0-cover)+surface*max(visible,cover));
    vec4 old_absorption = imageLoad(u_absorption,pixel);
    imageStore(u_absorption,pixel,old_absorption+vec4(vec3(absorption),surface.a)*max(visible,cover));
    vec3 readability = liquid_alpha * liquid_visibility / max(liquid, .00001);
    readability += gas_alpha * gas_visibility / max(gas, .00001) * (1.0 - liquid_alpha);
    // Alpha marks participating fluid for camera exposure, not radiance feedback.
    float volume = liquid_alpha + gas_alpha * (1.0 - liquid_alpha);
    imageStore(u_visibility, pixel, vec4(readability * visible, volume * visible));
    float gradient_length = length(gradient);
    if (liquid_alpha > 0.0 && visible > 0.0) {
        float inside_distance = max(0.0, liquid - .6) / max(gradient_length, .0001);
        float surface_band = 1.0 - smoothstep(aa, aa * 12.0, inside_distance);
        float confidence = liquid_alpha * surface_band * visible;
        vec4 old_normal = imageLoad(u_normal, pixel);
        vec4 surface_normal = old_normal + vec4(-gradient / max(gradient_length, .0001), 0, 1) * confidence * (1.0 - old_normal.a);
        // Planar normals need only XY. Positive Z is solid edge-light gain;
        // negative Z marks liquid and stores its coverage-weighted distortion.
        surface_normal.z = mix(old_normal.z, -max(.001, liquid_refraction / liquid) * liquid_alpha, visible);
        imageStore(u_normal, pixel, surface_normal);
    }
}
