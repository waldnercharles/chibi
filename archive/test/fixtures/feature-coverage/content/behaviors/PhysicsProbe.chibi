PhysicsProbe :: behavior {
    on Tick :: () {
        hit := raycast(self.Transform, self.Transform + vec2(200, 0), 1, self, false)
        if hit.Found {
            self.Velocity = self.Velocity * 0.5
        }
        apply_force(self, vec2(0, self.Body.mass * 10))
    }
    on ContactBegin :: () {
        touching := get_contact_entities(self, 1)
        apply_impulse(self, vec2(0, self.Body.mass * 20))
    }
    on ContactEnd :: (Other: entity) {
        left := Other
    }
}
