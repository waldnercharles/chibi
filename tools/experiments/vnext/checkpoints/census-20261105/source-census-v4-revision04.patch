+        for field, values, status in field_values:
+            for value in values:
+                fields = [MAGIC, 1, 1, 0]
+                fields[field] = value
+                with self.subTest(main_field=field, value=value):
+                    self.assert_failure(HEADER.pack(*fields), status, 0)
+
+        for length in range(1, 12):
+            with self.subTest(record_header_length=length):
+                self.assert_failure(valid_header + record()[:length], 5, 16)
