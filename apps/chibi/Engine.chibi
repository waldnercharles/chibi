package chibi_cli

// `chibi build` inside an engine checkout builds the engine through the
// authored build driver, tools/toolchain/Driver.chibi, run by the private
// build host. A checkout is the nearest ancestor holding that driver; a game
// project nearer than it keeps `chibi build` for the game.

EngineRoot :: () -> string {
    directory := files.resolve(".")
    while directory != "" {
        if files.kind(Join([directory, "/tools/toolchain/Driver.chibi"])) != 0 {
            return directory
        }
        directory = Parent(directory)
    }
    return ""
}

BuildHost :: () -> string {
    suffix := sdk.executable_suffix()
    sibling := Join([application.bin(), "/chibi-build-host", suffix])
    if files.kind(sibling) != 0 {
        return sibling
    }
    return Join([application.bin(), "/../libexec/chibi/chibi-build-host", suffix])
}

EngineBuild :: (root: string, arguments: string[]) -> int {
    host := BuildHost()
    if files.kind(host) == 0 {
        Error("build: cannot find chibi-build-host beside chibi")
        return 1
    }
    command := [
        host, "--compiler", Join([root, "/tools/compiler"]), "--compiler-core", Join([root, "/packages/core"]),
        "--root", root, "--source", Join([root, "/tools/toolchain/Driver.chibi"]),
        "--core", Join([root, "/packages/core"]), "--entry", "Main", "--timeout-ms", "86400000", "--", "build"
    ]
    return process.run(Concat(command, arguments))
}
