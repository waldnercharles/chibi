version 1
name "SdfNearPlaneBounds"
(array)entities {
    - {
        name "Camera"
        prototype "SdfOptimizationCamera"
        components {
            GameCamera width=96.0 height=80.0 focal_distance=32.0
            GameHRC2D ambient=0.5 fog=0.0
        }
    }
    - {
        name "Near clipped side box"
        prototype "SdfRoundedBox"
        components {
            GameTransform x=0.375 y=0.0
            GameVisualTransform scale=0.0038 pitch=0.0 roll=0.0
            GameGeometry3D elevation=31.0
            GameShader material="SdfCyan"
        }
    }
    - {
        name "Off-screen near-plane sphere"
        prototype "SdfSphere"
        components {
            GameTransform x=10.0 y=0.0
            GameVisualTransform scale=0.0026 pitch=0.0 roll=0.0
            GameGeometry3D elevation=31.0
            GameShader material="SdfRose"
        }
    }
    - {
        name "Ordinary perspective sphere"
        prototype "SdfSphere"
        components {
            GameTransform x=-14.0 y=7.0
            GameVisualTransform scale=0.1 pitch=0.0 roll=0.0
            GameGeometry3D elevation=16.0
            GameShader material="SdfAmber"
        }
    }
}
