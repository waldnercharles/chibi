            "src/execution/intrinsics.c", "src/execution/map_intrinsics.c", "src/execution/jit.c",
            "src/execution/jit_component.c", "src/execution/jit_host_call.c", "src/execution/jit_integer.c",
            "src/execution/jit_memory.c", "src/execution/jit_registers.c", "src/execution/jit_suspend.c",
            "src/execution/jit_system.c", "src/execution/jit_watch.c", "src/execution/log.c",
            "src/execution/machine.c", "src/execution/module.c", "src/execution/module_effects.c",
            "src/execution/opt.c", "src/execution/parallel.c", "src/execution/preparation_budget.c",
            "src/execution/prepared.c", "src/execution/prepared_function.c", "src/execution/prepared_record.c",
            "src/execution/program.c", "src/execution/program_inspection.c",
