package wasm_format

foreign {
    chibi_program_request_length :: () -> int
    chibi_program_request_copy :: (buffer: u8[], count: int) -> int
    chibi_program_budget :: () -> u64
    chibi_program_publish :: (bytes: u8[], count: int) -> int
    chibi_program_rejected :: (document: int, line: int, column: int, message: cstring) -> int
    chibi_native_scope_begin :: (steps: u64) -> int
    chibi_native_scope_end :: () -> int
}

Main :: () -> int {
    armed := chibi_native_scope_begin(chibi_program_budget());
    assert(armed == 0, "transport scope begins");
    count := chibi_program_request_length();
    data := resize([u8(0)], count);
    copied := chibi_program_request_copy(data, count);
    assert(copied == 0, "the request is copied");
    if (text_from_bytes(data) == "reject") {
        rejected := chibi_program_rejected(7, 3, 5, "rejected by the transport fixture");
        assert(rejected == 0, "the rejection is copied");
        return 1;
    }
    assert(text_from_bytes(data) == "[]", "the request bytes are exact");
    embedded := text_from_bytes([u8(97), u8(0), u8(98)]);
    text := format_text("{:016x}|{:.2f}|{}|{:>6}|{{}}|{1}", u64(18446744073709551615), f64(1.25), true, embedded);
    bytes: u8[] = [];
    for (byte in text_bytes(text)) { bytes.append(u8(byte)); }
    ended := chibi_native_scope_end();
    assert(ended == 0, "transport scope ends");
    return chibi_program_publish(bytes, length(bytes));
}
