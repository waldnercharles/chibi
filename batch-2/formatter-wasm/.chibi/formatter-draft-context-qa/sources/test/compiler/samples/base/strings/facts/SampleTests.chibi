package facts

// strings
@test
Calls :: () {
    a1_0: string = "";
    r1: string = Name(a1_0);
    e1: string = "nobody";
    assert(r1 == e1, "Name call 1");
    a2_0: string = "ada";
    r2: string = Name(a2_0);
    e2: string = "ada";
    assert(r2 == e2, "Name call 2");
    a3_0: string = "x";
    a3_1: string = "x";
    r3: bool = Same(a3_0, a3_1);
    e3: bool = true;
    assert(r3 == e3, "Same call 3");
    a4_0: string = "x";
    a4_1: string = "y";
    r4: bool = Same(a4_0, a4_1);
    e4: bool = false;
    assert(r4 == e4, "Same call 4");
    a5_0: string = "x";
    a5_1: string = "y";
    r5: bool = Differ(a5_0, a5_1);
    e5: bool = true;
    assert(r5 == e5, "Differ call 5");
    r6: string = Quoted();
    e6: string = "a\"bA";
    assert(r6 == e6, "Quoted call 6");
}
