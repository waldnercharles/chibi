+bool cf_imgui_draw_to_canvas(CF_Canvas canvas)
+{
+	ImDrawData* draw_data = ImGui::GetDrawData();
+	if (!canvas.id || draw_data->DisplaySize.x <= 0.0f || draw_data->DisplaySize.y <= 0.0f) {
+		return !canvas.id;
+	}
+	if (app->gfx_backend_type == CF_BACKEND_TYPE_GLES3) {
+		cf_gles_apply_canvas(canvas, false);
+		ImGui_ImplOpenGL3_RenderDrawData(draw_data);
+		return true;
+	}
+#ifndef CF_EMSCRIPTEN
+	SDL_GPUCommandBuffer* cmd = cf_sdlgpu_get_command_buffer();
+	ImGui_ImplSDLGPU3_PrepareDrawData(draw_data, cmd);
+	SDL_GPURenderPass* render_pass = cf_sdlgpu_begin_imgui_render_pass(canvas);
+	ImGui_ImplSDLGPU3_RenderDrawData(draw_data, cmd, render_pass);
+	cf_sdlgpu_end_imgui_render_pass();
+	return true;
+#else
+	return false;
+#endif
+}
