    if (target == "chibi_url_runtime") {
        return ["src/runtime/url.c", "src/runtime/url_definition.c"];
    }
    if (target == "chibi_host_native_catalog") {
        return ["src/host/native_catalog.c"];
    }
    if (target == "chibi_ui_documents") {
        return ["src/runtime/ui/documents.c", "src/runtime/ui/font.c"];
    }
    if (target == "chibi_fields") {
