package chibi_cli

import strings "core:strings"

Options :: struct {
    command: string
    path: string
    output: string
    web: string
    llvm: string
    target: string
    mode: string
    error: string
    path_count: int
    tail_first: int
    port: int
    valid: bool
    help: bool
    watch: bool
    native: bool
    archive: bool
    check: bool
    explain: bool
    json: bool
    serve: bool
    debug: bool
}

NewOptions :: (command: string) -> Options {
    return {command: command, path: "", output: "", web: "", llvm: "",
            target: "x86_64-unknown-linux-gnu", mode: "2", error: "", path_count: 0,
            tail_first: 0, port: 8000, valid: true, help: false, watch: false,
            native: false, archive: false, check: false, explain: false,
            json: false, serve: false, debug: false}
}

Tail :: (arguments: string[], first: int) -> string[] {
    values: string[] = []
    index := first
    while index < length(arguments) {
        values = append(values, arguments[index])
        index += 1
    }
    return values
}

Concat :: (first: string[], second: string[]) -> string[] {
    result := first
    for value in second {
        result = append(result, value)
    }
    return result
}

HelpOption :: (value: string) -> bool {
    return value == "--help" || value == "-h"
}

Option :: (value: string) -> bool {
    return strings.HasPrefix(value, "-")
}

Port :: (text: string) -> int {
    if text == "" {
        return -1
    }
    value := 0
    index := 0
    if strings.HasPrefix(text, "+") {
        index = 1
    }
    if index == strings.ByteLength(text) {
        return -1
    }
    while index < strings.ByteLength(text) {
        digit := strings.ByteAt(text, index) - 48
        if digit < 0 || digit > 9 || value > 6553 || (value == 6553 && digit > 5) {
            return -1
        }
        value = value * 10 + digit
        index += 1
    }
    return value
}

Invalid :: (options: Options, message: string) -> Options {
    result := options
    result.valid = false
    result.error = message
    return result
}

ParseRun :: (arguments: string[], first: int) -> Options {
    options := NewOptions("run")
    index := first
    if length(arguments) == index + 1 && HelpOption(arguments[index]) {
        options.help = true
        return options
    }
    if index < length(arguments) && arguments[index] == "--watch" {
        options.watch = true
        index += 1
    }
    if index < length(arguments) && arguments[index] != "--" && !Option(arguments[index]) {
        if arguments[index] == "" {
            return Invalid(options, "A program path must not be empty")
        }
        options.path = arguments[index]
        index += 1
    }
    if !options.watch && index < length(arguments) && arguments[index] == "--watch" {
        options.watch = true
        index += 1
    }
    if index < length(arguments) && arguments[index] == "--" {
        index += 1
    }
    options.tail_first = index
    return options
}

Parse :: (arguments: string[]) -> Options {
    options := NewOptions("")
    if length(arguments) < 2 {
        options.valid = false
        options.help = true
        return options
    }
    command := arguments[1]
    options.command = command
    if HelpOption(command) {
        options.help = true
        return options
    }
    if command == "run" {
        return ParseRun(arguments, 2)
    }
    if command == "--watch" {
        return ParseRun(arguments, 1)
    }
    known := command == "version" || command == "doctor" || command == "build" ||
             command == "check" || command == "test" || command == "fmt" ||
             command == "doc" || command == "web" || command == "export"
    if !known {
        options = ParseRun(arguments, 1)
        options.command = "shorthand"
        return options
    }
    if length(arguments) == 3 && HelpOption(arguments[2]) {
        options.help = true
        return options
    }
    if command == "version" {
        if length(arguments) != 2 {
            return Invalid(options, "Invalid version option; use --help.")
        }
        return options
    }
    index := 2
    if command == "build" && index < length(arguments) && arguments[index] == "--native" {
        options.native = true
        index += 1
    }
    rooted := false
    located := false
    targeted := false
    optimized := false
    ported := false
    while index < length(arguments) {
        argument := arguments[index]
        if argument == "" {
            return Invalid(options, format_text("A {} path must not be empty", command))
        }
        valued := argument == "--web" || argument == "--player" || argument == "--llvm" ||
                  argument == "--output" || argument == "--target"
        if valued && index + 1 < length(arguments) && arguments[index + 1] == "" {
            return Invalid(options, format_text("{} needs a nonempty value", argument))
        }
        if HelpOption(argument) && !(command == "build" && options.native) {
            options.help = true
            return options
        }
        if command == "fmt" {
            if argument == "--check" && !options.check {
                options.check = true
            } else if !Option(argument) {
                options.path_count += 1
            } else {
                return Invalid(options, "Invalid fmt option; use --help.")
            }
        } else if command == "check" && argument == "--explain-costs" && !options.explain {
            options.explain = true
        } else if command == "check" && argument == "--json" && !options.json {
            options.json = true
        } else if command == "doc" && argument == "--serve" && !options.serve {
            options.serve = true
        } else if (command == "doc" || command == "web") && argument == "--port" &&
                  index + 1 < length(arguments) && !ported {
            index += 1
            options.port = Port(arguments[index])
            ported = true
            if options.port < 0 {
                return Invalid(options, format_text("Invalid {} option; use --help.", command))
            }
        } else if ((command == "doctor" || command == "export") && argument == "--web" && options.web == "") ||
                  (command == "web" && argument == "--player" && options.web == "") {
            if index + 1 >= length(arguments) {
                return Invalid(options, format_text("Invalid {} option; use --help.", command))
            }
            index += 1
            options.web = arguments[index]
        } else if command == "export" && argument == "--output" && options.output == "" &&
                  index + 1 < length(arguments) {
            index += 1
            options.output = arguments[index]
        } else if command == "export" && argument == "--archive" {
            options.archive = true
        } else if command == "export" && argument == "--native" {
            options.native = true
        } else if (command == "export" || (command == "build" && options.native)) &&
                  argument == "--llvm" && index + 1 < length(arguments) && !located {
            index += 1
            options.llvm = arguments[index]
            located = true
        } else if command == "build" && options.native && argument == "--target" &&
                  index + 1 < length(arguments) && !targeted {
            index += 1
            options.target = arguments[index]
            targeted = true
        } else if command == "build" && options.native && (argument == "-O0" || argument == "-O2") && !optimized {
            options.mode = strings.Slice(argument, 2, 1)
            optimized = true
        } else if command == "build" && options.native && argument == "-g" && !options.debug {
            options.debug = true
        } else if !Option(argument) && !rooted && command != "doctor" {
            options.path = argument
            rooted = true
        } else {
            return Invalid(options, format_text("Invalid {} option; use --help.", command))
        }
        index += 1
    }
    if options.json && !options.explain {
        return Invalid(options, "--json requires --explain-costs; use --help.")
    }
    if ported && command == "doc" && !options.serve {
        return Invalid(options, "--port needs --serve; use --help.")
    }
    if command == "web" && options.web == "" {
        return Invalid(options, "web needs --player PLAYER, the browser player's folder")
    }
    if command == "export" && options.output == "" {
        return Invalid(options, "Export needs --output DIR")
    }
    if command == "export" && located && !options.native {
        return Invalid(options, "export --llvm needs --native")
    }
    return options
}

@test
CommandArgumentsKeepProgramArguments :: () {
    options := Parse(["chibi", "apps/chibi", "--", "version"])
    assert(options.valid && options.command == "shorthand" && options.path == "apps/chibi")
    assert(options.tail_first == 3)
    watched := Parse(["chibi", "run", "--watch", "Hello.chibi", "--", "--watch"])
    assert(watched.watch && watched.tail_first == 5)
    trailing := Parse(["chibi", "Hello.chibi", "--watch", "one", "two"])
    assert(trailing.watch && trailing.tail_first == 3)
    empty_tail := ["chibi", "Hello.chibi", "--", ""]
    with_empty := Parse(empty_tail)
    preserved := Tail(empty_tail, with_empty.tail_first)
    assert(with_empty.valid && length(preserved) == 1 && preserved[0] == "")
    assert(Parse(["chibi", "Hello.chibi", ""]).valid)
}

@test
CommandArgumentsRejectInvalidCombinations :: () {
    assert(!Parse(["chibi", "check", "--json"]).valid)
    assert(!Parse(["chibi", "doc", "--port", "0"]).valid)
    assert(!Parse(["chibi", "web"]).valid)
    assert(!Parse(["chibi", "export", "--output", "site", "--llvm", "llvm"]).valid)
    assert(!Parse(["chibi", "fmt", "--check", "--check"]).valid)
    assert(!Parse(["chibi", "test", "first", "second"]).valid)
    assert(!Parse(["chibi", "doctor", "--unknown"]).valid)
    assert(!Parse(["chibi"]).valid)
    assert(!Parse(["chibi", "doctor", "--web", ""]).valid)
    assert(!Parse(["chibi", "export", "--output", "site", "--web", ""]).valid)
    assert(!Parse(["chibi", "web", "--player", ""]).valid)
    assert(!Parse(["chibi", "export", "--output", ""]).valid)
    assert(!Parse(["chibi", "build", "--native", "--llvm", ""]).valid)
    assert(!Parse(["chibi", "export", "--native", "--output", "game", "--llvm", ""]).valid)
    assert(!Parse(["chibi", "build", "--native", "--target", ""]).valid)
    assert(!Parse(["chibi", "build", ""]).valid)
    assert(!Parse(["chibi", "build", "--native", ""]).valid)
    assert(!Parse(["chibi", "check", ""]).valid)
    assert(!Parse(["chibi", "fmt", ""]).valid)
    assert(!Parse(["chibi", "test", ""]).valid)
    assert(!Parse(["chibi", "doc", ""]).valid)
    assert(!Parse(["chibi", "web", "", "--player", "browser"]).valid)
    assert(!Parse(["chibi", "export", "", "--output", "site"]).valid)
    assert(!Parse(["chibi", "run", ""]).valid)
    assert(!Parse(["chibi", ""]).valid)
}

@test
CommandArgumentsSelectNativeAndExportOptions :: () {
    native := Parse(["chibi", "build", "--native", "-O0", "-g", "--target", "aarch64-apple-darwin", "--llvm", "/tools", "source"])
    assert(native.valid && native.native && native.mode == "0" && native.debug)
    assert(native.path == "source" && native.llvm == "/tools" && native.target == "aarch64-apple-darwin")
    exported := Parse(["chibi", "export", "game", "--web", "browser", "--output", "site", "--archive"])
    assert(exported.valid && exported.path == "game" && exported.web == "browser")
    assert(exported.output == "site" && exported.archive)
    checked := Parse(["chibi", "check", "game", "--json", "--explain-costs"])
    assert(checked.valid && checked.json && checked.explain)
}

@test
CommandPortsAreBounded :: () {
    assert(Port("0") == 0 && Port("65535") == 65535)
    assert(Port("") == -1 && Port("-1") == -1 && Port("65536") == -1)
    assert(Port("8000x") == -1 && Port("9999999999999999999") == -1)
}

@test
CommandArgumentsCoverProjectTools :: () {
    built := Parse(["chibi", "build", "game"])
    assert(built.valid && built.path == "game" && !built.native)
    checked := Parse(["chibi", "check", "--explain-costs", "game", "--json"])
    assert(checked.valid && checked.explain && checked.json && checked.path == "game")
    formatted := Parse(["chibi", "fmt", "first", "--check", "second"])
    assert(formatted.valid && formatted.check && formatted.path_count == 2)
    tested := Parse(["chibi", "test", "packages"])
    assert(tested.valid && tested.path == "packages")
    documented := Parse(["chibi", "doc", "--port", "0", "docs", "--serve"])
    assert(documented.valid && documented.port == 0 && documented.serve && documented.path == "docs")
    web := Parse(["chibi", "web", "game", "--player", "browser", "--port", "42"])
    assert(web.valid && web.path == "game" && web.web == "browser" && web.port == 42)
    doctor := Parse(["chibi", "doctor", "--web", "browser"])
    assert(doctor.valid && doctor.web == "browser")
}
