+#ifndef _WIN32
+static volatile sig_atomic_t watch_stopped;
+static void stop_watch(int)
+{
+    watch_stopped = 1;
+}
+#endif
+static int run_program(const char *path, bool watch)
+{
+    char *root = realpath(path, NULL);
+    if (!root) {
+        fprintf(stderr, "%s: %s\n", path, strerror(errno));
+        return 1;
+    }
+    char *core = core_collection();
+    authoring_program *program = core ? authoring_program_open(root, core) : NULL;
+    int status = program ? authoring_program_call(program) : 1;
+    if (program && watch) {
+#ifdef _WIN32
+        fprintf(stderr, "Watching standalone programs is unsupported on Windows\n");
+        status = 2;
+#else
+        watch_stopped = 0;
+        void (*interrupt)(int) = signal(SIGINT, stop_watch);
+        void (*terminate)(int) = signal(SIGTERM, stop_watch);
+        while (!watch_stopped) {
+            struct timespec delay = { .tv_nsec = 250000000 };
+            nanosleep(&delay, NULL);
+            if (watch_stopped || !authoring_program_reload(program)) {
+                continue;
+            }
+            /* A synchronous Main still uses normal interruption while busy. */
+            signal(SIGINT, interrupt);
+            signal(SIGTERM, terminate);
+            if (watch_stopped) {
+                break;
+            }
+            status = authoring_program_call(program);
+            signal(SIGINT, stop_watch);
+            signal(SIGTERM, stop_watch);
+        }
+        signal(SIGINT, interrupt);
+        signal(SIGTERM, terminate);
+        status = 0;
+#endif
+    }
+    authoring_program_free(program);
+    free(core);
+    free(root);
+    return status;
+}
