#ifndef SG_MATERIAL_PARAMETER
#define SG_MATERIAL_PARAMETER(i) u_parameters[i]
#endif
#ifndef SG_MATERIAL_CALL
#define SG_MATERIAL_CALL(id,context,values,result) sg_dispatch(id,context,values,result)
#endif
layout(location=0) out vec4 result_scene;
layout(location=1) out vec4 result_emission;
layout(location=2) out vec4 result_absorption;
layout(location=3) out vec4 result_albedo;
layout(location=4) out vec4 result_normal;
vec3 camera_point(vec3 world)
{
    if(u_camera[3].w<0.5) return world;
    vec3 target=vec3(u_camera[0].w,u_camera[1].w,u_camera[2].w);
    vec3 delta=world-target;
    return vec3(target.x+dot(delta,u_camera[0].xyz),dot(delta,u_camera[1].xyz),
        target.z+dot(delta,u_camera[2].xyz));
}
vec3 camera_vector(vec3 world)
{
    if(u_camera[3].w<0.5) return world;
    return vec3(dot(world,u_camera[0].xyz),dot(world,u_camera[1].xyz),dot(world,u_camera[2].xyz));
}
vec3 camera_world(vec3 aligned)
{
    if(u_camera[3].w<0.5) return aligned;
    vec3 target=vec3(u_camera[0].w,u_camera[1].w,u_camera[2].w);
    return target+u_camera[0].xyz*(aligned.x-target.x)+u_camera[1].xyz*aligned.y
        +u_camera[2].xyz*(aligned.z-target.z);
}
vec3 finite_rgb(vec3 value)
{
    if (isnan(value.x)||isinf(value.x)) value.x=0.0;
    if (isnan(value.y)||isinf(value.y)) value.y=0.0;
    if (isnan(value.z)||isinf(value.z)) value.z=0.0;
    return clamp(value,vec3(0),vec3(65504));
}
// UV gradients on the surface are the least-norm world covectors.
void surface_uv_frame(vec3 world, vec2 uv, out vec3 rows[2])
{
    vec3 x=dFdx(world), y=dFdy(world);
    vec2 a=dFdx(uv), b=dFdy(uv);
    float xx=dot(x,x), yy=dot(y,y), xy=dot(x,y), determinant=xx*yy-xy*xy;
    rows[0]=vec3(0); rows[1]=vec3(0);
    if(determinant>1e-20) {
        rows[0]=(x*(yy*a.x-xy*b.x)+y*(xx*b.x-xy*a.x))/determinant;
        rows[1]=(x*(yy*a.y-xy*b.y)+y*(xx*b.y-xy*a.y))/determinant;
    }
}
void surface_object_frame(out vec3 rows[3])
{
    rows[0]=SURFACE_OBJECT0; rows[1]=SURFACE_OBJECT1; rows[2]=SURFACE_OBJECT2;
}
void shade_surface_points(vec3 v_world, vec3 v_normal, vec3 object_point, vec3 part_point, vec2 uv, vec3 object_rows[3], vec3 part_rows[3], vec3 uv_rows[2], int material_id, vec4 parameters[32])
{
    // Shared flat primitives carry both windings. The perspective eye also
    // sees side faces; reject only surfaces facing away from that eye.
    vec3 eye=u_eye.w>0.5 ? u_eye.xyz-v_world : u_camera[1].xyz;
    if (dot(v_normal,eye) <= 0.0) discard;
    vec3 normal=normalize(v_normal);
    vec3 base=SURFACE_COLOR0.rgb, emission=SURFACE_COLOR1.rgb;
    vec3 albedo=SURFACE_COLOR2.rgb, absorption=SURFACE_COLOR3.rgb;
    float opacity=SURFACE_COLOR0.a, absorption_cover=SURFACE_COLOR3.a;
    float gloss=0.5, height=camera_point(v_world).y;
    bool unlit=false;
    if (material_id>0) {
        SGSample context;
        context.position=object_point.xz;
        context.uv=uv;
        context.object_position=object_point;
        context.part_position=part_point;
        for(int i=0;i<3;i++) { context.object_from_world[i]=object_rows[i]; context.part_from_world[i]=part_rows[i]; }
        for(int i=0;i<2;i++) context.uv_from_world[i]=uv_rows[i];
        context.world_position=v_world;
        context.normal=normal;
        context.view_direction=normalize(eye);
        context.time=u_surface.y;
        vec4 surface[SG_OUTPUTS];
        SG_MATERIAL_CALL(material_id,context,parameters,surface);
        base=surface[0].rgb; emission=surface[1].rgb;
        opacity=clamp(surface[5].x,0.0,1.0);
        unlit=surface[6].x>0.5;
        albedo=unlit?vec3(0):base*(1.0-clamp(surface[3].x,0.0,1.0));
        // Graph appearance preserves the entity's authored transport coefficients.
        absorption*=opacity; absorption_cover*=opacity;
        gloss=1.0-clamp(surface[2].x,0.0,1.0);
        float n2=dot(surface[4].xyz,surface[4].xyz);
        if (n2>1e-8&&!isnan(n2)&&!isinf(n2)) normal=surface[4].xyz*inversesqrt(n2);
        if (u_surface.w<4.0&&!isnan(surface[7].x)&&!isinf(surface[7].x)) height+=surface[7].x;
    }
    // This first mesh contract is opaque. Zero opacity supports cutouts.
    if (isnan(opacity)||opacity<=0.0) discard;
    vec3 aligned_normal=camera_vector(normal);
    vec2 tilt=vec2(aligned_normal.x,-aligned_normal.z);
    float t2=dot(tilt,tilt);
    if(aligned_normal.y<=0.0&&t2>1e-8) tilt*=0.999*inversesqrt(t2);
    result_scene=vec4(finite_rgb(base),1);
    result_emission=vec4(finite_rgb(emission),1);
    result_absorption=vec4(finite_rgb(absorption),clamp(absorption_cover,0.0,1.0));
    result_albedo=vec4(finite_rgb(albedo),clamp(height,-65504.0,65504.0));
    result_normal=unlit?vec4(0):vec4(tilt,u_surface.z,gloss);
}

void shade_surface(vec3 world, vec3 normal, vec3 local, vec3 object_normal, vec2 uv)
{
    if (mod(u_surface.w,4.0)<=0.5) {
        vec3 side=abs(object_normal);
        uv=side.y>=side.x&&side.y>=side.z ? local.xz+0.5
            : side.x>=side.z ? vec2(local.z+0.5,0.5-local.y)
            : vec2(local.x+0.5,0.5-local.y);
    }
    vec4 parameters[32];
    for (int i=0;i<32;i++) parameters[i]=SG_MATERIAL_PARAMETER(i);
    vec3 object_point=local*u_dimensions.xyz;
    vec3 object_rows[3], uv_rows[2];
    surface_object_frame(object_rows);
    if(mod(u_surface.w,4.0)>0.5) surface_uv_frame(world,uv,uv_rows);
    else {
        vec3 side=abs(object_normal);
        uv_rows[0]=(side.y>=side.x&&side.y>=side.z || side.x<side.z) ? object_rows[0]/u_dimensions.x : object_rows[2]/u_dimensions.z;
        uv_rows[1]=side.y>=side.x&&side.y>=side.z ? object_rows[2]/u_dimensions.z : -object_rows[1]/u_dimensions.y;
    }
    shade_surface_points(world,normal,object_point,object_point,uv,object_rows,object_rows,uv_rows,int(u_surface.x),parameters);
}
