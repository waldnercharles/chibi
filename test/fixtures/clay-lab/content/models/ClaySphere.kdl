version 3
name "ClaySphere"
domain "model"
id_counter 1000
description "Radius-18 calibration sphere in authored units."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 100
                type "Model Sphere"
                x 0.0
                y 0.0
                inputs Radius=18.0
            }
            - id=200 type="Model Output" x=300.0 y=0.0
        }
        (array)edges {
            - from="100.Geometry" to="200.Geometry"
        }
    }
}
