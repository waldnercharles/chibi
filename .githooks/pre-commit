#!/bin/sh
# Auto-format staged C/C++ sources, then re-stage the result.
# Refuses to touch files that have unstaged changes (git clang-format exits 2).
# Vendored third_party sources stay byte-identical to upstream.
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.c' '*.h' ':!third_party/*')
[ -z "$files" ] && exit 0

if ! command -v git-clang-format >/dev/null 2>&1; then
  echo "git-clang-format not found; skipping format enforcement." >&2
  exit 0
fi

git clang-format --staged -- $files
status=$?
if [ "$status" -eq 2 ]; then
  echo "clang-format failed; commit aborted." >&2
  exit 1
fi
git add -- $files
exit 0
