<div id="panel">
  <div class="kicker" id="kick-paused">Starwell</div>
  <div class="kicker" id="kick-cleared">Encounter</div>
  <div class="kicker" id="kick-defeated">Run over</div>
  <div class="title" id="paused">Paused</div>
  <div class="title" id="cleared">Encounter cleared</div>
  <div class="title" id="defeated">The Well claims you</div>
  <div id="recap" data-if="save.starwell_depth != ''">
    <div class="where">Lost in the {{ save.starwell_stratum }}</div>
    <div class="stats">
      <div class="stat"><div class="v">{{ save.starwell_depth }}<span class="u">m</span></div><div class="k">Depth</div></div>
      <div class="stat"><div class="v">{{ save.starwell_time }}</div><div class="k">Time</div></div>
      <div class="stat"><div class="v">{{ save.starwell_kills }}</div><div class="k">Kills</div></div>
      <div class="stat scrap"><div class="v"><span class="glyph"/>{{ save.starwell_scrap }}</div><div class="k">Scrap</div></div>
      <div class="stat level"><div class="v">{{ save.starwell_level }}</div><div class="k">Level</div></div>
    </div>
    <div class="seed">Seed {{ save.starwell_seed }}</div>
  </div>
  <div class="buttons">
    <use ui="MenuButton" id="resume" data-event-click="emit('Resume')">Resume<span class="key">Enter</span></use>
    <use ui="MenuButton" id="restart" data-event-click="emit('Restart')"><span class="again">Descend again</span><span class="plain">Restart</span><span class="key">R</span></use>
    <use ui="MenuButton" id="quit" data-event-click="emit('Quit')">Quit<span class="key">Q</span></use>
  </div>
</div>
