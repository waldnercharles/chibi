package native_link_tests

import link "project:native_link"
import strings "core:strings"

Plan3 :: (triple: string, libraries: string[], libpaths: string[], static: bool) -> link.Plan {
    plan: link.Plan = {triple: triple, llvm: "/llvm", objects: ["/w/a.o", "/w/b.o"], archives: ["/v/libbox3d.a"],
                       libraries: libraries, imports: [], libpaths: libpaths, output: "/w/program", work: "/w/stubs",
                       libc: "/usr/lib/x86_64-linux-gnu", interpreter: "/lib64/ld-linux-x86-64.so.2",
                       static: static, shared: false};
    return plan;
}

Plan :: (triple: string, static: bool) -> link.Plan {
    return Plan3(triple, ["m"], [], static);
}

Same :: (got: string[], expected: string[]) {
    assert(length(got) == length(expected), "the argument vector has a different length");
    for (index in 0..<length(expected)) {
        assert(got[index] == expected[index]);
    }
}

@test
TriplesNameTheirTargets :: () {
    assert(link.TargetOf("x86_64-unknown-linux-gnu") == link.LinuxX64, "linux");
    assert(link.TargetOf("arm64-apple-macosx11.0.0") == link.MacOSArm64, "macos");
    assert(link.TargetOf("aarch64-apple-darwin") == link.MacOSArm64, "macos by another name");
    assert(link.TargetOf("x86_64-pc-windows-msvc") == link.WindowsX64, "windows");
    assert(link.TargetOf("riscv64-unknown-linux-gnu") == -1, "unknown");
}

@test
EachTargetHasItsLinker :: () {
    assert(link.Linker(link.LinuxX64) == "ld.lld", "linux");
    assert(link.Linker(link.MacOSArm64) == "ld64.lld", "macos");
    assert(link.Linker(link.WindowsX64) == "lld-link", "windows");
}

@test
ObjectsAreLlcOutputPositionIndependent :: () {
    Same(link.ObjectCommand("/llvm/llc", "m.ll", "m.o", 0),
         ["/llvm/llc", "-filetype=obj", "-O=0", "-relocation-model=pic", "-o", "m.o", "m.ll"]);
    Same(link.ObjectCommand("/llvm/llc", "m.ll", "m.o", 2),
         ["/llvm/llc", "-filetype=obj", "-O=2", "-relocation-model=pic", "-o", "m.o", "m.ll"]);
}

@test
LinuxLinksLibcDynamicallyByDefault :: () {
    Same(link.Command(Plan("x86_64-unknown-linux-gnu", false), "/w/program.partial"),
         ["/llvm/ld.lld", "-flavor", "gnu", "--dynamic-linker", "/lib64/ld-linux-x86-64.so.2", "--gc-sections", "-o",
          "/w/program.partial", "/usr/lib/x86_64-linux-gnu/crt1.o", "/usr/lib/x86_64-linux-gnu/crti.o", "/w/a.o",
          "/w/b.o", "/v/libbox3d.a", "-L", "/usr/lib/x86_64-linux-gnu", "-lm", "-lc",
          "/usr/lib/x86_64-linux-gnu/crtn.o"]);
}

@test
LinuxStaticLinkTakesNoStartFilesOrLibc :: () {
    Same(link.Command(Plan("x86_64-unknown-linux-gnu", true), "/w/program.partial"),
         ["/llvm/ld.lld", "-flavor", "gnu", "-static", "--gc-sections", "-e", "_start", "-o", "/w/program.partial", "/w/a.o", "/w/b.o",
          "/v/libbox3d.a", "-lm"]);
}

@test
MacOSLinksTextStubsAndLooksUpTheRestWhenItRuns :: () {
    plan := Plan3("arm64-apple-macosx11.0.0", ["c++", "framework:Cocoa"], [], false);
    Same(link.Command(plan, "/w/program.partial"),
         ["/llvm/ld64.lld", "-flavor", "darwin", "-arch", "arm64", "-platform_version", "macos", "11.0.0", "11.0.0", "-dead_strip",
          "-undefined", "dynamic_lookup", "-e", "_main", "-o", "/w/program.partial", "/w/a.o", "/w/b.o",
          "/v/libbox3d.a", "/w/stubs/System.tbd", "/w/stubs/cpp.tbd", "/w/stubs/framework-Cocoa.tbd"]);
}

@test
StubsNameTheLibrariesTheProgramLoads :: () {
    assert(link.InstallName("c++") == "/usr/lib/libc++.1.dylib", "c++");
    assert(link.InstallName("z") == "/usr/lib/libz.dylib", "plain");
    assert(link.InstallName("framework:Cocoa") == "/System/Library/Frameworks/Cocoa.framework/Cocoa", "framework");
    stub := link.Stub("/usr/lib/libSystem.B.dylib", ["dyld_stub_binder", "_abs"]);
    assert(stub == "--- !tapi-tbd\ntbd-version: 4\ntargets: [ arm64-macos ]\ninstall-name: '/usr/lib/libSystem.B.dylib'\nexports:\n  - targets: [ arm64-macos ]\n    symbols: [ dyld_stub_binder, _abs ]\n...\n", "libSystem");
    assert(link.StubPath("/w", "framework:Cocoa") == "/w/framework-Cocoa.tbd", "path");
    assert(link.StubPath("/w", "c++") == "/w/cpp.tbd", "plus signs");
}

@test
WindowsLinksTheCRuntimeFromTheSdkUnlessStatic :: () {
    plan := Plan3("x86_64-pc-windows-msvc", ["user32.lib"], ["C:/sdk/lib"], false);
    Same(link.Command(plan, "/w/program.exe.partial"),
         ["/llvm/lld-link", "-flavor", "link", "/nologo", "/subsystem:console", "/machine:x64", "/opt:ref", "/Brepro", "/stack:67108864", "/out:/w/program.exe.partial",
          "/libpath:C:/sdk/lib", "/w/a.o", "/w/b.o", "/v/libbox3d.a", "user32.lib"]);
    plan = Plan3("x86_64-pc-windows-msvc", ["user32.lib"], ["C:/sdk/lib"], true);
    Same(link.Command(plan, "/w/program.exe.partial"),
         ["/llvm/lld-link", "-flavor", "link", "/nologo", "/subsystem:console", "/machine:x64", "/opt:ref", "/Brepro", "/stack:67108864", "/out:/w/program.exe.partial",
          "/nodefaultlib", "/entry:mainCRTStartup", "/libpath:C:/sdk/lib", "/w/a.o", "/w/b.o", "/v/libbox3d.a",
          "/w/stubs/kernel32.lib", "user32.lib"]);
}

@test
StartModulesKeepTheProcessArguments :: () {
    linux := link.Start("x86_64-unknown-linux-gnu", false, false);
    assert(strings.Contains(linux, "define i32 @main(i32 %argc, ptr %argv, ptr %envp)"), "libc main");
    assert(strings.Contains(linux, "store i32 %argc, ptr @chibi_argc"), "argc");
    assert(strings.Contains(linux, "store ptr %argv, ptr @chibi_argv"), "argv");
    assert(strings.Contains(linux, "call i32 @chibi_scalar()"), "entry");
    macos := link.Start("arm64-apple-macosx11.0.0", false, true);
    assert(strings.Contains(macos, "target triple = \"arm64-apple-macosx11.0.0\""), "macos triple");
    assert(strings.Contains(macos, "store i32 %argc, ptr @chibi_argc"), "macos argc");
    assert(strings.Contains(macos, "call i32 @chibi_scalar(ptr @chibi_context)"), "macos context");
    static := link.Start("x86_64-unknown-linux-gnu", true, false);
    assert(strings.Contains(static, "module asm \"_start:\""), "static entry");
    assert(strings.Contains(static, "movl %eax, chibi_argc(%rip)"), "static argc");
    assert(strings.Contains(static, "movq %rax, chibi_argv(%rip)"), "static argv");
    assert(strings.Contains(static, "movl $231, %eax"), "exit_group");
    windows := link.Start("x86_64-pc-windows-msvc", true, false);
    assert(strings.Contains(windows, "define void @mainCRTStartup()"), "windows entry");
    assert(strings.Contains(windows, "store ptr %line, ptr @chibi_command_line"), "command line");
    assert(strings.Contains(windows, "call void @ExitProcess(i32 %status)"), "exit");
    context := link.Start("x86_64-pc-windows-msvc", true, true);
    assert(strings.Contains(context, "store ptr %line, ptr @chibi_command_line"), "context command line");
    assert(strings.Contains(context, "@HeapAlloc"), "context heap");
}

@test
NoStartModuleForWhatCannotRun :: () {
    assert(link.Start("x86_64-unknown-linux-gnu", true, true) == "", "static linux has no context");
    assert(link.Start("riscv64-unknown-linux-gnu", false, false) == "", "unknown triple");
}

@test
Kernel32ExportsWhatTheStartModulesImport :: () {
    kernel32 := link.StartImports("x86_64-pc-windows-msvc");
    assert(kernel32.name == "kernel32", "kernel32");
    declared: string[] = [];
    for (context in [false, true]) {
        for (line in strings.SplitLines(link.Start("x86_64-pc-windows-msvc", true, context))) {
            at := strings.Index(line, "@");
            end := strings.Index(line, "(");
            if (strings.HasPrefix(line, "declare dllimport ") && at >= 0 && end > at) {
                name := strings.Slice(line, at + 1, end - at - 1);
                assert(kernel32.symbols.contains(name), "the list has each import");
                if (!declared.contains(name)) {
                    declared.append(name);
                }
            }
        }
    }
    assert(length(declared) == length(kernel32.symbols), "the modules import each of the list");
    assert(link.StartImports("x86_64-unknown-linux-gnu").name == "", "libc has the rest");
}

@test
StaticWindowsWritesKernel32AndEachImportLibrary :: () {
    plan := Plan3("x86_64-pc-windows-msvc", [], [], true);
    user32: link.Import = {name: "user32", symbols: ["MessageBoxA"]};
    kernel32: link.Import = {name: "kernel32", symbols: ["Sleep", "ExitProcess"]};
    plan.imports = [user32, kernel32];
    stubs := link.Imports(plan);
    assert(length(stubs) == 2 && stubs[0].name == "kernel32" && stubs[1].name == "user32", "kernel32 first");
    Same(stubs[0].symbols, ["ExitProcess", "GetCommandLineW", "GetProcessHeap", "HeapAlloc", "HeapFree", "GetStdHandle", "WriteFile",
                            "Sleep"]);
    assert(link.ImportPath(plan, "user32") == "/w/stubs/user32.def", "definition path");
    assert(link.ImportText(plan, stubs[1]) == "LIBRARY user32.dll\nEXPORTS\n    MessageBoxA\n", "definition");
    Same(link.ImportCommand(plan, "user32"),
         ["/llvm/lld-link", "-flavor", "link", "/lib", "/nologo", "/def:/w/stubs/user32.def", "/machine:x64",
          "/out:/w/stubs/user32.lib"]);
    Same(link.Command(plan, link.Partial(plan)),
         ["/llvm/lld-link", "-flavor", "link", "/nologo", "/subsystem:console", "/machine:x64", "/opt:ref", "/Brepro", "/stack:67108864",
          "/out:/w/stubs/a.exe", "/nodefaultlib", "/entry:mainCRTStartup", "/w/a.o", "/w/b.o", "/v/libbox3d.a",
          "/w/stubs/kernel32.lib", "/w/stubs/user32.lib"]);
}

@test
MacOSStubsExportWhatThePlanImports :: () {
    plan := Plan3("arm64-apple-macosx11.0.0", ["c++"], [], false);
    libsystem: link.Import = {name: "System", symbols: ["_abs", "dyld_stub_binder", "_abs"]};
    plan.imports = [libsystem];
    stubs := link.Imports(plan);
    assert(length(stubs) == 2 && stubs[0].name == "System" && stubs[1].name == "c++", "libSystem first");
    Same(stubs[0].symbols, ["dyld_stub_binder", "_abs"]);
    assert(link.ImportPath(plan, "System") == "/w/stubs/System.tbd", "stub path");
    assert(strings.Contains(link.ImportText(plan, stubs[0]), "symbols: [ dyld_stub_binder, _abs ]"), "stub exports");
    assert(strings.Contains(link.ImportText(plan, stubs[1]), "install-name: '/usr/lib/libc++.1.dylib'"), "c++ stub");
    assert(length(link.ImportCommand(plan, "System")) == 0, "macOS links the stub itself");
    assert(link.Partial(plan) == "/w/stubs/a.out", "the linker's output");
    assert(length(link.Imports(Plan("x86_64-unknown-linux-gnu", false))) == 0, "linux has no stubs");
}

@test
SystemImportsReadTheModulesMarkers :: () {
    found := link.SystemImports(["; chibi-library system:c", "; chibi-library system:user32",
                                 "; chibi-import system:user32 MessageBoxA", "; chibi-import system:kernel32 Sleep",
                                 "; chibi-import system:user32 MessageBoxA", "; chibi-import system:c abs",
                                 "define i32 @f()"]);
    assert(length(found) == 2 && found[0].name == "user32" && found[1].name == "kernel32", "libc is not one");
    Same(found[0].symbols, ["MessageBoxA"]);
    Same(found[1].symbols, ["Sleep"]);
    assert(link.ImportName("Message_Box.A-1@4$") && !link.ImportName("") && !link.ImportName("a b") &&
           !link.ImportName("a\nb"), "definition names");
}

@test
LinuxSharedLibrariesLinkOnlyTheObjects :: () {
    plan := Plan("x86_64-unknown-linux-gnu", false);
    plan.shared = true;
    plan.objects = ["/w/a.o"];
    Same(link.Command(plan, "/w/a.out"),
         ["/llvm/ld.lld", "-flavor", "gnu", "-shared", "--gc-sections", "-o", "/w/a.out", "/w/a.o", "/v/libbox3d.a"]);
}

@test
EveryStartModuleExportsTheArgumentFunctions :: () {
    for (triple in ["x86_64-unknown-linux-gnu", "arm64-apple-macosx11.0.0", "x86_64-pc-windows-msvc"]) {
        module := link.Start(triple, false, false);
        for (name in ["define i64 @chibi_argument_count()", "define i64 @chibi_argument(i64 %index, ptr %buffer, i64 %size)",
                      "define ptr @chibi_environment()"]) {
            assert(strings.Contains(module, name), "an argument function");
        }
    }
    static := link.Start("x86_64-unknown-linux-gnu", true, false);
    assert(strings.Contains(static, "chibi_envp(%rip)"), "static linux keeps envp");
    windows := link.Start("x86_64-pc-windows-msvc", true, false);
    assert(strings.Contains(windows, "define internal i64 @chibi_command_argument("), "windows parses its command line");
    assert(strings.Contains(link.Start("arm64-apple-macosx11.0.0", false, false), "ptr %envp"), "dyld passes envp");
}

@test
SystemImportsKeepFirstAppearancesOfManyUnsortedSymbols :: () {
    lines: string[] = ["; chibi-library system:user32"];
    expected: string[] = [];
    // 37 shares no factor with 300, so these visit each of 0..<300 once, out of order.
    for (index in 0..<300) {
        name := format_text("S{}", (index * 37) % 300);
        lines.append(strings.Concatenate(["; chibi-import system:user32 ", name]));
        expected.append(name);
    }
    // Then every one again, reversed.
    for (index in 0..<300) {
        lines.append(strings.Concatenate(["; chibi-import system:user32 ", format_text("S{}", 299 - index)]));
    }
    found := link.SystemImports(lines);
    assert(length(found) == 1 && found[0].name == "user32", "one library");
    Same(found[0].symbols, expected);
}

@test
ContextStartModulesFormatTextThemselves :: () {
    for (triple in ["x86_64-unknown-linux-gnu", "arm64-apple-macosx11.0.0", "x86_64-pc-windows-msvc"]) {
        text := link.Start(triple, triple != "x86_64-unknown-linux-gnu" && !strings.HasPrefix(triple, "arm64"), true);
        if (text == "") {
            continue;
        }
        assert(strings.Contains(text, "define internal void @chibi_format_text"), "defines format_text");
        assert(strings.Contains(text, "define internal void @chibi_copy"), "copies bytes itself");
        assert(strings.Contains(text, "%is.text = icmp eq i32 %tag, 12"), "tells strings from numbers");
    }
}

@test
VendorArchivesAreBesideTheSdkShare :: () {
    assert(link.VendorDirectory("/sdk/share/chibi/core") == "/sdk/lib/chibi-vendor", "an SDK's vendor folder");
    assert(link.VendorDirectory("/src/packages/core") == "", "a source tree has none");
    assert(link.VendorArchive("vendor:freetype", "/v") == "/v/libchibi_vendor_freetype.a", "a vendor archive");
    assert(link.VendorArchive("vendor:free type", "/v") == "", "a vendor name is an identifier");
    assert(link.VendorArchive("/lib/libz.a", "/v") == "", "an absolute path is no vendor archive");
}

@test
LibraryLinesNameArchives :: () {
    names := ["vendor:freetype", "/opt/lib/libz.a", "third/libbox.a", "system:c", "system:user32", "vendor:"];
    archives := ["/v/libchibi_vendor_freetype.a", "/opt/lib/libz.a", "/game/third/libbox.a", "", "", ""];
    for (index in 0..<length(names)) {
        assert(link.Archive(names[index], "/game", "/v") == archives[index], "a library line's archive");
    }
}
