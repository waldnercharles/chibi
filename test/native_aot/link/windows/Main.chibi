package windows_objects

import host "project:native_link_host"
import c "graph:c"
import evidence "graph:evidence"
import install "graph:install"
import os "core:os"
import strings "core:strings"
import windows "core:sys/windows"

foreign import probes "system:kernel32"
foreign probes {
    SleepEx :: (milliseconds: u32, alertable: i32) -> u32
    GetProcessHandleCount :: (process: u64, count: u32[]) -> i32
    WaitForSingleObjectEx :: (handle: u64, milliseconds: u32, alertable: i32) -> u32
    SetEnvironmentVariableW :: (name: u16[], value: u16[]) -> i32
}

// Exercise the native filesystem, process API and real opt/llc commands.
// Invoke with LLVM_BIN WORK_DIR.
Main :: () -> int {
    arguments := os.Arguments();
    if length(arguments) > 0 && strings.HasPrefix(arguments[0], "child-") {
        return Child(arguments);
    }
    assert(length(arguments) == 2, "LLVM directory and work directory");
    llvm := arguments[0];
    work := arguments[1];
    Files(llvm, work);
    Environment();
    Processes(work);
    GraphCache(work);
    module := strings.Concatenate([work, "/sample.ll"]);
    object := strings.Concatenate([work, "/sample.o"]);
    bitcode := strings.Concatenate([object, ".bc"]);
    text := "target triple = \"x86_64-pc-windows-msvc\"\ndefine i32 @answer() { ret i32 71 }\n";
    written := os.WriteText(module, text);
    assert(written == nil, "write a real LLVM module");
    failure := host.Objects(llvm, [module], [object], 2, 4);
    assert(failure == nil, "opt and llc succeed");
    emitted := os.ReadBytes(object);
    assert(emitted.error == nil && length(emitted.data) > 0, "a nonempty object");
    assert(!os.Exists(bitcode), "the intermediate bitcode is removed");
    removed := os.Remove(object);
    assert(removed == nil, "remove object");
    written = os.WriteText(module, "not LLVM IR\n");
    assert(written == nil, "write rejected LLVM input");
    failure = host.Objects(llvm, [module], [object], 2, 4);
    assert(failure != nil, "invalid LLVM fails");
    assert(!os.Exists(object) && !os.Exists(bitcode), "no output or bitcode on rejection");
    text = "target triple = \"x86_64-pc-windows-msvc\"\ndefine i32 @answer() {\n  call void asm sideeffect \"chibi_invalid_instruction\", \"\"()\n  ret i32 71\n}\n";
    written = os.WriteText(module, text);
    assert(written == nil, "write valid IR with invalid target assembly");
    failure = host.Objects(llvm, [module], [object], 2, 4);
    assert(failure != nil, "llc failure is not success");
    assert(!os.Exists(bitcode), "failed code generation still removes bitcode");
    failure = host.Objects(strings.Concatenate([work, "/missing-llvm"]), [module], [object], 2, 4);
    assert(failure != nil, "missing tools fail");
    removed = os.Remove(module);
    assert(removed == nil, "remove module");
    os.Print("PASS native object pipeline");
    return 0;
}

Child :: (arguments: string[]) -> int {
    mode := arguments[0];
    if mode == "child-exit7" {
        return 7;
    }
    if mode == "child-exit5" {
        return 5;
    }
    if mode == "child-cache" {
        source := os.ReadText(arguments[2]);
        assert(source.error == nil, "read the graph step's input");
        written := os.WriteText(arguments[4], source.text);
        assert(written == nil, "write the graph step's output");
        return 0;
    }
    if mode == "child-arguments" {
        assert(length(arguments) == 6 && arguments[1] == "" && arguments[2] == "a b" &&
               arguments[3] == "$x;\"'" && arguments[4] == "ü\\" && arguments[5] == "trailing space ",
               "asynchronous arguments survive Windows quoting");
        return 71;
    }
    if mode == "child-output" {
        output: u8[] = [97, 0, 98];
        os.WriteOutput(text_from_bytes(output));
        os.Print("error");
        return 7;
    }
    if mode == "child-piped" {
        process := os.Start([os.ProgramPath(), "child-output"], os.Piped);
        assert(process > 0 && os.Wait(process, -1) == 7, "piped output and exit code");
        return 0;
    }
    if mode == "child-slow" {
        delayed := SleepEx(5000, 0);
        return 5;
    }
    if mode == "child-marker" {
        delayed := SleepEx(600, 0);
        written := os.WriteText(arguments[1], "late");
        assert(written == nil, "descendant writes its marker");
        return 0;
    }
    if mode == "child-tree" || mode == "child-exited-tree" {
        descendant := windows.Spawn([os.ProgramPath(), "child-marker", arguments[1]]);
        assert(descendant > 0, "start a descendant before cancellation");
        written := os.WriteText(strings.Concatenate([arguments[1], ".ready"]), "ready");
        assert(written == nil, "report that the descendant exists");
        if mode == "child-exited-tree" {
            return 9;
        }
        delayed := SleepEx(5000, 0);
        return 0;
    }
    return 2;
}

Handles :: () -> u32 {
    count: u32[] = [0];
    counted := GetProcessHandleCount(~u64(0), count);
    assert(counted != 0, "count this process's handles");
    return count[0];
}

Environment :: () {
    suffix := os.HashText(os.ProgramPath());
    name := strings.Concatenate(["CHIBI_NATIVE_ENV_", suffix]);
    insensitive := strings.Concatenate(["chibi_native_env_", suffix]);
    key: u16[] = [];
    for byte in strings.Bytes(name) { key.append(u16(byte)); }
    key.append(0);
    assert(!windows.HasEnv(name), "the private environment probe starts absent");
    empty: u16[] = [0];
    changed := SetEnvironmentVariableW(key, empty);
    assert(changed != 0 && windows.HasEnv(insensitive) && windows.Getenv(name) == "",
           "a defined empty Windows variable is present and names ignore case");
    value: u16[] = [111, 107, 0];
    changed = SetEnvironmentVariableW(key, value);
    assert(changed != 0 && windows.HasEnv(name) && windows.Getenv(name) == "ok",
           "a populated environment variable is present");
    none: u16[] = [];
    changed = SetEnvironmentVariableW(key, none);
    assert(changed != 0 && !windows.HasEnv(name), "an unset Windows variable is absent");
    os.Print("PASS native Windows environment presence");
}

Processes :: (work: string) {
    program := os.ProgramPath();
    before := Handles();
    passed := os.Start([program, "child-arguments", "", "a b", "$x;\"'", "ü\\", "trailing space "], os.Inherited);
    assert(passed > 0, "start with arguments");
    status := os.Wait(passed, -1);
    assert(status == 71, "arguments and exit status reach the child");
    status = os.Wait(passed, 0);
    assert(status == -1, "a completed handle cannot be waited twice");
    status = os.Kill(passed);
    assert(status == -1, "a completed handle cannot be killed");
    first := os.Start([program, "child-exit7"], os.Piped);
    second := os.Start([program, "child-exit5"], os.Inherited);
    assert(first > 0 && second > 0 && first != second, "two processes have independent handles");
    status = os.Wait(second, -1);
    assert(status == 5, "wait out of launch order");
    status = os.Wait(first, -1);
    assert(status == 7, "the other process keeps its own exit status");
    failed := os.Start([strings.Concatenate([work, "/missing-program.exe"])], os.Piped);
    status = os.Wait(failed, -1);
    assert(failed < 0 && status == 127, "a failed start has exit status 127");
    slow := os.Start([program, "child-slow"], os.Inherited);
    status = os.Wait(slow, 20);
    assert(slow > 0 && status == os.StillRunning, "a timed wait preserves a running process");
    status = os.Kill(slow);
    if status != -9 {
        os.Print(format_text("running process cancellation returned {}", status));
    }
    assert(status == -9, "cancel a running process");
    status = os.Wait(slow, -1);
    assert(status == -1, "cancellation consumes its handle");
    captured := os.Capture([program, "child-piped"]);
    combined: u8[] = [97, 0, 98, 101, 114, 114, 111, 114, 10];
    assert(captured.status == 0 && captured.stdout == "" && captured.stderr == text_from_bytes(combined),
           "piped output preserves NUL bytes and reports on stderr");
    marker := strings.Concatenate([work, "/process marker ü"]);
    ready := strings.Concatenate([marker, ".ready"]);
    removed := os.Remove(marker);
    assert(removed == nil, "clear the descendant marker");
    removed = os.Remove(ready);
    assert(removed == nil, "clear the readiness marker");
    tree := os.Start([program, "child-tree", marker], os.Inherited);
    assert(tree > 0, "start a process tree");
    for attempt in 0..<100 {
        if os.Exists(ready) {
            break;
        }
        delayed := SleepEx(10, 0);
    }
    assert(os.Exists(ready), "the descendant is running before cancellation");
    status = os.Kill(tree);
    assert(status == -9, "cancel the process tree");
    delayed := SleepEx(1000, 0);
    assert(!os.Exists(marker), "cancellation stops the descendant too");
    removed = os.Remove(ready);
    assert(removed == nil, "remove the readiness marker");
    tree = os.Start([program, "child-exited-tree", marker], os.Inherited);
    assert(tree > 0, "start a tree whose root exits first");
    completed := WaitForSingleObjectEx(u64(tree), 5000, 0);
    assert(completed == 0 && os.Exists(ready), "the root has exited with its descendant still running");
    status = os.Kill(tree);
    assert(status == 9, "cancellation preserves the completed root's natural exit code");
    delayed = SleepEx(1000, 0);
    assert(!os.Exists(marker), "cancellation stops descendants after their root exits");
    removed = os.Remove(ready);
    assert(removed == nil, "remove the exited root's readiness marker");
    for index in 0..<32 {
        process := os.Start([program, "child-exit7"], os.Piped);
        status = os.Wait(process, -1);
        assert(status == 7, "repeated start and reap");
    }
    assert(Handles() == before, "all process, job, thread and file handles were closed");
    os.Print("PASS native Windows asynchronous processes");
}

// Reproduce a coarse-clock collision without depending on this runner's clock:
// retain the recorded content hash, but give it the rewritten file's metadata.
// A stamp-only record consequently appears current to the old implementation.
CollideMetadata :: (record: string, path: string) {
    read := os.ReadText(record);
    assert(read.error == nil, "read the graph record");
    lines := strings.SplitLines(read.text);
    at := -1;
    for index in 0..<length(lines) {
        if lines[index] == "" {
            at = index + 1;
            break;
        }
    }
    assert(at >= 0, "the graph record has a metadata footer");
    while at + 1 < length(lines) {
        if lines[at] == path {
            fingerprint := strings.Partition(lines[at + 1], "\t");
            lines[at + 1] = os.Stamp(path);
            if fingerprint.tail != "" {
                lines[at + 1] = strings.Concatenate([lines[at + 1], "\t", fingerprint.tail]);
            }
        }
        at += 2;
    }
    written := os.WriteText(record, strings.Concatenate([strings.Join(lines, "\n"), "\n"]));
    assert(written == nil, "write a colliding metadata record");
}

GraphCache :: (work: string) {
    folder := strings.Concatenate([work, "/graph cache inputs ü"]);
    made := os.MakeDirectory(folder);
    assert(made == nil, "make the graph input directory");
    source := strings.Concatenate([folder, "/source"]);
    output := strings.Concatenate([work, "/graph cache output ü"]);
    record := strings.Concatenate([output, ".chibi-record"]);
    command := [os.ProgramPath(), "child-cache", "-c", source, "-o", output];
    written := os.WriteText(source, "before");
    assert(written == nil, "write a graph input");
    stepped := c.Step(command, [folder, source], output);
    assert(stepped == 1, "the cold graph step runs");
    stepped = c.Step(command, [folder, source], output);
    assert(stepped == 0 && evidence.ReadRecord(output) == "",
           "an unchanged graph step and its evidence are current");
    written = os.WriteText(source, "after!");
    assert(written == nil, "rewrite a graph input without changing its size");
    CollideMetadata(record, source);
    assert(strings.Contains(evidence.ReadRecord(output), "stale input/output"),
           "evidence refuses changed content even when its metadata matches");
    stepped = c.Step(command, [folder, source], output);
    assert(stepped == 1 && os.ReadText(output).text == "after!",
           "changed content rebuilds even when its metadata matches");
    assert(evidence.ReadRecord(output) == "", "the rebuilt record proves the current bytes");
    written = os.WriteText(output, "broken");
    assert(written == nil, "rewrite a graph output without changing its size");
    CollideMetadata(record, output);
    assert(strings.Contains(evidence.ReadRecord(output), "stale input/output"),
           "evidence refuses an output with changed content");
    stepped = c.Step(command, [folder, source], output);
    assert(stepped == 1 && os.ReadText(output).text == "after!",
           "a modified output is rebuilt too");
    added := strings.Concatenate([folder, "/added.chibi"]);
    written = os.WriteText(added, "new source");
    assert(written == nil, "add a graph source without changing recorded files");
    CollideMetadata(record, folder);
    assert(strings.Contains(evidence.ReadRecord(output), "stale input/output"),
           "evidence notices added sources even when directory metadata matches");
    stepped = c.Step(command, [folder, source], output);
    assert(stepped == 1, "an added source rebuilds even when directory metadata matches");
    stepped = c.Step(command, [folder, source], output);
    assert(stepped == 0, "a directory inventory can be reused");
    for path in [source, added, output, record, folder] {
        removed := os.Remove(path);
        assert(removed == nil, "remove the graph cache fixture");
    }
    os.Print("PASS native Windows graph content invalidation");
}

// The native cache uses exclusive directory reservation/publication, canonical
// paths and metadata stamps. Exercise their Windows implementations on disk.
Files :: (llvm: string, work: string) {
    folder := strings.Concatenate([work, "/os cache-ü"]);
    nested := strings.Concatenate([folder, "/parents/child"]);
    made := os.MakeDirectory(nested);
    assert(made == nil && os.IsDirectory(nested), "parent directories are made");
    made = os.MakeDirectory(nested);
    assert(made == nil, "existing directories succeed");
    removed := os.Remove(strings.Concatenate([folder, "/missing"]));
    assert(removed == nil, "removing a missing path succeeds");
    file := strings.Concatenate([folder, "/source.txt"]);
    data: u8[] = [0, 255, 128, 10, 13, 65, 0];
    written := os.WriteBytes(file, data);
    assert(written == nil, "write binary file");
    before := os.Stamp(file);
    fields := strings.Split(before, ":");
    assert(length(fields) == 6 && fields[2] == "7", "stamp identifies file and size");
    read := os.ReadBytes(file);
    hashed := os.HashFile(file);
    assert(read.error == nil && length(read.data) == 7 && read.data[1] == 255 && read.data[6] == 0, "bytes round trip");
    assert(hashed.error == nil && os.Stamp(file) == before, "reads and hashing keep a stable stamp");
    assert(os.Stamp(strings.Concatenate([folder, "/missing"])) == "", "a missing path has no stamp");
    copied := strings.Concatenate([folder, "/copied.txt"]);
    written = os.WriteText(copied, "previous output");
    assert(written == nil, "write previous output");
    failure := os.Copy(file, copied);
    assert(failure == nil && os.HashFile(copied).digest == hashed.digest, "copy replaces a complete file");
    failure = os.Copy(strings.Concatenate([folder, "/missing"]), copied);
    assert(failure != nil && os.HashFile(copied).digest == hashed.digest, "failed copy preserves prior output");
    written = os.WriteText(file, "changed");
    assert(written == nil, "same-size rewrite succeeds");
    rewritten := os.HashFile(file);
    assert(rewritten.error == nil && rewritten.digest == os.HashText("changed") && rewritten.digest != hashed.digest,
           "content hashes notice a same-size rewrite independently of timestamp resolution");
    // A filesystem's clock may give rapid same-size writes equal metadata.
    // Change size to test the stamp without sleeping or assuming a clock tick.
    written = os.WriteText(file, "changed size");
    assert(written == nil, "size-changing rewrite succeeds");
    changed_stamp := os.Stamp(file);
    changed_fields := strings.Split(changed_stamp, ":");
    assert(changed_stamp != before && length(changed_fields) == 6 && changed_fields[2] == "12",
           "a size change changes the metadata stamp");
    root := os.Root();
    canonical := os.RealPath(file);
    assert(root != "" && os.IsDirectory(root) && os.RealPath(root) == os.RealPath("."), "root is the current directory");
    assert(canonical != "" && canonical == os.RealPath(strings.Concatenate([folder, "/parents/../source.txt"])), "canonical paths resolve parent components");
    assert(os.RealPath(strings.Concatenate([folder, "/missing"])) == "", "a missing path is not canonical");
    slot := strings.Concatenate([folder, "/slot"]);
    made = os.Reserve(slot);
    assert(made == nil, "reserve a new directory");
    made = os.Reserve(slot);
    assert(made != nil, "reserve refuses an existing directory");
    made = os.Reserve(file);
    assert(made != nil, "reserve refuses an existing file");
    first := os.TemporaryDirectory(folder);
    second := os.TemporaryDirectory(folder);
    assert(first.error == nil && second.error == nil && first.path != second.path &&
           install.Parent(first.path) == os.RealPath(folder) && os.IsDirectory(second.path),
           "temporary directories are distinct and stay beside their publish destination");
    moved := strings.Concatenate([folder, "/published-temporary"]);
    failure = os.Publish(first.path, moved);
    assert(failure == nil && os.IsDirectory(moved), "private directories publish on the same filesystem");
    missing := os.TemporaryDirectory(strings.Concatenate([folder, "/missing-parent"]));
    assert(missing.error != nil && missing.path == "", "temporary directory failures are explicit");
    for path in [moved, second.path] {
        removed = os.Remove(path);
        assert(removed == nil, "remove private temporary directories");
    }
    empty := strings.Concatenate([folder, "/empty"]);
    made = os.Reserve(empty);
    assert(made == nil, "reserve an empty destination");
    failure = os.Publish(slot, empty);
    assert(failure != nil && os.IsDirectory(slot) && os.IsDirectory(empty), "publish preserves an occupied empty directory");
    failure = os.Publish(slot, file);
    assert(failure != nil && os.IsDirectory(slot) && os.ReadText(file).text == "changed size", "publish preserves an occupied file");
    published := strings.Concatenate([folder, "/published"]);
    failure = os.Publish(slot, published);
    assert(failure == nil && !os.Exists(slot) && os.IsDirectory(published), "publish moves to a vacant name");
    executable := strings.Concatenate([llvm, "/llc.exe"]);
    assert(os.FindExecutable(executable) == executable, "explicit executable path");
    assert(os.FindExecutable(strings.TrimSuffix(executable, ".exe")) == executable, "Windows executable suffix");
    assert(os.FindExecutable("cmd") != "" && os.FindExecutable("chibi-missing-program") == "", "PATH executable discovery");
    junction := strings.Concatenate([folder, "/junction"]);
    linked := os.Capture(["cmd.exe", "/d", "/c", "mklink", "/J", junction, strings.Concatenate([folder, "/parents"])]);
    assert(linked.status == 0 && os.Kind(junction) == os.KindLink, "create a directory junction");
    assert(os.RealPath(junction) == os.RealPath(strings.Concatenate([folder, "/parents"])), "canonical paths resolve junctions");
    assert(install.CanonicalPath(strings.Concatenate([junction, "/../source.txt"])) == canonical,
           "SDK canonicalization resolves a junction before its parent component");
    contained := install.CanonicalPath(strings.Concatenate([junction, "/child/missing"]));
    assert(install.Inside(contained, nested) && !install.Inside(canonical, nested),
           "SDK containment follows Windows file identities and stops at a drive root");
    removed = os.Remove(junction);
    assert(removed == nil && os.IsDirectory(nested), "removing a junction keeps its target");
    for path in [file, copied, empty, published, nested, strings.Concatenate([folder, "/parents"]), folder] {
        removed = os.Remove(path);
        assert(removed == nil, "filesystem test cleanup");
    }
    os.Print("PASS native Windows cache filesystem");
}
