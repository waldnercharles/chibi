+static compiler_host *load(const char *folder)
+{
+    compiler_bootstrap options = { .folder = folder, .compiler = compiler, .core = core };
+    api_error[0] = 0;
+    api_host = compiler_bootstrap_load(&options, api_error, sizeof api_error);
+    return api_host;
