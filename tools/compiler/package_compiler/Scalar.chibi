package package_compiler

import facts "project:scalar_facts"
import snapshot "project:source_snapshot"
import raw "project:compiler_syntax"
import parser "project:source_parser"
import binding "project:lexical_binding"
import syntax "project:syntax_diagnostics"
import routes "project:package_routes"
import graph "project:package_graph"
import json "project:json_string"
import strings "core:strings"
import tk "project:source_tokenizer"

// Opt-in internal producer of a scalar_facts module. The snapshot,
// declarations, bodies, literal ranges, bindings, scopes and callees are the
// ordinary compiler's decisions, not a second parser or evaluator. The checks
// here only reject forms the subset cannot express: every function
// takes and returns numbers, bool, or records or unions of them that the
// source declares, or has named results of numbers and bool, or one record,
// and its body is locals, assignments, to a variable or a record variable's
// field, if statements, with else and else-if, switches on an integer or a
// union variable, while loops, loops over int ranges, breaks, continues and
// returns, ending in a terminating statement as stage zero requires unless
// it has named results. Values and conditions are literals, variables,
// arithmetic and shifts, comparisons of two numbers or two bools, `&&`, `||`
// and `!`, conversions between number types, record literals, field reads,
// reads of named results, union variants, `is` tests without bindings, or
// direct calls of functions of the same source, with such operands, in any
// parentheses; a call that omits
// trailing arguments passes their literal defaults. Each operand has the type
// the ordinary compiler gives it and converts as it converts it: an integer
// beside a floating value becomes one, a float beside a double, passed for a
// double or returned as one becomes a double, and an integer returned,
// assigned or declared as a wider one widens, and so does a range bound. Loops over arrays, other
// statements, attributes and imports are excluded; functions may recurse.
//
// Each body must also pass EmitBody with no effects, no host calls or roots
// but a record's construction, copies and field writes and a union's
// construction, tests and payload reads, and no cells but theirs, moved
// records and unions and its calls' argument and result cells. Its calls go
// only to functions of the set, so the closure is pure.

ScalarOperands :: union {
    Failed(diagnostic: syntax.Diagnostic) | Built(rows: facts.Row[])
}

// Rare side data, 32 bytes per message-bearing check on 64-bit targets. The ordinary body
// checker already decoded the message; preserve it rather than parsing source
// again in a native runtime or its caller.
ScalarAssertion :: struct { start: int; end: int; message: string; }

ScalarAssertionLater :: (a: ScalarAssertion, b: ScalarAssertion) -> bool {
    return a.start > b.start || (a.start == b.start && a.end > b.end);
}
ScalarAssertionSift :: (items: ^(ScalarAssertion[]), first: int, root: int, count: int) {
    while (root < count / 2) {
        child := root * 2 + 1;
        if (child + 1 < count && ScalarAssertionLater(items^[first + child + 1], items^[first + child])) { child += 1; }
        if (!ScalarAssertionLater(items^[first + child], items^[first + root])) { break; }
        held := items^[first + root];
        items^[first + root] = items^[first + child];
        items^[first + child] = held;
        root = child;
    }
}
// Checks of an assert's operands precede the assert in execution order. Sort
// only the sparse check table by source range, in O(n log n) and no scratch.
ScalarAssertionsSorted :: (items: ^(ScalarAssertion[]), first: int, last: int) {
    count := last - first;
    if (count < 2) { return; }
    parent := (count - 2) / 2;
    while (parent >= 0) { ScalarAssertionSift(items, first, parent, count); parent -= 1; }
    end := count - 1;
    while (end > 0) {
        held := items^[first]; items^[first] = items^[first + end]; items^[first + end] = held;
        ScalarAssertionSift(items, first, 0, end);
        end -= 1;
    }
}

// The foreign function the call `node` names, declared in a foreign block of
// its own file, or -1.
ScalarForeignDeclaration :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> int {
    callee := Field(forest, node, syntax.FieldFunction);
    if (!Is(forest, callee, syntax.Identifier)) {
        return -1;
    }
    name := Text(forest, text, callee);
    root := node;
    while (forest[root].parent >= 0) {
        root = forest[root].parent;
    }
    for (block in Members(forest, root)) {
        if (!Is(forest, block, syntax.ForeignBlock)) {
            continue;
        }
        for (declaration in Members(forest, block)) {
            if (Is(forest, declaration, syntax.ForeignFunction) &&
                Text(forest, text, Field(forest, declaration, syntax.FieldName)) == name) {
                return declaration;
            }
        }
    }
    return -1;
}
// The storage a foreign function returns, 0 when it returns nothing a number
// or bool can hold.
ScalarForeignResult :: (forest: snapshot.SnapshotNode[], text: string, declaration: int) -> int {
    result := Field(forest, declaration, syntax.FieldResults);
    if (result < 0) {
        return 0;
    }
    return ForeignResultStorage(forest, text, result);
}
// The path of the library a foreign function's block imports, "" when its
// file has no such import.
ScalarForeignLibrary :: (forest: snapshot.SnapshotNode[], text: string, declaration: int) -> string {
    block := forest[declaration].parent;
    if (Field(forest, block, syntax.FieldLibrary) < 0) {
        return "";
    }
    alias := Text(forest, text, Field(forest, block, syntax.FieldLibrary));
    root := block;
    while (forest[root].parent >= 0) {
        root = forest[root].parent;
    }
    for (member in Members(forest, root)) {
        if (Is(forest, member, syntax.ForeignImportDeclaration) &&
            Text(forest, text, Field(forest, member, syntax.FieldAlias)) == alias) {
            spelled := Text(forest, text, Field(forest, member, syntax.FieldPath));
            return strings.Slice(spelled, 1, strings.ByteLength(spelled) - 2);
        }
    }
    return "";
}
// Whether the foreign block of `declaration` names a library its file imports,
// or names none and so declares symbols of the program's own objects.
ScalarForeignKnown :: (forest: snapshot.SnapshotNode[], text: string, declaration: int) -> bool {
    block := forest[declaration].parent;
    if (Field(forest, block, syntax.FieldLibrary) < 0) {
        return true;
    }
    alias := Text(forest, text, Field(forest, block, syntax.FieldLibrary));
    root := block;
    while (forest[root].parent >= 0) {
        root = forest[root].parent;
    }
    for (member in Members(forest, root)) {
        if (Is(forest, member, syntax.ForeignImportDeclaration) &&
            Text(forest, text, Field(forest, member, syntax.FieldAlias)) == alias) {
            return true;
        }
    }
    return false;
}
// The row of the address of the authored function `argument` names, for a foreign
// parameter of function type `signature`: the function's parameters and result
// are the type's, and C calls it through an adapter.
ScalarCallbackAddress :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                          callable: Callable, argument: int, signature: int, rows: facts.Row[]) -> ScalarOperands {
    node := Unparenthesized(forest, argument);
    found := -1;
    if (Is(forest, node, syntax.Identifier)) {
        found = FindCallable(callables, callable.package, Text(forest, text, node));
    }
    if (found < 0) {
        return ScalarOperands.Failed(Diagnose(forest, argument, 0, "a function value passed to C is the name of a function"));
    }
    target := callables[found];
    shape := ProcShape(forest, text, signature);
    matches := target.count == length(shape) - 1 && target.result == shape[length(shape) - 1] && target.result_container == 0;
    for (index in 0..<target.count) {
        if (index < length(shape) - 1) {
            given := params[target.first + index];
            matches = matches && given.storage == shape[index] && given.container == 0 && !given.reference;
        }
    }
    if (!matches) {
        return ScalarOperands.Failed(Diagnose(forest, argument, 0, "the function differs from the parameter's function type"));
    }
    output := rows;
    output.append(ScalarAt(forest, node, facts.FunctionAddressRow, facts.WordType, found, 0, target.name));
    return ScalarOperands.Built(output);
}
// The rows of a call of a foreign function: each argument converted to its
// parameter, then one Foreign row naming the symbol and the library.
ScalarForeignRows :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                      callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                      constants: ConstDecl[], node: int, declaration: int, rows: facts.Row[]) -> ScalarOperands {
    parameters := Members(forest, Field(forest, declaration, syntax.FieldParameters));
    arguments := Members(forest, Field(forest, node, syntax.FieldArguments));
    if (length(arguments) != length(parameters)) {
        return ScalarOperands.Failed(Diagnose(forest, node, 0, "call has the wrong number of arguments"));
    }
    result := ScalarForeignResult(forest, text, declaration);
    archive := ScalarForeignLibrary(forest, text, declaration);
    if (result == 0 || !ScalarForeignKnown(forest, text, declaration)) {
        return ScalarOperands.Failed(Diagnose(forest, declaration, 0,
                                              "scalar proof requires a foreign function with a number or bool result and an import"));
    }
    output := rows;
    for (index in 0..<length(arguments)) {
        callback := GenericCallableType(forest, Field(forest, parameters[index], syntax.FieldType));
        if (callback >= 0) {
            switch ScalarCallbackAddress(forest, text, callables, params, callable, arguments[index], callback, output) {
                case .Failed(diagnostic):
                    return ScalarOperands.Failed(diagnostic);
                case .Built(built):
                    output = built;
            }
            continue;
        }
        element := ForeignArray(forest, text, Field(forest, parameters[index], syntax.FieldType));
        if (element != 0 && !Is(forest, arguments[index], syntax.NamedArgument) && !Is(forest, arguments[index], syntax.TypedArgument)) {
            switch ScalarForeignArrayRows(forest, text, callables, params, callable, names, types, members, constants,
                                         arguments[index], element, output) {
                case .Failed(diagnostic):
                    return ScalarOperands.Failed(diagnostic);
                case .Built(built):
                    output = built;
            }
            continue;
        }
        storage := ForeignStorage(forest, text, Field(forest, parameters[index], syntax.FieldType));
        switch ScalarForeignArgument(forest, text, callables, params, callable, names, types, members, constants,
                                     arguments[index], storage, output) {
            case .Failed(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Built(built):
                output = built;
        }
    }
    row := ScalarAt(forest, node, facts.ForeignRow, ScalarTypeOf(result), 0, length(arguments),
                    Text(forest, text, Field(forest, declaration, syntax.FieldName)));
    row.text = archive;
    output.append(row);
    return ScalarOperands.Built(output);
}
// The rows of one argument of a foreign call, converted to the storage its
// parameter spells. A cstring is any string; the call copies it to a buffer
// with its NUL.
ScalarForeignArgument :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                          callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                          constants: ConstDecl[], argument: int, storage: int, rows: facts.Row[]) -> ScalarOperands {
    pointer := ScalarPointerRecord(forest, text, callables, params, names, types, members, callable.package, argument);
    array := ScalarArrayShape(forest, text, callables, params, names, types, members, callable.package, argument);
    if (pointer >= 0 || (array.container == ArrayContainer && array.storage == PointerStorage)) {
        return ScalarOperands.Failed(Diagnose(forest, argument, 0, "native managed pointers cannot be passed to foreign functions"));
    }
    if (storage == 0 || Is(forest, argument, syntax.NamedArgument) || Is(forest, argument, syntax.TypedArgument)) {
        return ScalarOperands.Failed(Diagnose(forest, argument, 0,
                                              "scalar proof passes numbers, bools and strings to a foreign function by position"));
    }
    if (storage != TextStorage) {
        return ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, argument,
                             argument, storage, storage, facts.Clamp, rows);
    }
    return ScalarOperand(forest, text, callables, params, callable, names, types, members, constants, argument,
                         TextStorage, rows);
}
// The procedure type the call `node` calls through, -1 when its callee is not a
// variable holding one.
ScalarProcCallee :: (forest: snapshot.SnapshotNode[], text: string, names: Name[], node: int) -> int {
    callee := Field(forest, node, syntax.FieldFunction);
    if (!Is(forest, callee, syntax.Identifier)) {
        return -1;
    }
    return ProcOf(forest, text, names, callee);
}
// The rows of a call through a procedure value: the address, each argument
// converted to its parameter, then one Foreign row with no symbol. Its value
// is 1, the mark of a call through the first operand.
ScalarProcRows :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                   callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                   constants: ConstDecl[], node: int, proc: int, rows: facts.Row[]) -> ScalarOperands {
    shape := ProcShape(forest, text, proc);
    arguments := Members(forest, Field(forest, node, syntax.FieldArguments));
    result := shape[length(shape) - 1];
    if (length(arguments) != length(shape) - 1) {
        return ScalarOperands.Failed(Diagnose(forest, node, 0, "call has the wrong number of arguments"));
    }
    if (result <= 0) {
        return ScalarOperands.Failed(Diagnose(forest, node, 0,
                                              "scalar proof requires a procedure with a number or bool result"));
    }
    output := rows;
    switch ScalarOperand(forest, text, callables, params, callable, names, types, members, constants,
                         Field(forest, node, syntax.FieldFunction), WordStorage, output) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output = built;
    }
    for (index in 0..<length(arguments)) {
        switch ScalarForeignArgument(forest, text, callables, params, callable, names, types, members, constants,
                                     arguments[index], shape[index], output) {
            case .Failed(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Built(built):
                output = built;
        }
    }
    output.append(ScalarAt(forest, node, facts.ForeignRow, ScalarTypeOf(result), 1, length(arguments) + 1, ""));
    return ScalarOperands.Built(output);
}
ScalarSource :: (path: string, text: string) -> facts.Row {
    return {kind: facts.SourceRow, type: 0, value: 0, count: 0, literal: 0, name: path, text: text,
            start: 0, end: 0, line: 0, column: 0};
}
// Every rejection is canonical: the source and its diagnostic, so no partial
// function or operand survives.
ScalarFailure :: (path: string, text: string, diagnostic: syntax.Diagnostic) -> facts.Row[] {
    rejection: facts.Row = {kind: facts.RejectionRow, type: 0, value: 0, count: 0, literal: 0, name: "",
                            text: diagnostic.message,
                            start: diagnostic.start, end: diagnostic.end, line: diagnostic.line,
                            column: diagnostic.column};
    return [ScalarSource(path, text), rejection];
}
// The failure of a package set: its source is the documents joined as the
// rows of an accepted set have them, and a diagnostic in another document
// than the first moves to its place in them.
ScalarFailedIn :: (path: string, documents: snapshot.Document[], diagnostic: syntax.Diagnostic) -> facts.Row[] {
    shifted := diagnostic;
    offset: int = 0;
    row: int = 0;
    for (index in 0..<length(documents)) {
        if (index == diagnostic.document) {
            shifted.start += offset;
            shifted.end += offset;
            shifted.line += row;
        }
        offset += strings.ByteLength(documents[index].text);
        row += strings.Count(documents[index].text, "\n");
        if (!strings.HasSuffix(documents[index].text, "\n")) {
            offset += 1;
            row += 1;
        }
    }
    return ScalarFailure(path, ScalarJoined(documents), shifted);
}
// ScalarFailure, or for a package set ScalarFailedIn.
ScalarFailed :: (packaged: bool, path: string, text: string, documents: snapshot.Document[],
                 diagnostic: syntax.Diagnostic) -> facts.Row[] {
    if (packaged) {
        return ScalarFailedIn(path, documents, diagnostic);
    }
    return ScalarFailure(path, text, diagnostic);
}
ScalarAt :: (forest: snapshot.SnapshotNode[], node: int, kind: int, type: int, value: int, count: int,
             name: string) -> facts.Row {
    item := forest[node];
    return {kind: kind, type: type, value: value, count: count, literal: 0, name: name, text: "",
            start: item.start, end: item.end, line: item.row + 1, column: item.column + 1};
}
// A Literal row of `type` holding `bits`, an integer's bits sign-extended when
// it is signed, or a float's or double's encoding.
ScalarLiteral :: (forest: snapshot.SnapshotNode[], node: int, type: int, bits: u64) -> facts.Row {
    row := ScalarAt(forest, node, facts.LiteralRow, type, 0, 0, "");
    row.literal = i64(wrap: bits);
    return row;
}
// The facts type of a number, bool or string storage, 0 for any other. The
// facts types are consecutive from facts.IntType in this order.
ScalarTypeOf :: (storage: int) -> int {
    // Task observers retain their own type through lowering.
    if (storage == TaskStorage) {
        return facts.TaskType;
    }
    storages := [IntStorage, BoolStorage, Int8Storage, ByteStorage, Int16Storage, Uint16Storage, UintStorage,
                 Int64Storage, WordStorage, FloatStorage, DoubleStorage, TextStorage];
    for (index in 0..<length(storages)) {
        if (storages[index] == storage) {
            return facts.IntType + index;
        }
    }
    return 0;
}
// Whether `declared` is a record or union the source declares.
ScalarDeclares :: (types: TypeDecl[], declared: TypeDecl) -> bool {
    // An optional is the union of nil and its payload; ScalarResults leaves
    // the kind only on those with a payload of this subset.
    return declared.kind == MathDecl || declared.kind == TaskResultDecl || declared.kind == OptionalDecl || ScalarNestedCollection(declared) || ((declared.kind == RecordDecl || declared.kind == UnionDecl) && declared.node >= 0);
}
// Whether `held` is the record of an optional.
ScalarOptional :: (types: TypeDecl[], held: int) -> bool {
    return held >= 0 && held < length(types) && types[held].kind == OptionalDecl;
}
// The facts type of record or union `record`: RecordType plus its place among
// the source's records and unions, or 0 for one the source does not declare.
// The count reads ScalarDeclares' fields in place: a call per earlier type was
// most of the producer's time on the VM.
ScalarRecordType :: (types: TypeDecl[], record: int) -> int {
    if (record < 0 || !ScalarDeclares(types, types[record])) {
        return 0;
    }
    ordinal: int = 0;
    for (index in 0..<record) {
        kind := types[index].kind;
        if (kind == MathDecl || kind == TaskResultDecl || kind == OptionalDecl || ScalarNestedCollection(types[index]) || ((kind == RecordDecl || kind == UnionDecl) && types[index].node >= 0)) {
            ordinal += 1;
        }
    }
    return facts.RecordType + ordinal;
}
// The facts type of a value of `storage`, `container` and `record`: a scalar,
// a record or union the source declares, or an array of numbers, bool or
// strings; 0 for any other.
ScalarValueType :: (types: TypeDecl[], storage: int, container: int, record: int) -> int {
    // The ordinary checker keeps char nominal and checks its conversions.
    // Its proven Unicode scalar uses the existing i32 ABI.
    if (CharType(types, storage, container, record)) { return facts.IntType; }
    // A task observer keeps its success identity in source metadata.
    if (storage == TaskStorage && container == 0) {
        return facts.TaskType;
    }
    if (container == MapContainer) {
        return ScalarMapType(types, record);
    }
    if (container == ArrayContainer) {
        return ScalarArrayType(types, storage, record);
    }
    if (container != 0) {
        return 0;
    }
    if (storage == PointerStorage) { return ScalarPointerType(types, record); }
    if (storage == StructStorage || storage == UnionStorage) {
        return ScalarRecordType(types, record);
    }
    if (record != -1) {
        return 0;
    }
    return ScalarTypeOf(storage);
}
ScalarParam :: (types: TypeDecl[], param: Param) -> bool {
    return ScalarValueType(types, param.storage, param.container, param.record) != 0;
}
// The source's functions, records and fields as the facts see them. A
// function with one named result returns its value, as a call of it gives
// it. One with several returns a record of them, which follows the records
// the source declares and is named for the function.
ScalarView :: union {
    Viewed(callables: Callable[], types: TypeDecl[], members: TypeMember[])
}
// Whether a return statement under `node` gives a value; a function with an
// inferred result and none has no result.
ScalarReturnsValue :: (forest: snapshot.SnapshotNode[], node: int) -> bool {
    pending: int[] = [node];
    while (length(pending) > 0) {
        at := pending[length(pending) - 1];
        pending = slice(pending, 0, length(pending) - 1);
        if (Is(forest, at, syntax.ReturnStatement) && Field(forest, at, syntax.FieldValue) >= 0) {
            return true;
        }
        child := forest[at].first_child;
        while (child >= 0) {
            pending.append(child);
            child = forest[child].next_sibling;
        }
    }
    return false;
}
// Whether `callable`, as the ordinary compiler sees it, has no result.
ScalarVoid :: (callable: Callable) -> bool {
    return callable.result == 0 && callable.result_container == 0 && callable.results == 0;
}
ScalarResults :: (callables: Callable[], params: Param[], types: TypeDecl[], members: TypeMember[],
                  body_optionals: int[]) -> ScalarView {
    seen: Callable[] = [];
    records := types;
    fields := members;
    for (callable in callables) {
        viewed := callable;
        if (callable.results == 1) {
            named := params[callable.first + callable.count];
            viewed.result = named.storage;
            viewed.result_container = named.container;
            viewed.result_record = named.record;
        } else if (callable.results > 1) {
            declared: TypeDecl = {name: format_text("{}.results", callable.name),
                                  type_name: format_text("{}.{}.results", callable.package, callable.name),
                                  package: callable.package, node: callable.node, kind: RecordDecl,
                                  first: length(fields), count: callable.results, size: 0, parent: -1, storage: 0,
                                  id: 0, layout: 0, component: 0, key: 0, value_storage: 0, value_container: 0,
                                  value_record: -1, error: false};
            for (index in 0..<callable.results) {
                named := params[callable.first + callable.count + index];
                field: TypeMember = {name: named.name, storage: named.storage, container: named.container,
                                     record: named.record, offset: 0, writable: true, c_string: false,
                                     constant: false, read: -1, read_key: "", fixed: false};
                fields.append(field);
            }
            viewed.result = StructStorage;
            viewed.result_container = 0;
            viewed.result_record = length(records);
            records.append(declared);
        }
        if (ScalarVoid(callable)) {
            // A function with no result gives int 0, which no call reads.
            viewed.result = IntStorage;
        }
        seen.append(viewed);
    }
    // Sequence typing predeclares optional types that no expression may use.
    // Emit only those held by a signature, a field or a checked body's cells.
    used := resize(body_optionals, length(records));
    for (param in params) {
        if (param.storage == UnionStorage && param.container == 0 && ScalarOptional(records, param.record)) {
            used[param.record] = 1;
        }
    }
    for (callable in seen) {
        if (callable.result == UnionStorage && callable.result_container == 0 &&
            ScalarOptional(records, callable.result_record)) {
            used[callable.result_record] = 1;
        }
    }
    for (field in fields) {
        if (field.storage == UnionStorage && field.container == 0 && ScalarOptional(records, field.record)) {
            used[field.record] = 1;
        }
    }
    for (index in 0..<length(records)) {
        declared := records[index];
        if (declared.kind == OptionalDecl &&
            (used[index] == 0 ||
             ScalarValueType(records, declared.value_storage, declared.value_container, declared.value_record) == 0)) {
            records[index].kind = ScalarExcludedDecl;
        }
    }
    // Collection constructors are interned inside out. Each immediate array
    // points to an earlier collection, and the facts record domain is <1024.
    for (index in 0..<length(records)) {
        declared := records[index];
        if (declared.kind == CollectionDecl &&
            (!ScalarNestedCollection(declared) || declared.value_storage == PointerStorage ||
             declared.value_record >= index ||
             ScalarValueType(records, declared.value_storage, declared.value_container, declared.value_record) == 0)) {
            records[index].kind = ScalarExcludedDecl;
        }
    }
    return ScalarView.Viewed(seen, records, fields);
}
// The message for the signature of `callable` rejected at `node`: what a pointer
// parameter is when that is the cause.
ScalarSignatureMessage :: (params: Param[], callable: Callable, node: int, forest: snapshot.SnapshotNode[]) -> string {
    message := "scalar proof requires number, bool, string, record or union parameters and one number, bool, string, record or union result";
    for (index in 0..<callable.count) {
        param := params[callable.first + index];
        if (forest[param.node].parent == node && param.storage == TaskStorage) {
            return "native task parameters require cancellation unwind support";
        }
        if (forest[param.node].parent == node && param.storage == PointerStorage && !param.reference) {
            return format_text("{}: '{}' is a managed pointer, not a scoped reference", message, param.name);
        }
    }
    return message;
}
// The node a signature's rejection points at, or -1 when it is supported.
// `callable` is as ScalarResults sees it.
ScalarSignature :: (forest: snapshot.SnapshotNode[], types: TypeDecl[], params: Param[], callable: Callable) -> int {
    results := Field(forest, callable.node, syntax.FieldResults);
    if (ScalarValueType(types, callable.result, callable.result_container, callable.result_record) == 0) {
        if (results < 0) {
            return callable.node;
        }
        return results;
    }
    for (index in 0..<callable.count) {
        param := params[callable.first + index];
        // Task parameters need cancellation unwind across active call stacks.
        if (param.storage == TaskStorage || !ScalarParam(types, param)) {
            return forest[param.node].parent;
        }
    }
    return -1;
}
// The diagnostic of a return statement with an outcome, or none. EmitBody
// has rejected a return without a value but in a function with named
// results.
ScalarReturned :: (forest: snapshot.SnapshotNode[], returned: int) -> syntax.Diagnostic {
    outcome := Field(forest, returned, syntax.FieldOutcome);
    if (outcome >= 0) {
        return Diagnose(forest, outcome, 0, "scalar proof does not support return outcomes");
    }
    return ScalarPassed();
}
// The rows of a return of the current values of `callable`'s named results
// at `node`: a read of the one result, or a record of them all.
ScalarResultsReturn :: (forest: snapshot.SnapshotNode[], types: TypeDecl[], params: Param[], callable: Callable,
                        node: int) -> facts.Row[] {
    type := ScalarValueType(types, callable.result, callable.result_container, callable.result_record);
    operands := [ScalarAt(forest, node, facts.ReadRow, type, callable.count, 0, "")];
    if (callable.results > 1) {
        operands = [ScalarAt(forest, node, facts.ZeroRow, type, 0, 0, "")];
        for (index in 0..<callable.results) {
            named := params[callable.first + callable.count + index];
            operands.append(ScalarAt(forest, node, facts.ReadRow,
                                     ScalarValueType(types, named.storage, named.container, named.record),
                                     callable.count + index, 0, ""));
            operands.append(ScalarAt(forest, node, facts.UpdateRow, type, index, 2, ""));
        }
    }
    rows := [ScalarAt(forest, node, facts.ReturnRow, 0, 0, length(operands), "")];
    rows.extend(operands);
    return rows;
}
// The callable whose single named result the member expression `node`
// names on a call of it, or a local it initializes, as the member step
// projects it; -1 for none.
ScalarProjected :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                    names: Name[], package: int, node: int) -> int {
    source := ResultSourceCall(forest, text, names, Field(forest, node, syntax.FieldObject));
    called := ResultSourceCallable(forest, text, callables, [], names, package, source);
    if (called >= 0 && NamedResult(params, callables[called], Text(forest, text, Field(forest, node, syntax.FieldMember))) == 0) {
        return called;
    }
    return -1;
}
// The binding of `name` in `names`, the body's names in scope. A variable's
// binding holds its ordinal, the parameters first, then the locals in
// declaration order, and its storage. EmitBody has resolved every name of
// the body to one.
ScalarVariable :: (names: Name[], name: string) -> Name {
    return names[Lookup(names, name)];
}
// The record `node` is a value of: a record variable's, or that of a call of
// a function of the source that returns one, or of its single named result
// projected by name; -1 for any other value.
ScalarRecordOf :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                   names: Name[], types: TypeDecl[], members: TypeMember[], package: int, node: int) -> int {
    value := Unparenthesized(forest, node);
    if (Is(forest, value, syntax.BinaryExpression) || Is(forest, value, syntax.UnaryExpression)) {
        shape := ScalarBuiltinShape(forest, text, callables, names, types, members, package, value);
        if (shape.storage == StructStorage && MathKind(types, shape.record) != 0) { return shape.record; }
    }
    if (Is(forest, value, syntax.DereferenceExpression) && !ScalarScopedDereference(forest, text, names, value)) {
        pointer := ScalarPointerRecord(forest, text, callables, params, names, types, members, package,
                                        Field(forest, value, syntax.FieldOperand));
        shape := ScalarPointerElement(types, pointer);
        if (shape.storage == StructStorage) { return shape.record; }
    }
    if (Is(forest, value, syntax.ForceUnwrapExpression)) {
        payload := ScalarUnwrappedType(forest, text, callables, params, names, types, members, package, value);
        if (payload.storage == StructStorage && payload.container == 0) { return payload.record; }
        return -1;
    }
    // A single named result projected by name is its call's value.
    if (Is(forest, value, syntax.MemberExpression) &&
        ScalarProjected(forest, text, callables, params, names, package, value) >= 0) {
        return ScalarRecordOf(forest, text, callables, params, names, types, members, package, Field(forest, value, syntax.FieldObject));
    }
    if (Is(forest, value, syntax.Identifier)) {
        found := Lookup(names, Text(forest, text, value));
        if (found >= 0 && names[found].storage == StructStorage && names[found].container == 0) {
            return names[found].record;
        }
        return -1;
    }
    // A record field of a record.
    if (Is(forest, value, syntax.MemberExpression)) {
        field := ScalarMember(forest, text, callables, params, names, types, members, package, value);
        if (field >= 0 && members[field].storage == StructStorage && members[field].container == 0) {
            return members[field].record;
        }
        shape := ScalarBuiltinShape(forest, text, callables, names, types, members, package, value);
        if (shape.storage == StructStorage && MathKind(types, shape.record) != 0) { return shape.record; }
        return -1;
    }
    // An element of an array of records.
    if (Is(forest, value, syntax.IndexExpression)) {
        mapped := ScalarMapShape(forest, text, callables, names, types, package, Field(forest, value, syntax.FieldObject));
        if (mapped >= 0 && types[mapped].value_storage == StructStorage) { return types[mapped].value_record; }
        element := ScalarArrayShape(forest, text, callables, params, names, types, members, package, Field(forest, value, syntax.FieldObject));
        if (element.storage == StructStorage) {
            return element.record;
        }
        return -1;
    }
    if (!Is(forest, value, syntax.CallExpression)) {
        return -1;
    }
    callee := CalledFunction(forest, text, callables, [], names, package, value);
    if (callee >= 0 && callables[callee].result == StructStorage && callables[callee].result_container == 0) {
        return callables[callee].result_record;
    }
    if (ScalarBuiltinCall(forest, text, callables, names, package, value) != 0) {
        shape := ScalarBuiltinShape(forest, text, callables, names, types, members, package, value);
        if (shape.storage == StructStorage) { return shape.record; }
    }
    return -1;
}
// The union `node` is a value of: a union variable's, a variant's, or that of
// a call of a function of the source that returns one; -1 for any other
// value.
ScalarUnionOf :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], names: Name[],
                  types: TypeDecl[], package: int, node: int) -> int {
    value := Unparenthesized(forest, node);
    if (Is(forest, value, syntax.AwaitExpression)) {
        awaited := Unparenthesized(forest, Field(forest, value, syntax.FieldValue));
        if (Is(forest, awaited, syntax.Identifier)) {
            found := Lookup(names, Text(forest, text, awaited));
            if (found >= 0 && names[found].storage == TaskStorage && names[found].container == 0) {
                return TaskResultRecord(types, names[found].record);
            }
        }
        return -1;
    }
    if (Is(forest, value, syntax.Identifier)) {
        found := Lookup(names, Text(forest, text, value));
        if (found >= 0 && names[found].storage == UnionStorage && names[found].container == 0) {
            return names[found].record;
        }
        return -1;
    }
    if (Is(forest, value, syntax.MemberExpression)) {
        return UnionOf(forest, text, types, names, package, value);
    }
    if (!Is(forest, value, syntax.CallExpression)) {
        return -1;
    }
    // A call of a function of the source, qualified by its package or not,
    // before a variant constructor `U.V(payloads)`.
    callee := CalledFunction(forest, text, callables, [], names, package, value);
    if (callee >= 0) {
        if (callables[callee].result == UnionStorage && callables[callee].result_container == 0) {
            return callables[callee].result_record;
        }
        return -1;
    }
    if (Is(forest, Field(forest, value, syntax.FieldFunction), syntax.MemberExpression)) {
        return UnionOf(forest, text, types, names, package, Field(forest, value, syntax.FieldFunction));
    }
    return -1;
}
// Whether `node`, a value of a union, is one of its variants: `U.V` or
// `U.V(payloads)`, not a call of a function of the source.
ScalarVariantMade :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], names: Name[], package: int,
                      node: int) -> bool {
    value := Unparenthesized(forest, node);
    if (Is(forest, value, syntax.MemberExpression)) {
        return true;
    }
    return Is(forest, value, syntax.CallExpression) && Is(forest, Field(forest, value, syntax.FieldFunction), syntax.MemberExpression) &&
           CalledFunction(forest, text, callables, [], names, package, value) < 0;
}
// EmitBody has checked optional presence before a member read. Keep the
// optional slot's type elsewhere, including local inference and nil tests.
ScalarMemberRecordOf :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                        names: Name[], types: TypeDecl[], members: TypeMember[], package: int, node: int) -> int {
    pointer := ScalarPointerObject(forest, text, callables, params, names, types, members, package, node);
    if (pointer >= 0) { return ScalarPointerElement(types, pointer).record; }
    record := ScalarRecordOf(forest, text, callables, params, names, types, members, package, node);
    if (record >= 0) { return record; }
    optional := ScalarHeldUnion(forest, text, callables, params, names, types, members, package, node);
    if (ScalarOptional(types, optional) && types[optional].value_storage == StructStorage &&
        types[optional].value_container == 0) {
        return types[optional].value_record;
    }
    return -1;
}
// The field the member expression `node` reads of a record value, or -1
// when its object is no record.
ScalarMember :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                 names: Name[], types: TypeDecl[], members: TypeMember[], package: int, node: int) -> int {
    record := ScalarMemberRecordOf(forest, text, callables, params, names, types, members, package, Field(forest, node, syntax.FieldObject));
    if (record < 0) {
        return -1;
    }
    return FindField(types, members, record, Text(forest, text, Field(forest, node, syntax.FieldMember)));
}
// The facts operator of a comparison's source operator, 0 for any other,
// in the order of facts.Less through facts.NotEqual.
ScalarComparison :: (operator: int) -> int {
    if (operator == tk.Lt) {
        return facts.Less;
    }
    if (operator == tk.LtEq) {
        return facts.Less + 1;
    }
    if (operator == tk.Gt) {
        return facts.Less + 2;
    }
    if (operator == tk.GtEq) {
        return facts.Less + 3;
    }
    if (operator == tk.CmpEq) {
        return facts.Less + 4;
    }
    if (operator == tk.NotEq) {
        return facts.Less + 5;
    }
    return 0;
}
ScalarCompares :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> bool {
    return Is(forest, node, syntax.BinaryExpression) &&
           ScalarComparison(Operator(forest, node)) != 0;
}
// The facts operator of a binary arithmetic source operator, 0 for any other,
// in the order of facts.Add through facts.Xor.
ScalarArithmetic :: (operator: int) -> int {
    if (operator == tk.Add) {
        return facts.Add;
    }
    if (operator == tk.Sub) {
        return facts.Add + 1;
    }
    if (operator == tk.Mul) {
        return facts.Add + 2;
    }
    if (operator == tk.Quo) {
        return facts.Add + 3;
    }
    if (operator == tk.Mod) {
        return facts.Add + 4;
    }
    if (operator == tk.And) {
        return facts.Add + 5;
    }
    if (operator == tk.Or) {
        return facts.Add + 6;
    }
    if (operator == tk.Xor) {
        return facts.Add + 7;
    }
    return 0;
}
// Whether `node` computes an integer: binary arithmetic, or a negation or
// complement that is not itself a signed literal.
ScalarComputes :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> bool {
    if (Is(forest, node, syntax.BinaryExpression)) {
        return ScalarArithmetic(Operator(forest, node)) != 0;
    }
    if (!Is(forest, node, syntax.UnaryExpression)) {
        return false;
    }
    operator := Operator(forest, node);
    return (operator == tk.Complement || operator == tk.Sub) && InferredNumberStorage(forest, text, node) == 0;
}
ScalarShifts :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> bool {
    return Is(forest, node, syntax.BinaryExpression) && Shift(Operator(forest, node));
}
// The storage two operands of storages `left` and `right` meet at, as
// OperatorStep converts them: an untyped one, 0, takes the other's, an
// integer beside a floating value becomes it and a float beside a double
// becomes a double.
ScalarCommon :: (left: int, right: int) -> int {
    if (left == 0 || (Integer(left) && Floating(right)) || (left == FloatStorage && right == DoubleStorage)) {
        return right;
    }
    return left;
}
// Untyped comparison operands first take their spelled storages, then meet
// at the wider floating storage, or their common integer storage.
ScalarSpelled :: (left: int, right: int) -> int {
    if (left == DoubleStorage || right == DoubleStorage) {
        return DoubleStorage;
    }
    if (left == FloatStorage || right == FloatStorage) {
        return FloatStorage;
    }
    if (!Integer(left) || !Integer(right) || CommonInteger(left, right) < 0) {
        return 0;
    }
    return CommonInteger(left, right);
}
// The storage `operand` has where `context` is expected, as OperatorStep,
// ShiftStep and the conversion step type it: a parameter's, a call's result,
// a conversion's, bool for a bool literal or comparison, and the storage an
// operator's typed operands meet at. Operators visit their operands without
// a context, so an untyped shifted value there is int. A number literal,
// untyped constant expression or operator over untyped literals alone takes
// `context`, 0 when there is none.
// The function whose task the expression `node` holds: a call of a waiting function,
// or a variable that holds a task; -1 for any other.
ScalarTaskCallee :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], names: Name[],
                     callable: Callable, node: int) -> int {
    value := Unparenthesized(forest, node);
    if (Is(forest, value, syntax.CallExpression)) {
        return CalledFunction(forest, text, callables, [], names, callable.package, value);
    }
    if (Is(forest, value, syntax.Identifier) && Lookup(names, Text(forest, text, value)) >= 0) {
        held := names[Lookup(names, Text(forest, text, value))];
        if (held.storage == TaskStorage && held.container == 0 && held.record >= 0 &&
            held.record < length(callables) && callables[held.record].waits) {
            return held.record;
        }
    }
    return -1;
}
// A checked primitive optional read uses its payload in a value context.
// A union context keeps the original descriptor for copying and nil tests.
ScalarOptionalRead :: (forest: snapshot.SnapshotNode[], text: string, names: Name[], types: TypeDecl[],
                       node: int, record: int, context: int) -> bool {
    if (context == UnionStorage || !ScalarOptional(types, record)) { return false; }
    payload := types[record];
    if (payload.value_container != 0 || (!Numeric(payload.value_storage) && payload.value_storage != BoolStorage)) { return false; }
    shape: ValueType = {storage: UnionStorage, container: 0, record: record};
    return OptionalValuePresent(forest, text, names, node, shape);
}

ScalarOperandStorage :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                         callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], operand: int, context: int) -> int {
    original := Unparenthesized(forest, operand);
    if (Is(forest, original, syntax.Nil) && context == PointerStorage) { return PointerStorage; }
    if (Is(forest, original, syntax.AddressExpression)) {
        record := ScalarPointerRecord(forest, text, callables, params, names, types, members, callable.package, original);
        if (ScalarPointerType(types, record) != 0) { return PointerStorage; }
        return 0;
    }
    if (Is(forest, original, syntax.DereferenceExpression) && !ScalarScopedDereference(forest, text, names, original)) {
        record := ScalarPointerRecord(forest, text, callables, params, names, types, members, callable.package,
                                       Field(forest, original, syntax.FieldOperand));
        if (record >= 0) { return ScalarPointerElement(types, record).storage; }
    }
    node := ScalarTarget(forest, operand);
    if (Is(forest, node, syntax.OptionalMemberExpression)) {
        if (ScalarOptionalFieldRecord(forest, text, callables, params, names, types, members, callable.package, node) >= 0) { return UnionStorage; }
        return 0;
    }
    if (Is(forest, node, syntax.BinaryExpression) && Operator(forest, node) == tk.Coalesce) {
        return ScalarOptionalPrimitive(types, ScalarHeldUnion(forest, text, callables, params, names, types, members,
            callable.package, Field(forest, node, syntax.FieldLeft))).storage;
    }
    if (Is(forest, node, syntax.ForceUnwrapExpression)) {
        payload := ScalarUnwrappedType(forest, text, callables, params, names, types, members, callable.package, node);
        if (payload.container == 0) { return payload.storage; }
        return 0;
    }
    if (Is(forest, node, syntax.AwaitExpression)) {
        // The result of the waiting function it awaits; a task's is a union.
        awaited := Unparenthesized(forest, Field(forest, node, syntax.FieldValue));
        if (!Is(forest, awaited, syntax.CallExpression)) {
            function := ScalarTaskCallee(forest, text, callables, names, callable, awaited);
            if (function >= 0 && TaskResultRecord(types, function) >= 0) { return UnionStorage; }
            return 0;
        }
        function := ScalarTaskCallee(forest, text, callables, names, callable, awaited);
        if (function < 0 || !callables[function].waits) {
            return 0;
        }
        return callables[function].result;
    }
    mapped := ScalarMapRead(forest, text, callables, names, types, callable.package, node);
    if (mapped.operator == facts.MapHas) { return BoolStorage; }
    if (mapped.operator == facts.MapGet) {
        return types[ScalarMapShape(forest, text, callables, names, types, callable.package, mapped.object)].value_storage;
    }
    if (Is(forest, node, syntax.UnaryExpression) && Operator(forest, node) == tk.Add) {
        return ScalarOperandStorage(forest, text, callables, params, callable, names, types, members, constants, Field(forest, node, syntax.FieldOperand),
                                    context);
    }
    if (Is(forest, node, syntax.Boolean) || Is(forest, node, syntax.IsExpression) || ScalarCompares(forest, text, node)) {
        return BoolStorage;
    }
    if (Is(forest, node, syntax.Number) || InferredNumberStorage(forest, text, node) != 0) {
        return context;
    }
    if (Is(forest, node, syntax.String)) {
        return TextStorage;
    }
    if (ScalarVariantMade(forest, text, callables, names, callable.package, node) && ScalarUnionOf(forest, text, callables, names, types, callable.package, node) >= 0) {
        return UnionStorage;
    }
    named := ConstantOf(forest, text, constants, names, callable.package, node);
    if (named >= 0) {
        return constants[named].storage;
    }
    // A conversion that names an authored function is that call, as
    // ScalarOperand emits it.
    if (ConstantExpression(forest, text, constants, names, callable.package, node) &&
        !ShadowedConversion(forest, text, callables, callable.package, node)) {
        typed := ConstantType(forest, text, constants, names, callable.package, node);
        if (typed == 0) {
            return context;
        }
        return typed;
    }
    if (Is(forest, node, syntax.Identifier)) {
        binding := ScalarVariable(names, Text(forest, text, node));
        if (binding.storage == UnionStorage && ScalarOptionalRead(forest, text, names, types, node, binding.record, context)) {
            return types[binding.record].value_storage;
        }
        if (binding.storage == UnionStorage && binding.record >= 0 && types[binding.record].kind == TaskResultDecl &&
            TaskResultPresent(forest, text, binding, node)) {
            return TaskResultSuccess(types, binding.record).storage;
        }
        return binding.storage;
    }
    if (Is(forest, node, syntax.IndexExpression)) {
        return ScalarArrayShape(forest, text, callables, params, names, types, members, callable.package, Field(forest, node, syntax.FieldObject)).storage;
    }
    if (Is(forest, node, syntax.CallExpression)) {
        callee := CalledFunction(forest, text, callables, [], names, callable.package, node);
        if (callee >= 0) {
            // A call of a waiting function that is not awaited starts a task.
            if (callables[callee].waits && !ImmediatelyAwaited(forest, node)) {
                return TaskStorage;
            }
            return callables[callee].result;
        }
        callee_proc := ScalarProcCallee(forest, text, names, node);
        if (callee_proc >= 0) {
            shape := ProcShape(forest, text, callee_proc);
            return shape[length(shape) - 1];
        }
        if (ScalarCharacter(forest, text, node)) { return IntStorage; }
        callee_foreign := ScalarForeignDeclaration(forest, text, node);
        if (callee_foreign >= 0) {
            return ScalarForeignResult(forest, text, callee_foreign);
        }
        if (ScalarBuiltinCall(forest, text, callables, names, callable.package, node) != 0) {
            shape := ScalarBuiltinShape(forest, text, callables, names, types, members, callable.package, node);
            if (shape.storage != 0 && (shape.storage == StructStorage || !ScalarMathCall(forest, text, node))) { return shape.storage; }
        }
        if (ScalarMathCall(forest, text, node)) {
            return ScalarMathStorage(forest, text, callables, params, callable, names, types, members, constants, node);
        }
        if (ScalarLengthOf(forest, text, callables, params, names, types, members, callable.package, node) >= 0) {
            return IntStorage;
        }
        if (ScalarMakeArray(forest, text, callables, names, callable.package, node)) {
            return ScalarMadeShape(forest, text, callables, params, names, types, members, callable.package, node).storage;
        }
        native := ScalarArrayCall(forest, text, callables, params, names, types, members, callable.package, node);
        if (native.operator == facts.ArrayContains) {
            return BoolStorage;
        }
        if (native.operator == facts.ArrayText) {
            return TextStorage;
        }
        if (native.operator != 0) {
            return ScalarArrayShape(forest, text, callables, params, names, types, members, callable.package, node).storage;
        }
        operator := ScalarTextOperator(forest, text, node);
        if (operator == ScalarTextEqual) { return BoolStorage; }
        if (operator == facts.TextSlice || operator == facts.TextFormat) {
            return TextStorage;
        }
        if (operator != 0) {
            return IntStorage;
        }
        return NumberConversionType(forest, text, node);
    }
    if (Is(forest, node, syntax.UnaryExpression)) {
        if (ScalarNegated(Operator(forest, node))) {
            return BoolStorage;
        }
        return ScalarOperandStorage(forest, text, callables, params, callable, names, types, members, constants, Field(forest, node, syntax.FieldOperand), context);
    }
    if (Is(forest, node, syntax.MemberExpression)) {
        projected := ScalarProjected(forest, text, callables, params, names, callable.package, node);
        if (projected >= 0) {
            return params[callables[projected].first + callables[projected].count].storage;
        }
        field := ScalarMember(forest, text, callables, params, names, types, members, callable.package, node);
        if (field < 0) {
            return ScalarBuiltinShape(forest, text, callables, names, types, members, callable.package, node).storage;
        }
        if (members[field].storage == UnionStorage &&
            ScalarOptionalRead(forest, text, names, types, node, members[field].record, context)) {
            return types[members[field].record].value_storage;
        }
        if (members[field].storage == UnionStorage &&
            ScalarOptionalRead(forest, text, names, types, node, members[field].record, context)) {
            return types[members[field].record].value_storage;
        }
        return members[field].storage;
    }
    if (!Is(forest, node, syntax.BinaryExpression)) {
        return 0;
    }
    // `&&` and `||` are bool whatever their operands are: an optional operand
    // counts as true when it is not nil.
    if (ScalarLogic(Operator(forest, node)) != 0) {
        return BoolStorage;
    }
    left := ScalarOperandStorage(forest, text, callables, params, callable, names, types, members, constants, Field(forest, node, syntax.FieldLeft), 0);
    if (!ScalarShifts(forest, text, node)) {
        right := ScalarOperandStorage(forest, text, callables, params, callable, names, types, members, constants,
                                       Field(forest, node, syntax.FieldRight), 0);
        if (left == StructStorage || right == StructStorage) { return StructStorage; }
        common := ScalarCommon(left, right);
        if (common == 0) {
            return context;
        }
        return common;
    }
    if (left != 0) {
        return left;
    }
    if (Integer(context)) {
        return context;
    }
    return IntStorage;
}
// `operand` without parentheses, and a scoped parameter's `p^` as `p`: a
// returned dereference keeps its node, but reads the parameter all the same.
ScalarTarget :: (forest: snapshot.SnapshotNode[], operand: int) -> int {
    node := Unparenthesized(forest, operand);
    if (Is(forest, node, syntax.DereferenceExpression) && Is(forest, Field(forest, node, syntax.FieldOperand), syntax.Identifier)) {
        return Field(forest, node, syntax.FieldOperand);
    }
    return node;
}
// Appends the operand rows of `node`, an expression where storage `expected`
// is the context, after `rows`, in evaluation order: a call's arguments left
// to right, then the call. The rows give it the storage ScalarOperandStorage
// does, which a caller converts as the ordinary compiler does. Its callee is
// the one the ordinary call step resolves. EmitBody has already typed the
// body, so every name is a parameter and every call has its callee's arity,
// argument and result types.
ScalarOperand :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                  callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], operand: int, expected: int, rows: facts.Row[]) -> ScalarOperands {
    original := Unparenthesized(forest, operand);
    if (Is(forest, original, syntax.Nil) && expected == PointerStorage) {
        output := rows;
        output.append(ScalarLiteral(forest, original, facts.PointerType, 0));
        return ScalarOperands.Built(output);
    }
    if (Is(forest, original, syntax.AddressExpression)) {
        return ScalarPointerAddress(forest, text, callables, params, callable, names, types, members, constants, original, rows);
    }
    if (Is(forest, original, syntax.DereferenceExpression) && !ScalarScopedDereference(forest, text, names, original)) {
        pointer := Field(forest, original, syntax.FieldOperand);
        if (ScalarPointerRecord(forest, text, callables, params, names, types, members, callable.package, pointer) >= 0) {
            return ScalarPointerAccess(forest, text, callables, params, callable, names, types, members, constants,
                                        pointer, false, rows);
        }
    }
    node := ScalarTarget(forest, operand);
    if (Is(forest, node, syntax.OptionalMemberExpression)) {
        return ScalarOptionalFieldRows(forest, text, callables, params, callable, names, types, members, constants, node, rows);
    }
    if (Is(forest, node, syntax.BinaryExpression) && Operator(forest, node) == tk.Coalesce) {
        return ScalarCoalesce(forest, text, callables, params, callable, names, types, members, constants, node, rows);
    }
    if (Is(forest, node, syntax.ForceUnwrapExpression)) {
        return ScalarUnwrapRows(forest, text, callables, params, callable, names, types, members, constants, node, rows);
    }
    mapped_read := ScalarMapRead(forest, text, callables, names, types, callable.package, node);
    if (mapped_read.operator != 0) {
        return ScalarMapReadRows(forest, text, callables, params, callable, names, types, members, constants, node, mapped_read, rows);
    }
    if (Is(forest, node, syntax.UnaryExpression) && Operator(forest, node) == tk.Add) {
        return ScalarOperand(forest, text, callables, params, callable, names, types, members, constants, Field(forest, node, syntax.FieldOperand),
                             expected, rows);
    }
    if (Is(forest, node, syntax.AwaitExpression)) {
        awaited := Unparenthesized(forest, Field(forest, node, syntax.FieldValue));
        function := ScalarTaskCallee(forest, text, callables, names, callable, awaited);
        if (function < 0 || !callables[function].waits) {
            return ScalarOperands.Failed(Diagnose(forest, node, 0, "native task result needs a known success type"));
        }
        if (!Is(forest, awaited, syntax.CallExpression)) {
            record := TaskResultRecord(types, function);
            if (record < 0) { return ScalarOperands.Failed(Diagnose(forest, node, 0, "native task result type is unsupported")); }
            switch ScalarOperand(forest, text, callables, params, callable, names, types, members, constants, awaited, TaskStorage, rows) {
                case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
                case .Built(built):
                    output := built;
                    success := 1 - (FindVariant(types, record, "Cancelled") - types[record].first);
                    row := ScalarAt(forest, node, facts.AwaitResultRow, ScalarRecordType(types, record), function, 1, "");
                    row.literal = i64(success);
                    output.append(row);
                    return ScalarOperands.Built(output);
            }
        }
        // The call is awaited: its rows give the result.
        return ScalarOperand(forest, text, callables, params, callable, names, types, members, constants, awaited,
                             expected, rows);
    }
    if (Is(forest, node, syntax.MemberExpression)) {
        projected := ScalarProjected(forest, text, callables, params, names, callable.package, node);
        if (projected >= 0) {
            // A single named result is its call's value, converted back to
            // the result's storage when a local widened it.
            named := params[callables[projected].first + callables[projected].count];
            object := Field(forest, node, syntax.FieldObject);
            if (named.storage == StructStorage) {
                return ScalarRecordValue(forest, text, callables, params, callable, names, types, members, constants,
                                         object, named.record, rows);
            }
            return ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, node,
                                 object, named.storage, named.storage, facts.Clamp, rows);
        }
        pointer := ScalarPointerObject(forest, text, callables, params, names, types, members, callable.package,
                                        Field(forest, node, syntax.FieldObject));
        if (pointer >= 0) {
            field := ScalarMember(forest, text, callables, params, names, types, members, callable.package, node);
            if (field < 0) { return ScalarOperands.Failed(Diagnose(forest, node, 0, "native managed field is unavailable")); }
            switch ScalarPointerFieldRows(forest, text, callables, params, callable, names, types, members, constants, node, rows) {
                case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
                case .Built(built):
                    output := built;
                    shape := ScalarMemberShape(members, field);
                    read := ScalarAt(forest, node, facts.ManagedRow, ScalarMemberType(types, members, field), facts.ManagedRead, 1, "");
                    read.literal = ScalarPointerTag(types, shape);
                    output.append(read);
                    return ScalarOperands.Built(output);
            }
        }
    }
    if (Is(forest, node, syntax.IndexExpression)) {
        return ScalarIndexed(forest, text, callables, params, callable, names, types, members, constants, node, rows);
    }
    tested := ScalarNilCompared(forest, text, callables, params, names, types, members, callable, node);
    if (tested >= 0) {
        return ScalarNilTest(forest, text, callables, params, callable, names, types, members, constants, node, tested,
                             rows);
    }
    measured := ScalarLengthOf(forest, text, callables, params, names, types, members, callable.package, node);
    if (measured >= 0) {
        return ScalarLength(forest, text, callables, params, callable, names, types, members, constants, node, measured,
                            rows);
    }
    if (Is(forest, node, syntax.CallExpression) &&
        CalledFunction(forest, text, callables, [], names, callable.package, node) < 0) {
        callee_proc := ScalarProcCallee(forest, text, names, node);
        if (callee_proc >= 0) {
            return ScalarProcRows(forest, text, callables, params, callable, names, types, members, constants, node,
                                  callee_proc, rows);
        }
        callee_foreign := ScalarForeignDeclaration(forest, text, node);
        // As CallStep resolves it, a procedure can shadow char but a
        // foreign declaration cannot replace that conversion.
        if (callee_foreign >= 0 && !ScalarCharacter(forest, text, node)) {
            return ScalarForeignRows(forest, text, callables, params, callable, names, types, members, constants, node,
                                     callee_foreign, rows);
        }
    }
    if (ScalarMakeArray(forest, text, callables, names, callable.package, node)) {
        return ScalarMadeRows(forest, text, callables, params, callable, names, types, members, constants, node, rows);
    }
    native := ScalarArrayCall(forest, text, callables, params, names, types, members, callable.package, node);
    if (native.operator != 0) {
        return ScalarNativeRows(forest, text, callables, params, callable, names, types, members, constants, node, native,
                                rows);
    }
    storage := ScalarOperandStorage(forest, text, callables, params, callable, names, types, members, constants, node, expected);
    builtin := ScalarBuiltinCall(forest, text, callables, names, callable.package, node);
    if (builtin != 0 && (storage == StructStorage || !ScalarMathCall(forest, text, node))) {
        shape := ScalarBuiltinShape(forest, text, callables, names, types, members, callable.package, node);
        if (shape.storage != 0) {
            return ScalarBuiltinOperands(forest, text, callables, params, callable, names, types, members, constants,
                                          node, builtin, rows);
        }
    }
    if (storage == StructStorage && (Is(forest, node, syntax.BinaryExpression) || Is(forest, node, syntax.UnaryExpression))) {
        operation := BuiltinBinary;
        if (Is(forest, node, syntax.UnaryExpression)) { operation = BuiltinNegate; }
        return ScalarBuiltinOperands(forest, text, callables, params, callable, names, types, members, constants,
                                      node, operation, rows);
    }
    if (Is(forest, node, syntax.MemberExpression) &&
        ScalarMember(forest, text, callables, params, names, types, members, callable.package, node) < 0 &&
        MathKind(types, ScalarRecordOf(forest, text, callables, params, names, types, members, callable.package,
                                       Field(forest, node, syntax.FieldObject))) != 0) {
        return ScalarBuiltinOperands(forest, text, callables, params, callable, names, types, members, constants,
                                      node, BuiltinMember, rows);
    }
    type := ScalarTypeOf(storage);
    arrayed := Is(forest, node, syntax.CallExpression) &&
               ScalarArrayHeld(forest, text, callables, params, names, types, members, callable.package, node) != 0;
    if (arrayed) {
        type = ScalarArrayHeld(forest, text, callables, params, names, types, members, callable.package, node);
    }
    mapped := -1;
    if (storage == UnionStorage) {
        mapped = ScalarMapShape(forest, text, callables, names, types, callable.package, node);
    }
    if (mapped >= 0) { type = ScalarMapType(types, mapped); }
    if (storage == PointerStorage && !arrayed) {
        type = ScalarPointerType(types, ScalarPointerRecord(forest, text, callables, params, names, types, members, callable.package, node));
    }
    if (storage == StructStorage && Is(forest, node, syntax.CallExpression) && !arrayed) {
        // A call of a function that returns a record, as ScalarRecordValue
        // reads one.
        type = ScalarRecordType(types, ScalarRecordOf(forest, text, callables, params, names, types, members, callable.package, node));
    }
    // A field of a record: whatever type it holds.
    fielded := false;
    if (Is(forest, node, syntax.MemberExpression) &&
        ScalarProjected(forest, text, callables, params, names, callable.package, node) < 0) {
        field := ScalarMember(forest, text, callables, params, names, types, members, callable.package, node);
        if (field >= 0) {
            if (storage == members[field].storage) { type = ScalarMemberType(types, members, field); }
            fielded = true;
        }
    }
    if (storage == UnionStorage && !arrayed && !fielded && mapped < 0) {
        held := ScalarHeldUnion(forest, text, callables, params, names, types, members, callable.package, node);
        type = ScalarRecordType(types, held);
        if (held >= 0 && ScalarVariantMade(forest, text, callables, names, callable.package, node)) {
            return ScalarVariant(forest, text, callables, params, callable, names, types, members, constants, node, held, rows);
        }
    }
    if (type == 0) {
        return ScalarOperands.Failed(Diagnose(forest, node, 0, "scalar proof supports only number, bool and string values"));
    }
    output := rows;
    if (Is(forest, node, syntax.String)) {
        // The bytes the literal step decodes, which EmitBody has checked.
        row := ScalarAt(forest, node, facts.LiteralRow, type, 0, 0, "");
        row.text = json.Value(Text(forest, text, node)).value;
        output.append(row);
        return ScalarOperands.Built(output);
    }
    // A signed number is a literal too, as ParseNumber reads it.
    literal := Is(forest, node, syntax.Number) ||
               (Is(forest, node, syntax.UnaryExpression) && InferredNumberStorage(forest, text, node) != 0);
    if (literal && Floating(storage)) {
        // The encoding FloatConstantStep gives it, which EmitBody has checked.
        switch NumberBits(forest, text, node) {
            case .OutOfRange:
                return ScalarOperands.Failed(Diagnose(forest, node, 0, "Numeric literal is outside the range of its type"));
            case .Finite(double_bits, float_fits, float_bits):
                bits := double_bits;
                if (storage == FloatStorage) {
                    bits = float_bits;
                }
                output.append(ScalarLiteral(forest, node, type, bits));
                return ScalarOperands.Built(output);
        }
    }
    if (literal) {
        switch ReadIntegerLiteral(forest, text, 0, node, storage) {
            case .Rejected(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Checked(bits):
                output.append(ScalarLiteral(forest, node, type, bits));
                return ScalarOperands.Built(output);
        }
    }
    // A constant expression is the one constant EmitBody folds it to
    // exactly, not rows that would wrap, and a package constant alone is its
    // folded value.
    named := ConstantOf(forest, text, constants, names, callable.package, node);
    // Specialized bool parameters already carry the checker's folded value;
    // the numeric constant evaluator does not accept boolean storage.
    if (named >= 0 && storage == BoolStorage && constants[named].folded) {
        output.append(ScalarLiteral(forest, node, type, constants[named].bits));
        return ScalarOperands.Built(output);
    }
    if ((named >= 0 || Folds(forest, text, constants, names, callable.package, node, storage)) &&
        !ShadowedConversion(forest, text, callables, callable.package, node)) {
        switch FoldConstant(forest, text, callable.document, constants, names, callable.package, node, storage) {
            case .Failed(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Waiting:
                return ScalarOperands.Failed(Diagnose(forest, node, 0, "a constant is not folded yet"));
            case .Folded(bits):
                output.append(ScalarLiteral(forest, node, type, bits));
                return ScalarOperands.Built(output);
        }
    }
    if (Is(forest, node, syntax.Boolean)) {
        value: u64 = 0;
        if (Text(forest, text, node) == "true") {
            value = 1;
        }
        output.append(ScalarLiteral(forest, node, type, value));
        return ScalarOperands.Built(output);
    }
    if (Is(forest, node, syntax.Identifier)) {
        binding := ScalarVariable(names, Text(forest, text, node));
        ordinal := binding.index;
        if (binding.storage == UnionStorage &&
            ((ScalarOptional(types, binding.record) && storage != UnionStorage) ||
             (binding.record >= 0 && types[binding.record].kind == TaskResultDecl && TaskResultPresent(forest, text, binding, node)))) {
            output.append(ScalarAt(forest, node, facts.ReadRow, ScalarRecordType(types, binding.record), ordinal, 0, ""));
            output.append(ScalarAt(forest, node, facts.PayloadRow, type, 0, 1, ""));
        } else {
            output.append(ScalarAt(forest, node, facts.ReadRow, type, ordinal, 0, ""));
        }
        return ScalarOperands.Built(output);
    }
    if (Is(forest, node, syntax.IsExpression)) {
        return ScalarIs(forest, text, callables, params, callable, names, types, members, constants, node, output);
    }
    if (Is(forest, node, syntax.MemberExpression)) {
        // A field read of a record value: the record's rows, then the field.
        object := Field(forest, node, syntax.FieldObject);
        record := ScalarMemberRecordOf(forest, text, callables, params, names, types, members, callable.package, object);
        field := ScalarMember(forest, text, callables, params, names, types, members, callable.package, node);
        switch ScalarRecordValue(forest, text, callables, params, callable, names, types, members, constants, object, record,
                                 output) {
            case .Failed(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Built(built):
                output = built;
        }
        field_type := type;
        narrowed := members[field].storage == UnionStorage && ScalarOptional(types, members[field].record) && storage != UnionStorage;
        if (narrowed) { field_type = ScalarMemberType(types, members, field); }
        output.append(ScalarAt(forest, node, facts.FieldRow, field_type, field - types[record].first, 1, ""));
        if (narrowed) { output.append(ScalarAt(forest, node, facts.PayloadRow, type, 0, 1, "")); }
        return ScalarOperands.Built(output);
    }
    if (ScalarCompares(forest, text, node)) {
        // As OperatorStep types it: an untyped literal takes the other
        // operand's type, and the sides meet at their common storage.
        // EmitBody has typed both sides.
        sides := [Field(forest, node, syntax.FieldLeft), Field(forest, node, syntax.FieldRight)];
        compared := ScalarCommon(ScalarOperandStorage(forest, text, callables, params, callable, names, types, members, constants, sides[0], 0),
                                 ScalarOperandStorage(forest, text, callables, params, callable, names, types, members, constants, sides[1], 0));
        contexts := [compared, compared];
        // Untyped constant expressions each take the type their literals spell.
        if (compared == 0) {
            contexts = [ConstantExpressionStorage(forest, text, sides[0]), ConstantExpressionStorage(forest, text, sides[1])];
            compared = ScalarSpelled(contexts[0], contexts[1]);
        }
        operator := ScalarComparison(Operator(forest, node));
        if (compared == StructStorage) {
            return ScalarBuiltinOperands(forest, text, callables, params, callable, names, types, members, constants,
                                          node, BuiltinBinary, rows);
        }
        equality := operator == facts.Equal || operator == facts.NotEqual;
        if (!Integer(compared) && !Floating(compared) &&
            !((compared == BoolStorage || compared == TextStorage || compared == PointerStorage) && equality)) {
            return ScalarOperands.Failed(Diagnose(forest, node, 0, "scalar proof compares only number operands"));
        }
        compare := ScalarAt(forest, node, facts.CompareRow, facts.BoolType, operator, 2, "");
        return ScalarSides(forest, text, callables, params, callable, names, types, members, constants, node, sides, contexts, compared, compare,
                           output);
    }
    if (Is(forest, node, syntax.BinaryExpression) && ScalarLogic(Operator(forest, node)) != 0) {
        return ScalarLogical(forest, text, callables, params, callable, names, types, members, constants, node, output);
    }
    if (Is(forest, node, syntax.UnaryExpression) && ScalarNegated(Operator(forest, node))) {
        row := ScalarAt(forest, node, facts.UnaryRow, facts.BoolType, facts.Not, 1, "");
        return ScalarSides(forest, text, callables, params, callable, names, types, members, constants, node, [Field(forest, node, syntax.FieldOperand)],
                           [BoolStorage], BoolStorage, row, output);
    }
    if (ScalarComputes(forest, text, node)) {
        return ScalarComputed(forest, text, callables, params, callable, names, types, members, constants, node, storage, output);
    }
    if (ScalarShifts(forest, text, node)) {
        return ScalarShifted(forest, text, callables, params, callable, names, types, members, constants, node, storage, output);
    }
    if (!Is(forest, node, syntax.CallExpression)) {
        return ScalarOperands.Failed(Diagnose(forest, node, 0,
                                              "scalar proof supports only literals, variables, arithmetic, comparisons, logic, conversions and direct calls"));
    }
    callee := CalledFunction(forest, text, callables, [], names, callable.package, node);
    if (callee < 0 && NumberConversionType(forest, text, node) != 0) {
        return ScalarConverted(forest, text, callables, params, callable, names, types, members, constants, node, storage, output);
    }
    if (callee < 0 && ScalarTextOperator(forest, text, node) != 0) {
        return ScalarText(forest, text, callables, params, callable, names, types, members, constants, node, output);
    }
    if (callee < 0 && ScalarMathCall(forest, text, node)) {
        return ScalarMathOperands(forest, text, callables, params, callable, names, types, members, constants, node, output);
    }
    if (callee < 0 && ScalarCharacter(forest, text, node)) {
        // EmitBody rejects invalid constants, non-integer dynamic inputs and
        // named arguments. Keep the original width until the scalar check.
        argument := FirstMember(forest, Field(forest, node, syntax.FieldArguments));
        switch ScalarOperand(forest, text, callables, params, callable, names, types, members, constants,
                             argument, IntStorage, output) {
            case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
            case .Built(built): output = built;
        }
        output.append(ScalarAt(forest, node, facts.ConvertRow, facts.IntType, facts.CheckedChar, 1, ""));
        return ScalarOperands.Built(output);
    }
    if ((!Is(forest, Field(forest, node, syntax.FieldFunction), syntax.Identifier) &&
         !Is(forest, Field(forest, node, syntax.FieldFunction), syntax.MemberExpression)) || callee < 0) {
        return ScalarOperands.Failed(Diagnose(forest, Field(forest, node, syntax.FieldFunction), 0,
                                              "scalar proof calls only functions of its own source"));
    }
    target := callables[callee];
    count: int = 0;
    position: int = 0;
    order: int[] = [];
    argument_changes: string[] = [];
    argument_changes_read := false;
    // A float argument widens to a double parameter, as the call step widens
    // it, and a record argument is the record its parameter takes. Calling
    // ScalarOperand here for a call, not ScalarConvert or ScalarRecordValue,
    // keeps one frame per nested call.
    for (supplied in Members(forest, Field(forest, node, syntax.FieldArguments))) {
        if (GenericOmitted(names, supplied)) {
            continue;
        }
        argument := supplied;
        parameter := position;
        if (Is(forest, supplied, syntax.NamedArgument)) {
            signature := GenericCallbackSignature(forest, text, names, node);
            if (signature < 0 && !GenericResolvedCall(names, node)) {
                return ScalarOperands.Failed(Diagnose(forest, supplied, 0,
                                                      "scalar proof names arguments only for resolved callable signatures"));
            }
            parameter = GenericCallParameter(forest, text, callables, params, names, callee, node, supplied, position);
            argument = Field(forest, supplied, syntax.FieldValue);
        } else { position += 1; }
        assert(parameter >= 0 && parameter < target.count, "checked call argument has a parameter");
        // Positional and already ordered calls need no permutation storage.
        if (parameter != count && length(order) == 0) {
            for previous in 0..<count { order.append(previous); }
        }
        if (parameter != count || length(order) > 0) { order.append(parameter); }
        param := params[target.first + parameter];
        if (param.reference) {
            switch ScalarReferenceArgument(forest, text, callables, params, callable, names, types, members, constants, argument, param, output) {
                case .Failed(diagnostic):
                    return ScalarOperands.Failed(diagnostic);
                case .Built(built):
                    output = built;
            }
            count += 1;
            continue;
        }
        if (param.container == 0 && param.storage == UnionStorage && ScalarOptional(types, param.record)) {
            switch ScalarOptionalValue(forest, text, callables, params, callable, names, types, members, constants,
                                       argument, param.record, output) {
                case .Failed(diagnostic):
                    return ScalarOperands.Failed(diagnostic);
                case .Built(built):
                    output = built;
            }
            count += 1;
            continue;
        }
        if (param.container == MapContainer) {
            if (!argument_changes_read) {
                argument_changes = EvaluationChanges(forest, text, callables, params, [], names, callable.package, node, true);
                argument_changes_read = true;
            }
            copied := param.written || ScalarMapSnapshot(forest, text, params, callable, names, types, argument, argument_changes);
            switch ScalarMapValue(forest, text, callables, params, callable, names, types, members, constants,
                                  argument, param.record, copied, output) {
                case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
                case .Built(built): output = built;
            }
            count += 1;
            continue;
        }
        if (param.container == ArrayContainer) {
            // A readonly argument can be lent unless another argument or a
            // scoped callee parameter may change its source. Capture that
            // value before evaluating the next argument.
            if (!param.written && !argument_changes_read) {
                argument_changes = EvaluationChanges(forest, text, callables, params, [], names, callable.package, node, true);
                argument_changes_read = true;
            }
            lent: ValueType = {storage: param.storage, container: ArrayContainer, record: param.record};
            copied := param.written || ScalarArraySnapshot(forest, text, params, callable, names, argument, argument_changes);
            if (copied) {
                switch ScalarArrayStored(forest, text, callables, params, callable, names, types, members, constants,
                                         argument, lent, true, output) {
                    case .Failed(diagnostic):
                        return ScalarOperands.Failed(diagnostic);
                    case .Built(built):
                        output = built;
                }
                count += 1;
                continue;
            }
            switch ScalarArrayValue(forest, text, callables, params, callable, names, types, members, constants,
                                    argument, lent, output) {
                case .Failed(diagnostic):
                    return ScalarOperands.Failed(diagnostic);
                case .Built(built):
                    output = built;
            }
            count += 1;
            continue;
        }
        expected := param.storage;
        operand := ScalarOperands.Built(output);
        if ((expected == StructStorage && !Is(forest, Unparenthesized(forest, argument), syntax.CallExpression)) ||
            expected == UnionStorage) {
            operand = ScalarRecordValue(forest, text, callables, params, callable, names, types, members, constants, argument,
                                        param.record, output);
        } else {
            switch ScalarOperand(forest, text, callables, params, callable, names, types, members, constants, argument, expected,
                                 output) {
                case .Failed(diagnostic):
                    return ScalarOperands.Failed(diagnostic);
                case .Built(built):
                    operand = ScalarOperands.Built(built);
                    if (expected != StructStorage && expected != PointerStorage) {
                        operand = ScalarConversion(forest, text, callables, params, callable, names, types, members, constants,
                                                   argument, argument, expected, expected, facts.Clamp, built);
                    }
            }
        }
        switch operand {
            case .Failed(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Built(built):
                output = built;
        }
        count += 1;
    }
    // An omitted argument is its parameter's default, a literal of the
    // parameter's type at the call, as the call step fills it in.
    if (length(order) == 0) {
        while (count < target.count) {
            param := params[target.first + count];
            omitted := ScalarLiteral(forest, node, ScalarTypeOf(param.storage), param.default_bits);
            omitted.text = param.default_text;
            output.append(omitted);
            count += 1;
        }
    } else {
        // Labeled calls supply the complete signature. A one-based inverse
        // checks uniqueness, then places each value with at most one exchange.
        assert(count == target.count, "checked labeled call supplies every parameter");
        positions := resize([int(0)], target.count);
        for index in 0..<length(order) {
            assert(positions[order[index]] == 0, "checked call arguments are unique");
            positions[order[index]] = index + 1;
        }
        for index in 0..<target.count {
            other := positions[index] - 1;
            if (other == index) { continue; }
            output.append(ScalarAt(forest, node, facts.OperandSwapRow, 0,
                                   count - 1 - other, count - 1 - index, ""));
            moved := order[index];
            order[index] = index;
            order[other] = moved;
            positions[moved] = other + 1;
            positions[index] = index + 1;
        }
    }
    call := ScalarAt(forest, node, facts.CallRow, type, callee, count, target.name);
    if (target.waits) {
        // A waiting function runs inline when awaited, and otherwise as a task.
        call.literal = i64(facts.CallSpawned);
        if (ImmediatelyAwaited(forest, node)) {
            call.literal = i64(facts.CallAwaited);
        }
    }
    output.append(call);
    return ScalarOperands.Built(output);
}
// The row of `argument`, `&x` or a scoped parameter `x` passed on, for the
// scoped parameter `param`: a RefRow of the variable.
ScalarReferenceArgument :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                            callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                            constants: ConstDecl[], argument: int, param: Param, rows: facts.Row[]) -> ScalarOperands {
    addressed := Unparenthesized(forest, argument);
    if (Is(forest, addressed, syntax.AddressExpression)) {
        held := Unparenthesized(forest, Field(forest, addressed, syntax.FieldOperand));
        if (param.storage != PointerStorage && Is(forest, held, syntax.DereferenceExpression) &&
            !ScalarScopedDereference(forest, text, names, held) && ScalarPointerRecord(forest, text, callables, params, names, types, members, callable.package,
                                  Field(forest, held, syntax.FieldOperand)) >= 0) {
            return ScalarPointerAccess(forest, text, callables, params, callable, names, types, members, constants,
                                        Field(forest, held, syntax.FieldOperand), true, rows);
        }
    }
    if (param.storage != PointerStorage && !Is(forest, Unparenthesized(forest, argument), syntax.AddressExpression) &&
        ScalarPointerRecord(forest, text, callables, params, names, types, members, callable.package, argument) >= 0) {
        return ScalarPointerAccess(forest, text, callables, params, callable, names, types, members, constants,
                                    argument, true, rows);
    }
    name := ScalarPassedName(forest, text, argument);
    found := Lookup(names, name);
    type := ScalarValueType(types, param.storage, param.container, param.record);
    // `&point.x`: a number or bool field of a record variable.
    place := Unparenthesized(forest, argument);
    if (Is(forest, place, syntax.AddressExpression)) {
        place = Unparenthesized(forest, Field(forest, place, syntax.FieldOperand));
    }
    if (name == "" && Is(forest, place, syntax.MemberExpression) &&
        Is(forest, Unparenthesized(forest, Field(forest, place, syntax.FieldObject)), syntax.Identifier)) {
        object := Lookup(names, Text(forest, text, Unparenthesized(forest, Field(forest, place, syntax.FieldObject))));
        field := ScalarMember(forest, text, callables, params, names, types, members, callable.package, place);
        if (object >= 0 && field >= 0 && names[object].storage == StructStorage && names[object].container == 0 &&
            members[field].container == 0 && type != 0 && ScalarMemberType(types, members, field) == type &&
            (Integer(members[field].storage) || Floating(members[field].storage) || members[field].storage == BoolStorage)) {
            record := ScalarRecordOf(forest, text, callables, params, names, types, members, callable.package,
                                     Field(forest, place, syntax.FieldObject));
            reference := ScalarAt(forest, argument, facts.RefRow, type, names[object].index, 0, "");
            reference.literal = i64(field - types[record].first + 1);
            output := rows;
            output.append(reference);
            return ScalarOperands.Built(output);
        }
    }
    if (name == "" || found < 0 || type == 0) {
        return ScalarOperands.Failed(Diagnose(forest, argument, 0,
                                              "scalar proof passes only a variable by reference"));
    }
    output := rows;
    output.append(ScalarAt(forest, argument, facts.RefRow, type, names[found].index, 0, ""));
    return ScalarOperands.Built(output);
}
// Called only after authored functions, foreign calls and procedure values
// have been resolved, so their names can shadow the built-in.

ScalarCharacter :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> bool {
    callee := Field(forest, node, syntax.FieldFunction);
    return Is(forest, callee, syntax.Identifier) && Text(forest, text, callee) == "char";
}
// text_equal reuses the ordinary string Compare row rather than adding
// a second facts operator for the same value comparison.
ScalarTextEqual: int : -1;
// The text operation of `node`, 0 otherwise. Authored functions, procedure
// values and foreign calls resolve before these runtime capabilities.
ScalarTextOperator :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> int {
    function := Field(forest, node, syntax.FieldFunction);
    if (!Is(forest, function, syntax.Identifier)) {
        return 0;
    }
    name := Text(forest, text, function);
    if (name == "text_equal") { return ScalarTextEqual; }
    if (name == "print_string") { return facts.TextPrint; }
    if (name == "text_byte_length") {
        return facts.TextLength;
    }
    if (name == "text_byte_at") {
        return facts.TextByte;
    }
    if (name == "text_slice") {
        return facts.TextSlice;
    }
    if (name == "format_text") {
        return facts.TextFormat;
    }
    return 0;
}
// The ordinary binder has validated these ports. Preserve supplied order;
// only the final operation selects parameter order, never reevaluating a value.
ScalarTextParameter :: (operator: int, index: int) -> string {
    if (operator == ScalarTextEqual) { if (index == 0) { return "A"; } return "B"; }
    if (operator == facts.TextPrint) { return "InString"; }
    if (index == 0) { return "Value"; }
    if (operator == facts.TextByte) { return "Index"; }
    if (index == 1) { return "Start"; }
    return "Count";
}
ScalarText :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
               callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[],
               node: int, rows: facts.Row[]) -> ScalarOperands {
    operator := ScalarTextOperator(forest, text, node);
    inputs := Members(forest, Field(forest, node, syntax.FieldArguments));
    // Each fixed source operand stores its parameter in two bits. Variadic
    // formats need no permutation and no temporary argument table.
    parameters := 0;
    output := rows;
    for (input, ordinal in inputs) {
        argument := input;
        parameter := ordinal;
        if (Is(forest, argument, syntax.NamedArgument)) {
            if (operator == facts.TextFormat) {
                return ScalarOperands.Failed(Diagnose(forest, argument, 0,
                    "scalar proof passes format_text arguments in order"));
            }
            supplied := Text(forest, text, Field(forest, argument, syntax.FieldName));
            parameter = -1;
            // Fixed text natives have at most three checked parameters.
            for (index in 0..<length(inputs)) {
                if (NameMatches(supplied, ScalarTextParameter(operator, index))) { parameter = index; }
            }
            argument = Field(forest, argument, syntax.FieldValue);
            if (argument < 0) { argument = Field(forest, input, syntax.FieldSource); }
        }
        if (operator != facts.TextFormat) { parameters |= parameter << u32(ordinal * 2); }
        expected := ScalarTextArgument(forest, text, callables, params, callable, names, types, members, constants,
                                       operator, parameter, argument);
        if (expected.storage == 0) {
            return ScalarOperands.Failed(Diagnose(forest, argument, 0,
                                                  "scalar proof formats only numbers, bools, strings, arrays and maps"));
        }
        if (operator == facts.TextFormat && ScalarFormatPointer(types, members, expected)) {
            return ScalarOperands.Failed(Diagnose(forest, argument, 0,
                                                  "Native calls cannot retain managed pointer arguments"));
        }
        value := ScalarOperands.Built([]);
        if (expected.container == ArrayContainer) {
            value = ScalarArrayValue(forest, text, callables, params, callable, names, types, members, constants,
                                     argument, expected, output);
        } else if (expected.container == MapContainer) {
            value = ScalarMapValue(forest, text, callables, params, callable, names, types, members, constants,
                                   argument, expected.record, false, output);
        } else {
            value = ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, argument,
                                   argument, expected.storage, expected.storage, facts.Clamp, output);
        }
        switch value {
            case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
            case .Built(built): output = built;
        }
    }
    count := length(inputs);
    if (operator == ScalarTextEqual) {
        output.append(ScalarAt(forest, node, facts.CompareRow, facts.BoolType, facts.Equal, count, ""));
        return ScalarOperands.Built(output);
    }
    type := facts.IntType;
    if (operator == facts.TextSlice || operator == facts.TextFormat) { type = facts.StringType; }
    operation := ScalarAt(forest, node, facts.TextRow, type, operator, count, "");
    if (operator != facts.TextFormat && count > 1) {
        orders := 2;
        if (count == 3) { orders = 6; }
        found := false;
        for (order in 0..<orders) {
            matches := true;
            for (parameter in 0..<count) {
                source := facts.TextArgument(count, order, parameter);
                matches = matches && ((parameters >> u32(source * 2)) & 3) == parameter;
            }
            if (matches) { operation.literal = i64(order); found = true; break; }
        }
        assert(found);
    }
    output.append(operation);
    return ScalarOperands.Built(output);
}
// The ordinary native-value boundary rejects managed pointers, including
// those inside containers. Visit each reachable declared type once: recursive
// array/record schemas need not have recursive inline layouts. This is a
// compile-time schema check, never a walk over runtime elements or pointees.
ScalarFormatPointer :: (types: TypeDecl[], members: TypeMember[], shape: ValueType) -> bool {
    if (shape.storage == PointerStorage) { return true; }
    if (shape.container == 0 && ScalarTypeOf(shape.storage) != 0) { return false; }
    if (shape.record < 0) { return false; }
    seen: [int: bool] = [:];
    pending: int[] = [shape.record];
    index := 0;
    while (index < length(pending)) {
        record := pending[index];
        index += 1;
        if (record in seen) { continue; }
        seen[record] = true;
        declared := types[record];
        if (declared.kind == PointerDecl) { return true; }
        if (declared.kind == MapDecl || declared.kind == CollectionDecl ||
            declared.kind == OptionalDecl || declared.kind == TaskResultDecl) {
            if (declared.value_storage == PointerStorage) { return true; }
            if (declared.value_record >= 0) { pending.append(declared.value_record); }
        } else if (declared.kind == UnionDecl) {
            for (variant in declared.first..<declared.first + declared.count) { pending.append(variant); }
        } else {
            for (field in declared.first..<declared.first + declared.count) {
                member := members[field];
                if (member.storage == PointerStorage) { return true; }
                if (member.record >= 0) { pending.append(member.record); }
            }
        }
    }
    return false;
}
// The shape a text native's parameter `index`, `argument`, takes; storage 0
// means unsupported. A text native takes its string, then ints, and for
// format_text its format then a scalar/text value or a collection descriptor.
// Counts stay in the descriptor's value snapshot, not its backing storage.
ScalarTextArgument :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                       callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                       constants: ConstDecl[], operator: int, index: int, argument: int) -> ValueType {
    shape: ValueType = {storage: TextStorage, container: 0, record: -1};
    if (index == 0 || operator == ScalarTextEqual) {
        return shape;
    }
    if (operator != facts.TextFormat) {
        shape.storage = IntStorage;
        return shape;
    }
    node := ScalarTarget(forest, argument);
    if (Is(forest, node, syntax.Identifier)) {
        found := Lookup(names, Text(forest, text, node));
        if (found >= 0) {
            binding := names[found];
            if ((binding.container == 0 && ScalarTypeOf(binding.storage) != 0) ||
                (binding.container == ArrayContainer && ScalarArrayType(types, binding.storage, binding.record) != 0) ||
                (binding.container == MapContainer && ScalarMapType(types, binding.record) != 0)) {
                return {storage: binding.storage, container: binding.container, record: binding.record};
            }
        }
    } else {
        array := ScalarVisitedShape(forest, text, callables, params, callable, names, types, members, constants, node);
        if (array.container == ArrayContainer && ScalarArrayType(types, array.storage, array.record) != 0) { return array; }
        mapped := ScalarMapShape(forest, text, callables, names, types, callable.package, node);
        if (mapped >= 0) { return {storage: UnionStorage, container: MapContainer, record: mapped}; }
    }
    storage := ScalarOperandStorage(forest, text, callables, params, callable, names, types, members, constants,
                                    argument, 0);
    if (ScalarTypeOf(storage) == 0) {
        storage = 0;
    }
    shape.storage = storage;
    return shape;
}
// Only the runtime's fixed text signatures use the compact permutation.
// Reject calls through a different capability with ordinary catalog binding;
// unused capabilities and authored declarations keep their own meaning.
ScalarTextCatalog :: (natives: ResolvedNative[], ports: ^(ResolvedPort[])) {
    for (name in ["text_equal", "text_byte_length", "text_byte_at", "text_slice"]) {
        count := 0;
        canonical := true;
        operator := facts.TextLength;
        parameters := 1;
        if (name == "text_equal") { operator = ScalarTextEqual; parameters = 2; }
        if (name == "text_byte_at") { operator = facts.TextByte; parameters = 2; }
        if (name == "text_slice") { operator = facts.TextSlice; parameters = 3; }
        for (native in natives) {
            if (!NativeNameMatches(native, name)) { continue; }
            count += 1;
            if (native.name != name || native.parameters != parameters || native.results != 1 || native.variadic ||
                !native.direct || native.intrinsic != 0 || native.kind != NativeFunctionKind || native.effects != 0) {
                canonical = false;
                continue;
            }
            for (index in 0..<parameters + 1) {
                port := ports^[native.first + index];
                expected := TextStorage;
                port_name := "Result";
                if (index < parameters) {
                    port_name = ScalarTextParameter(operator, index);
                    if (index > 0 && operator != ScalarTextEqual) { expected = IntStorage; }
                } else {
                    expected = IntStorage;
                    if (operator == ScalarTextEqual) { expected = BoolStorage; }
                    if (operator == facts.TextSlice) { expected = TextStorage; }
                }
                if (port.storage != expected || port.container != 0 || port.record >= 0 || port.c_string ||
                    port.has_default || !NameMatches(port_name, port.name)) { canonical = false; }
            }
        }
        if (count == 0 || (count == 1 && canonical)) { continue; }
        for (native in natives) {
            if (!NativeNameMatches(native, name)) { continue; }
            for (index in native.first..<native.first + native.parameters + native.results) {
                port := ports^[index];
                port.storage = UnsupportedPort;
                ports^[index] = port;
            }
        }
    }
}
// Appends the rows of `node`, the variant `U.V` or `U.V(payloads)` of union
// `held`, after `rows`: each payload converted to its field's storage, as the
// call step expects it, then its Make row. EmitBody has typed it, so it
// names a variant and gives each payload.
ScalarVariant :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                  callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], node: int, held: int,
                  rows: facts.Row[]) -> ScalarOperands {
    callee := node;
    payloads: int[] = [];
    if (Is(forest, node, syntax.CallExpression)) {
        callee = Field(forest, node, syntax.FieldFunction);
        payloads = Members(forest, Field(forest, node, syntax.FieldArguments));
    }
    variant := FindVariant(types, held, Text(forest, text, Field(forest, callee, syntax.FieldMember)));
    output := rows;
    for (index in 0..<length(payloads)) {
        switch ScalarElementValue(forest, text, callables, params, callable, names, types, members, constants,
                                  payloads[index], ScalarMemberShape(members, types[variant].first + index), output) {
            case .Failed(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Built(built):
                output = built;
        }
    }
    made := ScalarAt(forest, node, facts.MakeRow, ScalarRecordType(types, held), variant - types[held].first,
                     length(payloads), "");
    output.append(made);
    return ScalarOperands.Built(output);
}
// The rows of `node`, `value is .V` or `value is not .V`, after `rows`: the
// value's rows, its Tag, a Literal of V's ordinal and an Equal or NotEqual
// Compare, as IsStep tests it. A binding is not supported.
ScalarIs :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
             callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], node: int,
             rows: facts.Row[]) -> ScalarOperands {
    value := Field(forest, node, syntax.FieldValue);
    pattern := Field(forest, node, syntax.FieldType);
    if (FirstMember(forest, Field(forest, pattern, syntax.FieldBindings)) >= 0) {
        return ScalarOperands.Failed(Diagnose(forest, pattern, 0, "scalar proof binds payloads only in switch arms"));
    }
    held := ScalarMatchedUnion(types,
        ScalarHeldUnion(forest, text, callables, params, names, types, members, callable.package, value));
    output := rows;
    switch ScalarUnionValue(forest, text, callables, params, callable, names, types, members, constants, value, held, output) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output = built;
    }
    variant := FindVariant(types, held, Text(forest, text, Field(forest, pattern, syntax.FieldName)));
    if (types[held].kind == TaskResultDecl && TaskResultPattern(forest, text, node)) {
        variant = FindVariant(types, held, "Cancelled");
    }
    operator := facts.Equal;
    if (Field(forest, node, syntax.FieldNegated) >= 0) {
        operator = facts.NotEqual;
    }
    tested := [ScalarAt(forest, value, facts.TagRow, facts.IntType, 0, 1, ""),
               ScalarLiteral(forest, pattern, facts.IntType, u64(variant - types[held].first)),
               ScalarAt(forest, node, facts.CompareRow, facts.BoolType, operator, 2, "")];
    output.extend(tested);
    return ScalarOperands.Built(output);
}
// The union `node` is a value of: ScalarUnionOf's, or the union a record
// variable's field holds.
ScalarHeldUnion :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                    names: Name[], types: TypeDecl[], members: TypeMember[], package: int, node: int) -> int {
    value := Unparenthesized(forest, node);
    if (Is(forest, value, syntax.OptionalMemberExpression)) {
        return ScalarOptionalFieldRecord(forest, text, callables, params, names, types, members, package, value);
    }
    if (Is(forest, value, syntax.ForceUnwrapExpression)) {
        payload := ScalarUnwrappedType(forest, text, callables, params, names, types, members, package, value);
        if (payload.storage == UnionStorage && payload.container == 0) { return payload.record; }
        return -1;
    }
    if (Is(forest, value, syntax.MemberExpression)) {
        field := ScalarMember(forest, text, callables, params, names, types, members, package, value);
        if (field >= 0 && members[field].storage == UnionStorage && members[field].container == 0) {
            return members[field].record;
        }
    }
    // An element of an array of unions.
    if (Is(forest, value, syntax.IndexExpression)) {
        element := ScalarArrayShape(forest, text, callables, params, names, types, members, package, Field(forest, value, syntax.FieldObject));
        if (element.storage == UnionStorage && element.container == ArrayContainer) {
            return element.record;
        }
        return -1;
    }
    return ScalarUnionOf(forest, text, callables, names, types, package, value);
}
// EmitBody has checked presence before a union match. The original optional
// keeps its identity for nil tests and assignment; only the match sees Some.
ScalarMatchedUnion :: (types: TypeDecl[], held: int) -> int {
    if (ScalarOptional(types, held) && types[held].value_storage == UnionStorage &&
        types[held].value_container == 0) { return types[held].value_record; }
    return held;
}
// A union value in the already-checked expected context. Guarded optional
// unions project their owned payload through the same path as record fields.
ScalarUnionValue :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                     callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[],
                     node: int, record: int, rows: facts.Row[]) -> ScalarOperands {
    held := ScalarHeldUnion(forest, text, callables, params, names, types, members, callable.package, node);
    switch ScalarOperand(forest, text, callables, params, callable, names, types, members, constants,
                         node, UnionStorage, rows) {
        case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output := built;
            if (held != record && ScalarMatchedUnion(types, held) == record) {
                output.append(ScalarAt(forest, node, facts.PayloadRow, ScalarRecordType(types, record), 0, 1, ""));
            }
            return ScalarOperands.Built(output);
    }
}
// The payload descriptor already checked by the ordinary force-unwrap step.
ScalarUnwrappedType :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                        names: Name[], types: TypeDecl[], members: TypeMember[], package: int, node: int) -> ValueType {
    optional := ScalarHeldUnion(forest, text, callables, params, names, types, members, package,
                                Field(forest, node, syntax.FieldOperand));
    if (!ScalarOptional(types, optional)) { return {storage: 0, container: 0, record: -1}; }
    return {storage: types[optional].value_storage, container: types[optional].value_container,
            record: types[optional].value_record};
}
ScalarUnwrapRows :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                     callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                     constants: ConstDecl[], node: int, rows: facts.Row[]) -> ScalarOperands {
    payload := ScalarUnwrappedType(forest, text, callables, params, names, types, members, callable.package, node);
    type := ScalarValueType(types, payload.storage, payload.container, payload.record);
    if (payload.container != 0 || type == 0) {
        return ScalarOperands.Failed(Diagnose(forest, node, 0,
                                              "native force unwrap requires a number, bool, string, record or union payload"));
    }
    switch ScalarOperand(forest, text, callables, params, callable, names, types, members, constants,
                         Field(forest, node, syntax.FieldOperand), UnionStorage, rows) {
        case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output := built;
            output.append(ScalarAt(forest, node, facts.UnwrapRow, type, 0, 1, ""));
            return ScalarOperands.Built(output);
    }
}
// The operand of the comparison `node`, `x == nil` or `x != nil`, that is a
// value of an optional, or -1 for any other comparison.
ScalarNilCompared :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                      names: Name[], types: TypeDecl[], members: TypeMember[], callable: Callable, node: int) -> int {
    if (!Is(forest, node, syntax.BinaryExpression)) {
        return -1;
    }
    operator := Text(forest, text, Field(forest, node, syntax.FieldOperator));
    if (operator != "==" && operator != "!=") {
        return -1;
    }
    left := Unparenthesized(forest, Field(forest, node, syntax.FieldLeft));
    right := Unparenthesized(forest, Field(forest, node, syntax.FieldRight));
    other := left;
    if (Is(forest, left, syntax.Nil)) {
        other = right;
    } else if (!Is(forest, right, syntax.Nil)) {
        return -1;
    }
    if (!ScalarOptional(types, ScalarHeldUnion(forest, text, callables, params, names, types, members, callable.package,
                                               other))) {
        return -1;
    }
    return other;
}
// The rows of the comparison `node` of `tested`, an optional, with nil: its
// Tag compared with the ordinal 0 of Nil.
ScalarNilTest :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                  callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                  constants: ConstDecl[], node: int, tested: int, rows: facts.Row[]) -> ScalarOperands {
    output := rows;
    switch ScalarOperand(forest, text, callables, params, callable, names, types, members, constants, tested,
                         UnionStorage, output) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output = built;
    }
    operator := facts.Equal;
    if (Text(forest, text, Field(forest, node, syntax.FieldOperator)) == "!=") {
        operator = facts.NotEqual;
    }
    output.extend([ScalarAt(forest, tested, facts.TagRow, facts.IntType, 0, 1, ""),
                   ScalarLiteral(forest, tested, facts.IntType, 0),
                   ScalarAt(forest, node, facts.CompareRow, facts.BoolType, operator, 2, "")]);
    return ScalarOperands.Built(output);
}
// Appends the rows of `operand`, a value of the optional `record`, after
// `rows`: nil is its Nil variant, a value of the optional's own type is read as
// it is, and any other value is the payload of a Some.
ScalarOptionalValue :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                        callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                        constants: ConstDecl[], operand: int, record: int, rows: facts.Row[]) -> ScalarOperands {
    node := Unparenthesized(forest, operand);
    type := ScalarRecordType(types, record);
    output := rows;
    if (Is(forest, node, syntax.Nil)) {
        output.append(ScalarAt(forest, node, facts.MakeRow, type, 0, 0, ""));
        return ScalarOperands.Built(output);
    }
    if (ScalarHeldUnion(forest, text, callables, params, names, types, members, callable.package, node) == record) {
        return ScalarOperand(forest, text, callables, params, callable, names, types, members, constants, node,
                             UnionStorage, output);
    }
    declared := types[record];
    payload: ValueType = {storage: declared.value_storage, container: declared.value_container,
                          record: declared.value_record};
    switch ScalarElementValue(forest, text, callables, params, callable, names, types, members, constants, node, payload,
                              output) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output = built;
    }
    output.append(ScalarAt(forest, node, facts.MakeRow, type, 1, 1, ""));
    return ScalarOperands.Built(output);
}
// The rows of `operand` in the checked record or union context `record`.
// Optionals construct Nil/Some; a guarded value projects Some. A record
// literal builds Zero and its converted field updates in source order.
ScalarRecordValue :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                      callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], operand: int,
                      record: int, rows: facts.Row[]) -> ScalarOperands {
    node := Unparenthesized(forest, operand);
    if (Is(forest, node, syntax.DereferenceExpression) && !ScalarScopedDereference(forest, text, names, node)) {
        return ScalarPointerAccess(forest, text, callables, params, callable, names, types, members, constants,
                                    Field(forest, node, syntax.FieldOperand), false, rows);
    }
    if (Is(forest, node, syntax.ForceUnwrapExpression)) {
        return ScalarUnwrapRows(forest, text, callables, params, callable, names, types, members, constants, node, rows);
    }
    type := ScalarRecordType(types, record);
    if (ScalarOptional(types, record)) {
        return ScalarOptionalValue(forest, text, callables, params, callable, names, types, members, constants, operand,
                                   record, rows);
    }
    if (record >= 0 && (types[record].kind == UnionDecl || types[record].kind == TaskResultDecl)) {
        return ScalarUnionValue(forest, text, callables, params, callable, names, types, members, constants, operand,
                                record, rows);
    }
    optional := ScalarHeldUnion(forest, text, callables, params, names, types, members, callable.package, node);
    if (ScalarOptional(types, optional) && types[optional].value_storage == StructStorage &&
        types[optional].value_container == 0 && types[optional].value_record == record) {
        switch ScalarOperand(forest, text, callables, params, callable, names, types, members, constants, node,
                             UnionStorage, rows) {
            case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
            case .Built(built):
                output := built;
                output.append(ScalarAt(forest, node, facts.PayloadRow, type, 0, 1, ""));
                return ScalarOperands.Built(output);
        }
    }
    if (Is(forest, node, syntax.Identifier)) {
        ordinal := ScalarVariable(names, Text(forest, text, node)).index;
        output := rows;
        output.append(ScalarAt(forest, node, facts.ReadRow, type, ordinal, 0, ""));
        return ScalarOperands.Built(output);
    }
    if (Is(forest, node, syntax.CallExpression) || Is(forest, node, syntax.MemberExpression) ||
        Is(forest, node, syntax.IndexExpression)) {
        return ScalarOperand(forest, text, callables, params, callable, names, types, members, constants, node, StructStorage,
                             rows);
    }
    if (!Is(forest, node, syntax.StructExpression)) {
        if (MathKind(types, record) != 0) {
            return ScalarOperand(forest, text, callables, params, callable, names, types, members, constants,
                                  node, StructStorage, rows);
        }
        return ScalarOperands.Failed(Diagnose(forest, node, 0,
                                              "scalar proof takes records only from literals, variables and calls"));
    }
    output := rows;
    output.append(ScalarAt(forest, node, facts.ZeroRow, type, 0, 0, ""));
    // 0 until a field needs it, then 1 when the literal may borrow the arrays
    // of the lent parameters it names, 2 when not.
    borrowing := 0;
    for (member in Members(forest, node)) {
        field := FindField(types, members, record, Text(forest, text, Field(forest, member, syntax.FieldName)));
        value := Field(forest, member, syntax.FieldValue);
        shape := ScalarMemberShape(members, field);
        if (members[field].fixed && shape.container == ArrayContainer && ScalarLentParameter(forest, text, names, value)) {
            if (borrowing == 0) {
                borrowing = 2;
                if (ScalarViewLocal(forest, text, Field(forest, callable.node, syntax.FieldBody), node)) {
                    borrowing = 1;
                }
            }
            if (borrowing == 1) {
                // The record's array is its parameter's own buffer: neither
                // copy it nor free it.
                switch ScalarArrayValue(forest, text, callables, params, callable, names, types, members, constants,
                                        value, shape, output) {
                    case .Failed(diagnostic):
                        return ScalarOperands.Failed(diagnostic);
                    case .Built(built):
                        output = built;
                }
                output.append(ScalarAt(forest, member, facts.UpdateRow, type, field - types[record].first, 2, ""));
                continue;
            }
        }
        switch ScalarElementValue(forest, text, callables, params, callable, names, types, members, constants, value,
                                  shape, output) {
            case .Failed(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Built(built):
                output = built;
        }
        update := ScalarAt(forest, member, facts.UpdateRow, type, field - types[record].first, 2, "");
        output.append(update);
    }
    return ScalarOperands.Built(output);
}
// The rows of `node` after `rows`, `operand` where `context` is expected, then
// its conversion in `mode` to `storage` when its own storage differs: one
// Convert row, or two when an integer becomes a float, through double as
// NumberCode converts it.
ScalarConvert :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                  callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], node: int, operand: int, context: int, storage: int, mode: int,
                  rows: facts.Row[]) -> ScalarOperands {
    switch ScalarOperand(forest, text, callables, params, callable, names, types, members, constants, operand, context, rows) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            return ScalarConversion(forest, text, callables, params, callable, names, types, members, constants, node, operand, context, storage,
                                    mode, built);
    }
}
// `rows`, which end with the rows of `operand` where `context` is expected,
// then its conversion in `mode` to `storage`, as ScalarConvert describes.
ScalarConversion :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                     callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], node: int, operand: int, context: int, storage: int,
                     mode: int, rows: facts.Row[]) -> ScalarOperands {
    own := ScalarOperandStorage(forest, text, callables, params, callable, names, types, members, constants, operand, context);
    if (own == storage) {
        return ScalarOperands.Built(rows);
    }
    if (own == TaskStorage && storage == BoolStorage) {
        output := rows;
        output.append(ScalarAt(forest, node, facts.TaskRunningRow, facts.BoolType, 0, 1, ""));
        return ScalarOperands.Built(output);
    }
    if (own == PointerStorage && storage == BoolStorage) {
        output := rows;
        output.extend([ScalarLiteral(forest, operand, facts.PointerType, 0),
            ScalarAt(forest, node, facts.CompareRow, facts.BoolType, facts.NotEqual, 2, "")]);
        return ScalarOperands.Built(output);
    }
    // Unproven optionals still test presence in a bool context. Proven
    // primitive reads have already emitted their payload at its own storage.
    if (own == UnionStorage && storage == BoolStorage &&
        ScalarOptional(types, ScalarHeldUnion(forest, text, callables, params, names, types, members, callable.package, operand))) {
        output := rows;
        output.extend([ScalarAt(forest, operand, facts.TagRow, facts.IntType, 0, 1, ""),
                       ScalarLiteral(forest, operand, facts.IntType, 0),
                       ScalarAt(forest, node, facts.CompareRow, facts.BoolType, facts.NotEqual, 2, "")]);
        return ScalarOperands.Built(output);
    }
    converts := [ScalarAt(forest, node, facts.ConvertRow, ScalarTypeOf(storage), mode, 1, "")];
    if (Integer(own) && storage == FloatStorage) {
        converts = [ScalarAt(forest, node, facts.ConvertRow, facts.DoubleType, mode, 1, ""), converts[0]];
    }
    output := rows;
    output.extend(converts);
    return ScalarOperands.Built(output);
}
// The rows of `node`, `T(value)` or `T(wrap: value)` of number storage
// `storage`, after `rows`: its value, then its conversion. As the conversion
// step types it, a clamped value has T as its context and a wrapped one none.
ScalarConverted :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                    callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], node: int, storage: int, rows: facts.Row[]) -> ScalarOperands {
    value := FirstMember(forest, Field(forest, node, syntax.FieldArguments));
    if (Is(forest, value, syntax.NamedArgument)) {
        return ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, node, Field(forest, value, syntax.FieldValue), 0,
                             storage, facts.Wrap, rows);
    }
    return ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, node, value, storage, storage, facts.Clamp,
                         rows);
}
// The rows of `node`, a shift of integer storage `storage`, after `rows`: its
// value, its count converted to `storage` at the count's range, then its
// Arithmetic row. As
// ShiftStep converts it, an untyped constant count is the value it folds to,
// or the type's largest when it does not fit, and a typed one clamps.
ScalarShifted :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                  callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], node: int, storage: int, rows: facts.Row[]) -> ScalarOperands {
    output := rows;
    switch ScalarOperand(forest, text, callables, params, callable, names, types, members, constants, Field(forest, node, syntax.FieldLeft), storage,
                         output) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output = built;
    }
    right := Field(forest, node, syntax.FieldRight);
    counted := ScalarOperandStorage(forest, text, callables, params, callable, names, types, members, constants, right, 0);
    if (counted == 0) {
        written := UntypedStorage(forest, text, right);
        switch FoldConstant(forest, text, callable.document, constants, names, callable.package, right, written) {
            case .Failed(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Waiting:
                return ScalarOperands.Failed(Diagnose(forest, right, 0, "a constant is not folded yet"));
            case .Folded(bits):
                exact := ExactStored(bits, written);
                if (ExactNegative(exact)) {
                    return ScalarOperands.Failed(Diagnose(forest, Unparenthesized(forest, right), 0,
                                                          "Shift count must not be negative"));
                }
                if (!ExactFits(exact, storage)) {
                    exact = ExactMax(storage);
                }
                output.append(ScalarLiteral(forest, right, ScalarTypeOf(storage), ExactWrapped(exact, storage)));
        }
    } else {
        if (Signed(counted)) {
            return ScalarOperands.Failed(Diagnose(forest, Unparenthesized(forest, right), 0,
                                                  "Shift count must be unsigned; convert it with u32(value)"));
        }
        switch ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, right, right, counted, storage,
                             facts.Clamp, output) {
            case .Failed(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Built(built):
                output = built;
        }
    }
    operator := facts.ShiftLeft;
    if (Operator(forest, node) == tk.Shr) {
        operator = facts.ShiftRight;
    }
    output.append(ScalarAt(forest, node, facts.ArithmeticRow, ScalarTypeOf(storage), operator, 2, ""));
    return ScalarOperands.Built(output);
}
// The rows of `node`, arithmetic of storage `storage`, after `rows`: its
// operands left to right, each converted to `storage`, then its Arithmetic
// or Unary row. EmitBody has typed it, so its operands are numbers that
// convert to that storage.
ScalarComputed :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                   callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], node: int, storage: int, rows: facts.Row[]) -> ScalarOperands {
    if (!Integer(storage) && !Floating(storage)) {
        return ScalarOperands.Failed(Diagnose(forest, node, 0, "scalar proof does arithmetic only on numbers"));
    }
    type := ScalarTypeOf(storage);
    operator := Operator(forest, node);
    if (Is(forest, node, syntax.UnaryExpression)) {
        value := facts.Negate;
        if (operator == tk.Complement) {
            value = facts.Complement;
        }
        row := ScalarAt(forest, node, facts.UnaryRow, type, value, 1, "");
        return ScalarSides(forest, text, callables, params, callable, names, types, members, constants, node, [Field(forest, node, syntax.FieldOperand)],
                           [storage], storage, row, rows);
    }
    row := ScalarAt(forest, node, facts.ArithmeticRow, type, ScalarArithmetic(operator), 2, "");
    sides := [Field(forest, node, syntax.FieldLeft), Field(forest, node, syntax.FieldRight)];
    return ScalarSides(forest, text, callables, params, callable, names, types, members, constants, node, sides, [storage, storage], storage, row,
                       rows);
}
// The facts operator of a logical source operator, 0 for any other.
ScalarLogic :: (operator: int) -> int {
    if (operator == tk.CmpAnd || operator == tk.AndKeyword) {
        return facts.LogicalAnd;
    }
    if (operator == tk.CmpOr || operator == tk.OrKeyword) {
        return facts.LogicalOr;
    }
    return 0;
}
ScalarNegated :: (operator: int) -> bool {
    return operator == tk.Not || operator == tk.NotKeyword;
}
// The rows of `node`, `left && right` or `left || right`, after `rows`: its
// left operand, its Logical row, then its right operand's rows, which the
// Logical row counts. EmitBody has typed both sides bool or optional; an
// optional is true when it is not nil.
ScalarLogical :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                  callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], node: int, rows: facts.Row[]) -> ScalarOperands {
    output := rows;
    left := Field(forest, node, syntax.FieldLeft);
    switch ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, left, left, BoolStorage,
                         BoolStorage, facts.Clamp, output) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output = built;
    }
    operator := ScalarLogic(Operator(forest, node));
    output.append(ScalarAt(forest, node, facts.LogicalRow, facts.BoolType, operator, 0, ""));
    at := length(output) - 1;
    right := Field(forest, node, syntax.FieldRight);
    switch ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, right, right, BoolStorage,
                         BoolStorage, facts.Clamp, output) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output = built;
    }
    logical := output[at];
    logical.count = length(output) - at - 1;
    output[at] = logical;
    return ScalarOperands.Built(output);
}
// The rows of `node` after `rows`: each of its `sides` where its `contexts`
// entry is expected, converted to `storage`, left to right, then `row`, the
// operation that consumes them.
ScalarSides :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], node: int, sides: int[], contexts: int[], storage: int,
                row: facts.Row, rows: facts.Row[]) -> ScalarOperands {
    output := rows;
    for (index in 0..<length(sides)) {
        switch ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, sides[index], sides[index],
                             contexts[index], storage, facts.Clamp, output) {
            case .Failed(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Built(built):
                output = built;
        }
    }
    output.append(row);
    return ScalarOperands.Built(output);
}
// An open switch while its arms are visited: its value's storage, and for a
// switch on a union variable, the union, the variable's ordinal and the arm
// that is its default, or -1.
ScalarSwitch :: struct {
    storage: int;
    held: int;
    subject: int;
    fallback: int;
}
// A statement of a body to visit, the alternative or end of the if
// statement `node`, the end of the switch or loop `node`, or the switch arm
// `node`, and how many names were in scope before it.
ScalarWork :: struct {
    node: int;
    phase: int;
    mark: int;
}
ScalarVisit: int : 0;
ScalarAlternative: int : 1;
ScalarClose: int : 2;
ScalarArm: int : 3;
// The arms of the switch statement `node`, in source order.
ScalarArms :: (forest: snapshot.SnapshotNode[], node: int) -> int[] {
    arms: int[] = [];
    for (member in Members(forest, node)) {
        if (Is(forest, member, syntax.SwitchArm)) {
            arms.append(member);
        }
    }
    return arms;
}
// Work that visits each statement of `block`, the first one last, since work
// is taken from its end.
ScalarBlock :: (forest: snapshot.SnapshotNode[], block: int, mark: int) -> ScalarWork[] {
    work: ScalarWork[] = [];
    members := Members(forest, block);
    index := length(members) - 1;
    while (index >= 0) {
        item: ScalarWork = {node: members[index], phase: ScalarVisit, mark: mark};
        work.append(item);
        index -= 1;
    }
    return work;
}
// Whether a break in `node` leaves the loop `node` is the body of: one not
// inside a loop of its own.
ScalarBreaks :: (forest: snapshot.SnapshotNode[], node: int) -> bool {
    if (Is(forest, node, syntax.BreakStatement)) {
        return true;
    }
    if (Is(forest, node, syntax.WhileStatement) || Is(forest, node, syntax.ForStatement)) {
        return false;
    }
    if (Is(forest, node, syntax.IfStatement)) {
        alternative := Field(forest, node, syntax.FieldAlternative);
        return ScalarBreaks(forest, Field(forest, node, syntax.FieldConsequence)) ||
               (alternative >= 0 && ScalarBreaks(forest, alternative));
    }
    if (Is(forest, node, syntax.SwitchStatement)) {
        for (arm in ScalarArms(forest, node)) {
            if (ScalarBreaks(forest, Field(forest, arm, syntax.FieldBody))) {
                return true;
            }
        }
        return false;
    }
    if (!Is(forest, node, syntax.Block)) {
        return false;
    }
    for (member in Members(forest, node)) {
        if (ScalarBreaks(forest, member)) {
            return true;
        }
    }
    return false;
}
// Whether `node` is a terminating statement, as stage zero requires at the
// end of a function with a result: a return, a block that ends in one, an if
// statement with an else whose branches both end in one, a switch with a
// default arm whose arms all end in one, or a while loop on the literal true
// that nothing breaks out of. A switch on a union covers each of its variants
// as EmitBody requires, so it needs no default arm. Stage zero also counts a
// condition it folds to true; the scalar proof takes only the literal.
ScalarEnds :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> bool {
    if (Is(forest, node, syntax.ReturnStatement)) {
        return true;
    }
    if (Is(forest, node, syntax.WhileStatement)) {
        condition := Unparenthesized(forest, Field(forest, node, syntax.FieldCondition));
        return Is(forest, condition, syntax.Boolean) && Text(forest, text, condition) == "true" &&
               !ScalarBreaks(forest, Field(forest, node, syntax.FieldBody));
    }
    if (Is(forest, node, syntax.IfStatement)) {
        alternative := Field(forest, node, syntax.FieldAlternative);
        return alternative >= 0 && ScalarEnds(forest, text, Field(forest, node, syntax.FieldConsequence)) &&
               ScalarEnds(forest, text, alternative);
    }
    if (Is(forest, node, syntax.SwitchStatement)) {
        defaulted := false;
        for (arm in ScalarArms(forest, node)) {
            if (!ScalarEnds(forest, text, Field(forest, arm, syntax.FieldBody))) {
                return false;
            }
            value := Field(forest, arm, syntax.FieldValue);
            defaulted = defaulted || value < 0 || Is(forest, value, syntax.VariantPattern);
        }
        return defaulted;
    }
    if (!Is(forest, node, syntax.Block) && !Is(forest, node, syntax.CallableBody)) {
        return false;
    }
    members := Members(forest, node);
    return length(members) > 0 && ScalarEnds(forest, text, members[length(members) - 1]);
}
// The storage of the variable a local declaration declares, as StatementStep
// types it: its declared type, or its value's storage where its value's
// inferred number storage is the context. 0 for a type that is not scalar.
ScalarDeclared :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                   callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], node: int) -> int {
    declared := Field(forest, node, syntax.FieldType);
    if (declared < 0) {
        value := Field(forest, node, syntax.FieldValue);
        return ScalarOperandStorage(forest, text, callables, params, callable, names, types, members, constants, value,
                                    ConstantExpressionStorage(forest, text, value));
    }
    // Reading a type may add an optional or pointer type; this analysis
    // keeps none of them.
    table := types;
    resolved := ReadType(forest, text, &table, names, callable.package, declared);
    if (resolved.container != 0) {
        return 0;
    }
    return resolved.storage;
}
// The record or union of the variable a local declaration of one declares:
// its declared type's, or its value's.
ScalarDeclaredRecord :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                         names: Name[], types: TypeDecl[], members: TypeMember[], callable: Callable, node: int) -> int {
    declared := Field(forest, node, syntax.FieldType);
    if (declared < 0) {
        value := Field(forest, node, syntax.FieldValue);
        pointer := ScalarPointerRecord(forest, text, callables, params, names, types, members, callable.package, value);
        if (pointer >= 0) { return pointer; }
        found := ScalarRecordOf(forest, text, callables, params, names, types, members, callable.package, value);
        if (found >= 0) {
            return found;
        }
        return ScalarHeldUnion(forest, text, callables, params, names, types, members, callable.package, value);
    }
    table := types;
    record := ReadType(forest, text, &table, names, callable.package, declared).record;
    // An unsupported descriptor must not escape its temporary type table.
    if (record >= length(types)) { return -1; }
    return record;
}
// Direct field writes need no parent captures. A nontrivial RHS precedes
// the current-root load; the postfix exchange emits no runtime instruction.
ScalarFieldAssigned :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                        callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[],
                        statement: int, record: int, field: int) -> ScalarOperands {
    destination := Field(forest, statement, syntax.FieldTarget);
    object := Unparenthesized(forest, Field(forest, destination, syntax.FieldObject));
    binding := ScalarVariable(names, Text(forest, text, object));
    type := ScalarRecordType(types, record);
    place := field - types[record].first;
    read := ScalarAt(forest, object, facts.ReadRow, type, binding.index, 0, "");
    incoming: facts.Row[] = [];
    operator := ScalarArithmetic(CompoundOperator(Operator(forest, statement)));
    value_type := ScalarTypeOf(members[field].storage);
    if (operator != 0) {
        incoming.extend([read, ScalarAt(forest, destination, facts.FieldRow, value_type, place, 1, "")]);
    }
    value := Field(forest, statement, syntax.FieldValue);
    switch ScalarElementValue(forest, text, callables, params, callable, names, types, members, constants,
                               value, ScalarMemberShape(members, field), incoming) {
        case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
        case .Built(built): incoming = built;
    }
    if (operator != 0) { incoming.append(ScalarAt(forest, statement, facts.ArithmeticRow, value_type, operator, 2, "")); }
    atom := Unparenthesized(forest, value);
    while (Is(forest, atom, syntax.UnaryExpression)) { atom = Unparenthesized(forest, Field(forest, atom, syntax.FieldOperand)); }
    simple := Is(forest, atom, syntax.Identifier) || Is(forest, atom, syntax.Number) ||
              Is(forest, atom, syntax.Boolean) || Is(forest, atom, syntax.Character) ||
              Is(forest, atom, syntax.String) || Is(forest, atom, syntax.Nil);
    changed: facts.Row[] = [];
    if (simple) { changed.append(read); changed.extend(incoming); }
    else {
        changed = incoming;
        changed.append(read);
        changed.append(ScalarAt(forest, statement, facts.OperandSwapRow, 0, 0, 1, ""));
    }
    changed.append(ScalarAt(forest, destination, facts.UpdateRow, type, place, 2, ""));
    rows := [ScalarAt(forest, statement, facts.AssignRow, type, binding.index, length(changed), "")];
    rows.extend(changed);
    return ScalarOperands.Built(rows);
}
// Inline record fields share a canonical root. Effects in the RHS precede
// the parent reload; compound assignment keeps only the old selected leaf.
ScalarFieldPlaceAssigned :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                        callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[],
                        statement: int, next_variable: ^int) -> ScalarOperands {
    destination := Unparenthesized(forest, Field(forest, statement, syntax.FieldTarget));
    variable := destination;
    nodes: int[] = [];
    while (Is(forest, variable, syntax.MemberExpression)) {
        nodes.append(variable);
        variable = Unparenthesized(forest, Field(forest, variable, syntax.FieldObject));
    }
    if (!Is(forest, variable, syntax.Identifier)) {
        return ScalarOperands.Failed(Diagnose(forest, destination, 0, "native record writes require an authored record variable"));
    }
    binding := ScalarVariable(names, Text(forest, text, variable));
    record := Canonical(types, binding.record);
    if (binding.storage != StructStorage || binding.container != 0 || record < 0 || types[record].kind != RecordDecl) {
        return ScalarOperands.Failed(Diagnose(forest, destination, 0, "native record writes require an authored record variable"));
    }
    root := ScalarRecordType(types, record);
    parent_types: int[] = [];
    path: facts.Row[] = [];
    selected: ValueType = {storage: 0, container: 0, record: -1};
    at := length(nodes) - 1;
    while (at >= 0) {
        field := FindField(types, members, record, Text(forest, text, Field(forest, nodes[at], syntax.FieldMember)));
        if (field < 0) {
            return ScalarOperands.Failed(Diagnose(forest, nodes[at], 0, "native record field is unavailable"));
        }
        selected = ScalarMemberShape(members, field);
        type := ScalarValueType(types, selected.storage, selected.container, selected.record);
        if (type == 0) {
            return ScalarOperands.Failed(Diagnose(forest, nodes[at], 0, "native record field requires a supported value type"));
        }
        parent_types.append(ScalarRecordType(types, record));
        path.append(ScalarAt(forest, nodes[at], facts.FieldRow, type, field - types[record].first, 1, ""));
        if (at > 0) {
            record = Canonical(types, selected.record);
            if (selected.storage != StructStorage || selected.container != 0 || record < 0 || types[record].kind != RecordDecl) {
                return ScalarOperands.Failed(Diagnose(forest, nodes[at], 0, "native record writes require inline authored-record fields"));
            }
        }
        at -= 1;
    }
    value := Field(forest, statement, syntax.FieldValue);
    value_type := path[length(path) - 1].type;
    operator := ScalarArithmetic(CompoundOperator(Operator(forest, statement)));
    if (operator != 0 && (!Numeric(selected.storage) || selected.container != 0 || selected.record >= 0)) {
        return ScalarOperands.Failed(Diagnose(forest, destination, 0, "native record compound assignment requires a numeric field"));
    }
    read := ScalarAt(forest, variable, facts.ReadRow, root, binding.index, 0, "");
    incoming: facts.Row[] = [];
    if (operator != 0) { incoming.append(read); incoming.extend(path); }
    switch ScalarElementValue(forest, text, callables, params, callable, names, types, members, constants,
                               value, selected, incoming) {
        case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
        case .Built(built): incoming = built;
    }
    if (operator != 0) { incoming.append(ScalarAt(forest, statement, facts.ArithmeticRow, value_type, operator, 2, "")); }
    rows: facts.Row[] = [];
    changed: facts.Row[] = [];
    variables := next_variable^;
    // One parent capture per prefix bounds ownership to this write, with
    // no repeated field lookup or root-to-leaf expansion.
    rows.append(ScalarAt(forest, statement, facts.ScopeRow, 0, 0, 0, ""));
    replacement := variables;
    rows.extend(ScalarCapture(forest, statement, value_type, variables, incoming));
    variables += 1;
    current := variables;
    rows.extend(ScalarCapture(forest, statement, root, variables, [read]));
    variables += 1;
    parents: int[] = [current];
    for (prefix in 0..<length(path) - 1) {
        expression := [ScalarAt(forest, statement, facts.ReadRow, parent_types[prefix], current, 0, ""), path[prefix]];
        rows.extend(ScalarCapture(forest, statement, path[prefix].type, variables, expression));
        current = variables;
        parents.append(current);
        variables += 1;
    }
    for (parent, prefix in parents) { changed.append(ScalarAt(forest, statement, facts.ReadRow, parent_types[prefix], parent, 0, "")); }
    changed.append(ScalarAt(forest, statement, facts.ReadRow, value_type, replacement, 0, ""));
    prefix := length(path) - 1;
    while (prefix >= 0) {
        changed.append(ScalarAt(forest, nodes[length(path) - 1 - prefix], facts.UpdateRow, parent_types[prefix], path[prefix].value, 2, ""));
        prefix -= 1;
    }
    rows.append(ScalarAt(forest, statement, facts.AssignRow, root, binding.index, length(changed), ""));
    rows.extend(changed);
    rows.append(ScalarAt(forest, statement, facts.EndRow, 0, 0, 0, ""));
    next_variable^ = variables;
    return ScalarOperands.Built(rows);
}
// The operand rows of the compound assignment `node` to a variable of
// `storage` after `rows`, as StatementStep combines them: a read of the
// variable, then the value converted to its storage, then their combination.
// The language has no compound shift.
ScalarAssigned :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                   callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], node: int, storage: int, rows: facts.Row[]) -> ScalarOperands {
    destination := Field(forest, node, syntax.FieldTarget);
    ordinal := ScalarVariable(names, Text(forest, text, destination)).index;
    type := ScalarTypeOf(storage);
    output := rows;
    output.append(ScalarAt(forest, destination, facts.ReadRow, type, ordinal, 0, ""));
    value := Field(forest, node, syntax.FieldValue);
    switch ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, value, value, storage, storage, facts.Clamp,
                         output) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(built):
            output = built;
    }
    operator := ScalarArithmetic(CompoundOperator(Operator(forest, node)));
    output.append(ScalarAt(forest, node, facts.ArithmeticRow, type, operator, 2, ""));
    return ScalarOperands.Built(output);
}
// How a statement's operand rows are built: its value converted from
// `context` to `storage`, a compound assignment's combination, a range's two
// bounds, a value of record `record`, an assignment to field `field` of a
// variable of record `record`, the Tag of the union variable `subject`, an
// array of the elements `shape` describes, copied when `copied`, an assignment to an
// array's element, a change of array variable `object` by `operator`, the array a loop
// visits, or none.
ScalarPlan :: union {
    Failed(diagnostic: syntax.Diagnostic) | Converted(value: int, context: int, storage: int) | Compound(storage: int) |
    Range(first: int, last: int) | Record(value: int, record: int) | Pointer(value: int) | Member(record: int, field: int) |
    Tagged(subject: int) | Subject(value: int, held: int) | Array(value: int, shape: ValueType, copied: bool) | Element | Changed(object: int, operator: int) |
    Iterated(value: int, copied: bool) | MapIterated(value: int, record: int, copied: bool) |
    Mapped(value: int, record: int, copied: bool) |
    MapEdited(change: ScalarMapCall) | Bare | DeepMember
}
// The plan of `statement`'s operands: a return's value, widened to the result
// as the return step widens it; a local's initial value; an assignment's
// value; an if statement's, a while loop's or an assert's condition; a
// switch's integer value or a union variable's Tag; a range loop's bounds; or
// none for a break or a continue. EmitBody has rejected any other mismatch. ScalarFunction converts the value itself, so a statement adds no
// frame under the nesting its operands may take.
ScalarPlanned :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                  callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], statement: int,
                  mutated: string[], stored: string[]) -> ScalarPlan {
    value := Field(forest, statement, syntax.FieldValue);
    if (Is(forest, statement, syntax.StateDeclaration)) {
        table := types;
        declared := StateType(forest, text, &table, 0, statement);
        if (!ScalarRetainedArrays(table, members, declared.storage, declared.container, declared.record)) {
            return ScalarPlan.Failed(Diagnose(forest, statement, 0,
                "native retained arrays require non-nominal numeric/bool elements"));
        }
    }
    map_change := ScalarMapChange(forest, text, callables, names, types, callable.package, statement);
    if (map_change.operator != 0) { return ScalarPlan.MapEdited(map_change); }
    if (Is(forest, statement, syntax.ReturnStatement)) {
        returned := ScalarReturned(forest, statement);
        if (returned.message != "") {
            return ScalarPlan.Failed(returned);
        }
        if (callable.result_container == MapContainer) {
            return ScalarPlan.Mapped(value, callable.result_record, true);
        }
        if (callable.result_container == ArrayContainer) {
            returned_shape: ValueType = {storage: callable.result, container: ArrayContainer,
                                         record: callable.result_record};
            if (ScalarArrayType(types, callable.result, callable.result_record) == 0) {
                return ScalarPlan.Failed(Diagnose(forest, statement, 0, "scalar proof supports only arrays of numbers, bool, strings, records and unions"));
            }
            // A parameter's array is the caller's, so a return copies it.
            return ScalarPlan.Array(value, returned_shape, ScalarKeptRead(forest, text, names, value));
        }
        if (callable.result == StructStorage || callable.result == UnionStorage) {
            return ScalarPlan.Record(value, callable.result_record);
        }
        if (callable.result == PointerStorage) { return ScalarPlan.Pointer(value); }
        return ScalarPlan.Converted(value, callable.result, callable.result);
    }
    if (Is(forest, statement, syntax.IfStatement) || Is(forest, statement, syntax.WhileStatement)) {
        return ScalarPlan.Converted(Field(forest, statement, syntax.FieldCondition), BoolStorage, BoolStorage);
    }
    if (Is(forest, statement, syntax.ForStatement)) {
        first := Field(forest, statement, syntax.FieldFirst);
        if (first < 0) {
            visited := Field(forest, statement, syntax.FieldValue);
            map := ScalarMapShape(forest, text, callables, names, types, callable.package, visited);
            if (map >= 0 && Field(forest, statement, syntax.FieldReference) < 0 &&
                Field(forest, statement, syntax.FieldReverse) < 0) {
                body := Field(forest, statement, syntax.FieldBody);
                changed := EvaluationChanges(forest, text, callables, params, [], names, callable.package, body, true);
                copied := ScalarMapSnapshot(forest, text, params, callable, names, types, visited, changed);
                return ScalarPlan.MapIterated(visited, map, copied);
            }
            if (visited >= 0 && Field(forest, statement, syntax.FieldReference) < 0 &&
                ScalarArrayType(types, ScalarVisitedShape(forest, text, callables, params, callable, names, types, members,
                                                          constants, visited).storage,
                                ScalarVisitedShape(forest, text, callables, params, callable, names, types, members,
                                                   constants, visited).record) != 0) {
                copied := false;
                // A fresh iterator owns its result already. Only a scoped
                // receiver needs forwarded-call discovery for other aliases.
                if (ScalarBorrowed(forest, Unparenthesized(forest, visited))) {
                    body := Field(forest, statement, syntax.FieldBody);
                    name := RootName(forest, text, visited);
                    found := Lookup(names, name);
                    changed: string[] = [];
                    if (found >= 0 && names[found].index >= 0 && names[found].index < callable.count &&
                        params[callable.first + names[found].index].reference) {
                        changed = EvaluationChanges(forest, text, callables, params, [], names, callable.package, body, true);
                    } else {
                        changed = MutatedNames(forest, text, body, AddressedNames(forest, text, body, []));
                    }
                    copied = ScalarArraySnapshot(forest, text, params, callable, names, visited, changed);
                }
                return ScalarPlan.Iterated(visited, copied);
            }
            return ScalarPlan.Failed(Diagnose(forest, statement, 0, "scalar proof iterates only int ranges, arrays and scalar maps"));
        }
        return ScalarPlan.Range(first, Field(forest, statement, syntax.FieldLast));
    }
    if (Is(forest, statement, syntax.BreakStatement) || Is(forest, statement, syntax.ContinueStatement)) {
        return ScalarPlan.Bare;
    }
    if (Is(forest, statement, syntax.SwitchStatement)) {
        storage := ScalarOperandStorage(forest, text, callables, params, callable, names, types, members, constants, value,
                                        InferredNumberStorage(forest, text, value));
        if (storage == UnionStorage) {
            // Each arm's bindings read the union again, so it is a variable,
            // or a hidden local that holds it.
            subject := Unparenthesized(forest, value);
            held := ScalarHeldUnion(forest, text, callables, params, names, types, members, callable.package, value);
            matched := ScalarMatchedUnion(types, held);
            if (matched != held) { return ScalarPlan.Subject(value, matched); }
            if (!Is(forest, subject, syntax.Identifier)) {
                if (held < 0) {
                    return ScalarPlan.Failed(Diagnose(forest, value, 0, "scalar proof switches only on unions of the source"));
                }
                return ScalarPlan.Subject(value, held);
            }
            return ScalarPlan.Tagged(subject);
        }
        if (facts.Bits(ScalarTypeOf(storage)) == 0) {
            return ScalarPlan.Failed(Diagnose(forest, value, 0, "scalar proof switches only on integers"));
        }
        return ScalarPlan.Converted(value, storage, storage);
    }
    if (Is(forest, statement, syntax.Assignment)) {
        destination := Field(forest, statement, syntax.FieldTarget);
        if (Is(forest, destination, syntax.MemberExpression) &&
            Is(forest, Unparenthesized(forest, Field(forest, destination, syntax.FieldObject)), syntax.Identifier)) {
            field := ScalarMember(forest, text, callables, params, names, types, members, callable.package, destination);
            if (field >= 0) {
                record := ScalarRecordOf(forest, text, callables, params, names, types, members, callable.package,
                                         Field(forest, destination, syntax.FieldObject));
                return ScalarPlan.Member(record, field);
            }
        }
        if (Is(forest, destination, syntax.IndexExpression) ||
            (Is(forest, destination, syntax.MemberExpression) &&
             Is(forest, Unparenthesized(forest, Field(forest, destination, syntax.FieldObject)), syntax.IndexExpression))) {
            return ScalarPlan.Element;
        }
        if (Is(forest, destination, syntax.MemberExpression)) { return ScalarPlan.DeepMember; }
        if (!Is(forest, destination, syntax.Identifier)) {
            return ScalarPlan.Failed(Diagnose(forest, destination, 0,
                                              "scalar proof assigns only variables, their fields and array elements"));
        }
        binding := ScalarVariable(names, Text(forest, text, destination));
        if (binding.container == MapContainer) {
            return ScalarPlan.Mapped(value, binding.record, true);
        }
        if (binding.container == ArrayContainer) {
            assigned: ValueType = {storage: binding.storage, container: ArrayContainer, record: binding.record};
            if (ScalarArrayType(types, binding.storage, binding.record) == 0 ||
                CompoundOperator(Operator(forest, statement)) != NoOperator) {
                return ScalarPlan.Failed(Diagnose(forest, statement, 0, "scalar proof assigns arrays only by ="));
            }
            return ScalarPlan.Array(value, assigned, true);
        }
        if (binding.storage == StructStorage || binding.storage == UnionStorage) {
            return ScalarPlan.Record(value, binding.record);
        }
        if (binding.storage == PointerStorage) { return ScalarPlan.Pointer(value); }
        storage := binding.storage;
        if (CompoundOperator(Operator(forest, statement)) != NoOperator) {
            return ScalarPlan.Compound(storage);
        }
        return ScalarPlan.Converted(value, storage, storage);
    }
    changed := ScalarChangeOf(forest, text, callables, params, names, types, members, callable.package, statement);
    if (changed >= 0) {
        return ScalarPlan.Changed(changed, ScalarChangeKind(forest, text, statement));
    }
    condition := ScalarAsserted(forest, text, callables, names, callable, statement);
    if (condition >= 0) {
        return ScalarPlan.Converted(condition, BoolStorage, BoolStorage);
    }
    discarded := ScalarDiscarded(forest, text, callables, names, types, callable, statement);
    if (discarded.storage != 0) {
        if (discarded.container == MapContainer) {
            return ScalarPlan.Mapped(FirstMember(forest, statement), discarded.record, false);
        }
        // A fresh result: an array of it is no copy of a variable's.
        if (discarded.container == ArrayContainer) {
            return ScalarPlan.Array(FirstMember(forest, statement), discarded, false);
        }
        if (discarded.storage == StructStorage) {
            return ScalarPlan.Record(FirstMember(forest, statement), discarded.record);
        }
        return ScalarPlan.Converted(FirstMember(forest, statement), discarded.storage, discarded.storage);
    }
    if (!Is(forest, statement, syntax.LocalDeclaration) && !Is(forest, statement, syntax.StateDeclaration)) {
        return ScalarPlan.Failed(Diagnose(forest, statement, 0,
                                          "scalar proof supports only locals, assignments, asserts, if statements, switches, loops and returns"));
    }
    local_map := ScalarLocalMap(forest, text, callables, names, types, callable, statement);
    if (local_map >= 0) { return ScalarPlan.Mapped(value, local_map, true); }
    shape := ScalarLocalArray(forest, text, callables, params, callable, names, types, members, constants, statement);
    if (shape.storage != 0) {
        if (ScalarArrayType(types, shape.storage, shape.record) == 0 || value < 0) {
            return ScalarPlan.Failed(Diagnose(forest, statement, 0, "scalar proof supports only arrays of numbers, bool, strings, records and unions with a value"));
        }
        // `x := p` of a lent array parameter that neither is changed or stored
        // whole is a name for the same array, not a copy of it.
        copy := true;
        borrowed := Unparenthesized(forest, value);
        if (Is(forest, borrowed, syntax.Identifier) && Is(forest, statement, syntax.LocalDeclaration)) {
            found := Lookup(names, Text(forest, text, borrowed));
            alias := Text(forest, text, Field(forest, statement, syntax.FieldName));
            if (found >= 0 && names[found].place == ParameterPlace && names[found].container == ArrayContainer &&
                !Holds(mutated, alias) && !Holds(stored, alias) &&
                !Holds(mutated, names[found].name) && !Holds(stored, names[found].name)) {
                copy = false;
            }
        }
        return ScalarPlan.Array(value, shape, copy);
    }
    storage := ScalarDeclared(forest, text, callables, params, callable, names, types, members, constants, statement);
    if (storage == StructStorage) {
        return ScalarPlan.Record(value, ScalarDeclaredRecord(forest, text, callables, params, names, types, members, callable,
                                                             statement));
    }
    if (storage == UnionStorage) {
        held := ScalarDeclaredRecord(forest, text, callables, params, names, types, members, callable, statement);
        return ScalarPlan.Record(value, held);
    }
    if (storage == PointerStorage) {
        record := ScalarDeclaredRecord(forest, text, callables, params, names, types, members, callable, statement);
        if (value < 0 || ScalarPointerType(types, record) == 0 || Is(forest, statement, syntax.StateDeclaration)) {
            return ScalarPlan.Failed(Diagnose(forest, statement, 0, "native managed pointer locals require a numeric or bool pointee and cannot be retained"));
        }
        return ScalarPlan.Pointer(value);
    }
    if (ScalarTypeOf(storage) == 0) {
        return ScalarPlan.Failed(Diagnose(forest, statement, 0, "scalar proof supports only number, bool and string values"));
    }
    if (Field(forest, statement, syntax.FieldType) < 0) {
        return ScalarPlan.Converted(value, ConstantExpressionStorage(forest, text, value), storage);
    }
    return ScalarPlan.Converted(value, storage, storage);
}
// The type a call statement's result has, which nothing reads: a call of a
// function of the source, whatever it gives (a record of several results
// included), or of a foreign function that gives a number or bool. Its storage
// is 0 for any other statement.
ScalarDiscarded :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], names: Name[],
                    types: TypeDecl[], callable: Callable, statement: int) -> ValueType {
    none: ValueType = {storage: 0, container: 0, record: -1};
    call := FirstMember(forest, statement);
    // `await F(...)` as a statement discards F's result.
    if (Is(forest, statement, syntax.ExpressionStatement) && Is(forest, call, syntax.AwaitExpression)) {
        call = Unparenthesized(forest, Field(forest, call, syntax.FieldValue));
    }
    if (!Is(forest, statement, syntax.ExpressionStatement) || !Is(forest, call, syntax.CallExpression)) {
        return none;
    }
    callee := CalledFunction(forest, text, callables, [], names, callable.package, call);
    if (callee >= 0) {
        target := callables[callee];
        found: ValueType = {storage: target.result, container: target.result_container, record: target.result_record};
        // `F(...)` of a waiting F starts a task, and its handle is discarded.
        if (target.waits && !ImmediatelyAwaited(forest, call)) {
            found = {storage: TaskStorage, container: 0, record: callee};
            return found;
        }
        if (ScalarValueType(types, found.storage, found.container, found.record) == 0) {
            return none;
        }
        return found;
    }
    if (ScalarTextOperator(forest, text, call) == facts.TextPrint) {
        return {storage: IntStorage, container: 0, record: -1};
    }
    imported := ScalarForeignDeclaration(forest, text, call);
    if (imported < 0 || ScalarTypeOf(ScalarForeignResult(forest, text, imported)) == 0) {
        return none;
    }
    returned: ValueType = {storage: ScalarForeignResult(forest, text, imported), container: 0, record: -1};
    return returned;
}
// The condition of `statement` when it is an assert, as the call step finds
// one: a call of `assert` that names no function of the package, its
// condition the first argument or the one named Condition. Otherwise -1.
ScalarAsserted :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], names: Name[],
                   callable: Callable, statement: int) -> int {
    call := FirstMember(forest, statement);
    if (!Is(forest, statement, syntax.ExpressionStatement) || !Is(forest, call, syntax.CallExpression)) {
        return -1;
    }
    function := Field(forest, call, syntax.FieldFunction);
    if (!Is(forest, function, syntax.Identifier) || !NameMatches("assert", Text(forest, text, function)) ||
        CalledFunction(forest, text, callables, [], names, callable.package, call) >= 0) {
        return -1;
    }
    arguments := Members(forest, Field(forest, call, syntax.FieldArguments));
    for (argument in arguments) {
        if (Is(forest, argument, syntax.NamedArgument) &&
            NameMatches("Condition", Text(forest, text, Field(forest, argument, syntax.FieldName)))) {
            return Field(forest, argument, syntax.FieldValue);
        }
    }
    return arguments[0];
}
// A function's rows: its signature, then its body's statement rows in source
// order, each followed by its operand rows. Operands count against one bound
// per function. The walk keeps the ordinary compiler's scopes: a block's
// names end with it.
ScalarFunction :: (forest: snapshot.SnapshotNode[], text: string, key: string, solid: int[], callables: Callable[],
                   params: Param[], types: TypeDecl[], members: TypeMember[], constants: ConstDecl[], function: int, ops: Ops,
                   target: Target, aliases: Name[], changed_fields: string[], assertions: ScalarAssertion[],
                   first_assertion: int, last_assertion: int, math_values: bool) -> ScalarOperands {
    callable := callables[function];
    result := ScalarValueType(types, callable.result, callable.result_container, callable.result_record);
    rows: facts.Row[] = [ScalarAt(forest, callable.node, facts.FunctionRow, result, 0, callable.count, callable.name)];
    for (index in 0..<callable.count) {
        param := params[callable.first + index];
        type := ScalarValueType(types, param.storage, param.container, param.record);
        parameter := ScalarAt(forest, param.node, facts.ParameterRow, type, index, 0, param.name);
        if (param.reference) {
            parameter.literal = i64(facts.ParameterReadonlyReference);
            if (param.written) { parameter.literal = i64(facts.ParameterReference); }
        } else if (param.written) {
            // A parameter the function changes is its own: the caller gives it
            // an array no one else holds.
            parameter.literal = i64(facts.ParameterOwnedArray);
        }
        rows.append(parameter);
    }
    // A function with no result, whose view returns int 0.
    nothing := callable.results == 0 && Field(forest, callable.node, syntax.FieldResults) < 0 &&
               !ScalarReturnsValue(forest, Field(forest, callable.node, syntax.FieldBody));
    if (nothing && callable.waits) { rows[0].value = facts.FunctionVoid; }
    // Named results are locals after the parameters, each starting at its
    // zero, as the prologue binds them.
    for (index in 0..<callable.results) {
        named := params[callable.first + callable.count + index];
        type := ScalarValueType(types, named.storage, named.container, named.record);
        rows.append(ScalarAt(forest, named.node, facts.LocalRow, type, callable.count + index, 1, named.name));
        if (named.container == MapContainer) {
            rows.append(ScalarAt(forest, named.node, facts.MapRow, type, facts.MapNew, 0, ""));
        } else if (named.container == ArrayContainer) {
            rows.append(ScalarAt(forest, named.node, facts.ArrayRow, type, facts.ArrayNew, 0, ""));
        } else if (named.storage == StructStorage) {
            rows.append(ScalarAt(forest, named.node, facts.ZeroRow, type, 0, 0, ""));
        } else if (named.storage == UnionStorage && ScalarOptional(types, named.record)) {
            rows.append(ScalarAt(forest, named.node, facts.MakeRow, type, 0, 0, ""));
        } else {
            rows.append(ScalarLiteral(forest, named.node, type, 0));
        }
    }
    empty_names: string[] = [];
    names: Name[] = [];
    switch Prologue(forest, text, params, callable, aliases, key, solid, 0, empty_names, empty_names, empty_names, ops, target) {
        case .Begun(work, begun_names, slots, locals, cells, hosts, code, points, named):
            names = begun_names;
    }
    // Each parameter's and named result's binding holds its ordinal.
    for (at in 0..<length(names)) {
        for (index in 0..<callable.count + callable.results) {
            if (names[at].node == params[callable.first + index].node) {
                binding := names[at];
                binding.index = index;
                // An array parameter the function changes is a variable of its
                // own, as a copy of it would be.
                if (index < callable.count && params[callable.first + index].written &&
                    !params[callable.first + index].reference &&
                    params[callable.first + index].container == ArrayContainer) {
                    binding.place = LocalPlace;
                    binding.writable = true;
                }
                names[at] = binding;
            }
        }
    }
    variables := callable.count + callable.results;
    body := Field(forest, callable.node, syntax.FieldBody);
    // A written array parameter is a local copy of the caller's array, which
    // a call lends; a record is copied by value.
    written := MutatedNames(forest, text, body, []);
    usage := ScalarStoredNames(forest, text, body, changed_fields);
    kept_whole := usage.names;
    opening := forest[body].first_child;
    for (index in 0..<callable.count) {
        param := params[callable.first + index];
        if (param.container != ArrayContainer || param.written || NamePosition(written, param.name) < 0) {
            continue;
        }
        type := ScalarValueType(types, param.storage, param.container, param.record);
        rows.append(ScalarAt(forest, opening, facts.LocalRow, type, variables, 2, param.name));
        rows.append(ScalarAt(forest, opening, facts.ReadRow, type, index, 0, ""));
        rows.append(ScalarAt(forest, opening, facts.ArrayRow, type, facts.ArrayCopy, 1, ""));
        copy: Name = {owned: false, name: param.name, place: LocalPlace, index: variables, storage: param.storage,
                      container: ArrayContainer, record: param.record, writable: true, node: param.node};
        names.append(copy);
        variables += 1;
    }
    work := ScalarBlock(forest, body, length(names));
    operands: facts.Row[] = [];
    switches: ScalarSwitch[] = [];
    while (length(work) > 0) {
        item := work[length(work) - 1];
        work = slice(work, 0, length(work) - 1);
        statement := item.node;
        if (item.phase == ScalarClose) {
            names = slice(names, 0, item.mark);
            if (Is(forest, statement, syntax.SwitchStatement)) {
                switches = slice(switches, 0, length(switches) - 1);
            }
            rows.append(ScalarAt(forest, statement, facts.EndRow, 0, 0, 0, ""));
            continue;
        }
        if (item.phase == ScalarAlternative) {
            names = slice(names, 0, item.mark);
            alternative := Field(forest, statement, syntax.FieldAlternative);
            rows.append(ScalarAt(forest, alternative, facts.ElseRow, 0, 0, 0, ""));
            if (Is(forest, alternative, syntax.IfStatement)) {
                visit: ScalarWork = {node: alternative, phase: ScalarVisit, mark: item.mark};
                work.append(visit);
            } else {
                work.extend(ScalarBlock(forest, alternative, item.mark));
            }
            continue;
        }
        if (item.phase == ScalarArm) {
            // As the switch step tests an arm: its value converted to the
            // switch value's storage, or a union arm's variant ordinal, with
            // the arm's names its own.
            names = slice(names, 0, item.mark);
            current := switches[length(switches) - 1];
            pattern := Field(forest, statement, syntax.FieldValue);
            first := length(operands);
            tested := ScalarOperands.Built(operands);
            variant: int = -1;
            if (pattern >= 0 && current.held >= 0) {
                variant = FindVariant(types, current.held, Text(forest, text, Field(forest, pattern, syntax.FieldName)));
            }
            if (variant >= 0 && statement != current.fallback) {
                name := Field(forest, pattern, syntax.FieldName);
                literal := operands;
                literal.append(ScalarLiteral(forest, name, facts.IntType, u64(variant - types[current.held].first)));
                tested = ScalarOperands.Built(literal);
            } else if (pattern >= 0 && current.held < 0) {
                tested = ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, pattern,
                                       pattern, current.storage, current.storage, facts.Clamp, operands);
            }
            switch tested {
                case .Failed(diagnostic):
                    return ScalarOperands.Failed(diagnostic);
                case .Built(built):
                    operands = built;
            }
            rows.append(ScalarAt(forest, statement, facts.CaseRow, ScalarTypeOf(current.storage), 0,
                                 length(operands) - first, ""));
            for (at in first..<length(operands)) {
                rows.append(operands[at]);
            }
            if (variant >= 0) {
                // Each binding is a local copy of its payload, as MatchStep
                // binds it. A union's payloads are consecutive members.
                held_type := ScalarRecordType(types, current.held);
                payloads := types[types[current.held].first].first;
                bindings := Members(forest, Field(forest, pattern, syntax.FieldBindings));
                for (position in 0..<length(bindings)) {
                    binding := bindings[position];
                    field := types[variant].first + position;
                    type := ScalarMemberType(types, members, field);
                    name := Text(forest, text, binding);
                    read := [ScalarAt(forest, binding, facts.ReadRow, held_type, current.subject, 0, ""),
                             ScalarAt(forest, binding, facts.PayloadRow, type, field - payloads, 1, "")];
                    operands.extend(read);
                    rows.append(ScalarAt(forest, binding, facts.LocalRow, type, variables, 2, name));
                    rows.extend(read);
                    bound: Name = {owned: false, name: name, place: LocalPlace, index: variables, storage: members[field].storage,
                                   container: members[field].container, record: members[field].record, writable: false,
                                   node: binding};
                    names.append(bound);
                    variables += 1;
                }
            }
            work.extend(ScalarBlock(forest, Field(forest, statement, syntax.FieldBody), item.mark));
            continue;
        }
        if (nothing && Is(forest, statement, syntax.ReturnStatement)) {
            rows.append(ScalarAt(forest, statement, facts.ReturnRow, 0, 0, 1, ""));
            rows.append(ScalarLiteral(forest, statement, facts.IntType, 0));
            continue;
        }
        if (callable.results > 0 && Is(forest, statement, syntax.ReturnStatement)) {
            switch ScalarNamedReturn(forest, text, callables, params, callable, names, types, members, constants,
                                     statement) {
                case .Failed(diagnostic):
                    return ScalarOperands.Failed(diagnostic);
                case .Built(returned):
                    rows.extend(returned);
            }
            continue;
        }
        if (Is(forest, statement, syntax.YieldStatement)) {
            // The turn is given up; the row gives int 0, a local nothing reads.
            rows.append(ScalarAt(forest, statement, facts.LocalRow, facts.IntType, variables, 1, "_"));
            rows.append(ScalarAt(forest, statement, facts.YieldRow, facts.IntType, 0, 0, ""));
            variables += 1;
            continue;
        }
        if (Is(forest, statement, syntax.ExpressionStatement) &&
            Is(forest, FirstMember(forest, statement), syntax.AwaitExpression)) {
            awaited := Unparenthesized(forest, Field(forest, FirstMember(forest, statement), syntax.FieldValue));
            callee := Field(forest, awaited, syntax.FieldFunction);
            if (Is(forest, awaited, syntax.CallExpression) && Is(forest, callee, syntax.Identifier) &&
                NameMatches(Text(forest, text, callee), "Delay") &&
                ScalarTaskCallee(forest, text, callables, names, callable, awaited) < 0) {
                arguments := Members(forest, Field(forest, awaited, syntax.FieldArguments));
                if (length(arguments) != 1) {
                    return ScalarOperands.Failed(Diagnose(forest, awaited, 0, "Delay requires one duration"));
                }
                switch ScalarOperand(forest, text, callables, params, callable, names, types, members, constants,
                                     arguments[0], DoubleStorage, []) {
                    case .Failed(diagnostic):
                        return ScalarOperands.Failed(diagnostic);
                    case .Built(built):
                        rows.append(ScalarAt(forest, statement, facts.LocalRow, facts.IntType, variables, length(built) + 1, "_"));
                        rows.extend(built);
                        rows.append(ScalarAt(forest, awaited, facts.DelayRow, facts.IntType, 0, 1, ""));
                        variables += 1;
                }
                continue;
            }
        }
        if (Is(forest, statement, syntax.ExpressionStatement) &&
            Is(forest, FirstMember(forest, statement), syntax.AwaitExpression) &&
            !Is(forest, Unparenthesized(forest, Field(forest, FirstMember(forest, statement), syntax.FieldValue)),
                syntax.CallExpression)) {
            // `await handle` as a statement waits for the task and discards its result.
            handle := Field(forest, FirstMember(forest, statement), syntax.FieldValue);
            if (ScalarTaskCallee(forest, text, callables, names, callable, handle) < 0 ||
                ScalarOperandStorage(forest, text, callables, params, callable, names, types, members, constants,
                                     handle, 0) != TaskStorage) {
                return ScalarOperands.Failed(Diagnose(forest, handle, 0, "scalar proof awaits only a task"));
            }
            switch ScalarOperand(forest, text, callables, params, callable, names, types, members, constants, handle,
                                 TaskStorage, []) {
                case .Failed(diagnostic):
                    return ScalarOperands.Failed(diagnostic);
                case .Built(built):
                    rows.append(ScalarAt(forest, statement, facts.LocalRow, facts.IntType, variables, length(built) + 1, "_"));
                    rows.extend(built);
                    rows.append(ScalarAt(forest, FirstMember(forest, statement), facts.AwaitRow, facts.IntType, 0, 1, ""));
                    variables += 1;
            }
            continue;
        }
        if (Is(forest, statement, syntax.CancelStatement)) {
            duration := Field(forest, statement, syntax.FieldDuration);
            handle := Field(forest, statement, syntax.FieldValue);
            held := ScalarTaskCallee(forest, text, callables, names, callable, handle);
            if (held < 0 || ScalarOperandStorage(forest, text, callables, params, callable, names, types, members, constants,
                                                 handle, 0) != TaskStorage) {
                return ScalarOperands.Failed(Diagnose(forest, handle, 0, "scalar proof cancels only a task"));
            }
            switch ScalarOperand(forest, text, callables, params, callable, names, types, members, constants, handle,
                                 TaskStorage, []) {
                case .Failed(diagnostic):
                    return ScalarOperands.Failed(diagnostic);
                case .Built(built):
                    task_rows := built;
                    kind := facts.CancelRow;
                    count: int = 1;
                    if (duration >= 0) {
                        switch ScalarOperand(forest, text, callables, params, callable, names, types, members,
                                             constants, duration, DoubleStorage, task_rows) {
                            case .Failed(diagnostic):
                                return ScalarOperands.Failed(diagnostic);
                            case .Built(timed):
                                task_rows = timed;
                        }
                        kind = facts.CancelAfterRow;
                        count = 2;
                    }
                    rows.append(ScalarAt(forest, statement, facts.LocalRow, facts.IntType, variables, length(task_rows) + 1, "_"));
                    rows.extend(task_rows);
                    rows.append(ScalarAt(forest, statement, kind, facts.IntType, 0, count, ""));
                    variables += 1;
            }
            continue;
        }
        // A pointer place is evaluated once before its RHS. Keeping the
        // descriptor in a hidden local also handles side effects in an index.
        if (Is(forest, statement, syntax.Assignment)) {
            destination := Unparenthesized(forest, Field(forest, statement, syntax.FieldTarget));
            shape: ValueType = {storage: 0, container: 0, record: -1};
            target_rows := ScalarOperands.Built([]);
            if (Is(forest, destination, syntax.DereferenceExpression) && !ScalarScopedDereference(forest, text, names, destination)) {
                pointer := Field(forest, destination, syntax.FieldOperand);
                record := ScalarPointerRecord(forest, text, callables, params, names, types, members, callable.package, pointer);
                if (record >= 0) {
                    shape = ScalarPointerElement(types, record);
                    if (shape.storage == 0) {
                        return ScalarOperands.Failed(Diagnose(forest, destination, 0, "native pointer writes require a non-null numeric or bool pointee"));
                    }
                    target_rows = ScalarOperand(forest, text, callables, params, callable, names, types, members, constants,
                                                pointer, PointerStorage, []);
                }
            } else if (Is(forest, destination, syntax.MemberExpression) &&
                       ScalarPointerObject(forest, text, callables, params, names, types, members, callable.package,
                                             Field(forest, destination, syntax.FieldObject)) >= 0) {
                field := ScalarMember(forest, text, callables, params, names, types, members, callable.package, destination);
                if (field >= 0) { shape = ScalarMemberShape(members, field); }
                target_rows = ScalarPointerFieldRows(forest, text, callables, params, callable, names, types, members, constants,
                                                     destination, []);
            }
            if (shape.storage != 0) {
                temporary := variables;
                switch target_rows {
                    case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
                    case .Built(evaluated):
                        rows.append(ScalarAt(forest, destination, facts.LocalRow, facts.PointerType, temporary,
                                              length(evaluated), "pointer target"));
                        rows.extend(evaluated);
                }
                variables += 1;
                switch ScalarPointerAssigned(forest, text, callables, params, callable, names, types, members, constants,
                                               statement, temporary, shape) {
                    case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
                    case .Built(evaluated):
                        // Capturing the destination precedes the RHS, even
                        // when that RHS replaces the containing record.
                        rows.append(ScalarAt(forest, Field(forest, statement, syntax.FieldValue), facts.LocalRow,
                                              ScalarValueType(types, shape.storage, shape.container, shape.record), variables, length(evaluated), "_"));
                        rows.extend(evaluated);
                }
                variables += 1;
                continue;
            }
        }
        if (math_values && Is(forest, statement, syntax.Assignment)) {
            switch ScalarMathAssigned(forest, text, callables, params, callable, names, types, members, constants,
                                       statement, &variables) {
                case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
                case .Built(assigned):
                    if (length(assigned) > 0) { rows.extend(assigned); continue; }
            }
        }
        first := length(operands);
        pattern_scope := false;
        pattern_mark := length(names);
        built := ScalarOperands.Built(operands);
        // The storage a converted value takes, which types a switch's arms,
        // and a switch's union variable, or -1.
        planned: int = 0;
        tagged: int = -1;
        hidden: int = -1;
        hidden_held: int = -1;
        appended: int = -1;
        iterated := false;
        map_iterated := -1;
        switch ScalarPlanned(forest, text, callables, params, callable, names, types, members, constants, statement, written,
                             kept_whole) {
            case .Failed(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Compound(storage):
                built = ScalarAssigned(forest, text, callables, params, callable, names, types, members, constants, statement, storage, operands);
            case .Record(value, record):
                built = ScalarRecordValue(forest, text, callables, params, callable, names, types, members, constants, value, record,
                                          operands);
            case .Pointer(value):
                built = ScalarOperand(forest, text, callables, params, callable, names, types, members, constants,
                                       value, PointerStorage, operands);
            case .Member(record, field):
                switch ScalarFieldAssigned(forest, text, callables, params, callable, names, types, members, constants,
                                           statement, record, field) {
                    case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
                    case .Built(assigned): rows.extend(assigned);
                }
                continue;
            case .DeepMember:
                switch ScalarFieldPlaceAssigned(forest, text, callables, params, callable, names, types, members, constants,
                                                statement, &variables) {
                    case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
                    case .Built(assigned): rows.extend(assigned);
                }
                continue;
            case .Converted(value, context, storage):
                planned = storage;
                if (usage.patterns && (Is(forest, statement, syntax.IfStatement) || Is(forest, statement, syntax.WhileStatement))) {
                    switch ScalarPatternCondition(forest, text, callables, params, callable, names, types, members, constants,
                                                   statement, value, variables, operands) {
                        case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
                        case .Built(captures, evaluated, bound, next_variable):
                            pattern_scope = length(captures) > 0;
                            if (pattern_scope) {
                                rows.append(ScalarAt(forest, statement, facts.ScopeRow, 0, 0, 0, ""));
                                rows.extend(captures);
                                work.append({node: statement, phase: ScalarClose, mark: pattern_mark});
                            }
                            names = bound;
                            variables = next_variable;
                            built = ScalarOperands.Built(evaluated);
                    }
                } else {
                    built = ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, value, value, context, storage,
                                          facts.Clamp, operands);
                }
            case .Range(first_bound, last_bound):
                // As the range step types them: each bound an int, an
                // untyped one taking int and a narrower one widening.
                built = ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, first_bound, first_bound,
                                      IntStorage, IntStorage, facts.Clamp, operands);
                switch built {
                    case .Failed(diagnostic):
                        return ScalarOperands.Failed(diagnostic);
                    case .Built(first_rows):
                        built = ScalarConvert(forest, text, callables, params, callable, names, types, members, constants, last_bound, last_bound,
                                              IntStorage, IntStorage, facts.Clamp, first_rows);
                }
            case .Tagged(subject):
                planned = IntStorage;
                tagged = subject;
                binding := ScalarVariable(names, Text(forest, text, subject));
                read := ScalarAt(forest, subject, facts.ReadRow, ScalarRecordType(types, binding.record),
                                 binding.index, 0, "");
                tagged := operands;
                tagged.extend([read, ScalarAt(forest, subject, facts.TagRow, facts.IntType, 0, 1, "")]);
                built = ScalarOperands.Built(tagged);
            case .Subject(value, held):
                // The union is evaluated once into a local of the switch's
                // own, which the Switch row reads and its arms read again.
                planned = IntStorage;
                hidden = variables;
                hidden_held = held;
                variables += 1;
                subject_type := ScalarRecordType(types, held);
                subject_rows := ScalarUnionValue(forest, text, callables, params, callable, names, types, members, constants,
                                                value, held, []);
                switch subject_rows {
                    case .Failed(diagnostic):
                        return ScalarOperands.Failed(diagnostic);
                    case .Built(evaluated):
                        subject_local := ScalarAt(forest, statement, facts.LocalRow, subject_type, hidden,
                                                  length(evaluated), "switch value");
                        subject_local.literal = i64(facts.SwitchSubject);
                        rows.append(subject_local);
                        rows.extend(evaluated);
                }
                tagged_rows := operands;
                tagged_rows.extend([ScalarAt(forest, value, facts.ReadRow, subject_type, hidden, 0, ""),
                                    ScalarAt(forest, value, facts.TagRow, facts.IntType, 0, 1, "")]);
                built = ScalarOperands.Built(tagged_rows);
            case .Array(value, shape, copied):
                built = ScalarArrayStored(forest, text, callables, params, callable, names, types, members, constants, value,
                                          shape, copied, operands);
            case .Mapped(value, record, copied):
                if (value < 0) {
                    zeroed := operands;
                    zeroed.append(ScalarAt(forest, statement, facts.MapRow, ScalarMapType(types, record), facts.MapNew, 0, ""));
                    built = ScalarOperands.Built(zeroed);
                } else {
                    built = ScalarMapValue(forest, text, callables, params, callable, names, types, members, constants,
                                           value, record, copied, operands);
                }
            case .MapEdited(change):
                appended = change.object;
                built = ScalarMapChanged(forest, text, callables, params, callable, names, types, members, constants,
                                         statement, change, operands);
            case .Element:
                switch ScalarElementAssigned(forest, text, callables, params, callable, names, types, members, constants,
                                               statement, &variables) {
                    case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
                    case .Built(assigned): rows.extend(assigned);
                }
                continue;
            case .Changed(object, operator):
                appended = object;
                built = ScalarChanged(forest, text, callables, params, callable, names, types, members, constants, statement,
                                      object, operator, operands);
            case .Iterated(value, copied):
                iterated = true;
                built = ScalarArrayStored(forest, text, callables, params, callable, names, types, members, constants, value,
                                          ScalarVisitedShape(forest, text, callables, params, callable, names, types, members, constants, value), copied,
                                          operands);
            case .MapIterated(value, record, copied):
                map_iterated = record;
                built = ScalarMapValue(forest, text, callables, params, callable, names, types, members, constants,
                                       value, record, copied, operands);
            case .Bare:
                built = ScalarOperands.Built(operands);
        }
        switch built {
            case .Failed(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Built(rows_built):
                operands = rows_built;
        }
        count := length(operands) - first;
        row := ScalarAt(forest, statement, facts.ReturnRow, 0, 0, count, "");
        projection: facts.Row[] = [];
        if (Is(forest, statement, syntax.WhileStatement) || Is(forest, statement, syntax.ForStatement)) {
            mark := length(names);
            if (pattern_scope) { mark = pattern_mark; }
            close: ScalarWork = {node: statement, phase: ScalarClose, mark: mark};
            work.append(close);
            if (Is(forest, statement, syntax.WhileStatement)) {
                row.kind = facts.WhileRow;
                if (pattern_scope) { row.literal = i64(facts.PatternLoop); }
            } else {
                // `for x, i in xs` names the item, then the index.
                declared := Field(forest, statement, syntax.FieldName);
                keyed := Field(forest, statement, syntax.FieldKey) >= 0;
                if (keyed) {
                    declared = Field(forest, statement, syntax.FieldKey);
                }
                name := Text(forest, text, declared);
                element := IntStorage;
                element_record := -1;
                element_container := 0;
                nested: ValueType = {storage: 0, container: 0, record: -1};
                row = ScalarAt(forest, statement, facts.ForRow, facts.IntType, variables, count, name);
                if (map_iterated >= 0) {
                    map := types[map_iterated];
                    element = map.value_storage;
                    element_record = map.value_record;
                    element_container = map.value_container;
                    if (keyed) { element = map.key; element_record = -1; element_container = 0; }
                    row.type = ScalarMapType(types, map_iterated);
                    row.literal = i64(facts.RangeMap);
                    if (keyed) { row.literal += i64(facts.RangeKeyed); }
                }
                if (iterated) {
                    visited := ScalarVisitedShape(forest, text, callables, params, callable, names, types, members, constants,
                                                  Field(forest, statement, syntax.FieldValue));
                    element = visited.storage;
                    element_record = visited.record;
                    if (visited.record >= 0 && ScalarNestedCollection(types[visited.record])) {
                        nested = SequenceElement(types, visited);
                    }
                    row.type = ScalarElementType(types, visited);
                    row.literal = i64(facts.RangeArray);
                    if (keyed) {
                        row.literal += i64(facts.RangeKeyed);
                    }
                }
                if (!iterated && map_iterated < 0 && Text(forest, text, Field(forest, statement, syntax.FieldBound)) == "..<") {
                    row.literal += i64(facts.RangeExclusive);
                }
                if (Field(forest, statement, syntax.FieldReverse) >= 0) {
                    row.literal += i64(facts.RangeReverse);
                }
                // As the range step binds it, read-only, for the body alone.
                binding: Name = {owned: false, name: name, place: LocalPlace, index: variables, storage: element, container: element_container,
                                 record: element_record, writable: false, node: declared};
                binding_position := length(names);
                names.append(binding);
                variables += 1;
                if (keyed) {
                    keyed_storage := IntStorage;
                    keyed_record := -1;
                    keyed_container := 0;
                    if (map_iterated >= 0) {
                        keyed_storage = types[map_iterated].value_storage;
                        keyed_record = types[map_iterated].value_record;
                        keyed_container = types[map_iterated].value_container;
                    }
                    index: Name = {owned: false, name: Text(forest, text, Field(forest, statement, syntax.FieldName)), place: LocalPlace,
                                   index: variables, storage: keyed_storage, container: keyed_container, record: keyed_record, writable: false,
                                   node: Field(forest, statement, syntax.FieldName)};
                    names.append(index);
                    variables += 1;
                }
                if (nested.storage != 0) {
                    // The For row binds the physical wrapper. Its source
                    // binding owns the immediate descriptor for this turn.
                    type := ScalarValueType(types, nested.storage, nested.container, nested.record);
                    body := Field(forest, statement, syntax.FieldBody);
                    projection = ScalarCapture(forest, body, type, variables,
                        [ScalarAt(forest, body, facts.ReadRow, row.type, row.value, 0, ""),
                         ScalarAt(forest, body, facts.FieldRow, type, 0, 1, "")]);
                    binding.index = variables;
                    binding.storage = nested.storage;
                    binding.container = nested.container;
                    binding.record = nested.record;
                    names[binding_position] = binding;
                    variables += 1;
                }
            }
            work.extend(ScalarBlock(forest, Field(forest, statement, syntax.FieldBody), mark));
        } else if (Is(forest, statement, syntax.SwitchStatement)) {
            row = ScalarAt(forest, statement, facts.SwitchRow, ScalarTypeOf(planned), 0, count, "");
            mark := length(names);
            close: ScalarWork = {node: statement, phase: ScalarClose, mark: mark};
            work.append(close);
            arms := ScalarArms(forest, statement);
            current: ScalarSwitch = {storage: planned, held: -1, subject: -1, fallback: -1};
            if (tagged >= 0 || hidden >= 0) {
                // The arms cover every variant, so with no default arm the
                // last is one.
                if (hidden >= 0) {
                    current.held = hidden_held;
                    current.subject = hidden;
                } else {
                    binding := ScalarVariable(names, Text(forest, text, tagged));
                    current.held = binding.record;
                    current.subject = binding.index;
                }
                current.fallback = arms[length(arms) - 1];
                for (arm in arms) {
                    if (Field(forest, arm, syntax.FieldValue) < 0) {
                        current.fallback = -1;
                    }
                }
            }
            switches.append(current);
            index := length(arms) - 1;
            while (index >= 0) {
                arm: ScalarWork = {node: arms[index], phase: ScalarArm, mark: mark};
                work.append(arm);
                index -= 1;
            }
        } else if (Is(forest, statement, syntax.BreakStatement)) {
            row.kind = facts.BreakRow;
        } else if (Is(forest, statement, syntax.ContinueStatement)) {
            row.kind = facts.ContinueRow;
        } else if (Is(forest, statement, syntax.IfStatement)) {
            row.kind = facts.IfRow;
            mark := length(names);
            if (pattern_scope) { mark = pattern_mark; }
            close: ScalarWork = {node: statement, phase: ScalarClose, mark: mark};
            work.append(close);
            if (Field(forest, statement, syntax.FieldAlternative) >= 0) {
                alternative: ScalarWork = {node: statement, phase: ScalarAlternative, mark: mark};
                work.append(alternative);
            }
            work.extend(ScalarBlock(forest, Field(forest, statement, syntax.FieldConsequence), mark));
        } else if (appended >= 0) {
            binding := ScalarVariable(names, Text(forest, text, RootOf(forest, appended)));
            row = ScalarAt(forest, statement, facts.AssignRow, ScalarValueType(types, binding.storage, binding.container, binding.record),
                           binding.index, count, "");
        } else if (ScalarDiscarded(forest, text, callables, names, types, callable, statement).storage != 0) {
            // The call's result goes to a local nothing reads.
            result := ScalarDiscarded(forest, text, callables, names, types, callable, statement);
            row = ScalarAt(forest, statement, facts.LocalRow,
                           ScalarValueType(types, result.storage, result.container, result.record), variables, count, "_");
            variables += 1;
        } else if (Is(forest, statement, syntax.ExpressionStatement)) {
            // As the assert step checks it, with its call's range.
            row = ScalarAt(forest, FirstMember(forest, statement), facts.AssertRow, 0, 0, count, "");
            first := first_assertion;
            last := last_assertion;
            while (first < last) {
                middle := first + (last - first) / 2;
                check := assertions[middle];
                if (check.start < row.start || (check.start == row.start && check.end < row.end)) { first = middle + 1; }
                else { last = middle; }
            }
            assert(first < last_assertion, "the body checker emitted the source assertion");
            message := assertions[first];
            assert(message.start == row.start && message.end == row.end, "the source assertion has its checked diagnostic");
            row.text = message.message;
        } else if (Is(forest, statement, syntax.Assignment)) {
            // The variable itself, or the one whose field is assigned.
            binding := ScalarVariable(names, Text(forest, text, RootOf(forest, Field(forest, statement, syntax.FieldTarget))));
            type := ScalarValueType(types, binding.storage, binding.container, binding.record);
            row = ScalarAt(forest, statement, facts.AssignRow, type, binding.index, count, "");
        } else if (Is(forest, statement, syntax.LocalDeclaration) || Is(forest, statement, syntax.StateDeclaration)) {
            retained := Is(forest, statement, syntax.StateDeclaration);
            declared := Field(forest, statement, syntax.FieldName);
            storage := ScalarDeclared(forest, text, callables, params, callable, names, types, members, constants, statement);
            record: int = -1;
            container: int = 0;
            shape := ScalarLocalArray(forest, text, callables, params, callable, names, types, members, constants, statement);
            map_record := ScalarLocalMap(forest, text, callables, names, types, callable, statement);
            if (map_record >= 0) {
                storage = UnionStorage;
                container = MapContainer;
                record = map_record;
            } else if (shape.storage != 0) {
                storage = shape.storage;
                container = ArrayContainer;
                record = shape.record;
            } else if (storage == StructStorage || storage == UnionStorage || storage == PointerStorage) {
                record = ScalarDeclaredRecord(forest, text, callables, params, names, types, members, callable, statement);
            } else if (storage == TaskStorage) {
                // The function whose task the variable holds.
                record = ScalarTaskCallee(forest, text, callables, names, callable, Field(forest, statement, syntax.FieldValue));
            }
            name := Text(forest, text, declared);
            type := ScalarValueType(types, storage, container, record);
            row = ScalarAt(forest, statement, facts.LocalRow, type, variables, count, name);
            if (retained) {
                scalar_array := container == ArrayContainer && (Numeric(storage) || storage == BoolStorage);
                if ((container != 0 && !scalar_array) || storage == UnionStorage || Field(forest, statement, syntax.FieldValue) < 0) {
                    return ScalarOperands.Failed(Diagnose(forest, statement, 0,
                                                          "a retained local is a number, bool, string, plain record or numeric/bool array with a value"));
                }
                row.literal = i64(facts.Retained);
                written := Field(forest, statement, syntax.FieldType);
                if (written >= 0) {
                    table := types;
                    nominal := ReadType(forest, text, &table, names, callable.package, written);
                    if (CharType(table, nominal.storage, nominal.container, nominal.record)) {
                        row.literal = i64(facts.Retained | facts.CharNominal);
                    }
                }
            }
            // As StatementStep binds it, after its value.
            binding: Name = {owned: false, name: name, place: LocalPlace, index: variables, storage: storage, container: container,
                             record: record, writable: true, node: declared};
            names.append(binding);
            variables += 1;
        }
        rows.append(row);
        for (at in first..<length(operands)) {
            rows.append(operands[at]);
        }
        rows.extend(projection);
    }
    if (ScalarEnds(forest, text, body)) {
        return ScalarOperands.Built(rows);
    }
    // A function with no result returns 0 at its end.
    if (nothing) {
        closing := ScalarClosing(forest, body);
        rows.append(ScalarAt(forest, closing, facts.ReturnRow, 0, 0, 1, ""));
        rows.append(ScalarLiteral(forest, closing, facts.IntType, 0));
        return ScalarOperands.Built(rows);
    }
    // A function with named results returns them at its end.
    if (callable.results == 0) {
        return ScalarOperands.Failed(Diagnose(forest, body, 0, "Missing return"));
    }
    rows.extend(ScalarResultsReturn(forest, types, params, callable, ScalarClosing(forest, body)));
    return ScalarOperands.Built(rows);
}
// The rows of `statement`, a return of a function with named results, as
// NamedReturnStep runs it. A value of a single result is the one returned.
// Several values are each assigned to their result in order, each before
// the next is evaluated, and the return of them all follows at the list's
// closing parenthesis.
ScalarNamedReturn :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                      callable: Callable, names: Name[], types: TypeDecl[], members: TypeMember[],
                      constants: ConstDecl[], statement: int) -> ScalarOperands {
    returned := ScalarReturned(forest, statement);
    if (returned.message != "") {
        return ScalarOperands.Failed(returned);
    }
    value := Field(forest, statement, syntax.FieldValue);
    if (value < 0) {
        return ScalarOperands.Built(ScalarResultsReturn(forest, types, params, callable, statement));
    }
    values := NamedReturnValues(forest, value);
    rows: facts.Row[] = [];
    for (index in 0..<length(values)) {
        named := params[callable.first + callable.count + index];
        type := ScalarValueType(types, named.storage, named.container, named.record);
        row := ScalarAt(forest, statement, facts.ReturnRow, 0, 0, 0, "");
        if (callable.results > 1) {
            row = ScalarAt(forest, values[index], facts.AssignRow, type, callable.count + index, 0, "");
        }
        empty: facts.Row[] = [];
        shape: ValueType = {storage: named.storage, container: named.container, record: named.record};
        built := ScalarElementValue(forest, text, callables, params, callable, names, types, members, constants,
                                    values[index], shape, empty);
        switch built {
            case .Failed(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Built(operands):
                row.count = length(operands);
                rows.append(row);
                rows.extend(operands);
        }
    }
    if (callable.results == 1) {
        return ScalarOperands.Built(rows);
    }
    rows.extend(ScalarResultsReturn(forest, types, params, callable, ScalarClosing(forest, value)));
    return ScalarOperands.Built(rows);
}
// The last token of `node`: an argument list's closing parenthesis or a
// body's closing brace, where a return of named results after the values
// or statements before it is placed.
ScalarClosing :: (forest: snapshot.SnapshotNode[], node: int) -> int {
    last := node;
    child := forest[node].first_child;
    while (child >= 0) {
        if (!forest[child].is_extra) {
            last = child;
        }
        child = forest[child].next_sibling;
    }
    return last;
}
// Claim a typed invocation's contiguous argument/result cells. These ranges
// come from EmitBody, whose table indices are compiler-internal invariants.
ScalarClaimCells :: (claimed: ^(bool[]), first: int, end: int) {
    assert(first >= 0 && end >= first && end <= length(claimed^));
    for (cell in first..<end) { claimed^[cell] = true; }
}

// Each cell belongs to an admitted value, invocation or host, or was copied
// into a result bank or conditional by the ordinary checker. Index ownership once;
// scanning every call/host for every cell would multiply their table sizes.
ScalarCells :: (cells: Cell[], calls: Invocation[], hosts: Host[], semantic: SemanticFact[], lent: bool) -> bool {
    claimed := resize([false], length(cells));
    for (cell in 0..<length(cells)) {
        claimed[cell] = (lent && cells[cell].container == 0) ||
            ((cells[cell].storage == StructStorage || cells[cell].storage == UnionStorage) && cells[cell].container == 0) ||
            (cells[cell].container == ArrayContainer && ScalarArrayElement(cells[cell].storage)) ||
            cells[cell].container == MapContainer;
    }
    for (call in calls) {
        ScalarClaimCells(&claimed, call.first, call.first + call.count);
        if (call.result_count > 0) {
            ScalarClaimCells(&claimed, call.result_first, call.result_first + call.result_count);
        }
    }
    for (host in hosts) {
        ScalarClaimCells(&claimed, host.first, host.result_first + host.result_count);
    }
    for (fact in semantic) {
        if (fact.kind == ScalarValueCellFact) {
            if (fact.target < 0 || fact.target >= length(cells) || !ScalarValueCell(cells[fact.target])) { return false; }
            claimed[fact.target] = true;
        }
    }
    for (known in claimed) { if (!known) { return false; } }
    return true;
}
// SCRIPT_EFFECT_HOST: a synchronous output action.
NativePrintEffect: int : 8;
// The text, output, array and scalar math natives this producer lowers.
ScalarTextNative :: (native: ResolvedNative) -> bool {
    return ScalarMathNative(native) || NativeNameMatches(native, "make_array") || NativeNameMatches(native, "text_equal") || NativeNameMatches(native, "text_byte_length") || NativeNameMatches(native, "text_byte_at") ||
           NativeNameMatches(native, "text_slice") || NativeNameMatches(native, "format_text") ||
           NativeNameMatches(native, "print_string") ||
           NativeNameMatches(native, "length") || NativeNameMatches(native, "append") ||
           NativeNameMatches(native, "extend") || NativeNameMatches(native, "slice") ||
           NativeNameMatches(native, "resize") || NativeNameMatches(native, "contains") ||
           NativeNameMatches(native, "insert") || NativeNameMatches(native, "reverse") ||
           NativeNameMatches(native, "set_array_elem") ||
           NativeNameMatches(native, "remove_index") ||
           NativeNameMatches(native, "text_bytes") || NativeNameMatches(native, "text_from_bytes");
}
// The text natives of `natives`, each with its ports at their place among
// ScalarTextPorts's.
ScalarTextNatives :: (natives: ResolvedNative[]) -> ResolvedNative[] {
    kept: ResolvedNative[] = [];
    first: int = 0;
    for (native in natives) {
        if (ScalarTextNative(native)) {
            row := native;
            row.first = first;
            kept.append(row);
            first += native.parameters + native.results;
        }
    }
    return kept;
}
// The ports of the text natives of `natives`, in order.
ScalarTextPorts :: (natives: ResolvedNative[], ports: ResolvedPort[]) -> ResolvedPort[] {
    kept: ResolvedPort[] = [];
    for (native in natives) {
        if (ScalarTextNative(native)) {
            count := native.parameters + native.results;
            for (index in 0..<count) {
                kept.append(ports[native.first + index]);
            }
        }
    }
    return kept;
}
// The identity pairs of the text natives of `natives`, in order.
ScalarTextIdentities :: (natives: ResolvedNative[], identities: u64[]) -> u64[] {
    kept: u64[] = [];
    for (index in 0..<length(natives)) {
        if (ScalarTextNative(natives[index])) {
            kept.append(identities[2 * index]);
            kept.append(identities[2 * index + 1]);
        }
    }
    return kept;
}
// Whether every host call reads a string's bytes through a text native,
// builds a record from its fields, copies, drops or snapshots one or reads or
// writes a field through a reference to it, or makes a union, tests its
// variant or reads a payload, the only host calls a string, record or union
// of this subset takes, and every traced root is a record or union. Its
// records and unions hold only numbers and bools, so a value copy or drop is
// a plain copy or nothing.
ScalarHosts :: (hosts: Host[], roots: Root[]) -> string {
    admitted := [ConstructIntrinsic, SnapshotIntrinsic, ValueCopyIntrinsic, ValueDropIntrinsic,
                 ReferenceMakeIntrinsic, ReferenceFieldIntrinsic, ReferenceReadIntrinsic, ReferenceWriteIntrinsic,
                 UnionMakeIntrinsic, UnionKeepIntrinsic, UnionTestIntrinsic, UnionGetIntrinsic,
                 ArrayPushIntrinsic, ArrayStoreIntrinsic, ArrayMutateIntrinsic, ArrayMutatePlaceIntrinsic,
                 SequenceGetIntrinsic, SequenceLengthIntrinsic, SequenceBorrowIntrinsic, SequenceCloneIntrinsic,
                 ArrayExtendIntrinsic, SequenceSliceIntrinsic, MapMakeIntrinsic, MapGetIntrinsic, MapHasIntrinsic,
                 MapStoreIntrinsic, MapDeleteIntrinsic, MapDeletePlaceIntrinsic, MapItemIntrinsic,
                 ReferenceKeyIntrinsic, PointerMakeIntrinsic, PointerReadIntrinsic, PointerWriteIntrinsic,
                 PointerReferenceIntrinsic, PointerFieldIntrinsic];
    for (host in hosts) {
        // A text native, the only natives EmitBody is given.
        if (host.intrinsic == 0 && host.linked >= 0) {
            continue;
        }
        // The facts below lower these commands to native coroutine operations.
        if (host.command == YieldCommand || host.command == JoinCommand || host.command == CancelCommand ||
            host.command == CancelAfterCommand || host.command == DelayCommand || host.command == RunningCommand) {
            continue;
        }
        intrinsic := host.intrinsic;
        if (intrinsic >= InResult) {
            intrinsic -= InResult;
        }
        known := false;
        for (allowed in admitted) {
            known = known || intrinsic == allowed;
        }
        if (!known) {
            return format_text("host intrinsic {}", intrinsic);
        }
    }
    for (root in roots) {
        records := (root.storage == StructStorage || root.storage == UnionStorage) && root.container == 0;
        arrays := root.container == ArrayContainer && ScalarArrayElement(root.storage);
        tasks := root.storage == TaskStorage && root.container == 0;
        pointers := root.storage == PointerStorage && root.container == 0;
        if (!records && !arrays && !tasks && !pointers && root.container != MapContainer) {
            return format_text("root storage {} container {}", root.storage, root.container);
        }
    }
    return "";
}
// Array schemas describe scalar storage, not nominal element constraints such
// as char's Unicode range. Keep those arrays closed before facts erase names.
ScalarRetainedArrays :: (types: TypeDecl[], members: TypeMember[], storage: int, container: int, record: int) -> bool {
    if (container == ArrayContainer) { return (Numeric(storage) || storage == BoolStorage) && record < 0; }
    if (container != 0) { return false; }
    if (storage != StructStorage) { return true; }
    visited := resize([false], length(types));
    pending := [record];
    visited[record] = true;
    at := 0;
    while (at < length(pending)) {
        parent := types[pending[at]];
        for (field in parent.first..<parent.first + parent.count) {
            member := members[field];
            if (member.container != 0) {
                if (member.container != ArrayContainer || member.record >= 0 ||
                    (!Numeric(member.storage) && member.storage != BoolStorage)) { return false; }
            } else if (member.storage == StructStorage && !visited[member.record]) {
                visited[member.record] = true;
                pending.append(member.record);
            }
        }
        at += 1;
    }
    return true;
}
// The names the ordinary compiler reads a function's retained locals by: each
// a state of the module, at its position among them.
ScalarRetainedNames :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], callable: Callable) -> Name[] {
    names: Name[] = [];
    table := types;
    pending: int[] = [Field(forest, callable.node, syntax.FieldBody)];
    while (length(pending) > 0) {
        node := pending[length(pending) - 1];
        pending = slice(pending, 0, length(pending) - 1);
        if (Is(forest, node, syntax.StateDeclaration)) {
            declared := StateType(forest, text, &table, 0, node);
            place := StatePlace;
            if (declared.storage == StructStorage || declared.container == ArrayContainer) {
                // The ordinary preflight checks a mutable aggregate local;
                // native retained lowering supplies its persistent storage.
                place = CellPlace;
            }
            kept: Name = {owned: false, name: Text(forest, text, Field(forest, node, syntax.FieldName)), place: place,
                          index: length(names), storage: declared.storage, container: declared.container, record: declared.record,
                          writable: true, node: Field(forest, node, syntax.FieldName)};
            names.append(kept);
        }
        child := forest[node].first_child;
        while (child >= 0) {
            pending.append(child);
            child = forest[child].next_sibling;
        }
    }
    return names;
}
// The ordinary compiler must emit the body with no semantic effects and none
// of the storage or host machinery this subset cannot carry: no host calls
// but a record's construction, copies and field writes and a union's
// construction, tests and payload reads, no traced roots but records and
// unions, and no cells besides those, moved records and unions and its
// authored calls' arguments and results.
ScalarEmits :: (forest: snapshot.SnapshotNode[], authored: snapshot.SnapshotNode[], documents: snapshot.Document[],
                text: string, key: string, callables: Callable[], params: Param[],
                table: ^(TypeDecl[]), body_optionals: ^(int[]), members: TypeMember[], constants: ConstDecl[], solid: int[], function: int,
                ops: Ops, target: Target, natives: ResolvedNative[], ports: ResolvedPort[],
                identities: u64[], aliases: Name[], retained: Name[], summary: ^ScalarEffectSummary,
                assertions: ^(ScalarAssertion[]), math_values: ^bool) -> syntax.Diagnostic {
    operators: NumericOperator[] = [];
    makes: NativeMake[] = [];
    indices: int[] = [];
    empty_names: string[] = [];
    // No native writes: the text natives are pure.
    writes := resize([int(0)], length(natives));
    // The names scoped arguments lend live in cells, as in the ordinary
    // compile. A written record or array parameter is a copy of its argument.
    referenced: string[] = [];
    body := Field(forest, callables[function].node, syntax.FieldBody);
    if (AnyReference(params)) {
        referenced = ReferencedNames(forest, text, callables, params, natives, aliases, callables[function].package, body);
    }
    mutated := MutatedNames(forest, text, body, referenced);
    switch EmitBody(forest, text, callables[function].document, callables, params, table, members, constants, natives, ports, identities,
                    operators, makes, indices, extend(aliases, retained), key, solid, 0, 0, function, referenced,
                    mutated, indices, BodyContext.Known(writes), indices, ops, target) {
        case .Failed(diagnostic):
            return diagnostic;
        case .Specialize(template, call, arguments, caller_names):
            return Diagnose(forest, call, callables[function].document, "scalar proof requires a specialized callable");
        case .Inferred(value):
            return Diagnose(forest, Field(forest, callables[function].node, syntax.FieldBody), 0,
                            "scalar proof requires a callable body");
        case .Emitted(slots, locals, cells, code, calls, hosts, roots, points, watches, effects,
                      direct_write, facts):
            // Reuse the ordinary checker's typed error-result facts and authored
            // control flow. Scoped lowering preserves node IDs but changes
            // pointer syntax; error ownership uses the original authored syntax.
            problems := FallibleBody(authored, documents, callables, params, table^, callables[function], facts);
            if (length(problems) > 0) { return problems[0]; }
            if (summary.wanted) { ScalarBodyEffects(summary, function, callables[function].waits, effects, ops, code, hosts, calls); }
            while (length(body_optionals^) < length(table^)) { body_optionals.append(0); }
            for (cell in cells) {
                if (!math_values^ && cell.storage == StructStorage && MathKind(table^, cell.record) != 0) {
                    math_values^ = true;
                }
                if (cell.storage == UnionStorage && cell.container == 0 && ScalarOptional(table^, cell.record)) {
                    body_optionals^[cell.record] = 1;
                }
            }
            // A retained local reads and writes its state, which the facts carry.
            // A write through a scoped parameter the module passes by reference
            // changes the caller's variable, which the facts carry.
            permitted: int = NativePrintEffect | ScalarPointerEffects(hosts);
            if (callables[function].waits) {
                permitted |= SuspendEffect;
            }
            for (param in params) {
                if (param.reference && param.written) {
                    permitted |= WriteEffect;
                }
            }
            why := "";
            host_problem := ScalarHosts(hosts, roots);
            if (length(retained) == 0 && (effects | permitted) != permitted) {
                why = format_text("effects {}", effects);
            } else if (length(retained) == 0 && (direct_write | permitted) != permitted) {
                why = "a direct write";
            } else if (host_problem != "") {
                why = host_problem;
            } else if (!ScalarCells(cells, calls, hosts, facts, AnyReference(params) || length(retained) > 0)) {
                why = "a cell";
            }
            if (why != "") {
                return Diagnose(forest, Field(forest, callables[function].node, syntax.FieldBody), 0,
                                format_text("scalar proof requires known effect-free scalar execution, not {}", why));
            }
            first_check := length(assertions^);
            for (instruction in code) {
                if (instruction.op == ops.guard && instruction.has_message) {
                    message: ScalarAssertion = {start: instruction.start, end: instruction.end, message: instruction.message};
                    assertions.append(message);
                }
            }
            ScalarAssertionsSorted(assertions, first_check, length(assertions^));
            return ScalarPassed();
    }
}
// Whether any function takes an array parameter.
AnyArrayParameter :: (params: Param[]) -> bool {
    for (param in params) {
        if ((param.container == ArrayContainer || param.container == MapContainer) && !param.reference) {
            return true;
        }
    }
    return false;
}
// The names of the fields that anything in the forest changes: the members on
// the path of an assignment's or a delete's target, of an `&` operand, and of
// the object a changing method is called on. Matching by name alone over all
// records only costs a copy where two records share a field name.
ScalarChangedFields :: (forest: snapshot.SnapshotNode[], text: string, foreign_buffers: bool[]) -> string[] {
    found: string[] = [];
    for (at in 0..<length(forest)) {
        target: int = -1;
        if (length(foreign_buffers) > 0 && foreign_buffers[at]) {
            target = at;
        } else if (Is(forest, at, syntax.Assignment) || Is(forest, at, syntax.DeleteStatement)) {
            target = Field(forest, at, syntax.FieldTarget);
        } else if (Is(forest, at, syntax.AddressExpression)) {
            target = Field(forest, at, syntax.FieldOperand);
        } else if (Is(forest, at, syntax.CallExpression)) {
            callee := Field(forest, at, syntax.FieldFunction);
            if (Is(forest, callee, syntax.MemberExpression) &&
                ChangingMethod(Text(forest, text, Field(forest, callee, syntax.FieldMember)))) {
                target = Field(forest, callee, syntax.FieldObject);
            }
        }
        while (target >= 0) {
            place := Unparenthesized(forest, target);
            if (Is(forest, place, syntax.MemberExpression)) {
                name := Text(forest, text, Field(forest, place, syntax.FieldMember));
                if (!Holds(found, name)) {
                    found.append(name);
                }
                target = Field(forest, place, syntax.FieldObject);
            } else if (Is(forest, place, syntax.IndexExpression)) {
                target = Field(forest, place, syntax.FieldObject);
            } else {
                target = -1;
            }
        }
    }
    return found;
}
// Whether the record literal `literal` initializes a local that the body uses
// only through its fields, `&` and as the argument of a call that is not a
// changing method's, so no copy of the record, and none of the arrays it
// borrows, outlives the call, provided no function returns or stores the
// record's type (ScalarModule checks that). A spelling shadowed elsewhere
// counts against the literal.
ScalarViewLocal :: (forest: snapshot.SnapshotNode[], text: string, body: int, literal: int) -> bool {
    declaration := forest[literal].parent;
    while (Is(forest, declaration, syntax.ParenthesizedExpression)) {
        declaration = forest[declaration].parent;
    }
    if (!Is(forest, declaration, syntax.LocalDeclaration) ||
        Unparenthesized(forest, Field(forest, declaration, syntax.FieldValue)) != literal) {
        return false;
    }
    named := Field(forest, declaration, syntax.FieldName);
    name := Text(forest, text, named);
    pending: int[] = [body];
    top: int = 1;
    while (top > 0) {
        top -= 1;
        at := pending[top];
        if (at != named && Is(forest, at, syntax.Identifier) && Text(forest, text, at) == name) {
            use := at;
            while (Is(forest, forest[use].parent, syntax.ParenthesizedExpression)) {
                use = forest[use].parent;
            }
            holder := forest[use].parent;
            fielded := Is(forest, holder, syntax.MemberExpression) && Field(forest, holder, syntax.FieldObject) == use;
            addressed := Is(forest, holder, syntax.AddressExpression) && Field(forest, holder, syntax.FieldOperand) == use;
            passed := false;
            if (Is(forest, holder, syntax.ArgumentList)) {
                // An authored call does not retain a scoped reference beyond the call.
                callee := Field(forest, forest[holder].parent, syntax.FieldFunction);
                passed = Is(forest, forest[holder].parent, syntax.CallExpression) &&
                         (!Is(forest, callee, syntax.MemberExpression) ||
                          !ChangingMethod(Text(forest, text, Field(forest, callee, syntax.FieldMember))));
            }
            if (!fielded && !addressed && !passed) {
                return false;
            }
        }
        child := forest[at].first_child;
        while (child >= 0) {
            if (top < length(pending)) {
                pending[top] = child;
            } else {
                pending.append(child);
            }
            top += 1;
            child = forest[child].next_sibling;
        }
    }
    return true;
}
// How many times the body `node` mentions the name `name`.
ScalarNameUses :: (forest: snapshot.SnapshotNode[], text: string, node: int, name: string) -> int {
    found := 0;
    pending: int[] = [node];
    top: int = 1;
    while (top > 0) {
        top -= 1;
        at := pending[top];
        if (Is(forest, at, syntax.Identifier) && Text(forest, text, at) == name) {
            found += 1;
        }
        child := forest[at].first_child;
        while (child >= 0) {
            if (top < length(pending)) {
                pending[top] = child;
            } else {
                pending.append(child);
            }
            top += 1;
            child = forest[child].next_sibling;
        }
    }
    return found;
}
// The names a body stores whole where a copy would be made: as the value of an
// assignment or a local, a returned value, a record literal's field, or a union
// variant's payload. A field that `changed_fields` lacks, of a literal that
// ScalarViewLocal accepts, borrows the array instead.
ScalarStorageUse :: struct { names: string[]; patterns: bool; }
ScalarStoredNames :: (forest: snapshot.SnapshotNode[], text: string, node: int, changed_fields: string[]) -> ScalarStorageUse {
    found: string[] = [];
    patterned := false;
    viewed: int[] = [];
    refused: int[] = [];
    pending: int[] = [node];
    top: int = 1;
    while (top > 0) {
        top -= 1;
        at := pending[top];
        if (Is(forest, at, syntax.IsExpression) &&
            FirstMember(forest, Field(forest, Field(forest, at, syntax.FieldType), syntax.FieldBindings)) >= 0) { patterned = true; }
        if (Is(forest, at, syntax.Identifier)) {
            value := at;
            while (Is(forest, forest[value].parent, syntax.ParenthesizedExpression)) {
                value = forest[value].parent;
            }
            holder := forest[value].parent;
            stored := false;
            if (Is(forest, holder, syntax.Assignment) || Is(forest, holder, syntax.LocalDeclaration)) {
                stored = Field(forest, holder, syntax.FieldValue) == value;
            } else if (Is(forest, holder, syntax.ReturnStatement)) {
                stored = true;
            } else if (Is(forest, holder, syntax.NamedArgument)) {
                literal := forest[holder].parent;
                stored = Field(forest, holder, syntax.FieldValue) == value && Is(forest, literal, syntax.StructExpression);
                if (stored && !Holds(changed_fields, Text(forest, text, Field(forest, holder, syntax.FieldName)))) {
                    if (!viewed.contains(literal) && !refused.contains(literal)) {
                        if (ScalarViewLocal(forest, text, node, literal)) {
                            viewed.append(literal);
                        } else {
                            refused.append(literal);
                        }
                    }
                    stored = !viewed.contains(literal);
                }
            } else if (Is(forest, holder, syntax.ArgumentList)) {
                // `Type.Variant(value)`: a call through a capitalized name.
                call := forest[holder].parent;
                function := Field(forest, call, syntax.FieldFunction);
                if (Is(forest, call, syntax.CallExpression) && Is(forest, function, syntax.MemberExpression)) {
                    object := Field(forest, function, syntax.FieldObject);
                    if (Is(forest, object, syntax.Identifier)) {
                        first := strings.ByteAt(Text(forest, text, object), 0);
                        stored = first >= 65 && first <= 90;
                    }
                }
            }
            if (stored) {
                found.append(Text(forest, text, at));
            }
        }
        child := forest[at].first_child;
        while (child >= 0) {
            if (top < length(pending)) {
                pending[top] = child;
            } else {
                pending.append(child);
            }
            top += 1;
            child = forest[child].next_sibling;
        }
    }
    return {names: found, patterns: patterned};
}
// `params` with `written` set on parameters whose targets their function
// changes. Scoped parameters always stay references; these flags drive value
// parameter ownership and effects. Passing on makes the analysis a fixed point
// over the module's calls.
ScalarWritten :: (scoped: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                  natives: ResolvedNative[], documents: snapshot.Document[], links: graph.Binding[],
                  generic_bindings: GenericBinding[], changed_fields: string[], foreign_buffers: bool[]) -> Param[] {
    marked := params;
    // Direct foreign writes depend only on syntax. Mark them once; the
    // fixed point below only propagates writes through authored calls.
    if (length(foreign_buffers) > 0) {
        for (callable in callables) {
            eligible := false;
            for (index in 0..<callable.count) {
                param := marked[callable.first + index];
                eligible = eligible || (!param.written && (param.reference || param.container == ArrayContainer));
            }
            if (!eligible) { continue; }
            body := Field(scoped, callable.node, syntax.FieldBody);
            names := ScalarForeignNames(scoped, text, body, foreign_buffers);
            for (index in 0..<callable.count) {
                param := marked[callable.first + index];
                if ((param.reference || param.container == ArrayContainer) && Holds(names, param.name)) {
                    param.written = true;
                    marked[callable.first + index] = param;
                }
            }
        }
    }
    changed := true;
    while (changed) {
        changed = false;
        for (function in 0..<length(callables)) {
            callable := callables[function];
            body := Field(scoped, callable.node, syntax.FieldBody);
            mutated := MutatedNames(scoped, text, body, []);
            stored := ScalarStoredNames(scoped, text, body, changed_fields).names;
            calls := ScopedCalls(scoped, text, callables, marked, natives,
                                 ScalarAliases(callables, documents, links, generic_bindings, function),
                                 callable.package, body, true);
            for (index in 0..<callable.count) {
                param := marked[callable.first + index];
                if (!param.reference && param.container == MapContainer && !param.written) {
                    owned := Holds(mutated, param.name);
                    for (argument in calls) {
                        // Taking the parameter's address lends mutable storage.
                        // Its backing must be private even when this body has
                        // no direct map write of its own.
                        if (marked[argument.param].reference &&
                            ScalarPassedName(scoped, text, argument.value) == param.name) {
                            owned = true;
                        }
                    }
                    if (owned) {
                        param.written = true;
                        marked[callable.first + index] = param;
                        changed = true;
                        continue;
                    }
                }
                // An array parameter the function changes is its own, and so
                // is one it hands on to a parameter that is: the argument is
                // a move wherever the parameter is dead after the call, and a
                // copy only where it is not.
                if (!param.reference && param.container == ArrayContainer && !param.written) {
                    owned := Holds(mutated, param.name) || Holds(stored, param.name);
                    // A parameter the function only hands on: every mention of
                    // it is an argument for a parameter that is the callee's
                    // own. One it also reads is lent on, as a table is, rather
                    // than copied at each call that hands it on.
                    handed := 0;
                    for (argument in calls) {
                        if (!marked[argument.param].reference && marked[argument.param].written &&
                            ScalarPassedName(scoped, text, argument.value) == param.name) {
                            handed += 1;
                        }
                    }
                    if (!owned && handed > 0 && ScalarNameUses(scoped, text, body, param.name) == handed) {
                        owned = true;
                    }
                    if (owned) {
                        param.written = true;
                        marked[callable.first + index] = param;
                        changed = true;
                        continue;
                    }
                }
                if (!param.reference || param.written) {
                    continue;
                }
                written := Holds(mutated, param.name);
                for (argument in calls) {
                    if (marked[argument.param].reference && marked[argument.param].written) {
                        place := Unparenthesized(scoped, argument.value);
                        if (Is(scoped, place, syntax.AddressExpression)) {
                            place = Field(scoped, place, syntax.FieldOperand);
                        }
                        // Lending a field for a write also changes its enclosing record.
                        if (RootName(scoped, text, place) == param.name) {
                            written = true;
                        }
                    }
                }
                if (written) {
                    param.written = true;
                    marked[callable.first + index] = param;
                    changed = true;
                }
            }
        }
    }
    return marked;
}
// The import aliases and generic bindings that resolve the calls of function
// `function`: a set of packages holds each function in its own document.
ScalarAliases :: (callables: Callable[], documents: snapshot.Document[], links: graph.Binding[],
                  generic_bindings: GenericBinding[], function: int) -> Name[] {
    home_aliases: Name[] = [];
    if (length(documents) > 0 && length(links) > 0) {
        home_aliases = Aliases(links, callables[function].document);
    }
    return GenericAliases(home_aliases, generic_bindings, function);
}
// The variable an argument for a scoped parameter passes: `&x` or a scoped
// parameter `x` passed on; "" for any other place.
ScalarPassedName :: (scoped: snapshot.SnapshotNode[], text: string, argument: int) -> string {
    value := Unparenthesized(scoped, argument);
    if (Is(scoped, value, syntax.AddressExpression)) {
        value = Unparenthesized(scoped, Field(scoped, value, syntax.FieldOperand));
    }
    if (!Is(scoped, value, syntax.Identifier)) {
        return "";
    }
    return Text(scoped, text, value);
}
// The functions of the module, each checked as a whole before the next.
ScalarModule :: (forest: snapshot.SnapshotNode[], text: string, key: string, callables: Callable[],
                 params: Param[], input_types: TypeDecl[], input_members: TypeMember[], constants: ConstDecl[], ops: Ops,
                 target: Target, natives: ResolvedNative[], ports: ResolvedPort[], identities: u64[],
                 is_library: bool, generic_bindings: GenericBinding[], documents: snapshot.Document[],
                 links: graph.Binding[], summary: ^ScalarEffectSummary) -> ScalarOperands {
    types := input_types;
    members := input_members;
    // Native collection does not use Link, which normally adds these unions.
    // Entry ordering is final here, so each parent is its actual callable.
    switch TaskResultDeclarations(callables, params, types, members) {
        case .Collected(declared_types, declared_members):
            types = declared_types;
            members = declared_members;
    }
    // The view the facts take; EmitBody takes the ordinary compiler's own.
    seen: Callable[] = [];
    records: TypeDecl[] = [];
    fields: TypeMember[] = [];
    switch ScalarResults(callables, params, types, members, []) {
        case .Viewed(viewed_callables, viewed_types, viewed_members):
            seen = viewed_callables;
            records = viewed_types;
            fields = viewed_members;
    }
    for (index in 0..<length(seen)) {
        callable := seen[index];
        if (Field(forest, callable.node, syntax.FieldAttribute) >= 0) {
            // Test metadata follows the ordinary front-end policy. It does not
            // change the entry ABI; a void entry returns the ordinary zero status.
            attributes := ReadAttributes(forest, text, callables[index]);
            if (attributes.fault >= 0) {
                return ScalarOperands.Failed(Diagnose(forest, attributes.fault, 0, attributes.message));
            }
        }
    }
    if (length(seen) == 0) {
        return ScalarOperands.Failed(ScalarStart("scalar proof requires a concrete function"));
    }
    solid := SolidOffsets(text);
    // A scoped parameter's `p^` is `p`, as every body sees it.
    scoped := forest;
    if (length(documents) > 0 && AnyReference(params)) {
        scoped = ScopedTargets(forest, documents, callables, params);
    }
    foreign_buffers := ScalarForeignBuffers(scoped, text);
    changed_fields := ScalarChangedFields(scoped, text, foreign_buffers);
    // Keep write facts for value ownership and source effects. Every scoped
    // parameter passes a live reference, including one this function only reads.
    marked := params;
    if (AnyReference(params) || AnyArrayParameter(params)) {
        marked = ScalarWritten(scoped, text, callables, params, natives, documents, links, generic_bindings, changed_fields, foreign_buffers);
    }
    // The ordinary checker interns body-local types before the facts assign
    // their type ordinals. Keep that table for every later function.
    checked := types;
    body_optionals: int[] = [];
    assertions: ScalarAssertion[] = [];
    assertion_offsets: int[] = [0];
    // DeclareMath always provides every built-in type. Only actual values and
    // authored fields need logical math-write analysis, not that catalog.
    math_values := false;
    for (param in params) {
        if (param.storage == StructStorage && MathKind(records, param.record) != 0) { math_values = true; break; }
    }
    if (!math_values) {
        for (field in fields) {
            if (field.storage == StructStorage && MathKind(records, field.record) != 0) { math_values = true; break; }
        }
    }
    for (function in 0..<length(callables)) {
        aliases := ScalarAliases(callables, documents, links, generic_bindings, function);
        used := constants;
        if (length(generic_bindings) > 0) {
            used = GenericConstants(forest, constants, generic_bindings, function, callables[function], documents);
        }
        emitted := ScalarEmits(scoped, forest, documents, text, key, callables, marked, &checked, &body_optionals, members, used, solid, function,
                               ops, target, natives, ports, identities, aliases,
                               ScalarRetainedNames(scoped, text, checked, callables[function]), summary, &assertions, &math_values);
        if (emitted.message != "") { return ScalarOperands.Failed(emitted); }
        assertion_offsets.append(length(assertions));
    }
    switch ScalarSynchronous(forest, callables, generic_bindings, summary^) {
        case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
        case .Valid: { }
    }
    // Source diagnostics precede restrictions of the native representation or
    // process entry ABI. In particular, an invalid math expression must keep
    // the ordinary checker's diagnostic even when its signature uses vectors.
    for (callable in seen) {
        rejected := ScalarSignature(forest, records, params, callable);
        if (rejected >= 0) {
            return ScalarOperands.Failed(Diagnose(forest, rejected, 0, ScalarSignatureMessage(params, callable, rejected, forest)));
        }
    }
    // A library has no entry.
    first := seen[0];
    if (!is_library && first.count != 0) {
        return ScalarOperands.Failed(Diagnose(forest, Field(forest, first.node, syntax.FieldParameters), 0,
                                              "scalar proof requires its first function to take no parameters"));
    }
    if (!is_library && (first.result != IntStorage || first.result_container != 0)) {
        at := Field(forest, first.node, syntax.FieldResults);
        if (at < 0) {
            at = first.node;
        }
        return ScalarOperands.Failed(Diagnose(forest, at, 0, "scalar proof requires its first function to return int or nothing"));
    }
    switch ScalarResults(callables, params, checked, members, body_optionals) {
        case .Viewed(viewed_callables, viewed_types, viewed_members):
            seen = viewed_callables;
            records = viewed_types;
            fields = viewed_members;
    }
    rows: facts.Row[] = [];
    switch ScalarRecords(forest, records, fields) {
        case .Failed(diagnostic):
            return ScalarOperands.Failed(diagnostic);
        case .Built(record_rows):
            rows = record_rows;
    }
    // The array fields no function changes may be borrowed by a record literal,
    // unless their record's type is returned or kept in another type: a copy
    // of such a record could outlive the arrays it borrows.
    kept_types: int[] = [];
    for (callable in seen) {
        if (callable.result == StructStorage) {
            kept_types.append(callable.result_record);
        }
    }
    for (field in fields) {
        if (field.storage == StructStorage) {
            kept_types.append(field.record);
        }
    }
    for (index in 0..<length(fields)) {
        if (fields[index].container == ArrayContainer && !Holds(changed_fields, fields[index].name)) {
            fixed := fields[index];
            fixed.fixed = true;
            fields[index] = fixed;
        }
    }
    for (record in kept_types) {
        if (record >= 0) {
            for (index in 0..<records[record].count) {
                unfixed := fields[records[record].first + index];
                unfixed.fixed = false;
                fields[records[record].first + index] = unfixed;
            }
        }
    }
    for (function in 0..<length(callables)) {
        aliases := ScalarAliases(callables, documents, links, generic_bindings, function);
        used := constants;
        if (length(generic_bindings) > 0) {
            used = GenericConstants(forest, constants, generic_bindings, function, callables[function], documents);
        }
        switch ScalarFunction(scoped, text, key, solid, seen, marked, records, fields, used,
                              function, ops, target, aliases, changed_fields, assertions,
                              assertion_offsets[function], assertion_offsets[function + 1], math_values) {
            case .Failed(diagnostic):
                return ScalarOperands.Failed(diagnostic);
            case .Built(function_rows):
                rows.extend(function_rows);
        }
    }
    switch ScalarBuiltinKernels(forest, text, records, fields, rows, length(callables), ops, target, summary) {
        case .Failed(diagnostic): return ScalarOperands.Failed(diagnostic);
        case .Built(kernels): return ScalarManagedRecords(forest, records, fields, kernels);
    }
}
// The name of a record or union row: its own, or `package.Name` when an
// earlier row of `named` has it, as another package's declaration may. The
// scan is over the declared types, which number in the hundreds.
ScalarDeclaredName :: (declared: TypeDecl, named: string[]) -> string {
    if (declared.type_name != "" && Holds(named, declared.name)) {
        return declared.type_name;
    }
    return declared.name;
}
// The rows of the source's records and unions, in declaration order, then
// those of the functions' results records: each record of number and bool
// fields, and each union.
ScalarRecords :: (forest: snapshot.SnapshotNode[], types: TypeDecl[], members: TypeMember[]) -> ScalarOperands {
    rows: facts.Row[] = [];
    named: string[] = [];
    position: int = -1;
    for (declared in types) {
        position += 1;
        if (!ScalarDeclares(types, declared)) {
            continue;
        }
        if (ScalarNestedCollection(declared)) {
            rows.extend(ScalarCollectionRows(forest, types, declared));
            continue;
        }
        if (declared.kind == MathDecl) {
            rows.append(ScalarAt(forest, 0, facts.RecordRow, 0, 0, declared.count, declared.name));
            for (field in 0..<declared.count) {
                rows.append(ScalarAt(forest, 0, facts.MemberRow, facts.FloatType, field, 0,
                                      members[declared.first + field].name));
            }
            continue;
        }
        if (declared.kind == TaskResultDecl) {
            rows.append(ScalarAt(forest, 0, facts.UnionRow, 0, 0, 2, format_text("taskresult{}", position)));
            for (ordinal in 0..<2) {
                variant := types[declared.first + ordinal];
                name := "Success";
                if (variant.name == "Cancelled") { name = "Cancelled"; }
                rows.append(ScalarAt(forest, 0, facts.VariantRow, 0, ordinal, variant.count, name));
                if (variant.count == 1) {
                    payload := ScalarValueType(types, declared.value_storage, declared.value_container, declared.value_record);
                    rows.append(ScalarAt(forest, 0, facts.MemberRow, payload, 0, 0, "value"));
                }
            }
            continue;
        }
        if (declared.kind == OptionalDecl) {
            rows.extend(ScalarOptionalRows(forest, types, declared, position));
            continue;
        }
        if (declared.kind == UnionDecl) {
            union_name := ScalarDeclaredName(declared, named);
            named.append(union_name);
            switch ScalarUnion(forest, types, members, declared, union_name) {
                case .Failed(diagnostic):
                    return ScalarOperands.Failed(diagnostic);
                case .Built(union_rows):
                    rows.extend(union_rows);
            }
            continue;
        }
        // A results record's fields are its function's named results.
        results := Is(forest, declared.node, syntax.FunctionDeclaration);
        fields := Members(forest, Field(forest, declared.node, syntax.FieldBody));
        if (results) {
            fields = Members(forest, Field(forest, declared.node, syntax.FieldResults));
        }
        named_as := ScalarDeclaredName(declared, named);
        named.append(named_as);
        rows.append(ScalarAt(forest, declared.node, facts.RecordRow, 0, 0, declared.count, named_as));
        for (index in 0..<declared.count) {
            field := members[declared.first + index];
            type := ScalarMemberType(types, members, declared.first + index);
            if (field.container == MapContainer) {
                return ScalarOperands.Failed(Diagnose(forest, fields[index], 0,
                                                      "native map fields require record ownership support"));
            }
            if (type == 0) {
                return ScalarOperands.Failed(Diagnose(forest, fields[index], 0,
                                                      "scalar proof requires number, bool, string, array, record and union record fields"));
            }
            member := ScalarAt(forest, Field(forest, fields[index], syntax.FieldName), facts.MemberRow, type, index, 0, field.name);
            if (CharType(types, field.storage, field.container, field.record)) { member.literal = i64(facts.CharNominal); }
            rows.append(member);
        }
    }
    return ScalarOperands.Built(rows);
}
// The rows of an optional's union, located at the document: the variants Nil,
// ordinal 0, and Some, ordinal 1, which holds the payload `value`.
ScalarOptionalRows :: (forest: snapshot.SnapshotNode[], types: TypeDecl[], declared: TypeDecl,
                       ordinal: int) -> facts.Row[] {
    payload := ScalarValueType(types, declared.value_storage, declared.value_container, declared.value_record);
    return [ScalarAt(forest, 0, facts.UnionRow, 0, 0, 2, format_text("optional{}", ordinal)), ScalarAt(forest, 0, facts.VariantRow, 0, 0, 0, "Nil"),
            ScalarAt(forest, 0, facts.VariantRow, 0, 1, 1, "Some"),
            ScalarAt(forest, 0, facts.MemberRow, payload, 0, 0, "value")];
}
// The Union row of `declared`, then each variant's Variant row and its
// payloads' Member rows, numbered across the union: number and bool
// payloads. The variants are `declared`'s, in order, and their payloads are
// consecutive members.
ScalarUnion :: (forest: snapshot.SnapshotNode[], types: TypeDecl[], members: TypeMember[],
                declared: TypeDecl, name: string) -> ScalarOperands {
    rows: facts.Row[] = [ScalarAt(forest, declared.node, facts.UnionRow, 0, 0, declared.count, name)];
    variants: int[] = [];
    for (member in Members(forest, declared.node)) {
        if (Is(forest, member, syntax.UnionVariant)) {
            variants.append(member);
        }
    }
    payloads := types[declared.first].first;
    for (ordinal in 0..<declared.count) {
        variant := types[declared.first + ordinal];
        rows.append(ScalarAt(forest, variants[ordinal], facts.VariantRow, 0, ordinal, variant.count, variant.name));
        fields := Members(forest, Field(forest, variants[ordinal], syntax.FieldParameters));
        for (index in 0..<variant.count) {
            field := members[variant.first + index];
            payload := ScalarMemberType(types, members, variant.first + index);
            if (field.container == MapContainer) {
                return ScalarOperands.Failed(Diagnose(forest, fields[index], 0,
                                                      "native map payloads require union ownership support"));
            }
            if (field.storage == PointerStorage) {
                return ScalarOperands.Failed(Diagnose(forest, fields[index], 0,
                                                      "native pointer payloads require union tracing support"));
            }
            if (payload == 0) {
                return ScalarOperands.Failed(Diagnose(forest, fields[index], 0,
                                                      "scalar proof requires number, bool, string, array, record and union payloads"));
            }
            rows.append(ScalarAt(forest, Field(forest, fields[index], syntax.FieldName), facts.MemberRow, payload,
                                 variant.first + index - payloads, 0, field.name));
        }
    }
    return ScalarOperands.Built(rows);
}
// A diagnostic at the source's start.
ScalarStart :: (message: string) -> syntax.Diagnostic {
    return {start: 0, end: 0, line: 1, column: 1, document: 0, message: message};
}
// No diagnostic: an empty message.
ScalarPassed :: () -> syntax.Diagnostic {
    return {start: 0, end: 0, line: 0, column: 0, document: 0, message: ""};
}
// The first member of one source document this subset cannot express, which
// admits only function, record, union and constant declarations, and in a
// package set, imports, with no function required of a package. A constant
// is the value Declare folds it to, so its reads are literals. A `when` is
// checked through both of its branches, in source order; Declare keeps the
// one its condition selects.
ScalarMembers :: (forest: snapshot.SnapshotNode[], root: int, packaged: bool) -> syntax.Diagnostic {
    checked := ScalarMemberList(forest, Members(forest, root), packaged);
    if (checked.diagnostic.message != "") {
        return checked.diagnostic;
    }
    if (!packaged && !checked.functions) {
        return Diagnose(forest, root, 0, "scalar proof requires at least one function");
    }
    return ScalarPassed();
}
ScalarMemberList :: (forest: snapshot.SnapshotNode[], members: int[], packaged: bool)
-> (functions: bool, diagnostic: syntax.Diagnostic) {
    functions := false;
    for (member in members) {
        if (Is(forest, member, syntax.WhenDeclaration)) {
            branches := Members(forest, Field(forest, member, syntax.FieldConsequence));
            alternative := Field(forest, member, syntax.FieldAlternative);
            if (Is(forest, alternative, syntax.WhenDeclaration)) {
                branches.append(alternative);
            } else if (alternative >= 0) {
                branches.extend(Members(forest, alternative));
            }
            inner := ScalarMemberList(forest, branches, packaged);
            if (inner.diagnostic.message != "") {
                return (functions, inner.diagnostic);
            }
            functions = functions || inner.functions;
        } else if (Is(forest, member, syntax.FunctionDeclaration)) {
            functions = true;
        } else if (!Is(forest, member, syntax.PackageHeader) && !(packaged && Is(forest, member, syntax.ImportDeclaration)) &&
                   !Is(forest, member, syntax.RecordDeclaration) && !Is(forest, member, syntax.ForeignImportDeclaration) &&
                   !Is(forest, member, syntax.ForeignBlock) &&
                   !Is(forest, member, syntax.UnionDeclaration) && !Is(forest, member, syntax.ConstantDeclaration)) {
            return (functions, Diagnose(forest, member, 0,
                                        "scalar proof supports only ordinary function, record, union and constant declarations"));
        }
    }
    return (functions, ScalarPassed());
}
// The first NUL byte's diagnostic, or none. The raw parser takes a C string;
// the snapshot's supplied byte count is not a NUL check when it came from this
// same length-bearing string.
ScalarNul :: (text: string) -> syntax.Diagnostic {
    bytes := strings.Bytes(text);
    line: int = 1;
    column: int = 1;
    for (index in 0..<length(bytes)) {
        if (bytes[index] == 0) {
            return {start: index, end: index + 1, line: line, column: column, document: 0,
                    message: "Package source contains NUL bytes"};
        }
        if (bytes[index] == 10) {
            line += 1;
            column = 1;
        } else {
            column += 1;
        }
    }
    return ScalarPassed();
}

// The rows of a game library, `Name :: library { ... }` holding only
// functions, under `path`, the identity the project compiles the source by
// (its content path). Its Document row's `text` names the library, and each
// Function row's `literal` is the function's stable ID, which the library's
// prepared module records, so a native object compiled from the rows can be
// bound to that module. No rows when the source has syntax errors, which the
// package snapshot reports, or declares no library.
ScalarLibrary :: (path: string, text: string, ops: Ops, target: Target, natives: ResolvedNative[],
                  ports: ResolvedPort[], identities: u64[]) -> facts.Row[] {
    forest: snapshot.SnapshotNode[] = [];
    top: int = -1;
    switch raw.Parse(text) {
        case .Rejected(diagnostic):
            return [];
        case .Parsed(nodes, fields, is_named, is_extra, root):
            for (at in 0..<length(nodes)) {
                forest.append(snapshot.Node(nodes[at], fields[at], is_named[at], is_extra[at], 0));
            }
            top = root;
    }
    declaration := FirstMember(forest, top);
    if (!Is(forest, declaration, syntax.Library)) {
        return [];
    }
    solid := SolidOffsets(text);
    empty_types: TypeDecl[] = [];
    aliases: Name[] = [];
    callables: Callable[] = [];
    params: Param[] = [];
    ids: u64[] = [];
    member := FirstMember(forest, Field(forest, declaration, syntax.FieldBody));
    scopes := NoScopes();
    if (member >= 0) {
        scopes = SiblingScopes(forest, text, member);
    }
    while (member >= 0) {
        if (!Is(forest, member, syntax.FunctionDeclaration) || Field(forest, member, syntax.FieldAttribute) >= 0) {
            return ScalarFailure(path, text, Diagnose(forest, member, 0,
                                                      "a native library holds only functions without attributes"));
        }
        name := Text(forest, text, Field(forest, member, syntax.FieldName));
        if (FindCallable(callables, 0, name) >= 0) {
            return ScalarFailure(path, text, Diagnose(forest, member, 0, format_text("Duplicate declaration '{}'", name)));
        }
        switch FunctionSignature(forest, text, path, solid, &empty_types, aliases, 0, 0, member, name, length(params), scopes) {
            case .Failed(diagnostic):
                return ScalarFailure(path, text, diagnostic);
            case .Read(callable, added):
                params.extend(added);
                callables.append(callable);
                ids.append(binding.ID("symbol", format_text("{}:1:{}:callable", path, name)));
        }
        member = NextMember(forest, member);
    }
    if (length(callables) == 0) {
        return ScalarFailure(path, text, Diagnose(forest, declaration, 0, "scalar proof requires at least one function"));
    }
    members: TypeMember[] = [];
    constants: ConstDecl[] = [];
    summary: ScalarEffectSummary = {wanted: false, natives: [], direct: [], waiting: [], calls: []};
    switch ScalarModule(forest, text, path, callables, params, empty_types, members, constants, ops, target, natives,
                        ports, identities, true, [], [], [], &summary) {
        case .Failed(diagnostic):
            return ScalarFailure(path, text, diagnostic);
        case .Built(rows):
            head: facts.Row = {kind: facts.DocumentRow, type: 0, value: 0, count: 0, literal: 0, name: path,
                               text: Text(forest, text, Field(forest, declaration, syntax.FieldName)), start: 0, end: 0, line: 0,
                               column: 0};
            module: facts.Row[] = [ScalarSource(path, text), head];
            function: int = 0;
            for (row in rows) {
                identified := row;
                if (row.kind == facts.FunctionRow) {
                    identified.literal = i64(wrap: ids[function]);
                    function += 1;
                }
                module.append(identified);
            }
            return module;
    }
}

// A package set's documents as one text: each ends in a newline, so each
// starts a line, and every node of the set is moved to its document's place in
// it, which gives all the set's rows one source to lie in.
ScalarJoined :: (documents: snapshot.Document[]) -> string {
    parts: string[] = [];
    for (document in documents) {
        parts.append(document.text);
        if (!strings.HasSuffix(document.text, "\n")) {
            parts.append("\n");
        }
    }
    return strings.Concatenate(parts);
}
ScalarJoinedNodes :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[]) -> snapshot.SnapshotNode[] {
    offsets := resize([int(0)], length(forest));
    lines := resize([int(0)], length(forest));
    offset: int = 0;
    row: int = 0;
    for (document in documents) {
        for (at in document.node_start..<document.node_start + document.node_count) {
            offsets[at] = offset;
            lines[at] = row;
        }
        offset += strings.ByteLength(document.text);
        row += strings.Count(document.text, "\n");
        if (!strings.HasSuffix(document.text, "\n")) {
            offset += 1;
            row += 1;
        }
    }
    moved: snapshot.SnapshotNode[] = [];
    for (at in 0..<length(forest)) {
        node := forest[at];
        node.start += offsets[at];
        node.end += offsets[at];
        node.row += lines[at];
        moved.append(node);
    }
    return moved;
}
// The callables with those of document 0 first, in their order, then the rest
// in theirs: the entry of a package set is the first function of its first
// file, whichever package order puts the dependencies in front. A function
// named `chosen` in the root package goes first, regardless of its source file.
ScalarEntryFirst :: (callables: Callable[], chosen: string, root: int, bindings: ^(GenericBinding[])) -> Callable[] {
    ordered: Callable[] = [];
    remap := resize([int(-1)], length(callables));
    if (chosen != "") {
        for (callable, index in callables) {
            if (callable.package == root && callable.name == chosen) {
                remap[index] = length(ordered);
                ordered.append(callable);
            }
        }
    }
    for (callable, index in callables) {
        if (callable.document == 0 && (chosen == "" || callable.name != chosen)) {
            remap[index] = length(ordered);
            ordered.append(callable);
        }
    }
    for (callable, index in callables) {
        if (callable.document != 0 && (chosen == "" || callable.package != root || callable.name != chosen)) {
            remap[index] = length(ordered);
            ordered.append(callable);
        }
    }
    if (length(bindings^) > 0) { bindings^ = GenericRemapBindings(bindings^, remap); }
    return ordered;
}
// Whether the package identity `identity` is `NAME:...` for a collection NAME.
ScalarInCollection :: (collection_names: string[], identity: string) -> bool {
    for (name in collection_names) {
        if (strings.HasPrefix(identity, strings.Concatenate([name, ":"]))) {
            return true;
        }
    }
    return false;
}
// The facts rows of `text` at `path`. `names`, `natives`, `ports` and
// `identities` are the host's instruction names and native catalog, as
// Compile takes them. Supported text, math and collection capabilities pass
// through their ordinary catalog binding before native projection.
pub CollectScalar :: (project: string, path: string, text: string, target: Target, names: string[], natives: Native[],
                      ports: Port[], identities: u64[]) -> facts.Row[] {
    return ScalarCollect(project, [], [], [path], [text], target, names, natives, ports, identities, false, 0, 0, "", false);
}
// The authored parser's tree for `text`, for tools that read syntax outside the
// compiler's passes: the native census reads its sources through it.
pub ParseSyntax :: (text: string) -> parser.Tree {
    return raw.Parse(text);
}
// The grammar's names for ParseSyntax's integer kinds and fields.
pub SyntaxKindName :: (kind: int) -> string {
    return parser.KindName(kind);
}
pub SyntaxFieldNames :: () -> string[] {
    return syntax.FieldNames();
}
// The facts rows of the project packages `paths` hold, as CollectScalar gives
// one source's: the first function of the first file is the entry, the other
// files are packages it imports, and a call may name an import's function. The
// collections are Compile's; every package must be a project package. `os`
// and `arch` are the destination's, as TargetPackageText numbers them, and
// replace core:target's text, so a `when` on them selects the destination's
// declarations; 0 keeps the file's own.
pub CollectScalarPackages :: (project: string, collection_names: string[], collection_paths: string[], paths: string[],
                              sources: string[], target: Target, names: string[], natives: Native[], ports: Port[],
                              identities: u64[], os: int, arch: int) -> facts.Row[] {
    return ScalarCollect(project, collection_names, collection_paths, paths, sources, target, names, natives, ports,
                         identities, true, os, arch, "", false);
}
// CollectScalarPackages with the entry named: the function `chosen` of the root
// package instead of the first file's first function, and any collection's packages.
pub CollectScalarProgram :: (project: string, collection_names: string[], collection_paths: string[], paths: string[],
                             sources: string[], target: Target, names: string[], natives: Native[], ports: Port[],
                             identities: u64[], os: int, arch: int, chosen: string) -> facts.Row[] {
    return ScalarCollect(project, collection_names, collection_paths, paths, sources, target, names, natives, ports,
                         identities, true, os, arch, chosen, false);
}
// A shared package has independent Main/Frame host entries rather than a
// process entry. Keep imported function names outside that root namespace.
pub CollectScalarGeneration :: (project: string, collection_names: string[], collection_paths: string[], paths: string[],
                                sources: string[], target: Target, names: string[], natives: Native[], ports: Port[],
                                identities: u64[], os: int, arch: int) -> facts.Row[] {
    return ScalarCollect(project, collection_names, collection_paths, paths, sources, target, names, natives, ports,
                         identities, true, os, arch, "", true);
}
ScalarCollect :: (project: string, collection_names: string[], collection_paths: string[], paths: string[],
                  sources: string[], target: Target, names: string[], natives: Native[], ports: Port[],
                  identities: u64[], packaged: bool, os: int, arch: int, chosen: string, generation: bool) -> facts.Row[] {
    summary: ScalarEffectSummary = {wanted: false, natives: [], direct: [], waiting: [], calls: []};
    return ScalarCollectWithEffects(project, collection_names, collection_paths, paths, sources, target, names,
                                    natives, ports, identities, packaged, os, arch, chosen, generation, &summary);
}

ScalarCollectWithEffects :: (project: string, collection_names: string[], collection_paths: string[], paths: string[],
                             sources: string[], target: Target, names: string[], natives: Native[], ports: Port[],
                             identities: u64[], packaged: bool, os: int, arch: int, chosen: string, generation: bool,
                             summary: ^ScalarEffectSummary) -> facts.Row[] {
    if (length(paths) == 0 || length(paths) != length(sources) || length(collection_names) != length(collection_paths) ||
        (!packaged && length(paths) != 1)) {
        return ScalarFailure("", "", ScalarStart("scalar proof requires matching paths and sources"));
    }
    path := paths[0];
    text := sources[0];
    ops := ResolveOps(names, false);
    if (!Complete(ops)) {
        return ScalarFailure(path, text, ScalarStart("scalar proof requires a complete instruction catalog"));
    }
    resolved := LegacyNatives(natives, names);
    resolved_ports := LegacyPorts(ports);
    if (!NativeInputValid(resolved, resolved_ports, identities, resize([int(0)], length(natives)))) {
        return ScalarFailure(path, text, ScalarStart("scalar proof requires a complete native catalog"));
    }
    text_natives := ScalarTextNatives(resolved);
    text_ports := ScalarTextPorts(resolved, resolved_ports);
    text_identities := ScalarTextIdentities(resolved, identities);
    ScalarCollectionCatalog(text_natives, &text_ports);
    ScalarArrayCatalog(text_natives, &text_ports);
    ScalarTextCatalog(text_natives, &text_ports);
    ScalarMathCatalog(&text_natives, &text_ports, &text_identities);
    // The bootstrap catalog contains data functions only. Printing is a void
    // action, supplied here for the ordinary body checker and lowered below.
    // These private identities never cross the prepared/runtime ABI.
    has_print := false;
    for (native in text_natives) { has_print = has_print || NativeNameMatches(native, "print_string"); }
    if (!has_print) {
        printed: ResolvedNative = {name: "print_string", first: length(text_ports), parameters: 1, results: 0,
                                  variadic: false, direct: true, qualified_name: "print_string",
                                  kind: NativeFunctionKind, intrinsic: 0, effects: NativePrintEffect, source: false};
        port: ResolvedPort = {name: "InString", storage: TextStorage, container: 0, c_string: false, record: -1,
                             has_default: false, default_owner: false, default_supported: false,
                             default_bits: 0, default_text: ""};
        text_natives.append(printed);
        text_ports.append(port);
        text_identities.append(binding.ID("native-scalar", "print_string"));
        text_identities.append(binding.ID("native-scalar-signature", "print_string(string)"));
    }
    for (source in sources) {
        nul := ScalarNul(source);
        if (nul.message != "") {
            return ScalarFailure(path, text, nul);
        }
    }
    if (!packaged) {
        library_rows := ScalarLibrary(path, text, ops, target, text_natives, text_ports, text_identities);
        if (length(library_rows) > 0) {
            return library_rows;
        }
    }
    collections: routes.Collection[] = [];
    for (index in 0..<length(collection_names)) {
        collection: routes.Collection = {name: collection_names[index], path: collection_paths[index], has_name: true,
                                         has_path: true};
        collections.append(collection);
    }
    inputs: snapshot.Input[] = [];
    sizes: u64[] = [];
    for (index in 0..<length(paths)) {
        source := sources[index];
        if (os != 0 && TargetPackagePath(collection_names, collection_paths, paths[index])) {
            source = TargetPackageText(os, arch, target.pointer_size * 8, 1);
        }
        input: snapshot.Input = {path: paths[index], text: source, has_path: true, has_text: true};
        inputs.append(input);
        sizes.append(u64(strings.ByteLength(source)));
    }
    options: snapshot.Options = {project: project, has_project: true, has_options: true,
                                 has_files: true, has_collections: length(collections) != 0, file_count: length(inputs),
                                 collection_count: length(collections)};
    switch snapshot.Build(options, collections, inputs, sizes) {
        case .Rejected(diagnostic, related, graph_error, cycle, documents, nodes, imports):
            return ScalarFailed(packaged, path, text, documents, diagnostic);
        case .Accepted(roots, documents, nodes, imports, built):
            // A package set's diagnostics lie in its documents joined, as its rows do.
            shown_nodes := nodes;
            shown_text := text;
            if (packaged) {
                shown_nodes = ScalarJoinedNodes(nodes, documents);
                shown_text = ScalarJoined(documents);
            }
            document := documents[0];
            switch built {
                case .Rejected(error, cycle):
                    return ScalarFailure(path, shown_text,
                                         Diagnose(shown_nodes, document.syntax_root, 0, "scalar proof requires an accepted package graph"));
                case .Accepted(packages, files_of, file_packages, order, edges, links):
                    if (!packaged) {
                        unsupported := ScalarMembers(shown_nodes, document.syntax_root, false);
                        if (unsupported.message != "") {
                            return ScalarFailure(path, shown_text, unsupported);
                        }
                    }
                    if (packaged) {
                        for (candidate in documents) {
                            if (!strings.HasPrefix(candidate.identity, "project:") &&
                                !strings.HasPrefix(candidate.identity, "core:") &&
                                !ScalarInCollection(collection_names, candidate.identity)) {
                                return ScalarFailure(path, shown_text,
                                                     Diagnose(shown_nodes, candidate.syntax_root, 0,
                                                              "scalar proof imports only project, core and collection packages"));
                            }
                            member_gap := ScalarMembers(shown_nodes, candidate.syntax_root, true);
                            if (member_gap.message != "") {
                                return ScalarFailure(path, shown_text, member_gap);
                            }
                        }
                    }
                    if (!packaged && (length(packages) != 1 || length(imports) != 0)) {
                        return ScalarFailure(path, shown_text,
                                             Diagnose(shown_nodes, document.syntax_root, 0, "scalar proof requires one package without imports"));
                    }
                    roots_named: string[] = [document.identity];
                    if (packaged) {
                        roots_named = [];
                        for (listed in packages) {
                            roots_named.append(documents[files_of[listed.member_start]].identity);
                        }
                    }
                    // The foreign functions and procedure types the sources declare are
                    // natives to the body check. A native build owns its effects, so the
                    // proof treats them as it treats the text natives.
                    text_count := length(text_natives);
                    if (target.pointer_size == 4) {
                        rejected := ScalarWasmForeignABI(nodes, documents);
                        if (rejected.message != "") {
                            return ScalarFailed(packaged, path, text, documents, rejected);
                        }
                    }
                    foreign_effects: int[] = [];
                    switch ForeignNatives(nodes, documents, text_natives, text_ports, text_identities,
                                          resize([int(0)], text_count)) {
                        case .Failed(diagnostic):
                            return ScalarFailed(packaged, path, text, documents, diagnostic);
                        case .Declared(declared_natives, declared_ports, declared_identities, declared_effects):
                            text_natives = declared_natives;
                            text_ports = declared_ports;
                            text_identities = declared_identities;
                            foreign_effects = declared_effects;
                    }
                    if (summary.wanted) {
                        for (native in text_natives) { summary.natives.append(native.effects); }
                    }
                    for (index in text_count..<length(text_natives)) {
                        quiet := text_natives[index];
                        quiet.effects = 0;
                        text_natives[index] = quiet;
                    }
                    switch Declare(nodes, documents, packages, files_of, order, edges, file_packages[0], imports, links,
                                   target) {
                        case .Failed(diagnostic):
                            return ScalarFailed(packaged, path, text, documents, diagnostic);
                        case .Declared(callables, params, types, members, constants, active, bound, kept):
                            // Use the ordinary compiler's concrete functions and bindings. The
                            // scalar pass then checks its existing pure numeric domain.
                            table := types;
                            effects := resize([int(0)], length(text_natives));
                            switch SpecializePackages(nodes, documents, active, bound, roots_named,
                                                      WaitingCallables(nodes, callables), params, &table, members,
                                                      constants, text_natives, text_ports, text_identities,
                                                      BodyContext.Known(effects), ops, target) {
                                case .Failed(diagnostic):
                                    return ScalarFailed(packaged, path, text, documents, diagnostic);
                                case .Ready(concrete, concrete_params, bindings):
                                    if (!summary.wanted && GenericNeedsSynchronous(bindings)) {
                                        summary.wanted = true;
                                        // Foreign admission quiets effects on its private native rows.
                                        // Retain the original masks for this semantic lifetime check.
                                        for (native, index in text_natives) {
                                            summary.natives.append(native.effects | foreign_effects[index]);
                                        }
                                    }
                                    if (generation && length(concrete) == 0) {
                                        empty_head: facts.Row = {kind: facts.DocumentRow, type: 0, value: 0, count: 0,
                                            literal: 0, name: document.key, text: "", start: 0, end: 0, line: 0, column: 0};
                                        return [ScalarSource(path, ScalarJoined(documents)), empty_head];
                                    }
                                    entered := concrete;
                                    entered_bindings := bindings;
                                    if (!generation && packaged && length(concrete) > 0 && (concrete[0].document != 0 || chosen != "")) {
                                        entered = ScalarEntryFirst(concrete, chosen, file_packages[0], &entered_bindings);
                                        if (chosen != "" && (entered[0].name != chosen || entered[0].package != file_packages[0])) {
                                            return ScalarFailure(path, shown_text, Diagnose(shown_nodes, document.syntax_root, 0,
                                                format_text("No runnable {} in the root package", chosen)));
                                        }
                                        if (chosen == "" && entered[0].document != 0) {
                                            return ScalarFailure(path, shown_text, Diagnose(shown_nodes, document.syntax_root, 0,
                                                "No runnable entry in the first file"));
                                        }
                                    }
                                    // Import aliases name a package set's qualified calls; a lone source has none.
                                    module_links: graph.Binding[] = [];
                                    if (packaged) {
                                        module_links = bound;
                                    }
                                    scalar_nodes := nodes;
                                    scalar_text := text;
                                    scalar_documents := documents;
                                    if (packaged) {
                                        scalar_text = ScalarJoined(documents);
                                        scalar_nodes = ScalarJoinedNodes(nodes, documents);
                                        scalar_documents = [];
                                        for (member in documents) {
                                            joined := member;
                                            joined.text = scalar_text;
                                            scalar_documents.append(joined);
                                        }
                                    }
                                    switch ScalarModule(scalar_nodes, scalar_text, document.key, entered, concrete_params, table,
                                                        members, constants, ops, target, text_natives, text_ports, text_identities,
                                                        generation, entered_bindings, scalar_documents, module_links, summary) {
                                        case .Failed(diagnostic):
                                            // The native check already used joined nodes; its range
                                            // must not receive the document offset a second time.
                                            return ScalarFailure(path, scalar_text, diagnostic);
                                        case .Built(rows):
                                            head: facts.Row = {kind: facts.DocumentRow, type: 0, value: 0, count: 0,
                                                               literal: 0, name: document.key, text: "", start: 0, end: 0, line: 0,
                                                               column: 0};
                                            module: facts.Row[] = [ScalarSource(path, scalar_text), head];
                                            if (generation) {
                                                package_identities: string[] = [];
                                                for (package in packages) {
                                                    package_identities.append(documents[files_of[package.member_start]].identity);
                                                }
                                                module.extend(ScalarGenerationNames(rows, entered, package_identities, file_packages[0]));
                                            } else {
                                                module.extend(rows);
                                            }
                                            return module;
                                    }
                            }
                    }
            }
    }
}
