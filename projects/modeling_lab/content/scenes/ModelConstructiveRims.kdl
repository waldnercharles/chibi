version 1
name "ModelConstructiveRims"
(array)entities {
    - {
        name "Camera"
        prototype "StudyCamera"
        components {
            GameCamera width=340.0 height=240.0
            GameHRC2D surface_relief=0.0 ambient=0.3
        }
    }
    - {
        name "Key"
        prototype "StudyLight"
        components {
            GameTransform x=-145.0 y=-95.0
        }
    }
    - {
        name "Fill"
        prototype "StudyLight"
        components {
            GameTransform x=145.0 y=80.0
            GameMaterial emission_intensity=0.15
        }
    }
    - {
        name "ConstructRoundedPlate"
        prototype "ConstructRoundedPlate"
        components {
            GameTransform x=-95.0 y=-40.0
        }
    }
    - {
        name "ConstructBeveledPlate"
        prototype "ConstructBeveledPlate"
        components {
            GameTransform x=95.0 y=-40.0
        }
    }
    - {
        name "ConstructShellWindow"
        prototype "ConstructShellWindow"
        components {
            GameTransform x=-90.0 y=65.0
        }
    }
    - {
        name "ConstructConcaveBezier"
        prototype "ConstructConcaveBezier"
        components {
            GameTransform x=90.0 y=65.0
        }
    }
}
