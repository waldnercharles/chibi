+++ b/tools/compiler/package_compiler/TaskResults.chibi
@@ -0,0 +1,176 @@
+package package_compiler
+
+import snapshot "project:source_snapshot"
+
+// A task join returns the native structural union T | Cancelled. These
+// declarations carry semantic tags, rather than source union variant names.
+TaskResultDecl: int : 7;
+CancelledTag: uint64 : 0x63616e63656c6c65;
+TaskDeclarations :: union {
+    Collected(types: TypeDecl[], members: TypeMember[])
+}
+TaskSuccessValue :: (callable: Callable, params: Param[]) -> ValueType {
+    if (callable.results == 1) {
+        result := params[callable.first + callable.count];
+        return {storage: result.storage, container: result.container, record: result.record};
+    }
+    return {storage: callable.result, container: callable.result_container, record: callable.result_record};
+}
+TaskResultSupport :: (callable: Callable, types: TypeDecl[], params: Param[]) -> string {
+    if (callable.results > 1) { return "task handles with multiple results are not supported yet"; }
+    value := TaskSuccessValue(callable, params);
+    if (value.storage == UnionStorage && value.container == 0) {
+        return "task handles with a union result are not supported yet";
+    }
+    return "";
+}
+TaskSuccessTag :: (callable: Callable, types: TypeDecl[], params: Param[]) -> uint64 {
+    return SemanticTag(types, TaskSuccessValue(callable, params));
+}
+TaskResultRecord :: (types: TypeDecl[], callable: int) -> int {
+    index: int = 0;
+    while (index < length(types)) {
+        if (types[index].kind == TaskResultDecl && types[index].parent == callable) { return index; }
+        index += 1;
+    }
+    return -1;
+}
+TaskResultSuccess :: (types: TypeDecl[], record: int) -> ValueType {
+    declared := types[record];
+    return {storage: declared.value_storage, container: declared.value_container, record: declared.value_record};
+}
+TaskResultDeclarations :: (callables: Callable[], params: Param[], input_types: TypeDecl[],
+                           input_members: TypeMember[]) -> TaskDeclarations {
+    types := input_types;
+    members := input_members;
+    index: int = 0;
+    while (index < length(callables)) {
+        callable := callables[index];
+        if (!callable.waits || TaskResultRecord(types, index) >= 0 ||
+            TaskResultSupport(callable, types, params) != "") { index += 1; continue; }
+        value := TaskSuccessValue(callable, params);
+        success := TaskSuccessTag(callable, types, params);
+        first_tag := success;
+        second_tag := CancelledTag;
+        if (first_tag > second_tag) { first_tag = CancelledTag; second_tag = success; }
+        id := ((uint64(14695981039346656037) ^ first_tag) * uint64(1099511628211) ^ second_tag) * uint64(1099511628211);
+        parent := length(types);
+        declared: TypeDecl = {name: "", type_name: "", package: callable.package, node: -1,
+                              kind: TaskResultDecl, first: parent + 1, count: 2, size: 0, parent: index,
+                              storage: UnionStorage, id: id, layout: 0, component: 0, key: 0,
+                              value_storage: value.storage, value_container: value.container,
+                              value_record: value.record};
+        types.append(declared);
+        tags: uint64[] = [first_tag, second_tag];
+        for (tag in tags) {
+            name := "";
+            count: int = 0;
+            first := length(members);
+            if (tag == CancelledTag) { name = "Cancelled"; }
+            else if (value.storage != 0) {
+                member: TypeMember = {name: "", storage: value.storage, container: value.container,
+                                      record: value.record, offset: 0, writable: false, c_string: false,
+                                      constant: false, read: -1, read_key: ""};
+                members.append(member);
+                count = 1;
+            }
+            variant: TypeDecl = {name: name, type_name: "", package: callable.package, node: -1,
+                                 kind: VariantDecl, first: first, count: count, size: 0, parent: parent,
+                                 storage: UnionStorage, id: tag, layout: 0, component: 0, key: 0,
+                                 value_storage: 0, value_container: 0, value_record: -1};
+            types.append(variant);
+        }
+        index += 1;
+    }
+    return TaskDeclarations.Collected(types, members);
+}
+TaskResultPattern :: (forest: snapshot.SnapshotNode[], text: string, condition: int) -> bool {
+    pattern := Field(forest, condition, "type");
+    return Text(forest, text, pattern) == "Cancelled" && Field(forest, condition, "binding") < 0;
+}
+TaskResultIsStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, types: TypeDecl[],
+                     members: TypeMember[], names: Name[], scope: int, values: Value[], top: int,
+                     item: Work, ops: Ops, target: Target, at: Bases) -> Step {
+    value := values[top - 1];
+    if (!TaskResultPattern(forest, text, item.node)) {
+        return Fail(forest, item.node, document, "a task result pattern must be Cancelled");
+    }
+    variant := FindVariant(types, value.record, "Cancelled");
+    return MatchStep(forest, text, document, types, members, names, scope, -1, value.slot, variant, -1,
+                     false, Field(forest, item.node, "negated") >= 0, -1, -1, ops, target, at, forest[item.node]);
+}
+// A proof applies only within the tested branch and until a write or call
+// could change the binding. Loop back edges do not preserve an outer proof.
+TaskResultPresent :: (forest: snapshot.SnapshotNode[], text: string, binding: Name, node: int) -> bool {
+    // An is-test always observes the original union, including when an
+    // enclosing branch has already proved the success case.
+    subject := node;
+    test := forest[subject].parent;
+    while (Is(forest, test, "parenthesized_expression")) { subject = test; test = forest[subject].parent; }
+    if (Is(forest, test, "is_expression") && Field(forest, test, "value") == subject) { return false; }
+    function := node;
+    while (function >= 0 && !Is(forest, function, "function_declaration") && !Is(forest, function, "handler")) {
+        function = forest[function].parent;
+    }
+    if (function < 0) { return false; }
+    body := Field(forest, function, "body");
+    aliased := binding.place == ReferencePlace || Holds(AddressedNames(forest, text, body), binding.name);
+    child := node;
+    parent := forest[node].parent;
+    while (parent >= 0 && parent != function) {
+        if (Is(forest, parent, "if_statement") || Is(forest, parent, "while_statement")) {
+            condition := Unparenthesized(forest, Field(forest, parent, "condition"));
+            branch := Field(forest, parent, "consequence");
+            if (Is(forest, parent, "while_statement")) { branch = Field(forest, parent, "body"); }
+            truth := branch >= 0 && forest[child].start >= forest[branch].start && forest[child].end <= forest[branch].end;
+            alternative := Field(forest, parent, "alternative");
+            false_branch := alternative >= 0 && forest[child].start >= forest[alternative].start &&
+                            forest[child].end <= forest[alternative].end;
+            subject := Unparenthesized(forest, Field(forest, condition, "value"));
+            negated := Field(forest, condition, "negated") >= 0;
+            if (Is(forest, condition, "is_expression") && TaskResultPattern(forest, text, condition) &&
+                Is(forest, subject, "identifier") && Text(forest, text, subject) == binding.name &&
+                (truth || false_branch) && truth == negated && (binding.node < 0 || forest[binding.node].start < forest[condition].start)) {
+                return !PointerProofChanged(forest, text, parent, forest[condition].end, forest[node].start,
+                                            binding.name, aliased);
+            }
+            if (Is(forest, parent, "while_statement")) { return false; }
+        }
+        child = parent;
+        parent = forest[parent].parent;
+    }
+    return false;
+}
+// The structural success payload has no invented Success case: scalar and
+// record results are the original value in payload position zero.
+TaskResultReadStep :: (types: TypeDecl[], binding: Name, ops: Ops, target: Target, at: Bases,
+                       node: snapshot.SnapshotNode) -> Step {
+    value := TaskResultSuccess(types, binding.record);
+    if (value.storage == 0) {
+        return Step.Failed({start: node.start, end: node.end, line: node.row + 1, column: node.column + 1,
+                            document: -1, message: "a completed void task has no result value"});
+    }
+    first := types[binding.record].first;
+    if (types[first].id == CancelledTag) { first += 1; }
+    address := AddressSlot(target);
+    storage := SlotStorage(value.storage, value.container, target);
+    slots: Slot[] = [{storage: UnionStorage, kind: ValueKind}, address, address,
+                     {storage: storage, kind: SlotKind(value.storage, value.container)}];
+    code: Code[] = [Instruction(ops.local, UnionStorage, at.slot, binding.index, 0, 0, node)];
+    code.extend(CellWrite(UnionStorage, at.slot, at.cell, ops, target, at.slot + 1, node));
+    code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, node));
+    code.extend(CellRead(storage, at.cell + 4, ops, target, at.slot + 2, node));
+    tag := TypedCell(WordStorage, 0, -1);
+    tag.variant = first;
+    cells: Cell[] = [TypedCell(UnionStorage, 0, binding.record), tag, TypedCell(IntStorage, 0, -1),
+                     TypedCell(BoolStorage, 0, -1), TypedCell(value.storage, value.container, value.record)];
+    host: Host = {intrinsic: UnionGetIntrinsic, linked: -1, first: at.cell, result_first: at.cell + 4,
+                   result_count: 1, written: false};
+    roots: Root[] = [];
+    if (Pointer(value.storage, value.container)) {
+        root: Root = {slot: at.slot + 3, storage: value.storage, container: value.container, record: value.record};
+        roots.append(root);
+    }
+    return Step.Emitted(code, slots, [], cells, [host], roots, [], [], [], 0,
+                         Typed(at.slot + 3, value.storage, value.container, value.record), NoValue(), []);
+}
diff --git a/tools/compiler/package_compiler/Tasks.chibi b/tools/compiler/package_compiler/Tasks.chibi
new file mode 100644
index 000000000..db06b844f
--- /dev/null
+++ b/tools/compiler/package_compiler/Tasks.chibi
@@ -0,0 +1,214 @@
+package package_compiler
+
+import snapshot "project:source_snapshot"
+import binding "project:lexical_binding"
+
+// These are the existing persistent command identities from execution/task.h.
+TaskCommandBase: uint64 : 0x4348494900000100;
+DelayCommand: int : 1;
+YieldCommand: int : 2;
+JoinCommand: int : 3;
+CancelCommand: int : 4;
+RunningCommand: int : 5;
+CancelAfterCommand: int : 6;
+SuspendEffect: int : 16;
+
+TaskCommandNode :: (command: int, syntax_node: int) -> uint64 {
+    return binding.ID("task-command", format_text("{}:{}", command, syntax_node));
+}
+// The native analyzer identifies waiting functions from their own await/yield
+// syntax. An unawaited call starts independent work and never makes its caller
+// wait. Nested declarations likewise have their own suspension contract.
+WaitingBody :: (forest: snapshot.SnapshotNode[], body: int) -> bool {
+    pending: int[] = [body];
+    top: int = 1;
+    while (top > 0) {
+        top -= 1;
+        node := pending[top];
+        if (Is(forest, node, "yield_statement") || Is(forest, node, "await_expression")) { return true; }
+        if (node != body && (Is(forest, node, "function_declaration") || Is(forest, node, "macro_declaration"))) {
+            continue;
+        }
+        child := forest[node].first_child;
+        while (child >= 0) {
+            if (top < length(pending)) { pending[top] = child; }
+            else { pending.append(child); }
+            top += 1;
+            child = forest[child].next_sibling;
+        }
+    }
+    return false;
+}
+WaitingCallables :: (forest: snapshot.SnapshotNode[], callables: Callable[]) -> Callable[] {
+    marked := callables;
+    index: int = 0;
+    while (index < length(marked)) {
+        row := marked[index];
+        row.waits = WaitingBody(forest, Field(forest, row.node, "body"));
+        marked[index] = row;
+        index += 1;
+    }
+    return marked;
+}
+// Parentheses do not change whether a call is immediately awaited. The call
+// runs as an ordinary invocation in that case, preserving direct-await results.
+ImmediatelyAwaited :: (forest: snapshot.SnapshotNode[], node: int) -> bool {
+    at := node;
+    parent := forest[at].parent;
+    while (Is(forest, parent, "parenthesized_expression")) { at = parent; parent = forest[at].parent; }
+    return Is(forest, parent, "await_expression") && Field(forest, parent, "value") == at;
+}
+// One registry command. Its arguments and result keep body-cell coordinates;
+// assembly gives commands their separate runtime banks and remaps row indices.
+TaskCommandStep :: (forest: snapshot.SnapshotNode[], document: int, values: Value[], top: int,
+                    item: Work, command: int, success_tag: uint64, result: Value, ops: Ops,
+                    target: Target, at: Bases) -> Step {
+    node := forest[item.node];
+    if (target.error_status_offset <= 0) {
+        return Fail(forest, item.node, document, "task lowering needs the target error-status offset");
+    }
+    code: Code[] = [];
+    slots: Slot[] = [];
+    locals: Slot[] = [];
+    cells: Cell[] = [];
+    hosts: Host[] = [];
+    roots: Root[] = [];
+    calls: Invocation[] = [];
+    bound: Name[] = [];
+    next: Work[] = [];
+    marks: int[] = [];
+    count: int = 0;
+    popped: int = 0;
+    if (command != YieldCommand && command != DelayCommand) {
+        handle := values[top - 1];
+        if (command == CancelAfterCommand) { handle = values[top - 2]; }
+        if (!Single(handle, TaskStorage)) { return Fail(forest, item.node, document, "task operation needs a task handle"); }
+        cells.append({storage: TaskStorage, container: 0, record: -1, variant: -1});
+        write := Instruction(ops.command_argument, TaskStorage, 0, handle.slot, 0, at.cell, node);
+        write.offset = target.payload_offset;
+        code.append(write);
+        count = 1;
+        popped = 1;
+    }
+    if (command == JoinCommand) {
+        cells.append({storage: WordStorage, container: 0, record: -1, variant: -1, constant: success_tag});
+        count = 2;
+    }
+    if (command == CancelAfterCommand || command == DelayCommand) {
+        duration := values[top - 1];
+        if (!Single(duration, DoubleStorage)) { return Fail(forest, item.node, document, "cancellation duration needs a double"); }
+        cells.append({storage: DoubleStorage, container: 0, record: -1, variant: -1});
+        write := Instruction(ops.command_argument, DoubleStorage, 0, duration.slot, 0, at.cell + count, node);
+        write.offset = target.payload_offset;
+        code.append(write);
+        count += 1;
+        popped += 1;
+    }
+    result_count: int = 0;
+    if (result.storage > 0) {
+        result_count = 1;
+        cells.append({storage: result.storage, container: result.container, record: result.record, variant: -1});
+    }
+    operation: Host = {command: command, syntax_node: item.node,
+                       linked: -1, first: at.cell, result_first: at.cell + count, result_count: result_count};
+    hosts.append(operation);
+    action := TaskCommandNode(command, item.node);
+    begin := Instruction(ops.command_begin, 0, 0, 0, 0, at.host, node);
+    begin.payload = action;
+    code.append(begin);
+    if (command != RunningCommand) {
+        // Match native await_command: synchronously completed commands proceed
+        // in this activation; only a pending request creates a suspension.
+        slots.extend([ValueLocal(IntStorage), ValueLocal(IntStorage), ValueLocal(BoolStorage)]);
+        status := Instruction(ops.context, IntStorage, at.slot, 0, 0, 0, node);
+        status.offset = target.error_status_offset;
+        code.append(status);
+        code.append(ConstantCode(ops, IntStorage, 0, at.slot + 1, node));
+        code.append(Instruction(ops.gt, IntStorage, at.slot + 2, at.slot, at.slot + 1, -1, node));
+        code.append(Instruction(ops.branch_if, 0, 0, at.slot + 2, 0, at.pc + length(code) + 2, node));
+        code.append(Instruction(ops.jump, 0, 0, 0, 0, at.pc + length(code) + 2, node));
+        suspend := Instruction(ops.suspend, 0, 0, 0, 0, 0, node);
+        suspend.payload = action;
+        code.append(suspend);
+    }
+    produced := NoValue();
+    if (Is(forest, item.node, "await_expression")) { produced = Typed(-1, -1, 0, -1); }
+    if (result_count != 0) {
+        loaded := at.slot + length(slots);
+        slots.append({storage: SlotStorage(result.storage, result.container, target), kind: SlotKind(result.storage, result.container)});
+        read := Instruction(ops.command_result, SlotStorage(result.storage, result.container, target), loaded,
+                            at.cell + count, 0, 0, node);
+        read.offset = target.payload_offset;
+        code.append(read);
+        produced = Typed(loaded, result.storage, result.container, result.record);
+        if (result.storage == UnionStorage) {
+            empty := at.slot + length(slots);
+            slots.append(ValueLocal(UnionStorage));
+            code.append(ConstantCode(ops, UnionStorage, 0, empty, node));
+            clear := Instruction(ops.command_output, UnionStorage, 0, empty, 0, at.cell + count, node);
+            clear.offset = target.payload_offset;
+            code.append(clear);
+        }
+    }
+    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, popped, produced, NoValue(), marks);
+}
+
+// Task syntax delegates to the same commands used by native lowering. Direct
+// authored await returns its declared values; handle await returns the typed
+// success-or-Cancelled union supplied by TaskResults.
+TaskStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, callables: Callable[],
+             params: Param[], types: TypeDecl[], names: Name[], package: int, values: Value[], top: int,
+             item: Work, ops: Ops, target: Target, at: Bases) -> Step {
+    kind := forest[item.node].kind;
+    if (kind == "yield_statement") {
+        return TaskCommandStep(forest, document, values, top, item, YieldCommand, 0, NoValue(), ops, target, at);
+    }
+    if (item.phase == 0) {
+        next: Work[] = [];
+        if (kind == "cancel_statement") {
+            next.append(Visit(Field(forest, item.node, "value")));
+            duration := Field(forest, item.node, "duration");
+            phase: int = 1;
+            if (duration >= 0) { next.append(Expect(duration, DoubleStorage, 0, -1)); phase = 2; }
+            next.append(Resume(item.node, phase, 0, 0));
+        } else {
+            value := Unparenthesized(forest, Field(forest, item.node, "value"));
+            if (Is(forest, value, "call_expression") && CalledFunction(forest, text, callables, names, package, value) < 0) {
+                callee := Field(forest, value, "function");
+                if (Is(forest, callee, "identifier") && NameMatches(Text(forest, text, callee), "Delay")) {
+                    arguments := Members(forest, Field(forest, value, "arguments"));
+                    if (length(arguments) != 1) { return Fail(forest, value, document, "Delay requires one duration"); }
+                    next.append(Expect(arguments[0], DoubleStorage, 0, -1));
+                    next.append(Resume(item.node, 3, 0, 0));
+                    return Step.Emitted([], [], [], [], [], [], [], [], next, 0, NoValue(), NoValue(), []);
+                }
+                return Fail(forest, value, document, "await of native commands is not supported yet");
+            }
+            next.append(Visit(value));
+            next.append(Resume(item.node, 1, 0, 0));
+        }
+        return Step.Emitted([], [], [], [], [], [], [], [], next, 0, NoValue(), NoValue(), []);
+    }
+    if (kind == "cancel_statement") {
+        command := CancelCommand;
+        if (item.phase == 2) { command = CancelAfterCommand; }
+        return TaskCommandStep(forest, document, values, top, item, command, 0, NoValue(), ops, target, at);
+    }
+    if (item.phase == 3) {
+        return TaskCommandStep(forest, document, values, top, item, DelayCommand, 0, NoValue(), ops, target, at);
+    }
+    awaited := Unparenthesized(forest, Field(forest, item.node, "value"));
+    value := values[top - 1];
+    if (Is(forest, awaited, "call_expression") && CalledFunction(forest, text, callables, names, package, awaited) >= 0) {
+        return Step.Emitted([], [], [], [], [], [], [], [], [], 1, value, NoValue(), []);
+    }
+    if (!Single(value, TaskStorage) || value.record < 0 || value.record >= length(callables)) {
+        return Fail(forest, item.node, document, "await needs a task handle or authored call");
+    }
+    called := callables[value.record];
+    unsupported := TaskResultSupport(called, types, params);
+    if (unsupported != "") { return Fail(forest, item.node, document, unsupported); }
+    result := Typed(-1, UnionStorage, 0, TaskResultRecord(types, value.record));
+    return TaskCommandStep(forest, document, values, top, item, JoinCommand,
+                           TaskSuccessTag(called, types, params), result, ops, target, at);
+}
