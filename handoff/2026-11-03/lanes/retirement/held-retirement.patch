-/* A build needs a compiler with the sources' logic, and stage one has it: the
- * seed compiled it from them. Proving that the sources compile to themselves
- * (recover) costs two or three more whole-compiler compiles on the VM, about
- * 230 of the 350 seconds a cold Linux CI host start spent; the check path
- * does that, and CI's compiler self-build runs it on every push. Frees seed;
- * returns stage one's host, kept in the cache, or NULL with why, and writes
- * its closure's SHA-256 to identity when given. */
-static compiler_host *stage_one(
-    compiler_host *seed,
-    const artifact *a,
-    const char *json,
-    size_t length,
-    int changed,
-    const char *cache,
-    const char *key,
-    char *identity,
-    char *report,
-    size_t size
-)
-{
-    size_t bytes_length = 0;
-    unsigned char *bytes = compile(seed, json, length, &bytes_length, report, size);
-    compiler_host_free(seed);
-    if (!bytes) {
-        return NULL;
-    }
-    compiler_host *host = loaded(bytes, bytes_length, a, report, size);
-    if (host) {
-        const char *revision = yyjson_get_str(yyjson_obj_get(a->root, "revision"));
-        char digest[65];
-        sha256_hex(bytes, bytes_length, digest);
-        snprintf(
-            report,
-            size,
-            "%d compiler sources changed since revision %s; the artifact "
-            "compiled a compiler of %zu bytes, sha256 %s, from them",
-            changed,
-            revision && *revision ? revision : "unrecorded",
-            bytes_length,
-            digest
-        );
-        cache_publish(cache, key, bytes, bytes_length);
-        if (identity) {
-            memcpy(identity, digest, sizeof digest);
-        }
-    }
-    free(bytes);
-    return host;
-}
-
-bool compiler_bootstrap_check(const compiler_bootstrap *b, char *report, size_t size)
-{
-    artifact a = { 0 };
-    char *json = NULL;
-    size_t length = 0;
-    int changed = 0;
-    compiler_host *host = validated(b, &a, &json, &length, &changed, report, size);
-    bool valid = host &&
-                 recover(host, &a, json, length, changed, b->output, report, size);
-    if (valid && b->arguments && !write_path(b->arguments, json, length)) {
-        snprintf(report, size, "cannot write Compile's arguments to %s", b->arguments);
-        valid = false;
-    }
-    free(json);
-    free_artifact(&a);
-    return valid;
-}
-
-bool compiler_bootstrap_identity(const compiler_bootstrap *b, char *error, size_t size)
-{
-    assert(b->identity);
-    artifact a = { 0 };
-    char *json = NULL;
-    size_t length = 0;
-    int changed = 0;
-    bool known = false;
-    if (inputs(b, &a, &json, &length, &changed, error, size)) {
-        if (!changed) {
-            sha256_hex(a.closure, a.closure_length, b->identity);
-            known = true;
-        } else if (b->cache) {
-            char key[BINARY_CACHE_KEY_BYTES + 1];
-            cache_key(&a, json, length, key);
-            size_t kept_length = 0;
-            unsigned char *kept = binary_cache_read(b->cache, key, COMPILER_HOST_MAX_CLOSURE_BYTES, &kept_length);
-            if (kept) {
-                sha256_hex(kept, kept_length, b->identity);
-                known = true;
-            }
-            free(kept);
-        }
-        if (!known) {
-            snprintf(error, size, "the compiler is not recovered yet");
-        }
-    }
-    free(json);
-    free_artifact(&a);
-    return known;
-}
-
-compiler_host *compiler_bootstrap_load(const compiler_bootstrap *b, char *error, size_t size)
-{
-    artifact a = { 0 };
-    char *json = NULL;
-    size_t length = 0;
-    int changed = 0;
-    compiler_host *host = NULL;
-    if (inputs(b, &a, &json, &length, &changed, error, size)) {
-        char key[BINARY_CACHE_KEY_BYTES + 1];
-        const char *cache = changed ? b->cache : NULL;
-        if (cache) {
-            cache_key(&a, json, length, key);
-        }
-        size_t kept_length = 0;
-        unsigned char *kept = cache
-                                ? binary_cache_read(cache, key, COMPILER_HOST_MAX_CLOSURE_BYTES, &kept_length)
-                                : NULL;
-        /* A recovered compiler the cache holds is the one recovery would
-         * produce again, if this host still loads it. */
-        host = kept ? loaded(kept, kept_length, &a, error, size) : NULL;
-        if (host && b->identity) {
-            sha256_hex(kept, kept_length, b->identity);
-        }
-        free(kept);
-        /* A publisher may have replaced the entry since our failed read.
-         * Successful recovery replaces it atomically under the write lock. */
-        if (!host) {
-            host = loaded(a.closure, a.closure_length, &a, error, size);
-            if (host && !changed && b->identity) {
-                sha256_hex(a.closure, a.closure_length, b->identity);
-            }
-            if (host && changed) {
-                host = stage_one(host, &a, json, length, changed, cache, cache ? key : NULL, b->identity, error, size);
-            }
-        }
-    }
-    free(json);
-    free_artifact(&a);
-    return host;
-}
