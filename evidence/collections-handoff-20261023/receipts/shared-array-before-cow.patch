+                    items->items[i].container == PIN_CONTAINER_SINGLE &&
+                    items->items[i].type_name &&
+                    !strcmp(items->items[i].type_name, items->type_name)) {
+                    items->items[i].record = items->record;
+                    items->items[i].type_name = items->type_name;
