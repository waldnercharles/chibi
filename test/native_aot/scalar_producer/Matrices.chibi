LoopsFixtureSource :: () -> string { return "package scalar\nMain :: () -> int { return Sum(3); }\nSum :: (n: int) -> int {\n    total := 0;\n    for (i in 0..<n) {\n        if (i == 1) { break; }\n        total += i;\n    }\n    while (true) {\n        if (total > 1) { return total; }\n        total += 1;\n        if (total < 0) { continue; }\n    }\n}\n"; }
