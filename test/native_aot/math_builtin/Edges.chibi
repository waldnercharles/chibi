package native_math_edges

import os "core:os"

NaN32 :: (value: number) { assert(value != value, "number result is NaN"); }
NaN64 :: (value: f64) { assert(value != value, "f64 result is NaN"); }
Zero32 :: (value: number, negative: bool) {
    assert(value == 0.0, "number result is zero");
    assert((1.0 / value < 0.0) == negative, "number zero keeps its sign");
}
Zero64 :: (value: f64, negative: bool) {
    assert(value == 0.0, "f64 result is zero");
    assert((1.0 / value < 0.0) == negative, "f64 zero keeps its sign");
}
Infinity32 :: (value: number, negative: bool) {
    assert(value != 0.0 && value == value + value, "number result is infinite");
    assert((value < 0.0) == negative, "number infinity keeps its sign");
}
Infinity64 :: (value: f64, negative: bool) {
    assert(value != 0.0 && value == value + value, "f64 result is infinite");
    assert((value < 0.0) == negative, "f64 infinity keeps its sign");
}
Near :: (value: number, expected: number) {
    assert(abs(value - expected) < 0.000001, "finite angle stays within one microradian");
}
Same :: (value: number, expected: number) {
    if (expected != expected) { NaN32(value); return; }
    assert(value == expected, "number value survives the math calls");
    if (expected == 0.0) {
        assert(1.0 / value == 1.0 / expected, "passed number keeps zero sign");
    }
}

UnaryEdges :: (nan: number, infinity: number, zero: number, tiny: number) {
    for (invalid in [nan, infinity, -infinity]) {
        NaN32(sin(invalid));
        NaN32(cos(invalid));
        NaN32(tan(invalid));
        NaN32(asin(invalid));
        NaN32(acos(invalid));
    }
    NaN32(asin(-2.0));
    NaN32(asin(2.0));
    NaN32(acos(-2.0));
    NaN32(acos(2.0));
    Zero32(tan(-zero), true);
    Zero32(asin(-zero), true);
    Near(asin(1.0), 1.5707963267948966);
    Near(asin(-1.0), -1.5707963267948966);
    Zero32(acos(1.0), false);
    Near(acos(-1.0), 3.141592653589793);
    Zero32(atan(-zero), true);
    NaN32(atan(nan));
    Near(atan(infinity), 1.5707963267948966);
    Near(atan(-infinity), -1.5707963267948966);
    Infinity32(log(zero), true);
    Infinity32(log(-zero), true);
    NaN32(log(-1.0));
    NaN32(log(-infinity));
    NaN32(log(nan));
    Infinity32(log(infinity), false);
    logarithm := log(tiny);
    assert(logarithm < 0.0 && logarithm > -100.0, "positive subnormal logarithm is finite");
}

PowerEdges :: (nan: number, infinity: number, zero: number, tiny: number) {
    NaN32(exp(nan));
    Infinity32(exp(infinity), false);
    Zero32(exp(-infinity), false);
    assert(exp(tiny) == 1.0, "number exponential rounds the tiny input to one");
    NaN32(pow(-2.0, 0.5));
    Zero32(pow(-zero, 3.0), true);
    Infinity32(pow(-zero, -3.0), true);
    assert(pow(nan, zero) == 1.0 && pow(1.0, nan) == 1.0, "number power keeps NaN identity cases");
    wide_nan := f64(nan);
    wide_infinity := f64(infinity);
    wide_zero := f64(zero);
    NaN64(exp(wide_nan));
    Infinity64(exp(wide_infinity), false);
    Zero64(exp(-wide_infinity), false);
    NaN64(pow(f64(-2.0), f64(0.5)));
    Zero64(pow(-wide_zero, f64(3.0)), true);
    Infinity64(pow(-wide_zero, f64(-3.0)), true);
    assert(pow(wide_nan, wide_zero) == f64(1.0) && pow(f64(1.0), wide_nan) == f64(1.0),
           "f64 power keeps NaN identity cases");
}

Atan2Edges :: (nan: number, infinity: number, zero: number) {
    Zero32(atan2(zero, zero), false);
    Zero32(atan2(-zero, zero), true);
    Near(atan2(zero, -zero), 3.141592653589793);
    Near(atan2(-zero, -zero), -3.141592653589793);
    NaN32(atan2(nan, 1.0));
    NaN32(atan2(1.0, nan));
    Near(atan2(infinity, infinity), 0.7853981633974483);
    Near(atan2(infinity, -infinity), 2.356194490192345);
    Near(atan2(-infinity, infinity), -0.7853981633974483);
    Near(atan2(-infinity, -infinity), -2.356194490192345);
}

// The former BF clamp and source clamp intentionally have different operand
// order. Keep both expressions visible instead of changing the source contract.
ClampEdges :: (nan: number, zero: number) {
    assert(max(min(nan, 1.0), zero) == 1.0 && clamp(nan, zero, 1.0) == zero);
    NaN32(max(min(0.5, 1.0), nan));
    assert(clamp(0.5, nan, 1.0) == 1.0);
    assert(max(min(0.5, nan), zero) == zero);
    NaN32(clamp(0.5, zero, nan));
    assert(max(min(zero, 1.0), 2.0) == 2.0 && clamp(zero, 2.0, 1.0) == 1.0);
    Zero32(max(min(zero, zero), -zero), true);
    Zero32(clamp(zero, -zero, zero), false);
    Zero32(max(min(-zero, -zero), zero), false);
    Zero32(clamp(-zero, zero, -zero), true);
}

LiveResult :: struct { value: number; carried: number; flag: bool; }
Live :: (a: number, b: number, c: number, d: number, e: number, f: number,
         carried: number, flag: bool, bias: ^number) -> LiveResult {
    s0 := sin(a); s1 := sin(b); s2 := sin(c);
    s3 := sin(d); s4 := sin(e); s5 := sin(f);
    // All six sine values remain live across the six subsequent calls.
    c0 := cos(s0); c1 := cos(s1); c2 := cos(s2);
    c3 := cos(s3); c4 := cos(s4); c5 := cos(s5);
    sine_sum := s0;
    sine_sum += s1; sine_sum += s2; sine_sum += s3; sine_sum += s4; sine_sum += s5;
    cosine_sum := c0;
    cosine_sum += c1; cosine_sum += c2; cosine_sum += c3; cosine_sum += c4; cosine_sum += c5;
    return {value: (sine_sum + cosine_sum) + bias^, carried: carried, flag: flag};
}

Main :: () -> int {
    // These runners supply no program arguments. The argument count crosses
    // the existing runtime ABI, so O2 cannot fold every input and math call.
    zero := number(length(os.Arguments()));
    infinity := 1.0 / zero;
    nan := infinity - infinity;
    tiny: number = 1e-40;
    tiny += zero;
    UnaryEdges(nan, infinity, zero, tiny);
    PowerEdges(nan, infinity, zero, tiny);
    Atan2Edges(nan, infinity, zero);
    ClampEdges(nan, zero);
    cases := [nan, infinity, -infinity, -zero, zero, tiny, 0.375 + zero];
    bias: number = 2.75;
    for (first, sample in cases) {
        values := [first, zero + 0.1 + 1.0 * 0.2, zero + 0.1 + 2.0 * 0.2,
                   zero + 0.1 + 3.0 * 0.2, zero + 0.1 + 4.0 * 0.2, zero + 0.1 + 5.0 * 0.2];
        flag := sample % 2 == 1;
        actual := Live(values[0], values[1], values[2], values[3], values[4], values[5], first, flag, &bias);
        sine_sum := sin(first);
        cosine_sum := cos(sine_sum);
        for (index in 1..<length(values)) {
            sine := sin(values[index]);
            sine_sum += sine;
            cosine_sum += cos(sine);
        }
        Same(actual.value, (sine_sum + cosine_sum) + 2.75);
        Same(actual.carried, first);
        assert(actual.flag == flag && bias == 2.75, "math calls preserve bool and external bias");
    }
    return 0;
}
