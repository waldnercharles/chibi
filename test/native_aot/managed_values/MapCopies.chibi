package map_copies
foreign { chibi_value_test_allocations :: () -> i64 }
Main :: () -> int {
    values: [int:int[]] = [1:[1]];
    for index in 2..<18 { values[index] = [index]; }
    before := chibi_value_test_allocations();
    sum := 0;
    for index in 0..<4096 {
        snapshot := values;
        sum += snapshot[1][0];
    }
    completed := chibi_value_test_allocations();
    assert(sum == 4096);
    assert(completed == before, "readonly source map copies share backing");
    changed := values;
    changed[1].append(3);
    assert(length(changed[1]) == 2 && changed[1][1] == 3);
    assert(values[1][0] == 1 && length(values[1]) == 1);
    changed = values;
    changed[1].extend([4,5]);
    assert(length(changed[1]) == 3 && changed[1][1] == 4 && changed[1][2] == 5);
    assert(values[1][0] == 1 && length(values[1]) == 1);
    changed = values;
    changed[1][0] = 9;
    assert(changed[1][0] == 9);
    assert(values[1][0] == 1 && length(values[1]) == 1);
    changed = values;
    changed[1].remove_index(0);
    assert(length(changed[1]) == 0);
    assert(values[1][0] == 1 && length(values[1]) == 1);
    changed = values;
    changed[1].resize(3);
    assert(length(changed[1]) == 3 && changed[1][0] == 1 && changed[1][2] == 0);
    assert(values[1][0] == 1 && length(values[1]) == 1);
    return 0;
}
