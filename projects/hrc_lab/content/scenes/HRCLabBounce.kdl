version 1
name "HRCLabBounce"
(array)entities {
    - {
        name "Camera"
        prototype "HRCLabCamera"
        components {
            GameTransform x=0 y=0
        }
    }
    - {
        name "HRC"
        prototype "HRCLabHRC"
        components {
            GameTransform x=0 y=0
        }
    }
    - {
        name "Emitter"
        prototype "HRCLabEmitter"
        components {
            GameTransform x=-340 y=-150
            GameAppearance width=24 height=24 shape="Circle"
        }
    }
    - {
        name "First reflector"
        prototype "HRCLabReceiver"
        components {
            GameTransform x=-150 y=-80
            GameAppearance width=180 height=24
            GameOrientation radians=0.45
        }
    }
    - {
        name "Second reflector"
        prototype "HRCLabReceiver"
        components {
            GameTransform x=80 y=70
            GameAppearance width=180 height=24
            GameOrientation radians=-0.45
        }
    }
    - {
        name "Receiver"
        prototype "HRCLabReceiver"
        components {
            GameTransform x=320 y=0
            GameAppearance width=100 height=380
        }
    }
    - {
        name "Backdrop"
        prototype "HRCLabReceiver"
        components {
            GameTransform x=0 y=0
            GameAppearance width=960 height=540 shape="Box" layer=-100
            GameMaterial absorption=0 albedo=3503345919 scene=1802202111 edge_light=0
        }
    }
}
