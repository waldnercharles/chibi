cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/generated_file.cmake")
if(NOT DEFINED OUTPUT OR NOT PACKS)
    message(FATAL_ERROR "OUTPUT and PACKS are required")
endif()
set(unique "${PACKS}")
list(REMOVE_DUPLICATES unique)
if(NOT unique STREQUAL PACKS)
    message(FATAL_ERROR "compose_registry: duplicate pack symbol")
endif()
set(content "/* Generated registry composition. Do not edit. */\n\n#include \"graph/model/registry.h\"\n\n")
foreach(pack IN LISTS PACKS)
    if(NOT pack MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Invalid registry pack symbol: ${pack}")
    endif()
    string(APPEND content "extern const registry_pack ${pack};\n")
endforeach()
string(APPEND content "\nconst registry_pack *const REGISTRY_PACKS[] = {\n")
foreach(pack IN LISTS PACKS)
    string(APPEND content "    &${pack},\n")
endforeach()
list(LENGTH PACKS count)
string(APPEND content "};\nconst int REGISTRY_PACK_COUNT = ${count};\n")
bp_write_generated("${OUTPUT}" "${content}")
