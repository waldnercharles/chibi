// Analytic lab fixtures matching optics_reference.py. Coordinates are Y-up.
const float PI = 3.14159265359;
const vec2 EXTENT = vec2(2, 1.125);
// At <=1024 cells per axis and <=4 events, even all emitted power in one
// pixel contributes <5222 fluence. The uint range is 8192 at this scale.
const float ACCUM_SCALE=524288.0;
const float EPS = 0.000002;
layout(set=2, binding=0) uniform Params {
    ivec4 u_grid; // width, height, directions, scene (0 empty, 1 lens, 2 slab, 3 prism, 4 mirror)
    ivec4 u_budget; // paths, interfaces, initialize, boundary filter
    vec4 u_scene; // fog, power, Y shift, step: 1 local / 0 long / -1 surface band
    ivec4 u_multigrid; // residual solver operation, physical solution, angular transfer, reserved
};
float cross2(vec2 a, vec2 b) { return a.x*b.y-a.y*b.x; }
vec2 fixture_vertex(int i) {
    if (u_grid.w == 2) {
        if (i == 0) return vec2(.65,.15);
        if (i == 1) return vec2(.9,.15);
        if (i == 2) return vec2(.9,.975);
        return vec2(.65,.975);
    }
    if (u_grid.w == 4) return i == 0 ? vec2(.55,.2) : vec2(1.15,.8);
    if (i == 0) return vec2(.55,.25);
    if (i == 1) return vec2(1,.25);
    return vec2(.775,.95);
}
bool inside(vec2 p) {
    if (u_grid.w == 0 || u_grid.w == 4) return false;
    p.y -= u_scene.z;
    if (u_grid.w == 1) return distance(p,vec2(.8,.5625)) < .23;
    int count = u_grid.w == 2 ? 4 : 3;
    for (int i=0;i<count;i++) {
        vec2 a=fixture_vertex(i), b=fixture_vertex((i+1)%count);
        if (cross2(b-a,p-a)<=0) return false;
    }
    return true;
}
float surface_distance(vec2 p) {
    if (u_grid.w==0) return 1e10;
    p.y-=u_scene.z;
    if (u_grid.w==1) return abs(length(p-vec2(.8,.5625))-.23);
    int count=u_grid.w==2 ? 4 : (u_grid.w==4 ? 1 : 3);
    float nearest=1e10;
    for (int i=0;i<count;i++) {
        vec2 a=fixture_vertex(i), b=fixture_vertex((i+1)%(u_grid.w==2 ? 4 : 3));
        vec2 edge=b-a;
        vec2 delta=p-a-edge*clamp(dot(p-a,edge)/dot(edge,edge),0,1);
        nearest=min(nearest,length(delta));
    }
    return nearest;
}
float hit_near(vec2 p, vec2 d, float minimum, out vec2 normal) {
    normal=vec2(0);
    if (u_grid.w == 0) return 1e10;
    p.y -= u_scene.z;
    if (u_grid.w == 1) {
        vec2 q=p-vec2(.8,.5625);
        float b=dot(q,d), disc=b*b-dot(q,q)+.23*.23;
        if (disc<=0) return 1e10;
        float t=-b-sqrt(disc);
        if (t<=minimum) t=-b+sqrt(disc);
        if (t<=minimum) return 1e10;
        normal=normalize(q+t*d);
        return max(0,t);
    }
    float nearest=1e10;
    int count=u_grid.w == 2 ? 4 : (u_grid.w == 4 ? 1 : 3);
    for (int i=0;i<count;i++) {
        vec2 a=fixture_vertex(i), b=fixture_vertex((i+1)%(u_grid.w == 2 ? 4 : 3)), edge=b-a;
        float det=cross2(d,edge);
        if (abs(det)<1e-7) continue;
        float t=cross2(a-p,edge)/det, f=cross2(a-p,d)/det;
        if (t>minimum && t<nearest && f>=0 && f<=1) {
            nearest=t; normal=normalize(vec2(edge.y,-edge.x));
        }
    }
    return max(0,nearest);
}
float hit(vec2 p, vec2 d, out vec2 normal) { return hit_near(p,d,EPS,normal); }
float exit_distance(vec2 p, vec2 d) {
    vec2 t=vec2(1e10);
    if (abs(d.x)>1e-8) t.x=((d.x>0 ? EXTENT.x : 0)-p.x)/d.x;
    if (abs(d.y)>1e-8) t.y=((d.y>0 ? EXTENT.y : 0)-p.y)/d.y;
    return max(0,min(t.x,t.y));
}
vec3 extinction(vec2 p, bool glass) {
    if (glass) return vec3(.15,.05,.01);
    vec2 cell=clamp(floor(p/EXTENT*vec2(32,18)),vec2(0),vec2(31,17));
    float rho=1+.25*cos(cell.x*2*PI/32)*sin(cell.y*2*PI/18);
    return vec3(u_scene.x*rho);
}
float fresnel(vec2 d, vec2 n, float ni, float nt, out vec2 transmitted) {
    float c=clamp(-dot(d,n),0,1), eta=ni/nt;
    float k=1-eta*eta*(1-c*c);
    if (k<=0) { transmitted=vec2(0); return 1; }
    float ct=sqrt(k);
    transmitted=eta*d+(eta*c-ct)*n;
    float rs=(ni*c-nt*ct)/(ni*c+nt*ct), rp=(nt*c-ni*ct)/(nt*c+ni*ct);
    return .5*(rs*rs+rp*rp);
}
