layout(set=0,binding=0) uniform sampler2D u_field;
layout(set=1,binding=0,rgba8) uniform writeonly image2D u_display;
layout(local_size_x=16,local_size_y=16) in;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy), size=imageSize(u_display);
    if (any(greaterThanEqual(p,size))) return;
    vec3 value=texture(u_field,(vec2(p)+.5)/vec2(size)).rgb;
    imageStore(u_display,p,vec4(pow(1-exp(-value*.5),vec3(1/2.2)),1));
}
