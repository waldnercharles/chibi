package package_paths

import strings "core:strings"

// A request with every part present; Unfloored and Unrooted clear parts.
Full :: (base: string, path: string, floor: string) -> Request {
    return {base: base, path: path, floor: floor, has_base: true, has_path: true, has_floor: true};
}
Unfloored :: (base: string, path: string) -> Request {
    request := Full(base, path, "");
    request.has_floor = false;
    return request;
}
Unrooted :: (path: string) -> Request {
    request := Unfloored("", path);
    request.has_base = false;
    return request;
}

Normalizes :: (request: Request, expected: string) {
    switch Normalize(request) {
        case .Normalized(path):
            assert(path == expected, "normalized path");
        case .Invalid:
            assert(false, "valid path was refused");
    }
}
Refuses :: (request: Request) {
    switch Normalize(request) {
        case .Normalized(path):
            assert(false, "invalid path was accepted");
        case .Invalid:
            return;
    }
}

@test
RootsAndFilesResolveBelowTheirBase :: () {
    Normalizes(Unrooted("/workspace/./project"), "/workspace/project");
    Normalizes(Unrooted("/sdk/./core"), "/sdk/core");
    Normalizes(Full("/workspace/project", "app/a.chibi", "/workspace/project"), "/workspace/project/app/a.chibi");
    Normalizes(Unfloored("/workspace/project", "/workspace/project/app/./a.chibi"), "/workspace/project/app/a.chibi");
    Normalizes(Unfloored("/workspace/project", "/sdk/core/scalar/a.chibi"), "/sdk/core/scalar/a.chibi");
    Normalizes(Unrooted("/moved/project"), "/moved/project");
    Normalizes(Unfloored("bad\\base", "/ok"), "/ok");
}

@test
ImportsStayWithinTheirFloor :: () {
    Normalizes(Full("/workspace/project/app", "../math", "/workspace/project"), "/workspace/project/math");
    Normalizes(Full("/workspace/project", "math/.", "/workspace/project"), "/workspace/project/math");
    Normalizes(Full("/sdk/core", "scalar", "/sdk/core"), "/sdk/core/scalar");
    Normalizes(Full("/workspace/project/app", "../missing", "/workspace/project"), "/workspace/project/missing");
    Refuses(Full("/workspace/project/app", "../../outside", "/workspace/project"));
    Refuses(Full("/workspace/project/app", "../math", "/workspace/project/app"));
    Refuses(Full("", "/workspace/project2/a", "/workspace/project"));
    Refuses(Full("/workspace/project", "../project/app", "/workspace/project"));
}

@test
SeparatorsAndDotsCollapse :: () {
    Normalizes(Full("/", "x/../y", "/"), "/y");
    Normalizes(Full("/workspace/project", "./a//b/../c", "/workspace/project"), "/workspace/project/a/c");
    Normalizes(Unfloored("/workspace/project", ""), "/workspace/project");
    Normalizes(Unrooted("/"), "/");
    Refuses(Unfloored("/workspace/project", "a\\b"));
}

@test
MissingPartsAreRefused :: () {
    absent := Unfloored("/workspace/project", "");
    absent.has_path = false;
    Refuses(absent);
    Refuses(Unrooted("app"));
}

@test
PathsAreBoundedBeforeAndAfterCollapse :: () {
    segment := strings.Repeat("a", 300);
    Normalizes(Full("/workspace/project", segment, "/workspace/project"), format_text("/workspace/project/{}", segment));
    longest := format_text("/{}", strings.Repeat("a", 4094));
    Normalizes(Unrooted(longest), longest);
    Refuses(Unrooted(format_text("/{}", strings.Repeat("a", 4095))));
    Refuses(Unfloored("/", format_text(".{}", strings.Repeat("/", 4093))));
}
