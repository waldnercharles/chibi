package os

// Files, directories, processes and the environment, as Odin's core:os offers
// them. Until `foreign import` reaches libc, every operation is the build
// host's native underneath, so this package compiles only where that host
// provides them; callers keep their signatures when the bodies change.
//
// Paths are relative to the program's root unless absolute. A fallible
// operation reports an expected failure of the file system or a process as
// an Error and leaves its other results empty. A bug (an invalid argument)
// stops the program.

pub NotFound: int : 1;
pub Permission: int : 2;
pub AlreadyExists: int : 3;
pub Failed: int : 4;

@error
pub Error :: struct {
    kind: int;
    code: int;
}

pub KindNone: int : 0;
pub KindFile: int : 1;
pub KindDirectory: int : 2;
pub KindLink: int : 3;
pub KindOther: int : 4;

// A finished child process. `status` is its exit status; a nonzero status is
// not an Error.
pub Result :: struct {
    status: int;
    stdout: string;
    stderr: string;
}

Failure :: (kind: int) -> Error {
    failed: Error = {kind: kind, code: 0};
    return failed;
}

// What the path names, KindNone when nothing. A link is not followed.
pub Kind :: (path: string) -> int {
    kind := build.file_kind(path);
    if (kind == "file") {
        return KindFile;
    }
    if (kind == "directory") {
        return KindDirectory;
    }
    if (kind == "link") {
        return KindLink;
    }
    if (kind == "other") {
        return KindOther;
    }
    return KindNone;
}

pub IsFile :: (path: string) -> bool {
    return build.file_kind(path) == "file";
}

pub IsDirectory :: (path: string) -> bool {
    return build.file_kind(path) == "directory";
}

pub Exists :: (path: string) -> bool {
    return build.file_exists(path);
}

// Identifies the file's content and metadata for change detection: equal
// stamps mean the same file untouched. "" when the path does not exist.
pub Stamp :: (path: string) -> string {
    return build.file_stamp(path);
}

pub ReadText :: (path: string) -> (text: string, error: Error?) {
    if (Kind(path) != KindFile) {
        return ("", Failure(NotFound));
    }
    return (build.read_file(path), nil);
}

pub WriteText :: (path: string, text: string) -> Error? {
    if (!build.write_file(path, text)) {
        return Failure(Failed);
    }
    return nil;
}

pub Copy :: (source: string, destination: string) -> Error? {
    if (!build.copy_file(source, destination)) {
        return Failure(Failed);
    }
    return nil;
}

pub Rename :: (source: string, destination: string) -> Error? {
    if (!build.rename(source, destination)) {
        return Failure(Failed);
    }
    return nil;
}

// Removes a file, or an empty directory. Absent is not an error.
pub Remove :: (path: string) -> Error? {
    if (!build.remove(path)) {
        return Failure(Failed);
    }
    return nil;
}

pub MakeDirectory :: (path: string) -> Error? {
    if (!build.make_directory(path)) {
        return Failure(Failed);
    }
    return nil;
}

// Makes one new directory whose parent exists. Any existing path, including
// a link, fails; nothing is replaced.
pub Reserve :: (path: string) -> Error? {
    if (!build.reserve_directory(path)) {
        return Failure(Failed);
    }
    return nil;
}

// Atomically renames a prepared directory to a destination that does not
// exist. Any existing destination fails; nothing is replaced.
pub Publish :: (source: string, destination: string) -> Error? {
    if (!build.publish_directory(source, destination)) {
        return Failure(Failed);
    }
    return nil;
}

// The names in a directory, in the order the host lists them.
pub List :: (path: string) -> (names: string[], error: Error?) {
    if (Kind(path) != KindDirectory) {
        empty: string[] = [];
        return (empty, Failure(NotFound));
    }
    return (build.list_directory(path), nil);
}

// The absolute path with links resolved, "" when the path does not exist.
pub RealPath :: (path: string) -> string {
    return build.resolve_path(path);
}

// Lowercase hexadecimal SHA-256 of the file's bytes.
pub HashFile :: (path: string) -> (digest: string, error: Error?) {
    if (Kind(path) != KindFile) {
        return ("", Failure(NotFound));
    }
    return (build.hash_file(path), nil);
}

// The directory build programs are rooted at.
pub Root :: () -> string {
    return build.root();
}

// The directory holding the build program's source.
pub ProgramDirectory :: () -> string {
    return build.program_directory();
}

// Runs a program to completion with its output going to the build's own.
// The result is its exit status; failing to start reports 127.
pub Run :: (command: string[]) -> int {
    return build.run(command);
}

// Runs a program and captures its output. Nothing prints.
pub Capture :: (command: string[]) -> Result {
    status := build.probe(command);
    return {status: status, stdout: build.last_stdout(), stderr: build.last_stderr()};
}

// Starts a program without waiting; Wait returns its exit status.
pub Spawn :: (command: string[]) -> int {
    return build.start(command);
}

pub Wait :: (handle: int) -> int {
    return build.wait(handle);
}

// The first executable of that name on PATH, "" when none.
pub FindExecutable :: (name: string) -> string {
    return build.find_executable(name);
}

// The variable's value, "" when it is unset.
pub Getenv :: (name: string) -> string {
    return build.environment(name);
}

pub Environment :: () -> string[] {
    return build.environment_names();
}

pub Arguments :: () -> string[] {
    return build.arguments();
}

// "Darwin" or "Linux".
pub Platform :: () -> string {
    return build.platform();
}

// Writes one line to the build's error output.
pub Print :: (line: string) {
    build.report(line);
}
