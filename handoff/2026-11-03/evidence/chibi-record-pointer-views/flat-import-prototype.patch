+        out.append(format_text("  %text{} = extractvalue {} {}, {}\n  %owner{} = extractvalue {} %text{}, 2\n", field, name, previous, field, field, abi.TextType(), field));
+        out.append(format_text("  %borrowed{} = icmp eq ptr %owner{}, null\n  br i1 %borrowed{}, label %import{}, label %done{}\nimport{}:\n", field, field, field, field, field, field));
+        out.append(format_text("  %data{} = extractvalue {} %text{}, 0\n  %length{} = extractvalue {} %text{}, 1\n", field, abi.TextType(), field, field, abi.TextType(), field));
+        out.append(format_text("  %owned{} = call {} @chibi_text.copy(ptr %ctx, ptr %data{}, i32 %length{})\n", field, abi.TextType(), field, field));
+        out.append(format_text("  %changed{} = insertvalue {} {}, {} %owned{}, {}\n  br label %done{}\ndone{}:\n", field, name, previous, abi.TextType(), field, field, field, field));
+        out.append(format_text("  %value{} = phi {} [ {}, %{} ], [ %changed{}, %import{} ]\n", field, name, previous, predecessor, field, field));
+        previous = format_text("%value{}", field);
+        predecessor = format_text("done{}", field);
+    }
+    out.append(format_text("  ret {} {}\n}}\n", name, previous));
+    return strings.Join(out, "");
