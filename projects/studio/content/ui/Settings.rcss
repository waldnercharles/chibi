/* The Settings page: Editor and Project tabs, a category sidebar with
   search, and a row per setting (studio_sources.c's `settings`). */
.settings { display: flex; flex-direction: column; flex: 1 1 auto; }
.head {
  display: flex; align-items: center; flex: 0 0 auto; height: 48dp; padding: 0dp 10dp 0dp 16dp;
  border-bottom: 1dp var(--line);
}
.head-side { display: flex; align-items: center; gap: 8dp; flex: 1 1 0dp; }
.head-side.end { justify-content: flex-end; }
.head-title { font-size: 13dp; font-weight: 600; color: var(--foreground); }
.head input { nav: horizontal; }
.body { display: flex; flex: 1 1 0dp; }
.aside {
  display: flex; flex-direction: column; gap: 12dp; flex: 0 0 auto; width: 224dp; padding: 12dp 10dp;
  background-color: color-mix(in srgb, var(--foreground) 3%, var(--popover)); border-right: 1dp var(--line);
}
.search { position: relative; display: flex; }
.search .lead {
  position: absolute; left: 7dp; top: 0dp; height: var(--h); line-height: var(--h); font-size: 13dp;
  color: var(--faint-foreground); pointer-events: none;
}
.search-input {
  display: block; flex: 1 1 auto; height: var(--h); padding: 0dp 24dp 0dp 27dp;
  line-height: var(--text-line); color: var(--foreground); cursor: text; nav: vertical;
  background-color: var(--field-edit); border: 1dp var(--border); border-radius: var(--r);
}
.search-input:hover { background-color: var(--input-hover); }
.search-input:focus { border-color: var(--ring); }
.search-input:placeholder-shown { color: var(--faint-foreground); }
.search-input selection { background-color: var(--primary); color: var(--primary-foreground); }
.search .clear {
  position: absolute; right: 3dp; top: 3dp; width: 16dp; height: 16dp; line-height: 16dp;
  text-align: center; border-radius: 3dp; cursor: pointer;
}
.search .clear .icon { font-size: 12dp; width: 16dp; line-height: 16dp; }
.search .clear:hover { background-color: var(--press); }
.searching .nav-item input:checked ~ .nav-face { background-color: transparent; }
.aside-foot { margin-top: auto; padding: 0dp 8dp; font-size: 11dp; color: var(--faint-foreground); }
.main { flex: 1 1 0dp; overflow-y: auto; padding: 18dp 24dp 28dp 24dp; }
.page-head { display: flex; align-items: center; gap: 8dp; height: 28dp; margin: 0dp 0dp 8dp 16dp; }
.page-title { font-size: 16dp; line-height: 20dp; font-weight: 600; color: var(--foreground); }
.row-slot { display: block; }
.group {
  margin: 14dp 0dp 2dp 16dp; font-size: 11dp; font-weight: 600; color: var(--faint-foreground);
  text-transform: uppercase; letter-spacing: 0.5dp;
}
.range { display: flex; align-items: center; gap: 10dp; }
/* The number sits before its slider, so controls end in one column and
   Up and Down move straight between them. */
.readout { width: 24dp; text-align: right; font-family: InterNumeric; color: var(--muted-foreground); }
.keys { display: flex; align-items: center; gap: 4dp; }
.key {
  min-width: 20dp; height: 20dp; line-height: 19dp; padding: 0dp 6dp; text-align: center; font-size: 11dp;
  color: var(--foreground); background-color: var(--secondary); border-radius: 4dp;
  border-bottom: 1dp color-mix(in srgb, var(--foreground) 18%, transparent);
}
.keys .none { color: var(--faint-foreground); }
.empty { display: flex; flex-direction: column; align-items: center; gap: 6dp; padding: 56dp 0dp; }
.empty-icon { font-size: 28dp; line-height: 32dp; width: 32dp; color: var(--disabled-foreground); }
.empty-title { font-size: 13dp; font-weight: 600; color: var(--foreground); }
.empty-hint { color: var(--muted-foreground); margin-bottom: 8dp; }

.shortcut { display: flex; flex-direction: column; align-items: flex-end; gap: 4dp; max-width: 300dp; }
.shortcut .keys { flex-wrap: wrap; justify-content: flex-end; }
.shortcut-context { font-size: 11dp; color: var(--faint-foreground); }
.shortcut-conflict { font-size: 11dp; color: var(--warning); }
.recording { color: var(--primary); }
