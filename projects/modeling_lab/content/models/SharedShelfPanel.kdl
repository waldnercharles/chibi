version 3
name "SharedShelfPanel"
domain "model"
id_counter 15
description "A reusable panel exposes typed vector dimensions within declared ranges."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Parameter"
                reference_name "Half Size"
                inputs {
                    Default {
                        type "struct"
                        type_name "ShaderVec3"
                        default x=45.0 y=2.0 z=12.0
                    }
                    Minimum {
                        type "struct"
                        type_name "ShaderVec3"
                        default x=5.0 y=1.0 z=4.0
                    }
                    Maximum {
                        type "struct"
                        type_name "ShaderVec3"
                        default x=60.0 y=6.0 z=20.0
                    }
                }
            }
            - id=8 type="Model Box"
            - {
                id 11
                type "Model Part"
                reference_name "Shelf panel"
                inputs {
                    Material id=14
                }
                outputs {
                    Geometry id=13
                }
            }
        }
        (array)edges {
            - from="3.Value" to="8.Half Size"
            - from="8.Geometry" to="11.Geometry"
            - from="11.Geometry" to="1.Geometry"
        }
    }
}
