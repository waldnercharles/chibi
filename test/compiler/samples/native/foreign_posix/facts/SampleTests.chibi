package facts

import os "core:os"
import posix "core:sys/posix"

// core:sys/posix over libc: a directory is made, found, renamed and removed,
// a file and a missing path are told apart, a file's bytes round-trip, and programs run. core:os then
// does what its VM bodies do, over the same calls. The VM skips this sample as native only;
// native_build_runs_the_foreign_samples runs it.
@test
Calls :: () {
    assert(posix.MakeDirectory("posix_probe"), "make")
    assert(posix.Exists("posix_probe"), "exists")
    assert(posix.Kind("posix_probe") == posix.KindDirectory, "directory")
    assert(posix.Rename("posix_probe", "posix_moved"), "rename")
    assert(!posix.Exists("posix_probe") && posix.Exists("posix_moved"), "moved")
    assert(posix.Remove("posix_moved"), "remove")
    assert(!posix.Exists("posix_moved"), "removed")
    assert(posix.Kind("Main.chibi") == posix.KindFile, "file")
    assert(posix.Kind("posix_missing") == posix.KindNone, "missing")
    data: u8[] = [0, 255, 10, 13, 128, 0, 65]
    assert(posix.WriteBytes("posix_probe.bin", data), "write")
    assert(posix.FileSize("posix_probe.bin") == 7, "size")
    back := posix.ReadBytes("posix_probe.bin")
    assert(length(back) == 7 && back[0] == 0 && back[1] == 255 && back[6] == 65, "bytes read back")
    assert(posix.FileSize("posix_missing.bin") == -1 && length(posix.ReadBytes("posix_missing.bin")) == 0, "missing file")
    empty: u8[] = []
    assert(posix.WriteBytes("posix_probe.bin", empty) && posix.FileSize("posix_probe.bin") == 0, "empty file")
    assert(posix.Remove("posix_probe.bin"), "remove file")
    assert(posix.ReadText("Main.chibi") != "" && posix.ReadText("posix_missing.bin") == "", "text")
    assert(posix.Getenv("CHIBI_POSIX_UNSET") == "", "unset variable")
    assert(posix.MakeDirectory("posix_list"), "list directory")
    listed: u8[] = [104, 105]
    assert(posix.WriteBytes("posix_list/hi.txt", listed), "list file")
    assert(posix.WriteBytes("posix_list/ho.txt", listed), "list second file")
    names := posix.List("posix_list")
    assert(length(names) == 2, "two names")
    assert((names[0] == "hi.txt" && names[1] == "ho.txt") || (names[0] == "ho.txt" && names[1] == "hi.txt"), "names")
    assert(length(posix.List("posix_missing_dir")) == 0, "missing directory")
    assert(posix.Remove("posix_list/hi.txt") && posix.Remove("posix_list/ho.txt") && posix.Remove("posix_list"), "list cleanup")
    assert(posix.Run(["true"]) == 0 && posix.Run(["false"]) == 1, "run status")
    assert(posix.Run(["posix-missing-program"]) == 127, "run missing program")
    said := posix.Capture(["echo", "hi"])
    assert(said.status == 0 && said.stdout == "hi\n" && said.stderr == "", "capture")
    both := posix.Capture(["sh", "-c", "echo out; echo err >&2; exit 3"])
    assert(both.status == 3 && both.stdout == "out\n" && both.stderr == "err\n", "capture both streams")
    assert(length(posix.Arguments()) >= 1 && posix.Arguments()[0] != "", "arguments")
    assert(posix.WriteText("posix_text.txt", "text\n") && posix.ReadText("posix_text.txt") == "text\n", "text round trip")
    assert(posix.IsFile("posix_text.txt") && !posix.IsDirectory("posix_text.txt") && posix.IsDirectory("."), "is file and directory")
    assert(posix.Remove("posix_text.txt"), "text cleanup")
    assert(posix.Print("posix print"), "print")
    process := posix.Spawn(["true"])
    assert(process > 0 && posix.Wait(process) == 0, "spawn and wait")

    // core:os over libc agrees with the build host's natives.
    assert(os.MakeDirectory("os_probe/a/b/c") == nil && os.IsDirectory("os_probe/a/b/c"), "os: parents are made")
    assert(os.MakeDirectory("os_probe/a/b/c") == nil, "os: an existing directory is fine")
    assert(os.Remove("os_probe/none") == nil, "os: removing an absent path is fine")
    assert(os.WriteText("os_probe/a/f.txt", "hello\n") == nil, "os: write")
    hashed := os.HashFile("os_probe/a/f.txt")
    assert(hashed.error == nil && hashed.digest == "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03", "os: file hash")
    assert(os.HashText("hello\n") == hashed.digest, "os: text hash")
    assert(os.HashFile("os_probe/none").error != nil, "os: missing file hash")
    assert(os.Copy("os_probe/a/f.txt", "os_probe/a/g.txt") == nil && os.ReadText("os_probe/a/g.txt").text == "hello\n", "os: copy")
    assert(os.Stamp("os_probe/a/f.txt") != "" && os.Stamp("os_probe/none") == "", "os: stamp")
    assert(os.Reserve("os_probe/r") == nil && os.Reserve("os_probe/r") != nil, "os: reserve")
    assert(os.Publish("os_probe/r", "os_probe/p") == nil && os.Publish("os_probe/p", "os_probe/a") != nil, "os: publish")
    assert(os.RealPath("os_probe/none") == "" && os.RealPath("os_probe/a") != "", "os: real path")
    // The native harness runs this in a private directory without sh, first
    // without PATH, then with a controlled PATH containing the system shell.
    assert(os.FindExecutable("/bin/sh") != "", "os: an absolute executable needs no PATH")
    assert((os.FindExecutable("sh") != "") == (os.Getenv("PATH") != ""), "os: bare names use PATH")
    assert(os.FindExecutable("os-missing-program") == "", "os: a missing executable")
    assert(os.Platform() == "Darwin" || os.Platform() == "Linux", "os: platform")
    assert(os.Root() != "" && os.IsDirectory(os.Root()), "os: root")
    for name in ["f.txt", "g.txt"] {
        assert(os.Remove(format_text("os_probe/a/{}", name)) == nil, "os: remove file")
    }
    prefixed := os.MakeDirectory("os_probe/order") == nil && os.WriteText("os_probe/order/ab", "x") == nil &&
                os.WriteText("os_probe/order/a", "x") == nil && os.WriteText("os_probe/order/b", "x") == nil
    assert(prefixed, "os: order files")
    order := os.List("os_probe/order").names
    assert(length(order) == 3 && order[0] == "a" && order[1] == "ab" && order[2] == "b", "os: a prefix sorts first")
    for name in ["a", "ab", "b"] {
        assert(os.Remove(format_text("os_probe/order/{}", name)) == nil, "os: order cleanup")
    }
    assert(os.Remove("os_probe/order") == nil, "os: order directory")
    assert(os.Reserve("os_probe/empty") == nil && os.Publish("os_probe/a", "os_probe/empty") != nil, "os: publish keeps an empty destination")
    assert(os.Remove("os_probe/empty") == nil, "os: empty cleanup")
    assert(os.HashFile("os_probe").error != nil, "os: a directory has no file hash")
    sorted := os.List("os_probe").names
    assert(length(sorted) == 2 && sorted[0] == "a" && sorted[1] == "p", "os: names are sorted")
    piped := os.Start(["sh", "-c", "echo piped; exit 4"], os.Piped)
    assert(piped > 0 && os.Wait(piped, -1) == 4, "os: piped program and its status")
    slow := os.Start(["sh", "-c", "sleep 30"], os.Inherited)
    assert(os.Wait(slow, 20) == os.StillRunning, "os: a running program")
    assert(os.Kill(slow) == -9, "os: kill")
    assert(os.Wait(os.Start(["os-missing-program"], os.Piped), -1) == 127, "os: a program that cannot start")
    // An optional is true when it is not nil, also as an operand of || and &&.
    failed := os.Reserve("os_probe/p") || os.Reserve("os_probe/a")
    assert(failed, "os: an optional as an operand of ||")
    assert(os.Reserve("os_probe/q") == nil && !(os.Remove("os_probe/q") && true), "os: an optional as an operand of &&")
    held := os.HashFile("os_probe/none")
    assert(held.error || held.digest != "", "os: an optional field as an operand of ||")
    clean := os.Remove("os_probe/none")
    assert(!(clean || clean) && !(clean && clean), "os: nil operands make || and && false")
    assert((os.Reserve("os_probe/p") && os.Reserve("os_probe/a")) && (clean || os.Reserve("os_probe/p")), "os: both operands set make && true, and || chains")
    assert(os.Remove("os_probe/p") == nil && os.Remove("os_probe/a/b/c") == nil && os.Remove("os_probe/a/b") == nil &&
           os.Remove("os_probe/a") == nil && os.Remove("os_probe") == nil, "os: cleanup")
}
