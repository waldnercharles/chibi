package package_routes

import paths "project:package_paths"
import strings "core:strings"
import syntax "project:syntax_diagnostics"

Collection :: struct {
    name: string;
    path: string;
    has_name: bool;
    has_path: bool;
}
Root :: struct {
    name: string;
    path: string;
}
File :: struct {
    path: string;
    directory: string;
    key: string;
    identity: string;
    root: int;
}
ImportInput :: struct {
    directory: string;
    literal: string;
    root: int;
    start: int;
    end: int;
    line: int;
    column: int;
    document: int;
}
RootResult :: union {
    Accepted(roots: Root[]) | Rejected(diagnostic: syntax.Diagnostic)
}
FileResult :: union {
    Accepted(file: File) | Rejected(diagnostic: syntax.Diagnostic)
}
ImportResult :: union {
    Accepted(directory: string) | Rejected(diagnostic: syntax.Diagnostic)
}

FileError :: pure fn(message: string, document: int) -> syntax.Diagnostic {
    return {start: 0, end: 0, line: 1, column: 1, document: document, message: message};
}

ImportError :: pure fn(message: string, request: ImportInput) -> ImportResult {
    return ImportResult.Rejected({start: request.start, end: request.end,
                                  line: request.line, column: request.column,
                                  document: request.document, message: message});
}

AddRoot :: pure fn(roots: Root[], item: Collection) -> RootResult {
    if (!item.has_name || !paths.Bounded(item.name) || !strings.IsIdentifier(item.name)) {
        return RootResult.Rejected(FileError("Invalid collection name", -1));
    }
    normalized := paths.Normalize({base: "", path: item.path, floor: "",
                                   has_base: false, has_path: item.has_path, has_floor: false});
    switch normalized {
        case .Invalid:
            return RootResult.Rejected(FileError("Invalid absolute collection root", -1));
        case .Normalized(path):
            // Name and path checks interleave for each earlier root. The first
            // conflicting earlier root determines the diagnostic.
            foreach (root in roots) {
                if (root.name == item.name) {
                    return RootResult.Rejected(FileError("Duplicate collection name", -1));
                }
                if (root.path == path) {
                    return RootResult.Rejected(FileError("Duplicate collection root", -1));
                }
            }
            root: Root = {name: item.name, path: path};
            return RootResult.Accepted(array_add(roots, root));
    }
}

RootSet :: pure fn(project: string, has_project: bool, collections: Collection[]) -> RootResult {
    // Snapshot option validation already bounds explicit collections to 255.
    roots: Root[] = [];
    first := AddRoot(roots, {name: "project", path: project, has_name: true, has_path: has_project});
    switch first {
        case .Rejected(diagnostic):
            return RootResult.Rejected(diagnostic);
        case .Accepted(items):
            roots = items;
    }
    foreach (item in collections) {
        added := AddRoot(roots, item);
        switch added {
            case .Rejected(diagnostic):
                return RootResult.Rejected(diagnostic);
            case .Accepted(items):
                roots = items;
        }
    }
    return RootResult.Accepted(roots);
}

// Roots are the nonempty canonical result of RootSet. Inputs use lexical paths;
// neither routing function inspects the filesystem or proves containment there.
OwningRoot :: pure fn(roots: Root[], directory: string) -> int {
    selected: int = -1;
    index: int = 0;
    while (index < length(roots)) {
        if (paths.Within(roots[index].path, directory)) {
            if (selected < 0 || strings.ByteLength(roots[index].path) > strings.ByteLength(roots[selected].path)) {
                selected = index;
            }
        }
        index += 1;
    }
    return selected;
}

Relative :: pure fn(root: string, path: string) -> string {
    offset := strings.ByteLength(root);
    if (root != "/" && strings.ByteAt(path, offset) == 47) {
        offset += 1;
    }
    return strings.Slice(path, offset, strings.ByteLength(path) - offset);
}

Key :: pure fn(root: Root, path: string) -> string {
    return format_text("{}:{}", root.name, Relative(root.path, path));
}

FileRoute :: pure fn(roots: Root[], path: string, has_path: bool, document: int) -> FileResult {
    if (!has_path || !paths.Bounded(path) || strings.ByteLength(path) == 0) {
        return FileResult.Rejected(FileError("Invalid package file path", document));
    }
    normalized := paths.Normalize({base: roots[0].path, path: path, floor: roots[0].path,
                                   has_base: true, has_path: true,
                                   has_floor: strings.ByteAt(path, 0) != 47});
    switch normalized {
        case .Invalid:
            return FileResult.Rejected(FileError("Invalid package file path or root escape", document));
        case .Normalized(canonical):
            if (canonical == "/") {
                return FileResult.Rejected(FileError("Invalid package file path or root escape", document));
            }
            slash: int = 0;
            index: int = 0;
            while (index < strings.ByteLength(canonical)) {
                if (strings.ByteAt(canonical, index) == 47) {
                    slash = index;
                }
                index += 1;
            }
            directory := "/";
            if (slash > 0) {
                directory = strings.Slice(canonical, 0, slash);
            }
            root := OwningRoot(roots, directory);
            if (root < 0) {
                return FileResult.Rejected(FileError("Package file is outside the configured roots", document));
            }
            tail := Relative(roots[root].path, directory);
            depth: int = 0;
            index = 0;
            while (index < strings.ByteLength(tail)) {
                if (strings.ByteAt(tail, index) == 47) {
                    depth += 1;
                }
                index += 1;
            }
            if (depth >= 16) {
                return FileResult.Rejected(FileError("Package path nesting exceeds the supported depth", document));
            }
            return FileResult.Accepted({path: canonical, directory: directory,
                                        key: Key(roots[root], canonical),
                                        identity: Key(roots[root], directory), root: root});
    }
}

// The foreign primitive supplies JSON decoding facts only. Collection lookup,
// path validity, root ownership and diagnostics remain authored policy.
ImportRoute :: pure fn(roots: Root[], request: ImportInput) -> ImportResult {
    decoded := compiler_json_string(request.literal);
    if (!decoded.valid || strings.ByteLength(decoded.value) != decoded.byte_length) {
        return ImportError("Invalid import string or embedded NUL", request);
    }
    path := decoded.value;
    base := request.directory;
    root := request.root;
    colon: int = -1;
    index: int = 0;
    while (index < strings.ByteLength(path)) {
        if (strings.ByteAt(path, index) == 58) {
            colon = index;
            break;
        }
        index += 1;
    }
    if (colon >= 0) {
        root = -1;
        name := strings.Slice(path, 0, colon);
        index = 0;
        while (index < length(roots)) {
            if (roots[index].name == name) {
                root = index;
                break;
            }
            index += 1;
        }
        if (root < 0) {
            return ImportError("Unknown import collection", request);
        }
        path = strings.Slice(path, colon + 1, strings.ByteLength(path) - colon - 1);
        base = roots[root].path;
    }
    if ((colon < 0 && strings.ByteLength(path) == 0) || strings.ByteAt(path, 0) == 47 || !paths.Bounded(path)) {
        return ImportError("Invalid import path", request);
    }
    normalized := paths.Normalize({base: base, path: path, floor: roots[root].path,
                                   has_base: true, has_path: true, has_floor: true});
    switch normalized {
        case .Invalid:
            return ImportError("Import path escapes its collection root or exceeds the path limit", request);
        case .Normalized(directory):
            return ImportResult.Accepted(directory);
    }
}
