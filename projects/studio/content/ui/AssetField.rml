<div class="asset-field" attrs>
  <button class="field select picker" popovertarget="choices" aria-haspopup="listbox" data-attrif-data-placeholder="value == ''"><span class="icon lead">{{ table.icon }}</span><span class="part value">{{ value == '' ? 'None' : value }}</span><span class="icon caret">&#xeab4;</span></button>
  <div class="popup dropdown" popover id="choices">
    <use ui="ChoiceList">
      <div class="menu-item" role="option" value="" data-label="None" data-attrif-data-current="value == ''"><span class="icon lead">&#xf0766;</span><span class="text"><span class="label">None</span></span></div>
      <div role="group" data-for="group : table.groups">
        <use ui="MenuGroup" data-if="group.label != ''" data-alias-group="group"/>
        <div class="menu-item" role="option" data-for="option : group.options" data-attr-value="option.value" data-attr-data-label="option.label" data-attrif-data-current="option.value == value"><span class="icon lead">{{ table.icon }}</span><span class="text"><span class="label">{{ option.label }}</span></span></div>
      </div>
    </use>
  </div>
</div>
