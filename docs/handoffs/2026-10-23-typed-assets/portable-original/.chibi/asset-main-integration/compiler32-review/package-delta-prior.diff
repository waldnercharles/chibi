+// A closed, prepared source cycle starts at its direct facts. Unknown native
+// contracts remain unknown; WRITE propagates through actual invocation edges.
+WriteSummaries :: (bodies: Body[]) -> int[] {
+    summaries: int[] = [];
+    for (body in bodies) {
