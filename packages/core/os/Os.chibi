package os

import target "core:target"

// Files, directories, processes and the environment, as Odin's core:os offers
// them. On the VM every operation is the build host's native underneath; in a
// native program (core:target's Native) it is the platform's libc or kernel32
// through core:sys/posix or core:sys/windows. One set of signatures serves
// both, so a package imports core:os and compiles either way. A native
// program has no ProgramDirectory or Environment yet, and on Windows Start,
// Wait and Kill report failure until core:sys/windows has them.
//
// Paths are relative to the program's root unless absolute. A fallible
// operation reports an expected failure of the file system or a process as
// an Error and leaves its other results empty. A bug (an invalid argument)
// stops the program.

pub NotFound: int : 1;
pub Permission: int : 2;
pub AlreadyExists: int : 3;
pub Failed: int : 4;

@error
pub Error :: struct {
    kind: int;
    code: int;
}

pub KindNone: int : 0;
pub KindFile: int : 1;
pub KindDirectory: int : 2;
pub KindLink: int : 3;
pub KindOther: int : 4;

// A finished child process. `status` is its exit status; a nonzero status is
// not an Error.
pub Result :: struct {
    status: int;
    stdout: string;
    stderr: string;
}

Failure :: (kind: int) -> Error {
    failed: Error = {kind: kind, code: 0};
    return failed;
}

// How a started program's standard output and error reach this one, as Zig's
// Child.StdIo names them: Piped captures them and reports them when the program
// ends, Inherited makes them this program's own, as they are written.
pub Piped: int : 0;
pub Inherited: int : 1;

// What Wait returns for a program that still runs: past any exit status or
// negative signal number.
pub StillRunning: int : 65536;

// The platform package a native program calls, under one alias; only the kept
// branch binds.
when target.Native == 1 and target.Os == target.Windows {
    import sys "core:sys/windows"
} else when target.Native == 1 {
    import sys "core:sys/posix"
}
when target.Native == 1 {
    import sha256 "core:hash/sha256"
}

when target.Native == 1 {
    pub Kind :: (path: string) -> int {
        return sys.Kind(path);
    }

    pub IsFile :: (path: string) -> bool {
        return sys.Kind(path) == KindFile;
    }

    pub IsDirectory :: (path: string) -> bool {
        return sys.Kind(path) == KindDirectory;
    }

    pub Exists :: (path: string) -> bool {
        return sys.Exists(path);
    }

    pub ReadText :: (path: string) -> (text: string, error: Error?) {
        if (sys.Kind(path) != KindFile) {
            return ("", Failure(NotFound));
        }
        return (sys.ReadText(path), nil);
    }

    pub ReadBytes :: (path: string) -> (data: u8[], error: Error?) {
        if (sys.Kind(path) != KindFile) {
            empty: u8[] = [];
            return (empty, Failure(NotFound));
        }
        return (sys.ReadBytes(path), nil);
    }

    pub WriteBytes :: (path: string, data: u8[]) -> Error? {
        if (!sys.WriteBytes(path, data)) {
            return Failure(Failed);
        }
        return nil;
    }

    pub WriteText :: (path: string, text: string) -> Error? {
        data: u8[] = [];
        size := text_byte_length(text);
        for index in 0..<size {
            data.append(u8(text_byte_at(text, index)));
        }
        if (!sys.WriteBytes(path, data)) {
            return Failure(Failed);
        }
        return nil;
    }

    pub Rename :: (source: string, destination: string) -> Error? {
        if (!sys.Rename(source, destination)) {
            return Failure(Failed);
        }
        return nil;
    }

    // Removes a file, or an empty directory. A path that is not there is not an error.
    pub Remove :: (path: string) -> Error? {
        if (!sys.Remove(path)) {
            return Failure(Failed);
        }
        return nil;
    }

    // Makes the directory and its missing parents; one that exists already is not
    // an error.
    pub MakeDirectory :: (path: string) -> Error? {
        if (!sys.MakeDirectory(path)) {
            return Failure(Failed);
        }
        return nil;
    }

    // Whether text `a` sorts before `b` byte by byte, a prefix first.
    Before :: (a: string, b: string) -> bool {
        size_a := text_byte_length(a);
        size_b := text_byte_length(b);
        at := 0;
        while (at < size_a && at < size_b) {
            left := text_byte_at(a, at);
            right := text_byte_at(b, at);
            if (left != right) {
                return left < right;
            }
            at += 1;
        }
        return size_a < size_b;
    }

    // The names in byte order, as the VM lists them: a merge sort.
    Sorted :: (names: string[]) -> string[] {
        count := length(names);
        current := names;
        width := 1;
        while (width < count) {
            merged: string[] = [];
            start := 0;
            while (start < count) {
                middle := start + width;
                if (middle > count) {
                    middle = count;
                }
                end := start + 2 * width;
                if (end > count) {
                    end = count;
                }
                left := start;
                right := middle;
                while (left < middle && right < end) {
                    if (Before(current[right], current[left])) {
                        merged.append(current[right]);
                        right += 1;
                    } else {
                        merged.append(current[left]);
                        left += 1;
                    }
                }
                while (left < middle) {
                    merged.append(current[left]);
                    left += 1;
                }
                while (right < end) {
                    merged.append(current[right]);
                    right += 1;
                }
                start = end;
            }
            current = merged;
            width = width * 2;
        }
        return current;
    }

    pub List :: (path: string) -> (names: string[], error: Error?) {
        if (sys.Kind(path) != KindDirectory) {
            empty: string[] = [];
            return (empty, Failure(NotFound));
        }
        return (Sorted(sys.List(path)), nil);
    }

    pub Run :: (command: string[]) -> int {
        return sys.Run(command);
    }

    pub Capture :: (command: string[]) -> Result {
        captured := sys.Capture(command);
        return {status: captured.status, stdout: captured.stdout, stderr: captured.stderr};
    }

    pub Getenv :: (name: string) -> string {
        return sys.Getenv(name);
    }

    // The arguments after the program's own name, as the VM gives them.
    pub Arguments :: () -> string[] {
        all := sys.Arguments();
        rest: string[] = [];
        for (index in 1..<length(all)) {
            rest.append(all[index]);
        }
        return rest;
    }

    // Writes one line and a newline to the error output.
    pub Print :: (line: string) {
        written := sys.Print(line);
    }

    // Identifies the file's content and metadata for change detection: equal
    // stamps mean the same file untouched. "" when the path does not exist.
    pub Stamp :: (path: string) -> string {
        return sys.Stamp(path);
    }

    pub Copy :: (source: string, destination: string) -> Error? {
        if (!sys.Copy(source, destination)) {
            return Failure(Failed);
        }
        return nil;
    }

    // Makes one new directory whose parent exists. Any existing path, including
    // a link, fails; nothing is replaced.
    pub Reserve :: (path: string) -> Error? {
        if (!sys.Reserve(path)) {
            return Failure(Failed);
        }
        return nil;
    }

    // Renames a prepared directory to a destination that does not exist. Any
    // existing destination fails; nothing is replaced.
    pub Publish :: (source: string, destination: string) -> Error? {
        if (!sys.Publish(source, destination)) {
            return Failure(Failed);
        }
        return nil;
    }

    // The absolute path with links resolved, "" when the path does not exist.
    pub RealPath :: (path: string) -> string {
        return sys.RealPath(path);
    }

    // Lowercase hexadecimal SHA-256 of the file's bytes.
    pub HashFile :: (path: string) -> (digest: string, error: Error?) {
        if (sys.Kind(path) != KindFile) {
            return ("", Failure(NotFound));
        }
        data := sys.ReadBytes(path);
        if (length(data) != sys.FileSize(path)) {
            return ("", Failure(Failed));
        }
        return (sha256.HexOf(data), nil);
    }

    // Lowercase hexadecimal SHA-256 of the text's bytes.
    pub HashText :: (text: string) -> string {
        data: u8[] = [];
        for (index in 0..<text_byte_length(text)) {
            data.append(u8(text_byte_at(text, index)));
        }
        return sha256.HexOf(data);
    }

    // The directory the program was started in, which relative paths follow.
    pub Root :: () -> string {
        return sys.Root();
    }

    pub Start :: (command: string[], stdio: int) -> int {
        return sys.Start(command, stdio == Piped);
    }

    pub Wait :: (process: int, timeout_ms: int) -> int {
        return sys.WaitFor(process, timeout_ms);
    }

    pub Kill :: (process: int) -> int {
        return sys.Kill(process);
    }

    pub FindExecutable :: (name: string) -> string {
        return sys.FindExecutable(name);
    }

    pub Platform :: () -> string {
        return sys.Platform();
    }
} else {
    // Only the VM bodies convert text and bytes; a native program must not
    // import core:bytes (core:strings formats text, which links the runtime).
    import bytes "core:bytes"

// What the path names, KindNone when nothing. A link is not followed.
pub Kind :: (path: string) -> int {
    kind := build.file_kind(path);
    if (kind == "file") {
        return KindFile;
    }
    if (kind == "directory") {
        return KindDirectory;
    }
    if (kind == "link") {
        return KindLink;
    }
    if (kind == "other") {
        return KindOther;
    }
    return KindNone;
}

pub IsFile :: (path: string) -> bool {
    return build.file_kind(path) == "file";
}

pub IsDirectory :: (path: string) -> bool {
    return build.file_kind(path) == "directory";
}

pub Exists :: (path: string) -> bool {
    return build.file_exists(path);
}

// Identifies the file's content and metadata for change detection: equal
// stamps mean the same file untouched. "" when the path does not exist.
pub Stamp :: (path: string) -> string {
    return build.file_stamp(path);
}

pub ReadText :: (path: string) -> (text: string, error: Error?) {
    if (Kind(path) != KindFile) {
        return ("", Failure(NotFound));
    }
    return (build.read_file(path), nil);
}

pub WriteText :: (path: string, text: string) -> Error? {
    if (!build.write_file(path, text)) {
        return Failure(Failed);
    }
    return nil;
}

// The file's bytes, including NUL and malformed UTF-8. O(n) in the VM, where a
// string is the transport; the libc implementation reads straight into the array.
pub ReadBytes :: (path: string) -> (data: u8[], error: Error?) {
    text := ReadText(path);
    if (text.error != nil) {
        empty: u8[] = [];
        return (empty, text.error);
    }
    return (bytes.FromString(text.text), nil);
}

pub WriteBytes :: (path: string, data: u8[]) -> Error? {
    return WriteText(path, bytes.ToString(data));
}

pub Copy :: (source: string, destination: string) -> Error? {
    if (!build.copy_file(source, destination)) {
        return Failure(Failed);
    }
    return nil;
}

pub Rename :: (source: string, destination: string) -> Error? {
    if (!build.rename(source, destination)) {
        return Failure(Failed);
    }
    return nil;
}

// Removes a file, or an empty directory. Absent is not an error.
pub Remove :: (path: string) -> Error? {
    if (!build.remove(path)) {
        return Failure(Failed);
    }
    return nil;
}

pub MakeDirectory :: (path: string) -> Error? {
    if (!build.make_directory(path)) {
        return Failure(Failed);
    }
    return nil;
}

// Makes one new directory whose parent exists. Any existing path, including
// a link, fails; nothing is replaced.
pub Reserve :: (path: string) -> Error? {
    if (!build.reserve_directory(path)) {
        return Failure(Failed);
    }
    return nil;
}

// Atomically renames a prepared directory to a destination that does not
// exist. Any existing destination fails; nothing is replaced.
pub Publish :: (source: string, destination: string) -> Error? {
    if (!build.publish_directory(source, destination)) {
        return Failure(Failed);
    }
    return nil;
}

// The names in a directory in byte order, without "." and "..".
pub List :: (path: string) -> (names: string[], error: Error?) {
    if (Kind(path) != KindDirectory) {
        empty: string[] = [];
        return (empty, Failure(NotFound));
    }
    return (build.list_directory(path), nil);
}

// The absolute path with links resolved, "" when the path does not exist.
pub RealPath :: (path: string) -> string {
    return build.resolve_path(path);
}

// Lowercase hexadecimal SHA-256 of the file's bytes.
pub HashFile :: (path: string) -> (digest: string, error: Error?) {
    if (Kind(path) != KindFile) {
        return ("", Failure(NotFound));
    }
    return (build.hash_file(path), nil);
}

// Lowercase hexadecimal SHA-256 of the text's bytes. The build host hashes in C;
// sha256.Hex costs about 7 µs a byte on the VM.
pub HashText :: (text: string) -> string {
    return build.hash_text(text);
}

// The directory build programs are rooted at.
pub Root :: () -> string {
    return build.root();
}

// The directory holding the build program's source.
pub ProgramDirectory :: () -> string {
    return build.program_directory();
}

// Runs a program to completion with its output going to the build's own.
// The result is its exit status; failing to start reports 127.
pub Run :: (command: string[]) -> int {
    return build.run(command);
}

// Runs a program and captures its output. Nothing prints.
pub Capture :: (command: string[]) -> Result {
    status := build.probe(command);
    return {status: status, stdout: build.last_stdout(), stderr: build.last_stderr()};
}

// Starts a program without waiting and returns its process, an id that is
// never 0; Wait and Kill end it. An unknown program is an exit status of 127
// when it is waited for, as for Run.
pub Start :: (command: string[], stdio: int) -> int {
    if (stdio == Inherited) {
        return build.spawn(command);
    }
    return build.start(command);
}

// Waits at most timeout_ms (negative: for as long as it takes) for the program
// to end and returns its exit status, or the negative signal number that
// stopped it. StillRunning means the time passed first; the program keeps
// running and Wait or Kill ends it. A process ends once, whatever ended it.
pub Wait :: (process: int, timeout_ms: int) -> int {
    return build.wait_for(process, timeout_ms);
}

// Stops the program and everything it started, waits for it and returns what
// Wait would: -9 for a program that was running.
pub Kill :: (process: int) -> int {
    return build.kill(process);
}

// The first executable of that name on PATH, "" when none.
pub FindExecutable :: (name: string) -> string {
    return build.find_executable(name);
}

// The variable's value, "" when it is unset.
pub Getenv :: (name: string) -> string {
    return build.environment(name);
}

pub Environment :: () -> string[] {
    return build.environment_names();
}

pub Arguments :: () -> string[] {
    return build.arguments();
}

// "Darwin" or "Linux".
pub Platform :: () -> string {
    return build.platform();
}

// Writes one line to the build's error output.
pub Print :: (line: string) {
    build.report(line);
}
}
