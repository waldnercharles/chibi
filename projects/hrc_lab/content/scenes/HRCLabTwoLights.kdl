version 1
name "HRCLabTwoLights"
(array)entities {
    - {
        name "Camera"
        prototype "HRCLabCamera"
        components {
            GameTransform x=0 y=0
        }
    }
    - {
        name "HRC"
        prototype "HRCLabHRC"
        components {
            GameTransform x=0 y=0
        }
    }
    - {
        name "Backdrop"
        prototype "HRCLabReceiver"
        components {
            GameTransform x=0 y=0
            GameAppearance width=960 height=540 shape="Box" layer=-100
            GameMaterial absorption=0 albedo=3503345919 scene=1802202111 edge_light=0
        }
    }
    - {
        name "Warm light"
