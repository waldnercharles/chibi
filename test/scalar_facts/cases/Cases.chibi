package scalar_cases

import facts "project:scalar_facts"
import strings "core:strings"

// Authored semantic fixtures and assertions. The temporary host adapter only
// dispatches these sources and transports the producer's unmodified rows.
// An accepted case names its functions in declaration order, its entry's
// value and, unless empty, each function's operand excerpts in evaluation
// order. A rejected case names its message and, unless empty, the excerpt its
// diagnostic covers.
Case :: struct {
    name: string;
    source: string;
    accepted: bool;
    value: int;
    functions: string;
    trace: string;
    message: string;
    excerpt: string;
}
Accepted :: (name: string, source: string, value: int, functions: string, trace: string) -> Case {
    return {name: name, source: source, accepted: true, value: value, functions: functions, trace: trace,
            message: "", excerpt: ""};
}
Rejected :: (name: string, source: string, message: string, excerpt: string) -> Case {
    return {name: name, source: source, accepted: false, value: 0, functions: "", trace: "", message: message,
            excerpt: excerpt};
}
// Main calls F1, which calls F2 and so on: `count` functions in all.
Chain :: (count: int) -> string {
    text := "package scalar\nMain :: () -> int { return F1(); }\n";
    for (index in 1..<count - 1) {
        text = format_text("{}F{} :: () -> int { return F{}(); }\n", text, index, index + 1);
    }
    return format_text("{}F{} :: () -> int { return {}; }\n", text, count - 1, count - 1);
}
ChainNames :: (count: int) -> string {
    names := "Main";
    for (index in 1..<count) {
        names = format_text("{},F{}", names, index);
    }
    return names;
}
// 1 inside `depth` nested calls of Id: depth + 1 operands.
Nested :: (depth: int) -> string {
    text := "";
    for (index in 0..<depth) {
        text = format_text("{}Id(", text);
    }
    text = format_text("{}1", text);
    for (index in 0..<depth) {
        text = format_text("{})", text);
    }
    return text;
}
Nest :: (depth: int) -> string {
    return format_text("package scalar\nMain :: () -> int { return {}; }\nId :: (x: int) -> int { return x; }\n",
                       Nested(depth));
}
// Main guarding on Small(Id(...(1))) with `condition` nested calls of Id,
// then returning `arm` nested calls of Id in its arm: operands across both
// segments count against one bound.
Split :: (condition: int, arm: int) -> string {
    return format_text("package scalar\nMain :: () -> int { if (Small({})) { return {}; } return 0; }\nSmall :: (x: int) -> bool { return x < 2; }\nId :: (x: int) -> int { return x; }\n",
                       Nested(condition), Nested(arm));
}
// Main returning 1, then a comment that pads the source to `size` bytes.
Padded :: (size: int) -> string {
    text := "package scalar\nMain :: () -> int { return 1; }\n//";
    filler := "x";
    while (strings.ByteLength(filler) < size) {
        filler = format_text("{}{}", filler, filler);
    }
    return format_text("{}{}", text, strings.Slice(filler, 0, size - strings.ByteLength(text)));
}
Cases :: () -> Case[] {
    return [
        Accepted("forty_two", "package scalar\nMain :: () -> int { return 42; }", 42, "Main", "42"),
        Accepted("zero", "package scalar\nMain :: () -> int { return 0; }", 0, "Main", "0"),
        Accepted("int_max", "package scalar\nMain :: () -> int { return 2147483647; }", 2147483647, "Main", "2147483647"),
        Accepted("hex", "package scalar\nMain :: () -> int { return 0x2a; }", 42, "Main", "0x2a"),
        Accepted("comments", "// 雪\npackage scalar\n\npub Main :: () -> int {\n    // λ\n    return 42; // trailing\n}\n", 42, "Main", "42"),
        Rejected("overflow", "package scalar\nMain :: () -> int { return 2147483648; }", "Numeric literal is outside the range of int", "2147483648"),
        Rejected("u64_overflow", "package scalar\nMain :: () -> int { return 18446744073709551616; }", "only integer literals of 64 bits are supported", "18446744073709551616"),
        Rejected("fraction", "package scalar\nMain :: () -> int { return 42.5; }", "only integer literals of 64 bits are supported", "42.5"),
        Rejected("exponent", "package scalar\nMain :: () -> int { return 1e2; }", "only integer literals of 64 bits are supported", "1e2"),
        Rejected("negative", "package scalar\nMain :: () -> int { return -1; }", "scalar proof supports only literals, parameters, comparisons and direct calls", "-1"),
        Rejected("parentheses", "package scalar\nMain :: () -> int { return (42); }", "scalar proof supports only literals, parameters, comparisons and direct calls", "(42)"),
        Rejected("arithmetic", "package scalar\nMain :: () -> int { return 40 + 2; }", "scalar proof supports only literals, parameters, comparisons and direct calls", "40 + 2"),
        Accepted("branch", "package scalar\nMain :: () -> int { if (true) { return 42; } return 0; }", 42, "Main", "true ? 42 : 0"),
        Rejected("local", "package scalar\nMain :: () -> int { x: int = 42; return x; }", "scalar proof requires one complete return statement", "x: int = 42;"),
        Rejected("after_return", "package scalar\nMain :: () -> int { return 42; assert(false); }", "scalar proof does not support additional statements", "assert(false);"),
        Rejected("extra_return", "package scalar\nMain :: () -> int { return 42; return 0; }", "scalar proof does not support additional statements", "return 0;"),
        Rejected("unknown_call", "package scalar\nMain :: () -> int { return unknown(); }", "Unknown function 'unknown'", "unknown"),
        Rejected("parameter", "package scalar\nMain :: (x: int) -> int { return 42; }", "scalar proof requires its first function to take no parameters", "(x: int)"),
        Rejected("reference", "package scalar\nMain :: (x: ref int) -> int { return 42; }", "scalar proof requires int or bool parameters and one int or bool result", "x: ref int"),
        Rejected("bool_result", "package scalar\nMain :: () -> bool { return true; }", "scalar proof requires its first function to return int", "bool"),
        Rejected("int64_result", "package scalar\nMain :: () -> int64 { return 42; }", "scalar proof requires int or bool parameters and one int or bool result", "int64"),
        Rejected("array_result", "package scalar\nMain :: () -> int[] { return [42]; }", "scalar proof requires int or bool parameters and one int or bool result", "int[]"),
        Rejected("nominal_result", "package scalar\nMain :: () -> Missing { return 42; }", "result type is not supported yet", "Missing"),
        Rejected("named_result", "package scalar\nMain :: () -> (x: int) { return 42; }", "scalar proof requires int or bool parameters and one int or bool result", "(x: int)"),
        Rejected("struct", "package scalar\nValue :: struct { x: int; }\nMain :: () -> int { return 42; }", "scalar proof supports only ordinary function declarations", "Value :: struct { x: int; }"),
        Rejected("constant", "package scalar\nN: int : 42;\nMain :: () -> int { return 42; }", "scalar proof supports only ordinary function declarations", "N: int : 42;"),
        Accepted("second_function", "package scalar\nMain :: () -> int { return 42; }\nOther :: () -> int { return 0; }", 42, "Main,Other", "42 | 0"),
        Rejected("import", "package scalar\nimport missing \"project:missing\"\nMain :: () -> int { return 42; }", "Imported package is missing from the snapshot", "\"project:missing\""),
        Rejected("attribute_test", "package scalar\n@test Main :: () -> int { return 42; }", "scalar proof does not support function attributes", "@test"),
        Rejected("attribute_pure", "package scalar\n@pure Main :: () -> int { return 42; }", "scalar proof does not support function attributes", "@pure"),
        Rejected("empty", "package scalar\nMain :: () -> int {}", "scalar proof requires one complete return statement", "{}"),
        Rejected("bare_return", "package scalar\nMain :: () -> int { return; }", "scalar proof requires a returned value", "return;"),
        Rejected("no_result", "package scalar\nMain :: () { return; }", "scalar proof requires int or bool parameters and one int or bool result", "Main :: () { return; }"),
        Rejected("no_function", "package scalar\n", "scalar proof requires at least one function", "package scalar\n"),
        Rejected("malformed", "package scalar\nMain :: () -> int { return 42;", "Expected }", ""),
        Rejected("nul", "package scalar\nMain :: () -> int { return 42; }\u0000", "Package source contains NUL bytes", "\u0000"),
        Rejected("string_result", "package scalar\nMain :: () -> string { return \"42\"; }", "scalar proof requires int or bool parameters and one int or bool result", "string"),
        Rejected("map_result", "package scalar\nMain :: () -> [int: int] { return [1: 42]; }", "scalar proof requires int or bool parameters and one int or bool result", "[int: int]"),
        Rejected("assert_before", "package scalar\nMain :: () -> int { assert(false); return 42; }", "scalar proof requires one complete return statement", "assert(false);"),
        Rejected("return_outcome", "package scalar\nMain :: () -> int { return .Done 42; }", "scalar proof does not support return outcomes", "Done"),
        Rejected("float_one", "package scalar\nMain :: () -> int { return 1.0; }", "only integer literals of 64 bits are supported", "1.0"),
        Rejected("exponent_one", "package scalar\nMain :: () -> int { return 1e0; }", "only integer literals of 64 bits are supported", "1e0"),
        Rejected("nul_comment", "// 雪\npackage scalar\n// before\u0000after\nMain :: () -> int { return 42; }", "Package source contains NUL bytes", "\u0000"),
        Accepted("identity", "package scalar\nMain :: () -> int { return Id(7); }\nId :: (x: int) -> int { return x; }", 7, "Main,Id", "7 ; Id(7) | x"),
        Accepted("first_argument", "package scalar\nMain :: () -> int { return Pick(5, true, 9); }\nPick :: (a: int, flag: bool, c: int) -> int { return a; }", 5, "Main,Pick", "5 ; true ; 9 ; Pick(5, true, 9) | a"),
        Accepted("last_argument", "package scalar\nMain :: () -> int { return Pick(5, true, 9); }\nPick :: (a: int, flag: bool, c: int) -> int { return c; }", 9, "Main,Pick", "5 ; true ; 9 ; Pick(5, true, 9) | c"),
        Accepted("bool_passthrough", "package scalar\nMain :: () -> int { return Gate(Flip(false), 8); }\nFlip :: (b: bool) -> bool { return b; }\nGate :: (flag: bool, x: int) -> int { return x; }", 8, "Main,Flip,Gate", "false ; Flip(false) ; 8 ; Gate(Flip(false), 8) | b | x"),
        Accepted("bool_literals", "package scalar\nMain :: () -> int { return Keep(Yes(), No(), 3); }\nYes :: () -> bool { return true; }\nNo :: () -> bool { return false; }\nKeep :: (a: bool, b: bool, x: int) -> int { return x; }", 3, "Main,Yes,No,Keep", "Yes() ; No() ; 3 ; Keep(Yes(), No(), 3) | true | false | x"),
        Accepted("chain", "package scalar\nMain :: () -> int { return A(11); }\nA :: (x: int) -> int { return B(x, 12); }\nB :: (x: int, y: int) -> int { return C(y, x); }\nC :: (p: int, q: int) -> int { return q; }", 11, "Main,A,B,C", "11 ; A(11) | x ; 12 ; B(x, 12) | y ; x ; C(y, x) | q"),
        Accepted("earlier_callee", "package scalar\nMain :: () -> int { return B(); }\nA :: () -> int { return 4; }\nB :: () -> int { return A(); }", 4, "Main,A,B", "B() | 4 | A()"),
        Accepted("repeated", "package scalar\nMain :: () -> int { return Second(Id(1), Id(2)); }\nId :: (x: int) -> int { return x; }\nSecond :: (a: int, b: int) -> int { return b; }", 2, "Main,Id,Second", "1 ; Id(1) ; 2 ; Id(2) ; Second(Id(1), Id(2)) | x | b"),
        Accepted("nested", "package scalar\nMain :: () -> int { return Third(1, Second(2, 3), Third(4, 5, 6)); }\nSecond :: (a: int, b: int) -> int { return b; }\nThird :: (a: int, b: int, c: int) -> int { return c; }", 6, "Main,Second,Third", "1 ; 2 ; 3 ; Second(2, 3) ; 4 ; 5 ; 6 ; Third(4, 5, 6) ; Third(1, Second(2, 3), Third(4, 5, 6)) | b | c"),
        Accepted("same_spelling", "package scalar\nMain :: () -> int { return Value(21); }\nValue :: (Value: int) -> int { return Value; }", 21, "Main,Value", "21 ; Value(21) | Value"),
        Accepted("eight_parameters", "package scalar\nMain :: () -> int { return P(1, 2, 3, 4, 5, 6, 7, 8); }\nP :: (a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int) -> int { return g; }", 7, "Main,P", "1 ; 2 ; 3 ; 4 ; 5 ; 6 ; 7 ; 8 ; P(1, 2, 3, 4, 5, 6, 7, 8) | g"),
        Accepted("int_max_argument", "package scalar\nMain :: () -> int { return Id(2147483647); }\nId :: (x: int) -> int { return x; }", 2147483647, "Main,Id", "2147483647 ; Id(2147483647) | x"),
        Rejected("recursion", "package scalar\nMain :: () -> int { return Main(); }", "scalar proof does not support recursive calls", "Main()"),
        Rejected("mutual_recursion", "package scalar\nMain :: () -> int { return A(); }\nA :: () -> int { return B(); }\nB :: () -> int { return A(); }", "scalar proof does not support recursive calls", "B()"),
        Rejected("unknown_argument", "package scalar\nMain :: () -> int { return Id(Missing()); }\nId :: (x: int) -> int { return x; }", "Unknown function 'Missing'", "Missing"),
