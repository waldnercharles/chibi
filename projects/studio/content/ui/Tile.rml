<div class="tile" data-attrif-data-ready="tile.image != ''" data-attrif-data-loading="tile.loading" data-attrif-data-selected="tile.selected" data-attrif-data-unresolved="tile.unresolved">
  <div class="tile-art">
    <span class="icon glyph">{{ tile.icon }}</span>
    <img class="picture" data-when="tile.image != ''" data-attr-src="tile.image"></img>
    <span class="icon badge">{{ tile.badge }}</span>
    <span class="icon spin">&#xeb19;</span>
  </div>
  <span class="name">{{ tile.label }}</span>
</div>
