ToolchainBuild :: library {
    Join :: (parts: string[]) -> string {
        return BuildJoin(parts, "");
    }
    Helper :: (name: string) -> string {
        return BuildJoin([BuildProgramDirectory(), "..", name], "/");
    }
    Definition :: (argument: string) -> string {
        if (!BuildStartsWith(argument, "-D")) {
            return "";
        }
        return BuildBefore(BuildBefore(BuildAfter(argument, "-D"), "="), ":");
    }
    Normalize :: (arguments: string[]) -> string[] {
        result: string[] = [];
        split := false;
        for (argument in arguments) {
            if (split) {
                result = BuildConcat(result, [Join(["-D", argument])]);
                split = false;
            } else if (argument == "-D") {
                split = true;
            } else {
                result = BuildConcat(result, [argument]);
            }
        }
        if (split) {
            result = BuildConcat(result, ["-D"]);
        }
        return result;
    }
    Cached :: (cache: string, name: string) -> string {
        prefix := Join([name, ":"]);
        for (line in BuildLines(cache)) {
            if (BuildStartsWith(line, prefix)) {
                return BuildAfter(line, "=");
            }
        }
        return "";
    }
    Contains :: (text: string, part: string) -> bool {
        return BuildBefore(text, part) != text;
    }
    // The kind of file a path names once links are followed, "" for none.
    Kind :: (path: string) -> string {
        resolved := BuildResolvePath(path);
        if (resolved == "") {
            return "";
        }
        return BuildFileKind(resolved);
    }
    // The separator that occurs first in text, or "" when none does.
    Earliest :: (text: string, separators: string[]) -> string {
        found := "";
        prefix := text;
        for (separator in separators) {
            before := BuildBefore(text, separator);
            if (before != prefix && BuildStartsWith(prefix, before)) {
                found = separator;
                prefix = before;
            }
        }
        return found;
    }
    // Text split into words as a POSIX shell splits it, without expansion,
    // like Python's shlex.split: blanks separate words, single quotes keep
    // their text, a backslash keeps the next byte, and inside double quotes
    // only a double quote or backslash can be escaped. An unclosed quote or a
    // trailing backslash splits into no words.
    Words :: (text: string) -> string[] {
        unquoted := [" ", "\t", "\r", "\n", "'", "\"", "\\"];
        words: string[] = [];
        word := "";
        started := false;
        quote := "";
        rest := text;
        while (true) {
            separators := unquoted;
            if (quote == "'") {
                separators = ["'"];
            } else if (quote == "\"") {
                separators = ["\"", "\\"];
            }
            separator := Earliest(rest, separators);
            if (separator == "") {
                if (quote != "") {
                    return [];
                }
                if (rest != "" || started) {
                    words = BuildConcat(words, [Join([word, rest])]);
                }
                return words;
            }
            part := BuildBefore(rest, separator);
            rest = BuildAfter(rest, separator);
            word = Join([word, part]);
            started = started || part != "";
            if (separator == "\\") {
                if (rest == "") {
                    return [];
                }
                escapable := unquoted;
                if (quote == "\"") {
                    escapable = ["\"", "\\"];
                }
                escaped := "";
                for (candidate in escapable) {
                    if (BuildStartsWith(rest, candidate)) {
                        escaped = candidate;
                    }
                }
                // Outside quotes an ordinary byte stays at the front of rest.
                if (escaped != "") {
                    word = Join([word, escaped]);
                    rest = BuildAfter(rest, escaped);
                } else if (quote == "\"") {
                    word = Join([word, "\\"]);
                }
                started = true;
            } else if (separator == "'" || separator == "\"") {
                if (quote == "") {
                    quote = separator;
                } else {
                    quote = "";
                }
                started = true;
            } else if (started) {
                words = BuildConcat(words, [word]);
                word = "";
                started = false;
            }
        }
        return words;
    }
    // The SDK the -isysroot of a compiler driver's -### report names, followed
    // through links, or "" when the driver cannot run or names no directory.
    // The report is data, so it stays out of the build's output.
    CompilerSDK :: (compiler: string) -> string {
        command := [compiler];
        if (Kind(compiler) != "file") {
            command = Words(compiler);
        }
        if (BuildLength(command) == 0 || BuildFindExecutable(command[0]) == "") {
            return "";
        }
        RunBuildProbe(BuildConcat(command, ["-###", "-x", "c", "-fsyntax-only", "-"]));
        for (line in BuildLines(BuildLastStderr())) {
            if (!Contains(line, "-isysroot")) {
                continue;
            }
            words := Words(line);
            if (BuildLength(words) == 0) {
                return "";
            }
            index: int = 0;
            while (index < BuildLength(words) && words[index] != "-isysroot") {
                index += 1;
            }
            if (index + 1 < BuildLength(words) && Kind(words[index + 1]) == "directory") {
                return BuildResolvePath(words[index + 1]);
            }
        }
        return "";
    }
    NativeArguments :: (build: string, arguments: string[]) -> string[] {
        cachePath := Join([build, "/CMakeCache.txt"]);
        cache := BuildReadFile(cachePath);
        selected := BuildEnvironment("CC") != "" ||
                    BuildEnvironment("CXX") != "" ||
                    BuildEnvironment("CMAKE_TOOLCHAIN_FILE") != "";
        for (argument in Normalize(arguments)) {
            name := Definition(argument);
            if (name == "CMAKE_C_COMPILER" || name == "CMAKE_CXX_COMPILER" ||
                name == "CMAKE_TOOLCHAIN_FILE" || argument == "--toolchain" ||
                BuildStartsWith(argument, "--toolchain=") || BuildStartsWith(argument, "-C")) {
                selected = true;
            }
        }
        result := arguments;
        if (BuildPlatform() == "Linux" && !BuildFileExists(cachePath) && !selected &&
            BuildFindExecutable("clang") != "" && BuildFindExecutable("clang++") != "") {
            result = BuildConcat(result, ["-DCMAKE_C_COMPILER=clang", "-DCMAKE_CXX_COMPILER=clang++"]);
        }
        return result;
    }
    NativeSDK :: (cache: string, arguments: string[]) -> string {
        sdk := BuildEnvironment("SDKROOT");
        compiler := BuildEnvironment("CC");
        if (compiler == "") {
            compiler = "cc";
        }
        cachedSDK := Cached(cache, "CMAKE_OSX_SYSROOT");
        cachedCompiler := Cached(cache, "CMAKE_C_COMPILER");
        if (cachedSDK != "") {
            sdk = cachedSDK;
        }
        if (cachedCompiler != "") {
            compiler = cachedCompiler;
        }
        for (argument in Normalize(arguments)) {
            name := Definition(argument);
            if (name == "CMAKE_OSX_SYSROOT") {
                sdk = BuildAfter(argument, "=");
            }
            if (name == "CMAKE_C_COMPILER") {
                compiler = BuildAfter(argument, "=");
            }
        }
        if (sdk != "") {
            return sdk;
        }
        sdk = CompilerSDK(compiler);
        if (sdk == "" && RunBuildProbe(["xcrun", "--show-sdk-path"]) == 0) {
            sdk = BuildTrim(BuildLastStdout());
        }
        return sdk;
    }
    // Removes a file, link or directory tree; true when nothing is left.
    RemoveTree :: (path: string) -> bool {
        if (BuildFileKind(path) == "directory") {
            for (name in BuildListDirectory(path)) {
                if (!RemoveTree(Join([path, "/", name]))) {
                    return false;
                }
            }
        }
        return BuildRemove(path);
    }
    // Where unpacked third-party archives live, one directory per SHA-256:
    // .git/chibi/third_party in the clone's Git directory, which all of its
    // worktrees share, or .chibi/third_party in a checkout without Git.
    // cmake/third_party.cmake looks there too.
    ThirdPartyCache :: () -> string {
        if (RunBuildProbe(["git", "-C", BuildRoot(), "rev-parse", "--path-format=absolute",
                           "--git-common-dir"]) == 0) {
            return Join([BuildTrim(BuildLastStdout()), "/chibi/third_party"]);
        }
        return Join([BuildRoot(), "/.chibi/third_party"]);
    }
    // This host's target as third_party/archives.tsv names it.
    ThirdPartyTarget :: () -> string {
        if (RunBuildProbe(["uname", "-m"]) != 0) {
            return "";
        }
        machine := BuildTrim(BuildLastStdout());
        os := "linux";
        if (BuildPlatform() == "Darwin") {
            os = "macos";
        }
        if (machine == "arm64" || machine == "aarch64") {
            return Join([os, "-arm64"]);
        }
        return Join([os, "-x64"]);
    }
    // Downloads one archive with the GitHub CLI, checks its SHA-256 and
    // unpacks it into cache/SHA256. Another build may publish it first.
    ThirdPartyArchive :: (cache: string, build: string, repository: string, release: string,
                          asset: string, sha256: string) -> bool {
        destination := Join([cache, "/", sha256]);
        partial := Join([destination, ".", BuildHashText(BuildResolvePath(build)), ".partial"]);
        file := Join([partial, "/", asset]);
        tree := Join([partial, "/tree"]);
        if (!RemoveTree(partial) || !BuildMakeDirectory(tree)) {
            return false;
        }
        BuildReport(Join(["downloading ", asset, " from ", repository, " ", release]));
        ok := RunBuildStep(["gh", "release", "download", release, "--repo", repository,
                            "--pattern", asset, "--dir", partial]) == 0;
        if (ok && BuildHashFile(file) != sha256) {
            BuildReport(Join([asset, " does not match the SHA-256 third_party/archives.tsv pins"]));
            ok = false;
        }
        ok = ok && RunBuildStep(["tar", "-xzf", file, "-C", tree]) == 0;
        ok = ok && (BuildRename(tree, destination) ||
                    BuildFileKind(Join([destination, "/third-party.cmake"])) == "file");
        return RemoveTree(partial) && ok;
    }
    // Makes sure the cache holds every archive third_party/archives.tsv lists
    // for this host's target; cmake/third_party.cmake picks the build's variant.
    ThirdParty :: (cache: string, build: string) -> bool {
        target := ThirdPartyTarget();
        repository := "";
        for (line in BuildLines(BuildReadFile(Join([BuildRoot(), "/third_party/archives.tsv"])))) {
            if (BuildStartsWith(line, "# repository ")) {
                repository = BuildAfter(line, "# repository ");
            }
            if (BuildStartsWith(line, "#") || BuildBefore(line, "\t") != target) {
                continue;
            }
            variant := BuildBefore(BuildAfter(line, "\t"), "\t");
            release := BuildBefore(BuildAfter(BuildAfter(line, "\t"), "\t"), "\t");
            sha256 := BuildAfter(BuildAfter(BuildAfter(line, "\t"), "\t"), "\t");
            asset := Join(["third-party-", target, "-", variant, ".tar.gz"]);
            if (BuildFileKind(Join([cache, "/", sha256, "/third-party.cmake"])) != "file" &&
                !ThirdPartyArchive(cache, build, repository, release, asset, sha256)) {
                return false;
            }
        }
        return true;
    }
    // Removes unpacked archives that no worktree of this clone pins, so the
    // cache holds only what its checkouts can link. Downloads in progress
    // (".partial") stay. Without Git nothing is pruned.
    PruneThirdParty :: (cache: string) -> bool {
        if (RunBuildProbe(["git", "-C", BuildRoot(), "worktree", "list", "--porcelain"]) != 0) {
            return true;
        }
        pinned := "|";
        for (line in BuildLines(BuildLastStdout())) {
            if (!BuildStartsWith(line, "worktree ")) {
                continue;
            }
            manifest := Join([BuildAfter(line, "worktree "), "/third_party/archives.tsv"]);
            for (row in BuildLines(BuildReadFile(manifest))) {
                if (!BuildStartsWith(row, "#")) {
                    pinned = Join([pinned, BuildAfter(BuildAfter(BuildAfter(row, "\t"), "\t"), "\t"), "|"]);
                }
            }
        }
        for (name in BuildListDirectory(cache)) {
            if (!Contains(name, ".") && !Contains(pinned, Join(["|", name, "|"])) &&
                !RemoveTree(Join([cache, "/", name]))) {
                return false;
            }
        }
        return true;
    }
    Signature :: (profile: string, build: string, arguments: string[]) -> string {
        if (!BuildFileExists(Join([build, "/CMakeCache.txt"]))) {
            return "";
        }
        command := BuildConcat([
            "python3", Helper("configure_inputs.py"), "signature", BuildRoot(), build,
            profile, Join([BuildProgramDirectory(), "/Build.chibi"]), "--"
        ], arguments);
        if (RunBuildStep(command) != 0) {
            return "";
        }
        return BuildTrim(BuildLastStdout());
    }
    Configure :: (profile: string, build: string, arguments: string[]) -> int {
        cache := ThirdPartyCache();
        if (!BuildMakeDirectory(cache) || !ThirdParty(cache, build) || !PruneThirdParty(cache)) {
            BuildReport("cannot prepare the third-party archives");
            return 1;
        }
        stamp := Join([build, "/.chibi-toolchain-config-inputs"]);
        signature := Signature(profile, build, arguments);
        if (signature != "" && signature == BuildTrim(BuildReadFile(stamp))) {
            return 0;
        }
        if (!BuildMakeDirectory(build)) {
            BuildReport("cannot create the build directory");
            return 1;
        }
        selected := NativeArguments(build, arguments);
        if (BuildPlatform() == "Darwin") {
            sdk := NativeSDK(BuildReadFile(Join([build, "/CMakeCache.txt"])), selected);
            if (sdk == "") {
                BuildReport("cannot discover the selected compiler SDK");
                return 1;
            }
            selected = BuildConcat(selected, [Join(["-DCMAKE_OSX_SYSROOT=", sdk])]);
        }
        source := BuildRoot();
        if (profile == "tool-host") {
            source = Join([source, "/sdk"]);
        }
        configure := ["cmake", "-S", source, "-B", build, Join(["-DCHIBI_THIRD_PARTY_CACHE=", cache])];
        if (!BuildFileExists(Join([build, "/CMakeCache.txt"])) &&
            BuildEnvironment("CMAKE_GENERATOR") == "" && BuildFindExecutable("ninja") != "") {
            configure = BuildConcat(configure, ["-G", "Ninja"]);
        }
        status := RunBuildStep(BuildConcat(configure, selected));
        if (status != 0) {
            BuildReport("native configuration failed");
            return status;
        }
        signature = Signature(profile, build, arguments);
        if (signature != "" && !BuildWriteFile(stamp, Join([signature, "\n"]))) {
            BuildReport("cannot save configuration input stamp");
            return 1;
        }
        return 0;
    }
    Build :: () -> int {
        arguments := BuildArguments();
        if (BuildLength(arguments) < 2) {
            BuildReport("usage: native|tool-host BUILD_DIR [--target NAME] [--jobs N] [--configure-only] -- CMAKE_ARGUMENTS");
            return 2;
        }
        profile := arguments[0];
        if (profile != "native" && profile != "tool-host") {
            BuildReport("unknown build profile");
            return 2;
        }
        build := arguments[1];
        configure: string[] = [];
        targets: string[] = [];
        jobs: string = "";
        configureOnly := false;
        tail := false;
        index: int = 2;
        while (index < BuildLength(arguments)) {
            argument := arguments[index];
            index += 1;
            if (tail) {
                configure = BuildConcat(configure, [argument]);
            } else if (argument == "--") {
                tail = true;
            } else if (argument == "--configure-only") {
                configureOnly = true;
            } else if ((argument == "--target" || argument == "--jobs") && index < BuildLength(arguments)) {
                if (argument == "--target") {
                    targets = BuildConcat(targets, [arguments[index]]);
                } else {
                    jobs = arguments[index];
                }
                index += 1;
            } else {
                BuildReport("invalid toolchain build option");
                return 2;
            }
        }
        if (profile == "tool-host") {
            configure = BuildConcat([
                "-DCHIBI_SDK_BUILD_COMPILER=ON", "-DCHIBI_SDK_BUILD_NATIVE=OFF", "-DCHIBI_SDK_BUILD_DESKTOP=OFF"
            ], configure);
            if (BuildLength(targets) == 0) {
                targets = ["chibi-build-host"];
            }
        }
        status := Configure(profile, build, configure);
        if (status != 0 || configureOnly) {
            return status;
        }
        command := ["cmake", "--build", build];
        if (BuildLength(targets) > 0) {
            command = BuildConcat(command, BuildConcat(["--target"], targets));
        }
        if (jobs != "") {
            command = BuildConcat(command, ["--parallel", jobs]);
        }
        status = RunBuildStep(command);
        if (status != 0) {
            BuildReport("native build failed");
        }
        return status;
    }
}
