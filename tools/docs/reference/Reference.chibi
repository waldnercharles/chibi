package reference

import markdown "project:markdown"
import strings "core:strings"

// The reference of a collection's packages, generated from their source: each
// package with its import path, and each top-level declaration's signature
// with the comment written above it.

Colon :: 58;

// A comment line's text, without its slashes.
CommentText :: pure fn(line: string) -> string {
    return markdown.Trim(markdown.From(markdown.Trim(line), 2));
}

IsComment :: pure fn(line: string) -> bool {
    return markdown.StartsWith(markdown.Trim(line), "//");
}

// The name a top-level declaration line declares, or "" for any other line:
// `Name :: ...` and typed constants such as `Name: int : 5;`.
Declared :: pure fn(line: string) -> string {
    if (line == "" || markdown.IsBlank(markdown.At(line, 0)) || IsComment(line) ||
        markdown.StartsWith(line, "package ") || markdown.StartsWith(line, "import ") ||
        markdown.StartsWith(line, "@")) {
        return "";
    }
    marker := markdown.FindText(line, " :: ", 0);
    if (marker > 0) {
        return strings.Slice(line, 0, marker);
    }
    colon := markdown.Find(line, Colon, 0);
    if (colon > 0 && markdown.FindText(line, " : ", colon) > colon) {
        return strings.Slice(line, 0, colon);
    }
    return "";
}

// The last index of pattern in text, or -1.
FindLast :: pure fn(text: string, pattern: string) -> int {
    found := -1;
    index := markdown.FindText(text, pattern, 0);
    while (index >= 0) {
        found = index;
        index = markdown.FindText(text, pattern, index + 1);
    }
    return found;
}

// A declaration's signature: a record's or union's lines as written, and
// otherwise its lines joined up to the body or the closing semicolon.
Signature :: pure fn(lines: string[], start: int, end: int) -> string {
    text: string = "";
    whole := markdown.FindText(lines[start], ":: struct", 0) > 0 ||
             markdown.FindText(lines[start], ":: union", 0) > 0;
    index := start;
    while (whole && index < end) {
        if (index == start) {
            text = lines[index];
        } else {
            text = format_text("{}\n{}", text, lines[index]);
        }
        line := markdown.Trim(lines[index]);
        if (markdown.EndsWith(line, "}") || markdown.EndsWith(line, "};")) {
            return text;
        }
        index += 1;
    }
    while (index < end) {
        line := markdown.Trim(lines[index]);
        if (markdown.EndsWith(line, ";")) {
            return markdown.Trim(format_text("{} {}", text, line));
        }
        if (markdown.EndsWith(line, "{")) {
            body := FindLast(line, " {");
            return markdown.Trim(format_text("{} {}", text, strings.Slice(line, 0, body)));
        }
        text = markdown.Trim(format_text("{} {}", text, line));
        index += 1;
    }
    return text;
}

// The package folder of a path inside the collection.
Package :: pure fn(path: string) -> string {
    return markdown.Folder(path);
}

// The Markdown of one file's declarations, under its package's heading when
// the file starts a package.
FileMarkdown :: pure fn(collection: string, path: string, first: bool, lines: string[], start: int,
                        end: int) -> string[] {
    md: string[] = [];
    if (first) {
        md = array_add(md, format_text("## {}", strings.BaseName(Package(path))));
        md = array_add(md, "");
        md = array_add(md, format_text("Import it as `{}:{}`.", collection, Package(path)));
        md = array_add(md, "");
    }
    // An attributed declaration, such as a @test, is not part of the API.
    comment: string[] = [];
    attributed := false;
    index := start;
    while (index < end) {
        line := lines[index];
        name := Declared(line);
        if (markdown.StartsWith(line, "@")) {
            // An attribute alone on its line applies to the next declaration.
            attributed = markdown.FindText(line, " :: ", 0) < 0;
            comment = [];
            index += 1;
            continue;
        }
        if (name != "" && attributed) {
            name = "";
            attributed = false;
        }
        if (name != "") {
            md = array_add(md, format_text("### {}", name));
            md = array_add(md, "");
            md = array_add(md, "```chibi");
            md = array_add(md, Signature(lines, index, end));
            md = array_add(md, "```");
            md = array_add(md, "");
            foreach (text in comment) {
                md = array_add(md, text);
            }
            md = array_add(md, "");
        }
        if (IsComment(line) && !markdown.IsBlank(markdown.At(line, 0))) {
            comment = array_add(comment, CommentText(line));
        } else {
            comment = [];
        }
        index += 1;
    }
    return md;
}

// The reference page's body. paths names each file relative to the
// collection's folder, starts[i] is where file i begins in lines, and the
// last three arguments map links as markdown.Render does.
Render :: pure fn(collection: string, paths: string[], starts: int[], lines: string[], page: string,
                  sources: string[], outputs: string[]) -> string[] {
    md: string[] = [format_text("# The {} packages", collection), "",
                    "Each package's declarations and the comments written above them in its source.", ""];
    previous: string = "";
    index: int = 0;
    while (index < length(paths)) {
        end := length(lines);
        if (index + 1 < length(starts)) {
            end = starts[index + 1];
        }
        first := Package(paths[index]) != previous;
        previous = Package(paths[index]);
        md = append(md, FileMarkdown(collection, paths[index], first, lines, starts[index], end));
        index += 1;
    }
    return markdown.Render(md, page, sources, outputs);
}
