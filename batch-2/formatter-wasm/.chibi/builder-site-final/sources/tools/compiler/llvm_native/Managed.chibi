package llvm_native

import abi "project:native_abi"
import strings "core:strings"

// A nonmoving heap whose zero value is empty. Its owner supplies all live
// roots and calls collection only with execution quiescent or roots spilled.
// Cells retain typed payload trace/drop callbacks; callbacks must outlive them.
// At 64-bit targets the heap is 40 bytes, each cell header 56 and root node 24.
// Mark/sweep is O(roots + cells + edges), with no per-edge allocation/recursion.
// This runtime is not yet source admission or a public native-boundary ABI.
pub ManagedRuntime :: () -> string {
    return strings.Join([
        "%chibi.managed.heap = type { ptr, ptr, ptr, i64, i64 }\n",
        "%chibi.managed.cell = type { ptr, ptr, ptr, ptr, i64, i1, ptr }\n",
        "%chibi.managed.root = type { ptr, ptr, ptr }\n",
        "\n",
        "; A heap's cells never move. Trace and drop callbacks receive payload storage.\n",
        "; Tracing only queues managed cells; dropping only releases external owners.\n",
        "define internal ptr @chibi_managed.new(ptr %ctx, ptr %heap, i64 %bytes, ptr %trace, ptr %drop) {\n",
        "entry:\n",
        "  %header = ptrtoint ptr getelementptr (%chibi.managed.cell, ptr null, i32 1) to i64\n",
        "  %room = sub i64 -1, %header\n",
        "  %fits = icmp ule i64 %bytes, %room\n",
        "  %used.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 3\n",
        "  %used = load i64, ptr %used.at\n",
        "  %total = add i64 %bytes, %header\n",
        "  %remaining = sub i64 -1, %used\n",
        "  %counts = icmp ule i64 %total, %remaining\n",
        "  %valid = and i1 %fits, %counts\n",
        "  br i1 %valid, label %allocate, label %trap\n",
        "allocate:\n",
        format_text("  %allocator.at = getelementptr {}, ptr %ctx, i32 0, i32 2\n", abi.ContextType()),
        "  %allocator = load ptr, ptr %allocator.at\n",
        "  %cell = call ptr %allocator(ptr %ctx, i64 %total)\n",
        "  store %chibi.managed.cell zeroinitializer, ptr %cell\n",
        "  %first = load ptr, ptr %heap\n",
        "  store ptr %first, ptr %cell\n",
        "  %trace.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 2\n",
        "  %drop.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 3\n",
        "  %size.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 4\n",
        "  store ptr %trace, ptr %trace.at\n",
        "  store ptr %drop, ptr %drop.at\n",
        "  store i64 %total, ptr %size.at\n",
        "  %owner.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 6\n",
        "  store ptr %heap, ptr %owner.at\n",
        "  %payload = getelementptr %chibi.managed.cell, ptr %cell, i32 1\n",
        "  call void @llvm.memset.p0.i64(ptr %payload, i8 0, i64 %bytes, i1 false)\n",
        "  store ptr %cell, ptr %heap\n",
        "  %next.used = add i64 %used, %total\n",
        "  store i64 %next.used, ptr %used.at\n",
        "  ret ptr %cell\n",
        "trap:\n",
        "  call void @llvm.trap()\n",
        "  unreachable\n",
        "}\n",
        "\n",
        "; Root nodes and their slots have stable addresses until the matching pop.\n",
        "; All slots are initialized before push; writes update the registered slot.\n",
        "define internal void @chibi_managed.push(ptr %heap, ptr %root, ptr %slot, ptr %trace) {\n",
        "entry:\n",
        "  %head = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 1\n",
        "  %old = load ptr, ptr %head\n",
        "  store ptr %old, ptr %root\n",
        "  %value.at = getelementptr %chibi.managed.root, ptr %root, i32 0, i32 1\n",
        "  %trace.at = getelementptr %chibi.managed.root, ptr %root, i32 0, i32 2\n",
        "  store ptr %slot, ptr %value.at\n",
        "  store ptr %trace, ptr %trace.at\n",
        "  store ptr %root, ptr %head\n",
        "  ret void\n",
        "}\n",
        "define internal void @chibi_managed.pop(ptr %heap, ptr %root) {\n",
        "entry:\n",
        "  %head = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 1\n",
        "  %old = load ptr, ptr %head\n",
        "  %same = icmp eq ptr %old, %root\n",
        "  br i1 %same, label %remove, label %trap\n",
        "remove:\n",
        "  %previous = load ptr, ptr %root\n",
        "  store ptr %previous, ptr %head\n",
        "  store %chibi.managed.root zeroinitializer, ptr %root\n",
        "  ret void\n",
        "trap:\n",
        "  call void @llvm.trap()\n",
        "  unreachable\n",
        "}\n",
        "\n",
        "; The cell header is its work-list node, so cycles and deep graphs allocate no\n",
        "; traversal memory and use no recursive collector stack.\n",
        "define internal void @chibi_managed.mark(ptr %heap, ptr %cell) {\n",
        "entry:\n",
        "  %empty = icmp eq ptr %cell, null\n",
        "  br i1 %empty, label %exit, label %check\n",
        "check:\n",
        "  %owner.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 6\n",
        "  %owner = load ptr, ptr %owner.at\n",
        "  %same.owner = icmp eq ptr %owner, %heap\n",
        "  br i1 %same.owner, label %owned, label %trap\n",
        "owned:\n",
        "  %marked.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 5\n",
        "  %marked = load i1, ptr %marked.at\n",
        "  br i1 %marked, label %exit, label %queue\n",
        "queue:\n",
        "  store i1 true, ptr %marked.at\n",
        "  %work.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 2\n",
        "  %old = load ptr, ptr %work.at\n",
        "  %next.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 1\n",
        "  store ptr %old, ptr %next.at\n",
        "  store ptr %cell, ptr %work.at\n",
        "  br label %exit\n",
        "exit:\n",
        "  ret void\n",
        "trap:\n",
        "  call void @llvm.trap()\n",
        "  unreachable\n",
        "}\n",
        "\n",
        "; Only quiescent code with complete spilled roots may call collect/safepoint.\n",
        "; Callbacks never allocate or collect and drop never follows managed edges.\n",
        "define internal void @chibi_managed.collect(ptr %ctx, ptr %heap) {\n",
        "entry:\n",
        "  %roots.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 1\n",
        "  %first.root = load ptr, ptr %roots.at\n",
        "  br label %roots\n",
        "roots:\n",
        "  %root = phi ptr [ %first.root, %entry ], [ %next.root, %trace.root ]\n",
        "  %roots.done = icmp eq ptr %root, null\n",
        "  br i1 %roots.done, label %work, label %trace.root\n",
        "trace.root:\n",
        "  %next.root = load ptr, ptr %root\n",
        "  %slot.at = getelementptr %chibi.managed.root, ptr %root, i32 0, i32 1\n",
        "  %root.trace.at = getelementptr %chibi.managed.root, ptr %root, i32 0, i32 2\n",
        "  %slot = load ptr, ptr %slot.at\n",
        "  %root.trace = load ptr, ptr %root.trace.at\n",
        "  call void %root.trace(ptr %heap, ptr %slot)\n",
        "  br label %roots\n",
        "work:\n",
        "  %work.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 2\n",
        "  %cell = load ptr, ptr %work.at\n",
        "  %work.done = icmp eq ptr %cell, null\n",
        "  br i1 %work.done, label %sweep, label %take\n",
        "take:\n",
        "  %next.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 1\n",
        "  %next = load ptr, ptr %next.at\n",
        "  store ptr %next, ptr %work.at\n",
        "  store ptr null, ptr %next.at\n",
        "  %trace.at = getelementptr %chibi.managed.cell, ptr %cell, i32 0, i32 2\n",
        "  %trace = load ptr, ptr %trace.at\n",
        "  %leaf = icmp eq ptr %trace, null\n",
        "  br i1 %leaf, label %work, label %trace.cell\n",
        "trace.cell:\n",
        "  %payload = getelementptr %chibi.managed.cell, ptr %cell, i32 1\n",
        "  call void %trace(ptr %heap, ptr %payload)\n",
        "  br label %work\n",
        "sweep:\n",
        "  br label %cells\n",
        "cells:\n",
        "  %link = phi ptr [ %heap, %sweep ], [ %cell.next, %keep ], [ %link, %release ]\n",
        "  %current = load ptr, ptr %link\n",
        "  %done = icmp eq ptr %current, null\n",
        "  br i1 %done, label %exit, label %inspect\n",
        "inspect:\n",
        "  %mark.at = getelementptr %chibi.managed.cell, ptr %current, i32 0, i32 5\n",
        "  %live = load i1, ptr %mark.at\n",
        "  br i1 %live, label %keep, label %discard\n",
        "keep:\n",
        "  store i1 false, ptr %mark.at\n",
        "  %cell.next = getelementptr %chibi.managed.cell, ptr %current, i32 0, i32 0\n",
        "  br label %cells\n",
        "discard:\n",
        "  %following = load ptr, ptr %current\n",
        "  store ptr %following, ptr %link\n",
        "  %drop.at = getelementptr %chibi.managed.cell, ptr %current, i32 0, i32 3\n",
        "  %drop = load ptr, ptr %drop.at\n",
        "  %plain = icmp eq ptr %drop, null\n",
        "  br i1 %plain, label %release, label %drop.cell\n",
        "drop.cell:\n",
        "  %value = getelementptr %chibi.managed.cell, ptr %current, i32 1\n",
        "  call void %drop(ptr %ctx, ptr %value)\n",
        "  br label %release\n",
        "release:\n",
        "  %size.at = getelementptr %chibi.managed.cell, ptr %current, i32 0, i32 4\n",
        "  %size = load i64, ptr %size.at\n",
        "  %used.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 3\n",
        "  %used = load i64, ptr %used.at\n",
        "  %left = sub i64 %used, %size\n",
        "  store i64 %left, ptr %used.at\n",
        format_text("  %release.at = getelementptr {}, ptr %ctx, i32 0, i32 4\n", abi.ContextType()),
        "  %free = load ptr, ptr %release.at\n",
        "  call void %free(ptr %ctx, ptr %current)\n",
        "  br label %cells\n",
        "exit:\n",
        "  %kept.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 3\n",
        "  %kept = load i64, ptr %kept.at\n",
        "  %doubled = shl i64 %kept, 1\n",
        "  %overflow = icmp ult i64 %doubled, %kept\n",
        "  %bounded = select i1 %overflow, i64 -1, i64 %doubled\n",
        "  %large = icmp ugt i64 %bounded, 65536\n",
        "  %threshold = select i1 %large, i64 %bounded, i64 65536\n",
        "  %threshold.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 4\n",
        "  store i64 %threshold, ptr %threshold.at\n",
        "  ret void\n",
        "}\n",
        "define internal void @chibi_managed.safepoint(ptr %ctx, ptr %heap) {\n",
        "entry:\n",
        "  %used.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 3\n",
        "  %used = load i64, ptr %used.at\n",
        "  %threshold.at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 4\n",
        "  %configured = load i64, ptr %threshold.at\n",
        "  %set = icmp ugt i64 %configured, 65536\n",
        "  %threshold = select i1 %set, i64 %configured, i64 65536\n",
        "  %due = icmp uge i64 %used, %threshold\n",
        "  br i1 %due, label %collect, label %exit\n",
        "collect:\n",
        "  call void @chibi_managed.collect(ptr %ctx, ptr %heap)\n",
        "  br label %exit\n",
        "exit:\n",
        "  ret void\n",
        "}\n"
    ], "");
}
