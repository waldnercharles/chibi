package json_string

import strings "core:strings"

pub Decoded :: struct {
    valid: bool;
    value: string;
    byte_length: int;
}

pub Metadata :: (literal: string) -> Decoded {
    return {valid: false, value: "", byte_length: strings.ByteLength(literal)};
}

pub Value :: (literal: string) -> Decoded {
    return {valid: false, value: "", byte_length: strings.ByteLength(literal)};
}
