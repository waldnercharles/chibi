package facts

// ordinary optional boolean member and operand reads the present payload
@test
Calls :: () {
    a1_0: bool = false;
    a1_1: bool = false;
    r1: int = Use(a1_0, a1_1);
    e1: int = 17;
    assert(r1 == e1, "Use call 1");
    a2_0: bool = true;
    a2_1: bool = false;
    r2: int = Use(a2_0, a2_1);
    e2: int = 99;
    assert(r2 == e2, "Use call 2");
    a3_0: bool = false;
    a3_1: bool = true;
    r3: int = Use(a3_0, a3_1);
    e3: int = 0;
    assert(r3 == e3, "Use call 3");
    a4_0: bool = true;
    a4_1: bool = true;
    r4: int = Use(a4_0, a4_1);
    e4: int = 0;
    assert(r4 == e4, "Use call 4");
}
