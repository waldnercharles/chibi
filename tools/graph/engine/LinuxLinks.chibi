            "third-party/lib/chibi-vendor/libchibi_vendor_tree_sitter.a",
            "chibi_behavior_runtime", "chibi_events",
            "chibi_native_capabilities", "chibi_asset_values", "chibi_execution",
            "third-party/lib/chibi-vendor/libchibi_vendor_sljit.a", "chibi_native_types", "chibi_ecs",
            "chibi_capabilities", "chibi_types", "chibi_support", "-lm"
