version 3
name "OutlinerHeaderInput"
id_counter 47
description "The Outliner's header: the filter field sets the object filter the rows and Up and Down follow, and shows it when Studio clears it; Add lists the scene's prototypes and places the one chosen, while the scene is editable."
owner_type "ecs.entity"
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Event" reference_name="Refresh"
            - id=3 type="Editor State"
            - id=7 type="Scene Info"
            - id=11 type="Prototype Choices"
            - {
                id 15
                type "Set UI Data"
                inputs Name="editable"
            }
            - {
                id 21
                type "Set UI Data"
                inputs Name="filter"
            }
            - {
                id 27
                type "Set UI Data"
                inputs Name="prototypes"
            }
            - {
                id 33
                type "Event"
                reference_name "FilterTyped"
                outputs {
                    Filter id=35 declaration_id=1 type="const char *" kind="data"
                }
            }
            - id=36 type="Set Object Filter"
            - {
                id 40
                type "Event"
                reference_name "AddObject"
                outputs {
                    Prototype id=42 declaration_id=1 type="const char *" kind="data"
                }
            }
            - id=43 type="Add Object"
        }
        (array)edges {
            - from="1.Then" to="11.Exec"
            - from="3.Editable" to="15.Value"
            - from="7.Filter" to="21.Value"
            - from="11.Then" to="15.Exec"
            - from="11.Options" to="27.Value"
            - from="15.Then" to="21.Exec"
            - from="21.Then" to="27.Exec"
            - from="33.Then" to="36.Exec"
            - from="33.Filter" to="36.Filter"
            - from="40.Then" to="43.Exec"
            - from="40.Prototype" to="43.Prototype"
        }
    }
}
