package evidence

import files "graph:files"
import engine "graph:engine"
import os "core:os"
import strings "core:strings"

// Evidence that a CI build ran with the profile it selected. It reads what the
// build left (the commands in each output's `.chibi-record`, the stamps of its
// inputs, the sanitizer symbols `nm` finds) rather than the planned command
// databases, which only say what would run. A record can describe a cache hit
// instead of a fresh compile. C profile checks cover representative objects and
// required links; native products have their own compiler command checks.
//
// Every check returns "" when it holds, else what failed.

// The compile flags the selected profile promises: -O1, debug information and
// frame pointers, no NDEBUG (tests also name -UNDEBUG) and ASan+UBSan exactly
// when `sanitizers`.
pub CheckFlags :: (arguments: string[], sanitizers: bool, test: bool) -> string {
    optimization: string[] = [];
    defines: string[] = [];
    for (index in 0..<length(arguments)) {
        argument := arguments[index];
        if (strings.HasPrefix(argument, "-O")) {
            optimization.append(argument);
        }
        if (argument == "-D" && index + 1 < length(arguments)) {
            defines.append(arguments[index + 1]);
        } else if (strings.HasPrefix(argument, "-D") && argument != "-D") {
            defines.append(strings.Cut(argument, 2, strings.ByteLength(argument) - 2));
        }
    }
    if (length(optimization) != 1 || optimization[0] != "-O1") {
        return "expected exactly -O1";
    }
    if (!arguments.contains("-g") || arguments.contains("-g0")) {
        return "expected debug information";
    }
    if (!arguments.contains("-fno-omit-frame-pointer") || arguments.contains("-fomit-frame-pointer")) {
        return "expected frame pointers";
    }
    for (define in defines) {
        if (strings.Partition(define, "=").head == "NDEBUG") {
            return "NDEBUG disables assertions";
        }
    }
    if (test && !arguments.contains("-UNDEBUG")) {
        return "test assertions must be explicitly enabled";
    }
    return CheckSanitizers(arguments, sanitizers);
}

// ASan+UBSan exactly when requested, and no flag that turns one off.
pub CheckSanitizers :: (arguments: string[], sanitizers: bool) -> string {
    selected: string[] = [];
    for (argument in arguments) {
        if (strings.HasPrefix(argument, "-fno-sanitize=")) {
            return "expected ASan+UBSan exactly when requested, without disabling flags";
        }
        if (strings.HasPrefix(argument, "-fsanitize=")) {
            selected.append(argument);
        }
    }
    if (sanitizers && (length(selected) != 1 || selected[0] != "-fsanitize=address,undefined")) {
        return "expected ASan+UBSan exactly when requested, without disabling flags";
    }
    if (!sanitizers && length(selected) != 0) {
        return "expected ASan+UBSan exactly when requested, without disabling flags";
    }
    return "";
}

// Native products are O2 compiler programs, independent of the C profile. Use
// the graph's product recipe to bind their source, entry, target and output.
pub CheckNative :: (arguments: string[], root: string, build: string, target: string) -> string {
    llvm := Place(arguments, "--llvm");
    jobs := Place(arguments, "--jobs");
    if (length(arguments) == 0 || llvm < 0 || llvm + 1 >= length(arguments) ||
        jobs < 0 || jobs + 1 >= length(arguments)) {
        return "unexpected native product command";
    }
    expected := engine.NativeCommand(arguments[0], arguments[llvm + 1], os.RealPath(root), os.RealPath(build), target, 1);
    if (length(expected) == 0 || length(arguments) != length(expected)) {
        return "unexpected native product command";
    }
    for (index in 0..<length(expected)) {
        // Worker count changes compile time, not the selected product/profile.
        if (index != jobs + 1 && arguments[index] != expected[index]) {
            return "unexpected native product command";
        }
    }
    return "";
}

// The sanitizer runtime symbols in `nm -g` output, once each. Mach-O adds a
// leading underscore. An object must reference them (U); a runtime definition
// counts only after linking, never in a source object that defines
// sanitizer-named stubs.
pub Symbols :: (text: string, compiled: bool) -> string[] {
    found: string[] = [];
    for (line in strings.SplitLines(text)) {
        fields := strings.Fields(line);
        if (length(fields) < 2) {
            continue;
        }
        name := fields[length(fields) - 1];
        kind := fields[length(fields) - 2];
        if (kind != "U" && (compiled || kind != "T")) {
            continue;
        }
        if (Family(name) != "" && !found.contains(name)) {
            found.append(name);
        }
    }
    return found;
}

// "asan" or "ubsan" for `__asan_init`, `___ubsan_handle_x` and the like.
Family :: (name: string) -> string {
    for (prefix in ["___asan_", "__asan_", "___ubsan_", "__ubsan_"]) {
        if (strings.HasPrefix(name, prefix) && strings.ByteLength(name) > strings.ByteLength(prefix)) {
            if (strings.Contains(prefix, "ubsan")) {
                return "ubsan";
            }
            return "asan";
        }
    }
    return "";
}

// Both families when sanitizers were requested, neither when not.
pub CheckSymbols :: (text: string, sanitizers: bool, compiled: bool) -> string {
    asan := false;
    ubsan := false;
    for (name in Symbols(text, compiled)) {
        asan = asan || Family(name) == "asan";
        ubsan = ubsan || Family(name) == "ubsan";
    }
    if (asan != sanitizers || ubsan != sanitizers) {
        return "sanitizer symbols do not match the requested profile";
    }
    return "";
}

// The command a record holds: its lines up to the first blank one.
pub Command :: (record: string) -> string[] {
    command: string[] = [];
    for (line in strings.SplitLines(record)) {
        if (line == "") {
            return command;
        }
        command.append(line);
    }
    return command;
}

// The stamped files a record ends with, one path then one stamp each, after the
// blank line that closes the command.
Footer :: (record: string) -> string[] {
    lines: string[] = [];
    closed := false;
    for (line in strings.SplitLines(record)) {
        if (closed) {
            lines.append(line);
        } else if (line == "") {
            closed = true;
        }
    }
    // The text ends with a newline, which splits off an empty last line.
    end := length(lines);
    while (end > 0 && lines[end - 1] == "") {
        end = end - 1;
    }
    footer: string[] = [];
    for (index in 0..<end) {
        footer.append(lines[index]);
    }
    return footer;
}

// String arrays keep this check compatible with the pinned producer. Sort once,
// then use logarithmic membership rather than scanning the entire receipt for
// every compiler/core source.
InputsBound :: (inputs: string[], recorded: string[]) -> bool {
    ordered := recorded;
    width := 1;
    while (width < length(ordered)) {
        merged: string[] = [];
        start := 0;
        while (start < length(ordered)) {
            middle := start + width;
            if (middle > length(ordered)) { middle = length(ordered); }
            end := middle + width;
            if (end > length(ordered)) { end = length(ordered); }
            left := start;
            right := middle;
            while (left < middle && right < end) {
                if (strings.Compare(ordered[left], ordered[right]) <= 0) {
                    merged.append(ordered[left]);
                    left += 1;
                } else {
                    merged.append(ordered[right]);
                    right += 1;
                }
            }
            while (left < middle) { merged.append(ordered[left]); left += 1; }
            while (right < end) { merged.append(ordered[right]); right += 1; }
            start = end;
        }
        ordered = merged;
        width *= 2;
    }
    for (path in inputs) {
        first := 0;
        end := length(ordered);
        while (first < end) {
            middle := first + (end - first) / 2;
            if (strings.Compare(ordered[middle], path) < 0) { first = middle + 1; }
            else { end = middle; }
        }
        if (first == length(ordered) || ordered[first] != path) { return false; }
    }
    return true;
}

// Whether `output`'s record binds its command, inputs and output to live stamps.
// Native records bind the compiler, source roots and LLVM tools; C records bind
// the `-c` source or the objects and absolute libraries of a link.
// ccache rebases depfile inputs against the checkout, so inputs compare by real
// path.
pub ReadRecord :: (output: string) -> string {
    record := files.Text(format_text("{}.chibi-record", output));
    if (record == "") {
        return format_text("{}: no record", output);
    }
    arguments := Command(record);
    footer := Footer(record);
    if (length(arguments) == 0 || length(footer) < 4 || length(footer) % 2 != 0 ||
        os.RealPath(footer[length(footer) - 2]) != os.RealPath(output)) {
        return format_text("{}: missing output binding or malformed stamps", output);
    }
    place := -1;
    native := false;
    for (index in 0..<length(arguments)) {
        if (arguments[index] == "-o" || arguments[index] == "--output") {
            if (place >= 0) {
                return format_text("{}: more than one output option", output);
            }
            place = index;
            native = arguments[index] == "--output";
        }
    }
    if (place < 0 || place + 1 >= length(arguments) || os.RealPath(arguments[place + 1]) != os.RealPath(output)) {
        return format_text("{}: command output mismatch", output);
    }
    inputs: string[] = [];
    at := Place(arguments, "-c");
    if (native) {
        inputs.append(arguments[0]);
        for (option in ["--compiler", "--core", "--source"]) {
            index := Place(arguments, option);
            if (index < 0 && option == "--source") { continue; }
            if (index < 0 || index + 1 >= length(arguments)) {
                return format_text("{}: unexpected native command", output);
            }
            if (option == "--source") {
                inputs.append(arguments[index + 1]);
            } else {
                inventory := engine.NativeInputs(arguments[index + 1]);
                if (length(inventory) == 0) {
                    return format_text("{}: cannot read native source inventory", output);
                }
                inputs.extend(inventory);
            }
        }
        index := Place(arguments, "--llvm");
        if (index < 0 || index + 1 >= length(arguments)) {
            return format_text("{}: unexpected native command", output);
        }
        linker := "ld.lld";
        suffix := "";
        if (os.Platform() == "Darwin") { linker = "ld64.lld"; }
        if (os.Platform() == "Windows") { linker = "lld-link"; suffix = ".exe"; }
        for (tool in ["opt", "llc", linker]) {
            inputs.append(format_text("{}/{}{}", arguments[index + 1], tool, suffix));
        }
    } else if (at >= 0) {
        if (at + 1 >= length(arguments)) {
            return format_text("{}: unexpected compile command", output);
        }
        inputs.append(arguments[at + 1]);
    } else {
        // The link puts objects before -o and libraries after its output;
        // other absolute operands, such as macOS -isysroot, are not inputs.
        for (index in 1..<place) {
            if (strings.HasSuffix(arguments[index], ".o")) {
                inputs.append(arguments[index]);
            }
        }
        for (index in (place + 2)..<length(arguments)) {
            if (strings.HasPrefix(arguments[index], "/")) {
                inputs.append(arguments[index]);
            }
        }
    }
    recorded: string[] = [];
    for (index in 0..<length(footer) / 2) {
        recorded.append(os.RealPath(footer[index * 2]));
    }
    if (length(inputs) == 0) {
        return format_text("{}: missing command input binding", output);
    }
    canonical: string[] = [];
    for (input in inputs) { canonical.append(os.RealPath(input)); }
    if (!InputsBound(canonical, recorded)) {
        return format_text("{}: missing command input binding", output);
    }
    for (index in 0..<length(footer) / 2) {
        path := footer[index * 2];
        fingerprint := files.Fingerprint(path);
        if (path == "" || fingerprint == "" || fingerprint != footer[index * 2 + 1]) {
            return format_text("{}: stale input/output {}", output, path);
        }
    }
    return "";
}

// The record's arguments, "" parts apart; empty when there is no record.
pub Arguments :: (output: string) -> string[] {
    return Command(files.Text(format_text("{}.chibi-record", output)));
}

// A string as a JSON literal.
Quote :: (text: string) -> string {
    escaped := strings.ReplaceAll(strings.ReplaceAll(text, "\\", "\\\\"), "\"", "\\\"");
    escaped = strings.ReplaceAll(strings.ReplaceAll(escaped, "\n", "\\n"), "\t", "\\t");
    return format_text("\"{}\"", escaped);
}

// The flags a test compiler header lists, one JSON string per line.
pub ExportedFlags :: (header: string) -> string[] {
    flags: string[] = [];
    for (line in strings.SplitLines(header)) {
        text := strings.TrimSpace(line);
        if (strings.HasPrefix(text, "\"") && strings.HasSuffix(text, "\",")) {
            body := strings.Cut(text, 1, strings.ByteLength(text) - 3);
            flags.append(strings.ReplaceAll(strings.ReplaceAll(body, "\\\"", "\""), "\\\\", "\\"));
        }
    }
    return flags;
}

// The index of the first `value` in `arguments`, -1 when there is none.
Place :: (arguments: string[], value: string) -> int {
    for (index in 0..<length(arguments)) {
        if (arguments[index] == value) {
            return index;
        }
    }
    return -1;
}

// A source names a representative C object; a target names a native product.
// Rows with neither are C links.
Output :: struct {
    path: string;
    source: string;
    test: bool;
    target: string;
}

Outputs :: () -> Output[] {
    outputs: Output[] = [
        {path: "objects/chibi_support/src/support/arena.c.o", source: "src/support/arena.c", test: false, target: ""},
        {path: "objects/test_tools/test/tools/main.c.o", source: "test/tools/main.c", test: true, target: ""},
        {path: "objects/test_language/test/language/main.c.o", source: "test/language/main.c", test: true, target: ""},
        {path: "sdk/chibi-compile", source: "", test: false, target: ""},
        {path: "sdk/chibi-build-host", source: "", test: false, target: ""},
        {path: "test/tools/test_tools", source: "", test: false, target: ""},
        {path: "test/language/test_language", source: "", test: false, target: ""}
    ];
    for (target in engine.NativeProducts()) {
        outputs.append({path: strings.TrimPrefix(engine.Executable("", target), "/"), source: "", test: false, target: target});
    }
    return outputs;
}

// What CI selected and ran, as the workflow passes it: the build host reads no
// ambient environment beyond a short allowlist, so each fact is an argument.
pub Selected :: struct {
    sha: string;
    run: string;
    attempt: string;
    job: string;
    sanitizers: string;
    profile: string;
    optimization: string;
    frame_pointers: string;
    outcome: string;
}

// The outcome of Verify: the first problem ("" when none) and a JSON object for
// each output checked before it.
Verdict :: struct {
    problem: string;
    checked: string[];
}

// The first problem with the build in `build` under what CI selected, else "".
// The symbol listings and records of each checked output are copied below
// `output`.
Verify :: (root: string, build: string, output: string, nm: string, selected: Selected) -> Verdict {
    checked: string[] = [];
    head := os.Capture(["git", "-C", root, "rev-parse", "HEAD"]);
    changes := os.Capture(["git", "-C", root, "status", "--porcelain", "--untracked-files=no"]);
    if (head.status != 0 || changes.status != 0 || strings.TrimSpace(head.stdout) != selected.sha ||
        strings.TrimSpace(changes.stdout) != "") {
        return {problem: "checkout does not match the clean CI source", checked: checked};
    }
    if (selected.sanitizers != "ON" && selected.sanitizers != "OFF") {
        return {problem: "missing selected sanitizer profile", checked: checked};
    }
    sanitizers := selected.sanitizers == "ON";
    profile := "debug";
    frames := "on";
    if (sanitizers) {
        profile = "sanitizer";
        frames = "";
    }
    if (selected.profile != profile || selected.optimization != "1" || selected.frame_pointers != frames) {
        return {problem: "unexpected selected CI profile", checked: checked};
    }
    for (name in ["compile_commands.json", "link_commands.json"]) {
        if (os.Copy(format_text("{}/{}", build, name), format_text("{}/{}", output, name)) != nil) {
            return {problem: format_text("cannot copy {}", name), checked: checked};
        }
    }
    for (row in Outputs()) {
        path := os.RealPath(format_text("{}/{}", build, row.path));
        if (path == "") {
            return {problem: format_text("missing output {}", row.path), checked: checked};
        }
        destination := format_text("{}/{}", output, strings.ReplaceAll(row.path, "/", "__"));
        arguments := Arguments(path);
        if (length(arguments) == 0) {
            return {problem: format_text("{}: no record", path), checked: checked};
        }
        if (os.Copy(format_text("{}.chibi-record", path), format_text("{}.chibi-record", destination)) != nil) {
            return {problem: format_text("cannot copy the record of {}", path), checked: checked};
        }
        problem := "";
        compiled := row.source != "";
        native := row.target != "";
        if (compiled) {
            at := Place(arguments, "-c");
            wanted := os.RealPath(format_text("{}/{}", root, row.source));
            if (at < 0 || at + 1 != length(arguments) - 1 || os.RealPath(arguments[at + 1]) != wanted) {
                return {problem: format_text("wrong representative source for {}", path), checked: checked};
            }
            problem = CheckFlags(arguments, sanitizers, row.test);
        } else if (native) {
            problem = CheckNative(arguments, root, build, row.target);
        } else {
            problem = CheckSanitizers(arguments, sanitizers);
        }
        if (problem != "") {
            return {problem: format_text("{}: {}", path, problem), checked: checked};
        }
        before := os.Stamp(path);
        digest := files.Digest(path);
        problem = ReadRecord(path);
        if (problem != "") {
            return {problem: problem, checked: checked};
        }
        listed := os.Capture([nm, "-g", path]);
        if (listed.status != 0 || digest == "") {
            return {problem: format_text("cannot read the symbols of {}", path), checked: checked};
        }
        lines: string[] = [];
        for (line in strings.SplitLines(listed.stdout)) {
            if (strings.Contains(line, "__asan_") || strings.Contains(line, "__ubsan_")) {
                lines.append(line);
            }
        }
        if (os.WriteText(format_text("{}.symbols.txt", destination), format_text("{}\n", strings.Join(lines, "\n"))) != nil) {
            return {problem: format_text("cannot write the symbols of {}", path), checked: checked};
        }
        problem = CheckSymbols(listed.stdout, sanitizers && !native, compiled);
        if (problem != "") {
            return {problem: format_text("{}: {}", path, problem), checked: checked};
        }
        if (os.Stamp(path) != before || (os.Platform() == "Windows" && files.Digest(path) != digest)) {
            return {problem: format_text("output changed during capture: {}", path), checked: checked};
        }
        names: string[] = [];
        for (name in Symbols(listed.stdout, compiled)) {
            names.append(Quote(name));
        }
        toolchain := "C";
        if (native) { toolchain = "native"; }
        checked.append(format_text("{{\"output\":{},\"toolchain\":{},\"sha256\":{},\"stamp\":{},\"symbols\":[{}]}}", Quote(path),
                                   Quote(toolchain), Quote(digest), Quote(before), strings.Join(names, ",")));
    }
    header := format_text("{}/test/tools/testing/include/export_compiler.h", build);
    if (os.Copy(header, format_text("{}/export_compiler.h", output)) != nil) {
        return {problem: "cannot copy the exported compiler header", checked: checked};
    }
    problem := CheckFlags(ExportedFlags(files.Text(header)), sanitizers, true);
    if (problem != "") {
        return {problem: format_text("exported compiler flags: {}", problem), checked: checked};
    }
    if (selected.outcome != "success") {
        return {problem: "selected build did not succeed; partial evidence only", checked: checked};
    }
    return {problem: "", checked: checked};
}

// Verifies the build in `build` and writes receipt.json below `output`; 0 when
// the profile is verified. Run right after the selected build, before tests
// re-enter the planner and change stamps.
pub Capture :: (root: string, build: string, output: string, nm: string, selected: Selected) -> int {
    if (os.MakeDirectory(output) != nil && !os.Exists(output)) {
        os.Print(format_text("evidence: cannot create {}", output));
        return 2;
    }
    verdict := Verify(root, build, output, nm, selected);
    problem := verdict.problem;
    checked := verdict.checked;
    environment := [format_text("\"sha\":{}", Quote(selected.sha)), format_text("\"run\":{}", Quote(selected.run)),
                    format_text("\"attempt\":{}", Quote(selected.attempt)), format_text("\"job\":{}", Quote(selected.job)),
                    format_text("\"sanitizers\":{}", Quote(selected.sanitizers)), format_text("\"profile\":{}", Quote(selected.profile)),
                    format_text("\"optimization\":{}", Quote(selected.optimization)),
                    format_text("\"frame_pointers\":{}", Quote(selected.frame_pointers)),
                    format_text("\"outcome\":{}", Quote(selected.outcome))];
    status := "verified";
    error := "";
    if (problem != "") {
        status = "incomplete";
        error = format_text(",\"error\":{}", Quote(problem));
    }
    receipt := format_text("{{\"environment\":{{{}}},\"status\":{},\"scope\":{},\"checked\":[{}]{}}}\n", strings.Join(environment, ","),
                           Quote(status), Quote("representative C objects, required C links and registered native programs; not every translation unit"),
                           strings.Join(checked, ","), error);
    if (os.WriteText(format_text("{}/receipt.json", output), receipt) != nil) {
        os.Print("evidence: cannot write receipt.json");
        return 2;
    }
    os.Print(receipt);
    if (problem != "") {
        return 1;
    }
    return 0;
}
