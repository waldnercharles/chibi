-        case PIN_I16: return INT16_MAX;
-        case PIN_U16: return UINT16_MAX;
-        case PIN_I32: return INT32_MAX;
-        case PIN_U32: return UINT32_MAX;
-        case PIN_I64: return INT64_MAX;
-        default: return UINT64_MAX;
-    }
