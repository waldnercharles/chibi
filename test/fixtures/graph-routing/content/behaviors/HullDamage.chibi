behavior "HullDamage" {
    on Damage {
        self.Health.Current -= event.Amount
        await "WeaponActions"."Spawn Prototype At"("HitEmitter", self.Transform)
        if cast<double>(self.Health.Current) <= 0 {
            await "WeaponActions"."Spawn Prototype At"("DeathEmitter", self.Transform)
            release_material(self)
        }
    }
}
