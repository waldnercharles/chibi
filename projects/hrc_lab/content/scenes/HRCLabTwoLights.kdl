version 1
name "HRCLabTwoLights"
(array)entities {
    - {
        name "Camera"
        prototype "HRCLabCamera"
        components {
            GameTransform x=0.0 y=0.0
        }
    }
    - {
        name "HRC"
        prototype "HRCLabHRC"
        components {
            GameTransform x=0.0 y=0.0
        }
    }
    - {
        name "Backdrop"
        prototype "HRCLabReceiver"
        components {
            GameTransform x=0.0 y=0.0
            GameAppearance width=960.0 height=540.0 shape="Box" layer=-100
            GameMaterial absorption=0.0 albedo=0xd0d0d0ff scene=0x6b6b6bff edge_light=0.0
        }
    }
    - {
        name "Warm light"
        prototype "HRCLabEmitter"
        components {
            GameTransform x=-180.0 y=0.0
            GameAppearance antialias=0.25 border_color=0x00000000 border_width=0.0 color=0xffffffff glow_color=0x00000000 glow_radius=0.0 height=72.0 layer=0 shape="Circle" stroke_width=0.0 width=72.0
            GameMaterial absorption=0.0 albedo=0xffffffff border_albedo=0x00000000 border_emission_color=0x00000000 border_filter=0x00000000 border_scene=0x00000000 edge_light=0.0 emission_color=0xffffa0ff emission_intensity=0.03 emission_multiplier=1.0 filter=0x00000000 scene=0xffffffff
        }
    }
    - {
        name "White light"
        prototype "HRCLabEmitter"
        components {
            GameTransform x=180.0 y=0.0
            GameAppearance antialias=0.25 border_color=0x00000000 border_width=0.0 color=0xffffffff glow_color=0x00000000 glow_radius=0.0 height=72.0 layer=0 shape="Circle" stroke_width=0.0 width=72.0
            GameMaterial absorption=0.0 albedo=0xffffffff border_albedo=0x00000000 border_emission_color=0x00000000 border_filter=0x00000000 border_scene=0x00000000 edge_light=0.0 emission_color=0xffffffff emission_intensity=0.03 emission_multiplier=1.0 filter=0x00000000 scene=0xffffffff
        }
    }
    - {
        name "Center occluder"
        prototype "HRCLabOccluder"
        components {
            GameTransform x=0.0 y=0.0
            GameAppearance antialias=0.25 border_color=0x00000000 border_width=0.0 color=0x893e46ff glow_color=0x00000000 glow_radius=0.0 height=104.0 layer=0 shape="Circle" stroke_width=0.0 width=104.0
            GameMaterial absorption=1.0 albedo=0x9cdce0ff border_albedo=0x00000000 border_emission_color=0x00000000 border_filter=0x00000000 border_scene=0x00000000 edge_light=0.0 emission_color=0x00000000 emission_intensity=0.0 emission_multiplier=1.0 filter=0x00000000 scene=0x111212ff
        }
    }
}
