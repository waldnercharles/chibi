#!/bin/sh
# Formats staged C sources with the clang-format version CI checks, then
# re-stages them. Vendored third_party sources are outside its scope.
root=$(git rev-parse --show-toplevel)
# Branches older than the shared script keep committing unformatted.
[ -f "$root/tools/clang-format.sh" ] || exit 0
exec sh "$root/tools/clang-format.sh" --staged
