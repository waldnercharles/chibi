package llvm_native

import strings "core:strings"

// One comparison session owns its buckets. Epochs reset membership between
// candidate elements without clearing the largest earlier candidate's table.
// A desktop bucket is 32 bytes: both borrowed addresses, shape, extent and
// epoch. Extent distinguishes valid descriptors sharing a backing prefix.
ValuePairsRuntime :: (guarded: bool = false) -> string {
    return strings.Join([
        "%chibi.value.pairs = type { ptr, i32, i32, i32 }\n",
        "%chibi.value.pair = type { ptr, ptr, i32, i32, i32 }\n",
        "\n",
        "define internal ptr @chibi_value_pairs.place(ptr %data, i32 %capacity, i32 %epoch, ptr %left, ptr %right, i32 %shape, i32 %extent) {\n",
        "entry:\n",
        "  %left.word = ptrtoint ptr %left to i64\n",
        "  %right.word = ptrtoint ptr %right to i64\n",
        "  %scaled.right = mul i64 %right.word, -49064778989728563\n",
        "  %shape.word = zext i32 %shape to i64\n",
        "  %pair = xor i64 %left.word, %scaled.right\n",
        "  %shape.upper = shl i64 %shape.word, 32\n",
        "  %extent.word = zext i32 %extent to i64\n",
        "  %typed = or i64 %shape.upper, %extent.word\n",
        "  %key = xor i64 %pair, %typed\n",
        "  %upper = lshr i64 %key, 33\n",
        "  %folded = xor i64 %key, %upper\n",
        "  %mixed = mul i64 %folded, -49064778989728563\n",
        "  %narrow = trunc i64 %mixed to i32\n",
        "  %mask = sub i32 %capacity, 1\n",
        "  %initial = and i32 %narrow, %mask\n",
        "  br label %probe\n",
        "probe:\n",
        "  %index = phi i32 [ %initial, %entry ], [ %next, %again ]\n",
        "  %at = getelementptr %chibi.value.pair, ptr %data, i32 %index\n",
        "  %epoch.at = getelementptr %chibi.value.pair, ptr %at, i32 0, i32 4\n",
        "  %stored.epoch = load i32, ptr %epoch.at\n",
        "  %occupied = icmp eq i32 %stored.epoch, %epoch\n",
        "  br i1 %occupied, label %check, label %done\n",
        "check:\n",
        "  %stored.left = load ptr, ptr %at\n",
        "  %right.at = getelementptr %chibi.value.pair, ptr %at, i32 0, i32 1\n",
        "  %shape.at = getelementptr %chibi.value.pair, ptr %at, i32 0, i32 2\n",
        "  %stored.right = load ptr, ptr %right.at\n",
        "  %stored.shape = load i32, ptr %shape.at\n",
        "  %extent.at = getelementptr %chibi.value.pair, ptr %at, i32 0, i32 3\n",
        "  %stored.extent = load i32, ptr %extent.at\n",
        "  %same.left = icmp eq ptr %left, %stored.left\n",
        "  %same.right = icmp eq ptr %right, %stored.right\n",
        "  %same.shape = icmp eq i32 %shape, %stored.shape\n",
        "  %same.extent = icmp eq i32 %extent, %stored.extent\n",
        "  %same.pair = and i1 %same.left, %same.right\n",
        "  %same.type = and i1 %same.pair, %same.shape\n",
        "  %same = and i1 %same.type, %same.extent\n",
        "  br i1 %same, label %done, label %again\n",
        "again:\n",
        "  %increment = add i32 %index, 1\n",
        "  %next = and i32 %increment, %mask\n",
        "  br label %probe\n",
        "done:\n",
        "  ret ptr %at\n",
        "}\n",
        "\n",
        "define internal void @chibi_value_pairs.grow(ptr %ctx, ptr %pairs) {\n",
        "entry:\n",
        "  %capacity.at = getelementptr %chibi.value.pairs, ptr %pairs, i32 0, i32 2\n",
        "  %epoch.at = getelementptr %chibi.value.pairs, ptr %pairs, i32 0, i32 3\n",
        "  %old.capacity = load i32, ptr %capacity.at\n",
        "  %epoch = load i32, ptr %epoch.at\n",
        "  %bounded = icmp ult i32 %old.capacity, 1073741824\n",
        "  br i1 %bounded, label %size, label %oom\n",
        "size:\n",
        "  %first = icmp eq i32 %old.capacity, 0\n",
        "  %doubled = shl i32 %old.capacity, 1\n",
        "  %capacity = select i1 %first, i32 16, i32 %doubled\n",
        "  %end = getelementptr %chibi.value.pair, ptr null, i32 %capacity\n",
        "  %bytes = ptrtoint ptr %end to i64\n",
        Allocated("data", "%bytes", guarded),
        "  call void @chibi_scalar.zero(ptr %data, i64 %bytes)\n",
        "  %previous = load ptr, ptr %pairs\n",
        "  br label %head\n",
        "head:\n",
        "  %index = phi i32 [ 0, %size ], [ %next, %step ]\n",
        "  %done = icmp eq i32 %index, %old.capacity\n",
        "  br i1 %done, label %release, label %read\n",
        "read:\n",
        "  %old = getelementptr %chibi.value.pair, ptr %previous, i32 %index\n",
        "  %old.epoch.at = getelementptr %chibi.value.pair, ptr %old, i32 0, i32 4\n",
        "  %old.epoch = load i32, ptr %old.epoch.at\n",
        "  %current = icmp eq i32 %old.epoch, %epoch\n",
        "  br i1 %current, label %copy, label %step\n",
        "copy:\n",
        "  %value = load %chibi.value.pair, ptr %old\n",
        "  %left = extractvalue %chibi.value.pair %value, 0\n",
        "  %right = extractvalue %chibi.value.pair %value, 1\n",
        "  %shape = extractvalue %chibi.value.pair %value, 2\n",
        "  %extent = extractvalue %chibi.value.pair %value, 3\n",
        "  %at = call ptr @chibi_value_pairs.place(ptr %data, i32 %capacity, i32 %epoch, ptr %left, ptr %right, i32 %shape, i32 %extent)\n",
        "  store %chibi.value.pair %value, ptr %at\n",
        "  br label %step\n",
        "step:\n",
        "  %next = add i32 %index, 1\n",
        "  br label %head\n",
        "release:\n",
        "  %has.previous = icmp ne ptr %previous, null\n",
        "  br i1 %has.previous, label %free, label %publish\n",
        "free:\n",
        ContextCall("give", 4, guarded),
        "  call void %give(ptr %ctx, ptr %previous)\n",
        "  br label %publish\n",
        "publish:\n",
        "  store ptr %data, ptr %pairs\n",
        "  store i32 %capacity, ptr %capacity.at\n",
        "  ret void\n",
        "oom:\n",
        "  call void @llvm.trap()\n",
        "  unreachable\n",
        "}\n",
        "\n",
        "define internal i1 @chibi_value_pairs.seen(ptr %ctx, ptr %pairs, ptr %left, ptr %right, i32 %shape, i32 %extent) {\n",
        "entry:\n",
        "  %used.at = getelementptr %chibi.value.pairs, ptr %pairs, i32 0, i32 1\n",
        "  %capacity.at = getelementptr %chibi.value.pairs, ptr %pairs, i32 0, i32 2\n",
        "  %epoch.at = getelementptr %chibi.value.pairs, ptr %pairs, i32 0, i32 3\n",
        "  %capacity = load i32, ptr %capacity.at\n",
        "  %epoch = load i32, ptr %epoch.at\n",
        "  %empty = icmp eq i32 %capacity, 0\n",
        "  br i1 %empty, label %room, label %find\n",
        "find:\n",
        "  %previous = load ptr, ptr %pairs\n",
        "  %known = call ptr @chibi_value_pairs.place(ptr %previous, i32 %capacity, i32 %epoch, ptr %left, ptr %right, i32 %shape, i32 %extent)\n",
        "  %known.epoch.at = getelementptr %chibi.value.pair, ptr %known, i32 0, i32 4\n",
        "  %known.epoch = load i32, ptr %known.epoch.at\n",
        "  %present = icmp eq i32 %known.epoch, %epoch\n",
        "  br i1 %present, label %found, label %room\n",
        "found:\n",
        "  ret i1 true\n",
        "room:\n",
        "  %used = load i32, ptr %used.at\n",
        "  %half = lshr i32 %capacity, 1\n",
        "  %full = icmp uge i32 %used, %half\n",
        "  br i1 %full, label %grow, label %insert\n",
        "grow:\n",
        "  call void @chibi_value_pairs.grow(ptr %ctx, ptr %pairs)\n",
        "  br label %insert\n",
        "insert:\n",
        "  %data = load ptr, ptr %pairs\n",
        "  %available = load i32, ptr %capacity.at\n",
        "  %at = call ptr @chibi_value_pairs.place(ptr %data, i32 %available, i32 %epoch, ptr %left, ptr %right, i32 %shape, i32 %extent)\n",
        "  %from = insertvalue %chibi.value.pair zeroinitializer, ptr %left, 0\n",
        "  %to = insertvalue %chibi.value.pair %from, ptr %right, 1\n",
        "  %typed = insertvalue %chibi.value.pair %to, i32 %shape, 2\n",
        "  %sized = insertvalue %chibi.value.pair %typed, i32 %extent, 3\n",
        "  %pair = insertvalue %chibi.value.pair %sized, i32 %epoch, 4\n",
        "  store %chibi.value.pair %pair, ptr %at\n",
        "  %next = add i32 %used, 1\n",
        "  store i32 %next, ptr %used.at\n",
        "  ret i1 false\n",
        "}\n",
        "\n",
        "define internal void @chibi_value_pairs.reset(ptr %pairs) {\n",
        "entry:\n",
        "  %used.at = getelementptr %chibi.value.pairs, ptr %pairs, i32 0, i32 1\n",
        "  %capacity.at = getelementptr %chibi.value.pairs, ptr %pairs, i32 0, i32 2\n",
        "  %epoch.at = getelementptr %chibi.value.pairs, ptr %pairs, i32 0, i32 3\n",
        "  %epoch = load i32, ptr %epoch.at\n",
        "  %next = add i32 %epoch, 1\n",
        "  %wrapped = icmp eq i32 %next, 0\n",
        "  br i1 %wrapped, label %clear, label %publish\n",
        "clear:\n",
        "  %data = load ptr, ptr %pairs\n",
        "  %capacity = load i32, ptr %capacity.at\n",
        "  %end = getelementptr %chibi.value.pair, ptr null, i32 %capacity\n",
        "  %bytes = ptrtoint ptr %end to i64\n",
        "  call void @chibi_scalar.zero(ptr %data, i64 %bytes)\n",
        "  br label %publish\n",
        "publish:\n",
        "  %current = phi i32 [ %next, %entry ], [ 1, %clear ]\n",
        "  store i32 0, ptr %used.at\n",
        "  store i32 %current, ptr %epoch.at\n",
        "  ret void\n",
        "}\n",
        "\n",
        "define internal void @chibi_value_pairs.release(ptr %ctx, ptr %pairs) {\n",
        "entry:\n",
        "  %data = load ptr, ptr %pairs\n",
        "  %present = icmp ne ptr %data, null\n",
        "  br i1 %present, label %free, label %done\n",
        "free:\n",
        ContextCall("give", 4, guarded),
        "  call void %give(ptr %ctx, ptr %data)\n",
        "  br label %done\n",
        "done:\n",
        "  store %chibi.value.pairs zeroinitializer, ptr %pairs\n",
        "  ret void\n",
        "}\n"
    ], "");
}
