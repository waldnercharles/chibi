version 1
name "Shapes"
presentation "3d"
(array)entities {
    - name="Environment" prototype="Environment"
    - name="Sun" prototype="Sun"
    - {
        name "Box"
        prototype "Solid"
        components {
            GAME.GameTransform x=200.0 y=-180.0
            GAME.GameGeometry3D primitive=0 width=100.0 depth=100.0 height=100.0 elevation=50.0
            GAME.GameMaterial scene=0xd04030ff
        }
    }
    - {
        name "Sphere"
        prototype "Solid"
        components {
            GAME.GameTransform x=440.0 y=-180.0
            GAME.GameGeometry3D primitive=1 width=110.0 depth=110.0 height=110.0 elevation=55.0
            GAME.GameMaterial scene=0x40a0e0ff
        }
    }
    - {
        name "Lamp"
        prototype "Solid"
        components {
            GAME.GameTransform x=320.0 y=-90.0
            GAME.GameGeometry3D primitive=1 width=16.0 depth=16.0 height=16.0 elevation=90.0
            GAME.GameMaterial scene=0xffe0b0ff emission_color=0xffc080ff emission_intensity=4.0 emission_multiplier=1.0
            GAME.GamePointLight color=0xffc080ff intensity=6.0 radius=420.0 elevation=90.0 shadows=#true
        }
    }
    - {
        name "Floor"
        prototype "Solid"
        components {
            GAME.GameTransform x=320.0 y=-180.0
            GAME.GameGeometry3D primitive=0 width=600.0 depth=400.0 height=4.0 elevation=-2.0
            GAME.GameMaterial scene=0x808080ff
        }
    }
}
