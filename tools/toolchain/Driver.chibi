package driver

import os "core:os"
import strings "core:strings"

// The engine's one build command, `chibi build` in an engine checkout. It
// runs under the private build host: `chibi-build-host --source
// tools/toolchain/Driver.chibi --entry Main -- build [VERB] [OPTIONS]`
// (tools/build.sh before a chibi exists).
//
//   build [--release|--debug|--profile NAME] [--build DIR] [--release-build DIR]
//         [--target NAME]... [--jobs N (default: every processor)]
//         [--host PATH] [--libclang-root DIR] [--reflect PATH]
//         [--asset-generator-hosts DIR] [--debug-optimization 0|1]
//         [--debug-frame-pointers on|off] [--dry-run]
//
// A sanitized build in `build` is the default; --release builds `build-release`
// and --debug `build-debug`. Without --target it builds every product and test
// driver, as `zig build` runs its install step; --target names a subset (and
// the build host the graph needs). --dry-run prints the
// commands instead of running them. The other verbs are `test`, `install`,
// `format`, `clean`, `census`, `sdk-reflect`, `runtime-sdk`, `package-runtime-sdk`,
// `bootstrap-artifact`, `bootstrap-recover`,
// `publish-seed`, `native-census` and `native-self-host`; Usage lists them.

Join :: (parts: string[]) -> string {
    return strings.Join(parts, "")
}

Flag :: (arguments: string[], name: string) -> bool {
    for (argument in arguments) {
        if (argument == name) {
            return true
        }
    }
    return false
}

Option :: (arguments: string[], name: string, fallback: string) -> string {
    for (i in 0..<length(arguments) - 1) {
        if (arguments[i] == name) {
            return arguments[i + 1]
        }
    }
    return fallback
}

Values :: (arguments: string[], name: string) -> string[] {
    values: string[] = []
    for (i in 0..<length(arguments) - 1) {
        if (arguments[i] == name) {
            values = extend(values, [arguments[i + 1]])
        }
    }
    return values
}

Absolute :: (path: string) -> string {
    if (strings.HasPrefix(path, "/")) {
        return path
    }
    return Join([os.Root(), "/", path])
}

// Prints or runs one step and reports a failure under its name.
Step :: (name: string, command: string[], dry: bool) -> int {
    if (dry) {
        os.Print(Join([name, ": ", strings.Join(command, " ")]))
        return 0
    }
    status := os.Run(command)
    if (status != 0) {
        os.Print(format_text("{}: failed with status {}", name, status))
    }
    return status
}

Profile :: (arguments: string[]) -> string {
    named := Option(arguments, "--profile", "")
    if (named != "") {
        return named
    }
    if (Flag(arguments, "--release")) {
        return "release"
    }
    if (Flag(arguments, "--debug")) {
        return "debug"
    }
    return "sanitizer"
}

DefaultDirectory :: (profile: string) -> string {
    if (profile == "release") {
        return "build-release"
    }
    if (profile == "debug") {
        return "build-debug"
    }
    return "build"
}

HostUsable :: (host: string) -> bool {
    if (!os.Exists(host)) {
        return false
    }
    probe := os.Capture([host, "--protocol-version"])
    return probe.status == 0 && strings.TrimSpace(probe.stdout) == "15"
}

// The command that runs an authored program under the private host.
Program :: (host: string, source: string, function: string, collections: string[], timeout: string) -> string[] {
    command := [
        host, "--compiler", "tools/compiler", "--compiler-core", "packages/core", "--root", os.Root(),
        "--source", source, "--core", "packages/core"
    ]
    for (collection in collections) {
        command = extend(command, ["--collection", collection])
    }
    return extend(command, ["--entry", function, "--timeout-ms", timeout, "--"])
}

// The --jobs a build runs its steps with: the option, else every processor
// online, so compiles use the whole machine by default. 8 when getconf can't say.
Jobs :: (arguments: string[]) -> string {
    jobs := Option(arguments, "--jobs", "")
    if (jobs != "") {
        return jobs
    }
    online := os.Capture(["getconf", "_NPROCESSORS_ONLN"])
    count := strings.TrimSpace(online.stdout)
    if (online.status != 0 || Count(count) < 1) {
        return "8"
    }
    return count
}

// Builds a profile, first the Release hosts a non-Release graph borrows to
// generate the asset compiler, which a Debug host cannot do from a cold tree
// within its deadline.
Build :: (arguments: string[]) -> int {
    dry := Flag(arguments, "--dry-run")
    profile := Profile(arguments)
    directory := Option(arguments, "--build", DefaultDirectory(profile))
    jobs := Jobs(arguments)
    releases := Option(arguments, "--release-build", "build-release")
    host := Absolute(Option(arguments, "--host", Join([directory, "/sdk/chibi-build-host"])))
    if (!HostUsable(host)) {
        // A cold tree fetches the pinned first build host (tools/bootstrap/hosts.tsv).
        status := Step("bootstrap", ["sh", "tools/bootstrap.sh", host], dry)
        if (status != 0) {
            return status
        }
    }
    generators := Option(arguments, "--asset-generator-hosts", "")
    if (generators == "" && profile != "release") {
        nested := [
            "--release", "--build", releases, "--host", host, "--jobs", jobs, "--target", "chibi-build-host",
            "--target", "chibi-compiler-host"
        ]
        if (dry) {
            nested = extend(nested, ["--dry-run"])
        }
        status := Build(nested)
        if (status != 0) {
            return status
        }
        generators = Absolute(Join([releases, "/sdk"]))
    }
    timeout := Option(arguments, "--timeout-ms", "3600000")
    status := Step(
        "third-party",
        extend(Program(host, "tools/toolchain/Build.chibi", "Build", [], "1800000"), ["third-party", directory]),
        dry
    )
    if (status != 0) {
        return status
    }
    graph := ["--build", Absolute(directory), "--profile", profile]
    for (name in ["--libclang-root", "--reflect"]) {
        value := Option(arguments, name, "")
        if (value != "") {
            graph = extend(graph, [name, Absolute(value)])
        }
    }
    for (name in ["--debug-optimization", "--debug-frame-pointers"]) {
        value := Option(arguments, name, "")
        if (value != "" && profile == "debug") {
            graph = extend(graph, [name, value])
        }
    }
    graph = extend(graph, ["--jobs", jobs])
    if (generators != "") {
        graph = extend(graph, ["--asset-generator-hosts", Absolute(generators)])
    }
    graph = extend(graph, ["--all-commands", "on"])
    // Without --target everything builds, as `zig build` runs its install step.
    targets := Values(arguments, "--target")
    if (length(targets) > 0) {
        targets = extend(targets, ["chibi-build-host"])
    }
    for (target in targets) {
        graph = extend(graph, ["--target", target])
    }
    command := extend(
        ["env", Join(["CCACHE_BASEDIR=", os.Root()])],
        extend(Program(host, "tools/toolchain/Graph.chibi", "Libraries", ["graph=tools/graph"], timeout), graph)
    )
    status = Step("graph", command, dry)
    if (status != 0) {
        return status
    }
    return Step("compile-commands", ["ln", "-sfn", Join([Absolute(directory), "/compile_commands.json"]), "compile_commands.json"], dry)
}

// A tab separated row split into fields; empty fields are kept.
Fields :: (row: string) -> string[] {
    fields: string[] = []
    rest := row
    while (true) {
        head := strings.Partition(rest, "\t").head
        fields = extend(fields, [head])
        if (head == rest) {
            return fields
        }
        rest = strings.Partition(rest, "\t").tail
    }
    return fields
}

// The selector table's rows: `tool NAME COMMAND...` and `group NAME MEMBER...`.
Rows :: () -> string[] {
    rows: string[] = []
    table := os.ReadText("tools/tests.tsv")
    if (table.error) {
        os.Print("test: cannot read tools/tests.tsv")
        return rows
    }
    for (line in strings.Lines(table.text)) {
        if (line != "" && !strings.HasPrefix(line, "#")) {
            rows = extend(rows, [line])
        }
    }
    return rows
}

Row :: (rows: string[], kind: string, name: string) -> string {
    prefix := Join([kind, "\t", name])
    for (row in rows) {
        if (row == prefix || strings.HasPrefix(row, Join([prefix, "\t"]))) {
            return row
        }
    }
    return ""
}

// The tool selectors a command line names, groups expanded, or [] and a
// report when one is unknown.
Selection :: (rows: string[], requested: string[]) -> string[] {
    selected: string[] = []
    for (name in requested) {
        group := Row(rows, "group", name)
        if (group != "") {
            members := Fields(group)
            for (i in 2..<length(members)) {
                selected = extend(selected, [members[i]])
            }
        } else if (Row(rows, "tool", name) != "") {
            selected = extend(selected, [name])
        } else {
            os.Print(format_text("test: unknown selector '{}'; use --list", name))
            none: string[] = []
            return none
        }
    }
    return selected
}

// The arguments after `build test` that are neither options nor option values.
Positionals :: (arguments: string[]) -> string[] {
    names: string[] = []
    skip := false
    for (i in 2..<length(arguments)) {
        argument := arguments[i]
        if (skip) {
            skip = false
        } else if (argument == "--build" || argument == "--release-build" || argument == "--jobs" ||
            argument == "--build-host" || argument == "--timeout") {
            skip = true
        } else if (!strings.HasPrefix(argument, "--")) {
            names = extend(names, [argument])
        }
    }
    return names
}

Count :: (text: string) -> int {
    value := 0
    for (byte in strings.Bytes(text)) {
        if (byte < 48 || byte > 57 || value > 10000) {
            return -1
        }
        value = value * 10 + byte - 48
    }
    return value
}

// The deadline of one selector: its `timeout NAME SECONDS` row, else `fallback`.
Deadline :: (rows: string[], name: string, fallback: string) -> string {
    row := Row(rows, "timeout", name)
    if (row == "") {
        return fallback
    }
    return Fields(row)[2]
}

// The command one selector runs: its row's words with the build directories
// filled in, under the environment the test drivers read.
TestCommand :: (row: string, directory: string, releases: string, host: string) -> string[] {
    fields := Fields(row)
    command := [
        "env",
        Join(["CHIBI_TOOLS_BUILD_DIR=", Absolute(directory), "/test/tools"]),
        Join(["CHIBI_LANGUAGE_BUILD_DIR=", Absolute(directory), "/test/language"]),
        Join(["CHIBI_BUILD_HOST=", Absolute(host)]),
        Join(["CHIBI_CLI=", Absolute(releases), "/sdk/chibi"]),
        Join(["CHIBI_COMPILE=", Absolute(releases), "/sdk/chibi-compile"]),
        Join(["CHIBI_RELEASE_COMPILER_HOST=", Absolute(releases), "/sdk/chibi-compiler-host"]),
        Join(["CHIBI_RELEASE_LANGUAGE_BUILD_DIR=", Absolute(releases), "/test/language"])
    ]
    for (i in 2..<length(fields)) {
        word := strings.ReplaceAll(strings.ReplaceAll(fields[i], "@host@", Absolute(host)), "@root@", os.Root())
        word = strings.ReplaceAll(strings.ReplaceAll(word, "@build@", Absolute(directory)), "@release@", Absolute(releases))
        command = extend(command, [word])
    }
    return command
}

// A selector `build test` has started and not yet reported.
Running :: struct {
    index: int; // into the selection
    process: int;
    // Milliseconds spent waiting while it ran: a lower bound on its age.
    waited: int;
}

// How long `build test` waits on its oldest selector before polling the rest.
TestSlice: int : 250

// Whether tools/tests.tsv has an `exclusive NAME` row: the selector runs alone,
// because it starts its own workers or shares files with others.
Exclusive :: (rows: string[], name: string) -> bool {
    return Row(rows, "exclusive", name) != ""
}

// Runs the named selectors or groups of tools/tests.tsv against the built test
// drivers, up to --jobs at a time (an `exclusive` row runs one alone), and fails
// when any fails.
//   build test [--build DIR] [--release-build DIR] [--build-host PATH] [--jobs N] [--timeout SECONDS] [--list] [--dry-run] NAME...
// Each selector gets --timeout seconds (600 by default; a `timeout NAME SECONDS` row of tools/tests.tsv sets one selector's); a hung one is killed
// and reported as timed out, and the rest still run.
Test :: (arguments: string[]) -> int {
    rows := Rows()
    if (Flag(arguments, "--list")) {
        for (row in rows) {
            fields := Fields(row)
            os.Print(Join([fields[0], " ", fields[1]]))
        }
        return 0
    }
    directory := Option(arguments, "--build", "build")
    releases := Option(arguments, "--release-build", "build-release")
    host := Option(arguments, "--build-host", Join([directory, "/sdk/chibi-build-host"]))
    jobs := Count(Option(arguments, "--jobs", "1"))
    seconds := Option(arguments, "--timeout", "600")
    if (Count(seconds) < 1) {
        os.Print("test: --timeout takes a whole number of seconds")
        return 2
    }
    requested := Positionals(arguments)
    if (jobs < 1 || length(requested) == 0) {
        os.Print("usage: build test [--build DIR] [--release-build DIR] [--jobs N] [--list] [--dry-run] NAME...")
        return 2
    }
    selected := Selection(rows, requested)
    if (length(selected) == 0) {
        return 2
    }
    if (Flag(arguments, "--dry-run")) {
        for (name in selected) {
            command := TestCommand(Row(rows, "tool", name), directory, releases, host)
            os.Print(format_text("{} ({}s): {}", name, Deadline(rows, name, seconds), strings.Join(command, " ")))
        }
        return 0
    }
    // Piped output keeps each selector's lines together when several run.
    stdio := os.Inherited
    if (jobs > 1) {
        stdio = os.Piped
    }
    running: Running[] = []
    next := 0
    failed := 0
    while (next < length(selected) || length(running) > 0) {
        while (next < length(selected) && length(running) < jobs &&
               (length(running) == 0 || (!Exclusive(rows, selected[next]) && !Exclusive(rows, selected[running[0].index])))) {
            os.Print(format_text("RUN {}", selected[next]))
            command := TestCommand(Row(rows, "tool", selected[next]), directory, releases, host)
            started: Running = {index: next, process: os.Start(command, stdio), waited: 0}
            running.append(started)
            next += 1
        }
        // Wait a slice for the oldest, then poll the rest, so a short selector
        // frees its slot while a long one runs. Only a slice that passes in
        // full counts toward the running deadlines, so none stops early.
        status := os.Wait(running[0].process, TestSlice)
        passed := 0
        if (status == os.StillRunning) {
            passed = TestSlice
        }
        left: Running[] = []
        for (i in 0..<length(running)) {
            job := running[i]
            if (i > 0) {
                status = os.Wait(job.process, 0)
            }
            job.waited += passed
            name := selected[job.index]
            limit := Count(Deadline(rows, name, seconds))
            if (status == os.StillRunning && job.waited >= limit * 1000) {
                os.Kill(job.process)
                os.Print(format_text("FAIL {} (timed out after {}s)", name, limit))
                failed += 1
            } else if (status == os.StillRunning) {
                left.append(job)
            } else if (status == 0) {
                os.Print(format_text("PASS {}", name))
            } else {
                os.Print(format_text("FAIL {} (status {})", name, status))
                failed += 1
            }
        }
        running = left
    }
    os.Print(format_text("{} tests, {} failed", length(selected), failed))
    if (failed > 0) {
        return 1
    }
    return 0
}

// The arguments after a bare `--`, which a verb passes on to the program it runs.
Rest :: (arguments: string[]) -> string[] {
    rest: string[] = []
    seen := false
    for (argument in arguments) {
        if (seen) {
            rest = extend(rest, [argument])
        } else if (argument == "--") {
            seen = true
        }
    }
    return rest
}

// The `--libclang-root DIR` a graph program takes, made absolute, or nothing.
Libclang :: (arguments: string[]) -> string[] {
    root := Option(arguments, "--libclang-root", "")
    none: string[] = []
    if (root == "") {
        return none
    }
    return ["--libclang-root", Absolute(root)]
}

// The private host that runs the authored SDK programs: --host when it speaks
// the current protocol, else the pinned first host fetched beside the
// reflection build. "" after a failed fetch.
PrivateHost :: (arguments: string[], dry: bool) -> string {
    host := Absolute(Option(arguments, "--host", "build/sdk/chibi-build-host"))
    if (HostUsable(host)) {
        return host
    }
    fetched := Absolute(Join([Option(arguments, "--reflect-build", "build-sdk-reflect"), "/host/bin/chibi-build-host"]))
    if (!HostUsable(fetched) && Step("bootstrap", ["sh", "tools/bootstrap.sh", fetched], dry) != 0) {
        return ""
    }
    return fetched
}

// Runs an authored graph program under the private host, with CCACHE_BASEDIR set
// to the checkout so worktrees share compiler-cache objects.
GraphStep :: (name: string, host: string, source: string, function: string, tail: string[], dry: bool) -> int {
    command := extend(
        ["env", Join(["CCACHE_BASEDIR=", os.Root()])],
        extend(Program(host, source, function, ["graph=tools/graph"], "3600000"), tail)
    )
    return Step(name, command, dry)
}

// The Release hosts and tools an install or a release-only verb needs.
ReleaseBuild :: (arguments: string[], targets: string[], dry: bool) -> int {
    nested := ["--release", "--release-build", Option(arguments, "--release-build", "build-release"),
               "--jobs", Jobs(arguments)]
    for (name in ["--host", "--libclang-root", "--reflect"]) {
        value := Option(arguments, name, "")
        if (value != "") {
            nested = extend(nested, [name, value])
        }
    }
    for (target in targets) {
        nested = extend(nested, ["--target", target])
    }
    if (dry) {
        nested = extend(nested, ["--dry-run"])
    }
    return Build(nested)
}

// Installs the Release products into --prefix (default ~/.local):
// bin/chibi, bin/chibi-compile, the private hosts in libexec/chibi and share/chibi.
Install :: (arguments: string[]) -> int {
    dry := Flag(arguments, "--dry-run")
    releases := Absolute(Option(arguments, "--release-build", "build-release"))
    status := ReleaseBuild(arguments, ["chibi", "chibi-compile", "chibi-build-host", "chibi-compiler-host"], dry)
    if (status != 0) {
        return status
    }
    prefix := Absolute(Option(arguments, "--prefix", Join([os.Getenv("HOME"), "/.local"])))
    return GraphStep(
        "install", Join([releases, "/sdk/chibi-build-host"]), "tools/toolchain/SDK.chibi", "Install",
        ["--build", releases, "--prefix", prefix], dry
    )
}

// The reflection tool the SDK builds against, built by the authored graph.
// Arguments after `--` go to the native toolchain (CMake compiler flags).
SdkReflect :: (arguments: string[]) -> int {
    dry := Flag(arguments, "--dry-run")
    host := PrivateHost(arguments, dry)
    if (host == "") {
        return 1
    }
    tail := ["--build", Absolute(Option(arguments, "--reflect-build", "build-sdk-reflect")), "--jobs", Jobs(arguments)]
    tail = extend(tail, Libclang(arguments))
    return GraphStep("sdk-reflect", host, "tools/toolchain/Graph.chibi", "SDKReflect", extend(tail, extend(["--"], Rest(arguments))), dry)
}

// The macOS runtime SDK, constructed by the authored graph from the reflection
// tool, and with --package installed under --output.
RuntimeSdk :: (arguments: string[], package: bool) -> int {
    dry := Flag(arguments, "--dry-run")
    status := SdkReflect(arguments)
    if (status != 0) {
        return status
    }
    host := PrivateHost(arguments, dry)
    constructed := Absolute(Option(arguments, "--runtime-build", "build-runtime-sdk"))
    status = Step(
        "third-party", extend(Program(host, "tools/toolchain/Build.chibi", "Build", [], "1800000"), ["third-party", constructed]), dry
    )
    if (status != 0) {
        return status
    }
    tail := [
        "--build", constructed, "--reflect",
        Join([Absolute(Option(arguments, "--reflect-build", "build-sdk-reflect")), "/reflect"]), "--jobs",
        Jobs(arguments)
    ]
    tail = extend(tail, Libclang(arguments))
    flags := Rest(arguments)
    if (length(flags) == 0) {
        flags = ["-DCMAKE_BUILD_TYPE=Debug", "-DCHIBI_ENABLE_SANITIZERS=OFF"]
    }
    status = GraphStep("runtime-sdk", host, "tools/toolchain/Graph.chibi", "RuntimeSDK", extend(tail, extend(["--"], flags)), dry)
    if (status != 0 || !package) {
        return status
    }
    output := Absolute(Option(arguments, "--output", "dist/runtime-sdk"))
    return GraphStep(
        "package-runtime-sdk", host, "tools/toolchain/RuntimeSDK.chibi", "RuntimePackage", ["--build", constructed, "--output", output], dry
    )
}

// The Release compiler host, which writes and recovers the bootstrap artifact.
CompilerHost :: (arguments: string[]) -> string {
    return Join([Absolute(Option(arguments, "--release-build", "build-release")), "/sdk/chibi-compiler-host"])
}

Revision :: () -> string {
    described := os.Capture(["git", "describe", "--always", "--dirty", "--abbrev=40"])
    return strings.TrimSpace(described.stdout)
}

// Rewrites tools/compiler/bootstrap: recovery compiles the sources on disk
// with the current seed to stage one and stage two, the fixed point, and
// leaves it with its Compile arguments in a seed folder; the host writes the
// artifact once that seed compiles the sources to itself. `recover` only
// checks that recovery succeeds.
Bootstrap :: (arguments: string[], mode: string) -> int {
    dry := Flag(arguments, "--dry-run")
    releases := Option(arguments, "--release-build", "build-release")
    host := CompilerHost(arguments)
    artifact := Option(arguments, "--artifact", "tools/compiler/bootstrap")
    base := ["--bootstrap", artifact, "--compiler", "tools/compiler", "--core", "packages/core"]
    status := ReleaseBuild(arguments, ["chibi-compiler-host"], dry)
    if (status != 0) {
        return status
    }
    if (mode == "recover") {
        return Step("recover", extend([host], base), dry)
    }
    seed := Absolute(Join([releases, "/bootstrap.", mode]))
    status = Step("seed-folder", ["sh", "-c", Join(["rm -rf '", seed, "' && mkdir -p '", seed, "'"])], dry)
    if (status != 0) {
        return status
    }
    status = Step(
        "recover",
        extend(extend([host], base), ["--recover", Join([seed, "/compiler.chibip"]), "--arguments", Join([seed, "/compile.json"])]),
        dry
    )
    if (status != 0) {
        return status
    }
    status = Step(
        "write-artifact", extend(extend([host], base), ["--seed", seed, "--revision", Revision()]), dry
    )
    if (status != 0) {
        return status
    }
    return Step("seed-folder", ["rm", "-rf", seed], dry)
}

// Rewrites docs/native-compiler-census.md: the first native blocker of each
// self-hosted compiler function.
NativeCensus :: (arguments: string[]) -> int {
    dry := Flag(arguments, "--dry-run")
    directory := Option(arguments, "--build", "build")
    options := ["--target", "test_language", "--build", directory]
    if (dry) {
        options = extend(options, ["--dry-run"])
    }
    status := Build(options)
    if (status != 0) {
        return status
    }
    return Step(
        "native-census",
        [Join([Absolute(directory), "/test/language/test_language"]), "--native-census", "docs/native-compiler-census.md"],
        dry
    )
}

// Whole seconds from date(1); the build host has no clock.
Clock :: () -> int {
    seconds := 0
    for (byte in strings.Bytes(strings.TrimSpace(os.Capture(["date", "+%s"]).stdout))) {
        seconds = seconds * 10 + byte - 48
    }
    return seconds
}

// The first function the committed census says the native lane rejects, or "".
FirstRejection :: () -> string {
    census := os.ReadText("docs/native-compiler-census.md")
    if (census.error) {
        return ""
    }
    for (line in strings.Lines(census.text)) {
        if (!strings.HasPrefix(line, "| `")) {
            continue
        }
        // | Source | Function | Package | Through | Also | Rejected | Message |
        cells := strings.Split(line, "|")
        if (length(cells) == 9 && strings.TrimSpace(cells[3]) != "none") {
            return format_text("{} in {}: {}", strings.TrimSpace(cells[2]), strings.TrimSpace(cells[1]), strings.TrimSpace(cells[7]))
        }
    }
    return ""
}

// The program the native build driver's last `native: PATH` report names, or "".
NativeProgram :: (report: string) -> string {
    program := ""
    for (line in strings.Lines(report)) {
        if (strings.HasPrefix(line, "native: /")) {
            program = strings.TrimSuffix(strings.TrimPrefix(line, "native: "), " is up to date")
        }
    }
    return program
}

// The file's SHA-256, or "" when it cannot be read.
Digest :: (path: string) -> string {
    hashed := os.HashFile(path)
    if (hashed.error) {
        return ""
    }
    return hashed.digest
}

// Runs one stage compiler in a clean directory and prints its wall time.
// The stage contract (docs/native-llvm-ledger.md, W22): `STAGE --compiler DIR
// --core DIR --output FILE --llvm DIR` writes a native executable with the same
// interface; exit 1 means the native lane rejected the sources, and the first
// stderr line then names the first rejected function.
NativeStage :: (name: string, stage: string, directory: string, llvm: string, dry: bool) -> int {
    status := Step(name, ["sh", "-c", Join(["rm -rf '", directory, "' && mkdir -p '", directory, "'"])], dry)
    if (status != 0) {
        return status
    }
    command := [stage, "--compiler", Absolute("tools/compiler"), "--core", Absolute("packages/core"), "--output", Join([directory, "/chibi"]), "--llvm", llvm]
    began := Clock()
    if (dry) {
        return Step(name, command, dry)
    }
    ran := os.Capture(command)
    os.Print(format_text("{}: {} s, exit {}", name, Clock() - began, ran.status))
    if (ran.status != 0) {
        os.Print(Join([name, " rejected: ", strings.TrimSpace(ran.stderr)]))
    }
    return ran.status
}

// Proves goal item 1: the native stage one compiles tools/compiler to stage
// two, stage two compiles it to stage three, and the two are byte-identical.
// Prints each stage's wall time and, for item 9, the VM-hosted self-build's
// (the recovery's seed to stage one to stage two) unless --skip-vm. Stage one is
// the package tools/compiler/native_driver, built by tools/native_aot/Driver.chibi,
// or the program --stage-one names; without either the verb fails with the first
// rejected function of the census.
NativeSelfHost :: (arguments: string[]) -> int {
    dry := Flag(arguments, "--dry-run")
    llvm := Option(arguments, "--llvm", "")
    work := Absolute(Option(arguments, "--work", "build-native-self-host"))
    driver := Absolute("tools/compiler/native_driver")
    if (llvm == "") {
        os.Print("native-self-host: pass --llvm DIR, the folder of opt, llc and ld.lld")
        return 2
    }
    prebuilt := Option(arguments, "--stage-one", "")
    if (prebuilt == "" && !dry && !os.Exists(Join([driver, "/Main.chibi"]))) {
        os.Print("native-self-host: stage one has no driver yet (tools/compiler/native_driver/Main.chibi)")
        os.Print(Join(["native-self-host: first function the native lane rejects: ", FirstRejection()]))
        return 1
    }
    status := ReleaseBuild(arguments, ["chibi-build-host", "chibi-compiler-host"], dry)
    if (status != 0) {
        return status
    }
    releases := Absolute(Option(arguments, "--release-build", "build-release"))
    compiler_host := Join([releases, "/sdk/chibi-compiler-host"])
    target := "x86_64-unknown-linux-gnu"
    if (os.Platform() == "Darwin") {
        target = "aarch64-apple-darwin"
    }
    tools := Absolute("tools/native_aot")
    build_one := [
        Join([releases, "/sdk/chibi-build-host"]), "--root", tools, "--source", Join([tools, "/Driver.chibi"]),
        "--collection", Join(["native_aot=", tools, "/driver"]), "--core", Absolute("packages/core"), "--compiler", Absolute("tools/compiler"), "--compiler-core",
        Absolute("packages/core"), "--entry", "Native", "--timeout-ms", "3600000", "--", compiler_host,
        Absolute("tools/compiler"), Absolute("packages/core"), driver, llvm, "2", "none", target
    ]
    stage_one := Join([driver, "/build/native/stage-one"])
    if (prebuilt != "") {
        stage_one = Absolute(prebuilt)
    } else if (dry) {
        Step("stage-one", build_one, dry)
    } else {
        began := Clock()
        built := os.Capture(build_one)
        os.Print(format_text("stage-one build: {} s, exit {}", Clock() - began, built.status))
        stage_one = NativeProgram(built.stderr)
        if (built.status != 0 || stage_one == "") {
            os.Print(Join(["native-self-host: stage one did not build: ", strings.TrimSpace(built.stderr)]))
            return 1
        }
    }
    two := Join([work, "/stage2"])
    three := Join([work, "/stage3"])
    status = NativeStage("stage-two", stage_one, two, llvm, dry)
    if (status != 0) {
        return status
    }
    status = NativeStage("stage-three", Join([two, "/chibi"]), three, llvm, dry)
    if (status != 0) {
        return status
    }
    if (!dry) {
        digest_two := Digest(Join([two, "/chibi"]))
        digest_three := Digest(Join([three, "/chibi"]))
        os.Print(Join(["stage two sha256 ", digest_two]))
        os.Print(Join(["stage three sha256 ", digest_three]))
        if (digest_two == "" || digest_two != digest_three) {
            os.Print("native-self-host: stage two and stage three differ")
            return 1
        }
    }
    if (!Flag(arguments, "--skip-vm")) {
        began := Clock()
        status = Step("vm-hosted-self-build", [compiler_host, "--bootstrap", "tools/compiler/bootstrap", "--compiler", "tools/compiler", "--core", "packages/core"], dry)
        if (status != 0) {
            return status
        }
        if (!dry) {
            os.Print(format_text("vm-hosted-self-build (seed, stage one, stage two): {} s", Clock() - began))
        }
    }
    if (!dry) {
        os.Print("native-self-host: stage two and stage three are byte-identical")
    }
    return 0
}

// Whether a registered worktree lives under `directory`.
HoldsWorktree :: (directory: string) -> bool {
    listed := os.Capture(["git", "worktree", "list", "--porcelain"])
    for (line in strings.Lines(listed.stdout)) {
        if (strings.HasPrefix(line, "worktree ") && strings.HasPrefix(strings.Partition(line, "worktree ").tail, Join([directory, "/"]))) {
            return true
        }
    }
    return false
}

// Removes the build outputs, except a build directory that holds a worktree.
Clean :: (arguments: string[]) -> int {
    for (name in [Option(arguments, "--build", "build"), "build-debug", Option(arguments, "--release-build", "build-release")]) {
        directory := Absolute(name)
        if (HoldsWorktree(directory)) {
            os.Print(Join(["Skipping ", directory, ": it contains a registered worktree"]))
        } else {
            Step("clean", ["rm", "-rf", "--", directory], Flag(arguments, "--dry-run"))
        }
    }
    return 0
}

// Goal items 3 and 4 as numbers over the tracked files outside archive/ and
// third_party/: it fails on CMake, Make or Python build tooling, and prints the
// first-party C and the C++/Objective-C shims that remain, with line counts.
Census :: () -> int {
    listed := os.Capture(["git", "-C", os.Root(), "ls-files"])
    if (listed.status != 0) {
        os.Print("census: git ls-files failed")
        return 1
    }
    banned: string[] = []
    shims: string[] = []
    c_files := 0
    c_lines := 0
    for (path in strings.SplitLines(listed.stdout)) {
        if (strings.HasPrefix(path, "archive/") || strings.HasPrefix(path, "third_party/")) {
            continue
        }
        name := strings.BaseName(path)
        if (name == "CMakeLists.txt" || name == "Makefile" || strings.HasSuffix(name, ".cmake") || strings.HasSuffix(name, ".py")) {
            banned.append(path)
            continue
        }
        is_c := strings.HasSuffix(name, ".c") || strings.HasSuffix(name, ".h")
        is_shim := false
        for (suffix in [".cpp", ".cc", ".cxx", ".hpp", ".m", ".mm"]) {
            is_shim = is_shim || strings.HasSuffix(name, suffix)
        }
        if (!is_c && !is_shim) {
            continue
        }
        lines := strings.Count(build.read_file(Absolute(path)), "\n")
        if (is_c) {
            c_files = c_files + 1
            c_lines = c_lines + lines
        } else {
            shims.append(format_text("{} {}", lines, path))
        }
    }
    for (path in banned) {
        os.Print(Join(["census: build tooling outside archive/: ", path]))
    }
    for (shim in shims) {
        os.Print(Join(["census: shim ", shim]))
    }
    os.Print(format_text("census: {} first-party C files, {} lines, {} C++/Objective-C shims, {} build tooling files", c_files, c_lines, length(shims), length(banned)))
    if (length(banned) > 0) {
        return 1
    }
    return 0
}

Usage :: () -> int {
    os.Print("usage: build [--release|--debug|--profile NAME] [--build DIR] [--target NAME]... [--jobs N] [--dry-run]")
    os.Print("       build test [--build DIR] [--release-build DIR] [--build-host PATH] [--jobs N] [--timeout SECONDS] [--list] [--dry-run] NAME...")
    os.Print("       build install [--prefix DIR] [--release-build DIR]")
    os.Print("       build format [--check] | clean | census | publish-seed | native-census")
    os.Print("       build native-self-host --llvm DIR [--stage-one PROGRAM] [--work DIR] [--release-build DIR] [--skip-vm] [--dry-run]")
    os.Print("       build bootstrap-artifact | bootstrap-recover [--release-build DIR]")
    os.Print("       build sdk-reflect | runtime-sdk | package-runtime-sdk [--reflect-build DIR] [--runtime-build DIR] [--output DIR] [-- NATIVE ARGUMENTS]")
    return 2
}

Main :: () -> int {
    arguments := os.Arguments()
    if (length(arguments) == 0 || arguments[0] != "build") {
        return Usage()
    }
    verb := ""
    if (length(arguments) > 1 && !strings.HasPrefix(arguments[1], "--")) {
        verb = arguments[1]
    }
    dry := Flag(arguments, "--dry-run")
    if (verb == "test") {
        return Test(arguments)
    }
    if (verb == "install") {
        return Install(arguments)
    }
    if (verb == "format") {
        check: string[] = []
        if (Flag(arguments, "--check")) {
            check = ["--check"]
        }
        return Step("format", extend(["sh", "tools/clang-format.sh"], check), dry)
    }
    if (verb == "clean") {
        return Clean(arguments)
    }
    if (verb == "census") {
        return Census()
    }
    if (verb == "sdk-reflect") {
        return SdkReflect(arguments)
    }
    if (verb == "runtime-sdk" || verb == "package-runtime-sdk") {
        return RuntimeSdk(arguments, verb == "package-runtime-sdk")
    }
    if (verb == "bootstrap-artifact") {
        return Bootstrap(arguments, "artifact")
    }
    if (verb == "bootstrap-recover") {
        return Bootstrap(arguments, "recover")
    }
    if (verb == "publish-seed") {
        return Step("publish-seed", ["sh", "tools/bootstrap/publish-seed.sh"], dry)
    }
    if (verb == "native-census") {
        return NativeCensus(arguments)
    }
    if (verb == "native-self-host") {
        return NativeSelfHost(arguments)
    }
    if (verb != "") {
        return Usage()
    }
    return Build(arguments)
}
