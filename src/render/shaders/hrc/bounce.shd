// Adapted from Neon-Swarm shaders/hrc/bounce.shd; original source comments retained.
layout (set = 2, binding = 1) uniform sampler2D u_radiance;
layout (set = 2, binding = 2) uniform sampler2D u_albedo;

layout (set = 3, binding = 1) uniform shd_uniforms {
    float u_hysteresis;
    int u_luminance_only;
};

vec4 shader(vec4 color, ShaderParams params)
{
    vec3 radiance = texture(u_radiance, screen_uv).rgb;
    vec3 albedo = texture(u_albedo, screen_uv).rgb;
    if (u_luminance_only != 0) {
        const vec3 luma = vec3(0.2126, 0.7152, 0.0722);
        return vec4(vec3(dot(albedo * radiance, luma)), u_hysteresis);
    }
    return vec4(albedo * radiance, u_hysteresis);
}
