package scalar_selection_probe

import os "core:os"
import native "project:llvm_native"
import abi "project:native_abi"
import host "project:native_link_host"
import link "project:native_link"
import strings "core:strings"

Code :: (op: int, type: int, output: int, left: int, right: int, target: int, literal: i64) -> native.Instruction {
    return {op: op, type: type, output: output, left: left, right: right, target: target, literal: literal};
}

Main :: () -> int {
    arguments := os.Arguments();
    if (length(arguments) != 2) { return 2; }
    target := abi.LinuxX64();
    suffix := "";
    windows := os.Platform() == "Windows";
    if (windows) { target = abi.WindowsX64(); suffix = ".exe"; }
    else if (os.Platform() == "Darwin") { target = abi.MacOSArm64(); }
    code := [Code(native.Check, 0, 0, 0, 0, 0, 0),
             Code(native.Constant, abi.BoolStorage, 0, 0, 0, 0, 1),
             Code(native.Constant, abi.BoolStorage, 1, 0, 0, 0, 0),
             Code(native.Constant, abi.IntStorage, 2, 0, 0, 0, 42),
             Code(native.Constant, abi.IntStorage, 3, 0, 0, 0, 7),
             Code(native.Select, abi.IntStorage, 4, 0, 2, 3, 0),
             Code(native.Select, abi.IntStorage, 5, 1, 3, 2, 0),
             Code(native.Eq, abi.IntStorage, 6, 4, 5, 0, 0),
             Code(native.Constant, abi.FloatStorage, 7, 0, 0, 0, 0x80000000),
             Code(native.Constant, abi.FloatStorage, 8, 0, 0, 0, 0x7fc12345),
             Code(native.Select, abi.FloatStorage, 9, 1, 8, 7, 0),
             Code(native.Constant, abi.FloatStorage, 10, 0, 0, 0, 0x3f800000),
             Code(native.Div, abi.FloatStorage, 11, 10, 9, 0, 0),
             Code(native.Constant, abi.FloatStorage, 12, 0, 0, 0, 0),
             Code(native.Lt, abi.FloatStorage, 13, 11, 12, 0, 0),
             Code(native.Select, abi.FloatStorage, 14, 0, 8, 7, 0),
             Code(native.Ne, abi.FloatStorage, 15, 14, 14, 0, 0),
             Code(native.Select, abi.BoolStorage, 16, 6, 13, 1, 0),
             Code(native.Select, abi.BoolStorage, 17, 16, 15, 1, 0),
             Code(native.Branch, 0, 0, 17, 0, 21, 0),
             Code(native.TypedFail, 0, 0, 0, 0, 0, 4),
             Code(native.Publish, abi.IntStorage, 0, 4, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0)];
    slots := [abi.BoolStorage, abi.BoolStorage, abi.IntStorage, abi.IntStorage, abi.IntStorage, abi.IntStorage,
              abi.BoolStorage, abi.FloatStorage, abi.FloatStorage, abi.FloatStorage, abi.FloatStorage,
              abi.FloatStorage, abi.FloatStorage, abi.BoolStorage, abi.FloatStorage, abi.BoolStorage,
              abi.BoolStorage, abi.BoolStorage];
    functions: native.Function[] = [{result: abi.IntStorage, first_parameter: 0, parameters: 0, first_slot: 0,
                                     slots: length(slots), first_local: 0, locals: 0, first_code: 0, code: length(code),
                                     first_argument: 0, arguments: 0}];
    source: native.Source = {file: "", directory: ""};
    module := "";
    switch native.EmitProgram(target, functions, [], slots, [], code, [], [], [], [], source, [], [], []) {
        case .Rejected(instruction, message): os.Print(message); return 1;
        case .Emitted(text): module = text;
    }
    levels: int[] = [0, 2];
    for (level in levels) {
        base := format_text("{}/select-{}", arguments[1], level);
        written := os.WriteText(strings.Concatenate([base, ".ll"]), module);
        if (written != nil) { return 1; }
        start := os.WriteText(strings.Concatenate([base, ".start.ll"]), link.ProgramStart(target.triple, windows, false, false));
        if (start != nil) { return 1; }
        objects := [strings.Concatenate([base, ".o"]), strings.Concatenate([base, ".start.o"])];
        compiled := host.ObjectsResult(arguments[0], [strings.Concatenate([base, ".ll"]), strings.Concatenate([base, ".start.ll"])], objects, level, 2);
        if (compiled.kind != 0) { return 1; }
        program := strings.Concatenate([base, suffix]);
        linked := host.LinkResult(link.Program(target.triple, arguments[0], objects, [], [], [], program, "", windows));
        if (linked.kind != 0) { return 1; }
        status := os.Run([program]);
        if (status != 42) { os.Print(format_text("scalar select O{} exited {}", level, status)); return 1; }
        os.Print(format_text("PASS scalar select O{}: both outcomes, bool, NaN and signed zero", level));
    }
    return 0;
}
