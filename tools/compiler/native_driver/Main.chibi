package native_driver

import link "project:native_link"
import host "project:native_link_host"
import os "core:os"
import strings "core:strings"

// The native compiler's driver: `STAGE --compiler DIR --core DIR --output FILE
// --llvm DIR [--package NAME | --source FILE] [--entry NAME] [--collection NAME=DIR]...
// [--target TRIPLE]` compiles package NAME of the project at DIR (default
// native_driver), or the one program FILE, and the core and collection packages
// it imports to the native module FILE.ll. Without --entry the program starts at
// the first function of its first file; with it, at the function NAME of that
// file, as the build host's --entry does. Exit 0 succeeded, 1 the sources were rejected,
// 2 the arguments or the machine were unusable. The first stderr line of a
// rejection is `native: rejected FUNCTION: MESSAGE`.
//
// Its inputs are independent files and its passes are transforms, so reading
// the closure and emitting each function group can run on worker threads once
// core:thread exists; the order of everything it writes is the source order.

// The entry comes first: a package set's entry is its first file's first function.
Main :: () -> int {
    arguments := os.Arguments();
    project := Option(arguments, "--compiler", "");
    core := Option(arguments, "--core", "");
    output := Option(arguments, "--output", "");
    llvm := Option(arguments, "--llvm", "");
    package := Option(arguments, "--package", "native_driver");
    source := Option(arguments, "--source", "");
    chosen := Option(arguments, "--entry", "");
    triple := Option(arguments, "--target", "x86_64-unknown-linux-gnu");
    if (project == "" || core == "" || output == "" || llvm == "") {
        os.Print("usage: --compiler DIR --core DIR --output FILE --llvm DIR [--package NAME | --source FILE] [--entry NAME] [--collection NAME=DIR]... [--target TRIPLE]");
        return 2;
    }
    collections: string[] = ["core"];
    directories: string[] = [core];
    for (declared in Values(arguments, "--collection")) {
        equals := strings.Index(declared, "=");
        if (equals <= 0) {
            os.Print(strings.Concatenate(["native: --collection takes NAME=DIR, not ", declared]));
            return 2;
        }
        name := strings.Slice(declared, 0, equals);
        directory := strings.Slice(declared, equals + 1, strings.ByteLength(declared) - equals - 1);
        if (!strings.HasPrefix(directory, "/") || Contains(collections, name)) {
            os.Print(strings.Concatenate(["native: --collection takes a new name and an absolute directory, not ", declared]));
            return 2;
        }
        collections.append(name);
        directories.append(directory);
    }
    gathered := Gather(project, collections, directories, package, source);
    if (gathered.problem != "") {
        os.Print(strings.Concatenate(["native: ", gathered.problem]));
        return 2;
    }
    context := false;
    markers: string[] = [];
    switch Module(collections, directories, gathered.paths, gathered.sources, triple, chosen) {
        case .Rejected(message):
            os.Print(strings.Concatenate(["native: ", message]));
            return 1;
        case .Emitted(module):
            if (os.WriteBytes(strings.Concatenate([output, ".ll"]), module) != nil) {
                os.Print(strings.Concatenate(["native: cannot write ", output, ".ll"]));
                return 2;
            }
            context = Takes(module);
            if (strings.HasPrefix(triple, "x86_64-pc-windows")) {
                markers = Markers(module);
            }
    }
    // A program that allocates or formats takes the runtime context, which the
    // start module supplies from libc's allocator on Linux, so it links libc
    // dynamically. Otherwise Linux and Windows programs run with nothing but
    // their own objects; macOS links libSystem, as its programs always have.
    static := !strings.HasPrefix(triple, "aarch64-apple") && (!context || strings.HasPrefix(triple, "x86_64-pc-windows"));
    objects := [strings.Concatenate([output, ".o"])];
    if (host.Object(llvm, strings.Concatenate([output, ".ll"]), objects[0], 2) != nil) {
        os.Print("native: llc could not emit the object");
        return 2;
    }
    start := link.Start(triple, static, context);
    if (start != "") {
        if (os.WriteText(strings.Concatenate([output, ".start.ll"]), start) != nil ||
            host.Object(llvm, strings.Concatenate([output, ".start.ll"]), strings.Concatenate([output, ".start.o"]), 2) != nil) {
            os.Print("native: cannot emit the start object");
            return 2;
        }
        objects.append(strings.Concatenate([output, ".start.o"]));
    }
    plan := link.Program(triple, llvm, objects, [], [], [], output, "", static);
    // Only a Windows program takes system libraries by name: lld-link needs an
    // import library for each, which the macOS and Linux links do without.
    plan.imports = link.SystemImports(markers);
    if (host.Link(plan) != nil) {
        os.Print("native: the link failed");
        return 2;
    }
    for (name in [".ll", ".o", ".start.ll", ".start.o"]) {
        removed := os.Remove(strings.Concatenate([output, name]));
    }
    return 0;
}

Option :: (arguments: string[], name: string, fallback: string) -> string {
    for (index in 0..<length(arguments) - 1) {
        if (arguments[index] == name) {
            return arguments[index + 1];
        }
    }
    return fallback;
}

// The value of every `name VALUE` pair, in order.
Values :: (arguments: string[], name: string) -> string[] {
    found: string[] = [];
    for (index in 0..<length(arguments) - 1) {
        if (arguments[index] == name) {
            found.append(arguments[index + 1]);
        }
    }
    return found;
}

// The names an import line of `text` takes from `collection`.
ImportedFrom :: (text: string, collection: string) -> string[] {
    found: string[] = [];
    prefix := strings.Concatenate([collection, ":"]);
    for (line in strings.SplitLines(text)) {
        // The indented imports of a `when` branch count too, so the snapshot
        // holds every package a kept branch may import.
        trimmed := strings.TrimSpace(line);
        if (!strings.HasPrefix(trimmed, "import ")) {
            continue;
        }
        parts := strings.Split(trimmed, "\"");
        if (length(parts) >= 3 && strings.HasPrefix(parts[1], prefix)) {
            found.append(strings.TrimPrefix(parts[1], prefix));
        }
    }
    return found;
}

// The .chibi files directly in a package folder, in the listing's order.
PackageFiles :: (folder: string) -> string[] {
    files: string[] = [];
    listed := os.List(folder);
    for (name in listed.names) {
        if (strings.HasSuffix(name, ".chibi") && !strings.HasSuffix(name, "Tests.chibi") && os.IsFile(strings.Concatenate([folder, "/", name]))) {
            files.append(name);
        }
    }
    // In name order, as the VM-side listing gives: the order of a package's
    // files is the order of its declarations, which the compiler's passes
    // (ScopedParameters wants them ascending) and its output depend on, and
    // a directory's own order is not stable across machines.
    ranked := resize([""], length(files));
    for (name in files) {
        rank := 0;
        for (other in files) {
            if (strings.Compare(other, name) < 0) {
                rank += 1;
            }
        }
        ranked[rank] = name;
    }
    return ranked;
}

// The sources of the closure: the package's own files, Main.chibi first (or the
// one file of `--source`), then each imported project package of the project
// folder and package of a collection, in the order first imported. `paths[i]` is
// the project-relative path of project files and the absolute path of collection
// files (core's included).
Inputs :: struct {
    paths: string[];
    sources: string[];
    problem: string;
}

Gather :: (project: string, collections: string[], directories: string[], package: string, source: string) -> Inputs {
    found: Inputs = {paths: [], sources: [], problem: ""};
    seen: string[] = [strings.Concatenate(["project:", package])];
    folders: string[] = [strings.Concatenate([project, "/", package])];
    prefixes: string[] = [strings.Concatenate([package, "/"])];
    kinds: string[] = ["project"];
    kinds.extend(collections);
    next := 0;
    while (next < length(folders)) {
        files := PackageFiles(folders[next]);
        if (next == 0 && source != "") {
            // One program: its file alone, whatever else its folder holds.
            slash := strings.LastIndex(source, "/");
            folders[0] = ".";
            files = [source];
            if (slash >= 0) {
                folders[0] = strings.Slice(source, 0, slash);
                files = [strings.Slice(source, slash + 1, strings.ByteLength(source) - slash - 1)];
            }
            prefixes[0] = "";
        } else if (next == 0) {
            // The entry file is first, as the producer reads the first file's
            // first function as the module's entry.
            ordered: string[] = ["Main.chibi"];
            for (file in files) {
                if (file != "Main.chibi") {
                    ordered.append(file);
                }
            }
            files = ordered;
        }
        for (file in files) {
            location := strings.Concatenate([folders[next], "/", file]);
            if (!os.Exists(location)) {
                found.problem = strings.Concatenate(["cannot read ", location]);
                return found;
            }
            read := os.ReadText(location);
            if (read.error != nil) {
                found.problem = strings.Concatenate(["cannot read ", location]);
                return found;
            }
            text := read.text;
            found.paths.append(strings.Concatenate([prefixes[next], file]));
            found.sources.append(text);
            for (kind in kinds) {
                for (name in ImportedFrom(text, kind)) {
                    key := strings.Concatenate([kind, ":", name]);
                    known := false;
                    for (other in seen) {
                        known = known || other == key;
                    }
                    if (known) {
                        continue;
                    }
                    seen.append(key);
                    folder := "";
                    if (kind == "project") {
                        folder = strings.Concatenate([project, "/", name]);
                        prefixes.append(strings.Concatenate([name, "/"]));
                    } else {
                        // A collection's package is its folder below the collection's
                        // directory, `NAME:.` the directory itself, and its files are
                        // named by absolute path.
                        root := directories[Position(collections, kind)];
                        folder = root;
                        if (name != ".") {
                            folder = strings.Concatenate([root, "/", name]);
                        }
                        prefixes.append(strings.Concatenate([folder, "/"]));
                    }
                    folders.append(folder);
                }
            }
        }
        next += 1;
    }
    return found;
}

// Whether `name` is in `names`.
Contains :: (names: string[], name: string) -> bool {
    for (other in names) {
        if (other == name) {
            return true;
        }
    }
    return false;
}

// Where `name` is in `names`; names holds it.
Position :: (names: string[], name: string) -> int {
    for (index in 0..<length(names)) {
        if (names[index] == name) {
            return index;
        }
    }
    return 0;
}

// Whether the module's entry takes the runtime context: its text holds
// `@chibi_scalar(ptr %ctx` (the other functions are `@chibi_scalar.N`).
Takes :: (module: u8[]) -> bool {
    needle := strings.Bytes("@chibi_scalar(ptr %ctx");
    last := length(module) - length(needle);
    at := 0;
    while (at <= last) {
        if (int(module[at]) == needle[0]) {
            matched := 1;
            while (matched < length(needle) && int(module[at + matched]) == needle[matched]) {
                matched += 1;
            }
            if (matched == length(needle)) {
                return true;
            }
        }
        at += 1;
    }
    return false;
}

// The module's `; chibi-library` and `; chibi-import` lines, which name the
// system libraries and symbols it takes. One pass over the bytes: a module is
// megabytes and only these few lines matter.
Markers :: (module: u8[]) -> string[] {
    found: string[] = [];
    needle := strings.Bytes("; chibi-");
    size := length(module);
    at := 0;
    while (at < size) {
        end := at;
        while (end < size && int(module[end]) != 10) {
            end += 1;
        }
        matched := end - at >= length(needle);
        for (index in 0..<length(needle)) {
            matched = matched && int(module[at + index]) == needle[index];
        }
        if (matched) {
            line: u8[] = [];
            for (index in at..<end) {
                line.append(module[index]);
            }
            found.append(text_from_bytes(line));
        }
        at = end + 1;
    }
    return found;
}
