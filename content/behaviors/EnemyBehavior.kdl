version 3
name "EnemyBehavior"
id_counter 334
description "Pursue the nearest player with a velocity that slows for arrival; stop when no target is in range."
owner_type "ecs.entity"
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Event" reference_name="Tick"
            - {
                id 5
                type "Self"
                outputs {
                    Self type_name="ecs.entity"
                }
            }
            - {
                id 7
                type "Find Nearest Entity"
                inputs {
                    Position {
                        binding kind="component" component="GAME.GameTransform"
                    }
                    Radius 2000.0
                    Categories 1
                }
            }
            - id=16 type="Branch"
            - id=52 type="Set_GameVelocity"
            - {
                id 66
                type "Call Pure Function"
                reference_name "Pursuit Velocity"
                inputs {
                    Position {
                        id 67
                        type "struct"
                        type_name "CF_V2"
                        binding kind="component" component="GAME.GameTransform"
                    }
                    Target id=68 type="struct" type_name="CF_V2"
                    Speed {
                        id 69
                        type "float"
                        binding kind="component_field" component="GAME.GameMovement" field="speed"
                    }
                    "Delta Seconds" {
                        id 70
                        type "float"
                        binding kind="delta_time"
                    }
                    Distance id=71 type="float"
                }
                outputs {
                    Velocity id=72 type="struct" type_name="GameVelocity"
                }
            }
            - {
                id 73
                type "Set_GameVelocity"
                inputs {
                    Value {
                        default x=0.0 y=0.0
                    }
                }
            }
        }
        (array)edges {
            - from="1.Then" to="16.Exec"
            - from="5.Self" to="7.Exclude"
            - from="7.Found" to="16.Condition"
            - from="7.Position" to="66.Target"
            - from="7.Distance" to="66.Distance"
            - from="16.True" to="52.Exec"
            - from="16.False" to="73.Exec"
            - from="66.Velocity" to="52.Value"
        }
    }
    - {
        id 57
        kind "function"
        name "Pursuit Velocity"
        entry_id 58
        return_id 64
        call_depth_limit 64
        (array)nodes {
            - {
                id 58
                type "Function Entry"
                (array)outputs {
                    - id=59 name="Position" type="struct" type_name="CF_V2" kind="data"
                    - id=60 name="Target" type="struct" type_name="CF_V2" kind="data"
                    - id=61 name="Speed" type="float" kind="data"
                    - id=62 name="Delta Seconds" type="float" kind="data"
                    - id=63 name="Distance" type="float" kind="data"
                }
            }
            - {
                id 64
                type "Return"
                (array)inputs {
                    - id=65 name="Velocity" type="struct" type_name="GameVelocity" kind="data"
                }
            }
            - {
                id 123
                type "Behavior Expression"
                reference_name "normalize(Target - Position) * clamp(Speed, 0, Distance / DeltaSeconds)"
                inputs {
                    Target id=124 type="struct" type_name="CF_V2"
                    Position id=125 type="struct" type_name="CF_V2"
                    Speed id=126 type="float"
                    Distance id=127 type="float"
                    DeltaSeconds id=128 type="float"
                }
                outputs {
                    Result id=129 type="struct" type_name="CF_V2"
                }
            }
        }
        (array)edges {
            - from="58.Position" to="123.Position"
            - from="58.Target" to="123.Target"
            - from="58.Speed" to="123.Speed"
            - from="58.Delta Seconds" to="123.DeltaSeconds"
            - from="58.Distance" to="123.Distance"
            - from="123.Result" to="64.Velocity"
        }
    }
    - id=89 kind="function" math_expression="normalize(Target - Position) * clamp(Speed, 0, Distance / DeltaSeconds)" entry_id=301
}
