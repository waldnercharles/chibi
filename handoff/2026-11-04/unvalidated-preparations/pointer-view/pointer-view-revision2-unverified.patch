+work=${3:?owned workspace}/pointer-elements
+root=$(CDPATH='' cd -- "$(dirname "$0")/../../.." && pwd -P)
+case "$(uname -s)-$(uname -m)" in
+    Darwin-arm64) triple=aarch64-apple-darwin ;;
+    Linux-x86_64) triple=x86_64-unknown-linux-gnu ;;
+    *) echo 'native pointer elements: unsupported test host' >&2; exit 2 ;;
+esac
+mkdir -p "$work"
+
+# This is an explicit pointer-only allowlist. Do not delegate to the broader
+# managed/view/generation runners: their aggregate admission is a separate lane.
+for entry in Main Tasks Append Iteration Inference Failure; do
+    "$compiler" --compiler "$root/tools/compiler" --core "$root/packages/core" \
+        --source "$root/test/native_aot/managed_pointers/source/PointerElements.chibi" --entry "$entry" \
+        --output "$work/$entry.ll" --emit-llvm --target "$triple"
+done
+"$compiler" --compiler "$root/tools/compiler" --core "$root/packages/core" \
+    --source "$root/test/native_aot/managed_pointers/SourceProbe.chibi" --entry Main \
+    --output "$work/source-probe" --llvm "$llvm" --target "$triple" --jobs 1
+for mode in normal callbacks; do
+    mkdir -p "$work/$mode" "$work/$mode-failure"
+    set --
+    if [ "$mode" = callbacks ]; then set -- --callbacks; fi
+    "$work/source-probe" "$@" "$work/$mode" "$llvm" \
+        "$root/test/native_aot/managed_pointers/SourceAudit.ll" "$work/Main.ll" "$work/Tasks.ll" "$work/Append.ll" "$work/Iteration.ll" "$work/Inference.ll"
+    "$work/source-probe" "$@" --assertion "$work/$mode-failure" "$llvm" \
+        "$root/test/native_aot/managed_pointers/SourceAudit.ll" "$work/Failure.ll"
+done
+
+# All six fixtures contain pointer elements, not inline aggregate elements.
+# The two pointer levels inside Row reach Leaf's definition without hashing
+# declaration ordinals or inventing native schema nodes for PointerDecl.
+for name in Original Reindexed Changed Nominal Nullable Nonnullable; do
+    "$compiler" --compiler "$root/tools/compiler" --core "$root/packages/core" \
+        --source "$root/test/native_aot/managed_pointers/pointer-element-schema/$name.chibi" --entry Main \
+        --output "$work/schema-$name.ll" --emit-llvm --target "$triple"
+done
+tag() {
+    sed -nE 's/^define internal .*@chibi_view\.[0-9]+\.(-?[0-9]+)\.make\..*/\1/p' "$1"
+}
+original=$(tag "$work/schema-Original.ll")
+reindexed=$(tag "$work/schema-Reindexed.ll")
+[ -n "$original" ] && [ "$original" = "$reindexed" ] || {
+    echo 'native pointer elements: reindex changed the schema' >&2; exit 1;
+}
+for name in Changed Nominal Nullable Nonnullable; do
+    changed=$(tag "$work/schema-$name.ll")
+    [ -n "$changed" ] && [ "$original" != "$changed" ] || {
+        echo "native pointer elements: $name lost its semantic identity" >&2; exit 1;
+    }
+done
+
+# Metadata knowledge must not authorize collector-bearing aggregate cells,
+# optional view signatures or authored view-union payloads.
+printf 'prior native output\n' > "$work/sentinel"
+for name in PointerArraySchema NestedPointerSchema ViewOwnedOptionalParameter ViewOwnedOptionalResult PointerViewUnionSchema; do
+    cp "$work/sentinel" "$work/rejected"
+    if "$compiler" --compiler "$root/tools/compiler" --core "$root/packages/core" \
+        --source "$root/test/native_aot/managed_pointers/source/rejected/$name.chibi" --entry Main \
+        --output "$work/rejected" --emit-llvm --target "$triple" > "$work/rejected-$name.log" 2>&1; then
+        echo "native pointer elements: unsupported $name was accepted" >&2; exit 1
+    fi
+    grep -F 'native: rejected' "$work/rejected-$name.log" >/dev/null
+    cmp "$work/sentinel" "$work/rejected"
+done
+echo 'native pointer elements: focused source, cleanup and schema checks passed'
diff --git a/test/native_aot/managed_pointers/source/PointerElements.chibi b/test/native_aot/managed_pointers/source/PointerElements.chibi
new file mode 100644
index 0000000..71a6951
--- /dev/null
+++ b/test/native_aot/managed_pointers/source/PointerElements.chibi
@@ -0,0 +1,168 @@
+package pointer_element_kinds
+
+Row :: struct { number: int; link: ^int; }
+Box :: (value: int) -> ^int { return &value; }
+MakeRow :: (number: int) -> ^Row {
+    linked := number + 1;
+    value: Row = {number: number, link: &linked};
+    return &value;
+}
+NullableOwner :: () -> view (^int?)[] {
+    values: (^int?)[] = [Box(7), nil]; pointer := &values;
+    return pointer.view(0..<2)!;
+}
+RecordOwner :: () -> view (^Row)[] {
+    values: (^Row)[] = [MakeRow(7), MakeRow(11)]; pointer := &values;
+    return pointer.view(0..<2)!;
+}
+ReadNullable :: (window: view (^int?)[], index: int) -> int {
+    pointer := window[index];
+    if pointer { return pointer^; }
+    return -1;
+}
+ReadRecord :: (window: view (^Row)[]) -> int {
+    pointer := window[0];
+    return pointer.number + pointer.link^;
+}
+Churn :: () { for index in 0..<1024 { discarded := RecordOwner(); } }
+Main :: () -> int {
+    nullable := NullableOwner(); Churn();
+    first := ReadNullable(nullable, 0); missing := ReadNullable(nullable, 1);
+    assert(first == 7 && missing == -1);
+    nullable[0] = nil; nullable[1] = Box(19); Churn();
+    first = ReadNullable(nullable, 0); second := ReadNullable(nullable, 1);
+    assert(first == -1 && second == 19);
+    copied := nullable.clone(); copied[1] = nil; Churn();
+    assert(!copied[0] && !copied[1]);
+    second = ReadNullable(nullable, 1); assert(second == 19);
+    sliced := nullable.slice(0..<2);
+    if sliced { sliced[0] = Box(23); pointer := sliced[0]; if pointer { assert(pointer^ == 23); } else { return 1; } }
+    else { return 2; }
+    first = ReadNullable(nullable, 0); assert(first == -1);
+
+    records := RecordOwner(); Churn();
+    total := ReadRecord(records); assert(total == 15);
+    saved := records[0]; records[0] = MakeRow(29); Churn();
+    assert(saved.number == 7 && saved.link^ == 8);
+    total = ReadRecord(records); assert(total == 59);
+    records[0].number = 31; records[0].link^ = 37; Churn();
+    total = ReadRecord(records); assert(total == 68);
+    cloned := records.clone(); cloned[0] = MakeRow(41); Churn();
+    assert(cloned[0].number == 41 && records[0].number == 31);
+    return 0;
+}
+NullableRecordOwner :: () -> ^((^Row?)[]) {
+    values: (^Row?)[] = [MakeRow(5), nil];
+    return &values;
+}
+ReadNullableRecord :: (window: view (^Row?)[], index: int) -> int {
+    pointer := window[index];
+    if pointer { return pointer.number + pointer.link^; }
+    return -1;
+}
+ReplaceNullableRows :: (owner: ^((^Row?)[])) -> ^Row? {
+    owner^ = [MakeRow(101), nil];
+    Churn();
+    return MakeRow(103);
+}
+// Nullable pointer carriers describe source nullability; append stores the
+// same descriptor as array literals and view assignment. Resolve the saved
+// receiver only after an RHS that may replace the complete array cell.
+Append :: () -> int {
+    numbers: (^int?)[] = [nil]; number_owner := &numbers;
+    number_owner.append(nil); number_owner.append(Box(37)); Churn();
+    number_window := number_owner.view(0..<3)!;
+    missing := ReadNullable(number_window, 1); present := ReadNullable(number_window, 2);
+    assert(missing == -1 && present == 37);
+
+    owner := NullableRecordOwner(); window := owner.view(0..<2)!;
+    owner.append(nil); owner.append(MakeRow(13)); Churn();
+    expanded := owner.view(0..<4)!;
+    first := ReadNullableRecord(expanded, 0); last := ReadNullableRecord(expanded, 3);
+    assert(first == 11 && last == 27);
+    empty := ReadNullableRecord(expanded, 2); assert(empty == -1);
+    copied := window.clone(); sliced := window.slice(0..<2);
+    window[0] = nil; window[1] = MakeRow(17); Churn();
+    original := copied[0]; if original { assert(original.number == 5 && original.link^ == 6); } else { return 1; }
+    if sliced { old := sliced[0]; if old { assert(old.number == 5); } else { return 2; } } else { return 3; }
+
+    owner.append(ReplaceNullableRows(owner)); Churn();
+    current := owner^; assert(length(current) == 3);
+    appended := current[2]; if appended { assert(appended.number == 103); } else { return 4; }
+    first = ReadNullableRecord(window, 0); empty = ReadNullableRecord(window, 1);
+    assert(first == 203 && empty == -1);
+    window[1] = ReplaceNullableRows(owner); Churn();
+    first = ReadNullableRecord(window, 0); last = ReadNullableRecord(window, 1);
+    assert(first == 203 && last == 207 && length(owner^) == 2);
+    return 0;
+}
+// Logical loop bindings must keep the PointerDecl, not the nullable array's
+// CollectionDecl carrier. Keyed loops still bind their index as an int.
+Iteration :: () -> int {
+    numbers: (^int?)[] = [Box(3), nil, Box(7)];
+    total := 0; absent := 0;
+    for pointer in numbers {
+        if pointer { Churn(); total += pointer^; } else { absent += 1; }
+    }
+    assert(total == 10 && absent == 1);
+    keyed := 0;
+    for pointer, index in numbers {
+        if pointer { keyed += pointer^ * (index + 1); } else { keyed += index; }
+    }
+    assert(keyed == 25);
+    rows: (^Row?)[] = [MakeRow(11), nil, MakeRow(17)];
+    total = 0; absent = 0;
+    for pointer, index in rows {
+        if pointer { Churn(); total += pointer.number + pointer.link^ + index; }
+        else { absent += 1; }
+    }
+    assert(total == 60 && absent == 1);
+    return 0;
+}
+InferNumbers :: (pointer: ^int?) -> ^((^int?)[]) { values := [pointer]; return &values; }
+InferRows :: (pointer: ^Row?) -> ^((^Row?)[]) { values := [pointer]; return &values; }
+InferIndexedNumbers :: (values: (^int?)[]) -> ^((^int?)[]) { copied := [values[0]]; return &copied; }
+InferIndexedRows :: (values: (^Row?)[]) -> ^((^Row?)[]) { copied := [values[0]]; return &copied; }
+// Taking the inferred array's address requires the exact checked collection
+// identity, including nullable and nominal pointer element types.
+Inference :: () -> int {
+    number := InferNumbers(Box(7)); missing := InferNumbers(nil); Churn();
+    present_window := number.view(0..<1)!; missing_window := missing.view(0..<1)!;
+    present := ReadNullable(present_window, 0); absent := ReadNullable(missing_window, 0);
+    assert(present == 7 && absent == -1);
+    numbers: (^int?)[] = [Box(13)]; copied_number := InferIndexedNumbers(numbers); Churn();
+    copied_window := copied_number.view(0..<1)!;
+    copied := ReadNullable(copied_window, 0); assert(copied == 13);
+
+    row := InferRows(MakeRow(19)); missing_row := InferRows(nil); Churn();
+    row_window := row.view(0..<1)!; absent_window := missing_row.view(0..<1)!;
+    present = ReadNullableRecord(row_window, 0); absent = ReadNullableRecord(absent_window, 0);
+    assert(present == 39 && absent == -1);
+    rows: (^Row?)[] = [MakeRow(23)]; copied_row := InferIndexedRows(rows); Churn();
+    copied_rows := copied_row.view(0..<1)!;
+    copied = ReadNullableRecord(copied_rows, 0); assert(copied == 47);
+    return 0;
+}
+WaitNullable :: () -> view (^int?)[] { window := NullableOwner(); yield; Churn(); return window; }
+WaitRecord :: () -> view (^Row)[] { window := RecordOwner(); yield; Churn(); return window; }
+Hold :: (window: view (^Row)[]) -> int { while true { yield } }
+Tasks :: () -> int {
+    nullable := await WaitNullable(); Churn();
+    first := ReadNullable(nullable, 0); assert(first == 7);
+    pending := WaitRecord(); alias := pending; yield; Churn();
+    joined := await pending;
+    if joined is Cancelled { return 1; }
+    else { window := joined; total := ReadRecord(window); assert(total == 15); window[0] = MakeRow(43); }
+    again := await alias;
+    if again is Cancelled { return 2; }
+    else { window := again; total := ReadRecord(window); assert(total == 87); }
+    window := await WaitRecord(); waiting := Hold(window); yield; Churn(); cancel waiting
+    stopped := await waiting; assert(stopped is Cancelled);
+    return 0;
+}
+Failure :: () -> int {
+    window := RecordOwner(); Churn();
+    total := ReadRecord(window); assert(total == 15);
+    assert(false, "pointer-element view cleanup");
+    return 0;
+}
