    - id=5 kind="function" math_expression="elapsed += dt" entry_id=24
    - id=40 kind="function" math_expression="x = -60 * cos(elapsed * (2 * pi / 8))" entry_id=89
    - id=145 kind="function" math_expression="y = -60 * sin(elapsed * (2 * pi / 8))" entry_id=194
