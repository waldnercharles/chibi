package native_driver

import facts "project:scalar_facts"

// Real producer fixtures and all 169 malformed variants ported from the C
// scalar producer tests. Each variant changes the collected rows, never a
// separately invented representation fixture.

GuardsFixtureSource :: () -> string { return "package scalar\nMain :: () -> int { return Pick(1, 2); }\nPick :: (a: int, b: int) -> int {\n    if (a < b) { return Id(a); }\n    return b;\n}\nId :: (x: int) -> int { return x; }\n"; }
GuardsRows :: () -> facts.Row[] {
    rows := Produced(GuardsFixtureSource());
    ExpectKinds(rows, [facts.SourceRow, facts.DocumentRow, facts.FunctionRow, facts.ReturnRow, facts.LiteralRow, facts.LiteralRow, facts.CallRow, facts.FunctionRow, facts.ParameterRow, facts.ParameterRow, facts.IfRow, facts.ReadRow, facts.ReadRow, facts.CompareRow, facts.ReturnRow, facts.ReadRow, facts.CallRow, facts.EndRow, facts.ReturnRow, facts.ReadRow, facts.FunctionRow, facts.ParameterRow, facts.ReturnRow, facts.ReadRow]);
    ValidateRows(rows, "");
    RejectChanged(rows, [Changed(10, CountField, 0)], "invalid scalar module layout");
    RejectChanged(rows, [Changed(18, KindField, 9)], "invalid scalar module layout");
    RejectChanged(rows, [Changed(17, KindField, 16)], "invalid scalar module layout");
    RejectChanged(rows, [Changed(7, CountField, 2147483647)], "invalid scalar module layout");
    RejectChanged(rows, [Changed(13, ValueField, 0)], "scalar comparison differs from its operands");
    RejectChanged(rows, [Changed(13, ValueField, 7)], "scalar comparison differs from its operands");
    RejectChanged(rows, [Changed(13, CountField, 1)], "scalar comparison differs from its operands");
    RejectChanged(rows, [Changed(13, TypeField, 1)], "scalar comparison differs from its operands");
    RejectChanged(rows, [Changed(12, KindField, 6), Changed(12, TypeField, 2), Changed(12, ValueField, 0), Changed(12, LiteralField, 1)], "scalar comparison differs from its operands");
    RejectChanged(rows, [Changed(11, KindField, 6), Changed(11, TypeField, 2), Changed(12, KindField, 6), Changed(12, TypeField, 2), Changed(12, ValueField, 0)], "scalar comparison differs from its operands");
    RejectChanged(rows, [Changed(13, KindField, 7), Changed(13, TypeField, 1), Changed(13, CountField, 0)], "scalar condition is not one bool");
    RejectChanged(rows, [Changed(10, TypeField, 1)], "invalid scalar statement row");
    RejectChanged(rows, [Copied(14, EndField, 18)], "invalid scalar statement row");
    RejectChanged(rows, [Copied(11, StartField, 15), Copied(11, EndField, 15), Copied(11, LineField, 15), Copied(11, ColumnField, 15)], "invalid scalar statement row");
    RejectChanged(rows, [Copied(18, StartField, 10), Copied(18, LineField, 10), Copied(18, ColumnField, 10)], "invalid scalar statement row");
    RejectChanged(rows, [Copied(17, EndField, 18)], "invalid scalar statement row");
    RejectChanged(rows, [Changed(15, ValueField, 2)], "scalar read differs from its variable");
    RejectChanged(rows, [Changed(18, KindField, 15), Changed(18, TypeField, 1), Changed(18, ValueField, 1)], "scalar function can end without returning");
    RejectChanged(rows, [Changed(23, KindField, 8), Changed(23, ValueField, 0), Named(23, NameField, "Other")], "scalar call differs from its callee's signature");
    ValidateRows(rows, "");
    return rows;
}

ArithmeticFixtureSource :: () -> string { return "package scalar\nMain :: () -> int { return Calc(3, 4); }\nCalc :: (a: int, b: int) -> int { return -(a + b) * ~b; }\n"; }
