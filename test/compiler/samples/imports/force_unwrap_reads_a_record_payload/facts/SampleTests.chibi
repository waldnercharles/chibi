package facts

import testing "core:testing"

// a postfix ! on an optional record reads its fields
@test
Calls :: () {
    r1: int = Main();
    e1: int = 45;
    assert(r1 == e1, "Main call 1");
}

@test
MissingFails :: () {
    testing.ExpectFailure(testing.Failure.UnwrappedNil);
    Missing();
}
