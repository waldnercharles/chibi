package engine

import os "core:os"
import strings "core:strings"

// The libraries the graph owns, as sdk/CMakeLists.txt and its includes define
// them. Records hold only scalars, so a target is its name, and these tables
// give its arrays. Paths are below the source root, except where a table says
// otherwise.

// The libraries the graph builds, each after those it depends on. A library
// with no sources only publishes headers, as CMake's INTERFACE libraries do.
pub Targets :: () -> string[] {
    targets := [
        "chibi_support", "chibi_types", "chibi_asset_values", "chibi_value_document", "chibi_capabilities", "chibi_ecs",
        "chibi_events", "chibi_execution_contract", "chibi_tasks", "chibi_input_action",
        "chibi_native_capabilities",
        "chibi_selection_capabilities", "chibi_set_capabilities",
        "chibi_comparison_capabilities", "chibi_conversion_capabilities", "chibi_host_native_catalog", "chibi_host_clock", "chibi_scheduling", "chibi_fmt", "chibi_json", "chibi_asset_json",
        "chibi_text_capabilities", "chibi_array_capabilities",
        "chibi_math",
        "chibi_execution", "chibi_core_capabilities", "chibi_behavior_runtime", "chibi_native_prepared",
        "chibi_vector_capabilities", "chibi_math_capabilities",
        "chibi_arithmetic_capabilities", "chibi_native_types", "chibi_native_bindings", "chibi_task_pool_runtime", "chibi_host_native_default",

        "chibi_source_catalog", "chibi_program", "chibi_build_host", "chibi-build-host", "chibi_compiler_host",
        "chibi-compiler-host", "chibi_asset_compiler_host", "chibi_application", "chibi", "chibi_compiler_syntax", "chibi_compiler_json"
    ];
    // The native products and full test drivers share the platform's archive.
    if (os.Platform() == "Darwin" || os.Platform() == "Linux") {
        // test_language's object library, which it links.
        targets.extend(["chibi-compile", "chibi_asset_compiler_consumer", "test_language"]);
        // The tooling tests' consumers, several over the archive's headers.
        targets.extend(ToolConsumers());
        targets.append("test_tools");
    }
    targets.extend(["test_host", "concurrent_runner", "policy_worker", "benchmark_trials", "reflect"]);
    return targets;
}

// A target's sources: below the source root, below the build directory for a
// `build/` entry, which a step of the graph writes, or below the third-party
// archive for a `third-party/` entry.
