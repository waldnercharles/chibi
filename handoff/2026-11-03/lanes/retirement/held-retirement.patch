-    ctx->points = f->points;
-    ctx->watches = f->watches;
-    ctx->edges = f->edges;
-    bool owned = !ctx->commands &&
-                 (acount(f->commands) ||
-                  (!ctx->data && (acount(f->host_calls) ||
-                                  acount(f->data_values) || acount(f->calls))));
-    if (owned) {
