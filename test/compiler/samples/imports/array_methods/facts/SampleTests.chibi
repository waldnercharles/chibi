package facts

// array methods
@test
Calls :: () {
    a1_0: int = 3;
    r1: int[] = Build(a1_0);
    e1: int[] = [200, 100, 2, 1, 0, 7];
    assert(length(r1) == length(e1), "Build call 1 length");
    for k in 0..<length(e1) {
        assert(r1[k] == e1[k], "Build call 1 element");
    }
    a2_0: int[] = [1, 2, 3];
    r2: int = Count(a2_0);
    e2: int = 35;
    assert(r2 == e2, "Count call 2");
    a3_0: int[] = [1, 2];
    a3_1: int = 2;
    r3: bool = Has(a3_0, a3_1);
    e3: bool = true;
    assert(r3 == e3, "Has call 3");
    a4_0: int[] = [5, 6, 7, 8];
    r4: int[] = Sliced(a4_0);
    e4: int[] = [6, 7];
    assert(length(r4) == length(e4), "Sliced call 4 length");
    for k in 0..<length(e4) {
        assert(r4[k] == e4[k], "Sliced call 4 element");
    }
    r5: int = Separate();
    e5: int = 2;
    assert(r5 == e5, "Separate call 5");
    a6_0: int[] = [5];
    r6: int[] = Grow(a6_0);
    e6: int[] = [5, 1];
    assert(length(r6) == length(e6), "Grow call 6 length");
    for k in 0..<length(e6) {
        assert(r6[k] == e6[k], "Grow call 6 element");
    }
    r7: int[] = Named();
    e7: int[] = [7];
    assert(length(r7) == length(e7), "Named call 7 length");
    for k in 0..<length(e7) {
        assert(r7[k] == e7[k], "Named call 7 element");
    }
}
