            <div class="node cap" id="learn" style="left: 50dp; top: 270dp;" data-event-click="emit('Learn', 8)" data-class-owned="self.n8 == 2" data-class-open="self.n8 == 1" data-class-poor="self.a8 == 0">
              <div class="ring"><div class="gem"/></div>
