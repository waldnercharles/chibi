pub Profile :: (profile: int) -> Options {
    options := Defaults();
    if (profile == 0) {
        options.profile = 0;
    }
    if (profile == 1) {
        options.indent_width = 2;
        options.preferred_width = 100;
        options.short_functions = 3;
        options.short_branches = 3;
        options.short_loops = 3;
        options.function_body = 2;
        options.function_keyword = 1;
        options.return_arrow = 1;
        options.binding_types = 1;
        options.operator_spacing = 1;
        options.statement_paragraphs = 2;
        options.trailing_commas = 1;
        options.profile = 1;
    }
    if (profile == 2) {
        options.preferred_width = 80;
        options.list_layout = 2;
        options.short_functions = 1;
        options.short_branches = 1;
        options.short_loops = 1;
        options.brace_placement = 2;
        options.branch_braces = 2;
        options.function_body = 1;
        options.function_keyword = 2;
        options.return_arrow = 2;
        options.statement_paragraphs = 2;
        options.blank_lines_before_final_return = 1;
        options.blank_lines_after_control = 1;
        options.blank_lines_between_members = 1;
        options.profile = 2;
    }
    if (profile == 3) {
        options.preferred_width = 100;
        options.list_layout = 3;
        options.assignment_alignment = 3;
        options.field_type_alignment = 3;
        options.constant_alignment = 3;
        options.record_value_alignment = 3;
        options.comment_alignment = 3;
        options.data_alignment = 3;
        options.alignment_max_padding = 24;
        options.alignment_max_column = 100;
        options.statement_paragraphs = 2;
        options.profile = 3;
    }
    return options;
}

pub Validate :: (options: Options) -> string {
    if (options.profile != 0 && options.profile != 1 && options.profile != 2 && options.profile != 3) {
        return "Invalid formatter options: profile must be current_v1, compact_v1, expanded_v1 or tabular_v1";
    }
    if (options.preferred_width != 0 && (options.preferred_width < 20 || options.preferred_width > 400)) {
        return "Invalid formatter options: preferred_width must be 0 or 20..400";
    }
    if (options.indent_width < 1 || options.indent_width > 16) {
        return "Invalid formatter options: indent_width must be 1..16";
    }
    if (options.continuation_indent < 0 || options.continuation_indent > 16) {
        return "Invalid formatter options: continuation_indent must be 0..16";
    }
    if (options.tab_width < 0 || options.tab_width > 16) {
        return "Invalid formatter options: tab_width must be 0..16";
    }
    if (options.brace_placement != 0 && options.brace_placement != 1 && options.brace_placement != 2) {
        return "Invalid formatter options: brace_placement must be preserve, attach or next_line";
    }
    if (options.branch_braces != 0 && options.branch_braces != 1 && options.branch_braces != 2) {
        return "Invalid formatter options: branch_braces must be preserve, always or omit_single";
    }
    if (options.empty_blocks != 0 && options.empty_blocks != 1 && options.empty_blocks != 2) {
        return "Invalid formatter options: empty_blocks must be keep, collapse or expand";
    }
    if (options.following_keyword != 0 && options.following_keyword != 1 && options.following_keyword != 2) {
        return "Invalid formatter options: following_keyword must be same_line, next_line or preserve";
    }
    if (options.unbraced_body_placement != 0 && options.unbraced_body_placement != 1 && options.unbraced_body_placement != 2 && options.unbraced_body_placement != 3) {
        return "Invalid formatter options: unbraced_body_placement must be inherit, preserve, same_line or next_line";
    }
    if (options.function_braces != 0 && options.function_braces != 1 && options.function_braces != 2 && options.function_braces != 3) {
        return "Invalid formatter options: function_braces must be inherit, preserve, attach or next_line";
    }
    if (options.control_braces != 0 && options.control_braces != 1 && options.control_braces != 2 && options.control_braces != 3) {
        return "Invalid formatter options: control_braces must be inherit, preserve, attach or next_line";
    }
    if (options.type_braces != 0 && options.type_braces != 1 && options.type_braces != 2 && options.type_braces != 3) {
        return "Invalid formatter options: type_braces must be inherit, preserve, attach or next_line";
    }
    if (options.foreign_braces != 0 && options.foreign_braces != 1 && options.foreign_braces != 2 && options.foreign_braces != 3) {
        return "Invalid formatter options: foreign_braces must be inherit, preserve, attach or next_line";
    }
    if (options.when_braces != 0 && options.when_braces != 1 && options.when_braces != 2 && options.when_braces != 3) {
        return "Invalid formatter options: when_braces must be inherit, preserve, attach or next_line";
    }
    if (options.empty_function_blocks != 0 && options.empty_function_blocks != 1 && options.empty_function_blocks != 2 && options.empty_function_blocks != 3) {
        return "Invalid formatter options: empty_function_blocks must be inherit, preserve, collapse or expand";
    }
    if (options.empty_control_blocks != 0 && options.empty_control_blocks != 1 && options.empty_control_blocks != 2 && options.empty_control_blocks != 3) {
        return "Invalid formatter options: empty_control_blocks must be inherit, preserve, collapse or expand";
    }
    if (options.empty_type_blocks != 0 && options.empty_type_blocks != 1 && options.empty_type_blocks != 2 && options.empty_type_blocks != 3) {
        return "Invalid formatter options: empty_type_blocks must be inherit, preserve, collapse or expand";
    }
    if (options.short_functions != 0 && options.short_functions != 1 && options.short_functions != 2 && options.short_functions != 3) {
        return "Invalid formatter options: short_functions must be inherit, expand, preserve or inline_if_fits";
    }
    if (options.short_branches != 0 && options.short_branches != 1 && options.short_branches != 2 && options.short_branches != 3) {
        return "Invalid formatter options: short_branches must be inherit, expand, preserve or inline_if_fits";
    }
    if (options.short_loops != 0 && options.short_loops != 1 && options.short_loops != 2 && options.short_loops != 3) {
        return "Invalid formatter options: short_loops must be inherit, expand, preserve or inline_if_fits";
    }
    if (options.short_case_arms != 0 && options.short_case_arms != 1 && options.short_case_arms != 2 && options.short_case_arms != 3) {
        return "Invalid formatter options: short_case_arms must be inherit, expand, preserve or inline_if_fits";
    }
    if (options.max_inline_statements < 0 || options.max_inline_statements > 16) {
