package record_members

import reader "project:signature_reader"
import named "project:named_binding"
import binding "project:lexical_binding"
import syntax "project:syntax_diagnostics"

pub Selection :: union {
    Selected(symbol: int, definition: int, diagnostics: syntax.Diagnostic[])
}
pub Member :: union {
    Discovered(name: string, id: u64, annotation: reader.Reading,
               has_default: bool, default_node: int, admissible: bool,
               diagnostics: syntax.Diagnostic[])
}

// Authored-record bits are raw metadata aligned with the complete merged
// catalog. All decisions, including original-order lookup and origin, live here.
pub Select :: (environment: reader.Environment, authored_records: bool[],
               tree: reader.Tree, node: int, scope: int, document: int) -> Selection {
    empty: syntax.Diagnostic[] = [];
    if (!reader.Kind(tree, node, syntax.RecordDeclaration)) {
        return Selection.Selected(-1, -1, empty);
    }
    token := reader.Field(tree, node, syntax.FieldName);
    switch reader.Name(tree, token, document) {
        case .Name(name, diagnostics):
            switch environment {
                case .Tables(names, constructor_tables, pointer_size):
                    switch names {
                        case .Tables(lexical, types, ids, merged, own, native, symbol_types, imports, exports, uses,
                                     identity, package_scope, has_native, has_documents, entity_id):
                            symbol := binding.FindName(lexical, scope, name);
                            if (symbol >= 0) {
                                switch named.TypeAt(types, ids, symbol_types[symbol]) {
                                    case .Typed(storage, container, flags, nominal, parameter):
                                        definition: int = -1;
                                        index: int = 0;
                                        while (index < length(merged) && definition < 0) {
                                            if (named.IDAt(ids, merged[index].id_slot) == nominal) {
                                                definition = index;
                                            }
                                            index += 1;
                                        }
                                        if (definition >= 0 && authored_records[definition]) {
                                            switch lexical {
                                                case .Tables(scopes, symbols, functions, lexical_ids, keys):
                                                    item := symbols[symbol];
                                                    origin := reader.Request(tree, token, scope, document, "");
                                                    if (item.document == origin.document && item.start == origin.start) {
                                                        return Selection.Selected(symbol, definition, diagnostics);
                                                    }
                                            }
                                        }
                                }
                            }
                    }
            }
            return Selection.Selected(-1, -1, diagnostics);
    }
}

// One member per call. The caller applies annotation publications/uses now,
// handles default_node separately, then supplies refreshed facts for the next
// member. Previous names include every earlier field, even invalid ones.
// Defaults are discovered, never read, resolved, checked or evaluated here.
pub Read :: (environment: reader.Environment, tree: reader.Tree, member: int,
             previous_names: string[], scope: int, document: int) -> Member {
    token := reader.Field(tree, member, syntax.FieldName);
    switch reader.Name(tree, token, document) {
        case .Name(name, name_diagnostics):
            diagnostics := name_diagnostics;
            annotation := reader.Type(environment, tree, reader.Field(tree, member, syntax.FieldType), scope, document);
            switch annotation {
                case .Read(value, has_unit, unit, updated, errors, uses, publications, collection):
                    for (error in errors) {
                        diagnostics.append(error);
                    }
                    admissible := true;
                    switch value {
                        case .Typed(storage, container, flags, nominal, parameter):
                            if (name == "" || nominal != 0 || flags != 0 || container != 0 ||
                                (storage != 13 && storage != 6 && storage != 1)) {
                                diagnostics.append(reader.Diagnostic(tree, member, document,
                                                                     "Record fields require nonoptional string, int or bool values"));
                                admissible = false;
                            }
                    }
                    for (previous in previous_names) {
                        if (previous == name) {
                            diagnostics.append(reader.Diagnostic(tree, member, document,
                                                                 format_text("Duplicate record field '{}'", name)));
                            admissible = false;
                        }
                    }
                    value_node := reader.Field(tree, member, syntax.FieldValue);
                    return Member.Discovered(name, binding.ID("record-field", name), annotation,
                                             value_node >= 0, value_node, admissible, diagnostics);
            }
    }
}
