/* Command (cmdk). */
.command-backdrop { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; background-color: var(--backdrop); pointer-events: auto; z-index: 29; opacity: 1; transition: opacity 0.16s cubic-out; }
.command-backdrop[data-starting-style], .command-backdrop[data-ending-style] { opacity: 0; }
.command {
    position: absolute; left: 50%; top: 88dp; width: 600dp; margin-left: -300dp; background-color: var(--popover);
    border: 1dp var(--popover-edge); border-radius: 8dp; display: block; pointer-events: auto;
    z-index: 30;
    opacity: 1; margin-top: 0dp; transition: opacity margin-top 0.16s cubic-out;
}
.command[data-starting-style], .command[data-ending-style] { opacity: 0; margin-top: -6dp; }
.command[data-ending-style] { transition: opacity margin-top 0.1s cubic-in; }
.cmd-input { display: flex; align-items: center; gap: 8dp; height: 44dp; padding: 0dp 12dp; border-bottom: 1dp var(--border); }
.cmd-input .icon { font-size: 15dp; color: var(--faint-foreground); }
.cmd-input input { flex: 1 1 0dp; font-size: 14dp; height: 20dp; color: var(--foreground); }
.cmd-list { display: block; max-height: 360dp; overflow-y: auto; padding: 4dp 6dp 6dp; }
.cmd-group { height: 26dp; display: block; padding: 10dp 6dp 0dp; font-size: 11dp; color: var(--faint-foreground); }
.cmd-item { display: flex; align-items: center; gap: 10dp; height: 32dp; padding: 0dp 8dp; border-radius: 5dp; color: var(--foreground); }
.cmd-item .label { flex: 1 1 0dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cmd-item .label b { font-weight: 600; color: var(--strong); }
.cmd-item .meta { color: var(--faint-foreground); font-size: 11dp; white-space: nowrap; }
.cmd-item[data-selected] { background-color: var(--item-selected); }
.cmd-empty { height: 64dp; line-height: 64dp; display: block; text-align: center; color: var(--faint-foreground); }
.cmd-footer { display: flex; align-items: center; gap: 4dp; height: 32dp; padding: 0dp 12dp; border-top: 1dp var(--border); color: var(--faint-foreground); font-size: 11dp; }
.cmd-footer .hint { margin-right: 10dp; }

/* Color picker popover: vertex gradients need no shader support. */
.popup.picker { width: 232dp; padding: 8dp; }
.picker .sv { position: relative; height: 150dp; border-radius: 4dp; drag: drag; cursor: crosshair; }
.picker .sv-white { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; border-radius: 4dp; decorator: horizontal-gradient(#ffffffff #ffffff00); }
.picker .sv-black { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; border-radius: 4dp; decorator: vertical-gradient(#00000000 #000000ff); }
.picker .sv .puck { position: absolute; width: 10dp; height: 10dp; margin: -5dp 0dp 0dp -5dp; border-radius: 5dp; border: 2dp #ffffff; }
.picker .hue { position: relative; display: flex; height: 12dp; border-radius: 3dp; margin-top: 8dp; drag: drag; }
.picker .hue-seg { flex: 1 1 0dp; height: 100%; }
.picker .hue .puck { position: absolute; top: 0dp; bottom: 0dp; width: 4dp; margin-left: -2dp; background-color: #ffffff; border-radius: 1dp; }
.picker .hexrow { margin-top: 8dp; }
.picker .hexrow input.value { width: 100%; font-family: InterNumeric; }
