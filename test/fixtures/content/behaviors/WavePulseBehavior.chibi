// An authored wave announcement expands a thin red band through floor cells and
// expires after 0.8 seconds.
WavePulseBehavior :: behavior {
    // The last frame step, for actions and functions.
    Step: float = 0
    // State
    Age: float = 0.0
    on Tick :: (dt: float s) {
        Step = dt
        Age = Age + Step
        if float(divide(Age, B: plain double = 0.8)) >= 1.0 {
            destroy_entity(self)
        } else {
            self.SurfaceInfluence.radius = float(24.0 + 336.0 * divide(Age, B: plain double = 0.8))
            self.SurfaceInfluence.inner_radius = float(max(0.0, 24.0 + 336.0 * divide(Age, B: plain double = 0.8) - 28.0))
            self.SurfaceInfluence.strength = float(0.65 * (1.0 - divide(Age, B: plain double = 0.8)))
        }
    }
}
