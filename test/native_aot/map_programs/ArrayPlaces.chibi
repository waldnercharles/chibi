package map_array_places
Key :: (calls: ^int) -> int { calls^ += 1; return 1; }
Index :: (calls: ^int) -> int { calls^ += 10; return 0; }
Replace :: (values: ^[int: int[]]) -> int { values^ = [1: [100,200], 2: [300]]; return 5; }
ReplaceIndex :: (values: ^[int: int[]]) -> int { values^ = [1: [100]]; return 0; }
Text :: (value: u8) -> string { return text_from_bytes([u8(65),u8(0),value]); }
StringValue :: (key: ^string) -> string { key^ = Text(9); return Text(7); }
Item :: struct { text: string; value: int; }
RecordValue :: (values: ^[int: Item[]]) -> Item {
    values^ = [1: [{text:Text(8),value:100}], 2: [{text:Text(2),value:200}]];
    return {text:Text(7),value:7};
}
Main :: () -> int {
    values: [int: int[]] = [1: [1,2]];
    alias := values;
    calls := 0;
    values[Key(&calls)][Index(&calls)] += Replace(&values);
    assert(calls == 11 && values[1][0] == 6 && values[1][1] == 200 && values[2][0] == 300);
    assert(alias[1][0] == 1 && alias[1][1] == 2);
    values = [1: [1]];
    values[1][ReplaceIndex(&values)] += 5;
    assert(values[1][0] == 105);
    floats: [int: f32[]] = [1: [f32(1.5)]];
    floats[1][0] *= 2;
    assert(floats[1][0] == f32(3));
    flags: [int: bool[]] = [1: [true]];
    flags[1][0] = false;
    assert(!flags[1][0]);
    key := Text(1);
    original := key;
    words: [string: string[]] = [key: [Text(3)]];
    word_alias := words;
    words[key][0] = StringValue(&key);
    assert(words[original][0] == Text(7) && word_alias[original][0] == Text(3) && key == Text(9));
    items: [int: Item[]] = [1: [{text:Text(1),value:1}]];
    item_alias := items;
    items[1][0] = RecordValue(&items);
    assert(items[1][0].text == Text(7) && items[1][0].value == 7);
    assert(items[2][0].value == 200 && item_alias[1][0].text == Text(1));
    return 0;
}
