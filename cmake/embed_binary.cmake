cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/generated_file.cmake")
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT SYMBOL MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
    message(FATAL_ERROR "INPUT, OUTPUT and a valid SYMBOL are required")
endif()
file(READ "${INPUT}" bytes HEX)
# Work in bulk: interpreting a CMake loop for each font byte is expensive.
string(REPEAT "[0-9a-f][0-9a-f]" 16 row)
string(REGEX REPLACE "(${row})" "\\1\n" bytes "${bytes}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " bytes "${bytes}")
string(REGEX REPLACE " +\n" "\n" bytes "${bytes}")
string(STRIP "${bytes}" bytes)
string(REPLACE "\n" "\n    " bytes "${bytes}")
set(content "#include <stddef.h>\n\nconst unsigned char ${SYMBOL}[] = {\n    ${bytes}\n};\nconst size_t ${SYMBOL}_size = sizeof ${SYMBOL};\n")
chibi_write_generated("${OUTPUT}" "${content}")
