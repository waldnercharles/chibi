package math_types

Accepts :: (result: Result, kind: int) {
    switch result {
        case .Accepted(actual):
            assert(actual == kind, "operation result type");
        case .Rejected(message):
            assert(false, "operation was rejected");
    }
}
Rejects :: (result: Result, message: string) {
    switch result {
        case .Accepted(kind):
            assert(false, "invalid operation was accepted");
        case .Rejected(actual):
            assert(actual == message, "operation diagnostic");
    }
}
Reads :: (result: SwizzleResult, kind: int, expected: int[]) {
    switch result {
        case .Accepted(actual, components):
            assert(actual == kind, "swizzle result type");
            assert(length(components) == length(expected), "swizzle width");
            index: int = 0;
            while (index < length(expected)) {
                assert(components[index] == expected[index], "swizzle component order");
                index += 1;
            }
        case .Rejected(message):
            assert(false, "swizzle was rejected");
    }
}
RejectsSwizzle :: (result: SwizzleResult, message: string) {
    switch result {
        case .Accepted(kind, components):
            assert(false, "invalid swizzle was accepted");
        case .Rejected(actual):
            assert(actual == message, "swizzle diagnostic");
    }
}

@test
ClassifiesOnlyCanonicalMathNames :: () {
    assert(Kind("number") == Scalar && Kind("f32") == Scalar);
    assert(Kind("f64") == Double && Kind("int") == Integer);
    assert(Kind("u64") == Integer && Kind("bool") == Boolean);
    assert(Kind("CF_V3") == Unknown && Kind("Velocity") == Unknown);
    assert(Kind("quat") == Quat && Kind("vec4") != Quat);
    assert(Components(Mat3) == 9 && Width(Mat3) == 3);
    assert(Components(Quat) == 4 && Width(Quat) == 0);
}
@test
ConstructsSplatsConcatenationsAndMatrixDiagonals :: () {
    assert(Constructor(Vec3, [Scalar], true) == "");
    assert(Constructor(Vec4, [Vec3, Scalar], true) == "");
    assert(Constructor(Vec4, [Vec2, Vec2], true) == "");
    assert(Constructor(Mat3, [Scalar], true) == "");
    assert(Constructor(Mat3, [Vec3, Vec3, Vec3], true) == "");
    assert(Constructor(Mat2, [Scalar, Scalar, Scalar, Scalar], true) == "");
}
@test
ConstructorsDoNotDropPadOrNarrowComponents :: () {
    assert(Constructor(Vec3, [Vec2], true) == "vec3 needs 3 components; these arguments supply 2");
    assert(Constructor(Vec3, [Vec4], true) == "vec3 needs 3 components; these arguments supply 4");
    empty: int[] = [];
    assert(Constructor(Mat4, empty, true) == "mat4 needs 16 components; these arguments supply 0");
    assert(Constructor(Vec2, [Scalar, Double], true) == "math components require explicit f32(value) narrowing from f64");
    assert(Constructor(Vec2, [Integer], true) == "math components need a resolved f32 value; convert the integer with f32(value)");
    assert(Constructor(Vec2, [Scalar], false) == "built-in math constructors take positional arguments");
}
@test
QuaternionConstructionIsDistinctFromVectorConstruction :: () {
    assert(Constructor(Quat, [Scalar, Scalar, Scalar, Scalar], true) == "");
    assert(Constructor(Quat, [Vec4], true) == "quat takes four f32 components in x, y, z, w order");
    assert(Constructor(Quat, [Scalar], true) == "quat needs 4 components; these arguments supply 1");
    assert(Constructor(Vec4, [Quat], true) == "vector and matrix constructors take f32 scalars and vectors");
}
@test
ScalarBroadcastPreservesVectorWidthOnEitherSide :: () {
    Accepts(Binary("+", Scalar, Vec2), Vec2);
    Accepts(Binary("-", Scalar, Vec3), Vec3);
    Accepts(Binary("/", Scalar, Vec4), Vec4);
    Accepts(Binary("*", Vec2, Scalar), Vec2);
    Accepts(Binary("-", Vec3, Vec3), Vec3);
    Rejects(Binary("+", Vec2, Vec3), "cannot apply + to vec2 and vec3");
}
@test
MatrixProductsUseColumnVectorsOfTheSameDimension :: () {
    Accepts(Binary("*", Mat2, Vec2), Vec2);
    Accepts(Binary("*", Mat3, Mat3), Mat3);
    Accepts(Binary("*", Mat4, Vec4), Vec4);
    Rejects(Binary("*", Mat3, Vec2), "cannot apply * to mat3 and vec2");
    Rejects(Binary("*", Vec3, Mat3), "a matrix multiplies a column vector on its right; write matrix * vector");
    Rejects(Binary("*", Mat4, Mat3), "cannot apply * to mat4 and mat3");
}
@test
MatricesScaleButDoNotBroadcastScalarAdditionOrDivision :: () {
    Accepts(Binary("*", Scalar, Mat2), Mat2);
    Accepts(Binary("/", Mat3, Scalar), Mat3);
    Accepts(Binary("+", Mat4, Mat4), Mat4);
    Rejects(Binary("+", Mat2, Scalar), "cannot apply + to mat2 and number");
    Rejects(Binary("/", Scalar, Mat2), "cannot apply / to number and mat2");
    Rejects(Binary("/", Mat3, Mat3), "cannot apply / to mat3 and mat3");
}
@test
QuaternionsComposeAndRotateWithoutVectorBroadcast :: () {
    Accepts(Binary("*", Quat, Quat), Quat);
    Accepts(Binary("*", Quat, Vec3), Vec3);
    assert(BinaryRecoverable("*", Quat, Vec3), "rotation must report an invalid quaternion");
    assert(!BinaryRecoverable("*", Quat, Quat), "composition uses ordinary f32 arithmetic");
    Rejects(Binary("*", Vec3, Quat), "quat supports quaternion composition and quat * vec3 rotation");
    Rejects(Binary("+", Quat, Quat), "quat supports quaternion composition and quat * vec3 rotation");
    Rejects(Binary("*", Quat, Scalar), "quat supports quaternion composition and quat * vec3 rotation");
}
@test
EqualityReturnsBoolAndOrderingNeedsComponents :: () {
    Accepts(Binary("==", Vec3, Vec3), Boolean);
    Accepts(Binary("!=", Mat4, Mat4), Boolean);
    Accepts(Binary("==", Quat, Quat), Boolean);
    Rejects(Binary("==", Vec3, Vec4), "math equality requires operands of the same built-in type");
    Rejects(Binary("<", Vec2, Vec2), "math values support + - * / == and !=; compare components instead");
    Rejects(Binary("%", Vec2, Vec2), "math values support + - * / == and !=; compare components instead");
}
@test
DoublePrecisionNeedsAnExplicitConversionBeforeMath :: () {
    Rejects(Binary("*", Vec3, Double), "math components require explicit f32(value) narrowing from f64");
    Rejects(Binary("+", Double, Vec4), "math components require explicit f32(value) narrowing from f64");
}
@test
UnaryNegationKeepsVectorAndMatrixTypes :: () {
    Accepts(Negate(Vec2), Vec2);
    Accepts(Negate(Mat4), Mat4);
    Rejects(Negate(Quat), "unary math negation needs a vector or matrix");
}
@test
SwizzleReadsPreserveOrderAndPermitRepeatedComponents :: () {
    Reads(Swizzle(Vec4, "wzyx", false), Vec4, [3, 2, 1, 0]);
    Reads(Swizzle(Vec3, "rgb", false), Vec3, [0, 1, 2]);
    Reads(Swizzle(Vec2, "xxxx", false), Vec4, [0, 0, 0, 0]);
    Reads(Swizzle(Vec2, "g", false), Scalar, [1]);
}
@test
WritableSwizzlesRejectRepeatedDestinations :: () {
    Reads(Swizzle(Vec2, "yx", true), Vec2, [1, 0]);
    Reads(Swizzle(Vec4, "bgra", true), Vec4, [2, 1, 0, 3]);
    RejectsSwizzle(Swizzle(Vec3, "xyx", true), "a writable swizzle cannot repeat a destination component");
    RejectsSwizzle(Swizzle(Vec4, "rr", true), "a writable swizzle cannot repeat a destination component");
}
@test
SwizzleDiagnosticsExplainTheSourceRule :: () {
    RejectsSwizzle(Swizzle(Vec3, "xr", false), "a swizzle cannot mix xyzw and rgba components");
    RejectsSwizzle(Swizzle(Vec2, "xz", false), "vec2 has no component 'z'");
    RejectsSwizzle(Swizzle(Vec3, "a", false), "vec3 has no component 'a'");
    RejectsSwizzle(Swizzle(Vec4, "", false), "a swizzle needs one to four components");
    RejectsSwizzle(Swizzle(Vec4, "xyzww", false), "a swizzle needs one to four components");
    RejectsSwizzle(Swizzle(Vec4, "xy_", false), "swizzles use xyzw or rgba components");
    RejectsSwizzle(Swizzle(Quat, "xy", false), "swizzles require a vector");
}

@test
MemberwiseFunctionsBroadcastWithoutNarrowing :: () {
    Accepts(Function("sin", [Vec3]), Vec3);
    Accepts(Function("min", [Scalar, Vec4]), Vec4);
    Accepts(Function("smoothstep", [Scalar, Scalar, Vec2]), Vec2);
    Accepts(Function("clamp", [Vec3, Scalar, Scalar]), Vec3);
    Rejects(Function("mix", [Vec2, Vec3, Scalar]), "memberwise math operands differ in vector width");
    Rejects(Function("sin", [Double]), "math components require explicit f32(value) narrowing from f64");
    Rejects(Function("sqrt", [Mat2]), "memberwise math functions take f32 scalars and vectors");
    Rejects(Function("step", [Vec2]), "step needs 2 arguments");
}

@test
GeometricFunctionsHaveSpecificDimensions :: () {
    Accepts(Function("length", [Vec4]), Scalar);
    Accepts(Function("dot", [Vec2, Vec2]), Scalar);
    Accepts(Function("cross", [Vec3, Vec3]), Vec3);
    Accepts(Function("refract", [Vec4, Vec4, Scalar]), Vec4);
    Rejects(Function("cross", [Vec2, Vec2]), "cross takes two vec3 operands");
    Rejects(Function("dot", [Vec3, Vec4]), "dot takes two vectors of one width");
    Rejects(Function("normalize_or", [Vec3, Vec2]), "normalize_or takes two vectors of one width");
    Rejects(Function("refract", [Vec3, Vec3, Double]), "refract takes two vectors of one width and an f32 ratio");
}

@test
MatrixAndQuaternionFunctionsKeepDistinctTypes :: () {
    Accepts(Function("transpose", [Mat3]), Mat3);
    Accepts(Function("determinant", [Mat4]), Scalar);
    Accepts(Function("inverse", [Mat2]), Mat2);
    Accepts(Function("matrix_comp_mult", [Mat3, Mat3]), Mat3);
    Accepts(Function("quat_conjugate", [Quat]), Quat);
    Rejects(Function("inverse", [Vec4]), "inverse takes one matrix");
    Rejects(Function("quat_normalize", [Vec4]), "quat_normalize takes one quaternion");
    assert(Recoverable("inverse") && Recoverable("normalize") && Recoverable("quat_normalize"));
    assert(Recoverable("normalize_or") && !Recoverable("normalize_or_zero"));
}

// Entry for the authored stage-one build host, which calls an int result.
pub Check :: () -> int {
    ClassifiesOnlyCanonicalMathNames();
    ConstructsSplatsConcatenationsAndMatrixDiagonals();
    ConstructorsDoNotDropPadOrNarrowComponents();
    QuaternionConstructionIsDistinctFromVectorConstruction();
    ScalarBroadcastPreservesVectorWidthOnEitherSide();
    MatrixProductsUseColumnVectorsOfTheSameDimension();
    MatricesScaleButDoNotBroadcastScalarAdditionOrDivision();
    QuaternionsComposeAndRotateWithoutVectorBroadcast();
    EqualityReturnsBoolAndOrderingNeedsComponents();
    DoublePrecisionNeedsAnExplicitConversionBeforeMath();
    UnaryNegationKeepsVectorAndMatrixTypes();
    SwizzleReadsPreserveOrderAndPermitRepeatedComponents();
    WritableSwizzlesRejectRepeatedDestinations();
    SwizzleDiagnosticsExplainTheSourceRule();
    MemberwiseFunctionsBroadcastWithoutNarrowing();
    GeometricFunctionsHaveSpecificDimensions();
    MatrixAndQuaternionFunctionsKeepDistinctTypes();
    return 0;
}
