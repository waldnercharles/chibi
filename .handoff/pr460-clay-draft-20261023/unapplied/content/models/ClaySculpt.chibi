                            data.Field.Named("x", data.Value.Real(0.0)),
                            data.Field.Named("y", data.Value.Real(0.0)),
                            data.Field.Named("inputs", data.Object([
                                data.Field.Named("Half Size", data.Object([
                                    data.Field.Named("default", data.Object([
