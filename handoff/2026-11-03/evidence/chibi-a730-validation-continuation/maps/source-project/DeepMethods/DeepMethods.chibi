package deep_mapped_methods

Item :: struct { word: string; values: int[]; }
Replace :: (values: ^([int:[int:int[]]])) -> int {
    fresh: [int:[int:int[]]] = [1:[2:[10,20]],7:[8:[80]]]; values^ = fresh; return 9;
}
AppendArg :: (values: ^([int:[int:int[]]])) -> int { ignored := Replace(values); return 9; }
ExtendArg :: (values: ^([int:[int:int[]]])) -> int[] { ignored := Replace(values); return [3,4]; }
RemoveArg :: (values: ^([int:[int:int[]]])) -> int { ignored := Replace(values); return 0; }
ResizeArg :: (values: ^([int:[int:int[]]])) -> int { ignored := Replace(values); return 3; }
Word :: (value: u8) -> string { return text_from_bytes([u8(97),0,value]); }
ChangeKey :: (key: ^string) -> string { key^ = Word(3); return "added"; }
Main :: () -> int {
    values: [int:[int:int[]]] = [1:[2:[1,2]]];
    old := values;
    values[1][2].append(3);
    values[1][2].extend([4,5]);
    values[1][2].remove_index(1);
    assert(length(values[1][2]) == 4 && values[1][2][0] == 1 && values[1][2][1] == 3 && values[1][2][3] == 5);
    values[1][2].resize(6);
    assert(length(values[1][2]) == 6 && values[1][2][4] == 0 && length(old[1][2]) == 2);
    values[1][2].append(AppendArg(&values));
    assert(length(values[1][2]) == 3 && values[1][2][0] == 10 && values[1][2][2] == 9 && values[7][8][0] == 80);
    values[1][2].extend(ExtendArg(&values));
    assert(length(values[1][2]) == 4 && values[1][2][2] == 3 && values[1][2][3] == 4);
    values[1][2].remove_index(RemoveArg(&values));
    assert(length(values[1][2]) == 1 && values[1][2][0] == 20);
    values[1][2].resize(ResizeArg(&values));
    assert(length(values[1][2]) == 3 && values[1][2][0] == 10 && values[1][2][2] == 0);
    values[1][2].remove_index(-1);
    values[1][2].remove_index(99);
    assert(length(values[1][2]) == 3);
    mixed: [int:int[]][] = [[1:[0]]];
    prior := mixed;
    mixed[0][1].append(1);
    mixed[0][1].extend([2,3]);
    mixed[0][1].remove_index(0);
    mixed[0][1].resize(4);
    assert(length(mixed[0][1]) == 4 && mixed[0][1][0] == 1 && mixed[0][1][2] == 3 && mixed[0][1][3] == 0);
    assert(length(prior[0][1]) == 1 && prior[0][1][0] == 0);
    for (index in 0..<96) {
        outer := Word(1);
        inner := Word(2);
        words: [string:[string:string[]]] = [outer:[inner:[]]];
        words[outer][inner].append(ChangeKey(&inner));
        assert(words[outer][Word(2)][0] == "added" && !words[outer].has(Word(3)));
        dynamic := text_from_bytes([u8(111),119,110,101,100]);
        records: [int:[int:Item[]]] = [1:[2:[]]];
        records[1][2].append({word:dynamic,values:[index]});
        records[1][2].extend(records[1][2]);
        assert(length(records[1][2]) == 2 && records[1][2][0].word == "owned" && records[1][2][1].values[0] == index);
        copy := records;
        records[1][2].remove_index(0);
        assert(length(records[1][2]) == 1 && records[1][2][0].word == "owned");
        records[1][2].resize(0);
        assert(length(copy[1][2]) == 2 && copy[1][2][0].values[0] == index && length(records[1][2]) == 0);
    }
    return 0;
}
