    RejectChanged(rows, [Changed(14, ValueField, 3)], "scalar arithmetic differs from its number operands");
    RejectChanged(rows, [Changed(14, CountField, 2)], "scalar arithmetic differs from its number operands");
    RejectChanged(rows, [Changed(12, KindField, 6), Changed(12, TypeField, 2), Changed(12, ValueField, 0), Changed(12, LiteralField, 1)], "scalar arithmetic differs from its number operands");
    RejectChanged(rows, [Changed(15, KindField, 6), Changed(15, TypeField, 2), Changed(15, ValueField, 0)], "scalar arithmetic differs from its number operands");
    ValidateRows(rows, "");
    return rows;
}

WidthsFixtureSource :: () -> string { return "package scalar\nMain :: () -> int { return int(Low(298)); }\nLow :: (x: int) -> u8 { return u8(wrap: x) << 1; }\n"; }
WidthsRows :: () -> facts.Row[] {
    rows := Produced(WidthsFixtureSource());
    ExpectKinds(rows, [facts.SourceRow, facts.DocumentRow, facts.FunctionRow, facts.ReturnRow, facts.LiteralRow, facts.CallRow, facts.ConvertRow, facts.FunctionRow, facts.ParameterRow, facts.ReturnRow, facts.ReadRow, facts.ConvertRow, facts.LiteralRow, facts.ArithmeticRow]);
    ValidateRows(rows, "");
    // Mode 2 is now CheckedChar; the old C fixture predates that admission.
    RejectChanged(rows, [Changed(6, ValueField, 3)], "scalar conversion is not one the runtime implements");
    RejectChanged(rows, [Changed(6, CountField, 2)], "scalar conversion is not one the runtime implements");
    RejectChanged(rows, [Changed(11, TypeField, 2)], "scalar conversion is not one the runtime implements");
    RejectChanged(rows, [Changed(10, KindField, 6), Changed(10, TypeField, 2), Changed(10, ValueField, 0)], "scalar conversion is not one the runtime implements");
    RejectChanged(rows, [Changed(12, LiteralField, 256)], "noncanonical scalar literal");
    RejectChanged(rows, [Changed(12, LiteralField, -1)], "noncanonical scalar literal");
    RejectChanged(rows, [Changed(10, LiteralField, 1)], "invalid scalar operand row");
    RejectChanged(rows, [Changed(12, TypeField, 1)], "scalar arithmetic differs from its number operands");
    RejectChanged(rows, [Changed(13, ValueField, 11)], "scalar arithmetic differs from its number operands");
    RejectChanged(rows, [Changed(6, TypeField, 4)], "scalar return differs from its function's result");
    ValidateRows(rows, "");
    return rows;
}

ControlFixtureSource :: () -> string { return "package scalar\nMain :: () -> int { return Pick(1, 2); }\nPick :: (a: int, b: int) -> int {\n    x := a;\n    if (a < b && !(b < 0)) {\n        y := b;\n        x += y;\n    } else {\n        return b;\n    }\n    return x;\n}\n"; }
