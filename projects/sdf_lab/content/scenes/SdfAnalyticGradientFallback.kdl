version 1
name "SdfAnalyticGradientFallback"
(array)entities {
    - {
        name "Camera"
        prototype "SdfOptimizationCamera"
        components {
            GameTransform x=0.0 y=0.0
            GameCamera width=500.0 height=320.0 focal_distance=700.0
            GameHRC2D surface_shadow_mode="Horizon8" ambient=0.22 fog=0.015 bounce_intensity=0.12
        }
    }
    - {
        name "Cyan light"
        prototype "SdfLight"
        components {
            GameTransform x=-215.0 y=-45.0
            GameMaterial emission_color=0x38d9edff
        }
    }
    - {
        name "Amber light"
        prototype "SdfLight"
        components {
            GameTransform x=215.0 y=45.0
            GameMaterial emission_color=0xffac54ff
        }
    }
    - {
        name "Noise fallback"
        prototype "SdfSphere"
        components {
            GameTransform x=0.0 y=0.0
            GameVisualTransform scale=2.0 pitch=0.4 roll=-0.2
            GameShader shape="SdfGradientNoise" material="SdfIvory"
        }
    }
}
