layout(set = 0, binding = 0) uniform sampler2D u_base;
layout(set = 0, binding = 1) uniform sampler2D u_field;
layout(set = 1, binding = 0, rgba16f) uniform image2D u_combined;

layout(set = 2, binding = 0) uniform Params
{
    int u_canvas_w;
    int u_canvas_h;
};

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= u_canvas_w || pixel.y >= u_canvas_h) {
        return;
    }
    vec3 result = texelFetch(u_base, pixel, 0).rgb + texelFetch(u_field, pixel, 0).rgb;
    imageStore(u_combined, pixel, vec4(result, 1.0));
}
