#include "package_snapshot_chibi_source.h"
#include "package_syntax_chibi_source.h"
#include "prepared_writer_chibi_source.h"
#include "syntax_chibi_source.h"

static const char PACKAGE_COMPILER_COMPILE_SOURCE[] = { @CHIBI_PACKAGE_COMPILER_COMPILE_BYTES@ 0 };
static const char PACKAGE_COMPILER_BODY_SOURCE[] = { @CHIBI_PACKAGE_COMPILER_BODY_BYTES@ 0 };
static const char PACKAGE_COMPILER_FALLIBLE_SOURCE[] = { @CHIBI_PACKAGE_COMPILER_FALLIBLE_BYTES@ 0 };
static const char PACKAGE_COMPILER_STEPS_SOURCE[] = { @CHIBI_PACKAGE_COMPILER_STEPS_BYTES@ 0 };
