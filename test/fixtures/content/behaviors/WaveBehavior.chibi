behavior "WaveBehavior" {
    state CountLimit: int = 8
    state Interval: float = 1.5
    state SpawnDistance: float = 260.0
    state Elapsed: float = 0.0
    state Spawned: int = 0
    state Side: float = -1.0
    value get_gametransform = get_game_transform()
    value self_2 = engine["Self"]()
    value find_nearest_entity = find_nearest_entity(get_gametransform, 1000000.0, 1, self_2)
    on Tick {
        if find_nearest_entity.Found {
            await set_variable<"Elapsed">(add(get_variable<"Elapsed">(), delta_time()))
            await "Spawn Within Wave Limit"(find_nearest_entity.Position)
        }
    }
    function "Spawn Within Wave Limit"("Player Position": struct<"CF_V2"> = null) {
        value interval = get_variable<"Interval">()
        value max = max(interval, B: float = 0.01)
        value elapsed = get_variable<"Elapsed">()
        value spawned = get_variable<"Spawned">()
        value countlimit = get_variable<"CountLimit">()
        value integer_greater_or_equal = integer_greater_or_equal(spawned, countlimit)
        value side = get_variable<"Side">()
        after entry {
            while greater_or_equal(elapsed, max) {
                if integer_greater_or_equal {
                    return
                } else {
                    await set_variable<"Elapsed">(subtract(elapsed, max))
                    await "Spawn Enemy"(entry."Player Position")
                    await set_variable<"Spawned">(add(spawned, B: int = 1))
                    set_variable<"Side">(multiply(side, B: float = -1.0))
                }
            }
            return
        }
    }
    function "Spawn Enemy"("Player Position": struct<"CF_V2"> = null) {
        value side = get_variable<"Side">()
        value spawndistance = get_variable<"SpawnDistance">()
        action spawn_prototype = engine["Spawn Prototype"]("Enemy")
        after entry {
            spawn_prototype()
        }
        after spawn_prototype {
            await set_entity_game_transform(spawn_prototype.Entity, make_game_transform(add(entry."Player Position".x, multiply(side, spawndistance)), entry."Player Position".y))
            return
        }
    }
}
