package facts

// integers
@test
Calls :: () {
    a1_0: u8[] = [1, 2, 3];
    r1: u64 = Hash(a1_0);
    e1: u64 = 11570874782335668893;
    assert(r1 == e1, "Hash call 1");
    a2_0: int = 300;
    r2: u8[] = Bytes(a2_0);
    e2: u8[] = [1, 2, 255, 44, 200];
    assert(length(r2) == length(e2), "Bytes call 2 length");
    for k in 0..<length(e2) {
        assert(r2[k] == e2[k], "Bytes call 2 element");
    }
    a3_0: int = 1;
    r3: int = High(a3_0);
    e3: int = 256;
    assert(r3 == e3, "High call 3");
    a4_0: int = 2;
    a4_1: i64 = 5000000000;
    r4: i64 = Mixed(a4_0, a4_1);
    e4: i64 = 5000000002;
    assert(r4 == e4, "Mixed call 4");
    a5_0: int = 4;
    r5: i64 = Store(a5_0);
    e5: i64 = 42;
    assert(r5 == e5, "Store call 5");
    a6_0: i64 = 7;
    r6: int = Narrow(a6_0);
    e6: int = 7;
    assert(r6 == e6, "Narrow call 6");
    a7_0: i64 = 5000000000;
    r7: int = Narrow(a7_0);
    e7: int = 2147483647;
    assert(r7 == e7, "Narrow call 7");
    a8_0: int = 300;
    r8: u8 = Clamp(a8_0);
    e8: u8 = 255;
    assert(r8 == e8, "Clamp call 8");
    a9_0: int = -5;
    r9: u8 = Clamp(a9_0);
    e9: u8 = 0;
    assert(r9 == e9, "Clamp call 9");
}
