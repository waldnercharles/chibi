package asset_wasm

import compiler "project:package_compiler"
import request "project:asset_request"
import target "core:target"
import call "project:asset_call"
import store "project:asset_store"
import strings "core:strings"

// The embedded browser service shares the desktop request and compiler. Its
// host borrows buffers only for these foreign calls; no file or OS import is
// part of the compiler module.
foreign {
    chibi_native_scope_begin :: (steps: u64) -> int
    chibi_native_scope_end :: () -> int
}

Main :: () -> int { return Compile(); }

pub Compile :: () -> int {
    assert(target.Os == target.Web && target.Arch == target.Wasm32 && target.PointerBits == 32, "the browser compiler target");
    count := call.RequestLength();
    if (count < 0 || count > 67108864) { return 2; }
    data := resize([u8(0)], count);
    if (call.RequestCopy(&data, count) != 0) { return 2; }
    ticket: store.Ticket = {directory: "", key: "", identity: ""};
    if (call.Cached()) {
        cache_directory := CacheDirectory();
        if (cache_directory != "") {
            if (call.SaltLength() != call.NoSalt) {
                ticket = store.Bind(cache_directory, call.Identity(), data);
                cached := store.Read(ticket);
                if (cached.found) {
                    if (call.Cancelled() != 0) {
                        rejected := call.Rejected(-1, 0, 0, "The package compile was cancelled");
                        return 2;
                    }
                    return call.Publish(cached.data, length(cached.data));
                }
            }
        }
    }
    value := request.Parse(text_from_bytes(data));
    if (!value.valid) { return 2; }
    armed := chibi_native_scope_begin(call.Budget());
    assert(armed == 0, "native compiler scope begins");
    compiled := compiler.CompileCatalogResult(value.project, value.collections, value.roots, value.paths, value.sources,
        value.debug, value.target, value.abi, value.names, value.natives, value.ports, value.identities,
        value.types, value.fields, value.entity, value.os, value.arch, value.effects);
    ended := chibi_native_scope_end();
    assert(ended == 0, "native compiler scope ends");
    switch compiled {
        case .Rejected(diagnostic):
            if (call.Rejected(diagnostic.document, diagnostic.line, diagnostic.column, diagnostic.message) != 0) { return 2; }
            return 1;
        case .Compiled(module, bytes):
            if (ticket.directory != "" && call.Cancelled() == 0) { store.Publish(ticket, bytes); }
            if (call.Publish(bytes, length(bytes)) != 0) { return 2; }
            return 0;
    }
}

CacheDirectory :: () -> string {
    option := call.Option(1);
    size := option.size;
    path := option.text;
    if (size == -1) {
        environment := call.Environment("CHIBI_ASSET_CACHE_DIR");
        size = environment.size;
        path = environment.text;
    }
    if (size == -1) { path = "/cache/chibi-assets"; }
    else if (size <= 0 || size > 4096) { return ""; }
    return strings.Concatenate([path, "/closures"]);
}
