        "src/toolchain/compiler_target.c", "test/language/binding_benchmark.c",
        "test/language/borrow.c", "test/language/bounded_compiler_chibi.c",
        "test/language/callable_headers_chibi.c", "test/language/capture.c",
        "test/language/compiler_artifact_chibi.c", "test/language/component_write.c",
        "test/language/component_write_ir.c", "test/language/component_write_source.c",
        "test/language/constant_proof_chibi.c", "test/language/constant_scalar_chibi.c",
        "test/language/docs_markdown.c", "test/language/effect_analysis_chibi.c",
        "test/language/effects.c",
        "test/language/execution.c", "test/language/execution_scope.c", "test/language/generic.c",
        "test/language/inferred_string_arrays.c", "test/language/integer_semantics.c", "test/language/host_packages_compiler.c",
        "test/language/lexical_binding_chibi.c",
        "test/language/maps.c", "test/language/named_binding_chibi.c",
        "test/language/native_census.c", "test/language/nominal_binding_chibi.c",
        "test/language/numeric.c",
        "test/language/outliner_projection.c", "test/language/package_compiler_chibi.c",
        "test/language/package_paths_chibi.c", "test/language/package_routes_chibi.c",
        "test/language/package_snapshot_chibi.c", "test/language/package_syntax.c",
        "test/language/package_syntax_chibi.c", "test/language/prepared_writer_chibi.c",
        "test/language/program.c", "test/language/query_boundary.c", "test/language/query_values.c", "test/language/query_migration.c", "test/language/ranges.c",
        "test/language/record_members_chibi.c", "test/language/record_prepared.c",
        "test/language/record_prepared_runtime.c", "test/language/record_publication.c",
        "test/language/record_runtime.c", "test/language/record_semantic.c",
        "test/language/record_state.c", "test/language/row_array.c",
        "test/language/runtime_attribution.c", "test/language/scalar_lowering_chibi.c",
        "test/language/scalarize.c", "test/language/signature_fixture.c",
        "test/language/signature_reader_chibi.c", "test/language/source_tokenizer_chibi.c",
        "test/language/type_constructors_chibi.c", "test/language/type_relations_chibi.c",
        "test/language/union_members_chibi.c", "test/language/unit_algebra_chibi.c",
        "test/language/unit_analysis_chibi.c", "test/language/wasm.c"
    ];
}

// Defines one source adds after its target's, as CMake's COMPILE_DEFINITIONS
// source property adds them; Expand fills {source_root}, {build_type},
// {sha256:PATH} and {program:NAME}.
pub SourceDefines :: (target: string, file: string) -> string[] {
    if (target == "test_language" && file == "test/language/runtime_attribution.c") {
        return [
            "CHIBI_ATTRIBUTION_BASE=\"3c65bb60b6f3443aef6ccf4ab15acbe09b04b191\"",
            "CHIBI_ATTRIBUTION_BUILD=\"{build_type}\"",
            "CHIBI_ATTRIBUTION_FIXTURE_SHA=\"{sha256:test/language/runtime_attribution.c}\""
        ];
    }
    if (target == "test_language" &&
        (file == "test/language/source_tokenizer_chibi.c" || file == "test/language/asset_packaging_chibi.c" ||
         file == "test/language/integer_semantics.c" || file == "test/language/host_packages_compiler.c")) {
        return ["CHIBI_SOURCE_ROOT=\"{source_root}\""];
    }
    return [];
}

// Include directories one source adds before its target's, as CMake's
// INCLUDE_DIRECTORIES source property adds them: test_tools' C export cases
// the testing headers.
pub SourceIncludes :: (target: string, file: string) -> string[] {
    if (target == "test_language" && Listed(LanguageTestsOverSource(), file)) {
        return ["src"];
    }
    if (target == "test_tools" && (file == "test/tools/c_export.c" || file == "test/tools/record_c_export.c")) {
        return ["build/test/tools/testing/include"];
    }
    return [];
}

// The C++ standard a target's C++ sources compile with, its CMake
// CXX_STANDARD with GNU extensions, or empty for none: the UI host, over RmlUi,
// declares C++17.
pub CxxStandard :: (target: string) -> string {
    if (target == "chibi_ui_host") {
        return "gnu++17";
    }
    return "";
}

// The name a target's headers are staged under, its CMake EXPORT_NAME when
// that is not the target's name without chibi_, and the target an export
// name stages.
pub ExportName :: (target: string) -> string {
    if (target == "chibi_ui_host") {
        return "ui";
    }
    if (target == "chibi_renderer") {
        return "render";
    }
    return "";
}
pub ExportTarget :: (component: string) -> string {
    if (component == "ui") {
        return "chibi_ui_host";
    }
    if (component == "render") {
        return "chibi_renderer";
    }
    return Join(["chibi_", component]);
}

// Whether names hold name.
Listed :: (names: string[], name: string) -> bool {
    for (listed in names) {
        if (listed == name) {
            return true;
        }
    }
    return false;
}

// Headers a header set configures below its private root, `HEADER=INPUT`, as
// CMake's configure_file writes them: a `.in` INPUT with its Substitutions,
// any other copied. The language tests embed the Chibi sources they compile;
// the tooling tests copy the fixtures their consumers include.
pub Configures :: (target: string) -> string[] {
    if (target == "chibi_language_testing") {
        return [
            "third_party/pico_headers/pico_unit.h=third_party/pico_headers/pico_unit.h",
            "test/prepared_fixture.h=test/prepared_fixture.h",
            "test/parallel.h=test/parallel.h",
            "package_core_source.h=test/language/package_core_source.h.in",
            "core_strings_tests_source.h=test/language/core_strings_tests_source.h.in",
            "host_packages_source.h=test/language/host_packages_source.h.in",
            "docs_markdown_source.h=test/language/docs_markdown_source.h.in",
            "package_graph_chibi_source.h=test/language/package_graph_chibi_source.h.in",
            "syntax_chibi_source.h=test/language/syntax_chibi_source.h.in",
            "source_tokenizer_chibi_source.h=test/language/source_tokenizer_chibi_source.h.in",
            "package_syntax_chibi_source.h=test/language/package_syntax_chibi_source.h.in",
            "package_paths_chibi_source.h=test/language/package_paths_chibi_source.h.in",
            "package_routes_chibi_source.h=test/language/package_routes_chibi_source.h.in",
            "package_snapshot_chibi_source.h=test/language/package_snapshot_chibi_source.h.in",
            "constant_proof_chibi_source.h=test/language/constant_proof_chibi_source.h.in",
            "constant_scalar_chibi_source.h=test/language/constant_scalar_chibi_source.h.in",
            "shader_source_chibi_source.h=test/language/shader_source_chibi_source.h.in",
            "asset_packaging_chibi_source.h=test/language/asset_packaging_chibi_source.h.in",
            "scalar_lowering_chibi_source.h=test/language/scalar_lowering_chibi_source.h.in",
            "lexical_binding_chibi_source.h=test/language/lexical_binding_chibi_source.h.in",
            "nominal_binding_chibi_source.h=test/language/nominal_binding_chibi_source.h.in",
            "named_binding_chibi_source.h=test/language/named_binding_chibi_source.h.in",
            "type_constructors_chibi_source.h=test/language/type_constructors_chibi_source.h.in",
            "type_relations_chibi_source.h=test/language/type_relations_chibi_source.h.in",
            "unit_algebra_chibi_source.h=test/language/unit_algebra_chibi_source.h.in",
            "signature_reader_chibi_source.h=test/language/signature_reader_chibi_source.h.in",
            "callable_headers_chibi_source.h=test/language/callable_headers_chibi_source.h.in",
            "unit_analysis_chibi_source.h=test/language/unit_analysis_chibi_source.h.in",
            "union_members_chibi_source.h=test/language/union_members_chibi_source.h.in",
            "effect_analysis_chibi_source.h=test/language/effect_analysis_chibi_source.h.in",
            "record_members_chibi_source.h=test/language/record_members_chibi_source.h.in",
            "build_workflow_source.h=test/language/build_workflow_source.h.in",
            "bounded_compiler_chibi_source.h=test/language/bounded_compiler_chibi_source.h.in",
            "prepared_writer_chibi_source.h=test/language/prepared_writer_chibi_source.h.in",
            "package_compiler_chibi_source.h=test/language/package_compiler_chibi_source.h.in"
        ];
    }
    if (target == "chibi_tools_testing") {
        return [
            "third_party/pico_headers/pico_unit.h=third_party/pico_headers/pico_unit.h",
            "test/prepared_fixture.h=test/prepared_fixture.h",
            "test/tools/fixture.h=test/tools/fixture.h", "test/graph/packs.h=test/graph/packs.h",
            "test/graph/fixture.h=test/graph/fixture.h",
            "test/render/hidden_app.h=test/render/hidden_app.h",
            "test/support/reflected_types.h=test/support/reflected_types.h",
            "test/support/gltf_fixture.h=test/support/gltf_fixture.h",
            "export_compiler.h=test/tools/export_compiler.h.in"
        ];
    }
    return [];
}

// The values of a target's `@NAME@` placeholders, `NAME=KIND:VALUE`: `bytes:PATH`
// as CMake's file(READ ... HEX) initializer, `cstring:PATH` as C string lines,
// and `compiler:ARGUMENT` as C string initializer lines of the profile's C
// compiler, its C flags and then ARGUMENT, as test/tools writes the compiler
// its exported C builds with. `test-sources:PREFIX:PACKAGE:DIR` and
// `test-inputs:PREFIX:PACKAGE:DIR` discover a test package's direct .chibi files.
pub Substitutions :: (target: string) -> string[] {
    if (target == "chibi_language_testing") {
        return [
            "CHIBI_ASSET_PACKAGING_BYTES=bytes:tools/compiler/asset_packaging/Packaging.chibi",
            "CHIBI_ASSET_GENERATOR_BYTES=bytes:tools/graph/asset_compiler/Generate.chibi",
            "CHIBI_ANALYSIS_STATE_BYTES=bytes:tools/compiler/analysis_state/State.chibi",
            "CHIBI_BOUNDED_COMPILE_BYTES=bytes:tools/compiler/bounded_compiler/Compile.chibi",
            "CHIBI_BOUNDED_EXPRESSION_BYTES=bytes:tools/compiler/bounded_compiler/Expression.chibi",
            "CHIBI_BOUNDED_PREPARE_BYTES=bytes:tools/compiler/bounded_compiler/Prepare.chibi",
            "CHIBI_CALLABLE_HEADERS_BYTES=bytes:tools/compiler/callable_headers/Headers.chibi",
            "CHIBI_COMPILER_FACTS_BYTES=bytes:tools/compiler/compiler_facts/Facts.chibi",
            "CHIBI_COMPILER_SYNTAX_BYTES=bytes:tools/compiler/compiler_syntax/Syntax.chibi",
            "CHIBI_CONSTANT_FOLDING_BYTES=bytes:tools/compiler/constant_folding/Fold.chibi",
            "CHIBI_CONSTANT_IR_BYTES=bytes:tools/compiler/constant_ir/IR.chibi",
            "CHIBI_CONSTANT_PROOF_BYTES=bytes:tools/compiler/constant_admissibility/Proof.chibi",
            "CHIBI_CONSTANT_SCALAR_BYTES=bytes:tools/compiler/constant_scalar/Scalar.chibi",
            "CHIBI_CORE_STRINGS_BYTES=bytes:packages/core/strings/Strings.chibi",
            "CHIBI_CORE_STRINGS_TEST_SOURCES=test-sources:CORE_STRINGS_TEST_SOURCE:core_strings:test/core_strings",
            "CHIBI_CORE_STRINGS_TEST_INPUTS=test-inputs:CORE_STRINGS_TEST_SOURCE:core_strings:test/core_strings",
            "CHIBI_CORE_TIME_BYTES=bytes:packages/core/time/Time.chibi",
            "CHIBI_CORE_TIME_TEST_BYTES=bytes:test/standard_library/time/TimeTests.chibi",
            "CHIBI_DOCS_GRAMMAR_BYTES=bytes:tools/docs/grammar/Grammar.chibi",
            "CHIBI_DOCS_MARKDOWN_BYTES=bytes:tools/docs/markdown/Markdown.chibi",
            "CHIBI_DOCS_REFERENCE_BYTES=bytes:tools/docs/reference/Reference.chibi",
            "CHIBI_DOCS_SITE_BYTES=bytes:tools/docs/site/Site.chibi",
            "CHIBI_EMITTER_TEST_SOURCES=test-sources:EMITTER_TEST_SOURCE:llvm_native_calls:test/native_aot/emitter_calls",
            "CHIBI_EMITTER_TEST_INPUTS=test-inputs:EMITTER_TEST_SOURCE:llvm_native_calls:test/native_aot/emitter_calls",
            "CHIBI_EFFECT_ANALYSIS_BYTES=bytes:tools/compiler/effect_analysis/Effects.chibi",
            "CHIBI_LEXICAL_BINDING_BYTES=bytes:tools/compiler/lexical_binding/Binding.chibi",
            "CHIBI_LLVM_NATIVE_BYTES=bytes:tools/compiler/llvm_native/Emit.chibi",
            "CHIBI_NAMED_BINDING_BYTES=bytes:tools/compiler/named_binding/Binding.chibi",
            "CHIBI_NATIVE_ABI_BYTES=bytes:tools/compiler/native_abi/Abi.chibi",
            "CHIBI_NOMINAL_BINDING_BYTES=bytes:tools/compiler/nominal_binding/Nominal.chibi",
            "CHIBI_PACKAGE_COMPILER_BEHAVIOR_BYTES=bytes:tools/compiler/package_compiler/Behavior.chibi",
            "CHIBI_PACKAGE_COMPILER_QUERIES_BYTES=bytes:tools/compiler/package_compiler/Queries.chibi",
            "CHIBI_PACKAGE_COMPILER_QUERYLOOPS_BYTES=bytes:tools/compiler/package_compiler/QueryLoops.chibi",
            "CHIBI_PACKAGE_COMPILER_BODY_BYTES=bytes:tools/compiler/package_compiler/Body.chibi",
            "CHIBI_PACKAGE_COMPILER_COMPILE_BYTES=bytes:tools/compiler/package_compiler/Compile.chibi",
            "CHIBI_PACKAGE_COMPILER_MAPS_BYTES=bytes:tools/compiler/package_compiler/Maps.chibi",
            "CHIBI_PACKAGE_COMPILER_NUMBER_BYTES=bytes:tools/compiler/package_compiler/Number.chibi",
            "CHIBI_PACKAGE_COMPILER_OPTIONAL_BYTES=bytes:tools/compiler/package_compiler/Optional.chibi",
            "CHIBI_PACKAGE_COMPILER_REFERENCES_BYTES=bytes:tools/compiler/package_compiler/References.chibi",
            "CHIBI_PACKAGE_COMPILER_POINTERS_BYTES=bytes:tools/compiler/package_compiler/Pointers.chibi",
            "CHIBI_PACKAGE_COMPILER_SCALAR_BYTES=bytes:tools/compiler/package_compiler/Scalar.chibi",
            "CHIBI_PACKAGE_COMPILER_SEQUENCES_BYTES=bytes:tools/compiler/package_compiler/Sequences.chibi",
            "CHIBI_PACKAGE_COMPILER_TASKS_BYTES=bytes:tools/compiler/package_compiler/Tasks.chibi",
            "CHIBI_PACKAGE_COMPILER_TASKRESULTS_BYTES=bytes:tools/compiler/package_compiler/TaskResults.chibi",
            "CHIBI_PACKAGE_COMPILER_STEPS_BYTES=bytes:tools/compiler/package_compiler/Steps.chibi",
            "CHIBI_PACKAGE_COMPILER_TREE_BYTES=bytes:tools/compiler/package_compiler/Tree.chibi",
            "CHIBI_PACKAGE_GRAPH_BYTES=bytes:tools/compiler/package_graph/Graph.chibi",
            "CHIBI_PACKAGE_PATHS_BYTES=bytes:tools/compiler/package_paths/Paths.chibi",
            "CHIBI_PACKAGE_ROUTES_BYTES=bytes:tools/compiler/package_routes/Routes.chibi",
            "CHIBI_PACKAGE_SNAPSHOT_BYTES=bytes:tools/compiler/source_snapshot/Snapshot.chibi",
            "CHIBI_PACKAGE_SYNTAX_BYTES=bytes:tools/compiler/package_syntax/Extract.chibi",
            "CHIBI_PREPARED_WRITER_BYTES=bytes:tools/compiler/prepared_writer/Writer.chibi",
            "CHIBI_RECORD_MEMBERS_BYTES=bytes:tools/compiler/record_members/Members.chibi",
            "CHIBI_SCALAR_CASES_BYTES=bytes:test/scalar_facts/cases/Cases.chibi",
            "CHIBI_SCALAR_FACTS_BYTES=bytes:tools/compiler/scalar_facts/Facts.chibi",
            "CHIBI_SCALAR_IR_BYTES=bytes:tools/compiler/constant_ir/IR.chibi",
            "CHIBI_SCALAR_LLVM_BYTES=bytes:tools/compiler/scalar_llvm/Emit.chibi",
            "CHIBI_SCALAR_LOWERING_BYTES=bytes:tools/compiler/scalar_lowering/Lower.chibi",
            "CHIBI_SCALAR_PROOF_BYTES=bytes:tools/compiler/constant_admissibility/Proof.chibi",
            "CHIBI_SHADER_SOURCE_BYTES=bytes:tools/compiler/shader_source/SourceMap.chibi",
            "CHIBI_SHADER_LOWER_BYTES=bytes:tools/compiler/shader_source/Lower.chibi",
            "CHIBI_SIGNATURE_READER_BYTES=bytes:tools/compiler/signature_reader/Reader.chibi",
            "CHIBI_SOURCE_TOKENIZER_BYTES=bytes:tools/compiler/source_tokenizer/Tokenizer.chibi",
            "CHIBI_SYNTAX_DIAGNOSTICS_BYTES=bytes:tools/compiler/syntax_diagnostics/Diagnostics.chibi",
            "CHIBI_TYPE_CONSTRUCTORS_BYTES=bytes:tools/compiler/type_constructors/Constructors.chibi",
            "CHIBI_TYPE_RELATIONS_BYTES=bytes:tools/compiler/type_relations/Relations.chibi",
            "CHIBI_UNION_MEMBERS_BYTES=bytes:tools/compiler/union_members/Members.chibi",
            "CHIBI_UNIT_ALGEBRA_BYTES=bytes:tools/compiler/unit_algebra/Units.chibi",
            "CHIBI_UNIT_ANALYSIS_BYTES=bytes:tools/compiler/unit_analysis/Analysis.chibi",
            "CHIBI_BUILD_WORKFLOW_SOURCE=cstring:test/language/BuildWorkflow.chibi"
        ];
    }
    if (target == "chibi_tools_testing") {
        return ["CHIBI_EXPORT_COMPILER_ARGUMENTS=compiler:-UNDEBUG"];
    }
    return [];
}

// The program that writes a target's `build/` sources before it compiles, or
// empty: reflect writes the native type and binding tables.
pub Generator :: (target: string) -> string {
    if (target == "chibi_native_types" || target == "chibi_native_bindings") {
        return "reflect";
    }
    return "";
}

// Files a target embeds as byte arrays: `OUTPUT=SYMBOL=INPUT` writes the
// generated source OUTPUT, a `build/` path as Files names it, defining SYMBOL
// with the bytes of INPUT below the source root, as cmake/embed_binary.cmake
// does.
pub Embeds :: (target: string) -> string[] {
    if (target == "chibi_component_presentation") {
        return [
            "build/sdk/generated/authoring/engine_components.c=component_presentation_engine_kdl=src/authoring/engine_components.kdl"
        ];
    }
    if (target == "chibi_builtin_fonts") {
        return [
            "build/sdk/generated/fonts/editor_nerd_symbols_font.c=editor_nerd_symbols_font=third_party/fonts/nerd-fonts-symbols-only/SymbolsNerdFont-Regular.ttf",
            "build/sdk/generated/fonts/editor_ui_font.c=editor_ui_font=third_party/fonts/inter/Inter.ttf",
            "build/sdk/generated/fonts/editor_ui_bold_font.c=editor_ui_bold_font=third_party/fonts/inter/Inter-Bold.ttf",
            "build/sdk/generated/fonts/editor_ui_medium_font.c=editor_ui_medium_font=third_party/fonts/inter/Inter-Medium.ttf",
            "build/sdk/generated/fonts/editor_ui_semibold_font.c=editor_ui_semibold_font=third_party/fonts/inter/Inter-SemiBold.ttf",
            "build/sdk/generated/fonts/editor_ui_numeric_font.c=editor_ui_numeric_font=third_party/fonts/inter/Inter-Numeric.ttf",
            "build/sdk/generated/fonts/studio_regular_font.c=studio_regular_font=third_party/fonts/geist/Geist-Regular.ttf",
            "build/sdk/generated/fonts/studio_medium_font.c=studio_medium_font=third_party/fonts/geist/Geist-Medium.ttf",
            "build/sdk/generated/fonts/studio_semibold_font.c=studio_semibold_font=third_party/fonts/geist/Geist-SemiBold.ttf",
            "build/sdk/generated/fonts/studio_bold_font.c=studio_bold_font=third_party/fonts/geist/Geist-Bold.ttf",
            "build/sdk/generated/fonts/studio_numeric_font.c=studio_numeric_font=third_party/fonts/geist/Geist-Numeric.ttf",
            "build/sdk/generated/fonts/editor_noto_sans_font.c=editor_noto_sans_font=third_party/fonts/noto-sans/NotoSans-Regular.ttf",
            "build/sdk/generated/fonts/editor_noto_sans_semibold_font.c=editor_noto_sans_semibold_font=third_party/fonts/noto-sans/NotoSans-SemiBold.ttf",
            "build/sdk/generated/fonts/editor_noto_sans_bold_font.c=editor_noto_sans_bold_font=third_party/fonts/noto-sans/NotoSans-Bold.ttf",
            "build/sdk/generated/fonts/editor_inconsolata_font.c=editor_inconsolata_font=third_party/fonts/inconsolata/Inconsolata-Regular.ttf",
            "build/sdk/generated/fonts/editor_code_font.c=editor_code_font=third_party/fonts/jetbrains-mono/JetBrainsMono-Regular.ttf"
        ];
    }
    return [];
}

// The directory below the build directory CMake writes an executable to, as
// the CMake subdirectory that declares it or its RUNTIME_OUTPUT_DIRECTORY
// places it; empty for the build directory itself.
pub ProgramDirectory :: (target: string) -> string {
    if (target == "chibi-player" || target == "chibi-compile" || target == "chibi-build-host" ||
        target == "chibi-compiler-host" || target == "chibi") {
        return "sdk";
    }
    if (target == "chibi_ctl") {
        return "bin";
    }
    if (target == "test_language") {
        return "test/language";
    }
    if (target == "policy_worker" || target == "test_tools" || target == "benchmark_trials") {
        return "test/tools";
    }
    return "";
}

// Files a target installs into the build tree, `DESTINATION=SOURCE`, as root
// CMakeLists.txt configures them: a directory SOURCE copies every file below
// it. The launcher's players, `chibi version`, `chibi test` and `chibi doc`
// read ../share/chibi as installed ones do; chibi_ctl reads its own resources.
// build/sdk/chibi_engine_metadata.json is the build identity (Identity).
pub Resources :: (target: string) -> string[] {
    if (target == "chibi-build-host") {
        return [
            "build/share/chibi/compiler=tools/compiler",
            "build/share/chibi/core=packages/core",
            "build/share/chibi/tools/native_aot=tools/native_aot"
        ];
    }
    if (target == "chibi") {
        return [
            "build/share/chibi/engine.json=build/sdk/chibi_engine_metadata.json",
            "build/share/chibi/core/strings/Strings.chibi=packages/core/strings/Strings.chibi",
            "build/share/chibi/docs/markdown/Markdown.chibi=tools/docs/markdown/Markdown.chibi",
            "build/share/chibi/docs/site/Site.chibi=tools/docs/site/Site.chibi",
            "build/share/chibi/docs/reference/Reference.chibi=tools/docs/reference/Reference.chibi",
            "build/share/chibi/docs/grammar/Grammar.chibi=tools/docs/grammar/Grammar.chibi",
            "build/share/chibi/docs/compiler_syntax/Syntax.chibi=tools/compiler/compiler_syntax/Syntax.chibi",
            "build/share/chibi/docs/syntax_diagnostics/Diagnostics.chibi=tools/compiler/syntax_diagnostics/Diagnostics.chibi",
            "build/share/chibi/shaders=src/render/shaders"
        ];
    }
    if (target == "chibi_ctl") {
        return [
            "build/controller_resources/engine.json=build/sdk/chibi_engine_metadata.json",
            "build/controller_resources/shaders=src/render/shaders"
        ];
    }
    return [];
}

// Source lists a target's tests read, `OUTPUT=ROOT`: every .chibi file below
// ROOT, by absolute path, sorted, except Unlisted ones, as
// test/language/CMakeLists.txt writes the language corpus.
pub SourceLists :: (target: string) -> string[] {
    if (target == "test_language") {
        return ["build/test/language/corpus.txt=test/fixtures"];
    }
    return [];
}

// Sources a target's lists leave out: the originals that keep historical
// declarations for project_declarations.c's migration checks.
pub Unlisted :: (target: string) -> string[] {
    if (target == "test_language") {
        return [
            "test/fixtures/studio-declarations/OutlinerRows.chibi",
            "test/fixtures/studio-declarations/VirtualList.chibi"
        ];
    }
    return [];
}

// The artifact formats the build identity records, as
// sdk/artifact_formats.cmake lists them: `NAME SOURCE HEADER MACRO`,
// then VALUE_WIRE for a format that encodes through types/value_wire and
// EXECUTION_CODECS for the prepared function and record codecs. Paths are
// below src/.
pub ArtifactFormats :: () -> string[] {
    return [
        "execution execution/prepared.c execution/prepared.h EXECUTION_PREPARED_VERSION VALUE_WIRE EXECUTION_CODECS",
        "player runtime/player_prepared.c runtime/player_prepared.h PLAYER_PREPARED_VERSION VALUE_WIRE",
        "events runtime/event_catalog.c runtime/event_catalog.h EVENT_CATALOG_VERSION VALUE_WIRE",
        "field runtime/fields/prepared.c runtime/fields/prepared.h FIELD_PREPARED_VERSION",
        "material_fields runtime/material_field_prepared.c runtime/material_field_prepared.h MATERIAL_FIELDS_PREPARED_VERSION",
        "scene runtime/scenes/prepared.c runtime/scenes/prepared.h SCENE_PREPARED_VERSION VALUE_WIRE",
        "ui runtime/ui/documents.c runtime/ui/documents.h UI_DOCUMENT_VERSION VALUE_WIRE",
        "font runtime/ui/font.c runtime/ui/font.h UI_FONT_PREPARED_VERSION VALUE_WIRE",
        "shader runtime/shaders/prepared.c runtime/shaders/prepared.h SHADER_PREPARED_VERSION VALUE_WIRE",
        "model runtime/models/prepared.c runtime/models/prepared.h MODEL_PREPARED_VERSION VALUE_WIRE",
        "mesh runtime/geometry/mesh_prepared.c runtime/geometry/mesh_prepared.h RENDER_MESH_PREPARED_VERSION VALUE_WIRE",
        "image runtime/images/catalog.c runtime/images/catalog.h RENDER_IMAGE_PREPARED_VERSION VALUE_WIRE",
        "sky runtime/images/sky.c runtime/images/sky.h RENDER_SKY_PREPARED_VERSION VALUE_WIRE",
        "parts render/scene3d_parts.c render/scene3d_parts.h RENDER_PARTS_PREPARED_VERSION VALUE_WIRE",
        "shader_values render/shader_values.c render/shader_catalog.h SHADER_VALUES_PREPARED_VERSION"
    ];
}

// The programs an executable runs, built with it as CMake's add_dependencies
// builds them: test_tools runs the workers and tools whose paths it compiles
// in, and the launcher the compiler and player beside it.
pub Runs :: (target: string) -> string[] {
    if (target == "chibi_asset_compiler_host") {
        return ["chibi-build-host", "chibi-compiler-host"];
    }
    if (target == "chibi") {
        return ["chibi-compile", "chibi-player"];
    }
    if (target == "test_tools") {
        return ["policy_worker", "benchmark_trials", "chibi-build-host", "chibi-compiler-host", "chibi_ctl", "chibi-compile"];
    }
    return [];
}

// The executables the graph builds; every other target is a library.
pub Programs :: () -> string[] {
    programs := [
        "reflect", "chibi-build-host", "chibi-compiler-host", "chibi", "test_host", "concurrent_runner",
        "policy_worker", "benchmark_trials"
    ];
    if (build.platform() == "Darwin" || build.platform() == "Linux") {
        programs.extend(["chibi-player", "chibi-compile", "chibi_ctl", "test_language", "test_tools"]);
    }
    return programs;
}

// Whether an executable links with the C++ compiler, as CMake does when a
// library it links has C++ sources.
pub LinksCxx :: (target: string) -> bool {
    return target == "chibi-player" || target == "chibi-compile" || target == "chibi_ctl" || target == "test_language" ||
           target == "test_tools";
}

// The libraries whose objects executables link directly, as CMake's OBJECT
// libraries, rather than archive.
pub ObjectLibrary :: (target: string) -> bool {
    return target == "chibi_build_host" || target == "chibi_asset_compiler_consumer" || target == "test_behavior_consumer" ||
           Listed(ToolConsumers(), target);
}

// The object libraries an executable links, whose objects come before its
// own, as CMake orders them.
pub LinkedObjects :: (target: string) -> string[] {
    if (target == "chibi-build-host") {
        return ["chibi_build_host"];
    }
    if (target == "chibi-compiler-host") {
        return [];
    }
    if (target == "test_language") {
        return ["chibi_asset_compiler_consumer", "test_behavior_consumer"];
    }
    if (target == "test_tools") {
        return [
            "chibi_record_consumer", "chibi_prepared_consumer", "chibi_scene_consumer",
            "chibi_sdk_contracts", "chibi_shader_bake_consumer", "chibi_scene_authoring_consumer",
            "chibi_scene_snapshot_read_consumer", "chibi_native_consumer",
            "chibi_asset_values_consumer", "chibi_ui_document_consumer", "chibi_particle_consumer",
            "chibi_png_consumer", "chibi_project_document_consumer",
            "chibi_project_declarations_consumer", "chibi_render_consumer",
            "chibi_image_preparation_consumer", "chibi_mesh_preparation_consumer",
            "chibi_model_import_consumer", "chibi_source_runtime_consumer",
            "chibi_source_features_consumer", "chibi_graph_consumer", "chibi_build_host"
        ];
    }
    return [];
}

// Options an executable's link adds after the profile's, its CMake
// LINK_OPTIONS: the compiler host drops what it does not call.
pub LinkOptions :: (target: string) -> string[] {
    if ((target == "chibi-compiler-host" || target == "test_language") && build.platform() == "Darwin") {
        return ["-Wl,-dead_strip"];
    }
    if (target == "chibi-compiler-host") {
        return ["-Wl,--gc-sections"];
    }
    // SDL's interface link option, which CMake puts among the link flags.
    if (target == "chibi-player" || target == "chibi_ctl" || target == "test_tools") {
        if (build.platform() == "Linux") {
            return ["-pthread"];
        }
        return ["-lpthread"];
    }
    return [];
}

// What an executable links after its output, in CMake's order, which may
// name a library twice: the graph's libraries by name, the third-party
// archive's as `third-party/` paths, and options and framework names as they
// are.
pub Links :: (target: string) -> string[] {
    if (target == "reflect") {
        return ["chibi_capabilities", "chibi_capabilities", "chibi_types", "chibi_support", "-lm"];
    }
    if (target == "chibi-build-host") {
        return [
            "chibi_compiler_host",
            "chibi_support", "chibi_value_document", "chibi_asset_json", "chibi_language_syntax",
            "third-party/lib/chibi-vendor/libchibi_vendor_tree_sitter.a", "chibi_asset_text",
            "chibi_asset_values", "chibi_asset_kdl", "chibi_json", "chibi_native_prepared",
            "chibi_behavior_runtime", "chibi_execution", "chibi_ecs",
            "third-party/lib/chibi-vendor/libchibi_vendor_sljit.a", "chibi_events",
            "chibi_text_capabilities", "chibi_fmt", "chibi_array_capabilities", "chibi_native_capabilities",
            "chibi_capabilities", "chibi_types", "chibi_support", "-lm"
        ];
    }
    if (target == "chibi-compiler-host") {
        return [
            "chibi_compiler_host",
            "chibi_asset_text", "chibi_asset_values", "chibi_json", "chibi_asset_kdl",
            "chibi_native_prepared", "chibi_behavior_runtime", "chibi_execution", "chibi_ecs",
            "third-party/lib/chibi-vendor/libchibi_vendor_sljit.a", "chibi_events",
            "chibi_text_capabilities", "chibi_fmt", "chibi_array_capabilities", "chibi_native_capabilities",
            "chibi_capabilities", "chibi_value_document", "chibi_types", "chibi_asset_json",
            "chibi_asset_values", "chibi_json", "chibi_language_syntax", "chibi_support", "-lm",
            "third-party/lib/chibi-vendor/libchibi_vendor_tree_sitter.a"
        ];
    }
    if (target == "chibi") {
        return [
            "chibi_project_document", "chibi_support", "chibi_json", "chibi_asset_text", "chibi_asset_values",
            "chibi_asset_kdl", "chibi_language_syntax", "chibi_support", "-lm",
            "third-party/lib/chibi-vendor/libchibi_vendor_tree_sitter.a"
        ];
    }
    if (build.platform() == "Linux") {
        return LinuxLinks(target);
    }
    if (target == "chibi-player" && build.platform() == "Darwin") {
        return [
            "chibi_renderer", "chibi_player", "chibi_native_prepared", "chibi_host_native_default",
            "chibi_text_capabilities", "chibi_declared_components", "chibi_ui_host", "chibi_platform",
            "third-party/lib/chibi-vendor/libchibi_vendor_cute.a", "-framework", "IOKit", "-framework",
            "Security", "-framework", "QuartzCore", "-framework", "MetalKit", "-framework", "Network",
            "-framework", "VideoToolbox", "-framework", "CoreMedia", "-framework", "CoreVideo", "-framework",
            "CoreFoundation", "third-party/lib/chibi-vendor/libchibi_vendor_physfs_static.a", "-framework",
            "IOKit", "-framework", "Foundation", "third-party/lib/chibi-vendor/libchibi_vendor_SDL3_static.a",
            "-framework", "CoreMedia", "-framework", "CoreVideo", "-framework", "Cocoa", "-Xlinker",
            "-weak_framework", "-Xlinker", "UniformTypeIdentifiers", "-framework", "IOKit", "-framework",
            "ForceFeedback", "-framework", "Carbon", "-framework", "CoreAudio", "-framework", "AudioToolbox",
            "-framework", "AVFoundation", "-framework", "Foundation", "-framework", "GameController",
            "-framework", "Metal", "-framework", "QuartzCore", "-Xlinker", "-weak_framework", "-Xlinker",
            "CoreHaptics", "chibi_text_search", "chibi_builtin_fonts",
            "third-party/lib/chibi-vendor/libchibi_vendor_rmlui_core.a",
            "third-party/lib/chibi-vendor/libchibi_vendor_freetype.a", "chibi_engine", "chibi_scheduling",
            "chibi_ui_document_values", "chibi_ui_documents", "chibi_visual_catalog", "chibi_model_runtime",
            "-framework", "Metal", "-framework", "Foundation", "chibi_image_catalog",
            "chibi_fmt", "chibi_ui_runtime", "chibi_value_document", "chibi_asset_values", "chibi_host_native_catalog",
            "chibi_core_capabilities", "chibi_array_capabilities", "chibi_field_capabilities",
            "chibi_state_capabilities", "chibi_selection_capabilities", "chibi_set_capabilities",
            "chibi_comparison_capabilities", "chibi_conversion_capabilities", "chibi_native_bindings",
            "chibi_audio_runtime", "chibi_url_runtime",
            "chibi_vector_capabilities", "chibi_math_capabilities", "chibi_arithmetic_capabilities",
            "chibi_physics3d_runtime",
            "third-party/lib/chibi-vendor/libchibi_vendor_box3d.a", "chibi_visibility_runtime",
            "chibi_physics_runtime", "chibi_material_runtime", "chibi_shader_runtime", "chibi_mesh_runtime",
            "chibi_particle_runtime", "chibi_save_runtime", "chibi_json", "chibi_field_catalog", "chibi_fields",
            "chibi_task_pool_runtime", "third-party/lib/chibi-vendor/libchibi_vendor_enkits.a", "-lc++",
            "chibi_entity_runtime", "chibi_tilemap_runtime", "chibi_scene_runtime",
            "third-party/lib/chibi-vendor/libchibi_vendor_box2d.a", "chibi_input_runtime",
            "chibi_spatial_runtime", "chibi_native_types", "chibi_native_capabilities",
            "chibi_behavior_runtime", "chibi_execution", "chibi_ecs",
            "third-party/lib/chibi-vendor/libchibi_vendor_sljit.a", "chibi_capabilities", "chibi_events", "chibi_types",
            "chibi_support", "-lm"
        ];
    }
    if (target == "chibi-compile" && build.platform() == "Darwin") {
        return [
            "chibi_project_compilation", "chibi_project_document", "chibi_behavior_runtime", "chibi_asset_json",
            "chibi_project_format", "chibi_project_compilation", "chibi_asset_compiler_host",
            "chibi_compiler_host", "chibi_asset_json", "chibi_native_prepared",
            "chibi_shader_preparation", "chibi_player", "chibi_engine", "chibi_scheduling",
            "chibi_visual_catalog", "chibi_graph_catalog", "chibi_host_native_default",
            "chibi_host_native_catalog", "chibi_native_bindings", "chibi_audio_runtime", "chibi_url_runtime",
            "chibi_ui_runtime",
            "chibi_physics3d_runtime", "third-party/lib/chibi-vendor/libchibi_vendor_box3d.a",
            "chibi_visibility_runtime", "chibi_physics_runtime", "chibi_material_runtime",
            "chibi_entity_runtime", "chibi_tilemap_runtime", "chibi_particle_runtime", "chibi_save_runtime",
            "chibi_mesh_runtime", "third-party/lib/chibi-vendor/libchibi_vendor_box2d.a", "chibi_asset_authoring",
            "chibi_graph_compilation", "chibi_field_capabilities", "chibi_model_runtime", "chibi_field_catalog",
            "chibi_fields", "chibi_ui_authoring",
            "third-party/lib/chibi-vendor/libchibi_vendor_tree_sitter_css.a",
            "third-party/lib/chibi-vendor/libchibi_vendor_tree_sitter_html.a", "chibi_builtin_fonts",
            "chibi_ui_documents", "chibi_image_preparation", "chibi_image_catalog", "chibi_shader_runtime",
            "chibi_compiler_syntax", "chibi_compiler_json",
            "chibi_task_pool_runtime", "third-party/lib/chibi-vendor/libchibi_vendor_enkits.a", "-lc++",
            "chibi_project_document", "chibi_source_catalog",
            "chibi_ui_document", "chibi_ui_document_values", "chibi_prototype_document", "chibi_scene_document",
            "chibi_scene_runtime", "chibi_source_presentation", "chibi_graph_authoring",
            "chibi_text_capabilities", "chibi_fmt", "chibi_array_capabilities", "chibi_core_capabilities",
            "chibi_state_capabilities", "chibi_selection_capabilities", "chibi_set_capabilities",
            "chibi_comparison_capabilities", "chibi_conversion_capabilities", "chibi_vector_capabilities",
            "chibi_math_capabilities", "chibi_arithmetic_capabilities", "chibi_value_document",
            "chibi_text_source", "chibi_text_search", "chibi_graph_model", "chibi_authoring",
