cmake_minimum_required(VERSION 3.20)
include("${ROOT}/cmake/generated_file.cmake")
if(PREPARE)
    file(READ "${BUILD_DIR}/dev.json" config)
    if(CONTROLLER)
        chibi_json_string(value "${TEST_DIR}")
        string(JSON config SET "${config}" source_dir "${value}")
        file(MAKE_DIRECTORY "${TEST_DIR}/cmake" "${TEST_DIR}/src")
        file(COPY "${ROOT}/cmake/dev_build.cmake" "${ROOT}/cmake/dev_build_worker.cmake"
            "${ROOT}/cmake/dev_snapshot.cmake" "${ROOT}/cmake/generated_file.cmake" DESTINATION "${TEST_DIR}/cmake")
        file(COPY "${ROOT}/test/dev/application.c" DESTINATION "${TEST_DIR}/src")
        file(WRITE "${TEST_DIR}/src/resident.glsl" "initial resident resource\n")
        file(WRITE "${TEST_DIR}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.20)\nproject(dev_fixture C)\nadd_custom_target(chibi)\nadd_library(chibi_dll SHARED src/application.c)\ntarget_include_directories(chibi_dll PRIVATE [==[${ROOT}/include]==])\n")
        file(APPEND "${TEST_DIR}/CMakeLists.txt" "add_custom_command(TARGET chibi_dll PRE_LINK COMMAND [==[${CMAKE_COMMAND}]==] -E echo [==[Fixture build pause]==] COMMAND [==[${CMAKE_COMMAND}]==] -E sleep 2)\n")
        execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TEST_DIR}" -B "${TEST_DIR}/build" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Fixture configure failed")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" --build "${TEST_DIR}/build" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Fixture build failed")
        endif()
        if(APPLE)
            set(extension dylib)
        else()
            set(extension so)
        endif()
        chibi_json_string(value "${TEST_DIR}/build/libchibi_dll.${extension}")
        string(JSON config SET "${config}" application "${value}")
        chibi_json_string(value "${TEST_DIR}/build")
        string(JSON config SET "${config}" build_dir "${value}")
        chibi_json_string(value "${TEST_DIR}/src")
        string(JSON config SET "${config}" roots "[${value}]")
        string(JSON config SET "${config}" suffixes "[\".c\",\".glsl\"]")
    endif()
    file(WRITE "${TEST_DIR}/dev.json" "${config}")
endif()
set(DEV_CONFIG "${TEST_DIR}/dev.json")
set(RESULT "${TEST_DIR}/generation.json")
set(SKIP_BUILD ON)
include("${ROOT}/cmake/dev_build.cmake")
file(READ "${RESULT}" generation)
string(JSON status GET "${generation}" status)
if(NOT status STREQUAL "ready")
    message(FATAL_ERROR "Staging failed: ${generation}")
endif()
string(JSON application GET "${generation}" application)
file(WRITE "${TEST_DIR}/module.txt" "${application}\n")
foreach(key host directory)
    string(JSON value GET "${generation}" "${key}")
    file(WRITE "${TEST_DIR}/${key}.txt" "${value}")
endforeach()
