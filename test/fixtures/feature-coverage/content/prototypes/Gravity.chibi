package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Gravity")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Gravity", data.Object([
                    data.Field.Named("acceleration", data.Object([
                        data.Field.Named("y", data.Value.Real(-320.0))
                    ]))
                ]))
            ]))
        ])
    );
}
