// The target triple of the machine this runs on.
HostTriple :: () -> string {
    if (os.Platform() == "Windows") {
        return "x86_64-pc-windows-msvc"
    }
    if (os.Platform() == "Darwin") {
        return "aarch64-apple-darwin"
    }
    machine := strings.TrimSpace(os.Capture(["uname", "-m"]).stdout)
    if (machine == "aarch64" || machine == "arm64") {
        return "aarch64-unknown-linux-gnu"
    }
    return "x86_64-unknown-linux-gnu"
}

// Sorted source paths and their cache fingerprints. Windows metadata can miss
// same-size rewrites, so Fingerprint also hashes bytes there. Empty rejects an
// unreadable source tree rather than reusing an incompletely verified runner.
TreeInputs :: (folder: string, lines: string[]) -> string[] {
    out := lines
    listed := os.List(folder)
    if (listed.error) {
        os.Print(Join(["runner: cannot list ", folder]))
        return []
    }
    for (name in listed.names) {
        path := Join([folder, "/", name])
        if (os.IsDirectory(path)) {
            out = TreeInputs(path, out)
            if (length(out) == 0) { return out }
        } else if (strings.HasSuffix(name, ".chibi")) {
            fingerprint := files.Fingerprint(path)
            if (fingerprint == "") {
                os.Print(Join(["runner: cannot fingerprint ", path]))
                return []
            }
            out.append(Join([path, "\t", fingerprint]))
        }
    }
    return out
}

// Gather the same identity before and after a cold compile. An input changing
// while the compiler runs must not publish a runner under the earlier key.
RunnerInputs :: (configuration: string[], tools: string[]) -> string[] {
    lines := configuration
    for (tool in tools) {
        canonical := os.RealPath(tool)
        fingerprint := files.Fingerprint(canonical)
        if (canonical == "" || !os.IsFile(canonical) || fingerprint == "") {
            os.Print(Join(["runner: cannot fingerprint executable ", tool]))
            return []
        }
        lines.append(Join([canonical, "\t", fingerprint]))
    }
    for (folder in ["tools/toolchain", "tools/graph", "packages/core"]) {
        canonical := os.RealPath(Absolute(folder))
        if (canonical == "") {
            os.Print(Join(["runner: cannot resolve source tree ", folder]))
            return []
        }
        lines = TreeInputs(canonical, lines)
        if (length(lines) == 0) { return [] }
    }
    return lines
}

RemoveRunnerWork :: (path: string) -> bool {
    if (!paths.RemoveTree(path)) {
        os.Print(Join(["runner: cannot remove private compilation directory ", path]))
        return false
    }
    return true
}

// The native executable of the authored program `source` (entry `function`, with
// `collections` NAME=DIR below the checkout), compiled on first use by the native
// driver `--native-driver` with the LLVM tools in `--llvm` and kept under
// .chibi/build-runner/KEY. KEY covers the program's source and tool fingerprints,
// configuration and target. A private compilation directory is published by an
// atomic rename, so a failed build leaves nothing a later one can reuse.
Runner :: (arguments: string[], source: string, function: string, collections: string[]) -> string {
    driver := os.RealPath(os.FindExecutable(Option(arguments, "--native-driver", "")))
    llvm := os.RealPath(Option(arguments, "--llvm", ""))
    if (driver == "" || llvm == "" || !os.IsFile(driver) || !os.IsDirectory(llvm)) {
        os.Print("runner: pass an executable --native-driver and --llvm DIR")
        return ""
    }
    target := HostTriple()
    linker := "ld.lld"
    suffix := ""
    if (os.Platform() == "Darwin") {
        linker = "ld64.lld"
    } else if (os.Platform() == "Windows") {
        linker = "lld-link"
        suffix = ".exe"
    }
    configuration := ["native-runner-v2", source, function, strings.Join(collections, ","), target]
    tools := [driver, Join([llvm, "/opt", suffix]), Join([llvm, "/llc", suffix]), Join([llvm, "/", linker, suffix])]
    lines := RunnerInputs(configuration, tools)
    if (length(lines) == 0) { return "" }
    key := os.HashText(strings.Join(lines, "\n"))
    base := strings.Slice(source, strings.LastIndex(source, "/") + 1, strings.ByteLength(source))
    name := Join([strings.Slice(base, 0, strings.LastIndex(base, ".")), "-", function, suffix])
    published := Absolute(Join([".chibi/build-runner/", key]))
    program := Join([published, "/", name])
    if (os.IsFile(program)) {
        return program
    }
    if (os.MakeDirectory(Absolute(".chibi/build-runner"))) {
        os.Print("runner: cannot create .chibi/build-runner")
        return ""
    }
    reserved := os.TemporaryDirectory(Absolute(".chibi/build-runner"))
    if (reserved.error || reserved.path == "") {
        os.Print("runner: cannot reserve a private compilation directory")
        return ""
    }
    work := reserved.path
    command := [
        driver, "--compiler", Absolute("tools/compiler"), "--core", Absolute("packages/core"), "--source", Absolute(source),
        "--entry", function, "--output", Join([work, "/", name]), "--llvm", llvm, "--target", target
    ]
    for (collection in collections) {
        equals := strings.Index(collection, "=")
        command = extend(command, ["--collection", Join([strings.Slice(collection, 0, equals + 1),
                                    Absolute(strings.Slice(collection, equals + 1, strings.ByteLength(collection)))])])
    }
    built := os.Capture(command)
    if (built.status != 0) {
        os.Print(Join(["runner: ", source, " does not compile natively: ", strings.TrimSpace(built.stderr)]))
        removed := RemoveRunnerWork(work)
        return ""
    }
    if (!os.IsFile(Join([work, "/", name]))) {
        os.Print(Join(["runner: compiler did not write ", source]))
        removed := RemoveRunnerWork(work)
        return ""
    }
    checked := RunnerInputs(configuration, tools)
    if (length(checked) == 0 || os.HashText(strings.Join(checked, "\n")) != key) {
        os.Print("runner: an input changed during compilation; retry")
        removed := RemoveRunnerWork(work)
        return ""
    }
    if (os.Publish(work, published)) {
        if (!RemoveRunnerWork(work)) { return "" }
        if (!os.IsFile(program)) {
            os.Print(Join(["runner: cannot publish ", program]))
            return ""
        }
    }
    return program
}

