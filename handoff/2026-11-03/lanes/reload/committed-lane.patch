+                 Code(native.TypedFail, 0, 0, 1, 0, 0, 7),
+                 Code(native.TypedFail, 0, 0, 0, 1, 0, 7),
+                 Code(native.TypedFail, 0, 0, 0, 0, 1, 7)]) {
+        Rejects(TypedFamilyModule(item), "native typed failure has no valid failure kind");
+    }
+}
