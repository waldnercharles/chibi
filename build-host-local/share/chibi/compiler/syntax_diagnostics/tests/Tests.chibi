package syntax_diagnostics_tests

import syntax "project:syntax_diagnostics"
import parser "project:source_parser"

// Diagnostics read from parsed trees, from the former C differential (syntax_chibi.c):
// a valid source has none; a rejected one has the error node's range as its one diagnostic.
Diagnosed :: (text: string) -> syntax.Diagnostic[] {
    switch parser.Parse(text) {
        case .Parsed(nodes, fields, is_named, is_extra, root):
            return syntax.Diagnose(nodes, root);
    }
}

Rejects :: (text: string, line: int, column: int) {
    diagnostics := Diagnosed(text);
    assert(length(diagnostics) == 1, "one diagnostic");
    d := diagnostics[0];
    assert(d.line == line && d.column == column, "diagnostic position");
    assert(d.start >= 0 && d.end >= d.start, "diagnostic range");
    assert(d.message != "", "diagnostic message");
}

@test
ValidSourceHasNoDiagnostics :: () {
    assert(length(Diagnosed("package demo\n\nMain :: () {\n}\n")) == 0, "valid source");
}

@test
MissingSeparatorIsReported :: () {
    Rejects("package demo\n\nMain :: () {\n    a := 1 b := 2\n}\n", 4, 12);
}

@test
UnclosedParenIsReported :: () {
    Rejects("package demo\n\nMain :: () -> int {\n    x := (1 + 2\n    return x\n}\n", 5, 5);
}

@test
UnterminatedStringIsReported :: () {
    Rejects("package demo\n\nMain :: () {\n    s := \"open\n}\n", 4, 10);
}

@test
ImportWithoutPathIsReported :: () {
    Rejects("package demo\n\nimport project:greet\n\nMain :: () {\n}\n", 3, 8);
}
