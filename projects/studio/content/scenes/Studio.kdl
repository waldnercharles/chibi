version 1
name "Studio"
(array)entities {
    - name="GraphView" prototype="GraphView"
    - {
        name "Settings"
        prototype "Settings"
        (array)behaviors "NavKeys" "Dismiss"
    }
    - name="Data" prototype="Data"
    - name="Theme" prototype="Theme"
    - name="Inspector" prototype="Inspector"
    - name="StatusBar" prototype="StatusBar"
    - name="TopBar" prototype="TopBar"
    - {
        name "Collaboration"
        prototype "Collaboration"
        (array)behaviors "NavKeys" "Dismiss"
    }
    - {
        name "Shortcuts"
        prototype "Shortcuts"
        (array)behaviors "Dismiss"
    }
    - {
        name "NewProject"
        prototype "NewProject"
        (array)behaviors "NewProjectKeys"
    }
    - name="AreaHeader" prototype="AreaHeader"
    - name="Properties" prototype="Properties"
    - {
        name "Widgets"
        prototype "Widgets"
        (array)behaviors "VirtualList" "WidgetGallery"
    }
    - name="Members" prototype="Members"
    - name="MembersHeader" prototype="MembersHeader"
}
