package lib
pub Forward :: ($Count: int, input: $T, operation: fn(first: T, second: T) -> T, tail: T) -> T { return Apply(operation, Count, input, tail); }
Apply :: (operation: fn(first: int, second: int) -> int, $Offset: int, input: int, tail: int) -> int { return operation(second: tail + Offset, first: input); }
