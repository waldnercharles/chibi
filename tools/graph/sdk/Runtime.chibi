package sdk

import engine "graph:engine"
import os "core:os"
import strings "core:strings"
import files "graph:install"
import sha "core:hash/sha256"

// The native runtime package: its inventory, verification, assembly and
// publication over a prior installation. tools/toolchain/RuntimeSDK.chibi runs it.

pub RuntimeJoin :: (parts: string[]) -> string {
    return strings.Join(parts, "");
}
pub RuntimeOption :: (arguments: string[], name: string) -> string {
    for (index in 0..<length(arguments) - 1) {
        if (arguments[index] == name) {
            return arguments[index + 1];
        }
    }
    return "";
}
RuntimeDecimal :: (text: string) -> int {
    if (text == "") {
        return -1;
    }
    value := 0;
    for (byte in strings.Bytes(text)) {
        if (byte < 48 || byte > 57 || value > 1000000) {
            return -1;
        }
        value = value * 10 + byte - 48;
    }
    return value;
}

// The public runtime package uses the same manifest as installed consumers.
// Construction evidence comes from graph records, never a CMake build tree.
pub RuntimeFail :: (message: string) -> string {
    os.Print(RuntimeJoin(["sdk: ", message]));
    return "";
}

pub RuntimePath :: (path: string) -> bool {
    if (path == "" || path == "." || strings.HasPrefix(path, "/") ||
        strings.Contains(path, "\\") || strings.Contains(path, "//")) {
        return false;
    }
    for (part in strings.Split(path, "/")) {
        if (part == "" || part == "." || part == "..") {
            return false;
        }
    }
    return true;
}

// A canonical JSON inventory also checks that the staged tree has only real
// directories and regular files. The package manifest does not inventory itself.
pub RuntimeFiles :: (prefix: string, relative: string) -> string {
    path := prefix;
    if (relative != "") {
        path = RuntimeJoin([prefix, "/", relative]);
    }
    if (!os.IsDirectory(path)) {
        return RuntimeFail(RuntimeJoin(["not a package directory: ", path]));
    }
    keys: string[] = [];
    values: string[] = [];
    for (name in build.list_directory(path)) {
        child := name;
        if (relative != "") {
            child = RuntimeJoin([relative, "/", name]);
        }
        if (!RuntimePath(child)) {
            return RuntimeFail("invalid package file name");
        }
        item := RuntimeJoin([prefix, "/", child]);
        kind := os.Kind(item);
        if (kind == os.KindDirectory) {
            nested := RuntimeFiles(prefix, child);
            if (nested == "") {
                return "";
            }
            for (field in JsonFields(nested)) {
                keys.append(field.key);
                values.append(field.value);
            }
            continue;
        }
        if (kind != os.KindFile) {
            return RuntimeFail(RuntimeJoin(["package input is not a regular file: ", child]));
        }
        if (child == "share/chibi/package.json") {
            continue;
        }
        size := strings.Partition(strings.Partition(strings.Partition(os.Stamp(item), ":").tail, ":").tail, ":").head;
        hash := build.hash_file(item);
        if (hash == "" || JsonCanonical(size) != size || strings.HasPrefix(size, "-")) {
            return RuntimeFail(RuntimeJoin(["cannot inventory package file: ", child]));
        }
        keys.append(child);
        values.append(JsonObject(["bytes", "sha256"], [size, JsonQuote(hash)]));
    }
    return JsonObject(keys, values);
}

RuntimeHeaderHashes :: (members: string, runtime_only: bool) -> string {
    keys: string[] = [];
    values: string[] = [];
    owners := ["ui_document_values", "text_search", "image_catalog", "support", "types", "ecs",
               "execution_contract", "execution", "behavior_runtime", "events", "asset_values", "value_document",
               "capabilities", "native_capabilities", "native_prepared", "core_capabilities", "array_capabilities",
               "field_capabilities", "state_capabilities", "selection_capabilities", "set_capabilities",
               "comparison_capabilities", "conversion_capabilities", "text_capabilities", "fmt", "host_native_catalog",
               "scene_runtime", "scheduling", "fields", "field_catalog", "tasks", "shader_runtime", "model_runtime",
               "ui_documents", "input_action"];
    for (field in JsonFields(members)) {
        name := field.key;
        if (!strings.HasPrefix(name, "include/")) {
            continue;
        }
        included := !runtime_only;
        for (owner in owners) {
            included = included || strings.HasPrefix(name, RuntimeJoin(["include/chibi/", owner, "/"]));
        }
        if (included) {
            keys.append(name);
            values.append(JsonGet(field.value, "sha256"));
        }
    }
    return sha.Hex(JsonObject(keys, values));
}

RuntimeSourceIdentity :: (root: string) -> string {
    head := os.Capture(["git", "-C", root, "rev-parse", "HEAD"]);
    if (head.status != 0) {
        return RuntimeFail("cannot read source revision");
    }
    revision := strings.TrimSpace(head.stdout);
    status := os.Capture(["git", "-C", root, "status", "--porcelain", "--untracked-files=normal"]);
    if (status.status != 0) {
        return RuntimeFail("cannot read source status");
    }
    dirty := "false";
    if (status.stdout != "") {
        dirty = "true";
    }
    listing := os.Capture(["git", "-C", root, "ls-files", "-c", "-o", "--exclude-standard", "-z"]);
    if (listing.status != 0) {
        return RuntimeFail("cannot read source inventory");
    }
    names := strings.Split(listing.stdout, "\u0000");
    keys: string[] = [];
    values: string[] = [];
    for (name in names) {
        if (name == "") {
            continue;
        }
        if (!RuntimePath(name)) {
            return RuntimeFail("invalid source inventory name");
        }
        path := RuntimeJoin([root, "/", name]);
        kind := os.Kind(path);
        // Deleted tracked files do not contribute bytes, as in source_identity.
        if (kind == os.KindNone) {
            continue;
        }
        value := "";
        if (kind == os.KindLink) {
            target := os.Capture(["readlink", path]);
            if (target.status != 0) {
                return RuntimeFail("cannot read source symlink");
            }
            link := strings.TrimSuffix(target.stdout, "\n");
            value = JsonObject(["symlink"], [JsonQuote(link)]);
        } else if (kind == os.KindFile) {
            hash := build.hash_file(path);
            if (hash == "") {
                return RuntimeFail("cannot hash source input");
            }
            value = JsonQuote(hash);
        } else {
            return RuntimeFail("source inventory contains a special file");
        }
        keys.append(name);
        values.append(value);
    }
    inventory := JsonObject(keys, values);
    if (inventory == "") {
        return RuntimeFail("duplicate or invalid source inventory");
    }
    return JsonObject(["revision", "dirty", "snapshot_sha256"],
                          [JsonQuote(revision), dirty, JsonQuote(sha.Hex(inventory))]);
}

RuntimeEntries :: (root: string, build_dir: string, third_party: string) -> string[] {
    entries := [RuntimeJoin(["bin/chibi-player=", engine.Executable(build_dir, "chibi-player")])];
    for (name in RuntimeTargets()) {
        target := BuildTarget(name);
        archive := Library(name);
        if (archive != "") {
            entries.append(RuntimeJoin([archive, "=", engine.Library(root, build_dir, third_party, target).output]));
        }
        for (header in Headers(name)) {
            entries.append(RuntimeJoin(["include/chibi/", name, "/", header, "=",
                                        engine.HeaderRoot(build_dir, target, "public"), "/", header]));
        }
    }
    resources := ResourceEntries();
    resources.extend(VendorEntries(os.Platform()));
    for (item in resources) {
        entries.append(strings.ReplaceAll(strings.ReplaceAll(item, "@source", root), "@vendor", third_party));
    }
    return entries;
}

RuntimeCopy :: (source: string, destination: string, headers_only: bool) -> bool {
    kind := os.Kind(source);
    if (kind == os.KindFile) {
        if (headers_only && !VendorHeader(source)) {
            return true;
        }
        if (os.MakeDirectory(files.Parent(destination)) || os.Copy(source, destination)) {
            return false;
        }
        return true;
    }
    if (kind != os.KindDirectory || os.MakeDirectory(destination)) {
        return false;
    }
    for (name in build.list_directory(source)) {
        if (!RuntimeCopy(RuntimeJoin([source, "/", name]), RuntimeJoin([destination, "/", name]), headers_only)) {
            return false;
        }
    }
    return true;
}

RuntimeExports :: (stage: string, version: string) -> bool {
    directory := RuntimeJoin([stage, "/lib/cmake/Chibi"]);
    names := ["ChibiTargets.cmake", "ChibiVendorDependencies.cmake", "ChibiConfig.cmake", "ChibiConfigVersion.cmake"];
    texts := [Targets(os.Platform()), Vendor(os.Platform()),
              Config(version, os.Platform(), 64), ConfigVersion(version, 64)];
    if (os.MakeDirectory(directory)) {
        return false;
    }
    for (i in 0..<length(names)) {
        if (texts[i] == "" || os.WriteText(RuntimeJoin([directory, "/", names[i]]), texts[i])) {
            return false;
        }
    }
    return true;
}

// Return the canonical verified manifest, or empty without accepting the prefix.
pub RuntimeVerify :: (prefix: string) -> string {
    if (!os.IsDirectory(prefix)) {
        return "";
    }
    manifest := JsonCanonical(build.read_file(RuntimeJoin([prefix, "/share/chibi/package.json"])));
    if (manifest == "" || JsonGet(manifest, "manifest_format") != "1" ||
        JsonGet(manifest, "kind") != "\"runtime\"" ||
        JsonGet(manifest, "build_id") != JsonQuote(sha.Hex(JsonWithout(manifest, "build_id"))) ||
        JsonGet(manifest, "products") != "{\"chibi-player\":\"bin/chibi-player\"}" ||
        JsonGet(manifest, "files") != RuntimeFiles(prefix, "")) {
        return "";
    }
    document := JsonCanonical(build.read_file(RuntimeJoin([prefix, "/share/chibi/engine.json"])));
    requirements := JsonGet(manifest, "requirements");
    if (document == "" || RuntimeDecimal(JsonGet(document, "project_version")) < 1 ||
        strings.ByteLength(JsonText(JsonGet(document, "build_id"))) != 64 ||
        JsonText(JsonGet(manifest, "package_version")) == "" ||
        JsonGet(document, "project_version") != JsonGet(requirements, "project_format") ||
        JsonGet(document, "artifact_formats") != JsonGet(requirements, "artifact_formats") ||
        JsonGet(requirements, "pointer_bits") != "64" ||
        JsonGet(requirements, "system") != JsonQuote(os.Platform()) ||
        JsonGet(manifest, "engine") != JsonObject(["manifest", "build_id"],
                                                          [JsonQuote("share/chibi/engine.json"), JsonGet(document, "build_id")])) {
        return "";
    }
    expected: string[] = [];
    for (name in RuntimeTargets()) {
        expected.append(JsonQuote(RuntimeJoin(["Chibi::", name])));
    }
    if (JsonGet(manifest, "targets") != JsonArray(expected)) {
        return "";
    }
    player := RuntimeJoin([prefix, "/bin/chibi-player"]);
    if (JsonGet(JsonGet(JsonGet(manifest, "files"), "bin/chibi-player"), "bytes") == "0") {
        return "";
    }
    executable := os.Capture(["test", "-x", player]);
    if (executable.status != 0) {
        return "";
    }
    magic := os.Capture(["od", "-An", "-tx1", "-N4", player]);
    if (magic.status != 0 || strings.TrimSpace(magic.stdout) == "00 61 73 6d") {
        return "";
    }
    return manifest;
}

// Publish a prepared generation with rollback for a managed replacement.
// Exclusive moves preserve a competing destination. Replacement has a gap
// between its two moves; failed rollback retains the prior generation.
pub RuntimePublish :: (stage: string, output: string, previous: string) -> bool {
    old := RuntimeJoin([stage, "/previous"]);
    prepared := RuntimeJoin([stage, "/package"]);
    if (previous != "" && os.Publish(output, old)) {
        files.RemoveTree(stage);
        return false;
    }
    // The preimage can change after the caller's last check. Validate the tree
    // actually moved, before publishing or deleting any prior generation.
    if (previous != "" && RuntimeVerify(old) != previous) {
        if (os.Publish(old, output)) {
            os.Print(RuntimeJoin(["sdk: changed prior generation retained at ", old]));
            return false;
        }
        files.RemoveTree(stage);
        return false;
    }
    if (!os.Publish(prepared, output)) {
        if (!files.RemoveTree(stage)) {
            os.Print(RuntimeJoin(["sdk: published; remove the leftover staging directory ", stage]));
        }
        return true;
    }
    if (previous != "" && os.Publish(old, output)) {
        os.Print(RuntimeJoin(["sdk: rollback failed; prior generation retained at ", old]));
        return false;
    }
    files.RemoveTree(stage);
    return false;
}

pub RuntimeExtend :: (object: string, added_keys: string[], added_values: string[]) -> string {
    keys: string[] = [];
    values: string[] = [];
    for (field in JsonFields(object)) {
        keys.append(field.key);
        values.append(field.value);
    }
    keys.extend(added_keys);
    values.extend(added_values);
    return JsonObject(keys, values);
}

RuntimeArchiveInstallation :: (evidence: string, members: string) -> string {
    archives := JsonGet(evidence, "archives");
    keys: string[] = [];
    values: string[] = [];
    for (field in JsonFields(archives)) {
        archive := field.key;
        destination := RuntimeJoin(["lib/", strings.BaseName(archive)]);
        if (field.value != JsonGet(JsonGet(members, destination), "sha256")) {
            return RuntimeFail(RuntimeJoin(["installed archive differs from graph evidence: ", destination]));
        }
        keys.append(archive);
        values.append(JsonObject(["path"], [JsonQuote(destination)]));
    }
    return JsonObject(keys, values);
}

RuntimeManifest :: (stage: string, evidence: string, source: string) -> string {
    configured := JsonGet(evidence, "configured_engine");
    document := JsonGet(configured, "document");
    configuration := JsonGet(evidence, "runtime_build");
    profile := JsonGet(configuration, "profile");
    formats := JsonGet(document, "artifact_formats");
    engine_id := sha.Hex(evidence);
    engine_manifest := RuntimeExtend(document, ["manifest_format", "build_id"], ["1", JsonQuote(engine_id)]);
    if (engine_manifest == "" || os.MakeDirectory(RuntimeJoin([stage, "/share/chibi"])) ||
        os.WriteText(RuntimeJoin([stage, "/share/chibi/engine.json"]), RuntimeJoin([engine_manifest, "\n"]))) {
        return RuntimeFail("cannot write engine manifest");
    }
    members := RuntimeFiles(stage, "");
    if (members == "") {
        return "";
    }
    archives := RuntimeArchiveInstallation(evidence, members);
    executable := JsonGet(JsonGet(evidence, "executables"), "chibi-player");
    if (archives == "" || JsonGet(executable, "sha256") !=
        JsonGet(JsonGet(members, "bin/chibi-player"), "sha256")) {
        return RuntimeFail("installed player differs from graph evidence");
    }
    requirements := JsonObject(
        ["c_standard", "prepared_format", "artifact_formats", "project_format", "system", "processor",
         "pointer_bits", "byte_order", "public_headers_sha256", "runtime_headers_sha256"],
        ["23", JsonGet(JsonGet(formats, "execution"), "version"), formats,
         JsonGet(document, "project_version"), JsonGet(configuration, "system"),
         JsonGet(configuration, "processor"), JsonGet(configuration, "pointer_bits"),
         JsonGet(configuration, "byte_order"), JsonQuote(RuntimeHeaderHashes(members, false)),
         JsonQuote(RuntimeHeaderHashes(members, true))]);
    build_manifest := JsonObject(
        ["inputs", "archive_installation", "configuration", "compiler_id", "compiler_version",
         "compiler_target", "c_flags", "configuration_c_flags", "native_backend"],
        [evidence, archives, JsonGet(profile, "build_type"), JsonGet(profile, "compiler_id"),
         JsonGet(configuration, "compiler_version"), "null",
         JsonQuote(""), JsonQuote(""), "true"]);
    targets: string[] = [];
    for (name in RuntimeTargets()) {
        targets.append(JsonQuote(RuntimeJoin(["Chibi::", name])));
    }
    manifest := JsonObject(
        ["manifest_format", "kind", "package_version", "engine", "source", "files", "targets",
         "products", "private_tools", "requirements", "build"],
        ["1", JsonQuote("runtime"), JsonGet(document, "sdk_version"),
         JsonObject(["manifest", "build_id"], [JsonQuote("share/chibi/engine.json"), JsonQuote(engine_id)]),
         source, members, JsonArray(targets), "{\"chibi-player\":\"bin/chibi-player\"}", "{}",
         requirements, build_manifest]);
    if (manifest == "") {
        return RuntimeFail("invalid package manifest fields");
    }
    return RuntimeExtend(manifest, ["build_id"], [JsonQuote(sha.Hex(manifest))]);
}

RuntimeInputTree :: (path: string, headers_only: bool) -> string {
    kind := os.Kind(path);
    if (kind == os.KindFile) {
        hash := build.hash_file(path);
        if (hash == "") {
            return "";
        }
        return JsonQuote(hash);
    }
    if (kind != os.KindDirectory) {
        return "";
    }
    keys: string[] = [];
    values: string[] = [];
    for (name in build.list_directory(path)) {
        child := RuntimeJoin([path, "/", name]);
        if (headers_only && os.IsFile(child) && !VendorHeader(child)) {
            continue;
        }
        value := RuntimeInputTree(child, headers_only);
        if (value == "") {
            return "";
        }
        keys.append(name);
        values.append(value);
    }
    return JsonObject(keys, values);
}

RuntimeInputIdentity :: (entries: string[]) -> string {
    keys: string[] = [];
    values: string[] = [];
    for (item in entries) {
        destination := strings.Partition(item, "=").head;
        value := RuntimeInputTree(strings.Partition(item, "=").tail, strings.HasPrefix(destination, "include/chibi/vendor/"));
        if (value == "") {
            return RuntimeFail(RuntimeJoin(["invalid distribution input: ", strings.Partition(item, "=").tail]));
        }
        keys.append(destination);
        values.append(value);
    }
    return JsonObject(keys, values);
}

pub RuntimeAssemble :: (root: string, build_dir: string, third_party: string, output: string) -> int {
    if (!Supported(os.Platform())) {
        RuntimeFail("runtime graph installation is unavailable on this platform");
        return 2;
    }
    if (!strings.HasPrefix(build_dir, "/") || !strings.HasPrefix(third_party, "/") ||
        !strings.HasPrefix(output, "/") || strings.HasSuffix(output, "/") ||
        strings.HasSuffix(output, "/.") || strings.HasSuffix(output, "/..")) {
        RuntimeFail("--build, --third-party and --output must be absolute; output must name a package");
        return 2;
    }
    // Graph records name the paths the build was given; only overlap checks resolve links.
    recorded_root := root;
    recorded_build := build_dir;
    recorded_third_party := third_party;
    root = files.CanonicalPath(root);
    build_dir = files.CanonicalPath(build_dir);
    third_party = files.CanonicalPath(third_party);
    output = files.CanonicalPath(output);
    if (root == "" || build_dir == "" || third_party == "" || output == "" ||
        root == output || strings.HasPrefix(root, RuntimeJoin([output, "/"])) ||
        build_dir == output || strings.HasPrefix(output, RuntimeJoin([build_dir, "/"])) ||
        strings.HasPrefix(build_dir, RuntimeJoin([output, "/"]))) {
        RuntimeFail("package output overlaps source/build ancestry");
        return 2;
    }
    previous := "";
    if (os.Kind(output) != os.KindNone) {
        previous = RuntimeVerify(output);
        if (previous == "") {
            RuntimeFail("existing output is not a verified runtime package");
            return 2;
        }
    }
    stage := files.CanonicalPath(RuntimeJoin([output, ".chibi-stage"]));
    if (stage == "") {
        RuntimeFail("invalid staging directory ancestor");
        return 2;
    }
    entries := RuntimeEntries(root, build_dir, third_party);
    for (item in entries) {
        input := strings.Partition(item, "=").tail;
        if (!RuntimePath(strings.Partition(item, "=").head) ||
            (os.IsDirectory(input) && (files.Inside(output, input) || files.Inside(stage, input)))) {
            RuntimeFail("output or staging overlaps a distribution input");
            return 2;
        }
    }
    evidence := GraphEvidence(recorded_root, recorded_build, recorded_third_party);
    source := RuntimeSourceIdentity(root);
    inputs := RuntimeInputIdentity(entries);
    if (evidence == "" || source == "" || inputs == "") {
        return 1;
    }
    if (os.MakeDirectory(files.Parent(output)) || os.Reserve(stage)) {
        RuntimeFail("cannot reserve staging directory; existing staging is preserved");
        return 1;
    }
    prepared := RuntimeJoin([stage, "/package"]);
    copied := !os.MakeDirectory(prepared);
    for (item in entries) {
        destination := strings.Partition(item, "=").head;
        if (copied) {
            copied = RuntimeCopy(strings.Partition(item, "=").tail, RuntimeJoin([prepared, "/", destination]),
                                 strings.HasPrefix(destination, "include/chibi/vendor/"));
        }
    }
    manifest := "";
    if (copied && RuntimeExports(prepared, engine.SDKVersion(root))) {
        manifest = RuntimeManifest(prepared, evidence, source);
    }
    if (manifest == "" || os.WriteText(RuntimeJoin([prepared, "/share/chibi/package.json"]), RuntimeJoin([manifest, "\n"])) ||
        RuntimeVerify(prepared) != manifest || GraphEvidence(recorded_root, recorded_build, recorded_third_party) != evidence ||
        RuntimeSourceIdentity(root) != source || RuntimeInputIdentity(entries) != inputs ||
        (previous == "" && os.Kind(output) != os.KindNone) ||
        (previous != "" && RuntimeVerify(output) != previous)) {
        files.RemoveTree(stage);
        RuntimeFail("runtime package preparation failed; output preserved");
        return 1;
    }
    if (!RuntimePublish(stage, output, previous)) {
        RuntimeFail("runtime package publication failed");
        return 1;
    }
    os.Print(RuntimeJoin(["sdk: installed runtime at ", output]));
    return 0;
}
