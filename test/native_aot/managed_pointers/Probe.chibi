package managed_pointer_probe

import native "project:llvm_native"
import abi "project:native_abi"
import host "project:native_link_host"
import link "project:native_link"
import os "core:os"
import strings "core:strings"

Main :: () -> int {
    args := os.Arguments();
    if (length(args) != 3) { return 2; }
    work := args[0];
    llvm := args[1];
    fixture := os.ReadText(args[2]);
    if (fixture.error) { return 2; }
    target := abi.LinuxX64();
    if (os.Platform() == "Darwin") { target = abi.MacOSArm64(); }
    for (mode in ["positive", "cross_owner", "wrong_pop", "callback_defers", "callback_underflow", "callback_overflow", "callback_construct_sweep", "callback_nested_constructor"]) {
        module := format_text("{}/collector-{}.ll", work, mode);
        text := strings.Join([format_text("target triple = \"{}\"\n", target.triple), native.ManagedRuntime(), fixture.text,
            format_text("\ndefine i32 @main() {{ %result = call i32 @managed_test.{}()\n ret i32 %result\n}}\n", mode)], "");
        if (os.WriteText(module, text) != nil) { return 2; }
        for (level in [int(0), 2]) {
            object := format_text("{}/collector-{}-O{}.o", work, mode, level);
            output := format_text("{}/collector-{}-O{}", work, mode, level);
            compiled := host.Objects(llvm, [module], [object], level, 1);
            if (compiled) { os.Print("LLVM did not compile the managed collector"); return 1; }
            plan := link.Program(target.triple, llvm, [object], [], [], [], output, "", false);
            if (os.Platform() == "Darwin") {
                libsystem: link.Import = {name: "System", symbols: ["malloc", "free", "printf", "abort"]};
                plan.imports = [libsystem];
            }
            linked := host.Link(plan);
            if (linked) { os.Print("The managed collector did not link"); return 1; }
            result := os.Capture([output]);
            positive := mode == "positive" || mode == "callback_defers" || mode == "callback_nested_constructor";
            valid := positive && result.status == 0;
            if (!positive) { valid = result.status != 0; }
            if (mode == "callback_construct_sweep") {
                valid = result.status == -4 || result.status == -5 || result.status == 132 || result.status == 133;
            }
            if (!valid) {
                os.Print(format_text("managed collector {} O{}: status {}, {}{}", mode, level,
                                     result.status, result.stdout, result.stderr));
                return 1;
            }
            os.Print(format_text("PASS native managed collector {} O{}", mode, level));
        }
    }
    return 0;
}
