version 3
name "ProfileRing"
domain "model"
id_counter 10
description "A circle centered at positive radial distance revolves into the same surface as an analytical torus."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Profile Circle"
                inputs {
                    Radius 7.0
                    Center {
                        default x=24.0 y=0.0
                    }
                }
            }
            - id=7 type="Model Revolve"
        }
        (array)edges {
            - from="3.Profile" to="7.Profile"
            - from="7.Geometry" to="1.Geometry"
        }
    }
}
