static const char BOUNDED_PREPARE_SOURCE[] = { @CHIBI_BOUNDED_PREPARE_BYTES@ 0 };

#define BOUNDED_SOURCE(PATH, VALUE) { PATH, VALUE, sizeof VALUE - 1 }
#define BOUNDED_COMPILER_SOURCE_INPUTS \
    BOUNDED_SOURCE("analysis_state/State.chibi", ANALYSIS_STATE_CHIBI_SOURCE), \
    BOUNDED_SOURCE("signature_reader/Reader.chibi", SIGNATURE_READER_CHIBI_SOURCE), \
