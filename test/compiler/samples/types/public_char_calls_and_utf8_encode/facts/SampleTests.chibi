package facts

// public char calls and UTF8 encode
@test
Calls :: () {
    a1_0: int = 0;
    r1: u8[] = Encode(a1_0);
    e1: u8[] = [0];
    assert(length(r1) == length(e1), "Encode call 1 length");
    for k in 0..<length(e1) {
        assert(r1[k] == e1[k], "Encode call 1 element");
    }
    a2_0: int = 127;
    r2: u8[] = Encode(a2_0);
    e2: u8[] = [127];
    assert(length(r2) == length(e2), "Encode call 2 length");
    for k in 0..<length(e2) {
        assert(r2[k] == e2[k], "Encode call 2 element");
    }
    a3_0: int = 128;
    r3: u8[] = Encode(a3_0);
    e3: u8[] = [194, 128];
    assert(length(r3) == length(e3), "Encode call 3 length");
    for k in 0..<length(e3) {
        assert(r3[k] == e3[k], "Encode call 3 element");
    }
    a4_0: int = 2047;
    r4: u8[] = Encode(a4_0);
    e4: u8[] = [223, 191];
    assert(length(r4) == length(e4), "Encode call 4 length");
    for k in 0..<length(e4) {
        assert(r4[k] == e4[k], "Encode call 4 element");
    }
    a5_0: int = 2048;
    r5: u8[] = Encode(a5_0);
    e5: u8[] = [224, 160, 128];
    assert(length(r5) == length(e5), "Encode call 5 length");
    for k in 0..<length(e5) {
        assert(r5[k] == e5[k], "Encode call 5 element");
    }
    a6_0: int = 55295;
    r6: u8[] = Encode(a6_0);
    e6: u8[] = [237, 159, 191];
    assert(length(r6) == length(e6), "Encode call 6 length");
    for k in 0..<length(e6) {
        assert(r6[k] == e6[k], "Encode call 6 element");
    }
    a7_0: int = 57344;
    r7: u8[] = Encode(a7_0);
    e7: u8[] = [238, 128, 128];
    assert(length(r7) == length(e7), "Encode call 7 length");
    for k in 0..<length(e7) {
        assert(r7[k] == e7[k], "Encode call 7 element");
    }
    a8_0: int = 65535;
    r8: u8[] = Encode(a8_0);
    e8: u8[] = [239, 191, 191];
    assert(length(r8) == length(e8), "Encode call 8 length");
    for k in 0..<length(e8) {
        assert(r8[k] == e8[k], "Encode call 8 element");
    }
    a9_0: int = 65536;
    r9: u8[] = Encode(a9_0);
    e9: u8[] = [240, 144, 128, 128];
    assert(length(r9) == length(e9), "Encode call 9 length");
    for k in 0..<length(e9) {
        assert(r9[k] == e9[k], "Encode call 9 element");
    }
    a10_0: int = 1114111;
    r10: u8[] = Encode(a10_0);
    e10: u8[] = [244, 143, 191, 191];
    assert(length(r10) == length(e10), "Encode call 10 length");
    for k in 0..<length(e10) {
        assert(r10[k] == e10[k], "Encode call 10 element");
    }
    a11_0: int = 128008;
    r11: int = NamedRead(a11_0);
    e11: int = 128008;
    assert(r11 == e11, "NamedRead call 11");
}
