package facts
Guard :: () -> int {
    if (7 < 3) { return 1; }
    return 2;
}
Wide :: () -> bool { return 3000000000 > 2; }
Mixed :: () -> bool { return 2.5 > 2; }
ReverseMixed :: () -> bool { return 2 < 2.5; }
FalseMixed :: () -> bool { return 2.5 < 2; }
RoundedMixed :: () -> bool { return 16777217 == 16777216.0; }
NegativeMixed :: () -> bool { return -2 > -2.5; }
Product :: () -> bool { return 6 * 7 == 42; }
ReverseProduct :: () -> bool { return 42 == 6 * 7; }
NestedProduct :: () -> bool { return 2 * (3 + 4) == 14; }
FalseProduct :: () -> bool { return 6 * 7 == 43; }
WideSum :: () -> bool { return 3000000000 + 2 == 3000000002; }
MixedSum :: () -> bool { return 2.5 + 1 == 3.5; }
ShiftedProduct :: () -> bool { return (48 >> 1) == (6 * 4); }
Negative :: () -> bool { return -1 < 0; }
Same :: () -> bool { return 7 == 7; }
