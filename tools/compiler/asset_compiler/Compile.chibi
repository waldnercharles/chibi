package asset_compiler

import compiler "project:package_compiler"
import routes "project:package_routes"
import binding "project:lexical_binding"
import source "project:asset_source"
import packaging "project:asset_packaging"
import syntax "project:syntax_diagnostics"
import strings "core:strings"
import costs "project:cost_explanations"

pub ExplainCosts :: (functions: costs.Function[], values: costs.Cost[], json: bool) -> u8[] {
    return costs.Report(functions, values, json);
}

pub Write :: (kinds: int[], parents: int[], keys: string[], texts: string[],
              signed: i64[], unsigned: u64[], reals: f64[], booleans: bool[]) -> u8[] {
    return source.Write(kinds, parents, keys, texts, signed, unsigned, reals, booleans);
}

pub ValidatePrototype :: (kinds: int[], parents: int[], keys: string[], texts: string[],
                          signed: i64[], unsigned: u64[], reals: f64[], booleans: bool[]) -> string {
    return source.ValidatePrototype(kinds, parents, keys, texts, signed, unsigned, reals, booleans);
}

pub Expression :: (kinds: int[], parents: int[], keys: string[], texts: string[],
                   signed: i64[], unsigned: u64[], reals: f64[], booleans: bool[]) -> u8[] {
    return source.Expression(kinds, parents, keys, texts, signed, unsigned, reals, booleans);
}

pub Inspect :: (text: string, function_name: string) -> source.Inspection {
    return source.Inspect(text, function_name);
}

pub DeclarationNameRange :: (text: string) -> int[] {
    return source.DeclarationNameRange(text);
}

pub Classify :: (text: string) -> bool {
    return source.Classify(text);
}

pub Field :: (text: string, component: string, field_path: string) -> source.FieldSource {
    return source.Field(text, component, field_path);
}

pub Packaged :: (paths: string[], sources: string[]) -> u8[] {
    return packaging.Packaged(paths, sources);
}

pub Parameters :: (text: string) -> u8[] {
    return source.Parameters(text);
}

pub SetParameter :: (text: string, name: string, kind: int, value_text: string,
                     signed: i64, unsigned: u64, real: f64, boolean: bool) -> u8[] {
    return source.SetParameter(text, name, kind, value_text, signed, unsigned, real, boolean);
}

pub Reconcile :: (text: string, old_kinds: int[], old_parents: int[], old_keys: string[], old_texts: string[],
                  old_signed: i64[], old_unsigned: u64[], old_reals: f64[], old_booleans: bool[],
                  new_kinds: int[], new_parents: int[], new_keys: string[], new_texts: string[],
                  new_signed: i64[], new_unsigned: u64[], new_reals: f64[], new_booleans: bool[]) -> u8[] {
    return source.Reconcile(text, old_kinds, old_parents, old_keys, old_texts, old_signed, old_unsigned,
                            old_reals, old_booleans, new_kinds, new_parents, new_keys, new_texts,
                            new_signed, new_unsigned, new_reals, new_booleans);
}

pub ReconcileNative :: (text: string, old_kinds: int[], old_parents: int[], old_keys: string[], old_texts: string[],
                        old_signed: i64[], old_unsigned: u64[], old_reals: f64[], old_booleans: bool[],
                        new_kinds: int[], new_parents: int[], new_keys: string[], new_texts: string[],
                        new_signed: i64[], new_unsigned: u64[], new_reals: f64[], new_booleans: bool[]) -> u8[] {
    return source.ReconcileNative(text, old_kinds, old_parents, old_keys, old_texts, old_signed, old_unsigned,
                                  old_reals, old_booleans, new_kinds, new_parents, new_keys, new_texts,
                                  new_signed, new_unsigned, new_reals, new_booleans);
}

pub Materialize :: (text: string, kinds: int[], parents: int[], keys: string[], texts: string[],
                    signed: i64[], unsigned: u64[], reals: f64[], booleans: bool[]) -> u8[] {
    return source.Materialize(text, kinds, parents, keys, texts, signed, unsigned, reals, booleans);
}

Entry :: (project: string, collection_names: string[], collection_paths: string[], path: string) -> u64 {
    collections: routes.Collection[] = [];
    index: int = 0;
    while (index < length(collection_names)) {
        collections.append({name: collection_names[index], path: collection_paths[index],
                            has_name: true, has_path: true});
        index += 1;
    }
    switch routes.RootSet(project, true, collections) {
        case .Rejected(diagnostic):
            return 0;
        case .Accepted(roots):
            switch routes.FileRoute(roots, path, true, 0) {
                case .Rejected(diagnostic):
                    return 0;
                case .Accepted(file):
                    return binding.ID("package-symbol", format_text("{}:1:Build:callable", file.identity));
            }
    }
}

// Asset packages use the normal authored compiler, imports and type checker.
// The embedding host supplies its explicit source snapshot and target/catalog
// facts. This facade preserves compile diagnostics without JSON interpretation
// or generated source. The compiled public Build entry returns owned byte[].
pub Compile :: (project: string, collection_names: string[], collection_paths: string[], paths: string[],
                sources: string[], debug: bool, target: compiler.Target, abi: u64, names: string[],
                natives: compiler.Native[], ports: compiler.Port[], identities: u64[])
-> (entry_id: u64, prepared: u8[], error: syntax.Diagnostic?) {
    compiled := compiler.Compile(project, collection_names, collection_paths, paths, sources, debug, target, abi,
                                 names, natives, ports, identities);
    diagnostic := compiled.error;
    if (diagnostic) {
        return (0, [], diagnostic);
    }
    return (Entry(project, collection_names, collection_paths, paths[0]), compiled.bytes, nil);
}

// Package compiles take the host's reflected catalog: its native capabilities
// with their nominal ports, its native types and fields, the entity type and
// each native's effect mask. The closure is the compiled root package and the
// packages it imports, empty when the input is rejected.
pub CompilePackages :: (project: string, collection_names: string[], collection_paths: string[], paths: string[],
                        sources: string[], debug: bool, target: compiler.Target, abi: u64, names: string[],
                        natives: compiler.CatalogNative[], ports: compiler.CatalogPort[], identities: u64[],
                        types: compiler.GameType[], type_fields: compiler.GameField[], entity: u64,
                        os: int, arch: int, native_effects: int[]) -> u8[] {
    return compiler.CompileClosureWithCatalog(project, collection_names, collection_paths, paths, sources, debug,
                                              target, abi, names, natives, ports, identities, types, type_fields,
                                              entity, os, arch, native_effects);
}
// The host reads a rejection's payload by position.
pub Rejection :: union {
    Accepted
    | Rejected(document: int, line: int, column: int, message: string)
}

// The first diagnostic CompilePackages' input is rejected with.
pub RejectPackages :: (project: string, collection_names: string[], collection_paths: string[], paths: string[],
                       sources: string[], debug: bool, target: compiler.Target, abi: u64, names: string[],
                       natives: compiler.CatalogNative[], ports: compiler.CatalogPort[], identities: u64[],
                       types: compiler.GameType[], type_fields: compiler.GameField[], entity: u64,
                       os: int, arch: int, native_effects: int[]) -> Rejection {
    compiled := compiler.CompileWithCatalog(project, collection_names, collection_paths, paths, sources, debug,
                                            target, abi, names, natives, ports, identities, types, type_fields,
                                            entity, os, arch, native_effects);
    diagnostic := compiled.error;
    if (diagnostic) {
        return Rejection.Rejected(diagnostic.document, diagnostic.line, diagnostic.column, diagnostic.message);
    }
    return Rejection.Accepted;
}

// Native transport envelope: status byte, entry uint64 LE, five int32 LE
// source fields (document/start/end/line/column), then prepared bytes or UTF-8
// diagnostic text. The native adapter only decodes this fixed 29-byte header.
pub CompileBytes :: (project: string, collection_names: string[], collection_paths: string[], paths: string[],
                     sources: string[], debug: bool, target: compiler.Target, abi: u64, names: string[],
                     natives: compiler.Native[], ports: compiler.Port[], identities: u64[]) -> u8[] {
    compiled := Compile(project, collection_names, collection_paths, paths, sources, debug, target, abi,
                        names, natives, ports, identities);
    diagnostic := compiled.error;
    positions: int[] = [-1, 0, 0, 0, 0];
    message: string = "";
    out: u8[] = [1];
    if (diagnostic) {
        out[0] = 0;
        positions = [diagnostic.document, diagnostic.start, diagnostic.end, diagnostic.line, diagnostic.column];
        message = diagnostic.message;
    }
    wide := compiled.entry_id;
    index: int = 0;
    while (index < 8) {
        out.append(u8(wide & 255));
        wide = wide >> 8;
        index += 1;
    }
    for (position in positions) {
        bits := u32(wrap: position);
        index = 0;
        while (index < 4) {
            out.append(u8(bits & 255));
            bits = bits >> 8;
            index += 1;
        }
    }
    if (diagnostic) {
        for (part in strings.Bytes(message)) {
            out.append(u8(part));
        }
        return out;
    }
    max_prepared: int = 16777187;
    assert(length(compiled.prepared) <= max_prepared, "Compiled asset exceeds transport byte quota");
    out.extend(compiled.prepared);
    return out;
}
