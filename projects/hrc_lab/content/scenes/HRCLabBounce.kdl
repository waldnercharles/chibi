version 1
name "HRCLabBounce"
(array)entities {
    - {
        name "Camera"
        prototype "HRCLabCamera"
        components {
            GameTransform x=0.0 y=0.0
        }
    }
    - {
        name "HRC"
        prototype "HRCLabHRC"
        components {
            GameTransform x=0.0 y=0.0
        }
    }
    - {
        name "Emitter"
        prototype "HRCLabEmitter"
        components {
            GameTransform x=-340.0 y=-150.0
            GameAppearance width=24.0 height=24.0 shape="Circle"
        }
    }
    - {
        name "First reflector"
        prototype "HRCLabReceiver"
        components {
            GameTransform x=-150.0 y=-80.0
            GameAppearance width=180.0 height=24.0
            GameOrientation radians=0.45
        }
    }
    - {
        name "Second reflector"
        prototype "HRCLabReceiver"
        components {
            GameTransform x=80.0 y=70.0
            GameAppearance width=180.0 height=24.0
            GameOrientation radians=-0.45
        }
    }
    - {
        name "Receiver"
        prototype "HRCLabReceiver"
        components {
            GameTransform x=320.0 y=0.0
            GameAppearance width=100.0 height=380.0
        }
    }
    - {
        name "Backdrop"
        prototype "HRCLabReceiver"
        components {
            GameTransform x=0.0 y=0.0
            GameAppearance width=960.0 height=540.0 shape="Box" layer=-100
            GameMaterial absorption=0.0 albedo=0xd0d0d0ff scene=0x6b6b6bff edge_light=0.0
        }
    }
}
