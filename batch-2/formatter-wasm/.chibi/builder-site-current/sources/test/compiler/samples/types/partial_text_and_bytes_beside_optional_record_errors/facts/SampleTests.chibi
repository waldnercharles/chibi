package facts

// partial text and bytes beside optional record errors
@test
Calls :: () {
    a1_0: bool = false;
    r1: int = Use(a1_0);
    e1: int = 8;
    assert(r1 == e1, "Use call 1");
    a2_0: bool = true;
    r2: int = Use(a2_0);
    e2: int = 347;
    assert(r2 == e2, "Use call 2");
    r3: int = UseDefaults();
    e3: int = 0;
    assert(r3 == e3, "UseDefaults call 3");
    a4_0: bool = false;
    r4: int = Guarded(a4_0);
    e4: int = 0;
    assert(r4 == e4, "Guarded call 4");
    a5_0: bool = true;
    r5: int = Guarded(a5_0);
    e5: int = 7;
    assert(r5 == e5, "Guarded call 5");
}
