package os_tests

import bytes "core:bytes"
import os "core:os"
import strings "core:strings"

// core:os over the build host's natives: bytes cross files unchanged.

BytesRoundTripIncludingNulAndInvalidUtf8 :: () {
    made := os.TemporaryDirectory(os.Root());
    assert(made.error == nil, "a private scratch directory beside the checkout");
    directory := made.path;
    path := format_text("{}/data", directory);
    data: u8[] = [0, 255, 10, 13, 128, 0, 65];
    assert(os.WriteBytes(path, data) == nil, "bytes are written");
    read := os.ReadBytes(path);
    assert(read.error == nil && bytes.Equal(read.data, data), "bytes read back unchanged");
    empty: u8[] = [];
    assert(os.WriteBytes(path, empty) == nil, "an empty file is written");
    again := os.ReadBytes(path);
    assert(again.error == nil && length(again.data) == 0, "an empty file reads as no bytes");
    removed := os.Remove(path);
    assert(removed == nil, "remove the scratch file");
    removed = os.Remove(directory);
    assert(removed == nil, "remove the scratch directory");
}

TemporaryDirectoriesAreDistinctAndFallible :: () {
    first := os.TemporaryDirectory(os.Root());
    second := os.TemporaryDirectory(os.Root());
    assert(first.error == nil && second.error == nil && first.path != second.path,
           "each caller owns a distinct directory");
    published := format_text("{}.published", first.path);
    moved := os.Publish(first.path, published);
    assert(moved == nil && os.IsDirectory(published) && !os.Exists(first.path),
           "a temporary directory publishes on its parent's filesystem");
    missing := os.TemporaryDirectory(format_text("{}/missing/parent", second.path));
    assert(missing.error != nil && missing.path == "", "a missing parent reports an error");
    removed := os.Remove(published);
    assert(removed == nil, "remove the published private directory");
    removed = os.Remove(second.path);
    assert(removed == nil, "remove the second private directory");
}

MissingFileReportsNotFound :: () {
    read := os.ReadBytes("/definitely/missing/file");
    assert(read.error != nil && length(read.data) == 0, "no bytes for a missing file");
}

pub Run :: () -> int {
    BytesRoundTripIncludingNulAndInvalidUtf8();
    TemporaryDirectoriesAreDistinctAndFallible();
    MissingFileReportsNotFound();
    return 0;
}
