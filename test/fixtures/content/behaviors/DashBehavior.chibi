behavior "DashBehavior" {
    state "Just Started" := false
    state "Struck Entities": handle<"ecs.entity">[] = []
    on Dash {
        if greater_or_equal(delta_time(), get_game_dash().Value.cooldown_remaining) {
            if greater_or_equal(0.0, get_game_dash().Value.remaining) {
                await "Start Dash"()
            }
        }
    }
    on Tick {
        await "Advance Dash Timers"()
        if less(0.0, get_game_dash().Value.remaining) {
            await "Drive Dash"()
        }
    }
    on "Contact Begin" {
        await "Strike Target"(event.Other)
    }
    function "Capture Dash Direction"() {
        after entry {
            if greater_or_equal(add(abs(break_cf_v2(get_game_input().Value.move).x), abs(break_cf_v2(get_game_input().Value.move).y)), 0.0001) {
                await set_game_dash_direction(vec2_norm(get_game_input().Value.move))
                return
            } else {
                await set_game_dash_direction(vec2_norm(get_game_aim().Value.direction))
                return
            }
        }
    }
    function "Drive Dash"() {
        after entry {
            await set_game_velocity(multiply(get_game_dash().Value.direction, get_game_dash().Value.speed))
            await set_game_orientation("DirectionMath"."Direction Orientation"(break_cf_v2(get_game_dash().Value.direction).x, break_cf_v2(get_game_dash().Value.direction).y))
            return
        }
    }
    function "Restore Movement"() {
        after entry {
            if has_game_input() {
                await set_game_velocity("MovementActions"."Movement Velocity"(get_game_input().Value.move, get_game_movement()))
                return
            } else {
                await set_game_velocity({
                    x: 0.0,
                    y: 0.0
                })
                return
            }
        }
    }
    function "Advance Dash"() {
        action set_gamedash_remaining = set_game_dash_remaining(max(subtract(get_game_dash().Value.remaining, delta_time()), B: float = 0.0))
        after entry {
            set_gamedash_remaining()
        }
        after set_gamedash_remaining {
            if less(0.0, set_gamedash_remaining.Value.remaining) {
                return
            } else {
                await "Restore Movement"()
                return
            }
        }
    }
    function "Advance Dash Timers"() {
        after entry {
            if get_variable<"Just Started">() {
                await set_variable<"Just Started">(false)
                return
            } else {
                await set_game_dash_cooldown_remaining(max(subtract(get_game_dash().Value.cooldown_remaining, delta_time()), B: float = 0.0))
                if less(0.0, get_game_dash().Value.remaining) {
                    await "Advance Dash"()
                    return
                } else {
                    return
                }
            }
        }
    }
    function "Strike Target"(Other: handle<"ecs.entity"> = 0) {
        after entry {
            if less(0.0, get_game_dash().Value.remaining) {
                if has_entity_game_health(entry.Other) {
                    if has_entity_game_collider(entry.Other) {
                        if has_any_flags(get_entity_game_collider(entry.Other).Value.category, 2) {
                            if contains(get_variable<"Struck Entities">(), entry.Other) {
                                return
                            } else {
                                await set_variable<"Struck Entities">(array_add(get_variable<"Struck Entities">(), entry.Other))
                                await send_event<"Damage">(entry.Other, get_game_dash().Value.damage, self)
                                return
                            }
                        } else {
                            return
                        }
                    } else {
                        return
                    }
                } else {
                    return
                }
            } else {
                return
            }
        }
    }
    function "Strike Current Contacts"() {
        after entry {
            foreach (foreach_2 in get_contact_entities(self, 2)) {
                await "Strike Target"(foreach_2)
            }
            return
        }
    }
    function "Start Dash"() {
        after entry {
            if integer_greater_or_equal(get_game_health().Value.current, 1) {
                await "Capture Dash Direction"()
                await set_game_dash_remaining(get_game_dash().Value.duration)
                await set_game_dash_cooldown_remaining(get_game_dash().Value.cooldown)
                await set_variable<"Just Started">(true)
                await set_variable<"Struck Entities">([])
                await "Strike Current Contacts"()
                return
            } else {
                return
            }
        }
    }
}
