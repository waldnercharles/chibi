package llvm_native

import abi "project:native_abi"
import strings "core:strings"

ClockRecord :: (records: Record[], fields: int[], type: int) -> bool {
    if (type < RecordType || type >= ArrayType || !Index(type - RecordType, length(records))) { return false; }
    record := records[type - RecordType];
    return record.count == 4 && fields[record.first] == 8 && fields[record.first + 1] == abi.WordStorage &&
           fields[record.first + 2] == abi.IntStorage && fields[record.first + 3] == abi.IntStorage;
}
HasClockSample :: (code: Instruction[]) -> bool {
    for (item in code) { if (item.op == ClockSample) { return true; } }
    return false;
}
ClockInstruction :: (item: Instruction, pc: int) -> string {
    out := [format_text("p{}:\n  %clock{} = call {} @chibi_clock_raw(ptr %ctx)\n", pc, pc, abi.ClockSampleType())];
    types: int[] = [8, abi.WordStorage, abi.IntStorage, abi.IntStorage];
    for (type, field in types) {
        out.append(format_text("  %clockfield{}.{} = extractvalue {} %clock{}, {}\n", pc, field, abi.ClockSampleType(), pc, field));
        previous := "zeroinitializer";
        if (field > 0) { previous = format_text("%clockvalue{}.{}", pc, field - 1); }
        out.append(format_text("  %clockvalue{}.{} = insertvalue {} {}, {} %clockfield{}.{}, {}\n",
                               pc, field, TypeName(item.type), previous, TypeName(type), pc, field, field));
    }
    out.append(Store(format_text("%clockvalue{}.3", pc), item.type, "s", item.output));
    out.append(format_text("  br label %p{}\n", pc + 1));
    return strings.Join(out, "");
}

// Sampling owns only stack scratch. The embedding host borrows a validated
// immutable grant into this context; the provider state may change per call.
ClockRuntime :: () -> string {
    text := strings.Join([
        "define internal @RESULT@ @chibi_clock_raw(ptr %ctx) {\n",
        "entry:\n",
        "  %grant.at = getelementptr @CONTEXT@, ptr %ctx, i32 0, i32 @FIELD@\n",
        "  %grant = load ptr, ptr %grant.at\n",
        "  %absent = icmp eq ptr %grant, null\n",
        "  br i1 %absent, label %denied, label %sample\n",
        "denied:\n",
        "  ret @RESULT@ { i64 0, i64 0, i32 -1, i32 0 }\n",
        "sample:\n",
        "  %domain = load i64, ptr %grant\n",
        "  %read.at = getelementptr @GRANT@, ptr %grant, i32 0, i32 1\n",
        "  %state.at = getelementptr @GRANT@, ptr %grant, i32 0, i32 2\n",
        "  %read = load ptr, ptr %read.at\n",
        "  %state = load ptr, ptr %state.at\n",
        "  %nanoseconds = alloca i64, align 8\n",
        "  %error = alloca i32, align 4\n",
        "  store i64 0, ptr %nanoseconds\n",
        "  store i32 0, ptr %error\n",
        "  %status = call i32 %read(ptr %state, ptr %nanoseconds, ptr %error)\n",
        // -1 is reserved for no grant; a provider cannot manufacture denial.
        "  %reserved = icmp eq i32 %status, -1\n",
        "  %transport = select i1 %reserved, i32 3, i32 %status\n",
        "  %time = load i64, ptr %nanoseconds\n",
        "  %code = load i32, ptr %error\n",
        "  %a = insertvalue @RESULT@ zeroinitializer, i64 %time, 0\n",
        "  %b = insertvalue @RESULT@ %a, i64 %domain, 1\n",
        "  %c = insertvalue @RESULT@ %b, i32 %transport, 2\n",
        "  %d = insertvalue @RESULT@ %c, i32 %code, 3\n",
        "  ret @RESULT@ %d\n",
        "}\n",
    ], "");
    text = strings.ReplaceAll(text, "@CONTEXT@", abi.ClockContextType());
    text = strings.ReplaceAll(text, "@GRANT@", abi.ClockGrantType());
    text = strings.ReplaceAll(text, "@FIELD@", format_text("{}", abi.ClockGrantField));
    return strings.ReplaceAll(text, "@RESULT@", abi.ClockSampleType());
}

ClockBindingSymbols :: () -> string {
    text := strings.Join([
        "define i32 @chibi_host_set_clock(ptr %grant) {\n",
        "entry:\n",
        "  %absent = icmp eq ptr %grant, null\n",
        "  br i1 %absent, label %store, label %validate\n",
        "validate:\n",
        "  %domain = load i64, ptr %grant\n",
        "  %read.at = getelementptr @GRANT@, ptr %grant, i32 0, i32 1\n",
        "  %read = load ptr, ptr %read.at\n",
        "  %named = icmp ne i64 %domain, 0\n",
        "  %callable = icmp ne ptr %read, null\n",
        "  %valid = and i1 %named, %callable\n",
        "  br i1 %valid, label %store, label %invalid\n",
        "store:\n",
        "  %at = getelementptr @CONTEXT@, ptr @chibi_context, i32 0, i32 @FIELD@\n",
        "  store ptr %grant, ptr %at\n",
        "  ret i32 0\n",
        "invalid:\n",
        "  ret i32 1\n",
        "}\n",
    ], "");
    text = strings.ReplaceAll(text, "@CONTEXT@", abi.ClockContextType());
    text = strings.ReplaceAll(text, "@GRANT@", abi.ClockGrantType());
    return strings.ReplaceAll(text, "@FIELD@", format_text("{}", abi.ClockGrantField));
}

ClockFactorySymbol :: (name: string) -> bool {
    return name == "chibi_clock_grant_init" || name == "chibi_clock_host_init";
}

