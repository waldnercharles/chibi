version 3
name "DetailTile"
domain "model"
id_counter 14
description "One rounded box shared by smooth, bump, normal and label controls."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 6
                type "Model Rounded Box"
                inputs {
                    "Half Size" {
                        default x=28.0 y=6.0 z=20.0
                    }
                    Radius 2.0
                }
            }
            - id=10 type="Model Part" reference_name="Tile"
        }
        (array)edges {
            - from="6.Geometry" to="10.Geometry"
            - from="10.Geometry" to="1.Geometry"
        }
    }
}
