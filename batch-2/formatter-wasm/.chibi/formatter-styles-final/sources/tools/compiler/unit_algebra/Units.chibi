package unit_algebra

import text "core:strings"

pub Term :: struct {
    name: string;
    power: int;
}
pub Unit :: union {
    Value(kind: int, terms: Term[])
}
pub ProductResult :: union {
    Product(value: Unit, overflow: bool)
}

pub Unknown: int : 0;
pub Literal: int : 1;
pub Known: int : 2;
pub Invalid: int : 3;
MaxPower: int : 2147483647;
MaxTerms: int : 8;

pub Empty :: (kind: int) -> Unit {
    terms: Term[] = [];
    return Unit.Value(kind, terms);
}
Letter :: (byte: int) -> bool {
    return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || byte == 95;
}
Digit :: (byte: int) -> bool {
    return byte >= 48 && byte <= 57;
}
Starts :: (value: string, at: int, prefix: string) -> bool {
    return text.Slice(value, at, text.ByteLength(prefix)) == prefix;
}
Find :: (terms: Term[], name: string) -> int {
    index: int = 0;
    while (index < length(terms)) {
        if (terms[index].name == name) {
            return index;
        }
        index += 1;
    }
    return index;
}
MultiplyTerm :: (value: Unit, term: Term) -> ProductResult {
    switch value {
        case .Value(kind, inputTerms):
            terms := slice(inputTerms, 0, length(inputTerms));
            index := Find(terms, term.name);
            if (index < length(terms)) {
                before := terms[index].power;
                if ((term.power > 0 && before > MaxPower - term.power) ||
                    (term.power < 0 && before < -MaxPower - term.power)) {
                    return ProductResult.Product(Empty(Unknown), true);
                }
                power := before + term.power;
                if (power == 0) {
                    terms = remove_index(terms, index);
                } else {
                    replacement: Term = {name: term.name, power: power};
                    terms[index] = replacement;
                }
                return ProductResult.Product(Unit.Value(kind, terms), false);
            }
            if (length(terms) == MaxTerms) {
                return ProductResult.Product(Empty(Unknown), true);
            }
            return ProductResult.Product(Unit.Value(kind, append(terms, term)), false);
    }
}

// Presence keeps a missing annotation distinct from an empty malformed one.
pub Parse :: (present: bool, value: string) -> Unit {
    if (!present) {
        return Empty(Unknown);
    }
    size := text.ByteLength(value);
    if (size == 0) {
        return Empty(Invalid);
    }
    result := Empty(Known);
    sign: int = 1;
    at: int = 0;
    while (at < size) {
        first := at;
        byte := text.ByteAt(value, at);
        if (byte == 49) {
            at += 1;
        } else {
            if (!Letter(byte)) {
                return Empty(Invalid);
            }
            while (Letter(text.ByteAt(value, at)) || Digit(text.ByteAt(value, at))) {
                at += 1;
            }
        }
        name := text.Slice(value, first, at - first);
        power: int = 1;
        if (text.ByteAt(value, at) == 94) {
            at += 1;
            negative := false;
            if (text.ByteAt(value, at) == 45 || text.ByteAt(value, at) == 43) {
                negative = text.ByteAt(value, at) == 45;
                at += 1;
            }
            if (!Digit(text.ByteAt(value, at))) {
                return Empty(Invalid);
            }
            power = 0;
            while (Digit(text.ByteAt(value, at))) {
                digit := text.ByteAt(value, at) - 48;
                if (power > (MaxPower - digit) / 10) {
                    return Empty(Invalid);
                }
                power = power * 10 + digit;
                at += 1;
            }
            if (power == 0) {
                return Empty(Invalid);
            }
            if (negative) {
                power = -power;
            }
        } else if (Starts(value, at, "²") || Starts(value, at, "³")) {
            if (Starts(value, at, "²")) {
                power = 2;
            } else {
                power = 3;
            }
            at += 2;
        }
        power *= sign;
        if (name != "1") {
            term: Term = {name: name, power: power};
            switch MultiplyTerm(result, term) {
                case .Product(next, overflow):
                    if (overflow) {
                        return Empty(Invalid);
                    }
                    result = next;
            }
        }
        if (Starts(value, at, "·")) {
            at += 2;
        } else if (text.ByteAt(value, at) == 47) {
            sign = -1;
            at += 1;
        } else if (at < size) {
            return Empty(Invalid);
        } else {
            return result;
        }
        if (at == size) {
            return Empty(Invalid);
        }
    }
    return result;
}

pub Same :: (left: Unit, right: Unit) -> bool {
    switch left {
        case .Value(leftKind, a):
            switch right {
                case .Value(rightKind, b):
                    if (length(a) != length(b)) {
                        return false;
                    }
                    for (term in a) {
                        index := Find(b, term.name);
                        if (index == length(b) || term.power != b[index].power) {
                            return false;
                        }
                    }
                    return true;
            }
    }
}
pub Product :: (left: Unit, right: Unit, sign: int) -> ProductResult {
    switch left {
        case .Value(leftKind, a):
            switch right {
                case .Value(rightKind, b):
                    if (leftKind == Literal && rightKind == Literal) {
                        return ProductResult.Product(Empty(Literal), false);
                    }
                    if (leftKind != Known || rightKind != Known) {
                        return ProductResult.Product(Empty(Unknown), false);
                    }
                    result := left;
                    for (term in b) {
                        scaled: Term = {name: term.name, power: term.power * sign};
                        switch MultiplyTerm(result, scaled) {
                            case .Product(next, overflow):
                                if (overflow) {
                                    return ProductResult.Product(Empty(Unknown), true);
                                }
                                result = next;
                        }
                    }
                    return ProductResult.Product(result, false);
            }
    }
}

Append :: (value: string, part: string, size: int) -> string {
    remaining := size - 1 - text.ByteLength(value);
    return format_text("{}{}", value, text.Slice(part, 0, remaining));
}
AppendTerm :: (value: string, term: Term, size: int) -> string {
    power := term.power;
    if (power < 0) {
        power = -power;
    }
    result := Append(value, term.name, size);
    if (power == 2) {
        return Append(result, "²", size);
    }
    if (power == 3) {
        return Append(result, "³", size);
    }
    if (power > 3) {
        result = Append(result, "^", size);
        result = Append(result, format_text("{}", power), size);
    }
    return result;
}
pub WholeCharacters :: (value: string) -> string {
    end := text.ByteLength(value);
    lead := end;
    while (lead > 0 && (text.ByteAt(value, lead - 1) & 192) == 128) {
        lead -= 1;
    }
    if (lead == 0) {
        return value;
    }
    first := text.ByteAt(value, lead - 1);
    size: int = 4;
    if (first < 128) {
        size = 1;
    } else if (first < 224) {
        size = 2;
    } else if (first < 240) {
        size = 3;
    }
    if (end - (lead - 1) < size) {
        return text.Slice(value, 0, lead - 1);
    }
    return value;
}
// size is positive and includes the trailing NUL in the C representation.
pub Format :: (value: Unit, size: int) -> string {
    switch value {
        case .Value(kind, terms):
            if (kind != Known) {
                return text.Slice("?", 0, size - 1);
            }
            result := "";
            numerator := false;
            for (term in terms) {
                if (term.power > 0) {
                    if (numerator) {
                        result = Append(result, "·", size);
                    }
                    result = AppendTerm(result, term, size);
                    numerator = true;
                }
            }
            if (!numerator) {
                result = Append(result, "1", size);
            }
            for (term in terms) {
                if (term.power < 0) {
                    result = Append(result, "/", size);
                    result = AppendTerm(result, term, size);
                }
            }
            return WholeCharacters(result);
    }
}
