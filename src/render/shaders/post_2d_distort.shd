// Screen-space displacement of the linear frame before bloom: expanding
// shockwave rings, heat shimmer around authored sources and over burning
// fluid, and refraction through solids, whose offsets the material raster
// writes to cover GB. Offsets are output pixels; the frame is resampled once.
layout(set = 2, binding = 1) uniform sampler2D cover_tex;
layout(set = 3, binding = 1) uniform shd_uniforms {
    // Camera rectangle: min x, max y, width, height in Y-up world units.
    vec4 view;
    // The camera rectangle within the material textures.
    vec4 crop_uv;
    vec2 output_texel;
    float time;
    float fluid_haze;
    float refraction;
    int wave_count;
    int haze_count;
    // Per ring: center, radius and thickness; then strength.
    vec4 waves[32];
    // Per source: center, radius and strength.
    vec4 hazes[16];
};

// Smooth rising shimmer in [-1, 1] per axis: two drifting sine lattices.
vec2 shimmer(vec2 world)
{
    vec2 p = world * vec2(0.21, 0.13) + vec2(0.0, -time * 1.7);
    vec2 q = world * vec2(0.37, 0.29) + vec2(time * 0.6, -time * 2.9);
    return vec2(sin(p.y * 2.3 + sin(p.x * 1.7 + time * 2.1)) * 0.6 + sin(q.x + q.y * 1.3) * 0.4,
                cos(p.x * 1.9 + sin(p.y * 2.1 - time * 1.3)) * 0.6 + cos(q.y - q.x * 0.7) * 0.4);
}

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 uv = params.uv;
    vec2 world = view.xy + uv * view.zw * vec2(1.0, -1.0);
    // Output pixels, with Y up.
    vec2 offset = vec2(0.0);
    for (int i = 0; i < wave_count; i++) {
        vec4 ring = waves[2 * i];
        vec2 d = world - ring.xy;
        float r = length(d);
        float x = (r - ring.z) / ring.w;
        if (abs(x) > 3.0 || r < 1e-4) continue;
        // Derivative of a Gaussian: a lens that pulls the frame into the ring.
        offset -= d / r * waves[2 * i + 1].x * 2.33 * x * exp(-x * x);
    }
    float haze = 0.0;
    for (int i = 0; i < haze_count; i++) {
        vec4 h = hazes[i];
        float falloff = 1.0 - smoothstep(0.0, h.z, length(world - h.xy));
        haze += h.w * falloff * falloff;
    }
    vec2 source_uv = mix(crop_uv.xy, crop_uv.zw, uv);
    vec4 cover = texture(cover_tex, source_uv);
    haze += fluid_haze * min(cover.a, 1.0);
    if (haze > 0.0) offset += shimmer(world) * haze;
    offset += cover.gb * refraction;
    vec2 shifted = clamp(uv + offset * vec2(1.0, -1.0) * output_texel, vec2(0.0), vec2(1.0));
    return vec4(texture(u_image, shifted).rgb, 1.0);
}
