package chibi_cli

import strings "core:strings"

Join :: (parts: string[]) -> string {
    return strings.Join(parts, "")
}

Output :: (text: string) {
    application.stdout(Join([text, "\n"]))
}

Error :: (text: string) {
    application.stderr(Join([text, "\n"]))
}

Default :: (value: string, fallback: string) -> string {
    if value == "" {
        return fallback
    }
    return value
}

RootLength :: (path: string) -> int {
    size := strings.ByteLength(path)
    if size >= 3 && strings.ByteAt(path, 1) == 58 && strings.ByteAt(path, 2) == 47 {
        return 3
    }
    if strings.HasPrefix(path, "//") {
        index := 2
        while index < size && strings.ByteAt(path, index) != 47 {
            index += 1
        }
        if index < size {
            index += 1
        }
        while index < size && strings.ByteAt(path, index) != 47 {
            index += 1
        }
        return index
    }
    if strings.HasPrefix(path, "/") {
        return 1
    }
    return 0
}

Parent :: (path: string) -> string {
    root := RootLength(path)
    size := strings.ByteLength(path)
    while size > root && strings.ByteAt(path, size - 1) == 47 {
        size -= 1
    }
    if size <= root {
        return ""
    }
    trimmed := strings.Slice(path, 0, size)
    slash := strings.LastIndexByte(trimmed, 47)
    if slash < 0 {
        return ""
    }
    if slash < root {
        return strings.Slice(trimmed, 0, root)
    }
    return strings.Slice(trimmed, 0, slash)
}

ProgramName :: (arguments: string[]) -> string {
    if length(arguments) == 0 {
        return "chibi"
    }
    return Default(arguments[0], "chibi")
}

NearestProject :: () -> string {
    directory := files.resolve(".")
    while directory != "" {
        if files.kind(Join([directory, "/project.kdl"])) != 0 {
            return directory
        }
        directory = Parent(directory)
    }
    return ""
}

Compiler :: () -> string {
    return Join([application.bin(), "/chibi-compile", sdk.executable_suffix()])
}

Player :: () -> string {
    return Join([application.bin(), "/chibi-player", sdk.executable_suffix()])
}

Main :: () -> int {
    arguments := application.arguments()
    if length(arguments) > 1 && arguments[1] == "build" && !strings.Contains(Join(arguments), "--native") &&
       NearestProject() == "" {
        root := EngineRoot()
        if root != "" {
            return EngineBuild(root, Tail(arguments, 2))
        }
    }
    options := Parse(arguments)
    if options.help {
        application.stdout(Usage(ProgramName(arguments)))
        if !options.valid {
            return 2
        }
        return 0
    }
    if !options.valid {
        Error(options.error)
        return 2
    }
    command := options.command
    if command == "version" {
        return Version()
    }
    if command == "doctor" {
        return Doctor(options)
    }
    if command == "build" {
        if options.native {
            return BuildNative(options)
        }
        return Game(options.path, [], false)
    }
    if command == "check" {
        return Check(options)
    }
    if command == "fmt" {
        return Format(options, arguments)
    }
    if command == "test" {
        return Test(options)
    }
    if command == "doc" {
        return Document(options)
    }
    if command == "export" {
        return Export(options)
    }
    if command == "web" {
        return Web(options)
    }
    if command == "shorthand" && (Option(arguments[1]) ||
                                  (files.kind(arguments[1]) == 0 && !strings.HasSuffix(arguments[1], ".chibi") && !strings.Contains(arguments[1], "/"))) {
        Error(format_text("Unknown command: {}; use --help.", arguments[1]))
        return 2
    }
    return Run(options, Tail(arguments, options.tail_first))
}

@test
ParentPathsStopAtRoot :: () {
    assert(Parent("/one/two") == "/one")
    assert(Parent("/one") == "/" && Parent("/") == "")
    assert(Parent("/one/two/") == "/one")
    assert(Parent("C:/project") == "C:/" && Parent("C:/") == "")
    assert(Parent("c:/project/child/") == "c:/project")
    assert(Parent("//server/share/project") == "//server/share")
    assert(Parent("//server/share") == "" && Parent("//server/share/") == "")
    empty: string[] = []
    assert(ProgramName(empty) == "chibi" && !Parse(empty).valid)
    assert(ProgramName(["", "--help"]) == "chibi")
}

Usage :: (program: string) -> string {
    return format_text("Usage: {} version\n       {} doctor [--web PLAYER]\n       {} build [PROJECT]\n       {} build --native [-O0|-O2] [-g] [--target TRIPLE]\n                [--llvm DIR] [ROOT]\n       {} check [PROJECT] [--explain-costs [--json]]\n       {} fmt [--check] [PATH...]\n       {} test [ROOT]\n       {} run [--watch] [PATH] [--] [ARGUMENTS]\n       {} [--watch] PATH [--] [ARGUMENTS]\n       {} export [PROJECT] --output DIR [--web PLAYER] [--archive]\n                [--native [--llvm DIR]]\n       {} web [PROJECT] --player PLAYER [--port PORT]\n       {} doc [ROOT] [--serve] [--port PORT]\nPROJECT is a project directory or its project.kdl. Without one, the\nnearest project.kdl at or above the working directory is used.\nPATH may also be a .chibi file or package directory. Its Main takes\nno arguments and returns nothing or an int exit status. A directory\nwith project.kdl runs as a game. chibi PATH is shorthand for run.\n--watch reruns a standalone Main after edits, keeping retained state.\nversion prints the SDK, build, compiler and artifact-format identity.\ndoctor reports the SDK, compiler, player, platform, native backend and,\nwith --web PLAYER, browser export as supported, unavailable or broken,\nchanging nothing; it fails only when a capability it checks is broken.\nbuild prepares .chibi/build/game.chibip without starting the player.\nbuild --native compiles the one .chibi source in ROOT, the working\ndirectory without one, whose first function is Main :: () -> int,\nto ROOT/build/native/O2-HASH/program (-O0 for an unoptimized one)\nwith the opt, llc and ld.lld in DIR, or in CHIBI_LLVM_BIN without\n--llvm. --target builds for x86_64-unknown-linux-gnu, the default,\naarch64-apple-darwin or x86_64-pc-windows-msvc, whose program is\nprogram.exe. -g adds DWARF line tables, on Linux so far, so\ndebuggers and profilers place its code in the source. Native code\nsupports a subset of the language so far; a source outside it fails\nwith the first unsupported form.\ncheck parses, resolves and validates the project as build does, but\nmigrates and writes nothing; an older project fails until migrated.\n--explain-costs reports inferred allocation, copy and retention\noperations; --json writes that report as JSON.\ntest runs each @test function of the packages below ROOT, the\nworking directory without one, and fails when one fails. ROOT holds\nonly package files.\nfmt rewrites each project's sources and KDL assets as their savers\nwrite them; --check writes nothing and fails when one would change.\nA PATH that is a folder without a project.kdl has the package\nsources below it formatted instead, as test reads them.\nrun calls Main for a program, or prepares and starts a game.\nProgram arguments after PATH or -- are available in application.arguments().\nGame arguments are passed to chibi-player; see chibi-player --help.\nexport compiles the project into DIR with the player, its resources\nand engine files, ready to run and ship: a DIR.app on macOS, a\nfolder with an .exe on Windows, and a folder with a .desktop entry\nelsewhere. --web PLAYER writes a static site instead, with the\nbrowser player from the PLAYER folder (make package-web-player).\n--archive also writes DIR.tar.gz. --native, on Linux x86-64 so far,\nalso compiles each library source to a shared object in the data\nfolder's natives folder with LLVM's tools in DIR, or in\nCHIBI_LLVM_BIN without --llvm. The player runs those libraries'\nfunctions natively; a library native code cannot hold yet stays in\nthe VM, and export says why.\nweb exports the browser site into a temporary folder, serves it at\nhttp://127.0.0.1:PORT/ (8000 by default; 0 picks a free port) until\ninterrupted, then removes the folder. Windows does not serve yet.\ndoc writes the documentation site that ROOT/docs/site.kdl lists, ROOT\nbeing the working directory without one, into ROOT/build/docs;\n--serve then serves it like web until interrupted. Windows does not\nbuild documentation yet.\n", program, program, program, program, program, program, program, program, program, program, program, program)
}
