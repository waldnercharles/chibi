package facts
Index :: (calls: ^int) -> int { calls^ = calls^ * 10 + 1; return 0; }
Right :: (rows: ^(vec4[]), calls: ^int) -> vec2 { calls^ = calls^ * 10 + 2; rows^[0].w = 9; return rows^[0].yx; }
Check :: () -> bool { calls: int = 0; rows: vec4[] = [vec4(1, 2, 3, 4), vec4(5, 6, 7, 8)]; rows[Index(&calls)].xy = Right(&rows, &calls); return calls == 12 && rows[0] == vec4(2, 1, 3, 9) && rows[1] == vec4(5, 6, 7, 8); }
