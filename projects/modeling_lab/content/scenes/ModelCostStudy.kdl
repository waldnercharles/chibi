version 1
name "ModelCostStudy"
(array)entities {
    - {
        name "Camera"
        prototype "StudyCamera"
        components {
            GameCamera width=600.0 height=400.0 focal_distance=0.0
            GameHRC2D adaptive=#false resolution=0.5 min_resolution=0.5 surface_relief=0.0 ambient=0.12
        }
    }
    - {
        name "Light"
        prototype "StudyLight"
        components {
            GameTransform x=-250.0 y=-145.0
        }
    }
    - {
        name "One model"
        prototype "CostSphere"
        components {
            GameTransform x=-210.0 y=-65.0
            GameVisualTransform scale=38.0
        }
    }
    - {
        name "Raw equivalent"
        prototype "CostRawSphere"
        components {
            GameTransform x=-90.0 y=-65.0
            GameVisualTransform scale=38.0
        }
    }
    - {
        name "Complex construction"
        prototype "CostConstruction"
