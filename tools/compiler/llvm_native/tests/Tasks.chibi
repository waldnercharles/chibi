package llvm_native_calls

import native "project:llvm_native"
import abi "project:native_abi"
import facts "project:scalar_facts"
import scalar "project:scalar_llvm"

TaskCalls :: (mode: int, waits: bool) -> native.Instruction[] {
    code := [Code(native.Check, 0, 0, 0, 0, 0, 0),
             Code(native.Call, abi.IntStorage, 0, 1, 0, 0, i64(mode)),
             Code(native.Publish, abi.IntStorage, 0, 0, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0),
             Code(native.Check, 0, 0, 0, 0, 0, 0),
             Code(native.Suspend, 0, 0, 0, 0, 0, 0),
             Code(native.Constant, abi.IntStorage, 0, 0, 0, 0, 7),
             Code(native.Publish, abi.IntStorage, 0, 0, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0)];
    if (!waits) { code[5] = Code(native.Jump, 0, 0, 0, 0, 2, 0); }
    return code;
}
TaskCallModule :: (code: native.Instruction[]) -> native.Result {
    return Emit([Function(abi.IntStorage, 0, 0, 1, 0, 4, 0, 0),
                 Function(abi.IntStorage, 0, 1, 1, 4, 5, 0, 0)], [],
                [abi.IntStorage, abi.IntStorage], code, []);
}
@test
PlainCallsCannotUseACoroutineRampAsAScalarFunction :: () {
    Rejects(TaskCallModule(TaskCalls(native.CallPlain, true)), "native plain call cannot name a waiting function");
}
@test
AwaitedCallsRequireACoroutine :: () {
    Rejects(TaskCallModule(TaskCalls(native.CallAwaited, false)),
            "native awaited call or spawn names a function that does not wait");
    Emitted(TaskCallModule(TaskCalls(native.CallAwaited, true)));
    Emitted(TaskCallModule(TaskCalls(native.CallPlain, false)));
}
@test
UnusedInstructionNumbersRemainRejected :: () {
    code := TaskCalls(native.CallPlain, false);
    code[1] = Code(native.FieldAddress + 1, abi.IntStorage, 0, 0, 0, 0, 0);
    Rejects(TaskCallModule(code), "unsupported native scalar instruction");
}
@test
FunctionAddressesCannotUseACoroutineRamp :: () {
    code := [Code(native.Check, 0, 0, 0, 0, 0, 0),
             Code(native.FunctionAddress, abi.WordStorage, 0, 1, 0, 0, 0),
             Code(native.Constant, abi.IntStorage, 1, 0, 0, 0, 0),
             Code(native.Publish, abi.IntStorage, 0, 1, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0),
             Code(native.Check, 0, 0, 0, 0, 0, 0),
             Code(native.Suspend, 0, 0, 0, 0, 0, 0),
             Code(native.Constant, abi.IntStorage, 0, 0, 0, 0, 7),
             Code(native.Publish, abi.IntStorage, 0, 0, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0)];
    result := Emit([Function(abi.IntStorage, 0, 0, 2, 0, 5, 0, 0),
                    Function(abi.IntStorage, 0, 2, 1, 5, 5, 0, 0)], [],
                   [abi.WordStorage, abi.IntStorage, abi.IntStorage], code, []);
    Rejects(result, "native function address cannot name a waiting function");
}

TaskFact :: (kind: int, type: int, value: int, count: int, name: string, start: int, end: int) -> facts.Row {
    return {kind: kind, type: type, value: value, count: count, literal: 0, name: name, text: "",
            start: start, end: end, line: 1, column: start + 1};
}
TaskFacts :: (mode: int, waits: bool) -> facts.Row[] {
    source := TaskFact(facts.SourceRow, 0, 0, 0, "Tasks.chibi", 0, 0);
    source.line = 0;
    source.column = 0;
    source.text = "................................................................";
    document := source;
    document.kind = facts.DocumentRow;
    document.text = "";
    call := TaskFact(facts.CallRow, facts.IntType, 1, 0, "Work", 1, 2);
    call.literal = i64(mode);
    suspension := TaskFact(facts.YieldRow, facts.IntType, 0, 0, "", 34, 35);
    if (!waits) { suspension.kind = facts.LiteralRow; }
    return [source, document, TaskFact(facts.FunctionRow, facts.IntType, 0, 0, "Main", 0, 32),
            TaskFact(facts.ReturnRow, 0, 0, 1, "", 1, 2), call,
            TaskFact(facts.FunctionRow, facts.IntType, 0, 0, "Work", 33, 64),
            TaskFact(facts.LocalRow, facts.IntType, 0, 1, "_", 34, 35), suspension,
            TaskFact(facts.ReturnRow, 0, 0, 1, "", 36, 37),
            TaskFact(facts.LiteralRow, facts.IntType, 0, 0, "", 36, 37)];
}
@test
ScalarPlainCallsCannotUseWaitingFunctions :: () {
    assert(scalar.Validate(TaskFacts(facts.CallPlain, true)) == "scalar plain call cannot name a waiting function");
    assert(scalar.Validate(TaskFacts(facts.CallPlain, false)) == "");
}
@test
ScalarAwaitedCallsMustNameWaitingFunctions :: () {
    assert(scalar.Validate(TaskFacts(facts.CallAwaited, false)) ==
           "scalar awaited call or spawn names a function that does not wait");
    assert(scalar.Validate(TaskFacts(facts.CallAwaited, true)) == "");
}
@test
ScalarFunctionAddressesCannotNameWaitingFunctions :: () {
    rows := TaskFacts(facts.CallPlain, true);
    address := TaskFact(facts.FunctionAddressRow, facts.WordType, 1, 0, "Work", 1, 2);
    rows = [rows[0], rows[1], rows[2],
            TaskFact(facts.LocalRow, facts.WordType, 0, 1, "_", 1, 2), address,
            TaskFact(facts.ReturnRow, 0, 0, 1, "", 3, 4),
            TaskFact(facts.LiteralRow, facts.IntType, 0, 0, "", 3, 4),
            rows[5], rows[6], rows[7], rows[8], rows[9]];
    assert(scalar.Validate(rows) == "scalar function address cannot name a waiting function");
}
@test
ScalarCallModesAreBounded :: () {
    for (mode in [int(-1), 3]) {
        assert(scalar.Validate(TaskFacts(mode, false)) == "invalid scalar operand row");
    }
}
