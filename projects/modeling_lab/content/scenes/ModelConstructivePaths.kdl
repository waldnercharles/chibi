version 1
name "ModelConstructivePaths"
(array)entities {
    - {
        name "Camera"
        prototype "StudyCamera"
        components {
            GameCamera width=340.0 height=240.0
            GameHRC2D surface_relief=0.0 ambient=0.3
        }
    }
    - {
        name "Key"
        prototype "StudyLight"
        components {
            GameTransform x=-145.0 y=-95.0
        }
    }
    - {
        name "Fill"
        prototype "StudyLight"
        components {
            GameTransform x=145.0 y=80.0
            GameMaterial emission_intensity=0.15
        }
    }
    - {
        name "ConstructBezierCable"
        prototype "ConstructBezierCable"
        components {
            GameTransform x=-75.0 y=0.0
        }
    }
    - {
        name "ConstructPivotArm"
        prototype "ConstructPivotArm"
        components {
            GameTransform x=75.0 y=0.0
        }
    }
}
