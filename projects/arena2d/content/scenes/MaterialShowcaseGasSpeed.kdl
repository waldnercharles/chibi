version 1
name "MaterialShowcaseGasSpeed"
(array)entities {
    - name="Materials" prototype="MaterialShowcaseGasSpeedWorld"
    - {
        name "Camera"
        prototype "MaterialShowcaseEntity"
        components {
            GameCamera width=260.0 height=180.0
        }
    }
    - {
        name "Floor"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=0.0 y=64.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=204.0 height=8.0 category=8 mask=15 friction=0.6
            GameAppearance width=204.0 height=8.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Left wall"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=-100.0 y=-4.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=8.0 height=144.0 category=8 mask=15 friction=0.6
            GameAppearance width=8.0 height=144.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Right wall"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=100.0 y=-4.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=8.0 height=144.0 category=8 mask=15 friction=0.6
            GameAppearance width=8.0 height=144.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Ceiling"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=0.0 y=-58.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=204.0 height=8.0 category=8 mask=15 friction=0.6
            GameAppearance width=204.0 height=8.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Left baffle"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=-48.0 y=-20.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=38.0 height=6.0 category=8 mask=15 friction=0.6
            GameAppearance width=38.0 height=6.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Right baffle"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=48.0 y=-42.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=38.0 height=6.0 category=8 mask=15 friction=0.6
            GameAppearance width=38.0 height=6.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Cyan gas"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=-18.0 y=40.0
            GameFluidVolume {
                kind "Gas"
                width 40.0
                height 34.0
                spacing 0.375
                mass 0.000140625
                color 0x42d7dfff
                velocity x=30.0 y=-12.0
                absorption 0.025
                visibility 0.25
                refraction 0.0
                grain_radius 0.0
            }
            MaterialThermal capacity=1.0 conductivity=200.0
            GameIgniter heat=0.8
        }
    }
    - {
        name "Magenta gas"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=18.0 y=40.0
            GameFluidVolume {
                kind "Gas"
                width 40.0
                height 34.0
                spacing 0.375
                mass 0.000140625
                color 0xd363dfff
                velocity x=-30.0 y=12.0
                absorption 0.025
                visibility 0.25
                refraction 0.0
                grain_radius 0.0
            }
            MaterialThermal capacity=1.0 conductivity=200.0
            GameIgniter heat=0.8
        }
    }
    - {
        name "Mixing paddle"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=0.0 y=20.0
            GameBody type="Kinematic" angular_velocity=1.3 allow_rotation=#true
            GameCollider shape="Box" width=64.0 height=6.0 category=8 mask=15 friction=0.6
            GameAppearance width=64.0 height=6.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
            GameOrientation radians=0.0
        }
    }
}
