package rejected_foreign_record
foreign import libc "system:c"
foreign libc { memset :: (data: u8[], value: i32, count: u64) -> rawptr }
Box :: struct { bytes: u8[]; }
Main :: () -> int {
    value: Box = {bytes: [u8(65)]};
    Fill(value);
    // This becomes an accepted ownership regression once array-backed
    // ordinary records hold independent references at every value boundary.
    assert(value.bytes[0] == 65);
    return 0;
}
Fill :: (value: Box) { changed := memset(value.bytes, 9, 1); }
