package llvm_native_tests

import native "project:llvm_native"

import abi "project:native_abi"
import strings "core:strings"

Code :: (op: int, type: int, output: int, left: int, right: int, target: int, literal: int) -> native.Instruction {
    return {op: op, type: type, output: output, left: left, right: right, target: target, literal: literal};
}
// One function's tables, as the module's only function.
Single :: (parameters: int[], result: int, slots: int[], locals: int[], code: native.Instruction[], main: bool,
           budget: int) -> native.Result {
    shape: native.Function = {result: result, first_parameter: 0, parameters: length(parameters), first_slot: 0,
                              slots: length(slots), first_local: 0, locals: length(locals), first_code: 0,
                              code: length(code), first_argument: 0, arguments: 0};
    empty: int[] = [];
    return native.Emit(abi.LinuxX64(), [shape], parameters, slots, locals, code, empty, main, budget);
}
Accepted :: (slots: int[], locals: int[], code: native.Instruction[]) -> bool {
    parameters: int[] = [];
    switch Single(parameters, 6, slots, locals, code, true, 64) {
        case .Rejected(instruction, message):
            return false;
        case .Emitted(text):
            return strings.Contains(text, "define i32 @main()") &&
                   !strings.Contains(text, "nsw") && !strings.Contains(text, "nuw");
    }
}

pub Tests :: () -> int {
    if (!ScalarBodyEmitsWithoutRuntime()) {
        return 1;
    }
    if (!InvalidTypesAndBranchesAreRejected()) {
        return 2;
    }
    if (!DefinitionMustDominateUse()) {
        return 3;
    }
    if (!CheckedArithmeticKeepsFailureEdges()) {
        return 4;
    }
    if (!BudgetIsExplicit()) {
        return 5;
    }
    if (!CallsEmitDefinitions()) {
        return 6;
    }
    if (!MalformedCallsAreRejected()) {
        return 7;
    }
    if (!CyclesAreRejected()) {
        return 8;
    }
    return 0;
}
ScalarBodyEmitsWithoutRuntime :: () -> bool {
    locals: int[] = [];
    code := [Code(native.Constant, 6, 0, 0, 0, 0, 42), Code(native.Publish, 6, 0, 0, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0)];
    if (!Accepted([6], locals, code)) {
        return false;
    }
    code[0] = Code(native.Constant, 1, 0, 0, 0, 0, 2);
    if (Accepted([1], locals, code)) {
        return false;
    }
    return true;
}
InvalidTypesAndBranchesAreRejected :: () -> bool {
    locals: int[] = [];
    code := [Code(native.Constant, 6, 0, 0, 0, 0, 42), Code(native.Publish, 6, 0, 0, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0)];
    if (Accepted([13], locals, code)) {
        return false;
    }
    if (Accepted([9], locals, code)) {
        return false;
    }
    code[1] = Code(native.Jump, 0, 0, 0, 0, 3, 0);
    if (Accepted([6], locals, code)) {
        return false;
    }
    code[1] = Code(99, 0, 0, 0, 0, 0, 0);
    if (Accepted([6], locals, code)) {
        return false;
    }
    return true;
}
DefinitionMustDominateUse :: () -> bool {
    locals: int[] = [];
    code := [Code(native.Constant, 1, 0, 0, 0, 0, 1), Code(native.Branch, 0, 0, 0, 0, 3, 0),
             Code(native.Constant, 6, 1, 0, 0, 0, 42), Code(native.Publish, 6, 0, 1, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0)];
    if (Accepted([1, 6], locals, code)) {
        return false;
    }
    code[1] = Code(native.Branch, 0, 0, 0, 0, 2, 0);
    if (!Accepted([1, 6], locals, code)) {
        return false;
    }
    return true;
}
CheckedArithmeticKeepsFailureEdges :: () -> bool {
    operations := [native.Div, native.Mod, native.Shl, native.Shr];
    empty: int[] = [];
    for (op in operations) {
        code := [Code(native.Constant, 6, 0, 0, 0, 0, -2147483648), Code(native.Constant, 6, 1, 0, 0, 0, -1),
                 Code(op, 6, 2, 0, 1, 0, 0), Code(native.Return, 0, 0, 0, 0, 0, 0)];
        // The arithmetic result is deliberately unused. Failure is an effect.
        switch Single(empty, 6, [6, 6, 6], empty, code, true, 64) {
            case .Rejected(instruction, message):
                return false;
            case .Emitted(text):
                if (!strings.Contains(text, "label %trap")) {
                    return false;
                }
                if (!strings.Contains(text, "call void @llvm.trap()")) {
                    return false;
                }
                if (strings.Contains(text, "nsw") || strings.Contains(text, "nuw")) {
                    return false;
                }
                if (op == native.Div || op == native.Mod) {
                    if (!strings.Contains(text, "br i1 %bad2, label %trap, label %safe2")) {
                        return false;
                    }
                    if (!strings.Contains(text, "safe2:\n")) {
                        return false;
                    }
                }
        }
    }
    return true;
}

BudgetIsExplicit :: () -> bool {
    empty: int[] = [];
    code := [Code(native.Check, 0, 0, 0, 0, 0, 0), Code(native.Return, 0, 0, 0, 0, 0, 0)];
    budgets: int[] = [0, -1];
    for (budget in budgets) {
        switch Single(empty, 6, empty, empty, code, true, budget) {
            case .Rejected(instruction, message):
                if (message == "") {
                    return false;
                }
            case .Emitted(text):
                return false;
        }
    }
    switch Single(empty, 6, empty, empty, code, true, 1) {
        case .Rejected(instruction, message):
            return false;
        case .Emitted(text):
            return strings.Contains(text, "icmp sgt i32 %remaining0, 0") &&
                   strings.Contains(text, "sub i32 %remaining0, 1");
    }
}

// main() -> int returns Pick(7, true, 9); Pick :: (int, bool, int) -> int
// returns its third argument. Slots s0..s2 hold the arguments in call order.
Function :: (result: int, first_parameter: int, parameters: int, first_slot: int, slots: int, first_code: int,
             code: int, first_argument: int, arguments: int) -> native.Function {
    return {result: result, first_parameter: first_parameter, parameters: parameters, first_slot: first_slot,
            slots: slots, first_local: 0, locals: 0, first_code: first_code, code: code,
            first_argument: first_argument, arguments: arguments};
}
Caller :: () -> native.Instruction[] {
    return [Code(native.Check, 0, 0, 0, 0, 0, 0), Code(native.Constant, 6, 0, 0, 0, 0, 7),
            Code(native.Constant, 1, 1, 0, 0, 0, 1), Code(native.Constant, 6, 2, 0, 0, 0, 9),
            Code(native.Call, 6, 3, 1, 0, 3, 0), Code(native.Publish, 6, 0, 3, 0, 0, 0),
            Code(native.Return, 0, 0, 0, 0, 0, 0)];
}
Callee :: () -> native.Instruction[] {
    return [Code(native.Check, 0, 0, 0, 0, 0, 0), Code(native.Argument, 6, 0, 2, 0, 0, 0),
            Code(native.Publish, 6, 0, 0, 0, 0, 0), Code(native.Return, 0, 0, 0, 0, 0, 0)];
}
Module :: (code: native.Instruction[], arguments: int[]) -> native.Result {
    functions := [Function(6, 0, 0, 0, 4, 0, 7, 0, length(arguments)), Function(6, 0, 3, 4, 1, 7, 4, length(arguments), 0)];
    locals: int[] = [];
    return native.Emit(abi.LinuxX64(), functions, [6, 1, 6], [6, 1, 6, 6, 6], locals, code, arguments, false, 1);
}
Rejects :: (code: native.Instruction[], arguments: int[]) -> bool {
    switch Module(code, arguments) {
        case .Rejected(instruction, message):
            return message != "";
        case .Emitted(text):
            return false;
    }
}
CallsEmitDefinitions :: () -> bool {
    code := Caller();
    code.extend(Callee());
    switch Module(code, [0, 1, 2]) {
        case .Rejected(instruction, message):
            return false;
        case .Emitted(text):
            return strings.Contains(text, "define i32 @chibi_scalar() {") &&
                   strings.Contains(text, "define internal i32 @chibi_scalar.1(i32 %arg0, i1 %arg1, i32 %arg2) {") &&
                   strings.Contains(text, "%v4 = call i32 @chibi_scalar.1(i32 %c4_0, i1 %c4_1, i32 %c4_2)") &&
                   strings.Contains(text, "%c4_0 = load i32, ptr %s0\n  %c4_1 = load i1, ptr %s1\n  %c4_2 = load i32, ptr %s2") &&
                   strings.Contains(text, "store i32 %arg2, ptr %s0");
    }
}
// code with one field of code[index] replaced.
Changed :: (code: native.Instruction[], index: int, field: string, value: int) -> native.Instruction[] {
    item := code[index];
    if (field == "left") {
        item.left = value;
    } else if (field == "right") {
        item.right = value;
    } else if (field == "target") {
        item.target = value;
    } else if (field == "type") {
        item.type = value;
    } else if (field == "output") {
        item.output = value;
    } else {
        item.literal = value;
    }
    changed := code;
    changed[index] = item;
    return changed;
}
MalformedCallsAreRejected :: () -> bool {
    code := Caller();
    code.extend(Callee());
    // Argument positions swapped: a bool slot where an int parameter is.
    if (!Rejects(code, [1, 0, 2])) {
        return false;
    }
    // A missing argument row and an argument slot past the function's slots.
    if (!Rejects(code, [0, 1]) || !Rejects(code, [0, 1, 4])) {
        return false;
    }
    if (!Rejects(Changed(code, 4, "left", 2), [0, 1, 2]) || !Rejects(Changed(code, 4, "left", -1), [0, 1, 2])) {
        return false;
    }
    // Arity, result type and argument range disagree with the callee.
    if (!Rejects(Changed(code, 4, "target", 2), [0, 1, 2]) || !Rejects(Changed(code, 4, "type", 1), [0, 1, 2]) ||
        !Rejects(Changed(code, 4, "right", 1), [0, 1, 2])) {
        return false;
    }
    // The call's output is defined twice, or an argument after the call.
    if (!Rejects(Changed(code, 4, "output", 2), [0, 1, 2])) {
        return false;
    }
    late := code;
    late[3] = Code(native.Call, 6, 3, 1, 0, 3, 0);
    late[4] = Code(native.Constant, 6, 2, 0, 0, 0, 9);
    if (!Rejects(late, [0, 1, 2])) {
        return false;
    }
    return Rejects(Changed(code, 2, "literal", 2), [0, 1, 2]);
}
// A recursive or mutually recursive module is rejected, as is a function range
// that leaves a table row unowned.
CyclesAreRejected :: () -> bool {
    code := Caller();
    code.extend(Callee());
    locals: int[] = [];
    empty: int[] = [];
    self_call := [Code(native.Check, 0, 0, 0, 0, 0, 0), Code(native.Call, 6, 0, 0, 0, 0, 0),
                  Code(native.Publish, 6, 0, 0, 0, 0, 0), Code(native.Return, 0, 0, 0, 0, 0, 0)];
    switch native.Emit(abi.LinuxX64(), [Function(6, 0, 0, 0, 1, 0, 4, 0, 0)], empty, [6], locals, self_call, empty,
                       false, 1) {
        case .Rejected(instruction, message):
            if (message != "native call graph is cyclic") {
                return false;
            }
        case .Emitted(text):
            return false;
    }
    mutual := [Code(native.Check, 0, 0, 0, 0, 0, 0), Code(native.Call, 6, 0, 1, 0, 0, 0),
               Code(native.Publish, 6, 0, 0, 0, 0, 0), Code(native.Return, 0, 0, 0, 0, 0, 0),
               Code(native.Check, 0, 0, 0, 0, 0, 0), Code(native.Call, 6, 0, 0, 0, 0, 0),
               Code(native.Publish, 6, 0, 0, 0, 0, 0), Code(native.Return, 0, 0, 0, 0, 0, 0)];
    functions := [Function(6, 0, 0, 0, 1, 0, 4, 0, 0), Function(6, 0, 0, 1, 1, 4, 4, 0, 0)];
    switch native.Emit(abi.LinuxX64(), functions, empty, [6, 6], locals, mutual, empty, false, 1) {
        case .Rejected(instruction, message):
            if (message != "native call graph is cyclic") {
                return false;
            }
        case .Emitted(text):
            return false;
    }
    gap := [Function(6, 0, 0, 0, 4, 0, 7, 0, 3), Function(6, 0, 3, 4, 1, 8, 3, 3, 0)];
    switch native.Emit(abi.LinuxX64(), gap, [6, 1, 6], [6, 1, 6, 6, 6], locals, code, [0, 1, 2], false, 1) {
        case .Rejected(instruction, message):
            return message == "unsupported native scalar signature or table size";
        case .Emitted(text):
            return false;
    }
}
