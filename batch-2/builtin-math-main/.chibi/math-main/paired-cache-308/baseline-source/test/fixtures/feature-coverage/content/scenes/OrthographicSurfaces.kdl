version 1
name "OrthographicSurfaces"
presentation "3d"
(array)entities {
    - name="View" prototype="OrthographicView"
    - {
        name "Environment"
        prototype "Stage"
        components {
            Environment ambient_sky=0xffffffff ambient_ground=0xffffffff ambient_intensity=0.6 occlusion="Off"
        }
    }
    - {
        name "Lower box"
        prototype "RenderSolid"
        components {
            Geometry3D width=24.0 depth=24.0 height=12.0 elevation=8.0
            Material scene=0x4080c0ff
            Transform x=-50.0 y=-20.0
        }
    }
    - {
        name "Raised box with equal projected footprint"
        prototype "RenderSolid"
        components {
            Geometry3D width=24.0 depth=24.0 height=12.0 elevation=48.0
            Material scene=0xe09040ff
            Transform x=50.0 y=-20.0
        }
    }
    - {
        name "Hollow frame excluded from indirect proxies"
        prototype "RenderSolid"
        components {
            Geometry3D primitive=8 width=40.0 depth=40.0 height=12.0 elevation=8.0
            IndirectOccluder enabled=#false
            Material scene=0x80c0a0ff
            Transform y=20.0
        }
    }
    - {
        name "Local light"
        prototype "Stage"
        components {
            PointLight color=0xfff0d0ff intensity=2.0 radius=180.0 elevation=100.0 shadows=#true
            Transform y=-20.0
        }
    }
}
