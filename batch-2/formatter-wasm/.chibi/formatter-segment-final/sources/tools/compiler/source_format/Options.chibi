        else if (name == "numeric_base" && value == "preserve") { options.numeric_base = 0; }
        else if (name == "numeric_base" && value == "decimal") { options.numeric_base = 1; }
        else if (name == "numeric_base" && value == "hex") { options.numeric_base = 2; }
        else if (name == "exponent_group" && number != -2147483648) { options.exponent_group = number; }
        else if (name == "string_escapes" && value == "preserve") { options.string_escapes = 0; }
        else if (name == "string_escapes" && value == "minimal") { options.string_escapes = 1; }
        else if (name == "string_escapes" && value == "ascii") { options.string_escapes = 2; }
        else if (name == "char_escapes" && value == "preserve") { options.char_escapes = 0; }
        else if (name == "char_escapes" && value == "minimal") { options.char_escapes = 1; }
        else if (name == "char_escapes" && value == "ascii") { options.char_escapes = 2; }
        else if (name == "imports" && value == "preserve") { options.imports = 0; }
        else if (name == "imports" && value == "sort") { options.imports = 1; }
        else if (name == "imports" && value == "organize") { options.imports = 2; }
        else if (name == "semicolons" && value == "keep") { options.semicolons = 0; }
        else if (name == "semicolons" && value == "omit") { options.semicolons = 1; }
        else if (name == "semicolons" && value == "always") { options.semicolons = 2; }
        else if (name == "line_ending" && value == "lf") { options.crlf = false; }
        else if (name == "line_ending" && value == "crlf") { options.crlf = true; }
        else if (name == "final_newline" && (value == "true" || value == "false")) { options.final_newline = value == "true"; }
        else if (name == "trailing_commas" && value == "preserve") { options.trailing_commas = 0; }
        else if (name == "trailing_commas" && value == "omit") { options.trailing_commas = 1; }
        else if (name == "trailing_commas" && value == "multiline") { options.trailing_commas = 2; }
        else if (name == "trailing_commas_arguments" && value == "inherit") { options.trailing_commas_arguments = -1; }
        else if (name == "trailing_commas_arguments" && value == "preserve") { options.trailing_commas_arguments = 0; }
        else if (name == "trailing_commas_arguments" && value == "omit") { options.trailing_commas_arguments = 1; }
        else if (name == "trailing_commas_arguments" && value == "multiline") { options.trailing_commas_arguments = 2; }
        else if (name == "trailing_commas_parameters" && value == "inherit") { options.trailing_commas_parameters = -1; }
        else if (name == "trailing_commas_parameters" && value == "preserve") { options.trailing_commas_parameters = 0; }
        else if (name == "trailing_commas_parameters" && value == "omit") { options.trailing_commas_parameters = 1; }
        else if (name == "trailing_commas_parameters" && value == "multiline") { options.trailing_commas_parameters = 2; }
        else if (name == "trailing_commas_arrays" && value == "inherit") { options.trailing_commas_arrays = -1; }
        else if (name == "trailing_commas_arrays" && value == "preserve") { options.trailing_commas_arrays = 0; }
        else if (name == "trailing_commas_arrays" && value == "omit") { options.trailing_commas_arrays = 1; }
        else if (name == "trailing_commas_arrays" && value == "multiline") { options.trailing_commas_arrays = 2; }
        else if (name == "trailing_commas_records" && value == "inherit") { options.trailing_commas_records = -1; }
        else if (name == "trailing_commas_records" && value == "preserve") { options.trailing_commas_records = 0; }
        else if (name == "trailing_commas_records" && value == "omit") { options.trailing_commas_records = 1; }
        else if (name == "trailing_commas_records" && value == "multiline") { options.trailing_commas_records = 2; }
        else if (name == "trailing_commas_tuples" && value == "inherit") { options.trailing_commas_tuples = -1; }
        else if (name == "trailing_commas_tuples" && value == "preserve") { options.trailing_commas_tuples = 0; }
        else if (name == "trailing_commas_tuples" && value == "omit") { options.trailing_commas_tuples = 1; }
        else if (name == "trailing_commas_tuples" && value == "multiline") { options.trailing_commas_tuples = 2; }
        else if (name == "trailing_commas_bindings" && value == "inherit") { options.trailing_commas_bindings = -1; }
        else if (name == "trailing_commas_bindings" && value == "preserve") { options.trailing_commas_bindings = 0; }
        else if (name == "trailing_commas_bindings" && value == "omit") { options.trailing_commas_bindings = 1; }
        else if (name == "trailing_commas_bindings" && value == "multiline") { options.trailing_commas_bindings = 2; }
        else if (name == "start_line" && number != -2147483648) { options.start_line = number; }
        else if (name == "end_line" && number != -2147483648) { options.end_line = number; }
        else if (name == "range_scope" && value == "declarations") { options.range_scope = 0; }
        else if (name == "range_scope" && value == "statements") { options.range_scope = 1; }
        else { return (options, format_text("Invalid formatter option {}", pair)); }
    }
    return (options, Validate(options));
}
