<div id="root" data-keys="Escape:Close">
  <div id="prompt" data-if="self.near > 0 &amp;&amp; self.open == 0" presence>
    <span class="key">E</span><span class="verb">Resonance</span><span class="aside">spend skill points</span>
  </div>

  <div id="screen" data-if="self.open > 0" presence>
    <div id="panel">
      <div class="head">
        <div class="titles">
          <div class="kicker">Sanctum</div>
          <div class="name">Resonance</div>
        </div>
        <div class="wallet res"><span class="orb"/><number-flow data-attr-value="self.points"/><span class="unit">points</span></div>
        <div class="close" data-event-click="emit('Close')">Close<span class="key">E</span></div>
      </div>
      <div class="branches">
        <div class="branch pilot">
          <div class="btitle">Pilot</div>
          <div class="bsub">Hull, shield and thrust</div>
          <div class="tree">
            <div class="edge" style="left: 42dp; top: 79dp; width: 36dp; transform: rotate(90deg);" data-class-lit="self.n0 == 2" data-class-done="self.n4 == 2"/>
            <div class="edge" style="left: 114dp; top: 79dp; width: 36dp; transform: rotate(90deg);" data-class-lit="self.n1 == 2" data-class-done="self.n5 == 2"/>
            <div class="edge" style="left: 186dp; top: 79dp; width: 36dp; transform: rotate(90deg);" data-class-lit="self.n2 == 2" data-class-done="self.n6 == 2"/>
            <div class="edge" style="left: 258dp; top: 79dp; width: 36dp; transform: rotate(90deg);" data-class-lit="self.n3 == 2" data-class-done="self.n7 == 2"/>
            <div class="edge" style="left: 46.8dp; top: 158.5dp; width: 114dp; transform: rotate(77.3deg);" data-class-lit="self.n4 == 2" data-class-done="self.n8 == 2"/>
            <div class="edge" style="left: 109.2dp; top: 158.5dp; width: 114dp; transform: rotate(102.7deg);" data-class-lit="self.n5 == 2" data-class-done="self.n8 == 2"/>
            <div class="node" id="learn" style="left: 20dp; top: 36dp;" data-event-click="emit('Learn', 0)" data-class-owned="self.n0 == 2" data-class-open="self.n0 == 1" data-class-poor="self.a0 == 0">
              <div class="ring"><div class="val">+25</div><div class="tag">Hull</div></div>
              <div class="tip" style="left: -32dp;">
                <div class="tname">Reinforced Hull</div>
                <div class="tdesc">+25 maximum hull.</div>
                <div class="tfoot"><span class="cost">1 point</span></div>
              </div>
            </div>
            <div class="node" id="learn" style="left: 92dp; top: 36dp;" data-event-click="emit('Learn', 1)" data-class-owned="self.n1 == 2" data-class-open="self.n1 == 1" data-class-poor="self.a1 == 0">
              <div class="ring"><div class="val">+15</div><div class="tag">Shield</div></div>
              <div class="tip" style="left: -73dp;">
                <div class="tname">Shield Capacitors</div>
                <div class="tdesc">+15 maximum shield.</div>
                <div class="tfoot"><span class="cost">1 point</span></div>
              </div>
            </div>
            <div class="node" id="learn" style="left: 164dp; top: 36dp;" data-event-click="emit('Learn', 2)" data-class-owned="self.n2 == 2" data-class-open="self.n2 == 1" data-class-poor="self.a2 == 0">
              <div class="ring"><div class="val">+12%</div><div class="tag">Thrust</div></div>
              <div class="tip" style="left: -73dp;">
                <div class="tname">Vector Thrusters</div>
                <div class="tdesc">Fly 12% faster.</div>
                <div class="tfoot"><span class="cost">1 point</span></div>
              </div>
            </div>
            <div class="node" id="learn" style="left: 236dp; top: 36dp;" data-event-click="emit('Learn', 3)" data-class-owned="self.n3 == 2" data-class-open="self.n3 == 1" data-class-poor="self.a3 == 0">
              <div class="ring"><div class="val">-30%</div><div class="tag">Boost</div></div>
              <div class="tip" style="left: -114dp;">
                <div class="tname">Afterburner</div>
                <div class="tdesc">Boosting drains 30% less.</div>
                <div class="tfoot"><span class="cost">1 point</span></div>
              </div>
            </div>
            <div class="node" id="learn" style="left: 20dp; top: 116dp;" data-event-click="emit('Learn', 4)" data-class-owned="self.n4 == 2" data-class-open="self.n4 == 1" data-class-poor="self.a4 == 0">
              <div class="ring"><div class="val">+35</div><div class="tag">Hull</div></div>
              <div class="tip" style="left: -32dp;">
                <div class="tname">Plating II</div>
