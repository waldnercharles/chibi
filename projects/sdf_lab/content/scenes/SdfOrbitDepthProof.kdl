version 1
name "SdfOrbitDepthProof"
(array)entities {
    - {
        name "Camera"
        prototype "SdfOptimizationCamera"
        components {
            GameTransform x=0.0 y=0.0
            GameCamera width=700.0 height=460.0 focal_distance=650.0 yaw=0.0 pitch=1.2 target_elevation=60.0
            GameSurfaceQuality resolution="Full" sdf_normal_mode="Analytic" sdf_pixel_error=0.0 disable_sdf_lod=#true
            GameHRC2D surface_mode="Gather" surface_shadow_mode="Reference" ambient=0.0 fog=0.0 shadow_floor=0.0 bloom=0.0 bounce_intensity=0.0 intensity=1.0 exposure=0.8 surface_radius=0.0 surface_relief=1.2 lighting_margin=125.0 resolution=0.5 min_resolution=0.5 adaptive=#false feedback=#false
        }
        (array)behaviors "SdfCameraOrbitYaw"
    }
    - {
        name "Cyan opposing sphere"
        prototype "SdfSphere"
        components {
            GameTransform x=0.0 y=-60.0
            GameGeometry3D elevation=60.0
            GameVisualTransform scale=1.6 pitch=0.0 yaw=0.0 roll=0.0
            GameShader material="SdfOrbitCyanDepth"
            GameMaterial emission_intensity=1.0
        }
    }
    - {
        name "Rose opposing bored box"
        prototype "SdfBoredBox"
        components {
            GameTransform x=0.0 y=60.0
            GameGeometry3D elevation=60.0
            GameVisualTransform scale=1.4 pitch=0.15 yaw=0.0 roll=-0.15
            GameShader material="SdfOrbitRoseDepth"
            GameMaterial emission_intensity=1.0
        }
    }
}
