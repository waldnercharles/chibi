version: 3
name: ArenaWaveBehavior
id_counter: 4784
description: 'Five telegraphed formations: edge rows, opposing pincers and an arc. Markers count as pending arrivals, hold for one second, and create enemies at their exact marked positions. Final pickups are collected before clearing.'
owner_type: ecs.entity
variables:
- id: 2001
  name: Interval
  type: float
  type_name: float
  category: Formation
  default: 4.0
- id: 2002
  name: Elapsed
  type: float
  type_name: float
  category: State
  default: 3.8
- {id: 2003, name: Enemy Count, type: int, type_name: int, category: State}
- {id: 2004, name: Player Alive, type: bool, type_name: bool, category: State}
- {id: 2387, name: Pending Deaths, type: bool, type_name: bool, category: State}
- id: 2430
  name: Formation Position
  type: struct
  type_name: GameTransform
  category: State
  default: {x: 0.0, "y": 0.0}
