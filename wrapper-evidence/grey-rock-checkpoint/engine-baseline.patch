@@ -0,0 +1,199 @@
+#include "render/material_mesh.h"
+
+#include "render/material_height.h"
+#include "runtime/geometry/material_surface_mesh.h"
+#include "support/array.h"
+#include "support/xalloc.h"
+
+#include <math.h>
