// Hierarchy levels are render targets written by fragment passes, which the
// GPU compresses losslessly; empty space costs little bandwidth. In the RGB
// transport each pixel holds one element: an interval of T (light, optical
// depth) or a direction of R (light, and the share of its cone that sees the
// sky; see merge.frag). Quadrants 1 and 3 run along world y, so
// their levels are stored transposed, rows along x, which gives every quadrant
// the same texture shape. Luminance pairs quadrants 0 and 2, then 1 and 3, in
// one set of levels: an interval texel holds both directions' (light, depth),
// a fluence texel both lights.

#include "hrc_common.shd"
#include "hrc/hrc_slots.shd"

layout(location = 0) out vec4 out_value;

ivec2 hrc_texel(int element, int row, int transposed)
{
	return transposed != 0 ? ivec2(row, element) : ivec2(element, row);
}

// This fragment's element and row.
ivec2 hrc_element_row(int transposed)
{
	ivec2 p = ivec2(gl_FragCoord.xy);
	return transposed != 0 ? p.yx : p;
}

#ifdef HRC_SCALAR
Interval interval_fetch(sampler2D level, ivec2 p)
{
	vec4 v = texelFetch(level, p, 0);
	return Interval(v.xz, v.yw);
}

vec4 interval_texel(Interval v)
{
	vec2 rad = clamp(v.rad, vec2(0.0), vec2(65504.0));
	return vec4(rad.x, v.tau.x, rad.y, v.tau.y);
}

#define HRC_FLUENCE vec2

vec2 fluence_fetch(sampler2D level, ivec2 p)
{
	return texelFetch(level, p, 0).xy;
}

vec4 fluence_texel(vec2 v)
{
	return vec4(clamp(v, vec2(0.0), vec2(65504.0)), 0.0, 1.0);
}
#else
Interval interval_fetch(sampler2D level, ivec2 p)
{
	vec4 v = texelFetch(level, p, 0);
	return Interval(v.rgb, v.a);
}

vec4 interval_texel(Interval v)
{
	return vec4(clamp(v.rad, vec3(0.0), vec3(65504.0)), v.tau);
}

#define HRC_FLUENCE vec4

vec4 fluence_fetch(sampler2D level, ivec2 p)
{
	return texelFetch(level, p, 0);
}

vec4 fluence_texel(vec4 v)
{
	return vec4(clamp(v.rgb, vec3(0.0), vec3(65504.0)), v.a);
}
#endif
