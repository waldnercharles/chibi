+CheckWhileCapability :: () {
+    source := "package p\npub Sum :: (limit: i64) -> i64 { at: i64 = 0; sum: i64 = 0; while (limit > at) { sum = sum + at; at = at + 1; } return sum; }\n";
+    module := Accepted(source);
+    assert(length(module.blocks) == 4, "plain while has entry/header/body/continuation");
+    assert(module.blocks[1].parameter_count == 2, "only assigned entry bindings become loop parameters");
+    header := module.blocks[1];
+    at_parameter := module.block_parameters[int(header.first_parameter)];
+    sum_parameter := module.block_parameters[int(header.first_parameter) + 1];
+    assert(module.values[int(at_parameter) - 1].type == typed.I64 &&
+           module.values[int(sum_parameter) - 1].type == typed.I64, "loop parameter types come from canonical values");
+    entry_jump := Terminator(module, 1);
+    back := Terminator(module, 3);
+    assert(entry_jump.op == typed.Jump && back.op == typed.Jump, "while entry and body exit are edges");
+    edge := module.edges[int(back.payload) - 1];
+    assert(edge.target == 2 && edge.argument_count == 2, "backedge points to the same logical header");
+    at_update := DefiningInstruction(module, module.arguments[int(edge.first_argument)]);
+    sum_update := DefiningInstruction(module, module.arguments[int(edge.first_argument) + 1]);
+    assert(at_update.op == typed.AddI64 && at_update.left == at_parameter,
+           "first backedge argument is the distinct at update");
+    assert(sum_update.op == typed.AddI64 && sum_update.left == sum_parameter && sum_update.right == at_parameter,
+           "second backedge argument is the distinct sum update");
+    continuation := Terminator(module, 4);
+    assert(continuation.left == sum_parameter, "zero-trip exit uses header value, never body value");
+    alias := Accepted("package p\nF :: (b: bool, x: i64, y: i64) -> i64 { while (b) { x = y; y = y; } return x; }\n");
+    back = Terminator(alias, 3);
+    edge = alias.edges[int(back.payload) - 1];
+    assert(edge.argument_count == 2 && alias.arguments[int(edge.first_argument)] == alias.arguments[int(edge.first_argument) + 1],
+           "intentional alias forwarding may repeat a ValueID in a valid owned span");
+    for (text in [
+        "package p\nF :: () -> i64 { x: i64 = 0; while (false) { x = x + 1; } return x; }\n",
+        "package p\nF :: () -> i64 { while (false) { temporary: i64 = 1; } return 0; }\n",
+        "package p\nF :: (n: i64) -> i64 { x: i64 = 0; b: bool = true; while (b) { if (n > x) { x = x + 1; } else { b = false; } } return x; }\n",
+        "package p\nF :: (n: i64) -> i64 { x: i64 = 0; while (n > x) { y: i64 = 0; while (n > y) { x = x + 1; y = y + 1; } } return x; }\n",
+        "package p\nF :: () -> i64 { x: i64 = 0; while (false) { local: i64 = 1; x = local; } while (false) { local: bool = true; if (local) { x = 2; } } return x; }\n",
+        "package p\nF :: (b: bool) -> i64 { while (b) { return 7; } return 0; }\n"
+    ]) { Accepted(text); }
+    for (text in [
+        "package p\nF :: () -> i64 { while (1) { } return 0; }\n",
+        "package p\nF :: () -> i64 { while (true) { break; } return 0; }\n",
+        "package p\nF :: () -> i64 { while (true) { continue; } return 0; }\n",
+        "package p\nF :: () -> i64 { while (false) { local: i64 = 1; } return local; }\n"
+    ]) { Rejected(text); }
+    // Mutations keep ownership intact unless ownership itself is the target.
+    changed := module;
+    edges := changed.edges;
+    row := edges[int(entry_jump.payload) - 1];
+    row.target = 1;
+    edges[int(entry_jump.payload) - 1] = row;
+    changed.edges = edges;
+    assert(typed.Verify(changed) == typed.InvalidEdge, "incoming entry edge is rejected");
+    changed = module;
+    instructions := changed.instructions;
+    last := length(instructions) - 1;
+    instruction := instructions[last];
+    instruction.left = at_update.result;
+    instructions[last] = instruction;
+    changed.instructions = instructions;
+    assert(typed.Verify(changed) == typed.InvalidDominance, "body definition unavailable on zero-trip continuation");
+    disconnected := Accepted("package p\nF :: (b: bool) -> i64 { while (b) { } return 0; }\n");
+    edges = disconnected.edges;
+    row = edges[0];
+    row.target = 4;
+    edges[0] = row;
+    disconnected.edges = edges;
+    assert(typed.Verify(disconnected) == typed.InvalidDominance, "unreachable header/body cycle is rejected");
+    changed = module;
+    edges = changed.edges;
+    back = Terminator(module, 3);
+    // Missing argument ownership must fail even if the edge still points home.
+    row = edges[int(back.payload) - 1];
+    row.first_argument = 0;
+    row.argument_count = 0;
+    edges[int(back.payload) - 1] = row;
+    changed.edges = edges;
+    assert(typed.Verify(changed) != 0, "missing backedge arguments are rejected");
+}
