package chibi_cli

import strings "core:strings"

Join :: (parts: string[]) -> string {
    return strings.Join(parts, "")
}

Output :: (text: string) {
    application.stdout(Join([text, "\n"]))
}

Error :: (text: string) {
    application.stderr(Join([text, "\n"]))
}

Default :: (value: string, fallback: string) -> string {
    if value == "" {
        return fallback
    }
    return value
}

RootLength :: (path: string) -> int {
    size := strings.ByteLength(path)
    if size >= 3 && strings.ByteAt(path, 1) == 58 && strings.ByteAt(path, 2) == 47 {
        return 3
    }
    if strings.HasPrefix(path, "//") {
        index := 2
        while index < size && strings.ByteAt(path, index) != 47 {
            index += 1
        }
        if index < size {
            index += 1
        }
        while index < size && strings.ByteAt(path, index) != 47 {
            index += 1
        }
        return index
    }
    if strings.HasPrefix(path, "/") {
        return 1
    }
    return 0
}

Parent :: (path: string) -> string {
    root := RootLength(path)
    size := strings.ByteLength(path)
    while size > root && strings.ByteAt(path, size - 1) == 47 {
        size -= 1
    }
    if size <= root {
        return ""
    }
    trimmed := strings.Slice(path, 0, size)
    slash := strings.LastIndexByte(trimmed, 47)
    if slash < 0 {
        return ""
    }
    if slash < root {
        return strings.Slice(trimmed, 0, root)
    }
    return strings.Slice(trimmed, 0, slash)
}

ProgramName :: (arguments: string[]) -> string {
    if length(arguments) == 0 {
        return "chibi"
    }
    return Default(arguments[0], "chibi")
}

NearestProject :: () -> string {
    directory := files.resolve(".")
    while directory != "" {
        if files.kind(Join([directory, "/project.kdl"])) != 0 {
            return directory
        }
        directory = Parent(directory)
    }
    return ""
}

Compiler :: () -> string {
    return Join([application.bin(), "/chibi-compile", sdk.executable_suffix()])
}

Main :: () -> int {
    arguments := application.arguments()
    if length(arguments) > 1 && arguments[1] == "build" && !strings.Contains(Join(arguments), "--native") &&
       NearestProject() == "" {
        root := EngineRoot()
        if root != "" {
            return EngineBuild(root, Tail(arguments, 2))
        }
    }
    options := Parse(arguments)
    if options.help {
        application.stdout(Usage(ProgramName(arguments)))
        if !options.valid {
            return 2
        }
        return 0
    }
    if !options.valid {
        Error(options.error)
        return 2
    }
    command := options.command
    if command == "version" {
        return Version()
    }
    if command == "doctor" {
        return Doctor(options)
    }
    if command == "build" {
        if options.native {
            return BuildNative(options)
        }
        return GameProjectsArchived("build")
    }
    if command == "test" {
        return Test(options)
    }
    if command == "shorthand" && (Option(arguments[1]) ||
                                  (files.kind(arguments[1]) == 0 && !strings.HasSuffix(arguments[1], ".chibi") && !strings.Contains(arguments[1], "/"))) {
        Error(format_text("Unknown command: {}; use --help.", arguments[1]))
        return 2
    }
    return Run(options, Tail(arguments, options.tail_first))
}

@test
ParentPathsStopAtRoot :: () {
    assert(Parent("/one/two") == "/one")
    assert(Parent("/one") == "/" && Parent("/") == "")
    assert(Parent("/one/two/") == "/one")
    assert(Parent("C:/project") == "C:/" && Parent("C:/") == "")
    assert(Parent("c:/project/child/") == "c:/project")
    assert(Parent("//server/share/project") == "//server/share")
    assert(Parent("//server/share") == "" && Parent("//server/share/") == "")
    empty: string[] = []
    assert(ProgramName(empty) == "chibi" && !Parse(empty).valid)
    assert(ProgramName(["", "--help"]) == "chibi")
}

Usage :: (program: string) -> string {
    commands := format_text("Usage: {} version\n       {} doctor\n       {} build --native [-O0|-O2] [-g] [--target TRIPLE]\n                [--llvm DIR] [ROOT]\n       {} test [ROOT]\n       {} run [--watch] [PATH] [--] [ARGUMENTS]\n       {} [--watch] PATH [--] [ARGUMENTS]\n", program, program, program, program, program, program)
    return Join([commands,
        "PATH is a .chibi file or package directory. Its Main takes no arguments\n",
        "and returns nothing or an int exit status. chibi PATH is shorthand for run.\n",
        "--watch reruns Main after edits, keeping retained state.\n",
        "version prints the SDK, build, compiler and artifact-format identity.\n",
        "doctor reports the SDK, compiler, platform and native backend as supported,\n",
        "unavailable or broken, changing nothing; it fails only when a capability it\n",
        "checks is broken.\n",
        "build --native compiles the one .chibi source in ROOT, the working\n",
        "directory without one, whose first function is Main :: () -> int,\n",
        "to ROOT/build/native/O2-HASH/program (-O0 for an unoptimized one)\n",
        "with the opt, llc and ld.lld in DIR, or in CHIBI_LLVM_BIN without\n",
        "--llvm, for the host. --target builds for x86_64-unknown-linux-gnu,\n",
        "aarch64-apple-darwin or x86_64-pc-windows-msvc, whose program is\n",
        "program.exe, instead. -g adds DWARF line tables, on Linux so far,\n",
        "so debuggers and profilers place its code in the source. Native code\n",
        "supports a subset of the language so far; a source outside it fails\n",
        "with the first unsupported form.\n",
        "test runs each @test function of the packages below ROOT, the\n",
        "working directory without one, and fails when one fails. ROOT holds\n",
        "only package files.\n",
        "run calls Main for a program.\n",
        "Program arguments after PATH or -- are available in application.arguments().\n"])
}
