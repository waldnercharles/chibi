version 3
name "ConstructAnchorProbe"
domain "model"
id_counter 36
description "Reusable probe carries a public socket position. The same declaration moves its geometry and exported attachment frame."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 6
                type "Model Parameter"
                reference_name "Socket Position"
                inputs {
                    Default {
                        type "struct"
                        type_name "ShaderVec3"
                        default x=0.0 y=-20.0 z=0.0
                    }
                    Minimum {
                        type "struct"
                        type_name "ShaderVec3"
                        default x=-10.0 y=-30.0 z=-10.0
                    }
                    Maximum {
                        type "struct"
                        type_name "ShaderVec3"
                        default x=10.0 y=-10.0 z=10.0
                    }
                }
            }
            - id=11 type="Model Anchor" reference_name="Socket"
            - {
                id 17
                type "Model Capsule"
                inputs Radius=7.0 "Half Segment"=14.0
            }
            - {
                id 21
                type "Model Sphere"
                inputs Radius=10.0
            }
            - {
                id 24
                type "Model Translate"
                inputs {
                    Offset {
                        default x=0.0 y=19.0 z=0.0
                    }
                }
            }
            - id=28 type="Model Union"
            - id=32 type="Model Translate"
        }
        (array)edges {
            - from="6.Value" to="11.Position"
            - from="6.Value" to="32.Offset"
            - from="17.Geometry" to="28.A"
            - from="21.Geometry" to="24.Geometry"
            - from="24.Geometry" to="28.B"
            - from="28.Geometry" to="32.Geometry"
            - from="32.Geometry" to="1.Geometry"
        }
    }
}
