package analysis_state

import snapshot "project:source_snapshot"
import reader "project:signature_reader"
import syntax "project:syntax_diagnostics"

// This is a view of the existing reader tree, not another syntax representation.
// Node references in later analysis are (package-local document, local node).
pub DocumentTree :: union {
    Parsed(tree: reader.Tree, root: int) | Missing
}
pub DocumentMap :: union {
    Mapped(local_to_source_file: int[], source_file_to_local: int[]) | Missing
}

LocalLink :: (link: int, node_start: int) -> int {
    if (link < 0) {
        return link;
    }
    return link - node_start;
}
RetainedTree :: (documents: snapshot.Document[], forest: snapshot.SnapshotNode[], source_file: int) -> DocumentTree {
    if (source_file < 0 || source_file >= length(documents)) {
        return DocumentTree.Missing;
    }
    document := documents[source_file];
    if (!document.has_syntax) {
        return DocumentTree.Missing;
    }
    nodes: syntax.Node[] = [];
    fields: int[] = [];
    named_flags: bool[] = [];
    extra_flags: bool[] = [];
    index: int = 0;
    while (index < document.node_count) {
        item := forest[document.node_start + index];
        node: syntax.Node = {
            kind: item.kind, start: item.start, end: item.end, row: item.row, column: item.column,
            parent: LocalLink(item.parent, document.node_start),
            first_child: LocalLink(item.first_child, document.node_start),
            next_sibling: LocalLink(item.next_sibling, document.node_start)
        };
        nodes.append(node);
        fields.append(item.field);
        named_flags.append(item.is_named);
        extra_flags.append(item.is_extra);
        index += 1;
    }
    return DocumentTree.Parsed(reader.Tree.Raw(nodes, fields, named_flags, extra_flags, document.text),
                               document.syntax_root - document.node_start);
}
pub TreeForDocument :: (source: snapshot.Result, source_file: int) -> DocumentTree {
    switch source {
        case .Accepted(roots, documents, nodes, imports, graph):
            return RetainedTree(documents, nodes, source_file);
        case .Rejected(diagnostic, related, graph_error, cycle, documents, nodes, imports):
            return RetainedTree(documents, nodes, source_file);
    }
}
// Package members are global snapshot file indices. Preserve graph-member order;
// -1 means a source file is outside this package. Rejected graphs have no map.
pub DocumentsForPackage :: (source: snapshot.Result, package_index: int) -> DocumentMap {
    switch source {
        case .Rejected(diagnostic, related, graph_error, cycle, documents, nodes, imports):
            return DocumentMap.Missing;
        case .Accepted(roots, documents, nodes, imports, graph):
            switch graph {
                case .Rejected(error, cycle):
                    return DocumentMap.Missing;
                case .Accepted(packages, members, file_packages, order, edges, bindings):
                    if (package_index < 0 || package_index >= length(packages)) {
                        return DocumentMap.Missing;
                    }
                    selected := packages[package_index];
                    local_to_source_file: int[] = [];
                    source_file_to_local: int[] = [];
                    source_file: int = 0;
                    while (source_file < length(documents)) {
                        source_file_to_local.append(int(-1));
                        source_file += 1;
                    }
                    local: int = 0;
                    while (local < selected.member_count) {
                        source_file = members[selected.member_start + local];
                        local_to_source_file.append(source_file);
                        source_file_to_local[source_file] = local;
                        local += 1;
                    }
                    return DocumentMap.Mapped(local_to_source_file, source_file_to_local);
            }
    }
}
