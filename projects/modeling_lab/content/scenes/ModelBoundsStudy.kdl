version 1
name "ModelBoundsStudy"
(array)entities {
    - {
        name "Camera"
        prototype "StudyCamera"
        components {
            GameCamera width=610.0 height=370.0
            GameHRC2D surface_relief=0.0 ambient=0.12
        }
        (array)behaviors "ModelBoundsCameraMotion"
    }
    - {
        name "Key light"
        prototype "StudyLight"
        components {
            GameTransform x=-245.0 y=-105.0
        }
    }
    - {
        name "Fill light"
        prototype "StudyLight"
        components {
            GameTransform x=245.0 y=105.0
        }
    }
    - {
        name "Changing reach and bend"
        prototype "AdjustableBoom"
        components {
            GameTransform x=-155.0 y=-60.0
        }
        (array)behaviors "ModelBoundsMotion"
    }
    - {
        name "Minimum dimensions"
        prototype "AdjustableBoom"
        components {
            GameTransform x=-125.0 y=90.0
            GameShader parameters="Reach 8\nBend -0.8\n(array)Offset -40 -10 -25\n(array)Factors 0.65 0.65 0.65\n"
        }
    }
    - {
        name "Maximum dimensions"
        prototype "AdjustableBoom"
        components {
            GameTransform x=85.0 y=45.0
            GameShader parameters="Reach 55\nBend 0.8\n(array)Offset -40 30 25\n(array)Factors 1.4 1.4 1.4\n"
        }
    }
    - {
        name "Independent mesh overlap"
        prototype "BoundsMeshControl"
        components {
            GameTransform x=95.0 y=55.0
        }
    }
}
