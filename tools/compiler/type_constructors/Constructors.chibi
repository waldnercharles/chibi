package type_constructors

import named "project:named_binding"
import binding "project:lexical_binding"
import syntax "project:syntax_diagnostics"

// Original catalog order and spans, with no precomputed lookup/selection facts.
Definition :: struct { id_slot: int; variant_start: int; variant_count: int; }
RawVariant :: struct { tag_slot: int; type: int; }
Capability :: struct { id_slot: int; result_count: int; }
Function :: struct { symbol: int; result_start: int; result_count: int; }
Symbol :: struct { id_slot: int; }
Environment :: union {
    Tables(types: named.Type[], ids: uint64[], definitions: Definition[], variants: RawVariant[],
           capabilities: Capability[], functions: Function[], symbols: Symbol[], result_symbols: int[])
}
Request :: struct { pointer_size: int; start: int; end: int; line: int; column: int; document: int; }
// Published selections refer to original metadata. Synthesized variants carry
// their exact scalar type and full-width IDs in the output pool.
Variant :: struct {
    catalog_type: int; variant: int; member: int;
    storage: int; container: int; flags: int;
    nominal_slot: int; parameter_slot: int; tag_slot: int;
}
Field :: struct { capability: int; parameter: int; symbol: int; }
Selections :: union { Selected(variants: Variant[], ids: uint64[]) }
Plan :: union {
    Constructed(value: named.Value, publish: bool, id: uint64, name: string,
                definition: named.Value, size: int, internal: bool,
                variants: Variant[], fields: Field[], ids: uint64[], diagnostics: syntax.Diagnostic[])
}

Tag :: pure fn(value: named.Value) -> uint64 {
    switch value {
        case .Typed(storage, container, flags, nominal, parameter):
            if ((flags & 512) != 0) { return nominal; }
            if ((flags & 1024) != 0) { return parameter; }
            nominal_id := nominal;
            result: uint64 = cast<uint64>(0);
            if ((flags & 64) != 0) { nominal_id = cast<uint64>(0); result = parameter; }
            return binding.ID("union-type", format_text("{}:{}:{}:{}:{}", storage, container, nominal_id, result, flags & 74));
    }
}
FindDefinition :: pure fn(environment: Environment, id: uint64) -> int {
    switch environment {
        case .Tables(types, ids, definitions, variants, capabilities, functions, symbols, results):
            index: int = 0;
            while (index < length(definitions)) {
                if (named.IDAt(ids, definitions[index].id_slot) == id) { return index; }
                index += 1;
            }
            return -1;
    }
}
Select :: pure fn(selection: Selections, value: named.Value, catalog_type: int, variant: int,
                  member: int, tag: uint64) -> Selections {
    switch selection {
        case .Selected(payload_rows, payload_ids):
            rows := payload_rows;
            ids := payload_ids;
            index: int = 0;
            while (index < length(rows)) {
                if (ids[rows[index].tag_slot] == tag) { return selection; }
                index += 1;
            }
            switch value {
                case .Typed(storage, container, flags, nominal, parameter):
                    slot := length(ids);
                    ids = array_add(ids, nominal);
                    ids = array_add(ids, parameter);
                    ids = array_add(ids, tag);
                    row: Variant = {catalog_type: catalog_type, variant: variant, member: member,
                        storage: storage, container: container, flags: flags,
                        nominal_slot: slot, parameter_slot: slot + 1, tag_slot: slot + 2};
                    rows = array_add(rows, row);
                    return Selections.Selected(rows, ids);
            }
    }
}
SelectMember :: pure fn(environment: Environment, selection: Selections, value: named.Value, member: int) -> Selections {
    switch value {
        case .Typed(storage, container, flags, nominal, parameter):
            nested := -1;
            if ((flags & 256) != 0 && (flags & 2048) == 0 && container == 0) {
                nested = FindDefinition(environment, nominal);
            }
            if (nested < 0) { return Select(selection, value, -1, -1, member, Tag(value)); }
            switch environment {
                case .Tables(types, ids, definitions, variants, capabilities, functions, symbols, results):
                    definition := definitions[nested];
                    index: int = 0;
                    while (index < definition.variant_count) {
                        original := variants[definition.variant_start + index];
                        tag := named.IDAt(ids, original.tag_slot);
                        if (parameter == cast<uint64>(0) || tag == parameter) {
                            selection = Select(selection, named.TypeAt(types, ids, original.type), nested, index, -1, tag);
                        }
                        index += 1;
                    }
                    return selection;
            }
    }
}
// Compare the first differing bit from most to least significant. This stays
// within the bootstrap executor's supported unsigned bit operations.
TagAfter :: pure fn(left: uint64, right: uint64) -> bool {
    mask: uint64 = cast<uint64>(1) << cast<uint64>(63);
    while (mask != cast<uint64>(0)) {
        left_bit := left & mask;
        right_bit := right & mask;
        if (left_bit != right_bit) { return left_bit != cast<uint64>(0); }
        mask = mask >> cast<uint64>(1);
    }
    return false;
}
FinishUnion :: pure fn(environment: Environment, selection: Selections, pointer_size: int,
                       diagnostics: syntax.Diagnostic[]) -> Plan {
    fields: Field[] = [];
    switch selection {
        case .Selected(payload_rows, payload_ids):
            rows := payload_rows;
            ids := payload_ids;
            index: int = 1;
            while (index < length(rows)) {
                cursor := index;
                while (cursor > 0 && TagAfter(ids[rows[cursor - 1].tag_slot], ids[rows[cursor].tag_slot])) {
                    previous := rows[cursor - 1];
                    rows[cursor - 1] = rows[cursor];
                    rows[cursor] = previous;
                    cursor -= 1;
                }
                index += 1;
            }
            id: uint64 = cast<uint64>(14695981039346656037);
            index = 0;
            while (index < length(rows)) {
                id = (id ^ ids[rows[index].tag_slot]) * cast<uint64>(1099511628211);
                index += 1;
            }
            value := named.Value.Typed(18, 0, 256, id, cast<uint64>(0));
            if (FindDefinition(environment, id) >= 0) {
                empty: Variant[] = [];
                noIDs: uint64[] = [];
                return Plan.Constructed(value, false, cast<uint64>(0), "",
                    named.Value.Typed(0, 0, 0, cast<uint64>(0), cast<uint64>(0)),
                    0, false, empty, fields, noIDs, diagnostics);
            }
            return Plan.Constructed(value, true, id, format_text("union:{}", id), value,
                pointer_size, true, rows, fields, ids, diagnostics);
    }
}
Union :: pure fn(environment: Environment, members: int[], pointer_size: int) -> Plan {
    rows: Variant[] = [];
    ids: uint64[] = [];
    selection := Selections.Selected(rows, ids);
    switch environment {
        case .Tables(types, sourceIDs, definitions, variants, capabilities, functions, symbols, results):
            index: int = 0;
            while (index < length(members)) {
                selection = SelectMember(environment, selection, named.TypeAt(types, sourceIDs, members[index]), index);
                index += 1;
            }
    }
    diagnostics: syntax.Diagnostic[] = [];
    return FinishUnion(environment, selection, pointer_size, diagnostics);
}
Task :: pure fn(environment: Environment, result: int, function: uint64) -> Plan {
    fields: Field[] = [];
    variants: Variant[] = [];
    outputIDs: uint64[] = [];
    diagnostics: syntax.Diagnostic[] = [];
    switch environment {
        case .Tables(types, ids, definitions, rawVariants, capabilities, functions, symbols, results):
            descriptor := named.TypeAt(types, ids, result);
            id := Tag(descriptor);
            value := named.Value.Typed(17, 0, 64, function, id);
            if (FindDefinition(environment, id) >= 0) {
                return Plan.Constructed(value, false, cast<uint64>(0), "",
                    named.Value.Typed(0, 0, 0, cast<uint64>(0), cast<uint64>(0)),
                    0, false, variants, fields, outputIDs, diagnostics);
            }
            if ((types[result].flags & 8) != 0) {
                capability := -1;
                index: int = 0;
                while (index < length(capabilities) && capability < 0) {
                    if (named.IDAt(ids, capabilities[index].id_slot) == function) { capability = index; }
                    index += 1;
                }
                if (capability >= 0) {
                    index = 0;
                    while (index < capabilities[capability].result_count) {
                        field: Field = {capability: capability, parameter: index, symbol: -1};
                        fields = array_add(fields, field);
                        index += 1;
                    }
                } else {
                    function_index := -1;
                    index = 0;
                    while (index < length(functions) && function_index < 0) {
                        candidate := functions[index];
                        if (candidate.symbol >= 0 && named.IDAt(ids, symbols[candidate.symbol].id_slot) == function) { function_index = index; }
                        index += 1;
                    }
                    if (function_index >= 0) {
                        index = 0;
                        while (index < functions[function_index].result_count) {
                            field: Field = {capability: -1, parameter: -1, symbol: results[functions[function_index].result_start + index]};
                            fields = array_add(fields, field);
                            index += 1;
                        }
                    }
                }
            }
            return Plan.Constructed(value, true, id, format_text("task-result:{}", id), descriptor,
                0, true, variants, fields, outputIDs, diagnostics);
    }
}
Await :: pure fn(environment: Environment, success: int, request: Request) -> Plan {
    diagnostics: syntax.Diagnostic[] = [];
    rows: Variant[] = [];
    outputIDs: uint64[] = [];
    selection := Selections.Selected(rows, outputIDs);
    switch environment {
        case .Tables(types, ids, definitions, variants, capabilities, functions, symbols, results):
            value := named.TypeAt(types, ids, success);
            cancelled := (types[success].flags & 512) != 0;
            definition := -1;
            if ((types[success].flags & 256) != 0) { definition = FindDefinition(environment, named.IDAt(ids, types[success].nominal_slot)); }
            if (definition >= 0) {
                index: int = 0;
                while (index < definitions[definition].variant_count) {
                    tag := named.IDAt(ids, variants[definitions[definition].variant_start + index].tag_slot);
                    if (tag == cast<uint64>(0x63616e63656c6c65)) { cancelled = true; }
                    index += 1;
                }
            }
            if (cancelled) {
                diagnostic: syntax.Diagnostic = {start: request.start, end: request.end, line: request.line,
                    column: request.column, document: request.document,
                    message: "Cancelled is reserved for task cancellation, not a successful task result"};
                diagnostics = array_add(diagnostics, diagnostic);
            }
            selection = SelectMember(environment, selection, value, 0);
            selection = SelectMember(environment, selection, named.Value.Typed(18, 0, 512,
                cast<uint64>(0x63616e63656c6c65), cast<uint64>(0)), 1);
    }
    return FinishUnion(environment, selection, request.pointer_size, diagnostics);
}
