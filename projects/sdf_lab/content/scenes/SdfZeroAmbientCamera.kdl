version 1
name "SdfZeroAmbientCamera"
(array)entities {
    - {
        name "Camera"
        prototype "SdfOptimizationCamera"
        components {
            GameTransform x=70.0 y=0.0
            GameCamera width=700.0 height=460.0 focal_distance=500.0
            GameSurfaceQuality resolution="Full" sdf_normal_mode="Analytic" sdf_pixel_error=0.0 disable_sdf_lod=#true
            GameHRC2D surface_shadow_mode="Horizon8" ambient=0.0 fog=0.0 shadow_floor=0.0 bloom=0.0 bounce_intensity=0.18 intensity=4.0 exposure=0.8 surface_radius=128.0 surface_relief=1.2 lighting_margin=125.0
        }
        (array)behaviors "SdfCameraEllipse"
    }
    - {
        name "Flat reference stage"
        prototype "SdfCameraFlatReceiver"
        components {
            GameTransform x=0.0 y=0.0
            GameAppearance shape="Box" width=490.0 height=280.0 color=0x293441ff
            GameMaterial scene=0x293441ff albedo=0x293441ff absorption=0.0 emission_intensity=0.0
        }
    }
    - {
        name "Flat reference stripe"
        prototype "SdfCameraFlatReceiver"
        components {
            GameTransform x=0.0 y=139.0
            GameAppearance shape="Box" width=230.0 height=10.0 color=0x7b8894ff
            GameMaterial scene=0x7b8894ff albedo=0x7b8894ff absorption=0.0 emission_intensity=0.0
        }
    }
    - {
        name "Far amber sphere"
        prototype "SdfSphere"
        components {
            GameTransform x=-65.0 y=15.0
            GameGeometry3D elevation=0.0
            GameVisualTransform scale=1.15 pitch=0.0 yaw=0.0 roll=0.0
            GameShader material="SdfAmber"
            GameMaterial emission_intensity=0.0 emission_color=0x000000ff
        }
    }
    - {
        name "Mid cyan torus"
        prototype "SdfTorus"
        components {
            GameTransform x=-20.0 y=-5.0
            GameGeometry3D elevation=60.0
            GameVisualTransform scale=1.25 pitch=0.32 yaw=0.0 roll=0.2
            GameShader material="SdfCyan"
            GameMaterial emission_intensity=0.0 emission_color=0x000000ff
        }
    }
    - {
        name "Near rose bored box"
        prototype "SdfBoredBox"
        components {
            GameTransform x=58.0 y=18.0
            GameGeometry3D elevation=130.0
            GameVisualTransform scale=1.05 pitch=0.28 yaw=0.0 roll=-0.25
            GameShader material="SdfRose"
            GameMaterial emission_intensity=0.0 emission_color=0x000000ff
        }
    }
    - {
        name "Far ivory mesh"
        prototype "SdfComparisonMesh"
        components {
            GameTransform x=-135.0 y=-60.0
            GameGeometry3D elevation=0.0
            GameVisualTransform scale=1.15 pitch=0.6 yaw=0.0 roll=0.2
            GameShader material="SdfIvory"
            GameMaterial emission_intensity=0.0 emission_color=0x000000ff
        }
    }
    - {
        name "Raised cyan mesh"
        prototype "SdfComparisonMesh"
        components {
            GameTransform x=140.0 y=-65.0
            GameGeometry3D elevation=60.0
            GameVisualTransform scale=1.0 pitch=0.55 yaw=0.0 roll=-0.25
            GameShader material="SdfCyan"
            GameMaterial emission_intensity=0.0 emission_color=0x000000ff
        }
    }
    - {
        name "Raised amber sphere"
        prototype "SdfSphere"
        components {
            GameTransform x=135.0 y=60.0
            GameGeometry3D elevation=130.0
            GameVisualTransform scale=0.8 pitch=0.0 yaw=0.0 roll=0.0
            GameShader material="SdfAmber"
            GameMaterial emission_intensity=0.0 emission_color=0x000000ff
        }
    }
    - {
        name "Far ivory torus"
        prototype "SdfTorus"
        components {
            GameTransform x=-130.0 y=73.0
            GameGeometry3D elevation=0.0
            GameVisualTransform scale=0.85 pitch=0.55 yaw=0.0 roll=-0.2
            GameShader material="SdfIvory"
            GameMaterial emission_intensity=0.0 emission_color=0x000000ff
        }
    }
    - {
        name "Cyan fixed emitter"
        prototype "SdfLight"
        components {
            GameTransform x=-215.0 y=-85.0
            GameAppearance width=20.0 height=20.0 color=0x35d9edff
            GameMaterial emission_color=0x35d9edff emission_intensity=0.85
        }
    }
    - {
        name "Amber fixed emitter"
        prototype "SdfLight"
        components {
            GameTransform x=215.0 y=60.0
            GameAppearance width=20.0 height=20.0 color=0xffad50ff
            GameMaterial emission_color=0xffad50ff emission_intensity=0.85
        }
    }
    - {
        name "Magenta fixed emitter"
        prototype "SdfLight"
        components {
            GameTransform x=5.0 y=-120.0
            GameAppearance width=20.0 height=20.0 color=0xfa68c7ff
            GameMaterial emission_color=0xfa68c7ff emission_intensity=0.85
        }
    }
}
