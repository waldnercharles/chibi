package constant_scalar

// Physical storage is explicit. Wide integers never pass through double or
// text. Presence preserves NULL literal strings independently of empty text.
pub Value :: union {
    Bool(value: bool)
    | I8(value: i8)
    | U8(value: u8)
    | I16(value: i16)
    | U16(value: u16)
    | I32(value: int)
    | U32(value: u32)
    | I64(value: i64)
    | U64(value: u64)
    | F32(value: number)
    | F64(value: f64)
    | Name(value: string, has_value: bool)
    | Text(value: string, has_value: bool)
}
pub Result :: union {
    Folded(value: Value) | Failed(message: string)
}
Conversion :: union {
    Accepted(value: Value) | Rejected | Unfit
}

OpNone: int : 0;
OpAdd: int : 1;
OpSub: int : 2;
OpMul: int : 3;
OpDiv: int : 4;
OpMod: int : 5;
OpNeg: int : 6;
OpNot: int : 7;
pub OpAnd: int : 8;
pub OpOr: int : 9;
OpEq: int : 10;
OpNe: int : 11;
OpLt: int : 12;
OpLe: int : 13;
OpGt: int : 14;
OpGe: int : 15;
OpBitAnd: int : 16;
OpBitOr: int : 17;
OpBitXor: int : 18;
OpShiftLeft: int : 19;
OpShiftRight: int : 20;
OpBitNot: int : 21;

pub Storage :: (value: Value) -> int {
    switch value {
        case .Bool(item):
            return 1;
        case .I8(item):
            return 2;
        case .U8(item):
            return 3;
        case .I16(item):
            return 4;
        case .U16(item):
            return 5;
        case .I32(item):
            return 6;
        case .U32(item):
            return 7;
        case .I64(item):
            return 8;
        case .U64(item):
            return 9;
        case .F32(item):
            return 10;
        case .F64(item):
            return 11;
        case .Name(item, present):
            return 12;
        case .Text(item, present):
            return 13;
    }
}

ToDouble :: (value: Value) -> Conversion {
    switch value {
        case .Bool(item):
            if (item) {
                return Conversion.Accepted(Value.F64(1.0));
            }
            return Conversion.Accepted(Value.F64(0.0));
        case .I8(item):
            return Conversion.Accepted(Value.F64(f64(item)));
        case .U8(item):
            return Conversion.Accepted(Value.F64(f64(item)));
        case .I16(item):
            return Conversion.Accepted(Value.F64(f64(item)));
        case .U16(item):
            return Conversion.Accepted(Value.F64(f64(item)));
        case .I32(item):
            return Conversion.Accepted(Value.F64(f64(item)));
        case .U32(item):
            return Conversion.Accepted(Value.F64(f64(item)));
        case .I64(item):
            return Conversion.Accepted(Value.F64(f64(item)));
        case .U64(item):
            return Conversion.Accepted(Value.F64(f64(item)));
        case .F32(item):
            return Conversion.Accepted(Value.F64(f64(item)));
        case .F64(item):
            return Conversion.Accepted(Value.F64(f64(item)));
        case .Name(item, present):
            return Conversion.Rejected;
        case .Text(item, present):
            return Conversion.Rejected;
    }
}

// Integer storage bounds, matching the runtime cast range checks. Unsigned
// values compare as int64 bit patterns, so High stops at int64's maximum.
Low :: (storage: int) -> i64 {
    if (storage == 2) {
        return -128;
    }
    if (storage == 4) {
        return -32768;
    }
    if (storage == 6) {
        return -2147483648;
    }
    if (storage == 8) {
        return -9223372036854775808;
    }
    return 0;
}
High :: (storage: int) -> i64 {
    if (storage == 2) {
        return 127;
    }
    if (storage == 3) {
        return 255;
    }
    if (storage == 4) {
        return 32767;
    }
    if (storage == 5) {
        return 65535;
    }
    if (storage == 6) {
        return 2147483647;
    }
    if (storage == 7) {
        return 4294967295;
    }
    return 9223372036854775807;
}
IntegerStorage :: (storage: int) -> bool {
    return storage >= 2 && storage <= 9;
}
// Every value of `from` fits `to`.
Widens :: (from: int, to: int) -> bool {
    if (Signed(from) == Signed(to)) {
        return Width(to) >= Width(from);
    }
    return !Signed(from) && Width(to) > Width(from);
}
// The operand storage holding both integers exactly: the wider one, or int or
// int64 for a signed/unsigned pair. 0 for int64 with uint64.
pub CommonInteger :: (x: int, y: int) -> int {
    if (Widens(x, y)) {
        return y;
    }
    if (Widens(y, x)) {
        return x;
    }
    if (Widens(x, 6) && Widens(y, 6)) {
        return 6;
    }
    if (Widens(x, 8) && Widens(y, 8)) {
        return 8;
    }
    return 0;
}
Published :: (bits: u64, target: int) -> Conversion {
    published := Publish(bits, target);
    switch published {
        case .Folded(item):
            return Conversion.Accepted(item);
        case .Failed(message):
            return Conversion.Rejected;
    }
}
// Modes match the runtime: 0 exact, 1 wrap (low bits), 2 clamp (saturate).
IntegerConvert :: (value: Value, target: int, mode: int) -> Conversion {
    bits := Bits(value);
    signed := i64(wrap: bits);
    negative := Signed(Storage(value)) && signed < 0;
    below := negative && signed < Low(target);
    // A nonnegative value with the sign bit set is an unsigned value >= 2^63.
    above := !negative && target != 9 && (signed < 0 || signed > High(target));
    if (mode == 1 || (!below && !above)) {
        return Published(bits, target);
    }
    if (mode == 0) {
        return Conversion.Unfit;
    }
    if (below) {
        return Published(u64(wrap: Low(target)), target);
    }
    return Published(u64(wrap: High(target)), target);
}
// Floating sources round toward zero, saturate and map NaN to zero.
FloatConvert :: (item: f64, target: int) -> Conversion {
    if (target == 2) {
        return Conversion.Accepted(Value.I8(i8(item)));
    }
    if (target == 3) {
        return Conversion.Accepted(Value.U8(u8(item)));
    }
    if (target == 4) {
        return Conversion.Accepted(Value.I16(i16(item)));
    }
    if (target == 5) {
        return Conversion.Accepted(Value.U16(u16(item)));
    }
    if (target == 6) {
        return Conversion.Accepted(Value.I32(int(item)));
    }
    if (target == 7) {
        return Conversion.Accepted(Value.U32(u32(item)));
    }
    if (target == 8) {
        return Conversion.Accepted(Value.I64(i64(item)));
    }
    if (target == 9) {
        return Conversion.Accepted(Value.U64(u64(item)));
    }
    return Conversion.Rejected;
}
pub Convert :: (value: Value, target: int, mode: int) -> Conversion {
    if (Storage(value) == target) {
        return Conversion.Accepted(value);
    }
    if (target == 11) {
        return ToDouble(value);
    }
    if (target == 10) {
        converted := ToDouble(value);
        if (converted is .Accepted(wide) && wide is .F64(item)) {
            return Conversion.Accepted(Value.F32(number(item)));
        }
        return Conversion.Rejected;
    }
    if (IntegerStorage(target) && IntegerStorage(Storage(value))) {
        return IntegerConvert(value, target, mode);
    }
    if (value is .F32(item)) {
        return FloatConvert(item, target);
    }
    if (value is .F64(item)) {
        return FloatConvert(item, target);
    }
    if (value is .Name(item, present) && target == 13) {
        return Conversion.Accepted(Value.Text(item, present));
    }
    if (value is .Text(item, present) && target == 12) {
        return Conversion.Accepted(Value.Name(item, present));
    }
    return Conversion.Rejected;
}

StringValue :: (value: string, present: bool) -> string {
    if (!present) {
        return "";
    }
    return value;
}

// Integer operators compute exactly, as stage zero folds an integer constant
// expression: a value is a sign and a 64-bit magnitude, and only the result
// must fit its storage.
Exact :: union {
    Number(negative: bool, magnitude: u64) | Failed(message: string)
}
NotFit :: "integer constant does not fit its type";
Reported :: "integer constant divides by zero, shifts by a negative count or negates an unsigned value";
// The most a constant shift count may be, as in stage zero's exact numbers.
ShiftLimit: u64 : 4096;

Negative :: (value: Value) -> bool {
    return Signed(Storage(value)) && i64(wrap: Bits(value)) < 0;
}
Magnitude :: (value: Value) -> u64 {
    if (Negative(value)) {
        return u64(0) - Bits(value);
    }
    return Bits(value);
}
Number :: (negative: bool, magnitude: u64) -> Exact {
    return Exact.Number(negative && magnitude != 0, magnitude);
}
// The two's complement word of a value whose higher bits all equal its sign.
Word :: (negative: bool, magnitude: u64) -> u64 {
    if (negative) {
        return u64(0) - magnitude;
    }
    return magnitude;
}
Mask :: (storage: int) -> u64 {
    return ~u64(0) >> u64(64 - Width(storage));
}
Sum :: (xn: bool, x: u64, yn: bool, y: u64) -> Exact {
    if (xn == yn) {
        sum := x + y;
        if (sum < x) {
            return Exact.Failed(NotFit);
        }
        return Number(xn, sum);
    }
    if (x >= y) {
        return Number(xn, x - y);
    }
    return Number(yn, y - x);
}
Product :: (xn: bool, x: u64, yn: bool, y: u64) -> Exact {
    product := x * y;
    if (x != 0 && product / x != y) {
        return Exact.Failed(NotFit);
    }
    return Number(xn != yn, product);
}
// Division truncates toward zero; a remainder takes the dividend's sign.
Quotient :: (op: int, xn: bool, x: u64, yn: bool, y: u64) -> Exact {
    if (y == 0) {
        return Exact.Failed(Reported);
    }
    if (op == OpDiv) {
        return Number(xn != yn, x / y);
    }
    return Number(xn, x % y);
}
// A right shift rounds toward negative infinity.
Shifted :: (op: int, xn: bool, x: u64, yn: bool, y: u64) -> Exact {
    if (yn) {
        return Exact.Failed("integer constant shift count must not be negative");
    }
    if (y > ShiftLimit) {
        return Exact.Failed("integer constant shift count is too large");
    }
    if (y == 0 || x == 0) {
        return Number(xn, x);
    }
    if (op == OpShiftLeft) {
        if (y >= 64 || (x >> (u64(64) - y)) != 0) {
            return Exact.Failed(NotFit);
        }
        return Number(xn, x << y);
    }
    if (y >= 64) {
        if (xn) {
            return Number(true, 1);
        }
        return Number(false, 0);
    }
    quotient := x >> y;
    if (xn && (quotient << y) != x) {
        quotient += 1;
    }
    return Number(xn, quotient);
}
Bitwise :: (op: int, xn: bool, x: u64, yn: bool, y: u64) -> Exact {
    left := Word(xn, x);
    right := Word(yn, y);
    word := left ^ right;
    negative := xn != yn;
    if (op == OpBitAnd) {
        word = left & right;
        negative = xn && yn;
    }
    if (op == OpBitOr) {
        word = left | right;
        negative = xn || yn;
    }
    if (!negative) {
        return Number(false, word);
    }
    if (word == 0) {
        return Exact.Failed(NotFit);
    }
    return Number(true, u64(0) - word);
}
Fitted :: (exact: Exact, storage: int) -> Result {
    switch exact {
        case .Failed(message):
            return Result.Failed(message);
        case .Number(negative, magnitude):
            limit := Mask(storage);
            if (Signed(storage)) {
                limit = limit >> u64(1);
                if (negative) {
                    limit += 1;
                }
            } else if (negative) {
                return Result.Failed(NotFit);
            }
            if (magnitude > limit) {
                return Result.Failed(NotFit);
            }
            return Publish(Word(negative, magnitude), storage);
    }
}
IntegerOperator :: (op: int) -> bool {
    return (op >= OpAdd && op <= OpNeg) || (op >= OpBitAnd && op <= OpBitNot);
}
// ~v keeps an unsigned storage's width: max - v; a signed one gives -v - 1.
IntegerOperation :: (op: int, left: Value, right: Value, storage: int) -> Result {
    xn := Negative(left);
    x := Magnitude(left);
    if (op == OpNeg) {
        if (!Signed(storage)) {
            return Result.Failed(Reported);
        }
        return Fitted(Number(!xn, x), storage);
    }
    if (op == OpBitNot) {
        if (Signed(storage)) {
            return Fitted(Sum(!xn, x, true, 1), storage);
        }
        return Fitted(Sum(false, Mask(storage), !xn, x), storage);
    }
    yn := Negative(right);
    y := Magnitude(right);
    if (op == OpAdd || op == OpSub) {
        return Fitted(Sum(xn, x, yn != (op == OpSub), y), storage);
    }
    if (op == OpMul) {
        return Fitted(Product(xn, x, yn, y), storage);
    }
    if (op == OpDiv || op == OpMod) {
        return Fitted(Quotient(op, xn, x, yn, y), storage);
    }
    if (op == OpShiftLeft || op == OpShiftRight) {
        return Fitted(Shifted(op, xn, x, yn, y), storage);
    }
    return Fitted(Bitwise(op, xn, x, yn, y), storage);
}
// The order of two integers of one storage: -1, 0 or 1.
Order :: (left: Value, right: Value) -> int {
    xn := Negative(left);
    if (xn != Negative(right)) {
        if (xn) {
            return -1;
        }
        return 1;
    }
    x := Magnitude(left);
    y := Magnitude(right);
    if (x == y) {
        return 0;
    }
    if ((x < y) != xn) {
        return -1;
    }
    return 1;
}
IntegerComparison :: (op: int, left: Value, right: Value) -> Result {
    storage := Storage(left);
    if (Storage(right) == storage && op >= OpEq && op <= OpGe) {
        order := Order(left, right);
        if (op == OpEq) {
            return Result.Folded(Value.Bool(order == 0));
        }
        if (op == OpNe) {
            return Result.Folded(Value.Bool(order != 0));
        }
        if (op == OpLt) {
            return Result.Folded(Value.Bool(order < 0));
        }
        if (op == OpLe) {
            return Result.Folded(Value.Bool(order <= 0));
        }
        if (op == OpGt) {
            return Result.Folded(Value.Bool(order > 0));
        }
        return Result.Folded(Value.Bool(order >= 0));
    }
    if (Signed(storage)) {
        return Result.Failed("unsupported scalar constant operator");
    }
    return Result.Failed("unsupported unsigned constant operator");
}

// Operator selection and errors are compiler policy; the selected typed
// expressions use the same ordinary runtime arithmetic and cast primitives.
PhysicalOperation :: (op: int, left: Value, right: Value) -> Result {
    if (op == OpNone) {
        return Result.Folded(left);
    }
    switch left {
        case .Bool(x):
            if (op == OpNot) {
                return Result.Folded(Value.Bool(!x));
            }
            if (right is .Bool(y)) {
                if (op == OpEq) {
                    return Result.Folded(Value.Bool(x == y));
                }
                if (op == OpNe) {
                    return Result.Folded(Value.Bool(x != y));
                }
            }
            return Result.Failed("unsupported scalar constant operator");
        case .I8(x):
            return IntegerComparison(op, left, right);
        case .U8(x):
            return IntegerComparison(op, left, right);
        case .I16(x):
            return IntegerComparison(op, left, right);
        case .U16(x):
            return IntegerComparison(op, left, right);
        case .I32(x):
            return IntegerComparison(op, left, right);
        case .U32(x):
            return IntegerComparison(op, left, right);
        case .I64(x):
            return IntegerComparison(op, left, right);
        case .U64(x):
            return IntegerComparison(op, left, right);
        case .F32(x):
            if (op == OpNeg) {
                return Result.Folded(Value.F32(-x));
            }
            if (right is .F32(y)) {
                if (op == OpEq) {
                    return Result.Folded(Value.Bool(x == y));
                }
                if (op == OpNe) {
                    return Result.Folded(Value.Bool(x != y));
                }
                if (op == OpAdd) {
                    return Result.Folded(Value.F32(x + y));
                }
                if (op == OpSub) {
                    return Result.Folded(Value.F32(x - y));
                }
                if (op == OpMul) {
                    return Result.Folded(Value.F32(x * y));
                }
                if (op == OpDiv) {
                    return Result.Folded(Value.F32(x / y));
                }
                if (op == OpMod) {
                    return Result.Folded(Value.F32(x % y));
                }
                if (op == OpLt) {
                    return Result.Folded(Value.Bool(x < y));
                }
                if (op == OpLe) {
                    return Result.Folded(Value.Bool(x <= y));
                }
                if (op == OpGt) {
                    return Result.Folded(Value.Bool(x > y));
                }
                if (op == OpGe) {
                    return Result.Folded(Value.Bool(x >= y));
                }
            }
            return Result.Failed("unsupported floating-point constant operator");
        case .F64(x):
            if (op == OpNeg) {
                return Result.Folded(Value.F64(-x));
            }
            if (right is .F64(y)) {
                if (op == OpEq) {
                    return Result.Folded(Value.Bool(x == y));
                }
                if (op == OpNe) {
                    return Result.Folded(Value.Bool(x != y));
                }
                if (op == OpAdd) {
                    return Result.Folded(Value.F64(x + y));
                }
                if (op == OpSub) {
                    return Result.Folded(Value.F64(x - y));
                }
                if (op == OpMul) {
                    return Result.Folded(Value.F64(x * y));
                }
                if (op == OpDiv) {
                    return Result.Folded(Value.F64(x / y));
                }
                if (op == OpMod) {
                    return Result.Folded(Value.F64(x % y));
                }
                if (op == OpLt) {
                    return Result.Folded(Value.Bool(x < y));
                }
                if (op == OpLe) {
                    return Result.Folded(Value.Bool(x <= y));
                }
                if (op == OpGt) {
                    return Result.Folded(Value.Bool(x > y));
                }
                if (op == OpGe) {
                    return Result.Folded(Value.Bool(x >= y));
                }
            }
            return Result.Failed("unsupported floating-point constant operator");
        case .Name(x, present):
            if (right is .Name(y, other_present)) {
                if (op == OpEq) {
                    return Result.Folded(Value.Bool(StringValue(x, present) == StringValue(y, other_present)));
                }
                if (op == OpNe) {
                    return Result.Folded(Value.Bool(StringValue(x, present) != StringValue(y, other_present)));
                }
            }
            if (right is .Text(y, other_present)) {
                if (op == OpEq) {
                    return Result.Folded(Value.Bool(StringValue(x, present) == StringValue(y, other_present)));
                }
                if (op == OpNe) {
                    return Result.Folded(Value.Bool(StringValue(x, present) != StringValue(y, other_present)));
                }
            }
            return Result.Failed("unsupported scalar constant operator");
        case .Text(x, present):
            if (right is .Name(y, other_present)) {
                if (op == OpEq) {
                    return Result.Folded(Value.Bool(StringValue(x, present) == StringValue(y, other_present)));
                }
                if (op == OpNe) {
                    return Result.Folded(Value.Bool(StringValue(x, present) != StringValue(y, other_present)));
                }
            }
            if (right is .Text(y, other_present)) {
                if (op == OpEq) {
                    return Result.Folded(Value.Bool(StringValue(x, present) == StringValue(y, other_present)));
                }
                if (op == OpNe) {
                    return Result.Folded(Value.Bool(StringValue(x, present) != StringValue(y, other_present)));
                }
            }
            return Result.Failed("unsupported scalar constant operator");
    }
}

// Integer storage publication retains the complete C intermediate word before
// truncating to the destination width: signed values sign-extend into it and
// publication keeps its low bits.
Bits :: (value: Value) -> u64 {
    switch value {
        case .I8(item):
            return u64(wrap: item);
        case .U8(item):
            return item;
        case .I16(item):
            return u64(wrap: item);
        case .U16(item):
            return item;
        case .I32(item):
            return u64(wrap: item);
        case .U32(item):
            return item;
        case .I64(item):
            return u64(wrap: item);
        case .U64(item):
            return item;
        case .Bool(item):
            return 0;
        case .F32(item):
            return 0;
        case .F64(item):
            return 0;
        case .Name(item, present):
            return 0;
        case .Text(item, present):
            return 0;
    }
}

Publish :: (bits: u64, storage: int) -> Result {
    if (storage == 2) {
        return Result.Folded(Value.I8(i8(wrap: bits)));
    }
    if (storage == 3) {
        return Result.Folded(Value.U8(u8(wrap: bits)));
    }
    if (storage == 4) {
        return Result.Folded(Value.I16(i16(wrap: bits)));
    }
    if (storage == 5) {
        return Result.Folded(Value.U16(u16(wrap: bits)));
    }
    if (storage == 6) {
        return Result.Folded(Value.I32(int(wrap: bits)));
    }
    if (storage == 7) {
        return Result.Folded(Value.U32(u32(wrap: bits)));
    }
    if (storage == 8) {
        return Result.Folded(Value.I64(i64(wrap: bits)));
    }
    if (storage == 9) {
        return Result.Folded(Value.U64(bits));
    }
    return Result.Failed("unsupported scalar constant operator");
}

Width :: (storage: int) -> int {
    if (storage == 2 || storage == 3) {
        return 8;
    }
    if (storage == 4 || storage == 5) {
        return 16;
    }
    if (storage == 6 || storage == 7) {
        return 32;
    }
    return 64;
}
Signed :: (storage: int) -> bool {
    return storage == 2 || storage == 4 || storage == 6 || storage == 8;
}
// This internal interface consumes well-typed analyzer IR: comparisons and
// logical not publish Bool, float arithmetic publishes F32/F64, and integer
// operations compute exactly and publish integer storage. Destination integer
// width may differ from the operands; only the result must fit it.
pub Operation :: (op: int, left: Value, right: Value, storage: int) -> Result {
    if (op == OpNone) {
        return Result.Folded(left);
    }
    if (IntegerStorage(Storage(left)) && IntegerStorage(storage) && IntegerOperator(op)) {
        return IntegerOperation(op, left, right, storage);
    }
    operated := PhysicalOperation(op, left, right);
    switch operated {
        case .Failed(message):
            return operated;
        case .Folded(value):
            resultStorage := Storage(value);
            if (resultStorage == 10 || resultStorage == 11) {
                converted := Convert(value, storage, 0);
                switch converted {
                    case .Rejected:
                        return Result.Failed("unsupported scalar constant conversion");
                    case .Unfit:
                        return Result.Failed("constant does not fit its conversion");
                    case .Accepted(item):
                        return Result.Folded(item);
                }
            }
            return operated;
    }
}
