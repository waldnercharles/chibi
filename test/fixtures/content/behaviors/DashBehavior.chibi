behavior "DashBehavior" {
    state "Just Started" := false
    state "Struck Entities": handle<"ecs.entity">[] = []
    on Dash {
        if delta_time() >= self.Dash.cooldown_remaining {
            if 0.0 >= self.Dash.remaining {
                await "Start Dash"()
            }
        }
    }
    on Tick {
        await "Advance Dash Timers"()
        if 0.0 < self.Dash.remaining {
            await "Drive Dash"()
        }
    }
    on "Contact Begin" {
        await "Strike Target"(event.Other)
    }
    function "Capture Dash Direction"() {
        after entry {
            if abs(break_cf_v2(self.Input.move).x) + abs(break_cf_v2(self.Input.move).y) >= 0.0001 {
                self.Dash.direction = vec2_norm(self.Input.move)
                return
            } else {
                self.Dash.direction = vec2_norm(self.Aim.direction)
                return
            }
        }
    }
    function "Drive Dash"() {
        after entry {
            self.Velocity = self.Dash.direction * self.Dash.speed
            self.Orientation = "DirectionMath"."Direction Orientation"(break_cf_v2(self.Dash.direction).x, break_cf_v2(self.Dash.direction).y)
            return
        }
    }
    function "Restore Movement"() {
        after entry {
            if self.Input {
                self.Velocity = "MovementActions"."Movement Velocity"(self.Input.move, self.Movement)
                return
            } else {
                self.Velocity = {
                    x: 0.0,
                    y: 0.0
                }
                return
            }
        }
    }
    function "Advance Dash"() {
        action set_gamedash_remaining = set_dash_remaining(max(self.Dash.remaining - delta_time(), B: float = 0.0))
        after entry {
            set_dash_remaining()
        }
        after set_gamedash_remaining {
            if 0.0 < set_gamedash_remaining.Value.remaining {
                return
            } else {
                await "Restore Movement"()
                return
            }
        }
    }
    function "Advance Dash Timers"() {
        after entry {
            if state."Just Started" {
                state."Just Started" = false
                return
            } else {
                self.Dash.cooldown_remaining = max(self.Dash.cooldown_remaining - delta_time(), B: float = 0.0)
                if 0.0 < self.Dash.remaining {
                    await "Advance Dash"()
                    return
                } else {
                    return
                }
            }
        }
    }
    function "Strike Target"(Other: handle<"ecs.entity"> = 0) {
        after entry {
            if 0.0 < self.Dash.remaining {
                if entry.Other.Health {
                    if entry.Other.Collider {
                        if has_any_flags(entry.Other.Collider.category, 2) {
                            if contains(state."Struck Entities", entry.Other) {
                                return
                            } else {
                                state."Struck Entities" = array_add(state."Struck Entities", entry.Other)
                                await send_event<"Damage">(entry.Other, self.Dash.damage, self)
                                return
                            }
                        } else {
                            return
                        }
                    } else {
                        return
                    }
                } else {
                    return
                }
            } else {
                return
            }
        }
    }
    function "Strike Current Contacts"() {
        after entry {
            foreach (foreach_2 in get_contact_entities(self, 2)) {
                await "Strike Target"(foreach_2)
            }
            return
        }
    }
    function "Start Dash"() {
        after entry {
            if self.Health.current >= 1 {
                await "Capture Dash Direction"()
                self.Dash.remaining = self.Dash.duration
                self.Dash.cooldown_remaining = self.Dash.cooldown
                state."Just Started" = true
                state."Struck Entities" = []
                await "Strike Current Contacts"()
                return
            } else {
                return
            }
        }
    }
}
