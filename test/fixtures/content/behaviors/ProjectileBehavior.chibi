behavior "ProjectileBehavior" {
    action set_gameprojectile_age = set_projectile_age(self.Projectile.age + delta_time())
    on Tick {
        await "Face Direction"(self.Velocity.x, self.Velocity.y)
        set_projectile_age()
    }
    after set_gameprojectile_age {
        if set_gameprojectile_age.Value.age >= set_gameprojectile_age.Value.lifetime {
            destroy_entity(self)
        }
    }
    function "Face Direction"(X: float = 0.0, Y: float = 0.0) {
        after entry {
            if self.Orientation {
                if greater_or_equal(0.0, "Direction Magnitude"(entry.X, entry.Y)) {
                    return
                } else {
                    self.Orientation = "DirectionMath"."Direction Orientation"(entry.X, entry.Y)
                    return
                }
            } else {
                return
            }
        }
    }
    pure function "Direction Magnitude"<T0: float, T1: float, T2: float>(x: T0 = 0.0, y: T1 = 0.0) -> (Result: T2 = 0.0) {
        return abs(entry.x) + abs(entry.y)
    }
}
