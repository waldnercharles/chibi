-    while (a->base) {
-        assert(a->offset <= SIZE_MAX - left);
-        left += a->offset;
-        a = a->base;
-    }
-    while (b->base) {
-        assert(b->offset <= SIZE_MAX - right);
-        right += b->offset;
-        b = b->base;
-    }
