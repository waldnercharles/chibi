package prepared_writer

import strings "core:strings"

// Prepared format v28, written exactly as execution_prepared_write encodes a
// module of authored functions, or of a behavior's states and event handlers.
// Every 64-bit payload (ids, layouts, scalar bits, union tags) is an index into
// the module's `wide` pool, whose entry 0 is zero for an absent payload.
// Nested values, table items and per-function tables are ranges of flat pools.
// Each metadata string is its 1-based index in the string table, which holds
// every distinct one in order of first use. The table follows the module's
// tables, then the 8-byte offset it starts at.
//
// Every table stays in Write; helpers encode one row, taking single records,
// scalars, text and the pools they index. Each appends its fields one at a
// time to the module's buffer, so no row builds an array of its own.

Magic: u64 : 0x4348494249505245;
Version: int : 28;

// A value. `wide` holds scalar bits, a union tag or a struct layout; nested
// struct fields, union payloads and array items are values[first, first + count),
// after the value itself. An absent authored struct still records its field
// count; an absent native one, a type header, records none.
pub Value :: struct {
    tag: int;
    container: int;
    type_name: string;
    has_type_name: bool;
    authored: bool;
    wide: int;
    text: string;
    has_text: bool;
    present: bool;
    first: int;
    count: int;
}
// Pin types the encoder distinguishes.
FlowTag: int : 0;
StructTag: int : 15;
UnionTag: int : 18;
NameTag: int : 12;
TextTag: int : 13;

pub Field :: struct {
    name: string;
    kind: int;
    type_name: string;
    has_type_name: bool;
    unit: string;
    has_unit: bool;
    container: int;
    record: int;
}
// An event the module handles; its payload fields are
// event_fields[first, first + count).
pub Event :: struct {
    id: int;
    abi: int;
    name: string;
    first: int;
    count: int;
}
pub EventField :: struct {
    name: string;
    nominal: int;
    has_default: bool;
    default_owner: bool;
    initial: int;
}
// A behavior's retained state and the value it starts with.
pub State :: struct {
    id: int;
    initial: int;
    shared: bool;
    contains_tasks: bool;
}
// A component a function reads or writes, and whether a binding owns it.
pub Component :: struct {
    id: int;
    binding: bool;
}
// An authored record requirement lists its fields; others resolve by identity.
pub Requirement :: struct {
    id: int;
    layout: int;
    storage: int;
    name: string;
    size: int;
    authored: bool;
    first: int;
    count: int;
}
pub Import :: struct {
    id: int;
    fingerprint: int;
}
// A function reference: own `index` in this module, or `function` (a wide id)
// in import `imported`. Null references have neither.
pub Reference :: struct {
    imported: int;
    own: int;
    function: int;
    role: int;
}
pub Source :: struct {
    graph: int;
    call: int;
    parent: int;
    asset: string;
    has_asset: bool;
    start: int;
    end: int;
    line: int;
    column: int;
}
pub Frame :: struct {
    source: int;
    depth: int;
    resume: int;
    source_index: int;
    stack: int;
}
pub Root :: struct {
    bank: int;
    index: int;
    shape: int;
}
// An instruction. Its frame, stack (-1), pin, indirect flag, component index
// and layout always hold their defaults in what the compiler writes, so they
// are not fields here and their bits stay clear in the row's mask.
pub Instruction :: struct {
    op: int;
    type: int;
    output: int;
    left: int;
    right: int;
    target: int;
    source: int;
    offset: int;
    node: int;
    value: int;
    message: string;
    has_message: bool;
}
pub Local :: struct {
    kind: int;
    initial: int;
    frame: int;
    node: int;
    pin: int;
    offset: int;
    parameter: bool;
    array_default: bool;
    data_index: int;
}
pub Parameter :: struct {
    initial: int;
    frame: int;
    pin: int;
}
pub ResultLayout :: struct {
    index: int;
    name: string;
}
pub Data :: struct {
    kind: int;
    initial: int;
    size: int;
}
pub Host :: struct {
    owned_arguments: bool;
    capability: int;
    abi: int;
    first: int;
    result_first: int;
    result_count: int;
    outcome_first: int;
    outcome_count: int;
}
// Existing asynchronous runtime command; all indices address this function's banks.
pub Command :: struct {
    capability: int;
    abi: int;
    first: int;
    count: int;
    node: int;
    result_first: int;
    result_count: int;
}
pub Call :: struct {
    owned_arguments: bool;
    function: int;
    first: int;
    count: int;
    result_first: int;
    result_count: int;
    task: bool;
}
pub Point :: struct {
    occurrence: int;
    meaning: int;
    start: int;
    end: int;
    line: int;
    column: int;
    kind: int;
    completion: bool;
}
pub Watch :: struct {
    origin: int;
    initial: int;
    ordinal: int;
    output: bool;
    reference: bool;
}
pub Span :: struct {
    first: int;
    count: int;
}
// Per-function tables, in spans[function.spans + table]. Kinds and slots are
// ints; defaults and roots name values; sources and stacks share `sources`.
// Component writes are ints naming component ids in `wide`.
ArgumentDefaults: int : 0;
ArgumentKinds: int : 1;
ResultDefaults: int : 2;
ResultKinds: int : 3;
VariableDefaults: int : 4;
Slots: int : 5;
SlotKinds: int : 6;
Roots: int : 7;
Instructions: int : 8;
Locals: int : 9;
Parameters: int : 10;
Frames: int : 11;
Sources: int : 12;
Stacks: int : 13;
Results: int : 14;
DataValues: int : 15;
Hosts: int : 16;
Commands: int : 17;
CommandArguments: int : 18;
CommandArgumentKinds: int : 19;
CommandResults: int : 20;
CommandResultKinds: int : 21;
Calls: int : 22;
Definitions: int : 23;
Components: int : 24;
ComponentWrites: int : 25;
SourcePoints: int : 26;
SourceWatches: int : 27;
pub Tables: int : 28;
pub Function :: struct {
    argument_count: int;
    result_count: int;
    variable_count: int;
    root_steps: int;
    child_budget: int;
    depth_bound: int;
    pure_depth_limit: int;
    breakpoints: bool;
    batchable: bool;
    managed: bool;
    custom_lowering: bool;
    checkpoints: bool;
    pin_watches: bool;
    watch_size: int;
    component_bindings: bool;
    component_access: bool;
    spans: int;
}
// A module function entry: an exported function, or a handler of the event
// `event_id` names in `wide` (0 for none). No observer, action or captures.
// `body` and `subscription` index `references`.
pub Entry :: struct {
    id: int;
    kind: int;
    entry_name: string;
    has_entry: bool;
    event_id: int;
    event_abi: int;
    event_name: string;
    has_event_name: bool;
    continuation_wait: bool;
    effects: int;
    body: int;
    subscription: int;
}
// One structural query term. Children name ints[first, first + count), and
// predicate indexes references, or is -1 for terms without an evaluator.
pub Query :: struct {
    kind: int;
    required: bool;
    component_id: int;
    source_relationship: int;
    source_traversal: int;
    source_variable: int;
    target_variable: int;
    predicate: int;
    first: int;
    count: int;
}
// A reusable query's root term, entity variables, row shape and evaluator.
// row_type indexes values; evaluate indexes references.
pub QueryDescription :: struct {
    query_root: int;
    query_variable_count: int;
    row_type: int;
    evaluate: int;
}
pub Module :: union {
    Tables(id: u64, owner_type: u64, abi: u64, pointer_size: int, wide: u64[], values: Value[], ints: int[],
           requirements: Requirement[], fields: Field[], event_declarations: Event[],
           event_fields: EventField[], imports: Import[], functions: Function[], spans: Span[], roots: Root[],
           instructions: Instruction[], locals: Local[], parameters: Parameter[], frames: Frame[],
           sources: Source[], results: ResultLayout[], data: Data[], hosts: Host[], commands: Command[], calls: Call[],
           references: Reference[], components: Component[], points: Point[], watches: Watch[],
           states: State[], entries: Entry[], queries: Query[], query_root: int, query_variable_count: int,
           query_filter: int, descriptions: QueryDescription[], system_description: int)
}

// A 64-bit word as a varint: seven bits at a time from the low end, the high
// bit marking that more follow.
Varint :: (out: ^(u8[]), word: u64) {
    rest := word;
    while ((rest >> 7) != 0) {
        out.append(u8(wrap: rest | 128));
        rest = rest >> 7;
    }
    out.append(u8(wrap: rest));
}
// An int as the varint of its zigzag word, which keeps small negative values,
// such as -1 for none, one byte long.
Int :: (out: ^(u8[]), value: int) {
    wide := i64(value);
    rest := u64(wrap: wide << 1) ^ u64(wrap: wide >> 63);
    while ((rest >> 7) != 0) {
        out.append(u8(wrap: rest | 128));
        rest = rest >> 7;
    }
    out.append(u8(wrap: rest));
}
// values[first, first + count), each as an Int.
Ints :: (out: ^(u8[]), values: int[], first: int, count: int) {
    index := first;
    while (index < first + count) {
        Int(out, values[index]);
        index += 1;
    }
}
// A bool as the varint 0 or 1.
Flag :: (out: ^(u8[]), value: bool) {
    if (value) {
        out.append(u8(1));
        return;
    }
    out.append(u8(0));
}
// `count` zero varints, the encoding of absent fields.
Zeros :: (out: ^(u8[]), count: int) {
    index: int = 0;
    while (index < count) {
        out.append(u8(0));
        index += 1;
    }
}
// The bytes of a string.
Raw :: (out: ^(u8[]), value: string) {
    for (code in strings.Bytes(value)) {
        out.append(u8(wrap: code));
    }
}
// Eight bytes, low byte first.
Fixed64 :: (out: ^(u8[]), value: u64) {
    index: int = 0;
    rest := value;
    while (index < 8) {
        out.append(u8(wrap: rest));
        rest = rest >> 8;
        index += 1;
    }
}
// The slot an open-addressed table of mask + 1 slots starts probing for
// `value` at: FNV-1a over its bytes.
Slot :: (value: string, mask: int) -> int {
    hash: u64 = 14695981039346656037;
    for (code in strings.Bytes(value)) {
        hash = (hash ^ u64(code)) * 1099511628211;
    }
    return int(hash & u64(mask));
}
// A power of two of at least twice `count` slots, which keeps probes short.
SlotCount :: (count: int) -> int {
    size: int = 1;
    while (size < 2 * count) {
        size = size * 2;
    }
    return size;
}
// The string table: each string of `texts` once, in order of first use.
Table :: (texts: string[]) -> string[] {
    mask := SlotCount(length(texts)) - 1;
    slots := resize([int(0)], mask + 1);
    found: string[] = [];
    for (value in texts) {
        at := Slot(value, mask);
        while (slots[at] != 0 && found[slots[at] - 1] != value) {
            at = (at + 1) & mask;
        }
        if (slots[at] == 0) {
            found.append(value);
            slots[at] = length(found);
        }
    }
    return found;
}
// Slots holding the 1-based index of each string of the table.
TableSlots :: (items: string[]) -> int[] {
    mask := SlotCount(length(items)) - 1;
    slots := resize([int(0)], mask + 1);
    index: int = 0;
    while (index < length(items)) {
        at := Slot(items[index], mask);
        while (slots[at] != 0) {
            at = (at + 1) & mask;
        }
        slots[at] = index + 1;
        index += 1;
    }
    return slots;
}
// The table's count, then each string's byte length plus one and its bytes.
TableBytes :: (out: ^(u8[]), items: string[]) {
    Int(out, length(items));
    for (item in items) {
        Varint(out, u64(strings.ByteLength(item) + 1));
        Raw(out, item);
    }
}
// The 1-based index of `value` in the table, which holds it.
TextIndex :: (value: string, items: string[], slots: int[]) -> int {
    mask := length(slots) - 1;
    at := Slot(value, mask);
    while (items[slots[at] - 1] != value) {
        at = (at + 1) & mask;
    }
    return slots[at];
}
// Absent text is 0; otherwise its table index.
Text :: (out: ^(u8[]), value: string, present: bool, items: string[], slots: int[]) {
    if (!present) {
        out.append(u8(0));
        return;
    }
    Varint(out, u64(TextIndex(value, items, slots)));
}
// A value's own bytes; its nested values follow them. `bits` is its wide entry.
ValueHead :: (out: ^(u8[]), v: Value, bits: u64, items: string[], slots: int[]) {
    Int(out, v.tag);
    Int(out, v.container);
    Text(out, v.type_name, v.has_type_name, items, slots);
    Flag(out, v.authored);
    if (v.container != 0) {
        Flag(out, v.present);
        if (v.present) {
            Int(out, v.count);
        }
        return;
    }
    if (v.tag == StructTag) {
        Varint(out, bits);
        Flag(out, v.present);
        Int(out, v.count);
        return;
    }
    if (v.tag == UnionTag) {
        Flag(out, v.present);
        if (v.present) {
            Varint(out, bits);
            Int(out, v.count);
        }
        return;
    }
    if (v.tag == TextTag) {
        Varint(out, u64(strings.ByteLength(v.text)));
        Raw(out, v.text);
        return;
    }
    if (v.tag == NameTag) {
        Text(out, v.text, v.has_text, items, slots);
        return;
    }
    Varint(out, bits);
}
// A source; `asset` is its asset's table index, 0 for none.
SourceBytes :: (out: ^(u8[]), v: Source, wide: u64[], asset: int) {
    Varint(out, wide[v.graph]);
    Varint(out, wide[v.call]);
    Int(out, v.parent);
    Varint(out, u64(asset));
    Int(out, v.start);
    Int(out, v.end);
    Int(out, v.line);
    Int(out, v.column);
}
ReferenceBytes :: (out: ^(u8[]), v: Reference, wide: u64[]) {
    Int(out, v.imported);
    Int(out, v.own);
    Varint(out, wide[v.function]);
    Int(out, v.role);
}
PointBytes :: (out: ^(u8[]), v: Point, wide: u64[]) {
    Varint(out, wide[v.occurrence]);
    Varint(out, wide[v.meaning]);
    Int(out, v.start);
    Int(out, v.end);
    Int(out, v.line);
    Int(out, v.column);
    Int(out, v.kind);
    Flag(out, v.completion);
}
// An instruction's fields that mostly hold their default follow a mask of the
// ones that differ from it, in this bit order, as prepared_function.c reads
// them. A value is default when it encodes as five zero bytes: a single flow
// value without a name. Bits 16 to 256 and 1024 (frame, stack, pin, indirect,
// component, layout) are never set.
InstructionRight: int : 1;
InstructionTarget: int : 2;
InstructionOffset: int : 4;
InstructionValue: int : 8;
InstructionNode: int : 512;
InstructionMessage: int : 2048;
// An instruction with its value, layout and message.
InstructionBytes :: (out: ^(u8[]), v: Instruction, wide: u64[], pool: u8[], starts: int[], sizes: int[],
                     items: string[], slots: int[]) {
    Int(out, v.op);
    Int(out, v.type);
    Int(out, v.output);
    Int(out, v.left);
    Int(out, v.source);
    value := starts[v.value];
    empty := sizes[v.value] == 5 && pool[value] == 0 && pool[value + 1] == 0 && pool[value + 2] == 0 &&
             pool[value + 3] == 0 && pool[value + 4] == 0;
    fields: int = 0;
    if (v.right != 0) {
        fields = fields | InstructionRight;
    }
    if (v.target != 0) {
        fields = fields | InstructionTarget;
    }
    if (v.offset != 0) {
        fields = fields | InstructionOffset;
    }
    if (!empty) {
        fields = fields | InstructionValue;
    }
    if (wide[v.node] != 0) {
        fields = fields | InstructionNode;
    }
    if (v.has_message) {
        fields = fields | InstructionMessage;
    }
    Varint(out, u64(fields));
    if ((fields & InstructionRight) != 0) {
        Int(out, v.right);
    }
    if ((fields & InstructionTarget) != 0) {
        Int(out, v.target);
    }
    if ((fields & InstructionOffset) != 0) {
        Varint(out, u64(v.offset));
    }
    if ((fields & InstructionValue) != 0) {
        out.extend(slice(pool, value, sizes[v.value]));
    }
    if ((fields & InstructionNode) != 0) {
        Varint(out, wide[v.node]);
    }
    if ((fields & InstructionMessage) != 0) {
        Text(out, v.message, true, items, slots);
    }
}
LocalBytes :: (out: ^(u8[]), v: Local, wide: u64[], pool: u8[], starts: int[], sizes: int[]) {
    Int(out, v.kind);
    out.extend(slice(pool, starts[v.initial], sizes[v.initial]));
    Int(out, v.frame);
    Varint(out, wide[v.node]);
    Int(out, v.pin);
    Varint(out, u64(v.offset));
    Flag(out, v.parameter);
    Flag(out, v.array_default);
    Int(out, v.data_index);
}
HostBytes :: (out: ^(u8[]), v: Host, wide: u64[]) {
    Varint(out, wide[v.capability]);
    Varint(out, wide[v.abi]);
    Int(out, v.first);
    Int(out, v.result_first);
    Int(out, v.result_count);
    Flag(out, v.owned_arguments);
    Int(out, v.outcome_count);
    index := v.outcome_first;
    while (index < v.outcome_first + v.outcome_count) {
        Varint(out, wide[index]);
        index += 1;
    }
}
CallBytes :: (out: ^(u8[]), v: Call, target: Reference, wide: u64[]) {
    ReferenceBytes(out, target, wide);
    Int(out, v.first);
    Int(out, v.count);
    Int(out, v.result_first);
    Int(out, v.result_count);
    Flag(out, v.task);
    Flag(out, v.owned_arguments);
}
FunctionHead :: (out: ^(u8[]), v: Function) {
    Int(out, v.argument_count);
    Int(out, v.result_count);
    Int(out, v.variable_count);
    Varint(out, u64(v.root_steps));
    Varint(out, u64(v.child_budget));
    Varint(out, u64(v.depth_bound));
    Varint(out, u64(v.pure_depth_limit));
    Flag(out, v.breakpoints);
    Flag(out, v.batchable);
    Flag(out, v.managed);
    Flag(out, v.custom_lowering);
    Flag(out, v.checkpoints);
    Flag(out, v.pin_watches);
    Varint(out, u64(v.watch_size));
    Flag(out, v.component_bindings);
    Flag(out, v.component_access);
}
// An entry before its body and subscription references.
EntryHead :: (out: ^(u8[]), v: Entry, wide: u64[], items: string[], slots: int[]) {
    // Event, event ABI, the observer's component, layout, field and offset,
    // then its type: a zero flow value with no container, type name, author
    // or bits, as an empty observer type is written.
    Varint(out, wide[v.id]);
    Varint(out, wide[v.event_id]);
    Varint(out, wide[v.event_abi]);
    Zeros(out, 4);
    Int(out, FlowTag);
    Zeros(out, 4);
    // The observer's argument, action, parent and outcome, then no captures.
    Zeros(out, 6);
    Flag(out, v.continuation_wait);
    Int(out, v.kind);
    Text(out, v.entry_name, v.has_entry, items, slots);
    Text(out, v.event_name, v.has_event_name, items, slots);
    Varint(out, wide[v.effects]);
}
// An event declaration with its payload fields.
EventBytes :: (out: ^(u8[]), v: Event, fields: EventField[], wide: u64[], pool: u8[], starts: int[],
               sizes: int[], items: string[], slots: int[]) {
    Varint(out, wide[v.id]);
    Varint(out, wide[v.abi]);
    Text(out, v.name, true, items, slots);
    Int(out, v.count);
    index := v.first;
    while (index < v.first + v.count) {
        field := fields[index];
        Text(out, field.name, true, items, slots);
        Varint(out, wide[field.nominal]);
        Flag(out, field.has_default);
        Flag(out, field.default_owner);
        out.extend(slice(pool, starts[field.initial], sizes[field.initial]));
        index += 1;
    }
}

// What Write writes: which values, and its metadata strings in the order it
// writes them, a run of sources of one asset naming it once.
Gathered :: union {
    Of(texts: string[], used: bool[])
}
Gather :: (module: Module) -> Gathered {
    switch module {
        case .Tables(id, owner_type, abi, pointer_size, wide, values, ints, requirements, fields, event_declarations,
                     event_fields, imports, functions, spans, roots, instructions, locals, parameters, frames,
                     sources, results, data, hosts, commands, calls, references, components, points, watches, states,
                     entries, queries, query_root, query_variable_count, query_filter, descriptions, system_description):
            // Each step is a value Write writes, or -1 - n for named[n].
            named: string[] = [];
            steps: int[] = [];
            for (requirement in requirements) {
                named.append(requirement.name);
                steps.append(-length(named));
                index := requirement.first;
                while (requirement.authored && index < requirement.first + requirement.count) {
                    field := fields[index];
                    named.append(field.name);
                    steps.append(-length(named));
                    if (field.has_type_name) {
                        named.append(field.type_name);
                        steps.append(-length(named));
                    }
                    if (field.has_unit) {
                        named.append(field.unit);
                        steps.append(-length(named));
                    }
                    index += 1;
                }
            }
            for (declared in event_declarations) {
                named.append(declared.name);
                steps.append(-length(named));
                index := declared.first;
                while (index < declared.first + declared.count) {
                    named.append(event_fields[index].name);
                    steps.append(-length(named));
                    steps.append(event_fields[index].initial);
                    index += 1;
                }
            }
            asset := "";
            known := false;
            for (function in functions) {
                table: int = 0;
                while (table < Tables) {
                    span := spans[function.spans + table];
                    item := span.first;
                    last := span.first + span.count;
                    if (table == ArgumentDefaults || table == ResultDefaults || table == VariableDefaults ||
                        table == CommandArguments || table == CommandResults) {
                        while (item < last) {
                            steps.append(item);
                            item += 1;
                        }
                    } else if (table == Roots) {
                        while (item < last) {
                            steps.append(roots[item].shape);
                            item += 1;
                        }
                    } else if (table == Instructions) {
                        while (item < last) {
                            steps.append(instructions[item].value);
                            if (instructions[item].has_message) {
                                named.append(instructions[item].message);
                                steps.append(-length(named));
                            }
                            item += 1;
                        }
                    } else if (table == Locals) {
                        while (item < last) {
                            steps.append(locals[item].initial);
                            item += 1;
                        }
                    } else if (table == Parameters) {
                        while (item < last) {
                            steps.append(parameters[item].initial);
                            item += 1;
                        }
                    } else if (table == Frames || table == Sources || table == Stacks) {
                        while (item < last) {
                            row := item;
                            if (table == Frames) {
                                row = frames[item].source;
                            }
                            source := sources[row];
                            if (source.has_asset && (!known || source.asset != asset)) {
                                asset = source.asset;
                                known = true;
                                named.append(asset);
                                steps.append(-length(named));
                            }
                            item += 1;
                        }
                    } else if (table == Results) {
                        while (item < last) {
                            named.append(results[item].name);
                            steps.append(-length(named));
                            item += 1;
                        }
                    } else if (table == DataValues) {
                        while (item < last) {
                            steps.append(data[item].initial);
                            item += 1;
                        }
                    } else if (table == SourceWatches) {
                        while (item < last) {
                            steps.append(watches[item].initial);
                            item += 1;
                        }
                    }
                    table += 1;
                }
            }
            for (retained in states) {
                steps.append(retained.initial);
            }
            for (item in entries) {
                if (item.has_entry) {
                    named.append(item.entry_name);
                    steps.append(-length(named));
                }
                if (item.has_event_name) {
                    named.append(item.event_name);
                    steps.append(-length(named));
                }
            }
            for (description in descriptions) {
                steps.append(description.row_type);
            }
            // A value writes its own strings, then those of its nested values
            // in order, so a stack walks each written value in that order.
            texts: string[] = [];
            used := resize([false], length(values));
            stack: int[] = [];
            for (step in steps) {
                if (step < 0) {
                    texts.append(named[-1 - step]);
                    continue;
                }
                if (length(stack) == 0) {
                    stack.append(step);
                }
                stack[0] = step;
                top: int = 1;
                while (top > 0) {
                    top -= 1;
                    v := values[stack[top]];
                    used[stack[top]] = true;
                    if (v.has_type_name) {
                        texts.append(v.type_name);
                    }
                    if (v.container == 0 && v.tag == NameTag && v.has_text) {
                        texts.append(v.text);
                    }
                    nested := v.first + v.count - 1;
                    aggregate := v.container != 0 || v.tag == StructTag || v.tag == UnionTag;
                    while (aggregate && v.present && nested >= v.first) {
                        if (top < length(stack)) {
                            stack[top] = nested;
                        } else {
                            stack.append(nested);
                        }
                        top += 1;
                        nested -= 1;
                    }
                }
            }
            return Gathered.Of(texts, used);
    }
}

// The complete inner module.
pub Write :: (module: Module) -> u8[] {
    bytes: u8[] = [];
    switch Gather(module) {
        case .Of(texts, used):
            WriteTables(&bytes, module, Table(texts), used);
    }
    return bytes;
}
WriteTables :: (out: ^(u8[]), module: Module, items: string[], used: bool[]) {
    slots := TableSlots(items);
    switch module {
        case .Tables(id, owner_type, abi, pointer_size, wide, values, ints, requirements, fields, event_declarations,
                     event_fields, imports, functions, spans, roots, instructions, locals, parameters, frames,
                     sources, results, data, hosts, commands, calls, references, components, points, watches, states,
                     entries, queries, query_root, query_variable_count, query_filter, descriptions, system_description):
            // A value's bytes are its own, then those of the values nested in
            // it. Nested values follow their parent, so encoding from the last
            // value back finds every nested value already in the pool.
            pool: u8[] = [];
            starts := resize([int(0)], length(values));
            sizes := resize([int(0)], length(values));
            at := length(values) - 1;
            while (at >= 0) {
                if (used[at]) {
                    start := length(pool);
                    v := values[at];
                    ValueHead(&pool, v, wide[v.wide], items, slots);
                    if ((v.container != 0 || v.tag == StructTag || v.tag == UnionTag) && v.present) {
                        nested := v.first;
                        while (nested < v.first + v.count) {
                            pool.extend(slice(pool, starts[nested], sizes[nested]));
                            nested += 1;
                        }
                    }
                    starts[at] = start;
                    sizes[at] = length(pool) - start;
                }
                at -= 1;
            }

            Varint(out, Magic);
            Varint(out, u64(Version));
            Varint(out, u64(pointer_size));
            Varint(out, abi);
            Varint(out, id);
            Varint(out, owner_type);
            Int(out, length(requirements));
            for (requirement in requirements) {
                Varint(out, wide[requirement.id]);
                Varint(out, wide[requirement.layout]);
                Int(out, requirement.storage);
                Text(out, requirement.name, true, items, slots);
                Varint(out, u64(requirement.size));
                Flag(out, requirement.authored);
                if (requirement.authored) {
                    Int(out, requirement.count);
                    index: int = 0;
                    while (index < requirement.count) {
                        field := fields[requirement.first + index];
                        Text(out, field.name, true, items, slots);
                        Int(out, field.kind);
                        Text(out, field.type_name, field.has_type_name, items, slots);
                        Text(out, field.unit, field.has_unit, items, slots);
                        Flag(out, field.kind == TextTag && field.container == 0);
                        Int(out, field.container);
                        Int(out, field.record);
                        index += 1;
                    }
                }
            }
            Int(out, length(event_declarations));
            for (declared in event_declarations) {
                EventBytes(out, declared, event_fields, wide, pool, starts, sizes, items, slots);
            }
            Int(out, length(imports));
            for (imported in imports) {
                Varint(out, wide[imported.id]);
                Varint(out, wide[imported.fingerprint]);
            }

            // Consecutive sources and frames of one asset look its text up once;
            // asset_index is 0 until the first.
            asset := "";
            asset_index: int = 0;
            Int(out, length(functions));
            for (function in functions) {
                FunctionHead(out, function);
                table: int = 0;
                while (table < Tables) {
                    span := spans[function.spans + table];
                    Int(out, span.count);
                    item := span.first;
                    last := span.first + span.count;
                    if (table == ArgumentDefaults || table == ResultDefaults || table == VariableDefaults ||
                        table == CommandArguments || table == CommandResults) {
                        while (item < last) {
                            out.extend(slice(pool, starts[item], sizes[item]));
                            item += 1;
                        }
                    } else if (table == ArgumentKinds || table == ResultKinds || table == Slots ||
                               table == SlotKinds || table == CommandArgumentKinds || table == CommandResultKinds) {
                        Ints(out, ints, span.first, span.count);
                    } else if (table == Roots) {
                        while (item < last) {
                            Int(out, roots[item].bank);
                            Int(out, roots[item].index);
                            out.extend(slice(pool, starts[roots[item].shape], sizes[roots[item].shape]));
                            item += 1;
                        }
                    } else if (table == Instructions) {
                        while (item < last) {
                            InstructionBytes(out, instructions[item], wide, pool, starts, sizes, items, slots);
                            item += 1;
                        }
                    } else if (table == Locals) {
                        while (item < last) {
                            LocalBytes(out, locals[item], wide, pool, starts, sizes);
                            item += 1;
                        }
                    } else if (table == Parameters) {
                        while (item < last) {
                            initial := parameters[item].initial;
                            out.extend(slice(pool, starts[initial], sizes[initial]));
                            Int(out, parameters[item].frame);
                            Int(out, parameters[item].pin);
                            item += 1;
                        }
                    } else if (table == Frames || table == Sources || table == Stacks) {
                        while (item < last) {
                            row := item;
                            if (table == Frames) {
                                row = frames[item].source;
                            }
                            source := sources[row];
                            if (source.has_asset && (asset_index == 0 || source.asset != asset)) {
                                asset = source.asset;
                                asset_index = TextIndex(asset, items, slots);
                            }
                            if (source.has_asset) {
                                SourceBytes(out, source, wide, asset_index);
                            } else {
                                SourceBytes(out, source, wide, 0);
                            }
                            if (table == Frames) {
                                frame := frames[item];
                                Int(out, frame.depth);
                                Int(out, frame.resume);
                                Int(out, frame.source_index);
                                Int(out, frame.stack);
                            }
                            item += 1;
                        }
                    } else if (table == Results) {
                        while (item < last) {
                            Int(out, results[item].index);
                            Text(out, results[item].name, true, items, slots);
                            item += 1;
                        }
                    } else if (table == DataValues) {
                        while (item < last) {
                            Int(out, data[item].kind);
                            out.extend(slice(pool, starts[data[item].initial], sizes[data[item].initial]));
                            Varint(out, u64(data[item].size));
                            item += 1;
                        }
                    } else if (table == Hosts) {
                        while (item < last) {
                            HostBytes(out, hosts[item], wide);
                            item += 1;
                        }
                        // No query rows. Commands and their banks follow separately.
                        Zeros(out, 1);
                    } else if (table == Commands) {
                        // Capability, ABI, two absent fields and no text; then the
                        // argument range, node, an absent field, the result range
                        // and a last absent field.
                        while (item < last) {
                            command := commands[item];
                            Varint(out, wide[command.capability]);
                            Varint(out, wide[command.abi]);
                            Zeros(out, 3);
                            Int(out, command.first);
                            Int(out, command.count);
                            Varint(out, wide[command.node]);
                            Zeros(out, 1);
                            Int(out, command.result_first);
                            Int(out, command.result_count);
                            Zeros(out, 1);
                            item += 1;
                        }
                    } else if (table == Calls) {
                        while (item < last) {
                            CallBytes(out, calls[item], references[calls[item].function], wide);
                            item += 1;
                        }
                    } else if (table == Definitions) {
                        while (item < last) {
                            ReferenceBytes(out, references[ints[item]], wide);
                            item += 1;
                        }
                    } else if (table == Components) {
                        while (item < last) {
                            Varint(out, wide[components[item].id]);
                            Flag(out, components[item].binding);
                            item += 1;
                        }
                    } else if (table == ComponentWrites) {
                        while (item < last) {
                            Varint(out, wide[ints[item]]);
                            item += 1;
                        }
                        // No state selections follow component writes.
                        Zeros(out, 1);
                    } else if (table == SourcePoints) {
                        while (item < last) {
                            PointBytes(out, points[item], wide);
                            item += 1;
                        }
                    } else {
                        while (item < last) {
                            watch := watches[item];
                            PointBytes(out, points[watch.origin], wide);
                            out.extend(slice(pool, starts[watch.initial], sizes[watch.initial]));
                            Int(out, watch.ordinal);
                            Flag(out, watch.output);
                            Flag(out, watch.reference);
                            item += 1;
                        }
                    }
                    table += 1;
                }
                // Points, watches and edges are debugger tables this module has none of.
                Zeros(out, 3);
            }

            Int(out, length(states));
            for (retained in states) {
                Varint(out, wide[retained.id]);
                out.extend(slice(pool, starts[retained.initial], sizes[retained.initial]));
                Flag(out, retained.shared);
                Flag(out, retained.contains_tasks);
            }
            Int(out, length(entries));
            for (item in entries) {
                EntryHead(out, item, wide, items, slots);
                ReferenceBytes(out, references[item.body], wide);
                ReferenceBytes(out, references[item.subscription], wide);
            }
            Int(out, length(queries));
            for (term in queries) {
                Int(out, term.kind);
                Flag(out, term.required);
                Varint(out, wide[term.component_id]);
                Varint(out, wide[term.source_relationship]);
                Int(out, term.source_traversal);
                Int(out, term.source_variable);
                Int(out, term.target_variable);
                if (term.predicate < 0) {
                    // A null reference.
                    Int(out, -1);
                    Int(out, -1);
                    Zeros(out, 2);
                } else {
                    ReferenceBytes(out, references[term.predicate], wide);
                }
                Int(out, term.count);
                Ints(out, ints, term.first, term.count);
            }
            Int(out, query_root);
            Int(out, query_variable_count);
            Int(out, query_filter);
            Int(out, length(descriptions));
            for (description in descriptions) {
                Int(out, description.query_root);
                Int(out, description.query_variable_count);
                initial := description.row_type;
                out.extend(slice(pool, starts[initial], sizes[initial]));
                ReferenceBytes(out, references[description.evaluate], wide);
            }
            // The selected system description is one-based; zero means none.
            // Reactive bindings and actions are absent from authored compiler modules.
            Int(out, system_description);
            Zeros(out, 2);
            strings_at := length(out^);
            TableBytes(out, items);
            Fixed64(out, u64(strings_at));
    }
}

// FNV-1a over the module bytes, as import fingerprints use; zero becomes one.
pub Fingerprint :: (bytes: u8[]) -> u64 {
    hash: u64 = 14695981039346656037;
    for (item in bytes) {
        hash = (hash ^ u64(item)) * 1099511628211;
    }
    if (hash == 0) {
        return 1;
    }
    return hash;
}

// CHIBICLO v1: header words "CHIBICLO", version, root id and row count, then
// rows sorted bytewise by name: id, name length, module length, name, module.
// Module bytes are data[starts[i], starts[i] + lengths[i]).
pub Closure :: (root: u64, ids: u64[], names: string[], data: u8[],
                starts: int[], lengths: int[]) -> u8[] {
    order: int[] = [];
    index: int = 0;
    while (index < length(names)) {
        at := length(order);
        order.append(index);
        while (at > 0 && strings.Compare(names[order[at - 1]], names[index]) > 0) {
            order[at] = order[at - 1];
            at -= 1;
        }
        order[at] = index;
        index += 1;
    }
    bytes: u8[] = [67, 72, 73, 66, 73, 67, 76, 79];
    Fixed64(&bytes, 1);
    Fixed64(&bytes, root);
    Fixed64(&bytes, u64(length(names)));
    for (row in order) {
        name := names[row];
        Fixed64(&bytes, ids[row]);
        Fixed64(&bytes, u64(strings.ByteLength(name)));
        Fixed64(&bytes, u64(lengths[row]));
        Raw(&bytes, name);
        bytes.extend(slice(data, starts[row], lengths[row]));
    }
    return bytes;
}
