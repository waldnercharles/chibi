behavior "ContactRegistry" {
    owner "ecs.entity";
    state contacted: set<handle<"ecs.entity">> = [];
    value contacted_2 = get_variable<"contacted">();
    value set_contains = set_contains(Set: set<handle<"ecs.entity">> = contacted_2, Item: handle<"ecs.entity"> = contact_begin.Other);
    on "Contact Begin" as contact_begin(Other: handle<"ecs.entity"> = 0, Point: struct<"CF_V2"> = null) {
        if (set_contains) {
        } else {
            set_variable<"contacted">(Value: set<handle<"ecs.entity">> = set_add(Set: set<handle<"ecs.entity">> = contacted_2, Item: handle<"ecs.entity"> = contact_begin.Other));
        }
    }
}
