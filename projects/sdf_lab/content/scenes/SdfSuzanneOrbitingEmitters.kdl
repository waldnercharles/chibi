version 1
name "SdfSuzanneOrbitingEmitters"
(array)entities {
    - {
        name "Camera"
        prototype "SdfOptimizationCamera"
        components {
            GameTransform x=0.0 y=0.0
            GameCamera width=180.0 height=160.0 focal_distance=650.0 yaw=0.0 pitch=0.0 roll=0.0 target_elevation=0.0
            GameSurfaceQuality resolution="Full" sdf_normal_mode="Analytic" sdf_pixel_error=0.0 disable_sdf_lod=#true
            GameHRC2D surface_mode="Depth thickness" surface_depth_radius=128.0 surface_thickness=12.0 surface_shadow_mode="Horizon8" surface_radius=24.0 intensity=3.0 exposure=3.0 resolution=0.5 min_resolution=0.5 adaptive=#false lighting_margin=125.0 ambient=0.002 fog=0.0 shadow_floor=0.0 bloom=0.0 bounce_intensity=0.0 feedback=#false
        }
    }
    - {
        name "Subdivided Blender Suzanne"
        prototype "SdfRoundedBox"
        components {
            GameTransform x=0.0 y=0.0
            GameGeometry3D width=1.0 height=1.0 depth=1.0 elevation=0.0
            GameVisualTransform scale=1.1 pitch=0.55 yaw=0.0 roll=-1.4
            GameShader shape="SdfSampledSuzanne" material="SdfIvory"
            GameMaterial emission_intensity=0.0
        }
    }
    - {
        name "Cyan orbiting emitter"
        prototype "SdfSphere"
        components {
            GameTransform x=60.0 y=0.0
            GameGeometry3D width=64.0 height=64.0 depth=64.0 elevation=65.0
            GameVisualTransform scale=0.2 pitch=0.0 yaw=0.0 roll=0.0
            GameShader shape="SdfSphere" material=""
            GameMaterial scene=0xffffffff albedo=0xffffffff emission_color=0x38d9edff emission_intensity=3.0 emission_multiplier=1.0 absorption=0.0
        }
        (array)behaviors "SdfCoverageLightCircle"
    }
    - {
        name "Amber orbiting emitter"
        prototype "SdfSphere"
        components {
            GameTransform x=-60.0 y=0.0
            GameGeometry3D width=64.0 height=64.0 depth=64.0 elevation=65.0
            GameVisualTransform scale=0.2 pitch=0.0 yaw=0.0 roll=0.0
            GameShader shape="SdfSphere" material=""
            GameMaterial scene=0xffffffff albedo=0xffffffff emission_color=0xffac54ff emission_intensity=3.0 emission_multiplier=1.0 absorption=0.0
        }
        (array)behaviors "SdfSuzanneOppositeCircle"
    }
}
