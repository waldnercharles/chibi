CompilerBootstrap :: library {
    // The text between name=" and the next quote in text, or "".
    Property :: (text: string, name: string) -> string {
        return BuildBefore(BuildAfter(text, BuildJoin([name, "=\""], "")), "\"");
    }
    // Recovers the compiler from the published bootstrap artifact that
    // tools/compiler/bootstrap.kdl pins. Arguments: the compiler host and the
    // folder to download the artifact into. The host checks the manifest
    // against the pin before it recovers anything.
    Recover :: () -> int {
        arguments := BuildArguments();
        if (BuildLength(arguments) != 2) {
            BuildReport("usage: COMPILER_HOST FOLDER");
            return 2;
        }
        contract := BuildAfter(BuildReadFile("tools/compiler/bootstrap.kdl"), "\npublished ");
        repository := Property(contract, "repository");
        tag := Property(contract, "tag");
        if (repository == "" || tag == "") {
            BuildReport("tools/compiler/bootstrap.kdl publishes no artifact");
            return 1;
        }
        if (!BuildMakeDirectory(arguments[1]) ||
            RunBuildStep(["gh", "release", "download", tag, "--repo", repository, "--dir", arguments[1],
                       "--pattern", "compiler.chibip", "--pattern", "bootstrap.json", "--clobber"]) != 0) {
            BuildReport(BuildJoin(["cannot download the release ", tag, " of ", repository], ""));
            return 1;
        }
        return RunBuildStep([arguments[0], "--bootstrap", arguments[1], "--compiler", "tools/compiler",
                          "--core", "packages/core", "--published"]);
    }
}
