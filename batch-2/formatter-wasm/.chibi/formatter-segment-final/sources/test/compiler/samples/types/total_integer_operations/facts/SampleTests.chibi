package facts

// total integer operations
@test
Calls :: () {
    a1_0: u8 = 1;
    r1: u8 = Negate(a1_0);
    e1: u8 = 255;
    assert(r1 == e1, "Negate call 1");
    a2_0: u64 = 1;
    r2: u64 = Wide(a2_0);
    e2: u64 = 18446744073709551615;
    assert(r2 == e2, "Wide call 2");
    a3_0: int = 3;
    r3: int = Far(a3_0);
    e3: int = 0;
    assert(r3 == e3, "Far call 3");
    a4_0: int = -5;
    r4: int = Fill(a4_0);
    e4: int = -1;
    assert(r4 == e4, "Fill call 4");
    a5_0: int = 5;
    r5: int = Fill(a5_0);
    e5: int = 0;
    assert(r5 == e5, "Fill call 5");
    a6_0: int = 7;
    a6_1: int = 0;
    r6: int = Divide(a6_0, a6_1);
    e6: int = 7;
    assert(r6 == e6, "Divide call 6");
}
