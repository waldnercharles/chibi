diff --git a/tools/compiler/bounded_compiler/Compile.chibi b/tools/compiler/bounded_compiler/Compile.chibi
index b07a137c9..3c7c3665a 100644
--- a/tools/compiler/bounded_compiler/Compile.chibi
+++ b/tools/compiler/bounded_compiler/Compile.chibi
@@ -83,7 +83,7 @@ ReadSignature :: (environment: reader.Environment, tree: reader.Tree, node: int,
         return ScalarSignature.Rejected(reader.Diagnostic(tree, node, document, "bounded compiler requires one ordinary int or bool result"));
     }
     switch reader.Signature(environment, tree, node, 0, document) {
-        case .Read(value, has_unit, unit, updated, diagnostics, uses, publications):
+        case .Read(value, has_unit, unit, updated, diagnostics, uses, publications, collection):
             if (length(diagnostics) != 0) {
                 return ScalarSignature.Rejected(diagnostics[0]);
             }
@@ -271,7 +271,7 @@ pub Compile :: (project: string, paths: string[], sources: string[], abi: lower.
         return InputFailure(-1, "bounded compiler requires one to three complete source files");
     }
     if (strings.ByteLength(project) == 0 || strings.ByteLength(project) > 240 ||
-        abi.schema != 1 || abi.prepared != 20 || (abi.pointer_storage != 7 && abi.pointer_storage != 9) ||
+        abi.schema != 1 || abi.prepared != 21 || (abi.pointer_storage != 7 && abi.pointer_storage != 9) ||
         prepared_abi == 0 || length(opcodes) != WireOpcodes) {
         return InputFailure(-1, "unsupported bounded compiler root or target");
     }
diff --git a/tools/compiler/callable_headers/Headers.chibi b/tools/compiler/callable_headers/Headers.chibi
index 4cbef89f7..a09d9b36c 100644
--- a/tools/compiler/callable_headers/Headers.chibi
+++ b/tools/compiler/callable_headers/Headers.chibi
@@ -128,7 +128,7 @@ Refresh :: (environment: Environment) -> Environment {
                     }
                     switch constructor_tables {
                         case .Tables(types, source_ids, definitions, variants, capabilities, old_functions, old_symbols, old_results):
-                            ids := source_ids;
+                            ids := slice(source_ids, 0, length(source_ids));
                             constructor_symbols: constructors.Symbol[] = [];
