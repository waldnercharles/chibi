package slashpath

import bytes "core:bytes"
import strings "core:strings"

// Slash-only lexical paths. Backslashes, colons, NUL and malformed UTF-8 are
// ordinary bytes. These operations do not resolve files, drives or UNC names.
// Returned strings have ordinary immutable Chibi value semantics.

pub Parts :: struct {
    directory: string;
    file: string;
}

@error
pub Error :: struct {
    kind: int;
    offset: int;
}

pub OutputTooLarge: int : 1;

pub IsAbsolute :: (path: string) -> bool {
    return strings.ByteAt(path, 0) == 47;
}

// O(n) time, O(1) auxiliary storage, and one returned substring at most.
// Empty paths return "."; roots return "/"; trailing slashes are removed.
pub Base :: (path: string) -> string {
    end := strings.ByteLength(path);
    if (end == 0) {
        return ".";
    }
    while (end > 0 && strings.ByteAt(path, end - 1) == 47) {
        end -= 1;
    }
    if (end == 0) {
        return "/";
    }
    start := end;
    while (start > 0 && strings.ByteAt(path, start - 1) != 47) {
        start -= 1;
    }
    return strings.Slice(path, start, end - start);
}

// Splits immediately after the last slash without cleaning either result.
// O(n) time and O(n) returned storage; directory followed by file is path.
pub Split :: (path: string) -> Parts {
    split := strings.LastIndexByte(path, 47) + 1;
    return {directory: strings.Slice(path, 0, split),
            file: strings.Slice(path, split, strings.ByteLength(path) - split)};
}

// The last dot in the final element begins the extension, including dotfiles.
// A trailing slash has no extension. O(n) time and O(n) returned storage.
pub Extension :: (path: string) -> string {
    index := strings.ByteLength(path) - 1;
    while (index >= 0 && strings.ByteAt(path, index) != 47) {
        if (strings.ByteAt(path, index) == 46) {
            return strings.Slice(path, index, strings.ByteLength(path) - index);
        }
        index -= 1;
    }
    return "";
}

// Returns the final element without its last extension. Unlike Base, this
// does not strip trailing slashes. O(n) time and O(n) returned storage.
pub Stem :: (path: string) -> string {
    end := strings.ByteLength(path);
    start := end;
    dot: int = -1;
    while (start > 0 && strings.ByteAt(path, start - 1) != 47) {
        start -= 1;
        if (dot < 0 && strings.ByteAt(path, start) == 46) {
            dot = start;
        }
    }
    if (dot >= 0) {
        end = dot;
    }
    return strings.Slice(path, start, end - start);
}

// The read position never trails the write position. Backtracking removes
// each written segment at most once, so cleaning takes O(n) time and storage.
CleanBuffer :: (data: u8[]) -> string {
    size := length(data);
    if (size == 0) {
        return ".";
    }
    rooted := data[0] == 47;
    read: int = 0;
    write: int = 0;
    barrier: int = 0;
    if (rooted) {
        read = 1;
        write = 1;
        barrier = 1;
    }
    while (read < size) {
        if (data[read] == 47) {
            read += 1;
            continue;
        }
        start := read;
        while (read < size && data[read] != 47) {
            read += 1;
        }
        count := read - start;
        if (count == 1 && data[start] == 46) {
            continue;
        }
        if (count == 2 && data[start] == 46 && data[start + 1] == 46) {
            if (write > barrier) {
                write -= 1;
                while (write > barrier && data[write] != 47) {
                    write -= 1;
                }
            } else if (!rooted) {
                if (write > 0) {
                    data[write] = 47;
                    write += 1;
                }
                data[write] = 46;
                data[write + 1] = 46;
                write += 2;
                barrier = write;
            }
            continue;
        }
        if (write > 0 && !(rooted && write == 1)) {
            data[write] = 47;
            write += 1;
        }
        index: int = 0;
        while (index < count) {
            data[write] = data[start + index];
            write += 1;
            index += 1;
        }
    }
    if (write == 0) {
        return ".";
    }
    return bytes.ToString(resize(data, write));
}

// Collapses slashes and dot segments. Relative leading .. remains; rooted ..
// stops at /. Empty or fully cancelled relative paths return ".".
// O(n) time and O(n) storage, with no fixed host-path length limit.
pub Clean :: (path: string) -> string {
    return CleanBuffer(bytes.FromString(path));
}

MaxLength: int : 2147483647;

// Adds a nonempty element and its separator without overflowing. Empty
// elements leave the length unchanged. -1 means the result cannot fit.
JoinedSize :: (current: int, partSize: int) -> int {
    if (current < 0 || partSize < 0) {
        return -1;
    }
    if (partSize == 0) {
        return current;
    }
    if (current > 0) {
        if (current == MaxLength) {
            return -1;
        }
        current += 1;
    }
    if (partSize > MaxLength - current) {
        return -1;
    }
    return current + partSize;
}

// Joins nonempty elements and cleans the result in O(total bytes) time and
// storage. Later rooted elements do not replace earlier elements. All-empty
// input returns "". OutputTooLarge at offset -1 reports an unrepresentable
// joined byte length before allocation or arithmetic overflow. No output is
// exposed on failure. Allocation follows runtime policy.
pub Join :: (parts: string[]) -> (text: string, error: Error?) {
    size: int = 0;
    for (part in parts) {
        size = JoinedSize(size, strings.ByteLength(part));
        if (size < 0) {
            failed: Error = {kind: OutputTooLarge, offset: -1};
            return ("", failed);
        }
    }
    if (size == 0) {
        return ("", nil);
    }
    data := resize([u8(0)], size);
    write: int = 0;
    for (part in parts) {
        partSize := strings.ByteLength(part);
        if (partSize == 0) {
            continue;
        }
        if (write > 0) {
            data[write] = 47;
            write += 1;
        }
        index: int = 0;
        while (index < partSize) {
            data[write] = u8(strings.ByteAt(part, index));
            write += 1;
            index += 1;
        }
    }
    return (CleanBuffer(data), nil);
}

