package llvm_native_calls

import native "project:llvm_native"
import abi "project:native_abi"
import strings "core:strings"

// Main returns chibi_probe_add(40, 2), a C function the module declares and the
// linker resolves.
Foreigns :: () -> native.Instruction[] {
    return [Code(native.Check, 0, 0, 0, 0, 0, 0),
            Code(native.Constant, 6, 0, 0, 0, 0, 40),
            Code(native.Constant, 6, 1, 0, 0, 0, 2),
            Code(native.ForeignCall, 6, 2, 0, 0, 2, 0),
            Code(native.Publish, 6, 0, 2, 0, 0, 0),
            Code(native.Return, 0, 0, 0, 0, 0, 0)];
}
ForeignResultModule :: (result: int, code: native.Instruction[], slots: int[], texts: string[]) -> native.Result {
    empty: int[] = [];
    records: native.Record[] = [];
    names: string[] = [];
    source: native.Source = {file: "", directory: ""};
    return native.Emit(abi.LinuxX64(), [Function(result, 0, 0, 3, 0, 6, 0, 2)], empty, slots, empty, code, [0, 1],
                       records, empty, texts, source, names, empty, empty, false, 1);
}
ForeignModule :: (code: native.Instruction[], slots: int[], texts: string[]) -> native.Result {
    return ForeignResultModule(6, code, slots, texts);
}
ForeignMismatch :: () -> string { return "native foreign call differs from its operands"; }
ChangedForeign :: (item: native.Instruction, slots: int[], texts: string[], message: string) {
    code := Foreigns();
    code[3] = item;
    Rejects(ForeignModule(code, slots, texts), message);
}
// A foreign call declares its symbol once and passes no context.
@test
ForeignCallDeclaresTheSymbol :: () {
    text := Emitted(ForeignModule(Foreigns(), [6, 6, 6], ["chibi_probe_add"]));
    assert(strings.Contains(text, "declare i32 @chibi_probe_add(i32, i32)\n"));
    assert(strings.Contains(text, "define i32 @chibi_scalar() #0 {\n"));
    assert(strings.Contains(text, "%v3 = call i32 @chibi_probe_add(i32 %c3_0, i32 %c3_1)\n"));
    assert(strings.Contains(text, "br label %p4\n"));
}
@test
ForeignVoidCallUsesTheCSignature :: () {
    code := Foreigns();
    code[3].left = abi.ForeignDirectVoid;
    text := Emitted(ForeignModule(code, [6, 6, 6], ["chibi_probe_notify"]));
    assert(strings.Contains(text, "declare void @chibi_probe_notify(i32, i32)\n"));
    assert(strings.Contains(text, "call void @chibi_probe_notify(i32 %c3_0, i32 %c3_1)\n"));
    assert(!strings.Contains(text, "%v3 = call"));
    assert(strings.Contains(text, "store i32 0, ptr %s2"));
}
@test
ForeignVoidModesHaveOnlyTheInternalIntResult :: () {
    for (mode in [abi.ForeignDirectVoid, abi.ForeignIndirectVoid, int(-1), 4]) {
        ChangedForeign(Code(native.ForeignCall, abi.BoolStorage, 2, mode, 0, 2, 0),
                       [6, 6, abi.BoolStorage], ["chibi_probe_notify"], ForeignMismatch());
    }
    for (symbol in ["chibi_native_test_index", "chibi_native_test_begin", "chibi_native_test_end", "chibi_native_scope_end"]) {
        ChangedForeign(Code(native.ForeignCall, abi.IntStorage, 2, abi.ForeignDirectVoid, 0, 0, 0),
                       [6, 6, 6], [symbol], ForeignMismatch());
    }
    ChangedForeign(Code(native.ForeignCall, abi.IntStorage, 2, abi.ForeignDirectVoid, 0, 1, 0),
                   [6, 6, 6], ["chibi_native_test_expect"], ForeignMismatch());
    code := Foreigns();
    code[1] = Code(native.Constant, abi.WordStorage, 0, 0, 0, 0, 100);
    code[3] = Code(native.ForeignCall, abi.IntStorage, 2, abi.ForeignDirectVoid, 0, 1, 0);
    Rejects(ForeignModule(code, [abi.WordStorage, 6, 6], ["chibi_native_scope_begin"]), ForeignMismatch());
    for (symbol in ["chibi_native_test_busy", "chibi_native_step"]) {
        code = Foreigns();
        count := 0;
        if (symbol == "chibi_native_test_busy") { count = 1; }
        code[3] = Code(native.ForeignCall, abi.IntStorage, 2, abi.ForeignDirectVoid, 0, count, 0);
        Emitted(ForeignModule(code, [6, 6, 6], [symbol]));
    }
}
// A bool crosses the C ABI zero-extended, as an argument and as a result.
@test
ForeignBoolsAreZeroExtended :: () {
    code := Foreigns();
    code[2] = Code(native.Constant, 1, 1, 0, 0, 0, 1);
    code[3] = Code(native.ForeignCall, 1, 2, 0, 0, 2, 0);
    code[4] = Code(native.Publish, 1, 0, 2, 0, 0, 0);
    text := Emitted(ForeignResultModule(1, code, [6, 1, 1], ["chibi_probe_pick"]));
    assert(strings.Contains(text, "declare zeroext i1 @chibi_probe_pick(i32, i1 zeroext)\n"));
    assert(strings.Contains(text, "%v3 = call zeroext i1 @chibi_probe_pick(i32 %c3_0, i1 zeroext %c3_1)\n"));
}
@test
ForeignSymbolMustBeInTheTextTable :: () {
    ChangedForeign(Code(native.ForeignCall, 6, 2, 0, 0, 2, 1), [6, 6, 6], ["chibi_probe_add"], ForeignMismatch());
}
@test
ForeignSymbolMustBeAnIdentifier :: () {
    Rejects(ForeignModule(Foreigns(), [6, 6, 6], ["llvm.trap"]), ForeignMismatch());
}
@test
ForeignSymbolMayNotBeTheEntry :: () {
    Rejects(ForeignModule(Foreigns(), [6, 6, 6], ["main"]), ForeignMismatch());
}
@test
ForeignArgumentsPastTheTableAreRejected :: () {
    ChangedForeign(Code(native.ForeignCall, 6, 2, 0, 1, 2, 0), [6, 6, 6], ["chibi_probe_add"], ForeignMismatch());
}
// A user declaration cannot alter the program-owned test helpers' real ABI,
// even when it occurs in an ordinary synchronous function.
@test
TestRuntimeForeignHelpersKeepTheirDeclaredABI :: () {
    for (symbol in ["chibi_native_test_index", "chibi_native_test_begin", "chibi_native_test_end"]) {
        Rejects(ForeignModule(Foreigns(), [6, 6, 6], [symbol]), ForeignMismatch());
        code := Foreigns();
        code[3] = Code(native.ForeignCall, abi.WordStorage, 2, 0, 0, 0, 0);
        code[4] = Code(native.Publish, abi.WordStorage, 0, 2, 0, 0, 0);
        Rejects(ForeignResultModule(abi.WordStorage, code, [6, 6, abi.WordStorage], [symbol]), ForeignMismatch());
        code[3] = Code(native.ForeignCall, abi.IntStorage, 2, 0, 0, 0, 0);
        code[4] = Code(native.Publish, abi.IntStorage, 0, 2, 0, 0, 0);
        Emitted(ForeignModule(code, [6, 6, 6], [symbol]));
    }
}

// Main calls the address in slot 0 with 40 and 2 and returns the result.
Indirects :: () -> native.Instruction[] {
    return [Code(native.Check, 0, 0, 0, 0, 0, 0),
            Code(native.Constant, 9, 0, 0, 0, 0, 4096),
            Code(native.Constant, 6, 1, 0, 0, 0, 40),
            Code(native.Constant, 6, 2, 0, 0, 0, 2),
            Code(native.ForeignCall, 6, 3, 1, 0, 3, 0),
            Code(native.Publish, 6, 0, 3, 0, 0, 0),
            Code(native.Return, 0, 0, 0, 0, 0, 0)];
}
IndirectModule :: (code: native.Instruction[], slots: int[], texts: string[]) -> native.Result {
    empty: int[] = [];
    records: native.Record[] = [];
    names: string[] = [];
    source: native.Source = {file: "", directory: ""};
    return native.Emit(abi.LinuxX64(), [Function(6, 0, 0, 4, 0, 7, 0, 3)], empty, slots, empty, code, [0, 1, 2],
                       records, empty, texts, source, names, empty, empty, false, 1);
}
// A call through an address declares nothing, traps on a null address and calls
// the pointer its first argument holds.
@test
ForeignCallThroughAnAddress :: () {
    text := Emitted(IndirectModule(Indirects(), [9, 6, 6, 6], [""]));
    assert(strings.Contains(text, "%callee4 = inttoptr i64 %c4_0 to ptr\n"));
    assert(strings.Contains(text, "%v4 = call i32 %callee4(i32 %c4_1, i32 %c4_2)\n"));
    assert(strings.Contains(text, "%null4 = icmp eq ptr %callee4, null\n  br i1 %null4, label %trap, label %call4\ncall4:\n"));
    assert(!strings.Contains(text, "declare i32 @"));
}
@test
ForeignVoidProcedureConsumesAndChecksItsAddress :: () {
    code := Indirects();
    code[4].left = abi.ForeignIndirectVoid;
    text := Emitted(IndirectModule(code, [9, 6, 6, 6], [""]));
    assert(strings.Contains(text, "%null4 = icmp eq ptr %callee4, null"));
    assert(strings.Contains(text, "call void %callee4(i32 %c4_1, i32 %c4_2)\n"));
    assert(!strings.Contains(text, "%v4 = call"));
    assert(strings.Contains(text, "store i32 0, ptr %s3"));
    Rejects(IndirectModule(code, [9, 6, 6, 6], ["named"]), ForeignMismatch());
    code[4].target = 0;
    Rejects(IndirectModule(code, [9, 6, 6, 6], [""]), ForeignMismatch());
}
@test
IndirectCallNeedsAWordAddress :: () {
    code := Indirects();
    code[1] = Code(native.Constant, 6, 0, 0, 0, 0, 4096);
    Rejects(IndirectModule(code, [6, 6, 6, 6], [""]), ForeignMismatch());
}
@test
IndirectCallNamesNoSymbol :: () {
    Rejects(IndirectModule(Indirects(), [9, 6, 6, 6], ["chibi_probe_add"]), ForeignMismatch());
}
@test
IndirectCallNeedsItsAddress :: () {
    code := Indirects();
    code[4] = Code(native.ForeignCall, 6, 3, 1, 0, 0, 0);
    Rejects(IndirectModule(code, [9, 6, 6, 6], [""]), ForeignMismatch());
}
// An array of numbers passes as the pointer to its elements, which the callee
// may write.
@test
ForeignArrayArgumentIsItsElementPointer :: () {
    code := [Code(native.Check, 0, 0, 0, 0, 0, 0),
             Code(native.Constant, 1027, 0, 0, 0, 0, 0),
             Code(native.ForeignCall, 6, 1, 0, 0, 1, 0),
             Code(native.Publish, 6, 0, 1, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0)];
    empty: int[] = [];
    records: native.Record[] = [];
    names: string[] = [];
    source: native.Source = {file: "", directory: ""};
    text := Emitted(native.Emit(abi.LinuxX64(), [Function(6, 0, 0, 2, 0, 5, 0, 1)], empty, [1027, 6], empty, code, [0],
                                records, empty, ["chibi_probe_fill"], source, names, empty, empty, false, 1));
    assert(strings.Contains(text, "declare i32 @chibi_probe_fill(ptr)\n"));
    assert(strings.Contains(text, "%c2_0.data = extractvalue { i32, i32, ptr, ptr } %c2_0, 2\n"));
    assert(strings.Contains(text, "%v2 = call i32 @chibi_probe_fill(ptr %c2_0.data)\n"));
}
@test
ForeignBuffersRejectMapsAndScopedReferences :: () {
    for (type in [native.MapType + abi.IntStorage * 16 + abi.IntStorage, native.RefType + abi.IntStorage]) {
        code := [Code(native.Check, 0, 0, 0, 0, 0, 0),
                 Code(native.Constant, type, 0, 0, 0, 0, 0),
                 Code(native.ForeignCall, abi.IntStorage, 1, 0, 0, 1, 0),
                 Code(native.Publish, abi.IntStorage, 0, 1, 0, 0, 0),
                 Code(native.Return, 0, 0, 0, 0, 0, 0)];
        empty: int[] = [];
        records: native.Record[] = [];
        texts := ["chibi_probe_fill"];
        source: native.Source = {file: "", directory: ""};
        result := native.Emit(abi.LinuxX64(), [Function(abi.IntStorage, 0, 0, 2, 0, 5, 0, 1)],
            empty, [type, abi.IntStorage], empty, code, [0], records, empty, texts, source, [], empty, empty, false, 1);
        Rejects(result, ForeignMismatch());
    }
}
LoanCode :: (array: int) -> native.Instruction[] {
    return [Code(native.Check, 0, 0, 0, 0, 0, 0),
            Code(native.Constant, array, 0, 0, 0, 0, 0),
            Code(native.ArrayLoan, array, 1, 0, 0, 1, 0),
            Code(native.Constant, abi.IntStorage, 2, 0, 0, 0, 0),
            Code(native.Publish, abi.IntStorage, 0, 2, 0, 0, 0),
            Code(native.Return, 0, 0, 0, 0, 0, 0)];
}
LoanModule :: (array: int, code: native.Instruction[]) -> native.Result {
    return Emit([Function(abi.IntStorage, 0, 0, 3, 0, length(code), 0, 0)], [], [array, array, abi.IntStorage], code, []);
}
@test
ForeignBufferLoansValidateTypePlaceModeAndLiteral :: () {
    array := native.ArrayType + abi.IntStorage;
    expected := "native foreign buffer loan differs from its array or place";
    code := LoanCode(array);
    bad := code[2];
    bad.target = 0;
    Rejects(LoanModule(array, Changed(code, 2, bad)), expected);
    bad = code[2]; bad.left = 2;
    Rejects(LoanModule(array, Changed(code, 2, bad)), expected);
    bad = code[2]; bad.target = native.ArrayLoanIndexed + 1;
    Rejects(LoanModule(array, Changed(code, 2, bad)), expected);
    bad = code[2]; bad.literal = 1;
    Rejects(LoanModule(array, Changed(code, 2, bad)), expected);
    bad = code[2]; bad.right = 1;
    Rejects(LoanModule(array, Changed(code, 2, bad)), expected);
    for (element in [abi.BoolStorage, abi.TextStorage]) {
        unsupported := native.ArrayType + element;
        Rejects(LoanModule(unsupported, LoanCode(unsupported)), expected);
    }
    Rejects(LoanModule(array, code), "native foreign buffer loan belongs to one call argument");
}
@test
ForeignBufferLoansHaveOneCallConsumer :: () {
    array := native.ArrayType + abi.IntStorage;
    for (same_call in [false, true]) {
        code := LoanCode(array);
        code = slice(code, 0, 3);
        count := 1;
        if (same_call) { count = 2; }
        code.append(Code(native.ForeignCall, abi.IntStorage, 2, 0, 0, count, 0));
        slots := [array, array, abi.IntStorage];
        result := 2;
        if (!same_call) {
            code.append(Code(native.ForeignCall, abi.IntStorage, 3, 0, 1, 1, 0));
            slots.append(abi.IntStorage);
            result = 3;
        }
        code.extend([Code(native.Publish, abi.IntStorage, 0, result, 0, 0, 0), Code(native.Return, 0, 0, 0, 0, 0, 0)]);
        empty: int[] = [];
        records: native.Record[] = [];
        source: native.Source = {file: "", directory: ""};
        emitted := native.Emit(abi.LinuxX64(), [Function(abi.IntStorage, 0, 0, length(slots), 0, length(code), 0, 2)],
            empty, slots, empty, code, [1, 1], records, empty, ["probe"], source, [], empty, empty, false, 1);
        Rejects(emitted, "native foreign buffer loan belongs to one call argument");
    }
}
// A string is copied with its NUL to a stack buffer the callee reads as a C string.
@test
ForeignStringArgumentIsCopiedWithItsNul :: () {
    code := [Code(native.Check, 0, 0, 0, 0, 0, 0),
             Code(native.Constant, 13, 0, 0, 0, 0, 0),
             Code(native.ForeignCall, 6, 1, 0, 0, 1, 1),
             Code(native.Publish, 6, 0, 1, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0)];
    empty: int[] = [];
    records: native.Record[] = [];
    names: string[] = [];
    source: native.Source = {file: "", directory: ""};
    text := Emitted(native.Emit(abi.LinuxX64(), [Function(6, 0, 0, 2, 0, 5, 0, 1)], empty, [13, 6], empty, code, [0],
                                records, empty, ["probe", "chibi_probe_length"], source, names, empty, empty, false, 1));
    assert(strings.Contains(text, "declare i32 @chibi_probe_length(ptr)\n"));
    assert(strings.Contains(text, "%cstr0 = alloca [4097 x i8]\n"));
    assert(strings.Contains(text, "%c2_0.ok = call i1 @chibi_scalar.cstring(ptr %cstr0, ptr %c2_0.data, i32 %c2_0.length)\n"));
    assert(strings.Contains(text, "%v2 = call i32 @chibi_probe_length(ptr %cstr0)\n"));
    assert(strings.Contains(text, "define internal i1 @chibi_scalar.cstring("));
}
// Main passes the address of Identity, a function of one int, to a foreign
// function that takes a word.
Callbacks :: () -> native.Instruction[] {
    return [Code(native.Check, 0, 0, 0, 0, 0, 0),
            Code(native.FunctionAddress, 9, 0, 1, 0, 0, 0),
            Code(native.ForeignCall, 6, 1, 0, 0, 1, 0),
            Code(native.Publish, 6, 0, 1, 0, 0, 0),
            Code(native.Return, 0, 0, 0, 0, 0, 0),
            Code(native.Check, 0, 0, 0, 0, 0, 0),
            Code(native.Argument, 6, 0, 0, 0, 0, 0),
            Code(native.Publish, 6, 0, 0, 0, 0, 0),
            Code(native.Return, 0, 0, 0, 0, 0, 0)];
}
CallbackModule :: (code: native.Instruction[], result: int = 6) -> native.Result {
    empty: int[] = [];
    records: native.Record[] = [];
    names: string[] = [];
    source: native.Source = {file: "", directory: ""};
    return native.Emit(abi.LinuxX64(), [Function(6, 0, 0, 2, 0, 5, 0, 1), Function(result, 1, 2, 1, 5, 4, 1, 0)], [6],
                       [9, 6, result], empty, code, [0], records, empty, ["chibi_probe_call"], source, names, empty, empty,
                       false, 1);
}
// A function address is the address of an adapter with C's calling convention,
// which calls the function.
@test
FunctionAddressIsItsAdapter :: () {
    text := Emitted(CallbackModule(Callbacks()));
    assert(strings.Contains(text, "%v1 = ptrtoint ptr @chibi_callback.1 to i64\n"));
    assert(strings.Contains(text, "define internal i32 @chibi_callback.1(i32 %a0) #0 {\n"));
    assert(strings.Contains(text, "%result = call i32 @chibi_scalar.1(i32 %a0)\n"));
    assert(strings.Contains(text, "declare i32 @chibi_probe_call(i64)\n"));
}
@test
FunctionAddressNamesAFunctionOfTheModule :: () {
    code := Callbacks();
    code[1] = Code(native.FunctionAddress, 9, 0, 2, 0, 0, 0);
    Rejects(CallbackModule(code), "native function address differs from its function");
}
@test
VoidFunctionAddressDiscardsItsInternalResult :: () {
    code := Callbacks();
    code[1].literal = i64(abi.CallbackVoid);
    text := Emitted(CallbackModule(code));
    assert(strings.Contains(text, "%v1 = ptrtoint ptr @chibi_callback.1.void to i64\n"));
    assert(strings.Contains(text, "define internal void @chibi_callback.1.void(i32 %a0) #0 {\n"));
    assert(strings.Contains(text, "%result = call i32 @chibi_scalar.1(i32 %a0)\n  ret void\n"));
    Rejects(CallbackModule(code, abi.BoolStorage), "native function address differs from its function");
}
@test
FunctionAddressRejectsUnknownCallbackMetadata :: () {
    for (mode in [i64(-1), 2, 4294967296]) {
        code := Callbacks();
        code[1].literal = mode;
        Rejects(CallbackModule(code), "native function address differs from its function");
    }
    code := Callbacks();
    code[1].right = 1;
    Rejects(CallbackModule(code), "native function address differs from its function");
    code[1].right = 0;
    code[1].target = 1;
    Rejects(CallbackModule(code), "native function address differs from its function");
}
@test
CallbackAdaptersAreKeyedByFunctionAndReturnABI :: () {
    code := [Code(native.Check, 0, 0, 0, 0, 0, 0),
             Code(native.FunctionAddress, 9, 0, 1, 0, 0, i64(abi.CallbackValue)),
             Code(native.FunctionAddress, 9, 1, 1, 0, 0, i64(abi.CallbackVoid)),
             Code(native.Constant, 6, 2, 0, 0, 0, 0),
             Code(native.Publish, 6, 0, 2, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0),
             Code(native.Check, 0, 0, 0, 0, 0, 0),
             Code(native.Argument, 6, 0, 0, 0, 0, 0),
             Code(native.Publish, 6, 0, 0, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0)];
    empty: int[] = [];
    records: native.Record[] = [];
    names: string[] = [];
    source: native.Source = {file: "", directory: ""};
    text := Emitted(native.Emit(abi.LinuxX64(), [Function(6, 0, 0, 3, 0, 6, 0, 0), Function(6, 1, 3, 1, 6, 4, 0, 0)],
                                [6], [9, 9, 6, 6], empty, code, empty, records, empty, names, source, names, empty, empty, false, 1));
    assert(strings.Contains(text, "define internal i32 @chibi_callback.1(i32 %a0)"));
    assert(strings.Contains(text, "define internal void @chibi_callback.1.void(i32 %a0)"));
}
