version 3
name "SdfOrbitAmberEmitter"
domain "material"
id_counter 10
description "Fixed color emission for orbit light/depth proof. Authored separately from the nonemissive GI receivers."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 1
                type "Shader Surface Output"
                inputs {
                    "Base Color" {
                        default x=1.0 y=0.52 z=0.12
                    }
                    Emission {
                        default x=0.75 y=0.39 z=0.09
                    }
                    Normal {
                        default x=0.0 y=0.0 z=0.0
                    }
                }
            }
        }
    }
}
