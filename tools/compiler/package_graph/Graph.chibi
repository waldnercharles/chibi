package package_graph

import strings "core:strings"

// Inputs are the checked parser/resolver descriptors. Paths and directories are
// canonical, names are identifiers other than _, files number at most 256, and
// every import's file index refers to this input. Neither parsing nor disk IO
// belongs to this component. Package indices preserve input discovery order.
pub File :: struct {
    path: string;
    directory: string;
    name: string;
}
// A conditional import is inside a `when` branch: its binding and edge hold
// only if the compiler keeps that branch, so two conditional imports of one
// file may share an alias, which the compiler checks among the kept ones.
pub Import :: struct {
    file: int;
    directory: string;
    alias: string;
    explicit_alias: bool;
    conditional: bool;
}
pub Package :: struct {
    directory: string;
    name: string;
    member_start: int;
    member_count: int;
}
pub Binding :: struct {
    name: string;
    file: int;
    target: int;
    import_index: int;
    conditional: bool;
}
// Conditional when every import that makes it is.
pub Edge :: struct {
    from: int;
    to: int;
    import_index: int;
    conditional: bool;
}
pub Error :: struct {
    code: int;
    file: int;
    import_index: int;
    related_file: int;
    related_import: int;
    cycle_count: int;
}
pub Graph :: union {
    Accepted(packages: Package[], members: int[], file_packages: int[],
             order: int[], edges: Edge[], bindings: Binding[])
    | Rejected(error: Error, cycle: int[])
}

OK: int : 0;
pub DuplicateFile: int : 1;
pub HeaderMismatch: int : 2;
pub DuplicateName: int : 3;
pub Missing: int : 4;
pub ImportName: int : 5;
pub DuplicateImport: int : 6;
pub Cycle: int : 7;
MaxFiles: int : 256;

Failure :: (error: Error, cycle: int[]) -> Graph {
    return Graph.Rejected(error, cycle);
}

BindingCompare :: (left: Binding, right: Binding) -> int {
    if (left.file < right.file) {
        return -1;
    }
    if (left.file > right.file) {
        return 1;
    }
    names := strings.Compare(left.name, right.name);
    if (names != 0) {
        return names;
    }
    if (left.import_index < right.import_index) {
        return -1;
    }
    if (left.import_index > right.import_index) {
        return 1;
    }
    return 0;
}

// Merge sorting avoids repeated whole-array indexed rewrites of imported bindings.
SortBindings :: (items: Binding[]) -> Binding[] {
    count := length(items);
    if (count < 2) {
        return items;
    }
    middle := count / 2;
    left := SortBindings(slice(items, 0, middle));
    right := SortBindings(slice(items, middle, count - middle));
    result: Binding[] = [];
    a: int = 0;
    b: int = 0;
    while (a < length(left) || b < length(right)) {
        takeLeft := b == length(right);
        if (a < length(left) && b < length(right)) {
            takeLeft = BindingCompare(left[a], right[b]) <= 0;
        }
        if (takeLeft) {
            result.append(left[a]);
            a += 1;
        } else {
            result.append(right[b]);
            b += 1;
        }
    }
    return result;
}

pub Build :: (files: File[], imports: Import[]) -> Graph {
    fileCount := length(files);
    packages: Package[] = [];
    bindings: Binding[] = [];
    edges: Edge[] = [];
    filePackages := resize([int(0)], fileCount);
    members := resize([int(0)], fileCount);
    cycle := resize([int(0)], MaxFiles);
    i: int = 0;
    while (i < fileCount) {
        file := files[i];
        j: int = 0;
        while (j < i) {
            if (file.path == files[j].path) {
                return Failure({code: DuplicateFile, file: i, import_index: -1,
                                related_file: j, related_import: -1, cycle_count: 0}, cycle);
            }
            j += 1;
        }
        found: int = -1;
        j = 0;
        while (j < length(packages)) {
            if (packages[j].directory == file.directory) {
                found = j;
                break;
            }
            j += 1;
        }
        if (found >= 0 && packages[found].name != file.name) {
            return Failure({code: HeaderMismatch, file: i, import_index: -1,
                            related_file: packages[found].member_start,
                            related_import: -1, cycle_count: 0}, cycle);
        }
        if (found < 0) {
            j = 0;
            while (j < length(packages)) {
                if (packages[j].name == file.name) {
                    return Failure({code: DuplicateName, file: i, import_index: -1,
                                    related_file: packages[j].member_start,
                                    related_import: -1, cycle_count: 0}, cycle);
                }
                j += 1;
            }
            found = length(packages);
            // Until membership is sorted, member_start retains the first file
            // responsible for this package's declared name and header.
            item: Package = {directory: file.directory, name: file.name,
                             member_start: i, member_count: 0};
            packages.append(item);
        }
        filePackages[i] = found;
        i += 1;
    }

    // Select sorted members with one output write per file. Insertion shifts
    // would repeatedly snapshot a scalar array under current value semantics.
    selected := resize([false], fileCount);
    offset: int = 0;
    i = 0;
    while (i < length(packages)) {
        item := packages[i];
        memberStart := offset;
        memberCount: int = 0;
        while (true) {
            next: int = -1;
            j: int = 0;
            while (j < fileCount) {
                if (!selected[j] && filePackages[j] == i) {
                    if (next < 0 || strings.Compare(files[j].path, files[next].path) < 0) {
                        next = j;
                    }
                }
                j += 1;
            }
            if (next < 0) {
                break;
            }
            selected[next] = true;
            members[offset] = next;
            offset += 1;
            memberCount += 1;
        }
        updated: Package = {directory: item.directory, name: item.name,
                            member_start: memberStart, member_count: memberCount};
        packages[i] = updated;
        i += 1;
    }

    i = 0;
    while (i < length(imports)) {
        imported := imports[i];
        target: int = -1;
        j: int = 0;
        while (j < length(packages)) {
            if (packages[j].directory == imported.directory) {
                target = j;
                break;
            }
            j += 1;
        }
        if (target < 0) {
            return Failure({code: Missing, file: imported.file, import_index: i,
                            related_file: -1, related_import: -1, cycle_count: 0}, cycle);
        }
        alias := imported.alias;
        if (!imported.explicit_alias) {
            alias = strings.BaseName(imported.directory);
        }
        blank := imported.explicit_alias && alias == "_";
        if (!strings.IsIdentifier(alias) || (!blank && alias == "_")) {
            return Failure({code: ImportName, file: imported.file, import_index: i,
                            related_file: -1, related_import: -1, cycle_count: 0}, cycle);
        }
        if (!blank) {
            binding: Binding = {name: alias, file: imported.file, target: target, import_index: i,
                                conditional: imported.conditional};
            bindings.append(binding);
        }
        from := filePackages[imported.file];
        exists := -1;
        for (index in 0..<length(edges)) {
            if (edges[index].from == from && edges[index].to == target) {
                exists = index;
                break;
            }
        }
        if (exists < 0) {
            edge: Edge = {from: from, to: target, import_index: i, conditional: imported.conditional};
            edges.append(edge);
        } else if (edges[exists].conditional && !imported.conditional) {
            certain: Edge = {from: from, to: target, import_index: i, conditional: false};
            edges[exists] = certain;
        }
        i += 1;
    }
    bindings = SortBindings(bindings);
    duplicate: int = -1;
    i = 1;
    while (i < length(bindings)) {
        a := bindings[i - 1];
        b := bindings[i];
        if (a.file == b.file && a.name == b.name && !(a.conditional && b.conditional)) {
            if (duplicate < 0 || b.import_index < bindings[duplicate].import_index) {
                duplicate = i;
            }
        }
        i += 1;
    }
    if (duplicate >= 0) {
        a := bindings[duplicate - 1];
        b := bindings[duplicate];
        return Failure({code: DuplicateImport, file: b.file, import_index: b.import_index,
                        related_file: b.file, related_import: a.import_index, cycle_count: 0}, cycle);
    }

    count := length(packages);
    dependencies := resize([int(0)], count);
    emitted := resize([false], count);
    order := resize([int(0)], count);
    for (edge in edges) {
        if (edge.from != edge.to) {
            dependencies[edge.from] += 1;
        }
    }
    ordinal: int = 0;
    while (ordinal < count) {
        next: int = -1;
        i = 0;
        while (i < count) {
            if (!emitted[i] && dependencies[i] == 0) {
                if (next < 0 || strings.Compare(packages[i].directory, packages[next].directory) < 0) {
                    next = i;
                }
            }
            i += 1;
        }
        if (next < 0) {
            // Follow the C residual witness exactly: lowest residual index,
            // lexical outgoing target, then trim the acyclic prefix.
            current: int = 0;
            while (emitted[current]) {
                current += 1;
            }
            seen := resize([int(0)], count);
            path: int[] = [];
            while (seen[current] == 0) {
                seen[current] = length(path) + 1;
                target: int = -1;
                importIndex: int = -1;
                for (edge in edges) {
                    if (edge.from == current && edge.to != current && !emitted[edge.to]) {
                        if (target < 0 || strings.Compare(packages[edge.to].directory, packages[target].directory) < 0) {
                            target = edge.to;
                            importIndex = edge.import_index;
                        }
                    }
                }
                path.append(importIndex);
                current = target;
            }
            start := seen[current] - 1;
            cycleCount := length(path) - start;
            i = 0;
            while (i < cycleCount) {
                cycle[i] = path[start + i];
                i += 1;
            }
            first := cycle[0];
            last := cycle[cycleCount - 1];
            return Failure({code: Cycle, file: imports[first].file, import_index: first,
                            related_file: imports[last].file, related_import: last,
                            cycle_count: cycleCount}, cycle);
        }
        emitted[next] = true;
        order[ordinal] = next;
        for (edge in edges) {
            if (edge.to == next && !emitted[edge.from]) {
                dependencies[edge.from] -= 1;
            }
        }
        ordinal += 1;
    }
    return Graph.Accepted(packages, members, filePackages, order, edges, bindings);
}

// Like the C facade, indexed queries require accepted graphs and valid indices.
pub Count :: (graph: Graph) -> int {
    switch graph {
        case .Accepted(packages, members, files, order, edges, bindings):
            return length(packages);
        case .Rejected(error, cycle):
            return 0;
    }
}
pub PackageAt :: (graph: Graph, index: int) -> Package {
    switch graph {
        case .Accepted(packages, members, files, order, edges, bindings):
            return packages[index];
        case .Rejected(error, cycle):
            return {directory: "", name: "", member_start: 0, member_count: 0};
    }
}
pub FilePackage :: (graph: Graph, file: int) -> int {
    switch graph {
        case .Accepted(packages, members, files, order, edges, bindings):
            return files[file];
        case .Rejected(error, cycle):
            return -1;
    }
}
pub Order :: (graph: Graph, ordinal: int) -> int {
    switch graph {
        case .Accepted(packages, members, files, order, edges, bindings):
            return order[ordinal];
        case .Rejected(error, cycle):
            return -1;
    }
}
pub Dependency :: (graph: Graph, from: int, to: int) -> int {
    switch graph {
        case .Accepted(packages, members, files, order, edges, bindings):
            for (edge in edges) {
                if (edge.from == from && edge.to == to) {
                    return edge.import_index;
                }
            }
            return -1;
        case .Rejected(error, cycle):
            return -1;
    }
}
pub Lookup :: (graph: Graph, file: int, alias: string) -> int {
    switch graph {
        case .Accepted(packages, members, files, order, edges, bindings):
            lo: int = 0;
            hi := length(bindings);
            while (lo < hi) {
                middle := lo + (hi - lo) / 2;
                binding := bindings[middle];
                compared := strings.Compare(alias, binding.name);
                if (file < binding.file) {
                    compared = -1;
                }
                if (file > binding.file) {
                    compared = 1;
                }
                if (compared == 0) {
                    return binding.target;
                }
                if (compared < 0) {
                    hi = middle;
                } else {
                    lo = middle + 1;
                }
            }
            return -1;
        case .Rejected(error, cycle):
            return -1;
    }
}
