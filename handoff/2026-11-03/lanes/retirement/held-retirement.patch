-            target->fields[i].size > target->size - target->fields[i].offset ||
-            source->fields[i].offset > source->size ||
-            source->fields[i].size > source->size - source->fields[i].offset ||
-            strcmp(target->fields[i].name, source->fields[i].name) ||
