version 1
name "ModelMappingDetailStudy"
(array)entities {
    - {
        name "Camera"
        prototype "StudyCamera"
        components {
            GameCamera width=380.0 height=240.0 focal_distance=800.0
            GameHRC2D surface_relief=0.0 ambient=0.14 bloom=0.01
        }
    }
    - {
        name "Key"
        prototype "StudyLight"
        components {
            GameTransform x=-150.0 y=-90.0
        }
    }
    - {
        name "Fill"
        prototype "StudyLight"
        components {
            GameTransform x=145.0 y=80.0
        }
    }
    - {
        name "Bounded front label"
        prototype "DetailLabelTile"
        components {
            GameTransform x=-65.0 y=0.0
        }
    }
    - {
        name "Cylindrical checker"
        prototype "DetailWrappedBarrel"
        components {
            GameTransform x=65.0 y=0.0
        }
    }
}
