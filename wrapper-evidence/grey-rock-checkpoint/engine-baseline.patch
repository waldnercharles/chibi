diff --git a/src/runtime/terrain_storage.c b/src/runtime/terrain_storage.c
new file mode 100644
index 000000000..a4b692e5f
--- /dev/null
+++ b/src/runtime/terrain_storage.c
@@ -0,0 +1,237 @@
+#include "runtime/terrain_storage.h"
+
+#include "execution/function.h"
+#include "runtime/materials.h"
+#include "runtime/save.h"
+#include "support/xalloc.h"
+
+#include <assert.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct terrain_storage
+{
+    materials *materials;
+    save *save;
+    ecs_entity source;
+    char *identity;
+    int sequence, request;
+    bool load, pending, succeeded;
+    char error[256];
+};
+
+terrain_storage *terrain_storage_new(materials *materials, save *save)
+{
+    assert(materials && save);
+    terrain_storage *storage = xcalloc(1, sizeof *storage);
+    storage->materials = materials;
+    storage->save = save;
+    return storage;
+}
+
+void terrain_storage_reset(terrain_storage *storage)
+{
+    free(storage->identity);
+    storage->identity = NULL;
+    storage->request = 0;
+    storage->pending = storage->succeeded = false;
+    storage->error[0] = 0;
+}
+
+void terrain_storage_free(terrain_storage *storage)
+{
+    terrain_storage_reset(storage);
+    free(storage);
+}
+
+int terrain_storage_request(
+    terrain_storage *storage,
+    ecs_entity source,
+    const char *identity,
+    bool load,
+    char *error,
+    size_t size
+)
+{
+    const char *problem = NULL;
+    if (storage->pending) {
+        problem = "A terrain storage request is already pending";
+    } else if (!identity || !identity[0] || strlen(identity) > SAVE_BLOB_KEY_MAX) {
+        problem = "Terrain save identity must contain 1-64 bytes";
+    } else if (!ecs_entity_to_u64(source)) {
+        problem = "Terrain storage requires a source entity";
+    } else if (storage->sequence == INT_MAX) {
+        problem = "Terrain storage request tokens are exhausted";
+    }
+    if (problem) {
+        snprintf(error, size, "%s", problem);
+        return 0;
+    }
+    free(storage->identity);
+    storage->identity = xstrdup(identity);
+    storage->source = source;
+    storage->load = load;
+    storage->pending = true;
+    storage->succeeded = false;
+    storage->error[0] = 0;
+    storage->request = ++storage->sequence;
+    if (size) {
+        error[0] = 0;
+    }
+    return storage->request;
+}
+
+bool terrain_storage_pending(const terrain_storage *storage)
+{
+    return storage->pending;
+}
+
+terrain_storage_state terrain_storage_result(const terrain_storage *storage, int request)
+{
+    if (request <= 0 || request != storage->request) {
+        return (terrain_storage_state){
+            .error = "Terrain storage request is unknown or expired"
+        };
+    }
+    return (terrain_storage_state){ .pending = storage->pending,
+                                    .succeeded = storage->succeeded,
+                                    .error = storage->error };
+}
+
+void terrain_storage_flush(terrain_storage *storage)
+{
+    if (!storage->pending) {
+        return;
+    }
+    unsigned char *bytes = NULL;
+    size_t length = 0;
+    bool ok = false;
+    if (storage->load &&
+        !save_blob_read(storage->save, storage->identity, &bytes, &length)) {
+        snprintf(storage->error, sizeof storage->error, "%s", save_error(storage->save));
+        goto done;
+    }
+    const char *problem = materials_prepare(storage->materials);
+    if (problem) {
+        snprintf(storage->error, sizeof storage->error, "%s", problem);
+        goto done;
+    }
+    if (storage->load) {
+        if (!materials_terrain_checkpoint_read(
+                storage->materials,
+                storage->source,
+                storage->identity,
+                bytes,
+                length,
+                storage->error,
+                sizeof storage->error
+            )) {
+            goto done;
+        }
+        problem = materials_prepare(storage->materials);
+        if (problem) {
+            snprintf(storage->error, sizeof storage->error, "Terrain restored, but preparation failed: %s", problem);
+            goto done;
+        }
+        ok = true;
+        goto done;
+    }
+    if (!materials_terrain_checkpoint_write(
+            storage->materials,
+            storage->source,
+            storage->identity,
+            &bytes,
+            &length,
+            storage->error,
+            sizeof storage->error
+        )) {
+        goto done;
+    }
+    ok = save_blob_write(storage->save, storage->identity, bytes, length);
+    if (!ok) {
+        snprintf(storage->error, sizeof storage->error, "%s", save_error(storage->save));
+    }
+done:
+    free(bytes);
+    free(storage->identity);
+    storage->identity = NULL;
+    storage->pending = false;
+    storage->succeeded = ok;
+}
+
+static const char *request(
+    const behavior_function_context *ctx,
+    void *service,
+    const pin_value *in,
+    pin_value *out,
+    bool load
+)
+{
+    assert(ctx->copy_string);
+    char error[256] = "Terrain storage requires a material world";
+    out[0].i = service ? terrain_storage_request(
+                             service,
+                             ecs_entity_from_u64(in[0].u64),
+                             in[1].str,
+                             load,
+                             error,
+                             sizeof error
+                         )
+                       : 0;
+    out[1].str = ctx->copy_string(ctx->value_storage, error);
+    return NULL;
+}
+
+static const char *save_terrain(
+    const behavior_function_context *ctx,
+    void *service,
+    const pin_value *in,
+    pin_value *out
+)
+{
+    return request(ctx, service, in, out, false);
+}
+
+static const char *load_terrain(
+    const behavior_function_context *ctx,
+    void *service,
+    const pin_value *in,
+    pin_value *out
+)
+{
+    return request(ctx, service, in, out, true);
+}
+
+static const char *result(
+    const behavior_function_context *ctx,
+    void *service,
+    const pin_value *in,
+    pin_value *out
+)
+{
+    assert(ctx->copy_string);
+    terrain_storage_state
+        state = service
+                  ? terrain_storage_result(service, in[0].i)
+                  : (terrain_storage_state){
+                        .error = "Terrain storage requires a material world"
+                    };
+    out[0].b = state.pending;
+    out[1].b = state.succeeded;
+    out[2].str = ctx->copy_string(ctx->value_storage, state.error);
+    return NULL;
+}
+
+const node_host_call TERRAIN_SAVE_CALL = { .service = TERRAIN_STORAGE_SERVICE,
+                                           .context = save_terrain,
+                                           .optional_service = true };
+const node_host_call TERRAIN_LOAD_CALL = { .service = TERRAIN_STORAGE_SERVICE,
+                                           .context = load_terrain,
+                                           .optional_service = true };
+const node_host_call TERRAIN_STORAGE_RESULT_CALL = { .service = TERRAIN_STORAGE_SERVICE,
+                                                     .context = result,
+                                                     .optional_service = true };
+const node_access TERRAIN_STORAGE_WRITE_ACCESS = { .flags = NODE_EFFECT_HOST_SINK };
+const node_access TERRAIN_STORAGE_READ_ACCESS = { .flags = NODE_EFFECT_WORLD_READ };
diff --git a/src/runtime/terrain_storage.h b/src/runtime/terrain_storage.h
new file mode 100644
index 000000000..9a58d55a7
--- /dev/null
+++ b/src/runtime/terrain_storage.h
@@ -0,0 +1,55 @@
+#ifndef CHIBI_TERRAIN_STORAGE_H
+#define CHIBI_TERRAIN_STORAGE_H
+
+#include "ecs/ecs.h"
+#include "execution/host.h"
+
+#include <stdbool.h>
+#include <stddef.h>
+
+struct materials;
+struct save;
+typedef struct terrain_storage terrain_storage;
+typedef struct
+{
+    bool pending, succeeded;
+    const char *error; /* Borrowed until the next request, flush or reset. */
+} terrain_storage_state;
+
+/* Borrowed dependencies belong to the same world and outlive this module. */
+terrain_storage *terrain_storage_new(struct materials *, struct save *);
+void terrain_storage_free(terrain_storage *);
+/* Cancel pending work and invalidate retained results on scene replacement. */
+void terrain_storage_reset(terrain_storage *);
+/* Copy the stable identity, which also selects the binary attachment in the
+ * host's save namespace. Return a positive token, or zero with an error. One
+ * request may be pending at a time. A new accepted request expires the prior
+ * result. The identity contains 1-64 bytes. This call never prepares terrain. */
+int terrain_storage_request(
+    terrain_storage *,
+    ecs_entity source,
+    const char *identity,
+    bool load,
+    char *error,
+    size_t size
+);
+bool terrain_storage_pending(const terrain_storage *);
+terrain_storage_state terrain_storage_result(const terrain_storage *, int request);
+/* Outside queries, after authored structural commands publish.
+ * Apply queued terrain edits before capture. Load fully validates before
+ * replacing terrain, then prepares residency/geometry for rendering. Physics
+ * shapes refresh at its next normal boundary before solving. Save/load add one
+ * materials preparation; successful load adds another. Storage failures are
+ * retained results, not engine failures. IO/validation failures preserve terrain.
+ * A post-import preparation failure reports that terrain was already restored;
+ * it does not roll back the import. Unbound/browser storage cannot succeed.
+ * A host using this directly must synchronize physics before inspecting shapes
+ * and propagate transforms before rendering newly created terrain tiles. */
+void terrain_storage_flush(terrain_storage *);
+
+#define TERRAIN_STORAGE_SERVICE "game.terrain_storage"
+extern const node_host_call TERRAIN_SAVE_CALL, TERRAIN_LOAD_CALL,
+    TERRAIN_STORAGE_RESULT_CALL;
+extern const node_access TERRAIN_STORAGE_WRITE_ACCESS, TERRAIN_STORAGE_READ_ACCESS;
+
+#endif
