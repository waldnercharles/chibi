package facts
@error Failure :: struct { code: int; }
Read :: () -> (value: int, error: Failure?) { return(7, {code: 3}); }
Use :: () -> int { values: int[] = [0, 1, 2, 3, 4, 5, 6, 7]; selected := values[Read().value..<8]; if selected { return selected.length(); } return -1; }

