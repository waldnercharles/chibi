package union_members

import reader "project:signature_reader"
import named "project:named_binding"
import constructors "project:type_constructors"
import binding "project:lexical_binding"
import syntax "project:syntax_diagnostics"
import json "project:json_string"
import strings "core:strings"

// Complete catalog order, including native records and internal constructors.
// Type/ID pools use the same representation as named binding; graph rows are
// raw metadata, not precomputed ownership edges or cycle decisions.
pub Definition :: struct {
    id_slot: int;
    field_start: int;
    field_count: int;
    variant_start: int;
    variant_count: int;
}
pub Field :: struct {
    type: int;
}
pub Variant :: struct {
    type: int;
    tagged: bool;
    field_start: int;
    field_count: int;
}
pub Capability :: struct {
    result_start: int;
    result_count: int;
}
pub Environment :: union {
    Tables(reader: reader.Environment, types: named.Type[], ids: u64[],
           definitions: Definition[], variants: Variant[], fields: Field[],
           capabilities: Capability[], capability_fields: Field[])
}
DeclaredField :: struct {
    name: string;
    id_slot: int;
    type: int;
    offset: int;
    writable: bool;
    has_default: bool;
}
DeclaredVariant :: struct {
    name: string;
    tag_slot: int;
    type: int;
    tagged: bool;
    is_literal: bool;
    literal: string;
    field_start: int;
    field_count: int;
}
pub Update :: union {
    Added(plan: constructors.Plan)
    | Replaced(id: u64, variants: DeclaredVariant[], fields: DeclaredField[], types: named.Type[], ids: u64[])
}
pub Members :: union {
    Built(environment: Environment, updates: Update[], diagnostics: syntax.Diagnostic[], uses: named.Use[])
}

pub Validation :: union {
    Checked(root: int, error: int, states: int[])
}
MaxDepth: int : 256;

// The traversal keeps its own stack: callable depth is limited to 64.
CycleID :: (ids: u64[], slot: int) -> u64 {
    if (slot < 0) {
        return 0;
    }
    return ids[slot];
}
CycleType :: (types: named.Type[], ids: u64[], index: int) -> named.Value {
    row := types[index];
    return named.Value.Typed(row.storage, row.container, row.flags,
                             CycleID(ids, row.nominal_slot), CycleID(ids, row.parameter_slot));
}
// The record or union definition a value names, or -1 when it owns no edges.
Target :: (ids: u64[], definitions: Definition[], value: named.Value) -> int {
    switch value {
        case .Typed(storage, container, flags, nominal, parameter):
            if (storage != 15 && storage != 18) {
                return -1;
            }
            index: int = 0;
            while (index < length(definitions)) {
                if (CycleID(ids, definitions[index].id_slot) == nominal) {
                    return index;
                }
                index += 1;
            }
    }
    return -1;
}
// A definition's owned edges in visit order, as type indices: its fields, then
// each variant's untagged payload and its fields, including array/optional
// nominal payloads.
Edges :: (definition: Definition, variants: Variant[], fields: Field[]) -> int[] {
    edges: int[] = [];
    index: int = 0;
    while (index < definition.field_count) {
        edges.append(fields[definition.field_start + index].type);
        index += 1;
    }
    index = 0;
    while (index < definition.variant_count) {
        variant := variants[definition.variant_start + index];
        if (!variant.tagged) {
            edges.append(variant.type);
        }
        field_index: int = 0;
        while (field_index < variant.field_count) {
            edges.append(fields[variant.field_start + field_index].type);
            field_index += 1;
        }
        index += 1;
    }
    return edges;
}
// Walk discovers owned edges from metadata depth first. Visiting/done checks
// precede the depth guard, exactly as in C; a definition's depth is the number
// of definitions open above it.
Walk :: (types: named.Type[], ids: u64[], definitions: Definition[], variants: Variant[], fields: Field[],
         root: named.Value, states: int[]) -> Validation {
    updated := states;
    open: int[] = [];
    cursors: int[] = [];
    depth: int = 0;
    value := root;
    visiting: bool = true;
    while (visiting || depth > 0) {
        if (visiting) {
            visiting = false;
            found := Target(ids, definitions, value);
            if (found >= 0 && updated[found] == 1) {
                return Validation.Checked(-1, 1, updated);
            }
            if (found >= 0 && updated[found] == 0) {
                if (depth == MaxDepth) {
                    return Validation.Checked(-1, 2, updated);
                }
                updated[found] = 1;
                if (depth == length(open)) {
                    open.append(found);
                    cursors.append(int(0));
                } else {
                    open[depth] = found;
                    cursors[depth] = 0;
                }
                depth += 1;
            }
        } else {
            top := depth - 1;
            edges := Edges(definitions[open[top]], variants, fields);
            if (cursors[top] == length(edges)) {
                updated[open[top]] = 2;
                depth = top;
            } else {
                value = CycleType(types, ids, edges[cursors[top]]);
                cursors[top] += 1;
                visiting = true;
            }
        }
    }
    return Validation.Checked(-1, 0, updated);
}
pub Validate :: (types: named.Type[], ids: u64[], definitions: Definition[], variants: Variant[], fields: Field[],
                 roots: int[], states: int[]) -> Validation {
    updated := states;
    index: int = 0;
    while (index < length(roots)) {
        switch Walk(types, ids, definitions, variants, fields, CycleType(types, ids, roots[index]), updated) {
            case .Checked(root, error, next_states):
                if (error != 0) {
                    return Validation.Checked(index, error, next_states);
                }
                updated = next_states;
        }
        index += 1;
    }
    return Validation.Checked(-1, 0, updated);
}

Eligible :: union {
    Declaration(symbol: int, value: named.Value, diagnostics: syntax.Diagnostic[])
}
EligibleUnion :: (environment: Environment, tree: reader.Tree, node: int, scope: int, document: int) -> Eligible {
    token := reader.Field(tree, node, syntax.FieldName);
    switch reader.Name(tree, token, document) {
        case .Name(name, diagnostics):
            switch environment {
                case .Tables(reading, types, ids, definitions, variants, fields, capabilities, capability_fields):
                    switch reading {
                        case .Tables(names, constructor_tables, pointer_size):
                            switch names {
                                case .Tables(lexical, name_types, name_ids, merged, own, native, symbol_types, imports, exports, uses,
                                             identity, package_scope, has_native, has_documents, entity_id):
                                    symbol := binding.FindName(lexical, scope, name);
                                    if (symbol >= 0) {
                                        switch lexical {
                                            case .Tables(scopes, symbols, functions, lexical_ids, keys):
                                                item := symbols[symbol];
                                                value := named.TypeAt(name_types, name_ids, symbol_types[symbol]);
                                                location := reader.Request(tree, token, scope, document, "");
                                                switch value {
                                                    case .Typed(storage, container, flags, nominal, parameter):
                                                        if (item.kind == 13 && storage == 18 && item.document == location.document && item.start == location.start) {
                                                            return Eligible.Declaration(symbol, value, diagnostics);
                                                        }
                                                }
                                        }
                                    }
                            }
                    }
            }
            return Eligible.Declaration(-1, named.Builtin("invalid"), diagnostics);
    }
}
// Preserve original variant metadata selections when a constructor flattens
// an earlier declaration. Tagged child payload spans remain raw catalog facts.
Append :: (environment: Environment, plan: constructors.Plan) -> Environment {
    switch plan {
        case .Constructed(value, publish, id, name, definition_value, size, internal, selected, selected_fields, output_ids, diagnostics, element_type, element_collection, collection_container, key_type, key_collection):
            if (!publish) {
                return environment;
            }
            switch environment {
                case .Tables(reading, types, ids, definitions, variants, fields, capabilities, capability_fields):
                    new_types := types;
                    new_ids := ids;
                    new_variants := variants;
                    variant_start := length(new_variants);
                    index: int = 0;
                    while (index < length(selected)) {
                        item := selected[index];
                        payload := named.Value.Typed(item.storage, item.container, item.flags,
                                                     named.IDAt(output_ids, item.nominal_slot), named.IDAt(output_ids, item.parameter_slot));
                        field_start: int = 0;
                        field_count: int = 0;
                        tagged := false;
                        if (item.catalog_type >= 0) {
                            previous := definitions[item.catalog_type];
                            source_variant := variants[previous.variant_start + item.variant];
                            field_start = source_variant.field_start;
                            field_count = source_variant.field_count;
                            tagged = source_variant.tagged;
                        }
                        switch reader.AddTypeCollection(new_types, new_ids, payload, item.collection) {
                            case .Added(rows, pool, type_index):
                                new_types = rows;
                                new_ids = pool;
                                row: Variant = {type: type_index, tagged: tagged, field_start: field_start, field_count: field_count};
                                new_variants.append(row);
                        }
                        index += 1;
                    }
                    new_fields := fields;
                    field_start := length(new_fields);
                    index = 0;
                    while (index < length(selected_fields)) {
                        selection := selected_fields[index];
                        payload := named.Builtin("invalid");
                        payload_collection: u64 = 0;
                        if (selection.capability >= 0) {
                            original := capabilities[selection.capability];
                            row := capability_fields[original.result_start + selection.parameter];
                            payload = named.TypeAt(types, ids, row.type);
                            payload_collection = types[row.type].collection;
                        } else {
                            switch reading {
                                case .Tables(names, constructor_tables, pointer_size):
                                    switch names {
                                        case .Tables(lexical, name_types, name_ids, merged, own, native, symbol_types, imports, exports, uses,
                                                     identity, package_scope, has_native, has_documents, entity_id):
                                            payload = named.TypeAt(name_types, name_ids, symbol_types[selection.symbol]);
                                            payload_collection = name_types[symbol_types[selection.symbol]].collection;
                                    }
                            }
                        }
                        switch reader.AddTypeCollection(new_types, new_ids, payload, payload_collection) {
                            case .Added(rows, pool, type_index):
                                new_types = rows;
                                new_ids = pool;
                                row: Field = {type: type_index};
                                new_fields.append(row);
                        }
                        index += 1;
                    }
                    id_slot := length(new_ids);
                    new_ids.append(id);
                    row: Definition = {id_slot: id_slot, field_start: field_start, field_count: length(selected_fields),
                                       variant_start: variant_start, variant_count: length(selected)};
                    new_definitions := append(definitions, row);
                    return Environment.Tables(reading, new_types, new_ids, new_definitions, new_variants, new_fields, capabilities, capability_fields);
            }
    }
}
Absorb :: (environment: Environment, result: reader.Reading) -> Members {
    switch result {
        case .Read(value, has_unit, unit, updated, diagnostics, uses, publications, collection):
            current := environment;
            updates: Update[] = [];
            for (plan in publications) {
                current = Append(current, plan);
                updates.append(Update.Added(plan));
            }
            switch current {
                case .Tables(old_reading, types, ids, definitions, variants, fields, capabilities, capability_fields):
                    return Members.Built(Environment.Tables(updated, types, ids, definitions, variants, fields, capabilities, capability_fields), updates, diagnostics, uses);
            }
    }
}
Combine :: (earlier: Members, later: Members) -> Members {
    switch earlier {
        case .Built(old_environment, old_updates, old_diagnostics, old_uses):
            switch later {
                case .Built(environment, updates, diagnostics, uses):
                    all_updates := old_updates;
                    all_diagnostics := old_diagnostics;
                    all_uses := old_uses;
                    for (item in updates) {
                        all_updates.append(item);
                    }
                    for (item in diagnostics) {
                        all_diagnostics.append(item);
                    }
                    for (item in uses) {
                        all_uses.append(item);
                    }
                    return Members.Built(environment, all_updates, all_diagnostics, all_uses);
            }
    }
}
Errors :: (result: Members, errors: syntax.Diagnostic[]) -> Members {
    switch result {
        case .Built(environment, updates, diagnostics, uses):
            all_diagnostics := diagnostics;
            for (item in errors) {
                all_diagnostics.append(item);
            }
            return Members.Built(environment, updates, all_diagnostics, uses);
    }
}
OneError :: (result: Members, tree: reader.Tree, node: int, document: int, message: string) -> Members {
    errors: syntax.Diagnostic[] = [];
    errors.append(reader.Diagnostic(tree, node, document, message));
    return Errors(result, errors);
}

Replace :: (environment: Environment, id: u64, declared_variants: DeclaredVariant[], declared_fields: DeclaredField[],
            payload_types: named.Type[], payload_ids: u64[]) -> Environment {
    switch environment {
        case .Tables(reading, types, ids, definitions, variants, fields, capabilities, capability_fields):
            new_types := types;
            new_ids := ids;
            new_fields := fields;
            field_start := length(new_fields);
            for (item in declared_fields) {
                switch reader.AddTypeCollection(new_types, new_ids, named.TypeAt(payload_types, payload_ids, item.type), payload_types[item.type].collection) {
                    case .Added(rows, pool, type_index):
                        new_types = rows;
                        new_ids = pool;
                        row: Field = {type: type_index};
                        new_fields.append(row);
                }
            }
            new_variants := variants;
            variant_start := length(new_variants);
            for (item in declared_variants) {
                switch reader.AddTypeCollection(new_types, new_ids, named.TypeAt(payload_types, payload_ids, item.type), payload_types[item.type].collection) {
                    case .Added(rows, pool, type_index):
                        new_types = rows;
                        new_ids = pool;
                        row: Variant = {type: type_index, tagged: item.tagged,
                                        field_start: field_start + item.field_start, field_count: item.field_count};
                        new_variants.append(row);
                }
            }
            new_definitions := definitions;
            index: int = 0;
            while (index < length(new_definitions)) {
                item := new_definitions[index];
                if (named.IDAt(new_ids, item.id_slot) == id) {
                    row: Definition = {id_slot: item.id_slot, field_start: item.field_start, field_count: item.field_count,
                                       variant_start: variant_start, variant_count: length(declared_variants)};
                    new_definitions[index] = row;
                }
                index += 1;
            }
            switch reading {
                case .Tables(names, constructor_tables, pointer_size):
                    switch constructor_tables {
                        case .Tables(ctor_types, ctor_ids, ctor_definitions, ctor_variants, ctor_capabilities, functions, symbols, results):
                            rows := ctor_types;
                            pool := ctor_ids;
                            alternatives := ctor_variants;
                            start := length(alternatives);
                            for (item in declared_variants) {
                                switch reader.AddTypeCollection(rows, pool, named.TypeAt(payload_types, payload_ids, item.type), payload_types[item.type].collection) {
                                    case .Added(next_rows, next_pool, type_index):
                                        rows = next_rows;
                                        tag_slot := length(next_pool);
                                        pool = append(next_pool, named.IDAt(payload_ids, item.tag_slot));
                                        row: constructors.RawVariant = {tag_slot: tag_slot, type: type_index};
                                        alternatives.append(row);
                                }
                            }
                            definitions_copy := ctor_definitions;
                            index = 0;
                            while (index < length(definitions_copy)) {
                                item := definitions_copy[index];
                                if (named.IDAt(pool, item.id_slot) == id) {
                                    row: constructors.Definition = {id_slot: item.id_slot, variant_start: start, variant_count: length(declared_variants), element_type: item.element_type};
                                    definitions_copy[index] = row;
                                }
                                index += 1;
                            }
                            new_reading := reader.Environment.Tables(names,
                                                                     constructors.Environment.Tables(rows, pool, definitions_copy, alternatives, ctor_capabilities, functions, symbols, results), pointer_size);
                            return Environment.Tables(new_reading, new_types, new_ids, new_definitions, new_variants, new_fields, capabilities, capability_fields);
                    }
            }
    }
}
// Literal alternatives carry byte strings; ordinary variant names remain strict metadata.
VariantText :: union {
    Read(value: string, diagnostics: syntax.Diagnostic[])
}
ReadVariant :: (tree: reader.Tree, node: int, document: int, literal: bool) -> VariantText {
    if (literal) {
        decoded := json.Value(reader.Text(tree, node));
        diagnostics: syntax.Diagnostic[] = [];
        if (!decoded.valid) {
            diagnostics.append(reader.Diagnostic(tree, node, document, "Invalid string literal"));
            return VariantText.Read("", diagnostics);
        }
        return VariantText.Read(decoded.value, diagnostics);
    }
    switch reader.Name(tree, node, document) {
        case .Name(value, diagnostics):
            return VariantText.Read(value, diagnostics);
    }
}
BuildUnion :: (initial: Members, tree: reader.Tree, node: int, scope: int, document: int,
               union_value: named.Value) -> Members {
    current := initial;
    variants: DeclaredVariant[] = [];
    fields: DeclaredField[] = [];
    types: named.Type[] = [];
    ids: u64[] = [];
    union_id := u64(0);
    switch union_value {
        case .Typed(storage, container, flags, nominal, parameter):
            union_id = nominal;
    }
    switch tree {
        case .Raw(nodes, row_fields, named_flags, extra_flags, source):
            child := nodes[node].first_child;
            while (child >= 0) {
                if (named_flags[child] && reader.Kind(tree, child, syntax.UnionVariant)) {
                    literal_node := reader.Field(tree, child, syntax.FieldLiteral);
                    name_node := reader.Field(tree, child, syntax.FieldName);
                    if (literal_node >= 0) {
                        name_node = literal_node;
                    }
                    switch ReadVariant(tree, name_node, document, literal_node >= 0) {
                        case .Read(decoded_name, errors):
                            current = Errors(current, errors);
                            name := decoded_name;
                            literal_value := decoded_name;
                            tag := binding.ID("union-literal", literal_value);
                            payload := named.Value.Typed(13, 0, 1024, 0, tag);
                            if (literal_node >= 0 && strings.IndexByte(name, 0) >= 0) {
                                name = reader.Text(tree, literal_node);
                            }
                            if (literal_node < 0) {
                                key := strings.Slice(format_text("{}:{}", union_id, name), 0, 511);
                                tag = binding.ID("union-variant", key);
                                switch union_value {
                                    case .Typed(storage, container, flags, nominal, parameter):
                                        payload = named.Value.Typed(storage, container, flags, nominal, tag);
                                }
                            }
                            for (item in variants) {
                                if (named.IDAt(ids, item.tag_slot) == tag) {
                                    current = OneError(current, tree, child, document, format_text("Duplicate union alternative '{}'", name));
                                }
                            }
                            first_field := length(fields);
                            parameters := reader.Field(tree, child, syntax.FieldParameters);
                            if (parameters >= 0) {
                                parameter_node := nodes[parameters].first_child;
                                while (parameter_node >= 0) {
                                    if (named_flags[parameter_node] && !extra_flags[parameter_node]) {
                                        token := reader.Field(tree, parameter_node, syntax.FieldName);
                                        switch reader.Name(tree, token, document) {
                                            case .Name(field_name, field_errors):
                                                current = Errors(current, field_errors);
                                                value := named.Builtin("invalid");
                                                value_collection: u64 = 0;
                                                switch current {
                                                    case .Built(environment, updates, diagnostics, uses):
                                                        switch environment {
                                                            case .Tables(reading, graph_types, graph_ids, definitions, graph_variants, graph_fields, capabilities, capability_fields):
                                                                result := reader.Type(reading, tree, reader.Field(tree, parameter_node, syntax.FieldType), scope, document);
                                                                switch result {
                                                                    case .Read(resolved, has_unit, unit, updated, type_errors, type_uses, publications, collection):
                                                                        value = resolved;
                                                                        value_collection = collection;
                                                                }
                                                                current = Combine(current, Absorb(environment, result));
                                                        }
                                                }
                                                switch value {
                                                    case .Typed(storage, container, flags, nominal, type_parameter):
                                                        if ((flags & 20) != 0) {
                                                            current = OneError(current, tree, parameter_node, document, "Union payloads require an owned value type");
                                                        }
                                                }
                                                switch reader.AddTypeCollection(types, ids, value, value_collection) {
                                                    case .Added(rows, pool, type_index):
                                                        types = rows;
                                                        id_slot := length(pool);
                                                        ids = append(pool, binding.ID("union-field", field_name));
                                                        row: DeclaredField = {name: field_name, id_slot: id_slot, type: type_index,
                                                                              offset: length(fields) - first_field, writable: false, has_default: false};
                                                        fields.append(row);
                                                }
                                        }
                                    }
                                    parameter_node = nodes[parameter_node].next_sibling;
                                }
                            }
                            switch reader.AddType(types, ids, payload) {
                                case .Added(rows, pool, type_index):
                                    types = rows;
                                    tag_slot := length(pool);
                                    ids = append(pool, tag);
                                    literal := "";
                                    if (literal_node >= 0) {
                                        literal = literal_value;
                                    }
                                    row: DeclaredVariant = {name: name, tag_slot: tag_slot, type: type_index,
                                                            tagged: literal_node < 0, is_literal: literal_node >= 0, literal: literal,
                                                            field_start: first_field, field_count: length(fields) - first_field};
                                    variants.append(row);
                            }
                    }
                }
                child = nodes[child].next_sibling;
            }
    }
    if (length(variants) == 0) {
        current = OneError(current, tree, node, document, "A union needs at least one alternative");
    }
    switch current {
        case .Built(environment, updates, diagnostics, uses):
            updated := Replace(environment, union_id, variants, fields, types, ids);
            all_updates := append(updates, Update.Replaced(union_id, variants, fields, types, ids));
            return Members.Built(updated, all_updates, diagnostics, uses);
    }
}
pub Build :: (environment: Environment, tree: reader.Tree, body: int, scope: int, document: int) -> Members {
    updates: Update[] = [];
    diagnostics: syntax.Diagnostic[] = [];
    uses: named.Use[] = [];
    current := Members.Built(environment, updates, diagnostics, uses);
    if (body < 0) {
        return current;
    }
    switch tree {
        case .Raw(nodes, row_fields, named_flags, extra_flags, source):
            child := nodes[body].first_child;
            while (child >= 0) {
                if (named_flags[child] && reader.Kind(tree, child, syntax.UnionDeclaration)) {
                    switch current {
                        case .Built(live, current_updates, current_diagnostics, current_uses):
                            switch EligibleUnion(live, tree, child, scope, document) {
                                case .Declaration(symbol, value, errors):
                                    current = Errors(current, errors);
                                    if (symbol >= 0) {
                                        current = BuildUnion(current, tree, child, scope, document, value);
                                    }
                            }
                    }
                }
                child = nodes[child].next_sibling;
            }
            states: int[] = [];
            switch current {
                case .Built(live, current_updates, current_diagnostics, current_uses):
                    switch live {
                        case .Tables(reading, types, ids, definitions, variants, fields, capabilities, capability_fields):
                            states = resize([int(0)], length(definitions));
                    }
            }
            child = nodes[body].first_child;
            while (child >= 0) {
                if (named_flags[child] && reader.Kind(tree, child, syntax.UnionDeclaration)) {
                    switch current {
                        case .Built(live, current_updates, current_diagnostics, current_uses):
                            switch EligibleUnion(live, tree, child, scope, document) {
                                case .Declaration(symbol, value, errors):
                                    current = Errors(current, errors);
                                    if (symbol >= 0) {
                                        switch live {
                                            case .Tables(reading, types, ids, definitions, variants, fields, capabilities, capability_fields):
                                                switch reader.AddType(types, ids, value) {
                                                    case .Added(rows, pool, type_index):
                                                        roots: int[] = [type_index];
                                                        switch Validate(rows, pool, definitions, variants, fields, roots, states) {
                                                            case .Checked(root, error, next_states):
                                                                states = next_states;
                                                                if (error != 0) {
                                                                    message := "Recursive owned union payloads are not supported";
                                                                    if (error == 2) {
                                                                        message = "Union payload nesting exceeds the supported depth";
                                                                    }
                                                                    return OneError(current, tree, child, document, message);
                                                                }
                                                        }
                                                }
                                        }
                                    }
                            }
                    }
                }
                child = nodes[child].next_sibling;
            }
    }
    return current;
}
