package package_compiler

import snapshot "project:source_snapshot"
import syntax "project:syntax_diagnostics"
import strings "core:strings"

// One function body, emitted in one pass. A work stack visits statements and
// expressions in evaluation order; each expression pushes its typed value.
// Scalars and strings live in the locals bank. Records and arrays are
// pointers; a local one lives in a data cell and is copied on every store.
// Host calls and authored calls pass values through cells, whose headers
// carry each value's type.
//
// EmitBody keeps every table and emits control flow. Every other node is a
// step (Steps.chibi) that returns only what it adds, so no one definition
// grows past what the runtime's verifier admits.

Slot :: struct { storage: int; kind: int; }
// An instruction with the value a constant or header read carries and the
// source range it lowers.
Code :: struct {
    op: int; type: int; output: int; left: int; right: int; target: int; offset: int;
    value_storage: int; value_container: int; value_record: int; payload: int; text: string;
    has_text: bool; start: int; end: int; line: int; column: int;
}
// A data cell's header type and kind. Some cells hold a constant payload: the
// bits `constant`, or the tag of variant types[variant] when that is not -1.
Cell :: struct { storage: int; container: int; record: int; constant: int; variant: int; kind: int; }
Invocation :: struct { callee: int; first: int; count: int; result_first: int; result_count: int; }
// A host call: runtime intrinsic `intrinsic`, or the native natives[linked]
// when `linked` is not -1.
Host :: struct { intrinsic: int; linked: int; first: int; result_first: int; result_count: int; }
// A slot holding a record or array pointer the collector must trace.
Root :: struct { slot: int; storage: int; container: int; record: int; }
Body :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Emitted(slots: Slot[], locals: int[], cells: Cell[], code: Code[], calls: Invocation[],
              hosts: Host[], roots: Root[])
}
// A scheduled visit. Storage, container and record are the type a literal at
// `node` takes from its context; storage 0 means none.
Work :: struct { node: int; phase: int; a: int; b: int; c: int; storage: int; container: int; record: int; }
Value :: struct { slot: int; storage: int; container: int; record: int; }
// A name in scope: a locals-bank value, a record or array held in a data
// cell, or a record or array parameter read in place. Pattern bindings are
// not writable.
Name :: struct { name: string; place: int; index: int; storage: int; container: int; record: int; writable: bool; }
// A loop being emitted. A while loop's continues jump to `head`; a foreach
// loop patches them to its increment, and owns its index local, the names to
// drop and its exit jump, `leave`.
Loop :: struct { head: int; first_break: int; first_continue: int; each: bool; index: int; mark: int; leave: int; }
// A switch being emitted: the local holding its union, where its exit jumps
// start in `exits` and its matched variants in `covered`, whether it has a
// default arm, the pending jump past the current arm, and the names the arm's
// bindings start at.
Switch :: struct { subject: int; held: int; first_exit: int; first_cover: int; defaulted: bool; skip: int; mark: int; }
// The size of each table when a step starts.
Bases :: struct { pc: int; slot: int; local: int; cell: int; host: int; call: int; }
// What a step adds: instructions and table rows, names it binds, work it
// schedules, how many values it pops, the value it produces, a value to copy
// into a fresh cell, and positions it reports to EmitBody.
Step :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Emitted(code: Code[], slots: Slot[], locals: int[], cells: Cell[], hosts: Host[], roots: Root[],
              calls: Invocation[], bound: Name[], next: Work[], popped: int, produced: Value, retain: Value,
              marks: int[])
}

ValueKind: int : 0;
AddressKind: int : 1;
LocalPlace: int : 0;
CellPlace: int : 1;
ParameterPlace: int : 2;
// An import alias; its index is the package it names.
AliasPlace: int : 3;
ArrayContainer: int : 1;
// A jump whose target a later instruction supplies.
Pending: int : -1;
SnapshotIntrinsic: int : 1;
ConstructIntrinsic: int : 2;
ArrayPushIntrinsic: int : 27;
ArrayStoreIntrinsic: int : 28;
ArrayExtendIntrinsic: int : 29;
UnionMakeIntrinsic: int : 20;
UnionTestIntrinsic: int : 21;
UnionGetIntrinsic: int : 22;
// Statement phases after the value is ready.
ValuePhase: int : 1;
RetainedPhase: int : 2;
PushPhase: int : 3;
StorePhase: int : 4;

Instruction :: pure fn(op: int, type: int, output: int, left: int, right: int, target: int,
                       item: snapshot.SnapshotNode) -> Code {
    return {op: op, type: type, output: output, left: left, right: right, target: target,
        offset: 0, value_storage: 0, value_container: 0, value_record: -1, payload: 0, text: "",
        has_text: false, start: item.start, end: item.end, line: item.row + 1, column: item.column + 1};
}
Visit :: pure fn(node: int) -> Work {
    return {node: node, phase: 0, a: 0, b: 0, c: 0, storage: 0, container: 0, record: -1};
}
Expect :: pure fn(node: int, storage: int, container: int, record: int) -> Work {
    return {node: node, phase: 0, a: 0, b: 0, c: 0, storage: storage, container: container, record: record};
}
Resume :: pure fn(node: int, phase: int, a: int, b: int) -> Work {
    return {node: node, phase: phase, a: a, b: b, c: 0, storage: 0, container: 0, record: -1};
}
NoValue :: pure fn() -> Value { return {slot: -1, storage: 0, container: 0, record: -1}; }
Typed :: pure fn(slot: int, storage: int, container: int, record: int) -> Value {
    return {slot: slot, storage: storage, container: container, record: record};
}
Fail :: pure fn(forest: snapshot.SnapshotNode[], node: int, document: int, message: string) -> Step {
    return Step.Failed(Diagnose(forest, node, document, message));
}
// Records and arrays are pointers to their storage.
Pointer :: pure fn(storage: int, container: int) -> bool {
    return container != 0 || storage == StructStorage;
}
SlotStorage :: pure fn(storage: int, container: int, target: Target) -> int {
    if (Pointer(storage, container)) { return target.pointer_storage; }
    return storage;
}
SlotKind :: pure fn(storage: int, container: int) -> int {
    if (Pointer(storage, container)) { return AddressKind; }
    return ValueKind;
}
SameType :: pure fn(storage: int, container: int, record: int, value: Value) -> bool {
    return storage == value.storage && container == value.container && record == value.record;
}
Single :: pure fn(value: Value, storage: int) -> bool {
    return value.storage == storage && value.container == 0;
}
// Decimal digits as an int, or -1 when they do not fit.
Decimal :: pure fn(text: string) -> int64 {
    value: int64 = 0;
    index: int = 0;
    while (index < strings.ByteLength(text)) {
        digit := strings.ByteAt(text, index);
        if (digit < 48 || digit > 57) { return -1; }
        value = value * 10 + int64(digit - 48);
        if (value > 2147483648) { return -1; }
        index += 1;
    }
    return value;
}
// The instruction a binary operator lowers to; -1 for logic and unknown ones.
BinaryOp :: pure fn(ops: Ops, operator: string) -> int {
    if (operator == "+") { return ops.add; }
    if (operator == "-") { return ops.sub; }
    if (operator == "*") { return ops.mul; }
    if (operator == "/") { return ops.div; }
    if (operator == "%") { return ops.mod; }
    if (operator == "&") { return ops.bit_and; }
    if (operator == "|") { return ops.bit_or; }
    if (operator == "^") { return ops.bit_xor; }
    if (operator == "<<") { return ops.shl; }
    if (operator == ">>") { return ops.shr; }
    if (operator == "<") { return ops.lt; }
    if (operator == "<=") { return ops.le; }
    if (operator == ">") { return ops.gt; }
    if (operator == ">=") { return ops.ge; }
    if (operator == "==") { return ops.eq; }
    if (operator == "!=") { return ops.ne; }
    return -1;
}
Comparison :: pure fn(ops: Ops, op: int) -> bool {
    return op == ops.lt || op == ops.le || op == ops.gt || op == ops.ge || op == ops.eq || op == ops.ne;
}
// The operator of a compound assignment, "" for plain assignment.
CompoundOperator :: pure fn(text: string) -> string {
    if (text == "=") { return ""; }
    return strings.Slice(text, 0, strings.ByteLength(text) - 1);
}
// The function of `package` named `name`, -1 when none.
FindCallable :: pure fn(callables: Callable[], package: int, name: string) -> int {
    index: int = 0;
    while (index < length(callables)) {
        if (callables[index].package == package && callables[index].name == name) { return index; }
        index += 1;
    }
    return -1;
}
FindField :: pure fn(types: TypeDecl[], members: TypeMember[], record: int, name: string) -> int {
    at := types[record].first;
    while (at < types[record].first + types[record].count) {
        if (members[at].name == name) { return at; }
        at += 1;
    }
    return -1;
}
// The innermost binding of `wanted`, -1 when none.
Lookup :: pure fn(names: Name[], wanted: string) -> int {
    at := length(names) - 1;
    while (at >= 0) {
        if (names[at].name == wanted) { return at; }
        at -= 1;
    }
    return -1;
}
Separator :: pure fn(byte: int) -> bool { return byte == 95 || byte == 32 || byte == 45; }
Lower :: pure fn(byte: int) -> int {
    if (byte >= 65 && byte <= 90) { return byte + 32; }
    return byte;
}
// Whether two names match as the native catalog matches them: ignoring case,
// spaces, underscores and hyphens.
NameMatches :: pure fn(left: string, right: string) -> bool {
    i: int = 0;
    j: int = 0;
    left_length := strings.ByteLength(left);
    right_length := strings.ByteLength(right);
    while (i <= left_length && j <= right_length) {
        while (i < left_length && Separator(strings.ByteAt(left, i))) { i += 1; }
        while (j < right_length && Separator(strings.ByteAt(right, j))) { j += 1; }
        if (i == left_length || j == right_length) { return i == left_length && j == right_length; }
        if (Lower(strings.ByteAt(left, i)) != Lower(strings.ByteAt(right, j))) { return false; }
        i += 1;
        j += 1;
    }
    return false;
}
// The native an exact name or one unique matching name selects: -1 when none,
// -2 when several match.
FindNative :: pure fn(natives: Native[], name: string) -> int {
    found := -1;
    index: int = 0;
    while (index < length(natives)) {
        if (natives[index].name == name) { return index; }
        if (NameMatches(natives[index].name, name)) {
            if (found >= 0) {
                found = -2;
            } else if (found == -1) {
                found = index;
            }
        }
        index += 1;
    }
    return found;
}
// The package a name of package `package` qualified by `node` names: that
// package for none, the imported one when `node` is an import alias no local
// hides, and -1 otherwise.
QualifierOf :: pure fn(forest: snapshot.SnapshotNode[], text: string, names: Name[], package: int, node: int) -> int {
    if (node < 0) { return package; }
    if (!Is(forest, node, "identifier")) { return -1; }
    found := Lookup(names, Text(forest, text, node));
    if (found < 0 || names[found].place != AliasPlace) { return -1; }
    return names[found].index;
}
// The union `U` names when `node` is a member expression `U.Variant` or
// `alias.U.Variant` and no local hides U or the alias; -1 otherwise.
UnionOf :: pure fn(forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], names: Name[], package: int,
                   node: int) -> int {
    object := Field(forest, node, "object");
    qualifier := -1;
    if (Is(forest, object, "member_expression")) {
        qualifier = Field(forest, object, "object");
        object = Field(forest, object, "member");
    } else if (!Is(forest, object, "identifier") || Lookup(names, Text(forest, text, object)) >= 0) {
        return -1;
    }
    home := QualifierOf(forest, text, names, package, qualifier);
    if (home < 0) { return -1; }
    declared := FindType(types, home, NameText(forest, text, object));
    if (declared < 0 || types[declared].kind != UnionDecl) { return -1; }
    return declared;
}
// Whether `variant` is among `covered` from `first` on.
Covers :: pure fn(covered: int[], first: int, variant: int) -> bool {
    at := first;
    while (at < length(covered)) {
        if (covered[at] == variant) { return true; }
        at += 1;
    }
    return false;
}
// The next switch arm after `node` among its siblings, -1 when none.
NextArm :: pure fn(forest: snapshot.SnapshotNode[], node: int) -> int {
    at := NextMember(forest, node);
    while (at >= 0 && !Is(forest, at, "switch_arm")) { at = NextMember(forest, at); }
    return at;
}
// The native `xs = name(xs, value)` updates in place when xs names the local
// array names[found]: "Array Add" or "Append"; -1 for any other statement.
InPlaceNative :: pure fn(forest: snapshot.SnapshotNode[], text: string, callables: Callable[], natives: Native[],
                         names: Name[], package: int, found: int, destination: int, value: int) -> int {
    binding := names[found];
    if (binding.place != CellPlace || binding.container != ArrayContainer || !binding.writable ||
        !Is(forest, value, "call_expression")) {
        return -1;
    }
    callee := Field(forest, value, "function");
    first := FirstMember(forest, Field(forest, value, "arguments"));
    if (!Is(forest, callee, "identifier") || FindCallable(callables, package, Text(forest, text, callee)) >= 0 ||
        !Is(forest, first, "identifier") || Text(forest, text, first) != Text(forest, text, destination)) {
        return -1;
    }
    second := NextMember(forest, first);
    if (second < 0 || NextMember(forest, second) >= 0) { return -1; }
    native := FindNative(natives, Text(forest, text, callee));
    if (native < 0 || (natives[native].name != "Array Add" && natives[native].name != "Append")) { return -1; }
    return native;
}

EmitBody :: pure fn(forest: snapshot.SnapshotNode[], text: string, document: int,
                    callables: Callable[], params: Param[], types: TypeDecl[], members: TypeMember[],
                    natives: Native[], ports: Port[], aliases: Name[], function: int, ops: Ops, target: Target) -> Body {
    callable := callables[function];
    declaration := forest[callable.node];
    slots: Slot[] = [];
    // The storage of each locals-bank value; records and arrays never live there.
    locals: int[] = [];
    cells: Cell[] = [];
    code: Code[] = [];
    calls: Invocation[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    // Import aliases are the outermost names; every local may hide one.
    names := aliases;
    work: Work[] = [];
    values: Value[] = [];
    loops: Loop[] = [];
    breaks: int[] = [];
    continues: int[] = [];
    switches: Switch[] = [];
    exits: int[] = [];
    covered: int[] = [];
    work_top: int = 0;
    value_top: int = 0;
    // Scalar and string parameters move to locals, so assigning one needs no
    // other form; record and array parameters are read in place.
    index: int = 0;
    while (index < callable.count) {
        param := params[callable.first + index];
        if (Pointer(param.storage, param.container)) {
            name: Name = {name: param.name, place: ParameterPlace, index: index, storage: param.storage,
                container: param.container, record: param.record, writable: true};
            names = array_add(names, name);
        } else {
            slot: Slot = {storage: param.storage, kind: ValueKind};
            slots = array_add(slots, slot);
            read := Instruction(ops.argument, param.storage, length(slots) - 1, index, 0, 0, declaration);
            read.value_storage = param.storage;
            code = array_add(code, read);
            locals = array_add(locals, param.storage);
            code = array_add(code, Instruction(ops.save, param.storage, 0, length(slots) - 1, 0,
                length(locals) - 1, declaration));
            name: Name = {name: param.name, place: LocalPlace, index: length(locals) - 1,
                storage: param.storage, container: 0, record: param.record, writable: true};
            names = array_add(names, name);
        }
        index += 1;
    }
    work = array_add(work, Visit(Field(forest, callable.node, "body")));
    work_top = 1;
    while (work_top > 0) {
        work_top -= 1;
        item := work[work_top];
        node := forest[item.node];
        kind := node.kind;
        // Items this one schedules, in the order they run.
        next: Work[] = [];
        // A value this item leaves for its consumer, when `produced.storage` is set.
        produced := NoValue();
        // A record or array to copy into a fresh cell; the copy is produced.
        retain := NoValue();
        operator := Text(forest, text, Field(forest, item.node, "operator"));
        logic := kind == "binary_expression" &&
                 (operator == "&&" || operator == "and" || operator == "||" || operator == "or");
        // The step a node other than control flow takes.
        stepped := true;
        at: Bases = {pc: length(code), slot: length(slots), local: length(locals), cell: length(cells),
            host: length(hosts), call: length(calls)};
        step := Fail(forest, item.node, document, "");
        if (kind == "callable_body" || kind == "block") {
            stepped = false;
            if (item.phase == 0) {
                child := FirstMember(forest, item.node);
                while (child >= 0) {
                    next = array_add(next, Visit(child));
                    child = NextMember(forest, child);
                }
                next = array_add(next, Resume(item.node, 1, length(names), 0));
            } else {
                names = slice(names, 0, item.a);
            }
        } else if (kind == "if_statement" || kind == "while_statement") {
            stepped = false;
            if (item.phase == 0) {
                head := length(code);
                code = array_add(code, Instruction(ops.check, 0, 0, 0, 0, 0, node));
                next = array_add(next, Visit(Field(forest, item.node, "condition")));
                next = array_add(next, Resume(item.node, 1, head, 0));
            } else if (item.phase == 1) {
                value_top -= 1;
                condition := values[value_top];
                if (!Single(condition, BoolStorage)) {
                    return Body.Failed(Diagnose(forest, Field(forest, item.node, "condition"), document,
                        "condition needs a bool"));
                }
                code = array_add(code, Instruction(ops.branch_if, 0, 0, condition.slot, 0, length(code) + 2, node));
                code = array_add(code, Instruction(ops.jump, 0, 0, 0, 0, Pending, node));
                field := "consequence";
                if (kind == "while_statement") {
                    field = "body";
                    loop: Loop = {head: item.a, first_break: length(breaks), first_continue: length(continues),
                        each: false, index: -1, mark: length(names), leave: length(code) - 1};
                    loops = array_add(loops, loop);
                }
                next = array_add(next, Visit(Field(forest, item.node, field)));
                next = array_add(next, Resume(item.node, 2, item.a, length(code) - 1));
            } else if (item.phase == 2) {
                alternative := Field(forest, item.node, "alternative");
                if (kind == "while_statement") {
                    code = array_add(code, Instruction(ops.jump, 0, 0, 0, 0, item.a, node));
                    loop := loops[length(loops) - 1];
                    loops = slice(loops, 0, length(loops) - 1);
                    at_break := loop.first_break;
                    while (at_break < length(breaks)) {
                        escape := code[breaks[at_break]];
                        escape.target = length(code);
                        code[breaks[at_break]] = escape;
                        at_break += 1;
                    }
                    breaks = slice(breaks, 0, loop.first_break);
                    skip := code[item.b];
                    skip.target = length(code);
                    code[item.b] = skip;
                } else if (alternative >= 0) {
                    code = array_add(code, Instruction(ops.jump, 0, 0, 0, 0, Pending, node));
                    skip := code[item.b];
                    skip.target = length(code);
                    code[item.b] = skip;
                    next = array_add(next, Visit(alternative));
                    next = array_add(next, Resume(item.node, 3, 0, length(code) - 1));
                } else {
                    skip := code[item.b];
                    skip.target = length(code);
                    code[item.b] = skip;
                }
            } else {
                end := code[item.b];
                end.target = length(code);
                code[item.b] = end;
            }
        } else if (kind == "foreach_statement") {
            if (item.phase == 0) {
                stepped = false;
                code = array_add(code, Instruction(ops.check, 0, 0, 0, 0, 0, node));
                next = array_add(next, Visit(Field(forest, item.node, "value")));
                next = array_add(next, Resume(item.node, 1, 0, 0));
            } else if (item.phase == 1) {
                // The loop walks its own copy, whatever the body changes.
                stepped = false;
                value_top -= 1;
                array := values[value_top];
                if (array.container != ArrayContainer) {
                    return Body.Failed(Diagnose(forest, Field(forest, item.node, "value"), document, "foreach needs an array"));
                }
                retain = array;
                next = array_add(next, Resume(item.node, 2, 0, 0));
            } else if (item.phase == 2) {
                // The copy is in the last cell; the step loads each element.
                value_top -= 1;
                if (NameText(forest, text, Field(forest, item.node, "name")) == "") {
                    return Body.Failed(Diagnose(forest, Field(forest, item.node, "name"), document,
                        "Invalid string or embedded NUL"));
                }
                step = ForeachStep(values[value_top], ops, target, at, node);
            } else if (item.phase == 3) {
                // A record element was copied into the last cell.
                stepped = false;
                value_top -= 1;
                kept := values[value_top];
                binding: Name = {name: NameText(forest, text, Field(forest, item.node, "name")), place: CellPlace,
                    index: length(cells) - 1, storage: StructStorage, container: 0, record: kept.record, writable: true};
                names = array_add(names, binding);
                next = array_add(next, Visit(Field(forest, item.node, "body")));
                next = array_add(next, Resume(item.node, 4, 0, 0));
            } else {
                stepped = false;
                loop := loops[length(loops) - 1];
                loops = slice(loops, 0, length(loops) - 1);
                at_continue := loop.first_continue;
                while (at_continue < length(continues)) {
                    resume := code[continues[at_continue]];
                    resume.target = length(code);
                    code[continues[at_continue]] = resume;
                    at_continue += 1;
                }
                continues = slice(continues, 0, loop.first_continue);
                number: Slot = {storage: IntStorage, kind: ValueKind};
                slots = array_add(slots, number);
                code = array_add(code, Instruction(ops.local, IntStorage, length(slots) - 1, loop.index, 0, 0, node));
                slots = array_add(slots, number);
                constant := Instruction(ops.constant, IntStorage, length(slots) - 1, 0, 0, 0, node);
                constant.value_storage = IntStorage;
                constant.payload = 1;
                code = array_add(code, constant);
                slots = array_add(slots, number);
                code = array_add(code, Instruction(ops.add, IntStorage, length(slots) - 1, length(slots) - 3,
                    length(slots) - 2, -1, node));
                code = array_add(code, Instruction(ops.save, IntStorage, 0, length(slots) - 1, 0, loop.index, node));
                code = array_add(code, Instruction(ops.jump, 0, 0, 0, 0, loop.head, node));
                done := code[loop.leave];
                done.target = length(code);
                code[loop.leave] = done;
                at_break := loop.first_break;
                while (at_break < length(breaks)) {
                    escape := code[breaks[at_break]];
                    escape.target = length(code);
                    code[breaks[at_break]] = escape;
                    at_break += 1;
                }
                breaks = slice(breaks, 0, loop.first_break);
                names = slice(names, 0, loop.mark);
            }
        } else if (kind == "switch_statement") {
            if (item.phase == 0) {
                stepped = false;
                code = array_add(code, Instruction(ops.check, 0, 0, 0, 0, 0, node));
                next = array_add(next, Visit(Field(forest, item.node, "value")));
                next = array_add(next, Resume(item.node, 1, 0, 0));
            } else if (item.phase == 1) {
                // The union waits in a local while each arm tests it in turn.
                stepped = false;
                value_top -= 1;
                subject := values[value_top];
                if (!Single(subject, UnionStorage)) {
                    return Body.Failed(Diagnose(forest, Field(forest, item.node, "value"), document, "switch needs a union value"));
                }
                locals = array_add(locals, UnionStorage);
                code = array_add(code, Instruction(ops.save, UnionStorage, 0, subject.slot, 0, length(locals) - 1, node));
                current: Switch = {subject: length(locals) - 1, held: subject.record, first_exit: length(exits),
                    first_cover: length(covered), defaulted: false, skip: -1, mark: length(names)};
                switches = array_add(switches, current);
                next = array_add(next, Resume(item.node, 2, NextArm(forest, Field(forest, item.node, "value")), 0));
            } else if (item.phase == 2 && item.a < 0) {
                stepped = false;
                current := switches[length(switches) - 1];
                if (!current.defaulted && length(covered) - current.first_cover < types[current.held].count) {
                    return Body.Failed(Diagnose(forest, item.node, document,
                        "Non-exhaustive switch: a union alternative is missing"));
                }
                switches = slice(switches, 0, length(switches) - 1);
                covered = slice(covered, 0, current.first_cover);
                at_exit := current.first_exit;
                while (at_exit < length(exits)) {
                    exit_jump := code[exits[at_exit]];
                    exit_jump.target = length(code);
                    code[exits[at_exit]] = exit_jump;
                    at_exit += 1;
                }
                exits = slice(exits, 0, current.first_exit);
            } else if (item.phase == 2) {
                current := switches[length(switches) - 1];
                current.mark = length(names);
                switches[length(switches) - 1] = current;
                pattern := Field(forest, item.a, "value");
                if (pattern < 0) {
                    if (current.defaulted) { return Body.Failed(Diagnose(forest, item.a, document, "Duplicate default arm")); }
                    current.defaulted = true;
                    switches[length(switches) - 1] = current;
                    stepped = false;
                } else {
                    if (!Is(forest, pattern, "variant_pattern")) {
                        return Body.Failed(Diagnose(forest, pattern, document, "switch arms need a variant pattern"));
                    }
                    member := Text(forest, text, Field(forest, pattern, "name"));
                    variant := FindVariant(types, current.held, member);
                    if (variant < 0) {
                        return Body.Failed(Diagnose(forest, pattern, document, format_text("Unknown variant '{}'", member)));
                    }
                    if (current.defaulted || Covers(covered, current.first_cover, variant)) {
                        return Body.Failed(Diagnose(forest, pattern, document, "Unreachable duplicate union pattern"));
                    }
                    covered = array_add(covered, variant);
                    bindings := Field(forest, pattern, "bindings");
                    count: int = 0;
                    binding := FirstMember(forest, bindings);
                    while (binding >= 0) {
                        count += 1;
                        binding = NextMember(forest, binding);
                    }
                    if (count != 0 && count != types[variant].count) {
                        return Body.Failed(Diagnose(forest, pattern, document, "A union payload pattern must bind every field"));
                    }
                    step = ArmStep(forest, text, types, members, current.subject, variant, bindings, ops, target, at, node);
                }
                next = array_add(next, Visit(Field(forest, item.a, "body")));
                next = array_add(next, Resume(item.node, 3, item.a, 0));
            } else {
                // The arm is done: leave the switch, and send a failed test here.
                stepped = false;
                exits = array_add(exits, length(code));
                code = array_add(code, Instruction(ops.jump, 0, 0, 0, 0, Pending, node));
                current := switches[length(switches) - 1];
                if (current.skip >= 0) {
                    skip := code[current.skip];
                    skip.target = length(code);
                    code[current.skip] = skip;
                }
                current.skip = -1;
                switches[length(switches) - 1] = current;
                names = slice(names, 0, current.mark);
                next = array_add(next, Resume(item.node, 2, NextArm(forest, item.a), 0));
            }
        } else if (kind == "break_statement" || kind == "continue_statement") {
            stepped = false;
            if (length(loops) == 0) {
                return Body.Failed(Diagnose(forest, item.node, document, "break or continue outside a loop"));
            }
            loop := loops[length(loops) - 1];
            code = array_add(code, Instruction(ops.check, 0, 0, 0, 0, 0, node));
            if (kind == "break_statement") {
                breaks = array_add(breaks, length(code));
                code = array_add(code, Instruction(ops.jump, 0, 0, 0, 0, Pending, node));
            } else if (loop.each) {
                continues = array_add(continues, length(code));
                code = array_add(code, Instruction(ops.jump, 0, 0, 0, 0, Pending, node));
            } else {
                code = array_add(code, Instruction(ops.jump, 0, 0, 0, 0, loop.head, node));
            }
        } else if (logic) {
            // The temporary local holds the answer whichever side decides it.
            stepped = false;
            if (item.phase == 0) {
                next = array_add(next, Visit(Field(forest, item.node, "left")));
                next = array_add(next, Resume(item.node, 1, 0, 0));
            } else if (item.phase == 1) {
                value_top -= 1;
                left := values[value_top];
                if (!Single(left, BoolStorage)) {
                    return Body.Failed(Diagnose(forest, item.node, document, "logic needs bool operands"));
                }
                locals = array_add(locals, BoolStorage);
                answer := length(locals) - 1;
                code = array_add(code, Instruction(ops.save, BoolStorage, 0, left.slot, 0, answer, node));
                escape := length(code);
                if (operator == "&&" || operator == "and") {
                    code = array_add(code, Instruction(ops.branch_if, 0, 0, left.slot, 0, length(code) + 2, node));
                    escape = length(code);
                    code = array_add(code, Instruction(ops.jump, 0, 0, 0, 0, Pending, node));
                } else {
                    code = array_add(code, Instruction(ops.branch_if, 0, 0, left.slot, 0, Pending, node));
                }
                next = array_add(next, Visit(Field(forest, item.node, "right")));
                next = array_add(next, Resume(item.node, 2, answer, escape));
            } else {
                value_top -= 1;
                right := values[value_top];
                if (!Single(right, BoolStorage)) {
                    return Body.Failed(Diagnose(forest, item.node, document, "logic needs bool operands"));
                }
                code = array_add(code, Instruction(ops.save, BoolStorage, 0, right.slot, 0, item.a, node));
                escape := code[item.b];
                escape.target = length(code);
                code[item.b] = escape;
                slot: Slot = {storage: BoolStorage, kind: ValueKind};
                slots = array_add(slots, slot);
                code = array_add(code, Instruction(ops.local, BoolStorage, length(slots) - 1, item.a, 0, 0, node));
                produced = Typed(length(slots) - 1, BoolStorage, 0, -1);
            }
        } else if (kind == "local_declaration" || kind == "assignment" || kind == "expression_statement" ||
                   kind == "return_statement") {
            step = StatementStep(forest, text, document, callables, types, natives, names, callable.package, values,
                value_top, function, item, ops, target, at);
        } else if (kind == "number" || kind == "boolean" || kind == "string" || kind == "identifier" ||
                   kind == "parenthesized_expression" || kind == "member_expression" || kind == "index_expression") {
            step = ValueStep(forest, text, document, types, members, names, callable.package, values, value_top, item,
                ops, target, at);
        } else if (kind == "struct_expression" || kind == "array_expression") {
            step = LiteralStep(forest, text, document, types, members, values, value_top, item, ops, target, at);
        } else if (kind == "call_expression") {
            step = CallStep(forest, text, document, callables, params, types, members, natives, ports, names,
                callable.package, values, value_top, item, ops, target, at);
        } else if (kind == "unary_expression" || kind == "binary_expression") {
            step = OperatorStep(forest, text, document, values, value_top, item, ops, at);
        } else {
            return Body.Failed(Diagnose(forest, item.node, document, format_text("unsupported syntax '{}'", kind)));
        }
        // Apply the step, then the copy it or the control flow asks for.
        pass: int = 0;
        while (pass < 2) {
            if (pass == 1) {
                stepped = retain.storage != 0;
                if (stepped) {
                    at = {pc: length(code), slot: length(slots), local: length(locals), cell: length(cells),
                        host: length(hosts), call: length(calls)};
                    step = RetainStep(retain, ops, target, at, node);
                }
            }
            if (stepped) {
                switch step {
                    case .Failed(diagnostic): return Body.Failed(diagnostic);
                    case .Emitted(added_code, added_slots, added_locals, added_cells, added_hosts, added_roots,
                                  added_calls, added_names, scheduled, popped, value, kept, marks):
                        code = append(code, added_code);
                        slots = append(slots, added_slots);
                        locals = append(locals, added_locals);
                        cells = append(cells, added_cells);
                        hosts = append(hosts, added_hosts);
                        roots = append(roots, added_roots);
                        calls = append(calls, added_calls);
                        names = append(names, added_names);
                        next = append(next, scheduled);
                        value_top -= popped;
                        if (value.storage != 0) { produced = value; }
                        if (pass == 0) { retain = kept; }
                        if (length(marks) == 1) {
                            // A switch arm's test: the jump past the arm.
                            current := switches[length(switches) - 1];
                            current.skip = marks[0];
                            switches[length(switches) - 1] = current;
                        }
                        if (length(marks) == 3) {
                            // A foreach head: its loop, then its element's binding.
                            loop: Loop = {head: marks[0], first_break: length(breaks), first_continue: length(continues),
                                each: true, index: marks[2], mark: length(names), leave: marks[1]};
                            loops = array_add(loops, loop);
                            element := produced;
                            produced = NoValue();
                            if (element.storage == StructStorage) {
                                retain = element;
                                next = array_add(next, Resume(item.node, 3, 0, 0));
                            } else {
                                locals = array_add(locals, element.storage);
                                code = array_add(code, Instruction(ops.save, element.storage, 0, element.slot, 0,
                                    length(locals) - 1, node));
                                binding: Name = {name: NameText(forest, text, Field(forest, item.node, "name")),
                                    place: LocalPlace, index: length(locals) - 1, storage: element.storage,
                                    container: 0, record: element.record, writable: true};
                                names = array_add(names, binding);
                                next = array_add(next, Visit(Field(forest, item.node, "body")));
                                next = array_add(next, Resume(item.node, 4, 0, 0));
                            }
                        }
                }
            }
            pass += 1;
        }
        if (produced.storage != 0) {
            if (value_top < length(values)) { values[value_top] = produced; } else { values = array_add(values, produced); }
            value_top += 1;
        }
        // Run scheduled items in order: the last pushed runs first.
        at_next := length(next) - 1;
        while (at_next >= 0) {
            if (work_top < length(work)) { work[work_top] = next[at_next]; } else { work = array_add(work, next[at_next]); }
            work_top += 1;
            at_next -= 1;
        }
    }
    code = array_add(code, Instruction(ops.end, 0, 0, 0, 0, 0, declaration));
    return Body.Emitted(slots, locals, cells, code, calls, hosts, roots);
}
