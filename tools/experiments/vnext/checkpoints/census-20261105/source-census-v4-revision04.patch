+        "package p\nBad :: (x: BorrowedBytes) -> i64 { return byte_read_checked(x, true); }\n",
+        "package p\nBad :: (x: BorrowedBytes) -> i64 { return byte_length(x, 0); }\n",
+        "package p\nBad :: (x: BorrowedBytes) -> i64 { return byte_read_checked(x); }\n",
+        "package p\nBad :: (x: BorrowedBytes) -> i64 { byte_length: i64 = 0; return byte_length(x); }\n",
+        "package p\nBad :: () -> i64 { return BorrowedBytes(); }\n",
+        "package p\nBad :: (x: BorrowedBytes) -> i64 { return i64(x); }\n"
+    ]) { Rejected(text); }
+    changed := module;
+    instructions := changed.instructions;
+    row := instructions[0];
+    assert(row.op == typed.ByteReadChecked, "first helper instruction is checked read");
+    row.left = 2;
+    instructions[0] = row;
+    changed.instructions = instructions;
+    assert(typed.Verify(changed) == typed.InvalidType, "checked read rejects scalar in its borrowed slot");
+    changed = module;
+    signatures := changed.signatures;
+    signature := signatures[0];
+    signature.result_type = typed.BorrowedBytes;
+    signatures[0] = signature;
+    changed.signatures = signatures;
+    assert(typed.Verify(changed) == typed.InvalidType, "borrowed returns rejected even in mutated IR");
+    subtract := Accepted("package p\nSub :: (a: i64, b: i64) -> i64 { return a - b; }\nLiteral :: () -> i64 { return 0 - 9223372036854775807 - 2; }\n");
+    row = subtract.instructions[0];
+    assert(row.op == typed.SubI64 && row.left == 1 && row.right == 2, "subtraction preserves operand order");
+    subs: int = 0;
+    for (instruction in subtract.instructions) { if (instruction.op == typed.SubI64) { subs += 1; } }
+    assert(subs == 3, "literal subtraction remains explicit wrapping operations");
+}
