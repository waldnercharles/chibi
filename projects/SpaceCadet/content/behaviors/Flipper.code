behavior "Flipper" {
    owner "ecs.entity";
    state restAngle: float = 0.0;
    state restPosition: struct<"CF_V2"> = null;
    state stroke: float = 0.0;
    action spin_clamp_restangle_sign_cos_restangle_stroke_a = behavior_expression<"spin = clamp((restAngle - sign(cos(restAngle)) * stroke - angle) / max(dt, 0.001), -24, 24)">(spin: float = &component("GAME.GameBody", "angular_velocity"), restAngle: double = &state.restAngle, stroke: double = &state.stroke, angle: double = &component("GAME.GameOrientation", "radians"), dt: double = &delta);
    on Begin as begin() {
        await set_variable<"restAngle">(Value: float = &component("GAME.GameOrientation", "radians"));
        set_variable<"restPosition">(Value: struct<"CF_V2"> = &component("GAME.GameTransform"));
    }
    on Tick as tick(DeltaSeconds: float = 0.0) {
        if (&component("GAME.GameActionBinding", "pressed")) {
            await set_variable<"stroke">(Value: float = 0.92);
            spin_clamp_restangle_sign_cos_restangle_stroke_a();
        } else {
            await set_variable<"stroke">(Value: float = 0.0);
            spin_clamp_restangle_sign_cos_restangle_stroke_a();
        }
    }
    after spin_clamp_restangle_sign_cos_restangle_stroke_a {
        &component("GAME.GameVelocity") = (&state.restPosition + 38 * (direction(cast<double>(&component("GAME.GameOrientation", "radians")) + cast<double>(&component("GAME.GameBody", "angular_velocity")) * cast<double>(&delta)) - direction(cast<double>(&state.restAngle))) - &component("GAME.GameTransform")) / max(cast<double>(&delta), 0.001);
    }
}
