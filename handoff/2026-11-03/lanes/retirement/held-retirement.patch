-chibi_build_compiler *chibi_build_compiler_load(
-    const char *sources,
-    const char *core,
-    const char *cache,
-    char *error,
-    size_t size
-)
-{
-    if (!sources || !*sources || !core || !*core) {
-        snprintf(error, size, "compiler sources and core collection are required");
-        return NULL;
-    }
-    char *folder = join(sources, "bootstrap");
