-    if (!storage->collectable || source->storage != storage || source->pointer) {
-        pin_value input = { .type = source->element_type,
-                            .container = source->pointer ? PIN_CONTAINER_VIEW
-                                                         : PIN_CONTAINER_ARRAY,
-                            .type_name = source->type_name,
-                            .record = source->record,
