        return ["src/authoring/asset_compiler_host.c", "src/authoring/package_compile.c",
                "src/support/binary_cache.c", "build/sdk/generated/assets/asset_compiler_packaged.c"];
    }
    if (target == "chibi_asset_compiler_consumer") {
        return ["test/language/asset_compiler_host.c"];
    }
    if (target == "reflect") {
        return [
            "tools/reflect/reflect.c", "tools/reflect/collect.c", "tools/reflect/identity.c", "tools/reflect/emit.c",
            "tools/reflect/emit_function.c", "tools/reflect/emit_component.c", "tools/reflect/emit_catalog.c"
        ];
    }
    if (target == "chibi_support") {
        return [
            "src/support/arena.c", "src/support/file_io.c", "src/support/xalloc.c"
        ];
    }
    if (target == "chibi_types") {
        return [
            "src/types/type.c", "src/types/schema.c", "src/types/catalog.c", "src/types/array.c", "src/types/text.c", "src/types/map.c",
            "src/types/record.c", "src/types/trace.c", "src/types/union.c",
