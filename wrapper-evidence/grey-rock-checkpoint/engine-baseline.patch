+{
+    int left, right, far;
+    uint64_t near_hash, far_hash;
+} terrain_evidence;
+
+static void cleanup()
+{
+    if (runtime) {
+        player_free(runtime);
+    }
+    runtime = NULL;
+    authoring_project_artifact_free(&artifact);
+    if (palette_installed) {
+        registry_set_packs(previous_packs, acount(previous_packs));
+    }
+    palette_installed = false;
+    afree(previous_packs);
+    previous_packs = NULL;
+    authoring_graph_catalog_free(palette);
+    palette = NULL;
+    native_capabilities_free(native);
+    native = NULL;
+    if (*scratch) {
+        tool_remove_tree(scratch);
+        *scratch = '\0';
+    }
+}
+
+/* The CPU host retains no graphics handles. UI state is a headless world
+ * service, so authored storage status still runs without an RML presenter. */
+static void *stage_cpu_resources(void *, const player_asset *assets, int count, size_t *, char *error, size_t size)
+{
+    for (int i = 0; i < count; i++) {
+        if (assets[i].kind != PLAYER_ASSET_SHADER_VALUES &&
+            assets[i].kind != PLAYER_ASSET_PARTS && assets[i].kind != PLAYER_ASSET_UI &&
+            assets[i].kind != PLAYER_ASSET_FONT) {
+            snprintf(
+                error,
+                size,
+                "CPU terrain playable has unsupported resource kind %d",
+                assets[i].kind
+            );
+            return NULL;
+        }
+    }
+    cpu_resources = count;
+    return &cpu_resources;
+}
+static bool cpu_scene(void *, void *, const scene *, char *, size_t)
+{
+    return true;
+}
+static void commit_cpu_resources(void *, void *, world *) {}
+static void release_cpu_resources(void *, void *) {}
+
+static bool prepare()
+{
+    char error[512] = { 0 };
+    REQUIRE(behavior_backend_available(backend));
+    native = host_native_default_catalog_new(NULL, 0, NULL, 0, error, sizeof error);
+    if (!native) {
+        fprintf(stderr, "terrain native catalog: %s\n", error);
+    }
+    REQUIRE(native);
+    palette = authoring_graph_catalog_new(
+        (authoring_graph_catalog_config){
+            .native = native,
+            .types = TYPE_PACK,
+            .components = { REGISTRY_COMPONENTS, REGISTRY_COMPONENT_COUNT },
+        },
+        error,
+        sizeof error
+    );
+    if (!palette) {
+        fprintf(stderr, "terrain graph catalog: %s\n", error);
+    }
+    REQUIRE(palette);
+    for (int i = 0; i < registry_pack_count(); i++) {
+        apush(previous_packs, registry_pack_at(i));
+    }
+    int pack_count;
+    const registry_pack *const *packs = authoring_graph_catalog_packs(palette, &pack_count);
+    registry_set_packs(packs, pack_count);
+    palette_installed = true;
+    authoring_project_options options = {
+        .project = project,
+        .native = native,
+        .components = { REGISTRY_COMPONENTS, REGISTRY_COMPONENT_COUNT },
+        .modules = WORLD_PHYSICS | WORLD_MATERIALS | WORLD_INPUT | WORLD_UI,
+    };
+    bool prepared = authoring_project_prepare(&options, &artifact, error, sizeof error);
+    if (!prepared) {
+        fprintf(stderr, "terrain preparation: %s\n", error);
+    }
+    REQUIRE(prepared);
+    native_prepared_context context = { .native = native };
+    execution_prepared_linker linker = native_capabilities_prepared_linker(&context);
+    player_host host = {
+        .components = { REGISTRY_COMPONENTS, REGISTRY_COMPONENT_COUNT },
+        .linker = &linker,
+        .resources = { .stage = stage_cpu_resources,
+                       .scene = cpu_scene,
+                       .commit = commit_cpu_resources,
+                       .discard = release_cpu_resources,
+                       .retire = release_cpu_resources },
+    };
+    runtime = player_prepared_read(artifact.data, artifact.size, &host, backend, error, sizeof error);
+    if (!runtime) {
+        fprintf(stderr, "terrain player: %s\n", error);
+    }
+    REQUIRE(runtime);
+    world *world = player_world(runtime);
+    char path[4096];
+    int n = snprintf(path, sizeof path, "%s/terrain-save.json", directory);
+    REQUIRE(n > 0 && n < (int)sizeof path);
+    REQUIRE(save_open(world_modules(world)->save, path));
+    REQUIRE(!materials_prepare(world_materials(world)));
+    REQUIRE(physics_tick(world_modules(world)->physics, 0) == 0);
+    engine *engine = world_engine(world);
+    REQUIRE(engine_set_focus(engine, ENGINE_FOCUS_VIEWPORT) == 0);
+    REQUIRE(engine_set_playing(engine, true) == 0);
+    REQUIRE(engine_frame(engine, 0) == 0);
+    steps = 0;
+    return true;
+}
+
+static ecs_entity explorer()
+{
+    const scene_instance *instance = player_scene(runtime);
+    const scene *scene = scene_instance_scene(instance);
+    for (int i = 0; i < scene_object_count(scene); i++) {
+        if (!strcmp(scene_object_name(scene, i), "Explorer")) {
+            return scene_instance_entity(instance, i);
+        }
+    }
+    return (ecs_entity){ 0 };
+}
+
+static bool step(uint64_t controls, float horizontal)
+{
+    engine *engine = world_engine(player_world(runtime));
+    bool firing;
+    REQUIRE(engine_sample_movement(engine, horizontal, 0) == 0);
+    REQUIRE(engine_sample_controls(engine, controls, &firing) == 0);
+    int result = engine_frame(engine, (++steps + .5) * ENGINE_FIXED_SECONDS);
+    if (result) {
+        fprintf(stderr, "terrain step: %s\n", engine_error(engine));
+    }
+    REQUIRE(result == 0);
+    REQUIRE(engine_last_timing(engine)->simulation_steps == (uint64_t)steps);
+    execution_program *program = source_program(world_sources(player_world(runtime)), "Explorer");
+    REQUIRE(program);
+    REQUIRE(execution_module_backend(execution_program_module(program)) == backend);
+    const execution_program_failure *failure = execution_program_error(program);
+    if (failure) {
+        fprintf(stderr, "terrain Explorer: %s\n", failure->message);
+    }
+    REQUIRE(!failure);
+    return true;
+}
+
+static terrain_mask *masks()
+{
+    world *world = player_world(runtime);
+    ecs_world *ecs = world_ecs(world);
+    ecs_component_id ids[] = { COMPONENT_Destructible.id, COMPONENT_Transform.id };
+    ecs_query query;
+    int status = ecs_query_begin(ecs, &query, ids, 2);
+    assert(status == ECS_OK);
+    terrain_mask *records = NULL;
+    ecs_entity entity;
+    while (ecs_query_next(&query, &entity)) {
+        const material_mask *mask = materials_mask(world_materials(world), entity);
+        if (mask && !materials_is_fragment(world_materials(world), entity)) {
+            apush(records, ((terrain_mask){ mask, *Transform_get_const(ecs, entity), entity }));
+        }
+    }
+    ecs_query_end(&query);
+    return records;
+}
+
+static ecs_entity occupied(const terrain_mask *records, float x, float y)
+{
+    for (int i = 0; i < acount(records); i++) {
+        if (material_mask_contains(
+                records[i].mask,
+                x - records[i].pose.x,
+                y - records[i].pose.y
+            )) {
+            return records[i].entity;
+        }
+    }
+    return (ecs_entity){ 0 };
+}
+
+/* Sample cell centers in fixed spatial order. These hashes do not depend on
+ * transient ECS handles, allocation order, fragments or player state. */
+static terrain_evidence evidence()
+{
+    terrain_mask *records = masks();
+    terrain_evidence out = {
+        .near_hash = UINT64_C(14695981039346656037),
+        .far_hash = UINT64_C(14695981039346656037),
+    };
+    for (int y = 0; y < 64; y++) {
+        for (int x = 0; x < 64; x++) {
+            bool solid = occupied(records, x - 31.5f, 47.5f - y).slot != 0;
+            if (x < 32) {
+                out.left += solid;
+            } else {
+                out.right += solid;
+            }
+            out.near_hash = (out.near_hash ^ solid) * UINT64_C(1099511628211);
+        }
+    }
+    for (int y = 0; y < 32; y++) {
+        for (int x = 0; x < 32; x++) {
+            bool solid = occupied(records, x + 240.5f, 47.5f - y).slot != 0;
+            out.far += solid;
+            out.far_hash = (out.far_hash ^ solid) * UINT64_C(1099511628211);
+        }
+    }
+    afree(records);
+    return out;
+}
+
+static bool ray(float x, bool expected)
+{
+    world *world = player_world(runtime);
+    ray_hit hit;
+    REQUIRE(
+        physics_raycast(
+            world_ecs(world),
+            world_entities(world),
+            (CF_V2){ x, 20 },
+            (CF_V2){ x, 4 },
+            8,
+            (ecs_entity){ 0 },
+            false,
+            &hit
+        ) == 0
+    );
+    REQUIRE(hit.found == expected);
+    if (expected) {
+        physics_body_state body;
+        REQUIRE(physics_inspect_body(world_modules(world)->physics, hit.entity, &body));
+        REQUIRE(body.shape_count > 0);
+    }
+    return true;
+}
+
+static bool pristine(terrain_evidence *out)
+{
+    terrain_mask *records = masks();
+    ecs_entity left = occupied(records, -.5f, 12), right = occupied(records, .5f, 12);
+    afree(records);
+    REQUIRE(left.slot && right.slot);
+    REQUIRE(ecs_entity_to_u64(left) != ecs_entity_to_u64(right));
+    REQUIRE(ray(-1, true));
+    REQUIRE(ray(1, true));
+    REQUIRE(ray(256, true));
+    *out = evidence();
+    REQUIRE(out->left > 0 && out->right > 0 && out->far == 1024);
+    return true;
+}
+
+static bool status(const char *expected)
+{
+    ui *ui = world_modules(player_world(runtime))->ui;
+    for (int i = 0; i < ui_element_count(ui); i++) {
+        ui_element *element = ui_element_at(ui, i);
+        if (!strcmp(element->selector, "#status") && element->text &&
+            strstr(element->text, expected)) {
+            return true;
+        }
+    }
+    REQUIRE(false);
+    return false;
+}
+
+static bool completed()
+{
+    terrain_storage_state state = terrain_storage_result(
+        world_modules(player_world(runtime))->terrain_storage,
+        1
+    );
+    if (!state.succeeded) {
+        fprintf(stderr, "terrain storage: %s\n", state.error ? state.error : "pending");
+    }
+    REQUIRE(!state.pending && state.succeeded);
+    return true;
+}
+
+TEST_CASE(terrain_child_uses_authored_controls)
+{
+    REQUIRE(prepare());
+    terrain_evidence base;
+    REQUIRE(pristine(&base));
+    char path[4096];
+    int n = snprintf(path, sizeof path, "%s/evidence.txt", directory);
+    REQUIRE(n > 0 && n < (int)sizeof path);
+    if (!strcmp(phase, "write")) {
+        ecs_world *ecs = world_ecs(player_world(runtime));
+        ecs_entity actor = explorer();
+        REQUIRE(actor.slot);
+        Transform start = *Transform_get_const(ecs, actor);
+        REQUIRE(step(UINT64_C(1) << CONTROL_D, 1));
+        REQUIRE(Transform_get_const(ecs, actor)->x > start.x + 1);
+        float grounded = Transform_get_const(ecs, actor)->y;
+        REQUIRE(step(UINT64_C(1) << CONTROL_SPACE, 0));
+        REQUIRE(Transform_get_const(ecs, actor)->y < grounded - 1);
+        REQUIRE(Velocity_get_const(ecs, actor)->y < -100);
+        REQUIRE(step(UINT64_C(1) << CONTROL_F, 0));
+        REQUIRE(ray(-1, false));
+        REQUIRE(ray(1, false));
+        REQUIRE(ray(256, true));
+        terrain_evidence cut = evidence();
+        REQUIRE(cut.left < base.left && cut.right < base.right);
+        REQUIRE(cut.near_hash != base.near_hash);
+        REQUIRE(cut.far == base.far && cut.far_hash == base.far_hash);
+        REQUIRE(step(UINT64_C(1) << CONTROL_S, 0));
+        REQUIRE(completed());
+        REQUIRE(step(0, 0));
+        REQUIRE(status("Terrain saved."));
+        char text[512];
+        snprintf(
+            text,
+            sizeof text,
+            "%d %d %d %" PRIu64 " %" PRIu64 "\n%d %d %d %" PRIu64 " %" PRIu64 "\n",
+            base.left,
+            base.right,
+            base.far,
+            base.near_hash,
+            base.far_hash,
+            cut.left,
+            cut.right,
+            cut.far,
+            cut.near_hash,
+            cut.far_hash
+        );
+        tool_write(path, text);
+        fprintf(
+            stderr,
+            "%s wrote seam cells %d/%d -> %d/%d; far patch %d unchanged\n",
+            behavior_backend_name(backend),
+            base.left,
+            base.right,
+            cut.left,
+            cut.right,
+            cut.far
+        );
+        return true;
+    }
+    REQUIRE(!strcmp(phase, "read"));
+    char *text = tool_read(path);
+    REQUIRE(text);
+    terrain_evidence before, saved;
+    int fields = sscanf(
+        text,
+        "%d %d %d %" SCNu64 " %" SCNu64 "\n%d %d %d %" SCNu64 " %" SCNu64,
+        &before.left,
+        &before.right,
+        &before.far,
+        &before.near_hash,
+        &before.far_hash,
+        &saved.left,
+        &saved.right,
+        &saved.far,
+        &saved.near_hash,
+        &saved.far_hash
+    );
+    free(text);
+    REQUIRE(fields == 10);
+    REQUIRE(
+        base.left == before.left && base.right == before.right &&
+        base.far == before.far
+    );
+    REQUIRE(base.near_hash == before.near_hash && base.far_hash == before.far_hash);
+    REQUIRE(base.near_hash != saved.near_hash);
+    REQUIRE(step(UINT64_C(1) << CONTROL_L, 0));
+    REQUIRE(completed());
+    /* PollStorage observes the completed request and the next ordinary physics
+     * boundary refreshes shapes before these collision queries. */
+    REQUIRE(step(0, 0));
+    REQUIRE(status("Saved excavation loaded."));
+    terrain_evidence loaded = evidence();
+    REQUIRE(
+        loaded.left == saved.left && loaded.right == saved.right &&
+        loaded.far == saved.far
+    );
+    REQUIRE(loaded.near_hash == saved.near_hash && loaded.far_hash == saved.far_hash);
+    REQUIRE(ray(-1, false));
+    REQUIRE(ray(1, false));
+    REQUIRE(ray(256, true));
+    fprintf(
+        stderr,
+        "%s fresh process regenerated pristine cells, then restored seam edit "
+        "and unchanged reference patch\n",
+        behavior_backend_name(backend)
+    );
+    return true;
+}
+
+int test_terrain_playable_child(
+    const char *project_path,
+    const char *save_directory,
+    const char *backend_name,
+    const char *child_phase
+)
+{
+    project = project_path;
+    directory = save_directory;
+    phase = child_phase;
+    if (!strcmp(backend_name, "vm")) {
+        backend = BEHAVIOR_BYTECODE;
+    } else if (!strcmp(backend_name, "sljit")) {
+        backend = BEHAVIOR_SLJIT;
+    } else {
+        return 2;
+    }
+    pu_setup(NULL, cleanup);
+    RUN_TEST_CASE(terrain_child_uses_authored_controls);
+    pu_clear_setup();
+    return pu_test_failed() ? 1 : 0;
+}
+
+static bool restarted(const char *backend_name)
+{
+    snprintf(scratch, sizeof scratch, "/tmp/chibi-terrain-playable-XXXXXX");
+    REQUIRE(mkdtemp(scratch));
+    char log[128];
+    const char *phases[] = { "write", "read" };
+    for (int i = 0; i < 2; i++) {
+        snprintf(log, sizeof log, "%s/%s.log", scratch, phases[i]);
+        const char *args[] = { binary,       "--terrain-playable-child",
+                               project,      scratch,
+                               backend_name, phases[i],
+                               NULL };
+        REQUIRE(tool_run(args, tool_root(), log) == 0);
+        char *output = tool_read(log);
+        REQUIRE(output);
+        fputs(output, stdout);
+        free(output);
+    }
+    return true;
+}
+TEST_CASE(terrain_playable_vm_survives_process_restart)
+{
+    return restarted("vm");
+}
+TEST_CASE(terrain_playable_sljit_survives_process_restart)
+{
+    return restarted("sljit");
+}
+void test_terrain_playable(const char *program, const char *project_path)
+{
+    binary = program;
+    project = project_path;
+    pu_setup(NULL, cleanup);
+    RUN_TEST_CASE(terrain_playable_vm_survives_process_restart);
+    RUN_TEST_CASE(terrain_playable_sljit_survives_process_restart);
+    pu_clear_setup();
+}
diff --git a/test/tools/terrain_playable_render.c b/test/tools/terrain_playable_render.c
new file mode 100644
index 000000000..65147d870
--- /dev/null
+++ b/test/tools/terrain_playable_render.c
@@ -0,0 +1,182 @@
+#include "platform/cute.h"
+#include "test/tools/fixture.h"
+#include "third_party/pico_headers/pico_unit.h"
+
+#include <assert.h>
+#include <errno.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+enum
+{
+    WIDTH = 640,
+    HEIGHT = 360,
+    PIXELS = WIDTH * HEIGHT,
+    PATH_SIZE = 4096
+};
+static const char *player, *artifact, *resources, *shaders, *output;
+static char directory[PATH_SIZE], capture[PATH_SIZE], log_path[PATH_SIZE];
+static char save_namespace[PATH_SIZE], save_path[PATH_SIZE];
+static bool owns_save_namespace;
+static char *log_text, *png;
+static CF_Image image;
+
+static void path(char *out, const char *name)
+{
+    int size = snprintf(out, PATH_SIZE, "%s/%s", directory, name);
+    assert(size > 0 && size < PATH_SIZE);
+}
+static void cleanup()
+{
+    if (pu_test_failed() && log_text) {
+        fputs(log_text, stderr);
+    }
+    free(log_text);
+    free(png);
+    cf_image_free(&image);
+    log_text = png = NULL;
+    image = (CF_Image){ 0 };
+    if (owns_save_namespace) {
+        tool_remove_tree(save_namespace);
+        owns_save_namespace = false;
+    }
+}
+
+TEST_CASE(installed_terrain_lab_renders_a_bounded_playable_frame)
+{
+    struct stat info;
+    REQUIRE(!stat(player, &info) && S_ISREG(info.st_mode));
+    REQUIRE(
+        !stat(artifact, &info) && S_ISREG(info.st_mode) && info.st_size > 0 &&
+        info.st_size <= 64 * 1024 * 1024
+    );
+    REQUIRE(!stat(resources, &info) && S_ISDIR(info.st_mode));
+    REQUIRE(!stat(shaders, &info) && S_ISDIR(info.st_mode));
+    REQUIRE(!mkdir(output, 0700) || errno == EEXIST);
+    REQUIRE(realpath(output, directory));
+    path(capture, "frame.png");
+    path(log_path, "player.log");
+    REQUIRE(!unlink(capture) || errno == ENOENT);
+    int namespace_size = snprintf(save_namespace, sizeof save_namespace, "%s/save-XXXXXX", directory);
+    REQUIRE(namespace_size > 0 && namespace_size < (int)sizeof save_namespace);
+    REQUIRE(mkdtemp(save_namespace));
+    owns_save_namespace = true;
+    int save_size = snprintf(save_path, sizeof save_path, "%s/state.json", save_namespace);
+    REQUIRE(save_size > 0 && save_size < (int)sizeof save_path);
+    const char *args[] = { player,
+                           artifact,
+                           "--resource-root",
+                           resources,
+                           "--shader-dir",
+                           shaders,
+                           "--backend",
+                           "vm",
+                           "--save",
+                           save_path,
+                           "--hidden",
+                           "--frames",
+                           "4",
+                           "--fixed-dt",
+                           "0.016666666666666666",
+                           "--size",
+                           "640x360",
+                           "--capture",
+                           capture,
+                           NULL };
+    REQUIRE(tool_run_within(args, directory, log_path, 25) == 0);
+    log_text = tool_read(log_path);
+    REQUIRE(log_text);
+    REQUIRE(strstr(log_text, "frames=4 steps=3"));
+    const char *backend = strstr(log_text, "capture backend=");
+    REQUIRE(backend && strstr(backend, "size=640x360 hidden=true"));
+    REQUIRE(!strstr(log_text, "Final frame capture failed"));
+    REQUIRE(
+        !stat(capture, &info) && S_ISREG(info.st_mode) && info.st_size > 0 &&
+        info.st_size < 2 * 1024 * 1024
+    );
+    png = tool_read(capture);
+    REQUIRE(png);
+    REQUIRE(!cf_is_error(cf_image_load_png_from_memory(png, (int)info.st_size, &image)));
+    REQUIRE(image.w == WIDTH && image.h == HEIGHT);
+    int opaque = 0, brown = 0, cool = 0, mint = 0, different = 0;
+    CF_Pixel corner = image.pix[0];
+    uint64_t hash = UINT64_C(14695981039346656037);
+    for (int y = 0; y < HEIGHT; y++) {
+        for (int x = 0; x < WIDTH; x++) {
+            CF_Pixel pixel = image.pix[y * WIDTH + x];
+            opaque += pixel.a == 255;
+            different += abs((int)pixel.r - corner.r) +
+                             abs((int)pixel.g - corner.g) +
+                             abs((int)pixel.b - corner.b) >
+                         30;
+            /* Loose authored landmarks: warm quarry below, cool backdrop
+             * above, mint explorer/marker near the playable center. */
+            brown += y >= HEIGHT / 2 && pixel.r > pixel.g + 15 &&
+                     pixel.g > pixel.b + 15;
+            cool += y < HEIGHT / 2 && pixel.b > pixel.r + 10;
+            mint += x >= 200 && x < 440 && y >= 100 && y < 280 &&
+                    pixel.g > pixel.r + 40 && pixel.b > pixel.r + 30;
+            const unsigned char rgba[] = { pixel.r, pixel.g, pixel.b, pixel.a };
+            for (int c = 0; c < 4; c++) {
+                hash = (hash ^ rgba[c]) * UINT64_C(1099511628211);
+            }
+        }
+    }
+    char summary[4096];
+    size_t backend_size = strcspn(backend, "\n");
+    if (backend_size > 255) {
+        backend_size = 255;
+    }
+    int length = snprintf(
+        summary,
+        sizeof summary,
+        "project=terrain-lab\nplayer=%s\nartifact=%s\nframes=4\nsize=640x360\n%"
+        ".*s\n"
+        "opaque_pixels=%d\nnonbackground_pixels=%d\nwarm_terrain_pixels=%"
+        "d\ncool_sky_pixels=%d\n"
+        "mint_center_pixels=%d\npixel_hash_algorithm=fnv1a64-rgba8\npixel_hash="
+        "%016" PRIx64 "\n",
+        player,
+        artifact,
+        (int)backend_size,
+        backend,
+        opaque,
+        different,
+        brown,
+        cool,
+        mint,
+        hash
+    );
+    REQUIRE(length > 0 && length < (int)sizeof summary);
+    char evidence[PATH_SIZE];
+    path(evidence, "result.txt");
+    tool_write(evidence, summary);
+    fputs(summary, stdout);
+    REQUIRE(opaque == PIXELS);
+    REQUIRE(different > 1000);
+    REQUIRE(brown > 1000);
+    REQUIRE(cool > 1000);
+    REQUIRE(mint > 10);
+    return true;
+}
+void test_terrain_playable_render(
+    const char *player_path,
+    const char *artifact_path,
+    const char *resource_root,
+    const char *shader_dir,
+    const char *evidence_output
+)
+{
+    player = player_path;
+    artifact = artifact_path;
+    resources = resource_root;
+    shaders = shader_dir;
+    output = evidence_output;
+    pu_setup(NULL, cleanup);
+    RUN_TEST_CASE(installed_terrain_lab_renders_a_bounded_playable_frame);
+    pu_clear_setup();
+}
diff --git a/test/tools/terrain_seams.c b/test/tools/terrain_seams.c
new file mode 100644
index 000000000..28139a8cf
--- /dev/null
+++ b/test/tools/terrain_seams.c
@@ -0,0 +1,208 @@
+#include "runtime/material_terrain.h"
+#include "support/array.h"
+#include "third_party/pico_headers/pico_unit.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static material_mask full, coarse;
+static material_terrain_chunk *chunks;
+static material_mask halves[2];
+static void setup() {}
+static void teardown()
+{
+    material_mask_free(&full);
+    material_mask_free(&coarse);
+    material_terrain_chunks_free(chunks);
+    chunks = NULL;
+    for (int i = 0; i < 2; i++) {
+        material_mask_free(&halves[i]);
+    }
+}
+static bool covered(const material_mask *mask, float x, float y)
+{
+    material_surface_view surface = material_mask_surface(mask);
+    for (int i = 0; i < surface.count; i++) {
+        const material_polygon *p = &surface.polygons[i];
+        bool inside = false;
+        for (int a = 0, b = p->count - 1; a < p->count; b = a++) {
+            float ax = p->points[2 * a], ay = p->points[2 * a + 1];
+            float bx = p->points[2 * b], by = p->points[2 * b + 1];
+            if ((ay > y) != (by > y) && x < (bx - ax) * (y - ay) / (by - ay) + ax) {
+                inside = !inside;
+            }
+        }
+        if (inside) {
+            return true;
+        }
+    }
+    return false;
+}
+static bool split_covered(float x, float y)
+{
+    for (int i = 0; i < acount(chunks); i++) {
+        if (covered(&chunks[i].mask, x - chunks[i].x, y - chunks[i].y)) {
+            return true;
+        }
+    }
+    return false;
+}
+static bool collision_cover(const material_mask *mask)
+{
+    material_collision_view collision = material_mask_collision(mask);
+    int occupied = 0;
+    for (int y = 0; y < mask->height; y++) {
+        for (int x = 0; x < mask->width; x++) {
+            float px = (x + .5f - mask->width * .5f) * mask->cell_size;
+            float py = (y + .5f - mask->height * .5f) * mask->cell_size;
+            int hits = 0;
+            for (int i = 0; i < collision.count; i++) {
+                material_rect r = collision.rects[i];
+                hits += fabsf(px - r.x) < r.width * .5f &&
+                        fabsf(py - r.y) < r.height * .5f;
+            }
+            if (hits != mask->cells[y * mask->width + x]) {
+                return false;
+            }
+            if (material_mask_contains(mask, px, py) != (hits == 1)) {
+                return false;
+            }
+            occupied += hits;
+        }
+    }
+    return occupied == mask->count;
+}
+static void generate(bool diagonal)
+{
+    float field[130 * 4];
+    for (int y = 0; y < 4; y++) {
+        for (int x = 0; x < 130; x++) {
+            float wx = -165 + x + .5f, wy = -2 + y + .5f;
+            field[y * 130 + x] = wx + 37 + .125f + (diagonal ? wy : 0);
+        }
+    }
+    full = material_mask_from_field(130, 4, 1, field);
+    chunks = material_terrain_chunks(field, (field_grid){ 130, 4, 1, -100, 0 });
+}
+static void synchronize()
+{
+    material_terrain_view views[2];
+    for (int i = 0; i < 2; i++) {
+        views[i] = (material_terrain_view){ &chunks[i].mask,
+                                            chunks[i].x,
+                                            chunks[i].y };
+    }
+    material_terrain_sync_views(views, 2, 32, 1);
+}
+TEST_CASE(diagonal_and_cross_seam_cut_match_continuous_mask)
+{
+    generate(true);
+    REQUIRE(acount(chunks) == 2 && chunks[0].mask.width == 128 && chunks[1].mask.width == 2);
+    // Below-hardness damage preserves signed geometry until a hit breaks cells.
+    float before[130 * 4];
+    memcpy(before, full.distance, sizeof before);
+    unsigned unchanged = full.revision;
+    REQUIRE(material_mask_apply_damage(&full, 63, 0, 1.4f, .25f, 1) == 0);
+    REQUIRE(!memcmp(before, full.distance, sizeof before) && full.revision == unchanged);
+    // The old independently clamped edge contours disagree at this solid point.
+    REQUIRE(covered(&full, 63.01f, -.375f));
+    synchronize();
+    for (int pass = 0; pass < 2; pass++) {
+        if (pass) {
+            int removed = material_mask_carve(&full, 63, 0, 1.4f);
+            int split_removed = 0;
+            for (int i = 0; i < 2; i++) {
+                split_removed += material_mask_carve(
+                    &chunks[i].mask,
+                    -37 - chunks[i].x,
+                    -chunks[i].y,
+                    1.4f
+                );
+            }
+            REQUIRE(removed > 0 && split_removed == removed);
+            synchronize();
+        }
+        for (int i = 0; i < 2; i++) {
+            REQUIRE(collision_cover(&chunks[i].mask));
+        }
+        for (int y = 0; y < 31; y++) {
+            for (int side = 0; side < 2; side++) {
+                float wx = -37 + (side ? .013f : -.013f), wy = -1.97f + y * .127f;
+                bool split = split_covered(wx, wy),
+                     continuous = covered(&full, wx + 100, wy);
+                if (split != continuous) {
+                    fprintf(stderr, "terrain seam pass=%d x=%.9g y=%.9g split=%d continuous=%d\n", pass, wx, wy, split, continuous);
+                }
+                REQUIRE(split == continuous);
+            }
+        }
+        unsigned revision = chunks[0].mask.revision;
+        synchronize();
+        REQUIRE(chunks[0].mask.revision == revision);
+    }
+    REQUIRE(!split_covered(-37.013f, .013f));
+    return true;
+}
+TEST_CASE(reduced_halos_preserve_partial_chunk_contours)
+{
+    generate(true);
+    synchronize();
+    coarse = material_mask_reduce(&full);
+    for (int i = 0; i < 2; i++) {
+        halves[i] = material_mask_reduce(&chunks[i].mask);
+        REQUIRE(halves[i].halo_radius == 16 && halves[i].lod_limit == 0);
+        REQUIRE(collision_cover(&halves[i]));
+    }
+    for (int y = 0; y < 15; y++) {
+        for (int side = 0; side < 2; side++) {
+            float wx = -37 + (side ? .013f : -.013f), wy = -1.91f + y * .263f;
+            bool split = false;
+            for (int i = 0; i < 2; i++) {
+                split |= covered(&halves[i], wx - chunks[i].x, wy - chunks[i].y);
+            }
+            REQUIRE(split == covered(&coarse, wx + 100, wy));
+        }
+    }
+    return true;
+}
+TEST_CASE(known_empty_neighbor_is_not_missing_or_solid)
+{
+    generate(false);
+    REQUIRE(acount(chunks) == 2 && chunks[1].mask.count == 0);
+    synchronize();
+    bool occupied;
+    float distance;
+    REQUIRE(material_mask_sample(&chunks[0].mask, 128, 1, &occupied, &distance));
+    REQUIRE(!occupied && distance > 0);
+    REQUIRE(!material_mask_sample(&chunks[0].mask, -1, 1, &occupied, &distance));
+    REQUIRE(!split_covered(-37.013f, .013f));
+    REQUIRE(split_covered(-37.3f, .013f));
+    // Finite-world corners preserve the neighboring X sample when Y is outside.
+    REQUIRE(!split_covered(-37.013f, -1.99f));
+    REQUIRE(split_covered(-37.3f, -1.99f));
+    halves[0] = material_mask_reduce(&chunks[0].mask);
+    halves[1] = material_mask_reduce(&chunks[1].mask);
+    REQUIRE(halves[1].count == 0 && collision_cover(&halves[1]));
+    REQUIRE(material_mask_sample(&halves[0], 64, 0, &occupied, &distance));
+    REQUIRE(!occupied && distance > 0);
+    material_surface_view surface = material_mask_surface(&chunks[0].mask);
+    for (int i = 0; i < surface.count; i++) {
+        const material_polygon *p = &surface.polygons[i];
+        REQUIRE(p->count >= 3 && p->count <= 6);
+        for (int j = 0; j < p->count; j++) {
+            REQUIRE(fabsf(p->points[2 * j]) <= chunks[0].mask.width * .5f);
+            REQUIRE(fabsf(p->points[2 * j + 1]) <= chunks[0].mask.height * .5f);
+        }
+    }
+    return true;
+}
+void test_tool_terrain_seams()
+{
+    pu_setup(setup, teardown);
+    RUN_TEST_CASE(diagonal_and_cross_seam_cut_match_continuous_mask);
+    RUN_TEST_CASE(reduced_halos_preserve_partial_chunk_contours);
+    RUN_TEST_CASE(known_empty_neighbor_is_not_missing_or_solid);
+    pu_setup(NULL, NULL);
+}
diff --git a/test/tools/terrain_storage.c b/test/tools/terrain_storage.c
new file mode 100644
index 000000000..faf3cd082
--- /dev/null
+++ b/test/tools/terrain_storage.c
@@ -0,0 +1,311 @@
+#include "runtime/terrain_storage.h"
+
+#include "execution/status.h"
+#include "runtime/component_catalog.h"
+#include "runtime/materials.h"
+#include "runtime/save.h"
+#include "runtime/world.h"
+#include "test/tools/fixture.h"
+#include "third_party/pico_headers/pico_unit.h"
+#include "types/catalog.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static world *simulation;
+static ecs_world *ecs;
+static materials *terrain;
+static terrain_storage *storage;
+static save *store;
+static ecs_entity source;
+static unsigned char *snapshots[4];
+static size_t lengths[4];
+static char directory[128], error[256];
+static const char identity[] = "world/quarry";
+
+static void cleanup()
+{
+    for (int i = 0; i < 4; i++) {
+        free(snapshots[i]);
+        snapshots[i] = NULL;
+        lengths[i] = 0;
+    }
+    if (simulation) {
+        world_free(simulation);
+    }
+    simulation = NULL;
+    if (directory[0]) {
+        tool_remove_tree(directory);
+        directory[0] = 0;
+    }
+}
+
+static bool prepare(bool persistent)
+{
+    REQUIRE(type_catalog_find("CF_V2"));
+    world_options options = { .modules = WORLD_MATERIALS };
+    simulation = world_new(&options, error, sizeof error);
+    REQUIRE(simulation);
+    REQUIRE(engine_set_playing(world_engine(simulation), false) == FLOW_OK);
+    ecs = world_ecs(simulation);
+    terrain = world_materials(simulation);
+    storage = world_modules(simulation)->terrain_storage;
+    store = world_modules(simulation)->save;
+    REQUIRE(storage && !world_modules(simulation)->physics);
+    field_ir constant = { .op = FIELD_CONSTANT, .value = -1 };
+    field_program *program = field_program_new(&constant, 1, 0, NULL, 0, error, sizeof error);
+    REQUIRE(program);
+    REQUIRE(material_field_register(materials_fields(terrain), "Rock", program));
+    source = ecs_world_create_entity(ecs);
+    MaterialTerrain authored = { .width = 16,
+                                 .height = 8,
+                                 .cell_size = 1,
+                                 .field = "Rock",
+                                 .seed = 17,
+                                 .min_fragment_cells = 1 };
+    Transform transform = { 0 };
+    Substance substance = { .hardness = 1 };
+    REQUIRE(
+        ecs_world_record_add(ecs, source, COMPONENT_MaterialTerrain.id, &authored, 0) == ECS_OK
+    );
+    REQUIRE(ecs_world_record_add(ecs, source, COMPONENT_Transform.id, &transform, 0) == ECS_OK);
+    REQUIRE(ecs_world_record_add(ecs, source, COMPONENT_Substance.id, &substance, 0) == ECS_OK);
+    REQUIRE(ecs_world_apply_commands(ecs) == ECS_OK);
+    REQUIRE(!materials_prepare(terrain));
+    REQUIRE(materials_inspect(terrain).cells == 128);
+    if (persistent) {
+        snprintf(directory, sizeof directory, "/tmp/chibi-terrain-storage-XXXXXX");
+        REQUIRE(mkdtemp(directory));
+        char path[160];
+        snprintf(path, sizeof path, "%s/save.json", directory);
+        REQUIRE(save_open(store, path));
+    }
+    return true;
+}
+
+static bool snapshot(int index)
+{
+    free(snapshots[index]);
+    return materials_terrain_checkpoint_write(
+        terrain,
+        source,
+        identity,
+        &snapshots[index],
+        &lengths[index],
+        error,
+        sizeof error
+    );
+}
+
+static bool same(int a, int b)
+{
+    return lengths[a] == lengths[b] &&
+           !memcmp(snapshots[a], snapshots[b], lengths[a]);
+}
+
+static int request(ecs_entity entity, const char *key, bool load)
+{
+    return terrain_storage_request(storage, entity, key, load, error, sizeof error);
+}
+
+static bool completed(int token, bool success)
+{
+    terrain_storage_state state = terrain_storage_result(storage, token);
+    REQUIRE(!state.pending && state.succeeded == success);
+    REQUIRE(success ? !state.error[0] : state.error[0] != 0);
+    return true;
+}
+
+static bool step()
+{
+    engine *runtime = world_engine(simulation);
+    REQUIRE(engine_step(runtime) == FLOW_OK);
+    int status = engine_frame(runtime, 0);
+    if (status != FLOW_OK) {
+        fprintf(
+            stderr,
+            "terrain storage engine step: %d %s\n",
+            status,
+            engine_error(runtime) ? engine_error(runtime) : "no diagnostic"
+        );
+    }
+    REQUIRE(status == FLOW_OK);
+    REQUIRE(engine_last_timing(runtime)->steps == 1);
+    return true;
+}
+
+TEST_CASE(terrain_requests_copy_identity_and_wait_for_the_engine_boundary)
+{
+    REQUIRE(prepare(true));
+    char key[] = "world/quarry";
+    ecs_component_id id = COMPONENT_MaterialTerrain.id;
+    ecs_query query;
+    REQUIRE(ecs_query_begin(ecs, &query, &id, 1) == ECS_OK);
+    int token = request(source, key, false);
+    ecs_query_end(&query);
+    REQUIRE(token > 0 && !error[0]);
+    key[0] = 'x';
+    REQUIRE(terrain_storage_pending(storage));
+    terrain_storage_state pending = terrain_storage_result(storage, token);
+    REQUIRE(pending.pending && !pending.succeeded && !pending.error[0]);
+    REQUIRE(request(source, "other", true) == 0 && error[0]);
+    REQUIRE(terrain_storage_result(storage, token).pending);
+    REQUIRE(completed(token + 1, false));
+    /* A stopped display frame cannot execute the queued snapshot. */
+    REQUIRE(engine_frame(world_engine(simulation), 0) == FLOW_OK);
+    REQUIRE(terrain_storage_result(storage, token).pending);
+    REQUIRE(!save_blob_read(store, identity, &snapshots[0], &lengths[0]));
+    REQUIRE(step());
+    REQUIRE(completed(token, true));
+    REQUIRE(!terrain_storage_pending(storage));
+    REQUIRE(save_blob_read(store, identity, &snapshots[0], &lengths[0]));
+    REQUIRE(snapshot(1) && same(0, 1));
+    int next = request(source, "cancelled", false);
+    REQUIRE(next > token);
+    REQUIRE(completed(token, false));
+    engine_reset_scene(world_engine(simulation));
+    REQUIRE(!terrain_storage_pending(storage));
+    REQUIRE(completed(next, false));
+    terrain_storage_flush(storage);
+    REQUIRE(!save_blob_read(store, "cancelled", &snapshots[2], &lengths[2]));
+    int after_reset = request(source, identity, false);
+    REQUIRE(after_reset > next);
+    REQUIRE(step());
+    REQUIRE(completed(after_reset, true));
+    return true;
+}
+
+TEST_CASE(terrain_storage_reports_unbound_and_invalid_source_failures)
+{
+    REQUIRE(prepare(false));
+    REQUIRE(snapshot(0));
+    int token = request(source, identity, false);
+    REQUIRE(token > 0);
+    terrain_storage_flush(storage);
+    REQUIRE(completed(token, false));
+    REQUIRE(strstr(terrain_storage_result(storage, token).error, "host-bound"));
+    REQUIRE(snapshot(1) && same(0, 1));
+    REQUIRE(request((ecs_entity){ 0 }, identity, false) == 0 && error[0]);
+    REQUIRE(request(source, "", false) == 0 && error[0]);
+    char oversized[SAVE_BLOB_KEY_MAX + 2];
+    memset(oversized, 'x', sizeof oversized - 1);
+    oversized[sizeof oversized - 1] = 0;
+    REQUIRE(request(source, oversized, false) == 0 && error[0]);
+    ecs_entity ordinary = ecs_world_create_entity(ecs);
+    token = request(ordinary, identity, false);
+    REQUIRE(token > 0);
+    terrain_storage_flush(storage);
+    REQUIRE(completed(token, false));
+    REQUIRE(strstr(terrain_storage_result(storage, token).error, "source"));
+    REQUIRE(ecs_world_destroy_entity(ecs, ordinary) == ECS_OK);
+    /* A stale generational handle cannot become a source on a later flush. */
+    token = request(ordinary, identity, false);
+    REQUIRE(token > 0);
+    terrain_storage_flush(storage);
+    REQUIRE(completed(token, false));
+    REQUIRE(snapshot(1) && same(0, 1));
+    return true;
+}
+
+TEST_CASE(terrain_storage_applies_queued_edits_and_restores_exact_state_without_physics)
+{
+    REQUIRE(prepare(true));
+    REQUIRE(snapshot(0));
+    materials_damage(terrain, source, (fluid_vec){ 0, 0 }, 2, 10, MATERIAL_DAMAGE_CONTACT, (material_impact){ 0 });
+    int token = request(source, identity, false);
+    REQUIRE(token > 0);
+    /* Neither enqueueing damage nor requesting save has changed live cells. */
+    REQUIRE(snapshot(1) && same(0, 1));
+    REQUIRE(step());
+    REQUIRE(completed(token, true));
+    REQUIRE(snapshot(1) && !same(0, 1));
+    int saved_cells = materials_inspect(terrain).cells;
+    REQUIRE(saved_cells > 0 && saved_cells < 128);
+    REQUIRE(save_blob_read(store, identity, &snapshots[2], &lengths[2]));
+    REQUIRE(same(1, 2));
+    materials_damage(
+        terrain,
+        source,
+        (fluid_vec){ 5, 0 },
+        1.5f,
+        10,
+        MATERIAL_DAMAGE_CONTACT,
+        (material_impact){ 0 }
+    );
+    REQUIRE(!materials_prepare(terrain));
+    REQUIRE(snapshot(3) && !same(1, 3));
+    token = request(source, identity, true);
+    REQUIRE(token > 0);
+    REQUIRE(snapshot(3) && !same(1, 3));
+    REQUIRE(step());
+    REQUIRE(completed(token, true));
+    REQUIRE(snapshot(3) && same(1, 3));
+    REQUIRE(materials_inspect(terrain).cells == saved_cells);
+    /* Loaded tiles are new entities. Their render transforms must be published
+     * in this same engine step even when the world has no physics module. */
+    ecs_component_id id = COMPONENT_Destructible.id;
+    ecs_query query;
+    REQUIRE(ecs_query_begin(ecs, &query, &id, 1) == ECS_OK);
+    ecs_entity entity;
+    int tiles = 0;
+    bool transforms = true;
+    while (ecs_query_next(&query, &entity)) {
+        tiles++;
+        transforms &= GlobalTransform2D_get_const(ecs, entity) != NULL;
+    }
+    ecs_query_end(&query);
+    REQUIRE(tiles > 0 && transforms);
+    return true;
+}
+
+TEST_CASE(terrain_storage_failed_loads_preserve_live_terrain_and_failed_writes_preserve_saved_bytes)
+{
+    REQUIRE(prepare(true));
+    int token = request(source, identity, false);
+    REQUIRE(token > 0);
+    terrain_storage_flush(storage);
+    REQUIRE(completed(token, true));
+    REQUIRE(save_blob_read(store, identity, &snapshots[0], &lengths[0]));
+    REQUIRE(!save_blob_write(store, identity, snapshots[0], (size_t)SAVE_BLOB_BYTES_MAX + 1));
+    REQUIRE(save_blob_read(store, identity, &snapshots[1], &lengths[1]));
+    REQUIRE(same(0, 1));
+    materials_damage(terrain, source, (fluid_vec){ 0, 0 }, 2, 10, MATERIAL_DAMAGE_CONTACT, (material_impact){ 0 });
+    REQUIRE(!materials_prepare(terrain));
+    REQUIRE(snapshot(2) && !same(0, 2));
+    token = request(source, "missing", true);
+    REQUIRE(token > 0);
+    terrain_storage_flush(storage);
+    REQUIRE(completed(token, false));
+    REQUIRE(snapshot(3) && same(2, 3));
+    /* Renaming the storage key cannot bypass the codec's stable identity. */
+    REQUIRE(save_blob_write(store, "wrong-identity", snapshots[0], lengths[0]));
+    token = request(source, "wrong-identity", true);
+    REQUIRE(token > 0);
+    terrain_storage_flush(storage);
+    REQUIRE(completed(token, false));
+    REQUIRE(snapshot(3) && same(2, 3));
+    const unsigned char corrupt[] = { 1, 2, 3 };
+    REQUIRE(save_blob_write(store, identity, corrupt, sizeof corrupt));
+    token = request(source, identity, true);
+    REQUIRE(token > 0);
+    terrain_storage_flush(storage);
+    REQUIRE(completed(token, false));
+    REQUIRE(snapshot(3) && same(2, 3));
+    return true;
+}
+
+void test_native_catalog_enable();
+void test_terrain_storage()
+{
+    test_native_catalog_enable(); /* Material Result snapshots a CF_V2 payload. */
+    pu_setup(NULL, cleanup);
+    RUN_TEST_CASE(terrain_requests_copy_identity_and_wait_for_the_engine_boundary);
+    RUN_TEST_CASE(terrain_storage_reports_unbound_and_invalid_source_failures);
+    RUN_TEST_CASE(terrain_storage_applies_queued_edits_and_restores_exact_state_without_physics);
+    RUN_TEST_CASE(
+        terrain_storage_failed_loads_preserve_live_terrain_and_failed_writes_preserve_saved_bytes
+    );
+    pu_clear_setup();
+}
diff --git a/test/tools/terrain_storage_commands.c b/test/tools/terrain_storage_commands.c
new file mode 100644
index 000000000..d593a3615
--- /dev/null
+++ b/test/tools/terrain_storage_commands.c
@@ -0,0 +1,450 @@
+#include "test/tools/fixture.h"
+#include "third_party/pico_headers/pico_unit.h"
+#include "third_party/yyjson/yyjson.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define MAX_REPLIES 16
+
+static const char *program;
+static char scratch[128], project[160], input_path[160], log_path[160],
+    save_path[160];
+static yyjson_doc *replies[MAX_REPLIES];
+static int reply_count, request_count;
+static FILE *requests;
+static yyjson_mut_doc *request;
+static yyjson_mut_val *input;
+static char *scene, *prototype;
+
+static void at(char *path, size_t size, const char *relative)
+{
+    int n = snprintf(path, size, "%s/%s", project, relative);
+    assert(n > 0 && n < (int)size);
+}
+
+static void write_asset(const char *relative, const char *text)
+{
+    char path[512];
+    at(path, sizeof path, relative);
+    tool_write(path, text);
+}
+
+static yyjson_val *get(yyjson_val *value, const char *key)
+{
+    return yyjson_obj_get(value, key);
+}
+
+static yyjson_val *reply(int index)
+{
+    assert(index >= 0 && index < reply_count);
+    return yyjson_doc_get_root(replies[index]);
+}
+
+static yyjson_val *result(int index)
+{
+    return get(reply(index), "result");
+}
+
+static bool ok(int index)
+{
+    return yyjson_get_bool(get(reply(index), "ok"));
+}
+
+static bool string_is(yyjson_val *value, const char *expected)
+{
+    const char *text = yyjson_get_str(value);
+    return text && !strcmp(text, expected);
+}
+
+static void clear_replies()
+{
+    for (int i = 0; i < reply_count; i++) {
+        yyjson_doc_free(replies[i]);
+    }
+    reply_count = 0;
+}
+
+static void begin(const char *operation, const char *entity, const char *identity, const char *namespace)
+{
+    assert(!request);
+    if (!requests) {
+        requests = fopen(input_path, "wb");
+        assert(requests);
+        request_count = 0;
+    }
+    request = yyjson_mut_doc_new(NULL);
+    input = yyjson_mut_obj(request);
+    yyjson_mut_doc_set_root(request, input);
+    yyjson_mut_obj_add_int(request, input, "contract", 1);
+    yyjson_mut_obj_add_str(request, input, "operation", operation);
+    yyjson_mut_obj_add_str(request, input, "name", "SeamStudy");
+    if (entity) {
+        yyjson_mut_obj_add_str(request, input, "entity", entity);
+    }
+    if (identity) {
+        yyjson_mut_obj_add_str(request, input, "identity", identity);
+    }
+    if (namespace) {
+        yyjson_mut_obj_add_str(request, input, "save_path", namespace);
+    }
+}
+
+static void send()
+{
+    char *json = yyjson_mut_write(request, 0, NULL);
+    assert(json && request_count < MAX_REPLIES);
+    assert(fprintf(requests, "%s\n", json) > 0);
+    free(json);
+    yyjson_mut_doc_free(request);
+    request = NULL;
+    request_count++;
+}
+
+static int run()
+{
+    assert(requests && !request);
+    assert(!fclose(requests));
+    requests = NULL;
+    clear_replies();
+    const char *args[] = {
+        "/bin/sh", "-c",    "exec \"$0\" --project-root \"$1\" < \"$2\"",
+        program,   project, input_path,
+        NULL
+    };
+    int status = tool_run(args, scratch, log_path);
+    char *output = tool_read(log_path);
+    assert(output);
+    for (const char *line = output; *line;) {
+        size_t length = strcspn(line, "\n");
+        if (!strncmp(line, "{\"contract\"", 11)) {
+            assert(reply_count < MAX_REPLIES);
+            replies[reply_count] = yyjson_read(line, length, 0);
+            assert(replies[reply_count++]);
+        }
+        line += length + (line[length] == '\n');
+    }
+    if (reply_count != request_count) {
+        fputs(output, stderr);
+    }
+    free(output);
+    assert(reply_count == request_count);
+    return status;
+}
+
+static void setup()
+{
+    strcpy(scratch, "/tmp/chibi-terrain-storage-XXXXXX");
+    assert(mkdtemp(scratch));
+    snprintf(project, sizeof project, "%s/project", scratch);
+    snprintf(input_path, sizeof input_path, "%s/requests.jsonl", scratch);
+    snprintf(log_path, sizeof log_path, "%s/output.log", scratch);
+    snprintf(save_path, sizeof save_path, "%s/save.json", scratch);
+    char fixture[1024];
+    snprintf(fixture, sizeof fixture, "%s/test/fixtures/environment-authoring", tool_root());
+#ifdef __APPLE__
+    const char *args[] = { "/bin/cp", "-cR", fixture, project, NULL };
+#else
+    const char *args[] = { "/bin/cp", "--reflink=auto", "-R",
+                           fixture,   project,          NULL };
+#endif
+    assert(tool_run(args, scratch, log_path) == 0);
+    char path[512];
+    at(path, sizeof path, "content/scenes/SeamStudy.kdl");
+    scene = tool_read(path);
+    at(path, sizeof path, "content/prototypes/SeamTerrain.kdl");
+    prototype = tool_read(path);
+    assert(scene && prototype);
+    tool_write(save_path, "{\"existing\":\"kept\"}\n");
+}
+
+static void cleanup()
+{
+    if (requests) {
+        fclose(requests);
+        requests = NULL;
+    }
+    yyjson_mut_doc_free(request);
+    request = NULL;
+    clear_replies();
+    free(scene);
+    free(prototype);
+    scene = prototype = NULL;
+    if (*scratch) {
+        tool_remove_tree(scratch);
+    }
+    *scratch = 0;
+}
+
+static void replace_asset(const char *relative, const char *source, const char *before, const char *after)
+{
+    const char *where = strstr(source, before);
+    assert(where);
+    size_t capacity = strlen(source) + strlen(after) + 1;
+    char *text = malloc(capacity);
+    assert(text);
+    size_t prefix = (size_t)(where - source);
+    memcpy(text, source, prefix);
+    strcpy(text + prefix, after);
+    strcat(text, where + strlen(before));
+    write_asset(relative, text);
+    free(text);
+}
+
+static void cut_scene(bool cut)
+{
+    if (!cut) {
+        write_asset("content/scenes/SeamStudy.kdl", scene);
+        return;
+    }
+    /* Reuse the checked-in CPU cut behavior and slab scene. No game policy. */
+    replace_asset(
+        "content/scenes/SeamStudy.kdl",
+        scene,
+        "        name \"Cut slab\"\n",
+        "        name \"Cut slab\"\n        (array)behaviors \"CutMaterial\"\n"
+    );
+}
+
+static void attachment(char *path, size_t size, const char *identity)
+{
+    static const char hex[] = "0123456789abcdef";
+    char encoded[129];
+    size_t length = strlen(identity);
+    assert(length <= 64);
+    for (size_t i = 0; i < length; i++) {
+        unsigned char byte = (unsigned char)identity[i];
+        encoded[2 * i] = hex[byte >> 4];
+        encoded[2 * i + 1] = hex[byte & 15];
+    }
+    encoded[2 * length] = 0;
+    int n = snprintf(path, size, "%s.blob-%s.bin", save_path, encoded);
+    assert(n > 0 && n < (int)size);
+}
+
+static unsigned char *read_bytes(const char *path, size_t *length)
+{
+    FILE *file = fopen(path, "rb");
+    assert(file && !fseek(file, 0, SEEK_END));
+    long bytes = ftell(file);
+    assert(bytes > 0 && !fseek(file, 0, SEEK_SET));
+    *length = (size_t)bytes;
+    unsigned char *data = malloc(*length);
+    assert(data && fread(data, 1, *length, file) == *length);
+    assert(!fclose(file));
+    return data;
+}
+
+static void write_bytes(const char *path, const unsigned char *data, size_t length)
+{
+    FILE *file = fopen(path, "wb");
+    assert(file && fwrite(data, 1, length, file) == length);
+    assert(!fclose(file));
+}
+
+static bool unchanged(const char *path, const unsigned char *expected, size_t length)
+{
+    size_t actual_length;
+    unsigned char *actual = read_bytes(path, &actual_length);
+    bool same = actual_length == length && !memcmp(actual, expected, length);
+    free(actual);
+    return same;
+}
+
+static const char *snapshot(int index)
+{
+    return yyjson_get_str(get(get(result(index), "terrain"), "snapshot_hash"));
+}
+
+static bool completed(int index)
+{
+    yyjson_val *completion = get(result(index), "completion");
+    REQUIRE(ok(index));
+    REQUIRE(yyjson_get_int(get(completion, "token")) > 0);
+    REQUIRE(!yyjson_get_bool(get(completion, "pending")));
+    REQUIRE(yyjson_get_bool(get(completion, "succeeded")));
+    REQUIRE(string_is(get(completion, "status"), "succeeded"));
+    REQUIRE(yyjson_get_bool(get(result(index), "physics_ready")));
+    REQUIRE(yyjson_get_int(get(get(result(index), "materials"), "cells")) > 0);
+    REQUIRE(snapshot(index) && strlen(snapshot(index)) == 16);
+    REQUIRE(yyjson_get_uint(get(get(result(index), "terrain"), "snapshot_bytes")) > 0);
+    return true;
+}
+
+TEST_CASE(terrain_storage_controller_contract_requires_explicit_namespace)
+{
+    begin("describe_contract", NULL, NULL, NULL);
+    send();
+    begin("save_terrain", "Cut slab", "slot", NULL);
+    send();
+    begin("save_terrain", "Cut slab", "slot", "relative.json");
+    send();
+    begin("save_terrain", "Cut slab", "slot", save_path);
+    yyjson_mut_obj_add_int(request, input, "frames", 121);
+    send();
+    begin("save_terrain", "Cut slab", "slot", save_path);
+    yyjson_mut_obj_add_obj(request, input, "saved_state");
+    send();
+    char too_long[66];
+    memset(too_long, 'x', sizeof too_long - 1);
+    too_long[sizeof too_long - 1] = 0;
+    begin("save_terrain", "Cut slab", too_long, save_path);
+    send();
+    begin("record_scenario", NULL, NULL, save_path);
+    send();
+    begin("replay_scenario", NULL, NULL, save_path);
+    send();
+    begin("replay_scenario", NULL, NULL, NULL);
+    yyjson_mut_val *recording = yyjson_mut_obj_add_obj(request, input, "recording");
+    yyjson_mut_obj_add_str(request, recording, "save_path", save_path);
+    send();
+    begin("run_scenario", NULL, NULL, save_path);
+    yyjson_mut_obj_add_str(request, input, "kind", "scene");
+    yyjson_mut_obj_add_obj(request, input, "saved_state");
+    send();
+    REQUIRE(run() != 0);
+    REQUIRE(ok(0));
+    yyjson_val *operations = get(result(0), "operations");
+    int found = 0;
+    for (size_t i = 0; i < yyjson_arr_size(operations); i++) {
+        yyjson_val *operation = yyjson_arr_get(operations, i);
+        if (!string_is(get(operation, "name"), "save_terrain") &&
+            !string_is(get(operation, "name"), "load_terrain")) {
+            continue;
+        }
+        REQUIRE(!yyjson_get_bool(get(operation, "read_only")));
+        yyjson_val *fields = get(operation, "request_fields");
+        int required = 0;
+        for (size_t n = 0; n < yyjson_arr_size(fields); n++) {
+            yyjson_val *field = yyjson_arr_get(fields, n);
+            required += yyjson_get_bool(get(field, "required"));
+        }
+        REQUIRE(required == 4);
+        found++;
+    }
+    REQUIRE(found == 2);
+    for (int i = 1; i < reply_count; i++) {
+        REQUIRE(!ok(i));
+        REQUIRE(string_is(get(get(reply(i), "error"), "code"), "invalid_request"));
+    }
+    char blob[512];
+    attachment(blob, sizeof blob, "slot");
+    REQUIRE(access(blob, F_OK) != 0);
+    char *text = tool_read(save_path);
+    REQUIRE(text && !strcmp(text, "{\"existing\":\"kept\"}\n"));
+    free(text);
+    return true;
+}
+
+TEST_CASE(terrain_storage_controller_restores_cut_after_process_restart)
+{
+    begin("save_terrain", "Cut slab", "slot", save_path);
+    send();
+    REQUIRE(run() == 0 && completed(0));
+    char original[17];
+    strcpy(original, snapshot(0));
+    cut_scene(true);
+    begin("save_terrain", "Cut slab", "slot", save_path);
+    yyjson_mut_obj_add_int(request, input, "frames", 1);
+    send();
+    REQUIRE(run() == 0 && completed(0));
+    char cut[17];
+    strcpy(cut, snapshot(0));
+    REQUIRE(strcmp(original, cut));
+    char blob[512];
+    attachment(blob, sizeof blob, "slot");
+    struct stat info;
+    REQUIRE(!stat(blob, &info) && S_ISREG(info.st_mode) && info.st_size > 0);
+    size_t length;
+    unsigned char *saved = read_bytes(blob, &length);
+    cut_scene(false);
+    /* Every run starts a new controller process and a fresh world. */
+    begin("load_terrain", "Cut slab", "slot", save_path);
+    send();
+    REQUIRE(run() == 0 && completed(0));
+    REQUIRE(!strcmp(cut, snapshot(0)));
+    REQUIRE(strcmp(original, snapshot(0)));
+    REQUIRE(unchanged(blob, saved, length));
+    begin("save_terrain", "Cut slab", "slot", save_path);
+    send();
+    REQUIRE(run() == 0 && completed(0));
+    REQUIRE(!strcmp(original, snapshot(0)));
+    char *text = tool_read(save_path);
+    REQUIRE(text && !strcmp(text, "{\"existing\":\"kept\"}\n"));
+    free(text);
+    free(saved);
+    return true;
+}
+
+TEST_CASE(terrain_storage_controller_rejects_invalid_loads_without_replacing_terrain)
+{
+    begin("save_terrain", "Cut slab", "slot", save_path);
+    send();
+    REQUIRE(run() == 0 && completed(0));
+    char original[17];
+    strcpy(original, snapshot(0));
+    char material_hash[17];
+    strcpy(material_hash, yyjson_get_str(get(get(result(0), "materials"), "hash")));
+    int cells = yyjson_get_int(get(get(result(0), "materials"), "cells"));
+    char blob[512], wrong[512];
+    attachment(blob, sizeof blob, "slot");
+    attachment(wrong, sizeof wrong, "other");
+    size_t length;
+    unsigned char *saved = read_bytes(blob, &length);
+    write_bytes(wrong, saved, length);
+    begin("load_terrain", "Cut slab", "missing", save_path);
+    send();
+    begin("load_terrain", "Cut slab", "other", save_path);
+    send();
+    begin("load_terrain", "Absent terrain", "slot", save_path);
+    send();
+    REQUIRE(run() != 0);
+    for (int i = 0; i < 2; i++) {
+        REQUIRE(!ok(i));
+        REQUIRE(!yyjson_get_bool(get(get(result(i), "completion"), "succeeded")));
+        REQUIRE(yyjson_get_bool(get(result(i), "physics_ready")));
+        REQUIRE(string_is(get(get(result(i), "materials"), "hash"), material_hash));
+        REQUIRE(yyjson_get_int(get(get(result(i), "materials"), "cells")) == cells);
+    }
+    REQUIRE(!ok(2));
+    REQUIRE(unchanged(blob, saved, length) && unchanged(wrong, saved, length));
+    char unavailable[256];
+    snprintf(unavailable, sizeof unavailable, "%s/absent/save.json", scratch);
+    begin("save_terrain", "Cut slab", "slot", unavailable);
+    send();
+    REQUIRE(run() != 0 && !ok(0));
+    REQUIRE(!yyjson_get_bool(get(get(result(0), "completion"), "succeeded")));
+    REQUIRE(unchanged(blob, saved, length));
+    REQUIRE(access(unavailable, F_OK) != 0);
+    saved[length - 1] ^= 1;
+    write_bytes(blob, saved, length);
+    begin("load_terrain", "Cut slab", "slot", save_path);
+    send();
+    REQUIRE(run() != 0 && !ok(0));
+    REQUIRE(!strcmp(original, snapshot(0)));
+    REQUIRE(unchanged(blob, saved, length));
+    saved[length - 1] ^= 1;
+    write_bytes(blob, saved, length);
+    replace_asset("content/prototypes/SeamTerrain.kdl", prototype, "seed=7", "seed=8");
+    begin("load_terrain", "Cut slab", "slot", save_path);
+    send();
+    REQUIRE(run() != 0 && !ok(0));
+    REQUIRE(!yyjson_get_bool(get(get(result(0), "completion"), "succeeded")));
+    REQUIRE(unchanged(blob, saved, length));
+    free(saved);
+    return true;
+}
+
+void test_terrain_storage_commands(const char *controller)
+{
+    program = controller;
+    pu_setup(setup, cleanup);
+    RUN_TEST_CASE(terrain_storage_controller_contract_requires_explicit_namespace);
+    RUN_TEST_CASE(terrain_storage_controller_restores_cut_after_process_restart);
+    RUN_TEST_CASE(terrain_storage_controller_rejects_invalid_loads_without_replacing_terrain);
+    pu_clear_setup();
+}
