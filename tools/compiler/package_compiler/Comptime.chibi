package package_compiler

import snapshot "project:source_snapshot"
import graph "project:package_graph"
import syntax "project:syntax_diagnostics"

// Compile-time execution of authored functions. A constant initializer may
// call a function of any package whose parameters and result are integers,
// bool, or arrays of them: the body runs on the compiler, with locals (arrays
// too), assignment (plain, compound and by element), `append`, `if`, `while`,
// `for` over a range or an array, `break`, `continue` and `return`.
// Expressions reuse the exact constant evaluator, so arithmetic keeps its
// range checks and a result that does not fit its type is an error, not a
// wrap. Each evaluation has a step budget and a call-depth limit.
CtSteps: int : 65536;
CtDepth: int : 128;

// What the compiler knows while it runs a function, read-only except `steps`.
CtContext :: struct {
    forest: snapshot.SnapshotNode[];
    documents: snapshot.Document[];
    links: graph.Binding[];
    callables: Callable[];
    params: Param[];
    constants: ConstDecl[];
    steps: int;
}
// The locals of one activation, innermost last. A local's storage is its
// type, or the negation of its element type when it is an array, whose
// elements are in `arrays`.
CtFrame :: struct {
    names: string[];
    bits: u64[];
    storages: int[];
    arrays: CtRow[];
}
// The elements of one array local.
CtRow :: struct {
    items: u64[];
}

CtResult :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Waiting
    | Value(bits: u64, storage: int)
    | Elements(values: u64[], storage: int)
}
CtFlow :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Waiting
    | Normal
    | Returned(bits: u64, storage: int)
    | ReturnedElements(values: u64[], storage: int)
    | Broke
    | Continued
}

// The constant `name` of an activation, its current value.
CtLocal :: (name: string, package: int, file: int, storage: int, bits: u64) -> ConstDecl {
    return {name: name, package: package, storage: storage, bits: bits, node: -1, file: file, folded: true,
            occurrence: 0};
}
// What an expression of an activation reads: its scalar locals, innermost
// first, the nodes already evaluated, then the constants.
CtScope :: (constants: ConstDecl[], package: int, file: int, frame: ^CtFrame, memo: ConstDecl[]) -> ConstDecl[] {
    scope: ConstDecl[] = [];
    at := length(frame.names) - 1;
    while (at >= 0) {
        if (frame.storages[at] > 0) {
            scope.append(CtLocal(frame.names[at], package, file, frame.storages[at], frame.bits[at]));
        }
        at -= 1;
    }
    scope.extend(memo);
    scope.extend(constants);
    return scope;
}
// The memo constant standing for the evaluated node, -1 for none.
FindMemo :: (constants: ConstDecl[], node: int) -> int {
    index: int = 0;
    while (index < length(constants)) {
        if (constants[index].name == "" && constants[index].node == node) {
            return index;
        }
        index += 1;
    }
    return -1;
}
// The function a call names, in `package` or through an import alias; -1 when
// it names none.
CtCallee :: (context: ^CtContext, package: int, file: int, call: int) -> int {
    text := context.documents[file].text;
    function := Field(context.forest, call, "function");
    if (Is(context.forest, function, "identifier")) {
        return FindCallable(context.callables, package, Text(context.forest, text, function));
    }
    if (Is(context.forest, function, "member_expression")) {
        home := QualifierOf(context.forest, text, Aliases(context.links, file), package,
                            Field(context.forest, function, "object"));
        if (home < 0) {
            return -1;
        }
        return FindCallable(context.callables, home, Text(context.forest, text, Field(context.forest, function, "member")));
    }
    return -1;
}
// Whether `call` is `length(array)`.
CtLength :: (context: ^CtContext, package: int, file: int, call: int) -> bool {
    function := Field(context.forest, call, "function");
    return Is(context.forest, call, "call_expression") && Is(context.forest, function, "identifier") &&
           Text(context.forest, context.documents[file].text, function) == "length" &&
           CtCallee(context, package, file, call) < 0;
}
// Appends the outermost nodes of the expression `node` that run before it is
// folded: calls of authored functions, `length(array)` and `array[index]`.
// Their own operands are evaluated with them.
CtCollect :: (context: ^CtContext, package: int, file: int, node: int, out: ^(int[])) {
    if (node < 0) {
        return;
    }
    if (Is(context.forest, node, "index_expression") ||
        (Is(context.forest, node, "call_expression") &&
         (CtCallee(context, package, file, node) >= 0 || CtLength(context, package, file, node)))) {
        out.append(node);
        return;
    }
    for (child in Members(context.forest, node)) {
        CtCollect(context, package, file, child, out);
    }
}
// Whether `node` is a condition: a comparison, a logical operation, `not`, or
// a boolean literal, local or call.
CtBoolean :: (forest: snapshot.SnapshotNode[], text: string, scope: ConstDecl[], aliases: Name[], package: int,
              node: int) -> bool {
    value := Unparenthesized(forest, node);
    if (Is(forest, value, "boolean")) {
        return true;
    }
    named := ConstantOf(forest, text, scope, aliases, package, value);
    if (named >= 0) {
        return scope[named].storage == BoolStorage;
    }
    if (Is(forest, value, "call_expression")) {
        return Text(forest, text, Field(forest, value, "function")) == "not";
    }
    if (Is(forest, value, "unary_expression")) {
        operator := Text(forest, text, Field(forest, value, "operator"));
        return operator == "not" || operator == "!";
    }
    if (Is(forest, value, "binary_expression")) {
        operator := Text(forest, text, Field(forest, value, "operator"));
        return ComparisonOperator(operator) || operator == "and" || operator == "&&" || operator == "or" ||
               operator == "||";
    }
    return false;
}
CtFail :: (context: ^CtContext, node: int, file: int, message: string) -> syntax.Diagnostic {
    return Diagnose(context.forest, node, file, message);
}
// Counts a step against the budget; false once it is spent.
CtStep :: (context: ^CtContext, node: int, file: int) -> bool {
    context.steps += 1;
    return context.steps <= CtSteps;
}
// The index of local `name`, the newest first; -1 for none.
CtLookup :: (frame: ^CtFrame, name: string) -> int {
    at := length(frame.names) - 1;
    while (at >= 0) {
        if (frame.names[at] == name) {
            return at;
        }
        at -= 1;
    }
    return -1;
}
// The array local that `node` names, -1 when it names none.
CtArrayLocal :: (context: ^CtContext, file: int, frame: ^CtFrame, node: int) -> int {
    value := Unparenthesized(context.forest, node);
    if (!Is(context.forest, value, "identifier")) {
        return -1;
    }
    at := CtLookup(frame, Text(context.forest, context.documents[file].text, value));
    if (at >= 0 && frame.storages[at] < 0) {
        return at;
    }
    return -1;
}
// Whether `node` is an array-valued expression here: an array literal, an
// array local, or a call of a function that returns an array.
CtIsArray :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, node: int) -> bool {
    value := Unparenthesized(context.forest, node);
    if (Is(context.forest, value, "array_expression")) {
        return true;
    }
    if (CtArrayLocal(context, file, frame, value) >= 0) {
        return true;
    }
    if (Is(context.forest, value, "call_expression")) {
        callee := CtCallee(context, package, file, value);
        return callee >= 0 && context.callables[callee].result_container == ArrayContainer;
    }
    return false;
}
// The value of the scalar expression `node` in an activation. `want` is the
// type an untyped expression takes, 0 for the default.
CtEval :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, node: int,
           want: int) -> CtResult {
    text := context.documents[file].text;
    memo: ConstDecl[] = [];
    reads: int[] = [];
    CtCollect(context, package, file, node, &reads);
    for (read in reads) {
        switch CtRead(context, package, file, frame, depth, read) {
            case .Failed(diagnostic):
                return CtResult.Failed(diagnostic);
            case .Waiting:
                return CtResult.Waiting;
            case .Elements(values, storage):
                return CtResult.Failed(CtFail(context, read, file, "an array cannot be used as a number here"));
            case .Value(value, storage):
                placed: ConstDecl = {name: "", package: package, storage: storage, bits: value, node: read,
                                     file: file, folded: true, occurrence: 0};
                memo.append(placed);
        }
    }
    scope := CtScope(context.constants, package, file, frame, memo);
    aliases := Aliases(context.links, file);
    if (CtBoolean(context.forest, text, scope, aliases, package, node)) {
        switch FoldCondition(context.forest, text, file, scope, aliases, package, node) {
            case .Failed(diagnostic):
                return CtResult.Failed(diagnostic);
            case .Waiting:
                return CtResult.Waiting;
            case .Yes:
                return CtResult.Value(1, BoolStorage);
            case .No:
                return CtResult.Value(0, BoolStorage);
        }
    }
    typed := ConstantType(context.forest, text, scope, aliases, package, node);
    if (typed == 0) {
        typed = want;
    }
    if (typed == 0) {
        typed = IntStorage;
    }
    switch FoldConstant(context.forest, text, file, scope, aliases, package, node, typed) {
        case .Failed(diagnostic):
            return CtResult.Failed(diagnostic);
        case .Waiting:
            return CtResult.Waiting;
        case .Folded(folded):
            return CtResult.Value(folded, typed);
    }
}
// The value of an array-valued expression: its elements and their type.
CtEvalArray :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, node: int,
                want: int) -> CtResult {
    value := Unparenthesized(context.forest, node);
    local := CtArrayLocal(context, file, frame, value);
    if (local >= 0) {
        return CtResult.Elements(frame.arrays[local].items, -frame.storages[local]);
    }
    if (Is(context.forest, value, "call_expression")) {
        return CtRead(context, package, file, frame, depth, value);
    }
    if (!Is(context.forest, value, "array_expression")) {
        return CtResult.Failed(CtFail(context, node, file, "a compile-time array is a literal, a local or a call"));
    }
    elements: u64[] = [];
    storage := want;
    for (element in Members(context.forest, value)) {
        switch CtEval(context, package, file, frame, depth, element, storage) {
            case .Failed(diagnostic):
                return CtResult.Failed(diagnostic);
            case .Waiting:
                return CtResult.Waiting;
            case .Elements(values, kind):
                return CtResult.Failed(CtFail(context, element, file, "compile-time arrays hold numbers and bools"));
            case .Value(item, kind):
                if (storage == 0) {
                    storage = kind;
                }
                if (kind != storage && !Widens(kind, storage)) {
                    return CtResult.Failed(CtFail(context, element, file, "array elements differ in type"));
                }
                elements.append(CtWidened(item, kind, storage));
        }
    }
    if (storage == 0) {
        return CtResult.Failed(CtFail(context, node, file, "an empty compile-time array needs its type"));
    }
    return CtResult.Elements(elements, storage);
}
// Evaluates a node CtCollect found: a call, `length(array)` or `array[index]`.
CtRead :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, node: int) -> CtResult {
    if (Is(context.forest, node, "call_expression") && !CtLength(context, package, file, node)) {
        return CtCall(context, package, file, frame, depth, node);
    }
    if (Is(context.forest, node, "call_expression")) {
        arguments := Members(context.forest, Field(context.forest, node, "arguments"));
        if (length(arguments) != 1) {
            return CtResult.Failed(CtFail(context, node, file, "length takes one array"));
        }
        switch CtEvalArray(context, package, file, frame, depth, arguments[0], 0) {
            case .Failed(diagnostic):
                return CtResult.Failed(diagnostic);
            case .Waiting:
                return CtResult.Waiting;
            case .Value(item, kind):
                return CtResult.Failed(CtFail(context, arguments[0], file, "length takes an array"));
            case .Elements(values, kind):
                return CtResult.Value(u64(length(values)), IntStorage);
        }
    }
    switch CtEvalArray(context, package, file, frame, depth, Field(context.forest, node, "object"), 0) {
        case .Failed(diagnostic):
            return CtResult.Failed(diagnostic);
        case .Waiting:
            return CtResult.Waiting;
        case .Value(item, kind):
            return CtResult.Failed(CtFail(context, node, file, "only an array can be indexed at compile time"));
        case .Elements(values, kind):
            switch CtEval(context, package, file, frame, depth, Field(context.forest, node, "index"), IntStorage) {
                case .Failed(diagnostic):
                    return CtResult.Failed(diagnostic);
                case .Waiting:
                    return CtResult.Waiting;
                case .Elements(more, other):
                    return CtResult.Failed(CtFail(context, node, file, "an array index is a number"));
                case .Value(position, storage):
                    if (!Integer(storage)) {
                        return CtResult.Failed(CtFail(context, node, file, "an array index is a number"));
                    }
                    signed := ExactStored(position, storage);
                    if (ExactNegative(signed) ||
                        MagnitudeCompare(Magnitude(signed), Magnitude(ExactOf(false, u64(length(values))))) >= 0) {
                        return CtResult.Failed(CtFail(context, node, file, "array index out of range"));
                    }
                    return CtResult.Value(values[int(LowBits(Magnitude(signed)))], kind);
            }
    }
}
// Calls the function that `call` names with its arguments evaluated here.
CtCall :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, call: int) -> CtResult {
    callee := CtCallee(context, package, file, call);
    callable := context.callables[callee];
    if (callable.count < 0) {
        return CtResult.Failed(CtFail(context, call, file, "compile-time execution does not call generic functions yet"));
    }
    if (depth >= CtDepth) {
        return CtResult.Failed(CtFail(context, call, file, "compile-time evaluation exceeded 128 nested calls"));
    }
    arguments := Members(context.forest, Field(context.forest, call, "arguments"));
    if (length(arguments) != callable.count) {
        return CtResult.Failed(CtFail(context, call, file, "compile-time call needs every argument"));
    }
    inner: CtFrame = {names: [], bits: [], storages: [], arrays: []};
    index: int = 0;
    while (index < length(arguments)) {
        param := context.params[callable.first + index];
        if ((!Integer(param.storage) && param.storage != BoolStorage) ||
            (param.container != 0 && param.container != ArrayContainer) || param.reference ||
            Is(context.forest, arguments[index], "named_argument")) {
            return CtResult.Failed(CtFail(context, arguments[index], file,
                                          "compile-time calls take integers, bools and arrays of them by position"));
        }
        if (param.container == ArrayContainer) {
            switch CtEvalArray(context, package, file, frame, depth, arguments[index], param.storage) {
                case .Failed(diagnostic):
                    return CtResult.Failed(diagnostic);
                case .Waiting:
                    return CtResult.Waiting;
                case .Value(item, kind):
                    return CtResult.Failed(CtFail(context, arguments[index], file, "the argument must be an array"));
                case .Elements(values, kind):
                    if (kind != param.storage) {
                        return CtResult.Failed(CtFail(context, arguments[index], file,
                                                      "array argument differs from its parameter type"));
                    }
                    inner.names.append(param.name);
                    inner.bits.append(0);
                    inner.storages.append(-param.storage);
                    CtAddRow(&inner, values);
            }
        } else {
            switch CtEval(context, package, file, frame, depth, arguments[index], param.storage) {
                case .Failed(diagnostic):
                    return CtResult.Failed(diagnostic);
                case .Waiting:
                    return CtResult.Waiting;
                case .Elements(values, kind):
                    return CtResult.Failed(CtFail(context, arguments[index], file, "the argument must be a number"));
                case .Value(value, storage):
                    if (storage != param.storage && !Widens(storage, param.storage)) {
                        return CtResult.Failed(CtFail(context, arguments[index], file,
                                                      format_text("Mismatched integer types {} and {}; convert one operand",
                                                                  TypeName(storage), TypeName(param.storage))));
                    }
                    inner.names.append(param.name);
                    inner.bits.append(CtWidened(value, storage, param.storage));
                    inner.storages.append(param.storage);
                    CtAddRow(&inner, []);
            }
        }
        index += 1;
    }
    return CtRun(context, callee, &inner, depth + 1);
}
// `value` of type `from` as a value of the wider type `to`.
CtWidened :: (value: u64, from: int, to: int) -> u64 {
    return ExactWrapped(ExactStored(value, from), to);
}
// Runs function `callee` with its arguments in `frame`.
CtRun :: (context: ^CtContext, callee: int, frame: ^CtFrame, depth: int) -> CtResult {
    callable := context.callables[callee];
    file := callable.document;
    if (callable.result == 0 || (!Integer(callable.result) && callable.result != BoolStorage) ||
        (callable.result_container != 0 && callable.result_container != ArrayContainer) || callable.results != 0) {
        return CtResult.Failed(CtFail(context, callable.node, file,
                                      "compile-time execution needs a function with one integer, bool or array result"));
    }
    body := Field(context.forest, callable.node, "body");
    switch CtBlock(context, callable.package, file, frame, depth, callable, Members(context.forest, body)) {
        case .Failed(diagnostic):
            return CtResult.Failed(diagnostic);
        case .Waiting:
            return CtResult.Waiting;
        case .Returned(value, storage):
            return CtResult.Value(value, storage);
        case .ReturnedElements(values, storage):
            return CtResult.Elements(values, storage);
        case .Normal:
            return CtResult.Failed(CtFail(context, callable.node, file, "a compile-time function must return a value"));
        case .Broke:
            return CtResult.Failed(CtFail(context, callable.node, file, "break outside a loop"));
        case .Continued:
            return CtResult.Failed(CtFail(context, callable.node, file, "continue outside a loop"));
    }
}
// `left op right` over exact values.
CtApply :: (operator: string, left: u64[], right: u64[]) -> u64[] {
    if (operator == "+") {
        return ExactAdd(left, right);
    }
    if (operator == "-") {
        return ExactSubtract(left, right);
    }
    if (operator == "*") {
        return ExactMultiply(left, right);
    }
    if (operator == "/" || operator == "%") {
        return ExactDivide(left, right, operator == "%");
    }
    return ExactBitwise(operator, left, right);
}
// Adds the elements of a new array local, or an empty row for a scalar.
CtAddRow :: (frame: ^CtFrame, values: u64[]) {
    row: CtRow = {items: values};
    frame.arrays.append(row);
}
CtSetRow :: (frame: ^CtFrame, at: int, values: u64[]) {
    row: CtRow = {items: values};
    frame.arrays[at] = row;
}
// Drops the locals declared after the first `mark`.
CtDrop :: (frame: ^CtFrame, mark: int) {
    frame.names.resize(mark);
    frame.bits.resize(mark);
    frame.storages.resize(mark);
    frame.arrays.resize(mark);
}
// Runs the statements of a block of `function`; its locals end with it.
CtBlock :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, function: Callable,
            statements: int[]) -> CtFlow {
    mark := length(frame.names);
    for (statement in statements) {
        if (!CtStep(context, statement, file)) {
            return CtFlow.Failed(CtFail(context, statement, file, "compile-time evaluation exceeded 65536 steps"));
        }
        switch CtStatement(context, package, file, frame, depth, function, statement) {
            case .Normal:
                continue;
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Returned(value, storage):
                CtDrop(frame, mark);
                return CtFlow.Returned(value, storage);
            case .ReturnedElements(values, storage):
                CtDrop(frame, mark);
                return CtFlow.ReturnedElements(values, storage);
            case .Broke:
                CtDrop(frame, mark);
                return CtFlow.Broke;
            case .Continued:
                CtDrop(frame, mark);
                return CtFlow.Continued;
        }
    }
    CtDrop(frame, mark);
    return CtFlow.Normal;
}
// The storage a type text names: negated for an array of it, 0 for none.
CtDeclared :: (text: string) -> int {
    size := text_byte_length(text);
    if (size > 2 && text_slice(text, size - 2, 2) == "[]") {
        return -ScalarStorage(text_slice(text, 0, size - 2));
    }
    return ScalarStorage(text);
}
CtStatement :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, function: Callable,
                statement: int) -> CtFlow {
    forest := context.forest;
    if (Is(forest, statement, "return_statement")) {
        value := Field(forest, statement, "value");
        if (value < 0) {
            return CtFlow.Failed(CtFail(context, statement, file, "return needs a value"));
        }
        if (function.result_container == ArrayContainer) {
            switch CtEvalArray(context, package, file, frame, depth, value, function.result) {
                case .Failed(diagnostic):
                    return CtFlow.Failed(diagnostic);
                case .Waiting:
                    return CtFlow.Waiting;
                case .Value(item, kind):
                    return CtFlow.Failed(CtFail(context, value, file, "returned value differs from the result type"));
                case .Elements(values, kind):
                    if (kind != function.result) {
                        return CtFlow.Failed(CtFail(context, value, file, "returned value differs from the result type"));
                    }
                    return CtFlow.ReturnedElements(values, kind);
            }
        }
        switch CtEval(context, package, file, frame, depth, value, function.result) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Elements(values, kind):
                return CtFlow.Failed(CtFail(context, value, file, "returned value differs from the result type"));
            case .Value(returned, storage):
                if (storage != function.result && !Widens(storage, function.result)) {
                    return CtFlow.Failed(CtFail(context, value, file, "returned value differs from the result type"));
                }
                return CtFlow.Returned(CtWidened(returned, storage, function.result), function.result);
        }
    }
    if (Is(forest, statement, "break_statement")) {
        return CtFlow.Broke;
    }
    if (Is(forest, statement, "continue_statement")) {
        return CtFlow.Continued;
    }
    if (Is(forest, statement, "local_declaration")) {
        return CtDeclaration(context, package, file, frame, depth, statement);
    }
    if (Is(forest, statement, "assignment")) {
        return CtAssignment(context, package, file, frame, depth, statement);
    }
    if (Is(forest, statement, "expression_statement")) {
        return CtAppend(context, package, file, frame, depth, statement);
    }
    if (Is(forest, statement, "if_statement")) {
        switch CtEval(context, package, file, frame, depth, Field(forest, statement, "condition"), BoolStorage) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Elements(values, kind):
                return CtFlow.Failed(CtFail(context, statement, file, "an if condition must be a bool"));
            case .Value(taken, storage):
                if (storage != BoolStorage) {
                    return CtFlow.Failed(CtFail(context, Field(forest, statement, "condition"), file,
                                                "an if condition must be a bool"));
                }
                if (taken != 0) {
                    return CtBlock(context, package, file, frame, depth, function,
                                   Members(forest, Field(forest, statement, "consequence")));
                }
                alternative := Field(forest, statement, "alternative");
                if (Is(forest, alternative, "if_statement")) {
                    return CtStatement(context, package, file, frame, depth, function, alternative);
                }
                if (alternative >= 0) {
                    return CtBlock(context, package, file, frame, depth, function, Members(forest, alternative));
                }
                return CtFlow.Normal;
        }
    }
    if (Is(forest, statement, "while_statement")) {
        return CtWhile(context, package, file, frame, depth, function, statement);
    }
    if (Is(forest, statement, "for_statement")) {
        return CtFor(context, package, file, frame, depth, function, statement);
    }
    return CtFlow.Failed(CtFail(context, statement, file, "compile-time execution does not support this statement yet"));
}
// `name: type = value` or `name := value`, scalar or array.
CtDeclaration :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int,
                  statement: int) -> CtFlow {
    forest := context.forest;
    text := context.documents[file].text;
    want: int = 0;
    declared := Field(forest, statement, "type");
    if (declared >= 0) {
        want = CtDeclared(Text(forest, text, declared));
        if (want == 0 || (want > 0 && !Integer(want) && want != BoolStorage) ||
            (want < 0 && !Integer(-want) && -want != BoolStorage)) {
            return CtFlow.Failed(CtFail(context, declared, file,
                                        "compile-time locals are integers, bools and arrays of them"));
        }
    }
    value := Field(forest, statement, "value");
    if (value < 0) {
        return CtFlow.Failed(CtFail(context, statement, file, "a compile-time local needs a value"));
    }
    name := Text(forest, text, Field(forest, statement, "name"));
    if (want < 0 || (want == 0 && CtIsArray(context, package, file, frame, value))) {
        switch CtEvalArray(context, package, file, frame, depth, value, -want) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Value(item, kind):
                return CtFlow.Failed(CtFail(context, value, file, "local value differs from its type"));
            case .Elements(values, kind):
                if (want < 0 && kind != -want) {
                    return CtFlow.Failed(CtFail(context, value, file, "local value differs from its type"));
                }
                frame.names.append(name);
                frame.bits.append(0);
                frame.storages.append(-kind);
                CtAddRow(frame, values);
                return CtFlow.Normal;
        }
    }
    switch CtEval(context, package, file, frame, depth, value, want) {
        case .Failed(diagnostic):
            return CtFlow.Failed(diagnostic);
        case .Waiting:
            return CtFlow.Waiting;
        case .Elements(values, kind):
            return CtFlow.Failed(CtFail(context, value, file, "local value differs from its type"));
        case .Value(initial, storage):
            if (want != 0 && storage != want && !Widens(storage, want)) {
                return CtFlow.Failed(CtFail(context, value, file, "local value differs from its type"));
            }
            if (want == 0) {
                want = storage;
            }
            frame.names.append(name);
            frame.bits.append(CtWidened(initial, storage, want));
            frame.storages.append(want);
            CtAddRow(frame, []);
            return CtFlow.Normal;
    }
}
// `x = v`, `x op= v`, `array[i] = v`, `array[i] op= v` and `array = other`.
CtAssignment :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int,
                 statement: int) -> CtFlow {
    forest := context.forest;
    text := context.documents[file].text;
    target := Field(forest, statement, "target");
    operator := CompoundOperator(Text(forest, text, Field(forest, statement, "operator")));
    value := Field(forest, statement, "value");
    element: int = -1;
    holder := target;
    if (Is(forest, target, "index_expression")) {
        holder = Field(forest, target, "object");
        element = Field(forest, target, "index");
    }
    if (!Is(forest, holder, "identifier")) {
        return CtFlow.Failed(CtFail(context, statement, file, "compile-time assignment needs a local"));
    }
    at := CtLookup(frame, Text(forest, text, holder));
    if (at < 0) {
        return CtFlow.Failed(CtFail(context, statement, file, "compile-time assignment needs a local"));
    }
    local := frame.storages[at];
    if (element < 0 && local < 0) {
        if (operator != "") {
            return CtFlow.Failed(CtFail(context, statement, file, "compound assignment needs integer operands"));
        }
        switch CtEvalArray(context, package, file, frame, depth, value, -local) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Value(item, kind):
                return CtFlow.Failed(CtFail(context, statement, file, "assigned value differs from its local"));
            case .Elements(values, kind):
                if (kind != -local) {
                    return CtFlow.Failed(CtFail(context, statement, file, "assigned value differs from its local"));
                }
                CtSetRow(frame, at, values);
                return CtFlow.Normal;
        }
    }
    kind := local;
    position: int = 0;
    if (element >= 0) {
        if (local >= 0) {
            return CtFlow.Failed(CtFail(context, statement, file, "only an array can be indexed at compile time"));
        }
        kind = -local;
        switch CtEval(context, package, file, frame, depth, element, IntStorage) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Elements(more, other):
                return CtFlow.Failed(CtFail(context, element, file, "an array index is a number"));
            case .Value(index, storage):
                signed := ExactStored(index, storage);
                if (!Integer(storage) || ExactNegative(signed) ||
                    MagnitudeCompare(Magnitude(signed), Magnitude(ExactOf(false, u64(length(frame.arrays[at].items))))) >= 0) {
                    return CtFlow.Failed(CtFail(context, element, file, "array index out of range"));
                }
                position = int(LowBits(Magnitude(signed)));
        }
    }
    switch CtEval(context, package, file, frame, depth, value, kind) {
        case .Failed(diagnostic):
            return CtFlow.Failed(diagnostic);
        case .Waiting:
            return CtFlow.Waiting;
        case .Elements(values, other):
            return CtFlow.Failed(CtFail(context, statement, file, "assigned value differs from its local"));
        case .Value(assigned, storage):
            if (storage != kind && !Widens(storage, kind)) {
                return CtFlow.Failed(CtFail(context, statement, file, "assigned value differs from its local"));
            }
            current: u64 = 0;
            if (element >= 0) {
                current = frame.arrays[at].items[position];
            } else {
                current = frame.bits[at];
            }
            result := CtWidened(assigned, storage, kind);
            if (operator != "") {
                if (!Integer(kind)) {
                    return CtFlow.Failed(CtFail(context, statement, file, "compound assignment needs integer operands"));
                }
                operand := ExactStored(result, kind);
                if ((operator == "/" || operator == "%") && ExactZero(operand)) {
                    return CtFlow.Failed(CtFail(context, statement, file, "Constant division by zero"));
                }
                combined := CtApply(operator, ExactStored(current, kind), operand);
                if (MagnitudeBits(Magnitude(combined)) > ExactLimit || !ExactFits(combined, kind)) {
                    return CtFlow.Failed(OutsideRange(forest, file, statement, kind));
                }
                result = ExactWrapped(combined, kind);
            }
            if (element >= 0) {
                row := frame.arrays[at].items;
                row[position] = result;
                CtSetRow(frame, at, row);
            } else {
                frame.bits[at] = result;
            }
            return CtFlow.Normal;
    }
}
// `array.append(value)`, the one expression statement a compile-time function
// may use.
CtAppend :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int,
             statement: int) -> CtFlow {
    forest := context.forest;
    text := context.documents[file].text;
    call := FirstMember(forest, statement);
    function := Field(forest, call, "function");
    if (!Is(forest, call, "call_expression") || !Is(forest, function, "member_expression") ||
        Text(forest, text, Field(forest, function, "member")) != "append") {
        return CtFlow.Failed(CtFail(context, statement, file, "compile-time execution does not support this statement yet"));
    }
    at := CtArrayLocal(context, file, frame, Field(forest, function, "object"));
    arguments := Members(forest, Field(forest, call, "arguments"));
    if (at < 0 || length(arguments) != 1) {
        return CtFlow.Failed(CtFail(context, statement, file, "append takes one value for a local array"));
    }
    kind := -frame.storages[at];
    switch CtEval(context, package, file, frame, depth, arguments[0], kind) {
        case .Failed(diagnostic):
            return CtFlow.Failed(diagnostic);
        case .Waiting:
            return CtFlow.Waiting;
        case .Elements(values, other):
            return CtFlow.Failed(CtFail(context, statement, file, "array elements differ in type"));
        case .Value(item, storage):
            if (storage != kind && !Widens(storage, kind)) {
                return CtFlow.Failed(CtFail(context, statement, file, "array elements differ in type"));
            }
            row := frame.arrays[at].items;
            row.append(CtWidened(item, storage, kind));
            CtSetRow(frame, at, row);
            return CtFlow.Normal;
    }
}
// `while condition { ... }`.
CtWhile :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, function: Callable,
            statement: int) -> CtFlow {
    forest := context.forest;
    while (true) {
        if (!CtStep(context, statement, file)) {
            return CtFlow.Failed(CtFail(context, statement, file, "compile-time evaluation exceeded 65536 steps"));
        }
        switch CtEval(context, package, file, frame, depth, Field(forest, statement, "condition"), BoolStorage) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Elements(values, kind):
                return CtFlow.Failed(CtFail(context, statement, file, "a while condition must be a bool"));
            case .Value(taken, storage):
                if (storage != BoolStorage) {
                    return CtFlow.Failed(CtFail(context, Field(forest, statement, "condition"), file,
                                                "a while condition must be a bool"));
                }
                if (taken == 0) {
                    return CtFlow.Normal;
                }
        }
        switch CtBlock(context, package, file, frame, depth, function, Members(forest, Field(forest, statement, "body"))) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Returned(value, storage):
                return CtFlow.Returned(value, storage);
            case .ReturnedElements(values, storage):
                return CtFlow.ReturnedElements(values, storage);
            case .Broke:
                return CtFlow.Normal;
            case .Normal:
                continue;
            case .Continued:
                continue;
        }
    }
}
// `for i in first..<last`, `for i in first..last`, `for item in array`,
// `for index, item in array`, each also reversed with `for <`.
CtFor :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, function: Callable,
          statement: int) -> CtFlow {
    forest := context.forest;
    text := context.documents[file].text;
    name := Text(forest, text, Field(forest, statement, "name"));
    reverse := Field(forest, statement, "reverse") >= 0;
    if (Field(forest, statement, "reference") >= 0) {
        return CtFlow.Failed(CtFail(context, statement, file, "compile-time loops iterate by value"));
    }
    values: u64[] = [];
    kind: int = IntStorage;
    key := Field(forest, statement, "key");
    if (Field(forest, statement, "first") >= 0) {
        first: u64 = 0;
        last: u64 = 0;
        switch CtEval(context, package, file, frame, depth, Field(forest, statement, "first"), 0) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Elements(more, other):
                return CtFlow.Failed(CtFail(context, statement, file, "a range bound is a number"));
            case .Value(low, storage):
                first = low;
                kind = storage;
        }
        switch CtEval(context, package, file, frame, depth, Field(forest, statement, "last"), kind) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Elements(more, other):
                return CtFlow.Failed(CtFail(context, statement, file, "a range bound is a number"));
            case .Value(high, storage):
                last = CtWidened(high, storage, kind);
        }
        if (!Integer(kind)) {
            return CtFlow.Failed(CtFail(context, statement, file, "a range bound is an integer"));
        }
        low := ExactStored(first, kind);
        high := ExactStored(last, kind);
        if (Text(forest, text, Field(forest, statement, "bound")) == "..") {
            high = ExactAdd(high, ExactOf(false, 1));
        }
        while (!ExactNegative(ExactSubtract(high, low)) && !ExactZero(ExactSubtract(high, low))) {
            if (length(values) >= CtSteps) {
                return CtFlow.Failed(CtFail(context, statement, file, "compile-time evaluation exceeded 65536 steps"));
            }
            values.append(ExactWrapped(low, kind));
            low = ExactAdd(low, ExactOf(false, 1));
        }
    } else {
        switch CtEvalArray(context, package, file, frame, depth, Field(forest, statement, "value"), 0) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Value(item, other):
                return CtFlow.Failed(CtFail(context, statement, file, "only an array can be iterated at compile time"));
            case .Elements(items, storage):
                values = items;
                kind = storage;
        }
    }
    mark := length(frame.names);
    position: int = 0;
    while (position < length(values)) {
        if (!CtStep(context, statement, file)) {
            return CtFlow.Failed(CtFail(context, statement, file, "compile-time evaluation exceeded 65536 steps"));
        }
        at := position;
        if (reverse) {
            at = length(values) - 1 - position;
        }
        if (key >= 0) {
            frame.names.append(Text(forest, text, key));
            frame.bits.append(u64(at));
            frame.storages.append(IntStorage);
            CtAddRow(frame, []);
        }
        frame.names.append(name);
        frame.bits.append(values[at]);
        frame.storages.append(kind);
        CtAddRow(frame, []);
        position += 1;
        switch CtBlock(context, package, file, frame, depth, function, Members(forest, Field(forest, statement, "body"))) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Returned(value, storage):
                CtDrop(frame, mark);
                return CtFlow.Returned(value, storage);
            case .ReturnedElements(items, storage):
                CtDrop(frame, mark);
                return CtFlow.ReturnedElements(items, storage);
            case .Broke:
                CtDrop(frame, mark);
                return CtFlow.Normal;
            case .Normal:
                CtDrop(frame, mark);
            case .Continued:
                CtDrop(frame, mark);
        }
    }
    CtDrop(frame, mark);
    return CtFlow.Normal;
}
// Folds the value of a constant whose expression calls authored functions:
// each call runs first and stands for its value.
FoldCalling :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], links: graph.Binding[],
                callables: Callable[], params: Param[], constants: ConstDecl[], package: int, file: int,
                node: int, storage: int) -> Folding {
    text := documents[file].text;
    aliases := Aliases(links, file);
    context: CtContext = {forest: forest, documents: documents, links: links, callables: callables, params: params,
                          constants: constants, steps: 0};
    frame: CtFrame = {names: [], bits: [], storages: [], arrays: []};
    reads: int[] = [];
    CtCollect(&context, package, file, node, &reads);
    if (length(reads) == 0) {
        return FoldConstant(forest, text, file, constants, aliases, package, node, storage);
    }
    memo: ConstDecl[] = [];
    for (read in reads) {
        switch CtRead(&context, package, file, &frame, 0, read) {
            case .Failed(diagnostic):
                return Folding.Failed(diagnostic);
            case .Waiting:
                return Folding.Waiting;
            case .Elements(values, kind):
                return Folding.Failed(Diagnose(forest, read, file, "constant value must be an integer expression"));
            case .Value(value, result):
                placed: ConstDecl = {name: "", package: package, storage: result, bits: value, node: read, file: file,
                                     folded: true, occurrence: 0};
                memo.append(placed);
        }
    }
    scope := memo;
    scope.extend(constants);
    return FoldConstant(forest, text, file, scope, aliases, package, node, storage);
}
