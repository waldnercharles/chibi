package facts
@error Failure :: struct { code: int; }
Read :: () -> (value: int, error: Failure?) { return(7, {code: 3}); }
Forward :: () -> (value: int, error: Failure?) { result := Read(); value = result.value; error = result.error; return; }
Use :: () -> int { result := Forward(); if result.error {} return result.value; }
