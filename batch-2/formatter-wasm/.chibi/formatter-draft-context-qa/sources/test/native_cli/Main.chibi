package native_cli_test

import os "core:os"
import strings "core:strings"

// A real native CLI and its LLVM folder, plus a fresh scratch directory, are
// supplied by the build selector. Every command below compiles and runs native code.
Main :: () -> int {
    arguments := os.Arguments();
    if (length(arguments) != 3) {
        os.Print("usage: native-cli-test CHIBI LLVM SCRATCH");
        return 2;
    }
    chibi := arguments[0];
    llvm := arguments[1];
    scratch := arguments[2];
    assert(os.IsDirectory(scratch), "scratch directory exists");
    version := os.Capture([chibi, "version"]);
    assert(version.status == 0 && strings.HasPrefix(version.stdout, "chibi native\n"), "native version uses stdout");
    help := os.Capture([chibi, "--help"]);
    assert(help.status == 0 && strings.HasPrefix(help.stdout, "Usage: chibi"), "CLI help uses the CLI dispatch");

    source := strings.Concatenate([scratch, "/main with spaces.chibi"]);
    text := "package sample\nimport os \"core:os\"\n\nHelper :: () -> int { return 99; }\nMain :: () -> int {\n    arguments := os.Arguments();\n    assert(length(arguments) == 3, \"three arguments\");\n    assert(arguments[0] == \"first\" && arguments[1] == \"a b\" && arguments[2] == \"--watch\", \"arguments survive\");\n    os.WriteOutput(\"native run\\n\");\n    return 7;\n}\n";
    Write(source, text);
    ran := os.Capture([chibi, "run", "-O0", "--llvm", llvm, source, "--", "first", "a b", "--watch"]);
    assert(ran.status == 7 && ran.stdout == "native run\n", "run selects Main and passes arguments and exit status");
    Write(source, "package sample\nimport os \"core:os\"\nMain :: () { os.WriteOutput(\"void entry\\n\"); return; }\n");
    void_run := os.Capture([chibi, "run", "-O0", "--llvm", llvm, source]);
    assert(void_run.status == 0 && void_run.stdout == "void entry\n", "a void Main runs and exits successfully");
    ScopedRuns(chibi, llvm, scratch);
    invalid := os.Capture([chibi, "run", "--llvm"]);
    assert(invalid.status == 2 && strings.Contains(invalid.stderr, "--llvm needs a nonempty value"), "missing option value is diagnosed");

    build_source := strings.Concatenate([scratch, "/BuildProgram.chibi"]);
    Write(build_source, "package sample\nHelper :: () -> int { return 99; }\nMain :: () -> int { return 3; }\n");
    built := os.Capture([chibi, "build", "--native", "-O0", "--llvm", llvm, build_source]);
    assert(built.status == 0, "native build compiles a file at O0");
    again := os.Capture([chibi, "build", "--native", "-O0", "--llvm", llvm, build_source]);
    assert(again.status == 0 && strings.Contains(again.stderr, "is up to date"), "native build reuses its verified output");
    if (os.Platform() == "Linux") {
        library_source := strings.Concatenate([scratch, "/Library.chibi"]);
        Write(library_source, "Probe :: library { Main :: () -> int { return 42; } }\n");
        shared := os.Capture([chibi, "build", "--native", "-O0", "--shared", "--llvm", llvm, library_source]);
        assert(shared.status == 0, "native CLI builds a shared library without selecting a program entry");
    }

    tests := strings.Concatenate([scratch, "/tests"]);
    made := os.MakeDirectory(tests);
    assert(made == nil, "make test package");
    test_source := strings.Concatenate([tests, "/SampleTests.chibi"]);
    Write(test_source, "package checks\n@test\nPass :: () { value: int = 2; assert(value + 2 == 4, \"arithmetic\"); }\n@test\nFail :: () { assert(false, \"expected failure\"); }\n");
    tested := os.Capture([chibi, "test", "-O0", "--llvm", llvm, tests]);
    assert(tested.status == 1, "a failed native test fails the command");
    assert(strings.Contains(tested.stdout, "PASS project.Pass") && strings.Contains(tested.stdout, "FAIL project.Fail"), "test outcomes include both isolated processes");
    assert(strings.Contains(tested.stdout, "expected failure") && strings.Contains(tested.stdout, "2 tests, 1 failed"), "native assertion retains source diagnostic and totals");
    Write(test_source, " \tpackage\tchecks\n@test\n// A comment does not detach the attribute.\nPass :: () { value: int = 2; assert(value + 2 == 4, \"arithmetic\"); }\n");
    passed := os.Capture([chibi, "test", "-O0", "--llvm", llvm, tests]);
    assert(passed.status == 0 && strings.Contains(passed.stdout, "1 tests, 0 failed"), "a native test suite succeeds");
    if (os.Platform() != "Windows") {
        environment := os.FindExecutable("env");
        without_path := os.Capture([environment, "PATH=", chibi, "test", "-O0", "--llvm", llvm, tests]);
        assert(without_path.status == 0 && strings.Contains(without_path.stdout, "1 tests, 0 failed"), "native tests need no host commands in PATH");
    }
    Write(test_source, "package checks\n@test\nInvalid :: (argument: int) {}\n");
    malformed := os.Capture([chibi, "test", "-O0", "--llvm", llvm, tests]);
    assert(malformed.status == 1 && strings.Contains(malformed.stderr, "A @test function takes no parameters and returns nothing"), "invalid test attributes are rejected");
    Write(test_source, "package facts\nBuild :: () -> int[] { xs: int[] = []; xs = xs.append(1); return xs; }\n\n// error: 2:45: append changes the array; call it as a statement on a name\n");
    expected := os.Capture([chibi, "test", "-O0", "--llvm", llvm, tests]);
    assert(expected.status == 0 && strings.Contains(expected.stdout, "PASS project.compile_error"), "compile-error tests compare native source coordinates");

    Write(test_source, "package checks\n@test\nMissingTest :: () { Missing(); }\n");
    bad_test := os.Capture([chibi, "test", "-O0", "--llvm", llvm, tests]);
    assert(bad_test.status == 1 && strings.Contains(bad_test.stderr,
        strings.Concatenate([os.RealPath(test_source), ":3:21: Unknown function 'Missing'"])), "test compile failures name the physical source and column");

    Write(source, "package broken\nMain :: () -> int { return Missing(); }\n");
    rejected := os.Capture([chibi, "run", "--llvm", llvm, source]);
    assert(rejected.status == 1 && rejected.stdout == "" && strings.Contains(rejected.stderr, "native: rejected"), "rejected source cannot execute a stale program");
    assert(strings.Contains(rejected.stderr, strings.Concatenate([os.RealPath(source), ":2:28: Unknown function 'Missing'"])),
        "a standalone compile failure names its physical source and column");
    if (os.Platform() != "Windows") {
        output := strings.Concatenate([scratch, "/relative-rejection"]);
        Write(output, "original output");
        relative := InFolder(scratch, [chibi, "--compiler", ".", "--core", os.Getenv("CHIBI_CORE"),
            "--source", "main with spaces.chibi", "--entry", "Main", "--emit-llvm", "--output", output]);
        assert(relative.status == 1 && strings.Contains(relative.stderr,
            strings.Concatenate([os.RealPath(source), ":2:28: Unknown function 'Missing'"])), "relative low-level source paths report their physical origin");
        assert(os.ReadText(output).text == "original output", "relative source rejection preserves the output");
    }
    os.Print("native CLI: run, build cache, arguments, assertions and rejections passed");
    return 0;
}

Write :: (path: string, text: string) {
    written := os.WriteText(path, text);
    assert(written == nil, "write fixture source");
}

InFolder :: (folder: string, command: string[]) -> os.Result {
    arguments := ["/bin/sh", "-c", "cd \"$1\" && shift && exec \"$@\"", "chibi-cli-directory", folder];
    arguments.extend(command);
    return os.Capture(arguments);
}

// Graph tools need a named entry, checkout project imports and independent
// collection bindings while keeping source files in their owning directories.
ScopedRuns :: (chibi: string, llvm: string, scratch: string) {
    root := strings.Concatenate([scratch, "/project scope"]);
    collection_root := strings.Concatenate([scratch, "/collection scope"]);
    for (folder in [root, strings.Concatenate([root, "/facts"]), strings.Concatenate([root, "/sub"]),
                   collection_root, strings.Concatenate([collection_root, "/facts"])]) {
        made := os.MakeDirectory(folder);
        assert(made == nil, "scoped directory");
    }
    Write(strings.Concatenate([root, "/facts/Facts.chibi"]), "package facts\npub Value :: () -> int { return 20; }\n");
    Write(strings.Concatenate([collection_root, "/facts/Facts.chibi"]), "package external_facts\npub Value :: () -> int { return 22; }\n");
    source := strings.Concatenate([scratch, "/ScopedEntry.chibi"]);
    Write(source, "package scoped\nimport facts \"project:facts\"\nimport extra \"extra:facts\"\nimport os \"core:os\"\nMain :: () -> int { return 99; }\nRun :: () -> int { args := os.Arguments(); assert(length(args) == 1 && args[0] == \"a b\", \"scoped argument\"); return facts.Value() + extra.Value(); }\n");
    command := [chibi, "run", "-O0", "--llvm", llvm, "--core", os.Getenv("CHIBI_CORE"), "--entry", "Run", "--root", root,
                "--collection", strings.Concatenate(["extra=", collection_root]), source, "--", "a b"];
    ran := os.Capture(command);
    if (ran.status != 42) { os.Print(ran.stderr); }
    assert(ran.status == 42 && ran.stdout == "", "entry and independent roots compile without moving sources");
    again := os.Capture(command);
    assert(again.status == 42, "scoped run reuses the program");
    Write(strings.Concatenate([root, "/sub/Main.chibi"]), "package consumer\nimport facts \"project:facts\"\nMain :: () -> int { return 99; }\nRun :: () -> int { return facts.Value() + Sibling(); }\n");
    Write(strings.Concatenate([root, "/sub/Sibling.chibi"]), "package consumer\nSibling :: () -> int { return 22; }\n");
    directory := os.Capture([chibi, "run", "-O0", "--llvm", llvm, "--entry", "Run", "--root", root,
                             strings.Concatenate([root, "/sub"])]);
    assert(directory.status == 42, "directory entry stays in its package under the chosen project root");
    duplicate := os.Capture([chibi, "run", "--llvm", llvm, "--collection", strings.Concatenate(["core=", collection_root]), source]);
    assert(duplicate.status == 2 && strings.Contains(duplicate.stderr, "unique name"), "duplicate collection is rejected");
    missing_core := os.Capture([chibi, "run", "--core"]);
    assert(missing_core.status == 2 && strings.Contains(missing_core.stderr, "--core needs a nonempty value"), "missing core is diagnosed");
    bad_core := os.Capture([chibi, "run", "--llvm", llvm, "--core", strings.Concatenate([scratch, "/absent core"]), source]);
    assert(bad_core.status == 2 && strings.Contains(bad_core.stderr, "cannot find core directory"), "an invalid explicit core cannot use the environment instead");
    missing := os.Capture([chibi, "run", "--entry"]);
    assert(missing.status == 2 && strings.Contains(missing.stderr, "--entry needs a nonempty value"), "missing named entry is diagnosed");
    imported := strings.Concatenate([collection_root, "/facts/Facts.chibi"]);
    Write(imported, "package external_facts\npub Value :: () -> int { return Missing(); }\n");
    bad_import := os.Capture(command);
    assert(bad_import.status == 1 && strings.Contains(bad_import.stderr,
        strings.Concatenate([os.RealPath(imported), ":2:33: Unknown function 'Missing'"])), "an imported compile failure names its physical collection path");
    Write(imported, "package external_facts\npub Value :: () -> int { return 22; }\n");
    local := strings.Concatenate([root, "/facts/Facts.chibi"]);
    Write(local, "package facts\npub Value :: () -> int { return Missing(); }\n");
    bad_local := os.Capture(command);
    assert(bad_local.status == 1 && strings.Contains(bad_local.stderr,
        strings.Concatenate([os.RealPath(local), ":2:33: Unknown function 'Missing'"])), "project imports use the project root rather than the external entry folder");
    output := strings.Concatenate([scratch, "/rejected-package"]);
    Write(output, "original output");
    bad_package := os.Capture([chibi, "--compiler", os.RealPath(root), "--core", os.Getenv("CHIBI_CORE"),
        "--package", "facts", "--entry", "Value", "--output", output, "--llvm", llvm]);
    assert(bad_package.status == 1 && strings.Contains(bad_package.stderr,
        strings.Concatenate([os.RealPath(local), ":2:33: Unknown function 'Missing'"])), "a package diagnostic does not repeat its package directory");
    assert(os.ReadText(output).text == "original output", "a rejected package preserves the existing output");
    if (os.Platform() != "Windows") {
        relative := InFolder(root, [chibi, "--compiler", ".", "--core", os.Getenv("CHIBI_CORE"),
            "--package", "facts", "--entry", "Value", "--output", output, "--llvm", llvm]);
        assert(relative.status == 1 && strings.Contains(relative.stderr,
            strings.Concatenate([os.RealPath(local), ":2:33: Unknown function 'Missing'"])), "relative low-level package roots report physical paths");
        assert(os.ReadText(output).text == "original output", "relative package rejection preserves the output");
    }
    Write(source, "package scoped\nHelper :: () -> int { return 42; }\n");
    absent := os.Capture([chibi, "run", "--llvm", llvm, "--entry", "Run", source]);
    assert(absent.status == 1 && strings.Contains(absent.stderr, "native: rejected Run:"),
        "a missing entry diagnostic names the requested entry");
}
