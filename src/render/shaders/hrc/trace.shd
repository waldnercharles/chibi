// Adapted from Neon-Swarm shaders/hrc/trace.shd; original source comments retained.
// DDA path-traces cascade levels 0..cutoff.
//
// For each thread, march along the ray from probe origin to target endpoint,
// stepping once per pixel boundary along the longest axis and accumulating
// radiance/optical-depth front-to-back. Stores τ (optical depth) instead of T.

layout(set = 0, binding = 0) uniform sampler2D u_emission;
layout(set = 0, binding = 1) uniform sampler2D u_transmittance;
layout(set = 0, binding = 2) uniform sampler2D u_bounce;

layout(set=0,binding=3) uniform sampler2D u_optical_source;

layout(std430, set = 1, binding = 0) writeonly buffer OutBuf { uvec2 data[]; } u_out;

layout(set = 2, binding = 0) uniform Params
{
	int u_cascade;
	int u_rotate;
	int u_world_w;
	int u_world_h;
	int u_work_w;
	int u_work_h;
	float u_step_scale;
	float u_bounce_intensity;
	int u_medium;
	float u_pixel_size;
    int u_optics;
};

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#include "hrc_common.shd"

vec2 rotate_pos(vec2 p, int rot, int w, int h)
{
	if (rot == 1)      return vec2(float(w - 1) - p.y, p.x);
	else if (rot == 2) return vec2(float(w - 1) - p.x, float(h - 1) - p.y);
	else if (rot == 3) return vec2(p.y, float(h - 1) - p.x);
	return p;
}

vec2 rotate_dir(vec2 d, int rot)
{
	if (rot == 1)      return vec2(-d.y, d.x);
	else if (rot == 2) return vec2(-d.x, -d.y);
	else if (rot == 3) return vec2(d.y, -d.x);
	return d;
}

void main()
{
	int step = 1 << u_cascade;
	int directions = step + 1;
	int cascade_w = (u_world_w + step - 1) / step * directions;

	ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
	if (gid.x >= cascade_w || gid.y >= u_world_h) return;

	int probe_x = gid.x / directions;
	int k = gid.x - probe_x * directions;

	// Ray endpoints in rotated cascade space.
	float y_offset = float(2 * k - step);
	vec2 ray_start = vec2(float(probe_x * step), float(gid.y));
	vec2 ray_end = vec2(float(probe_x * step + step), float(gid.y) + y_offset);

	// DDA: step once per pixel boundary along longest axis.
	vec2 segment = ray_end - ray_start;
	float intrv = max(max(abs(segment.x), abs(segment.y)), 1.0);
	vec2 delta = segment / intrv;
	float step_length = length(delta);

	// Pre-rotate start and delta to avoid per-step rotation.
	vec2 rot_start = rotate_pos(ray_start, u_rotate, u_work_w, u_work_h);
	vec2 rot_delta = rotate_dir(delta, u_rotate);

	// Clip iteration range to world bounds [-0.5, work_{w,h} - 0.5).
	float ii_lo = 0.0;
	float ii_hi = intrv;
	vec2 lo_bound = vec2(-0.5);
	vec2 hi_bound = vec2(float(u_work_w), float(u_work_h)) - 0.5;

	if (abs(rot_delta.x) > 1e-6) {
		float t0 = (lo_bound.x - rot_start.x) / rot_delta.x;
		float t1 = (hi_bound.x - rot_start.x) / rot_delta.x;
		ii_lo = max(ii_lo, min(t0, t1));
		ii_hi = min(ii_hi, max(t0, t1));
	} else if (rot_start.x < lo_bound.x || rot_start.x >= hi_bound.x) {
		ii_hi = -1.0;
	}

	if (abs(rot_delta.y) > 1e-6) {
		float t0 = (lo_bound.y - rot_start.y) / rot_delta.y;
		float t1 = (hi_bound.y - rot_start.y) / rot_delta.y;
		ii_lo = max(ii_lo, min(t0, t1));
		ii_hi = min(ii_hi, max(t0, t1));
	} else if (rot_start.y < lo_bound.y || rot_start.y >= hi_bound.y) {
		ii_hi = -1.0;
	}

	ii_lo = ceil(ii_lo);

	if (ii_lo >= ii_hi) {
		u_out.data[gid.y * cascade_w + gid.x] = f16_store(vec4(0, 0, 0, 0));
		return;
	}

	vec3 total_rad = vec3(0.0);
	float total_trn = 1.0;
	float total_tau = 0.0;

	float eps = 1.0 / 512.0;
	float dda_step = step_length * u_step_scale;
	vec2 inv_work = vec2(1.0) / vec2(textureSize(u_emission, 0));

	for (float ii = ii_lo; ii < ii_hi; ii += 1.0) {
		vec2 sample_pos = rot_start + rot_delta * ii;
		vec2 uv = (clamp(sample_pos, vec2(0.0), vec2(u_work_w - 1, u_work_h - 1)) + vec2(0.5)) * inv_work;

		vec4 emiss = texture(u_emission, uv);
		vec3 bounce = texture(u_bounce, uv).rgb * u_bounce_intensity;
		float tau = max(texture(u_transmittance, uv).r, 0.0);

		float tau_step = tau * dda_step;
		float T_step = exp(-tau_step);
		float opacity = 1.0 - T_step;
		vec3 rad = u_medium != 0 ? medium_emission(emiss, tau, dda_step, eps, u_pixel_size, opacity)
                                      : (opacity > eps ? opacity * emiss.rgb : emiss.rgb * dda_step);
		// Reflected light requires an interaction with matter. The emissive
		// fallback in nearly empty cells must never amplify temporal bounce.
        if (u_optics != 0) {
            vec2 source_uv=(clamp(sample_pos,vec2(0),vec2(u_work_w-1,u_work_h-1))+.5)/vec2(u_work_w,u_work_h);
            float integral=tau_step<.01?dda_step*(1-.5*tau_step):opacity/max(tau,1e-20);
            rad+=textureLod(u_optical_source,source_uv,0).rgb*u_pixel_size*integral;
        }
		rad += opacity * bounce;

		total_rad += total_trn * rad;
		total_trn *= T_step;
		total_tau += tau_step;
		if (total_trn < eps) break;
	}

	int out_idx = gid.y * cascade_w + gid.x;
	u_out.data[out_idx] = f16_store(vec4(total_rad, total_tau));
}
