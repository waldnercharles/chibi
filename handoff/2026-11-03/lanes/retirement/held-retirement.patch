-        const script_catalog_field *x = &a->fields[i], *y = &b->fields[i];
-        if (x->id != y->id || !same_text(x->name, y->name) ||
-            !script_type_equal(x->type, y->type) || x->offset != y->offset ||
-            x->read != y->read || x->write != y->write || x->writable != y->writable) {
