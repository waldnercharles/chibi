behavior "ArenaShardBehavior" {
    owner "ecs.entity";
    state Age: float = 0.0;
    state "Pitch Rate": float = 0.0;
    state "Roll Rate": float = 0.0;
    state Lift: float = 0.0;
    state "Birth Scale": float = 1.0;
    value random_range = random_range(Min: -6.0, Max: 6.0);
    value random_range_2 = random_range(Min: -7.0, Max: 7.0);
    value random_range_3 = random_range(Min: 18.0, Max: 42.0);
    on Tick as tick() {
        await set_variable<"Age">(Value: float = (&state.Age + &delta));
        if ((cast<double>(&state.Age) + cast<double>(&delta)) / 0.55 >= 1) {
            destroy_entity(Entity: self);
        } else {
            "Advance Shard Motion"(Seconds: &delta, Age: &state.Age);
        }
    }
    on Begin as begin() {
        "Initialize Shard"(scale: &component("GAME.GameVisualTransform", "scale"), "Pitch Rate": random_range, "Roll Rate": random_range_2, Lift: random_range_3);
    }
    pure function "Age Phase"<T0: float, T1: float, T2: float>(Age: T0 = 0.0, Delta: T1 = 0.0) -> (Result: T2 = 0.0) {
        depth_limit 64;
        value add = add(A: double = entry.Age, B: double = entry.Delta);
        value real = real(Value: 0.55);
        value divide = divide(A: double = add, B: double = real);
        result Result: float = divide;
    }
    pure function "Fade"<T0: float, T1: double>(Phase: T0 = 0.0) -> (Result: T1 = 0.0) {
        depth_limit 64;
        value real = real(Value: 1.0);
        value subtract = subtract(A: double = real, B: double = entry);
        value real_2 = real(Value: 1.0);
        value subtract_2 = subtract(A: double = real_2, B: double = entry);
        value multiply = multiply(A: double = subtract, B: double = subtract_2);
        result Result: double = multiply;
    }
    pure function "Position X"<T0: float, T1: float, T2: float, T3: float>(PositionX: T0 = 0.0, VelocityX: T1 = 0.0, Delta: T2 = 0.0) -> (Result: T3 = 0.0) {
        depth_limit 64;
        value multiply = multiply(A: double = entry.VelocityX, B: double = entry.Delta);
        value add = add(A: float = entry.PositionX, B: double = multiply);
        result Result: float = add;
    }
    pure function "Position Y"<T0: float, T1: float, T2: float, T3: float>(PositionY: T0 = 0.0, VelocityY: T1 = 0.0, Delta: T2 = 0.0) -> (Result: T3 = 0.0) {
        depth_limit 64;
        value multiply = multiply(A: double = entry.VelocityY, B: double = entry.Delta);
        value add = add(A: float = entry.PositionY, B: double = multiply);
        result Result: float = add;
    }
    pure function "Pitch"<T0: float, T1: float, T2: float, T3: float>(Pitch: T0 = 0.0, PitchRate: T1 = 0.0, Delta: T2 = 0.0) -> (Result: T3 = 0.0) {
        depth_limit 64;
        value multiply = multiply(A: double = entry.PitchRate, B: double = entry.Delta);
        value add = add(A: float = entry.Pitch, B: double = multiply);
        result Result: float = add;
    }
    pure function "Roll"<T0: float, T1: float, T2: float, T3: float>(Roll: T0 = 0.0, RollRate: T1 = 0.0, Delta: T2 = 0.0) -> (Result: T3 = 0.0) {
        depth_limit 64;
        value multiply = multiply(A: double = entry.RollRate, B: double = entry.Delta);
        value add = add(A: float = entry.Roll, B: double = multiply);
        result Result: float = add;
    }
    function "Initialize Shard"(scale: float = 0.0, "Pitch Rate": double = 0.0, "Roll Rate": double = 0.0, Lift: double = 0.0) -> () {
        depth_limit 64;
        after entry {
            await set_variable<"Birth Scale">(Value: float = entry.scale);
            await set_variable<"Pitch Rate">(Value: float = entry."Pitch Rate");
            await set_variable<"Roll Rate">(Value: float = entry."Roll Rate");
            await set_variable<"Lift">(Value: float = entry.Lift);
            return();
        }
    }
    function "Advance Shard Motion"(Seconds: float = 0.0, Age: float = 0.0) -> () {
        depth_limit 64;
        value age_phase = "Age Phase"(Age: float = entry.Age, Delta: float = &local.Seconds);
        value elevation_lift_seconds: double = (cast<double>(&component("GAME.GameGeometry3D", "elevation")) + cast<double>(&state.Lift) * entry.Seconds);
        value lift_90_seconds = "Lift - 90 * Seconds"(Lift: double = &state.Lift, Seconds: float = entry.Seconds);
        local Seconds = entry.Seconds;
        after entry {
            await set_component(Component: "GAME.GameTransform", Entity: 0, Value.x: float = "Position X"(PositionX: float = &component("GAME.GameTransform", "x"), VelocityX: float = &component("GAME.GameVelocity", "x"), Delta: float = &local.Seconds), Value.y: float = "Position Y"(PositionY: float = &component("GAME.GameTransform", "y"), VelocityY: float = &component("GAME.GameVelocity", "y"), Delta: float = &local.Seconds));
            await set_component(Component: "GAME.GameVisualTransform", Entity: 0, Value.pitch: float = Pitch(Pitch: float = &component("GAME.GameVisualTransform", "pitch"), PitchRate: float = &state."Pitch Rate", Delta: float = &local.Seconds), Value.roll: float = Roll(Roll: float = &component("GAME.GameVisualTransform", "roll"), RollRate: float = &state."Roll Rate", Delta: float = &local.Seconds), Value.scale: float = multiply(A: float = &state."Birth Scale", B: double = Fade(Phase: float = age_phase)));
            await set_game_geometry3_d_elevation(Value: elevation_lift_seconds, Target: 0);
            await set_variable<"Lift">(Value: float = lift_90_seconds);
            return();
        }
    }
    pure function "Lift - 90 * Seconds"<T0: double, T1: float, T2: double>(Lift: T0 = 0.0, Seconds: T1 = 0.0) -> (Result: T2 = 0.0) {
        depth_limit 64;
        value real = real(Value: 90.0);
        value multiply = multiply(A: double = real, B: double = entry.Seconds);
        value subtract = subtract(A: double = entry.Lift, B: double = multiply);
        result Result: double = subtract;
    }
}
