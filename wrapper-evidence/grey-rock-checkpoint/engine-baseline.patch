+#include "runtime/geometry/material_surface_mesh.h"
+
+#include "runtime/shaders/effects.h"
+#include "support/array.h"
+#include "support/xalloc.h"
+
+#include <float.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum
+{
+    SURFACE_CORNER_LIMIT = 3000000
+};
+typedef struct
+{
+    material_occupancy_view view;
+    MaterialSurface3D options;
+    MaterialFrame frame;
+    const material_surface_height *height;
+    render_mesh_asset mesh;
+    int *slots, slot_count;
+    bool failed;
+    bool sample_failed;
+} builder;
+
+static float sample(material_occupancy_view v, int x, int y)
+{
+    bool solid;
+    float d;
+    if (material_occupancy_sample(v, x, y, &solid, &d)) {
+        return d;
+    }
+    int cx = x < 0 ? 0 : x >= v.width ? v.width - 1 : x;
+    int cy = y < 0 ? 0 : y >= v.height ? v.height - 1 : y;
+    if (material_occupancy_sample(v, x, cy, &solid, &d) ||
+        material_occupancy_sample(v, cx, y, &solid, &d)) {
+        return d;
+    }
+    material_occupancy_sample(v, cx, cy, &solid, &d);
+    return d;
+}
+static float distance_at(builder *b, CF_V2 p)
+{
+    float x = p.x / b->view.cell_size + b->view.width * .5f - .5f;
+    float y = p.y / b->view.cell_size + b->view.height * .5f - .5f;
+    int ix = (int)floorf(x), iy = (int)floorf(y);
+    float tx = x - ix, ty = y - iy;
+    float a = sample(b->view, ix, iy), c = sample(b->view, ix, iy + 1);
+    return (a + tx * (sample(b->view, ix + 1, iy) - a)) * (1 - ty) +
+           (c + tx * (sample(b->view, ix + 1, iy + 1) - c)) * ty;
+}
+static CF_V2 material_point(builder *b, CF_V2 p)
+{
+    float c = cosf(b->frame.radians), s = sinf(b->frame.radians);
+    return (CF_V2){ b->frame.x + c * p.x - s * p.y, b->frame.y + s * p.x + c * p.y };
+}
+static float height_at(builder *b, CF_V2 p)
+{
+    if (b->failed) {
+        return 0;
+    }
+    MaterialSurface3D o = b->options;
+    CF_V2 q = material_point(b, p);
+    float displacement = NAN;
+    if (b->height) {
+        if (!b->height->sample(b->height->context, q, &displacement) ||
+            !isfinite(displacement) || fabsf(displacement) >= o.depth) {
+            b->failed = b->sample_failed = true;
+            return 0;
+        }
+    } else {
+        float point[3] = { q.x / o.relief_scale,
+                           q.y / o.relief_scale,
+                           (float)(o.seed % 4096u) };
+        displacement = o.relief * (2 * (.57f * shader_noise(point, 3, 1) +
+                                        .28f * shader_noise(point, 3, 2) +
+                                        .15f * shader_noise(point, 3, 4)) -
+                                   1);
+    }
+    float t = o.bevel_width > 0
+                ? fminf(1, fmaxf(0, -distance_at(b, p) / o.bevel_width))
+                : 1;
+    t = t * t * (3 - 2 * t);
+    return o.elevation - fminf(o.depth * .5f, o.bevel_width) * (1 - t) +
+           displacement * t;
+}
+static render_mesh_surface_vertex vertex(builder *b, CF_V2 p)
+{
+    float e = b->view.cell_size * .01f;
+    double dx = ((double)height_at(b, (CF_V2){ p.x + e, p.y }) -
+                 height_at(b, (CF_V2){ p.x - e, p.y })) /
+                (2.0 * e);
+    double dz = ((double)height_at(b, (CF_V2){ p.x, p.y + e }) -
+                 height_at(b, (CF_V2){ p.x, p.y - e })) /
+                (2.0 * e);
+    double length = sqrt(dx * dx + dz * dz + 1);
+    CF_V2 q = material_point(b, p);
+    float c = cosf(b->frame.radians), s = sinf(b->frame.radians);
+    render_mesh_surface_vertex v = {
+        .position = { p.x, height_at(b, p), p.y },
+        .normal = { (float)(-dx / length), (float)(1 / length), (float)(-dz / length) },
+        .uv = { q.x / b->options.relief_scale, q.y / b->options.relief_scale },
+        .part_position = { q.x, height_at(b, p), q.y },
+        .part_from_object = { { c, 0, -s }, { 0, 1, 0 }, { s, 0, c } }
+    };
+    return v;
+}
+static unsigned vertex_hash(const render_mesh_surface_vertex *v)
+{
+    unsigned hash = 2166136261u;
+    const unsigned char *bytes = (const unsigned char *)v;
+    for (size_t i = 0; i < sizeof *v; i++) {
+        hash = (hash ^ bytes[i]) * 16777619u;
+    }
+    return hash;
+}
+static int vertex_index(builder *b, render_mesh_surface_vertex v)
+{
+    if (2 * (acount(b->mesh.vertices) + 1) >= b->slot_count) {
+        b->slot_count = b->slot_count ? b->slot_count * 2 : 256;
+        free(b->slots);
+        b->slots = xcalloc((size_t)b->slot_count, sizeof *b->slots);
+        for (int i = 0; i < acount(b->mesh.vertices); i++) {
+            unsigned slot = vertex_hash(&b->mesh.vertices[i]) &
+                            (unsigned)(b->slot_count - 1);
+            while (b->slots[slot]) {
+                slot = (slot + 1) & (unsigned)(b->slot_count - 1);
+            }
+            b->slots[slot] = i + 1;
+        }
+    }
+    unsigned slot = vertex_hash(&v) & (unsigned)(b->slot_count - 1);
+    while (b->slots[slot]) {
+        int index = b->slots[slot] - 1;
+        if (!memcmp(&b->mesh.vertices[index], &v, sizeof v)) {
+            return index;
+        }
+        slot = (slot + 1) & (unsigned)(b->slot_count - 1);
+    }
+    int index = acount(b->mesh.vertices);
+    apush(b->mesh.vertices, v);
+    b->slots[slot] = index + 1;
+    CF_V3 p = v.position;
+    if (!index) {
+        b->mesh.min = b->mesh.max = p;
+    }
+    b->mesh.min.x = fminf(b->mesh.min.x, p.x);
+    b->mesh.max.x = fmaxf(b->mesh.max.x, p.x);
+    b->mesh.min.y = fminf(b->mesh.min.y, p.y);
+    b->mesh.max.y = fmaxf(b->mesh.max.y, p.y);
+    b->mesh.min.z = fminf(b->mesh.min.z, p.z);
+    b->mesh.max.z = fmaxf(b->mesh.max.z, p.z);
+    return index;
+}
+static void triangle(builder *b, render_mesh_surface_vertex a, render_mesh_surface_vertex c, render_mesh_surface_vertex d)
+{
+    if (b->failed) {
+        return;
+    }
+    if (acount(b->mesh.indices) + 3 > SURFACE_CORNER_LIMIT) {
+        b->failed = true;
+        return;
+    }
+    render_mesh_surface_vertex v[3] = { a, c, d };
+    for (int i = 0; i < 3; i++) {
+        int index = vertex_index(b, v[i]);
+        apush(b->mesh.indices, index);
+    }
+}
+static float length2(CF_V2 a, CF_V2 c)
+{
+    float x = a.x - c.x, y = a.y - c.y;
+    return x * x + y * y;
+}
+static void top(builder *b, CF_V2 a, CF_V2 c, CF_V2 d, int level)
+{
+    float lengths[3] = { length2(a, c), length2(c, d), length2(d, a) };
+    int edge = lengths[1] > lengths[0] ? 1 : 0;
+    if (lengths[2] > lengths[edge]) {
+        edge = 2;
+    }
+    if (lengths[edge] <= b->options.spacing * b->options.spacing) {
+        float area = (c.x - a.x) * (d.y - a.y) - (c.y - a.y) * (d.x - a.x);
+        if (fabsf(area) > 1e-12f) {
+            triangle(b, vertex(b, a), vertex(b, d), vertex(b, c));
+        }
+        return;
+    }
+    if (level >= 24 || b->failed) {
+        b->failed = true;
+        return;
+    }
+    CF_V2 points[3] = { a, c, d };
+    a = points[edge];
+    c = points[(edge + 1) % 3];
+    d = points[(edge + 2) % 3];
+    CF_V2 mid = { (a.x + c.x) * .5f, (a.y + c.y) * .5f };
+    top(b, a, mid, d, level + 1);
+    top(b, mid, c, d, level + 1);
+}
+static void wall(builder *b, CF_V2 a, CF_V2 c)
+{
+    float dx = c.x - a.x, dy = c.y - a.y, l = sqrtf(dx * dx + dy * dy);
+    if (l <= 1e-6f) {
+        return;
+    }
+    CF_V2 middle = { (a.x + c.x) * .5f, (a.y + c.y) * .5f };
+    float epsilon = b->view.cell_size * .01f;
+    CF_V2 outside = { middle.x + dy / l * epsilon, middle.y - dx / l * epsilon };
+    float hx = b->view.width * b->view.cell_size * .5f,
+          hy = b->view.height * b->view.cell_size * .5f;
+    bool boundary = fabsf(middle.x) >= hx - 1e-5f || fabsf(middle.y) >= hy - 1e-5f;
+    if (distance_at(b, outside) <= 0 && !boundary) {
+        return;
+    }
+    if (boundary) {
+        int x = (int)floorf(outside.x / b->view.cell_size + b->view.width * .5f);
+        int y = (int)floorf(outside.y / b->view.cell_size + b->view.height * .5f);
+        bool solid;
+        float distance;
+        if (material_occupancy_sample(b->view, x, y, &solid, &distance) && solid) {
+            return;
+        }
+        /* A streamed unavailable neighbor must not become an invented wall. */
+        if (b->view.halo_radius &&
+            !material_occupancy_sample(b->view, x, y, &solid, &distance)) {
+            return;
+        }
+    }
+    float *cuts = NULL;
+    apush(cuts, 0);
+    apush(cuts, 1);
+    for (int i = 1; i < b->view.width; i++) {
+        float t = (i * b->view.cell_size - hx - a.x) / dx;
+        if (t > 0 && t < 1) {
+            apush(cuts, t);
+        }
+    }
+    for (int i = 1; i < b->view.height; i++) {
+        float t = (i * b->view.cell_size - hy - a.y) / dy;
+        if (t > 0 && t < 1) {
+            apush(cuts, t);
+        }
+    }
+    int count = acount(cuts);
+    for (int i = 1; i < count; i++) {
+        float t = cuts[i];
+        int j = i;
+        while (j && cuts[j - 1] > t) {
+            cuts[j] = cuts[j - 1];
+            j--;
+        }
+        cuts[j] = t;
+    }
+    for (int i = 0; i + 1 < count; i++) {
+        if (cuts[i + 1] - cuts[i] < 1e-6f) {
+            continue;
+        }
+        CF_V2 p = { a.x + dx * cuts[i], a.y + dy * cuts[i] },
+              q = { a.x + dx * cuts[i + 1], a.y + dy * cuts[i + 1] };
+        render_mesh_surface_vertex u = vertex(b, p), v = vertex(b, q), w = v, z = u;
+        u.normal = v.normal = w.normal = z.normal = (CF_V3){ dy / l, 0, -dx / l };
+        w.position.y = z.position.y = b->options.elevation - b->options.depth;
+        w.part_position.y = w.position.y;
+        z.part_position.y = z.position.y;
+        triangle(b, u, v, w);
+        triangle(b, u, w, z);
+    }
+    afree(cuts);
+}
+static void polygon_top(builder *b, material_polygon p)
+{
+    float cell = b->view.cell_size, hx = b->view.width * cell * .5f,
+          hy = b->view.height * cell * .5f;
+    float minx = p.points[0], maxx = minx, miny = p.points[1], maxy = miny;
+    for (int i = 1; i < p.count; i++) {
+        minx = fminf(minx, p.points[2 * i]);
+        maxx = fmaxf(maxx, p.points[2 * i]);
+        miny = fminf(miny, p.points[2 * i + 1]);
+        maxy = fmaxf(maxy, p.points[2 * i + 1]);
+    }
+    int x0 = (int)floorf((minx + hx) / cell), x1 = (int)ceilf((maxx + hx) / cell);
+    int y0 = (int)floorf((miny + hy) / cell), y1 = (int)ceilf((maxy + hy) / cell);
+    for (int y = y0; y < y1; y++) {
+        for (int x = x0; x < x1; x++) {
+            CF_V2 a[16], c[16];
+            int n = p.count;
+            for (int i = 0; i < n; i++) {
+                a[i] = (CF_V2){ p.points[2 * i], p.points[2 * i + 1] };
+            }
+            float bounds[4] = { x * cell - hx,
+                                (x + 1) * cell - hx,
+                                y * cell - hy,
+                                (y + 1) * cell - hy };
+            for (int plane = 0; plane < 4 && n; plane++) {
+                int count = 0, axis = plane / 2;
+                float bound = bounds[plane];
+                for (int i = 0, j = n - 1; i < n; j = i++) {
+                    float u = axis ? a[j].y : a[j].x, v = axis ? a[i].y : a[i].x;
+                    bool in = plane % 2 ? u <= bound : u >= bound,
+                         next = plane % 2 ? v <= bound : v >= bound;
+                    if (in != next) {
+                        float t = (bound - u) / (v - u);
+                        c[count++] = (CF_V2){ a[j].x + t * (a[i].x - a[j].x),
+                                              a[j].y + t * (a[i].y - a[j].y) };
+                    }
+                    if (next) {
+                        c[count++] = a[i];
+                    }
+                }
+                n = count;
+                for (int i = 0; i < n; i++) {
+                    a[i] = c[i];
+                }
+            }
+            for (int i = 1; i + 1 < n; i++) {
+                top(b, a[0], a[i], a[i + 1], 0);
+            }
+        }
+    }
+}
+bool material_surface_mesh_build_height(
+    material_occupancy_view view,
+    MaterialSurface3D options,
+    MaterialFrame frame,
+    const material_surface_height *height,
+    render_mesh_asset *output,
+    char *error,
+    size_t size
+)
+{
+    float values[] = { options.elevation,
+                       options.depth,
+                       options.bevel_width,
+                       options.relief,
+                       options.relief_scale,
+                       options.spacing,
+                       frame.x,
+                       frame.y,
+                       frame.radians };
+    bool valid = view.width > 0 && view.height > 0 && view.width <= 65536 &&
+                 view.height <= 65536 &&
+                 (double)view.width * view.height <= 1048576 && view.cells &&
+                 view.distance && isfinite(view.cell_size) && view.cell_size > 0;
+    for (int i = 0; i < 9; i++) {
+        valid = valid && isfinite(values[i]) &&
+                fabsf(values[i]) <= sqrtf(FLT_MAX) / 16;
+    }
+    double extent = fmax(view.width, view.height) * (double)view.cell_size;
+    valid = valid && extent <= sqrtf(FLT_MAX) / 16 &&
+            view.cell_size * .01f > 0 && options.relief_scale > 0 &&
+            (extent + fabs(frame.x) + fabs(frame.y)) / options.relief_scale <
+                FLT_MAX / 16;
+    valid = valid && options.depth > 0 && options.bevel_width >= 0 &&
+            options.relief >= 0 && options.relief < options.depth &&
+            options.relief_scale > 0 && options.spacing >= view.cell_size;
+    if (!valid || (height && !height->sample)) {
+        snprintf(error, size, "MaterialSurface3D requires finite positive depth/scale/spacing and relief below depth on a bounded mask");
+        return false;
+    }
+    builder b = { .view = view, .options = options, .frame = frame, .height = height };
+    /* Reuse the exact published contour algorithm without owning its inputs.
+     * Only the rebuilt temporary rectangle/polygon arrays are released here. */
+    material_mask contour = { .width = view.width,
+                              .height = view.height,
+                              .cell_size = view.cell_size,
+                              .cells = (unsigned char *)view.cells,
+                              .distance = (float *)view.distance,
+                              .halo_cells = (unsigned char *)view.halo_cells,
+                              .halo_distance = (float *)view.halo_distance,
+                              .halo_radius = view.halo_radius };
+    material_mask_rebuild(&contour);
+    for (int i = 0; i < acount(contour.surface) && !b.failed; i++) {
+        material_polygon p = contour.surface[i];
+        polygon_top(&b, p);
+        for (int j = 0; j < p.count; j++) {
+            int k = (j + 1) % p.count;
+            wall(
+                &b,
+                (CF_V2){ p.points[2 * j], p.points[2 * j + 1] },
+                (CF_V2){ p.points[2 * k], p.points[2 * k + 1] }
+            );
+        }
+    }
+    afree(contour.rects);
+    afree(contour.surface);
+    free(b.slots);
+    if (b.failed) {
+        render_mesh_asset_free(&b.mesh);
+        snprintf(error, size, "%s", b.sample_failed ? "MaterialSurface3D height sampler failed or returned nonfinite/out-of-depth displacement" : "MaterialSurface3D geometry exceeds bounded tessellation budget");
+        return false;
+    }
+    render_mesh_asset_tangents(&b.mesh);
+    b.mesh.has_part_coordinates = true;
+    *output = b.mesh;
+    return true;
+}
+
+bool material_surface_mesh_build(
+    material_occupancy_view view,
+    MaterialSurface3D options,
+    MaterialFrame frame,
+    render_mesh_asset *output,
+    char *error,
+    size_t size
+)
+{
+    return material_surface_mesh_build_height(view, options, frame, NULL, output, error, size);
+}
diff --git a/src/runtime/geometry/material_surface_mesh.h b/src/runtime/geometry/material_surface_mesh.h
new file mode 100644
index 000000000..5fadd0078
--- /dev/null
+++ b/src/runtime/geometry/material_surface_mesh.h
@@ -0,0 +1,46 @@
+#ifndef CHIBI_MATERIAL_SURFACE_MESH_H
+#define CHIBI_MATERIAL_SURFACE_MESH_H
+
+#include "runtime/components.h"
+#include "runtime/geometry/mesh_asset.h"
+#include "runtime/material_mask.h"
+
+/* Immutable during one build. Samples signed world-unit displacement from
+ * options.elevation at retained MaterialFrame coordinates. Values must be finite
+ * and strictly between -depth and depth. False rejects the entire snapshot.
+ * The builder retains neither the descriptor nor context. No relief/noise gain
+ * is applied to sampled values; the contour bevel/taper still applies. */
+typedef struct
+{
+    bool (*sample)(void *context, CF_V2 material_point, float *height);
+    void *context;
+} material_surface_height;
+
+bool material_surface_mesh_build_height(
+    material_occupancy_view occupancy,
+    MaterialSurface3D options,
+    MaterialFrame frame,
+    const material_surface_height *height,
+    render_mesh_asset *output,
+    char *error,
+    size_t size
+);
+
+/* Derives an owned snapshot from published occupancy. Output starts zeroed;
+ * free with render_mesh_asset_free. Positions remain mask-local X/gameplay Z,
+ * elevation along Y. Frame selects stable relief/UV coordinates, not placement.
+ * No input storage is retained. Failure leaves output unchanged. Identity is
+ * assigned by the renderer, which owns cache invalidation and retirement.
+ * Admission: at most 1,048,576 input cells and 3,000,000 output corners.
+ * Spacing must be at least cell_size; contour support stays at source density.
+ * It is a shallow open-backed surface, not a separate solid-volume model. */
+bool material_surface_mesh_build(
+    material_occupancy_view occupancy,
+    MaterialSurface3D options,
+    MaterialFrame frame,
+    render_mesh_asset *output,
+    char *error,
+    size_t size
+);
+
+#endif
diff --git a/src/runtime/material_checkpoint.c b/src/runtime/material_checkpoint.c
new file mode 100644
index 000000000..f37604e32
--- /dev/null
+++ b/src/runtime/material_checkpoint.c
@@ -0,0 +1,324 @@
+#include "runtime/material_checkpoint.h"
+
+#include "runtime/fields/prepared.h"
+#include "runtime/material_terrain.h"
+#include "support/array.h"
+#include "support/xalloc.h"
+
+#include <assert.h>
+#include <float.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static_assert(
+    sizeof(int) == 4 && sizeof(float) == 4 && FLT_RADIX == 2 &&
+        FLT_MANT_DIG == 24 && FLT_MAX_EXP == 128,
+    "Terrain checkpoints require IEEE binary32"
+);
+static const unsigned char magic[8] = {
+    'C', 'H', 'B', 'I', 'T', 'C', 'P', MATERIAL_CHECKPOINT_VERSION
+};
+static uint64_t hash_bytes(uint64_t h, const void *data, size_t size)
+{
+    const unsigned char *bytes = data;
+    for (size_t i = 0; i < size; i++) {
+        h = (h ^ bytes[i]) * UINT64_C(1099511628211);
+    }
+    return h;
+}
+static void put32(unsigned char *p, uint32_t n)
+{
+    for (int i = 0; i < 4; i++) {
+        p[i] = (unsigned char)(n >> (8 * i));
+    }
+}
+static uint32_t get32(const unsigned char *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 |
+           (uint32_t)p[3] << 24;
+}
+static void put64(unsigned char *p, uint64_t n)
+{
+    put32(p, (uint32_t)n);
+    put32(p + 4, (uint32_t)(n >> 32));
+}
+static uint64_t get64(const unsigned char *p)
+{
+    return get32(p) | (uint64_t)get32(p + 4) << 32;
+}
+static uint32_t float_bits(float value)
+{
+    uint32_t bits;
+    /* Signed zero does not change generation. */
+    if (value == 0) {
+        value = 0;
+    }
+    memcpy(&bits, &value, 4);
+    return bits;
+}
+static float get_float(const unsigned char *p)
+{
+    uint32_t bits = get32(p);
+    float result;
+    memcpy(&result, &bits, 4);
+    return result;
+}
+static uint64_t hash_number(uint64_t h, uint32_t n)
+{
+    unsigned char bytes[4];
+    put32(bytes, n);
+    return hash_bytes(h, bytes, 4);
+}
+bool material_checkpoint_fingerprint(material_checkpoint_recipe recipe, uint64_t *out, char *error, size_t size)
+{
+    const field_program *program = material_field_program(recipe.fields, recipe.field);
+    if (!program) {
+        snprintf(error, size, "Terrain field is unavailable");
+        return false;
+    }
+    unsigned char *bytes;
+    size_t length;
+    if (!field_prepared_write(program, &bytes, &length, error, size)) {
+        return false;
+    }
+    /* Lowered field programs contain their resolved dependency code. Catalog
+     * revisions and unrelated fields never enter this durable identity. */
+    uint64_t hash = hash_bytes(UINT64_C(14695981039346656037), bytes, length);
+    free(bytes);
+    hash = hash_number(hash, recipe.context.seed);
+    for (int i = 0; i < field_program_parameter_count(program); i++) {
+        field_parameter parameter = field_program_parameter_at(program, i);
+        for (int j = 0; j < recipe.context.parameter_count; j++) {
+            if (!strcmp(parameter.name, recipe.context.parameters[j].name)) {
+                parameter.value = recipe.context.parameters[j].value;
+                break;
+            }
+        }
+        uint32_t kind, bits;
+        switch (parameter.value.type) {
+            case PIN_F32:
+                if (!isfinite(parameter.value.f)) {
+                    return false;
+                }
+                kind = 1;
+                bits = float_bits(parameter.value.f);
+                break;
+            case PIN_I32:
+                kind = 2;
+                bits = (uint32_t)parameter.value.i;
+                break;
+            case PIN_U32:
+                kind = 3;
+                bits = parameter.value.u;
+                break;
+            default: return false;
+        }
+        hash = hash_number(hash_number(hash, kind), bits);
+    }
+    const uint32_t settings[] = { recipe.grid.width,
+                                  recipe.grid.height,
+                                  float_bits(recipe.grid.cell_size),
+                                  float_bits(recipe.grid.center_x),
+                                  float_bits(recipe.grid.center_y),
+                                  recipe.connectivity,
+                                  recipe.border_cells,
+                                  recipe.island_cells,
+                                  recipe.streamed,
+                                  MATERIAL_TERRAIN_CHUNK_CELLS,
+                                  1 };
+    for (size_t i = 0; i < sizeof settings / sizeof *settings; i++) {
+        hash = hash_number(hash, settings[i]);
+    }
+    *out = hash;
+    return true;
+}
+
+material_mask *material_checkpoint_copy_mask(const material_mask *source, field_grid grid)
+{
+    size_t count = (size_t)grid.width * grid.height;
+    unsigned char *empty = NULL;
+    if (!source || !source->width) {
+        empty = xcalloc(count, 1);
+    }
+    material_mask *mask = xmalloc(sizeof *mask);
+    *mask = material_mask_copy_cells(
+        grid.width,
+        grid.height,
+        grid.cell_size,
+        empty ? empty : source->cells
+    );
+    free(empty);
+    mask->damage = xcalloc(count, sizeof(float));
+    if (source && source->width) {
+        assert(source->width == grid.width && source->height == grid.height);
+        memcpy(mask->cells, source->cells, count);
+        memcpy(mask->distance, source->distance, count * sizeof(float));
+        if (source->damage) {
+            memcpy(mask->damage, source->damage, count * sizeof(float));
+        }
+        mask->count = source->count;
+    }
+    return mask;
+}
+void material_checkpoint_free(material_checkpoint *checkpoint)
+{
+    for (int i = 0; i < acount(checkpoint->tiles); i++) {
+        material_mask_free(checkpoint->tiles[i].mask);
+        free(checkpoint->tiles[i].mask);
+    }
+    afree(checkpoint->tiles);
+    *checkpoint = (material_checkpoint){ 0 };
+}
+static bool valid_grid(field_grid g)
+{
+    return g.width > 0 && g.width <= MATERIAL_TERRAIN_CHUNK_CELLS && g.height > 0 &&
+           g.height <= MATERIAL_TERRAIN_CHUNK_CELLS && isfinite(g.cell_size) &&
+           g.cell_size > 0 && isfinite(g.center_x) && isfinite(g.center_y);
+}
+bool material_checkpoint_write(
+    const material_checkpoint *checkpoint,
+    const char *identity,
+    uint64_t recipe,
+    unsigned char **out,
+    size_t *length,
+    char *error,
+    size_t size
+)
+{
+    *out = NULL;
+    *length = 0;
+    size_t id_length = identity ? strlen(identity) : 0;
+    int count = acount(checkpoint->tiles);
+    if (!id_length || id_length > MATERIAL_CHECKPOINT_ID_MAX ||
+        count > MATERIAL_CHECKPOINT_MAX_TILES) {
+        goto fail;
+    }
+    size_t total = 32 + id_length;
+    for (int i = 0; i < count; i++) {
+        field_grid g = checkpoint->tiles[i].grid;
+        material_mask *mask = checkpoint->tiles[i].mask;
+        if (!valid_grid(g) || !mask ||
+            (mask->width && (mask->width != g.width || mask->height != g.height ||
+                             !mask->cells || !mask->distance))) {
+            goto fail;
+        }
+        total += 28 + (size_t)g.width * g.height * 9;
+    }
+    if (total > MATERIAL_CHECKPOINT_MAX_BYTES) {
+        goto fail;
+    }
+    unsigned char *bytes = xmalloc(total);
+    memcpy(bytes, magic, 8);
+    put64(bytes + 8, recipe);
+    put32(bytes + 16, (uint32_t)id_length);
+    put32(bytes + 20, (uint32_t)count);
+    memcpy(bytes + 24, identity, id_length);
+    size_t at = 24 + id_length;
+    for (int i = 0; i < count; i++) {
+        material_stream_tile tile = checkpoint->tiles[i];
+        field_grid g = tile.grid;
+        material_mask *m = tile.mask;
+        put64(bytes + at, tile.key);
+        put32(bytes + at + 8, g.width);
+        put32(bytes + at + 12, g.height);
+        put32(bytes + at + 16, float_bits(g.cell_size));
+        put32(bytes + at + 20, float_bits(g.center_x));
+        put32(bytes + at + 24, float_bits(g.center_y));
+        at += 28;
+        for (int j = 0; j < g.width * g.height; j++) {
+            float distance = m->width ? m->distance[j] : g.cell_size * .5f;
+            float damage = m->width && m->damage ? m->damage[j] : 0;
+            unsigned char cell = m->width ? m->cells[j] : 0;
+            if (cell > 1 || !isfinite(distance) || !isfinite(damage) || damage < 0) {
+                free(bytes);
+                goto fail;
+            }
+            bytes[at] = cell;
+            put32(bytes + at + 1, float_bits(distance));
+            put32(bytes + at + 5, float_bits(damage));
+            at += 9;
+        }
+    }
+    put64(bytes + at, hash_bytes(UINT64_C(14695981039346656037), bytes, at));
+    *out = bytes;
+    *length = total;
+    return true;
+fail:
+    snprintf(error, size, "Invalid terrain checkpoint or snapshot exceeds limits");
+    return false;
+}
+bool material_checkpoint_read(
+    const void *input,
+    size_t length,
+    const char *identity,
+    uint64_t recipe,
+    material_checkpoint *out,
+    char *error,
+    size_t size
+)
+{
+    material_checkpoint result = { 0 };
+    const unsigned char *bytes = input;
+    if (!bytes || !identity || length < 32 || length > MATERIAL_CHECKPOINT_MAX_BYTES ||
+        memcmp(bytes, magic, 8) || get64(bytes + 8) != recipe ||
+        get64(bytes + length - 8) !=
+            hash_bytes(UINT64_C(14695981039346656037), bytes, length - 8)) {
+        goto fail;
+    }
+    uint32_t id_length = get32(bytes + 16), count = get32(bytes + 20);
+    if (!id_length || id_length > MATERIAL_CHECKPOINT_ID_MAX ||
+        id_length > length - 32 || strlen(identity) != id_length ||
+        memcmp(bytes + 24, identity, id_length) ||
+        count > MATERIAL_CHECKPOINT_MAX_TILES) {
+        goto fail;
+    }
+    size_t at = 24 + id_length;
+    for (uint32_t i = 0; i < count; i++) {
+        if (length - 8 - at < 28) {
+            goto fail;
+        }
+        uint64_t key = get64(bytes + at);
+        field_grid g = { get32(bytes + at + 8),
+                         get32(bytes + at + 12),
+                         get_float(bytes + at + 16),
+                         get_float(bytes + at + 20),
+                         get_float(bytes + at + 24) };
+        if (!valid_grid(g)) {
+            goto fail;
+        }
+        for (int j = 0; j < acount(result.tiles); j++) {
+            if (result.tiles[j].key == key) {
+                goto fail;
+            }
+        }
+        at += 28;
+        size_t cells = (size_t)g.width * g.height;
+        if (cells * 9 > length - 8 - at) {
+            goto fail;
+        }
+        material_mask *m = material_checkpoint_copy_mask(NULL, g);
+        apush(result.tiles, ((material_stream_tile){ key, g, m }));
+        for (size_t j = 0; j < cells; j++) {
+            m->cells[j] = bytes[at];
+            m->distance[j] = get_float(bytes + at + 1);
+            m->damage[j] = get_float(bytes + at + 5);
+            if (m->cells[j] > 1 || !isfinite(m->distance[j]) ||
+                !isfinite(m->damage[j]) || m->damage[j] < 0) {
+                goto fail;
+            }
+            m->count += m->cells[j];
+            at += 9;
+        }
+    }
+    if (at != length - 8) {
+        goto fail;
+    }
+    *out = result;
+    return true;
+fail:
+    material_checkpoint_free(&result);
+    snprintf(error, size, "Terrain checkpoint is corrupt, incompatible, or exceeds limits");
+    return false;
+}
