package graph_discovery_tests

import engine "graph:engine"
import os "core:os"
import process "project:test/graph/native_process"
import programs "graph:programs"
import strings "core:strings"

// Toolchain discovery. Run builds fixture installations in a scratch directory
// and runs each check in its own native process with the selected environment.

Path :: (parts: string[]) -> string {
    return strings.Join(parts, "");
}
// Makes a directory and its parents.
Make :: (path: string) -> bool {
    return os.MakeDirectory(path) == nil;
}
Write :: (path: string, text: string) -> bool {
    return os.WriteText(path, text) == nil;
}

// An incomplete compiler may still have a C++ sibling, and platform search
// paths remain available without any compiler API library or builtin headers.
pub Drivers :: () -> int {
    root := os.Arguments()[0];
    libraries := Path([root, "/lib"]);
    made := os.MakeDirectory(libraries);
    assert(made == nil, "the library directory");
    sibling := Path([root, "/clang++-18"]);
    assert(Write(sibling, "") && engine.CxxCompiler(Path([root, "/clang-18"]), "Clang") == sibling, "the versioned C++ sibling");
    failing := os.FindExecutable("false");
    assert(failing != "" && os.Capture([failing]).status == 1, "a failing driver");
    shared := Path([libraries, "/libGraphDiscovery.so"]);
    assert(Write(shared, "") && engine.SystemLibrary(failing, "libGraphDiscovery.so") == shared, "a library on the search path");
    assert(engine.SystemLibrary(failing, "libAbsentGraphDiscovery.so") == "" && engine.SystemLibrary("", "libAbsentGraphDiscovery.so") == "", "an absent library");
    headers := Path([root, "/include"]);
    assert(Make(Path([headers, "/GL"])) && Write(Path([headers, "/GL/gl.h"]), "") && engine.OpenGLInclude() == headers, "OpenGL headers on the search path");
    return 0;
}

Toolchain :: struct { compiler: string; llvm: string; }

// Compile each entry once under the checkout's import scope. Relative
// discovery paths follow the child's actual cwd, including basename cases.
Check :: (toolchain: Toolchain, environment: string[], root: string, name: string, arguments: string[]) {
    source := os.Root();
    command := ["env"];
    command.extend(environment);
    program := programs.Build(source, toolchain.compiler, toolchain.llvm, "test/graph/DiscoveryTests.chibi", name, ["graph=tools/graph"]);
    assert(program != "", "the discovery entry compiles natively");
    command.extend(["/bin/sh", "-c", "cd \"$1\" && shift && exec \"$@\"", "graph-discovery", root, program]);
    command.extend(arguments);
    result := process.Capture(command, 30000);
    if (result.status != 0) {
        os.Print(format_text("{0} failed: {1}{2}", name, result.stdout, result.stderr));
    }
    assert(result.status == 0, "a discovery check");
}

// The selector supplies the native compiler and LLVM directory.
pub Run :: () -> int {
    arguments := os.Arguments();
    assert(length(arguments) == 2, "the native compiler and LLVM directory");
    toolchain: Toolchain = {compiler: os.RealPath(arguments[0]), llvm: os.RealPath(arguments[1])};
    assert(toolchain.compiler != "" && toolchain.llvm != "", "the native toolchain exists");
    relative := ".chibi/graph-discovery";
    scratch := Path([os.Root(), "/", relative]);
    assert(os.Run(["rm", "-rf", scratch]) == 0 && Make(scratch), "the scratch directory");
    Check(toolchain, ["-u", "CXX", Path(["CMAKE_LIBRARY_PATH=", scratch, "/lib"]), Path(["CMAKE_INCLUDE_PATH=", scratch, "/include"])],
          os.Root(), "Drivers", [scratch]);
    assert(os.Run(["rm", "-rf", scratch]) == 0, "the scratch cleanup");
    return 0;
}
