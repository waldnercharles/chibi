-            ((i->op >= BF_ADD && i->op <= BF_MOD) ||
-             (i->op >= BF_LT && i->op <= BF_NE) ||
-             (i->op >= BF_BIT_AND && i->op <= BF_SHR && i->op != BF_BIT_NOT) ||
-             i->op == BF_INDEX || i->op == BF_WRITE);
