body {
    --menu-background: #1d1e22;
    --popup-background: #242529;
    --popup-border: #393a40;
    --row-hover: #303137;
    --text-primary: #e8eaf0;
    --text-muted: #999ca5;
    --text-disabled: #666972;
    --accent: #73abff;
    width: 100%;
    height: 100%;
    margin: 0dp;
    padding: 0dp;
    font-family: Inter;
    font-size: 13dp;
    color: var(--text-primary);
    background-color: transparent;
    overflow: hidden;
}
#menu-root {
    width: 100%;
    height: 100%;
    overflow: visible;
}
.menu-bar {
    position: relative;
    display: block;
    height: 30dp;
    width: 100%;
    padding: 0dp 8dp;
    box-sizing: border-box;
    background-color: var(--menu-background);
    border-bottom: 1dp #303137;
    white-space: nowrap;
}
.brand {
    display: inline-flex;
    vertical-align: middle;
    height: 29dp;
    align-items: center;
    gap: 6dp;
    padding: 0dp 12dp 0dp 4dp;
    color: #dfe6f2;
    font-size: 12dp;
    font-weight: 700;
}
.brand-dot {
    width: 7dp;
    height: 7dp;
    border-radius: 4dp;
    background-color: var(--accent);
}
.menu-wrap {
    position: relative;
    display: inline-block;
    vertical-align: middle;
    height: 29dp;
}
button {
    font-family: Inter;
    font-size: 13dp;
    color: var(--text-primary);
    border: 0dp;
    box-sizing: border-box;
}
.menu-trigger {
    tab-index: auto;
    display: block;
    height: 25dp;
    margin: 2dp 1dp;
    padding: 0dp 10dp;
    border-radius: 4dp;
    border: 1dp transparent;
    background-color: transparent;
    color: #c8cad0;
}
.menu-trigger:hover,
.menu-bar.keyboard-open .menu-trigger:focus,
.menu-wrap.open > .menu-trigger {
    color: #f0f1f5;
    background-color: #2a2b30;
}
.menu-bar.keyboard-open .menu-trigger:focus {
    border: 1dp #555861;
}
.menu-popup {
    position: absolute;
    left: 0dp;
    top: 100%;
    z-index: 20;
    width: 224dp;
    padding: 5dp;
    box-sizing: border-box;
    background-color: var(--popup-background);
    border: 1dp var(--popup-border);
    border-radius: 6dp;
    visibility: visible;
    opacity: 0;
    transform: translateY(-2dp);
    transition: opacity 0.12s quadratic-out, transform 0.12s quadratic-out;
    pointer-events: none;
}
.menu-wrap.open > .menu-popup {
    opacity: 1;
    transform: translateY(0dp);
    pointer-events: auto;
}
.menu-bar.keyboard-open .menu-popup,
.menu-bar.reduced-motion .menu-popup,
.menu-bar.reduced-motion .menu-item,
.menu-bar.reduced-motion .menu-trigger {
    transition: none;
}
.view-popup {
    width: 252dp;
}
.menu-item {
    tab-index: none;
    display: flex;
    align-items: center;
    width: 100%;
    height: 27dp;
    padding: 0dp 9dp;
    border-radius: 4dp;
    background-color: transparent;
    text-align: left;
    white-space: nowrap;
    border: 1dp transparent;
    transition: background-color 0.09s quadratic-out, color 0.09s quadratic-out;
}
.menu-item:hover,
.menu-bar.keyboard-open .menu-item:focus {
    background-color: var(--row-hover);
    color: #ffffff;
}
.menu-bar.keyboard-open .menu-item:focus {
    border: 1dp #6a8dbd;
}
.menu-item.disabled {
    color: var(--text-disabled);
    pointer-events: none;
}
.item-label {
    flex: 1;
}
.shortcut {
    margin-left: 24dp;
    color: var(--text-muted);
    font-size: 12dp;
}
.check-mark {
    display: inline-block;
    width: 19dp;
    color: var(--accent);
    visibility: hidden;
}
.checkable.checked .check-mark {
    visibility: visible;
}
.separator {
    display: block;
    height: 1dp;
    margin: 4dp 5dp;
    background-color: #393a40;
}
.menu-bar.reduced-motion .menu-item:hover,
.menu-bar.reduced-motion .menu-trigger:hover {
    transition: none;
}
