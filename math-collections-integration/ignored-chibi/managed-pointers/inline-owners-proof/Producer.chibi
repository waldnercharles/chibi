    for index in indices { assert(rows[index].type == type, "producer operand storage"); }
}
WidthShape :: (rows: facts.Row[]) {
    indices: int[] = [4, 5, WidthWidened, WidthRead, WidthWrapped, WidthShiftCount, WidthShift];
    types: int[] = [facts.IntType, facts.ByteType, facts.IntType, facts.IntType, facts.ByteType, facts.ByteType, facts.ByteType];
    values: int[] = [0, 1, 0, 0, 1, 0, 9];
    literals: i64[] = [298, 0, 0, 0, 0, 1, 0];
    for index in 0..<length(indices) {
        row := rows[indices[index]];
        assert(row.type == types[index] && row.value == values[index] && row.literal == literals[index]);
    }
}
LoopShape :: (rows: facts.Row[]) {
    row := rows[LoopFor];
    assert(row.type == facts.IntType && row.value == 2 && row.count == 2 && row.literal == i64(facts.RangeExclusive));
    assert(row.name == "i" && rows[LoopTrue].literal == 1);
}
SwitchShape :: (rows: facts.Row[]) {
    indices: int[] = [SwitchRow, SwitchFirst, SwitchDefault, SwitchLast];
    counts: int[] = [1, 1, 0, 1];
    for index in 0..<length(indices) {
        row := rows[indices[index]];
        assert(row.type == facts.IntType && row.count == counts[index]);
    }
    assert(rows[SwitchLastValue].literal == 20);
}
RecordShape :: (rows: facts.Row[]) {
    assert(rows[RecordDeclaration].name == "Point" && rows[RecordDeclaration].count == 2);
    assert(rows[RecordX].name == "x" && rows[RecordX].type == facts.IntType);
    assert(rows[RecordY].name == "y" && rows[RecordY].type == facts.FloatType && rows[RecordY].value == 1);
    TypedRows(rows, [RecordLocal, RecordAssign, RecordRead, RecordMake, RecordZero, RecordYUpdate], facts.RecordType);
    assert(rows[RecordYUpdate].value == 1 && rows[RecordYUpdate + 2].value == 0);
    assert(rows[RecordYUpdate - 1].type == facts.FloatType && rows[RecordField].type == facts.IntType);
}
UnionShape :: (rows: facts.Row[]) {
    assert(rows[UnionDeclaration].name == "Shape" && rows[UnionDeclaration].count == 2);
    assert(rows[UnionDot].name == "Dot" && rows[UnionDot].count == 0);
    assert(rows[UnionBox].name == "Box" && rows[UnionBox].value == 1 && rows[UnionBox].count == 2);
    assert(rows[UnionW].name == "w" && rows[UnionW].type == facts.IntType);
    assert(rows[UnionH].name == "h" && rows[UnionH].type == facts.FloatType && rows[UnionH].value == 1);
    TypedRows(rows, [UnionLocal, UnionLocal + 2, UnionIsTag - 1, UnionMake], facts.RecordType);
    assert(rows[UnionMake].value == 1 && rows[UnionMake].count == 2);
    TypedRows(rows, [UnionIsTag, UnionIsVariant, UnionSwitch, UnionSwitchTag, UnionDotArm, UnionDotVariant,
                     UnionBoxArm, UnionWLocal], facts.IntType);
    assert(rows[UnionIsVariant].literal == 0 && rows[UnionDotArm].count == 1 && rows[UnionBoxArm].count == 0);
    assert(rows[UnionWLocal].name == "w" && rows[UnionHLocal].name == "h");
    assert(rows[UnionHLocal].type == facts.FloatType && rows[UnionHLocal].value == 2);
    assert(rows[UnionWPayload].value == 0 && rows[UnionHPayload].value == 1);
}
StringShape :: (rows: facts.Row[]) {
    TypedRows(rows, [StringLocal, StringArgument, StringRead, StringLiteral, StringName,
                     StringParameter, StringParameterRead], facts.StringType);
    for index in [StringArgument, StringLiteral] {
        assert(rows[index].text == "one" && rows[index].literal == 0);
    }
    assert(rows[StringCompare].type == facts.BoolType);
    text := IR(rows);
    assert(strings.Contains(text, "@chibi_scalar.text.0 = private unnamed_addr constant [4 x i8] c\"one\\00\""));
    assert(!strings.Contains(text, "@chibi_scalar.text.1"), "equal literals share their emitted bytes");
    long := ChangedRows(rows, [Named(StringLiteral, TextField, strings.Repeat("a", 40000))]);
    ValidateRows(long, "");
}
TextShape :: (rows: facts.Row[]) {
    indices: int[] = [TextSlice, TextLength, TextByte];
    operations: int[] = [facts.TextSlice, facts.TextLength, facts.TextByte];
    counts: int[] = [3, 1, 2];
    types: int[] = [facts.StringType, facts.IntType, facts.IntType];
    for index in 0..<length(indices) {
        row := rows[indices[index]];
        assert(row.value == operations[index] && row.count == counts[index] && row.type == types[index]);
    }
    assert(rows[TextSource].text == "abcd");
}
FormatShape :: (rows: facts.Row[]) {
    row := rows[FormatText];
    assert(row.value == facts.TextFormat && row.count == 4 && row.type == facts.StringType);
    assert(rows[FormatInt].type == facts.Int64Type && rows[FormatFormat].text == "{}{}{}");
}
AssertShape :: (rows: facts.Row[]) {
    call := "assert(x < 2, \"x is small\")";
    start := strings.Index(AssertsFixtureSource(), call);
    end := start + strings.ByteLength(call);
    row := rows[AssertStatement];
    assert(row.count == 3 && row.type == 0 && row.start == start && row.end == end && row.line == 4 && row.column == 5);
    text := IR(rows);
    expected := format_text("@chibi_scalar.failure.0.7 = private unnamed_addr constant { i64, i32, i32 } { i64 0, i32 {}, i32 {} }\n", start, end);
    assert(strings.Contains(text, expected));
    assert(strings.Contains(text, "define i32 @chibi_scalar(ptr %ctx) #0 {\n"));
    assert(strings.Contains(text, "  br i1 %a6, label %p8, label %p7\n"));
    assert(strings.Contains(text, "p7:\n  %fail7.at = getelementptr inbounds { ptr, ptr, ptr, ptr, ptr }, ptr %ctx, i32 0, i32 1\n  store ptr @chibi_scalar.failure.0.7, ptr %fail7.at\n  br label %failed\n"));
    assert(strings.Contains(text, "failed:\n  ret i32 0\n"));
}
GenericShape :: (rows: facts.Row[]) {
    assert(length(rows) > 2 && rows[2].kind == facts.FunctionRow);
    functions: facts.Row[] = [];
    for row in rows {
        if row.kind == facts.FunctionRow {
            assert(row.literal == 0 && row.count <= 1);
            functions.append(row);
        }
    }
    assert(length(functions) == 7);
    calls := 0;
    for row in rows {
        if row.kind == facts.CallRow {
            assert(row.value >= 0 && row.value < length(functions));
            assert(row.count == functions[row.value].count && row.name == functions[row.value].name);
            calls += 1;
        }
    }
    assert(calls == 6);
}


PackageRows :: (paths: string[], sources: string[], collections: string[], directories: string[]) -> facts.Row[] {
    return compiler.CollectScalarPackages("/project", collections, directories, paths, sources, TargetFacts(), Names(),
                                         Natives(), Ports(), Identities(), 0, 0);
}

ImportedPackages :: () {
    paths := ["Main.chibi", "lib/Lib.chibi"];
    sources := ["package main\nimport lib \"project:lib\"\nMain :: () -> int { return lib.Add(3, lib.Twice(2)) * lib.Limit; }\n", "package lib\npub Limit :: 5;\npub Twice :: (n: int) -> int { return n * 2; }\npub Add :: (a: int, b: int) -> int { return a + b; }\n"];
    rows := PackageRows(paths, sources, [], []);
    assert(length(rows) > 2 && rows[1].kind == facts.DocumentRow);
    ValidateRows(rows, "");
    assert(rows[2].name == "Main");
    text := IR(rows);
    assert(strings.Contains(text, "define internal i32 @chibi_scalar.1("));
    assert(strings.Contains(text, "define internal i32 @chibi_scalar.2("));
    assert(strings.Contains(text, "call i32 @chibi_scalar."));
}

CollectionPackages :: () {
    paths := ["Main.chibi", "/sdk/core/strings/Strings.chibi"];
    sources := ["package main\nimport strings \"core:strings\"\nMain :: () -> int { return strings.ByteLength(\"hello\"); }\n", "package strings\npub ByteLength :: (value: string) -> int { return text_byte_length(value); }\n"];
    rows := PackageRows(paths, sources, ["core"], ["/sdk/core"]);
    assert(length(rows) > 2 && rows[1].kind == facts.DocumentRow);
    ValidateRows(rows, "");
    assert(strings.Contains(IR(rows), "define internal i32 @chibi_scalar.1("));
}

LocatedPackages :: () {
    paths := ["Main.chibi", "lib/Lib.chibi"];
    sources := ["package main\nimport lib \"project:lib\"\nMain :: () -> int { return lib.Add(1, 2); }\n", "package lib\npub Add :: (a: int, b: int) -> int { return a + b; }\npub Table :: struct { m: [int: int]; }\n"];
    rows := PackageRows(paths, sources, [], []);
    assert(length(rows) == 2 && rows[1].kind == facts.RejectionRow);
    joined := rows[0].text;
    rejected := rows[1];
    assert(rejected.start > strings.ByteLength(sources[0]) && rejected.end <= strings.ByteLength(joined));
    assert(strings.Slice(joined, rejected.start, rejected.end - rejected.start) == "m: [int: int];");
}

ScopedPackages :: () {
    paths := ["Main.chibi", "lib/Z.chibi", "lib/A.chibi"];
    sources := ["package main\nimport lib \"project:lib\"\nMain :: () -> int { x: lib.Cursor = {pos: 1}; return lib.Relay(&x); }\n", "package lib\npub Cursor :: struct { pos: int; }\npub Relay :: (c: ^Cursor) -> int { return Step(c); }\n", "package lib\nStep :: (c: ^Cursor) -> int { c.pos += 1; return c.pos; }\n"];
    rows := PackageRows(paths, sources, [], []);
    assert(length(rows) > 2 && rows[1].kind == facts.DocumentRow);
    ValidateRows(rows, "");
}

ScopedParameterModes :: () {
    source := "package aliases\nCounter :: struct { count: int; }\nMain :: () -> int { counter: Counter = {count: 1}; return Change(&counter, &counter); }\nChange :: (reader: ^Counter, writer: ^Counter) -> int { writer.count += 1; return Read(reader); }\nRead :: (value: ^Counter) -> int { return value.count; }\n";
    rows := Produced(source);
    ValidateRows(rows, "");
    parameters := 0;
    for row in rows {
        if row.kind != facts.ParameterRow { continue; }
        if row.name == "writer" { assert(row.literal == i64(facts.ParameterReference)); }
        else { assert(row.literal == i64(facts.ParameterReadonlyReference)); }
        parameters += 1;
    }
    assert(parameters == 3, "forwarded readonly and writable parameter classifications");
}


LibraryRows :: (source: string) -> facts.Row[] {
    return compiler.CollectScalar("/project", "libraries/Tools.chibi", source,
                                  TargetFacts(), Names(), Natives(), Ports(), Identities());
}
LibraryContracts :: () {
    source := "Tools :: library {\n    Add :: (a: int, b: int) -> int { return a + b; }\n    Name :: () -> string { return \"tools\"; }\n}\n";
    rows := LibraryRows(source);
    assert(rows[1].kind == facts.DocumentRow && rows[1].text == "Tools");
    // Independent literal values from the stable C catalog's FNV-1a IDs.
    ids: i64[] = [8142356760778695737, -4666415818573129415];
    functions := 0;
    for row in rows {
        if row.kind == facts.FunctionRow {
            assert(functions < 2 && row.literal == ids[functions]);
            functions += 1;
        }
    }
    assert(functions == 2);
    sources := ["Tools :: library {\n    Point :: struct { x: int; }\n}\n",
                "Tools :: library {\n}\n",
                "Tools :: library {\n    One :: () -> int { return 1; }\n    One :: () -> int { return 2; }\n}\n"];
    messages := ["a native library holds only functions without attributes",
                 "scalar proof requires at least one function", "Duplicate declaration 'One'"];
    for index in 0..<length(sources) {
        rejected := LibraryRows(sources[index]);
        assert(length(rejected) == 2 && rejected[1].kind == facts.RejectionRow);
        assert(rejected[1].text == messages[index]);
    }
}
RetainedLibraryRows :: () {
    source := "Tools :: library {\n    Frame :: () -> int {\n        count: retain int = 4;\n        count += 1;\n        return count;\n    }\n}\n";
    rows := LibraryRows(source);
    assert(length(rows) > 2 && rows[1].kind == facts.DocumentRow);
    text := IR(rows);
    assert(strings.Contains(text, "@chibi_scalar.retained.0 = internal global i32 4\n"));
    assert(strings.Contains(text, "load i32, ptr @chibi_scalar.retained.0"));
    assert(strings.Contains(text, "store i32 %a"));
    assert(strings.Contains(text, "c\"Frame.count\\00\""));
    assert(strings.Contains(text, "@chibi_retained_Tools = constant { i32, i32, ptr, ptr, ptr, ptr } { i32 1, i32 1, "));
}


SourceBoundaries :: () {
    patterns := Produced("package scalar\nShape :: union { Dot | Box(w: int) }\nMain :: () -> int { s := Shape.Box(1); if (s is .Box(w)) { return w; } return 0; }\n");
    ValidateRows(patterns, "");
    RejectedSource("package scalar\nNamed :: union { Tag(items: [int: int]) }\nMain :: () -> int { return 1; }\n", "native map payloads require union ownership support", "items: [int: int]");
    RejectedSource("package scalar\nWrapped :: union { Of(p: ^int) }\nMain :: () -> int { return 1; }\n", "native pointer payloads require union tracing support", "p: ^int");
    summary := Produced("package scalar\nPoint :: struct { x: int; }\nMain :: () -> int { p: Point = {x: 1}; return text_byte_length(format_text(\"{}\", p)); }\n");
    assert(scalar.Validate(summary) == "");
    switch scalar.EmitProgramFor(abi.LinuxX64(), summary, "") {
        case .Emitted(text): assert(text != "");
        case: assert(false, "record summaries lower with a native program context");
    }
    RejectedSource("package scalar\nMain :: () -> int { return text_byte_length(format_text(\"{}\", 7)); }\n", "a number needs an integer type here", "7");
}

RejectedSource :: (source: string, message: string, excerpt: string) {
    rows := Produced(source);
    if (length(rows) != 2 || rows[1].kind != facts.RejectionRow) { os.Print(source); }
    assert(length(rows) == 2 && rows[1].kind == facts.RejectionRow);
    rejected := rows[1];
    if (rejected.text != message) {
        os.Print(format_text("Expected rejection '{}', received '{}'", message, rejected.text));
        os.Print(source);
    }
    assert(rejected.text == message);
    assert(strings.Slice(source, rejected.start, rejected.end - rejected.start) == excerpt);
}

CollectionRows :: (source: string, natives: compiler.Native[], ports: compiler.Port[]) -> facts.Row[] {
    return compiler.CollectScalar("/project", "Main.chibi", strings.Concatenate(["package collections\n", source]), TargetFacts(), Names(), natives, ports, Identities());
}
CollectionProjection :: () {
    source := "Main::()->int{a:int[][]=make_array([int(1)]);return length(a);}";
    rows := CollectionRows(source, Natives(), Ports());
    if (rows[1].kind == facts.RejectionRow) { os.Print(rows[1].text); }
    assert(rows[1].kind == facts.DocumentRow && scalar.Validate(rows) == "");
    collections := 0;
    scalar_leaf := false;
    for (index in 0..<length(rows)) {
        if (rows[index].kind == facts.RecordRow) {
            // Unused optional-array declarations must never become wrappers.
            assert(strings.HasPrefix(rows[index].name, "__collection_") && rows[index].count == 1);
            member := rows[index + 1];
            assert(member.kind == facts.MemberRow && member.type >= facts.ArrayType && member.type < facts.MapType);
            scalar_leaf = scalar_leaf || member.type == facts.ArrayType + facts.IntType;
            for (earlier in 0..<index) {
                if (rows[earlier].kind == facts.RecordRow) { assert(rows[earlier].name != rows[index].name); }
            }
            collections += 1;
        }
    }
    assert(collections > 0 && scalar_leaf);
    natives := Natives();
    ports := Ports();
    for (index in 0..<length(natives)) {
        if (natives[index].name == "make_array") {
            native := natives[index];
            native.variadic = false;
            natives[index] = native;
            argument := ports[native.first];
            argument.storage = 11;
            ports[native.first] = argument;
            result := ports[native.first + 1];
            result.storage = 13;
            result.container = 0;
            ports[native.first + 1] = result;
        }
    }
    rejected := CollectionRows("Main::()->int{x:=make_array(f64(2));return 0;}", natives, ports);
    assert(rejected[1].kind == facts.RejectionRow);
    unused := CollectionRows("Main::()->int{return 0;}", natives, ports);
    assert(unused[1].kind == facts.DocumentRow && scalar.Validate(unused) == "");
    shadow := CollectionRows("Main::()->int{return make_array(f64(2));}make_array::(value:f64)->int{return int(value);}", natives, ports);
    assert(shadow[1].kind == facts.DocumentRow && scalar.Validate(shadow) == "");
    reversed := Produced("package scalar\nMain::()->int{xs:int[]=[1,2];total:=0;for < value,index in xs{total+=value+index;}return total;}\n");
    ValidateRows(reversed, "");
    loops := 0;
    for (row, index in reversed) {
        if (row.kind != facts.ForRow) { continue; }
        assert(row.literal == i64(facts.RangeArray + facts.RangeKeyed + facts.RangeReverse));
        RejectChanged(reversed, [Changed(index, LiteralField, i64(facts.RangeArray + facts.RangeExclusive))], "invalid scalar local row");
        RejectChanged(reversed, [Changed(index, LiteralField, i64(facts.RangeArray + facts.RangeReverse + facts.RangeExclusive))], "invalid scalar local row");
        RejectChanged(reversed, [Changed(index, LiteralField, i64(facts.RangeArray + facts.RangeKeyed + facts.RangeExclusive))], "invalid scalar local row");
        RejectChanged(reversed, [Changed(index, LiteralField, i64(facts.RangeArray + facts.RangeKeyed + facts.RangeReverse + facts.RangeExclusive))], "invalid scalar local row");
        RejectChanged(reversed, [Changed(index, ValueField, i64(row.value + 1))], "invalid scalar local row");
        RejectChanged(reversed, [Changed(index, TypeField, i64(facts.BoolType))], "scalar range differs from its int bounds");
        loops += 1;
    }
    assert(loops == 1);
    nested := Produced("package scalar\nMain::()->int{xs:int[][]=[[1]];xs[0].append(2);return xs[0][1];}\n");
    ValidateRows(nested, "");
    places := 0;
    for (row, index in nested) {
        if (row.kind != facts.ArrayRow || row.literal != i64(facts.NestedArrayPlace)) { continue; }
        assert(row.value == facts.ArrayPush && row.count == 3);
        RejectChanged(nested, [Changed(index, CountField, 2)], "scalar array operation differs from its operands");
        RejectChanged(nested, [Changed(index, TypeField, i64(facts.ArrayType + facts.IntType))], "scalar array operation differs from its operands");
        RejectChanged(nested, [Changed(index - 2, KindField, i64(facts.LiteralRow)),
            Changed(index - 2, TypeField, i64(facts.BoolType)), Changed(index - 2, ValueField, 0)],
            "scalar array operation differs from its operands");
        places += 1;
    }
    assert(places == 1);
}

TextArgumentsProjection :: () {
    // These exact migrated sources were rejected before text argument parity.
    for (source in ["package scalar\nMain :: () -> int { return text_byte_length(Value: \"ab\"); }\n",
                    "package scalar\nMain :: () -> int { if (text_equal(\"a\", \"b\")) { return 1; } return 0; }\n"]) {
        rows := Produced(source);
        assert(rows[1].kind == facts.DocumentRow);
        ValidateRows(rows, "");
    }
    slices := ["Value: \"abcd\", Start: 1, Count: 2", "Value: \"abcd\", Count: 2, Start: 1",
               "Start: 1, Value: \"abcd\", Count: 2", "Count: 2, Value: \"abcd\", Start: 1",
               "Start: 1, Count: 2, Value: \"abcd\"", "Count: 2, Start: 1, Value: \"abcd\""];
    for (arguments, order in slices) {
        rows := Produced(format_text("package scalar\nMain::()->int{return text_byte_length(text_slice({}));}", arguments));
        assert(rows[1].kind == facts.DocumentRow);
        ValidateRows(rows, "");
        found := false;
        for (row in rows) {
            if (row.kind == facts.TextRow && row.value == facts.TextSlice) {
                assert(row.literal == i64(order));
                found = true;
            }
        }
        assert(found);
    }
    rows := TextRows();
    RejectChanged(rows, [Changed(7, LiteralField, -1)], "scalar text read differs from its operands");
    RejectChanged(rows, [Changed(7, LiteralField, 6)], "scalar text read differs from its operands");
    RejectChanged(rows, [Changed(7, LiteralField, 2)], "scalar text read differs from its operands");
    RejectChanged(rows, [Changed(13, LiteralField, 2)], "scalar text read differs from its operands");
    accepted := ChangedRows(rows, [Changed(7, LiteralField, 1)]);
    ValidateRows(accepted, "");
    formats := FormatsRows();
    RejectChanged(formats, [Changed(8, LiteralField, 1)], "scalar text read differs from its operands");
    natives := Natives();
    ports := Ports();
    for (native in natives) {
        if (native.name == "text_slice") {
            parameter := ports[native.first + 2];
            parameter.name = "End";
            ports[native.first + 2] = parameter;
        }
    }
    rejected := CollectionRows("Main::()->int{s:=text_slice(\"abcd\",1,2);return 0;}", natives, ports);
    assert(rejected[1].kind == facts.RejectionRow);
    unused := CollectionRows("Main::()->int{return 0;}", natives, ports);
    assert(unused[1].kind == facts.DocumentRow && scalar.Validate(unused) == "");
    shadow := CollectionRows("Main::()->int{return text_slice(1);}text_slice::(n:int)->int{return n;}", natives, ports);
    assert(shadow[1].kind == facts.DocumentRow && scalar.Validate(shadow) == "");
}

ForeignVoidProjection :: () {
    rows := Produced("package scalar\nforeign import libc \"system:c\"\nforeign libc {\nresolve::()->rawptr\nnotify::(value:int)\n}\nMain::()->int{p:fn(value:int)=resolve();p(1);notify(2);return 0;}");
    ValidateRows(rows, "");
    direct := -1;
    indirect := -1;
    for (row, index in rows) {
        if (row.kind != facts.ForeignRow) { continue; }
        if (row.value == abi.ForeignDirectVoid) { direct = index; }
        if (row.value == abi.ForeignIndirectVoid) { indirect = index; }
    }
    assert(direct >= 0 && indirect >= 0);
    mismatch := "scalar foreign call differs from its operands";
    RejectChanged(rows, [Changed(direct, TypeField, i64(facts.BoolType))], mismatch);
    RejectChanged(rows, [Changed(direct, ValueField, 4)], mismatch);
    RejectChanged(rows, [Named(direct, NameField, "")], mismatch);
    RejectChanged(rows, [Named(indirect, NameField, "notify")], mismatch);
    RejectChanged(rows, [Changed(indirect, CountField, 0)], mismatch);
    RejectChanged(rows, [Changed(indirect, LiteralField, i64(facts.ForeignReversed))], mismatch);
}

CallArgumentsProjection :: () {
    rows := Produced("package scalar\nMain :: () -> int { return Apply(Pick); }\nApply :: (op: fn(first: int, second: bool) -> int) -> int { return op(second: true, first: 7); }\nPick :: (x: int, flag: bool) -> int { if flag { return x; } return 0; }\n");
    assert(rows[1].kind == facts.DocumentRow);
    ValidateRows(rows, "");
    swap := -1;
    for (row, index in rows) {
        if row.kind == facts.OperandSwapRow { swap = index; }
    }
    assert(swap >= 0, "reordered callback arguments exchange existing values");
    invalid := "scalar operand exchange differs from its evaluation stack";
    for edit in [Changed(swap, ValueField, -1), Changed(swap, CountField, 0),
                 Changed(swap, CountField, 1000), Changed(swap, TypeField, i64(facts.IntType)),
                 Changed(swap, LiteralField, 1), Changed(swap, StartField, -1),
                 Named(swap, NameField, "bad"), Named(swap, TextField, "bad")] {
        RejectChanged(rows, [edit], invalid);
    }
    // A lazy RHS cannot exchange its own operand with a preceding call argument.
    lazy := Produced("package scalar\nMain :: () -> int { return Apply(Pick); }\nApply :: (op: fn(first: int, second: bool) -> int) -> int { return op(first: 7, second: true && false); }\nPick :: (x: int, flag: bool) -> int { if flag { return x; } return 0; }\n");
    ValidateRows(lazy, "");
    logical := -1;
    for (row, index in lazy) {
        if row.kind == facts.LogicalRow { logical = index; }
    }
    assert(logical >= 0);
    RejectChanged(lazy, [Changed(logical + 1, KindField, i64(facts.OperandSwapRow)),
                        Changed(logical + 1, TypeField, 0), Changed(logical + 1, CountField, 1)], invalid);
}

SynchronousProjection :: () {
    source := "package synchronous\nMain :: () -> int { return Apply(One); }\nApply :: (function: fn() -> int) -> int { return function() + Work(); }\nOne :: () -> int { return 1; }\nWork :: () -> int { text := format_text(\"ready\"); return text_byte_length(text); }\n";
    rows := Produced(source);
    assert(rows[1].kind == facts.DocumentRow);
    ValidateRows(rows, "");
    natives := Natives();
    for (native, index in natives) {
        if (native.name == "format_text") {
            changed := native;
            // SCRIPT_EFFECT_SUSPEND, a declared runtime capability. The plain
            // collector must retain it through typed checking and call closure.
            changed.effects = 16;
            natives[index] = changed;
        }
    }
    rejected := compiler.CollectScalar("/project", "Facts.chibi", source, TargetFacts(), Names(), natives, Ports(), Identities());
    assert(length(rejected) == 2 && rejected[1].kind == facts.RejectionRow);
    assert(rejected[1].text == "Non-escaping callable parameters require synchronous function bodies");
    assert(rejected[1].line == 3 && rejected[1].column == 1);
    unused := compiler.CollectScalar("/project", "Facts.chibi", "package synchronous\nMain :: () -> int { return 0; }\n",
        TargetFacts(), Names(), natives, Ports(), Identities());
    assert(unused[1].kind == facts.DocumentRow);
    ValidateRows(unused, "");
}

ArrayEditOperation :: (rows: facts.Row[], operator: int) -> int {
    for (row, index in rows) {
        if (row.kind == facts.ArrayRow && row.value == operator) { return index; }
    }
    assert(false, "array edit fixture contains its operation");
    return -1;
}
ArrayEditsProjection :: () {
    source := "package arrays\nMain::()->int{other:int[]=[9];values:int[]=[1,2];values.insert(0,3);values.reverse();values.set_array_elem(0,4);fresh:=insert(values,0,int(4));replaced:=set_array_elem(fresh,0,int(6));flipped:=reverse(replaced);return length(flipped);}";
    rows := Produced(source);
    assert(rows[1].kind == facts.DocumentRow);
    ValidateRows(rows, "");
    inserted := ArrayEditOperation(rows, facts.ArrayInsert);
    reversed := ArrayEditOperation(rows, facts.ArrayReverse);
    fresh_insert := ArrayEditOperation(rows, facts.ArrayInserted);
    fresh_reverse := ArrayEditOperation(rows, facts.ArrayReversed);
    mutable_set := ArrayEditOperation(rows, facts.ArrayReplace);
    replaced := ArrayEditOperation(rows, facts.ArrayReplaced);
    mismatch := "scalar array operation differs from its operands";
    RejectChanged(rows, [Changed(mutable_set, CountField, 2)], mismatch);
    RejectChanged(rows, [Changed(mutable_set, CountField, 4)], mismatch);
    RejectChanged(rows, [Changed(replaced, CountField, 2)], mismatch);
    RejectChanged(rows, [Changed(replaced, CountField, 4)], mismatch);
    RejectChanged(rows, [Changed(mutable_set - 3, ValueField, 0)], mismatch);
    RejectChanged(rows, [Changed(mutable_set - 2, TypeField, i64(facts.BoolType))], mismatch);
    RejectChanged(rows, [Changed(mutable_set - 1, TypeField, i64(facts.BoolType)), Changed(mutable_set - 1, LiteralField, 0)], mismatch);
    RejectChanged(rows, [Changed(replaced, ValueField, i64(facts.ArrayReplace))], "scalar array change is not the assignment of its array");
    RejectChanged(rows, [Changed(inserted, CountField, 2)], mismatch);
    RejectChanged(rows, [Changed(inserted, CountField, 4)], mismatch);
    RejectChanged(rows, [Changed(reversed, CountField, 0)], mismatch);
    RejectChanged(rows, [Changed(reversed, CountField, 2)], mismatch);
    RejectChanged(rows, [Changed(fresh_insert, CountField, 2)], mismatch);
    RejectChanged(rows, [Changed(fresh_reverse, CountField, 2)], mismatch);
    // Both arrays are already visible. A valid reference to the wrong root
    // must not mutate it under an assignment to the original variable.
    assert(rows[inserted - 3].kind == facts.RefRow && rows[inserted - 3].value == 1);
    assert(rows[reversed - 1].kind == facts.RefRow && rows[reversed - 1].value == 1);
    RejectChanged(rows, [Changed(inserted - 3, ValueField, 0)], mismatch);
    RejectChanged(rows, [Changed(reversed - 1, ValueField, 0)], mismatch);
    RejectChanged(rows, [Changed(inserted - 2, TypeField, i64(facts.BoolType))], mismatch);
    RejectChanged(rows, [Changed(inserted - 1, TypeField, i64(facts.BoolType)), Changed(inserted - 1, LiteralField, 0)], mismatch);
    RejectChanged(rows, [Changed(inserted - 3, TypeField, i64(facts.StringType))], "scalar reference differs from its variable");
    RejectChanged(rows, [Changed(fresh_insert, ValueField, i64(facts.ArrayInsert))], "scalar array change is not the assignment of its array");
    RejectChanged(rows, [Changed(fresh_reverse, ValueField, i64(facts.ArrayReverse))], "scalar array change is not the assignment of its array");
    bad_field := ChangedRows(rows, [Changed(inserted, LiteralField, 1)]);
    row := bad_field[inserted];
    diagnostic := format_text("{} at {}..{} (parent {}, field 0, operator {}): {}", mismatch,
        row.start, row.end, row.type, row.value, strings.Slice(source, row.start, row.end - row.start));
    ValidateRows(bad_field, diagnostic);
    natives := Natives();
    ports := Ports();
    for (native in natives) {
        if (native.name == "insert") {
            argument := ports[native.first + 1]; argument.name = "Position"; ports[native.first + 1] = argument;
        }
    }
    rejected := CollectionRows("Main::()->int{a:int[]=[1];b:=insert(a,0,int(2));return length(b);}", natives, ports);
    assert(rejected[1].kind == facts.RejectionRow);
    unused := CollectionRows("Main::()->int{return 0;}", natives, ports);
    assert(unused[1].kind == facts.DocumentRow && scalar.Validate(unused) == "");
    // Methods are ordinary typed place intrinsics. Their labels are checked
    // against the supplied catalog, independently of a function capability.
    method := CollectionRows("Main::()->int{a:int[]=[1];a.insert(Position:0,Item:2);return length(a);}", natives, ports);
    assert(method[1].kind == facts.DocumentRow && scalar.Validate(method) == "");
    shadow := CollectionRows("Main::()->int{return insert(2);}insert::(n:int)->int{return n;}", natives, ports);
    assert(shadow[1].kind == facts.DocumentRow && scalar.Validate(shadow) == "");

    removed := Produced("package removed\nMain::()->int{values:int[]=[1,2,1];other:=remove_item(values,int(1));return length(other);}");
    assert(removed[1].kind == facts.DocumentRow);
    ValidateRows(removed, "");
    without := ArrayEditOperation(removed, facts.ArrayWithoutItem);
    RejectChanged(removed, [Changed(without, CountField, 1)], mismatch);
    RejectChanged(removed, [Changed(without, CountField, 3)], mismatch);
    RejectChanged(removed, [Changed(without - 1, TypeField, i64(facts.BoolType))], mismatch);
    remove_ports := Ports();
    for (native in natives) {
        if (native.name == "remove_item") {
            argument := remove_ports[native.first + 1]; argument.name = "Different"; remove_ports[native.first + 1] = argument;
        }
    }
    bad_remove := CollectionRows("Main::()->int{a:int[]=[1];b:=remove_item(a,int(1));return length(b);}", natives, remove_ports);
    assert(bad_remove[1].kind == facts.RejectionRow);
    unused_remove := CollectionRows("Main::()->int{return 0;}", natives, remove_ports);
    assert(unused_remove[1].kind == facts.DocumentRow && scalar.Validate(unused_remove) == "");
    shadow_remove := CollectionRows("Main::()->int{return remove_item(2);}remove_item::(n:int)->int{return n;}", natives, remove_ports);
    assert(shadow_remove[1].kind == facts.DocumentRow && scalar.Validate(shadow_remove) == "");
}

ArrayPlacesProjection :: () {
    rows := Produced("package places\nMain::()->int{values:int[]=[1];values[0]=2;return values[0];}");
    ValidateRows(rows, "");
    check := ArrayEditOperation(rows, facts.ArrayPlaceCheck);
    mismatch := "scalar array operation differs from its operands";
    RejectChanged(rows, [Changed(check, CountField, 1)], mismatch);
    RejectChanged(rows, [Changed(check, CountField, 3)], mismatch);
    RejectChanged(rows, [Changed(check, TypeField, i64(facts.IntType))], mismatch);
    RejectChanged(rows, [Changed(check - 1, TypeField, i64(facts.BoolType))], "scalar read differs from its variable");
    RejectChanged(rows, [Changed(check, ValueField, i64(facts.ArrayPlaceCheck + 1))], mismatch);
}

ForeignPlacesProjection :: () {
    rows := Produced("package places\nforeign import libc \"system:c\"\nforeign libc {memset::(data:u8[],value:i32,count:u64)->rawptr}\nInner::struct{bytes:u8[];}Box::struct{inner:Inner;}Main::()->int{box:Box={inner:{bytes:[u8(65)]}};written:=memset(box.inner.bytes,9,1);return int(box.inner.bytes[0]);}");
    ValidateRows(rows, "");
    first := -1;
    for (row, index in rows) {
        if (row.kind == facts.FieldReferenceRow) { first = index; break; }
    }
    assert(first >= 0 && rows[first + 1].kind == facts.FieldReferenceRow);
    mismatch := "scalar field reference differs from its record";
    RejectChanged(rows, [Changed(first, CountField, 0)], mismatch);
    RejectChanged(rows, [Changed(first, CountField, 2)], mismatch);
    RejectChanged(rows, [Changed(first, ValueField, -1)], mismatch);
    RejectChanged(rows, [Changed(first, ValueField, 2147483647)], mismatch);
    RejectChanged(rows, [Changed(first, TypeField, i64(facts.BoolType))], mismatch);
    RejectChanged(rows, [Changed(first + 1, TypeField, i64(facts.ArrayType + facts.IntType))], mismatch);
    RejectChanged(rows, [Changed(first, LiteralField, 1)], "invalid scalar operand row");
    RejectChanged(rows, [Changed(first, TypeField, 0)], "invalid scalar operand row");
    // A parameter avoids an earlier initializer write masking this leaf-domain check.
    domain := Produced("package places\nforeign import libc \"system:c\"\nforeign libc {memset::(data:u8[],value:i32,count:u64)->rawptr}\nInner::struct{bytes:u8[];}Box::struct{inner:Inner;}Main::()->int{return 0;}Touch::(box:Box)->int{written:=memset(box.inner.bytes,9,1);return 0;}");
    member := -1;
    leaf := -1;
    for (row, index in domain) {
        if (row.kind == facts.MemberRow && row.name == "bytes") { member = index; }
        if (row.kind == facts.FieldReferenceRow) { leaf = index; }
    }
    assert(member >= 0 && leaf >= 0);
    ValidateRows(domain, "");
    RejectChanged(domain, [Changed(member, TypeField, i64(facts.ViewType)), Changed(leaf, TypeField, i64(facts.ViewType))], mismatch);
    retained := Produced("package places\nforeign import libc \"system:c\"\nforeign libc {memset::(data:u8[],value:i32,count:u64)->rawptr}\nBox::struct{bytes:u8[];}Main::()->int{box:retain Box={bytes:[u8(65)]};written:=memset(box.bytes,9,1);return 0;}");
    assert(retained[1].kind == facts.RejectionRow);
    assert(retained[1].text == "native foreign record buffer needs a writable inline record array field");
}

InlineArrayPlacesProjection :: () {
    rows := Produced("package places\nInner::struct{values:int[];}Root::struct{inner:Inner;}Main::()->int{value:Root={inner:{values:[int(1)]}};other:Root={inner:{values:[int(8)]}};value.inner.values.append(3);value.inner.values[0]+=2;return value.inner.values[0];}");
    ValidateRows(rows, "");
    change := -1;
    for (row, index in rows) {
        if (row.kind == facts.ArrayRow && row.literal == i64(facts.ArrayReferencePlace) && row.value == facts.ArrayPush) { change = index; }
    }
    assert(change >= 4 && rows[change - 4].kind == facts.RefRow && rows[change - 4].value == 0);
    mismatch := "scalar array operation differs from its operands";
    RejectChanged(rows, [Changed(change, CountField, 1)], mismatch);
    RejectChanged(rows, [Changed(change, CountField, 3)], mismatch);
    RejectChanged(rows, [Changed(change, LiteralField, 0)], mismatch);
    RejectChanged(rows, [Changed(change - 4, ValueField, 1)], mismatch);
    RejectChanged(rows, [Changed(change - 1, KindField, i64(facts.LiteralRow)), Changed(change - 1, ValueField, 0)], mismatch);
}

ArrayResizeProjection :: () {
    rows := Produced("package resize\nItem::struct{x:int;}\nMain::()->int{items:Item[]=[];items.resize(0);nested:int[][]=[];nested.resize(1);return length(items);}");
    ValidateRows(rows, "");
    authored := 0;
    synthetic := 0;
    for (row in rows) {
        if (row.kind != facts.RecordRow) { continue; }
        if (row.name == "Item") { assert(row.value == 0); authored += 1; }
        else { assert(row.value == facts.ZeroArrayGrowth); synthetic += 1; }
    }
    // The ordinary catalog interns other primitive nested collections too.
    assert(authored == 1 && synthetic > 0);
}

MapForeignPlacesProjection :: () {
    rows := Produced("package places\nforeign import libc \"system:c\"\nforeign libc {memset::(data:u8[],value:i32,count:u64)->rawptr}\nMain::()->int{values:[int:u8[]]=[1:[u8(65)]];written:=memset(values[1],9,1);return 0;}");
    ValidateRows(rows, "");
    loan := -1;
    for (row, index in rows) { if (row.kind == facts.MapRow && row.value == facts.MapArrayLoan) { loan = index; } }
    assert(loan >= 3 && rows[loan - 3].kind == facts.RefRow);
    mismatch := "scalar map operation differs from its operands";
    RejectChanged(rows, [Changed(loan, CountField, 2)], mismatch);
    RejectChanged(rows, [Changed(loan, CountField, 4)], mismatch);
    RejectChanged(rows, [Changed(loan, LiteralField, 0)], mismatch);
    RejectChanged(rows, [Changed(loan, TypeField, i64(facts.ArrayType + facts.BoolType))], mismatch);
    RejectChanged(rows, [Changed(loan - 2, KindField, i64(facts.RefRow))], mismatch);
}

MapArrayPlacesProjection :: () {
    rows := Produced("package places\nMain::()->int{other:[int:int[]]=[1:[8]];values:[int:int[]]=[1:[1]];values[1][0]+=2;return values[1][0];}");
    ValidateRows(rows, "");
    change := -1;
    assignment := -1;
    for (row, index in rows) {
        if (row.kind == facts.MapRow && row.value == facts.MapArraySet) { change = index; }
    }
    for (row, index in rows) {
        if (row.kind == facts.AssignRow && index + row.count == change) { assignment = index; }
    }
    assert(change >= 0 && assignment >= 0 && rows[assignment + 1].kind == facts.RefRow);
    mismatch := "scalar map operation differs from its operands";
    RejectChanged(rows, [Changed(change, CountField, 3)], mismatch);
    RejectChanged(rows, [Changed(change, CountField, 5)], mismatch);
    RejectChanged(rows, [Changed(change, TypeField, i64(facts.BoolType))], mismatch);
    RejectChanged(rows, [Changed(assignment + 1, ValueField, 0)], "scalar map change is not the assignment of its map");
    previous := ArrayEditOperation(rows, facts.ArrayPlaceGet);
    RejectChanged(rows, [Changed(previous, CountField, 1)], "scalar array operation differs from its operands");
    RejectChanged(rows, [Changed(previous, TypeField, i64(facts.BoolType))], "scalar array operation differs from its operands");
}

RecordElementPlacesProjection :: () {
    rows := Produced("package places\nEntry::struct{values:int[];}Main::()->int{other:Entry[]=[{values:[8]}];items:Entry[]=[{values:[1]}];flag:=false;items[0].values[0]=3;return items[0].values[0];}");
    ValidateRows(rows, "");
    observed := -1;
    mutated := -1;
    for (row, index in rows) {
        if (row.kind != facts.ArrayElementReferenceRow) { continue; }
        if (row.literal == i64(facts.ArrayElementObserve)) { observed = index; }
        else { mutated = index; }
    }
    assert(observed >= 0 && mutated >= 0);
    mismatch := "scalar array element reference differs from its record";
    for target in [observed,mutated] {
        RejectChanged(rows,[Changed(target,CountField,1)],mismatch);
        RejectChanged(rows,[Changed(target,CountField,3)],mismatch);
        RejectChanged(rows,[Changed(target,ValueField,1)],mismatch);
        RejectChanged(rows,[Changed(target,TypeField,i64(facts.BoolType))],mismatch);
        RejectChanged(rows,[Changed(target,LiteralField,-1)],mismatch);
        RejectChanged(rows,[Changed(target,LiteralField,i64(facts.ArrayElementObserve + 1))],mismatch);
        RejectChanged(rows,[Changed(target,LiteralField,2147483648)],mismatch);
    }
    RejectChanged(rows,[Changed(mutated - 1,TypeField,i64(facts.BoolType)),Changed(mutated - 1,ValueField,2)],mismatch);
    RejectChanged(rows,[Changed(mutated - 2,ValueField,0)],"scalar array element reference is not its canonical mutation");
    RejectChanged(rows,[Changed(mutated,LiteralField,i64(facts.ArrayElementObserve))],"scalar array observation is not a captured read");
    RejectChanged(rows,[Changed(observed,LiteralField,i64(facts.ArrayElementUnique))],"scalar array element reference is not its canonical mutation");
    RejectChanged(rows,[Changed(observed + 1,KindField,i64(facts.CallRow))],"scalar array observation outlives its captured read");
    // The read result is not itself a writable container, and the failed
    // public projections must not alter the original owned facts.
    ValidateRows(rows, "");
}

IndexedForeignLoansProjection :: () {
    rows := Produced("package places\nforeign import libc \"system:c\"\nforeign libc{memset::(data:u8[],value:i32,count:u64)->rawptr}\nInner::struct{bytes:u8[];}Entry::struct{inner:Inner;}Main::()->int{rows:Entry[]=[{inner:{bytes:[u8(1)]}}];written:=memset(rows[0].inner.bytes,9,1);return 0;}");
    ValidateRows(rows, "");
    selected := -1;
    for (row,index in rows) {
        if (row.kind == facts.ArrayElementReferenceRow && row.literal == i64(facts.ArrayElementLoan)) { selected = index; break; }
    }
    assert(selected >= 0 && rows[selected + 1].kind == facts.FieldReferenceRow && rows[selected + 2].kind == facts.FieldReferenceRow);
    mismatch := "scalar array element reference differs from its record";
    for count in [int(0),2,4] { RejectChanged(rows,[Changed(selected,CountField,i64(count))],mismatch); }
    RejectChanged(rows,[Changed(selected,ValueField,1)],mismatch);
    RejectChanged(rows,[Changed(selected,TypeField,i64(facts.BoolType))],mismatch);
    RejectChanged(rows,[Changed(selected,LiteralField,i64(facts.ArrayElementLoan + 1))],mismatch);
    RejectChanged(rows,[Changed(selected + 1,KindField,i64(facts.CallRow))],"scalar indexed buffer path is not consumed by one loan");
    RejectChanged(rows,[Changed(selected + 3,ValueField,i64(facts.ArrayLength))],"scalar indexed buffer path is not consumed by one loan");
    RejectChanged(rows,[Changed(selected + 3,CountField,2)],"scalar indexed buffer path is not consumed by one loan");
    ValidateRows(rows, "");
}

IndexedFieldReplacementProjection :: () {
    source := "package places\nInner::struct{values:int[];}Entry::struct{inner:Inner;}Main::()->int{other:Entry[]=[{inner:{values:[8]}}];items:Entry[]=[{inner:{values:[1]}}];incoming:int[]=[2];flag:=false;items[0].inner.values=incoming;return items[0].inner.values[0];}";
    rows := Produced(source);
    ValidateRows(rows, "");
    assigned := ArrayEditOperation(rows, facts.ArrayAssign);
    selected := -1;
    for (row,index in rows) { if (row.kind == facts.ArrayElementReferenceRow) { selected = index; break; } }
    assert(selected >= 2 && assigned > selected);
    mismatch := "scalar array operation differs from its operands";
    RejectChanged(rows,[Changed(assigned,CountField,1)],"scalar array element reference is not its canonical mutation");
    RejectChanged(rows,[Changed(assigned,CountField,3)],"scalar array element reference is not its canonical mutation");
    RejectChanged(rows,[Changed(assigned,TypeField,i64(facts.BoolType))],mismatch);
    RejectChanged(rows,[Changed(assigned,ValueField,i64(facts.ArrayAssign + 1))],mismatch);
    RejectChanged(rows,[Changed(assigned - 1,TypeField,i64(facts.BoolType)),Changed(assigned - 1,ValueField,3)],mismatch);
    RejectChanged(rows,[Changed(assigned,LiteralField,0)],mismatch);
    RejectChanged(rows,[Changed(assigned,LiteralField,1)],mismatch);
    RejectChanged(rows,[Changed(selected - 2,ValueField,0)],"scalar array element reference is not its canonical mutation");
    RejectChanged(rows,[Changed(assigned - 2,ValueField,1)],"scalar array element reference is not its canonical mutation");
    // The one-field dispatch must use the same canonical path as deep fields.
    direct := Produced("package places\nEntry::struct{values:int[];}Main::()->int{items:Entry[]=[{values:[1]}];items[0].values=[int(2)];return 0;}");
    assert(ArrayEditOperation(direct,facts.ArrayAssign) >= 0);
    ValidateRows(direct, "");
    ValidateRows(rows, "");
}

NestedMapsProjection :: () {
    rows := Produced("package nested_maps\nMain::()->int{groups:[int:[int:int]]=[:];return groups[1][2];}\n");
    assert(rows[1].kind == facts.DocumentRow);
    ValidateRows(rows, "");
    get := -1;
    for (row, index in rows) {
        if (row.kind == facts.MapRow && row.value == facts.MapGetWrapped) { get = index; }
    }
    assert(get >= 0);
    // Sequence typing can intern unused carriers too. Mutate the exact
    // result record of this get, rather than a different unused declaration.
    member := NestedMapCarrierField(rows, rows[get].type);
    assert(member >= 0 && rows[member].type >= facts.MapType);
    mismatch := "scalar map operation differs from its operands";
    RejectChanged(rows, [Changed(get, TypeField, i64(facts.IntType))], mismatch);
    RejectChanged(rows, [Changed(get, CountField, 1)], mismatch);
    RejectChanged(rows, [Changed(get, ValueField, i64(facts.MapGetOptional))], mismatch);
    RejectChanged(rows, [Changed(member, TypeField, i64(facts.ArrayType + facts.IntType))], mismatch);
    // A same-shaped carrier cannot change the outer map's key contract.
    mapped := int(rows[get].literal);
    wrong_key := mapped - (mapped - facts.MapType) % 16 + facts.BoolType;
    RejectChanged(rows, [Changed(get, LiteralField, i64(wrong_key))], mismatch);
}

NestedMapPlacesProjection :: () {
    rows := Produced("package nested_maps\nMain::()->int{rows:[int:int][]=[[:]];rows[0][1]=2;delete rows[0][1];groups:[int:[int:int]]=[1:[:]];groups[1][2]=3;delete groups[1][2];return 0;}\n");
    assert(rows[1].kind == facts.DocumentRow);
    ValidateRows(rows, "");
    found := 0;
    mismatch := "scalar map operation differs from its operands";
    for (row, index in rows) {
        if (row.kind != facts.MapRow || row.value < facts.ArrayMapSet || row.value > facts.NestedMapDelete) { continue; }
        found += 1;
        RejectChanged(rows, [Changed(index, LiteralField, 1)], mismatch);
        RejectChanged(rows, [Changed(index, CountField, i64(row.count + 1))], mismatch);
        RejectChanged(rows, [Changed(index, TypeField, i64(facts.IntType))], mismatch);
        wrong := facts.ArrayMapSet;
        if (row.value == facts.ArrayMapSet) { wrong = facts.NestedMapSet; }
        if (row.value == facts.ArrayMapDelete) { wrong = facts.NestedMapDelete; }
        RejectChanged(rows, [Changed(index, ValueField, i64(wrong))], mismatch);
    }
    assert(found == 4);
}

DeepMapPlacesProjection :: () {
    rows := Produced("package deep_maps\nMain::()->int{values:[int:[int:[int:int]]]=[1:[2:[:]]];values[1][2][3]=4;delete values[1][2][3];return 0;}\n");
    assert(rows[1].kind == facts.DocumentRow);
    ValidateRows(rows, "");
    found := 0;
    mismatch := "scalar map operation differs from its operands";
    for (row, index in rows) {
        if (row.kind != facts.MapRow || row.value < facts.ArrayMapSet || row.value > facts.NestedMapDelete) { continue; }
        found += 1;
        minimum := 3; if (row.value == facts.NestedMapSet) { minimum = 4; }
        for (count in [int(-2147483647), 0, minimum - 1, row.count - 1, row.count + 1, 2147483647]) {
            RejectChanged(rows, [Changed(index, CountField, i64(count))], mismatch);
        }
        RejectChanged(rows, [Changed(index, LiteralField, 1)], mismatch);
        RejectChanged(rows, [Changed(index, TypeField, i64(facts.IntType))], mismatch);
    }
    assert(found == 2);
    // A map's authored one-array-field record is not a map carrier. No source
    // map read precedes this change, so the malformed path reaches this gate.
    empty := Produced("package deep_maps\nMain::()->int{values:[int:[int:int]]=[:];values[1][2]=3;return 0;}\n");
    assert(empty[1].kind == facts.DocumentRow);
    carrier := -1;
    for (row in empty) { if (row.kind == facts.MapRow && row.value == facts.NestedMapSet) { carrier = (row.type - facts.MapType) / 16; } }
    field := NestedMapCarrierField(empty, carrier);
    assert(field >= 0);
    RejectChanged(empty, [Changed(field, TypeField, i64(facts.ArrayType + facts.IntType))], mismatch);
}

DeepMapPlacesGrowth :: () {
    previous := 0;
    previous_delta := 0;
    // These fixed depths stay within one field/type-ID digit width. Each
    // doubled source path must add twice the work, with a small spelling margin.
    for (depth in [int(4),8,16,32]) {
        type := "int";
        literal := "0";
        keys := "";
        for (index in 0..<depth) {
            type = strings.Concatenate(["[int:", type, "]"]);
            literal = strings.Concatenate(["[1:", literal, "]"]);
            keys = strings.Concatenate([keys, "[1]"]);
        }
        source := strings.Concatenate(["package deep_growth\nMain::()->int{values:", type, "=", literal,
            ";values", keys, "+=1;return values", keys, ";}\n"]);
        rows := Produced(source);
        assert(rows[1].kind == facts.DocumentRow && scalar.Validate(rows) == "");
        text := IR(rows);
        projections := 0;
        for (line in strings.SplitLines(text)) {
            if (strings.Contains(line, " = call ptr @chibi_map.") && strings.Contains(line, ".reference(")) { projections += 1; }
        }
        assert(projections == depth - 1, "one canonical projection per intermediate owner");
        bytes := strings.ByteLength(text);
        delta := bytes - previous;
        if (previous_delta > 0) { assert(delta * 10 < previous_delta * 23, "emitted helper/code growth is linear in depth"); }
        os.Print(format_text("deep map depth{}: {} bytes, {} canonical projections", depth, bytes, projections));
        previous_delta = delta; previous = bytes;
    }
}

// Interning can leave unused carrier declarations. Always mutate the exact
// physical carrier named by the operation under test.
NestedMapCarrierField :: (rows: facts.Row[], wanted: int) -> int {
    type := facts.RecordType;
    for (row, index in rows) {
        if (row.kind != facts.RecordRow && row.kind != facts.UnionRow) { continue; }
        if (type == wanted) { return index + 1; }
        type += 1;
    }
    return -1;
}


Corpus :: () {
    count := cases.Count();
    for index in 0..<count {
        rows := Produced(cases.Source(index));
        checked := cases.Check(rows);
        if checked != 1 { os.Print(format_text("{}: Check returned {}", cases.CaseName(index), checked)); }
        assert(checked == 1, "real scalar corpus matches its authored source oracle");
        assert(scalar.Validate(rows) == "");
        bytes := scalar.EmitBytesFor(abi.LinuxX64(), rows);
        if rows[1].kind == facts.RejectionRow {
            assert(length(bytes) == 0);
            switch scalar.EmitFor(abi.LinuxX64(), rows) {
                case .Rejected(rejected): assert(length(rejected) == length(rows) && rejected[1].text == rows[1].text);
                case: assert(false, "rejected corpus source keeps its projection");
            }
        } else {
            assert(length(bytes) > 0);
        }
    }
    os.Print(format_text("PASS all {} real scalar corpus cases, including deep operands", count));
}


DeclarationInput :: (path: string, text: string) -> snapshot.Input {
    return {path: path, text: text, has_path: true, has_text: true};
}

// Declare the same address-taking body in separate imported packages. This
// checks table growth without compiling the bodies or depending on type kinds.
DeclarationTypeCount :: (count: int) -> int {
    names := ["p01", "p02", "p03", "p04"];
    root := "package app\n";
    for (index in 0..<count) {
        root = strings.Concatenate([root, "import ", names[index], " \"../", names[index], "\"\n"]);
    }
    root = strings.Concatenate([root, "Main :: () -> int { return 0; }\n"]);
    inputs := [DeclarationInput("app/Main.chibi", root)];
    for (index in 0..<count) {
        source := strings.Concatenate(["package ", names[index], "\npub Touch :: () -> int { value: int = 1; pointer := &value; return pointer^; }\n"]);
        inputs.append(DeclarationInput(strings.Concatenate([names[index], "/Main.chibi"]), source));
    }
    sizes: u64[] = [];
    for (input in inputs) { sizes.append(u64(strings.ByteLength(input.text))); }
    collections: routes.Collection[] = [];
    options: snapshot.Options = {project: "/probe", has_project: true, has_options: true,
        has_files: true, has_collections: false, file_count: length(inputs), collection_count: 0};
    switch snapshot.Build(options, collections, inputs, sizes) {
        case .Rejected(diagnostic, related, graph_error, cycle, documents, nodes, imports):
            os.Print(diagnostic.message);
            assert(false, "declaration growth fixture snapshot is valid");
        case .Accepted(roots, documents, nodes, imports, built):
            assert(length(documents) == count + 1 && length(imports) == count);
            switch built {
                case .Rejected(error, cycle):
                    assert(false, "declaration growth fixture graph is valid");
                case .Accepted(packages, files_of, file_packages, order, edges, links):
                    assert(length(packages) == count + 1 && length(files_of) == count + 1);
                    assert(length(file_packages) == count + 1 && length(order) == count + 1);
                    assert(length(edges) == count && length(links) == count);
                    for (index in 0..<length(packages)) {
                        expected := "app";
                        if (index > 0) { expected = names[index - 1]; }
                        assert(packages[index].name == expected && packages[index].member_count == 1);
                        assert(files_of[packages[index].member_start] == index && file_packages[index] == index);
                    }
                    switch compiler.Declare(nodes, documents, packages, files_of, order, edges, file_packages[0], imports, links, TargetFacts()) {
                        case .Failed(diagnostic):
                            os.Print(diagnostic.message);
                            assert(false, "declaration growth fixture declares successfully");
                        case .Declared(callables, params, types, members, constants, active_order, bound, kept):
                            assert(length(callables) == count + 1 && length(params) == 0);
                            assert(length(members) == 0 && length(constants) == 0);
                            assert(length(active_order) == count + 1 && length(bound) == count && length(kept) == count);
                            declared := resize([false], length(packages));
                            for (callable in callables) {
                                package := callable.package;
                                assert(package >= 0 && package < length(packages) && !declared[package]);
                                expected := "Touch";
                                if (package == file_packages[0]) { expected = "Main"; }
                                assert(callable.name == expected && callable.count == 0);
                                declared[package] = true;
                            }
                            for (package in active_order) { assert(declared[package]); }
                            return length(types);
                    }
            }
    }
    return 0;
}

BoundedDeclarationConstructors :: () {
    one := DeclarationTypeCount(1);
    four := DeclarationTypeCount(4);
    assert(one > 0 && four > 0 && four <= 4 * one, "declaration type constructors grow at most with source package count");
}

InferredGenericAddressCompiles :: () {
    paths := ["Main.chibi", "lib/Lib.chibi"];
    sources := ["package probe\nimport lib \"project:lib\"\n\nMain :: () -> int {\n    original := [int(7)][0..<1];\n    return lib.Read(original);\n}\n",
                "package lib\n\npub Read :: (value: $T) -> int {\n    pointer := &value;\n    return 77;\n}\n"];
    collections: string[] = [];
    // Compilation only: the nonzero ABI stamp is serialized unchanged and
    // makes no claim about artifact admission or runtime execution.
    compiled := compiler.Compile("/project", collections, collections, paths, sources, false,
                                 TargetFacts(), u64(1), Names(), Natives(), Ports(), Identities());
    assert(compiled.error == nil, "inferred optional generic value has an addressable type");
    assert(length(compiled.bytes) > 0, "generic address demand emits prepared module bytes");
}

InlineGcRecordsKeepStructuralIdentity :: () {
    source := "package probe\nFlat :: struct { value:int; pointer:^int; }\nInline :: struct { values:^int[]; label:string; pointer:^int; }\nMain :: () -> int { number:=7; flat:Flat={value:3,pointer:&number}; cell:=&flat; value:Inline={values:[&number],label:\"held\",pointer:&number}; return cell.value+value.pointer^; }\n";
    rows := Produced(source);
    inline := -1; flat := -1;
    for index in 0..<length(rows) {
        row := rows[index];
        if (row.kind != facts.RecordRow) { continue; }
        if (row.name == "Inline") { inline = index; }
        if (row.name == "Flat") { flat = index; }
    }
    assert(inline >= 0 && flat >= 0, "both authored records project");
    assert(rows[inline].literal == 0, "value-only GC records carry structural root identity");
    for field in inline + 1..<inline + 1 + rows[inline].count { assert(rows[field].literal == 0); }
    assert(rows[flat].literal != 0, "the actual cell keeps a nominal layout identity");
    for field in flat + 1..<flat + 1 + rows[flat].count { assert(rows[field].literal != 0); }
    assert(scalar.Validate(rows) == "", "structural and nominal metadata remain distinct valid facts");
    invalid := ChangedRows(rows, [Changed(inline + 1, LiteralField, i64(1))]);
    assert(scalar.Validate(invalid) == "invalid scalar record member row", "structural members cannot carry cell tags");
}
InlineIdentityProof :: () -> int { InlineGcRecordsKeepStructuralIdentity(); return 0; }
