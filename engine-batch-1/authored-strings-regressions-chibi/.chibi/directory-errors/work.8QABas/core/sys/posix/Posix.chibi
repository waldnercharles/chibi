package posix
foreign import directory_faults "/Users/cwaldner/Personal/chibi/.worktrees/authored-strings-regressions/chibi/.chibi/directory-errors/work.8QABas/fault.a"
foreign directory_faults {
chibi_directory_open :: (path: cstring) -> rawptr
chibi_directory_read :: (directory: rawptr) -> rawptr
chibi_directory_close :: (directory: rawptr) -> i32
chibi_directory_errno_copy :: (destination: u8[], source: rawptr, count: u64) -> rawptr
}

import target "core:target"

// The POSIX calls core:os needs, declared against libc and called from native
// programs; the VM never runs foreign code. Paths are copied with a NUL into
// the call's stack buffer (see "Foreign libraries" in docs/code-language.md),
// so a path of 4096 bytes or more traps. A call that fails returns its libc
// result unchanged: 0 for success, -1 for failure; errno is not read yet.
// Getenv, which builds a string from C bytes, waits for allocating text natively.
//
// The stat layout and the directory entry's name offset are Linux x86-64's, and
// Darwin's when the build's destination is Darwin; Linux on other processors is
// not covered yet.

foreign import libc "system:c"

foreign libc {
    access :: (path: cstring, mode: i32) -> i32
    mkdir :: (path: cstring, mode: u32) -> i32
    mkdtemp :: (template: u8[]) -> rawptr
    unlink :: (path: cstring) -> i32
    rmdir :: (path: cstring) -> i32
    rename :: (source: cstring, destination: cstring) -> i32
    stat :: (path: cstring, buffer: u8[]) -> i32
    lstat :: (path: cstring, buffer: u8[]) -> i32
    fopen :: (path: cstring, mode: cstring) -> rawptr
    fread :: (buffer: u8[], size: u64, count: u64, stream: rawptr) -> u64
    fwrite :: (buffer: u8[], size: u64, count: u64, stream: rawptr) -> u64
    fclose :: (stream: rawptr) -> i32
    fseek :: (stream: rawptr, offset: i64, whence: i32) -> i32
    ftell :: (stream: rawptr) -> i64
    getenv :: (name: cstring) -> rawptr
    strlen :: (text: rawptr) -> u64
    memcpy :: (destination: u8[], source: rawptr, count: u64) -> rawptr
    memccpy :: (destination: rawptr, source: u8[], stop: i32, count: u64) -> rawptr
    
    
    
    memchr :: (buffer: u8[], value: i32, count: u64) -> rawptr
    pipe :: (descriptors: u8[]) -> i32
    read :: (descriptor: i32, buffer: u8[], count: u64) -> i64
    close :: (descriptor: i32) -> i32
    write :: (descriptor: i32, buffer: u8[], count: u64) -> i64
    _exit :: (code: i32) -> i32
    poll :: (descriptors: u8[], count: u64, timeout: i32) -> i32
    waitpid :: (pid: i32, status: u8[], options: i32) -> i32
    posix_spawnp :: (pid: u8[], file: cstring, actions: u8[], attributes: u8[], arguments: u8[], environment: rawptr) -> i32
    posix_spawn_file_actions_addopen :: (actions: u8[], descriptor: i32, path: cstring, flags: i32, mode: u32) -> i32
    posix_spawnattr_init :: (attributes: u8[]) -> i32
    posix_spawnattr_setflags :: (attributes: u8[], flags: i16) -> i32
    posix_spawnattr_setpgroup :: (attributes: u8[], group: i32) -> i32
    posix_spawnattr_destroy :: (attributes: u8[]) -> i32
    getcwd :: (buffer: u8[], size: u64) -> rawptr
    chdir :: (path: cstring) -> i32
    realpath :: (path: cstring, resolved: u8[]) -> rawptr
    chmod :: (path: cstring, mode: u32) -> i32
    kill :: (process: i32, signal: i32) -> i32
    usleep :: (microseconds: u32) -> i32
    getpid :: () -> i32
    // Each is declared everywhere and called on its own platform only.
    renamex_np :: (source: cstring, destination: cstring, flags: u32) -> i32
    renameat2 :: (source_directory: i32, source: cstring, destination_directory: i32, destination: cstring, flags: u32) -> i32
    posix_spawn_file_actions_init :: (actions: u8[]) -> i32
    posix_spawn_file_actions_adddup2 :: (actions: u8[], descriptor: i32, target: i32) -> i32
    posix_spawn_file_actions_addclose :: (actions: u8[], descriptor: i32) -> i32
    posix_spawn_file_actions_addchdir_np :: (actions: u8[], directory: cstring) -> i32
    posix_spawn_file_actions_destroy :: (actions: u8[]) -> i32
}

// Exports of the program's own start module (tools/compiler/native_link/Start.chibi):
// the process arguments and the environment its entry received.
foreign {
    chibi_argument_count :: () -> i64
    chibi_argument :: (index: i64, buffer: u8[], size: i64) -> i64
    chibi_environment :: () -> rawptr
}

pub KindNone: int : 0;
pub KindFile: int : 1;
pub KindDirectory: int : 2;
pub KindLink: int : 3;
pub KindOther: int : 4;

StatBytes: int : 256;

when target.Os == target.Darwin {
    ModeOffset: int : 4;
    ModeBytes: int : 2;
    NameOffset: int : 21;
    DeviceBytes: int : 4;
    SizeOffset: int : 96;
    ModifiedOffset: int : 48;
    ChangedOffset: int : 64;
    // O_WRONLY | O_CREAT | O_TRUNC
    WriteNew: int : 1537;
    // Renames without replacing: RENAME_EXCL.
    RenameNew :: (source: string, destination: string) -> bool {
        // Darwin accepts renaming a directory to itself, even with RENAME_EXCL.
        // Reject occupied names first; the kernel still excludes racing creates.
        if Kind(destination) != KindNone { return false; }
        return renamex_np(source, destination, 4) == 0;
    }
    pub Platform :: () -> string {
        return "Darwin";
    }
} else {
    ModeOffset: int : 24;
    ModeBytes: int : 4;
    NameOffset: int : 19;
    DeviceBytes: int : 8;
    SizeOffset: int : 48;
    ModifiedOffset: int : 88;
    ChangedOffset: int : 104;
    WriteNew: int : 577;
    // Renames without replacing: AT_FDCWD for both directories, RENAME_NOREPLACE.
    RenameNew :: (source: string, destination: string) -> bool {
        return renameat2(-100, source, -100, destination, 1) == 0;
    }
    pub Platform :: () -> string {
        return "Linux";
    }
}

// The device and inode lead the stat record on both platforms.
InodeOffset: int : 8;

// A directory entry begins with its inode and offset (8 bytes each) and then
// its record length, two bytes, at 16 on both platforms; the name follows the
// type at NameOffset.
RecordLengthOffset: int : 16;

// Whether the path names anything a link points at.
pub Exists :: (path: string) -> bool {
    return access(path, 0) == 0;
}

// The mode bits of the path's stat, -1 when it does not exist. A link is
// followed unless `link`.
Mode :: (path: string, link: bool) -> int {
    buffer: u8[] = [];
    for index in 0..<StatBytes {
        buffer.append(0);
    }
    status: i32 = 0;
    if link {
        status = lstat(path, buffer);
    } else {
        status = stat(path, buffer);
    }
    if status != 0 {
        return -1;
    }
    mode := 0;
    for index in 0..<ModeBytes {
        mode += int(buffer[ModeOffset + index]) << u32(8 * index);
    }
    return mode;
}

// What the path names, KindNone when nothing. A link is not followed.
pub Kind :: (path: string) -> int {
    mode := Mode(path, true);
    if mode < 0 {
        return KindNone;
    }
    format := mode & 61440;
    if format == 32768 {
        return KindFile;
    }
    if format == 16384 {
        return KindDirectory;
    }
    if format == 40960 {
        return KindLink;
    }
    return KindOther;
}

// Makes the directory and its missing parents; one that exists already is
// not an error, but it must be a directory the program can write.
pub MakeDirectory :: (path: string) -> bool {
    size := text_byte_length(path);
    at := 1;
    while at < size {
        if text_byte_at(path, at) == 47 {
            status := mkdir(text_slice(path, 0, at), 493);
        }
        at += 1;
    }
    status := mkdir(path, 493);
    mode := Mode(path, false);
    return mode >= 0 && (mode & 61440) == 16384 && access(path, 3) == 0;
}

// Makes one new directory whose parent exists; any existing path, a link
// included, fails.
pub Reserve :: (path: string) -> bool {
    return mkdir(path, 493) == 0;
}

// Renames a prepared directory to a destination that does not exist; the kernel
// refuses an existing destination, an empty directory included.
pub Publish :: (source: string, destination: string) -> bool {
    if Kind(source) != KindDirectory {
        return false;
    }
    return RenameNew(source, destination);
}

// Removes a file or link, or an empty directory. A path that is not there is
// not an error.
pub Remove :: (path: string) -> bool {
    kind := Kind(path);
    if kind == KindNone {
        return true;
    }
    if kind == KindDirectory {
        return rmdir(path) == 0;
    }
    return unlink(path) == 0;
}

pub Rename :: (source: string, destination: string) -> bool {
    return rename(source, destination) == 0;
}

// The file's size in bytes, -1 when it cannot be opened.
pub FileSize :: (path: string) -> int {
    stream := fopen(path, "rb");
    if stream == 0 {
        return -1;
    }
    status := fseek(stream, 0, 2);
    size := ftell(stream);
    status = fclose(stream);
    return int(size);
}

// The file's bytes, including NUL and malformed UTF-8; no bytes when it cannot
// be read (FileSize tells that from an empty file). Opens through stdio, which
// takes no variadic arguments, so it is the same call on every platform.
pub ReadBytes :: (path: string) -> u8[] {
    buffer: u8[] = [];
    stream := fopen(path, "rb");
    if stream == 0 {
        return buffer;
    }
    status := fseek(stream, 0, 2);
    size := int(ftell(stream));
    status = fseek(stream, 0, 0);
    buffer = Block(size);
    read := fread(buffer, 1, u64(size), stream);
    status = fclose(stream);
    if int(read) != size {
        empty: u8[] = [];
        return empty;
    }
    return buffer;
}

// Replaces the file with the bytes; false when it cannot be written whole.
pub WriteBytes :: (path: string, data: u8[]) -> bool {
    stream := fopen(path, "wb");
    if stream == 0 {
        return false;
    }
    written := fwrite(data, 1, u64(length(data)), stream);
    closed := fclose(stream);
    return int(written) == length(data) && closed == 0;
}

// The text of the bytes, which may hold NUL and malformed UTF-8.
pub Text :: (data: u8[]) -> string {
    return text_from_bytes(data);
}

// The file's text, "" when it cannot be read.
pub ReadText :: (path: string) -> string {
    return text_from_bytes(ReadBytes(path));
}

// Whether the variable exists, including one whose value is empty.
pub HasEnv :: (name: string) -> bool {
    return getenv(name) != 0;
}

// The environment variable's value, "" when it is unset.
pub Getenv :: (name: string) -> string {
    value := getenv(name);
    if value == 0 {
        return "";
    }
    size := int(strlen(value));
    buffer: u8[] = [];
    for index in 0..<size {
        buffer.append(0);
    }
    moved := memcpy(buffer, value, u64(size));
    return text_from_bytes(buffer);
}

// Failed enumeration never exposes a partial inventory. The errno copy buffer
// is allocated before readdir so an allocation cannot overwrite its error.
pub ListChecked :: (path: string) -> (names: string[], complete: bool) {
    names: string[] = [];
    directory := chibi_directory_open(path);
    if directory == 0 {
        return (names, false);
    }
    error_address := ErrnoAddress();
    error_bytes := Block(4);
    head := Block(RecordLengthOffset + 2);
    error := 0;
    while true {
        // The four zero bytes contain no 1, so memccpy copies all four. Its
        // actual pointer return keeps this boundary compatible with old seeds.
        cleared := memccpy(error_address, error_bytes, 1, 4);
        record_at := chibi_directory_read(directory);
        if record_at == 0 {
            copied := chibi_directory_errno_copy(error_bytes, error_address, 4);
            error = Word32(error_bytes, 0);
            break;
        }
        // The record length is read from a copy of the entry's head, then
        // exactly that many bytes are copied, so nothing past the entry is read.
        moved := memcpy(head, record_at, u64(RecordLengthOffset + 2));
        size := int(head[RecordLengthOffset]) + int(head[RecordLengthOffset + 1]) * 256;
        record: u8[] = [];
        for index in 0..<size {
            record.append(0);
        }
        moved = memcpy(record, record_at, u64(size));
        name: u8[] = [];
        at := NameOffset;
        while at < length(record) && record[at] != 0 {
            name.append(record[at]);
            at += 1;
        }
        text := text_from_bytes(name);
        if text != "." && text != ".." {
            names.append(text);
        }
    }
    status := chibi_directory_close(directory);
    if (error != 0 || status != 0) { return ([], false); }
    return (names, true);
}

// Raw platform compatibility: an unsuccessful listing remains empty. Fallible
// callers use ListChecked to distinguish it from a successful empty directory.
pub List :: (path: string) -> string[] {
    return ListChecked(path).names;
}

// A finished child process (named Output so the record does not share a name with core:os's Result: the native lane keys records by name): its exit status (the negative signal number when a
// signal ended it, 127 when the program could not be started) and, for Capture,
// what it wrote.
pub Output :: struct {
    status: int;
    stdout: string;
    stderr: string;
}

// One managed allocation holds the argv pointer table and every NUL-ended
// argument after it. Passing the complete buffer to posix_spawnp borrows both
// together until spawn returns; no raw allocation survives each launch.
// Pointers are 8-byte little-endian words on the supported POSIX targets.
Vector :: (command: string[]) -> u8[] {
    header := (u64(length(command)) + 1) * 8;
    size := header;
    for argument in command {
        size += u64(text_byte_length(argument)) + 1;
    }
    if size > 2147483647 {
        empty: u8[] = [];
        return empty;
    }
    vector := Block(int(size));
    // The first byte is zero before filling, so memchr returns this buffer's
    // address with its actual C signature and no unchecked pointer cast.
    address := memchr(vector, 0, 1);
    offset := int(header);
    for argument, at in command {
        length := text_byte_length(argument);
        for index in 0..<length {
            byte := u8(text_byte_at(argument, index));
            if byte == 0 {
                empty: u8[] = [];
                return empty;
            }
            vector[offset + index] = byte;
        }
        word := u64(address) + u64(offset);
        for index in 0..<8 {
            vector[at * 8 + index] = u8((word >> u32(8 * index)) & 255);
        }
        offset += length + 1;
    }
    return vector;
}

// What `waitpid` reported as an exit status.
Decoded :: (status: int) -> int {
    signal := status & 127;
    if signal == 0 {
        return (status >> 8) & 255;
    }
    return -signal;
}

// A zeroed block for a libc structure the program only passes along.
Block :: (size: int) -> u8[] {
    return resize([u8(0)], size);
}

// The 32-bit integer at `at` in `bytes`, little endian.
Word32 :: (bytes: u8[], at: int) -> int {
    return int(bytes[at]) + int(bytes[at + 1]) * 256 + int(bytes[at + 2]) * 65536 + int(bytes[at + 3]) * 16777216;
}

// Starts the program with the prepared file actions, which it destroys, and
// returns its process id; -1 when it cannot be started. `own_group` puts it in a
// process group of its own, so Kill reaches what it started too.
Launch :: (command: string[], actions: u8[], own_group: bool) -> int {
    vector := Vector(command);
    if length(vector) == 0 {
        destroyed := posix_spawn_file_actions_destroy(actions);
        return -1;
    }
    pid := Block(8);
    attributes := Block(512);
    status := posix_spawnattr_init(attributes);
    if own_group {
        status = posix_spawnattr_setflags(attributes, 2);
        status = posix_spawnattr_setpgroup(attributes, 0);
    }
    started := posix_spawnp(pid, command[0], actions, attributes, vector, chibi_environment());
    status = posix_spawnattr_destroy(attributes);
    status = posix_spawn_file_actions_destroy(actions);
    if started != 0 {
        return -1;
    }
    return Word32(pid, 0);
}

// Starts the program with the command's arguments, keeping this process's
// standard streams, and returns its process id; -1 when it cannot be started.
pub Spawn :: (command: string[]) -> int {
    if length(command) == 0 {
        return -1;
    }
    actions := Block(256);
    status := posix_spawn_file_actions_init(actions);
    return Launch(command, actions, false);
}

// Waits for an attached child and returns its exit status. A child stopped by
// job control stops its caller too; resuming the caller resumes that child.
pub Wait :: (process: int) -> int {
    status := Block(8);
    while (true) {
        done := waitpid(i32(process), status, 2);
        if (done < 0) {
            if (ErrorNumber() == 4) { continue; }
            return -1;
        }
        word := Word32(status, 0);
        if ((word & 127) == 127) {
            stopped := kill(getpid(), i32(ForegroundStop));
            continued := kill(i32(process), i32(ForegroundContinue));
            continue;
        }
        return Decoded(word);
    }
    return -1;
}

// Runs the program, keeping the standard streams, and returns its exit status;
// 127 when it cannot be started.
pub Run :: (command: string[]) -> int {
    process := Spawn(command);
    if process < 0 {
        return 127;
    }
    return Wait(process);
}

// Runs the program with its standard output and error read into the result.
// Both pipes are read together, so a child filling one cannot stop on the other.
pub Capture :: (command: string[]) -> Output {
    result: Output = {status: 127, stdout: "", stderr: ""};
    if length(command) == 0 {
        return result;
    }
    out := Block(8);
    err := Block(8);
    made := pipe(out);
    made = made + pipe(err);
    if made != 0 {
        return result;
    }
    out_read := i32(Word32(out, 0));
    out_write := i32(Word32(out, 4));
    err_read := i32(Word32(err, 0));
    err_write := i32(Word32(err, 4));
    actions := Block(256);
    status := posix_spawn_file_actions_init(actions);
    status = posix_spawn_file_actions_adddup2(actions, out_write, 1);
    status = posix_spawn_file_actions_adddup2(actions, err_write, 2);
    status = posix_spawn_file_actions_addclose(actions, out_read);
    status = posix_spawn_file_actions_addclose(actions, err_read);
    pid := Launch(command, actions, false);
    status = close(out_write);
    status = close(err_write);
    standard: u8[] = [];
    errors: u8[] = [];
    if pid >= 0 {
        // Two pollfd records: descriptor (4 bytes), requested events (2),
        // returned events (2). POLLIN is 1 and POLLHUP is 16 on both platforms.
        watched := Block(16);
        for index in 0..<4 {
            watched[index] = u8(Word32(out, 0) >> u32(8 * index));
            watched[8 + index] = u8(Word32(err, 0) >> u32(8 * index));
        }
        watched[4] = 1;
        watched[12] = 1;
        chunk := Block(4096);
        open := 2;
        while open > 0 {
            ready := poll(watched, 2, -1);
            if ready < 0 {
                break;
            }
            for stream in 0..<2 {
                if watched[stream * 8 + 6] != 0 {
                    descriptor := out_read;
                    if stream == 1 {
                        descriptor = err_read;
                    }
                    count := read(descriptor, chunk, 4096);
                    if count <= 0 {
                        // Closed: stop watching it.
                        watched[stream * 8 + 3] = 255;
                        watched[stream * 8 + 2] = 255;
                        watched[stream * 8 + 1] = 255;
                        watched[stream * 8] = 255;
                        open -= 1;
                    } else {
                        for index in 0..<int(count) {
                            if stream == 0 {
                                standard.append(chunk[index]);
                            } else {
                                errors.append(chunk[index]);
                            }
                        }
                    }
                }
            }
        }
        result.status = Wait(pid);
    }
    status = close(out_read);
    status = close(err_read);
    result.stdout = text_from_bytes(standard);
    result.stderr = text_from_bytes(errors);
    return result;
}

// The bytes up to the first NUL, as text.
Terminated :: (buffer: u8[]) -> string {
    end := 0;
    while end < length(buffer) && buffer[end] != 0 {
        end += 1;
    }
    text: u8[] = [];
    for index in 0..<end {
        text.append(buffer[index]);
    }
    return text_from_bytes(text);
}

pub ChangeDirectory :: (path: string) -> bool {
    return chdir(path) == 0;
}

// Sets mode 0755 after artifact transfer has discarded a program's file mode.
pub MakeExecutable :: (path: string) -> bool {
    return chmod(path, 493) == 0;
}

// The current working directory, "" when it cannot be read.
pub Root :: () -> string {
    buffer := Block(4096);
    at := getcwd(buffer, 4096);
    if at == 0 {
        return "";
    }
    return Terminated(buffer);
}

// The absolute path with links resolved, "" when the path does not exist.
pub RealPath :: (path: string) -> string {
    buffer := Block(4096);
    at := realpath(path, buffer);
    if at == 0 {
        return "";
    }
    return Terminated(buffer);
}

// The little-endian integer of `size` bytes at `at`.
Word :: (bytes: u8[], at: int, size: int) -> int {
    value := 0;
    for index in 0..<size {
        value += int(bytes[at + index]) << u32(8 * index);
    }
    return value;
}

// `value` in octal.
Octal :: (value: int) -> string {
    if value == 0 {
        return "0";
    }
    reversed: u8[] = [];
    rest := value;
    while rest > 0 {
        reversed.append(u8(48 + rest % 8));
        rest = rest / 8;
    }
    digits: u8[] = [];
    at := length(reversed) - 1;
    while at >= 0 {
        digits.append(reversed[at]);
        at -= 1;
    }
    return text_from_bytes(digits);
}

// `value`, a count of nanoseconds, as nine digits.
Nanoseconds :: (value: int) -> string {
    text := format_text("{}", value);
    while text_byte_length(text) < 9 {
        text = format_text("0{}", text);
    }
    return text;
}

// The file's identity and metadata for change detection, not a content hash.
// Equal stamps can miss rapid same-size rewrites on a coarse filesystem clock.
// "" when the path does not exist. A link is followed.
// The text is the build host's, `device:inode:size:mode:mtime:ctime`
// with the mode in octal and the times as seconds.nanoseconds, so a record
// either host wrote reads the same for the other.
pub Stamp :: (path: string) -> string {
    buffer := Block(StatBytes);
    if stat(path, buffer) != 0 {
        return "";
    }
    return format_text("{}:{}:{}:{}:{}.{}:{}.{}", Word(buffer, 0, DeviceBytes), Word(buffer, InodeOffset, 8),
                       Word(buffer, SizeOffset, 8), Octal(Word(buffer, ModeOffset, ModeBytes)),
                       Word(buffer, ModifiedOffset, 8), Nanoseconds(Word(buffer, ModifiedOffset + 8, 8)),
                       Word(buffer, ChangedOffset, 8), Nanoseconds(Word(buffer, ChangedOffset + 8, 8)));
}

// Copies the file's bytes and permission bits to the destination, whose folder
// exists. The copy is written beside it and renamed over it, so a reader never
// sees half a file.
pub Copy :: (source: string, destination: string) -> bool {
    mode := Mode(source, false);
    if mode < 0 || (mode & 61440) != 32768 {
        return false;
    }
    data := ReadBytes(source);
    if length(data) != FileSize(source) {
        return false;
    }
    temporary := format_text("{}.copy-{}", destination, getpid());
    if !WriteBytes(temporary, data) {
        status := unlink(temporary);
        return false;
    }
    if chmod(temporary, u32(mode & 511)) != 0 || rename(temporary, destination) != 0 {
        status := unlink(temporary);
        return false;
    }
    return true;
}

// mkdtemp atomically reserves a private directory on the parent's filesystem.
pub TemporaryDirectory :: (parent: string) -> string {
    pattern := format_text("{}/work.XXXXXX", parent);
    template := Block(text_byte_length(pattern) + 1);
    for index in 0..<text_byte_length(pattern) {
        template[index] = u8(text_byte_at(pattern, index));
    }
    made := mkdtemp(template);
    if made == 0 {
        return "";
    }
    return Terminated(template);
}

// Whether the path is a regular file the program may run; a link is followed.
Executable :: (path: string) -> bool {
    mode := Mode(path, false);
    return mode >= 0 && (mode & 61440) == 32768 && access(path, 1) == 0;
}

// The first executable of that name on PATH, "" when none; a name with a slash
// is looked up as it is.
pub FindExecutable :: (name: string) -> string {
    if name == "" {
        return "";
    }
    size := text_byte_length(name);
    for index in 0..<size {
        if text_byte_at(name, index) == 47 {
            if Executable(name) {
                return name;
            }
            return "";
        }
    }
    search := Getenv("PATH");
    length_of := text_byte_length(search);
    at := 0;
    while at <= length_of {
        end := at;
        while end < length_of && text_byte_at(search, end) != 58 {
            end += 1;
        }
        directory := text_slice(search, at, end - at);
        if directory == "" {
            directory = ".";
        }
        candidate := format_text("{}/{}", directory, name);
        if Executable(candidate) {
            return candidate;
        }
        at = end + 1;
    }
    return "";
}

// What WaitFor returns for a program that still runs: past any exit status or
// negative signal number. core:os's StillRunning is this value.
pub StillRunning: int : 65536;

// Where a started program's output waits for WaitFor: one file per process in
// the temporary folder, so the process id is the whole handle.
OutputPath :: (process: int) -> string {
    folder := Getenv("TMPDIR");
    if folder == "" {
        folder = "/tmp";
    }
    return format_text("{}/chibi-{}-{}.out", folder, getpid(), process);
}

// Starts the program in a process group of its own and returns its process id;
// -1 when it cannot be started. With `piped` its standard output and error go to
// one file that WaitFor prints when the program ends, keeping the lines of
// programs that run together apart; otherwise it shares this program's streams.
pub Start :: (command: string[], piped: bool) -> int {
    if length(command) == 0 {
        return -1;
    }
    actions := Block(256);
    status := posix_spawn_file_actions_init(actions);
    // A program in a group of its own must not read the terminal.
    status = posix_spawn_file_actions_addopen(actions, 0, "/dev/null", 0, 0);
    waiting := "";
    if piped {
        // The process id is not known before the program starts, so the file
        // is renamed once it is; the program keeps writing to the same file.
        // The name is removed first and the file is private (mode 0600), so a
        // file or link left in the temporary folder is not written through.
        waiting = OutputPath(0);
        status = unlink(waiting);
        status = posix_spawn_file_actions_addopen(actions, 1, waiting, i32(WriteNew), 384);
        status = posix_spawn_file_actions_adddup2(actions, 1, 2);
    }
    process := Launch(command, actions, true);
    if piped {
        if process < 0 {
            status = unlink(waiting);
        } else if rename(waiting, OutputPath(process)) != 0 {
            // Its output has no place to wait: stop it rather than lose it.
            status = kill(i32(0 - process), 9);
            done := WaitFor(process, -1);
            return -1;
        }
    }
    return process;
}

// Starts a process with stdout and stderr in separate caller-owned
// files. Empty stdout inherits the stream. Parent folders exist, and nonempty
// paths are distinct. Attached children share their parent's process group;
// others own a group for Kill to stop. Existing
// files are truncated with private permissions for newly created files.
// WaitFor/Kill retain their usual process semantics and leave these files
// for the caller to read and remove. Failure to start returns -1.
pub StartRedirected :: (command: string[], stdout_path: string, stderr_path: string, attached: bool = false) -> int {
    return StartRedirectedIn(command, stdout_path, stderr_path, "", attached);
}

// Sets only the child's working directory, preserving the caller's process-wide
// cwd. Equal output paths are permitted only for the explicit null device.
pub StartRedirectedIn :: (command: string[], stdout_path: string, stderr_path: string, directory: string, attached: bool = false) -> int {
    if length(command) == 0 || stderr_path == "" || (stdout_path == stderr_path && stdout_path != "/dev/null") {
        return -1;
    }
    actions := Block(256);
    status := posix_spawn_file_actions_init(actions);
    if status != 0 {
        return -1;
    }
    if directory != "" { status = posix_spawn_file_actions_addchdir_np(actions, directory); }
    if status == 0 { status = posix_spawn_file_actions_addopen(actions, 0, "/dev/null", 0, 0); }
    if status == 0 && stdout_path != "" {
        status = posix_spawn_file_actions_addopen(actions, 1, stdout_path, i32(WriteNew), 384);
    }
    if status == 0 {
        status = posix_spawn_file_actions_addopen(actions, 2, stderr_path, i32(WriteNew), 384);
    }
    if status != 0 {
        destroyed := posix_spawn_file_actions_destroy(actions);
        return -1;
    }
    process := Launch(command, actions, !attached);
    if process > 0 {
        // A dead ancestor may have left an automatic Piped report under a
        // reused PID. This process owns caller paths, never that report.
        discarded := unlink(OutputPath(process));
    }
    return process;
}

// Prints what a piped program wrote to this program's standard error and
// removes the file.
Report :: (process: int) {
    path := OutputPath(process);
    if Kind(path) != KindFile {
        return;
    }
    data := ReadBytes(path);
    if length(data) > 0 {
        written := write(2, data, u64(length(data)));
    }
    status := unlink(path);
}

// Waits at most `timeout_ms` (negative: for as long as it takes) for the program
// to end and returns its exit status or the negative signal number that stopped
// it; StillRunning when the time passed first. A program that could not start
// has the status 127. A process ends once: waiting again returns -1.
pub WaitFor :: (process: int, timeout_ms: int) -> int {
    if process < 0 {
        return 127;
    }
    status := Block(8);
    waited := 0;
    done: i32 = 0;
    if timeout_ms < 0 {
        done = waitpid(i32(process), status, 0);
    } else {
        done = waitpid(i32(process), status, 1);
        while done == 0 && waited < timeout_ms {
            usleep(2000);
            waited += 2;
            done = waitpid(i32(process), status, 1);
        }
    }
    if done == 0 {
        return StillRunning;
    }
    if done < 0 {
        return -1;
    }
    Report(process);
    return Decoded(Word32(status, 0));
}

// Wait for an isolated redirected child's whole group. waitid leaves its
// leader unreaped until the group has been stopped, so its PID cannot be reused
// for an unrelated group. Scratch is caller-owned >=256 bytes and reused while
// polling; this does not install handlers or change caller signal state.
pub WaitGroup :: (process: int, information: ^(u8[]), timeout_ms: int) -> int {
    if process <= 0 || length(information^) < 256 { return 127; }
    waited: i64 = 0;
    while true {
        for (byte in ForegroundInfoPid..<ForegroundInfoPid + 4) { information^[byte] = 0; }
        checked := waitid(1, u32(process), information^, i32(1 + 4 + ForegroundNowait));
        if checked < 0 {
            error := ErrorNumber();
            if error == 4 { continue; }
            return -1;
        }
        if Word32(information^, ForegroundInfoPid) == process {
            // No callback or other reap may intervene between ownership proof
            // and retiring the group. The leader remains reserved by waitid.
            stopped := kill(i32(0 - process), 9);
            done := waitpid(i32(process), information^, 0);
            while done < 0 {
                error := ErrorNumber();
                if error != 4 { return -1; }
                done = waitpid(i32(process), information^, 0);
            }
            if done != i32(process) { return -1; }
            return Decoded(Word32(information^, 0));
        }
        if timeout_ms >= 0 && waited >= i64(timeout_ms) { return StillRunning; }
        paused := usleep(2000);
        waited += 2;
    }
}

// Stops the program and everything it started, waits for it and returns what
// WaitFor would: -9 for a program that was running.
pub Kill :: (process: int) -> int {
    if process <= 0 {
        return 127;
    }
    status := kill(i32(0 - process), 9);
    if status != 0 {
        // An attached child belongs to its parent's cancellation group.
        // Killing its handle still stops/reaps that child; the parent group
        // owns cancellation of any descendants it started.
        status = kill(i32(process), 9);
    }
    return WaitFor(process, -1);
}

// The program's arguments, the first being how it was started. Each is read
// twice: its length first, then its bytes into a buffer of that size.
pub Arguments :: () -> string[] {
    arguments: string[] = [];
    count := int(chibi_argument_count());
    for index in 0..<count {
        none: u8[] = [];
        size := int(chibi_argument(i64(index), none, 0));
        if size < 0 {
            break;
        }
        bytes := Block(size);
        copied := chibi_argument(i64(index), bytes, i64(size));
        arguments.append(text_from_bytes(bytes));
    }
    return arguments;
}

pub IsFile :: (path: string) -> bool {
    return Kind(path) == KindFile;
}

pub IsDirectory :: (path: string) -> bool {
    return Kind(path) == KindDirectory;
}

// The bytes of the text, a copy.
Bytes :: (text: string) -> u8[] {
    data: u8[] = [];
    size := text_byte_length(text);
    for index in 0..<size {
        data.append(u8(text_byte_at(text, index)));
    }
    return data;
}

// Replaces the file with the text; false when it cannot be written whole.
pub WriteText :: (path: string, text: string) -> bool {
    return WriteBytes(path, Bytes(text));
}

// Writes the line and a newline to standard error, as build reports do; false
// when it cannot be written whole.
pub Print :: (line: string) -> bool {
    data := Bytes(line);
    data.append(10);
    written := write(2, data, u64(length(data)));
    return int(written) == length(data);
}

// Writes the text to standard output unchanged, retrying a short write; false
// when it cannot be written whole.
pub WriteOutput :: (text: string) -> bool {
    data := Bytes(text);
    done := 0;
    while done < length(data) {
        rest: u8[] = [];
        for index in done..<length(data) {
            rest.append(data[index]);
        }
        written := int(write(1, rest, u64(length(rest))));
        if written <= 0 {
            return false;
        }
        done += written;
    }
    return true;
}

// Ends the process with the exit status; it does not return.
pub Exit :: (code: int) -> int {
    return int(_exit(i32(code)));
}

foreign import foreground_libc "system:c"
foreign foreground_libc {
    open :: (path: cstring, flags: i32) -> i32
    dup :: (descriptor: i32) -> i32
    socketpair :: (domain: i32, type: i32, protocol: i32, descriptors: u8[]) -> i32
    send :: (descriptor: i32, text: cstring, count: u64, flags: i32) -> i64
    signal :: (number: i32, handler: fn(number: i32) -> i32) -> u64
    sigaction :: (number: i32, actions: u8[], previous: u8[]) -> i32
    sigemptyset :: (signals: u8[]) -> i32
    sigaddset :: (signals: u8[], number: i32) -> i32
    sigprocmask :: (how: i32, signals: u8[], previous: u8[]) -> i32
    posix_spawnattr_setsigmask :: (attributes: u8[], signals: u8[]) -> i32
    posix_spawnattr_setsigdefault :: (attributes: u8[], signals: u8[]) -> i32
    getpgrp :: () -> i32
    tcgetpgrp :: (terminal: i32) -> i32
    tcsetpgrp :: (terminal: i32, group: i32) -> i32
    waitid :: (kind: i32, process: u32, information: u8[], options: i32) -> i32
    clock_gettime :: (clock: i32, stamp: u8[]) -> i32
    __error :: () -> rawptr
    __errno_location :: () -> rawptr
}

when target.Os == target.Darwin {
    ForegroundBlock: int : 1;
    ForegroundSetMask: int : 3;
    ForegroundCloseOnExec: int : 16777216;
    ForegroundNonblockingSend: int : 128;
    ForegroundStopped: int : 8;
    ForegroundNowait: int : 32;
    ForegroundInfoPid: int : 12;
    ForegroundStop: int : 17;
    ForegroundContinue: int : 19;
    ForegroundClock: int : 6;
    ErrnoAddress :: () -> rawptr { return __error(); }
} else {
    ForegroundBlock: int : 0;
    ForegroundSetMask: int : 2;
    ForegroundCloseOnExec: int : 524288;
    ForegroundNonblockingSend: int : 64;
    ForegroundStopped: int : 2;
    ForegroundNowait: int : 16777216;
    ForegroundInfoPid: int : 16;
    ForegroundStop: int : 19;
    ForegroundContinue: int : 18;
    ForegroundClock: int : 1;
    ErrnoAddress :: () -> rawptr { return __errno_location(); }
}

// Thread-local errno from the last failed libc call. Read it immediately,
// before another OS call can replace it on this thread.
pub ErrorNumber :: () -> int {
    bytes := Block(4);
    copied := memcpy(bytes, ErrnoAddress(), 4);
    return Word32(bytes, 0);
}

ForegroundReaped :: struct { status: int; error: int; }
ForegroundReap :: (pid: int) -> ForegroundReaped {
    status := Block(8);
    done := waitpid(i32(pid), status, 0);
    while (done < 0) {
        error := ErrorNumber();
        if (error != 4) { return {status: 1, error: error}; }
        done = waitpid(i32(pid), status, 0);
    }
    return {status: Decoded(Word32(status, 0)), error: 0};
}

// One process-wide foreground owner. These scalars are initialized while the
// signals are blocked and remain read-only until the old handlers are restored.
// The handler never allocates, changes retained state, or enters the collector.
ForegroundHook :: (descriptor: int, child: int) -> int {
    output: retain int = 0;
    pid: retain int = 0;
    if (descriptor >= 0) { output = descriptor; pid = child; }
    if (descriptor == -2) { return pid; }
    return output;
}

ForegroundSignal :: (number: i32) -> i32 {
    child := ForegroundHook(-2, 0);
    if (child > 0) { sent := kill(i32(0 - child), number); }
    descriptor := ForegroundHook(-1, 0);
    if (number == 2) { return i32(send(i32(descriptor), "I", 1, i32(ForegroundNonblockingSend))); }
    if (number == 15) { return i32(send(i32(descriptor), "T", 1, i32(ForegroundNonblockingSend))); }
    return i32(send(i32(descriptor), "H", 1, i32(ForegroundNonblockingSend)));
}

// ForegroundStart owns one child group, its terminal handoff, and the temporary
// signal handlers. ForegroundWait releases all of them when the child ends.
// Only one scope may be active in a process. An empty scope owns no resources.
pub Foreground :: struct {
    pid: int;
    terminal: int;
    parent_group: int;
    input: int;
    output: int;
    interrupt: u8[];
    terminate: u8[];
    hangup: u8[];
    signals: u8[];
    cancelled: int;
    cancel_started: i64;
    problem: string;
}

// Descriptors below 3 must stay closed if the caller had closed them. Every
// owned descriptor is positive, leaving zero as absence. Spawn closes the
// signal channel explicitly; the terminal is opened close-on-exec.
ForegroundDescriptor :: (descriptor: int) -> int {
    if (descriptor < 0) { return 0; }
    held: int[] = [];
    while (descriptor >= 0 && descriptor < 3) {
        held.append(descriptor);
        descriptor = int(dup(i32(descriptor)));
    }
    for (temporary in held) { closed := close(i32(temporary)); }
    if (descriptor < 0) { return 0; }
    return descriptor;
}

ForegroundTerminal :: (scope: Foreground, group: int) -> bool {
    if (scope.terminal == 0) { return true; }
    previous := Block(128);
    signals := scope.signals;
    blocked := sigprocmask(i32(ForegroundBlock), signals, previous);
    if (blocked != 0) { return false; }
    changed := tcsetpgrp(i32(scope.terminal), i32(group));
    empty: u8[] = [];
    restored := sigprocmask(i32(ForegroundSetMask), previous, empty);
    return changed == 0 && restored == 0;
}

ForegroundRelease :: (scope: ^Foreground) {
    previous := Block(128);
    signals := scope^.signals;
    blocked := sigprocmask(i32(ForegroundBlock), signals, previous);
    if (blocked != 0 && scope^.problem == "") { scope^.problem = "cannot block signals while releasing the foreground program"; }
    empty: u8[] = [];
    if (scope^.terminal > 0) {
        if (tcgetpgrp(i32(scope^.terminal)) == i32(scope^.pid)) {
            restored := ForegroundTerminal(scope^, scope^.parent_group);
            if (!restored && scope^.problem == "") { scope^.problem = "cannot restore the foreground terminal"; }
        }
        closed := close(i32(scope^.terminal));
        scope^.terminal = 0;
    }
    old_interrupt := scope^.interrupt;
    old_terminate := scope^.terminate;
    old_hangup := scope^.hangup;
    if (length(old_interrupt) > 0) {
        restored := sigaction(2, old_interrupt, empty);
        if (restored != 0 && scope^.problem == "") { scope^.problem = "cannot restore the interrupt handler"; }
    }
    if (length(old_terminate) > 0) {
        restored := sigaction(15, old_terminate, empty);
        if (restored != 0 && scope^.problem == "") { scope^.problem = "cannot restore the termination handler"; }
    }
    if (length(old_hangup) > 0) {
        restored := sigaction(1, old_hangup, empty);
        if (restored != 0 && scope^.problem == "") { scope^.problem = "cannot restore the hangup handler"; }
    }
    if (ForegroundHook(-1, 0) == scope^.output) { cleared := ForegroundHook(0, 0); }
    if (scope^.input > 0) { closed := close(i32(scope^.input)); scope^.input = 0; }
    if (scope^.output > 0) { closed := close(i32(scope^.output)); scope^.output = 0; }
    if (blocked == 0) {
        restored := sigprocmask(i32(ForegroundSetMask), previous, empty);
        if (restored != 0 && scope^.problem == "") { scope^.problem = "cannot restore the signal mask after foreground cleanup"; }
    }
    scope^.pid = 0;
}

pub ForegroundStart :: (command: string[]) -> Foreground {
    scope: Foreground = {pid: 0, terminal: 0, parent_group: 0, input: 0, output: 0,
        interrupt: [], terminate: [], hangup: [], signals: [], cancelled: 0, cancel_started: 0, problem: ""};
    if (length(command) == 0 || ForegroundHook(-1, 0) != 0) {
        scope.problem = "a foreground command needs an inactive process scope";
        return scope;
    }
    signals := Block(128);
    initialized := sigemptyset(signals);
    for (number in [int(1), 2, 15, 22]) {
        if (initialized == 0) { initialized = sigaddset(signals, i32(number)); }
    }
    if (initialized != 0) { scope.problem = "cannot prepare the foreground signal set"; return scope; }
    scope.signals = signals;
    previous_mask := Block(128);
    blocked := sigprocmask(i32(ForegroundBlock), signals, previous_mask);
    if (blocked != 0) { scope.problem = "cannot block foreground signals"; return scope; }
    sockets := Block(8);
    paired := socketpair(1, 2, 0, sockets);
    if (paired == 0) {
        scope.input = ForegroundDescriptor(Word32(sockets, 0));
        scope.output = ForegroundDescriptor(Word32(sockets, 4));
    }
    empty: u8[] = [];
    if (scope.input == 0 || scope.output == 0) {
        scope.problem = "cannot make the foreground signal channel";
    } else {
        // glibc's action includes a 128-byte signal set: 152 bytes total on
        // Linux x86-64. The opaque scratch also covers Darwin's smaller action.
        saved_interrupt := Block(256);
        saved_terminate := Block(256);
        saved_hangup := Block(256);
        saved := sigaction(2, empty, saved_interrupt);
        if (saved == 0) { scope.interrupt = saved_interrupt; saved = sigaction(15, empty, saved_terminate); }
        if (saved == 0) { scope.terminate = saved_terminate; saved = sigaction(1, empty, saved_hangup); }
        if (saved == 0) { scope.hangup = saved_hangup; }
        if (saved != 0) {
            scope.problem = "cannot prepare foreground signal handling";
        } else {
            configured := ForegroundHook(scope.output, 0);
            interrupt := signal(2, ForegroundSignal);
            terminate := signal(15, ForegroundSignal);
            hangup := signal(1, ForegroundSignal);
            if (interrupt == u64(wrap: -1) || terminate == u64(wrap: -1) || hangup == u64(wrap: -1)) {
                scope.problem = "cannot install foreground signal handling";
            }
        }
    }
    if (scope.problem == "") {
        terminal := open("/dev/tty", i32(2 + ForegroundCloseOnExec));
        scope.terminal = ForegroundDescriptor(int(terminal));
        scope.parent_group = int(getpgrp());
        handoff := scope.terminal > 0 && tcgetpgrp(i32(scope.terminal)) == i32(scope.parent_group);
        if (!handoff && scope.terminal > 0) { closed := close(i32(scope.terminal)); scope.terminal = 0; }
        attributes := Block(512);
        pid := Block(8);
        defaults := Block(128);
        mask := Block(128);
        attributes_status := posix_spawnattr_init(attributes);
        prepared := attributes_status;
        cleared := sigemptyset(defaults);
        if (cleared == 0) { cleared = sigemptyset(mask); }
        for (number in [int(1), 2, 13, 15, 21, 22]) {
            if (cleared == 0) { cleared = sigaddset(defaults, i32(number)); }
        }
        if (cleared == 0 && target.Os == target.Darwin) { cleared = sigaddset(defaults, 18); }
        else if (cleared == 0) { cleared = sigaddset(defaults, 20); }
        if (prepared == 0) { prepared = cleared; }
        flags := 14;
        if (target.Os == target.Darwin && handoff) { flags += 128; }
        if (prepared == 0) { prepared = posix_spawnattr_setpgroup(attributes, 0); }
        if (prepared == 0) { prepared = posix_spawnattr_setsigmask(attributes, mask); }
        if (prepared == 0) { prepared = posix_spawnattr_setsigdefault(attributes, defaults); }
        if (prepared == 0) { prepared = posix_spawnattr_setflags(attributes, i16(flags)); }
        vector := Vector(command);
        actions := Block(256);
        actions_initialized := posix_spawn_file_actions_init(actions);
        actions_status := actions_initialized;
        if (actions_status == 0) { actions_status = posix_spawn_file_actions_addclose(actions, i32(scope.input)); }
        if (actions_status == 0) { actions_status = posix_spawn_file_actions_addclose(actions, i32(scope.output)); }
        if (actions_status == 0 && scope.terminal > 0) { actions_status = posix_spawn_file_actions_addclose(actions, i32(scope.terminal)); }
        if (prepared == 0 && actions_status == 0) {
            prepared = posix_spawnp(pid, command[0], actions, attributes, vector, chibi_environment());
        }
        if (attributes_status == 0) { destroyed := posix_spawnattr_destroy(attributes); }
        if (actions_initialized == 0) { destroyed_actions := posix_spawn_file_actions_destroy(actions); }
        if (prepared != 0 || actions_status != 0) {
            scope.problem = "cannot start the foreground program";
        } else {
            scope.pid = Word32(pid, 0);
            configured := ForegroundHook(scope.output, scope.pid);
            if (target.Os == target.Darwin) {
                if (handoff) { status := Block(8); stopped := waitpid(i32(scope.pid), status, 2); }
            }
            if (handoff && !ForegroundTerminal(scope, scope.pid)) {
                scope.problem = "cannot give the foreground program its terminal";
            }
            if (handoff) { continued := kill(i32(0 - scope.pid), i32(ForegroundContinue)); }
        }
    }
    restored := sigprocmask(i32(ForegroundSetMask), previous_mask, empty);
    if (restored != 0 && scope.problem == "") { scope.problem = "cannot restore the foreground signal mask"; }
    if (scope.problem != "") {
        if (scope.pid > 0) { killed := kill(i32(0 - scope.pid), 9); reaped := ForegroundReap(scope.pid); }
        ForegroundRelease(&scope);
        if (restored != 0) { retried := sigprocmask(i32(ForegroundSetMask), previous_mask, empty); }
    }
    return scope;
}

// A monotonic millisecond sample, or -1 when the clock cannot be read.
// Reuse at least 16 scratch bytes for the platform timespec. A uniquely
// owned buffer needs no allocation; an undersized buffer returns -1.
pub MonotonicMilliseconds :: (stamp: ^(u8[])) -> i64 {
    if (length(stamp^) < 16) { return -1; }
    read := clock_gettime(i32(ForegroundClock), stamp^);
    if (read != 0) { return -1; }
    seconds := i64(u64(Word32(stamp^, 0)) | (u64(Word32(stamp^, 4)) << 32));
    nanos := i64(u64(Word32(stamp^, 8)) | (u64(Word32(stamp^, 12)) << 32));
    return seconds * 1000 + nanos / 1000000;
}

// A waitable exit keeps the PID reserved until its group is killed. Stopped
// children hand the terminal back and suspend their wrapper; a resumed wrapper
// restores the child's terminal before continuing that entire group.
pub ForegroundWait :: (scope: ^Foreground, timeout_ms: int) -> int {
    if (scope^.pid <= 0) { return 127; }
    information := Block(128);
    notice := Block(1);
    polling := Block(8);
    for (byte in 0..<4) { polling[byte] = u8((scope^.input >> u32(byte * 8)) & 255); }
    polling[4] = 1;
    clock := Block(16);
    waited := 0;
    while (true) {
        available := poll(polling, 1, 0);
        received: i64 = 0;
        if (available > 0 && (polling[6] & 1) != 0) { received = read(i32(scope^.input), notice, 1); }
        if (received > 0 && scope^.cancelled == 0) {
            scope^.cancelled = 1;
            if (notice[0] == 73) { scope^.cancelled = 2; }
            else if (notice[0] == 84) { scope^.cancelled = 15; }
            scope^.cancel_started = MonotonicMilliseconds(&clock);
        }
        if (scope^.cancelled != 0) {
            now := MonotonicMilliseconds(&clock);
            if (now < 0 || scope^.cancel_started < 0) {
                scope^.problem = "cannot read the foreground cancellation clock";
                killed := kill(i32(0 - scope^.pid), 9);
            } else if (now - scope^.cancel_started >= 2000) {
                killed := kill(i32(0 - scope^.pid), 9);
            }
        }
        for (byte in ForegroundInfoPid..<ForegroundInfoPid + 4) { information[byte] = 0; }
        checked := waitid(1, u32(scope^.pid), information, i32(1 + 4 + ForegroundStopped + ForegroundNowait));
        if (checked < 0) {
            error := ErrorNumber();
            if (error == 4) { continue; }
            // ECHILD proves that this process no longer owns the PID; never
            // signal a group through a handle whose leader was reaped elsewhere.
            if (error != 10) { killed := kill(i32(0 - scope^.pid), 9); reaped := ForegroundReap(scope^.pid); }
            scope^.problem = format_text("cannot wait for the foreground program (errno {})", error);
            ForegroundRelease(scope);
            return 1;
        }
        if (checked == 0 && Word32(information, ForegroundInfoPid) == scope^.pid) {
            code := Word32(information, 8);
            if (code == 1 || code == 2 || code == 3) {
                killed := kill(i32(0 - scope^.pid), 9);
                reaped := ForegroundReap(scope^.pid);
                result := reaped.status;
                if (reaped.error != 0) { scope^.problem = "cannot reap the foreground program"; }
                else if (scope^.problem != "") { result = 1; }
                else if (scope^.cancelled != 0) { result = 0 - scope^.cancelled; }
                ForegroundRelease(scope);
                if (scope^.problem != "") { return 1; }
                return result;
            }
            consumed := waitid(1, u32(scope^.pid), information, i32(1 + ForegroundStopped));
            if (scope^.cancelled == 0) {
                if (scope^.terminal > 0 && tcgetpgrp(i32(scope^.terminal)) == i32(scope^.pid)) {
                    restored := ForegroundTerminal(scope^, scope^.parent_group);
                }
                stopped := kill(getpid(), i32(ForegroundStop));
                if (scope^.terminal > 0 && tcgetpgrp(i32(scope^.terminal)) == i32(scope^.parent_group)) {
                    handed := ForegroundTerminal(scope^, scope^.pid);
                }
            }
            continued := kill(i32(0 - scope^.pid), i32(ForegroundContinue));
        }
        if (timeout_ms >= 0 && waited >= timeout_ms) { return StillRunning; }
        slept := usleep(5000);
        waited += 5;
    }
    return 127;
}
