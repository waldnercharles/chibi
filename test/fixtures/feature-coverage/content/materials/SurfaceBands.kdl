version 3
name "SurfaceBands"
domain "material"
id_counter 1000
description "Local height colors the ring and box. A small emission gain keeps them visible in the planar scene."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=100 type="Shader ObjectPosition" x=0.0 y=0.0
            - {
                id 200
                type "Behavior Expression"
                x 250.0
                y 0.0
                reference_name "mix(vec3(0.05, 0.5, 0.75), vec3(0.95, 0.5, 0.12), clamp((position.y + 10) / 20, 0, 1))"
                inputs {
                    position id=201 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=202 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 300
                type "Behavior Expression"
                x 650.0
                y 180.0
                reference_name "color * 0.125"
                inputs {
                    color id=301 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=302 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 400
                type "Shader Surface Output"
                x 900.0
                y 0.0
                inputs Roughness=0.4 Unlit=#true
            }
        }
        (array)edges {
            - from="100.Value" to="200.position"
            - from="200.Result" to="300.color"
            - from="200.Result" to="400.Base Color"
            - from="300.Result" to="400.Emission"
        }
    }
    - id=500 kind="function" math_expression="mix(vec3(0.05, 0.5, 0.75), vec3(0.95, 0.5, 0.12), clamp((position.y + 10) / 20, 0, 1))" expression_mode=1 entry_id=501
    - id=600 kind="function" math_expression="color * 0.125" expression_mode=1 entry_id=601
}
