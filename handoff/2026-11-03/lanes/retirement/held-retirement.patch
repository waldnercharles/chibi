-static bool symbol_valid(const char *symbol)
-{
-    if (!isalpha((unsigned char)symbol[0]) && symbol[0] != '_') {
-        return false;
-    }
-    for (const char *c = symbol; *c; c++) {
-        if (!isalnum((unsigned char)*c) && *c != '_') {
-            return false;
-        }
-    }
-    return true;
-}
