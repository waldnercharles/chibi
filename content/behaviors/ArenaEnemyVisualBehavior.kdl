version 3
name "ArenaEnemyVisualBehavior"
id_counter 162
description "Begin chooses each enemy's initial rotation and drift from editable vector ranges. GameVisualMotion owns continuous rotation and the reaction pulse; Contact and Damaged call Bump to author the recoil strength."
owner_type "ecs.entity"
(array)variables {
    - id=1 name="Bump Lift" type="float" type_name="float" category="Motion" default=1.6
}
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 2
                type "Event"
                reference_name "Begin"
                outputs {
                    Then id=1
                }
            }
            - {
                id 4
                type "Random Range Vector"
                inputs {
                    Max {
                        default x=6.2831855 y=6.2831855 z=6.2831855
                    }
                }
            }
            - id=8 type="Set_GameVisualMotion_rotation"
            - {
                id 14
                type "Random Range Vector"
                inputs {
                    Min {
                        default x=-10.0 y=-10.0 z=-10.0
                    }
                    Max {
                        default x=10.0 y=10.0 z=10.0
                    }
                }
            }
            - id=18 type="Set_GameVisualMotion_angular_velocity"
            - {
                id 24
                type "Event"
                reference_name "Contact Begin"
                outputs {
                    Other id=26 type="handle" type_name="ecs.entity" kind="data"
                    Point id=160 type="struct" type_name="CF_V2" kind="data"
                }
            }
            - {
                id 27
                type "Call Function"
                reference_name "Bump"
                inputs {
                    Strength id=29 type="float" kind="data" default=1.0
                }
                outputs {
                    Then id=30
                }
            }
            - {
                id 31
                type "Event"
                reference_name "Damaged"
                outputs {
                    Amount id=33 declaration_id=2 type="int" kind="data"
                    Source id=34 declaration_id=3 type="handle" type_name="ecs.entity" kind="data"
                }
            }
            - {
                id 35
                type "Call Function"
                reference_name "Bump"
                inputs {
                    Strength id=37 type="float" kind="data" default=1.6
                }
                outputs {
                    Then id=38
                }
            }
        }
        (array)edges {
            - from="2.Then" to="8.Exec"
            - from="4.Result" to="8.Value"
            - from="8.Then" to="18.Exec"
            - from="14.Result" to="18.Value"
            - from="24.Then" to="27.Exec"
            - from="31.Then" to="35.Exec"
        }
    }
    - {
        id 96
        kind "function"
        name "Bump"
        entry_id 98
        return_id 128
        call_depth_limit 32
        (array)nodes {
            - {
                id 98
                type "Function Entry"
                (array)outputs {
                    - id=99 name="Then"
                    - id=100 name="Strength" type="float" kind="data" default=1.0
                }
            }
            - {
                id 101
                type "Random Range"
                inputs Min=-1.0
            }
            - {
                id 105
                type "Make_CF_V3"
                inputs x=0.36 z=0.5
                (array)outputs {
                    - id=109 name="Result"
                }
            }
            - id=110 type="Multiply"
            - {
                id 116
                type "Multiply"
                inputs {
                    A 1.0
                    B {
                        binding kind="variable" source_asset="ArenaEnemyVisualBehavior" name="Bump Lift"
                        default 1.6
                    }
                }
            }
            - id=120 type="Trigger Visual Reaction"
            - id=128 type="Return"
        }
        (array)edges {
            - from="98.Then" to="120.Exec"
            - from="98.Strength" to="116.A"
            - from="101.Result" to="110.B"
            - from="105.Result" to="110.A"
            - from="110.Result" to="120.Rotation"
            - from="116.Result" to="120.Lift"
            - from="120.Then" to="128.Exec"
        }
    }
}
