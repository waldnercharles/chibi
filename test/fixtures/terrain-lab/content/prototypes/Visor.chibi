package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Visor")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Appearance", data.Object([
                    data.Field.Named("color", data.Value.UInt(305085951)),
                    data.Field.Named("height", data.Value.Real(4.0)),
                    data.Field.Named("layer", data.Value.UInt(6)),
                    data.Field.Named("width", data.Value.Real(7.0))
                ])),
                data.Field.Named("GlobalBinding", data.Object([
                    data.Field.Named("name", data.Value.Text("Visor"))
                ])),
                data.Field.Named("Transform", data.Object([
                    data.Field.Named("x", data.Value.Real(-19.0)),
                    data.Field.Named("y", data.Value.Real(-16.0))
                ]))
            ]))
        ])
    );
}
