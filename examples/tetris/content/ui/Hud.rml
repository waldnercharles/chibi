<div id="hud">
    <div id="hold" class="label">HOLD</div>
    <div id="next" class="label">NEXT</div>
    <div id="stats">
        <div class="label">SCORE</div><div id="score" class="value">0</div>
        <div class="label">LEVEL</div><div id="level" class="value">1</div>
        <div class="label">LINES</div><div id="lines" class="value">0</div>
    </div>
    <div id="over"></div>
    <div id="restart"></div>
</div>
