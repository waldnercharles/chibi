+static bool pid_gone(int pid)
+{
+    assert(pid > 0);
+    return kill(pid, 0) < 0 && errno == ESRCH;
+}
+
+static bool group_gone(int pid)
+{
+    assert(pid > 0);
+    return kill(-pid, 0) < 0 && errno == ESRCH;
+}
