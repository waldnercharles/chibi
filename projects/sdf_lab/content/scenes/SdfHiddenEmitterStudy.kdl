version 1
name "SdfHiddenEmitterStudy"
(array)entities {
    - {
        name "Camera"
        prototype "SdfOptimizationCamera"
        components {
            GameCamera width=320.0 height=240.0 focal_distance=0.0 yaw=0.0 pitch=0.0 roll=0.0
            GameHRC2D surface_mode="Depth thickness" surface_depth_radius=384.0 surface_depth_gain=32.0 surface_thickness=12.0 surface_depth_quality="Balanced" surface_depth_near_detail=#true surface_depth_shadow_softness=0.0 surface_depth_temporal=#false ambient=0.0 fog=0.0 shadow_floor=0.0 bloom=0.0 feedback=#false bounce_intensity=0.0 specular=0.0 intensity=1.0 exposure=1.0 surface_depth_visibility="Bounded segments" surface_depth_emitters="Uniform material proxies"
            GameTransform x=0.0 y=0.0
        }
    }
    - {
        name "Receiver"
        prototype "SdfComparisonMesh"
        components {
            GameTransform x=0.0 y=0.0
            GameGeometry3D width=280.0 height=4.0 depth=210.0 elevation=-2.0
            GameVisualTransform scale=1.0 pitch=0.0 yaw=0.0 roll=0.0
            GameShader material=""
            GameMaterial scene=0x808080ff albedo=0x808080ff absorption=1.0 emission_intensity=0.0 edge_light=1.0
        }
    }
    - {
        name "Blocker"
        prototype "SdfComparisonMesh"
        components {
            GameTransform x=0.0 y=0.0
            GameGeometry3D width=8.0 height=12.0 depth=70.0 elevation=34.0
            GameVisualTransform scale=1.0 pitch=0.0 yaw=0.0 roll=0.0
            GameShader material=""
            GameMaterial scene=0x808080ff albedo=0x808080ff absorption=1.0 emission_intensity=0.0 edge_light=1.0
        }
    }
    - {
        name "Light"
        prototype "SdfSphere"
        components {
            GameTransform x=-70.0 y=0.0
            GameGeometry3D width=64.0 height=64.0 depth=64.0 elevation=80.0
            GameVisualTransform scale=0.125 pitch=0.0 yaw=0.0 roll=0.0
            GameShader shape="SdfSphere" material=""
            GameMaterial scene=0xffffffff albedo=0xffffffff emission_color=0xffffffff emission_intensity=12.0 emission_multiplier=1.0 absorption=0.0
        }
    }
    - {
        name "Emitter camera cap"
        prototype "SdfComparisonMesh"
        components {
            GameTransform x=-70.0 y=0.0
            GameGeometry3D width=30.0 height=12.0 depth=30.0 elevation=110.0
            GameVisualTransform scale=1.0 pitch=0.0 yaw=0.0 roll=0.0
            GameShader material=""
            GameMaterial scene=0x808080ff albedo=0x808080ff absorption=1.0 emission_intensity=0.0 edge_light=1.0
        }
    }
}
