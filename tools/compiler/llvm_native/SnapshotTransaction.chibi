package llvm_native

import strings "core:strings"

// The inline24-byte payload is eight-byte aligned for every admitted value.
SnapshotTransactionRuntime :: () -> string {
    return strings.Join([
        "%chibi.snapshot.stage = type { ptr, ptr, ptr, i32, i1, [3 x i64] }\n",
        "%chibi.snapshot.transaction = type { %chibi.snapshot.memo, %chibi.snapshot.queue, %chibi.snapshot.memo, %chibi.snapshot.queue, ptr, i32, i32, i32, i1 }\n",
        "\n",
        "; Stages own their payload until finish transfers or drops it. Small scalar,\n",
        "; string and array roots live inline. Only larger opaque aggregates allocate.\n",
        "; No queued job survives a setter, so growing the stage table cannot move a\n",
        "; destination underneath a running clone. Memo values borrow staged owners.\n",
        "define internal ptr @chibi_snapshot.transaction.new(ptr %ctx) {\n",
        "entry:\n",
        "  %bytes = ptrtoint ptr getelementptr (%chibi.snapshot.transaction, ptr null, i32 1) to i64\n",
        "  %allocate.at = getelementptr {ptr,ptr,ptr,ptr,ptr},ptr %ctx,i32 0,i32 2\n",
        "  %allocate = load ptr,ptr %allocate.at\n",
        "  %session = call ptr %allocate(ptr %ctx,i64 %bytes)\n",
        "  store %chibi.snapshot.transaction zeroinitializer,ptr %session\n",
        "  %last.at = getelementptr %chibi.snapshot.transaction,ptr %session,i32 0,i32 7\n",
        "  store i32 -1,ptr %last.at\n",
        "  ret ptr %session\n",
        "}\n",
        "define internal ptr @chibi_snapshot.stage.payload(ptr %stage) {\n",
        "entry:\n",
        "  %large = load ptr,ptr %stage\n",
        "  %inline = getelementptr %chibi.snapshot.stage,ptr %stage,i32 0,i32 5\n",
        "  %allocated = icmp ne ptr %large,null\n",
        "  %payload = select i1 %allocated,ptr %large,ptr %inline\n",
        "  ret ptr %payload\n",
        "}\n",
        "define internal void @chibi_snapshot.stage.grow(ptr %ctx,ptr %session) {\n",
        "entry:\n",
        "  %rows.at = getelementptr %chibi.snapshot.transaction,ptr %session,i32 0,i32 4\n",
        "  %length.at = getelementptr %chibi.snapshot.transaction,ptr %session,i32 0,i32 5\n",
        "  %capacity.at = getelementptr %chibi.snapshot.transaction,ptr %session,i32 0,i32 6\n",
        "  %rows = load ptr,ptr %rows.at\n",
        "  %length = load i32,ptr %length.at\n",
        "  %capacity = load i32,ptr %capacity.at\n",
        "  %bounded = icmp ult i32 %capacity,1073741824\n",
        "  br i1 %bounded,label %size,label %oom\n",
        "size:\n",
        "  %first = icmp eq i32 %capacity,0\n",
        "  %doubled = shl i32 %capacity,1\n",
        "  %room = select i1 %first,i32 8,i32 %doubled\n",
        "  %width = ptrtoint ptr getelementptr (%chibi.snapshot.stage,ptr null,i32 1) to i64\n",
        "  %count = zext i32 %room to i64\n",
        "  %bytes = mul i64 %count,%width\n",
        "  %allocate.at = getelementptr {ptr,ptr,ptr,ptr,ptr},ptr %ctx,i32 0,i32 2\n",
        "  %allocate = load ptr,ptr %allocate.at\n",
        "  %next = call ptr %allocate(ptr %ctx,i64 %bytes)\n",
        "  %used = zext i32 %length to i64\n",
        "  %used.bytes = mul i64 %used,%width\n",
        "  call void @chibi_scalar.copy(ptr %next,ptr %rows,i64 %used.bytes)\n",
        "  %previous = icmp ne ptr %rows,null\n",
        "  br i1 %previous,label %release,label %publish\n",
        "release:\n",
        "  %release.at = getelementptr {ptr,ptr,ptr,ptr,ptr},ptr %ctx,i32 0,i32 4\n",
        "  %give = load ptr,ptr %release.at\n",
        "  call void %give(ptr %ctx,ptr %rows)\n",
        "  br label %publish\n",
        "publish:\n",
        "  store ptr %next,ptr %rows.at\n",
        "  store i32 %room,ptr %capacity.at\n",
        "  ret void\n",
        "oom:\n",
        "  call void @llvm.trap()\n",
        "  unreachable\n",
        "}\n",
        "\n",
        "; The generated setter validates its tag/schema before acquiring a stage.\n",
        "; Increasing state indices prevent replacing a memo-borrowed destination.\n",
        "define internal ptr @chibi_snapshot.stage.new(ptr %ctx,ptr %session,i32 %index,i64 %bytes,ptr %commit,ptr %drop) {\n",
        "entry:\n",
        "  %last.at = getelementptr %chibi.snapshot.transaction,ptr %session,i32 0,i32 7\n",
        "  %failed.at = getelementptr %chibi.snapshot.transaction,ptr %session,i32 0,i32 8\n",
        "  %last = load i32,ptr %last.at\n",
        "  %failed = load i1,ptr %failed.at\n",
        "  %live = xor i1 %failed,true\n",
        "  %ascending = icmp sgt i32 %index,%last\n",
        "  %valid.index = icmp sge i32 %index,0\n",
        "  %ordered = and i1 %ascending,%valid.index\n",
        "  %allowed = and i1 %live,%ordered\n",
        "  br i1 %allowed,label %prepare,label %invalid\n",
        "invalid:\n",
        "  store i1 true,ptr %failed.at\n",
        "  ret ptr null\n",
        "prepare:\n",
        "  %rows.at = getelementptr %chibi.snapshot.transaction,ptr %session,i32 0,i32 4\n",
        "  %length.at = getelementptr %chibi.snapshot.transaction,ptr %session,i32 0,i32 5\n",
        "  %capacity.at = getelementptr %chibi.snapshot.transaction,ptr %session,i32 0,i32 6\n",
        "  %length = load i32,ptr %length.at\n",
        "  %capacity = load i32,ptr %capacity.at\n",
        "  %full = icmp eq i32 %length,%capacity\n",
        "  br i1 %full,label %grow,label %place\n",
        "grow:\n",
        "  call void @chibi_snapshot.stage.grow(ptr %ctx,ptr %session)\n",
        "  br label %place\n",
        "place:\n",
        "  %rows = load ptr,ptr %rows.at\n",
        "  %stage = getelementptr %chibi.snapshot.stage,ptr %rows,i32 %length\n",
        "  store %chibi.snapshot.stage zeroinitializer,ptr %stage\n",
        "  %commit.at = getelementptr %chibi.snapshot.stage,ptr %stage,i32 0,i32 1\n",
        "  %drop.at = getelementptr %chibi.snapshot.stage,ptr %stage,i32 0,i32 2\n",
        "  %index.at = getelementptr %chibi.snapshot.stage,ptr %stage,i32 0,i32 3\n",
        "  store ptr %commit,ptr %commit.at\n",
        "  store ptr %drop,ptr %drop.at\n",
        "  store i32 %index,ptr %index.at\n",
        "  store i32 %index,ptr %last.at\n",
        "  %next.length = add i32 %length,1\n",
        "  store i32 %next.length,ptr %length.at\n",
        "  %large = icmp ugt i64 %bytes,24\n",
        "  br i1 %large,label %allocate.payload,label %done\n",
        "allocate.payload:\n",
        "  %allocate.at = getelementptr {ptr,ptr,ptr,ptr,ptr},ptr %ctx,i32 0,i32 2\n",
        "  %allocate = load ptr,ptr %allocate.at\n",
        "  %payload = call ptr %allocate(ptr %ctx,i64 %bytes)\n",
        "  store ptr %payload,ptr %stage\n",
        "  br label %done\n",
        "done:\n",
        "  ret ptr %stage\n",
        "}\n",
        "\n",
        "; Commit runs only after complete validation/copy, with source execution\n",
        "; paused. Callbacks transfer owners without allocating or calling source code.\n",
        "; Abort drops staged values. Both paths release every auxiliary allocation.\n",
        "define internal i32 @chibi_snapshot.transaction.finish(ptr %ctx,ptr %session,i1 %wanted) {\n",
        "entry:\n",
        "  %rows.at = getelementptr %chibi.snapshot.transaction,ptr %session,i32 0,i32 4\n",
        "  %length.at = getelementptr %chibi.snapshot.transaction,ptr %session,i32 0,i32 5\n",
        "  %failed.at = getelementptr %chibi.snapshot.transaction,ptr %session,i32 0,i32 8\n",
        "  %rows = load ptr,ptr %rows.at\n",
        "  %length = load i32,ptr %length.at\n",
        "  %failed = load i1,ptr %failed.at\n",
        "  %valid = xor i1 %failed,true\n",
        "  %commit = and i1 %wanted,%valid\n",
        "  br label %head\n",
        "head:\n",
        "  %index = phi i32 [0,%entry],[%next,%advance]\n",
        "  %done = icmp eq i32 %index,%length\n",
        "  br i1 %done,label %cleanup,label %inspect\n",
        "inspect:\n",
        "  %stage = getelementptr %chibi.snapshot.stage,ptr %rows,i32 %index\n",
        "  %ready.at = getelementptr %chibi.snapshot.stage,ptr %stage,i32 0,i32 4\n",
        "  %ready = load i1,ptr %ready.at\n",
        "  br i1 %ready,label %apply,label %incomplete\n",
        "incomplete:\n",
        "  br i1 %commit,label %trap,label %release\n",
        "apply:\n",
        "  %commit.at = getelementptr %chibi.snapshot.stage,ptr %stage,i32 0,i32 1\n",
        "  %drop.at = getelementptr %chibi.snapshot.stage,ptr %stage,i32 0,i32 2\n",
        "  %commit.fn = load ptr,ptr %commit.at\n",
        "  %drop.fn = load ptr,ptr %drop.at\n",
        "  %callback = select i1 %commit,ptr %commit.fn,ptr %drop.fn\n",
        "  %called = icmp ne ptr %callback,null\n",
        "  br i1 %called,label %call,label %release\n",
        "call:\n",
        "  %payload = call ptr @chibi_snapshot.stage.payload(ptr %stage)\n",
        "  call void %callback(ptr %ctx,ptr %payload)\n",
        "  br label %release\n",
        "release:\n",
        "  %large = load ptr,ptr %stage\n",
        "  %allocated = icmp ne ptr %large,null\n",
        "  br i1 %allocated,label %give.payload,label %advance\n",
        "give.payload:\n",
        "  %release.at = getelementptr {ptr,ptr,ptr,ptr,ptr},ptr %ctx,i32 0,i32 4\n",
        "  %give = load ptr,ptr %release.at\n",
        "  call void %give(ptr %ctx,ptr %large)\n",
        "  br label %advance\n",
        "advance:\n",
        "  %next = add i32 %index,1\n",
        "  br label %head\n",
        "cleanup:\n",
        "  %has.rows = icmp ne ptr %rows,null\n",
        "  br i1 %has.rows,label %give.rows,label %auxiliary\n",
        "give.rows:\n",
        "  %give.at = getelementptr {ptr,ptr,ptr,ptr,ptr},ptr %ctx,i32 0,i32 4\n",
        "  %give.rows.fn = load ptr,ptr %give.at\n",
        "  call void %give.rows.fn(ptr %ctx,ptr %rows)\n",
        "  br label %auxiliary\n",
        "auxiliary:\n",
        "  %schema.memo = getelementptr %chibi.snapshot.transaction,ptr %session,i32 0,i32 0\n",
        "  %schema.queue = getelementptr %chibi.snapshot.transaction,ptr %session,i32 0,i32 1\n",
        "  %value.memo = getelementptr %chibi.snapshot.transaction,ptr %session,i32 0,i32 2\n",
        "  %value.queue = getelementptr %chibi.snapshot.transaction,ptr %session,i32 0,i32 3\n",
        "  call void @chibi_snapshot.memo.release(ptr %ctx,ptr %schema.memo)\n",
        "  call void @chibi_snapshot.queue.release(ptr %ctx,ptr %schema.queue)\n",
        "  call void @chibi_snapshot.memo.release(ptr %ctx,ptr %value.memo)\n",
        "  call void @chibi_snapshot.queue.release(ptr %ctx,ptr %value.queue)\n",
        "  %free.at = getelementptr {ptr,ptr,ptr,ptr,ptr},ptr %ctx,i32 0,i32 4\n",
        "  %free = load ptr,ptr %free.at\n",
        "  call void %free(ptr %ctx,ptr %session)\n",
        "  %status = zext i1 %commit to i32\n",
        "  ret i32 %status\n",
        "trap:\n",
        "  call void @llvm.trap()\n",
        "  unreachable\n",
        "}\n"
    ], "");
}
