package llvm_native_calls

import native "project:llvm_native"
import abi "project:native_abi"
import strings "core:strings"

// These tests inspect recursion and loop IR; they do not execute unbounded code.
RecursiveCode :: () -> native.Instruction[] {
    return [Code(native.Check, 0, 0, 0, 0, 0, 0),
            Code(native.Call, 6, 0, 0, 0, 0, 0),
            Code(native.Publish, 6, 0, 0, 0, 0, 0),
            Code(native.Return, 0, 0, 0, 0, 0, 0)];
}
RecursiveModule :: (target: abi.Target) -> native.Result {
    empty: int[] = [];
    records: native.Record[] = [];
    texts: string[] = [];
    source: native.Source = {file: "", directory: ""};
    return native.Emit(target, [Function(6, 0, 0, 1, 0, 4, 0, 0)], empty, [6], empty,
                       RecursiveCode(), empty, records, empty, texts, source, texts,
                       empty, empty, false, 1);
}
// Match the C oracle's overlapping search: adjacent probe attributes share
// the newline that ends one occurrence and starts the next.
Occurrences :: (text: string, needle: string) -> int {
    remaining := text;
    count: int = 0;
    while true {
        at := strings.Index(remaining, needle);
        if at < 0 {
            return count;
        }
        count += 1;
        start := at + 1;
        remaining = strings.Slice(remaining, start, strings.ByteLength(remaining) - start);
    }
}
InlineProbe :: () -> string { return "\nattributes #0 = { \"probe-stack\"=\"inline-asm\" }\n"; }
Tables :: () -> string { return "unsupported native scalar signature or table size"; }
@test
DirectRecursionCallsItsSymbolAndProbesTheStack :: () {
    text := Emitted(RecursiveModule(abi.LinuxX64()));
    assert(Occurrences(text, "define i32 @chibi_scalar() #0 {\nentry:\n") == 1);
    assert(Occurrences(text, "call i32 @chibi_scalar()") == 1);
    assert(Occurrences(text, InlineProbe()) == 1);
    assert(Occurrences(text, "depth") == 0);
}
@test
MacOSRecursionProbesInline :: () {
    text := Emitted(RecursiveModule(abi.MacOSArm64()));
    assert(Occurrences(text, InlineProbe()) == 1);
}
@test
WindowsRecursionProbesWithChkstk :: () {
    text := Emitted(RecursiveModule(abi.WindowsX64()));
    assert(Occurrences(text, "\nattributes #0 = { \"probe-stack\"=\"__chkstk\" }\n") == 1);
}
@test
MutualRecursionCallsBothSymbolsAndProbesEveryFunction :: () {
    code := RecursiveCode();
    code[1] = Code(native.Call, 6, 0, 1, 0, 0, 0);
    for item in RecursiveCode() {
        code.append(item);
    }
    empty: int[] = [];
    text := Emitted(Emit([Function(6, 0, 0, 1, 0, 4, 0, 0), Function(6, 0, 1, 1, 4, 4, 0, 0)],
                         empty, [6, 6], code, empty));
    assert(Occurrences(text, "define internal i32 @chibi_scalar.1() #0 {") == 1);
    assert(Occurrences(text, "call i32 @chibi_scalar.1()") == 1);
    assert(Occurrences(text, "call i32 @chibi_scalar()") == 1);
    assert(Occurrences(text, " #0 {") == 2);
    assert(Occurrences(text, InlineProbe()) == 1);
}
@test
UnownedCodeRowIsRejected :: () {
    Rejects(Emit([Function(6, 0, 0, 4, 0, 7, 0, 3), Function(6, 3, 4, 1, 8, 3, 3, 0)],
                 [6, 1, 6], [6, 1, 6, 6, 6], Calls(), [0, 1, 2]), Tables());
}
@test
WrappedSlotRangesAreRejected :: () {
    code: native.Instruction[] = [];
    for i in 0..<3 {
        code.append(Code(native.Check, 0, 0, 0, 0, 0, 0));
        code.append(Code(native.Constant, 6, 0, 0, 0, 0, 0));
        code.append(Code(native.Publish, 6, 0, 0, 0, 0, 0));
        code.append(Code(native.Return, 0, 0, 0, 0, 0, 0));
    }
    empty: int[] = [];
    Rejects(Emit([Function(6, 0, 0, 2147483647, 0, 4, 0, 0),
                  Function(6, 0, 2147483647, 2147483647, 4, 4, 0, 0),
                  Function(6, 0, -2, 2, 8, 4, 0, 0)], empty, empty, code, empty), Tables());
}
@test
BackEdgeMaySkipTheEntryCheck :: () {
    code := [Code(native.Check, 0, 0, 0, 0, 0, 0),
             Code(native.Constant, 1, 0, 0, 0, 0, 1),
             Code(native.Branch, 0, 0, 0, 0, 4, 0),
             Code(native.Jump, 0, 0, 0, 0, 1, 0),
             Code(native.Constant, 6, 1, 0, 0, 0, 0),
             Code(native.Publish, 6, 0, 1, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0)];
    empty: int[] = [];
    Emitted(Emit([Function(6, 0, 0, 2, 0, 7, 0, 0)], empty, [1, 6], code, empty));
}
// Dominance, not lexical order, decides whether an operand is defined.
// Instruction 5 reads slot 1, which instruction 3 defines; each case gives
// instructions 2 and 4, which pass the definition or skip it.
Dominated :: (third: native.Instruction, fourth: native.Instruction) -> native.Result {
    code := [Code(native.Check, 0, 0, 0, 0, 0, 0),
             Code(native.Constant, 1, 0, 0, 0, 0, 1),
             third,
             Code(native.Constant, 6, 1, 0, 0, 0, 5),
             fourth,
             Code(native.Publish, 6, 0, 1, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0)];
    empty: int[] = [];
    return Emit([Function(6, 0, 0, 2, 0, 7, 0, 0)], empty, [1, 6], code, empty);
}
@test
BranchAroundADefinitionIsRejected :: () {
    Rejects(Dominated(Code(native.Branch, 0, 0, 0, 0, 5, 0), Code(native.Check, 0, 0, 0, 0, 0, 0)),
            "native scalar left operand is not defined on every path");
}
@test
DefinitionThatControlNeverReachesIsRejected :: () {
    Rejects(Dominated(Code(native.Jump, 0, 0, 0, 0, 4, 0), Code(native.Check, 0, 0, 0, 0, 0, 0)),
            "native scalar left operand is not defined on every path");
}
@test
DefinitionBeforeBothArmsDominatesTheirJoin :: () {
    Emitted(Dominated(Code(native.Check, 0, 0, 0, 0, 0, 0), Code(native.Branch, 0, 0, 0, 0, 5, 0)));
}
@test
UseThatControlNeverReachesIsAccepted :: () {
    // Instruction 6 reads slot 1, which only the branch's fall-through
    // defines, but nothing jumps to 6.
    code := [Code(native.Check, 0, 0, 0, 0, 0, 0),
             Code(native.Constant, 1, 0, 0, 0, 0, 1),
             Code(native.Constant, 6, 2, 0, 0, 0, 7),
             Code(native.Branch, 0, 0, 0, 0, 5, 0),
             Code(native.Constant, 6, 1, 0, 0, 0, 5),
             Code(native.Jump, 0, 0, 0, 0, 7, 0),
             Code(native.Publish, 6, 0, 1, 0, 0, 0),
             Code(native.Publish, 6, 0, 2, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0)];
    empty: int[] = [];
    Emitted(Emit([Function(6, 0, 0, 3, 0, 9, 0, 0)], empty, [1, 6, 6], code, empty));
}
