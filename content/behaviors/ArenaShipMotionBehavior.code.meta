{"version":2,"id_counter":1710,"description":"Sustained aim-relative strafe slowly rolls between the pyramid's 90-degree faces. Roll angle and angular velocity stay continuous through reversals. Release settles onto the nearest face captured while moving. Reverse movement adds a subtle nose lift. Tune speed, rocking and settling under Motion in the Variables Inspector.","variables":[{"name":"Roll Speed (Degrees/Second)","id":1,"category":"Motion"},{"name":"Reverse Nose Lift (Degrees)","id":2,"category":"Motion"},{"name":"Settle Response (Hz)","id":3,"category":"Motion"},{"name":"Settle Damping","id":4,"category":"Motion"},{"name":"Roll Angle","id":5,"category":"State"},{"name":"Roll Velocity","id":6,"category":"State"},{"name":"Nose Position","id":7,"category":"State"},{"name":"Nose Velocity","id":8,"category":"State"},{"name":"Face Rocking","id":252,"category":"Motion"},{"name":"Roll Acceleration (Per Second)","id":253,"category":"Motion"},{"name":"Strafe Dead Zone","id":254,"category":"Motion"},{"name":"Resting Face","id":255,"category":"State"}],"graphs":[{"id":0,"kind":0,"caller":0,"name":"","description":"","locals":[],"nodes":[{"id":204,"owner":204,"type":"Call Function","reference":"Advance Damped Spring","x":0.0,"y":0.0,"inputs":[{"id":194,"name":"Exec"},{"id":195,"name":"Position"},{"id":196,"name":"Velocity"},{"id":197,"name":"Target"},{"id":198,"name":"Frequency"},{"id":199,"name":"Damping"},{"id":200,"name":"Delta"}],"outputs":[{"id":201,"name":"Then"},{"id":202,"name":"Position"},{"id":203,"name":"Velocity"}]},{"id":636,"type":"Call Pure Function","reference":"Compute Aim Basis","x":0.0,"y":0.0,"inputs":[{"id":637,"name":"Move"},{"id":638,"name":"Aim"}],"outputs":[{"id":639,"name":"Strafe"},{"id":640,"name":"Forward"}]},{"id":836,"owner":836,"type":"Call Function","reference":"Apply Ship Pose","x":0.0,"y":0.0,"inputs":[{"id":837,"name":"Exec"},{"id":839,"name":"reverseNoseLift"},{"id":840,"name":"Delta"},{"id":841,"name":"Frequency"},{"id":842,"name":"D