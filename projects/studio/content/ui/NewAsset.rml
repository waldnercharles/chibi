<div class="popup menu new-asset" popover id="new-asset-name">
  <use ui="MenuGroup" data-alias-group="new_asset"/>
  <div class="new-asset-field"><div class="field text"><input type="text" class="part value" placeholder="Name" data-value="new_asset.name" data-keys="Enter:new_asset.create" data-event-focus="emit('new_asset.select')"/></div></div>
  <div class="new-asset-error" data-if="new_asset.error != ''"><span class="icon">&#xea6c;</span><span class="label">{{ new_asset.error }}</span></div>
  <use ui="MenuSeparator"/>
  <use ui="MenuItem" data-alias-item="new_asset.create" data-event-click="emit('new_asset.create')"/>
</div>
