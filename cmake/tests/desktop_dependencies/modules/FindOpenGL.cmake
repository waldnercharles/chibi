# Exact discovery identities, including legacy GL and both GLVND roles.
set(OpenGL_FOUND TRUE)
set(OPENGL_FOUND TRUE)
set(OpenGL_OpenGL_FOUND TRUE)
set(OpenGL_GLX_FOUND TRUE)
set(OPENGL_gl_LIBRARY "${FIXTURE_PROVIDER_ROOT}/opengl/libGL.so")
set(OPENGL_opengl_LIBRARY "${FIXTURE_PROVIDER_ROOT}/opengl/libOpenGL.so")
set(OPENGL_glx_LIBRARY "${FIXTURE_PROVIDER_ROOT}/opengl/libGLX.so")
foreach(role GL OpenGL GLX)
    if(NOT TARGET "OpenGL::${role}")
        add_library("OpenGL::${role}" UNKNOWN IMPORTED)
        set_target_properties("OpenGL::${role}" PROPERTIES
            IMPORTED_LOCATION "${FIXTURE_PROVIDER_ROOT}/opengl/lib${role}.so")
    endif()
endforeach()
set_property(TARGET OpenGL::GLX PROPERTY INTERFACE_LINK_LIBRARIES "OpenGL::OpenGL")
