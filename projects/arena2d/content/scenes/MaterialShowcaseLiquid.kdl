version 1
name "MaterialShowcaseLiquid"
(array)entities {
    - name="Materials" prototype="MaterialShowcaseLiquidWorld"
    - {
        name "Camera"
        prototype "MaterialShowcaseEntity"
        components {
            GameCamera width=260.0 height=180.0
        }
    }
    - {
        name "Floor"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=0.0 y=64.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=204.0 height=8.0 category=8 mask=15 friction=0.6
            GameAppearance width=204.0 height=8.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Left wall"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=-100.0 y=-4.0
            GameBody type="Static" allow_rotation=#true
