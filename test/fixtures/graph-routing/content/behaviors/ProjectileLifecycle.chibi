// Age and expire projectiles; face velocity while moving.
ProjectileLifecycle :: behavior {
    on Tick :: (dt: number s) {
        self.Projectile.Age += f64(dt)
        if f64(self.Projectile.Age) >= f64(self.Projectile.Lifetime) {
            destroy_entity(self)
        } else {
            if length(self.Velocity) > 0.0001 {
                self.Orientation.Radians = atan2(self.Velocity.y, self.Velocity.x)
            }
        }
    }
}
