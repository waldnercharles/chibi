        Rejected("native_call", "package scalar\nMain :: () -> int { return print(1); }", "Unknown function 'print'", "print"),
        Rejected("qualified_call", "package scalar\nMain :: () -> int { return scalar.Id(1); }\nId :: (x: int) -> int { return x; }", "Unknown function 'scalar.Id'", "Id"),
        Rejected("duplicate_function", "package scalar\nMain :: () -> int { return Id(1); }\nId :: (x: int) -> int { return x; }\nId :: (y: int) -> int { return y; }", "Duplicate declaration 'Id'", "Id :: (y: int) -> int { return y; }"),
        Rejected("helper_statement", "package scalar\nMain :: () -> int { return Id(1); }\nId :: (x: int) -> int { y := x; return y; }", "scalar proof requires one complete return statement", "y := x;"),
        Rejected("nine_parameters", "package scalar\nMain :: () -> int { return 1; }\nP :: (a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, i: int) -> int { return a; }", "scalar proof requires int or bool parameters and one int or bool result", "(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, i: int)"),
        Accepted("most_functions", Chain(32), 31, ChainNames(32), ""),
        Rejected("too_many_functions", Chain(33), "scalar proof admits at most 32 functions", "F32 :: () -> int { return 32; }"),
        Accepted("most_operands", Nest(63), 1, "Main,Id", ""),
        Rejected("too_many_operands", Nest(64), "scalar proof admits at most 64 operands per function", Nested(64)),
        Accepted("largest_source", Padded(16384), 1, "Main", "1"),
        Accepted("min", "package scalar\nMain :: () -> int { return Min(7, 3); }\nMin :: (a: int, b: int) -> int {\n    if (a < b) { return a; }\n    return b;\n}\n", 3, "Main,Min", "7 ; 3 ; Min(7, 3) | a ; b ; a < b ? a : b"),
        Accepted("max", "package scalar\nMain :: () -> int { return Max(3, 7); }\nMax :: (a: int, b: int) -> int {\n    if (a > b) { return a; }\n    return b;\n}\n", 7, "Main,Max", "3 ; 7 ; Max(3, 7) | a ; b ; a > b ? a : b"),
        Accepted("clamp", "package scalar\nMain :: () -> int { return Clamp(12, 0, 10); }\nClamp :: (x: int, low: int, high: int) -> int { return Min(Max(x, low), high); }\nMin :: (a: int, b: int) -> int {\n    if (a < b) { return a; }\n    return b;\n}\nMax :: (a: int, b: int) -> int {\n    if (a > b) { return a; }\n    return b;\n}\n", 10, "Main,Clamp,Min,Max", "12 ; 0 ; 10 ; Clamp(12, 0, 10) | x ; low ; Max(x, low) ; high ; Min(Max(x, low), high) | a ; b ; a < b ? a : b | a ; b ; a > b ? a : b"),
        Accepted("operators", "package scalar\nMain :: () -> int { return If(Ge(2, 3), 1, 5); }\nIf :: (c: bool, a: int, b: int) -> int {\n    if (c) { return a; }\n    return b;\n}\nLt :: (a: int, b: int) -> bool { return a < b; }\nLe :: (a: int, b: int) -> bool { return a <= b; }\nGt :: (a: int, b: int) -> bool { return a > b; }\nGe :: (a: int, b: int) -> bool { return a >= b; }\nEq :: (a: int, b: int) -> bool { return a == b; }\nNe :: (a: int, b: int) -> bool { return a != b; }\n", 5, "Main,If,Lt,Le,Gt,Ge,Eq,Ne", "2 ; 3 ; Ge(2, 3) ; 1 ; 5 ; If(Ge(2, 3), 1, 5) | c ? a : b | a ; b ; a < b | a ; b ; a <= b | a ; b ; a > b | a ; b ; a >= b | a ; b ; a == b | a ; b ; a != b"),
        Accepted("call_condition", "package scalar\nMain :: () -> int {\n    if (Small(3)) { return 1; }\n    return 2;\n}\nSmall :: (x: int) -> bool { return x < 10; }\n", 1, "Main,Small", "3 ; Small(3) ? 1 : 2 | x ; 10 ; x < 10"),
        Accepted("lazy_arm", "package scalar\nMain :: () -> int { return Choose(false); }\nChoose :: (c: bool) -> int {\n    if (c) { return Taken(); }\n    return Skipped();\n}\nTaken :: () -> int { return 1; }\nSkipped :: () -> int { return 2; }\n", 2, "Main,Choose,Taken,Skipped", "false ; Choose(false) | c ? Taken() : Skipped() | 1 | 2"),
        Accepted("bare_condition", "package scalar\nMain :: () -> int { return Positive(5); }\nPositive :: (x: int) -> int {\n    if x > 0 { return x; }\n    return 0;\n}\n", 5, "Main,Positive", "5 ; Positive(5) | x ; 0 ; x > 0 ? x : 0"),
        Accepted("split_most_operands", Split(31, 29), 1, "Main,Small,Id", ""),
        Rejected("split_too_many_operands", Split(31, 30), "scalar proof admits at most 64 operands per function", "0"),
        Rejected("else_branch", "package scalar\nMain :: () -> int {\n    if (true) { return 1; } else { return 2; }\n}\n", "scalar proof does not support else branches", "{ return 2; }"),
        Rejected("two_guards", "package scalar\nMain :: () -> int {\n    if (true) { return 1; }\n    if (false) { return 2; }\n    return 3;\n}\n", "scalar proof admits at most 1 guard per function", "if (false) { return 2; }"),
        Rejected("guard_without_return", "package scalar\nMain :: () -> int {\n    if (true) { assert(false); }\n    return 1;\n}\n", "scalar proof requires a guard that returns", "assert(false);"),
        Rejected("bool_comparison", "package scalar\nMain :: () -> int { return If(Same(true, false), 1, 2); }\nSame :: (a: bool, b: bool) -> bool { return a == b; }\nIf :: (c: bool, a: int, b: int) -> int {\n    if (c) { return a; }\n    return b;\n}\n", "scalar proof compares only int operands", "a == b"),
        Rejected("nested_parentheses", "package scalar\nMain :: () -> int { return Min(1, 2); }\nMin :: (a: int, b: int) -> int {\n    if ((a < b)) { return a; }\n    return b;\n}\n", "scalar proof supports only literals, parameters, comparisons and direct calls", "(a < b)"),
        Rejected("logical_and", "package scalar\nMain :: () -> int { return Mid(1, 2, 3); }\nMid :: (a: int, b: int, c: int) -> int {\n    if (a < b && b < c) { return b; }\n    return a;\n}\n", "scalar proof supports only literals, parameters, comparisons and direct calls", "a < b && b < c"),
        Rejected("recursive_guard", "package scalar\nMain :: () -> int { return Down(3); }\nDown :: (x: int) -> int {\n    if (x > 0) { return Down(0); }\n    return x;\n}\n", "scalar proof does not support recursive calls", "Down(0)"),
        Accepted("literal_comparison", "package scalar\nMain :: () -> int {\n    if (7 < 3) { return 1; }\n    return 2;\n}\n", 2, "Main", "7 ; 3 ; 7 < 3 ? 1 : 2"),
        Rejected("too_large", Padded(16385), "scalar proof admits at most 16384 source bytes", "")];
}
pub Count :: () -> int {
    return length(Cases());
}
pub Source :: (index: int) -> string {
    cases := Cases();
    return cases[index].source;
}
pub CaseName :: (index: int) -> string {
    cases := Cases();
    return cases[index].name;
}
// The fixture's literal oracle, independent of producer rows and execution.
pub ExpectedValue :: (index: int) -> int {
    cases := Cases();
    return cases[index].value;
}
Excerpt :: (text: string, row: facts.Row) -> string {
    return strings.Slice(text, row.start, row.end - row.start);
}
Position :: (text: string, start: int, line: int, column: int) -> bool {
    bytes := strings.Bytes(text);
    if (start < 0 || start > length(bytes)) {
        return false;
    }
    row: int = 1;
    col: int = 1;
    for (at in 0..<start) {
        if (bytes[at] == 10) {
            row += 1;
            col = 1;
        } else {
            col += 1;
        }
    }
    return line == row && column == col;
}
// The row of each function, in declaration order.
Heads :: (rows: facts.Row[]) -> int[] {
    heads: int[] = [];
    for (index in 0..<length(rows)) {
        if (rows[index].kind == facts.FunctionRow) {
            heads.append(index);
        }
    }
    return heads;
}
// The value a comparison operator gives for `left` and `right`.
Compared :: (operator: int, left: int, right: int) -> bool {
    if (operator == facts.Less) {
        return left < right;
    }
    if (operator == facts.LessEqual) {
        return left <= right;
    }
    if (operator == facts.Greater) {
        return left > right;
    }
    if (operator == facts.GreaterEqual) {
        return left >= right;
    }
    if (operator == facts.Equal) {
        return left == right;
    }
    return left != right;
}
// The value function `function` returns for `arguments`: the rows read as
// the evaluation they record, operand by operand, segment by segment. The
// first guard whose condition holds returns its arm's value, else the final
// return gives it. Bools are 0 and 1. Only calls recurse, so the depth is the
// call chain's.
Evaluate :: (rows: facts.Row[], heads: int[], function: int, arguments: int[]) -> int {
    head := heads[function];
    at := head + 1 + rows[head].count;
    while (true) {
        stack: int[] = [];
        first := at + 1;
        for (index in first..<first + rows[at].count) {
            operand := rows[index];
            if (operand.kind == facts.LiteralRow) {
                stack.append(operand.value);
            } else if (operand.kind == facts.ReadRow) {
                stack.append(arguments[operand.value]);
            } else if (operand.kind == facts.CompareRow) {
                base := length(stack) - 2;
                compared: int = 0;
                if (Compared(operand.value, stack[base], stack[base + 1])) {
                    compared = 1;
                }
                stack = slice(stack, 0, base);
                stack.append(compared);
            } else {
                base := length(stack) - operand.count;
                passed: int[] = [];
                for (argument in base..<length(stack)) {
                    passed.append(stack[argument]);
                }
                stack = slice(stack, 0, base);
                stack.append(Evaluate(rows, heads, operand.value, passed));
            }
        }
        value := stack[length(stack) - 1];
        if (rows[at].kind == facts.ReturnRow) {
            return value;
        }
        // A guard: its arm when it holds, else the segment after the arm.
        at = first + rows[at].count;
        if (value != 1) {
            at += rows[at].count + 1;
        }
    }
}
// Function names joined by commas, and operand excerpts by function.
Names :: (rows: facts.Row[]) -> string {
    names := "";
    for (head in Heads(rows)) {
        if (names != "") {
            names = format_text("{},", names);
        }
        names = format_text("{}{}", names, rows[head].name);
    }
    return names;
}
// Each function's operand excerpts, separated by " ; ". A guard's condition
// is followed by " ? " and its arm's operands by " : ".
Trace :: (rows: facts.Row[]) -> string {
    trace := "";
    separator := "";
    // 1 within a guard's condition, 2 within its arm.
    guard: int = 0;
    for (row in rows) {
        if (row.kind == facts.FunctionRow) {
            separator = "";
            if (trace != "") {
                trace = format_text("{} |", trace);
                separator = " ";
            }
        } else if (row.kind == facts.GuardRow) {
            guard = 1;
        } else if (row.kind == facts.ReturnRow && guard == 1) {
            separator = " ? ";
            guard = 2;
        } else if (row.kind == facts.ReturnRow && guard == 2) {
            separator = " : ";
            guard = 0;
        } else if (row.kind == facts.LiteralRow || row.kind == facts.ReadRow || row.kind == facts.CallRow ||
                   row.kind == facts.CompareRow) {
            trace = format_text("{}{}{}", trace, separator, Excerpt(rows[0].text, row));
            separator = " ; ";
        }
    }
    return trace;
}
// Positive when the producer's rows are the case's expected result.
pub Check :: (rows: facts.Row[]) -> int {
    cases := Cases();
    index: int = 0;
    while (index < length(cases) && (length(rows) < 1 || cases[index].source != rows[0].text)) {
        index += 1;
    }
    if (index >= length(cases)) {
        return -1;
    } // "unknown scalar fixture source"
    expected := cases[index];
    if (rows[0].kind != facts.SourceRow || rows[0].name != "Scalar.chibi" || length(rows) < 2) {
        return -2;
    } // "source path was not retained"
    if (!expected.accepted) {
        if (length(rows) != 2 || rows[1].kind != facts.RejectionRow) {
            return -3;
        } // "unsupported source was certified, or a rejection kept a partial result"
        rejection := rows[1];
        if (rejection.text != expected.message) {
            return -4;
        } // "rejection message differs"
        if (!Position(rows[0].text, rejection.start, rejection.line, rejection.column) ||
            rejection.end < rejection.start || rejection.end > strings.ByteLength(rows[0].text)) {
            return -5;
        } // "diagnostic byte position differs"
        if (expected.excerpt != "" && Excerpt(rows[0].text, rejection) != expected.excerpt) {
            return -6;
        } // "diagnostic does not identify the unsupported source"
        return 1;
    }
    if (rows[1].kind != facts.DocumentRow || rows[1].name != "project:Scalar.chibi") {
        return -7;
    } // "source identity differs"
    if (Names(rows) != expected.functions) {
        return -8;
    } // "functions differ"
    empty: int[] = [];
    if (Evaluate(rows, Heads(rows), 0, empty) != expected.value) {
        return -9;
    } // "the recorded evaluation differs"
    if (expected.trace != "" && Trace(rows) != expected.trace) {
        return -10;
    } // "operand order or provenance differs"
    for (row in rows) {
        if (row.kind >= facts.FunctionRow && !Position(rows[0].text, row.start, row.line, row.column)) {
            return -11;
        } // "row position differs"
    }
    return 1;
}
