package facts

// managed pointers
@test
Calls :: () {
    r1: int = Alias();
    e1: int = 888;
    assert(r1 == e1, "Alias call 1");
    r2: int = Escaped();
    e2: int = 94;
    assert(r2 == e2, "Escaped call 2");
    r3: int = Field();
    e3: int = 54;
    assert(r3 == e3, "Field call 3");
    r4: int = Copies();
    e4: int = 379;
    assert(r4 == e4, "Copies call 4");
    r5: int = Distinct();
    e5: int = 1102;
    assert(r5 == e5, "Distinct call 5");
    r6: int = Nullable();
    e6: int = 3;
    assert(r6 == e6, "Nullable call 6");
    r7: int = ArrayCopies();
    e7: int = 522;
    assert(r7 == e7, "ArrayCopies call 7");
    r8: int = Parameter();
    e8: int = 34;
    assert(r8 == e8, "Parameter call 8");
    r9: int = Cycle();
    e9: int = 12;
    assert(r9 == e9, "Cycle call 9");
    r10: int = Grouped();
    e10: int = 4;
    assert(r10 == e10, "Grouped call 10");
    r11: i64 = Widened();
    e11: i64 = 5;
    assert(r11 == e11, "Widened call 11");
    r12: int = WholeArray();
    e12: int = 390;
    assert(r12 == e12, "WholeArray call 12");
}
