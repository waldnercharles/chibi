-
-/* The program is one file of the package at its directory; it may import
- * the packages of its collections, core: among them. */
-static char *compile_input(
-    const build_host *host,
-    const native_capabilities *native,
-    size_t *length,
-    char ***paths_out
-)
-{
-    const chibi_build_options *options = host->options;
-    source_package_collection collections[CHIBI_BUILD_MAX_COLLECTIONS + 1];
-    int count = 0;
-    if (options->core) {
-        collections[count++] = (source_package_collection){ "core", options->core };
-    }
-    for (int i = 0; i < options->collection_count; i++) {
-        collections[count++] = (source_package_collection){
-            options->collections[i].name,
-            options->collections[i].root
-        };
-    }
-    source_package_input *files = NULL;
-    for (int i = 0; i < count; i++) {
-        source_package_input *read = NULL;
-        source_package_load_error load = { 0 };
-        if (!source_package_files_read(collections[i].root, &read, &load)) {
-            diagnose(host->result, load.message);
-            source_package_files_free(files);
-            return NULL;
-        }
-        for (int j = 0; j < acount(read); j++) {
-            apush(files, read[j]);
-        }
-        afree(read);
-    }
-    const char *slash = strrchr(options->source_path, '/');
-    char *path = join(host->program_directory, slash ? slash + 1 : options->source_path);
-    /* Compile's first file chooses its root package. The program precedes
-     * collection inputs even when a collection sorts before it on disk. */
-    int file_count = acount(files) + 1;
-    const char **paths = xmalloc((size_t)file_count * sizeof *paths);
-    const char **texts = xmalloc((size_t)file_count * sizeof *texts);
-    size_t *sizes = xmalloc((size_t)file_count * sizeof *sizes);
-    paths[0] = path;
-    texts[0] = options->source_text;
-    sizes[0] = strlen(options->source_text);
-    for (int i = 0; i < acount(files); i++) {
-        paths[i + 1] = files[i].path;
-        texts[i + 1] = files[i].text;
-        sizes[i + 1] = files[i].size;
-    }
-    const char *names[CHIBI_BUILD_MAX_COLLECTIONS + 1],
-        *roots[CHIBI_BUILD_MAX_COLLECTIONS + 1];
-    for (int i = 0; i < count; i++) {
-        names[i] = collections[i].name;
-        roots[i] = collections[i].root;
-    }
-    /* This private host runs builds without a debugger or watch inspection. */
-    char *json = compiler_package_request_json(
-        host->program_directory,
-        names,
-        roots,
-        count,
-        paths,
-        texts,
-        sizes,
-        file_count,
-        native_capabilities_catalog(native),
-        length
-    );
-    free(sizes);
-    free(texts);
-    /* The rejection names a document by its place in this list. */
-    char **named = NULL;
-    for (int i = 0; i < file_count; i++) {
-        apush(named, xstrdup(paths[i]));
-    }
-    *paths_out = named;
-    free(paths);
-    free(path);
-    source_package_files_free(files);
-    if (!json) {
-        diagnose(host->result, "cannot encode build compiler input");
-    }
-    return json;
-}
-
-/* "path:line:column: message" when the rejection says where, else the message. */
-static void located_diagnostic(build_host *host, yyjson_val *diagnostic, const char *message, char **paths)
-{
-    int64_t line = yyjson_get_sint(yyjson_obj_get(diagnostic, "line"));
-    int64_t column = yyjson_get_sint(yyjson_obj_get(diagnostic, "column"));
-    int64_t document = yyjson_get_sint(yyjson_obj_get(diagnostic, "document"));
-    if (line > 0 && document >= 0 && document < acount(paths)) {
-        snprintf(
-            host->result->diagnostic,
-            sizeof host->result->diagnostic,
-            "%s:%lld:%lld: %s",
-            paths[document],
-            (long long)line,
-            (long long)column,
-            message
-        );
-        return;
-    }
-    diagnose(host->result, message);
-}
-
-static void compile_rejection(build_host *host, const char *json, size_t length, char **paths)
-{
-    compiler_host_result result = { 0 };
-    compiler_host *compiler = compiler_host_of(
-        host->options->compiler,
-        result.diagnostic,
-        sizeof result.diagnostic
-    );
-    bool called = compiler &&
-                  compiler_host_invoke(
-                      compiler,
-                      compiler_host_entry("project:package_compiler:1:CompileWithEffects:callable"),
-                      json,
-                      length,
-                      BUILD_COMPILE_BUDGET,
-                      &result
-                  );
-    yyjson_doc *doc = called ? yyjson_read(result.json, result.length, COMPILER_HOST_JSON_READ_FLAGS)
-                             : NULL;
-    yyjson_val *error = yyjson_arr_get(yyjson_doc_get_root(doc), 2);
-    yyjson_val *diagnostic = yyjson_arr_get(yyjson_obj_get(error, "values"), 0);
-    const char *message = yyjson_get_str(yyjson_obj_get(diagnostic, "message"));
-    if (message) {
-        located_diagnostic(host, diagnostic, message, paths);
-    } else {
-        diagnose(host->result, result.diagnostic[0] ? result.diagnostic : "build source compilation failed");
-    }
-    yyjson_doc_free(doc);
-    free(result.json);
-}
