version 3
name "RoundedBlock"
domain "model"
id_counter 7
description "Radius preserves the requested outer half-size."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Rounded Box"
                inputs {
                    "Half Size" {
                        default x=27.0 y=22.0 z=25.0
                    }
                    Radius 6.0
                }
            }
        }
        (array)edges {
            - from="3.Geometry" to="1.Geometry"
        }
    }
}
