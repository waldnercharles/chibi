behavior "EnemyBehavior" {
    owner "ecs.entity";
    value self_2 = engine["Self"]();
    value find_nearest_entity = find_nearest_entity(Position: &component("GAME.GameTransform"), Radius: 2000.0, Categories: 1, Exclude: self_2);
    on Tick as tick() {
        if (find_nearest_entity.Found) {
            set_game_velocity(Value: "Pursuit Velocity"(Position: &component("GAME.GameTransform"), Target: find_nearest_entity.Position, Speed: &component("GAME.GameMovement", "speed"), "Delta Seconds": &delta, Distance: find_nearest_entity.Distance));
        } else {
            set_game_velocity(Value: {
                x: 0.0,
                y: 0.0
            });
        }
    }
    pure function "Pursuit Velocity"(Position: struct<"CF_V2"> = null, Target: struct<"CF_V2"> = null, Speed: float = 0.0, "Delta Seconds": float = 0.0, Distance: float = 0.0) -> (Velocity: struct<"GameVelocity"> = null) {
        depth_limit 64;
        result Velocity: struct<"GameVelocity"> = "normalize(Target - Position) * clamp(Speed, 0, Distance / DeltaSeconds)"(Target: struct<"CF_V2"> = entry.Target, Position: struct<"CF_V2"> = entry.Position, Speed: float = entry.Speed, Distance: float = entry.Distance, DeltaSeconds: float = entry."Delta Seconds");
    }
    pure function "normalize(Target - Position) * clamp(Speed, 0, Distance / DeltaSeconds)"<T0: struct<"CF_V2">, T1: struct<"CF_V2">, T2: float, T3: float, T4: float, T5: struct<"CF_V2">>(Target: T0 = null, Position: T1 = null, Speed: T2 = 0.0, Distance: T3 = 0.0, DeltaSeconds: T4 = 0.0) -> (Result: T5 = null) {
        depth_limit 64;
        value subtract = subtract(A: struct<"CF_V2"> = entry.Target, B: struct<"CF_V2"> = entry.Position);
        value normalize_vector_2 = vec2_norm(Value: subtract);
        value real = real(Value: 0.0);
        value divide = divide(A: double = entry.Distance, B: double = entry.DeltaSeconds);
        value clamp = clamp(Value: double = entry.Speed, Min: double = real, Max: double = divide);
        value multiply = multiply(A: struct<"CF_V2"> = normalize_vector_2, B: double = clamp);
        result Result: struct<"CF_V2"> = multiply;
    }
}
