    BOUNDED_SOURCE("source_parser/Declarations.chibi", SOURCE_PARSER_DECLARATIONS_SOURCE), \
    BOUNDED_SOURCE("source_parser/Parser.chibi", SOURCE_PARSER_PARSER_SOURCE), \
    BOUNDED_SOURCE("compiler_syntax/Syntax.chibi", COMPILER_SYNTAX_CHIBI_SOURCE), \
    BOUNDED_SOURCE("package_routes/Routes.chibi", PACKAGE_ROUTES_CHIBI_SOURCE), \
    BOUNDED_SOURCE("package_syntax/Extract.chibi", PACKAGE_SYNTAX_CHIBI_SOURCE), \
    BOUNDED_SOURCE("package_graph/Graph.chibi", PACKAGE_GRAPH_CHIBI_SOURCE), \
    BOUNDED_SOURCE("package_paths/Paths.chibi", PACKAGE_PATHS_CHIBI_SOURCE), \
    BOUNDED_SOURCE("scalar_lowering/Lower.chibi", SCALAR_LOWERING_CHIBI_SOURCE), \
