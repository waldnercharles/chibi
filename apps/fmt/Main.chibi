package fmt_cli

import format "project:source_format"
import strings "core:strings"

// chibi fmt [--check | --staged] [--option NAME=VALUE]... [PATH...]: formats
// Chibi sources in place. Options come from source_format's defaults, then the
// repository's .chibi-format file (NAME=VALUE lines; # starts a comment), then
// --option flags. A PATH is a .chibi file or a directory, whose
// files are the ones git tracks below it; without one, the working directory.
// --check writes nothing and fails when a file would change. --staged formats
// the files staged for commit and stages the result, for the pre-commit hook.
// `chibi fmt` runs this package as a separate program so that the other
// commands do not compile the formatter on every start.
//
// A program's garbage is collected only between runs, and parsing costs about
// 3 KB of heap per source byte, so one process formats at most BatchBytes of
// source. A larger job runs its first batch itself and each later batch in a
// child `chibi run` of this package with the internal --batch flag, which takes
// explicit files, prints one line per changed file and writes its counts to the
// file named by --report. (process.capture cannot carry a child's output: it
// gives up after ten seconds, and a child spends longer than that compiling.)

// The most source one process formats; about 1.3 GB of heap.
BatchBytes: int : 400000;

Join :: (parts: string[]) -> string {
    return strings.Join(parts, "")
}

Output :: (text: string) {
    application.stdout(Join([text, "\n"]))
}

Error :: (text: string) {
    application.stderr(Join([text, "\n"]))
}

Concat :: (first: string[], second: string[]) -> string[] {
    result := first
    for value in second {
        result = append(result, value)
    }
    return result
}

Contains :: (lines: string[], wanted: string) -> bool {
    for line in lines {
        if line == wanted {
            return true
        }
    }
    return false
}

Request :: struct {
    check: bool
    staged: bool
    error: string
    help: bool
    batch: bool
    report: string
    // The --option NAME=VALUE pairs, separated by spaces.
    options: string
}

// The flags among `arguments`, which hold the program path first; FormatPaths
// lists the rest.
ParseRequest :: (arguments: string[]) -> Request {
    request: Request = {check: false, staged: false, error: "", help: false, batch: false, report: "", options: ""}
    paths := 0
    index := 1
    while index < length(arguments) {
        argument := arguments[index]
        if argument == "--help" || argument == "-h" {
            request.help = true
        } else if argument == "--check" && !request.check {
            request.check = true
        } else if argument == "--report" && request.report == "" && index + 1 < length(arguments) {
            index += 1
            request.report = arguments[index]
        } else if argument == "--option" && index + 1 < length(arguments) {
            index += 1
            request.options = Join([request.options, " ", arguments[index]])
        } else if argument == "--batch" && !request.batch {
            request.batch = true
        } else if argument == "--staged" && !request.staged {
            request.staged = true
        } else if argument == "" {
            request.error = "A fmt path must not be empty"
        } else if strings.HasPrefix(argument, "-") {
            request.error = format_text("Invalid fmt option {}; use --help.", argument)
        } else {
            paths += 1
        }
        index += 1
    }
    if request.error == "" && request.staged && (request.check || paths > 0) {
        request.error = "fmt --staged takes no paths and no --check; use --help."
    }
    return request
}

FormatPaths :: (arguments: string[]) -> string[] {
    paths: string[] = []
    index := 1
    while index < length(arguments) {
        if arguments[index] == "--report" || arguments[index] == "--option" {
            index += 1
        } else if !strings.HasPrefix(arguments[index], "-") {
            paths = append(paths, arguments[index])
        }
        index += 1
    }
    return paths
}

Usage :: () -> string {
    return "Usage: chibi fmt [--check | --staged] [--option NAME=VALUE]... [PATH...]\nfmt formats .chibi sources in place. A PATH is a file or a directory, which has\nthe files git tracks below it; none means the working directory. --check\nwrites nothing and fails when a file would change. --staged formats the staged\nfiles and stages the result. Options come from the defaults, then the\nrepository's .chibi-format file of NAME=VALUE lines, then --option; see\ndocs/source-formatting.md for the names.\n"
}

// The options for this run: the defaults, the repository's .chibi-format
// file, then the request's --option pairs.
LoadOptions :: (request: Request) -> (options: format.Options, error: string) {
    configured := ""
    top := process.capture(["git", "rev-parse", "--show-toplevel"])
    if top.error == 0 && top.status == 0 {
        file := Join([strings.TrimSpace(top.output), "/.chibi-format"])
        if files.kind(file) == 1 {
            configured = files.read(file)
        }
    }
    parsed := format.ParseOptions(format.Defaults(), Join([configured, "\n", request.options]))
    return (parsed.options, parsed.error)
}

// The lines `git` prints for `arguments` run in `directory`; `failed` is set
// when it fails, with the message already reported.
GitLines :: (directory: string, arguments: string[]) -> (lines: string[], failed: bool) {
    command := Concat(["git", "-C", directory], arguments)
    captured := process.capture(command)
    if captured.error != 0 || captured.status != 0 {
        Error(format_text("fmt: git {} failed in {}: {}", arguments[0], directory,
                          strings.TrimSpace(captured.error_output)))
        none: string[] = []
        return (none, true)
    }
    return (strings.SplitLines(captured.output), false)
}

// Adds the tracked .chibi files below `directory` to `found`.
TrackedSources :: (directory: string, found: ^(string[])) -> bool {
    listed := GitLines(directory, ["ls-files", "--full-name", "--", "*.chibi"])
    if listed.failed {
        return false
    }
    top := GitLines(directory, ["rev-parse", "--show-toplevel"])
    if top.failed || length(top.lines) == 0 {
        return false
    }
    for name in listed.lines {
        if name != "" {
            found.append(Join([top.lines[0], "/", name]))
        }
    }
    return true
}

// Formats one file. Returns 1 when it changed (or would), 0 when unchanged,
// -1 when it cannot be formatted.
FormatFile :: (path: string, check: bool, options: format.Options) -> int {
    text := files.read(path)
    switch format.Format(text, options) {
        case .Rejected(message):
            Error(format_text("{}: {}", path, message))
            return -1
        case .Formatted(formatted):
            if formatted == text {
                return 0
            }
            if check {
                Output(format_text("would reformat {}", path))
            } else if files.write(path, formatted) {
                Output(format_text("reformatted {}", path))
            } else {
                Error(format_text("{}: cannot write", path))
                return -1
            }
            return 1
    }
}

// The files named by `arguments`' paths, directories expanded; ok is false
// after reporting why not.
SourcePaths :: (request: Request, arguments: string[]) -> (sources: string[], ok: bool) {
    paths := FormatPaths(arguments)
    if length(paths) == 0 {
        paths = ["."]
    }
    sources: string[] = []
    for path in paths {
        kind := files.kind(path)
        if kind == 1 {
            sources.append(files.resolve(path))
        } else if kind == 2 && !request.batch {
            if !TrackedSources(files.resolve(path), &sources) {
                return (sources, false)
            }
        } else {
            Error(format_text("fmt: cannot find {}", path))
            return (sources, false)
        }
    }
    return (sources, true)
}

Counts :: struct {
    changed: int
    rejected: int
}

FormatBatch :: (sources: string[], from: int, to: int, check: bool, options: format.Options) -> Counts {
    counts: Counts = {changed: 0, rejected: 0}
    index := from
    while index < to {
        verdict := FormatFile(sources[index], check, options)
        if verdict > 0 {
            counts.changed += 1
        } else if verdict < 0 {
            counts.rejected += 1
        }
        index += 1
    }
    return counts
}

// Runs one later batch in a child process, which prints as it goes; its counts
// come back through `report`, a file path.
RunBatch :: (program: string, request: Request, batch: string[], report: string) -> Counts {
    launcher := Join([application.bin(), "/chibi"])
    if application.platform() == "Windows" {
        launcher = Join([launcher, ".exe"])
    }
    command := [launcher, "run", program, "--", "--batch", "--report", report]
    if request.check {
        command = append(command, "--check")
    }
    for pair in strings.Fields(request.options) {
        command = append(command, "--option")
        command = append(command, pair)
    }
    files.remove(report)
    process.run(Concat(command, batch))
    counts: Counts = {changed: 0, rejected: length(batch)}
    parts := strings.Split(strings.TrimSpace(files.read(report)), " ")
    if length(parts) == 2 && Number(parts[0]) >= 0 && Number(parts[1]) >= 0 {
        counts.changed = Number(parts[0])
        counts.rejected = Number(parts[1])
    } else {
        Error(format_text("fmt: a batch of {} files failed to run", length(batch)))
    }
    return counts
}

FormatTree :: (request: Request, arguments: string[], options: format.Options) -> int {
    found := SourcePaths(request, arguments)
    if !found.ok {
        return 2
    }
    sources := found.sources
    if request.batch {
        counts := FormatBatch(sources, 0, length(sources), request.check, options)
        if request.report != "" {
            files.write(request.report, format_text("{} {}", counts.changed, counts.rejected))
        }
        if counts.rejected > 0 || (request.check && counts.changed > 0) {
            return 1
        }
        return 0
    }
    sizes: int[] = []
    for source in sources {
        sizes = append(sizes, text_byte_length(files.read(source)))
    }
    total: Counts = {changed: 0, rejected: 0}
    scratch := ""
    start := 0
    while start < length(sources) {
        end := start + 1
        bytes := sizes[start]
        while end < length(sources) && bytes + sizes[end] <= BatchBytes {
            bytes += sizes[end]
            end += 1
        }
        counts: Counts = {changed: 0, rejected: 0}
        if start == 0 {
            counts = FormatBatch(sources, start, end, request.check, options)
        } else {
            if scratch == "" {
                scratch = files.temporary("chibi-fmt")
            }
            counts = RunBatch(arguments[0], request, Slice(sources, start, end), Join([scratch, "/report"]))
        }
        total.changed += counts.changed
        total.rejected += counts.rejected
        start = end
    }
    verb := "reformatted"
    if request.check {
        verb = "would change"
    }
    Output(format_text("{} files, {} {}, {} could not be formatted", length(sources), total.changed, verb, total.rejected))
    if total.rejected > 0 || (request.check && total.changed > 0) {
        return 1
    }
    return 0
}

Slice :: (values: string[], from: int, to: int) -> string[] {
    part: string[] = []
    index := from
    while index < to {
        part = append(part, values[index])
        index += 1
    }
    return part
}

// The pre-commit step. A file with unstaged edits is left alone, because
// staging its formatted text would stage those edits too.
FormatStaged :: (options: format.Options) -> int {
    here := files.resolve(".")
    top := GitLines(here, ["rev-parse", "--show-toplevel"])
    if top.failed || length(top.lines) == 0 {
        return 2
    }
    staged := GitLines(top.lines[0], ["diff", "--cached", "--name-only", "--diff-filter=ACMR", "--", "*.chibi"])
    partial := GitLines(top.lines[0], ["diff", "--name-only", "--", "*.chibi"])
    if staged.failed || partial.failed {
        return 2
    }
    status := 0
    for name in staged.lines {
        if name == "" {
            continue
        }
        path := Join([top.lines[0], "/", name])
        if Contains(partial.lines, name) {
            Error(format_text("{}: has unstaged edits; run chibi fmt on it, stage it, and commit again", name))
            if FormatFile(path, true, options) != 0 {
                status = 1
            }
            continue
        }
        verdict := FormatFile(path, false, options)
        if verdict < 0 {
            status = 1
        } else if verdict > 0 && process.run(["git", "-C", top.lines[0], "add", "--", name]) != 0 {
            Error(format_text("{}: cannot stage the formatted file", name))
            status = 1
        }
    }
    return status
}

// `text` as a non-negative decimal integer, or -1.
Number :: (text: string) -> int {
    if text == "" {
        return -1
    }
    value := 0
    index := 0
    while index < text_byte_length(text) {
        digit := strings.ByteAt(text, index) - 48
        if digit < 0 || digit > 9 {
            return -1
        }
        value = value * 10 + digit
        index += 1
    }
    return value
}

Main :: () -> int {
    arguments := application.arguments()
    request := ParseRequest(arguments)
    if request.help {
        application.stdout(Usage())
        return 0
    }
    if request.error != "" {
        Error(request.error)
        return 2
    }
    loaded := LoadOptions(request)
    if loaded.error != "" {
        Error(format_text("fmt: {}", loaded.error))
        return 2
    }
    if request.staged {
        return FormatStaged(loaded.options)
    }
    return FormatTree(request, arguments, loaded.options)
}
