  - id: 2386
    type: Send Event
    reference_name: CollectExperience
    inputs:
      Exec: {id: 2383}
  - id: 3627
    type: Behavior Expression
    reference_id: 3613
    reference_name: status != 2
    inputs:
      Exec: {id: 3630, kind: exec}
      status:
        id: 3628
        type: double
        flags: 0
