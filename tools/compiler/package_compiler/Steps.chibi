package package_compiler

import snapshot "project:source_snapshot"
import strings "core:strings"

// The steps EmitBody takes for nodes other than control flow. Each reads the
// body's tables, which calls share rather than copy, and returns only what it
// adds, numbered from the sizes in `at`.

// The slots ElementRead numbers from its `first`: zero, the lower check, the
// count, the upper check, the items, the element's address and the element.
ElementSlots :: pure fn(storage: int, target: Target) -> Slot[] {
    number: Slot = {storage: IntStorage, kind: ValueKind};
    flag: Slot = {storage: BoolStorage, kind: ValueKind};
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    element: Slot = {storage: SlotStorage(storage, 0, target), kind: SlotKind(storage, 0)};
    return [number, flag, number, flag, address, address, element];
}
// Reads the element of the array in slot `array` at the index in slot
// `position` into slot first + 6, after checking 0 <= index < count as stage
// zero does.
ElementRead :: pure fn(array: int, position: int, storage: int, first: int, ops: Ops, target: Target,
                       node: snapshot.SnapshotNode) -> Code[] {
    code: Code[] = [];
    constant := Instruction(ops.constant, IntStorage, first, 0, 0, 0, node);
    constant.value_storage = IntStorage;
    code = array_add(code, constant);
    code = array_add(code, Instruction(ops.ge, IntStorage, first + 1, position, first, -1, node));
    code = array_add(code, Instruction(ops.guard, 0, 0, first + 1, 0, target.argument_failure, node));
    code = array_add(code, Instruction(ops.guard, 0, 0, array, 0, target.argument_failure, node));
    count := Instruction(ops.load, IntStorage, first + 2, array, 0, 0, node);
    count.offset = target.count_offset;
    code = array_add(code, count);
    code = array_add(code, Instruction(ops.lt, IntStorage, first + 3, position, first + 2, -1, node));
    code = array_add(code, Instruction(ops.guard, 0, 0, first + 3, 0, target.argument_failure, node));
    items := Instruction(ops.load, target.pointer_storage, first + 4, array, 0, 0, node);
    items.offset = target.items_offset;
    code = array_add(code, items);
    indexed := Instruction(ops.index, target.pointer_storage, first + 5, first + 4, position, 0, node);
    indexed.offset = target.value_size;
    code = array_add(code, indexed);
    read := Instruction(ops.load, SlotStorage(storage, 0, target), first + 6, first + 5, 0, 0, node);
    read.offset = target.payload_offset;
    return array_add(code, read);
}

// Copies the record or array in slot `kept.slot` into a fresh snapshot cell
// and produces the copy's address.
RetainStep :: pure fn(kept: Value, ops: Ops, target: Target, at: Bases, item: snapshot.SnapshotNode) -> Step {
    code: Code[] = [];
    slots: Slot[] = [];
    locals: int[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    argument: Cell = {storage: kept.storage, container: kept.container, record: kept.record, offset: 0, kind: ValueKind};
    cells = array_add(cells, argument);
    cells = array_add(cells, argument);
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    slots = array_add(slots, address);
    code = array_add(code, Instruction(ops.host_slot, target.pointer_storage, at.slot, at.cell, 0, 0, item));
    write := Instruction(ops.write, target.pointer_storage, 0, kept.slot, at.slot, 0, item);
    write.offset = target.payload_offset;
    code = array_add(code, write);
    host: Host = {intrinsic: SnapshotIntrinsic, linked: -1, first: at.cell, result_first: at.cell + 1, result_count: 1};
    hosts = array_add(hosts, host);
    code = array_add(code, Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, item));
    slots = array_add(slots, address);
    code = array_add(code, Instruction(ops.host_slot, target.pointer_storage, at.slot + 1, at.cell + 1, 0, 0, item));
    slots = array_add(slots, address);
    load := Instruction(ops.load, target.pointer_storage, at.slot + 2, at.slot + 1, 0, 0, item);
    load.offset = target.payload_offset;
    code = array_add(code, load);
    root: Root = {slot: at.slot + 2, storage: kept.storage, container: kept.container, record: kept.record};
    roots = array_add(roots, root);
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
        Typed(at.slot + 2, kept.storage, kept.container, kept.record), NoValue(), marks);
}

// Statements: local declarations, assignments, expression statements and
// returns, from scheduling to the value's store.
StatementStep :: pure fn(forest: snapshot.SnapshotNode[], text: string, document: int, callables: Callable[],
                         records: Record[], natives: Native[], names: Name[], values: Value[], top: int,
                         function: int, item: Work, ops: Ops, target: Target, at: Bases) -> Step {
    callable := callables[function];
    node := forest[item.node];
    kind := node.kind;
    code: Code[] = [];
    slots: Slot[] = [];
    locals: int[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    popped: int = 0;
    retain := NoValue();
    if (item.phase == 0) {
        code = array_add(code, Instruction(ops.check, 0, 0, 0, 0, 0, node));
        value := Field(forest, item.node, "value");
        if (kind == "expression_statement") { value = FirstMember(forest, item.node); }
        expected := Visit(value);
        if (kind == "local_declaration") {
            declared := Field(forest, item.node, "type");
            if (declared >= 0) {
                resolved := ReadType(forest, text, records, declared);
                if (resolved.storage == 0) { return Fail(forest, declared, document, "local type is not supported yet"); }
                expected = Expect(value, resolved.storage, resolved.container, resolved.record);
            }
        } else if (kind == "return_statement") {
            expected = Expect(value, callable.result, callable.result_container, callable.result_record);
        } else if (kind == "assignment") {
            destination := Field(forest, item.node, "target");
            operator := CompoundOperator(Text(forest, text, Field(forest, item.node, "operator")));
            if (Is(forest, destination, "identifier")) {
                found := Lookup(names, Text(forest, text, destination));
                if (found >= 0) {
                    binding := names[found];
                    expected = Expect(value, binding.storage, binding.container, binding.record);
                    // `xs = array_add(xs, x)` and `xs = append(xs, ys)` on a
                    // local array update it in place.
                    native := -1;
                    if (operator == "") { native = InPlaceNative(forest, text, callables, natives, names, found, destination, value); }
                    if (native >= 0) {
                        argument := NextMember(forest, FirstMember(forest, Field(forest, value, "arguments")));
                        extend: int = 0;
                        container: int = 0;
                        if (natives[native].name == "Append") {
                            extend = 1;
                            container = ArrayContainer;
                        }
                        next = array_add(next, Expect(argument, binding.storage, container, binding.record));
                        next = array_add(next, Resume(item.node, PushPhase, found, extend));
                        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
                            NoValue(), retain, marks);
                    }
                }
            } else if (Is(forest, destination, "index_expression")) {
                // `xs[i] = x` on a local array stores in place.
                object := Field(forest, destination, "object");
                found := -1;
                if (Is(forest, object, "identifier")) { found = Lookup(names, Text(forest, text, object)); }
                if (found < 0 || names[found].place != CellPlace || names[found].container != ArrayContainer) {
                    return Fail(forest, destination, document, "element assignment needs a local array");
                }
                binding := names[found];
                compound: int = 0;
                if (operator != "") { compound = 1; }
                next = array_add(next, Visit(Field(forest, destination, "index")));
                next = array_add(next, Expect(value, binding.storage, 0, binding.record));
                next = array_add(next, Resume(item.node, StorePhase, found, compound));
                return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
                    NoValue(), retain, marks);
            }
        }
        if (kind == "return_statement" && value < 0) {
            if (callable.result != 0) { return Fail(forest, item.node, document, "return needs a value"); }
            code = array_add(code, Instruction(ops.finish, 0, 0, 0, 0, 0, node));
        } else {
            next = array_add(next, expected);
            next = array_add(next, Resume(item.node, ValuePhase, 0, 0));
        }
    } else if (item.phase == ValuePhase) {
        popped = 1;
        result := values[top - 1];
        if (result.storage < 0 && kind != "expression_statement") {
            return Fail(forest, item.node, document, "call has no value");
        }
        if (kind == "local_declaration") {
            declared := Field(forest, item.node, "type");
            local := result;
            if (declared >= 0) {
                resolved := ReadType(forest, text, records, declared);
                local = Typed(-1, resolved.storage, resolved.container, resolved.record);
            }
            if (!SameType(local.storage, local.container, local.record, result)) {
                return Fail(forest, item.node, document, "local value differs from its type");
            }
            name := NameText(forest, text, Field(forest, item.node, "name"));
            if (name == "") { return Fail(forest, Field(forest, item.node, "name"), document, "Invalid string or embedded NUL"); }
            if (Pointer(local.storage, local.container)) {
                // The local is the cell that holds its own copy.
                retain = result;
                next = array_add(next, Resume(item.node, RetainedPhase, 0, 0));
            } else {
                locals = array_add(locals, local.storage);
                code = array_add(code, Instruction(ops.save, local.storage, 0, result.slot, 0, at.local, node));
                binding: Name = {name: name, place: LocalPlace, index: at.local, storage: local.storage, container: 0,
                    record: -1};
                bound = array_add(bound, binding);
            }
        } else if (kind == "assignment") {
            destination := Field(forest, item.node, "target");
            found := -1;
            if (Is(forest, destination, "identifier")) { found = Lookup(names, Text(forest, text, destination)); }
            if (found < 0 || names[found].place == ParameterPlace) {
                return Fail(forest, destination, document, "assignment needs a local name");
            }
            binding := names[found];
            stored := result;
            operator := CompoundOperator(Text(forest, text, Field(forest, item.node, "operator")));
            if (operator != "") {
                op := BinaryOp(ops, operator);
                if (op < 0 || Comparison(ops, op) || binding.storage != IntStorage || binding.container != 0 ||
                    !Single(result, IntStorage)) {
                    return Fail(forest, item.node, document, "compound assignment needs int operands");
                }
                current: Slot = {storage: IntStorage, kind: ValueKind};
                slots = array_add(slots, current);
                code = array_add(code, Instruction(ops.local, IntStorage, at.slot, binding.index, 0, 0, node));
                slots = array_add(slots, current);
                code = array_add(code, Instruction(op, IntStorage, at.slot + 1, at.slot, result.slot, -1, node));
                stored = Typed(at.slot + 1, IntStorage, 0, -1);
            }
            if (!SameType(binding.storage, binding.container, binding.record, stored)) {
                return Fail(forest, item.node, document, "assigned value differs from its local");
            }
            if (binding.place == CellPlace) {
                retain = stored;
                next = array_add(next, Resume(item.node, RetainedPhase, binding.index, 0));
            } else {
                code = array_add(code, Instruction(ops.save, binding.storage, 0, stored.slot, 0, binding.index, node));
            }
        } else if (kind == "return_statement") {
            if (!SameType(callable.result, callable.result_container, callable.result_record, result)) {
                return Fail(forest, item.node, document, "returned value differs from the result type");
            }
            if (Pointer(result.storage, result.container)) {
                retain = result;
                next = array_add(next, Resume(item.node, RetainedPhase, -1, 0));
            } else {
                code = array_add(code, Instruction(ops.result, result.storage, 0, result.slot, 0, 0, node));
                code = array_add(code, Instruction(ops.finish, 0, 0, 0, 0, 0, node));
            }
        }
    } else if (item.phase == RetainedPhase) {
        // A retained copy, in the last cell: bind it, store it in a local's
        // cell, or publish its header.
        popped = 1;
        kept := values[top - 1];
        address: Slot = {storage: target.pointer_storage, kind: AddressKind};
        if (kind == "local_declaration") {
            binding: Name = {name: NameText(forest, text, Field(forest, item.node, "name")), place: CellPlace,
                index: at.cell - 1, storage: kept.storage, container: kept.container, record: kept.record};
            bound = array_add(bound, binding);
        } else if (kind == "assignment") {
            slots = array_add(slots, address);
            code = array_add(code, Instruction(ops.host_slot, target.pointer_storage, at.slot, item.a, 0, 0, node));
            write := Instruction(ops.write, target.pointer_storage, 0, kept.slot, at.slot, 0, node);
            write.offset = target.payload_offset;
            code = array_add(code, write);
        } else {
            // Copy the cell's whole header, type name and layout included,
            // into result zero.
            slots = array_add(slots, address);
            code = array_add(code, Instruction(ops.host_slot, target.pointer_storage, at.slot, at.cell - 1, 0, 0, node));
            slots = array_add(slots, address);
            context := Instruction(ops.context, target.pointer_storage, at.slot + 1, 0, 0, 0, node);
            context.offset = target.results_offset;
            code = array_add(code, context);
            zero: Slot = {storage: IntStorage, kind: ValueKind};
            slots = array_add(slots, zero);
            constant := Instruction(ops.constant, IntStorage, at.slot + 2, 0, 0, 0, node);
            constant.value_storage = IntStorage;
            code = array_add(code, constant);
            slots = array_add(slots, address);
            element := Instruction(ops.index, target.pointer_storage, at.slot + 3, at.slot + 1, at.slot + 2, 0, node);
            element.offset = target.value_size;
            code = array_add(code, element);
            header: int[] = [target.type_offset, target.container_offset, target.name_offset,
                target.record_offset, target.payload_offset];
            part: int = 0;
            while (part < 5) {
                loaded := address;
                if (part < 2) { loaded = zero; }
                slots = array_add(slots, loaded);
                load := Instruction(ops.load, loaded.storage, at.slot + length(slots) - 1, at.slot, 0, 0, node);
                load.offset = header[part];
                code = array_add(code, load);
                store := Instruction(ops.write, loaded.storage, 0, at.slot + length(slots) - 1, at.slot + 3, 0, node);
                store.offset = header[part];
                code = array_add(code, store);
                part += 1;
            }
            code = array_add(code, Instruction(ops.finish, 0, 0, 0, 0, 0, node));
        }
    } else {
        // An in-place update of the local array names[item.a]: a push or an
        // extension, or an element store (compound when item.b is 1).
        binding := names[item.a];
        item_value := NoValue();
        index_value := NoValue();
        intrinsic := ArrayStoreIntrinsic;
        item_container: int = 0;
        if (item.phase == PushPhase) {
            popped = 1;
            item_value = values[top - 1];
            intrinsic = ArrayPushIntrinsic;
            if (item.b == 1) {
                intrinsic = ArrayExtendIntrinsic;
                item_container = ArrayContainer;
            }
        } else if (item.b == 1) {
            // Read the element at the index already evaluated, then combine.
            popped = 2;
            index_value = values[top - 2];
            operand := values[top - 1];
            op := BinaryOp(ops, CompoundOperator(Text(forest, text, Field(forest, item.node, "operator"))));
            if (op < 0 || Comparison(ops, op) || binding.storage != IntStorage || !Single(operand, IntStorage)) {
                return Fail(forest, item.node, document, "compound assignment needs int operands");
            }
            if (!Single(index_value, IntStorage)) { return Fail(forest, item.node, document, "index needs an int"); }
            address: Slot = {storage: target.pointer_storage, kind: AddressKind};
            slots = array_add(slots, address);
            code = array_add(code, Instruction(ops.host_slot, target.pointer_storage, at.slot, binding.index, 0, 0, node));
            slots = array_add(slots, address);
            load := Instruction(ops.load, target.pointer_storage, at.slot + 1, at.slot, 0, 0, node);
            load.offset = target.payload_offset;
            code = array_add(code, load);
            root: Root = {slot: at.slot + 1, storage: IntStorage, container: ArrayContainer, record: -1};
            roots = array_add(roots, root);
            slots = append(slots, ElementSlots(IntStorage, target));
            code = append(code, ElementRead(at.slot + 1, index_value.slot, IntStorage, at.slot + 2, ops, target, node));
            combined: Slot = {storage: IntStorage, kind: ValueKind};
            slots = array_add(slots, combined);
            code = array_add(code, Instruction(op, IntStorage, at.slot + 9, at.slot + 8, operand.slot, -1, node));
            item_value = Typed(at.slot + 9, IntStorage, 0, -1);
        } else {
            popped = 2;
            index_value = values[top - 2];
            item_value = values[top - 1];
        }
        if (intrinsic == ArrayStoreIntrinsic && !Single(index_value, IntStorage)) {
            return Fail(forest, item.node, document, "index needs an int");
        }
        if (!SameType(binding.storage, item_container, binding.record, item_value)) {
            return Fail(forest, item.node, document, "array item differs from the array's type");
        }
        // The intrinsic takes the local's header address, then the index of a
        // store, then the item; it returns a bool.
        address_cell: Cell = {storage: target.pointer_storage, container: 0, record: -1, offset: 0, kind: AddressKind};
        cells = array_add(cells, address_cell);
        sources: int[] = [-1];
        storages: int[] = [target.pointer_storage];
        if (intrinsic == ArrayStoreIntrinsic) {
            index_cell: Cell = {storage: IntStorage, container: 0, record: -1, offset: 0, kind: ValueKind};
            cells = array_add(cells, index_cell);
            sources = array_add(sources, index_value.slot);
            storages = array_add(storages, IntStorage);
        }
        item_cell: Cell = {storage: binding.storage, container: item_container, record: binding.record, offset: 0,
            kind: ValueKind};
        cells = array_add(cells, item_cell);
        sources = array_add(sources, item_value.slot);
        storages = array_add(storages, SlotStorage(item_value.storage, item_value.container, target));
        done: Cell = {storage: BoolStorage, container: 0, record: -1, offset: 0, kind: ValueKind};
        cells = array_add(cells, done);
        address: Slot = {storage: target.pointer_storage, kind: AddressKind};
        slots = array_add(slots, address);
        header_slot := at.slot + length(slots) - 1;
        code = array_add(code, Instruction(ops.host_slot, target.pointer_storage, header_slot, binding.index, 0, 0, node));
        sources[0] = header_slot;
        argument: int = 0;
        while (argument < length(sources)) {
            slots = array_add(slots, address);
            code = array_add(code, Instruction(ops.host_slot, target.pointer_storage, at.slot + length(slots) - 1,
                at.cell + argument, 0, 0, node));
            write := Instruction(ops.write, storages[argument], 0, sources[argument], at.slot + length(slots) - 1, 0, node);
            write.offset = target.payload_offset;
            code = array_add(code, write);
            argument += 1;
        }
        host: Host = {intrinsic: intrinsic, linked: -1, first: at.cell, result_first: at.cell + length(cells) - 1,
            result_count: 1};
        hosts = array_add(hosts, host);
        code = array_add(code, Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, node));
    }
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, popped, NoValue(), retain, marks);
}

// Literals, names, parentheses, field reads and element reads.
ValueStep :: pure fn(forest: snapshot.SnapshotNode[], text: string, document: int, records: Record[],
                     fields: RecordField[], names: Name[], values: Value[], top: int, item: Work, ops: Ops,
                     target: Target, at: Bases) -> Step {
    node := forest[item.node];
    kind := node.kind;
    code: Code[] = [];
    slots: Slot[] = [];
    locals: int[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    popped: int = 0;
    produced := NoValue();
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    if (kind == "number" || kind == "boolean" || kind == "string") {
        storage := IntStorage;
        payload: int = 0;
        literal := "";
        if (kind == "number") {
            parsed := Decimal(Text(forest, text, item.node));
            if (parsed < 0 || parsed > 2147483647) { return Fail(forest, item.node, document, "integer literal exceeds int"); }
            payload = int(parsed);
        } else if (kind == "boolean") {
            storage = BoolStorage;
            if (Text(forest, text, item.node) == "true") { payload = 1; }
        } else {
            // String literals are JSON strings.
            storage = TextStorage;
            decoded := compiler_json_string(Text(forest, text, item.node));
            if (!decoded.valid || strings.ByteLength(decoded.value) != decoded.byte_length) {
                return Fail(forest, item.node, document, "Invalid string or embedded NUL");
            }
            literal = decoded.value;
        }
        slot: Slot = {storage: storage, kind: ValueKind};
        slots = array_add(slots, slot);
        constant := Instruction(ops.constant, storage, at.slot, 0, 0, 0, node);
        constant.value_storage = storage;
        constant.payload = payload;
        constant.text = literal;
        constant.has_text = kind == "string";
        code = array_add(code, constant);
        produced = Typed(at.slot, storage, 0, -1);
    } else if (kind == "identifier") {
        wanted := Text(forest, text, item.node);
        found := Lookup(names, wanted);
        if (found < 0) { return Fail(forest, item.node, document, format_text("Unknown name '{}'", wanted)); }
        binding := names[found];
        if (binding.place == LocalPlace) {
            slot: Slot = {storage: binding.storage, kind: ValueKind};
            slots = array_add(slots, slot);
            code = array_add(code, Instruction(ops.local, binding.storage, at.slot, binding.index, 0, 0, node));
        } else {
            slots = array_add(slots, address);
            if (binding.place == CellPlace) {
                code = array_add(code, Instruction(ops.host_slot, target.pointer_storage, at.slot, binding.index, 0, 0, node));
                slots = array_add(slots, address);
                load := Instruction(ops.load, target.pointer_storage, at.slot + 1, at.slot, 0, 0, node);
                load.offset = target.payload_offset;
                code = array_add(code, load);
            } else {
                read := Instruction(ops.array, target.pointer_storage, at.slot, binding.index, 0, ops.argument, node);
                read.value_storage = binding.storage;
                read.value_container = binding.container;
                read.value_record = binding.record;
                code = array_add(code, read);
            }
            root: Root = {slot: at.slot + length(slots) - 1, storage: binding.storage, container: binding.container,
                record: binding.record};
            roots = array_add(roots, root);
        }
        produced = Typed(at.slot + length(slots) - 1, binding.storage, binding.container, binding.record);
    } else if (kind == "parenthesized_expression") {
        next = array_add(next, Expect(Field(forest, item.node, "expression"), item.storage, item.container, item.record));
    } else if (item.phase == 0) {
        next = array_add(next, Visit(Field(forest, item.node, "object")));
        if (kind == "index_expression") { next = array_add(next, Visit(Field(forest, item.node, "index"))); }
        next = array_add(next, Resume(item.node, 1, 0, 0));
    } else if (kind == "member_expression") {
        popped = 1;
        object := values[top - 1];
        member := NameText(forest, text, Field(forest, item.node, "member"));
        if (member == "") { return Fail(forest, Field(forest, item.node, "member"), document, "Invalid string or embedded NUL"); }
        found := -1;
        if (Single(object, StructStorage)) { found = FindField(records, fields, object.record, member); }
        if (found < 0) { return Fail(forest, item.node, document, format_text("Unknown field '{}'", member)); }
        field := fields[found];
        slot: Slot = {storage: field.storage, kind: ValueKind};
        slots = array_add(slots, slot);
        read := Instruction(ops.load, field.storage, at.slot, object.slot, 0, 0, node);
        read.offset = field.offset;
        code = array_add(code, read);
        produced = Typed(at.slot, field.storage, 0, -1);
    } else {
        popped = 2;
        array := values[top - 2];
        position := values[top - 1];
        if (array.container != ArrayContainer) {
            return Fail(forest, Field(forest, item.node, "object"), document, "indexing needs an array");
        }
        if (!Single(position, IntStorage)) { return Fail(forest, Field(forest, item.node, "index"), document, "index needs an int"); }
        slots = ElementSlots(array.storage, target);
        code = ElementRead(array.slot, position.slot, array.storage, at.slot, ops, target, node);
        if (array.storage == StructStorage) {
            root: Root = {slot: at.slot + 6, storage: StructStorage, container: 0, record: array.record};
            roots = array_add(roots, root);
        }
        produced = Typed(at.slot + 6, array.storage, 0, array.record);
    }
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, popped, produced, NoValue(), marks);
}

// Struct and array literals, built by the construct intrinsic: the value's
// header, then each array item, or each field as an offset cell and a value
// cell; it returns the new value.
LiteralStep :: pure fn(forest: snapshot.SnapshotNode[], text: string, document: int, records: Record[],
                       fields: RecordField[], values: Value[], top: int, item: Work, ops: Ops, target: Target,
                       at: Bases) -> Step {
    node := forest[item.node];
    array := node.kind == "array_expression";
    code: Code[] = [];
    slots: Slot[] = [];
    locals: int[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    if (array && item.container != ArrayContainer) {
        return Fail(forest, item.node, document, "Array literal needs an explicit array type");
    }
    if (!array && (item.storage != StructStorage || item.container != 0)) {
        return Fail(forest, item.node, document, "Struct literal needs an explicit record type");
    }
    record := item.record;
    if (item.phase == 0) {
        count: int = 0;
        member := FirstMember(forest, item.node);
        while (member >= 0) {
            if (array) {
                next = array_add(next, Expect(member, item.storage, 0, record));
            } else {
                name := NameText(forest, text, Field(forest, member, "name"));
                if (name == "") { return Fail(forest, Field(forest, member, "name"), document, "Invalid string or embedded NUL"); }
                if (FindField(records, fields, record, name) < 0) {
                    return Fail(forest, member, document, format_text("Unknown field '{}'", name));
                }
                earlier := FirstMember(forest, item.node);
                while (earlier != member) {
                    if (NameText(forest, text, Field(forest, earlier, "name")) == name) {
                        return Fail(forest, member, document, format_text("Duplicate literal member '{}'", name));
                    }
                    earlier = NextMember(forest, earlier);
                }
                next = array_add(next, Visit(Field(forest, member, "value")));
            }
            count += 1;
            member = NextMember(forest, member);
        }
        if (!array && count != records[record].count) {
            return Fail(forest, item.node, document, "Struct literal needs every field");
        }
        rest := Expect(item.node, item.storage, item.container, record);
        rest.phase = 1;
        rest.a = count;
        next = array_add(next, rest);
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, NoValue(), NoValue(), marks);
    }
    header: Cell = {storage: item.storage, container: item.container, record: record, offset: 0, kind: ValueKind};
    cells = array_add(cells, header);
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    member := FirstMember(forest, item.node);
    index: int = 0;
    while (member >= 0) {
        value := values[top - item.a + index];
        if (array && !SameType(item.storage, 0, record, value)) {
            return Fail(forest, member, document, "array item differs from the array's type");
        }
        if (!array) {
            field := fields[FindField(records, fields, record, NameText(forest, text, Field(forest, member, "name")))];
            if (!SameType(field.storage, 0, -1, value)) {
                return Fail(forest, member, document, "field value differs from its type");
            }
            offset: Cell = {storage: WordStorage, container: 0, record: -1, offset: field.offset, kind: ValueKind};
            cells = array_add(cells, offset);
        }
        content: Cell = {storage: value.storage, container: 0, record: value.record, offset: 0, kind: ValueKind};
        cells = array_add(cells, content);
        slots = array_add(slots, address);
        code = array_add(code, Instruction(ops.host_slot, target.pointer_storage, at.slot + length(slots) - 1,
            at.cell + length(cells) - 1, 0, 0, forest[member]));
        write := Instruction(ops.write, SlotStorage(value.storage, 0, target), 0, value.slot,
            at.slot + length(slots) - 1, 0, forest[member]);
        write.offset = target.payload_offset;
        code = array_add(code, write);
        index += 1;
        member = NextMember(forest, member);
    }
    cells = array_add(cells, header);
    host: Host = {intrinsic: ConstructIntrinsic, linked: -1, first: at.cell, result_first: at.cell + length(cells) - 1,
        result_count: 1};
    hosts = array_add(hosts, host);
    code = array_add(code, Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, node));
    slots = array_add(slots, address);
    code = array_add(code, Instruction(ops.host_slot, target.pointer_storage, at.slot + length(slots) - 1,
        at.cell + length(cells) - 1, 0, 0, node));
    slots = array_add(slots, address);
    made := at.slot + length(slots) - 1;
    load := Instruction(ops.load, target.pointer_storage, made, made - 1, 0, 0, node);
    load.offset = target.payload_offset;
    code = array_add(code, load);
    root: Root = {slot: made, storage: item.storage, container: item.container, record: record};
    roots = array_add(roots, root);
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, item.a,
        Typed(made, item.storage, item.container, record), NoValue(), marks);
}

// Calls of the package's functions and of natives. Arguments go to fresh data
// cells and the result comes back in one. A native's inferred ports all take
// the one type its arguments give them.
CallStep :: pure fn(forest: snapshot.SnapshotNode[], text: string, document: int, callables: Callable[],
                    params: Param[], natives: Native[], ports: Port[], values: Value[], top: int, item: Work,
                    ops: Ops, target: Target, at: Bases) -> Step {
    node := forest[item.node];
    code: Code[] = [];
    slots: Slot[] = [];
    locals: int[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    if (item.phase == 0) {
        callee := Field(forest, item.node, "function");
        if (!Is(forest, callee, "identifier")) { return Fail(forest, callee, document, "call needs a function name"); }
        callee_name := Text(forest, text, callee);
        found := FindCallable(callables, callee_name);
        native := -1;
        expected_count: int = 0;
        if (found >= 0) {
            expected_count = callables[found].count;
        } else {
            native = FindNative(natives, callee_name);
            if (native == -2) { return Fail(forest, callee, document, format_text("Ambiguous function '{}'", callee_name)); }
            if (native < 0) { return Fail(forest, callee, document, format_text("Unknown function '{}'", callee_name)); }
            called := natives[native];
            supported := !called.variadic && called.results <= 1;
            port := called.first;
            while (port < called.first + called.parameters + called.results) {
                if (ports[port].storage < 0) { supported = false; }
                port += 1;
            }
            if (!supported) { return Fail(forest, callee, document, format_text("native '{}' is not supported yet", callee_name)); }
            expected_count = called.parameters;
        }
        count: int = 0;
        argument := FirstMember(forest, Field(forest, item.node, "arguments"));
        while (argument >= 0) {
            expected := Visit(argument);
            if (found >= 0 && count < expected_count) {
                param := params[callables[found].first + count];
                expected = Expect(argument, param.storage, param.container, param.record);
            } else if (native >= 0 && count < expected_count && ports[natives[native].first + count].storage > 0) {
                port := ports[natives[native].first + count];
                expected = Expect(argument, port.storage, port.container, -1);
            }
            next = array_add(next, expected);
            count += 1;
            argument = NextMember(forest, argument);
        }
        if (count != expected_count) { return Fail(forest, item.node, document, "call has the wrong number of arguments"); }
        finish := Resume(item.node, 1, found, count);
        if (native >= 0) {
            finish.a = native;
            finish.c = 1;
        }
        next = array_add(next, finish);
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, NoValue(), NoValue(), marks);
    }
    linked := item.c == 1;
    count := item.b;
    first := top - count;
    inferred := NoValue();
    first_port: int = 0;
    if (linked) { first_port = natives[item.a].first; }
    index: int = 0;
    while (index < count) {
        argument := values[first + index];
        expected := NoValue();
        if (linked) {
            port := ports[first_port + index];
            expected = Typed(-1, port.storage, port.container, -1);
            if (port.storage == 0) {
                element := Typed(-1, argument.storage, 0, argument.record);
                if (argument.storage <= 0 || argument.container != port.container ||
                    (inferred.storage != 0 && !SameType(inferred.storage, 0, inferred.record, element))) {
                    return Fail(forest, item.node, document, "argument differs from its parameter type");
                }
                inferred = element;
                expected = Typed(-1, element.storage, port.container, element.record);
            }
        } else {
            param := params[callables[item.a].first + index];
            expected = Typed(-1, param.storage, param.container, param.record);
        }
        if (!SameType(expected.storage, expected.container, expected.record, argument)) {
            return Fail(forest, item.node, document, "argument differs from its parameter type");
        }
        cell: Cell = {storage: argument.storage, container: argument.container, record: argument.record, offset: 0,
            kind: ValueKind};
        cells = array_add(cells, cell);
        index += 1;
    }
    result := Typed(-1, -1, 0, -1);
    result_count: int = 0;
    if (linked && natives[item.a].results == 1) {
        port := ports[first_port + count];
        result = Typed(-1, port.storage, port.container, -1);
        if (port.storage == 0) {
            if (inferred.storage == 0) { return Fail(forest, item.node, document, "native result type is not known"); }
            result = Typed(-1, inferred.storage, port.container, inferred.record);
        }
        result_count = 1;
    } else if (!linked && callables[item.a].result != 0) {
        called := callables[item.a];
        result = Typed(-1, called.result, called.result_container, called.result_record);
        result_count = 1;
    }
    if (result_count == 1) {
        cell: Cell = {storage: result.storage, container: result.container, record: result.record, offset: 0,
            kind: ValueKind};
        cells = array_add(cells, cell);
    }
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    index = 0;
    while (index < count) {
        argument := values[first + index];
        slots = array_add(slots, address);
        code = array_add(code, Instruction(ops.host_slot, target.pointer_storage, at.slot + index, at.cell + index, 0, 0, node));
        write := Instruction(ops.write, SlotStorage(argument.storage, argument.container, target), 0, argument.slot,
            at.slot + index, 0, node);
        write.offset = target.payload_offset;
        code = array_add(code, write);
        index += 1;
    }
    if (linked) {
        host: Host = {intrinsic: 0, linked: item.a, first: at.cell, result_first: at.cell + count,
            result_count: result_count};
        hosts = array_add(hosts, host);
        code = array_add(code, Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, node));
    } else {
        invocation: Invocation = {callee: item.a, first: at.cell, count: count, result_first: at.cell + count,
            result_count: result_count};
        calls = array_add(calls, invocation);
        // Each invocation suspends the caller once; its index is its order.
        code = array_add(code, Instruction(ops.invoke, 0, 0, at.call, 0, at.call, node));
    }
    if (result_count == 1) {
        slots = array_add(slots, address);
        code = array_add(code, Instruction(ops.host_slot, target.pointer_storage, at.slot + count, at.cell + count, 0, 0, node));
        loaded: Slot = {storage: SlotStorage(result.storage, result.container, target),
            kind: SlotKind(result.storage, result.container)};
        slots = array_add(slots, loaded);
        read := Instruction(ops.load, loaded.storage, at.slot + count + 1, at.slot + count, 0, 0, node);
        read.offset = target.payload_offset;
        code = array_add(code, read);
        if (Pointer(result.storage, result.container)) {
            root: Root = {slot: at.slot + count + 1, storage: result.storage, container: result.container,
                record: result.record};
            roots = array_add(roots, root);
        }
        result.slot = at.slot + count + 1;
    }
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, count, result, NoValue(), marks);
}

// Unary operators and the binary operators other than logic.
OperatorStep :: pure fn(forest: snapshot.SnapshotNode[], text: string, document: int, values: Value[], top: int,
                        item: Work, ops: Ops, at: Bases) -> Step {
    node := forest[item.node];
    unary := node.kind == "unary_expression";
    code: Code[] = [];
    slots: Slot[] = [];
    locals: int[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    marks: int[] = [];
    if (item.phase == 0) {
        if (unary) {
            next = array_add(next, Visit(Field(forest, item.node, "operand")));
        } else {
            next = array_add(next, Visit(Field(forest, item.node, "left")));
            next = array_add(next, Visit(Field(forest, item.node, "right")));
        }
        next = array_add(next, Resume(item.node, 1, 0, 0));
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0, NoValue(), NoValue(), marks);
    }
    operator := Text(forest, text, Field(forest, item.node, "operator"));
    storage := IntStorage;
    op := -1;
    operand_storage := IntStorage;
    left_slot := -1;
    right_slot := -1;
    popped: int = 2;
    flag: Slot = {storage: BoolStorage, kind: ValueKind};
    if (unary) {
        popped = 1;
        operand := values[top - 1];
        left_slot = operand.slot;
        operand_storage = operand.storage;
        storage = operand.storage;
        if (operator == "-" && Single(operand, IntStorage)) {
            op = ops.neg;
        } else if (operator == "~" && Single(operand, IntStorage)) {
            op = ops.bit_not;
        } else if ((operator == "!" || operator == "not") && Single(operand, BoolStorage)) {
            // Not is equality with false.
            slots = array_add(slots, flag);
            constant := Instruction(ops.constant, BoolStorage, at.slot, 0, 0, 0, node);
            constant.value_storage = BoolStorage;
            code = array_add(code, constant);
            right_slot = at.slot;
            op = ops.eq;
        } else if (operator == "+" && Single(operand, IntStorage)) {
            op = -2;
        } else {
            return Fail(forest, item.node, document, "operator does not apply to this operand");
        }
    } else {
        left := values[top - 2];
        right := values[top - 1];
        op = BinaryOp(ops, operator);
        left_slot = left.slot;
        right_slot = right.slot;
        operand_storage = left.storage;
        storage = left.storage;
        integral := Single(left, IntStorage) && Single(right, IntStorage);
        equality := op == ops.eq || op == ops.ne;
        same := Single(right, left.storage) && (Single(left, IntStorage) || Single(left, BoolStorage) ||
                                                Single(left, TextStorage));
        if (op < 0 || (!integral && !(equality && same))) {
            return Fail(forest, item.node, document, "operator does not apply to these operands");
        }
        if (Comparison(ops, op)) { storage = BoolStorage; }
        if (equality && left.storage == TextStorage) {
            // Strings compare by content; inequality negates it.
            slots = array_add(slots, flag);
            code = array_add(code, Instruction(ops.string_equal, BoolStorage, at.slot, left_slot, right_slot, 0, node));
            left_slot = at.slot;
            operand_storage = BoolStorage;
            if (op == ops.eq) {
                op = -2;
            } else {
                slots = array_add(slots, flag);
                constant := Instruction(ops.constant, BoolStorage, at.slot + 1, 0, 0, 0, node);
                constant.value_storage = BoolStorage;
                code = array_add(code, constant);
                right_slot = at.slot + 1;
                op = ops.eq;
            }
        }
    }
    if (op == -2) {
        return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, popped,
            Typed(left_slot, storage, 0, -1), NoValue(), marks);
    }
    slot: Slot = {storage: storage, kind: ValueKind};
    slots = array_add(slots, slot);
    output := at.slot + length(slots) - 1;
    operation := Instruction(op, operand_storage, output, left_slot, right_slot, -1, node);
    if (op == ops.neg || op == ops.bit_not) {
        operation.right = 0;
        operation.target = 0;
    }
    code = array_add(code, operation);
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, popped,
        Typed(output, storage, 0, -1), NoValue(), marks);
}

// The head of a foreach loop over the copy in the last cell: an index local
// set to zero, then at `head` the bound check, the exit jump and the element
// load. Marks report the head, the exit jump and the index local.
ForeachStep :: pure fn(array: Value, ops: Ops, target: Target, at: Bases, node: snapshot.SnapshotNode) -> Step {
    code: Code[] = [];
    slots: Slot[] = [];
    locals: int[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    roots: Root[] = [];
    calls: Invocation[] = [];
    bound: Name[] = [];
    next: Work[] = [];
    number: Slot = {storage: IntStorage, kind: ValueKind};
    flag: Slot = {storage: BoolStorage, kind: ValueKind};
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    slots = array_add(slots, number);
    constant := Instruction(ops.constant, IntStorage, at.slot, 0, 0, 0, node);
    constant.value_storage = IntStorage;
    code = array_add(code, constant);
    locals = array_add(locals, IntStorage);
    code = array_add(code, Instruction(ops.save, IntStorage, 0, at.slot, 0, at.local, node));
    head := at.pc + length(code);
    code = array_add(code, Instruction(ops.check, 0, 0, 0, 0, 0, node));
    slots = array_add(slots, address);
    code = array_add(code, Instruction(ops.host_slot, target.pointer_storage, at.slot + 1, at.cell - 1, 0, 0, node));
    slots = array_add(slots, address);
    load := Instruction(ops.load, target.pointer_storage, at.slot + 2, at.slot + 1, 0, 0, node);
    load.offset = target.payload_offset;
    code = array_add(code, load);
    root: Root = {slot: at.slot + 2, storage: array.storage, container: ArrayContainer, record: array.record};
    roots = array_add(roots, root);
    code = array_add(code, Instruction(ops.guard, 0, 0, at.slot + 2, 0, target.argument_failure, node));
    slots = array_add(slots, number);
    count := Instruction(ops.load, IntStorage, at.slot + 3, at.slot + 2, 0, 0, node);
    count.offset = target.count_offset;
    code = array_add(code, count);
    slots = array_add(slots, number);
    code = array_add(code, Instruction(ops.local, IntStorage, at.slot + 4, at.local, 0, 0, node));
    slots = array_add(slots, flag);
    code = array_add(code, Instruction(ops.lt, IntStorage, at.slot + 5, at.slot + 4, at.slot + 3, -1, node));
    code = array_add(code, Instruction(ops.branch_if, 0, 0, at.slot + 5, 0, at.pc + length(code) + 2, node));
    leave := at.pc + length(code);
    code = array_add(code, Instruction(ops.jump, 0, 0, 0, 0, Pending, node));
    // The index is below the count, so the element needs no check.
    slots = array_add(slots, address);
    items := Instruction(ops.load, target.pointer_storage, at.slot + 6, at.slot + 2, 0, 0, node);
    items.offset = target.items_offset;
    code = array_add(code, items);
    element_address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    slots = array_add(slots, element_address);
    indexed := Instruction(ops.index, target.pointer_storage, at.slot + 7, at.slot + 6, at.slot + 4, 0, node);
    indexed.offset = target.value_size;
    code = array_add(code, indexed);
    element: Slot = {storage: SlotStorage(array.storage, 0, target), kind: SlotKind(array.storage, 0)};
    slots = array_add(slots, element);
    read := Instruction(ops.load, element.storage, at.slot + 8, at.slot + 7, 0, 0, node);
    read.offset = target.payload_offset;
    code = array_add(code, read);
    if (array.storage == StructStorage) {
        element_root: Root = {slot: at.slot + 8, storage: StructStorage, container: 0, record: array.record};
        roots = array_add(roots, element_root);
    }
    marks: int[] = [head, leave, at.local];
    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, 0,
        Typed(at.slot + 8, array.storage, 0, array.record), NoValue(), marks);
}
