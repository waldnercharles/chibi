@test
AcceptsABodyAfterADereferenceAndALineBreak :: () {
    Accepts("package p\n\nF :: (p: ^bool) -> int {\n    if p^ {}\n    return 8\n}\n");
}

// The field and kind of every node of a parsed source, as "field:kind", in tree order.
Shape :: (text: string) -> string[] {
    shape: string[] = [];
    switch parser.Parse(text) {
        case .Parsed(nodes, fields, is_named, is_extra, root):
            index: int = 0;
            while (index < length(nodes)) {
                shape.append(format_text("{}:{}", syntax.FieldNames()[fields[index]], parser.KindName(nodes[index].kind)));
                index += 1;
            }
        case .Rejected(diagnostic):
            assert(false, "the source parses");
    }
    return shape;
}

@test
KindsFollowTokens :: () {
    // A token leaf's kind is its token's, so node kinds start past the tokens.
    assert(syntax.Comment >= tk.KindCount, "node kinds follow the token kinds");
    assert(length(syntax.KindNames()) == syntax.KindCount - syntax.Comment, "every node kind has a name");
    assert(length(syntax.FieldNames()) == syntax.FieldCount, "every field has a name");
}

@test
KindNamesMatchTheirConstants :: () {
    // The first and last kind of each group, the renamed words, and tokens.
    kinds := [tk.OpenParen, tk.Plain, syntax.Comment, syntax.QueryGenerator, syntax.CallableBody,
              syntax.YieldStatement, syntax.Type, syntax.ParenthesizedType, syntax.SourceFile,
              syntax.ExitDeclaration, syntax.Fn, syntax.Error];
    names := ["(", "plain", "comment", "query_generator", "callable_body", "yield_statement", "type",
              "parenthesized_type", "source_file", "exit_declaration", "fn", "ERROR"];
    index: int = 0;
    while (index < length(kinds)) {
        assert(parser.KindName(kinds[index]) == names[index], "a kind's name");
        index += 1;
    }
    assert(syntax.FieldNames()[syntax.FieldAlias] == "alias" && syntax.FieldNames()[syntax.FieldVisibility] == "visibility",
           "a field's name");
}

@test
ReadsRenamedWords :: () {
    text := "package p\n\nwhen A {\n}\n\nF :: (v: view int[], s: self Thing) {\n    reduce min(t, v)\n    reduce max(t, v)\n}\n";
    shape := Shape(text);
    Has(shape, ":when");
    Has(shape, "trait:view");
    Has(shape, "trait:self");
    Has(shape, "operator:min");
    Has(shape, "operator:max");
}

@test
RejectionKeepsTheDiagnosticRowsBytes :: () {
    // A long found token is cut to the 191 bytes a diagnostic row holds.
    text := format_text("package p\n\nF :: () {{\n    a := 1 \"{}\"\n}}\n", strings.Repeat("x", 300));
    switch parser.Parse(text) {
        case .Parsed(nodes, fields, is_named, is_extra, root):
            assert(false, "the source is rejected");
        case .Rejected(diagnostic):
            assert(strings.ByteLength(diagnostic.message) == 191, "the message is cut");
            assert(strings.HasPrefix(diagnostic.message, "Expected the end of the statement, found `\"xxx"),
                   "the message says what was expected and found");
    }
}

Has :: (shape: string[], item: string) {
    found := false;
    for (row in shape) {
        if (row == item) {
            found = true;
        }
    }
    assert(found, "the shape holds the expected node");
}

Lacks :: (shape: string[], item: string) {
    for (row in shape) {
        assert(row != item, "the shape lacks the unexpected node");
    }
}

@test
ReadsCallableParameterType :: () {
    text := "package p\n\nApply :: (value: int, transform: fn(value: int) -> int) -> int {\n    return transform(value)\n}\n";
    Accepts(text);
    shape := Shape(text);
    Has(shape, ":callable_type");
    Has(shape, ":fn");
    Has(shape, "parameters:parameter_list");
}

@test
ReadsInlineFunctionWithArrow :: () {
    text := "package p\n\nF :: (limit: int) -> int {\n    return Apply(3, (value: int) => value > limit)\n}\n";
    Accepts(text);
    shape := Shape(text);
    Has(shape, ":lambda_expression");
    Has(shape, "body:callable_body");
    Has(shape, ":=>");
    Has(shape, "value:binary_expression");
}

@test
ReadsInlineFunctionWithBlock :: () {
    text := "package p\n\nF :: () -> int {\n    return Apply(4, (value: int) { return value * 2 })\n}\n";
    Accepts(text);
    Has(Shape(text), ":lambda_expression");
}

@test
ReadsInlineFunctionWithFnAndResult :: () {
    text := "package p\n\nF :: () -> int {\n    return Apply(4, fn(value: int) -> int { return value * 2 })\n}\n";
    Accepts(text);
    shape := Shape(text);
    Has(shape, ":lambda_expression");
    Has(shape, ":fn");
}

@test
ReadsFnAsAName :: () {
    text := "package p\n\nF :: (x: int) -> int {\n    return fn(x)\n}\n";
    Accepts(text);
    shape := Shape(text);
    Has(shape, "value:call_expression");
    Lacks(shape, ":lambda_expression");
}

@test
ReadsDereferenceAsCondition :: () {
    text := "package p\n\nF :: (p: ^bool) -> int {\n    if p^ {\n        return 1\n    }\n    return 0\n}\n";
    Accepts(text);
    Has(Shape(text), "condition:dereference_expression");
}
