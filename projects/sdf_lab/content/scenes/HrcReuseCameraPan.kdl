version 1
name "HrcReuseCameraPan"
(array)entities {
    - {
        name "Camera"
        prototype "SdfOptimizationCamera"
        components {
            GameTransform x=0.0 y=0.0
            GameCamera width=620.0 height=400.0 focal_distance=0.0
            GameHRC2D surface_shadow_mode="Horizon8" ambient=0.08 fog=0.02 bounce_intensity=0.12
        }
        (array)behaviors "HrcReuseCameraPan"
    }
    - {
        name "West cyan"
        prototype "SdfLight"
        components {
            GameTransform x=-240.0 y=0.0
            GameMaterial emission_color=0x38d9edff
        }
    }
    - {
        name "East amber"
        prototype "SdfLight"
        components {
            GameTransform x=240.0 y=0.0
            GameMaterial emission_color=0xffac54ff
        }
    }
    - {
        name "Receiver 1"
        prototype "SdfHorizonCanopy"
        components {
            GameTransform x=-360.0 y=0.0
            GameVisualTransform scale=0.8
            GameShader material="SdfCyan"
        }
    }
    - {
        name "Receiver 2"
        prototype "SdfHorizonCanopy"
        components {
            GameTransform x=-180.0 y=0.0
            GameVisualTransform scale=0.8
            GameShader material="SdfAmber"
        }
    }
    - {
        name "Receiver 3"
        prototype "SdfHorizonCanopy"
        components {
            GameTransform x=0.0 y=0.0
            GameVisualTransform scale=0.8
            GameShader material="SdfCyan"
        }
    }
    - {
        name "Receiver 4"
        prototype "SdfHorizonCanopy"
        components {
            GameTransform x=180.0 y=0.0
            GameVisualTransform scale=0.8
            GameShader material="SdfAmber"
        }
    }
    - {
        name "Receiver 5"
        prototype "SdfHorizonCanopy"
        components {
            GameTransform x=360.0 y=0.0
            GameVisualTransform scale=0.8
            GameShader material="SdfCyan"
        }
    }
    - {
        name "Raised blocker 1"
        prototype "SdfRoundedBox"
        components {
            GameTransform x=-300.0 y=0.0
            GameVisualTransform scale=0.4
            GameGeometry3D elevation=35.0
        }
    }
    - {
        name "Raised blocker 2"
        prototype "SdfRoundedBox"
        components {
            GameTransform x=-100.0 y=0.0
            GameVisualTransform scale=0.4
            GameGeometry3D elevation=35.0
        }
    }
    - {
        name "Raised blocker 3"
        prototype "SdfRoundedBox"
        components {
            GameTransform x=100.0 y=0.0
            GameVisualTransform scale=0.4
            GameGeometry3D elevation=35.0
        }
    }
    - {
        name "Raised blocker 4"
        prototype "SdfRoundedBox"
        components {
            GameTransform x=300.0 y=0.0
            GameVisualTransform scale=0.4
            GameGeometry3D elevation=35.0
        }
    }
}
