package package_compiler

import snapshot "project:source_snapshot"
import raw "project:compiler_syntax"
import graph "project:package_graph"
import syntax "project:syntax_diagnostics"
import binding "project:lexical_binding"
import writer "project:prepared_writer"
import json "project:json_string"
import strings "core:strings"
import tk "project:source_tokenizer"

// Compiles a behavior asset to the prepared module of the game a target
// describes: its retained states, and its event handlers, which read and
// write those states and write fields of the owner's components. Its module,
// states and handlers take the IDs stage zero gives them.

// An event the game declares; its payload is event_fields[first, first + count).
pub GameEvent :: struct {
    name: string;
    id: u64;
    abi: u64;
    first: int;
    count: int;
}
pub GameEventField :: struct {
    name: string;
    storage: int;
    nominal: u64;
    has_default: bool;
    default_owner: bool;
}
// A type the game links, a component when `component` is its component ID;
// its fields are type_fields[first, first + count). A module requires every
// type but a namespace, such as SceneGlobals; types[underlying], when that is
// not -1, is the type it stands for.
pub GameType :: struct {
    required: bool;
    underlying: int;
    name: string;
    id: u64;
    layout: u64;
    storage: int;
    size: int;
    component: u64;
    first: int;
    count: int;
    relationship: bool;
    traits: int;
    error: bool;
}
// A game type's field: of the type types[record] when that is not -1; a
// constant whose value is its name; read by natives[read] when that is not
// -1, with the key `read_key` instead of the value when that is not "".
pub GameField :: struct {
    name: string;
    storage: int;
    offset: int;
    writable: bool;
    c_string: bool;
    record: int;
    constant: bool;
    read: int;
    read_key: string;
}
// A native that makes a record of type types[record] of its arguments;
// argument i gives the record's field make_fields[first + i].
pub NativeMake :: struct {
    native: int;
    record: int;
    first: int;
}
// A name the game binds in every behavior, of the type types[record] when
// that is not -1.
pub GameGlobal :: struct {
    name: string;
    storage: int;
    record: int;
}
// A native that combines numbers, and records of them field by field, for a
// binary operator: natives[native].
pub NumericOperator :: struct {
    native: int;
    operator: int;
}
// A behavior's retained state, with its nominal type and initial value.
StateDecl :: struct {
    name: string;
    id: u64;
    storage: int;
    record: int;
    bits: u64;
    text: string;
    node: int;
}
// State rows and every function's variable defaults retain the same header.
StateValue :: (kept: StateDecl, types: TypeDecl[], layouts: int[], wide: int) -> writer.Value {
    value := Header(kept.storage, 0, kept.record, types, layouts);
    value.wide = wide;
    value.text = kept.text;
    value.has_text = kept.storage == TextStorage;
    return value;
}
// What a module holds beyond its functions. A behavior's functions keep its
// states, and handled[i] is the event function i handles, -1 for none; its
// operators may combine records, and its globals are names.
Game :: union {
    Package
    | Library(entity: u64, operators: NumericOperator[], globals: GameGlobal[], makes: NativeMake[],
              make_fields: int[])
    | Behavior(kept: StateDecl[], handled: int[], declared: GameEvent[], payloads: GameEventField[],
               entity: u64, operators: NumericOperator[], globals: GameGlobal[], makes: NativeMake[],
               make_fields: int[])
}
// Prepared function kinds.
HandlerFunction: int : 1;
// The reference kind of a component field, as the reference intrinsics take it.
ComponentReference: int : 2;
// Effects a handler declares.
ReadEffect: int : 1;
WriteEffect: int : 2;
InvocationReadEffect: int : 64;

// The component of each component reference a body makes, or, when
// `written`, of each it writes through.
ComponentsOf :: (cells: Cell[], hosts: Host[], written: bool) -> u64[] {
    found: u64[] = [];
    for (host in hosts) {
        if (host.intrinsic == ReferenceMakeIntrinsic && cells[host.first + 2].constant == u64(ComponentReference) &&
            (host.written || !written)) {
            found.append(cells[host.first + 6].constant);
        }
    }
    return found;
}
// Each of `items` once, in order.
Distinct :: (items: u64[]) -> u64[] {
    kept: u64[] = [];
    for (item in items) {
        seen := false;
        for (known in kept) {
            if (known == item) {
                seen = true;
            }
        }
        if (!seen) {
            kept.append(item);
        }
    }
    return kept;
}
// A handler's effects, as stage zero's analysis gives them: reading a state
// reads what the invocation retains, storing one also reads it and writes,
// reading a component reads, and writing one reads and writes.
Effects :: (ops: Ops, code: Code[], reads_components: bool, writes_components: bool) -> int {
    effects: int = 0;
    if (reads_components) {
        effects = ReadEffect;
    }
    if (writes_components) {
        effects = ReadEffect | WriteEffect;
    }
    for (instruction in code) {
        if (instruction.op == ops.variable) {
            effects = effects | ReadEffect | InvocationReadEffect;
        } else if (instruction.op == ops.store || instruction.op == ops.store_value) {
            effects = effects | ReadEffect | InvocationReadEffect | WriteEffect;
        }
    }
    return effects;
}
// The game's types as shared native declarations, in order, a
// namespace as one no module requires; their fields are members, and a
// native type's parent is its underlying type.
NativeTypes :: (types: GameType[]) -> TypeDecl[] {
    declared: TypeDecl[] = [];
    for (linked in types) {
        kind := NativeDecl;
        if (!linked.required) {
            kind = NamespaceDecl;
        }
        row: TypeDecl = {name: linked.name, type_name: linked.name, package: -1, node: -1, kind: kind,
                         first: linked.first, count: linked.count, size: linked.size, parent: linked.underlying,
                         storage: linked.storage, id: linked.id, layout: linked.layout, component: linked.component,
                         key: linked.traits, value_storage: 0, value_container: 0, value_record: -1, error: linked.error};
        declared.append(row);
    }
    return declared;
}
NativeFields :: (type_fields: GameField[]) -> TypeMember[] {
    fields: TypeMember[] = [];
    for (linked in type_fields) {
        row: TypeMember = {name: linked.name, storage: linked.storage, container: 0, record: linked.record,
                           offset: linked.offset, writable: linked.writable, c_string: linked.c_string, constant: linked.constant,
                           read: linked.read, read_key: linked.read_key, fixed: false};
        fields.append(row);
    }
    return fields;
}
// A handler's payload parameters, or why the handler cannot take them.
Payload :: union {
    Failed(diagnostic: syntax.Diagnostic) | Bound(params: Param[])
}
// A number or one signed number. Unary plus keeps its operand's value;
// minus stays attached for the literal readers. Other unary operators are
// expressions, not numeric literal defaults.
StateNumberNode :: (forest: snapshot.SnapshotNode[], source: string, node: int) -> int {
    if (Is(forest, node, syntax.Number)) {
        return node;
    }
    if (!Is(forest, node, syntax.UnaryExpression)) {
        return -1;
    }
    operand := Field(forest, node, syntax.FieldOperand);
    if (!Is(forest, operand, syntax.Number)) {
        return -1;
    }
    operator := Operator(forest, node);
    if (operator == tk.Add) {
        return operand;
    }
    if (operator == tk.Sub) {
        return node;
    }
    return -1;
}
// A numeric literal's natural storage follows its spelling. Hexadecimal e
// is a digit; only decimal points and exponents select number storage.
StateNumberStorage :: (forest: snapshot.SnapshotNode[], source: string, node: int) -> int {
    digits := node;
    if (Is(forest, node, syntax.UnaryExpression)) {
        digits = Field(forest, node, syntax.FieldOperand);
    }
    spelling := Text(forest, source, digits);
    hexadecimal := strings.ByteLength(spelling) > 1 && strings.ByteAt(spelling, 0) == 48 &&
                   (strings.ByteAt(spelling, 1) == 120 || strings.ByteAt(spelling, 1) == 88);
    if (!hexadecimal) {
        index: int = 0;
        while (index < strings.ByteLength(spelling)) {
            digit := strings.ByteAt(spelling, index);
            if (digit == 46 || digit == 101 || digit == 69) {
                return FloatStorage;
            }
            index += 1;
        }
    }
    switch ParseNumber(forest, source, node) {
        case .Number(negative, magnitude):
            if (Fits(negative, magnitude, IntStorage)) {
                return IntStorage;
            }
            if (Fits(negative, magnitude, Int64Storage)) {
                return Int64Storage;
            }
        case .Invalid:
            return WordStorage;
    }
    return WordStorage;
}
StateRead :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Read(kept: StateDecl)
}
// The state declaration `member` of the document `document`, whose identity
// is `identity` and `qualifier` (a function's name and a dot, for a retained
// local) before the state's own name.
DeclaredState :: (forest: snapshot.SnapshotNode[], source: string, table: ^(TypeDecl[]), entity: u64, member: int,
                  document: int, identity: string, qualifier: string, ops: Ops) -> StateRead {
    name := Text(forest, source, Field(forest, member, syntax.FieldName));
    declared := StateType(forest, source, table, entity, member);
    if ((!Numeric(declared.storage) && declared.storage != BoolStorage && declared.storage != TextStorage &&
         declared.storage != HandleStorage) || declared.container != 0 ||
        CharType(table^, declared.storage, declared.container, declared.record) ||
        (declared.storage == HandleStorage && declared.record < 0)) {
        return StateRead.Failed(Diagnose(forest, member, document, "state type is not supported yet"));
    }
    bits: u64 = 0;
    initial := "";
    switch StateDefault(forest, source, name, declared.storage, Field(forest, member, syntax.FieldValue), ops) {
        case .Failed(diagnostic):
            return StateRead.Failed(snapshot.Stamp(diagnostic, document));
        case .Read(default_bits, default_text):
            bits = default_bits;
            initial = default_text;
    }
    kept: StateDecl = {name: name, id: binding.ID("symbol", format_text("{}:1:{}{}", identity, qualifier, name)),
                       storage: declared.storage, record: declared.record, bits: bits, text: initial,
                       node: Field(forest, member, syntax.FieldName)};
    return StateRead.Read(kept);
}
// A function's retained locals are states of its package's module, which
// carries every state as a variable of every function, as a behavior's
// functions do. `owners[i]` is the callable that declares `states[i]`, and a
// state's identity is its function's and its own name, so an edit that keeps
// both keeps the state.
Retained :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Read(states: StateDecl[], owners: int[])
}
RetainedLocals :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], callables: Callable[],
                   package_names: string[], table: ^(TypeDecl[]), ops: Ops) -> Retained {
    states: StateDecl[] = [];
    owners: int[] = [];
    for (at in 0..<length(documents)) {
        document := documents[at];
        for (offset in 0..<document.node_count) {
            member := document.node_start + offset;
            if (!Is(forest, member, syntax.StateDeclaration)) {
                continue;
            }
            function := forest[member].parent;
            while (function >= 0 && !Is(forest, function, syntax.FunctionDeclaration)) {
                function = forest[function].parent;
            }
            for (index in 0..<length(callables)) {
                if (function < 0 || callables[index].node != function) {
                    continue;
                }
                name := Text(forest, document.text, Field(forest, member, syntax.FieldName));
                for (position in 0..<length(states)) {
                    if (states[position].name == name && owners[position] == index) {
                        return Retained.Failed(Diagnose(forest, member, at, format_text("Duplicate declaration '{}'", name)));
                    }
                }
                qualifier := format_text("{}.", callables[index].name);
                switch DeclaredState(forest, document.text, table, 0, member, at, package_names[callables[index].owner_package],
                                     qualifier, ops) {
                    case .Failed(diagnostic):
                        return Retained.Failed(diagnostic);
                    case .Read(kept):
                        states.append(kept);
                        owners.append(index);
                }
            }
        }
    }
    return Retained.Read(states, owners);
}
// The retained locals of package `package`'s functions, in module order.
PackageStates :: (states: StateDecl[], owners: int[], callables: Callable[], package: int) -> StateDecl[] {
    kept: StateDecl[] = [];
    for (position in 0..<length(states)) {
        if (callables[owners[position]].owner_package == package) {
            kept.append(states[position]);
        }
    }
    return kept;
}
// The names callable `callable` of package `package` reads its own retained
// locals by, each the variable at its position among the package's states.
RetainedNames :: (states: StateDecl[], owners: int[], callables: Callable[], package: int, callable: int) -> Name[] {
    names: Name[] = [];
    index: int = 0;
    for (position in 0..<length(states)) {
        if (callables[owners[position]].owner_package != package) {
            continue;
        }
        if (owners[position] == callable) {
            kept: Name = {owned: false, name: states[position].name, place: StatePlace, index: index,
                          storage: states[position].storage, container: 0, record: states[position].record,
                          writable: true, node: states[position].node};
            names.append(kept);
        }
        index += 1;
    }
    return names;
}
// The written scalar type, or a literal initializer's natural type.
StateType :: (forest: snapshot.SnapshotNode[], source: string, types: ^(TypeDecl[]), entity: u64,
              member: int) -> ValueType {
    written := Field(forest, member, syntax.FieldType);
    value := Field(forest, member, syntax.FieldValue);
    if (written < 0) {
        if (Is(forest, value, syntax.Boolean)) {
            return {storage: BoolStorage, container: 0, record: -1};
        }
        if (Is(forest, value, syntax.String)) {
            return {storage: TextStorage, container: 0, record: -1};
        }
        literal := StateNumberNode(forest, source, value);
        if (literal >= 0) {
            return {storage: StateNumberStorage(forest, source, literal), container: 0, record: -1};
        }
        return {storage: 0, container: 0, record: -1};
    }
    spelled := Text(forest, source, Field(forest, written, syntax.FieldName));
    if ((spelled == "entity" || spelled == "number") && Field(forest, written, syntax.FieldTrait) < 0 &&
        Field(forest, written, syntax.FieldArguments) < 0 && !HasToken(forest, written, tk.Question) &&
        !HasToken(forest, written, tk.OpenBracket)) {
        if (spelled == "number") {
            return {storage: FloatStorage, container: 0, record: -1};
        }
        return {storage: HandleStorage, container: 0, record: TypeWithId(types^, entity)};
    }
    no_names: Name[] = [];
    return ReadType(forest, source, types, no_names, 0, written);
}
// A scalar state's literal default. Handles also admit an unwritten empty
// value; the other scalar types require an initializer, as stage zero does.
StateDefault :: (forest: snapshot.SnapshotNode[], source: string, name: string, storage: int,
                 value: int, ops: Ops) -> Default {
    if (value < 0) {
        if (storage == HandleStorage) {
            return Default.Read(0, "");
        }
        return Default.Failed({start: 0, end: 0, line: 1, column: 1, document: 0,
                               message: format_text("'{}' requires a default value", name)});
    }
    if (Is(forest, value, syntax.Nil) && Text(forest, source, value) == "null") {
        return Default.Read(0, "");
    }
    literal := StateNumberNode(forest, source, value);
    if (storage == HandleStorage && literal >= 0) {
        switch NumberBits(forest, source, literal) {
            case .Finite(double_bits, float_fits, float_bits):
                if ((double_bits & 0x7fffffffffffffff) == 0) {
                    return Default.Read(0, "");
                }
            case .OutOfRange:
                return Default.Failed(Diagnose(forest, value, 0, "Numeric literal is outside the range of its type"));
        }
        return Default.Failed(Diagnose(forest, value, 0, "entity default requires null or zero"));
    }
    if (storage == BoolStorage && Is(forest, value, syntax.Boolean)) {
        bits: u64 = 0;
        if (Text(forest, source, value) == "true") {
            bits = 1;
        }
        return Default.Read(bits, "");
    }
    if (storage == TextStorage && Is(forest, value, syntax.String)) {
        decoded := json.Value(Text(forest, source, value));
        if (!decoded.valid) {
            return Default.Failed(Diagnose(forest, value, 0, "Invalid string literal"));
        }
        return Default.Read(0, decoded.value);
    }
    if (Floating(storage) && literal >= 0) {
        switch FloatConstantStep(forest, source, 0, Typed(-1, NumberStorage, 0, literal), storage, ops,
                                 NoBases(), forest[value]) {
            case .Failed(diagnostic):
                return Default.Failed(diagnostic);
            case .Emitted(code, slots, locals, cells, hosts, roots, calls, bound, next, popped, result, retained, marks):
                return Default.Read(code[0].payload, "");
        }
    }
    if (Integer(storage)) {
        switch ParseNumber(forest, source, literal) {
            case .Number(negative, magnitude):
                if (Fits(negative, magnitude, storage)) {
                    return Default.Read(Bits(negative, magnitude), "");
                }
                return Default.Failed(Diagnose(forest, value, 0,
                                               format_text("Numeric literal is outside the range of {}",
                                                           TypeName(storage))));
            case .Invalid:
                return Default.Failed(Diagnose(forest, value, 0, "state default needs a literal of its declared type"));
        }
    }
    return Default.Failed(Diagnose(forest, value, 0, "state default needs a literal of its declared type"));
}
// Every source is declared before a body is emitted. Source-owned records
// replace their catalog row in place, preserving nominal indices in fields.
SourceTypes :: union {
    Failed(diagnostic: syntax.Diagnostic) | Read(types: TypeDecl[])
}
SourceMembers :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Read(game: Game, callables: Callable[], params: Param[])
}

// Resolves only reflected native nominal ports. Unsupported ports remain in
// place, so their native indices stay stable and only a use is rejected.
CatalogRecordValid :: (types: TypeDecl[], record: int) -> bool {
    if (record < 0 || record >= length(types)) {
        return false;
    }
    first := types[record];
    at := record;
    depth: int = 0;
    while (depth < length(types)) {
        if (at < 0 || at >= length(types)) {
            return false;
        }
        declared := types[at];
        if ((declared.kind != NativeDecl && declared.kind != MathDecl) || declared.storage != first.storage || declared.size <= 0 ||
            declared.size != first.size || declared.layout != first.layout ||
            (declared.storage == StructStorage && declared.layout == 0)) {
            return false;
        }
        if (declared.parent < 0) {
            return true;
        }
        at = declared.parent;
        depth += 1;
    }
    return false;
}
CatalogPorts :: (ports: CatalogPort[], types: TypeDecl[], entity: u64) -> ResolvedPort[] {
    resolved: ResolvedPort[] = [];
    for (port in ports) {
        record: int = -1;
        storage := port.storage;
        if (port.container < 0 || port.container > ArrayContainer ||
            (storage < UnsupportedPort && storage != AnyPort) || storage > StructStorage) {
            storage = UnsupportedPort;
        }
        if (port.nominal != 0) {
            found := TypeWithId(types, port.nominal);
            duplicate := false;
            if (found >= 0) {
                at := found + 1;
                while (at < length(types)) {
                    duplicate = duplicate || (types[at].id == port.nominal);
                    at += 1;
                }
            }
            valid := found >= 0 && !duplicate && port.container == 0 &&
                     (storage == StructStorage || storage == HandleStorage);
            if (valid) {
                declared := types[found];
                valid = declared.storage == storage && CatalogRecordValid(types, found);
                if (storage == StructStorage) {
                    valid = valid && declared.size > 0 && declared.layout != 0;
                }
            }
            if (valid) {
                record = found;
            } else {
                storage = UnsupportedPort;
            }
        } else if (storage == StructStorage || storage == HandleStorage) {
            storage = UnsupportedPort;
        }
        if (port.default_owner) {
            owner := TypeWithId(types, entity);
            valid := storage == HandleStorage && port.container == 0 && owner >= 0 && record >= 0;
            if (valid) {
                canonical := Canonical(types, owner);
                valid = CatalogRecordValid(types, owner) && canonical >= 0 && canonical == Canonical(types, record);
            }
            if (!valid) {
                storage = UnsupportedPort;
            }
        }
        row: ResolvedPort = {name: port.name, storage: storage, container: port.container,
                             c_string: port.c_string, record: record, has_default: port.has_default,
                             default_owner: port.default_owner, default_supported: port.default_supported,
                             default_bits: port.default_bits, default_text: port.default_text};
        resolved.append(row);
    }
    return resolved;
}
