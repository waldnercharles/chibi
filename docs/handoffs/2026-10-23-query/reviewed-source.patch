+            ((execution_module_function){ .id = 995003,
+                                          .kind = EXECUTION_FUNCTION_AUTHORED,
+                                          .body = function })
+        );
+        prepared_plan->function_count = 1;
+        function = NULL;
+        if (variant) {
+            execution_module_action action = {
+                .id = 995001,
+                .state_kind = variant == 1 ? NATIVE_STATE_NONE : NATIVE_STATE_ONCE
+            };
