version 3
name "Flagstone"
domain "material"
id_counter 15000
description "Sandstone flags 90 units square with sunken grout. Each flag takes its own tint, and Bump turns the grout and grain into shading."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 200
                type "Behavior Expression"
                reference_name "mix(vec3(0.42, 0.29, 0.18), vec3(0.72, 0.53, 0.34), noise((p - fract(p / 90) * 90) / 90, 1.37)) * mix(0.8, 1.0, noise(p, 0.07)) * mix(0.45, 1.0, stone)"
                inputs {
                    p id=201 type="struct" type_name="ShaderVec3"
                    stone id=202 type="float"
                }
                outputs {
                    Result id=250 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 300
                type "Behavior Expression"
                reference_name "stone * 1.5 + noise(p, 0.2) * 0.25"
                inputs {
                    p id=301 type="struct" type_name="ShaderVec3"
                    stone id=302 type="float"
                }
                outputs {
                    Result id=350 type="float"
                }
            }
            - {
                id 400
                type "Behavior Expression"
                reference_name "mix(0.95, 0.55 + noise(p, 0.05) * 0.3, stone)"
                inputs {
                    p id=401 type="struct" type_name="ShaderVec3"
                    stone id=402 type="float"
                }
                outputs {
                    Result id=450 type="float"
                }
            }
            - {
                id 500
                type "Behavior Expression"
                reference_name "smoothstep(0.0, 0.03, min(min(fract(p.x / 90), 1 - fract(p.x / 90)), min(fract(p.z / 90), 1 - fract(p.z / 90))))"
                inputs {
                    p id=501 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=550 type="float"
                }
            }
            - {
                id 1100
                type "Shader Surface Output"
                inputs "Alpha Mode"=1
            }
            - id=2000 type="Shader WorldPosition"
            - {
                id 3000
                type "Shader Bump"
                inputs Distance=0.4
            }
        }
        (array)edges {
            - from="200.Result" to="1100.Base Color"
            - from="300.Result" to="3000.Height"
            - from="400.Result" to="1100.Roughness"
            - from="500.Result" to="200.stone"
            - from="500.Result" to="300.stone"
            - from="500.Result" to="400.stone"
            - from="2000.Value" to="200.p"
            - from="2000.Value" to="300.p"
            - from="2000.Value" to="400.p"
            - from="2000.Value" to="500.p"
            - from="3000.Value" to="1100.Normal"
        }
    }
    - id=10000 kind="function" math_expression="smoothstep(0.0, 0.03, min(min(fract(p.x / 90), 1 - fract(p.x / 90)), min(fract(p.z / 90), 1 - fract(p.z / 90))))" expression_mode=1 entry_id=10001
    - id=11000 kind="function" math_expression="mix(vec3(0.42, 0.29, 0.18), vec3(0.72, 0.53, 0.34), noise((p - fract(p / 90) * 90) / 90, 1.37)) * mix(0.8, 1.0, noise(p, 0.07)) * mix(0.45, 1.0, stone)" expression_mode=1 entry_id=11001
    - id=12000 kind="function" math_expression="stone * 1.5 + noise(p, 0.2) * 0.25" expression_mode=1 entry_id=12001
    - id=13000 kind="function" math_expression="mix(0.95, 0.55 + noise(p, 0.05) * 0.3, stone)" expression_mode=1 entry_id=13001
}
