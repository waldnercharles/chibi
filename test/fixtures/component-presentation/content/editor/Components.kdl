components {
    EngineSystem icon="system"
    Aim tab="Gameplay"
    Appearance {
        icon "shape"
        fields {
            antialias {
                (array)range 0 1
            }
        }
    }
    Body tab="Physics"
    Camera icon="camera"
    Collider {
        tab "Physics"
        fields {
            radius unit="u"
            restitution {
                (array)range 0 1
            }
            friction {
                (array)range 0 1
            }
        }
    }
    Combustion {
        tab "Gameplay"
        fields {
            blast_radius {
                (array)range 0 1024
                unit "u"
            }
        }
    }
    Dash {
        fields {
            speed unit="u/s"
            cooldown unit="s"
        }
    }
    Destructible tab="Physics" icon="diamond"
    Drive {
        tab "Physics"
        fields {
            acceleration unit="u/s²"
        }
    }
    FluidVolume {
        tab "Physics"
        icon "water"
        fields {
            absorption {
                (array)range 0 1
            }
        }
    }
    FragmentGlow tab="Material"
    Fuel tab="Gameplay"
    HRC2D {
        tab "Material"
        icon "light"
        fields {
            resolution {
                (array)range 0.1 1
            }
            target_fps unit="fps"
            min_resolution {
                (array)range 0.1 1
            }
            lighting_margin unit="u"
            bounce_hysteresis {
                (array)range 0 1
            }
            radiance_hysteresis {
                (array)range 0 1
            }
            trace_levels {
                (array)range 1 5
            }
            surface_radius unit="u"
            exposure unit="EV"
            bloom {
                (array)range 0 1
            }
        }
    }
    Health tab="Gameplay" icon="health"
    Input tab="Gameplay" icon="gamepad"
    Material {
        tab "Material"
        fields {
            emission_intensity {
                (array)range 0 4
            }
            absorption {
                (array)range 0 1
            }
            edge_light {
                (array)range 0 1
            }
        }
    }
    MaterialCavity {
        fields {
            radius unit="u"
        }
    }
    Movement {
        tab "Gameplay"
        fields {
            speed unit="u/s"
        }
    }
    ParticleEmitter {
        icon "emitter"
        fields {
            absorption {
                (array)range 0 1
            }
        }
    }
    Pickup {
        fields {
            lifetime unit="s"
        }
    }
    PointLight {
        fields {
            radius unit="u"
        }
    }
    Projectile {
        icon "projectile"
        fields {
            speed unit="u/s"
            lifetime unit="s"
        }
    }
    Reflection tab="Material"
    Starfield2D tab="Material"
    Substance tab="Physics"
    SurfaceInfluence {
        fields {
            radius unit="u"
        }
    }
    Trail {
        fields {
            lifetime unit="s"
        }
    }
    Velocity tab="Physics"
    Vision {
        fields {
            radius unit="u"
        }
    }
    Weapon {
        tab "Gameplay"
        fields {
            cooldown unit="s"
        }
    }
    MaterialBreakProfile tab="Physics"
    MaterialTerrain tab="Material" icon="terrain"
}
