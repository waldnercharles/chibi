InputBehavior :: behavior {
    on Input :: (Direction: struct<CF_V2>) {
        if self.Dash {
            if 0.0 < self.Dash.remaining {
            } else {
                self.Velocity = MovementActions.Movement_Velocity(Direction, self.Movement)
                await Face_Direction(Direction)
            }
        } else {
            self.Velocity = MovementActions.Movement_Velocity(Direction, self.Movement)
            await Face_Direction(Direction)
        }
    }
    Face_Direction :: (Direction: struct<CF_V2> = null) {
        if self.Orientation {
            if 0.0 >= abs(Direction.x) + abs(Direction.y) {
                return
            } else {
                self.Orientation = DirectionMath.Direction_Orientation(Direction.x, Direction.y)
                return
            }
        } else {
            return
        }
    }
}
