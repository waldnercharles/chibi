+    }
+    for (int i = 0; i < authoring_packages_count(call_packages[index]); i++) {
+        const authoring_package *package = authoring_packages_at(call_packages[index], i);
+        if (!strcmp(package->identity, "project:")) {
+            return package;
+        }
