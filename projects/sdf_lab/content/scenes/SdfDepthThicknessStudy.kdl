version 1
name "SdfDepthThicknessStudy"
(array)entities {
    - {
        name "Camera"
        prototype "SdfOptimizationCamera"
        components {
            GameTransform x=0.0 y=0.0
            GameCamera width=520.0 height=340.0 focal_distance=600.0 yaw=0.0 pitch=0.35 roll=0.0 target_elevation=0.0
            GameSurfaceQuality resolution="Full" sdf_normal_mode="Analytic" sdf_pixel_error=0.0 disable_sdf_lod=#true
            GameHRC2D surface_shadow_mode="Horizon8" intensity=3.0 exposure=0.6 resolution=0.5 min_resolution=0.5 adaptive=#false lighting_margin=125.0 surface_mode="Depth thickness" surface_depth_radius=128.0 surface_thickness=12.0 ambient=0.0 fog=0.0 shadow_floor=0.0 bloom=0.0 bounce_intensity=0.0 feedback=#false
        }
    }
    - {
        name "Cyan rounded receiver"
        prototype "SdfRoundedBox"
        components {
            GameTransform x=-65.0 y=-10.0
            GameVisualTransform scale=1.25 pitch=0.2 yaw=0.0 roll=-0.15
            GameGeometry3D elevation=0.0
            GameShader material="SdfCyan"
            GameMaterial emission_intensity=0.0
        }
    }
    - {
        name "Amber curved receiver"
        prototype "SdfTorus"
        components {
            GameTransform x=80.0 y=15.0
            GameVisualTransform scale=1.25 pitch=0.4 yaw=0.0 roll=0.15
            GameGeometry3D elevation=15.0
            GameShader material="SdfAmber"
            GameMaterial emission_intensity=0.0
        }
    }
    - {
        name "Thin elevated mesh blocker"
        prototype "SdfComparisonMesh"
        components {
            GameTransform x=5.0 y=0.0
            GameVisualTransform scale=1.0 pitch=0.0 yaw=0.0 roll=0.0
            GameGeometry3D width=14.0 height=55.0 depth=130.0 elevation=30.0
            GameShader material="SdfRose"
            GameMaterial emission_intensity=0.0
        }
    }
    - {
        name "Cyan source"
        prototype "SdfSphere"
        components {
            GameTransform x=-95.0 y=-25.0
            GameGeometry3D width=64.0 height=64.0 depth=64.0 elevation=100.0
            GameVisualTransform scale=0.4 pitch=0.0 yaw=0.0 roll=0.0
            GameShader shape="SdfSphere" material=""
            GameMaterial scene=0xffffffff albedo=0xffffffff emission_color=0x38d9edff emission_intensity=6.0 emission_multiplier=1.0 absorption=0.0
        }
    }
    - {
        name "Amber source"
        prototype "SdfSphere"
        components {
            GameTransform x=110.0 y=50.0
            GameGeometry3D width=64.0 height=64.0 depth=64.0 elevation=100.0
            GameVisualTransform scale=0.4 pitch=0.0 yaw=0.0 roll=0.0
            GameShader shape="SdfSphere" material=""
            GameMaterial scene=0xffffffff albedo=0xffffffff emission_color=0xffac54ff emission_intensity=6.0 emission_multiplier=1.0 absorption=0.0
        }
    }
}
