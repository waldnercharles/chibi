package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("ClayTerracotta")),
            data.Field.Named("includes", data.List([
                data.Value.Text("ClayNeutral")
            ])),
            data.Field.Named("components", data.Object([
                data.Field.Named("Shader", data.Object([
                    data.Field.Named("parameters", data.Value.Text("package asset\n\nimport data \"game:assets\"\n\npub Build :: () -> byte[] {\n    return data.Encode(\n        data.Object([\n            data.Field.Named(\"material.BaseColor\", data.List([\n                data.Value.Real(0.52),\n                data.Value.Real(0.16),\n                data.Value.Real(0.08)\n            ]))\n        ])\n    );\n}\n"))
                ]))
            ]))
        ])
    );
}
