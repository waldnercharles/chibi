package package_syntax_tests

import extract "project:package_syntax"
import parser "project:source_parser"

// Package headers and imports read from parsed text, from the former C differential
// (package_syntax_chibi.c): the sources and the descriptors the C extractor gave.
Extracted :: (text: string) -> extract.Result {
    switch parser.Parse(text) {
        case .Parsed(nodes, fields, is_named, is_extra, root):
            return extract.Extract(nodes, fields, text, root, 7, "app/a.chibi", "app");
    }
}

@test
HeaderOnly :: () {
    switch Extracted("package demo\n") {
        case .Accepted(file, imports):
            assert(file.name == "demo", "package name");
            assert(file.path == "app/a.chibi" && file.directory == "app", "file path and directory");
            assert(file.header_start == 8 && file.header_end == 12, "header range");
            assert(file.header_line == 1 && file.header_column == 9 && file.header_document == 0, "header position");
            assert(length(imports) == 0, "no imports");
        case .Rejected(diagnostic):
            assert(false, "the header is valid");
    }
}

@test
ImportsWithAndWithoutAlias :: () {
    switch Extracted("package demo\nimport a \"core:strings\"\nimport \"project:other\"\n") {
        case .Accepted(file, imports):
            assert(length(imports) == 2, "two imports");
            first := imports[0];
            assert(first.file == 7 && first.alias == "a" && first.explicit_alias, "first import alias");
            assert(first.range_start == 13 && first.range_end == 36, "first import range");
            assert(first.range_line == 2 && first.range_column == 1, "first import position");
            assert(first.path_start == 22 && first.path_end == 36 && first.path_line == 2 && first.path_column == 10, "first import path");
            assert(first.alias_start == 20 && first.alias_end == 21 && first.alias_line == 2 && first.alias_column == 8, "first import alias range");
            second := imports[1];
            assert(second.alias == "" && !second.explicit_alias, "second import has no alias");
            assert(second.range_start == 37 && second.range_end == 59, "second import range");
            assert(second.path_start == 44 && second.path_end == 59 && second.path_line == 3 && second.path_column == 8, "second import path");
            assert(second.alias_start == 0 && second.alias_end == 0 && second.alias_line == 0 && second.alias_column == 0, "second import alias range is empty");
        case .Rejected(diagnostic):
            assert(false, "the imports are valid");
    }
}

@test
BlankPackageNameIsRejected :: () {
    switch Extracted("package _\n") {
        case .Accepted(file, imports):
            assert(false, "a blank name is rejected");
        case .Rejected(diagnostic):
            assert(diagnostic.message == "A package needs a non-blank name", "blank name message");
            assert(diagnostic.start == 8 && diagnostic.end == 9 && diagnostic.line == 1 && diagnostic.column == 9, "blank name position");
    }
}

@test
MissingPackageHeaderIsRejected :: () {
    switch Extracted("Main :: () {\n}\n") {
        case .Accepted(file, imports):
            assert(false, "a header is required");
        case .Rejected(diagnostic):
            assert(diagnostic.message == "Expected package header", "missing header message");
            assert(diagnostic.line == 1 && diagnostic.column == 1, "missing header position");
    }
}

@test
SyntaxErrorIsReportedFirst :: () {
    switch Extracted("package demo\nimport project:x\n") {
        case .Accepted(file, imports):
            assert(false, "the syntax error is rejected");
        case .Rejected(diagnostic):
            assert(diagnostic.line == 2 && diagnostic.column == 8, "syntax error position");
            assert(diagnostic.message != "", "syntax error message");
    }
}
