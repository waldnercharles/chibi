-    if ((i.op >= BF_ADD && i.op <= BF_DIV) || i.op == BF_NEG || i.op == BF_ABS ||
-        i.op == BF_MIN || i.op == BF_MAX || (i.op >= BF_LT && i.op <= BF_NE)) {
