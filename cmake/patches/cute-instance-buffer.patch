+CF_API uint64_t CF_CALL cf_make_instance_buffer(int size_in_bytes, int stride);
+CF_API void CF_CALL cf_update_instance_buffer(uint64_t handle, void* data, int count);
+CF_API void CF_CALL cf_destroy_instance_buffer(uint64_t handle);
