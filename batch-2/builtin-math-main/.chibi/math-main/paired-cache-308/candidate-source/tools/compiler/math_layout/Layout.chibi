package math_layout

import math "project:math_types"

// Logical f32 math storage. These are explicit packing contracts, not a
// substitute for the target's reflected native sizeof/alignof/offsetof facts.
// Storage follows std430 and Uniform follows std140. A backend with another
// buffer contract must supply its own layout rather than reuse CPU bytes.
pub Compact: int : 0;
pub Storage: int : 1;
pub Uniform: int : 2;

pub Result :: union {
    Packed(size: int, alignment: int, array_stride: int, column_stride: int)
    | Rejected(message: string)
}

Aligned :: (size: int, alignment: int) -> int {
    return (size + alignment - 1) / alignment * alignment;
}

pub Layout :: (kind: int, packing: int) -> Result {
    if (packing < Compact || packing > Uniform) {
        return Result.Rejected("Unknown math buffer packing");
    }
    count := math.Components(kind);
    if (count == 0) {
        return Result.Rejected("Math buffers require f32 math values");
    }
    if (packing == Compact) {
        column: int = 0;
        if (math.IsMatrix(kind)) {
            column = math.Width(kind) * 4;
        }
        return Result.Packed(count * 4, 4, count * 4, column);
    }
    if (math.IsMatrix(kind)) {
        width := math.Width(kind);
        alignment: int = 16;
        if (width == 2 && packing == Storage) {
            alignment = 8;
        }
        column := Aligned(width * 4, alignment);
        size := column * width;
        return Result.Packed(size, alignment, size, column);
    }
    alignment: int = 4;
    if (count == 2) {
        alignment = 8;
    } else if (count > 2) {
        alignment = 16;
    }
    array_alignment := alignment;
    if (packing == Uniform) {
        array_alignment = 16;
    }
    return Result.Packed(count * 4, alignment, Aligned(count * 4, array_alignment), 0);
}

// Offset of a logical column-first f32 component within one packed value.
// -1 means an invalid kind, packing, or component. Array offsets use the
// separately returned array_stride, not size.
pub ComponentOffset :: (kind: int, packing: int, component: int) -> int {
    if (component < 0 || component >= math.Components(kind)) {
        return -1;
    }
    switch Layout(kind, packing) {
        case .Rejected(message):
            return -1;
        case .Packed(size, alignment, array_stride, column_stride):
            if (column_stride == 0) {
                return component * 4;
            }
            width := math.Width(kind);
            return component / width * column_stride + component % width * 4;
    }
}

// An array's base alignment is distinct from its element's value alignment.
// For example, std140 float has alignment 4 but float[] starts at alignment16.
// -1 rejects an unsupported type or packing contract.
pub ArrayAlignment :: (kind: int, packing: int) -> int {
    switch Layout(kind, packing) {
        case .Rejected(message):
            return -1;
        case .Packed(size, alignment, array_stride, column_stride):
            if (packing == Uniform && alignment < 16) {
                return 16;
            }
            return alignment;
    }
}
