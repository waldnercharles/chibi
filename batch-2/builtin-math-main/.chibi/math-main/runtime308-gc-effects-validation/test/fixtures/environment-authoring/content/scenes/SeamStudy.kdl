version 1
name "SeamStudy"
(array)entities {
    - {
        name "Solid slab"
        prototype "SeamTerrain"
        components {
            Transform y=32.0
        }
    }
    - {
        name "Cut slab"
        prototype "SeamTerrain"
        components {
            Transform y=-32.0
        }
    }
    - {
        name "Solid probe"
        prototype "SeamProbe"
        components {
            Transform y=12.0
        }
    }
    - {
        name "Cut probe"
        prototype "SeamProbe"
        components {
            Transform y=-52.0
        }
    }
}
