layout(set = 2, binding = 1) uniform sampler2D scene_tex;
layout(set = 2, binding = 2) uniform sampler2D fluence_tex;
layout(set = 2, binding = 3) uniform sampler2D emission_tex;
layout(set = 2, binding = 4) uniform sampler2D absorption_tex;
layout(set = 2, binding = 5) uniform sampler2D albedo_tex;
layout(set = 2, binding = 6) uniform sampler2D normal_tex;

layout(set = 2, binding = 7) uniform sampler2D background_tex;
layout(set = 2, binding = 8) uniform sampler2D visibility_tex;
layout(set = 2, binding = 9) uniform sampler2D medium_tex;

layout(set=2,binding=10) uniform sampler2D optical_direct_tex;
layout(set=2,binding=11) uniform sampler2D optical_surface_tex;

layout(set = 3, binding = 1) uniform shd_uniforms
{
    float ambient;
    float intensity;
    float debug_view;
    float shadow_floor;
    float fog;
    float dither_phase;
    float medium_depth;
    float optical_display_scale;
    vec4 medium_albedo;
    vec4 crop_uv;
};

#include "color.shd"

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 source_uv = mix(crop_uv.xy, crop_uv.zw, screen_uv);
    vec4 scene = texture(scene_tex, source_uv);
    vec3 emission = texture(emission_tex, source_uv).rgb;
    vec3 absorption = texture(absorption_tex, source_uv).rgb;
    vec3 albedo = texture(albedo_tex, source_uv).rgb;
    vec3 fluence = max(texture(fluence_tex, source_uv).rgb, vec3(0.0));
    vec4 normal = texture(normal_tex, source_uv);
    vec3 optical_direct = texture(optical_direct_tex, source_uv).rgb * optical_display_scale;
    vec3 optical_surface = texture(optical_surface_tex, source_uv).rgb * optical_display_scale;

    int mode = int(debug_view + 0.5);
    if (mode == 1) return scene;
    if (mode == 2) return vec4(emission, 1.0);
    if (mode == 3) return vec4(exp(-absorption), 1.0);
    if (mode == 4) return vec4(albedo, 1.0);
    if (mode == 5) return vec4(fluence * 5.0, 1.0);
    if (mode == 6) return vec4(normal.xyz * 0.5 + 0.5, normal.a);

    // Screen-space liquid distortion samples the background and incident light.
    // Foreground opaque objects remain in front; this is not a depth/Snell solve.
    vec2 pixel_uv = 1.0 / vec2(textureSize(normal_tex, 0));
    vec2 distortion = normal.z < 0.0 ? normal.xy * (-normal.z) * pixel_uv : vec2(0);
    if (normal.z < 0.0) fluence = max(texture(fluence_tex, source_uv + distortion).rgb, vec3(0));
    // Sample nearby received light to soften illumination inward from edges.
    // The combined mask hides internal terrain seams. With no light this is zero.
    float edge = 0.0;
    vec2 step_uv = 8.0 * pixel_uv;
    if (normal.z > 0.0) {
        float weight = .5333333;
        for (int i = 1; i <= 4; i++) {
            vec2 reach = pixel_uv * (2.0 * float(i));
            float neighbor = min(min(texture(normal_tex, source_uv + vec2(reach.x, 0)).z,
                                     texture(normal_tex, source_uv - vec2(reach.x, 0)).z),
                                 min(texture(normal_tex, source_uv + vec2(0, reach.y)).z,
                                     texture(normal_tex, source_uv - vec2(0, reach.y)).z));
            edge += max(0.0, normal.z - max(0.0, neighbor)) * weight;
            weight *= .5;
        }
    }
    if (normal.z < 0.0) edge = normal.a * 2.0;
    vec3 edge_received = vec3(0);
    if (edge > 0.0) {
        edge_received = .25 * (texture(fluence_tex, source_uv + vec2(step_uv.x, 0)).rgb +
                                texture(fluence_tex, source_uv - vec2(step_uv.x, 0)).rgb +
                                texture(fluence_tex, source_uv + vec2(0, step_uv.y)).rgb +
                                texture(fluence_tex, source_uv - vec2(0, step_uv.y)).rgb);
    }
    vec4 visibility = texture(visibility_tex, source_uv);
    // The same exposure as visible emitters reveals light received by fluid.
    // Coverage blends this artistic gain; it never feeds the transport solver.
    float volume_exposure = mix(1.0, intensity, visibility.a);
    vec3 lit = albedo * (fluence * volume_exposure + edge_received * edge * intensity) +
               max(albedo * shadow_floor, visibility.rgb);
    vec3 out_linear = optical_surface * intensity + (fluence + optical_direct) * fog + emission * intensity + scene.rgb * ambient + lit;
    vec2 background_uv = clamp(screen_uv + distortion / (crop_uv.zw - crop_uv.xy), vec2(0), vec2(1));
    out_linear += texture(background_tex, background_uv).rgb * (1.0 - scene.a);
    float medium = texture(medium_tex, source_uv).r;
    if (medium > 0.0) {
        // Exact homogeneous slab integration toward the camera. The HRC field
        // supplies isotropic incident light, including temporal diffuse bounce.
        float tau = medium * medium_depth;
        float opacity = tau < .01 ? tau * (1.0 - .5 * tau) : 1.0 - exp(-tau);
        out_linear = out_linear * (1.0 - opacity) + (fluence + optical_direct) * intensity * medium_albedo.rgb * opacity;
    }
    vec3 out_srgb = linear_to_srgb(max(out_linear, vec3(0.0)));
    float dither = dither8bit_ign(gl_FragCoord.xy, dither_phase);
    return vec4(clamp(out_srgb + vec3(dither), vec3(0.0), vec3(1.0)), 1.0);
}
