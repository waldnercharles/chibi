CatalogTypes :: (environment: Environment) -> CatalogType[] {
    switch environment {
        case .Tables(expressions, arguments, statements, children, functions, symbols, scopes, queries, bindings, reads, writes, capabilities, catalog_types, ids, ranges, descriptions, stages):
            return catalog_types;
    }
}
Ids :: (environment: Environment) -> u64[] {
    switch environment {
        case .Tables(expressions, arguments, statements, children, functions, symbols, scopes, queries, bindings, reads, writes, capabilities, catalog_types, ids, ranges, descriptions, stages):
            return ids;
    }
}
Ranges :: (environment: Environment) -> Range[] {
    switch environment {
        case .Tables(expressions, arguments, statements, children, functions, symbols, scopes, queries, bindings, reads, writes, capabilities, catalog_types, ids, ranges, descriptions, stages):
