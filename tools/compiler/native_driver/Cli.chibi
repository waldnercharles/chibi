package native_driver

import link "project:native_link"
import host "project:native_link_host"
import os "core:os"
import strings "core:strings"

// The `chibi` command line: `version`, `doctor`, `build --native`, `test` and
// `run`. The compiler is this program, so a command compiles in-process with
// Gather and Emit and runs what it built; nothing is spawned but the program
// itself and the LLVM tools. SDK folders sit beside the binary: bin/chibi and
// share/chibi/core.

// A parsed command line.
CliInvocation :: struct {
    command: string;
    path: string;
    root: string;
    entry: string;
    collections: string[];
    llvm: string;
    core: string;
    target: string;
    mode: string;
    error: string;
    tail_first: int;
    valid: bool;
    help: bool;
    watch: bool;
    native: bool;
    debug: bool;
    static_link: bool;
    shared: bool;
}

NewInvocation :: (command: string) -> CliInvocation {
    return {command: command, path: "", root: "", entry: "Main", collections: [], llvm: "", core: "", target: "", mode: "2", error: "", tail_first: 0, valid: true,
            help: false, watch: false, native: false, debug: false, static_link: false, shared: false};
}

Tail :: (arguments: string[], first: int) -> string[] {
    values: string[] = [];
    index := first;
    while (index < length(arguments)) {
        values.append(arguments[index]);
        index += 1;
    }
    return values;
}

HelpOption :: (value: string) -> bool {
    return value == "--help" || value == "-h";
}

IsOption :: (value: string) -> bool {
    return strings.HasPrefix(value, "-");
}

Invalid :: (invocation: CliInvocation, message: string) -> CliInvocation {
    result := invocation;
    result.valid = false;
    result.error = message;
    return result;
}

ParseRun :: (arguments: string[], first: int) -> CliInvocation {
    invocation := NewInvocation("run");
    index := first;
    if (length(arguments) == index + 1 && HelpOption(arguments[index])) {
        invocation.help = true;
        return invocation;
    }
    while (index < length(arguments)) {
        argument := arguments[index];
        if (argument == "--watch" && !invocation.watch) {
            invocation.watch = true;
        } else if (argument == "--native" && !invocation.native) {
            invocation.native = true;
        } else if (argument == "-O0" || argument == "-O2") {
            invocation.mode = strings.Slice(argument, 2, 1);
        } else if (argument == "-g" && !invocation.debug) {
            invocation.debug = true;
        } else if (argument == "--llvm" || argument == "--target" || argument == "--entry" ||
                   argument == "--collection" || argument == "--root" || argument == "--core") {
            if (index + 1 >= length(arguments) || arguments[index + 1] == "" || IsOption(arguments[index + 1])) {
                return Invalid(invocation, format_text("{} needs a nonempty value", argument));
            }
            index += 1;
            if (argument == "--llvm") {
                invocation.llvm = arguments[index];
            } else if (argument == "--core") {
                invocation.core = arguments[index];
            } else if (argument == "--target") {
                invocation.target = arguments[index];
            } else if (argument == "--entry") {
                invocation.entry = arguments[index];
            } else if (argument == "--root") {
                invocation.root = arguments[index];
            } else {
                invocation.collections.append(arguments[index]);
            }
        } else if (IsOption(argument) && argument != "--") {
            return Invalid(invocation, format_text("Invalid run option: {}; use --help.", argument));
        } else {
            break;
        }
        index += 1;
    }
    if (index < length(arguments) && arguments[index] != "--" && !IsOption(arguments[index])) {
        if (arguments[index] == "") {
            return Invalid(invocation, "A program path must not be empty");
        }
        invocation.path = arguments[index];
        index += 1;
    }
    if (!invocation.watch && index < length(arguments) && arguments[index] == "--watch") {
        invocation.watch = true;
        index += 1;
    }
    if (index < length(arguments) && arguments[index] == "--") {
        index += 1;
    }
    invocation.tail_first = index;
    return invocation;
}

// The command line `arguments`, whose first is the program's name.
Parse :: (arguments: string[]) -> CliInvocation {
    invocation := NewInvocation("");
    if (length(arguments) < 2) {
        invocation.valid = false;
        invocation.help = true;
        return invocation;
    }
    command := arguments[1];
    invocation.command = command;
    if (HelpOption(command)) {
        invocation.help = true;
        return invocation;
    }
    if (command == "run") {
        return ParseRun(arguments, 2);
    }
    if (command == "--watch") {
        return ParseRun(arguments, 1);
    }
    known := command == "version" || command == "doctor" || command == "build" || command == "test";
    if (!known) {
        invocation = ParseRun(arguments, 1);
        invocation.command = "shorthand";
        return invocation;
    }
    if (length(arguments) == 3 && HelpOption(arguments[2])) {
        invocation.help = true;
        return invocation;
    }
    if (command == "version") {
        if (length(arguments) != 2) {
            return Invalid(invocation, "Invalid version option; use --help.");
        }
        return invocation;
    }
    index := 2;
    if (command == "build" && index < length(arguments) && arguments[index] == "--native") {
        invocation.native = true;
        index += 1;
    }
    rooted := false;
    located := false;
    targeted := false;
    optimized := false;
    while (index < length(arguments)) {
        argument := arguments[index];
        if (argument == "") {
            return Invalid(invocation, format_text("A {} path must not be empty", command));
        }
        valued := argument == "--llvm" || argument == "--target";
        if (valued && (index + 1 >= length(arguments) || arguments[index + 1] == "" || IsOption(arguments[index + 1]))) {
            return Invalid(invocation, format_text("{} needs a nonempty value", argument));
        }
        if (HelpOption(argument) && !(command == "build" && invocation.native)) {
            invocation.help = true;
            return invocation;
        }
        compilable := command == "test" || (command == "build" && invocation.native);
        if (compilable && argument == "--llvm" && index + 1 < length(arguments) && !located) {
            index += 1;
            invocation.llvm = arguments[index];
            located = true;
        } else if (compilable && argument == "--target" && index + 1 < length(arguments) && !targeted) {
            index += 1;
            invocation.target = arguments[index];
            targeted = true;
        } else if (compilable && (argument == "-O0" || argument == "-O2") && !optimized) {
            invocation.mode = strings.Slice(argument, 2, 1);
            optimized = true;
        } else if (compilable && argument == "-g" && !invocation.debug) {
            invocation.debug = true;
        } else if (command == "build" && invocation.native && argument == "--static" && !invocation.static_link && !invocation.shared) {
            invocation.static_link = true;
        } else if (command == "build" && invocation.native && argument == "--shared" && !invocation.shared && !invocation.static_link) {
            invocation.shared = true;
        } else if (!IsOption(argument) && !rooted && command != "doctor") {
            invocation.path = argument;
            rooted = true;
        } else {
            return Invalid(invocation, format_text("Invalid {} option; use --help.", command));
        }
        index += 1;
    }
    return invocation;
}

Usage :: (program: string) -> string {
    commands := format_text("Usage: {} version\n       {} doctor\n       {} build [BUILD OPTIONS]\n       {} build --native [-O0|-O2] [-g] [--static|--shared]\n                [--target TRIPLE] [--llvm DIR] [ROOT]\n       {} test [-O0|-O2] [--llvm DIR] [ROOT]\n       {} run [--watch] [-O0|-O2] [--llvm DIR] [PATH] [--] [ARGUMENTS]\n       {} [--watch] PATH [--] [ARGUMENTS]\n",
                            program, program, program, program, program, program, program);
    return strings.Concatenate([commands,
        "PATH is a .chibi file or package directory. Its Main takes no arguments\n",
        "and returns nothing or an int exit status. chibi PATH is shorthand for run.\n",
        "version prints the compiler's identity.\n",
        "doctor reports the SDK, compiler, platform and LLVM tools as supported,\n",
        "unavailable or broken, changing nothing; it fails only when a capability it\n",
        "checks is broken.\n",
        "build runs the nearest tools/toolchain/Driver.chibi through the native compiler.\n",
        "build --native compiles the Main of a .chibi file or package in ROOT,\n",
        "the working directory without one, to ROOT/build/native/OLEVEL-HASH/program\n",
        "with the LLVM tools in DIR,\n",
        "or in CHIBI_LLVM_BIN without --llvm, for the host. --target builds for\n",
        "x86_64-unknown-linux-gnu, aarch64-apple-darwin or x86_64-pc-windows-msvc,\n",
        "whose program is program.exe, instead. Native code supports a subset of\n",
        "the language so far; a source outside it fails with the first unsupported form.\n",
        "test runs each @test function of the packages below ROOT, the working\n",
        "directory without one, and fails when one fails.\n",
        "run compiles a program natively and calls Main, or --entry NAME.\n",
        "--root DIR resolves project imports; --collection NAME=DIR adds a package collection.\n",
        "--core DIR selects core packages for this run without changing the environment.\n",
        "Distinct source/entry combinations own separate cached programs. Arguments come after\n",
        "PATH or --, and it needs the LLVM tools as build --native does.\n"]);
}

// Writes a line to the standard output.
Say :: (text: string) {
    os.WriteOutput(strings.Concatenate([text, "\n"]));
}

// Writes a line to the standard error.
Complain :: (text: string) {
    os.Print(text);
}

Default :: (value: string, fallback: string) -> string {
    if (value == "") {
        return fallback;
    }
    return value;
}

// The folder holding `path`, "" for a bare name.
Directory :: (path: string) -> string {
    slash := strings.LastIndex(path, "/");
    if (slash < 0) {
        return "";
    }
    if (slash == 0) {
        return "/";
    }
    return strings.Slice(path, 0, slash);
}

// The triple a native build targets without --target: the host's.
HostTriple :: () -> string {
    platform := os.Platform();
    if (platform == "Darwin") {
        return "aarch64-apple-darwin";
    }
    if (platform == "Windows") {
        return "x86_64-pc-windows-msvc";
    }
    return "x86_64-unknown-linux-gnu";
}

// The folder of core packages: CHIBI_CORE, else share/chibi/core of the SDK this
// binary sits in (bin/chibi beside share/chibi), else "".
CoreFolder :: () -> string {
    chosen := os.Getenv("CHIBI_CORE");
    if (chosen != "") {
        return os.RealPath(chosen);
    }
    program := os.ProgramPath();
    if (program == "") {
        return "";
    }
    beside := os.RealPath(strings.Concatenate([Directory(program), "/../share/chibi/core"]));
    if (beside != "" && os.IsDirectory(beside)) {
        return beside;
    }
    return "";
}

// The folder of the LLVM tools: the option, else CHIBI_LLVM_BIN, else "".
LlvmFolder :: (requested: string) -> string {
    chosen := Default(requested, os.Getenv("CHIBI_LLVM_BIN"));
    if (chosen == "") {
        return "";
    }
    return os.RealPath(chosen);
}

NeedsLlvm :: () -> string {
    return "pass --llvm DIR with LLVM 22 or newer opt, llc and lld, or set CHIBI_LLVM_BIN";
}

// The names of the LLVM tools a native build runs.
LlvmTools :: () -> string[] {
    return ["opt", "llc", link.Linker(link.TargetOf(HostTriple()))];
}

Version :: () -> int {
    Say("chibi native");
    Say(strings.Concatenate(["compiler: ", Default(os.ProgramPath(), "unknown")]));
    Say(strings.Concatenate(["target: ", HostTriple()]));
    return 0;
}

Report :: (name: string, status: string, detail: string) -> bool {
    Say(format_text("{}: {} ({})", name, status, detail));
    return status == "broken";
}

Doctor :: () -> int {
    broken := false;
    program := os.ProgramPath();
    if (program == "") {
        broken = Report("compiler", "broken", "the program's own path is unknown");
    } else {
        Report("compiler", "supported", program);
    }
    core := CoreFolder();
    if (core == "") {
        broken = Report("sdk", "broken", "no share/chibi/core beside the program; set CHIBI_CORE") || broken;
    } else {
        Report("sdk", "supported", core);
    }
    triple := HostTriple();
    if (triple == "aarch64-apple-darwin" || triple == "x86_64-unknown-linux-gnu") {
        Report("platform", "supported", triple);
    } else {
        Report("platform", "unavailable", format_text("{}: native programs are built, not run, here", triple));
    }
    llvm := LlvmFolder("");
    if (llvm == "") {
        Report("llvm tools", "unavailable", NeedsLlvm());
    } else {
        llvm_broken := false;
        for (tool in LlvmTools()) {
            path := strings.Concatenate([llvm, "/", tool]);
            if (host.Tool(llvm, tool) == "") {
                llvm_broken = Report("llvm tools", "broken", strings.Concatenate(["missing ", path])) || llvm_broken;
            }
        }
        if (!llvm_broken) {
            problem := LlvmProblem(llvm, HostTriple());
            if (problem == "") {
                Report("llvm tools", "supported", llvm);
            } else {
                llvm_broken = Report("llvm tools", "broken", problem);
            }
        }
        broken = broken || llvm_broken;
    }
    if (broken) {
        return 1;
    }
    return 0;
}

// What a path names for the compiler: the folder `project` its `project:` imports resolve
// against, the one file `source` of a single-file program, or the package folder.
Subject :: struct {
    project: string;
    source: string;
    package: string;
    problem: string;
}

// The program PATH names, a .chibi file or a folder with a Main.chibi, or with
// exactly one .chibi file.
Resolve :: (requested: string) -> Subject {
    path := os.RealPath(requested);
    if (path == "") {
        return {project: "", source: "", package: ".", problem: format_text("{}: cannot resolve source target", requested)};
    }
    if (os.IsFile(path)) {
        if (!strings.HasSuffix(path, ".chibi")) {
            return {project: "", source: "", package: ".", problem: "A program requires a .chibi file or package directory"};
        }
        return {project: Directory(path), source: path, package: ".", problem: ""};
    }
    if (!os.IsDirectory(path)) {
        return {project: "", source: "", package: ".", problem: format_text("{}: cannot resolve source target", requested)};
    }
    if (os.IsFile(strings.Concatenate([path, "/project.kdl"]))) {
        return {project: "", source: "", package: ".", problem: "game projects are archived"};
    }
    if (os.IsFile(strings.Concatenate([path, "/Main.chibi"]))) {
        return {project: path, source: "", package: ".", problem: ""};
    }
    only := "";
    count := 0;
    for (name in os.List(path).names) {
        if (strings.HasSuffix(name, ".chibi") && os.IsFile(strings.Concatenate([path, "/", name]))) {
            only = name;
            count += 1;
        }
    }
    if (count == 1) {
        return {project: path, source: strings.Concatenate([path, "/", only]), package: ".", problem: ""};
    }
    return {project: "", source: "", package: ".", problem: format_text("{}: holds no Main.chibi and not exactly one .chibi source", requested)};
}

// Makes `path` and the folders above it that are missing.
MakeFolders :: (path: string) -> bool {
    if (path == "" || os.IsDirectory(path)) {
        return true;
    }
    if (!MakeFolders(Directory(path))) {
        return false;
    }
    return os.MakeDirectory(path) == nil;
}

// The same closure compilation serves CLI run, project build programs and
// the live host. An empty output selects the verified native output cache;
// an explicit output is the watch protocol's private generation file.
CompileProgram :: (subject: Subject, core: string, llvm: string, triple: string, output: string,
                   invocation: CliInvocation) -> ProgramBuild {
    scoped := subject;
    if (invocation.root != "") {
        scoped.project = os.RealPath(invocation.root);
        if (scoped.project == "" || !os.IsDirectory(scoped.project)) {
            Complain("run: --root must name an existing project directory");
            return {status: 2, path: "", reused: false};
        }
        if (scoped.source == "" && subject.project != scoped.project) {
            prefix := strings.Concatenate([scoped.project, "/"]);
            if (!strings.HasPrefix(subject.project, prefix)) {
                Complain("run: a package directory must be within --root");
                return {status: 2, path: "", reused: false};
            }
            scoped.package = strings.TrimPrefix(subject.project, prefix);
        }
    }
    collections: string[] = ["core"];
    directories: string[] = [core];
    for (declared in invocation.collections) {
        equals := strings.Index(declared, "=");
        if (equals <= 0) {
            Complain(strings.Concatenate(["run: --collection takes NAME=DIR: ", declared]));
            return {status: 2, path: "", reused: false};
        }
        name := strings.Slice(declared, 0, equals);
        directory := os.RealPath(strings.Slice(declared, equals + 1, strings.ByteLength(declared) - equals - 1));
        if (Contains(collections, name) || directory == "" || !os.IsDirectory(directory)) {
            Complain(strings.Concatenate(["run: --collection needs a unique name and an existing directory: ", declared]));
            return {status: 2, path: "", reused: false};
        }
        collections.append(name);
        directories.append(directory);
    }
    gathered := Gather(scoped.project, collections, directories, scoped.package, scoped.source);
    if (gathered.problem != "") {
        Complain(strings.Concatenate(["native: ", gathered.problem]));
        return {status: 2, path: "", reused: false};
    }
    folder := subject.project;
    if (scoped.source != "") { folder = Directory(scoped.source); }
    options: DriverOptions = {level: invocation.mode, lines: invocation.debug, static_link: false, shared: invocation.shared,
                             folder: folder, keep_module: output == ""};
    chosen := invocation.entry;
    if (invocation.shared) { chosen = ""; }
    if (output == "") {
        return CachedProgram(scoped.project, collections, directories, gathered, triple, chosen, llvm, Jobs([]), options,
                             scoped.package, scoped.source);
    }
    status := EmitOptions(collections, directories, gathered.paths, gathered.sources, triple, chosen, llvm, output, Jobs([]), options);
    if (status != 0) { return {status: status, path: "", reused: false}; }
    return {status: 0, path: output, reused: false};
}

CompileSubject :: (subject: Subject, core: string, llvm: string, triple: string, output: string,
                   invocation: CliInvocation) -> int {
    result := CompileProgram(subject, core, llvm, triple, output, invocation);
    return result.status;
}

// The program's own exit status as the command's, which fits 0..255.
ExitStatus :: (status: int) -> int {
    if (status < 0 || status > 255) {
        Complain("Main returned an exit status outside 0..255");
        return 1;
    }
    return status;
}

// `chibi run`: compiles or reuses its own content-keyed program and calls the chosen entry.
RunProgram :: (invocation: CliInvocation, tail: string[]) -> int {
    llvm := LlvmFolder(invocation.llvm);
    if (llvm == "") {
        Complain(strings.Concatenate(["run needs LLVM: ", NeedsLlvm()]));
        return 2;
    }
    core := CoreFolder();
    if (invocation.core != "") { core = os.RealPath(invocation.core); }
    if (core == "" || !os.IsDirectory(core)) {
        if (invocation.core != "") {
            Complain(strings.Concatenate(["run: cannot find core directory: ", invocation.core]));
        } else {
            Complain("cannot find the SDK's share/chibi/core; set CHIBI_CORE");
        }
        return 2;
    }
    subject := Resolve(Default(invocation.path, "."));
    if (subject.problem != "") {
        Complain(subject.problem);
        return 2;
    }
    triple := Default(invocation.target, HostTriple());
    if (triple != HostTriple()) {
        Complain("run requires the host target; use build --native to cross-compile");
        return 2;
    }
    if (invocation.watch) {
        if (invocation.entry != "Main" || invocation.root != "" || length(invocation.collections) != 0) {
            Complain("run --watch does not support --entry, --root or --collection yet");
            return 2;
        }
        return WatchProgram(subject, core, llvm, triple, invocation, tail);
    }
    compiled := CompileProgram(subject, core, llvm, triple, "", invocation);
    if (compiled.status != 0) {
        return compiled.status;
    }
    command: string[] = [compiled.path];
    command.extend(tail);
    return ExitStatus(os.Run(command));
}

// `chibi build --native`: compiles the program to ROOT/build/native/O2-HASH/program, which
// the HASH of its sources, target and options names, and says where it is.
BuildNative :: (invocation: CliInvocation) -> int {
    llvm := LlvmFolder(invocation.llvm);
    if (llvm == "") {
        Complain(strings.Concatenate(["build --native needs LLVM: ", NeedsLlvm()]));
        return 2;
    }
    core := CoreFolder();
    if (core == "") {
        Complain("native: cannot find the SDK's share/chibi/core; set CHIBI_CORE");
        return 2;
    }
    root := os.RealPath(Default(invocation.path, "."));
    arguments: string[] = ["--compiler", root, "--core", core, "--root", root, "--llvm", llvm,
                            "--target", Default(invocation.target, HostTriple()), "--level", invocation.mode];
    if (!invocation.shared) {
        arguments.extend(["--entry", "Main"]);
    }
    if (invocation.debug) {
        arguments.append("--lines");
    }
    if (invocation.static_link) {
        arguments.append("--static");
    }
    if (invocation.shared) {
        arguments.append("--shared");
    }
    return Build(arguments);
}

// A checkout's build entry is found from the working directory, as a project build is.
BuildCommand :: (arguments: string[]) -> int {
    root := os.Root();
    while (root != "" && !os.IsFile(strings.Concatenate([root, "/tools/toolchain/Driver.chibi"]))) {
        parent := Directory(root);
        if (parent == root) {
            root = "";
            break;
        }
        root = parent;
    }
    if (root == "") {
        Complain("chibi build: no tools/toolchain/Driver.chibi in this directory or its parents");
        return 2;
    }
    llvm := LlvmFolder(Option(arguments, "--llvm", ""));
    if (llvm == "") {
        Complain(strings.Concatenate(["build needs LLVM: ", NeedsLlvm()]));
        return 2;
    }
    command: string[] = ["sh", strings.Concatenate([root, "/tools/build.sh"]), "build"];
    command.extend(Tail(arguments, 1));
    command.extend(["--native-driver", os.ProgramPath(), "--llvm", llvm]);
    return ExitStatus(os.Run(command));
}

// The command line in `arguments`, without the program's name.
Cli :: (arguments: string[]) -> int {
    if (length(arguments) > 0 && arguments[0] == "build" &&
        (length(arguments) < 2 || arguments[1] != "--native") &&
        (length(arguments) != 2 || !HelpOption(arguments[1]))) {
        return BuildCommand(arguments);
    }
    full: string[] = ["chibi"];
    full.extend(arguments);
    invocation := Parse(full);
    if (invocation.help) {
        Say(Usage("chibi"));
        if (!invocation.valid) {
            return 2;
        }
        return 0;
    }
    if (!invocation.valid) {
        Complain(invocation.error);
        return 2;
    }
    command := invocation.command;
    if (command == "version") {
        return Version();
    }
    if (command == "doctor") {
        return Doctor();
    }
    if (command == "build") {
        if (invocation.native) {
            return BuildNative(invocation);
        }
        Complain("chibi build: game projects are archived");
        return 2;
    }
    if (command == "test") {
        return TestCommand(invocation);
    }
    if (command == "shorthand" && (IsOption(full[1]) || (!os.Exists(full[1]) && !strings.HasSuffix(full[1], ".chibi") && !strings.Contains(full[1], "/")))) {
        Complain(format_text("Unknown command: {}; use --help.", full[1]));
        return 2;
    }
    return RunProgram(invocation, Tail(full, invocation.tail_first));
}
