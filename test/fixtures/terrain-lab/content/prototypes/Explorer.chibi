package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Explorer")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Appearance", data.Object([
                    data.Field.Named("border_color", data.Value.UInt(3808425983)),
                    data.Field.Named("border_width", data.Value.Real(1.0)),
                    data.Field.Named("color", data.Value.UInt(1927992575)),
                    data.Field.Named("glow_color", data.Value.UInt(1927992368)),
                    data.Field.Named("glow_radius", data.Value.Real(4.0)),
                    data.Field.Named("height", data.Value.Real(20.0)),
                    data.Field.Named("layer", data.Value.UInt(5)),
                    data.Field.Named("width", data.Value.Real(12.0))
                ])),
                data.Field.Named("Body", data.Object([
                    data.Field.Named("continuous", data.Value.Bool(true)),
                    data.Field.Named("type", data.Value.Text("Dynamic"))
                ])),
                data.Field.Named("Collider", data.Object([
                    data.Field.Named("category", data.Value.UInt(1)),
                    data.Field.Named("height", data.Value.Real(20.0)),
                    data.Field.Named("mask", data.Value.UInt(8)),
                    data.Field.Named("shape", data.Value.Text("Box")),
                    data.Field.Named("width", data.Value.Real(12.0))
                ])),
                data.Field.Named("GlobalBinding", data.Object([
                    data.Field.Named("name", data.Value.Text("Explorer"))
                ])),
                data.Field.Named("Input", data.Object([])),
                data.Field.Named("Transform", data.Object([
                    data.Field.Named("x", data.Value.Real(-22.0)),
                    data.Field.Named("y", data.Value.Real(-12.0))
                ])),
                data.Field.Named("Velocity", data.Object([]))
            ])),
            data.Field.Named("behaviors", data.List([
                data.Value.Text("Explorer")
            ]))
        ])
    );
}
