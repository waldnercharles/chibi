package engine

// Whether a target was named with --target, or none were, or a named
// executable needs it.
pub Selected :: (arguments: string[], target: string) -> bool {
    named := false;
    for (i in 0..<length(arguments) - 1) {
        if (arguments[i] == "--target") {
            named = true;
            if (arguments[i + 1] == target || Needed(arguments[i + 1], target)) {
                return true;
            }
        }
    }
    return !named && !WebAssemblyProducts().contains(target) &&
           target != "chibi_graph_fixture" && target != "graph_headerless";
}
