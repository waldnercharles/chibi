include("${CMAKE_CURRENT_LIST_DIR}/generated_file.cmake")

function(chibi_config_array output json key)
    string(JSON count LENGTH "${json}" "${key}")
    set(values)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON value GET "${json}" "${key}" ${index})
            list(APPEND values "${value}")
        endforeach()
    endif()
    set(${output} "${values}" PARENT_SCOPE)
endfunction()

function(chibi_source_snapshot output resident_output config)
    chibi_config_array(roots "${config}" roots)
    chibi_config_array(suffixes "${config}" suffixes)
    set(files)
    foreach(root IN LISTS roots)
        if(IS_DIRECTORY "${root}")
            file(GLOB_RECURSE found LIST_DIRECTORIES false RELATIVE "${root}" "${root}/*")
            foreach(relative IN LISTS found)
                if(NOT relative MATCHES "(^|/)(CMakeFiles|__pycache__|\\.git|\\.chibi|build|build-[^/]*)(/|$)")
                    list(APPEND files "${root}/${relative}")
                endif()
            endforeach()
        elseif(EXISTS "${root}")
            list(APPEND files "${root}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES files)
    list(SORT files)
    set(snapshot "")
    set(resident "")
    foreach(path IN LISTS files)
        get_filename_component(name "${path}" NAME)
        get_filename_component(suffix "${path}" LAST_EXT)
        if(NOT suffix IN_LIST suffixes AND NOT name STREQUAL "CMakeLists.txt" AND NOT name STREQUAL "Makefile")
            continue()
        endif()
        if(NOT EXISTS "${path}")
            continue()
        endif()
        file(SHA256 "${path}" hash)
        string(APPEND snapshot "${path}\n${hash}\n")
        if(suffix MATCHES "^\\.(ttf|otf|shd|glsl)$" OR name MATCHES "^sdf_shapes\\.[ch]$" OR
           (path MATCHES "/editor/" AND name STREQUAL "fonts.c"))
            string(APPEND resident "${path}\n${hash}\n")
        endif()
    endforeach()
    string(SHA256 snapshot "${snapshot}")
    string(SHA256 resident "${resident}")
    set(${output} "${snapshot}" PARENT_SCOPE)
    set(${resident_output} "${resident}" PARENT_SCOPE)
endfunction()
