package task_observer_arrays

Count :: (add: int) -> int { total: retain int = 0; total += add; return total; }
Hold :: () -> int { values := [Child(53), Child(59)]; yield; yield; return length(values); }
Text :: (count: int) -> string { return text_from_bytes(resize([u8(120)], count)); }
Main :: () -> int {
    first := Child(7);
    values := [first, Child(11), first];
    copied := values;
    values = [];
    total := 0;
    for child, index in copied {
        joined := await child;
        if joined is Cancelled { return 1; }
        else { total += text_byte_length(joined); }
        assert(index >= 0 && index < 3);
    }
    assert(total == 25);
    indexed := await copied[1];
    if indexed is Cancelled { return 2; }
    else { assert(text_byte_length(indexed) == 11); }
    copied[0] = Child(13);
    copied.append(Child(17));
    copied.insert(1, Child(19));
    copied.extend([Child(23)]);
    copied.remove_index(2);
    grown := resize(copied, length(copied) + 1);
    absent := await grown[length(grown) - 1];
    assert(absent is Cancelled);
    appended := append(copied, Child(61));
    assert(length(appended) == length(copied) + 1);
    removed := slice(copied, 1, 2);
    reversed := reverse(removed);
    assert(copied.contains(reversed[0]));
    for child in reversed { cancel child; }
    for child in copied { cancel child; }
    nested := [[Child(29), Child(31)], [Child(37)]];
    nested[0] = nested[1];
    for children in nested {
        for child in children {
            joined := await child;
            if joined is Cancelled { return 3; }
            else { assert(text_byte_length(joined) >= 29); }
        }
    }
    single := [Child(41)];
    for child in single {
        single = [];
        yield;
        joined := await child;
        if joined is Cancelled { return 4; }
        else { assert(text_byte_length(joined) == 41); }
    }
    detached := [Child(43)];
    held := detached[0];
    detached = [];
    yield;
    joined := await held;
    if joined is Cancelled { return 5; }
    else { assert(text_byte_length(joined) == 43); }
    // Functional removal compares opaque handles; direct task equality stays
    // outside the ordinary language's scalar operator domain.
    dropped := [held, Child(47), held];
    trimmed := remove_item(dropped, held);
    assert(length(trimmed) == 2 && trimmed.contains(held));
    dropped = [];
    trimmed = [];
    methods := [first, Child(67), first];
    old_methods := methods;
    yield; yield;
    methods.remove_item(first);
    assert(length(methods) == 2 && length(old_methods) == 3);
    method_head := await methods[0];
    if method_head is Cancelled { return 6; }
    else { assert(text_byte_length(method_head) == 67); }
    methods.remove_item(methods[1]);
    methods.remove_item(first);
    assert(length(methods) == 1);
    // A fresh missing observer is dropped normally; its child stays
    // program-owned and is allowed to complete.
    methods.remove_item(Child(71));
    assert(length(methods) == 1 && length(old_methods) == 3);
    methods.remove_item(methods[0]);
    methods.remove_item(first);
    assert(length(methods) == 0);
    old_result := await old_methods[1];
    if old_result is Cancelled { return 7; }
    else { assert(text_byte_length(old_result) == 67); }
    cancelled_item := Child(73);
    cancelled_items := [cancelled_item];
    cancel cancelled_item;
    cancelled_items.remove_item(cancelled_item);
    assert(length(cancelled_items) == 0);
    cancelled := Hold();
    yield;
    cancel cancelled;
    gone := await cancelled;
    assert(gone is Cancelled);
    before := Count(0);
    for index in 0..<64 {
        orphan := [Detached(3), Detached(5)];
    }
    yield; yield;
    assert(Count(0) == before + 128, "dropping observer arrays does not cancel program-owned children");
    return 0;
}

// Force the task's callable ordinal beyond the ordinary built-in type table.
