package toolchain

import sdk "graph:sdk"
import engine "graph:engine"
import strings "core:strings"
import files "graph:install"

RuntimeJoin :: (parts: string[]) -> string {
    return strings.Join(parts, "");
}
RuntimeOption :: (arguments: string[], name: string) -> string {
    for (index in 0..<length(arguments) - 1) {
        if (arguments[index] == name) {
            return arguments[index + 1];
        }
    }
    return "";
}
RuntimeDecimal :: (text: string) -> int {
    if (text == "") {
        return -1;
    }
    value := 0;
    for (byte in strings.Bytes(text)) {
        if (byte < 48 || byte > 57 || value > 1000000) {
            return -1;
        }
        value = value * 10 + byte - 48;
    }
    return value;
}

// The public runtime package uses the same manifest as installed consumers.
// Construction evidence comes from graph records, never a CMake build tree.
RuntimeFail :: (message: string) -> string {
    build.report(RuntimeJoin(["sdk: ", message]));
    return "";
}

RuntimePath :: (path: string) -> bool {
    if (path == "" || path == "." || strings.HasPrefix(path, "/") ||
        strings.Contains(path, "\\") || strings.Contains(path, "//")) {
        return false;
    }
    for (part in strings.Split(path, "/")) {
        if (part == "" || part == "." || part == "..") {
            return false;
        }
    }
    return true;
}

// A canonical JSON inventory also checks that the staged tree has only real
// directories and regular files. The package manifest does not inventory itself.
RuntimeFiles :: (prefix: string, relative: string) -> string {
    path := prefix;
    if (relative != "") {
        path = RuntimeJoin([prefix, "/", relative]);
    }
    if (build.file_kind(path) != "directory") {
        return RuntimeFail(RuntimeJoin(["not a package directory: ", path]));
    }
    keys: string[] = [];
    values: string[] = [];
    for (name in build.list_directory(path)) {
        child := name;
        if (relative != "") {
            child = RuntimeJoin([relative, "/", name]);
        }
        if (!RuntimePath(child)) {
            return RuntimeFail("invalid package file name");
        }
        item := RuntimeJoin([prefix, "/", child]);
        kind := build.file_kind(item);
        if (kind == "directory") {
            nested := RuntimeFiles(prefix, child);
            if (nested == "") {
                return "";
            }
            for (field in sdk.JsonFields(nested)) {
                keys.append(field.key);
                values.append(field.value);
            }
            continue;
        }
        if (kind != "file") {
            return RuntimeFail(RuntimeJoin(["package input is not a regular file: ", child]));
        }
        if (child == "share/chibi/package.json") {
            continue;
        }
        size := build.before(build.after(build.after(build.file_stamp(item), ":"), ":"), ":");
        hash := build.hash_file(item);
        if (hash == "" || sdk.JsonCanonical(size) != size || strings.HasPrefix(size, "-")) {
            return RuntimeFail(RuntimeJoin(["cannot inventory package file: ", child]));
        }
        keys.append(child);
        values.append(sdk.JsonObject(["bytes", "sha256"], [size, sdk.JsonQuote(hash)]));
    }
    return sdk.JsonObject(keys, values);
}

RuntimeHeaderHashes :: (files: string, runtime_only: bool) -> string {
    keys: string[] = [];
    values: string[] = [];
    owners := ["ui_document_values", "text_search", "image_catalog", "support", "types", "ecs",
               "execution_contract", "execution", "behavior_runtime", "events", "asset_values", "value_document",
               "capabilities", "native_capabilities", "native_prepared", "core_capabilities", "array_capabilities",
               "field_capabilities", "state_capabilities", "selection_capabilities", "set_capabilities",
               "comparison_capabilities", "conversion_capabilities", "text_capabilities", "fmt", "host_native_catalog",
               "scene_runtime", "scheduling", "fields", "field_catalog", "tasks", "shader_runtime", "model_runtime",
               "ui_documents", "input_action"];
    for (field in sdk.JsonFields(files)) {
        name := field.key;
        if (!strings.HasPrefix(name, "include/")) {
            continue;
        }
        included := !runtime_only;
        for (owner in owners) {
            included = included || strings.HasPrefix(name, RuntimeJoin(["include/chibi/", owner, "/"]));
        }
        if (included) {
            keys.append(name);
            values.append(sdk.JsonGet(field.value, "sha256"));
        }
    }
    return build.hash_text(sdk.JsonObject(keys, values));
}

RuntimeSourceIdentity :: (root: string) -> string {
    if (build.probe(["git", "-C", root, "rev-parse", "HEAD"]) != 0) {
        return RuntimeFail("cannot read source revision");
    }
    revision := strings.TrimSpace(build.last_stdout());
    if (build.probe(["git", "-C", root, "status", "--porcelain", "--untracked-files=normal"]) != 0) {
        return RuntimeFail("cannot read source status");
    }
    dirty := "false";
    if (build.last_stdout() != "") {
        dirty = "true";
    }
    if (build.probe(["git", "-C", root, "ls-files", "-c", "-o", "--exclude-standard", "-z"]) != 0) {
        return RuntimeFail("cannot read source inventory");
    }
    names := strings.Split(build.last_stdout(), "\u0000");
    keys: string[] = [];
    values: string[] = [];
    for (name in names) {
        if (name == "") {
            continue;
        }
        if (!RuntimePath(name)) {
            return RuntimeFail("invalid source inventory name");
        }
        path := RuntimeJoin([root, "/", name]);
        kind := build.file_kind(path);
        // Deleted tracked files do not contribute bytes, as in source_identity.
        if (kind == "") {
            continue;
        }
        value := "";
        if (kind == "link") {
            if (build.probe(["readlink", path]) != 0) {
                return RuntimeFail("cannot read source symlink");
            }
            link := strings.TrimSuffix(build.last_stdout(), "\n");
            value = sdk.JsonObject(["symlink"], [sdk.JsonQuote(link)]);
        } else if (kind == "file") {
            hash := build.hash_file(path);
            if (hash == "") {
                return RuntimeFail("cannot hash source input");
            }
            value = sdk.JsonQuote(hash);
        } else {
            return RuntimeFail("source inventory contains a special file");
        }
        keys.append(name);
        values.append(value);
    }
    inventory := sdk.JsonObject(keys, values);
    if (inventory == "") {
        return RuntimeFail("duplicate or invalid source inventory");
    }
    return sdk.JsonObject(["revision", "dirty", "snapshot_sha256"],
                          [sdk.JsonQuote(revision), dirty, sdk.JsonQuote(build.hash_text(inventory))]);
}

RuntimeEntries :: (root: string, build_dir: string, third_party: string) -> string[] {
    entries := [RuntimeJoin(["bin/chibi-player=", engine.Executable(build_dir, "chibi-player")])];
    for (name in sdk.RuntimeTargets()) {
        target := sdk.BuildTarget(name);
        archive := sdk.Library(name);
        if (archive != "") {
            entries.append(RuntimeJoin([archive, "=", engine.Library(root, build_dir, third_party, target).output]));
        }
        for (header in sdk.Headers(name)) {
            entries.append(RuntimeJoin(["include/chibi/", name, "/", header, "=",
                                        engine.HeaderRoot(build_dir, target, "public"), "/", header]));
        }
    }
    resources := sdk.ResourceEntries();
    resources.extend(sdk.VendorEntries(build.platform()));
    for (item in resources) {
        entries.append(strings.ReplaceAll(strings.ReplaceAll(item, "@source", root), "@vendor", third_party));
    }
    return entries;
}

RuntimeCopy :: (source: string, destination: string, headers_only: bool) -> bool {
    kind := build.file_kind(source);
    if (kind == "file") {
        if (headers_only && !sdk.VendorHeader(source)) {
            return true;
        }
        return build.make_directory(files.Parent(destination)) && build.copy_file(source, destination);
    }
    if (kind != "directory" || !build.make_directory(destination)) {
        return false;
    }
    for (name in build.list_directory(source)) {
        if (!RuntimeCopy(RuntimeJoin([source, "/", name]), RuntimeJoin([destination, "/", name]), headers_only)) {
            return false;
        }
    }
    return true;
}

RuntimeExports :: (stage: string, version: string) -> bool {
    directory := RuntimeJoin([stage, "/lib/cmake/Chibi"]);
    names := ["ChibiTargets.cmake", "ChibiVendorDependencies.cmake", "ChibiConfig.cmake", "ChibiConfigVersion.cmake"];
    texts := [sdk.Targets(build.platform()), sdk.Vendor(build.platform()),
              sdk.Config(version, build.platform(), 64), sdk.ConfigVersion(version, 64)];
    if (!build.make_directory(directory)) {
        return false;
    }
    for (i in 0..<length(names)) {
        if (texts[i] == "" || !build.write_file(RuntimeJoin([directory, "/", names[i]]), texts[i])) {
            return false;
        }
    }
    return true;
}

// Return the canonical verified manifest, or empty without accepting the prefix.
RuntimeVerify :: (prefix: string) -> string {
    if (build.file_kind(prefix) != "directory") {
        return "";
    }
    manifest := sdk.JsonCanonical(build.read_file(RuntimeJoin([prefix, "/share/chibi/package.json"])));
    if (manifest == "" || sdk.JsonGet(manifest, "manifest_format") != "1" ||
        sdk.JsonGet(manifest, "kind") != "\"runtime\"" ||
        sdk.JsonGet(manifest, "build_id") != sdk.JsonQuote(build.hash_text(sdk.JsonWithout(manifest, "build_id"))) ||
        sdk.JsonGet(manifest, "products") != "{\"chibi-player\":\"bin/chibi-player\"}" ||
        sdk.JsonGet(manifest, "files") != RuntimeFiles(prefix, "")) {
        return "";
    }
    document := sdk.JsonCanonical(build.read_file(RuntimeJoin([prefix, "/share/chibi/engine.json"])));
    requirements := sdk.JsonGet(manifest, "requirements");
    if (document == "" || RuntimeDecimal(sdk.JsonGet(document, "project_version")) < 1 ||
        strings.ByteLength(sdk.JsonText(sdk.JsonGet(document, "build_id"))) != 64 ||
        sdk.JsonText(sdk.JsonGet(manifest, "package_version")) == "" ||
        sdk.JsonGet(document, "project_version") != sdk.JsonGet(requirements, "project_format") ||
        sdk.JsonGet(document, "artifact_formats") != sdk.JsonGet(requirements, "artifact_formats") ||
        sdk.JsonGet(requirements, "pointer_bits") != "64" ||
        sdk.JsonGet(requirements, "system") != sdk.JsonQuote(build.platform()) ||
        sdk.JsonGet(manifest, "engine") != sdk.JsonObject(["manifest", "build_id"],
                                                          [sdk.JsonQuote("share/chibi/engine.json"), sdk.JsonGet(document, "build_id")])) {
        return "";
    }
    expected: string[] = [];
    for (name in sdk.RuntimeTargets()) {
        expected.append(sdk.JsonQuote(RuntimeJoin(["Chibi::", name])));
    }
    if (sdk.JsonGet(manifest, "targets") != sdk.JsonArray(expected)) {
        return "";
    }
    player := RuntimeJoin([prefix, "/bin/chibi-player"]);
    if (sdk.JsonGet(sdk.JsonGet(sdk.JsonGet(manifest, "files"), "bin/chibi-player"), "bytes") == "0" ||
        build.probe(["test", "-x", player]) != 0 ||
        build.probe(["od", "-An", "-tx1", "-N4", player]) != 0 ||
        strings.TrimSpace(build.last_stdout()) == "00 61 73 6d") {
        return "";
    }
    return manifest;
}

// Publish a prepared generation with rollback for a managed replacement.
// Exclusive moves preserve a competing destination. Replacement has a gap
// between its two moves; failed rollback retains the prior generation.
RuntimePublish :: (stage: string, output: string, previous: string) -> bool {
    old := RuntimeJoin([stage, "/previous"]);
    prepared := RuntimeJoin([stage, "/package"]);
    if (previous != "" && !build.publish_directory(output, old)) {
        return false;
    }
    // The preimage can change after the caller's last check. Validate the tree
    // actually moved, before publishing or deleting any prior generation.
    if (previous != "" && RuntimeVerify(old) != previous) {
        if (!build.publish_directory(old, output)) {
            build.report(RuntimeJoin(["sdk: changed prior generation retained at ", old]));
            return false;
        }
        files.RemoveTree(stage);
        return false;
    }
    if (build.publish_directory(prepared, output)) {
        return files.RemoveTree(stage);
    }
    if (previous != "" && !build.publish_directory(old, output)) {
        build.report(RuntimeJoin(["sdk: rollback failed; prior generation retained at ", old]));
        return false;
    }
    files.RemoveTree(stage);
    return false;
}

RuntimeExtend :: (object: string, added_keys: string[], added_values: string[]) -> string {
    keys: string[] = [];
    values: string[] = [];
    for (field in sdk.JsonFields(object)) {
        keys.append(field.key);
        values.append(field.value);
    }
    keys.extend(added_keys);
    values.extend(added_values);
    return sdk.JsonObject(keys, values);
}

RuntimeArchiveInstallation :: (evidence: string, files: string) -> string {
    archives := sdk.JsonGet(evidence, "archives");
    keys: string[] = [];
    values: string[] = [];
    for (field in sdk.JsonFields(archives)) {
        archive := field.key;
        destination := RuntimeJoin(["lib/", strings.BaseName(archive)]);
        if (field.value != sdk.JsonGet(sdk.JsonGet(files, destination), "sha256")) {
            return RuntimeFail(RuntimeJoin(["installed archive differs from graph evidence: ", destination]));
        }
        keys.append(archive);
        values.append(sdk.JsonObject(["path"], [sdk.JsonQuote(destination)]));
    }
    return sdk.JsonObject(keys, values);
}

RuntimeManifest :: (stage: string, evidence: string, source: string) -> string {
    configured := sdk.JsonGet(evidence, "configured_engine");
    document := sdk.JsonGet(configured, "document");
    configuration := sdk.JsonGet(evidence, "runtime_build");
    profile := sdk.JsonGet(configuration, "profile");
    formats := sdk.JsonGet(document, "artifact_formats");
    engine_id := build.hash_text(evidence);
    engine_manifest := RuntimeExtend(document, ["manifest_format", "build_id"], ["1", sdk.JsonQuote(engine_id)]);
    if (engine_manifest == "" || !build.make_directory(RuntimeJoin([stage, "/share/chibi"])) ||
        !build.write_file(RuntimeJoin([stage, "/share/chibi/engine.json"]), RuntimeJoin([engine_manifest, "\n"]))) {
        return RuntimeFail("cannot write engine manifest");
    }
    files := RuntimeFiles(stage, "");
    if (files == "") {
        return "";
    }
    archives := RuntimeArchiveInstallation(evidence, files);
    executable := sdk.JsonGet(sdk.JsonGet(evidence, "executables"), "chibi-player");
    if (archives == "" || sdk.JsonGet(executable, "sha256") !=
        sdk.JsonGet(sdk.JsonGet(files, "bin/chibi-player"), "sha256")) {
        return RuntimeFail("installed player differs from graph evidence");
    }
    requirements := sdk.JsonObject(
        ["c_standard", "prepared_format", "artifact_formats", "project_format", "system", "processor",
         "pointer_bits", "byte_order", "public_headers_sha256", "runtime_headers_sha256"],
        ["23", sdk.JsonGet(sdk.JsonGet(formats, "execution"), "version"), formats,
         sdk.JsonGet(document, "project_version"), sdk.JsonGet(configuration, "system"),
         sdk.JsonGet(configuration, "processor"), sdk.JsonGet(configuration, "pointer_bits"),
         sdk.JsonGet(configuration, "byte_order"), sdk.JsonQuote(RuntimeHeaderHashes(files, false)),
         sdk.JsonQuote(RuntimeHeaderHashes(files, true))]);
    build_manifest := sdk.JsonObject(
        ["inputs", "archive_installation", "configuration", "compiler_id", "compiler_version",
         "compiler_target", "c_flags", "configuration_c_flags", "native_backend"],
        [evidence, archives, sdk.JsonGet(profile, "build_type"), sdk.JsonGet(profile, "compiler_id"),
         sdk.JsonGet(configuration, "compiler_version"), "null",
         sdk.JsonQuote(""), sdk.JsonQuote(""), "true"]);
    targets: string[] = [];
    for (name in sdk.RuntimeTargets()) {
        targets.append(sdk.JsonQuote(RuntimeJoin(["Chibi::", name])));
    }
    manifest := sdk.JsonObject(
        ["manifest_format", "kind", "package_version", "engine", "source", "files", "targets",
         "products", "private_tools", "requirements", "build"],
        ["1", sdk.JsonQuote("runtime"), sdk.JsonGet(document, "sdk_version"),
         sdk.JsonObject(["manifest", "build_id"], [sdk.JsonQuote("share/chibi/engine.json"), sdk.JsonQuote(engine_id)]),
         source, files, sdk.JsonArray(targets), "{\"chibi-player\":\"bin/chibi-player\"}", "{}",
         requirements, build_manifest]);
    if (manifest == "") {
        return RuntimeFail("invalid package manifest fields");
    }
    return RuntimeExtend(manifest, ["build_id"], [sdk.JsonQuote(build.hash_text(manifest))]);
}

RuntimeInputTree :: (path: string, headers_only: bool) -> string {
    kind := build.file_kind(path);
    if (kind == "file") {
        hash := build.hash_file(path);
        if (hash == "") {
            return "";
        }
        return sdk.JsonQuote(hash);
    }
    if (kind != "directory") {
        return "";
    }
    keys: string[] = [];
    values: string[] = [];
    for (name in build.list_directory(path)) {
        child := RuntimeJoin([path, "/", name]);
        if (headers_only && build.file_kind(child) == "file" && !sdk.VendorHeader(child)) {
            continue;
        }
        value := RuntimeInputTree(child, headers_only);
        if (value == "") {
            return "";
        }
        keys.append(name);
        values.append(value);
    }
    return sdk.JsonObject(keys, values);
}

RuntimeInputIdentity :: (entries: string[]) -> string {
    keys: string[] = [];
    values: string[] = [];
    for (item in entries) {
        destination := build.before(item, "=");
        value := RuntimeInputTree(build.after(item, "="), strings.HasPrefix(destination, "include/chibi/vendor/"));
        if (value == "") {
            return RuntimeFail(RuntimeJoin(["invalid distribution input: ", build.after(item, "=")]));
        }
        keys.append(destination);
        values.append(value);
    }
    return sdk.JsonObject(keys, values);
}

RuntimeAssemble :: (root: string, build_dir: string, third_party: string, output: string) -> int {
    if (!sdk.Supported(build.platform())) {
        RuntimeFail("runtime graph installation is unavailable on this platform");
        return 2;
    }
    if (!strings.HasPrefix(build_dir, "/") || !strings.HasPrefix(third_party, "/") ||
        !strings.HasPrefix(output, "/") || strings.HasSuffix(output, "/") ||
        strings.HasSuffix(output, "/.") || strings.HasSuffix(output, "/..")) {
        RuntimeFail("--build, --third-party and --output must be absolute; output must name a package");
        return 2;
    }
    root = files.CanonicalPath(root);
    build_dir = files.CanonicalPath(build_dir);
    third_party = files.CanonicalPath(third_party);
    output = files.CanonicalPath(output);
    if (root == "" || build_dir == "" || third_party == "" || output == "" ||
        root == output || strings.HasPrefix(root, RuntimeJoin([output, "/"])) ||
        build_dir == output || strings.HasPrefix(output, RuntimeJoin([build_dir, "/"])) ||
        strings.HasPrefix(build_dir, RuntimeJoin([output, "/"]))) {
        RuntimeFail("package output overlaps source/build ancestry");
        return 2;
    }
    previous := "";
    if (build.file_kind(output) != "") {
        previous = RuntimeVerify(output);
        if (previous == "") {
            RuntimeFail("existing output is not a verified runtime package");
            return 2;
        }
    }
    stage := files.CanonicalPath(RuntimeJoin([output, ".chibi-stage"]));
    if (stage == "") {
        RuntimeFail("invalid staging directory ancestor");
        return 2;
    }
    entries := RuntimeEntries(root, build_dir, third_party);
    for (item in entries) {
        input := build.after(item, "=");
        if (!RuntimePath(build.before(item, "=")) ||
            (build.file_kind(input) == "directory" && (files.Inside(output, input) || files.Inside(stage, input)))) {
            RuntimeFail("output or staging overlaps a distribution input");
            return 2;
        }
    }
    evidence := sdk.GraphEvidence(root, build_dir, third_party);
    source := RuntimeSourceIdentity(root);
    inputs := RuntimeInputIdentity(entries);
    if (evidence == "" || source == "" || inputs == "") {
        return 1;
    }
    if (!build.make_directory(files.Parent(output)) || !build.reserve_directory(stage)) {
        RuntimeFail("cannot reserve staging directory; existing staging is preserved");
        return 1;
    }
    prepared := RuntimeJoin([stage, "/package"]);
    copied := build.make_directory(prepared);
    for (item in entries) {
        destination := build.before(item, "=");
        if (copied) {
            copied = RuntimeCopy(build.after(item, "="), RuntimeJoin([prepared, "/", destination]),
                                 strings.HasPrefix(destination, "include/chibi/vendor/"));
        }
    }
    manifest := "";
    if (copied && RuntimeExports(prepared, engine.SDKVersion(root))) {
        manifest = RuntimeManifest(prepared, evidence, source);
    }
    if (manifest == "" || !build.write_file(RuntimeJoin([prepared, "/share/chibi/package.json"]), RuntimeJoin([manifest, "\n"])) ||
        RuntimeVerify(prepared) != manifest || sdk.GraphEvidence(root, build_dir, third_party) != evidence ||
        RuntimeSourceIdentity(root) != source || RuntimeInputIdentity(entries) != inputs ||
        (previous == "" && build.file_kind(output) != "") ||
        (previous != "" && RuntimeVerify(output) != previous)) {
        files.RemoveTree(stage);
        RuntimeFail("runtime package preparation failed; output preserved");
        return 1;
    }
    if (!RuntimePublish(stage, output, previous)) {
        RuntimeFail("runtime package publication failed");
        return 1;
    }
    build.report(RuntimeJoin(["sdk: installed runtime at ", output]));
    return 0;
}

RuntimePackage :: () -> int {
    arguments := build.arguments();
    for (index in 0..<length(arguments)) {
        if (index % 2 == 0 && (arguments[index] != "--build" && arguments[index] != "--third-party" &&
                               arguments[index] != "--output")) {
            RuntimeFail("unknown runtime package option");
            return 2;
        }
    }
    if (length(arguments) != 6) {
        RuntimeFail("runtime package requires --build, --third-party and --output");
        return 2;
    }
    return RuntimeAssemble(build.root(), RuntimeOption(arguments, "--build"), RuntimeOption(arguments, "--third-party"),
                           RuntimeOption(arguments, "--output"));
}
