package engine

import c "graph:c"
import strings "core:strings"

// Builds the engine's libraries, which Targets.chibi describes, with the C
// graph. Each matches the target of the same name in sdk/CMakeLists.txt; the
// build-graph route compares their compile commands with CMake's.

// A build configuration: what root CMakeLists.txt reads from its cache.
pub Profile :: struct {
    compiler: string;
    // Clang, AppleClang or GNU, as CMake identifies the compiler.
    compiler_id: string;
    // Debug, Release, RelWithDebInfo or MinSizeRel.
    build_type: string;
    architecture: string;
    sysroot: string;
    warnings: bool;
    // Sanitizers to enable, such as address,undefined; empty for none.
    sanitizers: string;
    // The directory debug info names for a ccache build, or empty.
    debug_compilation_dir: string;
    // libclang, which the reflection tool links: its headers, its library and
    // the builtin headers of the clang it belongs to.
    libclang_include: string;
    libclang_library: string;
    clang_resource_include: string;
    // The unpacked third-party archive the profile builds with, as
    // cmake/third_party.cmake picks it (ThirdParty); `third-party/` paths are
    // below it.
    third_party: string;
}

// The builtin headers of the clang that a libclang belongs to, as
// tools/reflect/resource.cmake finds them: that clang's resource directory.
// Empty when it has none.
pub ClangResourceInclude :: (libclang_library: string) -> string {
    library_dir := strings.Slice(libclang_library, 0, strings.LastIndex(libclang_library, "/"));
    clang := Join([library_dir, "/../bin/clang"]);
    if (!build.file_exists(clang) || build.probe([clang, "-print-resource-dir"]) != 0) {
        return "";
    }
    include := Join([strings.TrimSpace(build.last_stdout()), "/include"]);
    if (!build.file_exists(Join([include, "/stdbool.h"]))) {
        return "";
    }
    return include;
}

// Flags the profile gives a target's compiles, after its defines.
ProfileFlags :: (target: string, profile: Profile) -> string[] {
    if (target == "reflect") {
        return [
            Join(["-DCHIBI_REFLECT_RESOURCE_INCLUDE_DIR=\"", profile.clang_resource_include, "\""]),
            Join(["-I", profile.libclang_include])
        ];
    }
    return [];
}

// External libraries the profile gives an executable's link, first.
ProfileLibraries :: (target: string, profile: Profile) -> string[] {
    if (target == "reflect") {
        library_dir := strings.Slice(profile.libclang_library, 0, strings.LastIndex(profile.libclang_library, "/"));
        return [Join(["-Wl,-rpath,", library_dir]), profile.libclang_library];
    }
    return [];
}

pub Program :: (target: string) -> bool {
    for (program in Programs()) {
        if (program == target) {
            return true;
        }
    }
    return false;
}

// Where an executable is written: the build directory, as CMake writes the
// root project's.
pub Executable :: (build_dir: string, target: string) -> string {
    return Join([build_dir, "/", target]);
}

// What CMake gives an executable's link before its objects: the language
// flags, the platform's link flags and the sanitizers.
LinkFlags :: (profile: Profile, build_dir: string) -> string[] {
    flags: string[] = [];
    if (profile.debug_compilation_dir != "" &&
        (profile.build_type == "Debug" || profile.build_type == "RelWithDebInfo") && Clang(profile)) {
        flags.append(Join(["-fdebug-compilation-dir=", profile.debug_compilation_dir]));
    }
    flags.extend(BuildTypeFlags(profile.build_type));
    if (profile.architecture != "") {
        flags.extend(["-arch", profile.architecture]);
    }
    if (profile.sysroot != "") {
        flags.extend(["-isysroot", profile.sysroot]);
    }
    if (build.platform() == "Darwin") {
        flags.extend(["-Wl,-search_paths_first", "-Wl,-headerpad_max_install_names"]);
    }
    if (profile.sanitizers != "") {
        flags.append(Join(["-fsanitize=", profile.sanitizers]));
    }
    return flags;
}

// What an executable links after its output, in CMake's order: the profile's
// external libraries, the graph's archives, then system libraries.
LinkLibraries :: (source_root: string, build_dir: string, target: string, profile: Profile) -> string[] {
    libraries := ProfileLibraries(target, profile);
    for (linked in Links(target)) {
        libraries.append(Library(source_root, build_dir, profile.third_party, linked).output);
    }
    for (name in SystemLibraries(target)) {
        libraries.append(Join(["-l", name]));
    }
    return libraries;
}

Join :: (parts: string[]) -> string {
    return strings.Join(parts, "");
}

// The name a target's headers are published under, its CMake EXPORT_NAME.
pub Component :: (target: string) -> string {
    return strings.Slice(target, 6, strings.ByteLength(target) - 6);
}

// Where a target's public or private headers are staged.
pub HeaderRoot :: (build_dir: string, target: string, kind: string) -> string {
    return Join([build_dir, "/sdk/", kind, "/", Component(target)]);
}

pub Library :: (source_root: string, build_dir: string, third_party: string, target: string) -> c.Library {
    return {
        name: target,
        root: source_root,
        generated: Generated(build_dir),
        third_party: third_party,
        objects: Join([build_dir, "/objects/", target]),
        output: Join([build_dir, "/lib/lib", target, ".a"])
    };
}

// Where generated sources are written, as CMake writes them below sdk/.
pub Generated :: (build_dir: string) -> string {
    return Join([build_dir, "/sdk/generated"]);
}

// A path the tables name: below the third-party archive for a `third-party/`
// path, otherwise below the source root.
Resolve :: (source_root: string, third_party: string, path: string) -> string {
    if (strings.HasPrefix(path, "third-party/")) {
        return Join([third_party, "/", build.after(path, "/")]);
    }
    return Join([source_root, "/", path]);
}

// A target's sources: below the build's generated directory for a
// `generated/` entry, otherwise where Resolve finds them.
pub Sources :: (source_root: string, build_dir: string, third_party: string, target: string) -> string[] {
    sources: string[] = [];
    for (file in Files(target)) {
        if (strings.HasPrefix(file, "generated/")) {
            sources.append(Join([build_dir, "/sdk/", file]));
        } else {
            sources.append(Resolve(source_root, third_party, file));
        }
    }
    return sources;
}

// Writes each file a target embeds. An unchanged output keeps its stamp; a
// failure fails the program.
Embed :: (source_root: string, build_dir: string, target: string) {
    for (embed in Embeds(target)) {
        output := Join([build_dir, "/sdk/", build.before(embed, "=")]);
        rest := build.after(embed, "=");
        build.make_directory(strings.Slice(output, 0, strings.LastIndex(output, "/")));
        build.embed_file(Join([source_root, "/", build.after(rest, "=")]), output, build.before(rest, "="));
    }
}

// Where an include directory the tables name is: staged headers below the
// build's sdk directory, otherwise where Resolve finds it.
IncludeDirectory :: (source_root: string, build_dir: string, third_party: string, include: string) -> string {
    if (strings.HasPrefix(include, "public/") || strings.HasPrefix(include, "private/")) {
        return Join([build_dir, "/sdk/", include]);
    }
    return Resolve(source_root, third_party, include);
}

// Its defines, its include directories, then its system ones, the profile's
// flags, then its own options: the order CMake writes them.
pub CompileFlags :: (source_root: string, build_dir: string, target: string, profile: Profile) -> string[] {
    flags: string[] = [];
    for (define in Defines(target)) {
        flags.append(Join(["-D", define]));
    }
    flags.extend(ProfileFlags(target, profile));
    for (include in Includes(target)) {
        flags.append(Join(["-I", IncludeDirectory(source_root, build_dir, profile.third_party, include)]));
    }
    for (include in SystemIncludes(target)) {
        flags.extend(["-isystem", IncludeDirectory(source_root, build_dir, profile.third_party, include)]);
    }
    flags.extend(Flags(profile, build_dir));
    flags.extend(Options(target));
    return flags;
}

Clang :: (profile: Profile) -> bool {
    return profile.compiler_id == "Clang" || profile.compiler_id == "AppleClang";
}

// What CMake adds for each build type with Clang and GCC.
BuildTypeFlags :: (build_type: string) -> string[] {
    if (build_type == "Debug") {
        return ["-g"];
    }
    if (build_type == "Release") {
        return ["-O3", "-DNDEBUG"];
    }
    if (build_type == "RelWithDebInfo") {
        return ["-O2", "-g", "-DNDEBUG"];
    }
    if (build_type == "MinSizeRel") {
        return ["-Os", "-DNDEBUG"];
    }
    return [];
}

// The flags every C compile takes after its include directories, in the order
// root CMakeLists.txt and CMake's platform files give them.
pub Flags :: (profile: Profile, build_dir: string) -> string[] {
    flags: string[] = [];
    if (profile.debug_compilation_dir != "" &&
        (profile.build_type == "Debug" || profile.build_type == "RelWithDebInfo")) {
        if (Clang(profile)) {
            flags.append(Join(["-fdebug-compilation-dir=", profile.debug_compilation_dir]));
        } else if (profile.compiler_id == "GNU") {
            flags.append(Join(["-fdebug-prefix-map=", build_dir, "=", profile.debug_compilation_dir]));
        }
    }
    flags.extend(BuildTypeFlags(profile.build_type));
    flags.append("-std=gnu23");
    if (profile.architecture != "") {
        flags.extend(["-arch", profile.architecture]);
    }
    if (profile.sysroot != "") {
        flags.extend(["-isysroot", profile.sysroot]);
    }
    if (profile.warnings) {
        flags.extend([
            "-Wall", "-Wextra", "-Wpedantic", "-Werror", "-Wno-missing-field-initializers",
            "-Wno-unused-parameter", "-Wno-unused-function", "-Wno-unused-variable",
            "-Wno-zero-length-array", "-Wno-string-concatenation"
        ]);
    }
    if (profile.sanitizers != "") {
        flags.extend([Join(["-fsanitize=", profile.sanitizers]), "-fno-omit-frame-pointer"]);
    }
    if (Clang(profile)) {
        flags.append("-Wno-gnu-zero-variadic-macro-arguments");
    }
    return flags;
}

// The libraries whose headers the targets' compiles include: the targets, and
// each library a `public/NAME` or `private/NAME` include names.
Staged :: (targets: string[]) -> string[] {
    staged: string[] = [];
    for (target in targets) {
        staged = Add(staged, target);
        includes := Includes(target);
        includes.extend(SystemIncludes(target));
        for (include in includes) {
            if (strings.HasPrefix(include, "public/") || strings.HasPrefix(include, "private/")) {
                staged = Add(staged, Join(["chibi_", build.after(include, "/")]));
            }
        }
    }
    return staged;
}
// Whether building the targets reads the third-party archive: their sources
// or include directories are in it, or a library whose headers they stage
// publishes them from it.
pub NeedsThirdParty :: (targets: string[]) -> bool {
    paths: string[] = [];
    for (target in targets) {
        paths.extend(Files(target));
        paths.extend(Includes(target));
        paths.extend(SystemIncludes(target));
    }
    for (target in Staged(targets)) {
        paths.append(HeaderSource(target));
    }
    for (path in paths) {
        if (strings.HasPrefix(path, "third-party/")) {
            return true;
        }
    }
    return false;
}
Add :: (names: string[], name: string) -> string[] {
    for (present in names) {
        if (present == name) {
            return names;
        }
    }
    added := names;
    added.append(name);
    return added;
}

// Builds the selected targets: stages every one's headers, compiles what
// changed across all of them, at most `jobs` at once, then archives each in
// order. Compiles need only staged headers, so one target's compiles do not
// wait for another's archive. The number of sources compiled, or -1 on failure.
pub Build :: (tools: c.Tools, profile: Profile, source_root: string, build_dir: string, targets: string[]) -> int {
    source_dir := Join([source_root, "/src"]);
    for (target in targets) {
        Embed(source_root, build_dir, target);
    }
    for (target in Staged(targets)) {
        published := Resolve(source_root, profile.third_party, HeaderSource(target));
        if (!c.StageHeaders(published, PublicHeaders(target), HeaderRoot(build_dir, target, "public")) ||
            !c.StageHeaders(source_dir, PrivateHeaders(target), HeaderRoot(build_dir, target, "private"))) {
            build.report(Join(["graph: staging ", target, "'s headers failed"]));
            return -1;
        }
    }
    running: c.Running[] = [];
    waited := 0;
    failed := false;
    for (target in targets) {
        built := Library(source_root, build_dir, profile.third_party, target);
        flags := CompileFlags(source_root, build_dir, target, profile);
        for (source in Sources(source_root, build_dir, profile.third_party, target)) {
            if (failed || !c.Stale(tools, built, flags, source)) {
                continue;
            }
            running.append(c.Start(tools, built, flags, source));
            if (length(running) - waited >= tools.jobs) {
                failed = !c.Finish(running[waited]) || failed;
                waited += 1;
            }
        }
    }
    while (waited < length(running)) {
        failed = !c.Finish(running[waited]) || failed;
        waited += 1;
    }
    if (failed) {
        return -1;
    }
    for (target in targets) {
        if (length(Files(target)) == 0 || Program(target)) {
            continue;
        }
        compiled := false;
        for (compile in running) {
            compiled = compiled || compile.owner == target;
        }
        built := Library(source_root, build_dir, profile.third_party, target);
        if (!c.Archive(tools, built, Sources(source_root, build_dir, profile.third_party, target), compiled)) {
            build.report(Join(["graph: archiving ", target, " failed"]));
            return -1;
        }
    }
    for (target in targets) {
        if (!Program(target)) {
            continue;
        }
        built := Library(source_root, build_dir, profile.third_party, target);
        objects: string[] = [];
        for (source in Sources(source_root, build_dir, profile.third_party, target)) {
            objects.append(c.Object(built, source));
        }
        if (c.Link(tools, Executable(build_dir, target), objects, LinkFlags(profile, build_dir),
                   LinkLibraries(source_root, build_dir, target, profile)) < 0) {
            build.report(Join(["graph: linking ", target, " failed"]));
            return -1;
        }
    }
    return length(running);
}

// The compile commands of the selected targets as a compile_commands.json, as
// CMake exports its own.
pub CompileCommands :: (tools: c.Tools, profile: Profile, source_root: string, build_dir: string, targets: string[]) -> string {
    entries: string[] = [];
    for (target in targets) {
        built := Library(source_root, build_dir, profile.third_party, target);
        flags := CompileFlags(source_root, build_dir, target, profile);
        for (source in Sources(source_root, build_dir, profile.third_party, target)) {
            entries.append(c.CompileEntry(tools, built, flags, source));
        }
    }
    return Join(["[\n", strings.Join(entries, ",\n"), "\n]\n"]);
}
