behavior "Weapon" {
    macro AdvanceElapsed(elapsed: ref float, dt: double) {
        elapsed = cast<float>(cast<double>(elapsed) + dt)
    }
    state elapsed: float = 0.125
    action elapsed_dt = AdvanceElapsed(elapsed, delta)
    on Tick {
        if self.Aim.Manual {
            elapsed_dt()
        } else {
            if find_nearest_entity(self.Transform, 2000.0, 2, engine["Self"]()).Found {
                await set_aim_direction(convert<"transform_to_cf">(direction_to(self.Transform, convert<"transform_to_cf">(find_nearest_entity(self.Transform, 2000.0, 2, engine["Self"]()).Position))))
                elapsed_dt()
            } else {
                elapsed_dt()
            }
        }
    }
    after elapsed_dt {
        if self.Aim.Firing {
            while greater_or_equal(elapsed, self.Weapon.Cooldown) {
                await "WeaponActions"."Fire Projectile"("position + offset"(self.Transform, transform_visual_offset({
        x: 16.0,
        y: 0.0
    }, 0.0, self.Orientation.Radians, {
        pitch: 0.0,
        yaw: 0.0,
        roll: 0.0,
        scale: 1.0
    }).Offset), self.Aim.Direction, self.Weapon.Damage, "Projectile", engine["Self"]())
                elapsed -= cast<double>(self.Weapon.Cooldown)
            }
        } else {
            elapsed = min(elapsed, cast<double>(self.Weapon.Cooldown))
        }
    }
    pure function "position + offset"<T0: struct<"CF_V2">, T1: struct<"CF_V2">, T2: struct<"CF_V2">>(position: T0 = null, offset: T1 = null) -> (Result: T2 = null) {
        return add(entry.position, entry.offset)
    }
}
