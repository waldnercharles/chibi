-        if (produces && i->op != BF_CONTEXT && i->op != BF_INDEX && !scalar(i->type)) {
-            return false;
-        }
-        if (lhs && i->op != BF_INDEX && i->op != BF_WRITE &&
-            kinds[i->left] != BEHAVIOR_VALUE) {
