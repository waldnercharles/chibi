package scalar_facts

// Internal opt-in owned result for one source document holding a bounded,
// acyclic set of ordinary pure functions over int and bool. Each function's
// whole body returns a literal, a parameter or a direct call of another
// function of the set, whose arguments are such expressions. This is not a
// general IR, and no compiler-private identity crosses this boundary.
//
// The compiler host passes arrays of flat records, so a module is one array
// of rows. Row 0 is its Source: `name` is the path and `text` the document.
// A rejected module has exactly one more row, its Rejection: `text` is the
// diagnostic's message and the range is its source. Nothing else survives
// a rejection, and it must never be emitted.
//
// An accepted module's row 1 is its Document: `name` is the shared source
// snapshot's document key. Then each function follows in declaration order;
// the first is the module's entry and takes no parameters and returns int:
// - a Function row: its `name`, result `type`, `count` parameters and
//   declaration range;
// - `count` Parameter rows: `name`, `type`, ordinal `value`, name range;
// - a Return row: the return statement's range and the `count` operand rows
//   that follow it;
// - operand rows in evaluation order, each after the operands it consumes:
//   a Literal's `value` is the integer, or 0 and 1 for false and true; a
//   Read's `value` is its parameter's ordinal; a Call's `value` is its
//   callee's function ordinal, `name` its callee's name and `count` its
//   arguments, the `count` most recent unconsumed operands in argument order.
//   The last operand is the function's returned value.
//
// Ranges are half-open source-byte offsets into the source text; lines and
// columns are one-based source-byte positions. Fields a row does not use are
// zero or empty. The rows own their strings: a host snapshot of the array is
// the retained result, not a view into the producer's invocation.
pub Row :: struct {
    kind: int;
    type: int;
    value: int;
    count: int;
    name: string;
    text: string;
    start: int;
    end: int;
    line: int;
    column: int;
}

pub SourceRow: int : 0;
pub RejectionRow: int : 1;
pub DocumentRow: int : 2;
pub FunctionRow: int : 3;
pub ParameterRow: int : 4;
pub ReturnRow: int : 5;
pub LiteralRow: int : 6;
pub ReadRow: int : 7;
pub CallRow: int : 8;

pub IntType: int : 1;
pub BoolType: int : 2;

// Bounds both sides check before reading counts: source bytes, functions per
// module, parameters per function and operands per return.
pub MaxSource: int : 16384;
pub MaxFunctions: int : 32;
pub MaxParameters: int : 8;
pub MaxOperands: int : 64;
