            <div class="node" id="learn" style="left: 236dp; top: 116dp;" data-event-click="emit('Learn', 7)" data-class-owned="self.n7 == 2" data-class-open="self.n7 == 1" data-class-poor="self.a7 == 0">
              <div class="ring"><div class="val">+60</div><div class="tag">Magnet</div></div>
              <div class="tip" style="left: -114dp;">
                <div class="tname">Scrap Magnet</div>
