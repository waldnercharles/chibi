behavior "WaveBehavior" {
    self.CountLimit: int = 8
    Interval: float = 1.5
    SpawnDistance: float = 260.0
    Elapsed: float = 0.0
    Spawned: int = 0
    Side: float = -1.0
    on Tick {
        if find_nearest_entity(self.Transform, 1000000.0, 1, engine["Self"]()).Found {
            self."Elapsed" = self."Elapsed" + delta_time()
            await "Spawn Within Wave Limit"(find_nearest_entity(self.Transform, 1000000.0, 1, engine["Self"]()).Position)
        }
    }
    "Spawn Within Wave Limit" :: fn("Player Position": struct<"CF_V2"> = null) {
        after entry {
            while self."Elapsed" >= max(self."Interval", B: float = 0.01) {
                if self."Spawned" >= self."CountLimit" {
                    return
                } else {
                    self."Elapsed" = self."Elapsed" - max(self."Interval", B: float = 0.01)
                    await "Spawn Enemy"(entry."Player Position")
                    self."Spawned" = add(self."Spawned", B: int = 1)
                    self."Side" = self."Side" * -1.0
                }
            }
            return
        }
    }
    "Spawn Enemy" :: fn("Player Position": struct<"CF_V2"> = null) {
        action spawn_prototype = engine["Spawn Prototype"]("Enemy")
        after entry {
            spawn_prototype()
        }
        after spawn_prototype {
            spawn_prototype.Entity.Transform = make_transform(entry."Player Position".x + self."Side" * self."SpawnDistance", entry."Player Position".y)
            return
        }
    }
}
