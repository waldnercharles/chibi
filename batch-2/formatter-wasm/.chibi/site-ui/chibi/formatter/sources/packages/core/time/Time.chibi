package time

// A duration is a value measured in nanoseconds. Converting it to floating
// units can round; nanosecond units do not describe a clock's resolution.
pub Duration :: struct {
    nanoseconds: i64;
}

// A process-local clock snapshot. Only compare samples from the same domain.
// It has no wall-clock epoch and owns no host resource.
pub Instant :: struct {
    nanoseconds: i64;
    domain: u64;
}

pub Nanoseconds :: (duration: Duration) -> i64 {
    return duration.nanoseconds;
}

pub Seconds :: (duration: Duration) -> f64 {
    return f64(duration.nanoseconds) / 1000000000.0;
}
