-                !(f && f->readonly_collections &&
-                  behavior_function_borrow_argument(f, context, &source[i], &lent));
-    }
-    if (!held) {
-        return NULL;
-    }
-    if (!storage) {
-        return "Value arguments require invocation storage";
-    }
