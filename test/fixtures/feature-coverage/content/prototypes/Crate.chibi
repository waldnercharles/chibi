package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Crate")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Body", data.Object([])),
                data.Field.Named("Collider", data.Object([
                    data.Field.Named("category", data.Value.UInt(1)),
                    data.Field.Named("height", data.Value.Real(32.0)),
                    data.Field.Named("mask", data.Value.UInt(1)),
                    data.Field.Named("shape", data.Value.Text("Box")),
                    data.Field.Named("width", data.Value.Real(32.0))
                ])),
                data.Field.Named("Destructible", data.Object([
                    data.Field.Named("cell_size", data.Value.Real(4.0)),
                    data.Field.Named("min_fragment_cells", data.Value.UInt(2))
                ])),
                data.Field.Named("Heat", data.Object([
                    data.Field.Named("level", data.Value.Real(1.0)),
                    data.Field.Named("rate", data.Value.Real(0.5))
                ])),
                data.Field.Named("Material", data.Object([])),
                data.Field.Named("Sprite", data.Object([
                    data.Field.Named("frame", data.Value.UInt(1)),
                    data.Field.Named("frame_height", data.Value.UInt(16)),
                    data.Field.Named("frame_width", data.Value.UInt(16)),
                    data.Field.Named("image", data.Value.Text("content/images/props.png")),
                    data.Field.Named("layer", data.Value.UInt(1))
                ])),
                data.Field.Named("Transform", data.Object([]))
            ]))
        ])
    );
}
