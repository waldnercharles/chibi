package native_value_probe

import native "project:llvm_native"
import abi "project:native_abi"
import link "project:native_link"
import host "project:native_link_host"
import os "core:os"
import strings "core:strings"

Op :: (op: int, type: int, output: int, left: int, right: int, literal: i64) -> native.Instruction {
    return {op: op, type: type, output: output, left: left, right: right, target: 0, literal: literal};
}
// Each generated operation has one output slot. The test inspects live
// values after destructive changes, independently of source copy lowering.
Value :: (code: ^(native.Instruction[]), slots: ^(int[]), op: int, type: int, left: int, right: int, target: int, literal: i64) -> int {
    slot := length(slots^);
    slots.append(type);
    item := Op(op, type, slot, left, right, literal);
    item.target = target;
    code.append(item);
    return slot;
}
Expected :: (code: ^(native.Instruction[]), slots: ^(int[]), status: int, actual: int, expected: int) -> int {
    constant := Value(code, slots, native.Constant, abi.IntStorage, 0, 0, 0, i64(expected));
    difference := Value(code, slots, native.Sub, abi.IntStorage, actual, constant, 0, 0);
    return Value(code, slots, native.BitOr, abi.IntStorage, status, difference, 0, 0);
}
ArrayBacking :: (code: ^(native.Instruction[]), slots: ^(int[]), status: int) -> int {
    array := native.ArrayType + abi.IntStorage;
    empty := Value(code, slots, native.Constant, array, 0, 0, 0, 0);
    seven := Value(code, slots, native.Constant, abi.IntStorage, 0, 0, 0, 7);
    original := Value(code, slots, native.ArrayPush, array, empty, seven, 0, 1);
    shared := Value(code, slots, native.ValueCopy, array, original, 0, 0, 0);
    zero := Value(code, slots, native.Constant, abi.IntStorage, 0, 0, 0, 0);
    nine := Value(code, slots, native.Constant, abi.IntStorage, 0, 0, 0, 9);
    changed := Value(code, slots, native.ArraySet, array, shared, zero, nine, 0);
    before := Value(code, slots, native.ArrayGet, abi.IntStorage, original, zero, 0, 0);
    checked := Expected(code, slots, status, before, 7);
    pair := Value(code, slots, native.ArrayPush, array, changed, seven, 0, 1);
    pair_copy := Value(code, slots, native.ValueCopy, array, pair, 0, 0, 0);
    removed := Value(code, slots, native.ArrayRemove, array, pair_copy, zero, 0, 0);
    first := Value(code, slots, native.ArrayGet, abi.IntStorage, pair, zero, 0, 0);
    checked = Expected(code, slots, checked, first, 9);
    remaining := Value(code, slots, native.ArrayGet, abi.IntStorage, removed, zero, 0, 0);
    checked = Expected(code, slots, checked, remaining, 7);
    pair_copy = Value(code, slots, native.ValueCopy, array, pair, 0, 0, 0);
    four := Value(code, slots, native.ArrayExtend, array, pair_copy, pair, 0, 1);
    // Self-extension grows while its old buffer is also the source.
    eight := Value(code, slots, native.ArrayExtend, array, four, four, 0, 1);
    eight_copy := Value(code, slots, native.ValueCopy, array, eight, 0, 0, 0);
    longer := Value(code, slots, native.ArrayPush, array, eight_copy, seven, 0, 1);
    length := Value(code, slots, native.ArrayLength, abi.IntStorage, eight, 0, 0, 0);
    checked = Expected(code, slots, checked, length, 8);
    last := Value(code, slots, native.Constant, abi.IntStorage, 0, 0, 0, 8);
    added := Value(code, slots, native.ArrayGet, abi.IntStorage, longer, last, 0, 0);
    checked = Expected(code, slots, checked, added, 7);
    for (held in [original, pair, removed, eight, longer]) {
        code.append(Op(native.ValueDrop, array, 0, held, 0, 0));
    }
    return checked;
}
PointerLoan :: (code: ^(native.Instruction[]), slots: ^(int[]), arguments: ^(int[]), input: int, address: int, mode: int, status: int, expected: int) -> int {
    array := native.ArrayType + abi.IntStorage;
    right := input;
    if (mode == 0) { right = address; }
    held := Value(code, slots, native.ArrayLoan, array, input, right, mode, 0);
    begin := length(arguments^);
    arguments.append(held);
    result := Value(code, slots, native.ForeignCall, abi.IntStorage, 0, begin, 1, 1);
    checked := Expected(code, slots, status, result, expected);
    code.append(Op(native.ValueDrop, array, 0, held, 0, 0));
    return checked;
}
// The two loans name the same canonical cell. A later logical copy must
// survive C's write, while both C pointers still name one detached buffer.
ForeignBacking :: (code: ^(native.Instruction[]), slots: ^(int[]), arguments: ^(int[]), status: int) -> int {
    array := native.ArrayType + abi.IntStorage;
    empty := Value(code, slots, native.Constant, array, 0, 0, 0, 0);
    seven := Value(code, slots, native.Constant, abi.IntStorage, 0, 0, 0, 7);
    original := Value(code, slots, native.ArrayPush, array, empty, seven, 0, 1);
    code.append({op: native.Save, type: array, output: 0, left: original, right: 0, target: 0, literal: 0});
    address := Value(code, slots, native.LocalAddress, native.RefType + array, 0, 0, 0, 0);
    captured := Value(code, slots, native.Deref, array, address, 0, 0, 0);
    first := Value(code, slots, native.ArrayLoan, array, captured, address, 0, 0);
    second := Value(code, slots, native.ArrayLoan, array, captured, address, 0, 0);
    later := Value(code, slots, native.ValueCopy, array, captured, 0, 0, 0);
    begin := length(arguments^);
    arguments.extend([first, second]);
    result := Value(code, slots, native.ForeignCall, abi.IntStorage, 0, begin, 2, 0);
    checked := Expected(code, slots, status, result, 9);
    code.append(Op(native.ValueDrop, array, 0, first, 0, 0));
    code.append(Op(native.ValueDrop, array, 0, second, 0, 0));
    canonical := Value(code, slots, native.Local, array, 0, 0, 0, 0);
    zero := Value(code, slots, native.Constant, abi.IntStorage, 0, 0, 0, 0);
    readback := Value(code, slots, native.ArrayGet, abi.IntStorage, canonical, zero, 0, 0);
    checked = Expected(code, slots, checked, readback, 9);
    copied := Value(code, slots, native.ArrayGet, abi.IntStorage, later, zero, 0, 0);
    checked = Expected(code, slots, checked, copied, 7);
    code.append(Op(native.ValueDrop, array, 0, canonical, 0, 0));
    code.append(Op(native.ValueDrop, array, 0, later, 0, 0));
    // Explicit native ArrayCopy keeps its physical clone contract for raw
    // foreign callers that do not carry source-level writable-place loans.
    raw := Value(code, slots, native.ArrayPush, array, empty, seven, 0, 1);
    cloned := Value(code, slots, native.ArrayCopy, array, raw, 0, 0, 0);
    begin = length(arguments^);
    arguments.extend([cloned, raw]);
    raw_result := Value(code, slots, native.ForeignCall, abi.IntStorage, 0, begin, 2, 0);
    checked = Expected(code, slots, checked, raw_result, 7);
    changed_raw := Value(code, slots, native.ArrayGet, abi.IntStorage, cloned, zero, 0, 0);
    checked = Expected(code, slots, checked, changed_raw, 9);
    code.append(Op(native.ValueDrop, array, 0, cloned, 0, 0));
    code.append(Op(native.ValueDrop, array, 0, raw, 0, 0));
    // Zero descriptors remain C null pointers. An allocated zero-length
    // value with spare capacity remains a nonnull buffer, including a shared one.
    unbacked := Value(code, slots, native.Constant, array, 0, 0, 0, 0);
    checked = PointerLoan(code, slots, arguments, unbacked, 0, 1, checked, 1);
    checked = PointerLoan(code, slots, arguments, unbacked, 0, 2, checked, 1);
    code.append({op: native.Save, type: array, output: 0, left: unbacked, right: 0, target: 0, literal: 0});
    current_zero := Value(code, slots, native.Deref, array, address, 0, 0, 0);
    checked = PointerLoan(code, slots, arguments, current_zero, address, 0, checked, 1);
    allocated := Value(code, slots, native.ArrayPush, array, unbacked, seven, 0, 1);
    backed := Value(code, slots, native.ArrayRemove, array, allocated, zero, 0, 0);
    backed_copy := Value(code, slots, native.ValueCopy, array, backed, 0, 0, 0);
    checked = PointerLoan(code, slots, arguments, backed_copy, 0, 1, checked, 0);
    code.append(Op(native.ValueDrop, array, 0, backed, 0, 0));
    return checked;
}
Main :: () -> int {
    arguments := os.Arguments();
    if (length(arguments) != 3) { return 2; }
    work := arguments[0];
    llvm := arguments[1];
    audit := os.ReadText(arguments[2]);
    if (audit.error) { return 2; }
    code := [Op(native.Check, 0, 0, 0, 0, 0),
             Op(native.Constant, native.RecordType, 0, 0, 0, 0),
             Op(native.Constant, native.ArrayType + abi.ByteStorage, 1, 0, 0, 0),
             Op(native.Constant, abi.ByteStorage, 2, 0, 0, 65),
             Op(native.ArrayPush, native.ArrayType + abi.ByteStorage, 3, 1, 2, 1),
             Op(native.ArrayText, abi.TextStorage, 4, 3, 0, 0),
             Op(native.ArrayDrop, native.ArrayType + abi.ByteStorage, 0, 3, 0, 0),
             Op(native.Insert, native.RecordType, 5, 0, 4, 0),
             Op(native.ValueCopy, native.RecordType, 6, 5, 0, 0),
             Op(native.ValueDrop, native.RecordType, 0, 5, 0, 0),
             Op(native.Extract, abi.TextStorage, 7, 6, native.RecordType, 0),
             Op(native.Constant, abi.IntStorage, 8, 0, 0, 0),
             Op(native.TextByte, abi.IntStorage, 9, 7, 8, 0),
             Op(native.ValueCopy, native.RecordType, 12, 6, 0, 0),
             Op(native.Constant, native.ArrayType + native.RecordType, 13, 0, 0, 0),
             Op(native.ArrayPush, native.ArrayType + native.RecordType, 14, 13, 12, 1),
             Op(native.ValueCopy, native.ArrayType + native.RecordType, 15, 14, 0, 0),
             Op(native.ArrayDrop, native.ArrayType + native.RecordType, 0, 14, 0, 0),
             Op(native.ArrayGet, native.RecordType, 16, 15, 8, 0),
             Op(native.Extract, abi.TextStorage, 17, 16, native.RecordType, 0),
             Op(native.TextByte, abi.IntStorage, 18, 17, 8, 0),
             Op(native.ArrayDrop, native.ArrayType + native.RecordType, 0, 15, 0, 0),
             Op(native.ValueDrop, native.RecordType, 0, 6, 0, 0),
             Op(native.Constant, abi.IntStorage, 10, 0, 0, 65),
             Op(native.Sub, abi.IntStorage, 11, 18, 10, 0),
             Op(native.Publish, abi.IntStorage, 0, 11, 0, 0),
             Op(native.Return, 0, 0, 0, 0, 0)];
    function: native.Function = {result: abi.IntStorage, first_parameter: 0, parameters: 0, first_slot: 0,
        slots: 19, first_local: 0, locals: 0, first_code: 0, code: length(code), first_argument: 0, arguments: 0};
    slots := [native.RecordType, native.ArrayType + abi.ByteStorage, abi.ByteStorage, native.ArrayType + abi.ByteStorage,
              abi.TextStorage, native.RecordType, native.RecordType, abi.TextStorage,
              abi.IntStorage, abi.IntStorage, abi.IntStorage, abi.IntStorage,
              native.RecordType, native.ArrayType + native.RecordType, native.ArrayType + native.RecordType,
              native.ArrayType + native.RecordType, native.RecordType, abi.TextStorage, abi.IntStorage];
    code = slice(code, 0, length(code) - 2);
    status := ArrayBacking(&code, &slots, 11);
    foreign_arguments: int[] = [];
    status = ForeignBacking(&code, &slots, &foreign_arguments, status);
    code.append(Op(native.Publish, abi.IntStorage, 0, status, 0, 0));
    code.append(Op(native.Return, 0, 0, 0, 0, 0));
    function.slots = length(slots);
    function.code = length(code);
    function.locals = 1;
    function.arguments = length(foreign_arguments);
    // A raw ABI input has no native owner. Import it before mutation and
    // never release its caller-owned memory through the native allocator.
    array := native.ArrayType + abi.IntStorage;
    borrowed: native.Function = {result: abi.IntStorage, first_parameter: 0, parameters: 1,
        first_slot: length(slots), slots: 8, first_local: 1, locals: 0,
        first_code: length(code), code: 12, first_argument: length(foreign_arguments), arguments: 0};
    code.extend([Op(native.Check, 0, 0, 0, 0, 0), Op(native.Argument, array, 0, 0, 0, 0),
        Op(native.ValueCopy, array, 1, 0, 0, 0), Op(native.Constant, abi.IntStorage, 2, 0, 0, 0),
        Op(native.Constant, abi.IntStorage, 3, 0, 0, 99),
        {op: native.ArraySet, type: array, output: 4, left: 1, right: 2, target: 3, literal: 0},
        Op(native.ValueDrop, array, 0, 4, 0, 0), Op(native.ArrayDrop, array, 0, 0, 0, 0),
        Op(native.ArrayGet, abi.IntStorage, 5, 0, 2, 0), Op(native.Constant, abi.IntStorage, 6, 0, 0, 7),
        Op(native.Sub, abi.IntStorage, 7, 5, 6, 0), Op(native.Publish, abi.IntStorage, 0, 7, 0, 0),
        Op(native.Return, 0, 0, 0, 0, 0)]);
    borrowed.code = length(code) - borrowed.first_code;
    slots.extend([array, array, abi.IntStorage, abi.IntStorage, array, abi.IntStorage, abi.IntStorage, abi.IntStorage]);
    // A writable loan of unique storage keeps spare capacity. The compiler
    // uses this path for array fields whose enclosing record owns the buffer.
    loan: native.Function = {result: array, first_parameter: 1, parameters: 1,
        first_slot: length(slots), slots: 4, first_local: 1, locals: 0,
        first_code: length(code), code: 7, first_argument: length(foreign_arguments), arguments: 0};
    code.extend([Op(native.Check, 0, 0, 0, 0, 0), Op(native.Argument, array, 0, 0, 0, 0),
        Op(native.Constant, abi.IntStorage, 1, 0, 0, 7),
        Op(native.ArrayPush, array, 2, 0, 1, 0), Op(native.ArrayPush, array, 3, 2, 1, 0),
        Op(native.Publish, array, 0, 3, 0, 0), Op(native.Return, 0, 0, 0, 0, 0)]);
    slots.extend([array, abi.IntStorage, array, array]);
    // Copying an aggregate must store an imported array descriptor back
    // into the copied field. Keeping only its original borrowed bits leaks
    // the import and fails to isolate the caller's memory.
    record_type := native.RecordType + 1;
    record_input: native.Function = {result: abi.IntStorage, first_parameter: 2, parameters: 1,
        first_slot: length(slots), slots: 13, first_local: 1, locals: 0,
        first_code: length(code), code: 18, first_argument: length(foreign_arguments), arguments: 0};
    code.extend([Op(native.Check, 0, 0, 0, 0, 0), Op(native.Argument, record_type, 0, 0, 0, 0),
        Op(native.ValueCopy, record_type, 1, 0, 0, 0), Op(native.Extract, array, 2, 1, record_type, 0),
        Op(native.Constant, abi.IntStorage, 3, 0, 0, 0), Op(native.Constant, abi.IntStorage, 4, 0, 0, 99),
        {op: native.ArraySet, type: array, output: 5, left: 2, right: 3, target: 4, literal: 0},
        Op(native.ArrayGet, abi.IntStorage, 6, 5, 3, 0), Op(native.Extract, array, 7, 0, record_type, 0),
        Op(native.ArrayGet, abi.IntStorage, 8, 7, 3, 0), Op(native.Constant, abi.IntStorage, 9, 0, 0, 7),
        Op(native.Sub, abi.IntStorage, 10, 8, 9, 0), Op(native.Sub, abi.IntStorage, 11, 6, 4, 0),
        Op(native.BitOr, abi.IntStorage, 12, 10, 11, 0), Op(native.ValueDrop, record_type, 0, 1, 0, 0),
        Op(native.ValueDrop, record_type, 0, 0, 0, 0), Op(native.Publish, abi.IntStorage, 0, 12, 0, 0),
        Op(native.Return, 0, 0, 0, 0, 0)]);
    slots.extend([record_type, record_type, array, abi.IntStorage, abi.IntStorage, array, abi.IntStorage,
                  array, abi.IntStorage, abi.IntStorage, abi.IntStorage, abi.IntStorage, abi.IntStorage]);
    functions := [function, borrowed, loan, record_input];
    parameters := [array, array, record_type];
    native_locals := [array];
    records: native.Record[] = [{first: 0, count: 1, identity: 0}, {first: 1, count: 1, identity: 0}];
    fields := [abi.TextStorage, array];
    source: native.Source = {file: "", directory: ""};
    empty: int[] = [];
    texts := ["chibi_value_probe_alias", "chibi_value_probe_pointer"];
    target := abi.LinuxX64();
    if (os.Platform() == "Darwin") { target = abi.MacOSArm64(); }
    rejected := code;
    wrong := rejected[8];
    wrong.left = 2;
    rejected[8] = wrong;
    switch native.Emit(target, functions, parameters, slots, native_locals, rejected, foreign_arguments, records, fields, texts,
                       source, [], empty, empty, false, 1) {
        case .Emitted(text): os.Print("native lifecycle accepted a scalar operand"); return 1;
        case .Rejected(instruction, message):
            if (!strings.Contains(message, "native value lifecycle requires")) { os.Print(message); return 1; }
    }
    text := "";
    switch native.Emit(target, functions, parameters, slots, native_locals, code, foreign_arguments, records, fields, texts,
                       source, [], empty, empty, false, 1) {
        case .Rejected(instruction, message): os.Print(message); return 1;
        case .Emitted(emitted): text = emitted;
    }
    module := format_text("{}/lifecycle.ll", work);
    start := format_text("{}/lifecycle-start.ll", work);
    text = strings.ReplaceAll(text, "define i32 @chibi_scalar(ptr %ctx)", "define i32 @chibi_value_test_entry(ptr %ctx)");
    text = strings.ReplaceAll(text, "declare i32 @chibi_value_probe_alias(ptr, ptr)\n", "");
    text = strings.ReplaceAll(text, "declare i32 @chibi_value_probe_pointer(ptr)\n", "");
    text = strings.Concatenate([text,
        "define i32 @chibi_value_probe_pointer(ptr %data) {\nentry:\n  %null = icmp eq ptr %data, null\n  %result = zext i1 %null to i32\n  ret i32 %result\n}\n",
        "define i32 @chibi_value_probe_alias(ptr %left, ptr %right) {\nentry:\n  store i32 9, ptr %left\n  %value = load i32, ptr %right\n  ret i32 %value\n}\n"]);
    borrowed_data := "@chibi_value_test_borrowed = private global [2 x i32] [i32 7, i32 8]\n";
    audit_text := strings.ReplaceAll(audit.text,
        "%result = call i32 @chibi_value_test_entry(ptr @chibi_value_test_ctx)",
        strings.Concatenate(["%value.result = call i32 @chibi_value_test_entry(ptr @chibi_value_test_ctx)\n",
            "  %borrowed.result = call i32 @chibi_scalar.1(ptr @chibi_value_test_ctx, { i32, i32, ptr, ptr } { i32 2, i32 2, ptr @chibi_value_test_borrowed, ptr null })\n",
            "  %room = call { i32, i32, ptr, ptr } @chibi_array.1030.allocate(ptr @chibi_value_test_ctx, i32 1, i32 4)\n",
            "  %data = extractvalue { i32, i32, ptr, ptr } %room, 2\n  store i32 7, ptr %data\n",
            "  %grown = call { i32, i32, ptr, ptr } @chibi_scalar.2(ptr @chibi_value_test_ctx, { i32, i32, ptr, ptr } %room)\n",
            "  call void @chibi_array.1030.drop(ptr @chibi_value_test_ctx, { i32, i32, ptr, ptr } %grown)\n",
            "  %record.result = call i32 @chibi_scalar.3(ptr @chibi_value_test_ctx, %record1 { { i32, i32, ptr, ptr } { i32 2, i32 2, ptr @chibi_value_test_borrowed, ptr null } })\n",
            "  %array.result = or i32 %value.result, %borrowed.result\n  %result = or i32 %array.result, %record.result"]));
    if (os.WriteText(module, strings.Concatenate([text, borrowed_data, audit_text])) ||
        os.WriteText(start, link.Start(target.triple, false, true))) { return 2; }
    for (level in [int(0), 2]) {
        objects := [format_text("{}/lifecycle-O{}.o", work, level), format_text("{}/lifecycle-start-O{}.o", work, level)];
        if (host.Objects(llvm, [module, start], objects, level, 1)) { return 1; }
        program := format_text("{}/lifecycle-O{}", work, level);
        plan := link.Program(target.triple, llvm, objects, [], [], [], program, "", false);
        if (os.Platform() == "Darwin") {
            runtime: link.Import = {name: "System", symbols: ["malloc", "calloc", "free", "dprintf", "abort"]};
            plan.imports = [runtime];
        }
        if (host.Link(plan) || os.Run([program]) != 0) { return 1; }
    }
    os.Print("PASS native value/array ownership O0/O2, shared mutation, borrowed imports and balanced poisoned frees");
    return 0;
}
