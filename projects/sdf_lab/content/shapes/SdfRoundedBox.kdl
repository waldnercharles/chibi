version 3
name "SdfRoundedBox"
domain "shape"
bounds_x 48.0
bounds_y 48.0
id_counter 127
description "Rounded box: name the offset before computing its distance."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Shader Shape Output"
            - id=3 type="Shader ObjectPosition"
            - {
                id 32
                type "Behavior Expression"
                reference_name "abs(p) - vec3(27, 23, 27)"
                inputs {
                    p id=33 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=34 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 75
                type "Behavior Expression"
                reference_name "length(max(offset, 0)) + min(max(max(offset.x, offset.y), offset.z), 0) - 6"
                inputs {
                    offset id=76 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=77 type="float"
                }
            }
        }
        (array)edges {
            - from="3.Value" to="32.p"
            - from="32.Result" to="75.offset"
            - from="75.Result" to="1.Distance"
        }
    }
    - id=7 kind="function" math_expression="abs(p) - vec3(27, 23, 27)" expression_mode=1 entry_id=8
    - id=35 kind="function" math_expression="length(max(offset, 0)) + min(max(max(offset.x, offset.y), offset.z), 0) - 6" expression_mode=1 entry_id=79
}
