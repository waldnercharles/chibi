package foreign_element_pointer
foreign import libc "system:c"
foreign libc { memset :: (data:u8[],value:i32,count:u64) -> rawptr }
Entry :: struct { values:u8[]; pointer:^int; }
Main :: () -> int { value:=1; rows:Entry[]=[{values:[u8(1)],pointer:&value}]; written:=memset(rows[0].values,9,1); return 0; }
