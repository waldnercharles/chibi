            <div class="node" id="learn" style="left: 92dp; top: 116dp;" data-event-click="emit('Learn', 5)" data-class-owned="self.n5 == 2" data-class-open="self.n5 == 1" data-class-poor="self.a5 == 0">
              <div class="ring"><div class="val">+25</div><div class="tag">Shield</div></div>
