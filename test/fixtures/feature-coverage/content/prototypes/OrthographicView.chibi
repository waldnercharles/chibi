package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("OrthographicView")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Camera", data.Object([
                    data.Field.Named("far_clip", data.Value.Real(400.0)),
                    data.Field.Named("height", data.Value.Real(100.0)),
                    data.Field.Named("near_clip", data.Value.Real(1.0)),
                    data.Field.Named("orthographic", data.Value.Bool(true)),
                    data.Field.Named("width", data.Value.Real(180.0))
                ])),
                data.Field.Named("Transform3D", data.Object([
                    data.Field.Named("position", data.Object([
                        data.Field.Named("y", data.Value.Real(200.0))
                    ])),
                    data.Field.Named("rotation", data.Object([
                        data.Field.Named("w", data.Value.Real(0.70710680000000004)),
                        data.Field.Named("x", data.Value.Real(-0.70710680000000004))
                    ])),
                    data.Field.Named("scale", data.Object([
                        data.Field.Named("x", data.Value.Real(1.0)),
                        data.Field.Named("y", data.Value.Real(1.0)),
                        data.Field.Named("z", data.Value.Real(1.0))
                    ]))
                ]))
            ]))
        ])
    );
}
