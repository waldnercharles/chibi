package slashpath

import bytes "core:bytes"
import strings "core:strings"

ExpectJoined :: (parts: string[], expected: string) {
    result := Join(parts);
    assert(result.error == nil, "small path unexpectedly exceeded the length domain");
    assert(result.text == expected);
}

@test
RootsAndTrailingSlashesHaveExplicitNames :: () {
    assert(Base("") == ".");
    assert(Base("////") == "/");
    assert(Base("/a/b///") == "b");
    assert(Base("a") == "a");
    assert(IsAbsolute("/a"));
    assert(!IsAbsolute(""));
    assert(!IsAbsolute("a/b"));
    assert(!IsAbsolute("C:\\a"));
    return;
}

@test
SplitPreservesRawSeparators :: () {
    empty := Split("");
    assert(empty.directory == "" && empty.file == "");
    root := Split("/");
    assert(root.directory == "/" && root.file == "");
    simple := Split("name");
    assert(simple.directory == "" && simple.file == "name");
    nested := Split("a//b");
    assert(nested.directory == "a//" && nested.file == "b");
    trailing := Split("a//b/");
    assert(trailing.directory == "a//b/" && trailing.file == "");
    return;
}

@test
ExtensionsUseTheFinalDotWithoutSpecialDotfileRules :: () {
    assert(Extension("a/name.tar.gz") == ".gz");
    assert(Stem("a/name.tar.gz") == "name.tar");
    assert(Extension(".gitignore") == ".gitignore");
    assert(Stem(".gitignore") == "");
    assert(Extension("a.b/name") == "");
    assert(Stem("a.b/name") == "name");
    assert(Extension("a/name.") == ".");
    assert(Stem("a/name.") == "name");
    assert(Extension("a/name.txt/") == "");
    assert(Stem("a/name.txt/") == "");
    return;
}

@test
CleanKeepsRelativeParentsAndClampsRootedParents :: () {
    assert(Clean("") == ".");
    assert(Clean(".") == ".");
    assert(Clean("a/..") == ".");
    assert(Clean("a//./b/../c/") == "a/c");
    assert(Clean("../../a") == "../../a");
    assert(Clean("a/../../b") == "../b");
    assert(Clean("../a/../..") == "../..");
    assert(Clean("/../../a") == "/a");
    assert(Clean("/a/..") == "/");
    assert(Clean("///") == "/");
    assert(Clean(".../..hidden/..") == "...");
    return;
}

@test
SlashPathsDoNotInterpretWindowsOrNetworkNames :: () {
    assert(Clean("C:\\a\\..\\b") == "C:\\a\\..\\b");
    assert(Clean("C:/a/../b") == "C:/b");
    assert(!IsAbsolute("C:/a"));
    assert(Clean("//server/share") == "/server/share");
    assert(Clean("a%2Fb/./c") == "a%2Fb/c");
    assert(Clean("猫/../é") == "é");
    return;
}

@test
JoinCleansWithoutReplacingEarlierElements :: () {
    empty: string[] = [];
    ExpectJoined(empty, "");
    ExpectJoined(["", ""], "");
    ExpectJoined(["a", "/b"], "a/b");
    ExpectJoined(["", "/a", "", "b/../c"], "/a/c");
    ExpectJoined(["a", ".."], ".");
    ExpectJoined(["..", "a", "..", ".."], "../..");
    ExpectJoined(["/", "..", "a"], "/a");
    return;
}

@test
RawBytesRemainOrdinaryPathBytes :: () {
    raw := bytes.ToString([u8(97), 0, 255, 47, 98]);
    assert(Clean(raw) == raw);
    parts := Split(raw);
    assert(parts.directory == bytes.ToString([u8(97), 0, 255, 47]));
    assert(parts.file == "b");
    assert(Base(raw) == "b");
    cancelled := bytes.ToString([u8(97), 0, 255, 47, 46, 46]);
    assert(Clean(cancelled) == ".");
    ExpectJoined([bytes.ToString([u8(0), 255]), "b"],
                 bytes.ToString([u8(0), 255, 47, 98]));
    return;
}

@test
CleanIsIdempotentAcrossAdversarialSegments :: () {
    corpus := ["", ".", "..", "../..", "a/..", "/..", "a//./b/../c/",
               "/a/../../b", "../../a/../b", "./.././a/../../c",
               ".../..hidden/..", "//server/share", "a/../../..", "a/../b/../c"];
    for (path in corpus) {
        cleaned := Clean(path);
        assert(Clean(cleaned) == cleaned);
    }
    return;
}

@test
LexicalPathsHaveNoCompilerPathLengthLimit :: () {
    segment := strings.Repeat("a", 5000);
    assert(strings.ByteLength(segment) == 5000);
    assert(Clean(segment) == segment);
    assert(Base(segment) == segment);
    ExpectJoined([segment, "..", "end"], "end");
    return;
}

@test
PublicJoinReturnsNamedTextAndOptionalError :: () {
    joined := Join(["assets", "textures/../sounds", "hit.wav"]);
    assert(joined.text == "assets/sounds/hit.wav");
    assert(joined.error == nil);
    empty: string[] = [];
    result := Join(empty);
    assert(result.text == "");
    assert(result.error == nil);
    return;
}

@test
JoinedSizeChecksTheRepresentableBoundaryBeforeAdding :: () {
    assert(JoinedSize(0, 0) == 0);
    assert(JoinedSize(0, 2147483647) == 2147483647);
    assert(JoinedSize(2147483647, 0) == 2147483647);
    assert(JoinedSize(2147483645, 1) == 2147483647);
    assert(JoinedSize(2147483646, 1) == -1);
    assert(JoinedSize(2147483647, 1) == -1);
    assert(JoinedSize(1, 2147483646) == -1);
    assert(JoinedSize(0, -1) == -1);
    assert(JoinedSize(-1, 1) == -1);
    return;
}
