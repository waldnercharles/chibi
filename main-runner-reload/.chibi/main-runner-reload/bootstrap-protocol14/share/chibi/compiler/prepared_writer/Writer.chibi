package prepared_writer

import strings "core:strings"

// Prepared format v22, written exactly as execution_prepared_write encodes a
// module of authored functions, or of a behavior's states and event handlers.
// Every 64-bit payload (ids, layouts, scalar bits, union tags) is an index into
// the module's `wide` pool, whose entry 0 is zero for an absent payload.
// Nested values, table items and per-function tables are ranges of flat pools.
// Each metadata string is its 1-based index in the string table, which holds
// every distinct one in order of first use. The table follows the module's
// tables, then the 8-byte offset it starts at.
//
// Every table stays in Write; helpers encode one row, taking single records,
// scalars, text and the pools they index. Each encodes a row's fields in as
// few Words or Ints calls as it can, since a call that returns an array costs
// far more than a field.

Magic: u64 : 0x4348494249505245;
Version: int : 26;

// A value. `wide` holds scalar bits, a union tag or a struct layout; nested
// struct fields, union payloads and array items are values[first, first + count),
// after the value itself. An absent authored struct still records its field
// count; an absent native one, a type header, records none.
pub Value :: struct {
    tag: int;
    container: int;
    type_name: string;
    has_type_name: bool;
    authored: bool;
    wide: int;
    text: string;
    has_text: bool;
    present: bool;
    first: int;
    count: int;
}
// Pin types the encoder distinguishes.
FlowTag: int : 0;
StructTag: int : 15;
UnionTag: int : 18;
NameTag: int : 12;
TextTag: int : 13;

pub Field :: struct {
    name: string;
    kind: int;
    type_name: string;
    has_type_name: bool;
    unit: string;
    has_unit: bool;
}
// An event the module handles; its payload fields are
// event_fields[first, first + count).
pub Event :: struct {
    id: int;
    abi: int;
    name: string;
    first: int;
    count: int;
}
pub EventField :: struct {
    name: string;
    nominal: int;
    has_default: bool;
    default_owner: bool;
    initial: int;
}
// A behavior's retained state and the value it starts with.
pub State :: struct {
    id: int;
    initial: int;
    shared: bool;
    contains_tasks: bool;
}
// A component a function reads or writes, and whether a binding owns it.
pub Component :: struct {
    id: int;
    binding: bool;
}
// An authored record requirement lists its fields; others resolve by identity.
pub Requirement :: struct {
    id: int;
    layout: int;
    storage: int;
    name: string;
    size: int;
    authored: bool;
    first: int;
    count: int;
}
pub Import :: struct {
    id: int;
    fingerprint: int;
}
// A function reference: own `index` in this module, or `function` (a wide id)
// in import `imported`. Null references have neither.
pub Reference :: struct {
    imported: int;
    own: int;
    function: int;
    role: int;
}
pub Source :: struct {
    graph: int;
    call: int;
    parent: int;
    asset: string;
    has_asset: bool;
    start: int;
    end: int;
    line: int;
    column: int;
}
pub Frame :: struct {
    source: int;
    depth: int;
    resume: int;
    source_index: int;
    stack: int;
}
pub Root :: struct {
    bank: int;
    index: int;
    shape: int;
}
pub Instruction :: struct {
    op: int;
    type: int;
    output: int;
    left: int;
    right: int;
    target: int;
    frame: int;
    source: int;
    stack: int;
    pin: int;
    offset: int;
    indirect: bool;
    component_index: int;
    node: int;
    value: int;
    layout: int;
    message: string;
    has_message: bool;
}
pub Local :: struct {
    kind: int;
    initial: int;
    frame: int;
    node: int;
    pin: int;
    offset: int;
    parameter: bool;
    array_default: bool;
    data_index: int;
}
pub Parameter :: struct {
    initial: int;
    frame: int;
    pin: int;
}
pub ResultLayout :: struct {
    index: int;
    name: string;
}
pub Data :: struct {
    kind: int;
    initial: int;
    size: int;
}
pub Host :: struct {
    owned_arguments: bool;
    capability: int;
    abi: int;
    first: int;
    result_first: int;
    result_count: int;
    outcome_first: int;
    outcome_count: int;
}
// Existing asynchronous runtime command; all indices address this function's banks.
pub Command :: struct {
    capability: int;
    abi: int;
    first: int;
    count: int;
    node: int;
    result_first: int;
    result_count: int;
}
pub Call :: struct {
    owned_arguments: bool;
    function: int;
    first: int;
    count: int;
    result_first: int;
    result_count: int;
    task: bool;
}
pub Point :: struct {
    occurrence: int;
    meaning: int;
    start: int;
    end: int;
    line: int;
    column: int;
    kind: int;
    completion: bool;
}
pub Watch :: struct {
    origin: int;
    initial: int;
    ordinal: int;
    output: bool;
    reference: bool;
}
pub Span :: struct {
    first: int;
    count: int;
}
// Per-function tables, in spans[function.spans + table]. Kinds and slots are
// ints; defaults and roots name values; sources and stacks share `sources`.
// Component writes are ints naming component ids in `wide`.
ArgumentDefaults: int : 0;
ArgumentKinds: int : 1;
ResultDefaults: int : 2;
ResultKinds: int : 3;
VariableDefaults: int : 4;
Slots: int : 5;
SlotKinds: int : 6;
Roots: int : 7;
Instructions: int : 8;
Locals: int : 9;
Parameters: int : 10;
Frames: int : 11;
Sources: int : 12;
Stacks: int : 13;
Results: int : 14;
DataValues: int : 15;
Hosts: int : 16;
Commands: int : 17;
CommandArguments: int : 18;
CommandArgumentKinds: int : 19;
CommandResults: int : 20;
CommandResultKinds: int : 21;
Calls: int : 22;
Definitions: int : 23;
Components: int : 24;
ComponentWrites: int : 25;
SourcePoints: int : 26;
SourceWatches: int : 27;
pub Tables: int : 28;
pub Function :: struct {
    argument_count: int;
    result_count: int;
    variable_count: int;
    root_steps: int;
    child_budget: int;
    depth_bound: int;
    pure_depth_limit: int;
    breakpoints: bool;
    batchable: bool;
    managed: bool;
    custom_lowering: bool;
    checkpoints: bool;
    pin_watches: bool;
    watch_size: int;
    component_bindings: bool;
    component_access: bool;
    spans: int;
}
// A module function entry: an exported function, or a handler of the event
// `event_id` names in `wide` (0 for none). No observer, action or captures.
// `body` and `subscription` index `references`.
pub Entry :: struct {
    id: int;
    kind: int;
    entry_name: string;
    has_entry: bool;
    event_id: int;
    event_abi: int;
    event_name: string;
    has_event_name: bool;
    continuation_wait: bool;
    effects: int;
    body: int;
    subscription: int;
}
// One structural query term. Children name ints[first, first + count), and
// predicate indexes references, or is -1 for terms without an evaluator.
pub Query :: struct {
    kind: int;
    required: bool;
    component_id: int;
    source_relationship: int;
    source_traversal: int;
    source_variable: int;
    target_variable: int;
    predicate: int;
    first: int;
    count: int;
}
// A reusable query's root term, entity variables, row shape and evaluator.
// row_type indexes values; evaluate indexes references.
pub QueryDescription :: struct {
    query_root: int;
    query_variable_count: int;
    row_type: int;
    evaluate: int;
}
pub Module :: union {
    Tables(id: u64, owner_type: u64, abi: u64, pointer_size: int, wide: u64[], values: Value[], ints: int[],
           requirements: Requirement[], fields: Field[], event_declarations: Event[],
           event_fields: EventField[], imports: Import[], functions: Function[], spans: Span[], roots: Root[],
           instructions: Instruction[], locals: Local[], parameters: Parameter[], frames: Frame[],
           sources: Source[], results: ResultLayout[], data: Data[], hosts: Host[], commands: Command[], calls: Call[],
           references: Reference[], components: Component[], points: Point[], watches: Watch[],
           states: State[], entries: Entry[], queries: Query[], query_root: int, query_variable_count: int,
           query_filter: int, descriptions: QueryDescription[], system_description: int)
}

// Varints of 64-bit words: seven bits at a time from the low end, the high bit
// marking that more follow.
Words :: (words: u64[]) -> u8[] {
    bytes: u8[] = [];
    for (word in words) {
        rest := word;
        while ((rest >> 7) != 0) {
            bytes.append(u8(wrap: rest | 128));
            rest = rest >> 7;
        }
        bytes.append(u8(wrap: rest));
    }
    return bytes;
}
// Zigzag varints of ints, which keep small negative values, such as -1 for
// none, one byte long.
Ints :: (values: int[]) -> u8[] {
    bytes: u8[] = [];
    for (value in values) {
        wide := i64(value);
        rest := u64(wrap: wide << 1) ^ u64(wrap: wide >> 63);
        while ((rest >> 7) != 0) {
            bytes.append(u8(wrap: rest | 128));
            rest = rest >> 7;
        }
        bytes.append(u8(wrap: rest));
    }
    return bytes;
}
// An int as its zigzag word, for a row of Words.
Zig :: (value: int) -> u64 {
    wide := i64(value);
    return u64(wrap: wide << 1) ^ u64(wrap: wide >> 63);
}
Flag :: (value: bool) -> u64 {
    if (value) {
        return 1;
    }
    return 0;
}
// The bytes of a string.
Raw :: (value: string) -> u8[] {
    bytes: u8[] = [];
    for (code in strings.Bytes(value)) {
        bytes.append(u8(wrap: code));
    }
    return bytes;
}
// The slot an open-addressed table of mask + 1 slots starts probing for
// `value` at: FNV-1a over its bytes.
Slot :: (value: string, mask: int) -> int {
    hash: u64 = 14695981039346656037;
    for (code in strings.Bytes(value)) {
        hash = (hash ^ u64(code)) * 1099511628211;
    }
    return int(hash & u64(mask));
}
// A power of two of at least twice `count` slots, which keeps probes short.
SlotCount :: (count: int) -> int {
    size: int = 1;
    while (size < 2 * count) {
        size = size * 2;
    }
    return size;
}
// The string table: each string of `texts` once, in order of first use.
Table :: (texts: string[]) -> string[] {
    mask := SlotCount(length(texts)) - 1;
    slots := resize([int(0)], mask + 1);
    found: string[] = [];
    for (value in texts) {
        at := Slot(value, mask);
        while (slots[at] != 0 && found[slots[at] - 1] != value) {
            at = (at + 1) & mask;
        }
        if (slots[at] == 0) {
            found.append(value);
            slots[at] = length(found);
        }
    }
    return found;
}
// Slots holding the 1-based index of each string of the table.
TableSlots :: (items: string[]) -> int[] {
    mask := SlotCount(length(items)) - 1;
    slots := resize([int(0)], mask + 1);
    index: int = 0;
    while (index < length(items)) {
        at := Slot(items[index], mask);
        while (slots[at] != 0) {
            at = (at + 1) & mask;
        }
        slots[at] = index + 1;
        index += 1;
    }
    return slots;
}
// The table's count, then each string's byte length plus one and its bytes.
TableBytes :: (items: string[]) -> u8[] {
    bytes := Ints([length(items)]);
    for (item in items) {
        raw := Raw(item);
        bytes.extend(Words([u64(length(raw) + 1)]));
        bytes.extend(raw);
    }
    return bytes;
}
// Absent text is 0; otherwise its 1-based index in the table, which holds it.
Text :: (value: string, present: bool, items: string[], slots: int[]) -> u8[] {
    if (!present) {
        return [0];
    }
    mask := length(slots) - 1;
    at := Slot(value, mask);
    while (items[slots[at] - 1] != value) {
        at = (at + 1) & mask;
    }
    return Words([u64(slots[at])]);
}
Zeros :: (count: int) -> u8[] {
    return resize([u8(0)], count);
}
// A value's own bytes; its nested values follow them. `bits` is its wide entry.
ValueHead :: (v: Value, bits: u64, items: string[], slots: int[]) -> u8[] {
    bytes := extend(Ints([v.tag, v.container]), Text(v.type_name, v.has_type_name, items, slots));
    if (v.container != 0) {
        if (!v.present) {
            return extend(bytes, Words([Flag(v.authored), 0]));
        }
        return extend(bytes, Words([Flag(v.authored), 1, Zig(v.count)]));
    }
    if (v.tag == StructTag) {
        return extend(bytes, Words([Flag(v.authored), bits, Flag(v.present), Zig(v.count)]));
    }
    if (v.tag == UnionTag) {
        if (!v.present) {
            return extend(bytes, Words([Flag(v.authored), 0]));
        }
        return extend(bytes, Words([Flag(v.authored), 1, bits, Zig(v.count)]));
    }
    if (v.tag == TextTag) {
        raw := Raw(v.text);
        bytes.extend(Words([Flag(v.authored), u64(length(raw))]));
        return extend(bytes, raw);
    }
    if (v.tag == NameTag) {
        bytes.extend(Words([Flag(v.authored)]));
        return extend(bytes, Text(v.text, v.has_text, items, slots));
    }
    return extend(bytes, Words([Flag(v.authored), bits]));
}
// A value's bytes: its own, then those of the values nested in it, which
// `pool` already holds from starts[i] for sizes[i] bytes.
ValueBytes :: (v: Value, wide: u64[], pool: u8[], starts: int[], sizes: int[], items: string[],
               slots: int[]) -> u8[] {
    bytes := ValueHead(v, wide[v.wide], items, slots);
    aggregate := v.container != 0 || v.tag == StructTag || v.tag == UnionTag;
    if (!aggregate || !v.present) {
        return bytes;
    }
    nested := v.first;
    while (nested < v.first + v.count) {
        bytes.extend(slice(pool, starts[nested], sizes[nested]));
        nested += 1;
    }
    return bytes;
}
// A zero flow value, as an empty observer type is written.
FlowValue :: () -> u8[] {
    return Ints([FlowTag, 0, 0, 0, 0]);
}
// A source with its asset's text already encoded; an absent asset is 0.
SourceBytes :: (v: Source, wide: u64[], asset: u8[]) -> u8[] {
    if (!v.has_asset) {
        bytes := Words([wide[v.graph], wide[v.call], Zig(v.parent), 0]);
        return extend(bytes, Ints([v.start, v.end, v.line, v.column]));
    }
    bytes := extend(Words([wide[v.graph], wide[v.call], Zig(v.parent)]), asset);
    return extend(bytes, Ints([v.start, v.end, v.line, v.column]));
}
ReferenceBytes :: (v: Reference, wide: u64[]) -> u8[] {
    return Words([Zig(v.imported), Zig(v.own), wide[v.function], Zig(v.role)]);
}
PointBytes :: (v: Point, wide: u64[]) -> u8[] {
    return Words([wide[v.occurrence], wide[v.meaning], Zig(v.start), Zig(v.end), Zig(v.line), Zig(v.column),
                  Zig(v.kind), Flag(v.completion)]);
}
// An instruction with its value, layout and message.
InstructionBytes :: (v: Instruction, wide: u64[], pool: u8[], starts: int[], sizes: int[], items: string[],
                     slots: int[]) -> u8[] {
    bytes := Ints([v.op, v.type, v.output, v.left, v.right, v.target, v.frame, v.source, v.stack, v.pin]);
    bytes.extend(Words([u64(v.offset), Flag(v.indirect), Zig(v.component_index), wide[v.node]]));
    bytes.extend(slice(pool, starts[v.value], sizes[v.value]));
    if (!v.has_message) {
        return extend(bytes, Words([wide[v.layout], 0]));
    }
    bytes.extend(Words([wide[v.layout]]));
    return extend(bytes, Text(v.message, true, items, slots));
}
LocalBytes :: (v: Local, wide: u64[], pool: u8[], starts: int[], sizes: int[]) -> u8[] {
    bytes := extend(Ints([v.kind]), slice(pool, starts[v.initial], sizes[v.initial]));
    return extend(bytes, Words([Zig(v.frame), wide[v.node], Zig(v.pin), u64(v.offset), Flag(v.parameter),
                                Flag(v.array_default), Zig(v.data_index)]));
}
HostBytes :: (v: Host, wide: u64[]) -> u8[] {
    bytes := Words([wide[v.capability], wide[v.abi], Zig(v.first), Zig(v.result_first), Zig(v.result_count),
                    Flag(v.owned_arguments), Zig(v.outcome_count)]);
    return extend(bytes, Words(slice(wide, v.outcome_first, v.outcome_count)));
}
CallBytes :: (v: Call, target: Reference, wide: u64[]) -> u8[] {
    bytes := ReferenceBytes(target, wide);
    return extend(bytes, Words([Zig(v.first), Zig(v.count), Zig(v.result_first), Zig(v.result_count), Flag(v.task),
                                Flag(v.owned_arguments)]));
}
FunctionHead :: (v: Function) -> u8[] {
    return Words([Zig(v.argument_count), Zig(v.result_count), Zig(v.variable_count), u64(v.root_steps),
                  u64(v.child_budget), u64(v.depth_bound), u64(v.pure_depth_limit), Flag(v.breakpoints),
                  Flag(v.batchable), Flag(v.managed), Flag(v.custom_lowering), Flag(v.checkpoints),
                  Flag(v.pin_watches), u64(v.watch_size), Flag(v.component_bindings), Flag(v.component_access)]);
}
// An entry before its body and subscription references.
EntryHead :: (v: Entry, wide: u64[], items: string[], slots: int[]) -> u8[] {
    // Event, event ABI, the observer's component, layout, field and offset,
    // then its type.
    bytes := extend(Words([wide[v.id], wide[v.event_id], wide[v.event_abi], 0, 0, 0, 0]), FlowValue());
    // The observer's argument, action, parent and outcome, then no captures.
    bytes.extend(Words([0, 0, 0, 0, 0, 0, Flag(v.continuation_wait), Zig(v.kind)]));
    bytes.extend(Text(v.entry_name, v.has_entry, items, slots));
    bytes.extend(Text(v.event_name, v.has_event_name, items, slots));
    return extend(bytes, Words([wide[v.effects]]));
}
// An event declaration with its payload fields.
EventBytes :: (v: Event, fields: EventField[], wide: u64[], pool: u8[], starts: int[], sizes: int[],
               items: string[], slots: int[]) -> u8[] {
    bytes := extend(Words([wide[v.id], wide[v.abi]]), Text(v.name, true, items, slots));
    bytes.extend(Ints([v.count]));
    index := v.first;
    while (index < v.first + v.count) {
        field := fields[index];
        bytes.extend(Text(field.name, true, items, slots));
        bytes.extend(Words([wide[field.nominal], Flag(field.has_default), Flag(field.default_owner)]));
        bytes.extend(slice(pool, starts[field.initial], sizes[field.initial]));
        index += 1;
    }
    return bytes;
}

// What Write writes: which values, and its metadata strings in the order it
// writes them, a run of sources of one asset naming it once.
Gathered :: union {
    Of(texts: string[], used: bool[])
}
Gather :: (module: Module) -> Gathered {
    switch module {
        case .Tables(id, owner_type, abi, pointer_size, wide, values, ints, requirements, fields, event_declarations,
                     event_fields, imports, functions, spans, roots, instructions, locals, parameters, frames,
                     sources, results, data, hosts, commands, calls, references, components, points, watches, states,
                     entries, queries, query_root, query_variable_count, query_filter, descriptions, system_description):
            // Each step is a value Write writes, or -1 - n for named[n].
            named: string[] = [];
            steps: int[] = [];
            for (requirement in requirements) {
                named.append(requirement.name);
                steps.append(-length(named));
                index := requirement.first;
                while (requirement.authored && index < requirement.first + requirement.count) {
                    field := fields[index];
                    named.append(field.name);
                    steps.append(-length(named));
                    if (field.has_type_name) {
                        named.append(field.type_name);
                        steps.append(-length(named));
                    }
                    if (field.has_unit) {
                        named.append(field.unit);
                        steps.append(-length(named));
                    }
                    index += 1;
                }
            }
            for (declared in event_declarations) {
                named.append(declared.name);
                steps.append(-length(named));
                index := declared.first;
                while (index < declared.first + declared.count) {
                    named.append(event_fields[index].name);
                    steps.append(-length(named));
                    steps.append(event_fields[index].initial);
                    index += 1;
                }
            }
            asset := "";
            known := false;
            for (function in functions) {
                table: int = 0;
                while (table < Tables) {
                    span := spans[function.spans + table];
                    item := span.first;
                    last := span.first + span.count;
                    if (table == ArgumentDefaults || table == ResultDefaults || table == VariableDefaults ||
                        table == CommandArguments || table == CommandResults) {
                        while (item < last) {
                            steps.append(item);
                            item += 1;
                        }
                    } else if (table == Roots) {
                        while (item < last) {
                            steps.append(roots[item].shape);
                            item += 1;
                        }
                    } else if (table == Instructions) {
                        while (item < last) {
                            steps.append(instructions[item].value);
                            if (instructions[item].has_message) {
                                named.append(instructions[item].message);
                                steps.append(-length(named));
                            }
                            item += 1;
                        }
                    } else if (table == Locals) {
                        while (item < last) {
                            steps.append(locals[item].initial);
                            item += 1;
                        }
                    } else if (table == Parameters) {
                        while (item < last) {
                            steps.append(parameters[item].initial);
                            item += 1;
                        }
                    } else if (table == Frames || table == Sources || table == Stacks) {
                        while (item < last) {
                            row := item;
                            if (table == Frames) {
                                row = frames[item].source;
                            }
                            source := sources[row];
                            if (source.has_asset && (!known || source.asset != asset)) {
                                asset = source.asset;
                                known = true;
                                named.append(asset);
                                steps.append(-length(named));
                            }
                            item += 1;
                        }
                    } else if (table == Results) {
                        while (item < last) {
                            named.append(results[item].name);
                            steps.append(-length(named));
                            item += 1;
                        }
                    } else if (table == DataValues) {
                        while (item < last) {
                            steps.append(data[item].initial);
                            item += 1;
                        }
                    } else if (table == SourceWatches) {
                        while (item < last) {
                            steps.append(watches[item].initial);
                            item += 1;
                        }
                    }
                    table += 1;
                }
            }
            for (retained in states) {
                steps.append(retained.initial);
            }
            for (item in entries) {
                if (item.has_entry) {
                    named.append(item.entry_name);
                    steps.append(-length(named));
                }
                if (item.has_event_name) {
                    named.append(item.event_name);
                    steps.append(-length(named));
                }
            }
            for (description in descriptions) {
                steps.append(description.row_type);
            }
            // A value writes its own strings, then those of its nested values
            // in order, so a stack walks each written value in that order.
            texts: string[] = [];
            used := resize([false], length(values));
            stack: int[] = [];
            for (step in steps) {
                if (step < 0) {
                    texts.append(named[-1 - step]);
                    continue;
                }
                if (length(stack) == 0) {
                    stack.append(step);
                }
                stack[0] = step;
                top: int = 1;
                while (top > 0) {
                    top -= 1;
                    v := values[stack[top]];
                    used[stack[top]] = true;
                    if (v.has_type_name) {
                        texts.append(v.type_name);
                    }
                    if (v.container == 0 && v.tag == NameTag && v.has_text) {
                        texts.append(v.text);
                    }
                    nested := v.first + v.count - 1;
                    aggregate := v.container != 0 || v.tag == StructTag || v.tag == UnionTag;
                    while (aggregate && v.present && nested >= v.first) {
                        if (top < length(stack)) {
                            stack[top] = nested;
                        } else {
                            stack.append(nested);
                        }
                        top += 1;
                        nested -= 1;
                    }
                }
            }
            return Gathered.Of(texts, used);
    }
}

// The complete inner module.
pub Write :: (module: Module) -> u8[] {
    switch Gather(module) {
        case .Of(texts, used):
            return WriteTables(module, Table(texts), used);
    }
}
WriteTables :: (module: Module, items: string[], used: bool[]) -> u8[] {
    slots := TableSlots(items);
    switch module {
        case .Tables(id, owner_type, abi, pointer_size, wide, values, ints, requirements, fields, event_declarations,
                     event_fields, imports, functions, spans, roots, instructions, locals, parameters, frames,
                     sources, results, data, hosts, commands, calls, references, components, points, watches, states,
                     entries, queries, query_root, query_variable_count, query_filter, descriptions, system_description):
            // Nested values follow their parent, so encoding from the last
            // value back finds every nested value already in the pool.
            pool: u8[] = [];
            starts := resize([int(0)], length(values));
            sizes := resize([int(0)], length(values));
            at := length(values) - 1;
            while (at >= 0) {
                if (used[at]) {
                    start := length(pool);
                    pool.extend(ValueBytes(values[at], wide, pool, starts, sizes, items, slots));
                    starts[at] = start;
                    sizes[at] = length(pool) - start;
                }
                at -= 1;
            }

            bytes := Words([Magic, u64(Version), u64(pointer_size), abi, id, owner_type,
                            Zig(length(requirements))]);
            for (requirement in requirements) {
                bytes.extend(Words([wide[requirement.id], wide[requirement.layout],
                                    Zig(requirement.storage)]));
                bytes.extend(Text(requirement.name, true, items, slots));
                bytes.extend(Words([u64(requirement.size), Flag(requirement.authored)]));
                if (requirement.authored) {
                    bytes.extend(Ints([requirement.count]));
                    index: int = 0;
                    while (index < requirement.count) {
                        field := fields[requirement.first + index];
                        bytes.extend(Text(field.name, true, items, slots));
                        bytes.extend(Ints([field.kind]));
                        bytes.extend(Text(field.type_name, field.has_type_name, items, slots));
                        bytes.extend(Text(field.unit, field.has_unit, items, slots));
                        bytes.extend(Words([Flag(field.kind == TextTag)]));
                        index += 1;
                    }
                }
            }
            bytes.extend(Ints([length(event_declarations)]));
            for (declared in event_declarations) {
                bytes.extend(EventBytes(declared, event_fields, wide, pool, starts, sizes, items, slots));
            }
            bytes.extend(Ints([length(imports)]));
            for (imported in imports) {
                bytes.extend(Words([wide[imported.id], wide[imported.fingerprint]]));
            }

            // Consecutive sources of one asset share its encoded text.
            asset := "";
            asset_bytes: u8[] = [];
            bytes.extend(Ints([length(functions)]));
            for (function in functions) {
                bytes.extend(FunctionHead(function));
                table: int = 0;
                while (table < Tables) {
                    span := spans[function.spans + table];
                    bytes.extend(Ints([span.count]));
                    item := span.first;
                    last := span.first + span.count;
                    if (table == ArgumentDefaults || table == ResultDefaults || table == VariableDefaults ||
                        table == CommandArguments || table == CommandResults) {
                        while (item < last) {
                            bytes.extend(slice(pool, starts[item], sizes[item]));
                            item += 1;
                        }
                    } else if (table == ArgumentKinds || table == ResultKinds || table == Slots ||
                               table == SlotKinds || table == CommandArgumentKinds || table == CommandResultKinds) {
                        bytes.extend(Ints(slice(ints, span.first, span.count)));
                    } else if (table == Roots) {
                        while (item < last) {
                            bytes.extend(Ints([roots[item].bank, roots[item].index]));
                            bytes.extend(slice(pool, starts[roots[item].shape], sizes[roots[item].shape]));
                            item += 1;
                        }
                    } else if (table == Instructions) {
                        while (item < last) {
                            bytes.extend(InstructionBytes(instructions[item], wide, pool, starts, sizes, items, slots));
                            item += 1;
                        }
                    } else if (table == Locals) {
                        while (item < last) {
                            bytes.extend(LocalBytes(locals[item], wide, pool, starts, sizes));
                            item += 1;
                        }
                    } else if (table == Parameters) {
                        while (item < last) {
                            initial := parameters[item].initial;
                            bytes.extend(slice(pool, starts[initial], sizes[initial]));
                            bytes.extend(Ints([parameters[item].frame, parameters[item].pin]));
                            item += 1;
                        }
                    } else if (table == Frames) {
                        while (item < last) {
                            frame := frames[item];
                            source := sources[frame.source];
                            bytes.extend(SourceBytes(source, wide, Text(source.asset, source.has_asset, items, slots)));
                            bytes.extend(Ints([frame.depth, frame.resume, frame.source_index, frame.stack]));
                            item += 1;
                        }
                    } else if (table == Sources || table == Stacks) {
                        while (item < last) {
                            if (sources[item].has_asset && (length(asset_bytes) == 0 || sources[item].asset != asset)) {
                                asset = sources[item].asset;
                                asset_bytes = Text(asset, true, items, slots);
                            }
                            bytes.extend(SourceBytes(sources[item], wide, asset_bytes));
                            item += 1;
                        }
                    } else if (table == Results) {
                        while (item < last) {
                            bytes.extend(Ints([results[item].index]));
                            bytes.extend(Text(results[item].name, true, items, slots));
                            item += 1;
                        }
                    } else if (table == DataValues) {
                        while (item < last) {
                            bytes.extend(Ints([data[item].kind]));
                            bytes.extend(slice(pool, starts[data[item].initial], sizes[data[item].initial]));
                            bytes.extend(Words([u64(data[item].size)]));
                            item += 1;
                        }
                    } else if (table == Hosts) {
                        while (item < last) {
                            bytes.extend(HostBytes(hosts[item], wide));
                            item += 1;
                        }
                        // No query rows. Commands and their banks follow separately.
                        bytes.extend(Zeros(1));
                    } else if (table == Commands) {
                        while (item < last) {
                            command := commands[item];
                            bytes.extend(Words([wide[command.capability], wide[command.abi], 0, 0]));
                            bytes.extend(Text("", false, items, slots));
                            bytes.extend(Words([Zig(command.first), Zig(command.count), wide[command.node], 0,
                                                Zig(command.result_first), Zig(command.result_count), 0]));
                            item += 1;
                        }
                    } else if (table == Calls) {
                        while (item < last) {
                            bytes.extend(CallBytes(calls[item], references[calls[item].function], wide));
                            item += 1;
                        }
                    } else if (table == Definitions) {
                        while (item < last) {
                            bytes.extend(ReferenceBytes(references[ints[item]], wide));
                            item += 1;
                        }
                    } else if (table == Components) {
                        while (item < last) {
                            bytes.extend(Words([wide[components[item].id], Flag(components[item].binding)]));
                            item += 1;
                        }
                    } else if (table == ComponentWrites) {
                        while (item < last) {
                            bytes.extend(Words([wide[ints[item]]]));
                            item += 1;
                        }
                        // No state selections follow component writes.
                        bytes.extend(Zeros(1));
                    } else if (table == SourcePoints) {
                        while (item < last) {
                            bytes.extend(PointBytes(points[item], wide));
                            item += 1;
                        }
                    } else {
                        while (item < last) {
                            watch := watches[item];
                            bytes.extend(PointBytes(points[watch.origin], wide));
                            bytes.extend(slice(pool, starts[watch.initial], sizes[watch.initial]));
                            bytes.extend(Words([Zig(watch.ordinal), Flag(watch.output),
                                                Flag(watch.reference)]));
                            item += 1;
                        }
                    }
                    table += 1;
                }
                // Points, watches and edges are debugger tables this module has none of.
                bytes.extend(Zeros(3));
            }

            bytes.extend(Ints([length(states)]));
            for (retained in states) {
                bytes.extend(Words([wide[retained.id]]));
                bytes.extend(slice(pool, starts[retained.initial], sizes[retained.initial]));
                bytes.extend(Words([Flag(retained.shared), Flag(retained.contains_tasks)]));
            }
            bytes.extend(Ints([length(entries)]));
            for (item in entries) {
                bytes.extend(EntryHead(item, wide, items, slots));
                bytes.extend(ReferenceBytes(references[item.body], wide));
                bytes.extend(ReferenceBytes(references[item.subscription], wide));
            }
            bytes.extend(Ints([length(queries)]));
            for (term in queries) {
                bytes.extend(Words([Zig(term.kind), Flag(term.required), wide[term.component_id], wide[term.source_relationship],
                                    Zig(term.source_traversal), Zig(term.source_variable), Zig(term.target_variable)]));
                if (term.predicate < 0) {
                    bytes.extend(Ints([-1, -1, 0, 0]));
                } else {
                    bytes.extend(ReferenceBytes(references[term.predicate], wide));
                }
                bytes.extend(Ints([term.count]));
                bytes.extend(Ints(slice(ints, term.first, term.count)));
            }
            bytes.extend(Ints([query_root, query_variable_count, query_filter, length(descriptions)]));
            for (description in descriptions) {
                bytes.extend(Ints([description.query_root, description.query_variable_count]));
                initial := description.row_type;
                bytes.extend(slice(pool, starts[initial], sizes[initial]));
                bytes.extend(ReferenceBytes(references[description.evaluate], wide));
            }
            // The selected system description is one-based; zero means none.
            // Reactive bindings and actions are absent from authored compiler modules.
            bytes.extend(Ints([system_description, 0, 0]));
            strings_at := length(bytes);
            bytes.extend(TableBytes(items));
            return extend(bytes, Word(u64(strings_at)));
    }
}

// FNV-1a over the module bytes, as import fingerprints use; zero becomes one.
pub Fingerprint :: (bytes: u8[]) -> u64 {
    hash: u64 = 14695981039346656037;
    for (item in bytes) {
        hash = (hash ^ u64(item)) * 1099511628211;
    }
    if (hash == 0) {
        return 1;
    }
    return hash;
}

Word :: (value: u64) -> u8[] {
    bytes: u8[] = [];
    index: int = 0;
    rest := value;
    while (index < 8) {
        bytes.append(u8(wrap: rest));
        rest = rest >> 8;
        index += 1;
    }
    return bytes;
}
// CHIBICLO v1: header words "CHIBICLO", version, root id and row count, then
// rows sorted bytewise by name: id, name length, module length, name, module.
// Module bytes are data[starts[i], starts[i] + lengths[i]).
pub Closure :: (root: u64, ids: u64[], names: string[], data: u8[],
                starts: int[], lengths: int[]) -> u8[] {
    order: int[] = [];
    index: int = 0;
    while (index < length(names)) {
        at := length(order);
        order.append(index);
        while (at > 0 && strings.Compare(names[order[at - 1]], names[index]) > 0) {
            order[at] = order[at - 1];
            at -= 1;
        }
        order[at] = index;
        index += 1;
    }
    magic: u8[] = [67, 72, 73, 66, 73, 67, 76, 79];
    bytes := magic;
    bytes.extend(Word(1));
    bytes.extend(Word(root));
    bytes.extend(Word(u64(length(names))));
    for (row in order) {
        name := names[row];
        size := strings.ByteLength(name);
        bytes.extend(Word(ids[row]));
        bytes.extend(Word(u64(size)));
        bytes.extend(Word(u64(lengths[row])));
        bytes.extend(Raw(name));
        bytes.extend(slice(data, starts[row], lengths[row]));
    }
    return bytes;
}
