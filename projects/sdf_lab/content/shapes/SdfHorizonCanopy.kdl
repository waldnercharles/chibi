version 3
name "SdfHorizonCanopy"
domain "shape"
bounds_x 140.0
bounds_y 140.0
id_counter 45
description "Conservative ellipsoid distance for a smooth continuous height canopy."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Shader Shape Output"
            - id=3 type="Shader ObjectPosition"
            - {
                id 42
                type "Behavior Expression"
                reference_name "(length(position / vec3(110, 28, 65)) - 1) * 28"
                inputs {
                    position id=43 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=44 type="float"
                }
            }
        }
        (array)edges {
            - from="3.Value" to="42.position"
            - from="42.Result" to="1.Distance"
        }
    }
    - id=5 kind="function" math_expression="(length(position / vec3(110, 28, 65)) - 1) * 28" entry_id=6
}
