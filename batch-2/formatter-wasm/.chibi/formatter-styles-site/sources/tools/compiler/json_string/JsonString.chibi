package json_string

import strings "core:strings"

// Decodes one JSON string literal, quotes included, to the bytes it denotes:
// the compiler's reading of a source string literal. Surrounding JSON
// whitespace is skipped and nothing else may follow the closing quote.
// A literal that is not exactly one string decodes to invalid, empty text and
// zero length. One scan over the literal's bytes; the result joins slices of it and of
// the byte tables below.
//
// This replaced the compiler_json_string and compiler_json_value_string
// natives, which no longer exist. It builds its result from slices, so it
// needs no native that builds a string from bytes.

Space: int : 32;
Tab: int : 9;
Newline: int : 10;
Return: int : 13;
Quote: int : 34;
Backslash: int : 92;
Slash: int : 47;
LowerB: int : 98;
LowerF: int : 102;
LowerN: int : 110;
LowerR: int : 114;
LowerT: int : 116;
LowerU: int : 117;
FirstControlEnd: int : 32;
Ascii: int : 128;

// The value of a hexadecimal digit, or -1.
Digit :: (byte: int) -> int {
    if (byte >= 48 && byte <= 57) {
        return byte - 48;
    }
    if (byte >= 65 && byte <= 70) {
        return byte - 55;
    }
    if (byte >= 97 && byte <= 102) {
        return byte - 87;
    }
    return -1;
}

// The four hexadecimal digits at `at`, or -1.
Hex4 :: (data: int[], at: int) -> int {
    if (at + 4 > length(data)) {
        return -1;
    }
    value: int = 0;
    for offset in 0..<4 {
        digit := Digit(data[at + offset]);
        if (digit < 0) {
            return -1;
        }
        value = value * 16 + digit;
    }
    return value;
}

// Whether `data[at]` is a continuation byte inside [low, high].
Within :: (data: int[], at: int, low: int, high: int) -> bool {
    return at < length(data) && data[at] >= low && data[at] <= high;
}

// The width of the well-formed UTF-8 sequence at `at`, or 0: no overlong
// forms, surrogates or code points above U+10FFFF.
Sequence :: (data: int[], at: int) -> int {
    lead := data[at];
    if (lead >= 194 && lead <= 223) {
        if (Within(data, at + 1, 128, 191)) {
            return 2;
        }
        return 0;
    }
    if (lead >= 224 && lead <= 239) {
        low: int = 128;
        high: int = 191;
        if (lead == 224) {
            low = 160;
        }
        if (lead == 237) {
            high = 159;
        }
        if (Within(data, at + 1, low, high) && Within(data, at + 2, 128, 191)) {
            return 3;
        }
        return 0;
    }
    if (lead >= 240 && lead <= 244) {
        low: int = 128;
        high: int = 191;
        if (lead == 240) {
            low = 144;
        }
        if (lead == 244) {
            high = 143;
        }
        if (Within(data, at + 1, low, high) && Within(data, at + 2, 128, 191) && Within(data, at + 3, 128, 191)) {
            return 4;
        }
        return 0;
    }
    return 0;
}

// One byte of text. A slice may cut inside a UTF-8 sequence, so each byte of a
// decoded escape is a one-byte slice of a table: ASCII at its own index, then
// the continuation bytes 80..BF at the second byte of the characters U+0080..
// U+00BF, and each lead byte at the first byte of a character that begins with
// it (two bytes for C2..DF, three for E0..EF, four for F0..F4).
LowTable :: () -> string {
    return "\u0000\u0001\u0002\u0003\u0004\u0005\u0006\u0007\u0008\u0009\u000a\u000b\u000c\u000d\u000e\u000f\u0010\u0011\u0012\u0013\u0014\u0015\u0016\u0017\u0018\u0019\u001a\u001b\u001c\u001d\u001e\u001f\u0020\u0021\u0022\u0023\u0024\u0025\u0026\u0027\u0028\u0029\u002a\u002b\u002c\u002d\u002e\u002f\u0030\u0031\u0032\u0033\u0034\u0035\u0036\u0037\u0038\u0039\u003a\u003b\u003c\u003d\u003e\u003f\u0040\u0041\u0042\u0043\u0044\u0045\u0046\u0047\u0048\u0049\u004a\u004b\u004c\u004d\u004e\u004f\u0050\u0051\u0052\u0053\u0054\u0055\u0056\u0057\u0058\u0059\u005a\u005b\u005c\u005d\u005e\u005f\u0060\u0061\u0062\u0063\u0064\u0065\u0066\u0067\u0068\u0069\u006a\u006b\u006c\u006d\u006e\u006f\u0070\u0071\u0072\u0073\u0074\u0075\u0076\u0077\u0078\u0079\u007a\u007b\u007c\u007d\u007e\u007f";
}
ContinuationTable :: () -> string {
    return "\u0080\u0081\u0082\u0083\u0084\u0085\u0086\u0087\u0088\u0089\u008a\u008b\u008c\u008d\u008e\u008f\u0090\u0091\u0092\u0093\u0094\u0095\u0096\u0097\u0098\u0099\u009a\u009b\u009c\u009d\u009e\u009f\u00a0\u00a1\u00a2\u00a3\u00a4\u00a5\u00a6\u00a7\u00a8\u00a9\u00aa\u00ab\u00ac\u00ad\u00ae\u00af\u00b0\u00b1\u00b2\u00b3\u00b4\u00b5\u00b6\u00b7\u00b8\u00b9\u00ba\u00bb\u00bc\u00bd\u00be\u00bf";
}
LeadTwoTable :: () -> string {
    return "\u0080\u00c0\u0100\u0140\u0180\u01c0\u0200\u0240\u0280\u02c0\u0300\u0340\u0380\u03c0\u0400\u0440\u0480\u04c0\u0500\u0540\u0580\u05c0\u0600\u0640\u0680\u06c0\u0700\u0740\u0780\u07c0";
}
LeadThreeTable :: () -> string {
    return "\u0800\u1000\u2000\u3000\u4000\u5000\u6000\u7000\u8000\u9000\ua000\ub000\uc000\ud000\ue000\uf000";
}
LeadFourTable :: () -> string {
    return "\ud800\udc00\ud8c0\udc00\ud9c0\udc00\udac0\udc00\udbc0\udc00";
}

ByteText :: (byte: int) -> string {
    if (byte < 128) {
        return strings.Slice(LowTable(), byte, 1);
    }
    if (byte < 192) {
        return strings.Slice(ContinuationTable(), 2 * (byte - 128) + 1, 1);
    }
    if (byte < 224) {
        return strings.Slice(LeadTwoTable(), 2 * (byte - 194), 1);
    }
    if (byte < 240) {
        return strings.Slice(LeadThreeTable(), 3 * (byte - 224), 1);
    }
    return strings.Slice(LeadFourTable(), 4 * (byte - 240), 1);
}

// The UTF-8 text of a code point that is not a surrogate.
PointText :: (point: int) -> string {
    if (point < 128) {
        return ByteText(point);
    }
    if (point < 2048) {
        return strings.Concatenate([ByteText(192 + point / 64), ByteText(128 + point % 64)]);
    }
    if (point < 65536) {
        return strings.Concatenate([ByteText(224 + point / 4096), ByteText(128 + point / 64 % 64),
                                    ByteText(128 + point % 64)]);
    }
    return strings.Concatenate([ByteText(240 + point / 262144), ByteText(128 + point / 4096 % 64),
                                ByteText(128 + point / 64 % 64), ByteText(128 + point % 64)]);
}

// The position after the whitespace at `at`.
SkipSpace :: (data: int[], at: int) -> int {
    while (at < length(data) && (data[at] == Space || data[at] == Tab || data[at] == Newline || data[at] == Return)) {
        at += 1;
    }
    return at;
}

// A character the single-character escapes denote, or -1.
Simple :: (byte: int) -> int {
    if (byte == Quote || byte == Backslash || byte == Slash) {
        return byte;
    }
    if (byte == LowerB) {
        return 8;
    }
    if (byte == LowerF) {
        return 12;
    }
    if (byte == LowerN) {
        return 10;
    }
    if (byte == LowerR) {
        return 13;
    }
    if (byte == LowerT) {
        return 9;
    }
    return -1;
}

pub Decoded :: struct {
    valid: bool;
    value: string;
    byte_length: int;
}

Invalid :: () -> Decoded {
    return {valid: false, value: "", byte_length: 0};
}

// A strict literal rejects raw control bytes and malformed UTF-8. Otherwise
// every raw byte is kept, as the compiler's value strings are arbitrary bytes.
// The pieces are the literal's raw runs, copied whole, and its escapes.
Decode :: (literal: string, strict: bool) -> Decoded {
    data := strings.Bytes(literal);
    count := length(data);
    pieces: string[] = [];
    at := 0;
    if (count > 0 && data[0] != Quote) {
        at = SkipSpace(data, 0);
    }
    if (at >= count || data[at] != Quote) {
        return Invalid();
    }
    at += 1;
    run := at;
    closed := false;
    while (!closed) {
        // The common bytes, tested with as few comparisons as the mode allows.
        if (strict) {
            while (at < count && data[at] >= FirstControlEnd && data[at] < Ascii && data[at] != Quote &&
                   data[at] != Backslash) {
                at += 1;
            }
        } else {
            while (at < count && data[at] != Quote && data[at] != Backslash) {
                at += 1;
            }
        }
        if (at >= count) {
            return Invalid();
        }
        byte := data[at];
        if (byte == Quote) {
            if (at + 1 == count && length(pieces) == 0) {
                // The whole literal is one quoted run, with no escape.
                return {valid: true, value: strings.Slice(literal, run, at - run), byte_length: at - run};
            }
            pieces.append(strings.Slice(literal, run, at - run));
            closed = true;
            at += 1;
        } else if (byte == Backslash) {
            pieces.append(strings.Slice(literal, run, at - run));
            if (at + 1 >= count) {
                return Invalid();
            }
            escape := data[at + 1];
            if (escape != LowerU) {
                simple := Simple(escape);
                if (simple < 0) {
                    return Invalid();
                }
                pieces.append(ByteText(simple));
                at += 2;
            } else {
                high := Hex4(data, at + 2);
                if (high < 0) {
                    return Invalid();
                }
                at += 6;
                point := high;
                if (high >= 55296 && high <= 57343) {
                    if (high >= 56320 || at + 1 >= count || data[at] != Backslash || data[at + 1] != LowerU) {
                        return Invalid();
                    }
                    low := Hex4(data, at + 2);
                    if (low < 56320 || low > 57343) {
                        return Invalid();
                    }
                    point = 65536 + (high - 55296) * 1024 + (low - 56320);
                    at += 6;
                }
                pieces.append(PointText(point));
            }
            run = at;
        } else if (byte < FirstControlEnd) {
            return Invalid();
        } else {
            // Only a strict literal stops on a raw byte of 128 or more.
            width := Sequence(data, at);
            if (width == 0) {
                return Invalid();
            }
            at += width;
        }
    }
    if (SkipSpace(data, at) != count) {
        return Invalid();
    }
    text := pieces[0];
    if (length(pieces) > 1) {
        text = strings.Concatenate(pieces);
    }
    return {valid: true, value: text, byte_length: strings.ByteLength(text)};
}

// A metadata string: well-formed Unicode only.
pub Metadata :: (literal: string) -> Decoded {
    return Decode(literal, true);
}

// A value string: any bytes between the quotes.
pub Value :: (literal: string) -> Decoded {
    return Decode(literal, false);
}
