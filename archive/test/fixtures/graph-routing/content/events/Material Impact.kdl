version 3
name "Material Impact"
domain "event"
id_counter 4
(array)variables {
    - id=1 name="Energy" type="number"
    - id=2 name="Cause" type="int"
    - {
        id 3
        name "Point"
        type "struct"
        type_name "vec2"
        default x=0.0 y=0.0
    }
}
(array)graphs {
    - kind="event" name=""
}
