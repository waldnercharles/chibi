    if (target == "chibi_asset_compiler_host") {
        return [
            "public/asset_compiler_host", "private/asset_compiler_host", "build/sdk/generated/assets",
            "third_party/yyjson", "public/asset_values", "public/support", "public/compiler_host",
            "public/behavior_runtime", "public/execution", "public/types", "public/execution_contract", "public/capabilities",
            "public/ecs", "public/tasks", "public/events", "public/asset_json", "public/json"
        ];
    }
    if (target == "reflect") {
        return ["public/capabilities", "public/types", "public/support", "public/execution_contract"];
    }
    if (target == "chibi_save_runtime") {
        return [
            "public/save_runtime", "third_party/yyjson", "public/native_capabilities", "public/capabilities",
            "public/types", "public/support", "public/execution_contract", "public/json"
        ];
    }
    if (target == "chibi_component_presentation") {
        return [
