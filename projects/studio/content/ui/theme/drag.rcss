/* Drag and drop (dnd-kit): the overlay follows the pointer; targets light up. */
.drag-overlay {
    position: absolute; display: flex; align-items: center; gap: 6dp; height: 24dp; padding: 0dp 8dp;
    background-color: var(--popover); border: 1dp var(--popover-edge); border-radius: var(--r); color: var(--foreground);
    pointer-events: none; z-index: 45; white-space: nowrap; opacity: 0.92;
    transition: opacity 0.12s cubic-out;
}
.drag-overlay[data-starting-style], .drag-overlay[data-ending-style] { opacity: 0; }
.drag-overlay .label { display: block; line-height: 16dp; }
.drag-overlay[data-over] { border-color: var(--primary); }
[data-dragging] { opacity: 0.5; }
[data-drop-over] { background-color: var(--primary-soft); }
.tree-row[data-drop-over] { border-color: var(--primary); }
