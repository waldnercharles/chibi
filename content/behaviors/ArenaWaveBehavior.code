behavior "ArenaWaveBehavior" {
    owner "ecs.entity";
    state Interval: float = 4.0;
    state Elapsed: float = 3.8;
    state "Enemy Count": int = 0;
    state "Player Alive": bool = false;
    state "Pending Deaths": bool = false;
    state "Formation Position": struct<"GameTransform"> = {
        x: 0.0,
        y: 0.0
    };
    value integer_equal = integer_equal(A: &component("GAME.GameEncounter", "status"), B: 0);
    on Tick as tick() {
        await "Refresh Encounter"();
        if (integer_equal) {
            "Advance Wave"("Arena Center": convert<"game_transform_to_cf">(get_game_transform()));
        } else {
        }
    }
    on RefreshEncounter as refreshencounter() {
        "Refresh Encounter"();
    }
    function "Refresh Encounter"() -> () {
        depth_limit 0;
        value find_entities_with_component = find_entities_with_component(Component: "GAME.GamePickup");
        after entry {
            if (cast<double>(&component("GAME.GameEncounter", "status")) != 2) {
                await "Count Living Members"();
                await set_game_encounter_alive(Value: &state."Enemy Count", Target: 0);
                if (&state."Player Alive") {
                    if (cast<double>(&component("GAME.GameEncounter", "status")) == 0 && cast<double>(&component("GAME.GameEncounter", "spawned")) >= cast<double>(&component("GAME.GameEncounter", "total")) && cast<double>(&state."Enemy Count") == 0 && !&state."Pending Deaths") {
                        if (convert<"To Real">(length(Array: handle<"ecs.entity">[] = find_entities_with_component)) == 0) {
                            await set_game_encounter_status(Value: 1, Target: 0);
                            return();
                        } else {
                            foreach (foreach_2 in find_entities_with_component) {
                                send_event<"CollectExperience">(Entity: foreach_2);
                            }
                            return();
                        }
                    } else {
                        return();
                    }
                } else {
                    await set_game_encounter_status(Value: 2, Target: 0);
                    return();
                }
            } else {
                return();
            }
        }
    }
    function "Count Living Members"() -> () {
        depth_limit 0;
        action count_members_snapshot = "Count Members Snapshot"();
        after entry {
            count_members_snapshot();
        }
        after count_members_snapshot {
            await set_variable<"Enemy Count">(Value: count_members_snapshot."Enemy Count");
            await set_variable<"Player Alive">(Value: bool = count_members_snapshot."Player Alive");
            await set_variable<"Pending Deaths">(Value: bool = count_members_snapshot."Pending Deaths");
            return();
        }
    }
    function "Advance Wave"("Arena Center": struct<"CF_V2"> = null) -> () {
        depth_limit 0;
        value add = add(A: int = &component("GAME.GameEncounter", "spawned"), B: int = 1);
        value add_2 = add(A: int = &component("GAME.GameEncounter", "alive"), B: int = 1);
        value max_interval_0_01: double = (max(cast<double>(&state.Interval), 0.01));
        local "Spawn Interval" = max_interval_0_01;
        after entry {
            if (cast<double>(&component("GAME.GameEncounter", "spawned")) < cast<double>(&component("GAME.GameEncounter", "total"))) {
                &state.Elapsed += cast<double>(&delta);
                while (greater_or_equal(A: &state.Elapsed, B: &local."Spawn Interval")) {
                    if (cast<double>(&component("GAME.GameEncounter", "spawned")) < cast<double>(&component("GAME.GameEncounter", "total"))) {
                        &state.Elapsed -= &local."Spawn Interval";
                        for (forloop in 0..7) {
                            if (cast<double>(&component("GAME.GameEncounter", "spawned")) < cast<double>(&component("GAME.GameEncounter", "total"))) {
                                await "Spawn Telegraph"("Arena Center": entry."Arena Center", Index: &component("GAME.GameEncounter", "spawned"));
                                await set_game_encounter_spawned(Value: add, Target: 0);
                                set_game_encounter_alive(Value: add_2, Target: 0);
                            } else {
                            }
                        }
                    } else {
                        return();
                    }
                }
                return();
            } else {
                return();
            }
        }
    }
    function "Spawn Telegraph"("Arena Center": struct<"CF_V2"> = null, Index: int = 0) -> () {
        depth_limit 0;
        action spawn_prototype = engine["Spawn Prototype"](Prototype: "ArenaSpawnMarker");
        action spawn_prototype_2 = engine["Spawn Prototype"](Prototype: "ArenaWavePulse");
        value index_8 = "Index % 8"(Index: int = entry.Index);
        action formation_position = "Formation Position"(Center: entry."Arena Center", Index: convert<"To Integer">(&local.Slot), Pattern: convert<"To Integer">("floor(Index / 8) % 4"(Index: int = entry.Index)));
        value atan2_center_y_position_y_center_x_position_x = "atan2(center.y - position.y, center.x - position.x)"(center: struct<"CF_V2"> = entry."Arena Center", position: struct<"GameTransform"> = formation_position.Position);
        local Slot = index_8;
        after entry {
            formation_position();
        }
        after spawn_prototype {
            await set_entity_game_transform(Entity: spawn_prototype.Entity, Value: formation_position.Position);
            await set_game_orientation_radians(Value: atan2_center_y_position_y_center_x_position_x, Target: spawn_prototype.Entity);
            if (&local.Slot == 0) {
                spawn_prototype_2();
            } else {
                return();
            }
        }
        after spawn_prototype_2 {
            await set_entity_game_transform(Entity: spawn_prototype_2.Entity, Value: make_game_transform(x: entry."Arena Center".x, y: entry."Arena Center".y));
            return();
        }
        after formation_position {
            spawn_prototype();
        }
    }
    function "Formation Position"(Center: struct<"CF_V2"> = null, Index: int = 0, Pattern: int = 0) -> (Position: struct<"GameTransform"> = null) {
        depth_limit 64;
        value to_real = to_real(Value: entry.Index);
        value row_formation = "Row Formation"(Center: entry.Center, Index: to_real, Direction: 1.0);
        value row_formation_2 = "Row Formation"(Center: entry.Center, Index: to_real, Direction: -1.0);
        value sign_index_3_5: double = (sign(to_real - 3.5));
        value side_formation = "Side Formation"(Center: entry.Center, Index: to_real, Side: sign_index_3_5);
        value ellipse_formation = "Ellipse Formation"(Center: entry.Center, Index: to_real);
        result Position: struct<"GameTransform"> = get_variable<"Formation Position">();
        after entry {
            match (entry.Pattern) {
                case 0 {
                    await set_variable<"Formation Position">(Value: struct<"GameTransform"> = row_formation);
                    return();
                }
                case 1 {
                    await set_variable<"Formation Position">(Value: struct<"GameTransform"> = row_formation_2);
                    return();
                }
                case 2 {
                    await set_variable<"Formation Position">(Value: struct<"GameTransform"> = side_formation);
                    return();
                }
                default {
                    await set_variable<"Formation Position">(Value: struct<"GameTransform"> = ellipse_formation);
                    return();
                }
            }
        }
    }
    pure function "Row Formation"(Center: struct<"CF_V2"> = null, Index: double = 0.0, Direction: float = 0.0) -> (Position: struct<"GameTransform"> = null) {
        depth_limit 64;
        value make_gametransform = make_game_transform(x: "Row X"(Center: struct<"CF_V2"> = entry.Center, Direction: float = entry.Direction, Index: double = entry.Index), y: "Row Y"(Center: struct<"CF_V2"> = entry.Center, Direction: float = entry.Direction));
        result Position: struct<"GameTransform"> = make_gametransform;
    }
    pure function "Row X"<T0: struct<"CF_V2">, T1: float, T2: double, T3: float>(Center: T0 = null, Direction: T1 = 0.0, Index: T2 = 0.0) -> (Result: T3 = 0.0) {
        depth_limit 64;
        value real = real(Value: 48.0);
        value multiply = multiply(A: double = entry.Direction, B: double = real);
        value real_2 = real(Value: 3.5);
        value subtract = subtract(A: double = entry.Index, B: double = real_2);
        value multiply_2 = multiply(A: double = multiply, B: double = subtract);
        value add = add(A: float = entry.Center.x, B: double = multiply_2);
        result Result: float = add;
    }
    pure function "Row Y"<T0: struct<"CF_V2">, T1: float, T2: float>(Center: T0 = null, Direction: T1 = 0.0) -> (Result: T2 = 0.0) {
        depth_limit 64;
        value real = real(Value: 116.0);
        value multiply = multiply(A: double = entry.Direction, B: double = real);
        value add = add(A: float = entry.Center.y, B: double = multiply);
        result Result: float = add;
    }
    pure function "Side Formation"(Center: struct<"CF_V2"> = null, Index: double = 0.0, Side: float = 0.0) -> (Position: struct<"GameTransform"> = null) {
        depth_limit 64;
        value make_gametransform = make_game_transform(x: "Side X"(Center: struct<"CF_V2"> = entry.Center, Side: float = entry.Side), y: "Side Y"(Center: struct<"CF_V2"> = entry.Center, Index: double = entry.Index));
        result Position: struct<"GameTransform"> = make_gametransform;
    }
    pure function "Side X"<T0: struct<"CF_V2">, T1: float, T2: float>(Center: T0 = null, Side: T1 = 0.0) -> (Result: T2 = 0.0) {
        depth_limit 64;
        value real = real(Value: 220.0);
        value multiply = multiply(A: double = entry.Side, B: double = real);
        value add = add(A: float = entry.Center.x, B: double = multiply);
        result Result: float = add;
    }
    pure function "Side Y"<T0: struct<"CF_V2">, T1: double, T2: float>(Center: T0 = null, Index: T1 = 0.0) -> (Result: T2 = 0.0) {
        depth_limit 64;
        value real = real(Value: 54.0);
        value real_2 = real(Value: 4.0);
        value modulo = modulo(A: double = entry.Index, B: double = real_2);
        value real_3 = real(Value: 1.5);
        value subtract = subtract(A: double = modulo, B: double = real_3);
        value multiply = multiply(A: double = real, B: double = subtract);
        value add = add(A: float = entry.Center.y, B: double = multiply);
        result Result: float = add;
    }
    pure function "Ellipse Formation"(Center: struct<"CF_V2"> = null, Index: double = 0.0) -> (Position: struct<"GameTransform"> = null) {
        depth_limit 64;
        value make_gametransform = make_game_transform(x: "Ellipse X"(Center: struct<"CF_V2"> = entry.Center, Index: double = entry.Index), y: "Ellipse Y"(Center: struct<"CF_V2"> = entry.Center, Index: double = entry.Index));
        result Position: struct<"GameTransform"> = make_gametransform;
    }
    pure function "Ellipse X"<T0: struct<"CF_V2">, T1: double, T2: float>(Center: T0 = null, Index: T1 = 0.0) -> (Result: T2 = 0.0) {
        depth_limit 64;
        value real = real(Value: 225.0);
        value real_2 = real(Value: 3.141592653589793);
        value multiply = multiply(A: double = entry.Index, B: double = real_2);
        value real_3 = real(Value: 4.0);
        value divide = divide(A: double = multiply, B: double = real_3);
        value real_4 = real(Value: 3.141592653589793);
        value real_5 = real(Value: 8.0);
        value divide_2 = divide(A: double = real_4, B: double = real_5);
        value add = add(A: double = divide, B: double = divide_2);
        value cosine = cosine(Value: add);
        value multiply_2 = multiply(A: double = real, B: double = cosine);
        value add_2 = add(A: float = entry.Center.x, B: double = multiply_2);
        result Result: float = add_2;
    }
    pure function "Ellipse Y"<T0: struct<"CF_V2">, T1: double, T2: float>(Center: T0 = null, Index: T1 = 0.0) -> (Result: T2 = 0.0) {
        depth_limit 64;
        value real = real(Value: 108.0);
        value real_2 = real(Value: 3.141592653589793);
        value multiply = multiply(A: double = entry.Index, B: double = real_2);
        value real_3 = real(Value: 4.0);
        value divide = divide(A: double = multiply, B: double = real_3);
        value real_4 = real(Value: 3.141592653589793);
        value real_5 = real(Value: 8.0);
        value divide_2 = divide(A: double = real_4, B: double = real_5);
        value add = add(A: double = divide, B: double = divide_2);
        value sine = sine(Value: add);
        value multiply_2 = multiply(A: double = real, B: double = sine);
        value add_2 = add(A: float = entry.Center.y, B: double = multiply_2);
        result Result: float = add_2;
    }
    function "Count Members Snapshot"() -> ("Enemy Count": int = 0, "Player Alive": bool = false, "Pending Deaths": bool = false) {
        depth_limit 64;
        value find_entities_with_component = find_entities_with_component(Component: "GAME.GameEncounterMember");
        value count_matching_entities = count_matching_entities(Entities: find_entities_with_component, Conditions: [
            {
                component: "GAME.GameHealth",
                field: "current",
                test: ">",
                value: 0.0
            },
            {
                component: "GAME.GameEncounterMember",
                field: "role",
                test: "==",
                value: 1.0
            }
        ]);
        value count_matching_entities_2 = count_matching_entities(Entities: find_entities_with_component, Conditions: [
            {
                component: "GAME.GameHealth",
                field: "",
                test: "missing",
                value: 0.0
            },
            {
                component: "GAME.GameSpawnRequest",
                field: "",
                test: "has",
                value: 0.0
            },
            {
                component: "GAME.GameEncounterMember",
                field: "role",
                test: "==",
                value: 1.0
            }
        ]);
        value count_matching_entities_3 = count_matching_entities(Entities: find_entities_with_component, Conditions: [
            {
                component: "GAME.GameHealth",
                field: "current",
                test: ">",
                value: 0.0
            },
            {
                component: "GAME.GameEncounterMember",
                field: "role",
                test: "==",
                value: 0.0
            }
        ]);
        value count_matching_entities_4 = count_matching_entities(Entities: find_entities_with_component, Conditions: [
            {
                component: "GAME.GameHealth",
                field: "current",
                test: "<=",
                value: 0.0
            }
        ]);
        value integer_greater = integer_greater(A: count_matching_entities_3, B: 0);
        value integer_greater_2 = integer_greater(A: count_matching_entities_4, B: 0);
        result "Enemy Count": int = add(A: int = count_matching_entities, B: int = count_matching_entities_2);
        result "Player Alive": bool = integer_greater;
        result "Pending Deaths": bool = integer_greater_2;
        after entry {
            return();
        }
    }
    pure function "atan2(center.y - position.y, center.x - position.x)"<T0: struct<"CF_V2">, T1: struct<"GameTransform">, T2: double>(center: T0 = null, position: T1 = null) -> (Result: T2 = 0.0) {
        depth_limit 64;
        value subtract = subtract(A: double = entry.center.y, B: double = entry.position.y);
        value subtract_2 = subtract(A: double = entry.center.x, B: double = entry.position.x);
        value atan2 = atan2(Y: subtract, X: subtract_2);
        result Result: double = atan2;
    }
    pure function "Index % 8"<T0: int, T1: double>(Index: T0 = 0) -> (Result: T1 = 0.0) {
        depth_limit 64;
        value real = real(Value: 8.0);
        value modulo = modulo(A: double = convert<"To Real">(entry), B: double = real);
        result Result: double = modulo;
    }
    pure function "floor(Index / 8) % 4"<T0: int, T1: double>(Index: T0 = 0) -> (Result: T1 = 0.0) {
        depth_limit 64;
        value real = real(Value: 8.0);
        value divide = divide(A: double = convert<"To Real">(entry), B: double = real);
        value floor = floor(Value: divide);
        value real_2 = real(Value: 4.0);
        value modulo = modulo(A: double = floor, B: double = real_2);
        result Result: double = modulo;
    }
}
