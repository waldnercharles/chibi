+// Traits omitted by retained scalar metadata must not widen slice admission.
+CheckScalarAnnotations :: () {
+    ordinary := Accepted("package p\nNumber :: (x: i64) -> i64 { saved: i64 = x; return saved; }\nFlag :: (x: bool) -> bool { saved: bool = x; return saved; }\n");
+    assert(ordinary.parameter_types[0] == typed.I64 && ordinary.parameter_types[1] == typed.Bool &&
+           ordinary.signatures[0].result_type == typed.I64 && ordinary.signatures[1].result_type == typed.Bool,
+           "ordinary scalar parameter, result and local annotations remain admitted");
+    assert(length(ordinary.values) == 2 && ordinary.values[0].type == typed.I64 &&
+           ordinary.values[1].type == typed.Bool, "ordinary annotated locals preserve their parameter values");
+    message := "vNext requires canonical ordinary i64, bool or BorrowedBytes";
+    for (scalar in ["i64", "bool"]) {
+        // Each source has just one nonordinary annotation, so the diagnostic
+        // must identify that complete type rather than a body/type mismatch.
+        annotations := [strings.Concatenate(["plain ", scalar]),
+                        strings.Concatenate(["service ", scalar]),
+                        strings.Concatenate(["setting ", scalar]),
+                        strings.Concatenate(["self ", scalar]),
+                        strings.Concatenate(["wildcard(1) ", scalar]),
+                        strings.Concatenate(["(", scalar, ")"])];
+        for (annotation in annotations) {
+            parameter := strings.Concatenate(["package p\nF :: (x: ", annotation, ") -> ", scalar, " { return x; }\n"]);
+            result := strings.Concatenate(["package p\nF :: (x: ", scalar, ") -> ", annotation, " { return x; }\n"]);
+            local := strings.Concatenate(["package p\nF :: (x: ", scalar, ") -> ", scalar, " { saved: ", annotation, " = x; return saved; }\n"]);
+            CheckRejectedAt(parameter, message, annotation);
+            CheckRejectedAt(result, message, annotation);
+            CheckRejectedAt(local, message, annotation);
+        }
+    }
+}
