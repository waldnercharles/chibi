package probe

import compiler "project:package_compiler"
import binding "project:lexical_binding"
import facts "project:scalar_facts"
import scalar "project:scalar_llvm"
import abi "project:native_abi"
import strings "core:strings"
import syntax "project:syntax_diagnostics"
import os "core:os"
import route "project:driver_paths"

// run.sh appends the driver's actual catalog, not a second maintained copy.
Main :: () -> int {
    TypedEffects();
    ExistingMathOverloads();
    first := "package main\nMain :: () -> int { return Missing(); }\n";
    Rejected(["Main.chibi"], [first], first, "Missing", "Unknown function 'Missing'", 2, 28);

    root_source := "package main\nimport lib \"project:lib\"\nMain :: () -> int { return lib.Value(); }\n";
    bad := "package lib\npub Value :: () -> int { return Missing(); }\n";
    joined := strings.Concatenate([root_source, bad]);
    Rejected(["Main.chibi", "lib/Lib.chibi"], [root_source, bad], joined, "Missing", "Unknown function 'Missing'", 5, 33);

    parse := "package main\nMain :: () -> int { return 1;\n";
    ParseRejected(["Main.chibi"], [parse], parse, 3, "Expected `}`, found the end of the file (to close the `{` at 2:19)");
    parse_import := "package lib\npub Value :: () -> int { return 1;\n";
    ParseRejected(["Main.chibi", "lib/Lib.chibi"], [root_source, parse_import], strings.Concatenate([root_source, parse_import]), 6, "Expected `}`, found the end of the file (to close the `{` at 2:24)");

    Message(["core"], ["/sdk/core"], ["Main.chibi"], [parse],
            "rejected Main: Expected `}`, found the end of the file (to close the `{` at 2:19) (Main.chibi:3)");
    Message(["core"], ["/sdk/core"], ["Main.chibi", "lib/Lib.chibi"], [root_source, parse_import],
            "rejected Value: Expected `}`, found the end of the file (to close the `{` at 2:24) (lib/Lib.chibi:3)");

    // Parsing stops before later inputs are retained. EOF belongs to the
    // rejected document, not the next file at that joined byte boundary.
    ParseRejected(["Main.chibi", "unused/U.chibi"], [parse, "package unused\n"], parse, 3,
                  "Expected `}`, found the end of the file (to close the `{` at 2:19)");
    Message(["core"], ["/sdk/core"], ["Main.chibi", "unused/U.chibi"], [parse, "package unused\n"],
            "rejected Main: Expected `}`, found the end of the file (to close the `{` at 2:19) (Main.chibi:3)");
    Message(["core"], ["/sdk/core"], ["Main.chibi", "lib/Lib.chibi", "unused/U.chibi"],
            [root_source, parse_import, "package unused\n"],
            "rejected Value: Expected `}`, found the end of the file (to close the `{` at 2:24) (lib/Lib.chibi:3)");

    // Pointer-free record summaries are supported. Pointer-bearing records still
    // reject at the ordinary native-call boundary, with the same imported span.
    unsupported := "package lib\nPoint :: struct { x: ^int; }\npub Value :: () -> int { value := 1; p: Point = {x: &value}; return text_byte_length(format_text(\"{}\", p)); }\n";
    Rejected(["Main.chibi"], [unsupported], unsupported, "p", "Native calls cannot retain managed pointer arguments", 3, 104);
    Rejected(["Main.chibi", "lib/Lib.chibi"], [root_source, unsupported], strings.Concatenate([root_source, unsupported]),
             "p", "Native calls cannot retain managed pointer arguments", 6, 104);

    // The on-disk target is deliberately a different length from its replacement.
    uses_target := "package main\nimport target \"core:target\"\nimport lib \"project:lib\"\nMain :: () -> int { return lib.Value() + target.Native; }\n";
    actual_target := compiler.TargetPackageText(1, 1, 64, 1);
    target_joined := strings.Concatenate([uses_target, actual_target, bad]);
    Rejected(["Main.chibi", "/sdk/core/target/Target.chibi", "lib/Lib.chibi"],
             [uses_target, "package target\n", bad], target_joined, "Missing", "Unknown function 'Missing'",
             strings.Count(uses_target, "\n") + strings.Count(actual_target, "\n") + 2, 33);
    Message(["core"], ["/sdk/core"], ["Main.chibi", "/sdk/core/target/Target.chibi", "lib/Lib.chibi"],
            [uses_target, "package target\n", bad], "rejected Value: Unknown function 'Missing' (lib/Lib.chibi:2)");
    Message(["core"], ["/relocated SDK/core"], ["Main.chibi", "/relocated SDK/core/target/Target.chibi", "lib/Lib.chibi"],
            [uses_target, "package target\n", bad], "rejected Value: Unknown function 'Missing' (lib/Lib.chibi:2)");
    project_target := strings.ReplaceAll(uses_target, "core:target", "project:target");
    Message(["core"], ["/sdk/core"], ["Main.chibi", "target/Target.chibi", "lib/Lib.chibi"],
            [project_target, "package target\npub Native: int : 1\n", bad], "rejected Value: Unknown function 'Missing' (lib/Lib.chibi:2)");
    return 0;
}

// A typed scheduling summary follows actual calls, including recursive and
// imported calls. An unrelated function with the same name stays independent.
TypedEffects :: () {
    source := "package main\nimport other \"project:other\"\nforeign { External :: () -> int }\nMain :: () -> int { return 0; }\nPure :: () -> int { values: int[] = [1, 2]; values[0] = 3; return length(values); }\nCallsPure :: () -> int { return Pure(); }\nLeaf :: () -> int { return External(); }\nMid :: () -> int { return Leaf(); }\nCycleA :: (n: int) -> int { if (n > 0) { return CycleB(n - 1); } return Leaf(); }\nCycleB :: (n: int) -> int { return CycleA(n); }\nImported :: () -> int { return other.Value(); }\n";
    other := "package other\nforeign { ExternalOther :: () -> int }\npub Value :: () -> int { return ExternalOther(); }\nPure :: () -> int { return 1; }\n";
    collected := compiler.CollectScalarProgramWithEffects("/project", [], [], ["Main.chibi", "other/Other.chibi"],
        [source, other], TargetFacts(), Names(), Natives(), Ports(), Identities(), 1, 1, "Main");
    if (length(collected.rows) <= 2 || collected.rows[1].kind == facts.RejectionRow) {
        os.Print(collected.rows[length(collected.rows) - 1].text);
    }
    assert(length(collected.rows) > 2 && collected.rows[1].kind != facts.RejectionRow, "typed effect input compiles");
    masks: [string: int] = [:];
    at := 0;
    for (row in collected.rows) {
        if (row.kind == facts.FunctionRow) {
            if (row.start < strings.ByteLength(source)) { masks[row.name] = collected.effects[at]; }
            at += 1;
        }
    }
    assert(at == length(collected.effects), "one mask per function, no facts payload overload");
    assert(masks["Main"] == 0 && masks["Pure"] == 0 && masks["CallsPure"] == 0, "local mutation and pure calls stay pure");
    assert(masks["Leaf"] == 3 && masks["Mid"] == 3 && masks["CycleA"] == 3 && masks["CycleB"] == 3 &&
           masks["Imported"] == 3, "foreign read/write effects close across calls and cycles");
    rejected := compiler.CollectScalarProgramWithEffects("/project", [], [], ["Main.chibi"],
        ["package main\nMain :: () -> int { return Missing(); }\n"], TargetFacts(), Names(), Natives(), Ports(), Identities(), 1, 1, "Main");
    assert(length(rejected.effects) == 0 && rejected.rows[1].kind == facts.RejectionRow, "rejection publishes no partial masks");
}

Collect :: (paths: string[], sources: string[]) -> facts.Row[] {
    return compiler.CollectScalarProgram("/project", ["core"], ["/sdk/core"], paths, sources,
                                         TargetFacts(), Names(), Natives(), Ports(), Identities(), 1, 1, "");
}

Rejected :: (paths: string[], sources: string[], joined: string, excerpt: string, message: string, line: int, column: int) {
    rows := Collect(paths, sources);
    assert(length(rows) == 2);
    assert(rows[0].kind == facts.SourceRow && rows[0].name == paths[0] && rows[0].text == joined);
    assert(rows[1].kind == facts.RejectionRow && rows[1].text == message);
    assert(rows[1].start == strings.LastIndex(joined, excerpt));
    assert(rows[1].end == rows[1].start + strings.ByteLength(excerpt));
    assert(rows[1].line == line && rows[1].column == column);
    assert(scalar.Validate(rows) == "");
}

ParseRejected :: (paths: string[], sources: string[], joined: string, line: int, message: string) {
    rows := Collect(paths, sources);
    assert(length(rows) == 2);
    assert(rows[0].kind == facts.SourceRow && rows[0].name == paths[0] && rows[0].text == joined);
    assert(rows[1].kind == facts.RejectionRow);
    assert(rows[1].text == message);
    assert(rows[1].start == strings.ByteLength(joined) && rows[1].end == rows[1].start);
    assert(rows[1].line == line && rows[1].column == 1);
    assert(scalar.Validate(rows) == "");
}

Message :: (collections: string[], directories: string[], paths: string[], sources: string[], expected: string) {
    switch Module(collections, directories, paths, sources, "x86_64-unknown-linux-gnu", "", "") {
        case .Rejected(message):
            assert(message == expected);
        case .Emitted(text):
            assert(false);
    }
}

// A game/runtime catalog can already contain the two canonical math forms.
// Reusing them must not inject duplicate candidates and create ambiguity.
ExistingMathOverloads :: () {
    for (count in [int(1), 2]) {
        natives := Natives();
        ports := Ports();
        identities := Identities();
        for (index in 0..<count) {
            storage := 11;
            if (index == 1) { storage = 10; }
            first := length(ports);
            natives.append({name: "fmod", first: first, parameters: 2, results: 1, variadic: false, effects: 0});
            for (name in ["Value", "Divisor", "Result"]) {
                ports.append({name: name, storage: storage, container: 0, c_string: false});
            }
            identities.append(binding.ID("test-math-native", format_text("fmod:{}", storage)));
            identities.append(binding.ID("test-math-signature", format_text("fmod:{}", storage)));
        }
        source := "package main\nMain :: () -> int { return int(fmod(i64(16777217), i64(2))); }\n";
        rows := compiler.CollectScalar("/project", "Main.chibi", source, TargetFacts(), Names(), natives, ports, identities);
        assert(length(rows) > 1);
        if (count == 2) {
            assert(rows[1].kind != facts.RejectionRow, "existing canonical fmod overloads are not duplicated");
            assert(scalar.Validate(rows) == "");
        } else {
            assert(rows[1].kind == facts.RejectionRow, "a different catalog cannot silently gain f32 math");
            unused := "package main\nMain :: () -> int { return 0; }\n";
            accepted := compiler.CollectScalar("/project", "Main.chibi", unused, TargetFacts(), Names(), natives, ports, identities);
            assert(length(accepted) > 1 && accepted[1].kind != facts.RejectionRow, "unused capabilities remain valid");
            shadow := "package main\nMain :: () -> int { return fmod(); }\nfmod :: () -> int { return 42; }\n";
            accepted = compiler.CollectScalar("/project", "Main.chibi", shadow, TargetFacts(), Names(), natives, ports, identities);
            assert(length(accepted) > 1 && accepted[1].kind != facts.RejectionRow, "authored fmod shadows an unsupported capability");
        }
    }
}
