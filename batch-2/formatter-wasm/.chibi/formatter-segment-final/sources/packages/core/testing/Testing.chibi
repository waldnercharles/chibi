package testing

import target "core:target"

when target.Native == 1 {
    import native "core:testing/native"
    ExpectKind :: (kind: int) {
        native.ExpectKind(kind);
    }
} else {
    ExpectKind :: (kind: int) {
        test_expect_failure(kind);
    }
}

// Expected run-time failures, as Odin's core:testing has expect_assert: a test
// that calls ExpectFailure passes only by ending with that kind of failure.
// Nothing unwinds or recovers; the failure ends the test as it would anyway.

// The run-time failures the test runner tells apart, in its order.
pub Failure :: union {
    IndexOutOfRange
    | MapKeyAbsent
    | ViewOutOfRange
    | AssertionFailed
    | BudgetExhausted
    | DepthExceeded
    | UnwrappedNil
}

// Makes the running test pass only if it ends with `failure`. Call it right
// before the call that must fail: a failure before it still fails the test,
// and returning normally after it fails the test too.
pub ExpectFailure :: (failure: Failure) {
    switch failure {
        case .IndexOutOfRange: ExpectKind(1);
        case .MapKeyAbsent: ExpectKind(2);
        case .ViewOutOfRange: ExpectKind(3);
        case .AssertionFailed: ExpectKind(4);
        case .BudgetExhausted: ExpectKind(5);
        case .DepthExceeded: ExpectKind(6);
        case .UnwrappedNil: ExpectKind(7);
    }
}
