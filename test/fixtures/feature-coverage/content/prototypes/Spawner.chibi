package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Spawner")),
            data.Field.Named("components", data.Object([
                data.Field.Named("GlobalBinding", data.Object([
                    data.Field.Named("name", data.Value.Text("Spawner"))
                ])),
                data.Field.Named("Health", data.Object([
                    data.Field.Named("current", data.Value.UInt(3)),
                    data.Field.Named("maximum", data.Value.UInt(3))
                ])),
                data.Field.Named("Transform", data.Object([]))
            ])),
            data.Field.Named("children", data.List([
                data.Object([
                    data.Field.Named("name", data.Value.Text("Antenna")),
                    data.Field.Named("prototype", data.Value.Text("Antenna"))
                ])
            ]))
        ])
    );
}
