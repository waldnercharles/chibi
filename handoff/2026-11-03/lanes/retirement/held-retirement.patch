-        case BF_ARRAY:
-        case BF_TYPE_NAME:
-        case BF_STORAGE_NAME:
-        case BF_OWN_NAME:
-        case BF_HOST_SERVICE:
-        case BF_COMMAND_SERVICE:
-        case BF_COMMAND_RESULT:
