package facts
Point :: struct { x: int; y: int; }
Grow :: (xs: int[], n: int) -> int[] { xs = append(xs, n); xs[0] = 9; return xs; }
Swap :: (p: Point, q: Point) -> int { p = q; return p.x * 10 + q.y; }
Caller :: () -> int {
    xs: int[] = [1, 2];
    ys := Grow(xs, 5);
    a: Point = {x: 1, y: 2};
    b: Point = {x: 3, y: 4};
    return xs[0] * 1000 + length(ys) * 100 + ys[0] * 10 + Swap(a, b) - a.x * 34;
}