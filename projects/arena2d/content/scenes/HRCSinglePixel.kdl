version 1
name "HRCSinglePixel"
(array)entities {
    - {
        name "Camera"
        prototype "Camera"
        components {
            GameTransform x=0.0 y=0.0
        }
    }
    - {
        name "HRC"
        prototype "HRC"
        components {
            GameTransform x=0.0 y=0.0
        }
    }
    - {
        name "Single pixel"
        prototype "Crystal"
        components {
            GameTransform x=-190.0 y=0.0
            GameAppearance width=4.0 height=4.0 color=0xffffffff
            GameMaterial emission_color=0xffffffff emission_intensity=0.1 absorption=0.0 scene=0xffffffff edge_light=0.0
        }
    }
    - {
        name "Receiver"
        prototype "HardRock"
        components {
            GameTransform x=250.0 y=0.0
            GameAppearance width=260.0 height=360.0
            GameMaterial absorption=0.2 edge_light=0.0
        }
    }
    - {
        name "Receiver edge"
        prototype "Crystal"
        components {
            GameTransform x=150.0 y=180.0
            GameAppearance width=180.0 height=18.0
            GameMaterial absorption=0.5 edge_light=0.0
        }
    }
}
