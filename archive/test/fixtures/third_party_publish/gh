#!/bin/sh
# Local-only transport fixture. C/pico owns the assertions and all test state.
set -eu
printf '%s\n' "$*" >> "$MOCK_GH_STATE/calls"
if [ "$1" = api ]; then
    case "$2" in
        */pulls\?head=owner:prepared-source\&state=all|*/pulls\?head=owner:prepared%2Fsource%23review%261\&state=all)
            if [ -f "$MOCK_GH_STATE/api-denied" ]; then printf '{"status":"403"}'; exit 1; fi
            if [ -f "$MOCK_GH_STATE/pin-branch-after-local-commit" ] || [ -f "$MOCK_GH_STATE/pin-pr-after-local-commit.json" ]; then
                if git show-ref --verify --quiet "refs/heads/pin-$RELEASE"; then
                    if [ -f "$MOCK_GH_STATE/pin-branch-after-local-commit" ]; then
                        git push origin "$(cat "$MOCK_GH_STATE/pin-branch-after-local-commit"):refs/heads/pin-$RELEASE" >/dev/null 2>&1
                        rm "$MOCK_GH_STATE/pin-branch-after-local-commit"
                    fi
                    if [ -f "$MOCK_GH_STATE/pin-pr-after-local-commit.json" ]; then
                        mv "$MOCK_GH_STATE/pin-pr-after-local-commit.json" "$MOCK_GH_STATE/pr.json"
                    fi
                fi
            fi
            if [ -f "$MOCK_GH_STATE/source-pr.json" ]; then cat "$MOCK_GH_STATE/source-pr.json"; else printf '[]'; fi ;;
        */pulls\?*)
            if [ -f "$MOCK_GH_STATE/api-denied" ]; then printf '{"status":"403"}'; exit 1; fi
            if [ -f "$MOCK_GH_STATE/pr.json" ]; then cat "$MOCK_GH_STATE/pr.json"; else printf '[]'; fi ;;
        */releases/tags/*)
            if [ ! -f "$MOCK_GH_STATE/release" ]; then printf '{"status":"404"}'; exit 1; fi
            printf '{"draft":false,"prerelease":true,"assets":['
            if [ -f "$MOCK_GH_STATE/assets" ]; then awk 'NR>1 {printf ","} {printf "%s",$0}' "$MOCK_GH_STATE/assets"; fi
            printf ']}' ;;
        *) exit 91 ;;
    esac
elif [ "$1 $2" = 'release create' ]; then
    git tag "$3" "$GITHUB_SHA"
    git push origin "refs/tags/$3"
    touch "$MOCK_GH_STATE/release"
elif [ "$1 $2" = 'release upload' ]; then
    name=${4##*/}
    if command -v sha256sum >/dev/null 2>&1; then
        digest=$(sha256sum "$4" | awk '{print $1}')
    else
        digest=$(shasum -a 256 "$4" | awk '{print $1}')
    fi
    size=$(wc -c < "$4" | tr -d ' ')
    printf '{"name":"%s","state":"uploaded","size":%s,"digest":"sha256:%s"}\n' "$name" "$size" "$digest" >> "$MOCK_GH_STATE/assets"
    if [ -f "$MOCK_GH_STATE/move-tag" ]; then
        git push --force origin "$(cat "$MOCK_GH_STATE/move-tag"):refs/tags/$3" >/dev/null 2>&1
    fi
    if [ -f "$MOCK_GH_STATE/source-pr-after-upload.json" ]; then
        mv "$MOCK_GH_STATE/source-pr-after-upload.json" "$MOCK_GH_STATE/source-pr.json"
    fi
    if [ -f "$MOCK_GH_STATE/move-main" ]; then
        git push origin "$(cat "$MOCK_GH_STATE/move-main"):refs/heads/main" >/dev/null 2>&1
        rm "$MOCK_GH_STATE/move-main"
    fi
    if [ -f "$MOCK_GH_STATE/move-source" ]; then
        git push origin "$(cat "$MOCK_GH_STATE/move-source"):refs/heads/prepared-source" >/dev/null 2>&1
        rm "$MOCK_GH_STATE/move-source"
    fi
elif [ "$1 $2" = 'pr create' ]; then
    touch "$MOCK_GH_STATE/pr-created"
    printf 'https://github.com/owner/repo/pull/1\n'
else
    exit 92
fi
