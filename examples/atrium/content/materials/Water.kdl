version 3
name "Water"
domain "material"
id_counter 12000
description "Still, dark water whose drifting ripples reflect the sky."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 200
                type "Behavior Expression"
                reference_name "noise(p + vec3(t * 6, 0, t * 4), 0.04) * 1.2 + noise(p - vec3(t * 3, 0, t * 5), 0.09) * 0.5"
                inputs {
                    p id=201 type="struct" type_name="ShaderVec3"
                    t id=202 type="float"
                }
                outputs {
                    Result id=250 type="float"
                }
            }
            - {
                id 1100
                type "Shader Surface Output"
                inputs {
                    "Base Color" {
                        default x=0.01 y=0.018 z=0.022
                    }
                    Roughness 0.03
                    "Alpha Mode" 1
                }
            }
            - id=2000 type="Shader WorldPosition"
            - id=3000 type="Shader Time"
            - {
                id 4000
                type "Shader Bump"
                inputs Distance=0.6
            }
        }
        (array)edges {
            - from="200.Result" to="4000.Height"
            - from="2000.Value" to="200.p"
            - from="3000.Value" to="200.t"
            - from="4000.Value" to="1100.Normal"
        }
    }
    - id=10000 kind="function" math_expression="noise(p + vec3(t * 6, 0, t * 4), 0.04) * 1.2 + noise(p - vec3(t * 3, 0, t * 5), 0.09) * 0.5" expression_mode=1 entry_id=10001
}
