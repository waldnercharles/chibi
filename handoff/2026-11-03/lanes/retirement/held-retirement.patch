-static inline FILE *build_timing_open(const char *directory)
-{
-    if (!directory || !directory[0]) {
-        return NULL;
-    }
-    char path[4096];
-    for (int i = 0; i < BUILD_TIMING_FILES; i++) {
-        int length = snprintf(path, sizeof path, "%s/%02d.tsv", directory, i);
