// Adapted from Neon-Swarm shaders/hrc/blur.shd; original source comments retained.
// 3x3 edge-aware Gaussian blur for gather output.
// Weights: [1 2 1]^2 / 16. Skips taps where transmittance
// differs from center by more than u_threshold (hard edge detection).

layout (set = 0, binding = 0) uniform sampler2D u_in_radiance;
layout (set = 0, binding = 1) uniform sampler2D u_transmittance;
layout (set = 0, binding = 2) uniform sampler2D u_prev_radiance;

#ifdef HRC_LUMINANCE
layout (set = 1, binding = 0, r16f) uniform writeonly image2D u_out;
#else
layout (set = 1, binding = 0, rgba16f) uniform writeonly image2D u_out;
#endif

layout (set = 2, binding = 0) uniform blur_params
{
    vec2 u_texel_size;
    float u_threshold;
    float u_hysteresis;
    vec2 u_history_offset;
    int u_history_valid;
};

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

vec3 input_radiance(vec2 uv)
{
    vec3 value = texture(u_in_radiance, uv).rgb;
    #ifdef HRC_LUMINANCE_FROM_RGB
    return vec3(dot(value, vec3(0.2126, 0.7152, 0.0722)));
    #elif defined(HRC_LUMINANCE)
    return vec3(value.r);
    #else
    return value;
    #endif
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_out);
    if (p.x >= size.x || p.y >= size.y) return;

    vec2 uv = (vec2(p) + vec2(0.5)) / vec2(size);

    #ifdef HRC_LUMINANCE_FROM_RGB
    // RGB has already been spatially and temporally filtered. Conversion must
    // not add a second history trail or lose more detail.
    imageStore(u_out, p, vec4(input_radiance(uv).r, 0, 0, 0));
    return;
    #endif

    vec3 center_t = texture(u_transmittance, uv).rgb;
    float center_s = dot(center_t, vec3(1.0/3.0));

    bool history_active = false;
    vec2 history_uv = uv;
    if (u_hysteresis < 1.0 && u_history_valid != 0) {
        history_uv += u_history_offset;
        vec2 inset = u_texel_size * 0.5;
        history_active = all(greaterThanEqual(history_uv, inset)) &&
                         all(lessThanEqual(history_uv, vec2(1.0) - inset));
    }

    // 1D weights: [1 2 1] / 4
    const float w1d[3] = float[3](1.0/4.0, 2.0/4.0, 1.0/4.0);

    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    vec3 lower = vec3(0.0), upper = vec3(0.0);
    if (history_active) {
        lower = input_radiance(uv);
        upper = lower;
    }

    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            vec2 uv_q = uv + vec2(float(dx), float(dy)) * u_texel_size;

            vec3 t = texture(u_transmittance, uv_q).rgb;
            float s = dot(t, vec3(1.0/3.0));
            float edge_w = 1.0 - smoothstep(0.0, u_threshold, abs(s - center_s));

            float w = w1d[dx + 1] * w1d[dy + 1] * edge_w;
            vec3 current = input_radiance(uv_q);
            sum += current * w;
            wsum += w;
            if (history_active && edge_w > 0.0) {
                lower = min(lower, current);
                upper = max(upper, current);
            }
        }
    }

    vec3 out_r = wsum > 0.0 ? sum / wsum : input_radiance(uv);
    if (history_active) {
        vec3 prev = texture(u_prev_radiance, history_uv).rgb;
        #ifdef HRC_LUMINANCE
        prev = vec3(prev.r);
        #endif
        out_r = mix(clamp(prev, lower, upper), out_r, u_hysteresis);
    }
    #ifdef HRC_LUMINANCE
    imageStore(u_out, p, vec4(out_r.r, 0, 0, 0));
    #else
    imageStore(u_out, p, vec4(out_r, 1.0));
    #endif
}
