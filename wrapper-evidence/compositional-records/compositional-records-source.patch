+static void cleanup()
+{
+    finish_call();
+    compiler_fixture_free(&fixture);
+    execution_program_free(program);
+    program = NULL;
+    execution_module_free(module);
+    execution_module_free(next);
+    next = NULL;
+    if (world) {
+        ecs_world_free(world);
+        world = NULL;
+    }
+    execution_module_plan_free(plan);
+    module = NULL;
+    plan = NULL;
+    clear_analysis();
+    arena_free(&retained);
+    arena_free(&catalog_storage);
+    free(image);
+    image = NULL;
+    image_size = 0;
