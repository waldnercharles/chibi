package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Vault")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Appearance", data.Object([
                    data.Field.Named("height", data.Value.Real(1200.0)),
                    data.Field.Named("width", data.Value.Real(2400.0))
                ])),
                data.Field.Named("Transform", data.Object([])),
                data.Field.Named("Ui", data.Object([
                    data.Field.Named("document", data.Value.Text("Bank"))
                ]))
            ])),
            data.Field.Named("behaviors", data.List([
                data.Value.Text("Teller")
            ]))
        ])
    );
}
