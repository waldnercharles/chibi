                            data.Field.Named("x", data.Value.Real(0.0)),
                            data.Field.Named("y", data.Value.Real(260.0)),
                            data.Field.Named("reference_name", data.Value.Text("Form")),
                            data.Field.Named("inputs", data.Object([
                                data.Field.Named("Minimum", data.Value.Real(0.0)),
                                data.Field.Named("Maximum", data.Value.Real(1.0))
                            ]))
                        ]),
                        data.Object([
                            data.Field.Named("id", data.Value.UInt(300)),
                            data.Field.Named("type", data.Value.Text("Behavior Expression")),
                            data.Field.Named("x", data.Value.Real(280.0)),
                            data.Field.Named("y", data.Value.Real(230.0)),
                            data.Field.Named("reference_name", data.Value.Text("vec3(14 * form, 3 * form, 2 * form)")),
                            data.Field.Named("inputs", data.Object([
