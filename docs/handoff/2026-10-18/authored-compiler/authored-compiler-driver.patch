+#ifndef CHIBI_TEST_COMPILER_PREPARED_FIXTURE_H
+#define CHIBI_TEST_COMPILER_PREPARED_FIXTURE_H
+
+#include "runtime/native_definitions.h"
+
+#define COMPILER_PREPARED_FIXTURE_SERVICE "compiler_prepared_fixture"
+typedef struct
+{
+    /* Resolve Plan.Ready from project:scalar_lowering export metadata after
+     * bootstrap preparation. Keep immutable while a driver invocation runs. */
+    uint64_t ready_tag;
+} compiler_prepared_fixture_service;
+
+/* Test-only opt-in native catalog. Authored signature:
+ * compiler_prepared_scalar(plan: T, module: uint64, function: uint64,
+ *                          entry: string, result_storage: int)
+ *     -> (bytes: byte[], diagnostic: string)
+ * T is native generic transport, validated by scalar_lowering_decode.
+ * Required service: COMPILER_PREPARED_FIXTURE_SERVICE, pointing to the above.
+ * A bridge rejection returns empty bytes and a nonempty diagnostic; success
+ * returns nonempty inner-module bytes and an empty diagnostic. Both results
+ * belong to invocation value_storage. The callback retains no input/service.
+ * This pack must never be installed in the runtime-only compiler_host.
+ * Tests may copy this single definition/binding to interpose call counting. */
+extern const native_definition_pack COMPILER_PREPARED_FIXTURE_DEFINITION_PACK;
+
+#endif
diff --git a/tools/compiler/bounded_compiler/Artifact.chibi b/tools/compiler/bounded_compiler/Artifact.chibi
new file mode 100644
--- /dev/null
+++ b/tools/compiler/bounded_compiler/Artifact.chibi
@@ -0,0 +1,42 @@
+package bounded_compiler
+
+import strings "core:strings"
+
+// CHIBICLO v1 is ordinary authored package policy. The inner CHIBIPRE v14
+// payload is still produced by the explicitly transitional native finalizer.
+// One closed, import-free module needs no sorting or dependency fingerprints.
+ArtifactWord :: pure fn(bytes: byte[], offset: int, value: uint64) -> byte[] {
+    index: int = 0;
+    while (index < 8) {
+        bytes[offset + index] = cast<byte>(value & cast<uint64>(255));
+        value = value >> 8;
+        index += 1;
+    }
+    return bytes;
+}
+
+Artifact :: pure fn(identity: string, module: uint64, payload: byte[]) -> byte[] {
+    name_size := strings.ByteLength(identity);
+    bytes := resize([cast<byte>(0)], 56 + name_size + length(payload));
+    magic: byte[] = [cast<byte>(67), cast<byte>(72), cast<byte>(73), cast<byte>(66),
+                    cast<byte>(73), cast<byte>(67), cast<byte>(76), cast<byte>(79)];
+    index: int = 0;
+    while (index < 8) { bytes[index] = magic[index]; index += 1; }
+    bytes = ArtifactWord(bytes, 8, cast<uint64>(1));
+    bytes = ArtifactWord(bytes, 16, module);
+    bytes = ArtifactWord(bytes, 24, cast<uint64>(1));
+    bytes = ArtifactWord(bytes, 32, module);
+    bytes = ArtifactWord(bytes, 40, cast<uint64>(name_size));
+    bytes = ArtifactWord(bytes, 48, cast<uint64>(length(payload)));
+    index = 0;
+    while (index < name_size) {
+        bytes[56 + index] = cast<byte>(strings.ByteAt(identity, index));
+        index += 1;
+    }
+    index = 0;
+    while (index < length(payload)) {
+        bytes[56 + name_size + index] = payload[index];
+        index += 1;
+    }
+    return bytes;
+}
diff --git a/tools/compiler/bounded_compiler/Compile.chibi b/tools/compiler/bounded_compiler/Compile.chibi
new file mode 100644
--- /dev/null
+++ b/tools/compiler/bounded_compiler/Compile.chibi
@@ -0,0 +1,263 @@
+package bounded_compiler
+
+import snapshot "project:source_snapshot"
+import analysis "project:analysis_state"
+import routes "project:package_routes"
+import reader "project:signature_reader"
+import binding "project:lexical_binding"
+import named "project:named_binding"
+import constructors "project:type_constructors"
+import lower "project:scalar_lowering"
+import syntax "project:syntax_diagnostics"
+import strings "core:strings"
+
+// An explicit package source snapshot is the complete input. No native source
+// analyzer, package preparer or old compiler is reachable from this entry.
+// Stage zero still builds this compiler closure, and the private prepared
+// payload capability still owns native verification/finalization/inner encoding.
+Result :: union {
+    Rejected(diagnostic: syntax.Diagnostic) |
+    Compiled(module: uint64, function_id: uint64, bytes: byte[])
+}
+ScalarSignature :: union { Accepted(storage: int) | Rejected(diagnostic: syntax.Diagnostic) }
+
+InputFailure :: pure fn(document: int, message: string) -> Result {
+    diagnostic: syntax.Diagnostic = {start: 0, end: 0, line: 1, column: 1,
+                                     document: document, message: message};
+    return Result.Rejected(diagnostic);
+}
+SourceFailure :: pure fn(tree: reader.Tree, node: int, document: int, message: string) -> Result {
+    return Result.Rejected(reader.Diagnostic(tree, node, document, message));
+}
+FirstMember :: pure fn(tree: reader.Tree, parent: int) -> int {
+    if (parent < 0) { return -1; }
+    switch tree { case .Raw(nodes, fields, named_flags, extra_flags, text):
+        return reader.NextMember(tree, nodes[parent].first_child);
+    }
+}
+FollowingMember :: pure fn(tree: reader.Tree, node: int) -> int {
+    switch tree { case .Raw(nodes, fields, named_flags, extra_flags, text):
+        return reader.NextMember(tree, nodes[node].next_sibling);
+    }
+}
+DirectToken :: pure fn(tree: reader.Tree, parent: int, token: string) -> bool {
+    switch tree { case .Raw(nodes, fields, named_flags, extra_flags, text):
+        child := nodes[parent].first_child;
+        while (child >= 0) {
+            if (!extra_flags[child] && nodes[child].kind == token) { return true; }
+            child = nodes[child].next_sibling;
+        }
+        return false;
+    }
+}
+
+LexicalEnvironment :: pure fn(keys: string[]) -> binding.Environment {
+    scope: binding.Scope = {parent: -1, function: -1, start: 0, end: 0,
+                           line: 1, column: 1, document: 0};
+    symbols: binding.Symbol[] = [];
+    functions: binding.Function[] = [];
+    ids: uint64[] = [];
+    return binding.Environment.Tables([scope], symbols, functions, ids, keys);
+}
+SignatureEnvironment :: pure fn(lexical: binding.Environment, identity: string, pointer_size: int) -> reader.Environment {
+    types: named.Type[] = [];
+    ids: uint64[] = [];
+    entries: named.Entry[] = [];
+    indices: int[] = [];
+    imports: named.Import[] = [];
+    exports: named.Export[] = [];
+    uses: named.Use[] = [];
+    names := named.Environment.Tables(lexical, types, ids, entries, entries, entries,
+        indices, imports, exports, uses, identity, 0, false, true, cast<uint64>(0));
+    definitions: constructors.Definition[] = [];
+    variants: constructors.RawVariant[] = [];
+    capabilities: constructors.Capability[] = [];
+    functions: constructors.Function[] = [];
+    symbols: constructors.Symbol[] = [];
+    construction := constructors.Environment.Tables(types, ids, definitions, variants,
+        capabilities, functions, symbols, indices);
+    return reader.Environment.Tables(names, construction, pointer_size);
+}
+ReadSignature :: pure fn(environment: reader.Environment, tree: reader.Tree, node: int, document: int) -> ScalarSignature {
+    // Preserve the real annotation reader's diagnostics and type semantics.
+    // Reject unsupported shape before invoking it, so arbitrary constructor
+    // declarations never expand this deliberately scalar source contract.
+    if (!reader.Kind(tree, node, "type") ||
+        (reader.Text(tree, node) != "int" && reader.Text(tree, node) != "bool")) {
+        return ScalarSignature.Rejected(reader.Diagnostic(tree, node, document, "bounded compiler requires one ordinary int or bool result"));
+    }
+    switch reader.Signature(environment, tree, node, 0, document) {
+        case .Read(value, has_unit, unit, updated, diagnostics, uses, publications):
+            if (length(diagnostics) != 0) { return ScalarSignature.Rejected(diagnostics[0]); }
+            switch value { case .Typed(storage, container, flags, nominal, parameter):
+                if ((storage != 1 && storage != 6) || container != 0 || flags != 0 ||
+                    nominal != cast<uint64>(0) || parameter != cast<uint64>(0) || has_unit ||
+                    length(uses) != 0 || length(publications) != 0) {
+                    return ScalarSignature.Rejected(reader.Diagnostic(tree, node, document, "unsupported bounded result signature"));
+                }
+                return ScalarSignature.Accepted(storage);
+            }
+    }
+}
+
+CompileFunction :: pure fn(tree: reader.Tree, function: int, document: int,
+                           identity: string, keys: string[], abi: lower.Target) -> Result {
+    if (!DirectToken(tree, function, "pure") || reader.Field(tree, function, "type_parameters") >= 0) {
+        return SourceFailure(tree, function, document, "bounded compiler requires a nongeneric pure function");
+    }
+    name_node := reader.Field(tree, function, "name");
+    name := reader.Text(tree, name_node);
+    if (!reader.Kind(tree, name_node, "identifier") || name == "_" || strings.ByteLength(name) > 240) {
+        return SourceFailure(tree, name_node, document, "bounded compiler requires an identifier-named function");
+    }
+    parameters := reader.Field(tree, function, "parameters");
+    if (parameters < 0 || FirstMember(tree, parameters) >= 0) {
+        return SourceFailure(tree, function, document, "bounded compiler supports zero-argument functions only");
+    }
+    lexical := LexicalEnvironment(keys);
+    context: binding.Context = {identity: identity, scope: 0, function: -1,
+        package_scope: 0, has_identity: true, has_documents: true};
+    place := reader.Request(tree, name_node, 0, document, name);
+    request: binding.Request = {name: name, kind: binding.FunctionKind,
+        start: place.start, end: place.end, line: place.line, column: place.column, document: document};
+    function_id: uint64 = cast<uint64>(0);
+    switch binding.Declare(lexical, context, request) {
+        case .Existing(symbol, diagnostics): return Result.Rejected(diagnostics[0]);
+        case .Appended(id, diagnostics):
+            if (length(diagnostics) != 0) { return Result.Rejected(diagnostics[0]); }
+            function_id = id;
+    }
+    pointer_size: int = 4;
+    if (abi.pointer_storage == 9) { pointer_size = 8; }
+    environment := SignatureEnvironment(lexical, identity, pointer_size);
+    result_storage: int = 0;
+    signature := reader.Field(tree, function, "results");
+    switch ReadSignature(environment, tree, signature, document) {
+        case .Rejected(diagnostic): return Result.Rejected(diagnostic);
+        case .Accepted(storage): result_storage = storage;
+    }
+    body := reader.Field(tree, function, "body");
+    statement := FirstMember(tree, body);
+    if (statement < 0 || !reader.Kind(tree, statement, "return_statement") ||
+        FollowingMember(tree, statement) >= 0 || reader.Field(tree, statement, "outcome") >= 0) {
+        return SourceFailure(tree, body, document, "bounded function body needs exactly one ordinary return");
+    }
+    expression := reader.Field(tree, statement, "value");
+    if (expression < 0) { return SourceFailure(tree, statement, document, "bounded return requires a scalar expression"); }
+    switch ReadExpression(tree, expression, document, result_storage) {
+        case .Rejected(diagnostic): return Result.Rejected(diagnostic);
+        case .Accepted(expressions, literals, expression_ranges, result):
+            result_type: int = 0;
+            if (result_storage == 6) { result_type = 1; }
+            if (expressions[result].type != result_type) {
+                return SourceFailure(tree, expression, document, "bounded return expression differs from its declared result type");
+            }
+            boolean: lower.Type = {storage: 1, container: 0, flags: 0, nominal_slot: -1, parameter_slot: -1};
+            integer: lower.Type = {storage: 6, container: 0, flags: 0, nominal_slot: -1, parameter_slot: -1};
+            symbols: lower.Symbol[] = [];
+            variables: lower.Variable[] = [];
+            ids: uint64[] = [];
+            output: lower.Result = {expression: result, type: result_type};
+            ranges := array_add(expression_ranges, ExpressionRange(tree, function, document));
+            facts := lower.Request.Tables([boolean, integer], expressions, symbols, variables,
+                [output], literals, ids, ranges, keys, abi, length(ranges) - 1);
+            plan := lower.Lower(facts);
+            switch plan {
+                case .Rejected(diagnostics):
+                    return SourceFailure(tree, expression, document, diagnostics[0].message);
+                case .Ready(target, variable_ids, defaults, results, slots, locals, origins, documents, code):
+                    module := binding.ID("module", identity);
+                    // A narrow producer capability receives only the authored
+                    // plan, IDs and signature. It never receives source text.
+                    prepared := compiler_prepared_scalar(plan, module, function_id, name, result_storage);
+                    if (prepared.diagnostic != "") {
+                        return SourceFailure(tree, function, document, prepared.diagnostic);
+                    }
+                    if (length(prepared.bytes) == 0 || length(prepared.bytes) > 65536) {
+                        return SourceFailure(tree, function, document, "bounded prepared payload exceeds its output limit");
+                    }
+                    return Result.Compiled(module, function_id, Artifact(identity, module, prepared.bytes));
+            }
+    }
+}
+
+CompileSnapshot :: pure fn(source: snapshot.Result, abi: lower.Target) -> Result {
+    switch source {
+        case .Rejected(diagnostic, related, graph_error, cycle, documents, nodes, imports):
+            return Result.Rejected(diagnostic);
+        case .Accepted(roots, documents, nodes, imports, graph):
+            if (length(imports) != 0) { return InputFailure(imports[0].file, "bounded compiler does not support imports"); }
+            switch graph {
+                case .Rejected(error, cycle): return InputFailure(-1, "bounded compiler requires an accepted package graph");
+                case .Accepted(packages, members, file_packages, order, edges, bindings):
+                    if (length(packages) != 1) { return InputFailure(-1, "bounded compiler requires one complete package"); }
+            }
+            keys: string[] = [];
+            foreach (item in documents) {
+                if (item.node_count > 512 || strings.ByteLength(item.key) > 240 ||
+                    strings.ByteLength(item.identity) > 240) {
+                    return InputFailure(-1, "bounded package syntax or identity exceeds its limit");
+                }
+                keys = array_add(keys, item.key);
+            }
+            function: int = -1;
+            document: int = -1;
+            switch analysis.DocumentsForPackage(source, 0) {
+                case .Missing: return InputFailure(-1, "bounded compiler has no package document map");
+                case .Mapped(local_to_source_file, source_file_to_local):
+                    foreach (source_file in local_to_source_file) {
+                        switch analysis.TreeForDocument(source, source_file) {
+                            case .Missing: return InputFailure(source_file, "bounded compiler has no retained source tree");
+                            case .Parsed(tree, root):
+                                child := FirstMember(tree, root);
+                                while (child >= 0) {
+                                    if (!reader.Kind(tree, child, "package_header")) {
+                                        if (!reader.Kind(tree, child, "function_declaration")) {
+                                            return SourceFailure(tree, child, source_file, "unsupported declaration in bounded package");
+                                        }
+                                        if (function >= 0) {
+                                            return SourceFailure(tree, child, source_file, "bounded package supports exactly one function");
+                                        }
+                                        function = child;
+                                        document = source_file;
+                                    }
+                                    child = FollowingMember(tree, child);
+                                }
+                        }
+                    }
+            }
+            if (function < 0) { return InputFailure(-1, "bounded package needs one function"); }
+            switch analysis.TreeForDocument(source, document) {
+                case .Missing: return InputFailure(document, "bounded compiler lost its retained source tree");
+                case .Parsed(tree, root):
+                    return CompileFunction(tree, function, document, documents[document].identity, keys, abi);
+            }
+    }
+}
+
+Compile :: pure fn(project: string, paths: string[], sources: string[], abi: lower.Target) -> Result {
+    if (length(paths) < 1 || length(paths) > 3 || length(sources) != length(paths)) {
+        return InputFailure(-1, "bounded compiler requires one to three complete source files");
+    }
+    if (strings.ByteLength(project) == 0 || strings.ByteLength(project) > 240 ||
+        abi.schema != 1 || abi.prepared != 14 || (abi.pointer_storage != 7 && abi.pointer_storage != 9)) {
+        return InputFailure(-1, "unsupported bounded compiler root or target");
+    }
+    inputs: snapshot.Input[] = [];
+    sizes: uint64[] = [];
+    index: int = 0;
+    while (index < length(paths)) {
+        if (strings.ByteLength(paths[index]) == 0 || strings.ByteLength(paths[index]) > 240 ||
+            strings.ByteLength(sources[index]) > 1024) {
+            return InputFailure(index, "bounded source path or text exceeds its limit");
+        }
+        input: snapshot.Input = {path: paths[index], text: sources[index], has_path: true, has_text: true};
+        inputs = array_add(inputs, input);
+        sizes = array_add(sizes, cast<uint64>(strings.ByteLength(sources[index])));
+        index += 1;
+    }
+    options: snapshot.Options = {project: project, has_project: true, has_options: true,
+        has_files: true, has_collections: false, file_count: length(inputs), collection_count: 0};
+    collections: routes.Collection[] = [];
+    return CompileSnapshot(snapshot.Build(options, collections, inputs, sizes), abi);
+}
diff --git a/tools/compiler/bounded_compiler/Expression.chibi b/tools/compiler/bounded_compiler/Expression.chibi
new file mode 100644
--- /dev/null
+++ b/tools/compiler/bounded_compiler/Expression.chibi
@@ -0,0 +1,218 @@
+package bounded_compiler
+
+import reader "project:signature_reader"
+import lower "project:scalar_lowering"
+import syntax "project:syntax_diagnostics"
+import strings "core:strings"
+
+ScalarExpression :: union {
+    Rejected(diagnostic: syntax.Diagnostic) |
+    Accepted(expressions: lower.Expression[], literals: lower.Literal[], ranges: lower.Range[], result: int)
+}
+Decimal :: union { Parsed(value: int) | Invalid }
+ExpressionFrame :: struct { node: int; phase: int; left: int; expected: int; }
+
+// Accumulate before conversion so even signed minimum is exact. Other literal
+// syntax and implicit numeric promotion are outside this first source subset.
+DecimalValue :: pure fn(text: string, negative: bool) -> Decimal {
+    size := strings.ByteLength(text);
+    if (size == 0) { return Decimal.Invalid; }
+    magnitude: uint64 = cast<uint64>(0);
+    index: int = 0;
+    while (index < size) {
+        digit := strings.ByteAt(text, index) - 48;
+        if (digit < 0 || digit > 9) { return Decimal.Invalid; }
+        if (magnitude > (cast<uint64>(2147483648) - cast<uint64>(digit)) / cast<uint64>(10)) {
+            return Decimal.Invalid;
+        }
+        magnitude = magnitude * cast<uint64>(10) + cast<uint64>(digit);
+        index += 1;
+    }
+    if (magnitude == cast<uint64>(2147483648)) {
+        if (negative) { return Decimal.Parsed(cast<int>(-2147483648)); }
+        return Decimal.Invalid;
+    }
+    value := cast<int>(magnitude);
+    if (negative) { value = -value; }
+    return Decimal.Parsed(value);
+}
+
+ExpressionRange :: pure fn(tree: reader.Tree, node: int, document: int) -> lower.Range {
+    place := reader.Request(tree, node, 0, document, "");
+    return {start: place.start, end: place.end, line: place.line,
+            column: place.column, document: document};
+}
+
+BinaryOperator :: pure fn(text: string) -> int {
+    if (text == "+") { return 1; }
+    if (text == "-") { return 2; }
+    if (text == "*") { return 3; }
+    if (text == "&&" || text == "and") { return 8; }
+    if (text == "||" || text == "or") { return 9; }
+    if (text == "==") { return 10; }
+    if (text == "!=") { return 11; }
+    if (text == "<") { return 12; }
+    if (text == "<=") { return 13; }
+    if (text == ">") { return 14; }
+    if (text == ">=") { return 15; }
+    if (text == "&") { return 16; }
+    if (text == "|") { return 17; }
+    if (text == "^") { return 18; }
+    return -1;
+}
+
+ExpressionFailure :: pure fn(tree: reader.Tree, node: int, document: int, message: string) -> ScalarExpression {
+    return ScalarExpression.Rejected(reader.Diagnostic(tree, node, document, message));
+}
+
+// Explicit frames bound source traversal independently of callable depth. The
+// only native input is a raw parser tree; all typed rows are constructed here.
+ReadExpression :: pure fn(tree: reader.Tree, root: int, document: int, expected: int) -> ScalarExpression {
+    expressions: lower.Expression[] = [];
+    literals: lower.Literal[] = [];
+    ranges: lower.Range[] = [];
+    initial: ExpressionFrame = {node: root, phase: 0, left: -1, expected: expected};
+    frames := resize([initial], cast<int>(65));
+    top: int = 0;
+    visits: int = 0;
+    value: int = -1;
+    returning: bool = false;
+    while (top >= 0) {
+        frame := frames[top];
+        node := frame.node;
+        row: lower.Expression = {kind: 0, op: 0, left: -1, right: -1,
+            symbol: -1, type: -1, literal: -1, range: length(ranges)};
+        if (returning) {
+            if (frame.phase == 1) { top -= 1; continue; }
+            if (frame.phase == 4) {
+                frame.left = value;
+                frame.phase = 5;
+                frames[top] = frame;
+                next: ExpressionFrame = {node: reader.Field(tree, node, "right"), phase: 0, left: -1, expected: 0};
+                top += 1;
+                frames[top] = next;
+                returning = false;
+                continue;
+            }
+            row.left = value;
+            row.type = expressions[value].type;
+            if (frame.phase == 2) {
+                if (row.type != 1) { return ExpressionFailure(tree, node, document, "bounded compiler supports only identity int casts"); }
+                row.kind = 5;
+            } else if (frame.phase == 3) {
+                row.kind = 3;
+                op := reader.Text(tree, reader.Field(tree, node, "operator"));
+                if (op == "!" || op == "not") {
+                    if (row.type != 0) { return ExpressionFailure(tree, node, document, "logical negation needs bool"); }
+                    row.op = 7;
+                } else {
+                    if (row.type != 1) { return ExpressionFailure(tree, node, document, "integer unary operation needs int"); }
+                    if (op == "-") { row.op = 6; }
+                    if (op == "~") { row.op = 21; }
+                }
+            } else {
+                row.kind = 4;
+                row.left = frame.left;
+                row.right = value;
+                row.op = BinaryOperator(reader.Text(tree, reader.Field(tree, node, "operator")));
+                left_type := expressions[row.left].type;
+                if (left_type != row.type) { return ExpressionFailure(tree, node, document, "bounded binary operands need the same scalar type"); }
+                if (row.op == 8 || row.op == 9) {
+                    if (row.type != 0) { return ExpressionFailure(tree, node, document, "logical operation needs bool operands"); }
+                } else if (row.op == 10 || row.op == 11) {
+                    row.type = 0;
+                } else {
+                    if (row.type != 1) { return ExpressionFailure(tree, node, document, "integer operation needs explicitly typed int operands"); }
+                    if (row.op >= 12 && row.op <= 15) { row.type = 0; }
+                }
+            }
+        } else {
+            visits += 1;
+            if (visits > 64 || top >= 64 || node < 0) {
+                return ExpressionFailure(tree, root, document, "bounded expression exceeds its traversal limit");
+            }
+            if (reader.Kind(tree, node, "parenthesized_expression")) {
+                frame.phase = 1;
+                frames[top] = frame;
+                child: ExpressionFrame = {node: reader.Field(tree, node, "expression"), phase: 0, left: -1, expected: frame.expected};
+                top += 1;
+                frames[top] = child;
+                continue;
+            }
+            if (reader.Kind(tree, node, "cast_expression")) {
+                if (reader.Text(tree, reader.Field(tree, node, "type")) != "int") {
+                    return ExpressionFailure(tree, node, document, "bounded compiler supports only explicit int casts");
+                }
+                frame.phase = 2;
+                frames[top] = frame;
+                child: ExpressionFrame = {node: reader.Field(tree, node, "value"), phase: 0, left: -1, expected: 6};
+                top += 1;
+                frames[top] = child;
+                continue;
+            }
+            if (reader.Kind(tree, node, "binary_expression")) {
+                if (BinaryOperator(reader.Text(tree, reader.Field(tree, node, "operator"))) < 0) {
+                    return ExpressionFailure(tree, node, document, "unsupported bounded binary operator");
+                }
+                frame.phase = 4;
+                frames[top] = frame;
+                child: ExpressionFrame = {node: reader.Field(tree, node, "left"), phase: 0, left: -1, expected: 0};
+                top += 1;
+                frames[top] = child;
+                continue;
+            }
+            negative: bool = false;
+            literal_node := node;
+            if (reader.Kind(tree, node, "unary_expression")) {
+                op := reader.Text(tree, reader.Field(tree, node, "operator"));
+                operand := reader.Field(tree, node, "operand");
+                negative = op == "-" && reader.Kind(tree, operand, "number");
+                if (negative) {
+                    literal_node = operand;
+                } else {
+                    if (op != "!" && op != "not" && op != "+" && op != "-" && op != "~") {
+                        return ExpressionFailure(tree, node, document, "unsupported bounded unary operator");
+                    }
+                    frame.phase = 3;
+                    frames[top] = frame;
+                    child_expected := frame.expected;
+                    if (op == "!" || op == "not") { child_expected = 1; }
+                    child: ExpressionFrame = {node: operand, phase: 0, left: -1, expected: child_expected};
+                    top += 1;
+                    frames[top] = child;
+                    continue;
+                }
+            }
+            row.kind = 1;
+            literal: lower.Literal = {storage: 0, payload: 0};
+            if (reader.Kind(tree, literal_node, "number")) {
+                if (frame.expected != 6) {
+                    return ExpressionFailure(tree, node, document, "bounded integer operands need explicit cast<int>");
+                }
+                switch DecimalValue(reader.Text(tree, literal_node), negative) {
+                    case .Invalid: return ExpressionFailure(tree, node, document, "bounded compiler needs a decimal literal in the int range");
+                    case .Parsed(number): literal.payload = number;
+                }
+                literal.storage = 6;
+                row.type = 1;
+            } else if (reader.Kind(tree, node, "boolean")) {
+                literal.storage = 1;
+                row.type = 0;
+                if (reader.Text(tree, node) == "true") { literal.payload = 1; }
+            } else {
+                return ExpressionFailure(tree, node, document, "unsupported bounded expression");
+            }
+            row.literal = length(literals);
+            literals = array_add(literals, literal);
+        }
+        if (length(expressions) >= 24) {
+            return ExpressionFailure(tree, root, document, "bounded expression exceeds its 24-row limit");
+        }
+        ranges = array_add(ranges, ExpressionRange(tree, node, document));
+        expressions = array_add(expressions, row);
+        value = length(expressions) - 1;
+        top -= 1;
+        returning = true;
+    }
+    return ScalarExpression.Accepted(expressions, literals, ranges, value);
+}
