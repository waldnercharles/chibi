package package_compiler

import snapshot "project:source_snapshot"
import syntax "project:syntax_diagnostics"

// Scoped pointer parameters, lowered to stage zero's reference intrinsics. A
// scoped parameter's argument is a descriptor of the caller's location: a
// value reference to a local's data cell, a field reference into a local
// record, a managed pointer's target, or the caller's own scoped parameter,
// passed on. The callee reads and writes the location through it.

// A scoped parameter; the name's index is the argument holding its descriptor.
ReferencePlace: int : 8;
// A number, bool or string local or parameter whose address a scoped
// argument takes, kept in a data cell, as stage zero keeps every local, so a
// reference can point at it; the name's index is the cell.
BoxPlace: int : 9;
// The value of a scoped argument: a descriptor in a pointer slot.
ReferenceStorage: int : -6;
// The phase of the location `&x` lends a scoped parameter, which makes its
// descriptor; its work carries the parameter's type.
ReferencePhase: int : 14;
// The phase of a scoped argument without `&`: the caller's own scoped
// parameter, passed on, or a managed pointer, which lends its target. Its
// number differs from every other statement phase, such as
// EntityComponentPhase's 15.
ScopedPhase: int : 16;

// Whether any function of `params` takes a scoped parameter.
AnyReference :: (params: Param[]) -> bool {
    for (param in params) {
        if (param.reference) {
            return true;
        }
    }
    return false;
}
// The function a call names, of this package or an import, -1 for any other.
CalledFunction :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], natives: ResolvedNative[], aliases: Name[],
                   package: int, call: int) -> int {
    for (resolved in aliases) {
        if (resolved.place == GenericCallPlace && resolved.node == call) {
            return resolved.index;
        }
    }
    callee := Field(forest, call, syntax.FieldFunction);
    qualifier: int = -1;
    if (Is(forest, callee, syntax.MemberExpression)) {
        qualifier = Field(forest, callee, syntax.FieldObject);
        callee = Field(forest, callee, syntax.FieldMember);
    }
    home := QualifierOf(forest, text, aliases, package, qualifier);
    if (home < 0 || !Is(forest, callee, syntax.Identifier)) {
        return -1;
    }
    if (qualifier < 0) {
        local := Lookup(aliases, Text(forest, text, callee));
        if (local >= 0 && aliases[local].place == GenericFunctionPlace) {
            return aliases[local].index;
        }
        return SourceCallable(callables, natives, aliases, home, Text(forest, text, callee));
    }
    return QualifiedCallable(callables, natives, aliases, home, Text(forest, text, callee),
                             NativeCallName(forest, text, call));
}
// The name a place reads through its fields and elements, or "".
RootName :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> string {
    at := node;
    while (Is(forest, at, syntax.ParenthesizedExpression) || Is(forest, at, syntax.MemberExpression) ||
           Is(forest, at, syntax.IndexExpression)) {
        if (Is(forest, at, syntax.ParenthesizedExpression)) {
            at = Field(forest, at, syntax.FieldExpression);
        } else {
            at = Field(forest, at, syntax.FieldObject);
        }
    }
    if (!Is(forest, at, syntax.Identifier)) {
        return "";
    }
    return Text(forest, text, at);
}
// Whether an `&` anywhere under `node` takes the address of local `name` or
// a place inside it. The forest lists each subtree right after its root.
ReferencesName :: (forest: snapshot.SnapshotNode[], text: string, node: int, name: string) -> bool {
    at := node;
    while (at < length(forest)) {
        parent := at;
        while (parent > node) {
            parent = forest[parent].parent;
        }
        if (parent != node) {
            return false;
        }
        if (Is(forest, at, syntax.AddressExpression) && RootName(forest, text, Field(forest, at, syntax.FieldOperand)) == name) {
            return true;
        }
        at += 1;
    }
    return false;
}
// An argument a call passes for a scoped parameter: its value node (`&x`, or
// a scoped parameter or managed pointer passed on) and the parameter, as an
// index into params.
ScopedArgument :: struct {
    value: int;
    param: int;
}
// The arguments of scoped parameters in the body `node`, in the order the
// calls appear.
ScopedCalls :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                natives: ResolvedNative[], aliases: Name[], package: int, node: int) -> ScopedArgument[] {
    found: ScopedArgument[] = [];
    pending: int[] = [node];
    top: int = 1;
    while (top > 0) {
        top -= 1;
        at := pending[top];
        if (Is(forest, at, syntax.CallExpression)) {
            called := CalledFunction(forest, text, callables, natives, aliases, package, at);
            position: int = 0;
            for (argument in Members(forest, Field(forest, at, syntax.FieldArguments))) {
                if (GenericOmitted(aliases, argument)) { continue; }
                index := GenericCallParameter(forest, text, callables, params, aliases, called, at, argument, position);
                if (called >= 0 && index >= 0 && index < callables[called].count &&
                    params[callables[called].first + index].reference) {
                    scoped: ScopedArgument = {value: GenericArgumentValue(forest, argument),
                                              param: callables[called].first + index};
                    found.append(scoped);
                }
                if (!Is(forest, argument, syntax.NamedArgument)) { position += 1; }
            }
        }
        child := forest[at].first_child;
        while (child >= 0) {
            if (top < length(pending)) {
                pending[top] = child;
            } else {
                pending.append(child);
            }
            top += 1;
            child = forest[child].next_sibling;
        }
    }
    return found;
}
// The `&x` arguments of scoped parameters in the body `node`. Each lends `x`
// for the call rather than taking a managed address.
ScopedArguments :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                    natives: ResolvedNative[], aliases: Name[], package: int, node: int) -> int[] {
    found: int[] = [];
    for (argument in ScopedCalls(forest, text, callables, params, natives, aliases, package, node)) {
        if (Is(forest, argument.value, syntax.AddressExpression)) {
            found.append(argument.value);
        }
    }
    return found;
}
// The names the body `node` lends to scoped parameters, which then live in
// data cells. Shadowing is ignored: boxing a value nothing references costs
// only its speed.
ReferencedNames :: (forest: snapshot.SnapshotNode[], text: string, callables: Callable[], params: Param[],
                    natives: ResolvedNative[], aliases: Name[], package: int, node: int) -> string[] {
    found: string[] = [];
    for (argument in ScopedArguments(forest, text, callables, params, natives, aliases, package, node)) {
        root := RootOf(forest, Field(forest, argument, syntax.FieldOperand));
        if (Is(forest, root, syntax.Identifier)) {
            found.append(Text(forest, text, root));
        }
    }
    return found;
}
// A scoped parameter names its target, so each `p^` of one reads and writes
// `p`, as stage zero lowers it: in a copy of `forest`, each such dereference
// of a function becomes its operand. A returned `p^` stays, so its result
// keeps the dereference's source span, and a pointer to a pointer keeps a
// `p^` that KeptTarget names, which reads the pointer `p` holds.
ScopedTargets :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], callables: Callable[],
                  params: Param[]) -> snapshot.SnapshotNode[] {
    scoped := forest;
    for (callable in callables) {
        at: int = 0;
        while (at < callable.count) {
            if (params[callable.first + at].reference) {
                text := documents[callable.document].text;
                pending: int[] = [Field(forest, callable.node, syntax.FieldBody)];
                while (length(pending) > 0) {
                    node := pending[length(pending) - 1];
                    pending = slice(pending, 0, length(pending) - 1);
                    operand := Field(forest, node, syntax.FieldOperand);
                    if (Is(forest, node, syntax.DereferenceExpression) && Is(forest, operand, syntax.Identifier) &&
                        Text(forest, text, operand) == params[callable.first + at].name &&
                        !Returned(forest, node) &&
                        !(params[callable.first + at].storage == PointerStorage && KeptTarget(forest, node))) {
                        named := forest[operand];
                        named.parent = forest[node].parent;
                        named.next_sibling = forest[node].next_sibling;
                        named.field = forest[node].field;
                        scoped[node] = named;
                    } else if (!CallableDeclaration(forest, node)) {
                        pending.extend(Members(forest, node));
                    }
                }
            }
            at += 1;
        }
    }
    return scoped;
}
// Whether the dereference `node` of a scoped pointer to a pointer stays: a
// call argument passes the pointer its target holds rather than forwarding
// the parameter, and a dereference of it reads through that pointer.
KeptTarget :: (forest: snapshot.SnapshotNode[], node: int) -> bool {
    parent := forest[node].parent;
    while (Is(forest, parent, syntax.ParenthesizedExpression)) {
        parent = forest[parent].parent;
    }
    return Is(forest, parent, syntax.DereferenceExpression) || CallArgument(forest, node);
}
// Whether `node`, possibly parenthesized, is an argument a call passes.
CallArgument :: (forest: snapshot.SnapshotNode[], node: int) -> bool {
    at := node;
    parent := forest[at].parent;
    while (Is(forest, parent, syntax.ParenthesizedExpression)) {
        at = parent;
        parent = forest[parent].parent;
    }
    return Is(forest, parent, syntax.ArgumentList) ||
           ((Is(forest, parent, syntax.NamedArgument) || Is(forest, parent, syntax.TypedArgument)) &&
            Field(forest, parent, syntax.FieldValue) == at);
}
// A `^T` parameter whose callers' addresses never outlive the call, as stage
// zero decides it: not nullable, and its body only dereferences it, reads its
// target's members or passes it on to another such parameter of a function of
// its package (ScopedParameters). It takes a reference to the caller's location;
// any other use makes it an ordinary managed pointer.

// The `^T` a parameter annotation spells, possibly measured, or -1 when it
// adds `?`, `[]` or a trait.
PointerAnnotation :: (forest: snapshot.SnapshotNode[], type: int) -> int {
    at := type;
    if (Is(forest, at, syntax.MeasuredType)) {
        at = Field(forest, at, syntax.FieldBase);
    }
    if (!Is(forest, at, syntax.Type)) {
        return -1;
    }
    pointer: int = -1;
    child := forest[at].first_child;
    while (child >= 0) {
        if (!forest[child].is_named || pointer >= 0 || forest[child].kind != syntax.PointerType) {
            return -1;
        }
        pointer = child;
        child = forest[child].next_sibling;
    }
    return pointer;
}
CallableDeclaration :: (forest: snapshot.SnapshotNode[], node: int) -> bool {
    return Is(forest, node, syntax.FunctionDeclaration) || Is(forest, node, syntax.MacroDeclaration) ||
           Is(forest, node, syntax.LambdaExpression);
}
// Whether `node` spells a name in `parent` rather than reading a value.
SpellsName :: (forest: snapshot.SnapshotNode[], parent: int, node: int) -> bool {
    return Is(forest, parent, syntax.ArgumentName) || Is(forest, parent, syntax.TypeName) ||
           Field(forest, parent, syntax.FieldName) == node || Field(forest, parent, syntax.FieldMember) == node ||
           (Is(forest, parent, syntax.ForStatement) && Field(forest, parent, syntax.FieldKey) == node);
}
BindingForm :: (forest: snapshot.SnapshotNode[], node: int) -> bool {
    return Is(forest, node, syntax.LocalDeclaration) || Is(forest, node, syntax.ForStatement) ||
           Is(forest, node, syntax.QueryGenerator);
}
// The scoped pointer parameters of a package's functions, decided together.
// `nodes` lists their parameter nodes in ascending order, each with a verdict in
// `scoped`. A table without nodes decides nothing, and the callers fall back to
// the one function's own analysis.
ScopeTable :: struct {
    nodes: int[];
    scoped: bool[];
}
NoScopes :: () -> ScopeTable {
    return {nodes: [], scoped: []};
}
// What `ScopedWalk` finds in the uses of a parameter: whether one makes it
// managed, and each use that hands its address to a call.
ScopeWalk :: struct {
    escapes: bool;
    forwards: int[];
}
// The uses of the parameter `name` in `body`: whether one makes it managed (a
// local of the same spelling, or an address that escapes), and each use that
// passes its address to a call, for ScopedParameters to follow into the callee.
ScopedWalk :: (forest: snapshot.SnapshotNode[], text: string, body: int, name: string) -> ScopeWalk {
    found: ScopeWalk = {escapes: false, forwards: []};
    pending: int[] = [body];
    while (length(pending) > 0) {
        at := pending[length(pending) - 1];
        pending = slice(pending, 0, length(pending) - 1);
        if (CallableDeclaration(forest, at)) {
            continue;
        }
        if (!Is(forest, at, syntax.Identifier) || Text(forest, text, at) != name) {
            for (child in Members(forest, at)) {
                pending.append(child);
            }
            continue;
        }
        parent := forest[at].parent;
        if (SpellsName(forest, parent, at)) {
            if (BindingForm(forest, parent)) {
                found.escapes = true;
                return found;
            }
            continue;
        }
        if (!Is(forest, parent, syntax.DereferenceExpression) && !Is(forest, parent, syntax.MemberExpression)) {
            found.forwards.append(at);
            continue;
        }
        place := parent;
        while (Is(forest, forest[place].parent, syntax.DereferenceExpression) ||
               Is(forest, forest[place].parent, syntax.ParenthesizedExpression) ||
               (Is(forest, forest[place].parent, syntax.MemberExpression) &&
                Field(forest, forest[place].parent, syntax.FieldObject) == place)) {
            place = forest[place].parent;
        }
        outer := forest[place].parent;
        if (Is(forest, outer, syntax.AddressExpression)) {
            found.forwards.append(outer);
        }
    }
    return found;
}
// The functions of a package that have a pointer parameter: their names, the
// text of their documents, their declarations, and the index in the package's
// parameter list of each one's first parameter.
ScopeFunctions :: struct {
    names: string[];
    texts: string[];
    declarations: int[];
    first: int[];
}
// The index, in the package's parameter list, of the pointer parameter that the
// call `argument` is an argument of passes to, or -1 when it passes to anything
// else: a function without a pointer there, or one of another package.
ScopedTarget :: (forest: snapshot.SnapshotNode[], text: string, functions: ScopeFunctions, argument: int) -> int {
    at := argument;
    list := forest[at].parent;
    while (Is(forest, list, syntax.ParenthesizedExpression)) {
        at = list;
        list = forest[list].parent;
    }
    label: int = -1;
    if (Is(forest, list, syntax.NamedArgument) ||
        (Is(forest, list, syntax.TypedArgument) && Field(forest, list, syntax.FieldValue) == at)) {
        label = Field(forest, list, syntax.FieldName);
        at = list;
        list = forest[list].parent;
    }
    if (!Is(forest, list, syntax.ArgumentList) || !Is(forest, forest[list].parent, syntax.CallExpression)) {
        return -1;
    }
    called := Field(forest, forest[list].parent, syntax.FieldFunction);
    if (!Is(forest, called, syntax.Identifier)) {
        return -1;
    }
    spelled := Text(forest, text, called);
    function: int = -1;
    for (index in 0..<length(functions.names)) {
        if (functions.names[index] == spelled) {
            function = index;
            break;
        }
    }
    if (function < 0) {
        return -1;
    }
    position: int = 0;
    for (current in Members(forest, list)) {
        if (current == at) {
            break;
        }
        if (!Is(forest, current, syntax.NamedArgument) && !Is(forest, current, syntax.TypedArgument)) {
            position += 1;
        }
    }
    slot: int = 0;
    for (parameter in Members(forest, Field(forest, functions.declarations[function], syntax.FieldParameters))) {
        if ((label < 0 && slot == position) ||
            (label >= 0 && Text(forest, text, label) == Text(forest, functions.texts[function],
                                                              Field(forest, parameter, syntax.FieldName)))) {
            if (PointerAnnotation(forest, Field(forest, parameter, syntax.FieldType)) < 0) {
                return -1;
            }
            return functions.first[function] + slot;
        }
        slot += 1;
    }
    return -1;
}
// Which pointer parameters of `declarations`, function declarations in
// ascending node order, take a reference to the caller's location: those whose
// uses only dereference them, read fields through them, or pass them on to such
// a parameter. The decision is the greatest fixed point of the passing edges,
// one pass over every function instead of a search into each callee from each
// use. `texts` holds the document text of each declaration.
ScopedParameters :: (forest: snapshot.SnapshotNode[], texts: string[], declarations: int[]) -> ScopeTable {
    nodes: int[] = [];
    names: string[] = [];
    pointers: bool[] = [];
    owners: int[] = [];
    functions: ScopeFunctions = {names: [], texts: [], declarations: [], first: []};
    previous: int = -1;
    for (at in 0..<length(declarations)) {
        declaration := declarations[at];
        if (declaration <= previous) {
            return NoScopes();
        }
        previous = declaration;
        text := texts[at];
        any := false;
        for (parameter in Members(forest, Field(forest, declaration, syntax.FieldParameters))) {
            if (PointerAnnotation(forest, Field(forest, parameter, syntax.FieldType)) >= 0) {
                any = true;
            }
        }
        if (!any) {
            continue;
        }
        owner := length(functions.names);
        functions.names.append(Text(forest, text, Field(forest, declaration, syntax.FieldName)));
        functions.texts.append(text);
        functions.declarations.append(declaration);
        functions.first.append(length(nodes));
        for (parameter in Members(forest, Field(forest, declaration, syntax.FieldParameters))) {
            nodes.append(parameter);
            names.append(Text(forest, text, Field(forest, parameter, syntax.FieldName)));
            pointers.append(PointerAnnotation(forest, Field(forest, parameter, syntax.FieldType)) >= 0);
            owners.append(owner);
        }
    }
    scoped: bool[] = [];
    edge_from: int[] = [];
    edge_to: int[] = [];
    for (index in 0..<length(nodes)) {
        verdict := pointers[index];
        if (verdict) {
            owner := owners[index];
            body := Field(forest, functions.declarations[owner], syntax.FieldBody);
            if (body >= 0) {
                text := functions.texts[owner];
                walked := ScopedWalk(forest, text, body, names[index]);
                verdict = !walked.escapes;
                for (use in walked.forwards) {
                    target := ScopedTarget(forest, text, functions, use);
                    if (target < 0) {
                        verdict = false;
                    } else if (target != index) {
                        edge_from.append(index);
                        edge_to.append(target);
                    }
                }
            }
        }
        scoped.append(verdict);
    }
    changed := true;
    while (changed) {
        changed = false;
        for (edge in 0..<length(edge_from)) {
            if (scoped[edge_from[edge]] && !scoped[edge_to[edge]]) {
                scoped[edge_from[edge]] = false;
                changed = true;
            }
        }
    }
    return {nodes: nodes, scoped: scoped};
}
// The scoped pointer parameters of the functions beside `member`, those of its
// parent's other members: a library's, a behavior's, or a document's.
SiblingScopes :: (forest: snapshot.SnapshotNode[], text: string, member: int) -> ScopeTable {
    declarations: int[] = [];
    texts: string[] = [];
    for (sibling in Members(forest, forest[member].parent)) {
        if (Is(forest, sibling, syntax.FunctionDeclaration)) {
            declarations.append(sibling);
            texts.append(text);
        }
    }
    return ScopedParameters(forest, texts, declarations);
}
// 1 when the table decides that `parameter` is scoped, 0 when it decides it is
// managed, and -1 when the table does not list it.
ScopedVerdict :: (table: ScopeTable, parameter: int) -> int {
    low: int = 0;
    high: int = length(table.nodes);
    while (low < high) {
        middle := (low + high) / 2;
        if (table.nodes[middle] < parameter) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if (low == length(table.nodes) || table.nodes[low] != parameter) {
        return -1;
    }
    if (table.scoped[low]) {
        return 1;
    }
    return 0;
}
// Whether `names` holds `name`.
Holds :: (names: string[], name: string) -> bool {
    for (each in names) {
        if (each == name) {
            return true;
        }
    }
    return false;
}
// A scoped parameter's descriptor, the argument `index`, into slot `slot`.
DescriptorCode :: (ops: Ops, target: Target, index: int, slot: int, node: snapshot.SnapshotNode) -> Code {
    read := Instruction(ops.argument, target.pointer_storage, slot, index, 0, 0, node);
    read.value_storage = target.pointer_storage;
    return read;
}
DescriptorSlot :: (target: Target) -> Slot {
    return {storage: target.pointer_storage, kind: ReferenceKind};
}
// A cell holding a value of the type storage, container and record give.
TypedCell :: (storage: int, container: int, record: int) -> Cell {
    return {storage: storage, container: container, record: record, constant: 0, variant: -1, kind: ValueKind};
}
// The read of the value of `type` that the descriptor in slot `descriptor`
// reaches, through cells from `cell` and slots from `slot`, by host `host`;
// the value lands in slot + 2.
ReadThroughCode :: (ops: Ops, target: Target, storage: int, container: int, descriptor: int, cell: int, host: int,
                    slot: int, node: snapshot.SnapshotNode) -> Code[] {
    code := CellWrite(target.pointer_storage, descriptor, cell, ops, target, slot, node);
    code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, host, node));
    return extend(code, CellRead(SlotStorage(storage, container, target), cell + 1, ops, target, slot + 1, node));
}
ReadThroughSlots :: (storage: int, container: int, target: Target) -> Slot[] {
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    value: Slot = {storage: SlotStorage(storage, container, target), kind: SlotKind(storage, container)};
    return [address, address, value];
}
ReadThroughHost :: (cell: int) -> Host {
    return {owned_arguments: false, command: 0, syntax_node: 0, intrinsic: ReferenceReadIntrinsic, linked: -1, first: cell, result_first: cell + 1, result_count: 1,
            written: false};
}
// The write of the value in slot `value` through the descriptor in slot
// `descriptor`, through cells from `cell` and two slots from `slot`.
WriteThroughCode :: (ops: Ops, target: Target, storage: int, container: int, descriptor: int, value: int, cell: int,
                     host: int, slot: int, node: snapshot.SnapshotNode) -> Code[] {
    code := CellWrite(target.pointer_storage, descriptor, cell, ops, target, slot, node);
    code.extend(CellWrite(SlotStorage(storage, container, target), value, cell + 1, ops, target, slot + 1,
                          node));
    return append(code, Instruction(ops.host_call, 0, 0, target.data_failure, 0, host, node));
}
WriteThroughCells :: (storage: int, container: int, record: int, target: Target) -> Cell[] {
    done: Cell = {storage: BoolStorage, container: 0, record: -1, constant: 0, variant: -1, kind: ValueKind};
    return [ReferenceCell(target), TypedCell(storage, container, record), done];
}
WriteThroughHost :: (cell: int) -> Host {
    return {owned_arguments: false, command: 0, syntax_node: 0, intrinsic: ReferenceWriteIntrinsic, linked: -1, first: cell, result_first: cell + 2, result_count: 1,
            written: false};
}
// A read of `binding`, a scoped parameter, through its descriptor, or a boxed
// value, from its cell.
PlaceReadStep :: (binding: Name, ops: Ops, target: Target, at: Bases, node: snapshot.SnapshotNode) -> Step {
    roots: Root[] = [];
    if (binding.place == BoxPlace) {
        address: Slot = {storage: target.pointer_storage, kind: AddressKind};
        slots: Slot[] = [address, ValueLocal(binding.storage)];
        if (Pointer(binding.storage, 0)) {
            root: Root = {slot: at.slot + 1, storage: binding.storage, container: 0, record: binding.record};
            roots.append(root);
        }
        return Step.Emitted(CellRead(binding.storage, binding.index, ops, target, at.slot, node), slots, [], [], [],
                            roots, [], [], [], 0, Typed(at.slot + 1, binding.storage, 0, binding.record), NoValue(),
                            []);
    }
    slots: Slot[] = [DescriptorSlot(target)];
    code: Code[] = [DescriptorCode(ops, target, binding.index, at.slot, node)];
    slots.extend(ReadThroughSlots(binding.storage, binding.container, target));
    code.extend(ReadThroughCode(ops, target, binding.storage, binding.container, at.slot, at.cell, at.host,
                                at.slot + 1, node));
    cells: Cell[] = [ReferenceCell(target), TypedCell(binding.storage, binding.container, binding.record)];
    value := at.slot + 3;
    if (Pointer(binding.storage, binding.container)) {
        root: Root = {slot: value, storage: binding.storage, container: binding.container, record: binding.record};
        roots.append(root);
    }
    return Step.Emitted(code, slots, [], cells, [ReadThroughHost(at.cell)], roots, [], [], [], 0,
                        Typed(value, binding.storage, binding.container, binding.record), NoValue(), []);
}
// `x: T = v` for a number, bool, string or pointer local that a scoped
// argument lends, or a union something writes: its cell holds the value.
BoxStep :: (forest: snapshot.SnapshotNode[], text: string, local: Value, value: Value, item: Work, ops: Ops,
            target: Target, at: Bases, node: snapshot.SnapshotNode) -> Step {
    name := Field(forest, item.node, syntax.FieldName);
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    code := CellWrite(local.storage, value.slot, at.cell, ops, target, at.slot, node);
    code.append(SymbolCode(ops, name, node));
    binding: Name = {owned: false, name: Text(forest, text, name), place: BoxPlace, index: at.cell, storage: local.storage,
                     container: 0, record: local.record, writable: true, node: name};
    return Step.Emitted(code, [address], [], [TypedCell(local.storage, 0, local.record)], [], [], [], [binding], [],
                        1, NoValue(), NoValue(), []);
}
// A number, bool, string or pointer parameter that a scoped argument lends
// moves into a cell of its own before the body runs, as stage zero isolates
// it.
BoxParameterStep :: (param: Param, index: int, ops: Ops, target: Target, at: Bases,
                     node: snapshot.SnapshotNode) -> Step {
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    read := Instruction(ops.argument, param.storage, at.slot, index, 0, 0, node);
    read.value_storage = param.storage;
    code: Code[] = [read];
    code.extend(CellWrite(param.storage, at.slot, at.cell, ops, target, at.slot + 1, node));
    binding: Name = {owned: false, name: param.name, place: BoxPlace, index: at.cell, storage: param.storage, container: 0,
                     record: param.record, writable: true, node: param.node};
    return Step.Emitted(code, [ValueLocal(param.storage), address], [], [TypedCell(param.storage, 0, param.record)],
                        [], [], [], [binding], [], 0, NoValue(), NoValue(), []);
}
// `x = v` and `x op= v` on a scoped parameter or a boxed local, as stage zero
// assigns them: a narrower integer widens first; a compound reads the target
// and watches it, then combines; the store writes through the reference or
// into the cell. A boxed local is stored as any local, with its symbol's
// point; a scoped parameter's target is the caller's.
PlaceAssignStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, binding: Name, value: Value,
                    item: Work, ops: Ops, target: Target, at: Bases, node: snapshot.SnapshotNode) -> Step {
    destination := forest[Field(forest, item.node, syntax.FieldTarget)];
    slots: Slot[] = [];
    code: Code[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    stored := value;
    if (binding.container == 0 && value.container == 0 && Widens(value.storage, binding.storage)) {
        slots.append(ValueLocal(binding.storage));
        code.append(CastCode(ops, binding.storage, at.slot, value.slot, 0, node));
        stored = Typed(at.slot, binding.storage, 0, -1);
    }
    reference := binding.place == ReferencePlace;
    descriptor: int = -1;
    if (reference) {
        descriptor = at.slot + length(slots);
        slots.append(DescriptorSlot(target));
        code.append(DescriptorCode(ops, target, binding.index, descriptor, node));
    }
    operator := CompoundOperator(Operator(forest, item.node));
    if (operator != NoOperator) {
        op := BinaryOp(ops, operator);
        if (op < 0 || Comparison(ops, op) || !Numeric(binding.storage) || binding.container != 0 ||
            !Single(stored, binding.storage)) {
            return Fail(forest, item.node, document, "compound assignment needs number operands of its type");
        }
        if (!Computes(ops, op, binding.storage)) {
            return Fail(forest, item.node, document, "unsupported arithmetic type");
        }
        current := at.slot + length(slots) + 2;
        if (reference) {
            slots.extend(ReadThroughSlots(binding.storage, 0, target));
            code.extend(ReadThroughCode(ops, target, binding.storage, 0, descriptor, at.cell, at.host,
                                        current - 2, node));
            cells = [ReferenceCell(target), TypedCell(binding.storage, 0, -1)];
            hosts = [ReadThroughHost(at.cell)];
        } else {
            current = at.slot + length(slots) + 1;
            slots.extend(PlaceSlots(binding, target));
            code.extend(CellRead(binding.storage, binding.index, ops, target, current - 1, node));
        }
        code.append(ScalarWatch(ops, current, binding.storage, 0, true, destination));
        slots.append(ValueLocal(binding.storage));
        code.append(Instruction(op, binding.storage, current + 1, current, stored.slot, -1, node));
        // A local's target is watched again as the value it stores. Parameters,
        // including boxed value parameters, write through a reference in stage zero.
        if (!reference && !Parameter(forest, binding)) {
            code.append(ScalarWatch(ops, current + 1, binding.storage, 0, true, destination));
        }
        stored = Typed(current + 1, binding.storage, 0, -1);
    }
    if (!SameType(binding.storage, binding.container, binding.record, stored)) {
        return Fail(forest, item.node, document, "assigned value differs from its local");
    }
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    if (reference) {
        first := at.cell + length(cells);
        cells.extend(WriteThroughCells(binding.storage, binding.container, binding.record, target));
        hosts.append(WriteThroughHost(first));
        code.extend(WriteThroughCode(ops, target, binding.storage, binding.container, descriptor, stored.slot,
                                     first, at.host + length(hosts) - 1, at.slot + length(slots), node));
        slots.extend([address, address]);
    } else {
        code.extend(CellWrite(binding.storage, stored.slot, binding.index, ops, target, at.slot + length(slots),
                              node));
        slots.append(address);
    }
    if (!Parameter(forest, binding)) {
        code.append(SymbolCode(ops, binding.node, node));
    }
    return Step.Emitted(code, slots, [], cells, hosts, [], [], [], [], 1, NoValue(), NoValue(), []);
}
PlaceSlots :: (binding: Name, target: Target) -> Slot[] {
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    return [address, ValueLocal(binding.storage)];
}
// A value reference to the local whose cell is `cell`, of the type storage,
// container and record give: the make's context, type and kind, its unused
// state variable, the cell's address, then unused component facts.
MakeValueCells :: (target: Target, storage: int, container: int, record: int) -> Cell[] {
    facts: u64[] = [0, 0, 0, 0xFFFFFFFFFFFFFFFF, 0, 0, 0, 0, 0];
    cells := MakeCells(target, -1, facts);
    cells[1] = TypedCell(storage, container, record);
    return cells;
}
// The make of a value reference to the cell `cell`, through cells from
// `first`, with the six slots from `slot`; the descriptor lands in slot + 5.
MakeValueCode :: (ops: Ops, target: Target, cell: int, first: int, host: int, slot: int,
                  node: snapshot.SnapshotNode) -> Code[] {
    code: Code[] = [Instruction(ops.context, target.pointer_storage, slot, 0, 0, 1, node),
                    Instruction(ops.host_slot, target.pointer_storage, slot + 1, cell, 0, 0, node)];
    code.extend(CellWrite(target.pointer_storage, slot, first, ops, target, slot + 2, node));
    code.extend(CellWrite(target.pointer_storage, slot + 1, first + 4, ops, target, slot + 3, node));
    code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, host, node));
    return extend(code, CellRead(target.pointer_storage, first + 9, ops, target, slot + 4, node));
}
MakeValueSlots :: (target: Target) -> Slot[] {
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    return [address, address, address, address, address, DescriptorSlot(target)];
}
MakeValueHost :: (first: int) -> Host {
    return {owned_arguments: false, command: 0, syntax_node: 0, intrinsic: ReferenceMakeIntrinsic, linked: -1, first: first, result_first: first + 9, result_count: 1,
            written: true};
}
// The argument of a scoped parameter of the type item.storage,
// item.container and item.record, as stage zero passes it: a value reference
// to a local's cell, a field reference into a local record or through a
// scoped parameter, a managed pointer's target, or a scoped parameter's own
// descriptor. The argument's points come first, its members outermost, then
// its name.
ReferenceArgumentStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, types: TypeDecl[],
                          members: TypeMember[], names: Name[], work: Work, ops: Ops, target: Target,
                          at: Bases) -> Step {
    // `(p)` forwards as `p` does, and `(p^)` lends p's target as `p^` does.
    item := work;
    argument := Unparenthesized(forest, item.node);
    forwarded := false;
    if (item.phase == ScopedPhase && Is(forest, argument, syntax.Identifier)) {
        found := Lookup(names, Text(forest, text, argument));
        forwarded = found >= 0 && names[found].place == ReferencePlace;
    }
    if (forwarded) {
        item.node = argument;
    }
    if (item.phase == ScopedPhase && !forwarded && !Is(forest, argument, syntax.DereferenceExpression)) {
        // A managed pointer lends its target, as its dereference would.
        resumed := item;
        resumed.phase = PointerBridgePhase;
        return Step.Emitted([ExpressionCode(ops, forest[item.node])], [], [], [], [], [], [], [],
                            [Visit(item.node), resumed], 0, NoValue(), NoValue(), []);
    }
    if (Is(forest, argument, syntax.DereferenceExpression)) {
        resumed := item;
        resumed.phase = PointerBridgePhase;
        return Step.Emitted([ExpressionCode(ops, forest[item.node])], [], [], [], [], [], [], [],
                            [Visit(Field(forest, argument, syntax.FieldOperand)), resumed], 0, NoValue(), NoValue(), []);
    }
    node := forest[item.node];
    code := TargetPoints(forest, text, names, ops, item.node);
    root := item.node;
    field: int = -1;
    if (Is(forest, item.node, syntax.MemberExpression)) {
        root = Field(forest, item.node, syntax.FieldObject);
    }
    found: int = -1;
    if (Is(forest, root, syntax.Identifier)) {
        found = Lookup(names, Text(forest, text, root));
    }
    if (root != item.node && (Is(forest, root, syntax.DereferenceExpression) ||
                              (found >= 0 && names[found].storage == PointerStorage))) {
        source := root;
        points: Code[] = [ExpressionCode(ops, node)];
        points.append(ExpressionCode(ops, forest[root]));
        if (Is(forest, root, syntax.DereferenceExpression)) {
            source = Field(forest, root, syntax.FieldOperand);
        }
        resumed := item;
        resumed.phase = PointerRefFieldPhase;
        return Step.Emitted(points, [], [], [], [], [], [], [], [Visit(source), resumed], 0,
                            NoValue(), NoValue(), []);
    }
    if (found >= 0 && names[found].place == ManagedPlace) {
        binding := names[found];
        if (root == item.node && !SameType(item.storage, item.container, item.record,
                                           Typed(-1, binding.storage, binding.container, binding.record))) {
            return Fail(forest, item.node, document, "pointer argument differs from the parameter's type");
        }
        pointer := FindPointer(types, {storage: binding.storage, container: binding.container, record: binding.record}, false);
        code.extend(CellRead(PointerStorage, binding.index, ops, target, at.slot, node));
        slots: Slot[] = [AddressSlot(target), {storage: PointerStorage, kind: ValueKind}];
        if (root != item.node) {
            resumed := item;
            resumed.phase = PointerBridgePhase;
            field := PointerFieldStep(forest, text, document, types, members,
                                      Typed(at.slot + 1, PointerStorage, 0, pointer), item.node, 0,
                                      ops, target, SlotsPast(at, 2));
            return PointerContinue(PointerPrefix(code, slots, field), resumed);
        }
        return PointerPrefix(code, slots, PointerPopped(PointerReferenceStep(
            Typed(at.slot + 1, PointerStorage, 0, pointer), ops, target, SlotsPast(at, 2), node), 0));
    }
    if (found < 0 || !names[found].writable || Alias(names[found].place)) {
        return Fail(forest, item.node, document, "Pointer argument requires a writable location");
    }
    binding := names[found];
    storage := binding.storage;
    container := binding.container;
    record := binding.record;
    if (root != item.node) {
        if (binding.storage != StructStorage || binding.container != 0 ||
            (binding.place != CellPlace && binding.place != ReferencePlace)) {
            return Fail(forest, item.node, document, "a reference to this field is not supported yet");
        }
        field = FindField(types, members, binding.record, Text(forest, text, Field(forest, item.node, syntax.FieldMember)));
        if (field < 0) {
            return Fail(forest, item.node, document, "Unknown field");
        }
        storage = members[field].storage;
        container = 0;
        record = -1;
    } else if (binding.place != CellPlace && binding.place != BoxPlace && binding.place != ReferencePlace) {
        return Fail(forest, item.node, document, "a reference to this value is not supported yet");
    }
    if (!SameType(item.storage, item.container, item.record, Typed(-1, storage, container, record))) {
        return Fail(forest, item.node, document, "pointer argument differs from the parameter's type");
    }
    slots: Slot[] = [];
    cells: Cell[] = [];
    hosts: Host[] = [];
    descriptor: int = -1;
    if (binding.place == ReferencePlace) {
        descriptor = at.slot;
        slots = [DescriptorSlot(target)];
        code.append(DescriptorCode(ops, target, binding.index, descriptor, node));
    } else {
        cells = MakeValueCells(target, binding.storage, binding.container, binding.record);
        hosts = [MakeValueHost(at.cell)];
        slots = MakeValueSlots(target);
        code.extend(MakeValueCode(ops, target, binding.index, at.cell, at.host, at.slot, node));
        descriptor = at.slot + 5;
    }
    if (field >= 0) {
        // The field reference: its base, the field's type and offset, and no
        // element.
        first := at.cell + length(cells);
        offset: Cell = {storage: WordStorage, container: 0, record: -1, constant: u64(members[field].offset),
                        variant: -1, kind: ValueKind};
        element: Cell = {storage: BoolStorage, container: 0, record: -1, constant: 0, variant: -1, kind: ValueKind};
        cells.extend([ReferenceCell(target), TypedCell(storage, 0, -1), offset, element, ReferenceCell(target)]);
        reach: Host = {owned_arguments: false, command: 0, syntax_node: 0, intrinsic: ReferenceFieldIntrinsic, linked: -1, first: first, result_first: first + 4,
                       result_count: 1, written: false};
        hosts.append(reach);
        address: Slot = {storage: target.pointer_storage, kind: AddressKind};
        base := at.slot + length(slots);
        slots.extend([address, address, DescriptorSlot(target)]);
        code.extend(CellWrite(target.pointer_storage, descriptor, first, ops, target, base, node));
        code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host + length(hosts) - 1,
                                node));
        code.extend(CellRead(target.pointer_storage, first + 4, ops, target, base + 1, node));
        descriptor = base + 2;
    }
    return Step.Emitted(code, slots, [], cells, hosts, [], [], [], [], 0,
                        Typed(descriptor, ReferenceStorage, 0, -1), NoValue(), []);
}
// The input watch of a scoped argument: the descriptor in slot `slot`, watched as
// the parameter's referenced type.
ReferenceWatch :: (ops: Ops, param: Param, ordinal: int, slot: int, node: snapshot.SnapshotNode,
                   target: Target) -> Code {
    watch := WatchCode(ops, slot, param.storage, param.container, param.record, ordinal, false, node, target);
    watch.type = target.pointer_storage;
    watch.offset = 1;
    return watch;
}
// `p.f = v` and `p.f op= v` through the scoped parameter `binding`, as stage
// zero writes them: a field reference from the parameter's descriptor; a
// compound reads the field through it and watches it, then combines; then the
// write. `before` and `taken` are the code and slots that converted the value.
ReferenceFieldStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, binding: Name,
                       field: TypeMember, value: Value, before: Code[], taken: Slot[], item: Work, ops: Ops,
                       target: Target, at: Bases, node: snapshot.SnapshotNode) -> Step {
    code := extend(before, [DescriptorCode(ops, target, binding.index, at.slot + length(taken), node)]);
    slots := extend(taken, [DescriptorSlot(target)]);
    base := at.slot + length(slots) - 1;
    offset: Cell = {storage: WordStorage, container: 0, record: -1, constant: u64(field.offset), variant: -1,
                    kind: ValueKind};
    element: Cell = {storage: BoolStorage, container: 0, record: -1, constant: 0, variant: -1, kind: ValueKind};
    cells: Cell[] = [ReferenceCell(target), TypedCell(field.storage, 0, -1), offset, element, ReferenceCell(target)];
    reach: Host = {owned_arguments: false, command: 0, syntax_node: 0, intrinsic: ReferenceFieldIntrinsic, linked: -1, first: at.cell, result_first: at.cell + 4,
                   result_count: 1, written: false};
    hosts: Host[] = [reach];
    address: Slot = {storage: target.pointer_storage, kind: AddressKind};
    slots.extend([address, address, DescriptorSlot(target)]);
    code.extend(CellWrite(target.pointer_storage, base, at.cell, ops, target, base + 1, node));
    code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, node));
    code.extend(CellRead(target.pointer_storage, at.cell + 4, ops, target, base + 2, node));
    reached := base + 3;
    stored := value;
    if (item.c == 1) {
        op := BinaryOp(ops, CompoundOperator(Operator(forest, item.node)));
        if (op < 0 || Comparison(ops, op) || !(Integer(field.storage) || Floating(field.storage)) ||
            !Single(stored, field.storage)) {
            return Fail(forest, item.node, document, "compound assignment needs number operands of its type");
        }
        if (!Computes(ops, op, field.storage)) {
            return Fail(forest, item.node, document, "unsupported arithmetic type");
        }
        read := at.slot + length(slots);
        slots.extend(ReadThroughSlots(field.storage, 0, target));
        cells.extend([ReferenceCell(target), TypedCell(field.storage, 0, -1)]);
        hosts.append(ReadThroughHost(at.cell + 5));
        code.extend(ReadThroughCode(ops, target, field.storage, 0, reached, at.cell + 5, at.host + 1, read,
                                    node));
        code.append(ScalarWatch(ops, read + 2, field.storage, 0, true, forest[Field(forest, item.node, syntax.FieldTarget)]));
        slots.append(ValueLocal(field.storage));
        code.append(Instruction(op, field.storage, read + 3, read + 2, stored.slot, -1, node));
        stored = Typed(read + 3, field.storage, 0, -1);
    }
    if (!SameType(field.storage, 0, -1, stored)) {
        return Fail(forest, item.node, document, "field value differs from its type");
    }
    first := at.cell + length(cells);
    cells.extend(WriteThroughCells(field.storage, 0, -1, target));
    hosts.append(WriteThroughHost(first));
    code.extend(WriteThroughCode(ops, target, field.storage, 0, reached, stored.slot, first,
                                 at.host + length(hosts) - 1, at.slot + length(slots), node));
    slots.extend([address, address]);
    return Step.Emitted(code, slots, [], cells, hosts, [], [], [], [], 1, NoValue(), NoValue(), []);
}
