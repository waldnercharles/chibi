package llvm_native

import abi "project:native_abi"
import strings "core:strings"

// A loan keeps its evaluated array alive while later arguments run. Before
// calling C, compare every captured place before changing any of them, then
// retire matching loans, make the places unique, and acquire the call loans.
// This preserves repeated arguments that point at the same place. A later
// argument that replaced a place leaves the historical loan independent.
ForeignArrays :: (arguments: int[], code: Instruction[], origins: int[], item: Instruction, pc: int) -> string {
    if (length(origins) == 0) { return ""; }
    array := abi.ArrayType();
    out: string[] = [];
    for (index in 0..<item.target) {
        slot := arguments[item.right + index];
        if (origins[slot] < 0) { continue; }
        loan := code[origins[slot]];
        name := format_text("loan{}_{}", pc, index);
        out.append(Load(format_text("{}.given", name), loan.type, "s", slot));
        if (loan.target != 0) { continue; }
        out.append(Load(format_text("{}.captured", name), loan.type, "s", loan.left));
        out.append(Load(format_text("{}.address", name), RefType + loan.type, "s", loan.right));
        out.append(format_text("  %{}.current = load {}, ptr %{}.address\n", name, array, name));
        for (field in 0..<4) {
            type := "i32";
            if (field >= 2) { type = "ptr"; }
            out.append(format_text("  %{}.before{} = extractvalue {} %{}.captured, {}\n", name, field, array, name, field));
            out.append(format_text("  %{}.now{} = extractvalue {} %{}.current, {}\n", name, field, array, name, field));
            out.append(format_text("  %{}.same{} = icmp eq {} %{}.before{}, %{}.now{}\n", name, field, type, name, field, name, field));
        }
        out.append(format_text("  %{}.size = and i1 %{}.same0, %{}.same1\n  %{}.storage = and i1 %{}.same2, %{}.same3\n", name, name, name, name, name, name));
        out.append(format_text("  %{}.matches = and i1 %{}.size, %{}.storage\n", name, name, name));
    }
    // Release all matching loans before uniqueness. Retaking one early would
    // make a repeated argument detach the same place a second time.
    for (index in 0..<item.target) {
        slot := arguments[item.right + index];
        if (origins[slot] < 0) { continue; }
        loan := code[origins[slot]];
        if (loan.target != 0) { continue; }
        name := format_text("loan{}_{}", pc, index);
        out.append(format_text("  br i1 %{}.matches, label %{}.drop, label %{}.dropped\n{}.drop:\n", name, name, name, name));
        out.append(format_text("  call void @chibi_array.{}.drop(ptr %ctx, {} %{}.given)\n  br label %{}.dropped\n{}.dropped:\n", loan.type, array, name, name, name));
    }
    for (index in 0..<item.target) {
        slot := arguments[item.right + index];
        if (origins[slot] < 0) { continue; }
        loan := code[origins[slot]];
        if (loan.target != 0) { continue; }
        name := format_text("loan{}_{}", pc, index);
        out.append(format_text("  br i1 %{}.matches, label %{}.prepare, label %{}.prepared\n{}.prepare:\n", name, name, name, name));
        out.append(format_text("  %{}.latest = load {}, ptr %{}.address\n  %{}.length = extractvalue {} %{}.latest, 0\n", name, array, name, name, array, name));
        out.append(format_text("  %{}.unique = call {} @chibi_array.{}.unique(ptr %ctx, {} %{}.latest, i32 %{}.length, i1 true)\n", name, array, loan.type, array, name, name));
        out.append(format_text("  store {} %{}.unique, ptr %{}.address\n  br label %{}.prepared\n{}.prepared:\n", array, name, name, name, name));
    }
    for (index in 0..<item.target) {
        slot := arguments[item.right + index];
        if (origins[slot] < 0) { continue; }
        loan := code[origins[slot]];
        name := format_text("loan{}_{}", pc, index);
        if (loan.target == 0) {
            out.append(format_text("  br i1 %{}.matches, label %{}.retake, label %{}.historical\n{}.retake:\n", name, name, name, name));
            out.append(format_text("  %{}.ready = load {}, ptr %{}.address\n", name, array, name));
            out.append(format_text("  %{}.retaken = call {} @chibi_array.{}.copy(ptr %ctx, {} %{}.ready)\n", name, array, loan.type, array, name));
            out.append(Store(format_text("%{}.retaken", name), loan.type, "s", slot));
            out.append(format_text("  br label %{}.done\n{}.historical:\n", name, name));
        }
        out.append(format_text("  %{}.held_length = extractvalue {} %{}.given, 0\n", name, array, name));
        out.append(format_text("  %{}.held_unique = call {} @chibi_array.{}.unique(ptr %ctx, {} %{}.given, i32 %{}.held_length, i1 true)\n", name, array, loan.type, array, name, name));
        out.append(Store(format_text("%{}.held_unique", name), loan.type, "s", slot));
        if (loan.target == 0) { out.append(format_text("  br label %{}.done\n{}.done:\n", name, name)); }
    }
    return strings.Join(out, "");
}
