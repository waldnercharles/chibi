}
Queries :: (environment: Environment) -> Query[] {
    switch environment {
        case .Tables(expressions, arguments, statements, children, functions, symbols, scopes, queries, bindings, reads, writes, capabilities, catalog_types, ids, ranges, descriptions, stages):
            return queries;
    }
}
Bindings :: (environment: Environment) -> Binding[] {
    switch environment {
        case .Tables(expressions, arguments, statements, children, functions, symbols, scopes, queries, bindings, reads, writes, capabilities, catalog_types, ids, ranges, descriptions, stages):
            return bindings;
    }
}
Reads :: (environment: Environment) -> u64[] {
    switch environment {
        case .Tables(expressions, arguments, statements, children, functions, symbols, scopes, queries, bindings, reads, writes, capabilities, catalog_types, ids, ranges, descriptions, stages):
            return reads;
    }
}
Writes :: (environment: Environment) -> u64[] {
    switch environment {
        case .Tables(expressions, arguments, statements, children, functions, symbols, scopes, queries, bindings, reads, writes, capabilities, catalog_types, ids, ranges, descriptions, stages):
            return writes;
    }
}
Capabilities :: (environment: Environment) -> Capability[] {
    switch environment {
        case .Tables(expressions, arguments, statements, children, functions, symbols, scopes, queries, bindings, reads, writes, capabilities, catalog_types, ids, ranges, descriptions, stages):
            return capabilities;
