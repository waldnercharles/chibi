                        data.Object([
                            data.Field.Named("id", data.Value.UInt(1100)),
                            data.Field.Named("type", data.Value.Text("Model Output")),
                            data.Field.Named("x", data.Value.Real(1480.0)),
                            data.Field.Named("y", data.Value.Real(0.0))
                        ])
                    ])),
                    data.Field.Named("edges", data.List([
                        data.Object([
                            data.Field.Named("from", data.Value.Text("100.Geometry")),
                            data.Field.Named("to", data.Value.Text("600.A"))
                        ]),
                        data.Object([
                            data.Field.Named("from", data.Value.Text("200.Value")),
