package utf8

import strings "core:strings"

CheckError :: (error: Error?, kind: int, offset: int) {
    assert(error != nil);
    if error {
        assert(error.kind == kind && error.offset == offset);
    }
}

CheckSameError :: (left: Error?, right: Error?) {
    assert((left == nil) == (right == nil));
    if left {
        if right {
            assert(left.kind == right.kind && left.offset == right.offset);
        }
    }
}

// Explicit byte oracles follow Unicode 17.0 table 3-7, including every range
// transition and the E0, ED, F0 and F4 second-byte restrictions.
CheckScalar :: (data: u8[], scalar: int) {
    decoded := Decode(data, 0);
    assert(decoded.status == Success);
    assert(int(decoded.value) == scalar);
    assert(decoded.width == length(data));
    assert(decoded.error == nil);
    validated := Validate(data);
    assert(validated == nil);
    encoded := Encode(char(scalar));
    assert(length(encoded) == length(data));
    for (index in 0..<length(data)) {
        assert(encoded[index] == data[index]);
    }
}

CheckFailure :: (data: u8[], status: int) {
    decoded := Decode(data, 0);
    assert(decoded.status == status);
    assert(decoded.width == 0);
    CheckError(decoded.error, status, 0);
    validated := Validate(data);
    CheckError(validated, status, 0);
}

@test
ScalarRangeBoundaries :: () {
    CheckScalar([u8(0)], 0);
    CheckScalar([u8(127)], 127);
    CheckScalar([u8(194), u8(128)], 128);
    CheckScalar([u8(223), u8(191)], 2047);
    CheckScalar([u8(224), u8(160), u8(128)], 2048);
    CheckScalar([u8(237), u8(159), u8(191)], 55295);
    CheckScalar([u8(238), u8(128), u8(128)], 57344);
    CheckScalar([u8(239), u8(191), u8(191)], 65535);
    CheckScalar([u8(240), u8(144), u8(128), u8(128)], 65536);
    CheckScalar([u8(244), u8(143), u8(191), u8(191)], 1114111);
    return;
}

@test
ValidReplacementBomAndUnassignedScalar :: () {
    CheckScalar([u8(239), u8(191), u8(189)], 65533);
    CheckScalar([u8(239), u8(187), u8(191)], 65279);
    CheckScalar([u8(205), u8(184)], 888);
    CheckScalar([u8(239), u8(183), u8(144)], 64976);
    return;
}

@test
RejectMalformedSequences :: () {
    CheckFailure([u8(128)], Malformed);
    CheckFailure([u8(191)], Malformed);
    CheckFailure([u8(192), u8(128)], Malformed);
    CheckFailure([u8(193), u8(191)], Malformed);
    CheckFailure([u8(224), u8(159), u8(191)], Malformed);
    CheckFailure([u8(237), u8(160), u8(128)], Malformed);
    CheckFailure([u8(240), u8(143), u8(191), u8(191)], Malformed);
    CheckFailure([u8(244), u8(144), u8(128), u8(128)], Malformed);
    CheckFailure([u8(245), u8(128), u8(128), u8(128)], Malformed);
    CheckFailure([u8(255)], Malformed);
    CheckFailure([u8(194), u8(65)], Malformed);
    CheckFailure([u8(225), u8(128), u8(65)], Malformed);
    CheckFailure([u8(241), u8(128), u8(128), u8(65)], Malformed);
    return;
}

@test
TruncationRequiresAValidAvailablePrefix :: () {
    CheckFailure([u8(194)], Truncated);
    CheckFailure([u8(224)], Truncated);
    CheckFailure([u8(224), u8(160)], Truncated);
    CheckFailure([u8(240)], Truncated);
    CheckFailure([u8(240), u8(144)], Truncated);
    CheckFailure([u8(240), u8(144), u8(128)], Truncated);
    CheckFailure([u8(226), u8(40)], Malformed);
    CheckFailure([u8(240), u8(128)], Malformed);
    CheckFailure([u8(237), u8(160)], Malformed);
    CheckFailure([u8(241), u8(128), u8(65)], Malformed);
    return;
}

@test
EmptyInputAndInvalidOffsets :: () {
    empty: u8[] = [];
    valid := Validate(empty);
    assert(valid == nil);
    ended := Decode(empty, 0);
    assert(ended.error == nil);
    assert(ended.status == End && ended.width == 0);
    negative := Decode(empty, -1);
    assert(negative.status == InvalidOffset && negative.width == 0);
    CheckError(negative.error, InvalidOffset, -1);
    past := Decode([u8(65)], 2);
    assert(past.status == InvalidOffset && past.width == 0);
    CheckError(past.error, InvalidOffset, 2);
    minimum := Decode([u8(65)], -2147483648);
    assert(minimum.status == InvalidOffset && minimum.width == 0);
    CheckError(minimum.error, InvalidOffset, -2147483648);
    maximum := Decode([u8(65)], 2147483647);
    assert(maximum.status == InvalidOffset && maximum.width == 0);
    CheckError(maximum.error, InvalidOffset, 2147483647);
    counted := Count("");
    assert(counted.error == nil);
    assert(counted.count == 0);
    return;
}

@test
OffsetsIdentifyTheSequenceStartWithoutConsuming :: () {
    data: u8[] = [u8(65), u8(226), u8(40), u8(161)];
    decoded := Decode(data, 1);
    assert(decoded.status == Malformed && decoded.width == 0);
    CheckError(decoded.error, Malformed, 1);
    again := Decode(data, 1);
    assert(again.status == Malformed && again.width == 0);
    CheckError(again.error, Malformed, 1);
    following := Decode(data, 2);
    assert(following.status == Success && int(following.value) == 40 && following.width == 1);
    assert(following.error == nil);
    validated := Validate(data);
    CheckError(validated, Malformed, 1);
    assert(data[0] == 65 && data[1] == 226 && data[2] == 40 && data[3] == 161);
    continuation := Decode([u8(194), u8(128)], 1);
    assert(continuation.status == Malformed && continuation.width == 0);
    CheckError(continuation.error, Malformed, 1);
    return;
}

@test
StringsCountScalarsAndPreserveNul :: () {
    text := "A\u0000é🐈";
    valid := ValidateString(text);
    assert(valid == nil);
    counted := Count(text);
    assert(counted.error == nil);
    assert(counted.count == 4);
    nul := DecodeString(text, 1);
    assert(nul.error == nil);
    assert(nul.status == Success && int(nul.value) == 0 && nul.width == 1);
    accent := DecodeString(text, 2);
    assert(accent.error == nil);
    assert(accent.status == Success && int(accent.value) == 233 && accent.width == 2);
    cat := DecodeString(text, 4);
    assert(cat.error == nil);
    assert(cat.status == Success && int(cat.value) == 128008 && cat.width == 4);
    end := DecodeString(text, 8);
    assert(end.error == nil);
    assert(end.status == End && end.width == 0);
    negative := DecodeString(text, -1);
    assert(negative.status == InvalidOffset && negative.width == 0);
    CheckError(negative.error, InvalidOffset, -1);
    past := DecodeString(text, 9);
    assert(past.status == InvalidOffset && past.width == 0);
    CheckError(past.error, InvalidOffset, 9);
    minimum := DecodeString(text, -2147483648);
    assert(minimum.status == InvalidOffset && minimum.width == 0);
    CheckError(minimum.error, InvalidOffset, -2147483648);
    maximum := DecodeString(text, 2147483647);
    assert(maximum.status == InvalidOffset && maximum.width == 0);
    CheckError(maximum.error, InvalidOffset, 2147483647);
    combining := Count("é");
    assert(combining.error == nil);
    assert(combining.count == 2);
    bom := Count("\uFEFFa");
    assert(bom.error == nil);
    assert(bom.count == 2);
    return;
}

@test
StringAndArrayDecodersAgree :: () {
    text := "A\u0000é🐈";
    data: u8[] = [u8(65), u8(0), u8(195), u8(169), u8(240), u8(159), u8(144), u8(136)];
    for (offset in 0..<9) {
        a := Decode(data, offset);
        b := DecodeString(text, offset);
        assert(int(a.value) == int(b.value) && a.width == b.width);
        assert(a.status == b.status);
        CheckSameError(a.error, b.error);
    }
    malformed := strings.Slice("é", 1, 1);
    invalid := ValidateString(malformed);
    CheckError(invalid, Malformed, 0);
    rejected := DecodeString(malformed, 0);
    assert(rejected.status == Malformed && rejected.width == 0);
    CheckError(rejected.error, Malformed, 0);
    truncated := strings.Slice("a🐈", 0, 3);
    counted := Count(truncated);
    assert(counted.count == 0);
    CheckError(counted.error, Truncated, 1);
    return;
}

@test
EncodedArraysHaveIndependentValues :: () {
    encoded := Encode(char(233));
    copied := encoded;
    encoded[0] = 65;
    assert(copied[0] == 195 && copied[1] == 169);
    fresh := Encode(char(233));
    assert(fresh[0] == 195 && fresh[1] == 169);
    return;
}

@test
PublicApi :: () {
    decoded := Decode([u8(195), u8(169)], 0);
    assert(decoded.error == nil);
    assert(decoded.status == Success && int(decoded.value) == 233 && decoded.width == 2);
    ended := Decode([], 0);
    assert(ended.error == nil && ended.status == End && ended.width == 0);
    assert(Validate([]) == nil);
    assert(Validate([u8(0), u8(127)]) == nil);

    rejected := Decode([u8(65), u8(237), u8(160)], 1);
    assert(rejected.width == 0 && rejected.status == Malformed);
    error := rejected.error;
    assert(error != nil);
    if error {
        assert(error.kind == Malformed && error.offset == 1);
    }
    truncated := Validate([u8(65), u8(226), u8(130)]);
    assert(truncated != nil);
    if truncated {
        assert(truncated.kind == Truncated && truncated.offset == 1);
    }
    invalid := DecodeString("a", 2147483647).error;
    assert(invalid != nil);
    if invalid {
        assert(invalid.kind == InvalidOffset && invalid.offset == 2147483647);
    }

    text := "A\u0000é🐈";
    scalar := DecodeString(text, 1);
    assert(scalar.error == nil && scalar.value == char(0) && scalar.width == 1);
    assert(ValidateString(text) == nil);
    counted := Count(text);
    assert(counted.error == nil && counted.count == 4);
    broken := strings.Slice("a🐈", 0, 3);
    failed := Count(broken);
    assert(failed.count == 0 && failed.error != nil);
    countError := failed.error;
    if countError {
        assert(countError.kind == Truncated && countError.offset == 1);
    }
    validationError := ValidateString(strings.Slice("é", 1, 1));
    assert(validationError != nil);
    if validationError {
        assert(validationError.kind == Malformed && validationError.offset == 0);
    }
    return;
}
