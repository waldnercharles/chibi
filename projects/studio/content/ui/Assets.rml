<div class="assets" data-attrif-data-grid="assets.grid">
  <use ui="List" id="assets-list" data-event-scroll="emit('assets.scroll')" data-style---tile-width="assets.tileWidth" data-style---tile-height="assets.tileHeight">
    <use ui="TreeRow" data-for="row : assets.rows" data-if="row.shown" data-alias-item="row" data-style-top="row.top" data-attr-data-asset="row.id" data-attrif-data-unused="row.unused" data-attrif-data-unresolved="row.unresolved" data-attr-data-drag="row.drag" data-attr-data-drag-payload="row.label" data-attr-data-drag-icon="row.icon" data-event-click="emit('assets.click', row.id, row.kind)" data-event-dblclick="emit('assets.open', row.id)" data-event-contextmenu="emit('assets.menu', row.id)"></use>
    <use ui="Tile" data-for="cell : assets.tiles" data-if="cell.shown" data-alias-tile="cell" data-style-top="cell.top" data-style-left="cell.left" data-attr-data-asset="cell.id" data-attr-data-tip="cell.label" data-attr-data-tip-about="cell.about" data-attr-data-tip-image="cell.preview" data-attr-data-drag="cell.drag" data-attr-data-drag-payload="cell.label" data-attr-data-drag-icon="cell.icon" data-event-click="emit('assets.click', cell.id, -1)" data-event-dblclick="emit('assets.open', cell.id)" data-event-contextmenu="emit('assets.menu', cell.id)"></use>
  </use>
  <div class="output-empty" data-if="assets.empty != ''">{{ assets.empty }}</div>
  <use ui="Menu" id="asset-menu">
    <use ui="MenuGroup" data-alias-group="assets.menu"/>
    <div data-for="entry : assets.menu.items">
      <use ui="MenuSeparator" data-if="entry.separator"/>
      <use ui="MenuItem" data-alias-item="entry" data-event-click="emit('assets.' + entry.action, assets.menu.id)"/>
    </div>
  </use>
</div>
