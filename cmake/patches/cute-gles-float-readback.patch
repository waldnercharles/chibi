diff --git a/src/cute_graphics_gles.cpp b/src/cute_graphics_gles.cpp
--- a/src/cute_graphics_gles.cpp
+++ b/src/cute_graphics_gles.cpp
@@ -2768,19 +2768,49 @@
 	int size;
 };
 
+// Exact for values read from a half-float target.
+static uint16_t s_half_from_float(float value)
+{
+	uint32_t x;
+	CF_MEMCPY(&x, &value, sizeof x);
+	uint32_t sign = (x >> 16) & 0x8000;
+	uint32_t mantissa = x & 0x7fffff;
+	int exponent = (int)((x >> 23) & 0xff);
+	if (exponent == 0xff) return (uint16_t)(sign | 0x7c00 | (mantissa ? 0x200 : 0));
+	exponent -= 127 - 15;
+	if (exponent >= 31) return (uint16_t)(sign | 0x7c00);
+	if (exponent <= 0) return (uint16_t)(exponent < -10 ? sign : sign | ((mantissa | 0x800000) >> (14 - exponent)));
+	return (uint16_t)(sign | ((uint32_t)exponent << 10) | (mantissa >> 13));
+}
+
 CF_Readback cf_gles_canvas_readback2(CF_Canvas canvas, int index)
 {
 	CF_GL_Canvas* c = (CF_GL_Canvas*)(uintptr_t)canvas.id;
 	if (!c || index < 0 || index >= (c->target_count > 1 ? c->target_count : 1)) return { 0 };
 	int w = c->w, h = c->h;
+	// Float targets read as RGBA/FLOAT, the float pair GLES guarantees; half targets
+	// then pack to halves, so sizes match the SDL_GPU backend's readbacks.
+	CF_GL_Texture* target = (CF_GL_Texture*)(uintptr_t)(index ? c->cf_colors_mrt[index] : c->cf_color).id;
+	GLenum format = target ? target->internal_fmt : GL_RGBA8;
+	bool half = format == GL_RGBA16F, full = format == GL_RGBA32F;
 	CF_GL_Readback* rb = (CF_GL_Readback*)CF_ALLOC(sizeof(CF_GL_Readback));
-	rb->size = w * h * 4;
+	rb->size = w * h * (half ? 8 : full ? 16 : 4);
 	rb->data = CF_ALLOC(rb->size);
 	GLuint prev_fbo = g_ctx.fbo;
 	s_bind_framebuffer(c->fbo);
 	if (index != 0) glReadBuffer(GL_COLOR_ATTACHMENT0 + (GLenum)index);
 	glPixelStorei(GL_PACK_ALIGNMENT, 4);
-	glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, rb->data);
+	if (half || full) {
+		float* texels = full ? (float*)rb->data : (float*)CF_ALLOC(w * h * 16);
+		glReadPixels(0, 0, w, h, GL_RGBA, GL_FLOAT, texels);
+		if (half) {
+			uint16_t* halves = (uint16_t*)rb->data;
+			for (int i = 0; i < w * h * 4; ++i) halves[i] = s_half_from_float(texels[i]);
+			CF_FREE(texels);
+		}
+	} else {
+		glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, rb->data);
+	}
 	if (index != 0) glReadBuffer(GL_COLOR_ATTACHMENT0);
 	s_bind_framebuffer(prev_fbo);
 	CF_POLL_OPENGL_ERROR();
