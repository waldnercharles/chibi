version 1
name "ModelCostVariants"
(array)entities {
    - {
        name "Camera"
        prototype "StudyCamera"
        components {
            GameCamera width=600.0 height=400.0 focal_distance=0.0
            GameHRC2D adaptive=#false resolution=0.5 min_resolution=0.5 surface_relief=0.0 ambient=0.12
        }
    }
    - {
        name "Light"
        prototype "StudyLight"
