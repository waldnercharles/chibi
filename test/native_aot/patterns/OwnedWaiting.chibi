package waiting_patterns

// Pattern payload owners remain live after their source changes and yields.

Value :: union { Nothing | Count(number: int) }
TextValue :: union { Nothing | Word(text: string) }
Worker :: () -> int {
    value := Value.Count(7);
    if value is .Count(number) {
        value = Value.Count(99);
        yield;
        return number;
    }
    return 0;
}
OwnedWorker :: () -> int {
    value := TextValue.Word(text_from_bytes([u8(119), 111, 114, 100]));
    if value is .Word(text) {
        value = TextValue.Nothing;
        yield;
        return text_byte_length(text);
    }
    return 0;
}
Main :: () -> int {
    number := await Worker();
    if number != 7 { return 1; }
    size := await OwnedWorker();
    if size != 4 { return 2; }
    return 0;
}
