package graph_tests

import engine "graph:engine"
import c "graph:c"
import files "graph:files"
import os "core:os"
import strings "core:strings"

// The profile options' compile flags, argument validation and target
// selection, checked on the engine's functions without running the graph.
Debug :: (sanitizers: string, frames: bool, optimization: string) -> engine.Profile {
    profile: engine.Profile = {
        compiler: "/unused/clang", cxx_compiler: "/unused/clang++", compiler_id: "Clang", build_type: "Debug",
        debug_optimization: optimization, debug_frame_pointers: frames, architecture: "", sysroot: "",
        warnings: false, sanitizers: sanitizers, debug_compilation_dir: "", libclang_include: "",
        opengl_library: "", opengl_include: "", glx_library: "", libclang_library: "",
        clang_resource_include: "", third_party: "", reflect: ""
    };
    return profile;
}
Has :: (flags: string[], flag: string) -> bool {
    for (each in flags) {
        if (each == flag) {
            return true;
        }
    }
    return false;
}
Count :: (flags: string[], prefix: string) -> int {
    count := 0;
    for (each in flags) {
        if (strings.HasPrefix(each, prefix)) {
            count += 1;
        }
    }
    return count;
}

// A Debug profile keeps -g and its assertions, instruments only when asked,
// keeps frame pointers for sanitizers or when asked, and adds -O only for an
// explicit debug optimization level.
DebugFlagsKeepInstrumentation :: () {
    for (language in ["c", "cxx", "objc"]) {
        for (sanitizers in ["", "address,undefined"]) {
            for (frames in [false, true]) {
                for (optimization in ["", "0", "1"]) {
                    flags := engine.Flags(Debug(sanitizers, frames, optimization), "/build", "chibi_support", language);
                    assert(Has(flags, "-g"), "debug info");
                    assert(!Has(flags, "-fomit-frame-pointer") && Count(flags, "-DNDEBUG") == 0, "assertions and frames kept");
                    assert(Has(flags, "-fsanitize=address,undefined") == (sanitizers != ""), "sanitizers");
                    assert(Count(flags, "-fsanitize=") == Count(flags, "-fsanitize=address,undefined"), "only the chosen sanitizers");
                    assert(Has(flags, "-fno-omit-frame-pointer") == (sanitizers != "" || frames), "frame pointers");
                    if (optimization == "") {
                        assert(Count(flags, "-O") == 0, "no optimization level");
                    } else {
                        assert(Count(flags, "-O") == 1 && Has(flags, format_text("-O{}", optimization)), "the chosen level");
                    }
                }
            }
        }
    }
}

// Tests compile with assertions even where the profile would drop them.
TestsKeepAssertions :: () {
    for (target in ["policy_worker", "test_tools", "test_language"]) {
        assert(Has(engine.Options(target), "-UNDEBUG"), "test target undefines NDEBUG");
    }
}

// Debug-only options take one of their values and the Debug build type.
DebugOptionsAreValidated :: () {
    optimization := "graph: --debug-optimization requires 0 or 1 and build type Debug";
    frames := "graph: --debug-frame-pointers requires on or off and build type Debug";
    assert(engine.ProfileOptionError(["--debug-optimization", "1"], "Debug") == "", "valid level");
    assert(engine.ProfileOptionError(["--debug-frame-pointers", "on"], "Debug") == "", "valid frames");
    assert(engine.ProfileOptionError(["--debug-optimization", "2"], "Debug") == optimization, "level 2");
    assert(engine.ProfileOptionError(["--debug-optimization", "1", "--debug-optimization", "2"], "Debug") == optimization, "repeated");
    assert(engine.ProfileOptionError(["--debug-optimization", ""], "Debug") == optimization, "empty level");
    assert(engine.ProfileOptionError(["--debug-optimization"], "Debug") == optimization, "missing level");
    assert(engine.ProfileOptionError(["--debug-optimization", "--commands-only", "on"], "Debug") == optimization, "option as level");
    assert(engine.ProfileOptionError(["--debug-optimization", "1"], "Release") == optimization, "Release");
    assert(engine.ProfileOptionError(["--debug-optimization", "0"], "RelWithDebInfo") == optimization, "RelWithDebInfo");
    assert(engine.ProfileOptionError(["--debug-frame-pointers", "bad"], "Debug") == frames, "bad frames");
    assert(engine.ProfileOptionError(["--debug-frame-pointers", "on", "--debug-frame-pointers", "bad"], "Debug") == frames, "repeated frames");
    assert(engine.ProfileOptionError(["--debug-frame-pointers", ""], "Debug") == frames, "empty frames");
    assert(engine.ProfileOptionError(["--debug-frame-pointers"], "Debug") == frames, "missing frames");
    assert(engine.ProfileOptionError(["--debug-frame-pointers", "--commands-only", "on"], "Debug") == frames, "option as frames");
    assert(engine.ProfileOptionError(["--debug-frame-pointers", "on"], "Release") == frames, "Release frames");
    assert(engine.ProfileOptionError(["--debug-frame-pointers", "off"], "RelWithDebInfo") == frames, "RelWithDebInfo frames");
}

// Every named target must exist before anything is written.
ArgumentsAreValidated :: () {
    targets := engine.Targets();
    assert(engine.TargetError(["--target", "chibi_support"], targets) == "", "a known target");
    assert(engine.TargetError(["--commands-only", "on", "--target", "chibi-clt"], targets) == "graph: unknown target 'chibi-clt'", "an unknown target");
    assert(engine.TargetError(["--target", "chibi_support", "--target", "chibi-clt"], targets) == "graph: unknown target 'chibi-clt'", "a later unknown target");
    assert(engine.TargetError(["--commands-only", "on", "--target"], targets) == "graph: --target requires a target name", "a missing target");
    assert(engine.TargetError(["--target", "--commands-only", "on"], targets) == "graph: --target requires a target name", "an option as target");
}

ReflectionError :: (arguments: string[]) -> string {
    return engine.ReflectionOptions(arguments).error;
}

// SDK reflection takes three options and the toolchain definitions Make's
// SDK consumers pass, and rejects anything else before building.
ReflectionArgumentsAreValidated :: () {
    for (option in ["--jobs", "--build", "--libclang-root"]) {
        invalid := format_text("graph: invalid native reflection option '{0}'", option);
        assert(ReflectionError([option]) == invalid, "an option without a value");
        assert(ReflectionError([option, ""]) == invalid, "an option with an empty value");
    }
    assert(ReflectionError(["--commands-only", "on"]) == "graph: invalid native reflection option '--commands-only'", "an unknown option");
    unsupported := "graph: unsupported native reflection toolchain argument '-DUNSUPPORTED=ON'";
    assert(ReflectionError(["--", "-DUNSUPPORTED=ON"]) == unsupported, "an unknown definition");
    assert(ReflectionError(["--", "-D"]) == "graph: -D requires a native toolchain definition", "a missing definition");
    assert(ReflectionError(["--", "-DCMAKE_C_COMPILER:FILEPATH="]) == "graph: unsupported native reflection toolchain argument '-DCMAKE_C_COMPILER:FILEPATH='", "an empty definition");
    assert(ReflectionError(["--", "-DCMAKE_C_COMPILER:FILEPATH=/usr/bin/true", "-DUNSUPPORTED=ON"]) == unsupported, "a typed compiler, then an unknown definition");
    assert(ReflectionError(["--", "-D", "CMAKE_C_COMPILER:FILEPATH=/usr/bin/true", "-DUNSUPPORTED=ON"]) == unsupported, "a split compiler, then an unknown definition");
    assert(ReflectionError(["--", "-D", "LIBCLANG_ROOT:PATH=/fixture/llvm root", "-DUNSUPPORTED=ON"]) == unsupported, "a split libclang root, then an unknown definition");
    assert(ReflectionError(["--", "-D", "UNSUPPORTED=ON"]) == unsupported, "a split unknown definition");

    value := "/fixture/llvm root=value";
    mapped := engine.NativeToolchainOption(strings.Join(["-DLIBCLANG_ROOT:PATH=", value], ""));
    assert(length(mapped) == 2 && mapped[0] == "--libclang-root" && mapped[1] == value, "a typed path keeps its value");
    assert(length(engine.NativeToolchainOption("-DLIBCLANG_ROOT:PATH")) == 0, "a definition without a value");

    // The last definition wins, and an explicit --libclang-root wins over both.
    reflection := engine.ReflectionOptions(["--build", "/out", "--libclang-root", "/llvm", "--", "-DCMAKE_C_COMPILER=cc",
                                            "-D", "CMAKE_C_COMPILER:FILEPATH=clang", "-DLIBCLANG_ROOT=/other"]);
    assert(reflection.error == "", "valid reflection arguments");
    options := reflection.options;
    assert(Option(options, "--compiler") == "clang" && Option(options, "--libclang-root") == "/llvm", "the chosen definitions");
    assert(Option(options, "--build") == "/out" && Option(options, "--profile") == "release" && Option(options, "--target") == "reflect", "the reflection build");
}

// Naming test_tools and the launcher builds the programs they run, as CMake's
// add_dependencies does, and no other program.
NamedProgramsBuildWhatTheyRun :: () {
    named := ["--commands-only", "on", "--target", "test_tools", "--target", "chibi"];
    for (program in ["test_tools", "chibi-compile", "chibi-compiler-host", "chibi"]) {
        assert(engine.Selected(named, program), "a program a named program runs");
    }
    assert(!engine.Selected(named, "chibi-build-host"), "tooling tests no longer run the private build host");
    assert(!engine.Selected(named, "reflect"), "an unrelated program");
    assert(engine.Selected(["--commands-only", "on"], "reflect"), "no target names every target");
}

// Companions may use runtime helpers added after the pinned bootstrap seed.
// Even a consumer of the asset library must first build the current compiler.
NativeCompanionsUseCurrentCompiler :: () {
    for (consumer in ["chibi-asset-compiler", "chibi_asset_compiler_host"]) {
        named := ["--target", consumer];
        assert(engine.Selected(named, "chibi"), "the current compiler is a transitive prerequisite");
        assert(engine.Selected(named, "chibi-asset-compiler"), "the native asset service is selected");
    }
    if (os.Platform() == "Darwin" || os.Platform() == "Linux") {
        assert(engine.Selected(["--target", "test_tools"], "chibi"), "a linked asset library needs the compiler too");
    }
    products := engine.NativeProducts();
    assert(length(products) == 2 && products[0] == "chibi" && products[1] == "chibi-asset-compiler",
           "the compiler precedes its companion");
    compiler := engine.NativeCommand("/verified seed", "/llvm", "/source", "/build output", "chibi", 2);
    assert(compiler[0] == "/verified seed", "only the current compiler is compiled by the seed");
    companion := engine.NativeCommand("/verified seed", "/llvm", "/source", "/build output", "chibi-asset-compiler", 2);
    assert(companion[0] == engine.Executable("/build output", "chibi"), "the companion uses the current compiler");
}

// The value after the first `--name`, as the graph reads options.
Option :: (options: string[], name: string) -> string {
    for (i in 0..<length(options) - 1) {
        if (options[i] == name) {
            return options[i + 1];
        }
    }
    return "";
}

// A directory resource mirrors its source: a file deleted from the source, and
// a directory emptied by that, are gone from the copy after the next install,
// as are files the copy held that the source never had.
MirrorDropsDeletedFiles :: () {
    root := strings.Join([os.Root(), "/.chibi/mirror-test"], "");
    assert(os.Run(["/bin/rm", "-rf", root]) == 0, "the old scratch is removed");
    source := strings.Join([root, "/source"], "");
    copy := strings.Join([root, "/copy"], "");
    for (path in [root, source, strings.Join([source, "/sub"], ""), copy]) {
        assert(os.MakeDirectory(path) == nil, "the directory is made");
    }
    for (path in ["/kept.chibi", "/gone.chibi", "/sub/inner.chibi"]) {
        assert(os.WriteText(strings.Join([source, path], ""), path) == nil, "the file is written");
    }
    assert(engine.CopyChanged(source, copy), "the first copy");
    assert(os.Kind(strings.Join([copy, "/gone.chibi"], "")) == os.KindFile, "the copy holds the file");
    assert(os.Kind(strings.Join([copy, "/sub/inner.chibi"], "")) == os.KindFile, "the copy holds the nested file");
    assert(os.WriteText(strings.Join([copy, "/stale.chibi"], ""), "stale") == nil, "a stale file is planted");
    assert(os.Remove(strings.Join([source, "/gone.chibi"], "")) == nil, "the file is deleted from the source");
    assert(os.Remove(strings.Join([source, "/sub/inner.chibi"], "")) == nil, "the nested file is deleted from the source");
    assert(os.Remove(strings.Join([source, "/sub"], "")) == nil, "the emptied directory is deleted from the source");
    assert(engine.CopyChanged(source, copy), "the second copy");
    listed := os.List(copy);
    assert(listed.error == nil && length(listed.names) == 1 && listed.names[0] == "kept.chibi", "the copy is the source");
    assert(os.Run(["/bin/rm", "-rf", root]) == 0, "the scratch is removed");
}

// The build host runs this entry; each case stops it on a failed assert.
pub Run :: () -> int {
    NativeCompanionsUseCurrentCompiler();
    NativeIdentityUsesAuthoredOwners();
    NativeStepsUseCurrentSourceInventory();
    MirrorDropsDeletedFiles();
    DebugFlagsKeepInstrumentation();
    TestsKeepAssertions();
    DebugOptionsAreValidated();
    ArgumentsAreValidated();
    ReflectionArgumentsAreValidated();
    NamedProgramsBuildWhatTheyRun();
    return 0;
}


IdentityWrite :: (path: string, text: string) {
    failure := os.WriteText(path, text);
    assert(failure == nil, "write a native identity input");
}
IdentityRead :: (path: string) -> string {
    read := os.ReadText(path);
    assert(read.error == nil, "read the identity");
    return read.text;
}

// A native SDK identity needs no VM source/header tree. The package compiler's
// prepared encoder remains the explicit compile-only artifact owner.
NativeIdentityUsesAuthoredOwners :: () {
    root := strings.Concatenate([os.Root(), "/.chibi/native-identity-test"]);
    removed := os.Run(["/bin/rm", "-rf", root]);
    assert(removed == 0, "remove an earlier identity fixture");
    owner_folder := strings.Concatenate([root, "/tools/compiler/prepared_writer"]);
    for (path in [strings.Concatenate([root, "/sdk"]), owner_folder]) {
        made := os.MakeDirectory(path);
        assert(made == nil, "make the identity inputs");
    }
    sdk := strings.Concatenate([root, "/sdk/VERSION"]);
    project := strings.Concatenate([root, "/sdk/PROJECT_VERSION"]);
    owner := strings.Concatenate([owner_folder, "/Writer.chibi"]);
    output := strings.Concatenate([root, "/build"]);
    metadata := strings.Concatenate([output, "/sdk/chibi_engine_metadata.json"]);
    IdentityWrite(sdk, "9.8.7\n");
    IdentityWrite(project, "39\n");
    writer := "package prepared_writer\nVersion: int : 28;\n";
    IdentityWrite(owner, writer);
    written := engine.WriteNativeIdentity(root, output);
    assert(written && !os.Exists(strings.Concatenate([root, "/src"])), "native identity has no C VM dependency");
    text := IdentityRead(metadata);
    assert(strings.Contains(text, "\"sdk_version\": \"9.8.7\"") && strings.Contains(text, "\"project_version\": 39"), "public version fields are preserved");
    assert(strings.Contains(text, "\"backends\": [\"native\"]") && !strings.Contains(text, "\"events\""), "native metadata names its live backend and artifact");
    assert(strings.Contains(text, "\"execution\": {\"version\": 28") && strings.Contains(text, "\"source\": \"tools/compiler/prepared_writer/Writer.chibi\""), "the prepared writer owns the execution format");
    assert(strings.Contains(text, os.HashText(writer)) && !strings.Contains(text, "src/"), "the exact encoder bytes decide the format identity");
    for (bad in ["", "0", "-1", "039", "39x", "1\n2", "2147483648"]) {
        IdentityWrite(project, bad);
        written = engine.WriteNativeIdentity(root, output);
        assert(!written && IdentityRead(metadata) == text, "an invalid compatibility version preserves prior metadata");
    }
    failure := os.Remove(project);
    assert(failure == nil, "remove the compatibility version input");
    written = engine.WriteNativeIdentity(root, output);
    assert(!written && IdentityRead(metadata) == text, "a missing compatibility version has no default");
    IdentityWrite(project, "39\n");
    for (bad in ["", "Version: int : 0;\n", "Version: int : 28;\nVersion: int : 29;\n", "Version: string : 28;\n"]) {
        IdentityWrite(owner, bad);
        written = engine.WriteNativeIdentity(root, output);
        assert(!written && IdentityRead(metadata) == text, "an invalid encoder version preserves prior metadata");
    }
    writer = "package prepared_writer\nVersion : int : 29;\n// codec change\n";
    IdentityWrite(owner, writer);
    written = engine.WriteNativeIdentity(root, output);
    text = IdentityRead(metadata);
    assert(written && strings.Contains(text, "\"execution\": {\"version\": 29") && strings.Contains(text, os.HashText(writer)), "the encoder owns its version and identity together");
    // Explicit VM reference builds retain their C codec identity, while the
    // project compatibility field has the same single SDK owner.
    for (directory in ["execution", "types", "runtime"]) {
        made := os.MakeDirectory(strings.Concatenate([root, "/src/", directory]));
        assert(made == nil, "make legacy identity input directories");
    }
    for (path in ["execution/prepared.c", "execution/prepared_function.c", "execution/prepared_record.c",
                  "types/value_wire.c", "types/value_wire.h", "runtime/event_catalog.c"]) {
        IdentityWrite(strings.Concatenate([root, "/src/", path]), "legacy codec owner\n");
    }
    IdentityWrite(strings.Concatenate([root, "/src/execution/prepared.h"]), "#define EXECUTION_PREPARED_VERSION 28\n");
    IdentityWrite(strings.Concatenate([root, "/src/runtime/event_catalog.h"]), "#define EVENT_CATALOG_VERSION 3\n");
    profile := Debug("", false, "");
    profile.architecture = "fixture";
    legacy := strings.Concatenate([root, "/legacy"]);
    written = engine.WriteIdentity(root, legacy, profile);
    assert(written, "the explicit VM identity remains available");
    old := IdentityRead(strings.Concatenate([legacy, "/sdk/chibi_engine_metadata.json"]));
    assert(strings.Contains(old, "\"backends\": [\"bytecode\", \"sljit\"]") && strings.Contains(old, "\"events\": {\"version\": 3"), "the explicit VM identity retains its codec records");
    IdentityWrite(project, "40\n");
    written = engine.WriteNativeIdentity(root, output);
    assert(written && strings.Contains(IdentityRead(metadata), "\"project_version\": 40"), "native identity reads the SDK version authority");
    written = engine.WriteIdentity(root, legacy, profile);
    assert(written && strings.Contains(IdentityRead(strings.Concatenate([legacy, "/sdk/chibi_engine_metadata.json"])), "\"project_version\": 40"), "legacy identity derives the same compatibility version");
    removed = os.Run(["/bin/rm", "-rf", root]);
    assert(removed == 0, "remove the private identity fixture");
}


StepExpected :: (command: string[], inputs: string[], output: string, wanted: int, runs: int) {
    result := c.Step(command, inputs, output);
    if (result != wanted) { os.Print(format_text("step status {}, expected {}", result, wanted)); }
    assert(result == wanted, "the step uses its current declared input inventory");
    count := os.ReadText(strings.Concatenate([output, ".calls"]));
    assert(count.error == nil && strings.ByteLength(count.text) == runs, "a cache hit starts no child process");
}

// Real source trees and a child process test both sides of the cache boundary:
// generated files do not rebuild products, while changed source inventories do.
NativeStepsUseCurrentSourceInventory :: () {
    root := strings.Concatenate([os.Root(), "/.chibi/native-source-inventory"]);
    removed := os.Run(["/bin/rm", "-rf", root]);
    assert(removed == 0, "remove an earlier inventory fixture");
    sources := strings.Concatenate([root, "/source with spaces"]);
    made := os.MakeDirectory(sources);
    assert(made == nil, "make the source tree");
    main := strings.Concatenate([sources, "/Main.chibi"]);
    written := os.WriteText(main, "package main\n");
    assert(written == nil, "write the first source");
    output := strings.Concatenate([root, "/product"]);
    command := ["/bin/sh", "-c", "set -eu; printf x >>\"$1.calls\"; /usr/bin/find \"$2\" -type f -name '*.chibi' -exec /bin/cat {} + >\"$1\"", "source-step", output, sources];

    // Existing receipts may still contain directory stamps. They rebuild once
    // when the fresh inventory drops those paths, then become warm.
    StepExpected(command, [sources, main], output, 1, 1);
    inputs := engine.NativeInputs(sources);
    assert(length(inputs) == 1 && inputs[0] == main, "native inputs contain source files only");
    StepExpected(command, inputs, output, 1, 2);
    StepExpected(command, inputs, output, 0, 2);
    for (directory in ["build/native/O2-cache", "bootstrap", "empty-package"]) {
        generated := strings.Concatenate([sources, "/", directory]);
        made = os.MakeDirectory(generated);
        assert(made == nil, "make a generated or empty directory");
        artifact := strings.Concatenate([generated, "/compiler.chibip"]);
        written = os.WriteText(artifact, "generated bytes\n");
        assert(written == nil, "write an unrelated prepared artifact");
        StepExpected(command, engine.NativeInputs(sources), output, 0, 2);
        removed_file := os.Remove(artifact);
        assert(removed_file == nil, "remove the unrelated artifact");
        StepExpected(command, engine.NativeInputs(sources), output, 0, 2);
    }
    package_folder := strings.Concatenate([sources, "/new-package"]);
    made = os.MakeDirectory(package_folder);
    assert(made == nil, "make a new package");
    added := strings.Concatenate([package_folder, "/Added.chibi"]);
    written = os.WriteText(added, "package added\n");
    assert(written == nil, "add a source file");
    StepExpected(command, engine.NativeInputs(sources), output, 1, 3);
    result := os.ReadText(output);
    assert(result.error == nil && strings.Contains(result.text, "package added"), "the rebuild reads the added source");
    written = os.WriteText(main, "package changed_source\n");
    assert(written == nil, "edit an existing source");
    StepExpected(command, engine.NativeInputs(sources), output, 1, 4);
    removed_file := os.Remove(added);
    assert(removed_file == nil, "remove a source file");
    StepExpected(command, engine.NativeInputs(sources), output, 1, 5);
    StepExpected(command, engine.NativeInputs(sources), output, 0, 5);
    assert(length(engine.NativeInputs(strings.Concatenate([sources, "/missing"]))) == 0,
           "an unreadable source inventory is not a partial success");

    // Valid fingerprints cannot substitute a different input or output owner.
    // Build each malformed receipt after the preceding rebuild, so its output
    // fingerprint is current and cannot accidentally explain the rejection.
    other := strings.Concatenate([root, "/other owner"]);
    written = os.WriteText(other, "other bytes\n");
    assert(written == nil, "write another owner");
    head := strings.Concatenate([strings.Join(command, "\n"), "\n\n"]);
    record := strings.Concatenate([output, ".chibi-record"]);
    for (shape in 0..<6) {
        main_pair := strings.Concatenate([main, "\n", files.Fingerprint(main), "\n"]);
        output_pair := strings.Concatenate([output, "\n", files.Fingerprint(output), "\n"]);
        other_pair := strings.Concatenate([other, "\n", files.Fingerprint(other), "\n"]);
        malformed := "";
        if (shape == 0) { malformed = strings.Concatenate([head, other_pair, output_pair]); }
        else if (shape == 1) { malformed = strings.Concatenate([head, main_pair, other_pair]); }
        else if (shape == 2) { malformed = head; }
        else if (shape == 3) { malformed = strings.Concatenate([head, main_pair]); }
        else if (shape == 4) { malformed = strings.Concatenate([head, main_pair, output, "\n"]); }
        else { malformed = strings.Concatenate(["wrong command\n", head, main_pair, output_pair]); }
        written = os.WriteText(record, malformed);
        assert(written == nil, "write a malformed receipt");
        StepExpected(command, engine.NativeInputs(sources), output, 1, 6 + shape);
    }
    StepExpected(command, engine.NativeInputs(sources), output, 0, 11);
    removed = os.Run(["/bin/rm", "-rf", root]);
    assert(removed == 0, "remove the source inventory fixture");
}
