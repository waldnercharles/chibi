@@ -816,6 +816,20 @@ CF_API void CF_CALL cf_draw_pop_dash(void);
  */
 CF_API void CF_CALL cf_draw_push_outline(CF_Color color, float width);
 
+/**
+ * @function cf_draw_push_interior_border
+ * @category draw
+ * @brief    Draws a border inside subsequent SDF shapes.
+ * @param    color  Border color, composited over the interior fill.
+ * @param    width  Inward border width in world units. Nonpositive values disable it.
+ * @remarks  The outer silhouette is unchanged. The fill is inset by width and the
+ *           remaining edge coverage receives the border color. Works with filled
+ *           and stroked SDF shapes, and composes with glow. Sprites and text ignore
+ *           it. Shares the outline stack: pair with cf_draw_pop_outline.
+ * @related  cf_draw_pop_outline cf_draw_push_outline cf_draw_push_glow
+ */
+CF_API void CF_CALL cf_draw_push_interior_border(CF_Color color, float width);
+
 /**
  * @function cf_draw_pop_outline
  * @category draw
@@ -2493,6 +2507,7 @@ CF_INLINE CF_Color draw_peek_color() { return cf_draw_peek_color(); }
 CF_INLINE void draw_push_dash(float on_length, float off_length, float phase) { cf_draw_push_dash(on_length, off_length, phase); }
 CF_INLINE void draw_pop_dash() { cf_draw_pop_dash(); }
 CF_INLINE void draw_push_outline(CF_Color color, float width) { cf_draw_push_outline(color, width); }
+CF_INLINE void draw_push_interior_border(CF_Color color, float width) { cf_draw_push_interior_border(color, width); }
 CF_INLINE void draw_pop_outline() { cf_draw_pop_outline(); }
 CF_INLINE void draw_push_glow(CF_Color color, float radius) { cf_draw_push_glow(color, radius); }
