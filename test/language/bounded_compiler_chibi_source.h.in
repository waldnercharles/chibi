    BOUNDED_SOURCE("syntax_diagnostics/Diagnostics.chibi", SYNTAX_CHIBI_SOURCE), \
    BOUNDED_SOURCE("/sdk/core/strings/Strings.chibi", CORE_STRINGS_SOURCE), \
    BOUNDED_SOURCE("source_snapshot/Snapshot.chibi", PACKAGE_SNAPSHOT_CHIBI_SOURCE), \
    BOUNDED_SOURCE("source_tokenizer/Tokenizer.chibi", SOURCE_TOKENIZER_SOURCE), \
    BOUNDED_SOURCE("source_parser/Tree.chibi", SOURCE_PARSER_TREE_SOURCE), \
    BOUNDED_SOURCE("source_parser/Types.chibi", SOURCE_PARSER_TYPES_SOURCE), \
    BOUNDED_SOURCE("source_parser/Expressions.chibi", SOURCE_PARSER_EXPRESSIONS_SOURCE), \
