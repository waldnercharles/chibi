version 3
name "CrossBoredHousing"
domain "model"
id_counter 23
description "Two nested differences cut orthogonal finite holes through a rounded block."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Rounded Box"
                inputs {
                    "Half Size" {
                        default x=27.0 y=23.0 z=25.0
                    }
                    Radius 4.0
                }
            }
            - {
                id 7
                type "Model Cylinder"
                inputs Radius=11.0 "Half Height"=40.0
            }
            - {
                id 11
                type "Model Rotate"
                inputs {
                    Angles {
                        default x=0.0 y=0.0 z=1.5707964
                    }
                }
            }
            - id=15 type="Model Difference"
            - id=19 type="Model Difference"
        }
        (array)edges {
            - from="3.Geometry" to="15.A"
            - from="7.Geometry" to="11.Geometry"
            - from="7.Geometry" to="15.B"
            - from="11.Geometry" to="19.B"
            - from="15.Geometry" to="19.A"
            - from="19.Geometry" to="1.Geometry"
        }
    }
}
