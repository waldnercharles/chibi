package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Follower")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Transform", data.Object([
                    data.Field.Named("x", data.Value.Real(-60.0))
                ]))
            ])),
            data.Field.Named("behaviors", data.List([
                data.Value.Text("Trail")
            ]))
        ])
    );
}
