package graph_tests

import engine "graph:engine"
import os "core:os"
import strings "core:strings"

// The profile options' compile flags, argument validation and target
// selection, checked on the engine's functions without running the graph.
Debug :: (sanitizers: string, frames: bool, optimization: string) -> engine.Profile {
    profile: engine.Profile = {
        compiler: "/unused/clang", cxx_compiler: "/unused/clang++", compiler_id: "Clang", build_type: "Debug",
        debug_optimization: optimization, debug_frame_pointers: frames, architecture: "", sysroot: "",
        warnings: false, sanitizers: sanitizers, debug_compilation_dir: "", libclang_include: "",
        opengl_library: "", opengl_include: "", glx_library: "", libclang_library: "",
        clang_resource_include: "", third_party: "", reflect: "", asset_generator_hosts: ""
    };
    return profile;
}
Has :: (flags: string[], flag: string) -> bool {
    for (each in flags) {
        if (each == flag) {
            return true;
        }
    }
    return false;
}
Count :: (flags: string[], prefix: string) -> int {
    count := 0;
    for (each in flags) {
        if (strings.HasPrefix(each, prefix)) {
            count += 1;
        }
    }
    return count;
}

// A Debug profile keeps -g and its assertions, instruments only when asked,
// keeps frame pointers for sanitizers or when asked, and adds -O only for an
// explicit debug optimization level.
DebugFlagsKeepInstrumentation :: () {
    for (language in ["c", "cxx", "objc"]) {
        for (sanitizers in ["", "address,undefined"]) {
            for (frames in [false, true]) {
                for (optimization in ["", "0", "1"]) {
                    flags := engine.Flags(Debug(sanitizers, frames, optimization), "/build", "chibi_support", language);
                    assert(Has(flags, "-g"), "debug info");
                    assert(!Has(flags, "-fomit-frame-pointer") && Count(flags, "-DNDEBUG") == 0, "assertions and frames kept");
                    assert(Has(flags, "-fsanitize=address,undefined") == (sanitizers != ""), "sanitizers");
                    assert(Count(flags, "-fsanitize=") == Count(flags, "-fsanitize=address,undefined"), "only the chosen sanitizers");
                    assert(Has(flags, "-fno-omit-frame-pointer") == (sanitizers != "" || frames), "frame pointers");
                    if (optimization == "") {
                        assert(Count(flags, "-O") == 0, "no optimization level");
                    } else {
                        assert(Count(flags, "-O") == 1 && Has(flags, format_text("-O{}", optimization)), "the chosen level");
                    }
                }
            }
        }
    }
}

// Tests compile with assertions even where the profile would drop them.
TestsKeepAssertions :: () {
    for (target in ["test_host", "policy_worker", "test_tools", "test_language"]) {
        assert(Has(engine.Options(target), "-UNDEBUG"), "test target undefines NDEBUG");
    }
}

// Debug-only options take one of their values and the Debug build type.
DebugOptionsAreValidated :: () {
    optimization := "graph: --debug-optimization requires 0 or 1 and build type Debug";
    frames := "graph: --debug-frame-pointers requires on or off and build type Debug";
    assert(engine.ProfileOptionError(["--debug-optimization", "1"], "Debug") == "", "valid level");
    assert(engine.ProfileOptionError(["--debug-frame-pointers", "on"], "Debug") == "", "valid frames");
    assert(engine.ProfileOptionError(["--debug-optimization", "2"], "Debug") == optimization, "level 2");
    assert(engine.ProfileOptionError(["--debug-optimization", "1", "--debug-optimization", "2"], "Debug") == optimization, "repeated");
    assert(engine.ProfileOptionError(["--debug-optimization", ""], "Debug") == optimization, "empty level");
    assert(engine.ProfileOptionError(["--debug-optimization"], "Debug") == optimization, "missing level");
    assert(engine.ProfileOptionError(["--debug-optimization", "--commands-only", "on"], "Debug") == optimization, "option as level");
    assert(engine.ProfileOptionError(["--debug-optimization", "1"], "Release") == optimization, "Release");
    assert(engine.ProfileOptionError(["--debug-optimization", "0"], "RelWithDebInfo") == optimization, "RelWithDebInfo");
    assert(engine.ProfileOptionError(["--debug-frame-pointers", "bad"], "Debug") == frames, "bad frames");
    assert(engine.ProfileOptionError(["--debug-frame-pointers", "on", "--debug-frame-pointers", "bad"], "Debug") == frames, "repeated frames");
    assert(engine.ProfileOptionError(["--debug-frame-pointers", ""], "Debug") == frames, "empty frames");
    assert(engine.ProfileOptionError(["--debug-frame-pointers"], "Debug") == frames, "missing frames");
    assert(engine.ProfileOptionError(["--debug-frame-pointers", "--commands-only", "on"], "Debug") == frames, "option as frames");
    assert(engine.ProfileOptionError(["--debug-frame-pointers", "on"], "Release") == frames, "Release frames");
    assert(engine.ProfileOptionError(["--debug-frame-pointers", "off"], "RelWithDebInfo") == frames, "RelWithDebInfo frames");
}

// Every named target must exist, and an absolute directory must follow
// --asset-generator-hosts, before anything is written.
ArgumentsAreValidated :: () {
    targets := engine.Targets();
    assert(engine.TargetError(["--target", "chibi_support"], targets) == "", "a known target");
    assert(engine.TargetError(["--commands-only", "on", "--target", "chibi-clt"], targets) == "graph: unknown target 'chibi-clt'", "an unknown target");
    assert(engine.TargetError(["--target", "chibi_support", "--target", "chibi-clt"], targets) == "graph: unknown target 'chibi-clt'", "a later unknown target");
    assert(engine.TargetError(["--commands-only", "on", "--target"], targets) == "graph: --target requires a target name", "a missing target");
    assert(engine.TargetError(["--target", "--commands-only", "on"], targets) == "graph: --target requires a target name", "an option as target");
    hosts := "graph: --asset-generator-hosts requires an absolute directory";
    assert(engine.ProfileOptionError(["--asset-generator-hosts", "build-release/sdk"], "Debug") == hosts, "relative hosts");
    assert(engine.ProfileOptionError(["--asset-generator-hosts"], "Debug") == hosts, "missing hosts");
    assert(engine.ProfileOptionError(["--asset-generator-hosts", "/abs/sdk"], "Debug") == "", "absolute hosts");
}

ReflectionError :: (arguments: string[]) -> string {
    return engine.ReflectionOptions(arguments).error;
}

// SDK reflection takes three options and the toolchain definitions Make's
// SDK consumers pass, and rejects anything else before building.
ReflectionArgumentsAreValidated :: () {
    for (option in ["--jobs", "--build", "--libclang-root"]) {
        invalid := format_text("graph: invalid native reflection option '{0}'", option);
        assert(ReflectionError([option]) == invalid, "an option without a value");
        assert(ReflectionError([option, ""]) == invalid, "an option with an empty value");
    }
    assert(ReflectionError(["--commands-only", "on"]) == "graph: invalid native reflection option '--commands-only'", "an unknown option");
    unsupported := "graph: unsupported native reflection toolchain argument '-DUNSUPPORTED=ON'";
    assert(ReflectionError(["--", "-DUNSUPPORTED=ON"]) == unsupported, "an unknown definition");
    assert(ReflectionError(["--", "-D"]) == "graph: -D requires a native toolchain definition", "a missing definition");
    assert(ReflectionError(["--", "-DCMAKE_C_COMPILER:FILEPATH="]) == "graph: unsupported native reflection toolchain argument '-DCMAKE_C_COMPILER:FILEPATH='", "an empty definition");
    assert(ReflectionError(["--", "-DCMAKE_C_COMPILER:FILEPATH=/usr/bin/true", "-DUNSUPPORTED=ON"]) == unsupported, "a typed compiler, then an unknown definition");
    assert(ReflectionError(["--", "-D", "CMAKE_C_COMPILER:FILEPATH=/usr/bin/true", "-DUNSUPPORTED=ON"]) == unsupported, "a split compiler, then an unknown definition");
    assert(ReflectionError(["--", "-D", "LIBCLANG_ROOT:PATH=/fixture/llvm root", "-DUNSUPPORTED=ON"]) == unsupported, "a split libclang root, then an unknown definition");
    assert(ReflectionError(["--", "-D", "UNSUPPORTED=ON"]) == unsupported, "a split unknown definition");

    value := "/fixture/llvm root=value";
    mapped := engine.NativeToolchainOption(strings.Join(["-DLIBCLANG_ROOT:PATH=", value], ""));
    assert(length(mapped) == 2 && mapped[0] == "--libclang-root" && mapped[1] == value, "a typed path keeps its value");
    assert(length(engine.NativeToolchainOption("-DLIBCLANG_ROOT:PATH")) == 0, "a definition without a value");

    // The last definition wins, and an explicit --libclang-root wins over both.
    reflection := engine.ReflectionOptions(["--build", "/out", "--libclang-root", "/llvm", "--", "-DCMAKE_C_COMPILER=cc",
                                            "-D", "CMAKE_C_COMPILER:FILEPATH=clang", "-DLIBCLANG_ROOT=/other"]);
    assert(reflection.error == "", "valid reflection arguments");
    options := reflection.options;
    assert(Option(options, "--compiler") == "clang" && Option(options, "--libclang-root") == "/llvm", "the chosen definitions");
    assert(Option(options, "--build") == "/out" && Option(options, "--profile") == "release" && Option(options, "--target") == "reflect", "the reflection build");
}

// Naming test_tools and the launcher builds the programs they run, as CMake's
// add_dependencies does, and no other program.
NamedProgramsBuildWhatTheyRun :: () {
    named := ["--commands-only", "on", "--target", "test_tools", "--target", "chibi"];
    for (program in ["test_tools", "policy_worker", "chibi-compile", "chibi-build-host", "chibi-compiler-host", "chibi"]) {
        assert(engine.Selected(named, program), "a program a named program runs");
    }
    assert(!engine.Selected(named, "test_host"), "another test driver");
    assert(engine.Selected(["--commands-only", "on"], "test_host"), "no target names every target");
}

// The value after the first `--name`, as the graph reads options.
Option :: (options: string[], name: string) -> string {
    for (i in 0..<length(options) - 1) {
        if (options[i] == name) {
            return options[i + 1];
        }
    }
    return "";
}

// A directory resource mirrors its source: a file deleted from the source, and
// a directory emptied by that, are gone from the copy after the next install,
// as are files the copy held that the source never had.
MirrorDropsDeletedFiles :: () {
    root := strings.Join([os.Root(), "/.chibi/mirror-test"], "");
    assert(os.Run(["/bin/rm", "-rf", root]) == 0, "the old scratch is removed");
    source := strings.Join([root, "/source"], "");
    copy := strings.Join([root, "/copy"], "");
    for (path in [root, source, strings.Join([source, "/sub"], ""), copy]) {
        assert(os.MakeDirectory(path) == nil, "the directory is made");
    }
    for (path in ["/kept.chibi", "/gone.chibi", "/sub/inner.chibi"]) {
        assert(os.WriteText(strings.Join([source, path], ""), path) == nil, "the file is written");
    }
    assert(engine.CopyChanged(source, copy), "the first copy");
    assert(os.Kind(strings.Join([copy, "/gone.chibi"], "")) == os.KindFile, "the copy holds the file");
    assert(os.Kind(strings.Join([copy, "/sub/inner.chibi"], "")) == os.KindFile, "the copy holds the nested file");
    assert(os.WriteText(strings.Join([copy, "/stale.chibi"], ""), "stale") == nil, "a stale file is planted");
    assert(os.Remove(strings.Join([source, "/gone.chibi"], "")) == nil, "the file is deleted from the source");
    assert(os.Remove(strings.Join([source, "/sub/inner.chibi"], "")) == nil, "the nested file is deleted from the source");
    assert(os.Remove(strings.Join([source, "/sub"], "")) == nil, "the emptied directory is deleted from the source");
    assert(engine.CopyChanged(source, copy), "the second copy");
    listed := os.List(copy);
    assert(listed.error == nil && length(listed.names) == 1 && listed.names[0] == "kept.chibi", "the copy is the source");
    assert(os.Run(["/bin/rm", "-rf", root]) == 0, "the scratch is removed");
}

// The build host runs this entry; each case stops it on a failed assert.
pub Run :: () -> int {
    MirrorDropsDeletedFiles();
    DebugFlagsKeepInstrumentation();
    TestsKeepAssertions();
    DebugOptionsAreValidated();
    ArgumentsAreValidated();
    ReflectionArgumentsAreValidated();
    NamedProgramsBuildWhatTheyRun();
    return 0;
}
