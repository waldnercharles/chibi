package family_probe

import native "project:llvm_native"
import abi "project:native_abi"
import host "project:native_link_host"
import link "project:native_link"
import os "core:os"
import strings "core:strings"

Module :: (target: abi.Target, template: string, old: bool) -> string {
    shape: native.Function = {result: abi.IntStorage, first_parameter: 0, parameters: 0,
        first_slot: 0, slots: 2, first_local: 0, locals: 0, first_code: 0, code: 4, first_argument: 0, arguments: 0};
    code: native.Instruction[] = [
        {op: native.Constant, type: abi.IntStorage, output: 0, left: 0, right: 0, target: 0, literal: 0},
        {op: native.ManagedNew, type: native.PointerType, output: 1, left: 0, right: abi.IntStorage, target: 0, literal: 1},
        {op: native.Publish, type: abi.IntStorage, output: 0, left: 0, right: 0, target: 0, literal: 0},
        {op: native.Return, type: 0, output: 0, left: 0, right: 0, target: 0, literal: 0}];
    empty: int[] = [];
    records: native.Record[] = [];
    switch native.EmitFamilyLibraryStates(target, "family", ["Frame"], [i64(1)], [shape], empty,
        [abi.IntStorage, native.PointerType], empty, code, empty, records, empty, [], [], 1, [], -1, []) {
        case .Rejected(pc, message): os.Print(message); return "";
        case .Emitted(text):
            // Only the host protocol is replaced. The real collector, ABI
            // metadata, context and source admission remain emitter-owned.
            body := strings.ReplaceAll(text, "@chibi_host_call_Frame", "@family.unused_frame");
            body = strings.ReplaceAll(body, "@chibi_host_retained_", "@family.unused_retained_");
            flag := "false";
            if old { flag = "true"; }
            return strings.Concatenate([body, strings.ReplaceAll(template, "@OLD@", flag)]);
    }
}
Main :: () -> int {
    args := os.Arguments();
    if length(args) != 4 { return 2; }
    work := args[0];
    llvm := args[1];
    level := 0;
    if args[3] == "2" { level = 2; }
    else if args[3] != "0" { return 2; }
    fixture := os.ReadText(args[2]);
    if fixture.error { return 2; }
    // The family ABI is verified for every desktop pointer/calling convention.
    // Actual image loading below uses the current platform's real linker.
    for (target, index in [abi.LinuxX64(), abi.MacOSArm64(), abi.WindowsX64()]) {
        module := Module(target, fixture.text, true);
        if module == "" { return 1; }
        path := format_text("{}/family-target-{}.ll", work, index);
        start := format_text("{}/family-start-{}.ll", work, index);
        runtime := link.ManagedFamilyContext(link.SharedContext(target.triple, true), true);
        if os.WriteText(path, module) != nil { return 2; }
        if os.WriteText(start, runtime) != nil { return 2; }
        for source in [path, start] {
            if os.Run([strings.Concatenate([llvm, "/opt"]), "-passes=verify", "-disable-output", source]) != 0 { return 1; }
        }
    }
    target := abi.LinuxX64();
    if os.Platform() == "Darwin" { target = abi.MacOSArm64(); }
    start := strings.Concatenate([work, "/family-start.ll"]);
    if os.WriteText(start, link.ManagedFamilyContext(link.SharedContext(target.triple, true), true)) != nil { return 2; }
    for name in ["old", "new", "bad-version", "bad-size"] {
        module := Module(target, fixture.text, name == "old");
        if name == "bad-version" {
            module = strings.ReplaceAll(module, format_text("ret i64 {}\n", abi.ManagedFamilyABI),
                format_text("ret i64 {}\n", abi.ManagedFamilyABI + 1));
        } else if name == "bad-size" {
            module = strings.ReplaceAll(module, "ret i64 %size\n", "ret i64 8\n");
        }
        path := format_text("{}/family-{}.ll", work, name);
        output := format_text("{}/family-{}.so", work, name);
        if os.WriteText(path, module) != nil { return 2; }
        objects := [strings.Concatenate([output, ".o"]), strings.Concatenate([output, "-start.o"])];
        if host.Objects(llvm, [path, start], objects, level, 1) { return 1; }
        plan := link.Program(target.triple, llvm, objects, [], [], [], output, "", false);
        plan.shared = true;
        if os.Platform() == "Darwin" {
            plan.imports = [{name: "System", symbols: ["calloc", "free", "malloc", "write", "abort", "fopen", "fclose", "access"]}];
        } else { plan.libraries = ["c"]; }
        if host.Link(plan) { return 1; }
    }
    return 0;
}
