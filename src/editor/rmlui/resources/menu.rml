<rml>
<head>
    <title>Chibi Editor Menus</title>
    <link type="text/rcss" href="menu.rcss" />
</head>
<body>
    <div id="menu-root">
        <div id="menu-bar" class="menu-bar" role="menubar" aria-label="Application menu">
            <div class="brand"><span class="brand-dot" aria-hidden="true"></span><span id="menu.brand.label">Chibi</span></div>
            <div class="menu-wrap" id="file-wrap">
                <button id="file.menu" class="menu-trigger" data-menu-trigger="file" role="menuitem" aria-haspopup="true" aria-expanded="false"><span id="file.label">File</span></button>
                <div id="file.popup" class="menu-popup" data-menu-popup="file" role="menu" aria-label="File" aria-hidden="true">
                    <button id="workspace.quick_open" class="menu-item" data-action="workspace.quick_open" role="menuitem"><span class="item-label">Quick Open</span><span id="quick-open-shortcut" class="shortcut">Ctrl+P</span></button>
                    <div class="separator"></div>
                    <button id="file.save" class="menu-item" data-action="file.save" data-requires-command="true" role="menuitem"><span class="item-label">Save</span><span id="save-shortcut" class="shortcut">Ctrl+S</span></button>
                    <button id="file.save_as" class="menu-item" data-action="file.save_as" data-requires-command="true" role="menuitem"><span class="item-label">Save As</span></button>
                    <button id="file.save_all" class="menu-item" data-action="file.save_all" data-requires-command="true" role="menuitem"><span class="item-label">Save All</span></button>
                    <div class="separator"></div>
                    <button id="file.reload" class="menu-item" data-action="file.reload" data-requires-command="true" role="menuitem"><span class="item-label">Reload</span></button>
                </div>
            </div>
            <div class="menu-wrap" id="edit-wrap">
                <button id="edit.menu" class="menu-trigger" data-menu-trigger="edit" role="menuitem" aria-haspopup="true" aria-expanded="false"><span id="edit.label">Edit</span></button>
                <div id="edit.popup" class="menu-popup" data-menu-popup="edit" role="menu" aria-label="Edit" aria-hidden="true">
                    <button id="edit.undo" class="menu-item" data-action="edit.undo" data-requires-undo="true" role="menuitem"><span class="item-label">Undo</span><span id="undo-shortcut" class="shortcut">Ctrl+Z</span></button>
                    <button id="edit.redo" class="menu-item" data-action="edit.redo" data-requires-redo="true" role="menuitem"><span class="item-label">Redo</span><span id="redo-shortcut" class="shortcut">Ctrl+Shift+Z</span></button>
                </div>
            </div>
            <div class="menu-wrap" id="view-wrap">
                <button id="view.menu" class="menu-trigger" data-menu-trigger="view" role="menuitem" aria-haspopup="true" aria-expanded="false"><span id="view.label">View</span></button>
                <div id="view.popup" class="menu-popup view-popup" data-menu-popup="view" role="menu" aria-label="View" aria-hidden="true">
                    <button id="view.graph_and_scene" class="menu-item" data-action="view.graph_and_scene" role="menuitem"><span class="item-label">Reset Workspace</span></button>
                    <div class="separator"></div>
                    <button id="view.navigator" class="menu-item checkable" data-action="view.navigator" role="menuitemcheckbox" aria-checked="false"><span class="check-mark">✓</span><span class="item-label">Navigator</span></button>
                    <button id="view.inspector" class="menu-item checkable" data-action="view.inspector" role="menuitemcheckbox" aria-checked="false"><span class="check-mark">✓</span><span class="item-label">Inspector</span></button>
                    <button id="view.node_canvas" class="menu-item checkable" data-action="view.node_canvas" role="menuitemcheckbox" aria-checked="false"><span class="check-mark">✓</span><span class="item-label">Node Canvas</span></button>
                    <button id="view.scene" class="menu-item checkable" data-action="view.scene" role="menuitemcheckbox" aria-checked="false"><span class="check-mark">✓</span><span class="item-label">Scene</span></button>
                    <div class="separator"></div>
                    <button id="view.compiler_results" class="menu-item checkable" data-action="view.compiler_results" role="menuitemcheckbox" aria-checked="false"><span class="check-mark">✓</span><span class="item-label">Compiler Results</span></button>
                    <button id="view.output_log" class="menu-item checkable" data-action="view.output_log" role="menuitemcheckbox" aria-checked="false"><span class="check-mark">✓</span><span class="item-label">Output Log</span></button>
                    <button id="view.performance" class="menu-item checkable" data-action="view.performance" role="menuitemcheckbox" aria-checked="false"><span class="check-mark">✓</span><span class="item-label">Performance</span></button>
                    <div class="separator"></div>
                    <button id="view.inline_edge_nodes" class="menu-item checkable" data-action="view.inline_edge_nodes" role="menuitemcheckbox" aria-checked="false"><span class="check-mark">✓</span><span class="item-label">Inline nodes on edge drop</span></button>
                    <button id="view.reduced_motion" class="menu-item checkable" data-action="view.reduced_motion" role="menuitemcheckbox" aria-checked="false"><span class="check-mark">✓</span><span class="item-label">Reduce Motion</span></button>
                    <div class="separator"></div>
                    <button id="view.reset_layout" class="menu-item" data-action="view.reset_layout" role="menuitem"><span class="item-label">Reset Layout</span></button>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
