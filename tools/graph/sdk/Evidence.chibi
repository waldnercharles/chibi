package sdk

import engine "graph:engine"
import c "graph:c"
import strings "core:strings"

// Runtime package provenance comes from declared graph commands and current
// records. Compiler banners are observations, not a parsed version promise.
EvidenceJoin :: (parts: string[]) -> string {
    return strings.Join(parts, "");
}

EvidenceFailure :: (message: string) -> string {
    build.report(EvidenceJoin(["sdk: ", message]));
    return "";
}

EvidenceNumber :: (text: string) -> int {
    if (text == "") {
        return -1;
    }
    value := 0;
    for (byte in strings.Bytes(text)) {
        if (byte < 48 || byte > 57 || value > 1000000) {
            return -1;
        }
        value = value * 10 + byte - 48;
    }
    return value;
}

EvidenceBool :: (value: bool) -> string {
    if (value) {
        return "true";
    }
    return "false";
}

EvidenceDefine :: (text: string, name: string) -> string {
    prefix := EvidenceJoin(["#define ", name, " "]);
    for (line in build.lines(text)) {
        if (strings.HasPrefix(line, prefix)) {
            return strings.TrimSpace(build.after(line, prefix));
        }
    }
    return "";
}

EvidenceProfile :: (profile: engine.Profile) -> string {
    return JsonObject([
        "compiler", "cxx_compiler", "compiler_id", "build_type", "debug_optimization",
        "debug_frame_pointers", "architecture", "sysroot", "warnings", "sanitizers",
        "debug_compilation_dir", "libclang_include", "opengl_library", "opengl_include",
        "glx_library", "libclang_library", "clang_resource_include", "third_party", "reflect",
        "asset_generator_hosts"
    ], [
        JsonQuote(profile.compiler), JsonQuote(profile.cxx_compiler), JsonQuote(profile.compiler_id),
        JsonQuote(profile.build_type), JsonQuote(profile.debug_optimization),
        EvidenceBool(profile.debug_frame_pointers), JsonQuote(profile.architecture),
        JsonQuote(profile.sysroot), EvidenceBool(profile.warnings), JsonQuote(profile.sanitizers),
        JsonQuote(profile.debug_compilation_dir), JsonQuote(profile.libclang_include),
        JsonQuote(profile.opengl_library), JsonQuote(profile.opengl_include), JsonQuote(profile.glx_library),
        JsonQuote(profile.libclang_library), JsonQuote(profile.clang_resource_include),
        JsonQuote(profile.third_party), JsonQuote(profile.reflect), JsonQuote(profile.asset_generator_hosts)
    ]);
}

EvidenceTools :: (tools: c.Tools) -> string {
    return JsonObject(["launcher", "compiler", "cxx_compiler", "archiver", "ranlib", "jobs"], [
        JsonQuote(tools.launcher), JsonQuote(tools.compiler), JsonQuote(tools.cxx_compiler),
        JsonQuote(tools.archiver), JsonQuote(tools.ranlib), format_text("{}", tools.jobs)
    ]);
}

EvidenceTargets :: () -> string[] {
    selected: string[] = [];
    for (target in engine.Targets()) {
        for (name in RuntimeTargets()) {
            if (BuildTarget(name) == target) {
                selected.append(target);
                break;
            }
        }
    }
    selected.append("chibi-player");
    return selected;
}

EvidenceToolIdentities :: (profile: engine.Profile, tools: c.Tools) -> string {
    names := ["compiler", "cxx_compiler", "archiver", "ranlib", "launcher", "reflect"];
    paths := [tools.compiler, tools.cxx_compiler, tools.archiver, tools.ranlib, tools.launcher, profile.reflect];
    keys: string[] = [];
    values: string[] = [];
    resolved_paths: string[] = [];
    hashes: string[] = [];
    for (i in 0..<length(names)) {
        path := paths[i];
        if (path == "" && (names[i] == "launcher" || names[i] == "reflect")) {
            continue;
        }
        resolved := build.resolve_path(build.find_executable(path));
        if (resolved == "" || build.file_kind(resolved) != "file") {
            return EvidenceFailure(EvidenceJoin(["runtime tool is unavailable: ", names[i]]));
        }
        checksum := "";
        for (previous in 0..<length(resolved_paths)) {
            if (resolved_paths[previous] == resolved) {
                checksum = hashes[previous];
                break;
            }
        }
        if (checksum == "") {
            checksum = build.hash_file(resolved);
        }
        if (checksum == "") {
            return EvidenceFailure("runtime tool identity is unavailable");
        }
        resolved_paths.append(resolved);
        hashes.append(checksum);
        keys.append(names[i]);
        values.append(JsonObject(["path", "resolved", "sha256"], [JsonQuote(path), JsonQuote(resolved), JsonQuote(checksum)]));
    }
    return JsonObject(keys, values);
}

// The generic graph cache records command paths, not executable bytes. This
// SDK preflight binds tool bytes before construction and invalidates only the
// selected objects' cache records when that binding changed or is unavailable.
pub PrepareBuildConfiguration :: (build_dir: string, profile: engine.Profile, tools: c.Tools) -> bool {
    if (!Supported(build.platform()) || !strings.HasPrefix(build_dir, "/") || tools.jobs < 1) {
        EvidenceFailure("invalid runtime build preflight");
        return false;
    }
    identities := EvidenceToolIdentities(profile, tools);
    if (identities == "") {
        return false;
    }
    previous := JsonCanonical(build.read_file(EvidenceJoin([build_dir, "/sdk/runtime-build.json"])));
    if (JsonGet(previous, "tool_identities") != identities) {
        // A failed build must not let a restored tool revalidate objects the other tool made.
        configuration := EvidenceJoin([build_dir, "/sdk/runtime-build.json"]);
        if (build.file_kind(configuration) != "" && !build.remove(configuration)) {
            EvidenceFailure("cannot invalidate the previous runtime build configuration");
            return false;
        }
        for (target in EvidenceTargets()) {
            built := engine.Library(build.root(), build_dir, profile.third_party, target);
            for (source in engine.Sources(build.root(), build_dir, profile.third_party, target)) {
                record := EvidenceJoin([c.Object(built, source), ".chibi-record"]);
                kind := build.file_kind(record);
                if (kind != "" && (kind != "file" || !build.remove(record))) {
                    EvidenceFailure("cannot invalidate a selected runtime object record");
                    return false;
                }
            }
        }
    }
    pending := JsonObject(["format", "system", "profile", "tools", "tool_identities"], [
        "1", JsonQuote(build.platform()), EvidenceProfile(profile), EvidenceTools(tools), identities
    ]);
    return pending != "" && build.make_directory(EvidenceJoin([build_dir, "/sdk"])) &&
           build.write_file(EvidenceJoin([build_dir, "/sdk/runtime-build-pending.json"]),
                            EvidenceJoin([pending, "\n"]));
}

// Called only after successful construction. Preprocessor target facts produce
// no object or executable, and include the same architecture/sysroot selections.
pub WriteBuildConfiguration :: (build_dir: string, profile: engine.Profile, tools: c.Tools) -> bool {
    if (!Supported(build.platform()) || !strings.HasPrefix(build_dir, "/") || tools.compiler == "" ||
        tools.archiver == "" || tools.ranlib == "" || tools.jobs < 1) {
        EvidenceFailure("invalid runtime build configuration");
        return false;
    }
    pending_path := EvidenceJoin([build_dir, "/sdk/runtime-build-pending.json"]);
    pending := JsonCanonical(build.read_file(pending_path));
    identities := EvidenceToolIdentities(profile, tools);
    if (identities == "" || JsonGet(pending, "format") != "1" ||
        JsonGet(pending, "system") != JsonQuote(build.platform()) ||
        JsonGet(pending, "profile") != EvidenceProfile(profile) || JsonGet(pending, "tools") != EvidenceTools(tools) ||
        JsonGet(pending, "tool_identities") != identities) {
        EvidenceFailure("runtime construction has no matching tool preflight");
        return false;
    }
    if (build.probe([tools.compiler, "--version"]) != 0) {
        EvidenceFailure("cannot inspect the runtime compiler version");
        return false;
    }
    banner := strings.TrimSpace(build.last_stdout());
    if (banner == "" || build.probe([tools.compiler, "-dumpmachine"]) != 0) {
        EvidenceFailure("cannot inspect the runtime compiler default target");
        return false;
    }
    default_target := strings.TrimSpace(build.last_stdout());
    probe := [tools.compiler];
    if (profile.architecture != "") {
        probe.extend(["-arch", profile.architecture]);
    }
    if (profile.sysroot != "") {
        probe.extend(["-isysroot", profile.sysroot]);
    }
    probe.extend(["-dM", "-E", "-x", "c", "/dev/null"]);
    if (default_target == "" || build.probe(probe) != 0) {
        EvidenceFailure("cannot inspect the runtime compiler target layout");
        return false;
    }
    macros := build.last_stdout();
    pointer_bytes := EvidenceNumber(EvidenceDefine(macros, "__SIZEOF_POINTER__"));
    processor := "";
    if (EvidenceDefine(macros, "__aarch64__") != "" || EvidenceDefine(macros, "__arm64__") != "") {
        processor = "arm64";
    }
    if (EvidenceDefine(macros, "__x86_64__") != "") {
        processor = "x86_64";
    }
    order := EvidenceDefine(macros, "__BYTE_ORDER__");
    little := order == "__ORDER_LITTLE_ENDIAN__" ||
              (order != "" && order == EvidenceDefine(macros, "__ORDER_LITTLE_ENDIAN__"));
    if (pointer_bytes != 8 || processor == "" || !little ||
        (profile.architecture != "" && profile.architecture != processor)) {
        EvidenceFailure("unsupported runtime compiler target layout");
        return false;
    }
    configuration := JsonObject([
        "format", "system", "processor", "pointer_bits", "byte_order", "compiler_version",
        "compiler_version_format", "compiler_default_target", "profile", "tools", "tool_identities"
    ], [
        "1", JsonQuote(build.platform()), JsonQuote(processor), "64", JsonQuote("LITTLE_ENDIAN"),
        JsonQuote(banner), JsonQuote("raw-banner"), JsonQuote(default_target), EvidenceProfile(profile),
        EvidenceTools(tools), identities
    ]);
    return configuration != "" && EvidenceToolIdentities(profile, tools) == identities &&
           build.write_file(EvidenceJoin([build_dir, "/sdk/runtime-build.json"]),
                            EvidenceJoin([configuration, "\n"])) && build.remove(pending_path);
}

EvidenceListed :: (values: string[], value: string) -> bool {
    for (candidate in values) {
        if (candidate == value) {
            return true;
        }
    }
    return false;
}

EvidenceStrings :: (values: string[]) -> string {
    encoded: string[] = [];
    for (value in values) {
        encoded.append(JsonQuote(value));
    }
    return JsonArray(encoded);
}

EvidenceArguments :: (encoded: string) -> string[] {
    values: string[] = [];
    if (!strings.HasPrefix(JsonCanonical(encoded), "[")) {
        return values;
    }
    for (value in JsonItems(encoded)) {
        if (!strings.HasPrefix(value, "\"")) {
            return [];
        }
        values.append(JsonText(value));
    }
    return values;
}

// Build and vendor roots can be below the source root, so they come first.
EvidenceRootOrder :: () -> int[] {
    order: int[] = [1, 2, 0];
    return order;
}

EvidenceNormalize :: (roots: string[], value: string) -> string {
    result := value;
    // Build/vendor paths can be below the source root, so substitute them first.
    for (i in EvidenceRootOrder()) {
        if (roots[i] != "") {
            label := "@source";
            if (i == 1) {
                label = "@build";
            }
            if (i == 2) {
                label = "@vendor";
            }
            // Only whole path components: /x/tp must not rewrite /x/tp-build.
            result = build.replace(result, EvidenceJoin([roots[i], "/"]), EvidenceJoin([label, "/"]));
            if (strings.HasSuffix(result, roots[i])) {
                result = EvidenceJoin([strings.Slice(result, 0, strings.ByteLength(result) - strings.ByteLength(roots[i])), label]);
            }
        }
    }
    return result;
}

EvidencePath :: (roots: string[], path: string, checksum: string) -> string {
    for (i in EvidenceRootOrder()) {
        if (roots[i] != "" && strings.HasPrefix(path, EvidenceJoin([roots[i], "/"]))) {
            return EvidenceNormalize(roots, path);
        }
    }
    basename := strings.Slice(path, strings.LastIndex(path, "/") + 1, strings.ByteLength(path));
    return EvidenceJoin(["external/", basename, "-", strings.Slice(checksum, 0, 16)]);
}

EvidenceNormalizedArguments :: (roots: string[], command: string[]) -> string {
    arguments: string[] = [];
    for (argument in command) {
        arguments.append(EvidenceNormalize(roots, argument));
    }
    return EvidenceStrings(arguments);
}

// Roots are [source, build, vendor], each an absolute directory.
EvidenceRootsValid :: (roots: string[]) -> bool {
    if (length(roots) != 3) {
        return false;
    }
    for (root in roots) {
        if (!strings.HasPrefix(root, "/")) {
            return false;
        }
    }
    return true;
}

// Sort before deduplicating shared dependency keys. Different bytes for one
// logical input indicate mutation during collection, never a last-write win.
EvidenceFields :: (fields: JsonField[]) -> string {
    width := 1;
    while (width < length(fields)) {
        sorted: JsonField[] = [];
        start := 0;
        while (start < length(fields)) {
            middle := start + width;
            if (middle > length(fields)) {
                middle = length(fields);
            }
            end := middle + width;
            if (end > length(fields)) {
                end = length(fields);
            }
            left := start;
            right := middle;
            while (left < middle || right < end) {
                if (right >= end || (left < middle && strings.Compare(fields[left].key, fields[right].key) <= 0)) {
                    sorted.append(fields[left]);
                    left += 1;
                } else {
                    sorted.append(fields[right]);
                    right += 1;
                }
            }
            start = end;
        }
        fields = sorted;
        width *= 2;
    }
    keys: string[] = [];
    values: string[] = [];
    for (field in fields) {
        if (length(keys) > 0 && keys[length(keys) - 1] == field.key) {
            if (values[length(values) - 1] != field.value) {
                return EvidenceFailure("a graph input changed during collection");
            }
            continue;
        }
        keys.append(field.key);
        values.append(field.value);
    }
    return JsonObject(keys, values);
}

// The same verifier serves object, archive and executable records. Expected
// inputs come from the depfile or declared graph membership, not the record.
// Roots are [source, build, vendor]; commands and every stamped pair are exact.
pub RecordEvidence :: (roots: string[], command: string[], output: string, inputs: string[]) -> string {
    if (!EvidenceRootsValid(roots) || length(command) == 0 || command[0] == "" ||
        !strings.HasPrefix(output, EvidenceJoin([roots[1], "/"])) || build.file_kind(output) != "file") {
        return EvidenceFailure("invalid graph record output or command");
    }
    for (argument in command) {
        if (strings.Contains(argument, "\n") || strings.Contains(argument, "\r") || strings.Contains(argument, "\u0000")) {
            return EvidenceFailure("graph record commands cannot contain line or NUL separators");
        }
    }
    record := EvidenceJoin([output, ".chibi-record"]);
    if (build.file_kind(record) != "file") {
        return EvidenceFailure("graph record is missing or is not regular data");
    }
    record_stamp := build.file_stamp(record);
    lines := build.lines(build.read_file(record));
    count := length(command);
    if (length(lines) != count + 1 + 2 * (length(inputs) + 1) || lines[count] != "") {
        return EvidenceFailure(EvidenceJoin(["graph record membership differs: ", output]));
    }
    for (i in 0..<count) {
        if (lines[i] != command[i]) {
            return EvidenceFailure(EvidenceJoin(["graph record command differs: ", output]));
        }
    }
    dependencies: JsonField[] = [];
    for (i in 0..length(inputs)) {
        path := output;
        if (i < length(inputs)) {
            path = inputs[i];
        }
        at := count + 1 + 2 * i;
        stamp := build.file_stamp(path);
        resolved := build.resolve_path(path);
        if (path == "" || resolved == "" || build.file_kind(resolved) != "file" || stamp == "" ||
            lines[at] != path || lines[at + 1] != stamp) {
            return EvidenceFailure(EvidenceJoin(["graph record input is missing or stale: ", output]));
        }
        checksum := build.hash_file(path);
        if (checksum == "" || build.file_stamp(path) != stamp) {
            return EvidenceFailure(EvidenceJoin(["graph record input changed while hashing: ", output]));
        }
        if (i < length(inputs)) {
            dependencies.append({key: EvidencePath(roots, path, checksum), value: JsonQuote(checksum)});
        }
    }
    arguments := EvidenceNormalizedArguments(roots, command);
    dependency_map := EvidenceFields(dependencies);
    checksum := build.hash_file(output);
    if (dependency_map == "" || checksum == "") {
        return "";
    }
    if (build.file_stamp(record) != record_stamp) {
        return EvidenceFailure("graph record changed during verification");
    }
    for (i in 0..length(inputs)) {
        if (build.file_stamp(lines[count + 1 + 2 * i]) != lines[count + 2 + 2 * i]) {
            return EvidenceFailure("graph record input changed during verification");
        }
    }
    return JsonObject(["path", "sha256", "arguments", "command_sha256", "dependencies"], [
        JsonQuote(EvidenceNormalize(roots, output)), JsonQuote(checksum), arguments,
        JsonQuote(build.hash_text(arguments)), dependency_map
    ]);
}

EvidenceReadProfile :: (data: string) -> engine.Profile {
    return {
        compiler: JsonText(JsonGet(data, "compiler")), cxx_compiler: JsonText(JsonGet(data, "cxx_compiler")),
        compiler_id: JsonText(JsonGet(data, "compiler_id")), build_type: JsonText(JsonGet(data, "build_type")),
        debug_optimization: JsonText(JsonGet(data, "debug_optimization")),
        debug_frame_pointers: JsonGet(data, "debug_frame_pointers") == "true",
        architecture: JsonText(JsonGet(data, "architecture")), sysroot: JsonText(JsonGet(data, "sysroot")),
        warnings: JsonGet(data, "warnings") == "true", sanitizers: JsonText(JsonGet(data, "sanitizers")),
        debug_compilation_dir: JsonText(JsonGet(data, "debug_compilation_dir")),
        libclang_include: JsonText(JsonGet(data, "libclang_include")),
        opengl_library: JsonText(JsonGet(data, "opengl_library")), opengl_include: JsonText(JsonGet(data, "opengl_include")),
        glx_library: JsonText(JsonGet(data, "glx_library")), libclang_library: JsonText(JsonGet(data, "libclang_library")),
        clang_resource_include: JsonText(JsonGet(data, "clang_resource_include")),
        third_party: JsonText(JsonGet(data, "third_party")), reflect: JsonText(JsonGet(data, "reflect")),
        asset_generator_hosts: JsonText(JsonGet(data, "asset_generator_hosts"))
    };
}

EvidenceReadTools :: (data: string) -> c.Tools {
    return {
        launcher: JsonText(JsonGet(data, "launcher")), compiler: JsonText(JsonGet(data, "compiler")),
        cxx_compiler: JsonText(JsonGet(data, "cxx_compiler")), archiver: JsonText(JsonGet(data, "archiver")),
        ranlib: JsonText(JsonGet(data, "ranlib")), jobs: EvidenceNumber(JsonGet(data, "jobs"))
    };
}

EvidenceNormalizeJSON :: (roots: string[], data: string) -> string {
    if (strings.HasPrefix(data, "\"")) {
        return JsonQuote(EvidenceNormalize(roots, JsonText(data)));
    }
    if (strings.HasPrefix(data, "[")) {
        values: string[] = [];
        for (value in JsonItems(data)) {
            values.append(EvidenceNormalizeJSON(roots, value));
        }
        return JsonArray(values);
    }
    if (strings.HasPrefix(data, "{")) {
        keys: string[] = [];
        values: string[] = [];
        for (field in JsonFields(data)) {
            keys.append(field.key);
            values.append(EvidenceNormalizeJSON(roots, field.value));
        }
        return JsonObject(keys, values);
    }
    return JsonCanonical(data);
}

EvidenceHeaderVersion :: (path: string, name: string) -> string {
    value := EvidenceDefine(build.read_file(path), name);
    if (strings.HasPrefix(value, "UINT64_C(")) {
        value = build.after(value, "UINT64_C(");
    }
    count := 0;
    for (byte in strings.Bytes(value)) {
        if (byte < 48 || byte > 57) {
            break;
        }
        count += 1;
    }
    number := strings.Slice(value, 0, count);
    if (EvidenceNumber(number) < 1) {
        return "";
    }
    return JsonCanonical(number);
}

EvidenceOwner :: (source_root: string, inputs: JsonField[], owner: string,
                  expected_source: string, expected_header: string) -> bool {
    if (JsonGet(owner, "source") != JsonQuote(EvidenceJoin(["src/", expected_source])) ||
        JsonGet(owner, "header") != JsonQuote(EvidenceJoin(["src/", expected_header]))) {
        EvidenceFailure("configured artifact format names an undeclared source owner");
        return false;
    }
    source_hash := build.hash_file(EvidenceJoin([source_root, "/src/", expected_source]));
    header_hash := build.hash_file(EvidenceJoin([source_root, "/src/", expected_header]));
    if (source_hash == "" || header_hash == "" || JsonGet(owner, "sha256") != JsonQuote(source_hash) ||
        JsonGet(owner, "header_sha256") != JsonQuote(header_hash)) {
        EvidenceFailure("configured artifact format differs from its current source owner");
        return false;
    }
    source_found := false;
    header_found := false;
    for (field in inputs) {
        if (field.key == EvidenceJoin(["@source/src/", expected_source])) {
            source_found = field.value == JsonQuote(source_hash);
        }
        if (field.key == EvidenceJoin(["@source/src/", expected_header]) ||
            (strings.HasPrefix(field.key, "@build/") && strings.HasSuffix(field.key, EvidenceJoin(["/", expected_header])))) {
            if (field.value != JsonQuote(header_hash)) {
                EvidenceFailure("compiled artifact format header differs from its configured owner");
                return false;
            }
            header_found = true;
        }
    }
    if (!source_found || !header_found) {
        EvidenceFailure("configured artifact format has no compiled source/header ownership");
        return false;
    }
    return true;
}

EvidenceConfiguredEngine :: (source_root: string, build_dir: string, inputs: string) -> string {
    path := EvidenceJoin([build_dir, "/sdk/chibi_engine_metadata.json"]);
    if (build.file_kind(path) != "file") {
        return EvidenceFailure("runtime build has no configured engine identity");
    }
    document := JsonCanonical(build.read_file(path));
    formats := JsonGet(document, "artifact_formats");
    declarations := engine.ArtifactFormats();
    fields := JsonFields(inputs);
    if (document == "" || length(JsonFields(formats)) != length(declarations) ||
        JsonGet(document, "sdk_version") != JsonQuote(engine.SDKVersion(source_root)) ||
        JsonGet(document, "project_version") != EvidenceHeaderVersion(EvidenceJoin([source_root, "/src/assets/project.h"]),
                                                                      "CHIBI_PROJECT_VERSION")) {
        return EvidenceFailure("configured engine version or artifact format inventory differs");
    }
    for (declaration in declarations) {
        parts := strings.Fields(declaration);
        owner := JsonGet(formats, parts[0]);
        if (!EvidenceOwner(source_root, fields, owner, parts[1], parts[2]) ||
            JsonGet(owner, "version") != EvidenceHeaderVersion(EvidenceJoin([source_root, "/src/", parts[2]]), parts[3])) {
            return EvidenceFailure("configured artifact version differs from compiled ownership");
        }
        wire := EvidenceListed(parts, "VALUE_WIRE");
        if ((wire && !EvidenceOwner(source_root, fields, JsonGet(owner, "codec"), "types/value_wire.c", "types/value_wire.h")) ||
            (!wire && JsonGet(owner, "codec") != "")) {
            return EvidenceFailure("configured artifact codec ownership differs");
        }
        codecs := EvidenceListed(parts, "EXECUTION_CODECS");
        implementations := JsonItems(JsonGet(owner, "implementation"));
        if ((codecs && length(implementations) != 2) || (!codecs && JsonGet(owner, "implementation") != "")) {
            return EvidenceFailure("configured execution codec inventory differs");
        }
        if (codecs) {
            sources := ["execution/prepared_function.c", "execution/prepared_record.c"];
            for (i in 0..<2) {
                implementation := implementations[i];
                key := EvidenceJoin(["@source/src/", sources[i]]);
                found := false;
                for (field in fields) {
                    if (field.key == key) {
                        found = field.value == JsonGet(implementation, "sha256");
                        break;
                    }
                }
                if (!found || JsonGet(implementation, "source") != JsonQuote(EvidenceJoin(["src/", sources[i]]))) {
                    return EvidenceFailure("configured execution codec has no compiled owner");
                }
            }
        }
    }
    return JsonObject(["document", "sha256", "sdk_version", "project_version", "artifact_formats"], [
        document, JsonQuote(build.hash_file(path)), JsonGet(document, "sdk_version"),
        JsonGet(document, "project_version"), formats
    ]);
}

EvidenceArtifact :: (record: string) -> string {
    return JsonObject(["path", "sha256", "arguments", "link_command_sha256", "link_inputs"], [
        JsonGet(record, "path"), JsonGet(record, "sha256"), JsonGet(record, "arguments"),
        JsonGet(record, "command_sha256"), JsonGet(record, "dependencies")
    ]);
}

// Public package evidence includes only the runtime graph and its player.
// Compilation/link databases are compared with independently declared commands;
// records cannot nominate extra targets, objects, dependencies or products.
pub GraphEvidence :: (source_root: string, build_dir: string, third_party: string) -> string {
    roots := [source_root, build_dir, third_party];
    configuration_path := EvidenceJoin([build_dir, "/sdk/runtime-build.json"]);
    if (!Supported(build.platform()) || !strings.HasPrefix(source_root, "/") ||
        !strings.HasPrefix(build_dir, "/") || !strings.HasPrefix(third_party, "/") ||
        build.file_kind(configuration_path) != "file" ||
        build.file_kind(EvidenceJoin([build_dir, "/sdk/runtime-build-pending.json"])) != "") {
        return EvidenceFailure("runtime build is unsupported, incomplete or has no successful configuration");
    }
    configuration_stamp := build.file_stamp(configuration_path);
    configuration := JsonCanonical(build.read_file(configuration_path));
    profile_data := JsonGet(configuration, "profile");
    tools_data := JsonGet(configuration, "tools");
    profile := EvidenceReadProfile(profile_data);
    tools := EvidenceReadTools(tools_data);
    if (JsonGet(configuration, "format") != "1" || JsonGet(configuration, "system") != JsonQuote(build.platform()) ||
        JsonGet(configuration, "pointer_bits") != "64" || JsonGet(configuration, "byte_order") != JsonQuote("LITTLE_ENDIAN") ||
        !EvidenceListed(["arm64", "x86_64"], JsonText(JsonGet(configuration, "processor"))) ||
        JsonGet(configuration, "compiler_version_format") != JsonQuote("raw-banner") ||
        JsonText(JsonGet(configuration, "compiler_version")) == "" ||
        JsonText(JsonGet(configuration, "compiler_default_target")) == "" ||
        EvidenceProfile(profile) != profile_data || EvidenceTools(tools) != tools_data ||
        profile.third_party != third_party || tools.jobs < 1 || tools.compiler == "" ||
        JsonGet(configuration, "tool_identities") != EvidenceToolIdentities(profile, tools)) {
        return EvidenceFailure("runtime configuration or tool identity is missing or stale");
    }
    targets := EvidenceTargets();
    compile_path := EvidenceJoin([build_dir, "/compile_commands.json"]);
    link_path := EvidenceJoin([build_dir, "/link_commands.json"]);
    if (build.file_kind(compile_path) != "file" || build.file_kind(link_path) != "file") {
        return EvidenceFailure("runtime build has no compile/link command databases");
    }
    compile_stamp := build.file_stamp(compile_path);
    link_stamp := build.file_stamp(link_path);
    actual_compile := JsonCanonical(build.read_file(compile_path));
    actual_link := JsonCanonical(build.read_file(link_path));
    expected_compile := JsonCanonical(engine.CompileCommands(tools, profile, source_root, build_dir, targets));
    expected_link := JsonCanonical(engine.LinkCommands(tools, profile, source_root, build_dir, targets));
    if (actual_compile == "" || actual_compile != expected_compile || actual_link == "" || actual_link != expected_link) {
        return EvidenceFailure("runtime compile/link databases differ from the declared graph");
    }
    entries := JsonItems(actual_compile);
    object_fields: JsonField[] = [];
    input_fields: JsonField[] = [];
    artifact_fields: JsonField[] = [];
    archive_fields: JsonField[] = [];
    archive_target_fields: JsonField[] = [];
    archive_object_fields: JsonField[] = [];
    entry_index := 0;
    for (target in targets) {
        built := engine.Library(source_root, build_dir, third_party, target);
        sources := engine.Sources(source_root, build_dir, third_party, target);
        objects: string[] = [];
        for (source in sources) {
            if (entry_index >= length(entries)) {
                return EvidenceFailure("runtime graph source membership is incomplete");
            }
            command := EvidenceArguments(JsonGet(entries[entry_index], "arguments"));
            output := c.Object(built, source);
            if (JsonGet(entries[entry_index], "file") != JsonQuote(source) ||
                JsonGet(entries[entry_index], "output") != JsonQuote(output) ||
                JsonGet(entries[entry_index], "directory") != JsonQuote(source_root) ||
                build.file_kind(EvidenceJoin([output, ".d"])) != "file") {
                return EvidenceFailure("runtime graph object has no declared source or dependency file");
            }
            dependencies := c.Dependencies(build.read_file(EvidenceJoin([output, ".d"])));
            if (!EvidenceListed(dependencies, source)) {
                return EvidenceFailure("runtime object dependencies omit its source");
            }
            record := RecordEvidence(roots, command, output, dependencies);
            if (record == "") {
                return "";
            }
            dependency_fields := JsonFields(JsonGet(record, "dependencies"));
            input_fields.extend(dependency_fields);
            dependency_paths: string[] = [];
            for (field in dependency_fields) {
                dependency_paths.append(field.key);
            }
            owner := EvidenceNormalize(roots, built.output);
            if (target == "chibi-player") {
                owner = EvidenceNormalize(roots, engine.Executable(build_dir, target));
            }
            object_fields.append({key: EvidenceNormalize(roots, output), value: JsonObject([
                "target", "sha256", "arguments", "command_sha256", "dependencies", "artifacts"
            ], [JsonQuote(target), JsonGet(record, "sha256"), JsonGet(record, "arguments"),
                JsonGet(record, "command_sha256"), EvidenceStrings(dependency_paths), EvidenceStrings([owner])])});
            objects.append(output);
            entry_index += 1;
        }
        if (length(objects) == 0 || target == "chibi-player") {
            continue;
        }
        if (engine.Program(target) || engine.ObjectLibrary(target)) {
            return EvidenceFailure("runtime export has an unsupported artifact owner");
        }
        archive_command := [tools.archiver, "qc", built.output];
        archive_command.extend(objects);
        record := RecordEvidence(roots, archive_command, built.output, objects);
        if (record == "") {
            return "";
        }
        key := EvidenceNormalize(roots, built.output);
        artifact_fields.append({key: key, value: EvidenceArtifact(record)});
        archive_fields.append({key: key, value: JsonGet(record, "sha256")});
        archive_target_fields.append({key: key, value: JsonQuote(target)});
        normalized_objects: string[] = [];
        for (path in objects) {
            normalized_objects.append(EvidenceNormalize(roots, path));
        }
        archive_object_fields.append({key: key, value: EvidenceStrings(normalized_objects)});
        input_fields.extend(JsonFields(JsonGet(record, "dependencies")));
    }
    if (entry_index != length(entries)) {
        return EvidenceFailure("runtime compile database has undeclared objects");
    }
    links := JsonItems(actual_link);
    player := engine.Executable(build_dir, "chibi-player");
    if (length(links) != 1 || JsonGet(links[0], "output") != JsonQuote(player)) {
        return EvidenceFailure("runtime link database must contain exactly the standalone player");
    }
    command := EvidenceArguments(JsonGet(links[0], "arguments"));
    link_inputs: string[] = [];
    object_owners := engine.LinkedObjects("chibi-player");
    object_owners.append("chibi-player");
    for (owner in object_owners) {
        if (!EvidenceListed(targets, owner)) {
            return EvidenceFailure("player links an undeclared object owner");
        }
        built := engine.Library(source_root, build_dir, third_party, owner);
        for (source in engine.Sources(source_root, build_dir, third_party, owner)) {
            link_inputs.append(c.Object(built, source));
        }
    }
    output_at := -1;
    for (i in 1..<length(command)) {
        if (command[i] == "-o") {
            output_at = i;
            break;
        }
    }
    if (output_at < 1 || output_at + 1 >= length(command) || command[output_at + 1] != player) {
        return EvidenceFailure("player link command has no declared output");
    }
    for (i in output_at + 2..<length(command)) {
        if (strings.HasPrefix(command[i], "/")) {
            link_inputs.append(command[i]);
        }
    }
    player_record := RecordEvidence(roots, command, player, link_inputs);
    if (player_record == "") {
        return "";
    }
    player_evidence := EvidenceArtifact(player_record);
    artifact_fields.append({key: EvidenceNormalize(roots, player), value: player_evidence});
    input_fields.extend(JsonFields(JsonGet(player_record, "dependencies")));
    inputs := EvidenceFields(input_fields);
    configured := EvidenceConfiguredEngine(source_root, build_dir, inputs);
    if (inputs == "" || configured == "" || build.file_stamp(configuration_path) != configuration_stamp ||
        build.file_stamp(compile_path) != compile_stamp || build.file_stamp(link_path) != link_stamp ||
        JsonGet(configuration, "tool_identities") != EvidenceToolIdentities(profile, tools)) {
        return EvidenceFailure("runtime inputs changed while collecting package evidence");
    }
    return JsonObject(["graph_format", "runtime_build", "configured_engine", "inputs", "objects", "archives",
                       "archive_targets", "archive_objects", "artifacts", "executables"], [
                           "1", EvidenceNormalizeJSON(roots, configuration), configured, inputs, EvidenceFields(object_fields),
                           EvidenceFields(archive_fields), EvidenceFields(archive_target_fields), EvidenceFields(archive_object_fields),
                           EvidenceFields(artifact_fields), JsonObject(["chibi-player"], [player_evidence])
                       ]);
}
