package engine

import os "core:os"

// Native SDK products and explicit-only, test-owned generic C graph fixtures.
pub Targets :: () -> string[] {
    return ["chibi", "chibi-asset-compiler", "chibi_asset_compiler_host", "chibi_graph_fixture", "graph_headerless"];
}

Files :: (target: string) -> string[] {
    if (target == "chibi_graph_fixture") {
        return ["test/graph/fixtures/archive/first.c", "test/graph/fixtures/archive/second.c", "test/graph/fixtures/archive/third.c"];
    }
    if (target == "graph_headerless") { return ["test/graph/fixtures/headerless.c"]; }
    return [];
}

pub HeaderSource :: (target: string) -> string {
    if (target == "chibi_graph_fixture") { return "test/graph/fixtures/include"; }
    return "src";
}
pub PublicHeaders :: (target: string) -> string[] {
    if (target == "chibi_graph_fixture") { return ["graph_fixture/fixture.h"]; }
    if (target == "chibi_asset_compiler_host") { return ["authoring/asset_compiler_host.h"]; }
    return [];
}
pub Includes :: (target: string) -> string[] {
    if (target == "chibi_graph_fixture") { return ["public/graph_fixture"]; }
    return [];
}
pub Options :: (target: string) -> string[] {
    if (target == "graph_headerless") { return ["-UNDEBUG"]; }
    return [];
}
pub ProgramDirectory :: (target: string) -> string {
    if (length(NativeArguments(target)) != 0) { return "sdk"; }
    if (target == "graph_headerless") { return "test/graph"; }
    return "";
}
pub Programs :: () -> string[] {
    programs := NativeProducts();
    programs.append("graph_headerless");
    return programs;
}
pub Runs :: (target: string) -> string[] {
    if (target == "chibi-asset-compiler") { return ["chibi"]; }
    if (target == "chibi_asset_compiler_host") { return ["chibi-asset-compiler"]; }
    return [];
}

pub PrivateHeaders :: (target: string) -> string[] { return []; }
pub PrivateDirectory :: (target: string) -> string { return ""; }
pub DirectorySet :: (include: string) -> string { return ""; }
pub Rewrites :: (target: string) -> string[] { return []; }
pub Renames :: (target: string) -> string[] { return []; }
pub SystemIncludes :: (target: string) -> string[] { return []; }
pub Defines :: (target: string) -> string[] { return []; }
pub SourceOptions :: (target: string, file: string) -> string[] { return []; }
pub SourceDefines :: (target: string, file: string) -> string[] { return []; }
pub SourceIncludes :: (target: string, file: string) -> string[] { return []; }
pub CxxStandard :: (target: string) -> string { return ""; }
pub ExportName :: (target: string) -> string { return ""; }
pub Configures :: (target: string) -> string[] { return []; }
pub Substitutions :: (target: string) -> string[] { return []; }
pub SourceLists :: (target: string) -> string[] { return []; }
pub LinksCxx :: (target: string) -> bool { return false; }
pub ObjectLibrary :: (target: string) -> bool { return false; }
pub LinkedObjects :: (target: string) -> string[] { return []; }
pub LinkOptions :: (target: string) -> string[] { return []; }
pub Links :: (target: string) -> string[] { return []; }
pub ExportTarget :: (component: string) -> string { return Join(["chibi_", component]); }

pub Resources :: (target: string) -> string[] {
    if (target == "chibi") {
        resources := [
            "build/share/chibi/engine.json=build/sdk/chibi_engine_metadata.json",
            "build/share/chibi/compiler=tools/compiler",
            "build/share/chibi/apps/host=apps/host",
            "build/share/chibi/core=packages/core",
            "build/share/chibi/graph=tools/graph",
            "build/share/chibi/tools/toolchain=tools/toolchain"
        ];
        if (os.Platform() == "Darwin" || os.Platform() == "Linux") {
            resources.append("build/lib/chibi-vendor/libchibi_vendor_freetype.a=third-party/lib/chibi-vendor/libchibi_vendor_freetype.a");
        }
        return resources;
    }
    return [];
}
