            "authoring/source_package_exports.h", "authoring/source_package_files.h", "authoring/source_package_io.h",
            "authoring/source_package_prepare.h", "authoring/source_package_snapshot.h",
            "authoring/source_packages.h", "authoring/source_prototype_edit.h"
        ];
    }
    if (target == "chibi_platform") {
        return ["platform/cute.h", "support/resources.h"];
    }
    if (target == "chibi_model_import") {
        return ["assets/model_import.h", "assets/standard_material.h"];
    }
    if (target == "chibi_project_compilation") {
        return [
            "authoring/component_declarations.h", "authoring/material_prepare.h",
            "authoring/project_compile.h", "authoring/project_open.h", "authoring/project_prepare.h",
            "authoring/prototype_prepare.h", "authoring/renderer_catalog.h", "authoring/scene_prepare.h",
            "authoring/sound_prepare.h", "authoring/source_graph_library.h", "authoring/source_costs.h"
        ];
    }
    if (target == "chibi_project_format") {
        return ["authoring/project_format.h"];
    }
    if (target == "chibi_project_preparation") {
        return [
            "authoring/application_catalog.h", "authoring/behavior_loader.h", "authoring/engine_preview.h",
            "authoring/preview.h", "authoring/preview_runtime.h", "authoring/preview_source.h",
            "authoring/prototype_preview.h", "authoring/render_preview.h", "authoring/source_apply.h",
            "authoring/studio_project.h", "authoring/ui_check.h", "authoring/ui_events_adapter.h",
            "authoring/ui_loader.h"
        ];
    }
    if (target == "chibi_ui_host") {
        return [
            "support/number_expr.h", "support/ui_style.h", "ui/autofocus.h", "ui/controls/controls.h", "ui/drag.h",
            "ui/focus_within.h", "ui/iframe.h", "ui/iframe_profile.h", "ui/input_feel.h", "ui/json_items.h",
            "ui/list.h", "ui/motion.h", "ui/popover.h", "ui/rml.h", "ui/rml_backend.h", "ui/rml_gpu.h"
        ];
    }
    if (target == "chibi_renderer") {
        // Every header in src/render, as sdk/desktop.cmake globs them, but
        // the catalog's, which chibi_visual_catalog publishes.
        excluded := [
            "render/shader_catalog_internal.h", "render/scene3d_parts.h", "render/scene3d_parts_table.h",
            "render/catalog_publication.h", "render/shader_catalog.h", "render/shader_catalog_records.h",
            "render/shader_values.h", "render/shader_parameters.h"
        ];
        headers: string[] = [];
        for (header in HeadersIn("render")) {
            if (!Listed(excluded, header)) {
                headers.append(header);
            }
        }
        headers.extend(["support/file_watch.h", "runtime/camera.h"]);
        return headers;
    }
    return [];
}

// The headers only a target's own sources include, below src/. A name that is
// no target, such as chibi_physics, is a private/NAME directory several
// libraries share, which CMake stages for none of them alone.
pub PrivateHeaders :: (target: string) -> string[] {
    if (target == "chibi_asset_compiler_host") {
        return ["authoring/asset_compiler_host_internal.h", "support/binary_cache.h", "support/sha256.h"];
    }
    if (target == "chibi_types") {
        return ["types/array_internal.h", "types/copy_internal.h"];
    }
    if (target == "chibi_asset_values") {
        return ["support/float_text.h"];
    }
    if (target == "chibi_ecs") {
        return ["ecs/ecs_internal.h"];
    }
    if (target == "chibi_shader_runtime") {
        return ["runtime/shaders/prepared_internal.h"];
    }
    if (target == "chibi_model_runtime") {
        return [
            "runtime/models/model_bounds.h", "runtime/models/model_program_internal.h",
            "runtime/shaders/prepared_internal.h"
        ];
    }
    if (target == "chibi_native_capabilities") {
        return ["capabilities/catalog_index.h"];
    }
    if (target == "chibi_asset_text") {
        return ["support/float_text.h"];
    }
    if (target == "chibi_execution") {
        // Every header beside its sources, as sdk/execution.cmake globs them.
        return HeadersIn("execution");
    }
    if (target == "chibi_visual_catalog") {
        return ["render/shader_catalog_internal.h"];
    }
    if (target == "chibi_ui_authoring") {
        return ["assets/ui_source_internal.h"];
    }
    if (target == "chibi_material_runtime") {
        return [
            "diagnostics/tracy.h", "diagnostics/web_trace.h", "runtime/material_ecs.h",
            "runtime/material_flow.h", "runtime/material_mpm.h", "runtime/material_obstacle_index.h",
            "runtime/material_particle_index.h", "support/cos_sin.h", "support/exponential.h"
        ];
    }
    if (target == "chibi_studio_graph") {
        return ["graph/model/native_definition.h"];
    }
    if (target == "chibi_engine") {
        return ["diagnostics/tracy.h", "diagnostics/web_trace.h", "support/cos_sin.h"];
    }
    if (target == "chibi_physics") {
        // Shared by the task pool and physics runtimes, as CMake stages them.
        return ["diagnostics/tracy.h", "diagnostics/web_trace.h"];
    }
    if (target == "chibi_graph") {
        // Shared by the graph model, authoring and compilation libraries.
        return [
            "graph/document/serialize_internal.h", "graph/modeling/model_numeric.h",
            "graph/modeling/model_expand_internal.h", "graph/modeling/model_internal.h",
            "graph/modeling/model_expand.h", "graph/authoring/optimize_internal.h",
            "graph/authoring/arrange_internal.h", "graph/model/native_definition.h",
            "graph/model/graph_internal.h", "graph/compiler/structure_internal.h",
            "runtime/models/model_bounds.h", "runtime/models/model_program_internal.h"
        ];
    }
    if (target == "chibi_authoring") {
        return ["authoring/source_prepare_internal.h"];
    }
    if (target == "chibi_source_presentation") {
        return [
            "authoring/source_edit_internal.h", "authoring/source_edit_refactor_internal.h",
            "authoring/source_presentation_anchors.h", "authoring/source_presentation_details.h",
            "authoring/source_presentation_internal.h"
        ];
    }
    if (target == "chibi_player") {
        return ["host/player_clock.h", "host/player_url.h", "host/native_libraries.h", "host/stack_overflow.h"];
    }
    if (target == "chibi_source_catalog") {
        return [
            "authoring/source_catalog_snapshot.h", "authoring/source_package_paths.h",
            "authoring/source_package_routes.h", "authoring/source_package_syntax.h",
            "authoring/source_prepare_internal.h", "capabilities/catalog_index.h"
        ];
    }
    if (target == "chibi_language") {
        return [
            "language/callable_headers.h", "language/constant_proof.h",
            "language/effect_analysis.h", "language/lexical_binding.h", "language/named_binding.h",
            "language/nominal_binding.h", "language/numeric.h", "language/record_members.h",
            "language/scalar_constant.h",
            "language/semantic_internal.h", "language/signature_reader.h",
            "language/type_constructors.h", "language/union_members.h", "language/unit_algebra.h",
            "language/unit_analysis.h"
        ];
    }
    if (target == "chibi_platform") {
        return ["assets/project.h"];
    }
    if (target == "chibi_project_compilation") {
        return [
            "authoring/graph_sources.h", "authoring/native_graph_prepare.h",
            "authoring/project_prepare_internal.h", "authoring/ui_prepare.h", "toolchain/compiler_json.h",
            "toolchain/compiler_syntax.h", "authoring/asset_compiler_host_internal.h"
        ];
    }
    if (target == "chibi_project_preparation") {
        return [
            "authoring/graph_loader_internal.h", "authoring/graph_sources.h",
            "authoring/preview_source_internal.h"
        ];
    }
    if (target == "chibi_ui_host") {
        return ["ui/controls/controls_internal.h", "support/math.h", "diagnostics/tracy.h"];
    }
    if (target == "chibi_renderer") {
        return ["diagnostics/tracy.h", "support/math.h"];
    }
    if (target == "chibi_build-host") {
        // The build host's private headers, which its object library and
        // executable share.
        return [
            "host/build_host.h", "host/build_host_internal.h", "host/build_timing.h", "host/build_io.h", "host/build_values.h",
            "host/process.h", "support/sha256.h", "authoring/source_package_io.h"
        ];
    }
    if (target == "chibi_compiler-host") {
        return [
            "support/sha256.h", "toolchain/compiler_artifact.h", "toolchain/compiler_bootstrap.h",
            "toolchain/compiler_host.h", "toolchain/compiler_json.h", "toolchain/compiler_syntax.h",
            "toolchain/compiler_target.h"
        ];
    }
    if (target == "chibi_launcher") {
        return ["host/export.h", "host/process.h", "host/serve.h"];
    }
    if (target == "chibi_compiler-syntax") {
        return ["toolchain/compiler_syntax.h"];
    }
    if (target == "chibi_compiler-json") {
        return ["toolchain/compiler_json.h"];
    }
    if (target == "chibi_compiler-target") {
        return ["toolchain/compiler_artifact.h", "toolchain/compiler_target.h"];
    }
    if (target == "chibi_ctl_private") {
        // chibi_ctl's and the automation library's, which tools/chibi_ctl
        // stages in its own binary directory.
        return [
            "automation/content_hash.h", "automation/controller.h", "automation/execution_policy.h",
            "automation/field_preview.h", "automation/gpu_capture.h", "automation/material_bake.h",
            "automation/navigation.h", "automation/render_preview.h", "automation/ui_inspect.h",
            "diagnostics/tracy.h", "diagnostics/web_trace.h", "support/execution_policy.h"
        ];
    }
    if (target == "chibi_host_tests") {
        // The headers the host tests include, as root CMakeLists.txt stages
        // them below its binary directory.
        return ["host/export.h", "host/process.h", "host/state_file.h", "support/array.h", "support/xalloc.h"];
    }
    return [];
}

// The headers in src/DIRECTORY, as paths below src/.
HeadersIn :: (directory: string) -> string[] {
    headers: string[] = [];
    for (name in build.list_directory(Join([build.root(), "/src/", directory]))) {
        if (strings.HasSuffix(name, ".h")) {
            headers.append(Join([directory, "/", name]));
        }
    }
    return headers;
}

// Where a target's private headers are staged, when not below
// BUILD/sdk/private: the language's sit in its CMake subdirectory's binary
// directory.
pub PrivateDirectory :: (target: string) -> string {
    if (target == "chibi_language") {
        return "build/sdk/language/private";
    }
    if (target == "chibi_ctl_private") {
        return "build/tools/chibi_ctl/private";
    }
    if (target == "chibi_host_tests") {
        return "build/testing/host/include";
    }
    if (target == "chibi_language_testing") {
        return "build/test/language/testing/include";
    }
    if (target == "chibi_tools_testing") {
        return "build/test/tools/testing/include";
    }
    return "";
}

// The tooling tests' SDK contract consumers, object libraries that compile
// against staged SDK headers and pico_unit alone, as test/tools/CMakeLists.txt
// declares them, so a header that leaks a private include fails here.
ToolConsumers :: () -> string[] {
    return [
        "chibi_sdk_contracts", "chibi_prepared_consumer", "chibi_record_consumer",
        "chibi_scene_consumer", "chibi_shader_bake_consumer", "chibi_scene_authoring_consumer",
        "chibi_scene_snapshot_read_consumer", "chibi_native_consumer", "chibi_asset_values_consumer",
        "chibi_ui_document_consumer", "chibi_particle_consumer", "chibi_png_consumer",
        "chibi_project_document_consumer", "chibi_project_declarations_consumer",
        "chibi_render_consumer", "chibi_image_preparation_consumer", "chibi_mesh_preparation_consumer",
        "chibi_model_import_consumer", "chibi_source_runtime_consumer",
        "chibi_source_features_consumer", "chibi_graph_consumer"
    ];
}

// The header set staged in a `build/` include directory, or empty.
pub DirectorySet :: (include: string) -> string {
    if (include == "build/tools/chibi_ctl/private") {
        return "chibi_ctl_private";
    }
    if (include == "build/testing/host/include") {
        return "chibi_host_tests";
    }
    if (include == "build/test/language/testing/include") {
        return "chibi_language_testing";
    }
    if (include == "build/test/tools/testing/include") {
        return "chibi_tools_testing";
    }
    return "";
}

// Private headers a step writes rather than copies, `HEADER=INPUT`: INPUT
// with each of Renames' pairs replaced in turn, as sdk/images.cmake gives
// Cute's codecs private symbols.
pub Rewrites :: (target: string) -> string[] {
    if (target == "chibi_sound_preparation") {
        // The players' Vorbis decoder, as sdk/project_preparation.cmake writes it.
        return ["vendor/sound_vorbis.h=third-party/source/cute_framework/libraries/stb/stb_vorbis.c"];
    }
    if (target == "chibi_host_tests") {
        return ["third_party/pico_headers/pico_unit.h=third_party/pico_headers/pico_unit.h"];
    }
    if (target == "chibi_renderer") {
        // A plain copy: the one private header from outside src/.
        return ["third_party/yyjson/yyjson.h=third_party/yyjson/yyjson.h"];
    }
    if (target == "chibi_image_preparation") {
        return [
            "vendor/image_png.h=third-party/source/cute_framework/libraries/cute/cute_png.h",
            "vendor/image_jpg.h=third-party/source/cute_framework/libraries/cute/cute_jpg.h"
        ];
    }
    return [];
}
pub Renames :: (target: string) -> string[] {
    if (target == "chibi_sound_preparation") {
        return ["stb_vorbis_=chibi_sound_vorbis_"];
    }
    if (target == "chibi_image_preparation") {
        return ["cp_=chibi_image_cp_", "cj_=chibi_image_cj_", "CP_CRC_TABLE=chibi_image_cp_crc_table"];
    }
    return [];
}

// A target's include directories in CMake's order: public/NAME and
// private/NAME are the staged headers of the library chibi_NAME; any other
// path is below the source root, or below the third-party archive for
// `third-party/`.
pub Includes :: (target: string) -> string[] {
    if (target == "chibi_asset_compiler_consumer") {
        return ["build/test/language/testing/include", "public/asset_compiler_host", "public/asset_values",
                "public/support", "public/behavior_runtime", "public/execution", "public/types",
                "public/execution_contract", "public/capabilities", "public/ecs", "public/tasks", "public/events",
                "public/scene_document", "public/scene_runtime", "public/prototype_document"];
