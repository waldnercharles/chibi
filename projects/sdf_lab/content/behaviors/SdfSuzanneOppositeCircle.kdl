                }
            }
            - {
                id 187
                type "Behavior Expression"
                reference_name "y = -60 * sin(elapsed * (2 * pi / 8))"
                inputs {
                    Exec id=191 kind="exec"
                    y {
                        id 188
                        type "float"
                        binding kind="component_field" component="GAME.GameTransform" field="y"
                    }
                    elapsed {
                        id 189
                        type "double"
                        binding kind="variable" source_asset="SdfSuzanneOppositeCircle" name="elapsed"
                    }
                }
                outputs {
                    Then id=192 kind="exec"
                    Result id=190 type="float"
                }
            }
        }
        (array)edges {
            - from="2.Then" to="17.Exec"
            - from="17.Then" to="82.Exec"
            - from="82.Then" to="187.Exec"
