version 1
name "ModelTransformNoRelief"
(array)entities {
    - {
        name "Camera"
        prototype "StudyCamera"
        components {
            GameCamera width=540.0 height=370.0
            GameHRC2D surface_relief=0.0
        }
    }
    - {
        name "Key light"
        prototype "StudyLight"
        components {
            GameTransform x=-200.0 y=-100.0
        }
    }
    - {
        name "Fill light"
        prototype "StudyLight"
        components {
            GameTransform x=200.0 y=30.0
            GameMaterial emission_color=0x9dd4ffff
        }
    }
    - {
        name "AsymmetricRotation"
        prototype "AsymmetricRotation"
        components {
            GameTransform x=-145.0 y=-60.0
        }
    }
    - {
        name "MirroredPart"
        prototype "MirroredPart"
        components {
            GameTransform x=0.0 y=-60.0
        }
    }
    - {
        name "ScaledPart"
        prototype "ScaledPart"
        components {
            GameTransform x=145.0 y=-60.0
        }
    }
    - {
        name "OffsetSphere"
        prototype "OffsetSphere"
        components {
            GameTransform x=-145.0 y=50.0
        }
    }
    - {
        name "ScaledSmoothJoin"
        prototype "ScaledSmoothJoin"
        components {
            GameTransform x=0.0 y=50.0
        }
    }
    - {
        name "Capsule"
        prototype "Capsule"
        components {
            GameTransform x=145.0 y=50.0
        }
    }
}
