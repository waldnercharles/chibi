package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Target")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Appearance", data.Object([
                    data.Field.Named("border_color", data.Value.UInt(1927992490)),
                    data.Field.Named("border_width", data.Value.Real(1.0)),
                    data.Field.Named("color", data.Value.UInt(4294967040)),
                    data.Field.Named("height", data.Value.Real(48.0)),
                    data.Field.Named("layer", data.Value.UInt(4)),
                    data.Field.Named("shape", data.Value.Text("Circle")),
                    data.Field.Named("width", data.Value.Real(48.0))
                ])),
                data.Field.Named("GlobalBinding", data.Object([
                    data.Field.Named("name", data.Value.Text("DigTarget"))
                ])),
                data.Field.Named("Transform", data.Object([]))
            ]))
        ])
    );
}
