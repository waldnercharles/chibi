/* Studio workspace (the kit's studio.rml), ported from
   docs/prototypes/studio/studio.css. Areas are Blender-style splits, each with
   a header and an editor type. */

body.studio { width: 100%; height: 100%; margin: 0dp; padding: 0dp; background-color: var(--app); overflow: hidden; }

#app { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; flex-direction: column; }

/* The top bar is projects/studio's TopBar, and each area's header its
   AreaHeader. A modified document's dot, as the Text Editor shows it. */
.dirty-dot { width: 6dp; height: 6dp; border-radius: 3dp; background-color: var(--muted-foreground); }

/* Workspace and areas. */
.workspace { flex: 1 1 0dp; display: flex; padding: 2dp; }
.column { display: flex; flex-direction: column; }
.column.main { flex: 1 1 0dp; }
/* The top and bottom areas: stacked vertically or arranged side by side. */
.main-editors { display: flex; flex-direction: column; flex: 1 1 0dp; min-width: 0dp; min-height: 0dp; }
.main-editors.across { flex-direction: row; }
/* The side column keeps the width it eases to, clipping while it closes. */
.column.side { flex: 0 0 auto; overflow: hidden; }
.area { position: relative; display: flex; flex-direction: column; background-color: var(--background); border-radius: var(--r-lg); overflow: hidden; }
.area.fill { flex: 1 1 0dp; }
/* Editors' controls in their area's header. */
.area-head .menu-btn { color: var(--foreground); padding: 0dp 6dp; }
/* Breadcrumbs (studio_graph_nav.c): the behavior, the calls entered and the open graph. */
.area-head .crumbs { display: flex; align-items: center; gap: 2dp; color: var(--muted-foreground); white-space: nowrap; overflow: hidden; flex: 0 1 auto; min-width: 0dp; }
.area-head .crumbs .crumb { padding: 0dp 4dp; color: var(--muted-foreground); flex: 0 1 auto; min-width: 0dp; }
.area-head .crumbs .crumb.current { color: var(--foreground); }
.area-head .crumbs .crumb-sep { color: var(--disabled-foreground); font-size: var(--studio-font-10, 10dp); width: 10dp; flex: 0 0 auto; }
.area-body { flex: 1 1 0dp; position: relative; overflow: hidden; }
.area-panel { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; overflow-y: auto; padding: 8dp; }

/* Splitters: 4 dp hit area. */
.split-v { width: 4dp; flex: 0 0 auto; cursor: ew-resize; drag: drag; }
.split-h { height: 4dp; flex: 0 0 auto; cursor: ns-resize; drag: drag; }
.split-v:hover, .split-v[data-dragging], .split-h:hover, .split-h[data-dragging] { background-color: var(--primary-wash); }

/* Drawer: the collapsible bottom area of the main column. */
.area.drawer:not(.fill) { flex: 0 0 auto; }

/* Scene viewport. */
.viewport { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; background-color: var(--viewport); }
/* The scene renders on a dark canvas in every theme; its chrome keeps dark roles. */
body:not(.dark) .viewport {
    --foreground: #e8edf5; --muted-foreground: #aeb9ca; --faint-foreground: #aeb9ca; --line: #ffffff10; --accent: #ffffff0f; --press: #ffffff1a;
    --floating: #282c33ee; --primary-text: #9dbef5; --notice: #1a1612f0; --notice-fg: #ffad66;
}
.viewport .surface { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; }
.viewport .toolshelf { position: absolute; left: 8dp; top: 8dp; display: flex; flex-direction: column; gap: 2dp; padding: 3dp; background-color: var(--floating); border: 1dp var(--line); border-radius: var(--r-lg); }
.viewport .toolshelf .btn { width: 28dp; height: 28dp; padding: 0dp; }
.viewport .toolshelf .btn .icon { font-size: 15dp; width: 18dp; }
.viewport .toolshelf .btn[data-state=on] { background-color: var(--primary); }
.viewport .toolshelf .btn[data-state=on] .icon { color: var(--primary-foreground); }
.viewport .view-label { position: absolute; left: 50dp; bottom: 10dp; color: var(--foreground); font-size: var(--studio-font-11, 11dp); pointer-events: none; }
.viewport .view-label .dim { display: block; }
/* They leave the game's view to its HUD while a session runs. */
.viewport .toolshelf, .viewport .view-label { opacity: 1; transition: opacity 0.14s cubic-out; }
.viewport .toolshelf[data-starting-style], .viewport .toolshelf[data-ending-style],
.viewport .view-label[data-starting-style], .viewport .view-label[data-ending-style] { opacity: 0; }
.viewport .readout { position: absolute; right: 10dp; bottom: 8dp; color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); font-family: var(--font-numeric); pointer-events: none; }
.viewport .live-badge { position: absolute; left: 50dp; bottom: 10dp; }
.viewport .notice { position: absolute; left: 12dp; right: 12dp; bottom: 36dp; padding: 6dp 8dp; border-radius: var(--r); background-color: var(--notice); color: var(--notice-fg); white-space: normal; }

/* Outliner. */
.outliner { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; overflow-y: auto; padding: 3dp 4dp 8dp; }
.outliner-empty { position: absolute; left: 0dp; right: 0dp; top: 40dp; color: var(--faint-foreground); text-align: center; pointer-events: none; }

/* The Properties pane's authored shell is styled in Properties.rcss. */
.identity { display: flex; align-items: center; gap: 8dp; padding: 6dp 4dp 12dp; }
.identity .glyph { width: 30dp; height: 30dp; flex: 0 0 auto; border-radius: var(--r-lg); background-color: var(--panel-head); display: flex; align-items: center; justify-content: center; }
.identity .glyph .icon { font-size: 16dp; color: var(--foreground); }
.identity .who { flex: 1 1 0dp; display: flex; flex-direction: column; gap: 3dp; }
.identity .who .title { font-size: var(--studio-font-13, 13dp); font-weight: 600; }
/* The name, a field that reads as the title until hovered or edited (Unity's Inspector). */
.identity .name-field { display: flex; margin-left: -8dp; }
.identity .name-field .field.text { height: var(--studio-height-20, 20dp); background-color: transparent; }
.identity .name-field .field.text:hover { background-color: var(--input-hover); }
.identity .name-field .field.text[data-editing] { background-color: var(--field-edit); border-color: var(--ring); }
.identity .name-field .field[data-readonly] { border-color: transparent; }
.identity .name-field input.value { font-size: var(--studio-font-13, 13dp); font-weight: 600; }
.identity .lineage { display: flex; align-items: center; gap: 4dp; color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); white-space: nowrap; }
.identity .lineage .btn { height: var(--studio-height-16, 16dp); padding: 0dp 3dp; font-size: var(--studio-font-11, 11dp); color: var(--muted-foreground); gap: 3dp; }
.identity .lineage .btn .icon { font-size: 10dp; width: 11dp; }
.prop-empty { padding: 20dp 8dp; color: var(--faint-foreground); text-align: center; }
.behavior-row { display: flex; align-items: center; gap: 6dp; height: var(--studio-height-26, 26dp); padding: 0dp 4dp 0dp 6dp; border-radius: var(--r); margin-top: 2dp; background-color: var(--secondary); }
.behavior-row { cursor: pointer; transition: background-color 0.11s cubic-out; }
.behavior-row:hover { background-color: var(--field-hover); }
.behavior-row[data-current] { background-color: var(--primary-soft); }
.behavior-row[data-current] .icon { color: var(--primary-text); }
.behavior-row .name { flex: 1 1 0dp; }
.behavior-row .graphs { color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); }
.add-row { margin-top: 6dp; display: flex; }
.add-row .btn { flex: 1 1 0dp; }

/* Behavior graph: the canvas is its own zoomed document (graph.rml), shown here. */
.graph-surface { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; }
.area-head .readout { color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); font-family: var(--font-numeric); padding: 0dp 4dp; }
/* A paused run's call stack floats over the canvas's bottom-left corner. */
.call-stack {
    position: absolute; left: 8dp; bottom: 8dp; width: 280dp; padding: 4dp; display: flex; flex-direction: column;
    background-color: var(--floating); border: 1dp var(--line); border-radius: var(--r-lg);
    opacity: 1; margin-top: 0dp; transition: opacity 0.14s cubic-out;
}
.call-stack[data-starting-style], .call-stack[data-ending-style] { opacity: 0; }
.call-stack[data-ending-style] { transition: opacity 0.1s cubic-out; }
.call-stack-head { display: flex; align-items: center; gap: 6dp; height: var(--studio-height-20, 20dp); padding: 0dp 6dp; font-size: var(--studio-font-12, 12dp); font-weight: 600; white-space: nowrap; overflow: hidden; }
.call-stack-head .dim { font-weight: 400; overflow: hidden; text-overflow: ellipsis; }
.call-stack .tree-row .icon { color: var(--faint-foreground); }
.call-stack .tree-row[data-selected] .icon { color: var(--warning); }

/* A source that feeds a pin, in Properties (the graph draws its own). */
.prop .chip { display: block; height: var(--studio-height-18, 18dp); padding: 0dp 6dp; border-radius: 3dp; background-color: var(--field-edit); color: var(--tok-name); font-size: var(--studio-font-11, 11dp); line-height: var(--studio-line-18, 18dp); white-space: nowrap; overflow: hidden; }

/* Editors without content yet. */
/* An empty graph's hint, over the canvas's middle; the canvas keeps the pointer. */
.graph-empty { position: absolute; left: 0dp; right: 0dp; top: 50%; text-align: center; color: var(--faint-foreground); pointer-events: none; }
.pending-editor { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; align-items: center; justify-content: center; color: var(--faint-foreground); background-color: var(--canvas); }

/* Output. */
/* View labels carry counts, so segments fit their labels. */
.output-views, .output-scope { display: flex; flex: 0 0 auto; }
.output-views .segmented, .output-scope .segmented { flex: 0 0 auto; }
.output-views .seg, .output-scope .seg { flex: 0 0 auto; }
.output-scope { margin-left: 6dp; }
.output-filter { width: 160dp; display: flex; }
.output-list { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; padding: 2dp 0dp 6dp; font-family: var(--font-numeric); }
.output-list .vlist-content > .output-line, .output-row { display: block; height: var(--studio-height-20, 20dp); line-height: var(--studio-line-20, 20dp); padding: 0dp 10dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
body.comfortable .output-list .vlist-content > .output-line, body.comfortable .output-row { height: var(--studio-height-24, 24dp); line-height: var(--studio-line-24, 24dp); }
.output-row { display: flex; align-items: center; gap: 6dp; }
.output-row .kind { font-size: var(--studio-font-12, 12dp); width: 14dp; flex: 0 0 auto; }
.output-row .output-line { display: block; flex: 1 1 0dp; padding: 0dp; overflow: hidden; text-overflow: ellipsis; }
.output-row[data-kind=error] .kind { color: var(--destructive); }
.output-row[data-kind=warning] .kind { color: var(--warning); }
.output-row[data-kind=success] .kind { color: var(--success); }
.output-row[data-kind=info] .kind { color: var(--faint-foreground); }
.output-list .vlist-content > .output-line:hover, .output-row:hover { background-color: var(--accent); }
/* Rows at a node open it: where, muted, then the message and a repeat count. */
.output-row.located { cursor: pointer; }
.output-row .output-at { display: block; flex: 0 0 auto; color: var(--faint-foreground); white-space: nowrap; }
.output-row .output-count { flex: 0 0 auto; font-family: var(--font-numeric); }
.output-empty { position: absolute; left: 0dp; right: 0dp; top: 45%; text-align: center; color: var(--faint-foreground); pointer-events: none; }

/* Output's Find view (studio_find.c): what the references are to, then a row per use. */
.find-head { position: absolute; left: 0dp; top: 0dp; right: 0dp; height: var(--studio-height-24, 24dp); display: flex; align-items: center; gap: 6dp; padding: 0dp 10dp; border-bottom: 1dp var(--line); }
.find-head .icon { color: var(--faint-foreground); font-size: 12dp; width: 14dp; }
.find-title { display: block; line-height: var(--studio-line-16, 16dp); color: var(--foreground); font-weight: 600; white-space: nowrap; }
.find-count { display: block; line-height: var(--studio-line-16, 16dp); color: var(--faint-foreground); font-family: var(--font-numeric); }
.output-list.find-list { top: 24dp; padding: 2dp 4dp 6dp; }

/* Find in the graph (studio_graph_find.c) and in the Text Editor
   (studio_code.c): floats over the canvas's or the text's top right, as VS
   Code's find widget does. */
.find-widget {
    position: absolute; top: 8dp; right: 8dp; width: 340dp; display: flex; flex-direction: column; gap: 4dp;
    padding: 4dp; background-color: var(--popover); border: 1dp var(--popover-edge); border-radius: var(--r-lg);
    z-index: 5;
}
.find-widget-bar { display: flex; align-items: center; gap: 2dp; }
.find-widget-bar .search { flex: 1 1 0dp; min-width: 0dp; }
.find-widget-count { display: block; flex: 0 0 auto; padding: 0dp 4dp; line-height: var(--studio-line-16, 16dp); color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); font-family: var(--font-numeric); white-space: nowrap; }
.graph-find-list { position: relative; }
.graph-find-list .tree-row .meta { display: block; flex: 0 1 auto; max-width: 60%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* Assets. */
.assets-kind { width: 140dp; display: flex; }
.assets-filter { flex: 1 1 0dp; display: flex; max-width: 220dp; margin-left: 4dp; }
.assets-list { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; padding: 3dp 4dp 8dp; }
.assets-list .tree-row { tab-index: none; }
.assets-list .tree-row[data-unused] .meta { color: var(--disabled-foreground); }
.assets-list .tree-row[data-unresolved] .icon { color: var(--warning); }

/* Performance. */
.perf-title { display: block; line-height: var(--studio-line-16, 16dp); color: var(--foreground); font-weight: 500; margin-left: 2dp; }
.perf-readout { display: block; line-height: var(--studio-line-16, 16dp); color: var(--muted-foreground); font-family: var(--font-numeric); margin-right: 6dp; }
.perf { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; flex-direction: column; padding: 6dp 10dp 8dp; gap: 4dp; overflow-y: auto; }
.perf-heading { display: block; line-height: var(--studio-line-16, 16dp); color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); }
.perf-chart { flex: 1 1 0dp; min-height: 60dp; }
.perf-legend { display: flex; gap: 14dp; flex: 0 0 auto; height: var(--studio-height-18, 18dp); align-items: center; }
.perf-key { display: flex; align-items: center; gap: 5dp; }
.perf-key span { display: block; line-height: var(--studio-line-16, 16dp); color: var(--muted-foreground); font-size: var(--studio-font-11, 11dp); }
.perf-dot { width: 8dp; height: 8dp; border-radius: 4dp; }
.perf-idle { flex: 1 1 0dp; display: block; line-height: var(--studio-line-40, 40dp); text-align: center; color: var(--faint-foreground); }
.perf-status { flex: 0 0 auto; display: block; line-height: var(--studio-line-16, 16dp); color: var(--muted-foreground); font-size: var(--studio-font-11, 11dp); }

/* Members (Unreal's My Blueprint). */
.members-filter { flex: 1 1 0dp; display: flex; max-width: 240dp; }
.members-list { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; padding: 3dp 4dp 8dp; }
.members-list .tree-row { tab-index: none; }
.members-list .tree-row[data-section] .name { font-weight: 600; }
.member-row { display: block; }
.member-swatch { width: 9dp; height: 9dp; flex: 0 0 auto; margin: 0dp 5dp 0dp 3dp; }
/* A member's use count, which lists its uses in Find. */
.tree-row .member-uses { height: var(--studio-height-18, 18dp); min-width: 20dp; padding: 0dp 4dp; justify-content: center; color: var(--faint-foreground); font-family: var(--font-numeric); }
.tree-row .member-uses[data-unused] { color: var(--disabled-foreground); }
.member-rename .field, .object-rename .field { height: var(--studio-height-20, 20dp); margin-right: 4dp; }
/* Rename and safe delete: the new name, then the assets it rewrites or the
   uses a delete leaves, as rows shaped like the menu's items. */
.popup.refactor { width: 300dp; }
.refactor-field { display: block; padding: 2dp 4dp 4dp; }
.refactor-field .field { height: var(--studio-height-24, 24dp); }
.refactor-row { display: flex; align-items: center; gap: 8dp; height: var(--h); padding: 0dp 8dp 0dp 6dp; white-space: nowrap; color: var(--fg); }
.refactor-row .lead { color: var(--fg-2); }
.refactor-row .label { flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; }
.refactor-row .kbd { margin-left: 16dp; flex: 0 0 auto; color: var(--fg-3); }
.type-pick { display: flex; align-items: center; gap: 2dp; flex: 1 1 0dp; }
.type-pick .member-swatch { margin: 0dp 4dp; }
.type-pick .type-button { flex: 1 1 0dp; justify-content: flex-start; overflow: hidden; }
.param-row { display: flex; align-items: center; gap: 4dp; margin-top: var(--gap); }
.param-row .field { flex: 1 1 0dp; }
.param-row .type-pick { flex: 0 0 104dp; }
.param-row .select { flex: 0 0 78dp; }
.param-row .param-grip { flex: 0 0 12dp; width: 12dp; font-size: var(--studio-font-12, 12dp); color: var(--disabled-foreground); cursor: grab; }
.param-row .param-grip:hover { color: var(--muted-foreground); }
.param { border-radius: 4dp; }

/* UI documents (workstream D). The Text Editor: part tabs, the file and the
   apply mode in the header; the part's code editor (kit_code) filling the
   body, and a status line while the text does not read. */
.code-parts, .code-apply { display: flex; flex: 0 0 auto; }
/* Workstream Q: Back and Forward through Go to Definition's jumps. */
.code-history { display: flex; flex: 0 0 auto; align-items: center; gap: 1dp; margin-right: 4dp; }
.code-parts .segmented, .code-apply .segmented { flex: 0 0 auto; }
.code-parts .seg, .code-apply .seg { flex: 0 0 auto; }
.code-file { display: flex; align-items: center; gap: 6dp; padding: 0dp 6dp; flex: 0 1 auto; min-width: 0dp; white-space: nowrap; color: var(--foreground); }
.code-file .icon { color: var(--muted-foreground); }
.code-file .name { overflow: hidden; text-overflow: ellipsis; }
.code-problem { display: flex; align-items: center; gap: 4dp; padding: 0dp 6dp; flex: 0 0 auto; color: var(--destructive); }
.code-editor { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; flex-direction: column; background-color: var(--background); }
.code-editor kit-code { flex: 1 1 0dp; min-height: 0dp; }
.code-status { display: flex; align-items: center; gap: 6dp; height: var(--studio-height-22, 22dp); flex: 0 0 auto; padding: 0dp 8dp; border-top: 1dp var(--edge); background-color: var(--muted); color: var(--destructive); white-space: nowrap; overflow: hidden; }
.code-status .message { overflow: hidden; text-overflow: ellipsis; }
/* Assets ▸ New: the name of the new asset. */
.popup.new-asset { width: 260dp; }
.new-asset-field { display: block; padding: 2dp 4dp 4dp; }
.new-asset-field .field { height: var(--studio-height-24, 24dp); }
.new-asset-error { display: flex; align-items: center; gap: 8dp; min-height: var(--h); padding: 0dp 8dp 0dp 6dp; color: var(--destructive); }

/* UI wiring (workstream K): the Canvas preview of one ui asset in the Scene area. */
.canvas-sizes { display: flex; flex: 0 0 auto; margin-left: 6dp; }
.canvas-sizes .segmented { flex: 0 0 auto; }
.canvas-sizes .seg { flex: 0 0 auto; }
.viewport.canvas { display: flex; }
/* The stage sits a step darker than the frame's backdrop, so a screen size's edges show. */
.canvas-stage { position: relative; flex: 1 1 0dp; overflow: hidden; background-color: #121214; }
.viewport.canvas.light .canvas-stage { background-color: #d4d4d8; }
.viewport .canvas-label { left: 12dp; right: 12dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.viewport .canvas-label .dim { overflow: hidden; text-overflow: ellipsis; }
.viewport.canvas.light .canvas-label { color: #3f3f46; }
.viewport.canvas.light .canvas-label .dim { color: #71717a; }
.canvas-actions { flex: 0 0 240dp; display: flex; flex-direction: column; border-left: 1dp var(--line); background-color: var(--floating); }
.canvas-actions-toggle { display: flex; align-items: center; gap: 4dp; flex: 0 0 auto; padding: 0dp 6dp 0dp 2dp; }
.canvas-actions-toggle .btn { gap: 4dp; padding: 0dp 6dp; }
.canvas-actions-toggle .btn .icon { font-size: 13dp; width: 14dp; }
.canvas-actions-toggle .count { color: var(--faint-foreground); font-size: 11dp; }
.canvas-actions-head { display: flex; align-items: center; gap: 6dp; height: var(--header-h); flex: 0 0 auto; padding: 0dp 4dp 0dp 10dp; font-size: var(--studio-font-11, 11dp); border-bottom: 1dp var(--line); }
.canvas-actions-head .icon { color: var(--faint-foreground); font-size: 12dp; width: 14dp; }
.canvas-actions-head .title { font-weight: 600; color: var(--foreground); }
.canvas-actions-head .count { color: var(--faint-foreground); font-family: var(--font-numeric); }
.canvas-actions-list { position: relative; flex: 1 1 0dp; padding: 2dp 4dp; font-family: var(--font-numeric); }
.canvas-action { display: flex; align-items: center; gap: 6dp; height: var(--studio-height-20, 20dp); padding: 0dp 6dp; border-radius: var(--r); white-space: nowrap; overflow: hidden; }
body.comfortable .canvas-action { height: var(--studio-height-24, 24dp); }
.canvas-action:hover { background-color: var(--accent); }
.canvas-action .event { color: var(--primary-text); font-weight: 600; flex: 0 1 auto; overflow: hidden; text-overflow: ellipsis; }
.canvas-action .element { color: var(--muted-foreground); flex: 0 1 auto; overflow: hidden; text-overflow: ellipsis; }
.canvas-action .value { color: var(--foreground); flex: 0 0 auto; }
.canvas-action .count { color: var(--faint-foreground); flex: 0 0 auto; }
.canvas-action .time { margin-left: auto; color: var(--faint-foreground); flex: 0 0 auto; }
.canvas-actions-empty { display: block; padding: 16dp 10dp; text-align: center; color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); pointer-events: none; }

/* Visual designer (workstream H): a UI document's Hierarchy, Details and
   Library, and its outlines in the Canvas. */
.designer-mode { display: block; flex: 0 0 auto; padding: 0dp 6dp 0dp 2dp; font-weight: 600; color: var(--foreground); white-space: nowrap; }
.designer-tree .tree-row { tab-index: none; }
.designer-tree .tree-row .name { flex: 0 1 auto; }
.designer-tree .tree-row .meta { flex: 1 1 0dp; margin-left: 2dp; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.designer-tree .tree-row .bound { font-size: 12dp; width: 14dp; color: var(--link); pointer-events: none; }
/* Where a drag lands: a line above or below the row, or the row itself. */
.designer-tree .tree-row[data-drop=before] { border-color: transparent; border-top-color: var(--primary); background-color: transparent; }
.designer-tree .tree-row[data-drop=after] { border-color: transparent; border-bottom-color: var(--primary); background-color: transparent; }
.designer-tree .tree-row[data-drop=inside] { border-color: var(--primary); background-color: var(--primary-soft); }
/* The Canvas: the element under the pointer, a drop's target and the
   selection, labeled as UMG labels its selected widget. */
.inspect-highlight.designer-hover .band.content { background-color: transparent; border: 1dp var(--primary-edge); }
.inspect-highlight.designer-target .band.content { background-color: var(--primary-soft); border: 1dp var(--primary); }
.inspect-highlight.selected .label { color: var(--primary-foreground); background-color: var(--primary); border-color: var(--primary); }
.designer-drop { position: absolute; pointer-events: none; }
.designer-drop[data-active] { pointer-events: auto; }
.designer-drop[data-drop-over] { background-color: transparent; }
/* Workstream Q: where a Canvas drop lands between siblings. */
.designer-drop-line { position: absolute; pointer-events: none; background-color: var(--primary); border-radius: 1dp; }
/* Details. */
.designer-details .prop .remove { flex: 0 0 auto; opacity: 0; transition: opacity 0.11s cubic-out; }
.designer-details .prop:hover .remove { opacity: 1; }
.designer-chips { display: flex; flex: 1 1 0dp; flex-wrap: wrap; align-items: center; gap: 4dp; min-height: var(--h); }
.designer-chip { display: flex; align-items: center; height: var(--studio-height-20, 20dp); padding: 0dp 1dp 0dp 7dp; border-radius: 10dp; background-color: var(--secondary); color: var(--foreground); white-space: nowrap; }
.designer-chip .btn { width: 16dp; height: 16dp; border-radius: 8dp; }
.designer-chip .btn .icon { font-size: 10dp; color: var(--muted-foreground); }
.designer-chips .designer-add { width: 20dp; height: 20dp; border-radius: 10dp; padding: 0dp; }
.designer-bindings .field .value { font-family: var(--studio-code-font-family, jetbrains mono); font-size: var(--studio-mono-font-11, 11dp); color: var(--link); }
.designer-more { display: flex; margin-top: 6dp; }
.designer-more .btn { flex: 1 1 0dp; justify-content: center; color: var(--muted-foreground); }
.designer-origin { display: flex; align-items: center; gap: 6dp; height: var(--studio-height-20, 20dp); margin-bottom: 2dp; font-size: var(--studio-font-11, 11dp); color: var(--faint-foreground); }
.designer-origin .within { color: var(--muted-foreground); white-space: nowrap; }
.designer-origin .btn { height: var(--studio-height-18, 18dp); padding: 0dp 4dp; gap: 3dp; font-size: var(--studio-font-11, 11dp); color: var(--muted-foreground); font-family: var(--font-numeric); }
.designer-origin .btn .icon { font-size: 10dp; width: 11dp; }
.designer-none, .designer-hint { display: block; padding: 6dp 4dp; font-size: var(--studio-font-11, 11dp); color: var(--faint-foreground); }
.popup.designer-add-menu { width: 240dp; }
.designer-add-field { display: block; padding: 2dp 4dp 4dp; }
.designer-add-field .field { height: var(--studio-height-24, 24dp); }
/* Library: tiles to drag into the Hierarchy or the Canvas. */
.designer-library { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; overflow-y: auto; padding: 4dp 8dp 10dp; }
.designer-section { display: block; padding: 8dp 2dp 5dp; }
.designer-section .title { font-size: var(--studio-font-11, 11dp); font-weight: 600; color: var(--muted-foreground); }
.designer-tiles { display: flex; flex-wrap: wrap; gap: 6dp; }
.designer-tile {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5dp; width: 78dp; height: 56dp;
    border-radius: var(--r-lg); border: 1dp var(--line); background-color: var(--card); cursor: pointer;
    transition: background-color border-color 0.11s cubic-out;
}
.designer-tile:hover { background-color: var(--accent); border-color: var(--border); }
.designer-tile:active { background-color: var(--press); }
.designer-tile .glyph { font-size: 18dp; color: var(--muted-foreground); pointer-events: none; }
.designer-tile:hover .glyph { color: var(--primary-text); }
.designer-tile .label { pointer-events: none; max-width: 70dp; font-size: var(--studio-font-11, 11dp); color: var(--foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
body.comfortable .designer-tile { width: 86dp; height: 62dp; }
