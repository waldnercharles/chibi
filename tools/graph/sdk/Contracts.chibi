        "share/chibi/licenses/fonts/nerd-fonts-symbols-only/LICENSE=@source/third_party/fonts/nerd-fonts-symbols-only/LICENSE",
        "share/chibi/licenses/fonts/nerd-fonts-symbols-only/NOTICES.md=@source/third_party/fonts/nerd-fonts-symbols-only/NOTICES.md",
