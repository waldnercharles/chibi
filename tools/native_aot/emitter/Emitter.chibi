package native_emitter

import abi "project:native_abi"
import facts "project:scalar_facts"
import scalar "project:scalar_llvm"
import strings "core:strings"

// `chibi build --native`'s and `chibi export --native`'s entries over
// CollectScalar's rows. Each returns raw bytes the compiler host writes
// unchanged: the module's IR, or why it has none.
// Emit for the driver's target 0, 1 or 2: Linux x86-64, macOS arm64 or
// Windows x64.
pub Emit :: (rows: facts.Row[], target: int) -> u8[] {
    targets := [abi.LinuxX64(), abi.MacOSArm64(), abi.WindowsX64()];
    if (Library(rows) || target < 0 || target >= length(targets)) {
        none: u8[] = [];
        return none;
    }
    return scalar.EmitBytesFor(targets[target], rows);
}
// Emit with line tables, for a source in `directory`.
pub EmitLines :: (rows: facts.Row[], directory: string) -> u8[] {
    if (Library(rows)) {
        none: u8[] = [];
        return none;
    }
    return scalar.EmitLinesBytes(rows, directory);
}

// A native library's module, for `chibi export --native`, which links it as
// the shared object the player loads. Libraries are Linux x86-64 only so far.
pub EmitLibrary :: (rows: facts.Row[]) -> u8[] {
    if (!Library(rows)) {
        none: u8[] = [];
        return none;
    }
    return scalar.EmitBytesFor(abi.LinuxX64(), rows);
}

// Why native code cannot hold the library, or no bytes when the emitter did
// not reject it: `chibi export --native` keeps a rejected library in the VM and
// fails on anything else.
pub Rejection :: (rows: facts.Row[]) -> u8[] {
    message := "";
    switch scalar.Emit(rows) {
        case .Rejected(rejected):
            message = Located(rejected[1]);
        case .Invalid(reason):
            message = "";
        case .Emitted(text):
            message = "";
    }
    return Text(message);
}

// Whether the rows are a native library's, which has no entry to link a
// program from: its Document row names the library.
Library :: (rows: facts.Row[]) -> bool {
    return rows[1].kind == facts.DocumentRow && rows[1].text != "";
}

pub Diagnose :: (rows: facts.Row[]) -> u8[] {
    message := "";
    switch scalar.Emit(rows) {
        case .Rejected(rejected):
            message = Located(rejected[1]);
        case .Invalid(reason):
            message = reason;
        case .Emitted(text):
            if (Library(rows)) {
                message = "a native library has no entry; build --native links a package";
            }
    }
    return Text(message);
}

// A rejection row as "line:column: reason".
Located :: (row: facts.Row) -> string {
    return format_text("{}:{}: {}", row.line, row.column, row.text);
}

Text :: (message: string) -> u8[] {
    bytes: u8[] = [];
    for (value in strings.Bytes(message)) {
        bytes.append(u8(value));
    }
    return bytes;
}
