version 3
name "AdjustableBoom"
domain "model"
id_counter 62
description "Public uniform dimensions and transforms share one distance program. Its off-center bounds follow the same parameter snapshot."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Parameter"
                reference_name "Reach"
                inputs Default=24.0 Minimum=8.0 Maximum=55.0
            }
            - {
                id 8
                type "Model Parameter"
                reference_name "Bend"
                inputs Default=0.0 Minimum=-0.8 Maximum=0.8
            }
            - {
                id 13
                type "Model Parameter"
                reference_name "Offset"
                inputs {
                    Default {
                        type "struct"
                        type_name "ShaderVec3"
                        default x=0.0 y=0.0 z=0.0
                    }
                    Minimum {
                        type "struct"
                        type_name "ShaderVec3"
                        default x=-40.0 y=-10.0 z=-25.0
                    }
                    Maximum {
                        type "struct"
                        type_name "ShaderVec3"
                        default x=40.0 y=30.0 z=25.0
                    }
                }
            }
            - {
                id 18
                type "Model Parameter"
                reference_name "Factors"
                inputs {
                    Default {
                        type "struct"
                        type_name "ShaderVec3"
                        default x=1.0 y=1.0 z=1.0
                    }
                    Minimum {
                        type "struct"
                        type_name "ShaderVec3"
                        default x=0.65 y=0.65 z=0.65
                    }
                    Maximum {
                        type "struct"
                        type_name "ShaderVec3"
                        default x=1.4 y=1.4 z=1.4
                    }
                }
            }
            - {
                id 23
                type "Shader Vector3"
                inputs Y=8.0 Z=11.0
            }
            - {
                id 28
                type "Model Rounded Box"
                inputs Radius=3.0
            }
            - id=32 type="Shader Vector3"
            - id=37 type="Model Translate"
            - {
                id 41
                type "Model Part"
                reference_name "Extending arm"
                inputs {
                    Material id=61
                }
                outputs {
                    Geometry id=43
                }
            }
            - id=44 type="Shader Vector3"
            - id=49 type="Model Rotate"
            - id=53 type="Model Scale"
            - id=57 type="Model Translate"
        }
        (array)edges {
            - from="3.Value" to="23.X"
            - from="3.Value" to="32.X"
            - from="8.Value" to="44.Z"
            - from="13.Value" to="57.Offset"
            - from="18.Value" to="53.Factors"
            - from="23.Value" to="28.Half Size"
            - from="28.Geometry" to="37.Geometry"
            - from="32.Value" to="37.Offset"
            - from="37.Geometry" to="41.Geometry"
            - from="41.Geometry" to="49.Geometry"
            - from="44.Value" to="49.Angles"
            - from="49.Geometry" to="53.Geometry"
            - from="53.Geometry" to="57.Geometry"
            - from="57.Geometry" to="1.Geometry"
        }
    }
}
