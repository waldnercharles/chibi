 	root->Update(density_independent_pixel_ratio, Vector2f(dimensions));
+	if (profile_seconds)
+		profile_seconds[1] = UpdateProfileTime() - profile_start;
+
+	profile_start = profile_seconds ? UpdateProfileTime() : 0;
 
 	for (int i = 0; i < root->GetNumChildren(); ++i)
 	{
@@ -213,8 +227,14 @@
 		}
 	}
 
+	if (profile_seconds)
+		profile_seconds[2] = UpdateProfileTime() - profile_start;
+
