package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("DriftSystem")),
            data.Field.Named("components", data.Object([
                data.Field.Named("EngineSystem", data.Object([
                    data.Field.Named("asset", data.Value.Text("Drift"))
                ]))
            ]))
        ])
    );
}
