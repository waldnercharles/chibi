+        "\n"
+        "{\"contract\":1,\"operation\":\"bake_material\",\"kind\":\"material\","
+        "\"name\":\"Bake\",\"width\":2,\"height\":2,\"channel\":\"roughness\","
+        "\"overrides\":[{\"asset\":\"Bake\",\"scope\":\"\",\"parameter_id\":"
+        "500,"
+        "\"value\":[0.75]}]}\n"
+        "{\"contract\":1,\"operation\":\"bake_material\",\"kind\":\"material\","
+        "\"name\":\"Bake\",\"uv_max\":[0,0]}\n"
+        "{\"contract\":1,\"operation\":\"bake_material\",\"kind\":\"material\","
