package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("MovingPlatformsView")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Camera", data.Object([
                    data.Field.Named("height", data.Value.Real(360.0)),
                    data.Field.Named("width", data.Value.Real(640.0))
                ])),
                data.Field.Named("DirectionalLight", data.Object([
                    data.Field.Named("color", data.Value.UInt(4294967295)),
                    data.Field.Named("direction", data.Object([
                        data.Field.Named("x", data.Value.Real(0.45000000000000001)),
                        data.Field.Named("y", data.Value.Real(-0.84999999999999998)),
                        data.Field.Named("z", data.Value.Real(-0.40000000000000002))
                    ])),
                    data.Field.Named("intensity", data.Value.Real(2.7999999999999998)),
                    data.Field.Named("shadows", data.Value.Bool(true))
                ])),
                data.Field.Named("Environment", data.Object([
                    data.Field.Named("ambient_ground", data.Value.UInt(808993023)),
                    data.Field.Named("ambient_intensity", data.Value.Real(1.0)),
                    data.Field.Named("ambient_sky", data.Value.UInt(2156962047)),
                    data.Field.Named("fog_resolution", data.Value.Real(0.25)),
                    data.Field.Named("fog_steps", data.Value.UInt(4))
                ])),
                data.Field.Named("Transform", data.Object([]))
            ]))
        ])
    );
}
