package managed_tasks

foreign import libc "system:c"
foreign libc {
    fopen :: (path: cstring, mode: cstring) -> rawptr
    fwrite :: (data: cstring, size: u64, count: u64, stream: rawptr) -> u64
    fclose :: (stream: rawptr) -> i32
    access :: (path: cstring, mode: i32) -> i32
}
Make :: (value: int) -> ^int { return &value; }
Churn :: () { for index in 0..<3000 { discarded := Make(index); } }
Mark :: (path: string, text: string) {
    stream := fopen(path, "wb");
    assert(stream != 0);
    written := fwrite(text, 1, u64(text_byte_length(text)), stream);
    closed := fclose(stream);
    assert(written == u64(text_byte_length(text)) && closed == 0);
}
Allowed :: () -> bool { return access("allow-managed-task", 0) == 0; }
Done :: () { Mark("managed-task-done", "old42"); }
Promise :: () -> ^int { if false { yield } return Make(31); }
ArrayPromise :: () -> ^int[] { if false { yield } return [Make(11), Make(13)]; }
Worker :: () -> int {
    promised := Promise();
    array_promised := ArrayPromise();
    pointer := Make(37);
    values := [Make(2), Make(3)];
    while !Allowed() { yield }
    Churn();
    joined := await promised;
    if joined is Cancelled { return 1; }
    else { assert(joined^ == 31, "completed old promise survives incoming-generation collection"); }
    array_joined := await array_promised;
    if array_joined is Cancelled { return 2; }
    else {
        saved := array_joined;
        saved[0] = Make(99);
        Churn();
        assert(saved[0]^ == 99 && saved[1]^ == 13);
    }
    array_again := await array_promised;
    if array_again is Cancelled { return 3; }
    else { saved := array_again; assert(saved[0]^ == 11, "joins copy the old generation's GC-array promise"); }
    assert(pointer^ + values[0]^ + values[1]^ == 42, "old generation keeps its suspended collector roots");
    Done();
    return 0;
}
Child :: (values: ^int[]) -> int {
    yield
    Churn();
    return values[0]^;
}
Cancelled :: () -> int {
    completed := ArrayPromise();
    values := [Make(19)];
    return await Child(values);
}
Main :: () -> int {
    worker := Worker();
    cancelled := Cancelled();
    cancel cancelled
    Mark("managed-ready", "ready");
    return 0;
}
Frame :: () -> int { Churn(); return 0; }
