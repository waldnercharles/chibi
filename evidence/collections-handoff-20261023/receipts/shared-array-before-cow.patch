+                MANAGE_SLOT(&sum->values[i]);
+            }
+            continue;
+        }
+        value.record = snapshot_layout(
+            storage,
+            value.type,
+            value.type_name,
+            value.record
+        );
+        if (!value.record) {
+            error = -1;
+            break;
+        }
+        value.type_name = value.record->type.name;
+        manage_header(&visited, &value, at.slot, value.record, value.type_name);
