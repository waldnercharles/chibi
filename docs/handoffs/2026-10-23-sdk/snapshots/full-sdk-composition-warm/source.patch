+InstalledEntries :: (stage: string) -> string[] {
+    entries: string[] = [];
+    for (path in ["libexec/chibi/chibi-build-host", "libexec/chibi/chibi-compiler-host",
+                  "bin/chibi-compile", "share/chibi/compiler", "share/chibi/core",
+                  "share/chibi/tools/toolchain/SDK.chibi", PolicyOutputs()[0]]) {
+        entries = build.concat(entries, [Join([path, "=", stage, "/", path])]);
+    }
+    return entries;
