package facts
Factorial :: (n: int) -> int { if n <= 1 { return 1; } return n * Factorial(n - 1); }
Sum :: (limit: int) -> int { total := 0; i := 1; while i <= limit { if i == 3 { i += 1; continue; } total += i; i += 1; if total > 1000 { break; } } return total; }
IsBig :: (n: int) -> bool { return n > 100; }
Pick :: (n: int) -> int { if IsBig(n) { return 1; } return 2; }
Size :: Factorial(5)
Total :: Sum(5)
Chosen :: Pick(Size) + Pick(3)
Wide: i64 : i64(Factorial(10))
Main :: () -> int { if Wide == 3628800 { return Size + Total + Chosen; } return 0; }
