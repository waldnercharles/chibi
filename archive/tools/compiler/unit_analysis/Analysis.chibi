package unit_analysis

import units "project:unit_algebra"
import syntax "project:syntax_diagnostics"
import binding "project:lexical_binding"
import strings "core:strings"

// Raw analyzer/catalog facts, preserving original order and full-width IDs.
// Negative ID slots mean zero. All other indices/spans obey analyzer invariants.
pub Type :: struct {
    storage: int;
    container: int;
    flags: int;
    nominal_slot: int;
}
pub Range :: struct {
    start: int;
    end: int;
    line: int;
    column: int;
    document: int;
}
pub Expression :: struct {
    kind: int;
    op: int;
    type: int;
    range: int;
    symbol: int;
    left: int;
    right: int;
    arg_start: int;
    arg_count: int;
    result_count: int;
    capability_slot: int;
    member_slot: int;
    offset_slot: int;
    task: bool;
}
pub Symbol :: struct {
    id_slot: int;
    kind: int;
    range: int;
    initializer: int;
    has_unit: bool;
    unit: string;
}
pub Function :: struct {
    param_start: int;
    param_count: int;
    result_start: int;
    result_count: int;
}
pub Argument :: struct {
    value: int;
    parameter: int;
    range: int;
}
pub Capability :: struct {
    id_slot: int;
    kind: int;
    param_start: int;
    param_count: int;
    result_start: int;
    result_count: int;
    event_sender: bool;
    variadic: bool;
}
pub Field :: struct {
    id_slot: int;
    has_unit: bool;
    unit: string;
}
pub CatalogType :: struct {
    id_slot: int;
    field_start: int;
    field_count: int;
}
pub Global :: struct {
    id_slot: int;
    has_unit: bool;
    unit: string;
}
pub Statement :: struct {
    kind: int;
    range: int;
    op: int;
    expression: int;
    symbol: int;
    second: int;
}
pub Binding :: struct {
    target: int;
    value: int;
    range: int;
}
Cache :: struct {
    kind: int;
    term_start: int;
    term_count: int;
}
pub Port :: struct {
    name: string;
    has_unit: bool;
    unit: string;
}
pub Environment :: union {
    Tables(types: Type[], ids: u64[], symbols: Symbol[], expressions: Expression[], arguments: Argument[], functions: Function[], symbol_indices: int[], capabilities: Capability[], ports: Port[], fields: Field[], catalog_types: CatalogType[], globals: Global[], statements: Statement[], bindings: Binding[], ranges: Range[])
}
State :: union {
    Cached(cache: Cache[], terms: units.Term[], visits: int[], diagnostics: syntax.Diagnostic[])
}
Evaluation :: union {
    Evaluated(value: units.Unit, current: State)
}
pub Analysis :: union {
    Completed(cache: Cache[], terms: units.Term[], diagnostics: syntax.Diagnostic[])
}

Types :: (environment: Environment) -> Type[] {
    switch environment {
        case .Tables(types, ids, symbols, expressions, arguments, functions, symbol_indices, capabilities, ports, fields, catalog_types, globals, statements, bindings, ranges):
            return types;
    }
}

Ids :: (environment: Environment) -> u64[] {
    switch environment {
        case .Tables(types, ids, symbols, expressions, arguments, functions, symbol_indices, capabilities, ports, fields, catalog_types, globals, statements, bindings, ranges):
            return ids;
    }
}

Symbols :: (environment: Environment) -> Symbol[] {
    switch environment {
        case .Tables(types, ids, symbols, expressions, arguments, functions, symbol_indices, capabilities, ports, fields, catalog_types, globals, statements, bindings, ranges):
            return symbols;
    }
}

Expressions :: (environment: Environment) -> Expression[] {
    switch environment {
        case .Tables(types, ids, symbols, expressions, arguments, functions, symbol_indices, capabilities, ports, fields, catalog_types, globals, statements, bindings, ranges):
            return expressions;
    }
}

Arguments :: (environment: Environment) -> Argument[] {
    switch environment {
        case .Tables(types, ids, symbols, expressions, arguments, functions, symbol_indices, capabilities, ports, fields, catalog_types, globals, statements, bindings, ranges):
            return arguments;
    }
}

Functions :: (environment: Environment) -> Function[] {
    switch environment {
        case .Tables(types, ids, symbols, expressions, arguments, functions, symbol_indices, capabilities, ports, fields, catalog_types, globals, statements, bindings, ranges):
            return functions;
    }
}

SymbolIndices :: (environment: Environment) -> int[] {
    switch environment {
        case .Tables(types, ids, symbols, expressions, arguments, functions, symbol_indices, capabilities, ports, fields, catalog_types, globals, statements, bindings, ranges):
            return symbol_indices;
    }
}

Capabilities :: (environment: Environment) -> Capability[] {
    switch environment {
        case .Tables(types, ids, symbols, expressions, arguments, functions, symbol_indices, capabilities, ports, fields, catalog_types, globals, statements, bindings, ranges):
            return capabilities;
    }
}

Ports :: (environment: Environment) -> Port[] {
    switch environment {
        case .Tables(types, ids, symbols, expressions, arguments, functions, symbol_indices, capabilities, ports, fields, catalog_types, globals, statements, bindings, ranges):
            return ports;
    }
}

Fields :: (environment: Environment) -> Field[] {
    switch environment {
        case .Tables(types, ids, symbols, expressions, arguments, functions, symbol_indices, capabilities, ports, fields, catalog_types, globals, statements, bindings, ranges):
            return fields;
    }
}

CatalogTypes :: (environment: Environment) -> CatalogType[] {
    switch environment {
        case .Tables(types, ids, symbols, expressions, arguments, functions, symbol_indices, capabilities, ports, fields, catalog_types, globals, statements, bindings, ranges):
            return catalog_types;
    }
}

Globals :: (environment: Environment) -> Global[] {
    switch environment {
        case .Tables(types, ids, symbols, expressions, arguments, functions, symbol_indices, capabilities, ports, fields, catalog_types, globals, statements, bindings, ranges):
            return globals;
    }
}

Statements :: (environment: Environment) -> Statement[] {
    switch environment {
        case .Tables(types, ids, symbols, expressions, arguments, functions, symbol_indices, capabilities, ports, fields, catalog_types, globals, statements, bindings, ranges):
            return statements;
    }
}

Bindings :: (environment: Environment) -> Binding[] {
    switch environment {
        case .Tables(types, ids, symbols, expressions, arguments, functions, symbol_indices, capabilities, ports, fields, catalog_types, globals, statements, bindings, ranges):
            return bindings;
    }
}

Ranges :: (environment: Environment) -> Range[] {
    switch environment {
        case .Tables(types, ids, symbols, expressions, arguments, functions, symbol_indices, capabilities, ports, fields, catalog_types, globals, statements, bindings, ranges):
            return ranges;
    }
}

// Existing typed IR enum values and type flags retain their ABI.
ConstantExpression: int : 1;
SymbolExpression: int : 2;
UnaryExpression: int : 3;
BinaryExpression: int : 4;
CastExpression: int : 5;
CallExpression: int : 6;
MemberExpression: int : 7;
StructExpression: int : 14;
FallbackExpression: int : 16;
JoinExpression: int : 18;
IsExpression: int : 22;
AsExpression: int : 23;
UnwrapExpression: int : 24;
QueryFieldExpression: int : 28;
GlobalSymbol: int : 0;
StateSymbol: int : 4;
SharedStateSymbol: int : 5;
ParameterSymbol: int : 6;
ResultSymbol: int : 7;
LocalSymbol: int : 8;
ConstantSymbol: int : 14;
OpNone: int : 0;
OpAdd: int : 1;
OpSubtract: int : 2;
OpMultiply: int : 3;
OpDivide: int : 4;
OpModulo: int : 5;
OpNegate: int : 6;
OpEqual: int : 10;
OpGreaterEqual: int : 15;
EventCapability: int : 2;
AssignStatement: int : 2;
ReduceStatement: int : 16;
GenericFlag: int : 32;
ResultsFlag: int : 8;
NumericExcludedFlags: int : 75;

IDAt :: (environment: Environment, slot: int) -> u64 {
    if (slot < 0) {
        return 0;
    }
    return Ids(environment)[slot];
}
// Match a full-width offset to a bounded native index without narrowing it.
OffsetIndex :: (offset: u64, count: int) -> int {
    index: int = 0;
    while (index < count) {
        if (offset == u64(index)) {
            return index;
        }
        index += 1;
    }
    return -1;
}
Kind :: (value: units.Unit) -> int {
    switch value {
        case .Value(kind, terms):
            return kind;
    }
}
Numeric :: (type: Type, environment: Environment) -> bool {
    return type.container == 0 &&
           (IDAt(environment, type.nominal_slot) == 0 || (type.flags & GenericFlag) != 0) &&
           type.storage >= 2 && type.storage <= 11 && (type.flags & NumericExcludedFlags) == 0;
}
CapabilityAt :: (environment: Environment, id: u64) -> int {
    rows := Capabilities(environment);
    index: int = 0;
    while (index < length(rows)) {
        if (IDAt(environment, rows[index].id_slot) == id) {
            return index;
        }
        index += 1;
    }
    return -1;
}
CallCapability :: (environment: Environment, expression: Expression) -> int {
    id := IDAt(environment, expression.capability_slot);
    if (expression.kind == JoinExpression && expression.left >= 0) {
        receiver := Expressions(environment)[expression.left];
        id = IDAt(environment, Types(environment)[receiver.type].nominal_slot);
    }
    return CapabilityAt(environment, id);
}
Report :: (current: State, range: Range, message: string) -> State {
    switch current {
        case .Cached(cache, terms, visits, diagnostics):
            row: syntax.Diagnostic = {
                start: range.start, end: range.end, line: range.line,
                column: range.column, document: range.document,
                message: units.WholeCharacters(strings.Slice(message, 0, 191))
            };
            return State.Cached(cache, terms, visits, append(diagnostics, row));
    }
}
Annotated :: (current: State, range: Range, present: bool, text: string) -> Evaluation {
    value := units.Parse(present, text);
    if (Kind(value) == units.Invalid) {
        current = Report(current, range, format_text("Invalid unit '{}'", text));
        value = units.Empty(units.Unknown);
    }
    return Evaluation.Evaluated(value, current);
}
Clash :: (left: units.Unit, right: units.Unit) -> bool {
    return Kind(left) == units.Known && Kind(right) == units.Known && !units.Same(left, right);
}
ReportUnits :: (current: State, range: Range, left: units.Unit, op: string, right: units.Unit) -> State {
    return Report(current, range, format_text("Units differ: {} {} {}", units.Format(left, 192), op, units.Format(right, 192)));
}
Match :: (current: State, range: Range, left: units.Unit, op: string, right: units.Unit) -> Evaluation {
    if (Clash(left, right)) {
        return Evaluation.Evaluated(units.Empty(units.Unknown), ReportUnits(current, range, left, op, right));
    }
    if (Kind(left) == units.Known) {
        return Evaluation.Evaluated(left, current);
    }
    if (Kind(right) == units.Known) {
        return Evaluation.Evaluated(right, current);
    }
    if (Kind(left) == units.Literal && Kind(right) == units.Literal) {
        return Evaluation.Evaluated(units.Empty(units.Literal), current);
    }
    return Evaluation.Evaluated(units.Empty(units.Unknown), current);
}
Product :: (current: State, range: Range, left: units.Unit, right: units.Unit, sign: int) -> Evaluation {
    switch units.Product(left, right, sign) {
        case .Product(value, overflow):
            if (overflow) {
                current = Report(current, range, "Unit expression exceeds supported dimensional complexity");
            }
            return Evaluation.Evaluated(value, current);
    }
}
OpText :: (op: int) -> string {
    names: string[] = ["", "+", "-", "*", "/", "%", "", "", "", "", "==", "!=", "<", "<=", ">", ">="];
    if (op < 0 || op >= length(names)) {
        return "";
    }
    return names[op];
}
ResultSource :: (environment: Environment, index: int) -> int {
    expressions := Expressions(environment);
    symbols := Symbols(environment);
    depth: int = 0;
    while (index >= 0 && depth < 256) {
        value := expressions[index];
        if (value.kind == UnwrapExpression) {
            index = value.left;
        } else if (value.result_count != 0) {
            return index;
        } else if (value.kind == SymbolExpression && value.symbol >= 0) {
            index = symbols[value.symbol].initializer;
        } else {
            return index;
        }
        depth += 1;
    }
    return -1;
}
ResultUnit :: (environment: Environment, current: State, expression: Expression, index: int) -> Evaluation {
    range := Ranges(environment)[expression.range];
    if ((expression.kind == CallExpression || expression.kind == JoinExpression) && expression.right >= 0) {
        function := Functions(environment)[expression.right];
        if (index < function.result_count) {
            symbol := Symbols(environment)[SymbolIndices(environment)[function.result_start + index]];
            return Annotated(current, range, symbol.has_unit, symbol.unit);
        }
        return Evaluation.Evaluated(units.Empty(units.Unknown), current);
    }
    capability := CallCapability(environment, expression);
    if (capability >= 0) {
        row := Capabilities(environment)[capability];
        if (index < row.result_count) {
            port := Ports(environment)[row.result_start + index];
            return Annotated(current, range, port.has_unit, port.unit);
        }
    }
    return Evaluation.Evaluated(units.Empty(units.Unknown), current);
}
// Separate the symbol's dependency decision from evaluation. The iterative
// evaluator follows only the selected initializer or narrowing source.
SymbolSource :: struct {
    expression: int;
    known_only: bool;
    has_unit: bool;
    unit: string;
}
SymbolInput :: (environment: Environment, index: int) -> SymbolSource {
    symbol := Symbols(environment)[index];
    source: SymbolSource = {expression: -1, known_only: false, has_unit: false, unit: ""};
    if (symbol.has_unit) {
        source.has_unit = true;
        source.unit = symbol.unit;
        return source;
    }
    if (symbol.kind == GlobalSymbol) {
        for (row in Globals(environment)) {
            if (IDAt(environment, row.id_slot) == IDAt(environment, symbol.id_slot)) {
                source.has_unit = row.has_unit;
                source.unit = row.unit;
                return source;
            }
        }
        return source;
    }
    if (symbol.kind == LocalSymbol && symbol.initializer < 0) {
        for (condition in Expressions(environment)) {
            if (condition.kind == IsExpression && condition.symbol == index) {
                source.expression = condition.left;
                return source;
            }
        }
    }
    if ((symbol.kind != LocalSymbol && symbol.kind != ConstantSymbol && symbol.kind != StateSymbol && symbol.kind != SharedStateSymbol) || symbol.initializer < 0) {
        return source;
    }
    source.expression = symbol.initializer;
    source.known_only = true;
    return source;
}
QueryFieldSymbol :: (environment: Environment, expression: Expression) -> int {
    member := IDAt(environment, expression.member_slot);
    rows := Symbols(environment);
    for row, index in rows {
        if (IDAt(environment, row.id_slot) == member) {
            return index;
        }
    }
    return -1;
}
SymbolUnit :: (environment: Environment, current: State, index: int, range: Range) -> Evaluation {
    source := SymbolInput(environment, index);
    if (source.expression < 0) {
        return Annotated(current, range, source.has_unit, source.unit);
    }
    switch Eval(environment, current, source.expression) {
        case .Evaluated(value, next):
            if (!source.known_only || Kind(value) == units.Known) {
                return Evaluation.Evaluated(value, next);
            }
            return Evaluation.Evaluated(units.Empty(units.Unknown), next);
    }
}
MemberUnit :: (environment: Environment, current: State, expression: Expression) -> Evaluation {
    member := IDAt(environment, expression.member_slot);
    range := Ranges(environment)[expression.range];
    for (symbol in Symbols(environment)) {
        if (IDAt(environment, symbol.id_slot) == member && (symbol.kind == ParameterSymbol || symbol.kind == ResultSymbol)) {
            return Annotated(current, range, symbol.has_unit, symbol.unit);
        }
    }
    receiver := Expressions(environment)[expression.left];
    source := ResultSource(environment, expression.left);
    offset := IDAt(environment, expression.offset_slot);
    if (source >= 0) {
        original := Expressions(environment)[source];
        capability := CallCapability(environment, original);
        if ((original.kind == CallExpression || original.kind == JoinExpression) && capability >= 0) {
            row := Capabilities(environment)[capability];
            resultIndex := OffsetIndex(offset, row.result_count);
            if (resultIndex >= 0) {
                port := Ports(environment)[row.result_start + resultIndex];
                if (member == binding.ID("port", port.name)) {
                    return ResultUnit(environment, current, original, resultIndex);
                }
            }
        }
    }
    nominal := IDAt(environment, Types(environment)[receiver.type].nominal_slot);
    payload := CapabilityAt(environment, nominal);
    if ((Types(environment)[receiver.type].flags & ResultsFlag) != 0 && payload >= 0) {
        row := Capabilities(environment)[payload];
        parameterIndex := OffsetIndex(offset, row.param_count);
        if (row.kind == EventCapability && parameterIndex >= 0) {
            port := Ports(environment)[row.param_start + parameterIndex];
            return Annotated(current, range, port.has_unit, port.unit);
        }
    }
    for (type in CatalogTypes(environment)) {
        if (IDAt(environment, type.id_slot) == nominal) {
            index: int = 0;
            while (index < type.field_count) {
                field := Fields(environment)[type.field_start + index];
                if (IDAt(environment, field.id_slot) == member) {
                    return Annotated(current, range, field.has_unit, field.unit);
                }
                index += 1;
            }
            return Evaluation.Evaluated(units.Empty(units.Unknown), current);
        }
    }
    return Evaluation.Evaluated(units.Empty(units.Unknown), current);
}

// Parameter metadata is read immediately before its argument is visited.
// In particular, malformed annotations precede that argument's diagnostics.
CallTarget :: (environment: Environment, current: State, expression: Expression, argument: Argument) -> Evaluation {
    capability: int = -1;
    if (expression.right < 0) {
        capability = CallCapability(environment, expression);
    }
    parameter := argument.parameter;
    present := false;
    annotation := "";
    if (expression.right >= 0 && parameter >= 0 && parameter < Functions(environment)[expression.right].param_count) {
        function := Functions(environment)[expression.right];
        symbol := Symbols(environment)[SymbolIndices(environment)[function.param_start + parameter]];
        present = symbol.has_unit;
        annotation = symbol.unit;
    } else if (capability >= 0) {
        row := Capabilities(environment)[capability];
        if (parameter >= 0 && parameter < row.param_count) {
            port := Ports(environment)[row.param_start + parameter];
            present = port.has_unit;
            annotation = port.unit;
        } else if (row.event_sender && parameter >= row.param_count) {
            eventIndex := CapabilityAt(environment, IDAt(environment, expression.member_slot));
            parameter -= row.param_count;
            if (eventIndex >= 0 && parameter < Capabilities(environment)[eventIndex].param_count) {
                port := Ports(environment)[Capabilities(environment)[eventIndex].param_start + parameter];
                present = port.has_unit;
                annotation = port.unit;
            }
        } else if (row.variadic && row.param_count != 0 && parameter >= row.param_count) {
            port := Ports(environment)[row.param_start + row.param_count - 1];
            present = port.has_unit;
            annotation = port.unit;
        }
    }
    return Annotated(current, Ranges(environment)[argument.range], present, annotation);
}
Operation :: (environment: Environment, current: State, expression: Expression, left: units.Unit, right: units.Unit) -> Evaluation {
    if (expression.right < 0) {
        if (expression.op == OpNegate || expression.op == OpNone) {
            return Evaluation.Evaluated(left, current);
        }
        return Evaluation.Evaluated(units.Empty(units.Unknown), current);
    }
    range := Ranges(environment)[expression.range];
    if (expression.op == OpMultiply) {
        return Product(current, range, left, right, 1);
    }
    if (expression.op == OpDivide) {
        return Product(current, range, left, right, -1);
    }
    if (expression.op == OpAdd || expression.op == OpSubtract || expression.op == OpModulo) {
        return Match(current, range, left, OpText(expression.op), right);
    }
    if (expression.op >= OpEqual && expression.op <= OpGreaterEqual) {
        switch Match(current, range, left, OpText(expression.op), right) {
            case .Evaluated(ignored, next):
                return Evaluation.Evaluated(units.Empty(units.Unknown), next);
        }
    }
    return Evaluation.Evaluated(units.Empty(units.Unknown), current);
}

// One pending expression owns one continuation and one saved operand. Child
// results flow through value; only selected dependencies are pushed. Keeping
// source depth in arrays leaves every callable's ordinary depth limit intact.
Work :: struct {
    expression: int;
    phase: int;
    argument: int;
    catalog: int;
}
Enter: int : 0;
Finish: int : 1;
KnownOnly: int : 2;
Left: int : 3;
Right: int : 4;
ArgumentsPhase: int : 5;
ArgumentPhase: int : 6;
WorkValue :: (expression: int) -> Work {
    row: Work = {expression: expression, phase: Enter, argument: 0, catalog: -1};
    return row;
}
Eval :: (environment: Environment, current: State, index: int) -> Evaluation {
    frames: Work[] = [];
    saved: units.Unit[] = [];
    frames.append(WorkValue(index));
    saved.append(units.Empty(units.Unknown));
    value := units.Empty(units.Unknown);
    while (length(frames) > 0) {
        top := length(frames) - 1;
        work := frames[top];
        if (work.phase == Enter) {
            value = units.Empty(units.Unknown);
            visited := work.expression < 0;
            if (!visited) {
                switch current {
                    case .Cached(cache, terms, visits, diagnostics):
                        visited = visits[work.expression] != 0;
                        if (visits[work.expression] == 2) {
                            row := cache[work.expression];
                            value = units.Unit.Value(row.kind, slice(terms, row.term_start, row.term_count));
                        }
                        if (!visited) {
                            current = State.Cached(cache, terms, set_array_elem(visits, work.expression, int(1)), diagnostics);
                        }
                }
            }
            // A VISITING backedge yields unknown without writing the cache.
            // DONE reads likewise create no new terms or diagnostics.
            if (visited) {
                frames = slice(frames, 0, top);
                saved = slice(saved, 0, top);
                continue;
            }
        }
        if (work.phase == Finish) {
            switch value {
                case .Value(kind, added):
                    switch current {
                        case .Cached(cache, terms, visits, diagnostics):
                            row: Cache = {kind: kind, term_start: length(terms), term_count: length(added)};
                            current = State.Cached(set_array_elem(cache, work.expression, row), extend(terms, added), set_array_elem(visits, work.expression, int(2)), diagnostics);
                    }
            }
            frames = slice(frames, 0, top);
            saved = slice(saved, 0, top);
            continue;
        }
        expression := Expressions(environment)[work.expression];
        range := Ranges(environment)[expression.range];
        descend := false;
        child: int = -1;
        if (work.phase == Enter) {
            work.phase = Finish;
            if (expression.kind == ConstantExpression) {
                if (Numeric(Types(environment)[expression.type], environment)) {
                    value = units.Empty(units.Literal);
                }
            } else if (expression.kind == SymbolExpression || expression.kind == QueryFieldExpression) {
                index := expression.symbol;
                if (expression.kind == QueryFieldExpression) {
                    index = QueryFieldSymbol(environment, expression);
                }
                source: SymbolSource = {expression: -1, known_only: false, has_unit: false, unit: ""};
                if (index >= 0) {
                    source = SymbolInput(environment, index);
                }
                if (source.expression < 0) {
                    switch Annotated(current, range, source.has_unit, source.unit) {
                        case .Evaluated(unit, next):
                            value = unit;
                            current = next;
                    }
                } else {
                    if (source.known_only) {
                        work.phase = KnownOnly;
                    }
                    child = source.expression;
                    descend = true;
                }
            } else if (expression.kind == UnaryExpression || expression.kind == BinaryExpression || expression.kind == FallbackExpression) {
                work.phase = Left;
                child = expression.left;
                descend = true;
            } else if (expression.kind == CastExpression || expression.kind == AsExpression || expression.kind == UnwrapExpression) {
                child = expression.left;
                descend = true;
            } else if (expression.kind == CallExpression) {
                work.phase = ArgumentsPhase;
            } else if (expression.kind == JoinExpression) {
                if (expression.result_count == 1) {
                    switch ResultUnit(environment, current, expression, 0) {
                        case .Evaluated(unit, next):
                            value = unit;
                            current = next;
                    }
                }
            } else if (expression.kind == StructExpression && expression.arg_count > 0) {
                nominal := IDAt(environment, Types(environment)[expression.type].nominal_slot);
                rows := CatalogTypes(environment);
                catalog: int = 0;
                while (catalog < length(rows) && work.catalog < 0) {
                    if (IDAt(environment, rows[catalog].id_slot) == nominal) {
                        work.catalog = catalog;
                    }
                    catalog += 1;
                }
                if (work.catalog >= 0) {
                    work.phase = ArgumentsPhase;
                }
            } else if (expression.kind == MemberExpression) {
                switch MemberUnit(environment, current, expression) {
                    case .Evaluated(unit, next):
                        value = unit;
                        current = next;
                }
            }
        } else if (work.phase == KnownOnly) {
            if (Kind(value) != units.Known) {
                value = units.Empty(units.Unknown);
            }
            work.phase = Finish;
        } else if (work.phase == Left) {
            saved[top] = value;
            if (expression.kind == FallbackExpression) {
                work.phase = ArgumentsPhase;
            } else if (expression.right < 0) {
                switch Operation(environment, current, expression, value, units.Empty(units.Unknown)) {
                    case .Evaluated(unit, next):
                        value = unit;
                        current = next;
                }
                work.phase = Finish;
            } else {
                work.phase = Right;
                child = expression.right;
                descend = true;
            }
        } else if (work.phase == Right) {
            switch Operation(environment, current, expression, saved[top], value) {
                case .Evaluated(unit, next):
                    value = unit;
                    current = next;
            }
            work.phase = Finish;
        } else if (work.phase == ArgumentsPhase) {
            if (work.argument >= expression.arg_count) {
                value = units.Empty(units.Unknown);
                if (expression.kind == FallbackExpression) {
                    value = saved[top];
                }
                if (expression.kind == CallExpression && !expression.task && expression.result_count == 1) {
                    switch ResultUnit(environment, current, expression, 0) {
                        case .Evaluated(unit, next):
                            value = unit;
                            current = next;
                    }
                }
                work.phase = Finish;
            } else {
                argument := Arguments(environment)[expression.arg_start + work.argument];
                if (expression.kind == FallbackExpression && argument.value == expression.left) {
                    work.argument += 1;
                } else {
                    if (expression.kind == CallExpression) {
                        switch CallTarget(environment, current, expression, argument) {
                            case .Evaluated(unit, next):
                                saved[top] = unit;
                                current = next;
                        }
                    } else if (expression.kind == StructExpression) {
                        type := CatalogTypes(environment)[work.catalog];
                        field := Fields(environment)[type.field_start + argument.parameter];
                        switch Annotated(current, Ranges(environment)[argument.range], field.has_unit, field.unit) {
                            case .Evaluated(unit, next):
                                saved[top] = unit;
                                current = next;
                        }
                    }
                    work.phase = ArgumentPhase;
                    child = argument.value;
                    descend = true;
                }
            }
        } else if (work.phase == ArgumentPhase) {
            argument := Arguments(environment)[expression.arg_start + work.argument];
            op := "=";
            if (expression.kind == CallExpression) {
                op = "argument";
            }
            if (expression.kind == FallbackExpression) {
                op = "fallback";
            }
            switch Match(current, Ranges(environment)[argument.range], saved[top], op, value) {
                case .Evaluated(unit, next):
                    if (expression.kind == FallbackExpression) {
                        saved[top] = unit;
                    }
                    current = next;
            }
            work.argument += 1;
            work.phase = ArgumentsPhase;
        }
        frames[top] = work;
        if (descend) {
            frames.append(WorkValue(child));
            saved.append(units.Empty(units.Unknown));
        }
    }
    return Evaluation.Evaluated(value, current);
}
Assignment :: (environment: Environment, current: State, statement: Statement) -> State {
    target := units.Empty(units.Unknown);
    value := units.Empty(units.Unknown);
    range := Ranges(environment)[statement.range];
    if (statement.expression >= 0) {
        switch Eval(environment, current, statement.expression) {
            case .Evaluated(unit, next):
                target = unit;
                current = next;
        }
    } else if (statement.symbol >= 0) {
        switch SymbolUnit(environment, current, statement.symbol, range) {
            case .Evaluated(unit, next):
                target = unit;
                current = next;
        }
    }
    switch Eval(environment, current, statement.second) {
        case .Evaluated(unit, next):
            value = unit;
            current = next;
    }
    if (statement.op == OpNone || statement.op == OpAdd || statement.op == OpSubtract || statement.op == OpModulo) {
        if (Clash(target, value)) {
            op := "=";
            if (statement.op != OpNone) {
                op = format_text("{}=", OpText(statement.op));
            }
            return ReportUnits(current, range, target, op, value);
        }
    } else if (statement.op == OpMultiply || statement.op == OpDivide) {
        if (Kind(target) == units.Known && Kind(value) == units.Known) {
            switch value {
                case .Value(kind, terms):
                    if (length(terms) > 0) {
                        sign: int = 1;
                        if (statement.op == OpDivide) {
                            sign = -1;
                        }
                        switch Product(current, range, target, value, sign) {
                            case .Evaluated(productValue, next):
                                return Report(next, range, format_text("Units differ: {}= would turn {} into {}", OpText(statement.op), units.Format(target, 192), units.Format(productValue, 192)));
                        }
                    }
            }
        }
    }
    return current;
}
pub Analyze :: (environment: Environment) -> Analysis {
    cache: Cache[] = [];
    visits: int[] = [];
    terms: units.Term[] = [];
    diagnostics: syntax.Diagnostic[] = [];
    for (expression in Expressions(environment)) {
        row: Cache = {kind: units.Unknown, term_start: 0, term_count: 0};
        cache.append(row);
        visits.append(int(0));
    }
    current := State.Cached(cache, terms, visits, diagnostics);
    for (symbol in Symbols(environment)) {
        if (symbol.has_unit) {
            range := Ranges(environment)[symbol.range];
            target := units.Empty(units.Unknown);
            switch Annotated(current, range, true, symbol.unit) {
                case .Evaluated(value, next):
                    target = value;
                    current = next;
            }
            if (symbol.initializer >= 0) {
                switch Eval(environment, current, symbol.initializer) {
                    case .Evaluated(value, next):
                        switch Match(next, range, target, "default", value) {
                            case .Evaluated(ignored, final):
                                current = final;
                        }
                }
            }
        }
    }
    index: int = 0;
    while (index < length(Expressions(environment))) {
        switch Eval(environment, current, index) {
            case .Evaluated(ignored, next):
                current = next;
        }
        index += 1;
    }
    for (statement in Statements(environment)) {
        if (statement.kind == AssignStatement || statement.kind == ReduceStatement) {
            current = Assignment(environment, current, statement);
        }
    }
    for (bindingRow in Bindings(environment)) {
        target := units.Empty(units.Unknown);
        switch Eval(environment, current, bindingRow.target) {
            case .Evaluated(value, next):
                target = value;
                current = next;
        }
        switch Eval(environment, current, bindingRow.value) {
            case .Evaluated(value, next):
                current = next;
                if (Clash(target, value)) {
                    current = ReportUnits(current, Ranges(environment)[bindingRow.range], target, "=", value);
                }
        }
    }
    switch current {
        case .Cached(rows, names, done, errors):
            return Analysis.Completed(rows, names, errors);
    }
}
