version 3
name "SdfCameraCenteredOrbit"
id_counter 133
description "Sixteen-second full camera orbit around the unchanged analytic-gradient study. Constant target and distance; yaw and roll pi/2 align the orbit with the original image vertical axis."
owner_type "ecs.entity"
(array)variables {
    - id=1 name="elapsed" type="float"
}
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 2
                type "Event"
                reference_name "Tick"
                outputs {
                    DeltaSeconds id=4 type="float" kind="data"
                }
            }
            - {
                id 17
                type "Behavior Expression"
                reference_name "elapsed += dt"
                inputs {
                    Exec id=21 kind="exec"
                    elapsed {
                        id 18
                        type "float"
                        binding kind="variable" source_asset="SdfCameraCenteredOrbit" name="elapsed"
                    }
                    dt {
                        id 19
                        type "double"
                        binding kind="delta_time"
                    }
                }
                outputs {
                    Then id=22 kind="exec"
                    Result id=20 type="float"
                }
            }
            - {
                id 69
                type "Behavior Expression"
                reference_name "pitch = elapsed * (2 * pi / 16)"
                inputs {
                    Exec id=73 kind="exec"
                    pitch {
                        id 70
                        type "float"
                        binding kind="component_field" component="GAME.GameCamera" field="pitch"
                    }
                    elapsed {
                        id 71
                        type "double"
                        binding kind="variable" source_asset="SdfCameraCenteredOrbit" name="elapsed"
                    }
                }
                outputs {
                    Then id=74 kind="exec"
                    Result id=72 type="float"
                }
            }
        }
        (array)edges {
            - from="2.Then" to="17.Exec"
            - from="17.Then" to="69.Exec"
        }
    }
    - id=5 kind="function" math_expression="elapsed += dt" entry_id=24
    - id=40 kind="function" math_expression="pitch = elapsed * (2 * pi / 16)" entry_id=76
}
