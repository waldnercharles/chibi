version 1
name "Lantern Yard"
(array)entities {
    - {
        name "Lighting"
        prototype "Lighting"
        (array)behaviors
    }
    - {
        name "Camera"
        prototype "Camera"
        (array)behaviors
    }
    - {
        name "Yard"
        prototype "Yard"
        (array)behaviors
    }
    - {
        name "Lantern"
        prototype "Lantern"
        components {
            GameTransform x=0.0 y=-10.0
        }
        (array)behaviors
    }
    - {
        name "Crate"
        prototype "Prop"
        components {
            GameTransform x=-70.0 y=20.0
            GameSprite image="content/images/props.png" frame=1 frame_width=16 frame_height=16 layer=1
        }
        (array)behaviors
    }
    - {
        name "Mossy Crate"
        prototype "Prop"
        components {
            GameTransform x=-50.0 y=20.0
            GameSprite image="content/images/props.png" frame=1 frame_width=16 frame_height=16 layer=1
            GameMaterial scene=0x9fe0a0ff albedo=0x9fe0a0ff
        }
        (array)behaviors
    }
    - {
        name "Arrow"
        prototype "Prop"
        components {
            GameTransform x=50.0 y=-30.0
            GameSprite image="content/images/props.png" frame=2 frame_width=16 frame_height=16 layer=1
        }
        (array)behaviors
    }
    - {
        name "Flipped Arrow"
        prototype "Prop"
        components {
            GameTransform x=50.0 y=-10.0
            GameSprite image="content/images/props.png" frame=2 frame_width=16 frame_height=16 flip_x=#true layer=1
        }
        (array)behaviors
    }
    - {
        name "Turned Arrow"
        prototype "Prop"
        components {
            GameTransform x=80.0 y=-20.0
            GameSprite image="content/images/props.png" frame=2 frame_width=16 frame_height=16 layer=1
            GameOrientation radians=0.7854
        }
        (array)behaviors
    }
    - {
        name "Gem"
        prototype "Prop"
        components {
            GameTransform x=-80.0 y=-40.0
            GameSprite image="content/images/props.png" frame=3 frame_width=16 frame_height=16 layer=1
            GameMaterial scene=0xffffffff albedo=0xffffffff emission_color=0x40e0d0ff emission_intensity=0.25 emission_multiplier=1.0
        }
        (array)behaviors
    }
    - {
        name "Sheet"
        prototype "Sheet"
        components {
            GameTransform x=0.0 y=55.0
        }
        (array)behaviors
    }
    - {
        name "Decorative Mosaic"
        prototype "TileMosaic"
        (array)behaviors
    }
}
