package package_compiler

import snapshot "project:source_snapshot"
import syntax "project:syntax_diagnostics"
import strings "core:strings"

// Readers over the snapshot's syntax forest. Links are global node indices,
// -1 when absent; offsets count bytes of the node's document text. Kinds and
// fields are syntax_diagnostics constants; a token's kind is its tk kind.

// The first named, non-extra node at or after `link` among its siblings.
Member :: (forest: snapshot.SnapshotNode[], link: int) -> int {
    at := link;
    while (at >= 0 && (!forest[at].is_named || forest[at].is_extra)) {
        at = forest[at].next_sibling;
    }
    return at;
}
// The members of `parent`, in order.
Members :: (forest: snapshot.SnapshotNode[], parent: int) -> int[] {
    found: int[] = [];
    member := FirstMember(forest, parent);
    while (member >= 0) {
        found.append(member);
        member = NextMember(forest, member);
    }
    return found;
}
FirstMember :: (forest: snapshot.SnapshotNode[], parent: int) -> int {
    if (parent < 0) {
        return -1;
    }
    return Member(forest, forest[parent].first_child);
}
NextMember :: (forest: snapshot.SnapshotNode[], node: int) -> int {
    return Member(forest, forest[node].next_sibling);
}
// The child holding `field`, named or not.
Field :: (forest: snapshot.SnapshotNode[], node: int, field: int) -> int {
    if (node < 0) {
        return -1;
    }
    child := forest[node].first_child;
    while (child >= 0) {
        if (forest[child].field == field) {
            return child;
        }
        child = forest[child].next_sibling;
    }
    return -1;
}
Is :: (forest: snapshot.SnapshotNode[], node: int, kind: int) -> bool {
    return node >= 0 && forest[node].kind == kind;
}
// Whether `parent` has a direct, non-extra token of kind `token`, such as tk.Question.
HasToken :: (forest: snapshot.SnapshotNode[], parent: int, token: int) -> bool {
    child := forest[parent].first_child;
    while (child >= 0) {
        if (!forest[child].is_extra && forest[child].kind == token) {
            return true;
        }
        child = forest[child].next_sibling;
    }
    return false;
}
// The operator of a node that has none, and the operation of a plain `=`.
NoOperator: int : 0;
// The kind of `node`'s operator: a tk kind such as tk.Add, syntax.NotIn for
// `not in`, syntax.Min or syntax.Max; NoOperator when it has none.
Operator :: (forest: snapshot.SnapshotNode[], node: int) -> int {
    operator := Field(forest, node, syntax.FieldOperator);
    if (operator < 0) {
        return NoOperator;
    }
    return forest[operator].kind;
}
Text :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> string {
    if (node < 0) {
        return "";
    }
    return strings.Slice(text, forest[node].start, forest[node].end - forest[node].start);
}
Diagnose :: (forest: snapshot.SnapshotNode[], node: int, document: int, message: string) -> syntax.Diagnostic {
    item := forest[node];
    return {start: item.start, end: item.end, line: item.row + 1, column: item.column + 1,
            document: document, message: message};
}
