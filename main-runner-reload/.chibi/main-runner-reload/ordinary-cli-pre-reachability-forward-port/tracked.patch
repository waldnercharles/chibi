+            usleep(10000);
+        }
+        close(master);
+        deadline = chibi_process_now() + 2;
+        do {
+            root_retired |= group_gone(process.pid);
+            child_retired |= known && pid_gone(child);
+            group_retired |= known && group_gone(group);
+            if (root_retired &&
+                (!known || (child_retired && (group != child || group_retired)))) {
