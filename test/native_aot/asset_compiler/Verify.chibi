package native_asset_tests

import os "core:os"
import strings "core:strings"

Fixture :: struct { program: string; folder: string; }
Path :: (parts: string[]) -> string { return strings.Concatenate(parts); }
Write :: (path: string, text: string) {
    result := os.WriteText(path, text);
    assert(result == nil, "write asset fixture");
}
Read :: (path: string) -> string {
    result := os.ReadText(path);
    assert(result.error == nil, "read asset fixture");
    return result.text;
}
// Existing outputs must survive both compiler rejection and invalid requests.
Invoke :: (fixture: Fixture, name: string, request: string, status: int, diagnostic: string) -> string {
    input := Path([fixture.folder, "/", name, ".json"]);
    output := Path([fixture.folder, "/", name, ".chibip"]);
    rejected := Path([fixture.folder, "/", name, ".diagnostic"]);
    Write(input, request);
    Write(output, "unchanged");
    Write(rejected, "unchanged");
    result := os.Capture([fixture.program, input, output, rejected]);
    if (result.status != status) { os.Print(Path([name, ": ", result.stderr])); }
    assert(result.status == status, "asset compiler status");
    assert(!os.Exists(Path([output, ".partial"])), "temporary output removed");
    if (status != 0) {
        assert(Read(output) == "unchanged", "rejection preserves the output");
        assert(Read(rejected) == diagnostic, "the first diagnostic or preserved file");
    } else {
        assert(strings.HasPrefix(Read(output), "CHIBICLO"), "prepared closure output");
        assert(Read(rejected) == "unchanged", "success preserves diagnostic output");
    }
    return output;
}
Main :: () -> int {
    arguments := os.Arguments();
    assert(length(arguments) == 5, "asset service, catalog, scratch and optional legacy pair");
    fixture: Fixture = {program: arguments[0], folder: arguments[2]};
    catalog := strings.TrimSpace(Read(arguments[1]));
    catalog = strings.Slice(catalog, 1, strings.ByteLength(catalog) - 2);
    prefix := "[\"/project\",[],[],[\"Main.chibi\"],[\"package main\\nMain :: () -> int { return 42; }\\n\"],false,";
    suffix := ",[],[],[],[],[],0,2,2,[]]";
    request := Path([prefix, catalog, suffix]);
    output := Invoke(fixture, "simple", request, 0, "unchanged");
    digest := os.HashFile(output);
    // Frozen from the VM-hosted compiler, then loaded there to return 42.
    assert(digest.error == nil && digest.digest == "08b7ec6ca8d209820e44ddbda3151b5f8b866334fd45cc7f06124794279f3dc9", "reference closure bytes");
    if (arguments[3] != "") {
        reference := Path([fixture.folder, "/reference.chibip"]);
        input := Path([fixture.folder, "/simple.json"]);
        compiled := os.Capture([arguments[3], "--artifact", arguments[4], "--entry", "0xf10ff1d6771d8100",
            "--input", input, "--backend", "sljit", "--budget", "4000000000", "--timeout-ms", "120000",
            "--output-bytes", reference]);
        assert(compiled.status == 0 && Read(output) == Read(reference), "native and VM compile the same closure");
        empty := Path([fixture.folder, "/empty.json"]);
        Write(empty, "[]");
        ran := os.Capture([arguments[3], "--artifact", output, "--entry", "0x4c68f27f0be23827", "--input", empty,
            "--backend", "bytecode", "--budget", "10000", "--timeout-ms", "120000"]);
        assert(ran.status == 0 && strings.TrimSpace(ran.stdout) == "[42]", "the native-produced closure returns 42");
    }
    source_error := strings.ReplaceAll(request, "return 42;", "return missing;");
    rejected := Invoke(fixture, "source-error", source_error, 1, "0\n2\n28\nUnknown name 'missing'");
    native := "{\"name\":\"unused\",\"first\":0,\"parameters\":0,\"results\":1,\"variadic\":false,\"direct\":true,\"qualified_name\":\"unused\",\"kind\":0,\"intrinsic\":0,\"effects\":0}";
    port := "{\"name\":\"Result\",\"storage\":9,\"container\":0,\"c_string\":false,\"nominal\":0,\"has_default\":false,\"default_owner\":false,\"default_supported\":false,\"default_bits\":18446744073709551615,\"default_text\":\"\"}";
    rich_suffix := Path([",[", native, "],[", port, "],[18446744073709551615,18446744073709551615],[],[],0,2,2,[0]]"]);
    unsigned_catalog := Invoke(fixture, "unsigned-catalog", Path([prefix, catalog, rich_suffix]), 0, "unchanged");
    native_type := "{\"required\":false,\"underlying\":-1,\"name\":\"UnusedNamespace\",\"id\":18446744073709551615,\"layout\":18446744073709551615,\"storage\":0,\"size\":0,\"component\":0,\"first\":0,\"count\":1,\"relationship\":false,\"traits\":0,\"error\":false}";
    native_field := "{\"name\":\"field\",\"storage\":6,\"offset\":0,\"writable\":false,\"c_string\":false,\"record\":-1,\"constant\":false,\"read\":-1,\"read_key\":\"\"}";
    typed_suffix := Path([",[],[],[],[", native_type, "],[", native_field, "],0,2,2,[]]"]);
    typed_catalog := Invoke(fixture, "typed-catalog", Path([prefix, catalog, typed_suffix]), 0, "unchanged");
    cases := [
        strings.Replace(request, "false", "\"false\"", 1),
        strings.ReplaceAll(request, "12807983651649450734", "18446744073709551616"),
        strings.ReplaceAll(request, ",0,2,2,[]]", ",0,2147483648,2,[]]"),
        Path([strings.TrimSuffix(request, "]"), ",0]"]),
        strings.TrimSuffix(request, ",[]]"),
        Path([strings.TrimSuffix(request, "]"), ",]"]),
        Path([request, " null"]),
        strings.Slice(request, 0, strings.ByteLength(request) - 2),
        strings.ReplaceAll(request, "\"pointer_size\":8", "\"pointer_size\":8,\"pointer_size\":8"),
        strings.ReplaceAll(request, "\"pointer_size\"", "\"unknown\""),
        strings.ReplaceAll(request, "\"/project\"", "\"/pro\\qject\"")
    ];
    for (bad, index in cases) {
        invalid := Invoke(fixture, format_text("invalid-{}", index), bad, 2, "unchanged");
    }
    limited := Path([fixture.folder, "/limited.chibip"]);
    limited_diagnostic := Path([fixture.folder, "/limited.diagnostic"]);
    Write(limited, "unchanged");
    Write(limited_diagnostic, "unchanged");
    for (budget in ["1", "0", "-1", "18446744073709551616", "words"]) {
        expected := 2;
        if (budget == "1") { expected = 125; }
        ran := os.Capture([fixture.program, Path([fixture.folder, "/simple.json"]), limited, limited_diagnostic, budget]);
        assert(ran.status == expected && Read(limited) == "unchanged" && Read(limited_diagnostic) == "unchanged", "quota rejection preserves output files");
    }
    // A failed publication removes the temporary file and preserves a directory.
    directory := Path([fixture.folder, "/cannot-replace"]);
    made := os.MakeDirectory(directory);
    assert(made == nil, "make publication rejection fixture");
    failed := os.Capture([fixture.program, Path([fixture.folder, "/simple.json"]), directory,
                         Path([fixture.folder, "/unused-diagnostic"])]);
    assert(failed.status == 2 && os.IsDirectory(directory) && !os.Exists(Path([directory, ".partial"])), "failed publication cleans its own temporary file");
    os.Print("native asset compiler relocation, closures, diagnostics and request rejection passed");
    return 0;
}
