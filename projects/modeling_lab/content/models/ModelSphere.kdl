version 3
name "ModelSphere"
domain "model"
id_counter 6
description "A sphere with computed bounds; radius is measured in local project units."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Sphere"
                inputs Radius=30.0
            }
        }
        (array)edges {
            - from="3.Geometry" to="1.Geometry"
        }
    }
}
