    reference_name: pickupCount == 0
    inputs:
      Exec: {id: 3938, kind: exec}
      pickupCount: {id: 3936, type: double, flags: 0}
    outputs:
      "True": {id: 3939, kind: exec}
      "False": {kind: exec}
      Result: {id: 3937, type: bool}
