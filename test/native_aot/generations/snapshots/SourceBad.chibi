package retained_source
foreign import libc "system:c"
foreign libc {
    fopen :: (path: cstring, mode: cstring) -> rawptr
    fclose :: (file: rawptr) -> i32
}
Node :: struct { changed: string; values: int[]; }
Payload :: union { Text(value: string) | Nodes(value: Node[]) }
State :: struct { names: string[]; nodes: Node[]; payload: Payload; }
Mark :: (path: string) {
    file := fopen(path, "w");
    assert(file != 0);
    assert(fclose(file) == 0);
}
Text :: (n: int) -> string { return text_from_bytes([u8(65), u8(0), u8(n)]); }
Main :: () -> int { return 0; }
Frame :: () -> int {
    count: retain int = 0;
    progress: retain State = {names: [], nodes: [], payload: Payload.Text("seed")};
    count += 1;
    if count == 1 {
        progress.names = [Text(1), Text(2)];
        progress.nodes = [{changed: Text(3), values: [7, 9]}];
        progress.payload = Payload.Nodes(progress.nodes);
    }
    assert(length(progress.names) == 2 && text_byte_at(progress.names[0], 2) == 1);
    assert(length(progress.nodes) == 1 && progress.nodes[0].values[1] == 9);
    switch progress.payload {
        case .Nodes(value): assert(value[0].values[0] == 7 && text_byte_at(value[0].changed, 2) == 3);
        case .Text(value): assert(false);
    }
    if count == 3 { Mark("ready"); }
    return 0;
}
