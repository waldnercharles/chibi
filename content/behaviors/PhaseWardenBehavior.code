behavior "PhaseWardenBehavior" {
    state "Orbit Radius": float = 72.0;
    state "Move Speed": float = 55.0;
    value find_nearest_entity = find_nearest_entity(Position: &component("GAME.GameTransform"), Radius: 2000.0, Categories: 1, Exclude: 0);
    value scene_rhythm = scene_rhythm();
    value cosine = cosine(Value: scene_rhythm.Phase);
    value sine = sine(Value: scene_rhythm.Phase);
    value multiply = multiply(A: float = cosine, B: float = &state."Orbit Radius");
    value multiply_2 = multiply(A: float = sine, B: float = &state."Orbit Radius");
    value make_cf_v2 = make_cf_v2(x: multiply, y: multiply_2);
    value add = add(A: struct<"CF_V2"> = find_nearest_entity.Position, B: struct<"CF_V2"> = make_cf_v2);
    value direction_to = direction_to(Origin: &component("GAME.GameTransform"), Target: add);
    value multiply_3 = multiply(A: float = direction_to.Direction.x, B: float = &state."Move Speed");
    value multiply_4 = multiply(A: float = direction_to.Direction.y, B: float = &state."Move Speed");
    on Tick as tick() {
        if (find_nearest_entity.Found) {
            set_game_velocity(Value: make_game_velocity(x: multiply_3, y: multiply_4));
        } else {
            set_game_velocity(Value: {
                x: 0.0,
                y: 0.0
            });
        }
    }
}
