package constant_ir

// These are resolved analyzer facts. References are pool indices; a negative
// child/initializer denotes absence. Nonnegative references and argument spans
// obey the same invariants as the analyzer's owned expression graph.
// Scalar folding also requires type-correct operator result families and
// literal storage. Admissibility does not validate arbitrary hand-built IR.
pub Type :: struct {
    storage: int;
    container: int;
    flags: int;
    has_nominal: bool;
}
pub Expression :: struct {
    kind: int;
    op: int;
    type: int;
    literal: int;
    symbol: int;
    left: int;
    right: int;
    arg_start: int;
    arg_count: int;
    effects: int;
    conversion: int; // Cast range policy: 0 exact, 1 wrap, 2 clamp.
}
pub Symbol :: struct {
    kind: int;
    initializer: int;
}
pub Argument :: struct {
    value: int;
}

// Enum and bit-mask values retain the existing semantic and value ABI.
pub Constant: int : 1;
pub SymbolReference: int : 2;
pub Unary: int : 3;
pub Binary: int : 4;
pub Cast: int : 5;
pub Member: int : 7;
pub Index: int : 9;
pub Array: int : 10;
pub Record: int : 14;
pub Nil: int : 15;
pub Union: int : 21;
pub ConstantSymbol: int : 14;
pub Single: int : 0;
pub Boolean: int : 1;
pub String: int : 13;
pub Untyped: int : 16;
pub Literal: int : 1024;
