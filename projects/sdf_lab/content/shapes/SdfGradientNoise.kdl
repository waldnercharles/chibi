version 3
name "SdfGradientNoise"
domain "shape"
bounds_x 48.0
bounds_y 48.0
id_counter 40
description "Small spatial-noise displacement deliberately exercises tetrahedral fallback in Analytic normal mode."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Shader Shape Output"
            - id=3 type="Shader ObjectPosition"
            - {
                id 37
                type "Behavior Expression"
                reference_name "length(position) - 30 + 0.05 * noise(position, 0.15)"
                inputs {
                    position id=38 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=39 type="float"
                }
            }
        }
        (array)edges {
            - from="3.Value" to="37.position"
            - from="37.Result" to="1.Distance"
        }
    }
    - id=5 kind="function" math_expression="length(position) - 30 + 0.05 * noise(position, 0.15)" expression_mode=1 entry_id=6
}
