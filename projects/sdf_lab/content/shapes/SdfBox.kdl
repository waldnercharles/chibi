version 3
name "SdfBox"
domain "shape"
bounds_x 48.0
bounds_y 48.0
id_counter 115
description "Exact box for a matched comparison with the engine's triangle box."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Shader Shape Output"
            - id=3 type="Shader ObjectPosition"
            - {
                id 32
                type "Behavior Expression"
                reference_name "abs(p) - vec3(30, 22, 30)"
                inputs {
                    p id=33 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=34 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 69
                type "Behavior Expression"
                reference_name "length(max(offset, 0)) + min(max(max(offset.x, offset.y), offset.z), 0)"
                inputs {
                    offset id=70 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=71 type="float"
                }
            }
        }
        (array)edges {
            - from="3.Value" to="32.p"
            - from="32.Result" to="69.offset"
            - from="69.Result" to="1.Distance"
        }
    }
    - id=7 kind="function" math_expression="abs(p) - vec3(30, 22, 30)" entry_id=8
    - id=35 kind="function" math_expression="length(max(offset, 0)) + min(max(max(offset.x, offset.y), offset.z), 0)" entry_id=73
}
