version 3
name "StudyShipEngine"
domain "model"
id_counter 51
description "Reusable hollow engine with an editable radius, named casing and glowing exhaust."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - id=6 type="Model Material Slot" reference_name="Casing" reference_asset="ShipMetal"
            - id=8 type="Model Material Slot" reference_name="Exhaust" reference_asset="ShipGlow"
            - {
                id 10
                type "Model Parameter"
                reference_name "Radius"
                inputs Default=10.0 Minimum=8.0 Maximum=14.0
            }
            - {
                id 15
                type "Model Cylinder"
                inputs "Half Height"=19.0
            }
            - {
                id 19
                type "Model Cylinder"
                inputs Radius=6.0 "Half Height"=22.0
            }
            - id=23 type="Model Difference"
            - id=27 type="Model Part" reference_name="Engine casing"
            - {
                id 31
                type "Model Cylinder"
                inputs Radius=5.8
            }
            - {
                id 35
                type "Model Translate"
                inputs {
                    Offset {
                        default x=0.0 y=-15.0 z=0.0
                    }
                }
            }
            - id=39 type="Model Part" reference_name="Exhaust disk"
            - id=43 type="Model Union"
            - {
                id 47
                type "Model Rotate"
                inputs {
                    Angles {
                        default x=1.5707964 y=0.0 z=0.0
                    }
                }
            }
        }
        (array)edges {
            - from="6.Slot" to="27.Material"
            - from="8.Slot" to="39.Material"
            - from="10.Value" to="15.Radius"
            - from="15.Geometry" to="23.A"
            - from="19.Geometry" to="23.B"
            - from="23.Geometry" to="27.Geometry"
            - from="27.Geometry" to="43.A"
            - from="31.Geometry" to="35.Geometry"
            - from="35.Geometry" to="39.Geometry"
            - from="39.Geometry" to="43.B"
            - from="43.Geometry" to="47.Geometry"
            - from="47.Geometry" to="1.Geometry"
        }
    }
}
