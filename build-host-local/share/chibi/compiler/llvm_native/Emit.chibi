package llvm_native

import abi "project:native_abi"
import strings "core:strings"

// A scalar backend. This is not the prepared/pin_value ABI: arguments and
// results are native LLVM values. Slots and locals are private stack storage,
// never observable pointers. A module that calls the runtime, through Format
// or Fail, takes its context, native_abi.ContextType(), as every function's
// hidden first parameter, as Odin's procedures take theirs.
pub Instruction :: struct {
    op: int;
    type: int;
    output: int;
    left: int;
    right: int;
    target: int;
    literal: i64;
}
// One function of a module: consecutive ranges of the module's parameter,
// slot, local, code and argument tables, in function order. A call's argument
// slots are arguments[first_argument + right, + target) of its own function.
pub Function :: struct {
    result: int;
    first_parameter: int;
    parameters: int;
    first_slot: int;
    slots: int;
    first_local: int;
    locals: int;
    first_code: int;
    code: int;
    first_argument: int;
    arguments: int;
}
pub Result :: union {
    Rejected(instruction: int, message: string) | Emitted(text: string)
}
// A record type: the module's field types fields[first, first + count), each
// a scalar. Type RecordType + r is records[r], an LLVM struct of its fields
// in order, passed and returned by value between the module's functions.
pub Record :: struct {
    first: int;
    count: int;
}
pub RecordType: int : 32;
// The source file of a module's line tables and its directory. An empty file
// emits no debug information, and the module is the same text as without it.
pub Source :: struct {
    file: string;
    directory: string;
}

// output = literal: a scalar's value or encoding, a record's zero, or a
// string's text, texts[literal] of the module's text table.
pub Constant: int : 0;
pub Argument: int : 1;
pub Local: int : 2;
pub Save: int : 3;
pub Publish: int : 4;
pub Return: int : 5;
pub End: int : 6;
pub Add: int : 7;
pub Sub: int : 8;
pub Mul: int : 9;
pub Div: int : 10;
pub Mod: int : 11;
pub Neg: int : 12;
pub BitAnd: int : 13;
pub BitOr: int : 14;
pub BitXor: int : 15;
pub BitNot: int : 16;
pub Shl: int : 17;
pub Shr: int : 18;
pub Lt: int : 19;
pub Le: int : 20;
pub Gt: int : 21;
pub Ge: int : 22;
pub Eq: int : 23;
pub Ne: int : 24;
pub Branch: int : 25;
pub Jump: int : 26;
pub Check: int : 27;
// output = callee(arguments...): left is the callee's function index, and
// the argument slots are this function's arguments[right, right + target).
pub Call: int : 28;
// output = type(left): right is the left slot's type. Between integer types,
// literal 0 clamps the value to type while 1 keeps its low bits. A float or
// double converts to an integer type in either mode by truncating toward
// zero, saturating at the type's bounds, with NaN as 0. An integer or a float
// converts to double, and a double to float, rounding to nearest.
pub Convert: int : 29;
// output = the left slot's record with field `literal` replaced by the right
// slot's value; type is the record type.
pub Insert: int : 30;
// output = field `literal` of the left slot's record, whose type is right;
// type is the field's type.
pub Extract: int : 31;
// output = the byte count of the left slot's string, an int.
pub TextLength: int : 32;
// output = the byte of the left slot's string at the right slot's int index,
// 0 to 255, or -1 outside the string, an int.
pub TextByte: int : 33;
// output = the left slot's string without its first bytes, as many as the
// right slot's int, clamped to the string.
pub TextDrop: int : 34;
// output = the first bytes of the left slot's string, as many as the right
// slot's int, clamped to the string. Both slices are views of the string's
// bytes.
pub TextTake: int : 35;
// output = format_text(arguments...), a string the runtime makes: the
// argument slots are this function's arguments[right, right + target), a
// string format then numbers, bools and strings, as a call's are. The string
// lives until the call from the VM returns.
pub Format: int : 36;
// Ends the call from the VM with the failure of the assert at source bytes
// [left, right) of the function whose stable ID is `literal`: the context's
// failure names it, a native_abi.FailureType() constant, and this function,
// and each call it is in, returns its result's zero.
pub Fail: int : 37;
// An array type is ArrayType plus its element's type, a scalar, a string or a
// record, and an array holds no array: an LLVM { i32, i32, ptr }, its length,
// its capacity and its elements, by value. Its zero, the Constant of literal
// 0, is the empty array, which owns no memory. The runtime context allocates
// an array's elements and ends the program on an index outside the array
// (D9). An array is a value, so two variables never share elements: a
// producer copies with ArrayCopy where it would otherwise share them, and a
// callee that changes a parameter copies it first. ArraySet and ArrayPush
// change their array's elements in place.
pub ArrayType: int : 1024;
// output = the length of the left slot's array, an int.
pub ArrayLength: int : 38;
// output = the left slot's array element at the right slot's int index, of
// type; an index outside the array ends the program.
pub ArrayGet: int : 39;
// output = the left slot's array with its element at the right slot's int
// index replaced by the value in slot `target`; type is the array type. An
// index outside the array ends the program.
pub ArraySet: int : 40;
// output = the left slot's array with the right slot's value appended; type
// is the array type. The elements move to a larger allocation when they are
// full.
pub ArrayPush: int : 41;
// output = an array of its own elements equal to the left slot's; type is
// the array type.
pub ArrayCopy: int : 42;
// output = the left slot's array with the right slot's array's elements
// after its own; type is the array type. Like ArrayPush, it changes the
// elements the left slot holds, and moves them when they do not fit.
pub ArrayExtend: int : 43;
// output = a new array of the elements of the left slot's array from the
// right slot's int start, as many as the int count in slot `target`, each
// clamped to the array.
pub ArraySlice: int : 44;
// output = a new array of the right slot's int length, 0 if it is negative:
// the first elements of the left slot's array, then zeros.
pub ArrayResize: int : 45;
// output = whether an element of the left slot's array equals the right
// slot's value, a bool; literal is the element type, a number, bool or
// string. A string is equal by its bytes, and a float as IEEE compares it.
pub ArrayContains: int : 46;
// output = the left slot's array without its element at the right slot's int
// index, or as it is for an index outside it; type is the array type. The
// elements after the removed move down in place.
pub ArrayRemove: int : 47;

Index :: (value: int, count: int) -> bool {
    return value >= 0 && value < count;
}
Typed :: (slots: int[], slot: int, type: int) -> bool {
    return Index(slot, length(slots)) && slots[slot] == type;
}
Produces :: (op: int) -> bool {
    return op <= Local || (op >= Add && op <= Ne) || (op >= Call && op <= Format) || (op >= ArrayLength && op <= ArrayRemove);
}
Comparison :: (op: int) -> bool {
    return op >= Lt && op <= Ne;
}
Unary :: (op: int) -> bool {
    return op == Neg || op == BitNot;
}
ReadsLeft :: (op: int) -> bool {
    return op == Save || op == Publish || op == Branch || (op >= Add && op <= Ne) || (op >= Convert && op <= TextTake) ||
           (op >= ArrayLength && op <= ArrayRemove);
}
Integer :: (type: int) -> bool {
    return abi.IntegerBits(type) > 0;
}
// Whether `literal` is a value of `type`: 0 or 1 for bool, for an integer
// type its range, except that a 64-bit unsigned value is its bit pattern, and
// for a float or double its IEEE encoding.
Fits :: (literal: i64, type: int) -> bool {
    if (type == abi.FloatStorage) {
        return literal >= 0 && literal < i64(1) << u32(32);
    }
    if (type == abi.DoubleStorage) {
        return true;
    }
    if (!Integer(type)) {
        return literal == 0 || literal == 1;
    }
    bits := abi.IntegerBits(type);
    if (bits == 64) {
        return true;
    }
    if (abi.Unsigned(type)) {
        return literal >= 0 && literal < (i64(1) << u32(bits));
    }
    half := i64(1) << u32(bits - 1);
    return literal >= 0 - half && literal < half;
}
ReadsRight :: (op: int) -> bool {
    return (op >= Add && op <= Ne && !Unary(op)) || op == Insert || (op >= TextByte && op <= TextTake) ||
           ArrayReadsRight(op);
}
// Whether an array instruction reads a right slot: an index, an element,
// another array or a length.
ArrayReadsRight :: (op: int) -> bool {
    return op >= ArrayGet && op != ArrayCopy;
}
// Whether an instruction reads the slot its target names: an array store's
// value or a slice's count.
ReadsTarget :: (op: int) -> bool {
    return op == ArraySet || op == ArraySlice;
}
// Whether an array instruction calls the runtime context: an index check, or
// an allocation.
ArrayCalls :: (op: int) -> bool {
    return op == ArrayGet || op == ArraySet || op == ArrayPush || op == ArrayCopy || op == ArrayExtend ||
           op == ArraySlice || op == ArrayResize;
}
// Whether an instruction reads argument slots: a call's or a format's.
ReadsArguments :: (op: int) -> bool {
    return op == Call || op == Format;
}
// The element type of array type `type`, or 0 when it is no array of a
// scalar, a string or one of the module's records.
ElementType :: (records: Record[], type: int) -> int {
    element := type - ArrayType;
    if (element <= 0 || element >= ArrayType || !Valued(records, element)) {
        return 0;
    }
    return element;
}
// Whether `type` is a scalar, a string, one of the module's records or an
// array of one of them.
Valued :: (records: Record[], type: int) -> bool {
    if (type >= ArrayType) {
        return ElementType(records, type) != 0;
    }
    return abi.ScalarType(type) != "" || type == abi.TextStorage || Index(type - RecordType, length(records));
}
// The LLVM type of a scalar, string, record or array type the module holds.
TypeName :: (type: int) -> string {
    if (type >= ArrayType) {
        return abi.ArrayType();
    }
    if (type >= RecordType) {
        return format_text("%record{}", type - RecordType);
    }
    if (type == abi.TextStorage) {
        return abi.TextType();
    }
    return abi.ScalarType(type);
}
// The type of field `field` of record type `type`, or 0 when `type` is no
// record of the module or has no such field.
FieldType :: (records: Record[], fields: int[], type: int, field: i64) -> int {
    if (!Index(type - RecordType, length(records))) {
        return 0;
    }
    record := records[type - RecordType];
    if (field < 0 || field >= i64(record.count)) {
        return 0;
    }
    return fields[record.first + int(field)];
}
// Records partition the field table in order, each with at least one scalar or
// string field.
RecordLayout :: (records: Record[], fields: int[]) -> bool {
    first: int = 0;
    for (record in records) {
        if (record.first != first || record.count < 1 || record.count > length(fields) - first) {
            return false;
        }
        first += record.count;
    }
    if (first != length(fields)) {
        return false;
    }
    for (type in fields) {
        if (!Valued(records, type)) {
            return false;
        }
    }
    for (index in 0..<length(records)) {
        if (Nests(records, fields, index, index, 0)) {
            return false;
        }
    }
    return true;
}
// Whether record `from` holds record `wanted` by value, directly or through
// the records it holds. An array holds its elements apart. `depth` bounds the
// walk for cycles that do not reach `wanted`.
Nests :: (records: Record[], fields: int[], from: int, wanted: int, depth: int) -> bool {
    if (depth > length(records)) {
        return true;
    }
    record := records[from];
    for (index in record.first..<record.first + record.count) {
        type := fields[index];
        if (type < RecordType || type >= ArrayType) {
            continue;
        }
        if (type - RecordType == wanted || Nests(records, fields, type - RecordType, wanted, depth + 1)) {
            return true;
        }
    }
    return false;
}
// Whether the backend computes `op` in `type`: every operation on integers,
// IEEE arithmetic other than remainders and every comparison on floats,
// equality and negation on bool, and equality on strings.
Computes :: (op: int, type: int) -> bool {
    if (type == abi.TextStorage) {
        return op == Eq || op == Ne;
    }
    if (Integer(type)) {
        return true;
    }
    if (abi.Floating(type)) {
        return op == Add || op == Sub || op == Mul || op == Div || Comparison(op);
    }
    return type == abi.BoolStorage && (op == Eq || op == Ne || op == BitNot);
}
// The conversions the backend implements, as the runtime's casts: integers
// to one another and to double, float and double to one another and to the
// integers. An integer becomes a float only through double.
Converts :: (from: int, to: int) -> bool {
    if (to == abi.FloatStorage) {
        return from == abi.DoubleStorage;
    }
    if (to == abi.DoubleStorage) {
        return Integer(from) || from == abi.FloatStorage;
    }
    return Integer(to) && (Integer(from) || abi.Floating(from));
}
// The instructions control may reach next from `pc` of valid code, whose
// last instruction cannot fall through.
Successors :: (code: Instruction[], pc: int) -> int[] {
    item := code[pc];
    next: int[] = [];
    if (item.op == Jump || item.op == Branch) {
        next.append(item.target);
    }
    if (item.op != Jump && item.op != Return && item.op != End && item.op != Fail) {
        next.append(pc + 1);
    }
    return next;
}
// Every scalar slot is single-definition in the shared frontend's code.
// Check dominance too: an arbitrary branch may not bypass its definition.
// This check includes every reachable input edge, not just lexical instruction order.
Dominates :: (code: Instruction[], definition: int, use: int) -> bool {
    if (definition < 0 || definition >= use) {
        return false;
    }
    seen := resize([false], length(code));
    pending: int[] = [0];
    while (length(pending) > 0) {
        pc := pending[length(pending) - 1];
        pending = slice(pending, 0, length(pending) - 1);
        if (pc == definition || seen[pc]) {
            continue;
        }
        if (pc == use) {
            return false;
        }
        seen[pc] = true;
        pending.extend(Successors(code, pc));
    }
    return true;
}
// values[first, first + count), which the caller has bounded.
Part :: (values: int[], first: int, count: int) -> int[] {
    part: int[] = [];
    for (index in 0..<count) {
        part.append(values[first + index]);
    }
    return part;
}
Codes :: (code: Instruction[], first: int, count: int) -> Instruction[] {
    part: Instruction[] = [];
    for (index in 0..<count) {
        part.append(code[first + index]);
    }
    return part;
}
// Functions partition every table in order, so no range overlaps another or
// leaves a row unowned. Each count is checked before it is summed.
Layout :: (functions: Function[], parameters: int[], slots: int[], locals: int[], code: Instruction[],
           arguments: int[]) -> bool {
    if (length(functions) < 1) {
        return false;
    }
    at: Function = {result: 0, first_parameter: 0, parameters: 0, first_slot: 0, slots: 0, first_local: 0,
                    locals: 0, first_code: 0, code: 0, first_argument: 0, arguments: 0};
    for (item in functions) {
        // Each count is checked against what remains of its table, so no
        // sum wraps.
        if (item.parameters < 0 || item.slots < 0 || item.locals < 0 || item.code < 1 || item.arguments < 0 ||
            item.parameters > length(parameters) - at.first_parameter || item.slots > length(slots) - at.first_slot ||
            item.locals > length(locals) - at.first_local || item.code > length(code) - at.first_code ||
            item.arguments > length(arguments) - at.first_argument || item.first_parameter != at.first_parameter ||
            item.first_slot != at.first_slot || item.first_local != at.first_local ||
            item.first_code != at.first_code || item.first_argument != at.first_argument) {
            return false;
        }
        at.first_parameter += item.parameters;
        at.first_slot += item.slots;
        at.first_local += item.locals;
        at.first_code += item.code;
        at.first_argument += item.arguments;
    }
    return at.first_parameter == length(parameters) && at.first_slot == length(slots) &&
           at.first_local == length(locals) && at.first_code == length(code) &&
           at.first_argument == length(arguments);
}
// A format reads a string format, then numbers, bools and strings, from its
// argument slots, to give a string.
FormatValid :: (slots: int[], arguments: int[], item: Instruction) -> bool {
    if (item.type != abi.TextStorage || item.left != 0 || item.target < 1 || item.right < 0 ||
        item.right > length(arguments) - item.target ||
        !Typed(slots, arguments[item.right], abi.TextStorage)) {
        return false;
    }
    for (index in 1..<item.target) {
        slot := arguments[item.right + index];
        if (!Index(slot, length(slots)) || abi.ValueTag(slots[slot]) == 0) {
            return false;
        }
    }
    return true;
}
// A call names another function of the module, with its result type and one
// argument slot of each parameter's type.
CallValid :: (functions: Function[], parameters: int[], slots: int[], arguments: int[], item: Instruction) -> bool {
    if (!Index(item.left, length(functions))) {
        return false;
    }
    callee := functions[item.left];
    if (item.type != callee.result || item.target != callee.parameters || item.right < 0 ||
        item.right > length(arguments) - item.target) {
        return false;
    }
    for (index in 0..<item.target) {
        if (!Typed(slots, arguments[item.right + index], parameters[callee.first_parameter + index])) {
            return false;
        }
    }
    return true;
}
Validate :: (functions: Function[], function: int, module_parameters: int[], module_slots: int[],
             module_locals: int[], module_code: Instruction[], module_arguments: int[], records: Record[],
             fields: int[], texts: string[], mode: int) -> Result {
    shape := functions[function];
    parameters := Part(module_parameters, shape.first_parameter, shape.parameters);
    slots := Part(module_slots, shape.first_slot, shape.slots);
    locals := Part(module_locals, shape.first_local, shape.locals);
    code := Codes(module_code, shape.first_code, shape.code);
    arguments := Part(module_arguments, shape.first_argument, shape.arguments);
    result := shape.result;
    // The exported entry takes and returns scalars: no foreign aggregate or
    // string ABI is promised.
    exported := function == 0 && mode != NoEntry;
    if (!Valued(records, result) || (exported && abi.ScalarType(result) == "") ||
        (mode == MainEntry && exported && (length(parameters) != 0 || result != 6))) {
        return Result.Rejected(-1, "unsupported native scalar signature or table size");
    }
    for (type in parameters) {
        if (!Valued(records, type) || (exported && abi.ScalarType(type) == "")) {
            return Result.Rejected(-1, "unsupported native scalar parameter");
        }
    }
    for (type in slots) {
        if (!Valued(records, type)) {
            return Result.Rejected(-1, "native scalar slot cannot hold a managed value or pointer");
        }
    }
    for (type in locals) {
        if (!Valued(records, type)) {
            return Result.Rejected(-1, "native scalar local cannot hold a managed value or pointer");
        }
    }
    definitions: int[] = [];
    for (slot in slots) {
        definitions.append(int(-1));
    }
    base := shape.first_code;
    pc: int = 0;
    while (pc < length(code)) {
        item := code[pc];
        if (item.op < Constant || item.op > ArrayRemove) {
            return Result.Rejected(base + pc, "unsupported native scalar instruction");
        }
        if (Produces(item.op)) {
            output := item.type;
            if (Comparison(item.op)) {
                output = 1;
            }
            if (!Typed(slots, item.output, output) || definitions[item.output] != -1) {
                return Result.Rejected(base + pc, "native scalar output has an invalid type or multiple definitions");
            }
            definitions[item.output] = pc;
        }
        // A record's only constant is its zero, and a string's is a text of
        // the table.
        if (item.op == Constant && ((abi.ScalarType(item.type) != "" && !Fits(item.literal, item.type)) ||
                                    (item.type >= RecordType && item.literal != 0) ||
                                    (item.type == abi.TextStorage &&
                                     (item.literal < 0 || item.literal >= i64(length(texts)))))) {
            return Result.Rejected(base + pc, "native constant is outside its type");
        }
        if (item.op == Argument && !Typed(parameters, item.left, item.type)) {
            return Result.Rejected(base + pc, "native argument type differs from its signature");
        }
        if (item.op == Local && !Typed(locals, item.left, item.type)) {
            return Result.Rejected(base + pc, "native local read has an invalid type");
        }
        if (item.op == Save && (!Typed(slots, item.left, item.type) ||
                                !Typed(locals, item.target, item.type))) {
            return Result.Rejected(base + pc, "native local write has an invalid type");
        }
        if (item.op == Publish && (item.type != result || item.target != 0 ||
                                   !Typed(slots, item.left, result))) {
            return Result.Rejected(base + pc, "native return value differs from its signature");
        }
        if (item.op >= Add && item.op <= Ne) {
            if (!Computes(item.op, item.type) || !Typed(slots, item.left, item.type) ||
                (ReadsRight(item.op) && !Typed(slots, item.right, item.type))) {
                return Result.Rejected(base + pc, "native scalar operand type mismatch");
            }
        }
        if (item.op == Convert && (!Converts(item.right, item.type) || !Typed(slots, item.left, item.right) ||
                                   (item.literal != 0 && item.literal != 1))) {
            return Result.Rejected(base + pc, "native conversion is not one the backend implements");
        }
        if (item.op == Insert) {
            field := FieldType(records, fields, item.type, item.literal);
            if (field == 0 || !Typed(slots, item.left, item.type) || !Typed(slots, item.right, field)) {
                return Result.Rejected(base + pc, "native field write differs from its record");
            }
        }
        if (item.op == Extract) {
            field := FieldType(records, fields, item.right, item.literal);
            if (field == 0 || field != item.type || !Typed(slots, item.left, item.right)) {
                return Result.Rejected(base + pc, "native field read differs from its record");
            }
        }
        if (item.op >= ArrayLength && item.op <= ArrayRemove && !ArrayValid(records, slots, item)) {
            return Result.Rejected(base + pc, "native array operation differs from its operands");
        }
        if (item.op >= TextLength && item.op <= TextTake && !TextValid(slots, item)) {
            return Result.Rejected(base + pc, "native text read differs from its operands");
        }
        if (item.op == Format && !FormatValid(slots, arguments, item)) {
            return Result.Rejected(base + pc, "native format differs from its operands");
        }
        if (item.op == Call && !CallValid(functions, module_parameters, slots, arguments, item)) {
            return Result.Rejected(base + pc, "native call differs from its callee's signature");
        }
        if (item.op == Fail && (item.left < 0 || item.right < item.left)) {
            return Result.Rejected(base + pc, "native failure names no source range");
        }
        if ((item.op == Branch || item.op == Jump) && !Index(item.target, length(code))) {
            return Result.Rejected(base + pc, "native branch target is out of range");
        }
        if (item.op == Branch && !Typed(slots, item.left, 1)) {
            return Result.Rejected(base + pc, "native branch requires bool");
        }
        if (pc + 1 == length(code) && item.op != Return && item.op != End && item.op != Jump && item.op != Fail) {
            return Result.Rejected(base + pc, "native scalar code falls outside its body");
        }
        pc += 1;
    }
    pc = 0;
    while (pc < length(code)) {
        item := code[pc];
        if (ReadsLeft(item.op) && !Dominates(code, definitions[item.left], pc)) {
            return Result.Rejected(base + pc, "native scalar left operand is not defined on every path");
        }
        if (ReadsRight(item.op) && !Dominates(code, definitions[item.right], pc)) {
            return Result.Rejected(base + pc, "native scalar right operand is not defined on every path");
        }
        if (ReadsTarget(item.op) && !Dominates(code, definitions[item.target], pc)) {
            return Result.Rejected(base + pc, "native scalar operand is not defined on every path");
        }
        if (ReadsArguments(item.op)) {
            for (index in 0..<item.target) {
                if (!Dominates(code, definitions[arguments[item.right + index]], pc)) {
                    return Result.Rejected(base + pc, "native call argument is not defined on every path");
                }
            }
        }
        pc += 1;
    }
    return Result.Emitted("");
}
// Whether an array instruction reads the slots of its operands' types. The
// array is the left slot's: ArrayLength reads any array and gives an int,
// ArrayGet one of type's elements, ArrayContains one of a number, bool or
// string array and the element, literal its type, to give a bool, and the
// others give the array type itself, ArraySet reading an int index right and a
// value in slot `target`, ArrayPush a value right, ArrayExtend another array,
// ArraySlice an int start right and an int count in slot `target`, and
// ArrayResize and ArrayRemove an int right.
ArrayValid :: (records: Record[], slots: int[], item: Instruction) -> bool {
    if (!Index(item.left, length(slots))) {
        return false;
    }
    held := slots[item.left];
    if (item.op == ArrayLength) {
        return item.type == abi.IntStorage && ElementType(records, held) != 0;
    }
    if (item.op == ArrayGet) {
        return item.type < ArrayType && item.type > 0 && held == ArrayType + item.type &&
               ElementType(records, held) != 0 && Typed(slots, item.right, abi.IntStorage);
    }
    if (item.op == ArrayContains) {
        searched := ElementType(records, held);
        return item.type == abi.BoolStorage && searched != 0 && searched < RecordType && item.literal == i64(searched) &&
               Typed(slots, item.right, searched);
    }
    element := ElementType(records, item.type);
    if (element == 0 || held != item.type) {
        return false;
    }
    if (item.op == ArraySet) {
        return Typed(slots, item.right, abi.IntStorage) && Typed(slots, item.target, element);
    }
    if (item.op == ArrayPush) {
        return Typed(slots, item.right, element);
    }
    if (item.op == ArrayExtend) {
        return Typed(slots, item.right, item.type);
    }
    if (item.op == ArraySlice) {
        return Typed(slots, item.right, abi.IntStorage) && Typed(slots, item.target, abi.IntStorage);
    }
    if (item.op == ArrayResize || item.op == ArrayRemove) {
        return Typed(slots, item.right, abi.IntStorage);
    }
    return true;
}
// Whether a text instruction reads a string and an int, or only a string for
// TextLength, to give its type: an int, or for a slice a string.
TextValid :: (slots: int[], item: Instruction) -> bool {
    output := abi.TextStorage;
    if (item.op <= TextByte) {
        output = abi.IntStorage;
    }
    return item.type == output && Typed(slots, item.left, abi.TextStorage) &&
           (item.op == TextLength || Typed(slots, item.right, abi.IntStorage));
}
Operation :: (op: int, type: int) -> string {
    if (abi.Floating(type)) {
        // Ordered comparisons are false for NaN; != is unordered, so true.
        operations := ["fadd", "fsub", "fmul", "fdiv", "", "", "", "", "", "", "", "", "fcmp olt", "fcmp ole",
                       "fcmp ogt", "fcmp oge", "fcmp oeq", "fcmp une"];
        return operations[op - Add];
    }
    if (abi.Unsigned(type) && op >= Lt && op <= Ge) {
        predicates := ["icmp ult", "icmp ule", "icmp ugt", "icmp uge"];
        return predicates[op - Lt];
    }
    if (op == Add) {
        return "add";
    }
    if (op == Sub) {
        return "sub";
    }
    if (op == Mul) {
        return "mul";
    }
    if (op == BitAnd) {
        return "and";
    }
    if (op == BitOr) {
        return "or";
    }
    if (op == BitXor) {
        return "xor";
    }
    if (op == Lt) {
        return "icmp slt";
    }
    if (op == Le) {
        return "icmp sle";
    }
    if (op == Gt) {
        return "icmp sgt";
    }
    if (op == Ge) {
        return "icmp sge";
    }
    if (op == Eq) {
        return "icmp eq";
    }
    return "icmp ne";
}
Load :: (name: string, type: int, bank: string, index: int) -> string {
    return format_text("  %{} = load {}, ptr %{}{}\n", name, TypeName(type), bank, index);
}
Store :: (value: string, type: int, bank: string, index: int) -> string {
    return format_text("  store {} {}, ptr %{}{}\n", TypeName(type), value, bank, index);
}
// Integer operations never fail: x / 0 is 0, x % 0 is x, MIN / -1 wraps to
// MIN and MIN % -1 is 0, and a shift count at or past the width, read
// unsigned, gives 0, or the sign fill for a signed >>. The divisor and count
// are made safe for LLVM before the operation, so no result is poison and no
// path traps.
Total :: (item: Instruction, pc: int) -> string {
    t := abi.ScalarType(item.type);
    bits := abi.IntegerBits(item.type);
    if ((item.op == Div || item.op == Mod) && abi.Unsigned(item.type)) {
        guard := format_text("  %zero{} = icmp eq {} %b{}, 0\n  %d{} = select i1 %zero{}, {} 1, {} %b{}\n", pc, t, pc, pc,
                             pc, t, t, pc);
        if (item.op == Div) {
            return format_text("{}  %q{} = udiv {} %a{}, %d{}\n  %v{} = select i1 %zero{}, {} 0, {} %q{}\n", guard, pc, t,
                               pc, pc, pc, pc, t, t, pc);
        }
        return format_text("{}  %q{} = urem {} %a{}, %d{}\n  %v{} = select i1 %zero{}, {} %a{}, {} %q{}\n", guard, pc, t,
                           pc, pc, pc, pc, t, pc, t, pc);
    }
    if (item.op == Div || item.op == Mod) {
        // format_text renders at most twelve arguments, so each line is its own.
        guards := format_text("  %zero{} = icmp eq {} %b{}, 0\n  %negone{} = icmp eq {} %b{}, -1\n", pc, t, pc, pc, t, pc);
        guards = format_text("{}  %unsafe{} = or i1 %zero{}, %negone{}\n  %d{} = select i1 %unsafe{}, {} 1, {} %b{}\n",
                             guards, pc, pc, pc, pc, pc, t, t, pc);
        if (item.op == Div) {
            quotient := format_text("  %q{} = sdiv {} %a{}, %d{}\n  %negated{} = sub {} 0, %a{}\n", pc, t, pc, pc, pc, t, pc);
            quotient = format_text("{}  %w{} = select i1 %negone{}, {} %negated{}, {} %q{}\n", quotient, pc, pc, t, pc, t,
                                   pc);
            return format_text("{}{}  %v{} = select i1 %zero{}, {} 0, {} %w{}\n", guards, quotient, pc, pc, t, t, pc);
        }
        remainder := format_text("  %q{} = srem {} %a{}, %d{}\n  %w{} = select i1 %negone{}, {} 0, {} %q{}\n", pc, t, pc,
                                 pc, pc, pc, t, t, pc);
        return format_text("{}{}  %v{} = select i1 %zero{}, {} %a{}, {} %w{}\n", guards, remainder, pc, pc, t, pc, t, pc);
    }
    wide := format_text("  %wide{} = icmp uge {} %b{}, {}\n", pc, t, pc, bits);
    if (item.op == Shr && !abi.Unsigned(item.type)) {
        return format_text("{}  %count{} = select i1 %wide{}, {} {}, {} %b{}\n  %v{} = ashr {} %a{}, %count{}\n", wide, pc,
                           pc, t, bits - 1, t, pc, pc, t, pc, pc);
    }
    operation := "shl";
    if (item.op == Shr) {
        operation = "lshr";
    }
    shifted := format_text("  %count{} = and {} %b{}, {}\n  %q{} = {} {} %a{}, %count{}\n", pc, t, pc, bits - 1, pc,
                           operation, t, pc, pc);
    return format_text("{}{}  %v{} = select i1 %wide{}, {} 0, {} %q{}\n", wide, shifted, pc, pc, t, t, pc);
}
// The least and greatest values of an integer type, as LLVM literals.
Least :: (type: int) -> string {
    if (abi.Unsigned(type)) {
        return "0";
    }
    lows := ["-128", "-32768", "-2147483648", "-9223372036854775808"];
    return lows[Width(type)];
}
Greatest :: (type: int) -> string {
    if (abi.Unsigned(type)) {
        highs := ["255", "65535", "4294967295", "18446744073709551615"];
        return highs[Width(type)];
    }
    highs := ["127", "32767", "2147483647", "9223372036854775807"];
    return highs[Width(type)];
}
// 0 to 3 for 8 to 64 bits.
Width :: (type: int) -> int {
    bits := abi.IntegerBits(type);
    if (bits == 8) {
        return 0;
    }
    if (bits == 16) {
        return 1;
    }
    if (bits == 32) {
        return 2;
    }
    return 3;
}
// The intrinsic that converts a float or double to an integer type, as the
// runtime does: truncating toward zero, saturating, with NaN as 0.
Saturating :: (from: int, to: int) -> string {
    sign := "s";
    if (abi.Unsigned(to)) {
        sign = "u";
    }
    bits := "f32";
    if (from == abi.DoubleStorage) {
        bits = "f64";
    }
    return format_text("llvm.fpto{}i.sat.{}.{}", sign, abi.ScalarType(to), bits);
}
// The conversion of a floating value, or of an integer to double.
Floated :: (item: Instruction, pc: int) -> string {
    source := abi.ScalarType(item.right);
    target := abi.ScalarType(item.type);
    if (Integer(item.type)) {
        return format_text("  %v{} = call {} @{}({} %a{})\n", pc, target, Saturating(item.right, item.type), source, pc);
    }
    operation := "fptrunc";
    if (item.right == abi.FloatStorage) {
        operation = "fpext";
    } else if (Integer(item.right) && abi.Unsigned(item.right)) {
        operation = "uitofp";
    } else if (Integer(item.right)) {
        operation = "sitofp";
    }
    return format_text("  %v{} = {} {} %a{} to {}\n", pc, operation, source, pc, target);
}
// An integer conversion widens its operand to i65, which holds every value of
// every integer type, then clamps it to the target's range or keeps its low
// bits. A clamp never becomes a plain truncation.
Conversion :: (item: Instruction, pc: int) -> string {
    if (abi.Floating(item.right) || abi.Floating(item.type)) {
        return Floated(item, pc);
    }
    source := abi.ScalarType(item.right);
    extend := "sext";
    if (abi.Unsigned(item.right)) {
        extend = "zext";
    }
    out := format_text("  %x{} = {} {} %a{} to i65\n", pc, extend, source, pc);
    value := format_text("%x{}", pc);
    if (item.literal == 0) {
        out = format_text("{}  %below{} = icmp slt i65 %x{}, {}\n  %raised{} = select i1 %below{}, i65 {}, i65 %x{}\n", out,
                          pc, pc, Least(item.type), pc, pc, Least(item.type), pc);
        out = format_text("{}  %above{} = icmp sgt i65 %raised{}, {}\n  %clamped{} = select i1 %above{}, i65 {}, i65 %raised{}\n",
                          out, pc, pc, Greatest(item.type), pc, pc, Greatest(item.type), pc);
        value = format_text("%clamped{}", pc);
    }
    return format_text("{}  %v{} = trunc i65 {} to {}\n", out, pc, value, abi.ScalarType(item.type));
}
// A float or double constant as `name`, from its encoding's bits, so every
// value, NaN and signed zero included, is exact.
Encoded :: (literal: i64, type: int, name: string) -> string {
    if (type == abi.FloatStorage) {
        return format_text("  %{} = bitcast i32 {} to float\n", name, Spelled(literal, abi.UintStorage));
    }
    return format_text("  %{} = bitcast i64 {} to double\n", name, literal);
}
// The zero a slot, local or result starts as, which is also a record's
// constant. A string's is empty text.
Zero :: (type: int) -> string {
    if (type >= RecordType || type == abi.TextStorage) {
        return "zeroinitializer";
    }
    if (abi.Floating(type)) {
        return "0.0";
    }
    return "0";
}
// A literal as LLVM spells it: the signed value of its bits at its width.
Spelled :: (literal: i64, type: int) -> i64 {
    bits := abi.IntegerBits(type);
    if (bits == 0 || bits == 64 || !abi.Unsigned(type) || literal < (i64(1) << u32(bits - 1))) {
        return literal;
    }
    return literal - (i64(1) << u32(bits));
}
EmitInstruction :: (item: Instruction, pc: int, result: int, records: Record[], fields: int[], texts: string[]) -> string {
    out := format_text("p{}:\n", pc);
    type := TypeName(item.type);
    if (item.op == Constant && item.type == abi.TextStorage) {
        literal := int(item.literal);
        text := format_text("{ ptr @{}, i32 {}, ptr null }", TextSymbol(literal), strings.ByteLength(texts[literal]));
        out = format_text("{}{}", out, Store(text, item.type, "s", item.output));
    } else if (item.op == Constant && item.type >= RecordType) {
        out = format_text("{}{}", out, Store(Zero(item.type), item.type, "s", item.output));
    } else if (item.op == Constant && abi.Floating(item.type)) {
        out = format_text("{}{}", out, Encoded(item.literal, item.type, format_text("v{}", pc)));
        out = format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    } else if (item.op == Constant) {
        out = format_text("{}{}", out, Store(format_text("{}", Spelled(item.literal, item.type)), item.type, "s", item.output));
    } else if (item.op == Argument) {
        out = format_text("{}{}", out, Store(format_text("%arg{}", item.left), item.type, "s", item.output));
    } else if (item.op == Local) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.type, "l", item.left));
        out = format_text("{}{}", out, Store(format_text("%a{}", pc), item.type, "s", item.output));
    } else if (item.op == Save) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.type, "s", item.left));
        out = format_text("{}{}", out, Store(format_text("%a{}", pc), item.type, "l", item.target));
    } else if (item.op == Publish) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.type, "s", item.left));
        out = format_text("{}{}", out, Store(format_text("%a{}", pc), item.type, "result", 0));
    } else if (item.op == Return || item.op == End) {
        out = format_text("{}{}", out, Load(format_text("return{}", pc), result, "result", 0));
        return format_text("{}{}", out, format_text("  ret {} %return{}\n", TypeName(result), pc));
    } else if (item.op == Branch) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), 1, "s", item.left));
        return format_text("{}{}", out, format_text("  br i1 %a{}, label %p{}, label %p{}\n", pc, item.target, pc + 1));
    } else if (item.op == Jump) {
        return format_text("{}{}", out, format_text("  br label %p{}\n", item.target));
    } else if (item.op == Check) {
        // CHECKs, not LLVM instructions, consume the caller's positive bound.
        // Compare before subtracting: exactly N CHECKs may pass a budget N.
        out = format_text("{}  %remaining{} = load i32, ptr %budget0\n  %available{} = icmp sgt i32 %remaining{}, 0\n  br i1 %available{}, label %budget_ok{}, label %trap\nbudget_ok{}:\n  %next_budget{} = sub i32 %remaining{}, 1\n  store i32 %next_budget{}, ptr %budget0\n",
                          out, pc, pc, pc, pc, pc, pc, pc, pc, pc);
    } else if (item.op == Convert) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.right, "s", item.left));
        out = format_text("{}{}", out, Conversion(item, pc));
        out = format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    } else if (item.op == Insert) {
        field := FieldType(records, fields, item.type, item.literal);
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.type, "s", item.left));
        out = format_text("{}{}", out, Load(format_text("b{}", pc), field, "s", item.right));
        out = format_text("{}  %v{} = insertvalue {} %a{}, {} %b{}, {}\n", out, pc, type, pc, TypeName(field), pc,
                          item.literal);
        out = format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    } else if (item.op == Extract) {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.right, "s", item.left));
        out = format_text("{}  %v{} = extractvalue {} %a{}, {}\n", out, pc, TypeName(item.right), pc, item.literal);
        out = format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    } else if (item.op >= ArrayLength && item.op <= ArrayRemove) {
        out = format_text("{}{}", out, ArrayRead(item, pc));
    } else if (item.op >= TextLength && item.op <= TextTake) {
        out = format_text("{}{}", out, TextRead(item, pc));
    } else if (item.type == abi.TextStorage) {
        // Strings are equal when their bytes are; != negates that.
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.type, "s", item.left));
        out = format_text("{}{}", out, Load(format_text("b{}", pc), item.type, "s", item.right));
        name := format_text("v{}", pc);
        if (item.op == Ne) {
            name = format_text("e{}", pc);
        }
        out = format_text("{}  %{} = call i1 @chibi_scalar.text_equal({} %a{}, {} %b{})\n", out, name, type, pc, type, pc);
        if (item.op == Ne) {
            out = format_text("{}  %v{} = xor i1 %e{}, true\n", out, pc, pc);
        }
        out = format_text("{}{}", out, Store(format_text("%v{}", pc), 1, "s", item.output));
    } else {
        out = format_text("{}{}", out, Load(format_text("a{}", pc), item.type, "s", item.left));
        if (Unary(item.op)) {
            if (item.op == Neg) {
                out = format_text("{}{}", out, format_text("  %v{} = sub {} 0, %a{}\n", pc, type, pc));
            } else {
                out = format_text("{}{}", out, format_text("  %v{} = xor {} %a{}, -1\n", pc, type, pc));
            }
        } else {
            out = format_text("{}{}", out, Load(format_text("b{}", pc), item.type, "s", item.right));
            if (Integer(item.type) && (item.op == Div || item.op == Mod || item.op == Shl || item.op == Shr)) {
                out = format_text("{}{}", out, Total(item, pc));
            } else {
                out = format_text("{}{}", out, format_text("  %v{} = {} {} %a{}, %b{}\n", pc, Operation(item.op, item.type),
                                                           type, pc, pc));
            }
        }
        output := item.type;
        if (Comparison(item.op)) {
            output = 1;
        }
        out = format_text("{}{}", out, Store(format_text("%v{}", pc), output, "s", item.output));
    }
    return format_text("{}{}", out, format_text("  br label %p{}\n", pc + 1));
}

// The operation of the context at field `field`, loaded as `name`.
ContextCall :: (name: string, field: int) -> string {
    out := format_text("  %{}.at = getelementptr inbounds {}, ptr %ctx, i32 0, i32 {}\n", name, abi.ContextType(), field);
    return format_text("{}  %{} = load ptr, ptr %{}.at\n", out, name, name);
}
// The context's allocate of `bytes`, an i64 value, as `name`.
Allocated :: (name: string, bytes: string) -> string {
    out := ContextCall(format_text("{}.allocate", name), 2);
    return format_text("{}  %{} = call ptr %{}.allocate(ptr %ctx, i64 {})\n", out, name, name, bytes);
}
// The byte size of one `type`, an i64 named `name`.
Sized :: (name: string, type: int) -> string {
    out := format_text("  %{}.at = getelementptr {}, ptr null, i32 1\n", name, TypeName(type));
    return format_text("{}  %{} = ptrtoint ptr %{}.at to i64\n", out, name, name);
}
// An array's length, an element, an element's replacement or an append, or a
// copy of its elements. A read or write is only inside the array, so none
// passes the elements, and an append that fills the array moves its elements
// to an allocation twice the size, or four elements.
ArrayRead :: (item: Instruction, pc: int) -> string {
    array := abi.ArrayType();
    // Every array type is the same LLVM type.
    out := Load(format_text("a{}", pc), ArrayType + abi.IntStorage, "s", item.left);
    out = format_text("{}  %length{} = extractvalue {} %a{}, 0\n", out, pc, array, pc);
    if (item.op == ArrayLength) {
        return format_text("{}{}", out, Store(format_text("%length{}", pc), item.type, "s", item.output));
    }
    if (item.op == ArrayCopy) {
        return format_text("{}{}", out, ArrayCopied(item, pc));
    }
    if (item.op == ArrayPush) {
        return format_text("{}{}", out, ArrayPushed(item, pc));
    }
    if (item.op == ArrayExtend) {
        return format_text("{}{}", out, ArrayExtended(item, pc));
    }
    if (item.op == ArraySlice) {
        return format_text("{}{}", out, ArraySliced(item, pc));
    }
    if (item.op == ArrayResize) {
        return format_text("{}{}", out, ArrayResized(item, pc));
    }
    if (item.op == ArrayContains) {
        return format_text("{}{}", out, ArrayFound(item, pc));
    }
    if (item.op == ArrayRemove) {
        return format_text("{}{}", out, ArrayRemoved(item, pc));
    }
    element := item.type;
    if (item.op == ArraySet) {
        element = item.type - ArrayType;
    }
    type := TypeName(element);
    out = format_text("{}{}", out, Load(format_text("b{}", pc), abi.IntStorage, "s", item.right));
    out = format_text("{}  %in{} = icmp ult i32 %b{}, %length{}\n", out, pc, pc, pc);
    out = format_text("{}  br i1 %in{}, label %inside{}, label %outside{}\noutside{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}{}", out, ContextCall(format_text("index{}", pc), 3));
    out = format_text("{}  call void %index{}(ptr %ctx, i32 %b{}, i32 %length{})\n  unreachable\ninside{}:\n", out, pc, pc,
                      pc, pc);
    out = format_text("{}  %data{} = extractvalue {} %a{}, 2\n  %offset{} = zext i32 %b{} to i64\n", out, pc, array, pc,
                      pc, pc);
    out = format_text("{}  %at{} = getelementptr inbounds {}, ptr %data{}, i64 %offset{}\n", out, pc, type, pc, pc);
    if (item.op == ArrayGet) {
        out = format_text("{}  %v{} = load {}, ptr %at{}\n", out, pc, type, pc);
        return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    }
    out = format_text("{}{}", out, Load(format_text("c{}", pc), element, "s", item.target));
    out = format_text("{}  store {} %c{}, ptr %at{}\n", out, type, pc, pc);
    return format_text("{}{}", out, Store(format_text("%a{}", pc), item.type, "s", item.output));
}
// The array of the elements of the array loaded as %a<pc> with the value in
// the right slot after them, in the allocation the elements already have
// when it has room.
ArrayPushed :: (item: Instruction, pc: int) -> string {
    array := abi.ArrayType();
    element := item.type - ArrayType;
    type := TypeName(element);
    out := Load(format_text("c{}", pc), element, "s", item.right);
    out = format_text("{}  %capacity{} = extractvalue {} %a{}, 1\n  %data{} = extractvalue {} %a{}, 2\n", out, pc, array,
                      pc, pc, array, pc);
    out = format_text("{}  %full{} = icmp eq i32 %length{}, %capacity{}\n", out, pc, pc, pc);
    out = format_text("{}  br i1 %full{}, label %grow{}, label %room{}\ngrow{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}  %none{} = icmp eq i32 %capacity{}, 0\n  %double{} = shl i32 %capacity{}, 1\n", out, pc, pc, pc,
                      pc);
    out = format_text("{}  %grown{} = select i1 %none{}, i32 4, i32 %double{}\n", out, pc, pc, pc);
    out = format_text("{}{}", out, Sized(format_text("width{}", pc), element));
    out = format_text("{}  %count{} = zext i32 %grown{} to i64\n  %bytes{} = mul i64 %count{}, %width{}\n", out, pc, pc,
                      pc, pc, pc);
    out = format_text("{}{}", out, Allocated(format_text("fresh{}", pc), format_text("%bytes{}", pc)));
    out = format_text("{}  %used{} = zext i32 %length{} to i64\n  %moved{} = mul i64 %used{}, %width{}\n", out, pc, pc,
                      pc, pc, pc);
    out = format_text("{}  call void @chibi_scalar.copy(ptr %fresh{}, ptr %data{}, i64 %moved{})\n", out,
                      pc, pc, pc);
    out = format_text("{}  br label %room{}\nroom{}:\n", out, pc, pc);
    out = format_text("{}  %buffer{} = phi ptr [ %data{}, %p{} ], [ %fresh{}, %grow{} ]\n", out, pc, pc, pc, pc, pc);
    out = format_text("{}  %space{} = phi i32 [ %capacity{}, %p{} ], [ %grown{}, %grow{} ]\n", out, pc, pc, pc, pc, pc);
    out = format_text("{}  %offset{} = zext i32 %length{} to i64\n", out, pc, pc);
    out = format_text("{}  %at{} = getelementptr inbounds {}, ptr %buffer{}, i64 %offset{}\n", out, pc, type, pc, pc);
    out = format_text("{}  store {} %c{}, ptr %at{}\n  %next{} = add i32 %length{}, 1\n", out, type, pc, pc, pc, pc);
    out = format_text("{}  %longer{} = insertvalue {} %a{}, i32 %next{}, 0\n", out, pc, array, pc, pc);
    out = format_text("{}  %roomy{} = insertvalue {} %longer{}, i32 %space{}, 1\n", out, pc, array, pc, pc);
    out = format_text("{}  %v{} = insertvalue {} %roomy{}, ptr %buffer{}, 2\n", out, pc, array, pc, pc);
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}
// The array of the elements of the array loaded as %a<pc> followed by those of
// the array in the right slot, in the allocation the first has when it has
// room, and otherwise in one of twice the size, or as many elements as it
// needs.
ArrayExtended :: (item: Instruction, pc: int) -> string {
    array := abi.ArrayType();
    element := item.type - ArrayType;
    type := TypeName(element);
    out := Load(format_text("o{}", pc), item.type, "s", item.right);
    out = format_text("{}  %capacity{} = extractvalue {} %a{}, 1\n  %data{} = extractvalue {} %a{}, 2\n", out, pc, array,
                      pc, pc, array, pc);
    out = format_text("{}  %extra{} = extractvalue {} %o{}, 0\n  %source{} = extractvalue {} %o{}, 2\n", out, pc, array,
                      pc, pc, array, pc);
    out = format_text("{}  %total{} = add i32 %length{}, %extra{}\n", out, pc, pc, pc);
    out = format_text("{}  %full{} = icmp ugt i32 %total{}, %capacity{}\n", out, pc, pc, pc);
    out = format_text("{}  br i1 %full{}, label %grow{}, label %room{}\ngrow{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}  %double{} = shl i32 %capacity{}, 1\n  %bigger{} = icmp ugt i32 %double{}, %total{}\n", out, pc,
                      pc, pc, pc, pc);
    out = format_text("{}  %grown{} = select i1 %bigger{}, i32 %double{}, i32 %total{}\n", out, pc, pc, pc, pc);
    out = format_text("{}{}", out, Sized(format_text("width{}", pc), element));
    out = format_text("{}  %count{} = zext i32 %grown{} to i64\n  %bytes{} = mul i64 %count{}, %width{}\n", out, pc, pc,
                      pc, pc, pc);
    out = format_text("{}{}", out, Allocated(format_text("fresh{}", pc), format_text("%bytes{}", pc)));
    out = format_text("{}  %used{} = zext i32 %length{} to i64\n  %moved{} = mul i64 %used{}, %width{}\n", out, pc, pc,
                      pc, pc, pc);
    out = format_text("{}  call void @chibi_scalar.copy(ptr %fresh{}, ptr %data{}, i64 %moved{})\n", out, pc, pc, pc);
    out = format_text("{}  br label %room{}\nroom{}:\n", out, pc, pc);
    out = format_text("{}  %buffer{} = phi ptr [ %data{}, %p{} ], [ %fresh{}, %grow{} ]\n", out, pc, pc, pc, pc, pc);
    out = format_text("{}  %space{} = phi i32 [ %capacity{}, %p{} ], [ %grown{}, %grow{} ]\n", out, pc, pc, pc, pc, pc);
    out = format_text("{}{}", out, Sized(format_text("size{}", pc), element));
    out = format_text("{}  %offset{} = zext i32 %length{} to i64\n", out, pc, pc);
    out = format_text("{}  %at{} = getelementptr inbounds {}, ptr %buffer{}, i64 %offset{}\n", out, pc, type, pc, pc);
    out = format_text("{}  %added{} = zext i32 %extra{} to i64\n  %extent{} = mul i64 %added{}, %size{}\n", out, pc, pc,
                      pc, pc, pc);
    out = format_text("{}  call void @chibi_scalar.copy(ptr %at{}, ptr %source{}, i64 %extent{})\n", out, pc, pc, pc);
    out = format_text("{}  %longer{} = insertvalue {} %a{}, i32 %total{}, 0\n", out, pc, array, pc, pc);
    out = format_text("{}  %roomy{} = insertvalue {} %longer{}, i32 %space{}, 1\n", out, pc, array, pc, pc);
    out = format_text("{}  %v{} = insertvalue {} %roomy{}, ptr %buffer{}, 2\n", out, pc, array, pc, pc);
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}
// A new array of the elements of the array loaded as %a<pc> from the start in
// the right slot, as many as the count in slot `target`, each clamped to the
// array, or the empty array for none.
ArraySliced :: (item: Instruction, pc: int) -> string {
    array := abi.ArrayType();
    element := item.type - ArrayType;
    type := TypeName(element);
    out := Load(format_text("b{}", pc), abi.IntStorage, "s", item.right);
    out = format_text("{}{}", out, Load(format_text("c{}", pc), abi.IntStorage, "s", item.target));
    out = format_text("{}  %data{} = extractvalue {} %a{}, 2\n", out, pc, array, pc);
    out = format_text("{}  %below{} = icmp slt i32 %b{}, 0\n  %low{} = select i1 %below{}, i32 0, i32 %b{}\n", out, pc,
                      pc, pc, pc, pc);
    out = format_text("{}  %over{} = icmp sgt i32 %low{}, %length{}\n  %first{} = select i1 %over{}, i32 %length{}, i32 %low{}\n",
                      out, pc, pc, pc, pc, pc, pc, pc);
    out = format_text("{}  %room{} = sub i32 %length{}, %first{}\n", out, pc, pc, pc);
    out = format_text("{}  %less{} = icmp slt i32 %c{}, 0\n  %want{} = select i1 %less{}, i32 0, i32 %c{}\n", out, pc,
                      pc, pc, pc, pc);
    out = format_text("{}  %more{} = icmp sgt i32 %want{}, %room{}\n  %n{} = select i1 %more{}, i32 %room{}, i32 %want{}\n",
                      out, pc, pc, pc, pc, pc, pc, pc);
    out = format_text("{}  %none{} = icmp eq i32 %n{}, 0\n", out, pc, pc);
    out = format_text("{}  br i1 %none{}, label %done{}, label %clone{}\nclone{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}{}", out, Sized(format_text("width{}", pc), element));
    out = format_text("{}  %count{} = zext i32 %n{} to i64\n  %bytes{} = mul i64 %count{}, %width{}\n", out, pc, pc, pc,
                      pc, pc);
    out = format_text("{}{}", out, Allocated(format_text("fresh{}", pc), format_text("%bytes{}", pc)));
    out = format_text("{}  %skip{} = zext i32 %first{} to i64\n", out, pc, pc);
    out = format_text("{}  %from{} = getelementptr inbounds {}, ptr %data{}, i64 %skip{}\n", out, pc, type, pc, pc);
    out = format_text("{}  call void @chibi_scalar.copy(ptr %fresh{}, ptr %from{}, i64 %bytes{})\n", out, pc, pc, pc);
    out = format_text("{}  br label %done{}\ndone{}:\n", out, pc, pc);
    out = format_text("{}  %buffer{} = phi ptr [ null, %p{} ], [ %fresh{}, %clone{} ]\n", out, pc, pc, pc, pc);
    out = format_text("{}  %sized{} = insertvalue {} zeroinitializer, i32 %n{}, 0\n", out, pc, array, pc);
    out = format_text("{}  %capped{} = insertvalue {} %sized{}, i32 %n{}, 1\n", out, pc, array, pc, pc);
    out = format_text("{}  %v{} = insertvalue {} %capped{}, ptr %buffer{}, 2\n", out, pc, array, pc, pc);
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}
// A new array of the length in the right slot, 0 if it is negative: the first
// elements of the array loaded as %a<pc>, then zeros.
ArrayResized :: (item: Instruction, pc: int) -> string {
    array := abi.ArrayType();
    element := item.type - ArrayType;
    out := Load(format_text("b{}", pc), abi.IntStorage, "s", item.right);
    out = format_text("{}  %data{} = extractvalue {} %a{}, 2\n", out, pc, array, pc);
    out = format_text("{}  %below{} = icmp slt i32 %b{}, 0\n  %n{} = select i1 %below{}, i32 0, i32 %b{}\n", out, pc, pc,
                      pc, pc, pc);
    out = format_text("{}  %none{} = icmp eq i32 %n{}, 0\n", out, pc, pc);
    out = format_text("{}  br i1 %none{}, label %done{}, label %make{}\nmake{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}{}", out, Sized(format_text("width{}", pc), element));
    out = format_text("{}  %count{} = zext i32 %n{} to i64\n  %bytes{} = mul i64 %count{}, %width{}\n", out, pc, pc, pc,
                      pc, pc);
    out = format_text("{}{}", out, Allocated(format_text("fresh{}", pc), format_text("%bytes{}", pc)));
    out = format_text("{}  %short{} = icmp ult i32 %n{}, %length{}\n", out, pc, pc, pc);
    out = format_text("{}  %kept{} = select i1 %short{}, i32 %n{}, i32 %length{}\n", out, pc, pc, pc, pc);
    out = format_text("{}  %keep{} = zext i32 %kept{} to i64\n  %held{} = mul i64 %keep{}, %width{}\n", out, pc, pc, pc,
                      pc, pc);
    out = format_text("{}  call void @chibi_scalar.copy(ptr %fresh{}, ptr %data{}, i64 %held{})\n", out, pc, pc, pc);
    out = format_text("{}  %rest{} = getelementptr inbounds i8, ptr %fresh{}, i64 %held{}\n", out, pc, pc, pc);
    out = format_text("{}  %fill{} = sub i64 %bytes{}, %held{}\n", out, pc, pc, pc);
    out = format_text("{}  call void @chibi_scalar.zero(ptr %rest{}, i64 %fill{})\n", out, pc, pc);
    out = format_text("{}  br label %done{}\ndone{}:\n", out, pc, pc);
    out = format_text("{}  %buffer{} = phi ptr [ null, %p{} ], [ %fresh{}, %make{} ]\n", out, pc, pc, pc, pc);
    out = format_text("{}  %sized{} = insertvalue {} zeroinitializer, i32 %n{}, 0\n", out, pc, array, pc);
    out = format_text("{}  %capped{} = insertvalue {} %sized{}, i32 %n{}, 1\n", out, pc, array, pc, pc);
    out = format_text("{}  %v{} = insertvalue {} %capped{}, ptr %buffer{}, 2\n", out, pc, array, pc, pc);
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}
// Whether an element of the array loaded as %a<pc> equals the value in the
// right slot, found by looking at each in turn.
ArrayFound :: (item: Instruction, pc: int) -> string {
    array := abi.ArrayType();
    element := int(item.literal);
    type := TypeName(element);
    out := Load(format_text("w{}", pc), element, "s", item.right);
    out = format_text("{}  %data{} = extractvalue {} %a{}, 2\n", out, pc, array, pc);
    out = format_text("{}  br label %scan{}\nscan{}:\n", out, pc, pc);
    out = format_text("{}  %at{} = phi i32 [ 0, %p{} ], [ %next{}, %step{} ]\n", out, pc, pc, pc, pc);
    out = format_text("{}  %end{} = icmp eq i32 %at{}, %length{}\n", out, pc, pc, pc);
    out = format_text("{}  br i1 %end{}, label %missing{}, label %look{}\nlook{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}  %offset{} = zext i32 %at{} to i64\n", out, pc, pc);
    out = format_text("{}  %place{} = getelementptr inbounds {}, ptr %data{}, i64 %offset{}\n", out, pc, type, pc, pc);
    out = format_text("{}  %item{} = load {}, ptr %place{}\n", out, pc, type, pc);
    if (element == abi.TextStorage) {
        out = format_text("{}  %same{} = call i1 @chibi_scalar.text_equal({} %item{}, {} %w{})\n", out, pc, type, pc, type,
                          pc);
    } else if (abi.Floating(element)) {
        out = format_text("{}  %same{} = fcmp oeq {} %item{}, %w{}\n", out, pc, type, pc, pc);
    } else {
        out = format_text("{}  %same{} = icmp eq {} %item{}, %w{}\n", out, pc, type, pc, pc);
    }
    out = format_text("{}  br i1 %same{}, label %found{}, label %step{}\nstep{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}  %next{} = add i32 %at{}, 1\n  br label %scan{}\nmissing{}:\n  br label %done{}\nfound{}:\n", out, pc,
                      pc, pc, pc, pc, pc);
    out = format_text("{}  br label %done{}\ndone{}:\n", out, pc, pc);
    out = format_text("{}  %v{} = phi i1 [ false, %missing{} ], [ true, %found{} ]\n", out, pc, pc, pc);
    return format_text("{}{}", out, Store(format_text("%v{}", pc), abi.BoolStorage, "s", item.output));
}
// The array loaded as %a<pc> without its element at the index in the right
// slot, the elements after it moved down, if the index is inside it.
ArrayRemoved :: (item: Instruction, pc: int) -> string {
    array := abi.ArrayType();
    element := item.type - ArrayType;
    type := TypeName(element);
    out := Load(format_text("b{}", pc), abi.IntStorage, "s", item.right);
    out = format_text("{}  %data{} = extractvalue {} %a{}, 2\n", out, pc, array, pc);
    out = format_text("{}  %in{} = icmp ult i32 %b{}, %length{}\n", out, pc, pc, pc);
    out = format_text("{}  br i1 %in{}, label %cut{}, label %kept{}\ncut{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}{}", out, Sized(format_text("width{}", pc), element));
    out = format_text("{}  %after{} = add i32 %b{}, 1\n  %tail{} = sub i32 %length{}, %after{}\n", out, pc, pc, pc, pc, pc);
    out = format_text("{}  %to{} = zext i32 %b{} to i64\n  %from{} = zext i32 %after{} to i64\n", out, pc, pc, pc, pc);
    out = format_text("{}  %hole{} = getelementptr inbounds {}, ptr %data{}, i64 %to{}\n", out, pc, type, pc, pc);
    out = format_text("{}  %next{} = getelementptr inbounds {}, ptr %data{}, i64 %from{}\n", out, pc, type, pc, pc);
    out = format_text("{}  %count{} = zext i32 %tail{} to i64\n  %bytes{} = mul i64 %count{}, %width{}\n", out, pc, pc,
                      pc, pc, pc);
    out = format_text("{}  call void @chibi_scalar.copy(ptr %hole{}, ptr %next{}, i64 %bytes{})\n", out, pc, pc, pc);
    out = format_text("{}  %shorter{} = sub i32 %length{}, 1\n  br label %kept{}\nkept{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}  %size{} = phi i32 [ %length{}, %p{} ], [ %shorter{}, %cut{} ]\n", out, pc, pc, pc, pc, pc);
    out = format_text("{}  %v{} = insertvalue {} %a{}, i32 %size{}, 0\n", out, pc, array, pc, pc);
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}
// An array of its own allocation holding the elements of the array loaded as
// %a<pc>, or the empty array for an empty one.
ArrayCopied :: (item: Instruction, pc: int) -> string {
    array := abi.ArrayType();
    element := item.type - ArrayType;
    out := format_text("  %data{} = extractvalue {} %a{}, 2\n", pc, array, pc);
    out = format_text("{}{}", out, Sized(format_text("width{}", pc), element));
    out = format_text("{}  %used{} = zext i32 %length{} to i64\n  %bytes{} = mul i64 %used{}, %width{}\n", out, pc, pc,
                      pc, pc, pc);
    out = format_text("{}  %none{} = icmp eq i32 %length{}, 0\n", out, pc, pc);
    out = format_text("{}  br i1 %none{}, label %done{}, label %clone{}\nclone{}:\n", out, pc, pc, pc, pc);
    out = format_text("{}{}", out, Allocated(format_text("fresh{}", pc), format_text("%bytes{}", pc)));
    out = format_text("{}  call void @chibi_scalar.copy(ptr %fresh{}, ptr %data{}, i64 %bytes{})\n", out,
                      pc, pc, pc);
    out = format_text("{}  br label %done{}\ndone{}:\n", out, pc, pc);
    out = format_text("{}  %buffer{} = phi ptr [ null, %p{} ], [ %fresh{}, %clone{} ]\n", out, pc, pc, pc, pc);
    out = format_text("{}  %sized{} = insertvalue {} %a{}, i32 %length{}, 1\n", out, pc, array, pc, pc);
    out = format_text("{}  %v{} = insertvalue {} %sized{}, ptr %buffer{}, 2\n", out, pc, array, pc, pc);
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}

// A string's byte count, a byte or a slice. A byte is read only inside the
// string, and a slice clamps its count to the string's bytes, so neither
// reads nor points past them.
TextRead :: (item: Instruction, pc: int) -> string {
    text := abi.TextType();
    out := Load(format_text("a{}", pc), abi.TextStorage, "s", item.left);
    out = format_text("{}  %length{} = extractvalue {} %a{}, 1\n", out, pc, text, pc);
    if (item.op == TextLength) {
        return format_text("{}{}", out, Store(format_text("%length{}", pc), item.type, "s", item.output));
    }
    out = format_text("{}{}", out, Load(format_text("b{}", pc), abi.IntStorage, "s", item.right));
    if (item.op == TextByte) {
        // A negative index is outside too, read unsigned.
        out = format_text("{}  %inside{} = icmp ult i32 %b{}, %length{}\n  br i1 %inside{}, label %read{}, label %byte{}\n",
                          out, pc, pc, pc, pc, pc, pc);
        out = format_text("{}read{}:\n  %bytes{} = extractvalue {} %a{}, 0\n  %offset{} = zext i32 %b{} to i64\n", out, pc,
                          pc, text, pc, pc, pc);
        out = format_text("{}  %at{} = getelementptr inbounds i8, ptr %bytes{}, i64 %offset{}\n", out, pc, pc, pc);
        out = format_text("{}  %loaded{} = load i8, ptr %at{}\n  %wide{} = zext i8 %loaded{} to i32\n  br label %byte{}\n",
                          out, pc, pc, pc, pc, pc);
        out = format_text("{}byte{}:\n  %v{} = phi i32 [ %wide{}, %read{} ], [ -1, %p{} ]\n", out, pc, pc, pc, pc, pc);
        return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    }
    // The count, clamped to 0 through the byte count.
    out = format_text("{}  %negative{} = icmp slt i32 %b{}, 0\n  %low{} = select i1 %negative{}, i32 0, i32 %b{}\n", out,
                      pc, pc, pc, pc, pc);
    out = format_text("{}  %over{} = icmp ugt i32 %low{}, %length{}\n  %n{} = select i1 %over{}, i32 %length{}, i32 %low{}\n",
                      out, pc, pc, pc, pc, pc, pc, pc);
    if (item.op == TextTake) {
        out = format_text("{}  %v{} = insertvalue {} %a{}, i32 %n{}, 1\n", out, pc, text, pc, pc);
        return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    }
    out = format_text("{}  %bytes{} = extractvalue {} %a{}, 0\n  %offset{} = zext i32 %n{} to i64\n", out, pc, text, pc,
                      pc, pc);
    out = format_text("{}  %start{} = getelementptr inbounds i8, ptr %bytes{}, i64 %offset{}\n", out, pc, pc, pc);
    out = format_text("{}  %rest{} = sub i32 %length{}, %n{}\n", out, pc, pc, pc);
    out = format_text("{}  %moved{} = insertvalue {} %a{}, ptr %start{}, 0\n", out, pc, text, pc, pc);
    out = format_text("{}  %v{} = insertvalue {} %moved{}, i32 %rest{}, 1\n", out, pc, text, pc, pc);
    return format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
}

// How a module exports function 0: as `chibi_scalar`, as `main` for a
// zero-argument int entry, or not at all, as a library, which exports only
// its manifest.
ScalarEntry: int : 0;
MainEntry: int : 1;
NoEntry: int : 2;
// The entry's symbol, or an internal function's.
Symbol :: (function: int, mode: int) -> string {
    if (function == 0 && mode == MainEntry) {
        return "main";
    }
    if (function == 0 && mode == ScalarEntry) {
        return "chibi_scalar";
    }
    return format_text("chibi_scalar.{}", function);
}
// Arguments load in call order, so evaluation order stays visible at O0. A
// module that calls the runtime passes its context first. After a call of a
// function that can fail, the caller fails when the context names a failure.
CallInstruction :: (functions: Function[], parameters: int[], arguments: int[], item: Instruction, pc: int,
                    mode: int, runtime: bool, checked: bool) -> string {
    callee := functions[item.left];
    out := format_text("p{}:\n", pc);
    listed: string[] = [];
    if (runtime) {
        listed.append("ptr %ctx");
    }
    for (index in 0..<item.target) {
        type := parameters[callee.first_parameter + index];
        out = format_text("{}{}", out, Load(format_text("c{}_{}", pc, index), type, "s", arguments[item.right + index]));
        listed.append(format_text("{} %c{}_{}", TypeName(type), pc, index));
    }
    list := strings.Join(listed, ", ");
    out = format_text("{}  %v{} = call {} @{}({})\n", out, pc, TypeName(item.type), Symbol(item.left, mode), list);
    out = format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    if (!checked) {
        return format_text("{}  br label %p{}\n", out, pc + 1);
    }
    out = format_text("{}  %failure{}.at = getelementptr inbounds {}, ptr %ctx, i32 0, i32 1\n", out, pc,
                      abi.ContextType());
    out = format_text("{}  %failure{} = load ptr, ptr %failure{}.at\n", out, pc, pc);
    out = format_text("{}  %failed{} = icmp ne ptr %failure{}, null\n", out, pc, pc);
    return format_text("{}  br i1 %failed{}, label %failed, label %p{}\n", out, pc, pc + 1);
}
// Fail names its failure in the context, then the function fails.
FailInstruction :: (function: int, pc: int) -> string {
    out := format_text("p{}:\n  %fail{}.at = getelementptr inbounds {}, ptr %ctx, i32 0, i32 1\n", pc, pc,
                       abi.ContextType());
    return format_text("{}  store ptr @{}, ptr %fail{}.at\n  br label %failed\n", out, FailureSymbol(function, pc), pc);
}
// The constant that names the failure of instruction `pc` of `function`.
FailureSymbol :: (function: int, pc: int) -> string {
    return format_text("chibi_scalar.failure.{}.{}", function, pc);
}
EmitFunction :: (functions: Function[], function: int, parameters: int[], slots: int[], locals: int[],
                 code: Instruction[], arguments: int[], records: Record[], fields: int[], texts: string[],
                 mode: int, step_budget: int, runtime: bool, fallible: bool[]) -> string {
    shape := functions[function];
    result := shape.result;
    linkage := "";
    if (function != 0 || mode == NoEntry) {
        linkage = "internal ";
    }
    listed: string[] = [];
    if (runtime) {
        listed.append("ptr %ctx");
    }
    for (index in 0..<shape.parameters) {
        listed.append(format_text("{} %arg{}", TypeName(parameters[shape.first_parameter + index]), index));
    }
    out := format_text("define {}{} @{}({}) #0 {\nentry:\n", linkage, TypeName(result), Symbol(function, mode),
                       strings.Join(listed, ", "));
    out = format_text("{}  %budget0 = alloca i32\n  store i32 {}, ptr %budget0\n", out, step_budget);
    for (index in 0..<shape.slots) {
        out = format_text("{}  %s{} = alloca {}\n", out, index, TypeName(slots[shape.first_slot + index]));
    }
    for (index in 0..<shape.locals) {
        type := locals[shape.first_local + index];
        out = format_text("{}  %l{} = alloca {}\n", out, index, TypeName(type));
        out = format_text("{}{}", out, Store(Zero(type), type, "l", index));
    }
    out = format_text("{}  %result0 = alloca {}\n", out, TypeName(result));
    out = format_text("{}{}", out, Store(Zero(result), result, "result", 0));
    // A format's values and result live in the entry block, so a loop
    // reuses them.
    for (pc in 0..<shape.code) {
        item := code[shape.first_code + pc];
        if (item.op == Format) {
            out = format_text("{}  %values{} = alloca [{} x {}]\n  %text{} = alloca {}\n", out, pc, item.target,
                              abi.ValueType(), pc, abi.TextType());
        }
    }
    out = format_text("{}  br label %p0\n", out);
    own := Part(arguments, shape.first_argument, shape.arguments);
    for (pc in 0..<shape.code) {
        item := code[shape.first_code + pc];
        if (item.op == Call) {
            out = format_text("{}{}", out, CallInstruction(functions, parameters, own, item, pc, mode, runtime,
                                                           fallible[item.left]));
        } else if (item.op == Fail) {
            out = format_text("{}{}", out, FailInstruction(function, pc));
        } else if (item.op == Format) {
            out = format_text("{}{}", out, FormatInstruction(Part(slots, shape.first_slot, shape.slots), own, item, pc));
        } else {
            out = format_text("{}{}", out, EmitInstruction(item, pc, result, records, fields, texts));
        }
    }
    // A function fails with its result's zero, which no caller reads.
    if (fallible[function]) {
        out = format_text("{}failed:\n  ret {} {}\n", out, TypeName(result), Zero(result));
    }
    return format_text("{}trap:\n  call void @llvm.trap()\n  unreachable\n}\n", out);
}

// Each argument becomes a runtime value in the format's array, in order, and
// the context's format_text writes the string it makes.
FormatInstruction :: (slots: int[], arguments: int[], item: Instruction, pc: int) -> string {
    value := abi.ValueType();
    text := abi.TextType();
    out := format_text("p{}:\n", pc);
    for (index in 0..<item.target) {
        slot := arguments[item.right + index];
        type := slots[slot];
        name := format_text("f{}_{}", pc, index);
        out = format_text("{}{}", out, Load(name, type, "s", slot));
        empty := format_text("{ i32 {}, i32 0, i64 0, ptr null }", abi.ValueTag(type));
        if (type == abi.TextStorage) {
            out = format_text("{}  %{}.bytes = extractvalue {} %{}, 0\n  %{}.length = extractvalue {} %{}, 1\n", out,
                              name, text, name, name, text, name);
            out = format_text("{}  %{}.sized = insertvalue {} {}, i32 %{}.length, 1\n", out, name, value, empty, name);
            out = format_text("{}  %{}.value = insertvalue {} %{}.sized, ptr %{}.bytes, 3\n", out, name, value, name,
                              name);
        } else {
            out = format_text("{}{}", out, ToWord(format_text("{}.word", name), format_text("%{}", name), type));
            out = format_text("{}  %{}.value = insertvalue {} {}, i64 %{}.word, 2\n", out, name, value, empty, name);
        }
        out = format_text("{}  %{}.at = getelementptr inbounds [{} x {}], ptr %values{}, i64 0, i64 {}\n", out, name,
                          item.target, value, pc, index);
        out = format_text("{}  store {} %{}.value, ptr %{}.at\n", out, value, name, name);
    }
    out = format_text("{}  %format{}.at = getelementptr inbounds {}, ptr %ctx, i32 0, i32 0\n", out, pc,
                      abi.ContextType());
    out = format_text("{}  %format{} = load ptr, ptr %format{}.at\n", out, pc, pc);
    out = format_text("{}  call void %format{}(ptr %ctx, ptr %values{}, i32 {}, ptr %text{})\n", out, pc, pc,
                      item.target, pc);
    out = format_text("{}  %v{} = load {}, ptr %text{}\n", out, pc, text, pc);
    out = format_text("{}{}", out, Store(format_text("%v{}", pc), item.type, "s", item.output));
    return format_text("{}  br label %p{}\n", out, pc + 1);
}
// Whether `code` calls the runtime.
Runtime :: (code: Instruction[]) -> bool {
    for (item in code) {
        if (item.op == Format || item.op == Fail || ArrayCalls(item.op)) {
            return true;
        }
    }
    return false;
}
// Whether each function can fail: it has a Fail, or calls a function that
// can.
Fallible :: (functions: Function[], code: Instruction[]) -> bool[] {
    fallible: bool[] = [];
    for (shape in functions) {
        fallible.append(false);
    }
    changed := true;
    while (changed) {
        changed = false;
        for (function in 0..<length(functions)) {
            shape := functions[function];
            for (item in Codes(code, shape.first_code, shape.code)) {
                if (!fallible[function] && (item.op == Fail || (item.op == Call && fallible[item.left]))) {
                    fallible[function] = true;
                    changed = true;
                }
            }
        }
    }
    return fallible;
}
// Each Fail's constant: its function's stable ID and its source range.
Failures :: (functions: Function[], code: Instruction[]) -> string {
    out := "";
    for (function in 0..<length(functions)) {
        shape := functions[function];
        for (pc in 0..<shape.code) {
            item := code[shape.first_code + pc];
            if (item.op == Fail) {
                out = format_text("{}@{} = private unnamed_addr constant {} { i64 {}, i32 {}, i32 {} }\n", out,
                                  FailureSymbol(function, pc), abi.FailureType(), item.literal, item.left, item.right);
            }
        }
    }
    return out;
}

// Whether `code` moves array elements, which the module's copy does.
Copies :: (code: Instruction[]) -> bool {
    for (item in code) {
        if (item.op == ArrayPush || item.op == ArrayCopy || (item.op >= ArrayExtend && item.op != ArrayContains)) {
            return true;
        }
    }
    return false;
}
// Whether `code` makes zeros for a longer array, which the module's zero does.
Zeroes :: (code: Instruction[]) -> bool {
    for (item in code) {
        if (item.op == ArrayResize) {
            return true;
        }
    }
    return false;
}
// Fills `bytes` bytes with zero, a byte at a time, in a function that disables
// the library calls for the reason ArrayCopyHelper gives.
ArrayZeroHelper :: () -> string {
    out := "define internal void @chibi_scalar.zero(ptr %at, i64 %bytes) #1 {\nentry:\n  br label %head\n";
    out = format_text("{}head:\n  %index = phi i64 [ 0, %entry ], [ %next, %body ]\n  %done = icmp eq i64 %index, %bytes\n", out);
    out = format_text("{}  br i1 %done, label %exit, label %body\nbody:\n", out);
    out = format_text("{}  %place = getelementptr inbounds i8, ptr %at, i64 %index\n  store i8 0, ptr %place\n", out);
    return format_text("{}  %next = add i64 %index, 1\n  br label %head\nexit:\n  ret void\n}\n", out);
}
// Copies `bytes` bytes from one allocation to another, a byte at a time, from
// the front, so a copy down a few elements within an allocation is safe. It is
// a loop of its own, in a function that disables the library calls
// (attribute #1), so the optimizer does not turn it into a call of memcpy,
// which a program with no C library and an object with no undefined symbols
// lack.
ArrayCopyHelper :: () -> string {
    out := "define internal void @chibi_scalar.copy(ptr %to, ptr %from, i64 %bytes) #1 {\nentry:\n  br label %head\n";
    out = format_text("{}head:\n  %at = phi i64 [ 0, %entry ], [ %next, %body ]\n  %done = icmp eq i64 %at, %bytes\n", out);
    out = format_text("{}  br i1 %done, label %exit, label %body\nbody:\n", out);
    out = format_text("{}  %source = getelementptr inbounds i8, ptr %from, i64 %at\n  %byte = load i8, ptr %source\n", out);
    out = format_text("{}  %target = getelementptr inbounds i8, ptr %to, i64 %at\n  store i8 %byte, ptr %target\n", out);
    return format_text("{}  %next = add i64 %at, 1\n  br label %head\nexit:\n  ret void\n}\n", out);
}
// The symbol of text `index` of the module's table.
TextSymbol :: (index: int) -> string {
    return format_text("chibi_scalar.text.{}", index);
}
// `text` as the bytes of an LLVM c"" string: printable ASCII but `"` and `\`
// as itself, and every other byte as two hex digits after a `\`. Each run of
// bytes kept as themselves is one slice.
Escaped :: (text: string) -> string {
    digits := "0123456789ABCDEF";
    parts: string[] = [];
    bytes := strings.Bytes(text);
    start := 0;
    for (index in 0..<length(bytes)) {
        value := bytes[index];
        if (value < 32 || value >= 127 || value == 34 || value == 92) {
            parts.append(strings.Slice(text, start, index - start));
            parts.append(format_text("\\{}{}", strings.Slice(digits, value / 16, 1), strings.Slice(digits, value % 16, 1)));
            start = index + 1;
        }
    }
    parts.append(strings.Slice(text, start, length(bytes) - start));
    return strings.Join(parts, "");
}
// Whether `code` compares strings.
Compares :: (code: Instruction[]) -> bool {
    for (item in code) {
        if (item.type == abi.TextStorage && (item.op == Eq || item.op == Ne)) {
            return true;
        }
        if (item.op == ArrayContains && item.literal == i64(abi.TextStorage)) {
            return true;
        }
    }
    return false;
}
// Whether two strings hold the same bytes, as the runtime compares them:
// their lengths, then each byte in turn. It reads no byte of an empty string,
// so the zero string's missing bytes are never read.
TextEqual :: () -> string {
    text := abi.TextType();
    out := format_text("define internal i1 @chibi_scalar.text_equal({} %a, {} %b) #0 {\nentry:\n", text, text);
    out = format_text("{}  %a.bytes = extractvalue {} %a, 0\n  %a.length = extractvalue {} %a, 1\n", out, text, text);
    out = format_text("{}  %b.bytes = extractvalue {} %b, 0\n  %b.length = extractvalue {} %b, 1\n", out, text, text);
    out = format_text("{}  %same = icmp eq i32 %a.length, %b.length\n  br i1 %same, label %head, label %differ\n", out);
    out = format_text("{}head:\n  %index = phi i32 [ 0, %entry ], [ %next, %byte ]\n", out);
    out = format_text("{}  %done = icmp eq i32 %index, %a.length\n  br i1 %done, label %equal, label %byte\n", out);
    out = format_text("{}byte:\n  %offset = zext i32 %index to i64\n", out);
    out = format_text("{}  %a.at = getelementptr inbounds i8, ptr %a.bytes, i64 %offset\n", out);
    out = format_text("{}  %b.at = getelementptr inbounds i8, ptr %b.bytes, i64 %offset\n", out);
    out = format_text("{}  %a.byte = load i8, ptr %a.at\n  %b.byte = load i8, ptr %b.at\n", out);
    out = format_text("{}  %next = add i32 %index, 1\n  %matches = icmp eq i8 %a.byte, %b.byte\n", out);
    out = format_text("{}  br i1 %matches, label %head, label %differ\nequal:\n  ret i1 true\n", out);
    return format_text("{}differ:\n  ret i1 false\n}\n", out);
}
// The saturating conversion intrinsics `code` calls, each declared once.
Declarations :: (code: Instruction[]) -> string {
    out := "";
    for (item in code) {
        if (item.op != Convert || !abi.Floating(item.right) || !Integer(item.type)) {
            continue;
        }
        declaration := format_text("declare {} @{}({})\n", abi.ScalarType(item.type), Saturating(item.right, item.type),
                                   abi.ScalarType(item.right));
        if (!strings.Contains(out, declaration)) {
            out = format_text("{}{}", out, declaration);
        }
    }
    return out;
}
Module :: (target: abi.Target, functions: Function[], parameters: int[], slots: int[], locals: int[],
           code: Instruction[], arguments: int[], records: Record[], fields: int[], texts: string[], source: Source,
           names: string[], lines: int[], columns: int[], mode: int, step_budget: int) -> Result {
    if (step_budget <= 0) {
        return Result.Rejected(-1, "native CHECK budget must be positive");
    }
    if (!abi.Supported(target)) {
        return Result.Rejected(-1, "unsupported native target");
    }
    if (!Layout(functions, parameters, slots, locals, code, arguments)) {
        return Result.Rejected(-1, "unsupported native scalar signature or table size");
    }
    if (!RecordLayout(records, fields)) {
        return Result.Rejected(-1, "native records differ from their field table");
    }
    if (source.file != "" && abi.DebugFormat(target) == "") {
        return Result.Rejected(-1, "native line tables are Linux x86-64 only");
    }
    if (source.file != "" && !Placed(names, lines, columns, length(functions), length(code))) {
        return Result.Rejected(-1, "native line table differs from its module");
    }
    for (function in 0..<length(functions)) {
        switch Validate(functions, function, parameters, slots, locals, code, arguments, records, fields, texts,
                        mode) {
            case .Rejected(instruction, message):
                return Result.Rejected(instruction, message);
            case .Emitted(text):
                continue;
        }
    }
    // A program's main has no context to pass.
    runtime := Runtime(code);
    if (runtime && mode == MainEntry) {
        return Result.Rejected(-1, "a native program cannot call the runtime yet");
    }
    // No host-derived data layout: the explicit LLVM target selects it. No
    // raw pointer or foreign ABI is admitted yet, and records stay internal.
    out := format_text("target triple = \"{}\"\n\n", target.triple);
    for (index in 0..<length(records)) {
        record := records[index];
        types := "";
        for (field in 0..<record.count) {
            if (field > 0) {
                types = format_text("{}, ", types);
            }
            types = format_text("{}{}", types, TypeName(fields[record.first + field]));
        }
        out = format_text("{}%record{} = type { {} }\n", out, index, types);
    }
    for (index in 0..<length(texts)) {
        out = format_text("{}@{} = private unnamed_addr constant [{} x i8] c\"{}\\00\"\n", out, TextSymbol(index),
                          strings.ByteLength(texts[index]) + 1, Escaped(texts[index]));
    }
    out = format_text("{}{}declare void @llvm.trap()\n{}", out, Failures(functions, code), Declarations(code));
    debug := source.file != "";
    compares := Compares(code);
    fallible := Fallible(functions, code);
    for (function in 0..<length(functions)) {
        text := EmitFunction(functions, function, parameters, slots, locals, code, arguments, records, fields,
                             texts, mode, step_budget, runtime, fallible);
        if (debug) {
            text = Located(text, Subprogram(function), Location(length(functions), compares,
                                                                functions[function].first_code));
        }
        out = format_text("{}\n{}", out, text);
    }
    if (compares) {
        text := TextEqual();
        if (debug) {
            text = Located(text, Subprogram(length(functions)), Location(length(functions), true, length(code)));
        }
        out = format_text("{}\n{}", out, text);
    }
    if (Copies(code)) {
        out = format_text("{}\n{}", out, ArrayCopyHelper());
    }
    if (Zeroes(code)) {
        out = format_text("{}\n{}", out, ArrayZeroHelper());
    }
    // Recursion is unchecked, as Rust's is: each function probes every page
    // of its frame, so running out of stack faults in the guard page below
    // it, which the host reports as a stack overflow.
    out = strings.Join([out, "\nattributes #0 = { ", abi.StackProbe(target), " }\n"], "");
    if (Copies(code)) {
        out = strings.Join([out, "attributes #1 = { noinline nounwind \"no-builtins\" }\n"], "");
    }
    if (debug) {
        out = format_text("{}\n{}", out, Metadata(target, functions, source, names, lines, columns, mode, compares));
    }
    return Result.Emitted(out);
}

// Whether line tables name every function and place every instruction.
Placed :: (names: string[], lines: int[], columns: int[], functions: int, code: int) -> bool {
    if (length(names) != functions || length(lines) != code || length(columns) != code) {
        return false;
    }
    for (name in names) {
        if (name == "") {
            return false;
        }
    }
    for (index in 0..<code) {
        if (lines[index] < 0 || columns[index] < 0) {
            return false;
        }
    }
    return true;
}
// Debug metadata numbers: the compile unit and its file, the two module flags,
// the one subroutine type and its empty tuple, a subprogram for each function
// then the string comparison helper, and a location for each code
// instruction then the helper's.
FirstSubprogram: int : 6;
Subprogram :: (function: int) -> int {
    return FirstSubprogram + function;
}
Location :: (functions: int, compares: bool, instruction: int) -> int {
    first := Subprogram(functions);
    if (compares) {
        first += 1;
    }
    return first + instruction;
}
// One function's IR with each instruction at its source position. The
// function is in its subprogram; label p<pc> starts code instruction pc's
// position, and the entry and trap blocks are at its first instruction's. A
// helper without p labels is wholly at `first`.
Located :: (text: string, scope: int, first: int) -> string {
    out: string[] = [];
    at := first;
    pc := 0;
    for (line in strings.Split(text, "\n")) {
        placed := line;
        if (strings.HasPrefix(line, "define ")) {
            placed = strings.Join([strings.TrimSuffix(line, " {"), format_text(" !dbg !{} ", scope), "{"], "");
        } else if (strings.HasPrefix(line, "p") && strings.HasSuffix(line, ":")) {
            at = first + pc;
            pc += 1;
        } else if (line == "trap:") {
            at = first;
        } else if (strings.HasPrefix(line, "  ")) {
            placed = format_text("{}, !dbg !{}", line, at);
        }
        out.append(placed);
    }
    return strings.Join(out, "\n");
}
// The line tables' metadata. DWARF names no Chibi language, so the unit is
// C99's, as Odin's is; only line tables are emitted, as rustc's
// line-tables-only does, so the subroutine type lists no types. The exported
// entry is external and every other function local to the unit; the string
// comparison helper is artificial, at line 0.
Metadata :: (target: abi.Target, functions: Function[], source: Source, names: string[], lines: int[], columns: int[],
             mode: int, compares: bool) -> string {
    out := "!llvm.dbg.cu = !{!0}\n!llvm.module.flags = !{!2, !3}\n";
    out = format_text("{}!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: \"chibi\", isOptimized: false, runtimeVersion: 0, emissionKind: LineTablesOnly)\n",
                      out);
    out = format_text("{}!1 = !DIFile(filename: \"{}\", directory: \"{}\")\n!2 = {}\n", out, Escaped(source.file),
                      Escaped(source.directory), abi.DebugFormat(target));
    out = strings.Join([out, "!3 = !{i32 2, !\"Debug Info Version\", i32 3}\n!4 = !DISubroutineType(types: !5)\n",
                        "!5 = !{}\n"], "");
    for (function in 0..<length(functions)) {
        line := lines[functions[function].first_code];
        flags := "DISPFlagDefinition";
        if (function != 0 || mode == NoEntry) {
            flags = "DISPFlagLocalToUnit | DISPFlagDefinition";
        }
        out = format_text("{}!{} = distinct !DISubprogram(name: \"{}\", linkageName: \"{}\", scope: !1, file: !1, line: {}, type: !4, scopeLine: {}, spFlags: {}, unit: !0)\n",
                          out, Subprogram(function), Escaped(names[function]), Symbol(function, mode), line, line,
                          flags);
    }
    if (compares) {
        out = format_text("{}!{} = distinct !DISubprogram(name: \"chibi_scalar.text_equal\", scope: !1, file: !1, line: 0, type: !4, scopeLine: 0, flags: DIFlagArtificial, spFlags: DISPFlagLocalToUnit | DISPFlagDefinition, unit: !0)\n",
                          out, Subprogram(length(functions)));
    }
    for (function in 0..<length(functions)) {
        shape := functions[function];
        for (pc in shape.first_code..<shape.first_code + shape.code) {
            out = format_text("{}!{} = !DILocation(line: {}, column: {}, scope: !{})\n", out,
                              Location(length(functions), compares, pc), lines[pc], columns[pc],
                              Subprogram(function));
        }
    }
    if (compares) {
        code := 0;
        for (shape in functions) {
            code += shape.code;
        }
        out = format_text("{}!{} = !DILocation(line: 0, scope: !{})\n", out, Location(length(functions), true, code),
                          Subprogram(length(functions)));
    }
    return out;
}
pub Emit :: (target: abi.Target, functions: Function[], parameters: int[], slots: int[], locals: int[],
             code: Instruction[], arguments: int[], records: Record[], fields: int[], texts: string[],
             source: Source, names: string[], lines: int[], columns: int[], main: bool, step_budget: int) -> Result {
    mode := ScalarEntry;
    if (main) {
        mode = MainEntry;
    }
    return Module(target, functions, parameters, slots, locals, code, arguments, records, fields, texts, source, names,
                  lines, columns, mode, step_budget);
}

// Whether `name` can end a C symbol: an ASCII letter or `_`, then letters,
// digits and `_`.
Identifier :: (name: string) -> bool {
    bytes := strings.Bytes(name);
    for (index in 0..<length(bytes)) {
        value := bytes[index];
        letter := (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95;
        if (!letter && (index == 0 || value < 48 || value > 57)) {
            return false;
        }
    }
    return length(bytes) > 0;
}
// The manifest types of a function's parameters, then its result, or none
// when a word cannot carry one of them, such as a string or a record, or the
// entry ABI takes fewer parameters.
ExportTypes :: (shape: Function, parameters: int[]) -> int[] {
    types: int[] = [];
    if (shape.parameters > abi.ExportParameters) {
        return types;
    }
    for (index in 0..<shape.parameters) {
        types.append(abi.ExportType(parameters[shape.first_parameter + index]));
    }
    types.append(abi.ExportType(shape.result));
    for (type in types) {
        if (type == 0) {
            return [];
        }
    }
    return types;
}
// `word`, an i64, as a value `name` of storage `type`.
FromWord :: (name: string, word: string, type: int) -> string {
    if (type == abi.FloatStorage) {
        return format_text("  %{}.bits = trunc i64 {} to i32\n  %{} = bitcast i32 %{}.bits to float\n", name, word,
                           name, name);
    }
    if (type == abi.DoubleStorage) {
        return format_text("  %{} = bitcast i64 {} to double\n", name, word);
    }
    if (abi.IntegerBits(type) == 64) {
        return format_text("  %{} = add i64 {}, 0\n", name, word);
    }
    return format_text("  %{} = trunc i64 {} to {}\n", name, word, abi.ScalarType(type));
}
// The value `value` of storage `type` as an i64 `name`: an integer sign- or
// zero-extended, a bool as 0 or 1, and a float or double as its bits.
ToWord :: (name: string, value: string, type: int) -> string {
    if (type == abi.FloatStorage) {
        return format_text("  %{}.bits = bitcast float {} to i32\n  %{} = zext i32 %{}.bits to i64\n", name, value,
                           name, name);
    }
    if (type == abi.DoubleStorage) {
        return format_text("  %{} = bitcast double {} to i64\n", name, value);
    }
    if (abi.IntegerBits(type) == 64) {
        return format_text("  %{} = add i64 {}, 0\n", name, value);
    }
    extend := "sext";
    if (type == abi.BoolStorage || abi.Unsigned(type)) {
        extend = "zext";
    }
    return format_text("  %{} = {} {} {} to i64\n", name, extend, abi.ScalarType(type), value);
}
// Function `function`'s export entry, which takes the call's context, reads
// its arguments from words and writes its result as one. It passes the
// context on when the module calls the runtime.
ExportEntry :: (functions: Function[], function: int, parameters: int[], runtime: bool) -> string {
    shape := functions[function];
    out := format_text("define internal void @chibi_scalar.export.{}(ptr %ctx, ptr %in, ptr %out) #0 {\nentry:\n",
                       function);
    listed: string[] = [];
    if (runtime) {
        listed.append("ptr %ctx");
    }
    for (index in 0..<shape.parameters) {
        type := parameters[shape.first_parameter + index];
        out = format_text("{}  %w{}.at = getelementptr inbounds i64, ptr %in, i64 {}\n", out, index, index);
        out = format_text("{}  %w{} = load i64, ptr %w{}.at\n", out, index, index);
        out = format_text("{}{}", out, FromWord(format_text("a{}", index), format_text("%w{}", index), type));
        listed.append(format_text("{} %a{}", TypeName(type), index));
    }
    out = format_text("{}  %r = call {} @{}({})\n", out, TypeName(shape.result), Symbol(function, NoEntry),
                      strings.Join(listed, ", "));
    out = format_text("{}{}", out, ToWord("word", "%r", shape.result));
    return format_text("{}  store i64 %word, ptr %out\n  ret void\n}\n", out);
}
// A library module: each function is internal, and the one symbol it exports
// is its manifest, `chibi_natives_<library>`, a constant execution_native_manifest
// (src/execution/native.h) listing an entry for each function whose
// parameters and result words carry, under its name and stable ID.
pub EmitLibrary :: (target: abi.Target, name: string, names: string[], ids: i64[], functions: Function[],
                    parameters: int[], slots: int[], locals: int[], code: Instruction[], arguments: int[],
                    records: Record[], fields: int[], texts: string[], step_budget: int) -> Result {
    // The export ABI is checked only on Linux x86-64 so far.
    if (!abi.Same(target, abi.LinuxX64())) {
        return Result.Rejected(-1, "native libraries are Linux x86-64 only");
    }
    if (!Identifier(name) || length(names) != length(functions) || length(ids) != length(functions)) {
        return Result.Rejected(-1, "native library needs an identifier and a name and ID for each function");
    }
    for (index in 0..<length(names)) {
        for (other in 0..<index) {
            if (names[other] == names[index] || ids[other] == ids[index]) {
                return Result.Rejected(-1, "native library names each function once");
            }
        }
    }
    out := "";
    // A library has no line tables yet.
    source: Source = {file: "", directory: ""};
    no_positions: int[] = [];
    switch Module(target, functions, parameters, slots, locals, code, arguments, records, fields, texts, source,
                  names, no_positions, no_positions, NoEntry, step_budget) {
        case .Rejected(instruction, message):
            return Result.Rejected(instruction, message);
        case .Emitted(text):
            out = text;
    }
    runtime := Runtime(code);
    out = format_text("{}\n%chibi.export = type { ptr, i64, ptr, i32, i32, ptr }\n", out);
    out = format_text("{}%chibi.manifest = type { i32, i32, ptr }\n", out);
    exports: string[] = [];
    for (function in 0..<length(functions)) {
        types := ExportTypes(functions[function], parameters);
        if (length(types) == 0) {
            continue;
        }
        out = format_text("{}@chibi_scalar.export.name.{} = private unnamed_addr constant [{} x i8] c\"{}\\00\"\n",
                          out, function, strings.ByteLength(names[function]) + 1, Escaped(names[function]));
        listed: string[] = [];
        for (type in types) {
            listed.append(format_text("i8 {}", type));
        }
        out = format_text("{}@chibi_scalar.export.types.{} = private unnamed_addr constant [{} x i8] [{}]\n", out,
                          function, length(types), strings.Join(listed, ", "));
        out = format_text("{}\n{}", out, ExportEntry(functions, function, parameters, runtime));
        exports.append(format_text("%chibi.export { ptr @chibi_scalar.export.name.{}, i64 {}, ptr @chibi_scalar.export.types.{}, i32 {}, i32 1, ptr @chibi_scalar.export.{} }",
                                   function, ids[function], function, functions[function].parameters, function));
    }
    out = format_text("{}\n@chibi_scalar.exports = private constant [{} x %chibi.export] [{}]\n", out,
                      length(exports), strings.Join(exports, ", "));
    return Result.Emitted(format_text("{}@chibi_natives_{} = constant %chibi.manifest { i32 {}, i32 {}, ptr @chibi_scalar.exports }\n",
                                      out, name, abi.ExportAbi, length(exports)));
}
