package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("version", data.Value.UInt(1)),
            data.Field.Named("name", data.Value.Text("SeamStudy")),
            data.Field.Named("entities", data.List([
                data.Object([
                    data.Field.Named("name", data.Value.Text("Solid slab")),
                    data.Field.Named("prototype", data.Value.Text("SeamTerrain")),
                    data.Field.Named("components", data.Object([
                        data.Field.Named("Transform", data.Object([
                            data.Field.Named("y", data.Value.Real(32.0))
                        ]))
                    ]))
                ]),
                data.Object([
                    data.Field.Named("name", data.Value.Text("Cut slab")),
                    data.Field.Named("prototype", data.Value.Text("SeamTerrain")),
                    data.Field.Named("components", data.Object([
                        data.Field.Named("Transform", data.Object([
                            data.Field.Named("y", data.Value.Real(-32.0))
                        ]))
                    ]))
                ]),
                data.Object([
                    data.Field.Named("name", data.Value.Text("Solid probe")),
                    data.Field.Named("prototype", data.Value.Text("SeamProbe")),
                    data.Field.Named("components", data.Object([
                        data.Field.Named("Transform", data.Object([
                            data.Field.Named("y", data.Value.Real(12.0))
                        ]))
                    ]))
                ]),
                data.Object([
                    data.Field.Named("name", data.Value.Text("Cut probe")),
                    data.Field.Named("prototype", data.Value.Text("SeamProbe")),
                    data.Field.Named("components", data.Object([
                        data.Field.Named("Transform", data.Object([
                            data.Field.Named("y", data.Value.Real(-52.0))
                        ]))
                    ]))
                ])
            ]))
        ])
    );
}
