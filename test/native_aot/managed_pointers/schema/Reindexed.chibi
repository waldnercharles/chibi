package owned_view_schema
Unrelated :: struct { number: f64; }
Leaf :: union { Value(number: int) | Missing }
Row :: struct { leaf: Leaf; xs: int[]; }
Main :: () -> int {
    unused: Unrelated = {number: 9};
    values: Row[] = [{leaf: Leaf.Value(7), xs: [1]}];
    owner := &values;
    selected := owner.view(0..<1);
    if selected { return selected.length() - 1; }
    return 1;
}
