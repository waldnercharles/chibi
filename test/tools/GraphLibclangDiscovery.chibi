package graph_libclang_discovery

import engine "graph:engine"
import strings "core:strings"

Installation :: (prefix: string, directory: string, name: string) -> bool {
    include := strings.Join([prefix, "/include/clang-c"], "");
    shared := strings.Join([prefix, "/", directory], "");
    resource := strings.Join([shared, "/clang/18/include"], "");
    return build.make_directory(include) && build.make_directory(resource) &&
        build.write_file(strings.Join([include, "/Index.h"], ""), "") &&
        build.write_file(strings.Join([resource, "/stdbool.h"], ""), "") &&
        build.write_file(strings.Join([shared, "/", name], ""), "");
}

Matches :: (root: string, explicit: string, expected: string, relative: string) -> bool {
    profile := engine.Discover("release", build.root(), root, explicit);
    if (profile.libclang_include != strings.Join([expected, "/include"], "") ||
        profile.libclang_library != strings.Join([expected, "/", relative], "")) {
        build.report(format_text("libclang selected '{0}' and '{1}'", profile.libclang_include, profile.libclang_library));
        return false;
    }
    directory := strings.Slice(relative, 0, strings.LastIndex(relative, "/"));
    if (profile.clang_resource_include != strings.Join([expected, "/", directory, "/clang/18/include"], "")) {
        build.report(format_text("libclang selected builtin headers '{0}'", profile.clang_resource_include));
        return false;
    }
    return true;
}

Verify :: () -> int {
    arguments := build.arguments();
    root := arguments[0];
    first := strings.Join([root, "/first prefix"], "");
    second := strings.Join([root, "/second prefix"], "");
    semicolon := strings.Join([root, "/semicolon;prefix"], "");
    explicit := strings.Join([root, "/explicit prefix"], "");
    direct := strings.Join([root, "/direct prefix"], "");
    wide := strings.Join([root, "/wide prefix"], "");
    if (!Installation(first, "lib", "libclang.dylib") ||
        !Installation(second, "lib", "libclang.so") ||
        !Installation(semicolon, "lib", "libclang.so") ||
        !Installation(explicit, "lib", "libclang.so") ||
        !Installation(direct, "lib64", "libclang.so") ||
        !Installation(wide, "lib64", "libclang-18.so")) {
        return 1;
    }
    if (!Matches(root, "", first, "lib/libclang.dylib")) {
        return 2;
    }
    if (!Matches(root, explicit, explicit, "lib/libclang.so")) {
        return 3;
    }
    // A header-only prefix cannot borrow another installation's library.
    first_library := strings.Join([first, "/lib/libclang.dylib"], "");
    second_library := strings.Join([second, "/lib/libclang.so"], "");
    semicolon_library := strings.Join([semicolon, "/lib/libclang.so"], "");
    direct_library := strings.Join([direct, "/lib64/libclang.so"], "");
    if (!build.remove(first_library) || !Matches(root, "", second, "lib/libclang.so")) {
        return 4;
    }
    if (!build.remove(second_library) || !Matches(root, "", semicolon, "lib/libclang.so")) {
        return 5;
    }
    if (!build.remove(semicolon_library) || !Matches(root, "", direct, "lib64/libclang.so")) {
        return 6;
    }
    if (!Matches(root, wide, wide, "lib64/libclang-18.so")) {
        return 7;
    }
    if (!build.remove(direct_library)) {
        return 8;
    }
    fallback := engine.Discover("release", build.root(), root, "");
    if (strings.HasPrefix(fallback.libclang_library, root) ||
        !build.file_exists(strings.Join([fallback.libclang_include, "/clang-c/Index.h"], "")) ||
        !build.file_exists(fallback.libclang_library) ||
        !build.file_exists(strings.Join([fallback.clang_resource_include, "/stdbool.h"], ""))) {
        return 9;
    }
    // Keep the environment's first complete prefix for the native CMake control.
    if (!build.write_file(first_library, "") || !build.write_file(second_library, "") ||
        !build.write_file(semicolon_library, "") || !build.write_file(direct_library, "")) {
        return 10;
    }
    return 0;
}

// POSIX fixture names exercise drive spellings without claiming Windows execution.
VerifyPathSpelling :: () -> int {
    for (prefix in ["C:/LLVM path spelling", "C:\\LLVM path spelling"]) {
        if (!Installation(prefix, "lib", "libclang.so") ||
            !Matches(build.root(), prefix, prefix, "lib/libclang.so")) {
            return 1;
        }
    }
    return 0;
}

// The native caller supplies conventional relative search paths in an isolated root.
VerifyBasenamePaths :: () -> int {
    arguments := build.arguments();
    directory := arguments[0];
    root := build.root();
    if (length(arguments) > 1 && arguments[1] != "") {
        root = strings.Join([root, "/", arguments[1]], "");
    }
    if (!Installation(root, directory, "libclang.so")) {
        return 1;
    }
    if (!Matches(root, "", root, strings.Join([directory, "/libclang.so"], ""))) {
        return 2;
    }
    return 0;
}
