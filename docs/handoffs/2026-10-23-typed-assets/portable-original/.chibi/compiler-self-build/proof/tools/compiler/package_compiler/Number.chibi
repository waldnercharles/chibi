package package_compiler

import strings "core:strings"

// Numeric literals of floating types: the binary64 nearest the literal, and
// the binary32 nearest that, as stage zero reads them where long double is
// double. The reading
// ports the slow path of Odin's core:strconv (decimal_to_float_bits over
// core:strconv/decimal, itself Go's strconv): the literal becomes a
// multiple-precision decimal that shifts by powers of two until its integer
// part is the rounded mantissa. It needs only integer arithmetic.

// A multiple-precision decimal: digits[0, count), most significant first,
// each 0 to 9, with the decimal point after `point` of them; `trunc` when
// nonzero digits beyond the last were dropped.
Decimal :: union {
    Value(digits: int[], count: int, point: int, trunc: bool) | Malformed
}
// A literal's bit patterns, or OutOfRange for one that must be finite but is
// not: overflow, and underflow to zero or a subnormal.
// `float_fits` is false when the value exceeds the largest binary32.
pub FloatBits :: union {
    Finite(double_bits: uint64, float_fits: bool, float_bits: uint64) | OutOfRange
}

// Odin keeps 384 digits; Go 800. Dropped digits only set `trunc`.
DecimalDigits: int : 800;
// The largest shift whose digit arithmetic stays within int.
MaxShift: int : 27;
// binary64: 52 mantissa bits, 11 exponent bits, bias -1023.
MantissaBits: int : 52;
ExponentLimit: int : 2047;
Bias: int : -1023;

// The decimal without trailing zeros, as Odin's trim leaves it.
Trimmed :: (digits: int[], count: int, point: int, trunc: bool) -> Decimal {
    kept := count;
    while (kept > 0 && digits[kept - 1] == 0) {
        kept -= 1;
    }
    at := point;
    if (kept == 0) {
        at = 0;
    }
    return Decimal.Value(digits, kept, at, trunc);
}

// The decimal spelling of a number literal: digits, an optional fraction and
// an optional exponent, as Odin's decimal.set reads them, except that the
// point counts every significant digit read, those beyond the stored ones
// too.
DecimalOf :: (spelling: string) -> Decimal {
    size := strings.ByteLength(spelling);
    digits: int[] = [];
    count: int = 0;
    read: int = 0;
    point: int = 0;
    trunc := false;
    dot := false;
    seen := false;
    index: int = 0;
    while (index < size) {
        c := strings.ByteAt(spelling, index);
        if (c == 46) {
            if (dot) {
                return Decimal.Malformed;
            }
            dot = true;
            point = read;
        } else if (c >= 48 && c <= 57) {
            seen = true;
            if (c == 48 && read == 0) {
                point -= 1;
            } else {
                read += 1;
                if (count < DecimalDigits) {
                    digits.append(c - 48);
                    count += 1;
                } else if (c != 48) {
                    trunc = true;
                }
            }
        } else {
            break;
        }
        index += 1;
    }
    if (!seen) {
        return Decimal.Malformed;
    }
    if (!dot) {
        point = read;
    }
    if (index < size && (strings.ByteAt(spelling, index) == 101 || strings.ByteAt(spelling, index) == 69)) {
        index += 1;
        sign: int = 1;
        if (index < size && strings.ByteAt(spelling, index) == 43) {
            index += 1;
        } else if (index < size && strings.ByteAt(spelling, index) == 45) {
            index += 1;
            sign = -1;
        }
        if (index >= size || strings.ByteAt(spelling, index) < 48 || strings.ByteAt(spelling, index) > 57) {
            return Decimal.Malformed;
        }
        exponent: int = 0;
        while (index < size && strings.ByteAt(spelling, index) >= 48 && strings.ByteAt(spelling, index) <= 57) {
            if (exponent < 10000) {
                exponent = exponent * 10 + strings.ByteAt(spelling, index) - 48;
            }
            index += 1;
        }
        point += exponent * sign;
    }
    if (index != size) {
        return Decimal.Malformed;
    }
    return Decimal.Value(digits, count, point, trunc);
}

// An integer decimal plus `value`, carrying into new leading digits.
Added :: (digits: int[], count: int, point: int, trunc: bool, value: int) -> Decimal {
    // The integer's every digit, the trimmed zeros included.
    full: int[] = [];
    index: int = 0;
    while (index < point) {
        if (index < count) {
            full.append(digits[index]);
        } else {
            full.append(int(0));
        }
        index += 1;
    }
    carry := value;
    index = point - 1;
    while (carry > 0 && index >= 0) {
        sum := full[index] + carry;
        full[index] = sum % 10;
        carry = sum / 10;
        index -= 1;
    }
    width := point;
    while (carry > 0) {
        lead: int[] = [carry % 10];
        full = extend(lead, full);
        carry = carry / 10;
        width += 1;
    }
    return Trimmed(full, width, width, trunc);
}

// The decimal of a hexadecimal integer literal, `0x` and its digits.
HexDecimalOf :: (spelling: string) -> Decimal {
    size := strings.ByteLength(spelling);
    digits: int[] = [];
    count: int = 0;
    point: int = 0;
    trunc := false;
    index: int = 2;
    while (index < size) {
        digit := HexDigit(strings.ByteAt(spelling, index));
        if (digit < 0) {
            return Decimal.Malformed;
        }
        switch Shifted(digits, count, point, trunc, 4) {
            case .Value(shifted_digits, shifted_count, shifted_point, shifted_trunc):
                switch Added(shifted_digits, shifted_count, shifted_point, shifted_trunc, digit) {
                    case .Value(sum_digits, sum_count, sum_point, sum_trunc):
                        digits = sum_digits;
                        count = sum_count;
                        point = sum_point;
                        trunc = sum_trunc;
                    case .Malformed:
                        return Decimal.Malformed;
                }
            case .Malformed:
                return Decimal.Malformed;
        }
        index += 1;
    }
    return Decimal.Value(digits, count, point, trunc);
}

// The decimal times 2^k for 0 < k <= MaxShift. Odin finds the new length
// from a table of powers of five; computing the carry's digits first gives
// the same digits.
ShiftLeft :: (digits: int[], count: int, point: int, trunc: bool, k: int) -> Decimal {
    // Product digits, least significant first.
    reversed: int[] = [];
    n: int = 0;
    read := count - 1;
    while (read >= 0) {
        n += digits[read] << k;
        quotient := n / 10;
        reversed.append(n - 10 * quotient);
        n = quotient;
        read -= 1;
    }
    while (n > 0) {
        quotient := n / 10;
        reversed.append(n - 10 * quotient);
        n = quotient;
    }
    delta := length(reversed) - count;
    product: int[] = [];
    dropped := trunc;
    index := length(reversed) - 1;
    while (index >= 0) {
        if (length(product) < DecimalDigits) {
            product.append(reversed[index]);
        } else if (reversed[index] != 0) {
            dropped = true;
        }
        index -= 1;
    }
    return Trimmed(product, length(product), point + delta, dropped);
}

// The nonzero decimal divided by 2^k for 0 < k <= MaxShift, as Odin's
// shift_right.
ShiftRight :: (digits: int[], count: int, point: int, trunc: bool, k: int) -> Decimal {
    read: int = 0;
    n: int = 0;
    while ((n >> k) == 0) {
        if (read >= count) {
            while ((n >> k) == 0) {
                n = n * 10;
                read += 1;
            }
            break;
        }
        n = n * 10 + digits[read];
        read += 1;
    }
    at := point - (read - 1);
    mask := (1 << k) - 1;
    quotient: int[] = [];
    while (read < count) {
        next := digits[read];
        quotient.append(n >> k);
        n = n & mask;
        n = n * 10 + next;
        read += 1;
    }
    dropped := trunc;
    while (n > 0) {
        digit := n >> k;
        n = n & mask;
        if (length(quotient) < DecimalDigits) {
            quotient.append(digit);
        } else if (digit > 0) {
            dropped = true;
        }
        n = n * 10;
    }
    return Trimmed(quotient, length(quotient), at, dropped);
}

// The decimal times 2^shift, divided when `shift` is negative, in steps of
// at most MaxShift, as Odin's shift.
Shifted :: (digits: int[], count: int, point: int, trunc: bool, shift: int) -> Decimal {
    current := Decimal.Value(digits, count, point, trunc);
    left := shift;
    while (left != 0) {
        step := left;
        if (step > MaxShift) {
            step = MaxShift;
        }
        if (step < -MaxShift) {
            step = -MaxShift;
        }
        switch current {
            case .Value(now_digits, now_count, now_point, now_trunc):
                if (now_count == 0) {
                    return current;
                }
                if (step > 0) {
                    current = ShiftLeft(now_digits, now_count, now_point, now_trunc, step);
                } else {
                    current = ShiftRight(now_digits, now_count, now_point, now_trunc, -step);
                }
            case .Malformed:
                return current;
        }
        left -= step;
    }
    return current;
}

// Whether rounding at digit `at` rounds up: above half, or exactly half with
// an odd digit before it or truncated digits after it, as Odin's
// can_round_up.
RoundsUp :: (digits: int[], count: int, trunc: bool, at: int) -> bool {
    if (at < 0 || at >= count) {
        return false;
    }
    if (digits[at] == 5 && at + 1 == count) {
        if (trunc) {
            return true;
        }
        return at > 0 && digits[at - 1] % 2 != 0;
    }
    return digits[at] >= 5;
}

// The decimal's integer part, rounded half to even, as Odin's
// rounded_integer; the callers keep it below 2^54.
RoundedInteger :: (digits: int[], count: int, point: int, trunc: bool) -> int64 {
    n: int64 = 0;
    index: int = 0;
    while (index < point && index < count) {
        n = n * 10 + digits[index];
        index += 1;
    }
    while (index < point) {
        n = n * 10;
        index += 1;
    }
    if (RoundsUp(digits, count, trunc, point)) {
        n += 1;
    }
    return n;
}

// The steps that move the decimal point by a decimal place or more, by
// how far it is from the units, as Odin's power_table.
PowerStep :: (distance: int) -> int {
    steps: int[] = [1, 3, 6, 9, 13, 16, 19, 23, 26];
    if (distance >= length(steps)) {
        return 27;
    }
    return steps[distance];
}

// The binary32 nearest a normal binary64 value: its mantissa rounded half to
// even to 24 bits, or to a subnormal's fewer bits, as a C conversion rounds.
FloatFromDouble :: (exponent: int, mantissa: int64) -> int64 {
    whole := mantissa | (int64(1) << 52);
    unbiased := exponent - 1023;
    narrow := unbiased + 127;
    shift: int = 29;
    if (narrow <= 0) {
        shift = 30 - narrow;
    }
    if (shift > 54) {
        return 0;
    }
    kept := whole >> shift;
    rest := whole & ((int64(1) << shift) - 1);
    half := int64(1) << (shift - 1);
    if (rest > half || (rest == half && (kept & 1) != 0)) {
        kept += 1;
    }
    if (narrow <= 0) {
        // A subnormal; rounding up to 2^23 is the least normal's encoding.
        return kept;
    }
    // kept is in [2^23, 2^24]; 2^24 carries into the exponent.
    return (int64(narrow) << 23) + kept - (int64(1) << 23);
}

// The bit patterns of the decimal, negated when `negative`, as Odin's
// decimal_to_float_bits for binary64.
DecimalBits :: (digits: int[], count: int, point: int, trunc: bool, negative: bool) -> FloatBits {
    sign: uint64 = 0;
    if (negative) {
        sign = 0x8000000000000000;
    }
    if (count == 0) {
        float_sign: uint64 = 0;
        if (negative) {
            float_sign = 0x80000000;
        }
        return FloatBits.Finite(sign, true, float_sign);
    }
    if (point > 310 || point < -330) {
        return FloatBits.OutOfRange;
    }
    now_digits := digits;
    now_count := count;
    now_point := point;
    now_trunc := trunc;
    exponent: int = 0;
    while (now_point != 0 || now_digits[0] < 5) {
        shift: int = 0;
        if (now_point > 0) {
            shift = -PowerStep(now_point);
        } else {
            shift = PowerStep(-now_point);
        }
        switch Shifted(now_digits, now_count, now_point, now_trunc, shift) {
            case .Value(shifted_digits, shifted_count, shifted_point, shifted_trunc):
                now_digits = shifted_digits;
                now_count = shifted_count;
                now_point = shifted_point;
                now_trunc = shifted_trunc;
            case .Malformed:
                return FloatBits.OutOfRange;
        }
        exponent -= shift;
    }
    // From [0.5, 1) to [1, 2).
    exponent -= 1;
    if (exponent < Bias + 1) {
        // Below the least normal exponent: the mantissa takes a subnormal's
        // place, though rounding may still make it normal.
        step := Bias + 1 - exponent;
        switch Shifted(now_digits, now_count, now_point, now_trunc, -step) {
            case .Value(shifted_digits, shifted_count, shifted_point, shifted_trunc):
                now_digits = shifted_digits;
                now_count = shifted_count;
                now_point = shifted_point;
                now_trunc = shifted_trunc;
            case .Malformed:
                return FloatBits.OutOfRange;
        }
        exponent += step;
    }
    if (exponent - Bias >= ExponentLimit) {
        return FloatBits.OutOfRange;
    }
    mantissa: int64 = 0;
    switch Shifted(now_digits, now_count, now_point, now_trunc, 1 + MantissaBits) {
        case .Value(final_digits, final_count, final_point, final_trunc):
            mantissa = RoundedInteger(final_digits, final_count, final_point, final_trunc);
        case .Malformed:
            return FloatBits.OutOfRange;
    }
    if (mantissa == int64(2) << MantissaBits) {
        mantissa = mantissa >> 1;
        exponent += 1;
        if (exponent - Bias >= ExponentLimit) {
            return FloatBits.OutOfRange;
        }
    }
    if ((mantissa & (int64(1) << MantissaBits)) == 0) {
        // A result that underflows to zero or a subnormal is out of range.
        return FloatBits.OutOfRange;
    }
    fraction := mantissa & ((int64(1) << MantissaBits) - 1);
    biased := exponent - Bias;
    bits := (int64(biased) << MantissaBits) | fraction;
    // Stage zero compares the value with the largest binary32 before it
    // converts: (2 - 2^-23) * 2^127, exponent 1150 and mantissa 2^52 - 2^29.
    float_fits := biased < 1150 || (biased == 1150 && fraction <= 0xFFFFFE0000000);
    narrow := FloatFromDouble(biased, fraction);
    float_sign: int64 = 0;
    if (negative) {
        float_sign = 0x80000000;
    }
    return FloatBits.Finite(uint64(wrap: bits) | sign, float_fits, uint64(wrap: narrow | float_sign));
}

// The bit patterns of the number literal `spelling`, negated when
// `negative`.
pub LiteralBits :: (spelling: string, negative: bool) -> FloatBits {
    size := strings.ByteLength(spelling);
    hexadecimal := size > 2 && strings.ByteAt(spelling, 0) == 48 &&
                   (strings.ByteAt(spelling, 1) == 120 || strings.ByteAt(spelling, 1) == 88);
    parsed := Decimal.Malformed;
    if (hexadecimal) {
        parsed = HexDecimalOf(spelling);
    } else {
        parsed = DecimalOf(spelling);
    }
    switch parsed {
        case .Value(digits, count, point, trunc):
            return DecimalBits(digits, count, point, trunc, negative);
        case .Malformed:
            return FloatBits.OutOfRange;
    }
}
