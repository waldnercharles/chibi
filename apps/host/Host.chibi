package host

import target "core:target"

// The native Edit and Continue host loads live-0.so, calls Main once, and
// calls Frame until its nonzero result ends the program. A next.so generation
// replaces code between Frames. Named retained leaves migrate before the next
// Frame; incompatible string/scalar changes reject the incoming generation.
// Retired generations keep their code and state until their tasks finish.

RetainedText: int : 12;
RtldNow: i32 : 2;
DarwinRtldLocal: i32 : 4;
DarwinRtldFirst: i32 : 256;
InvalidFileAttributes: u32 : 4294967295;

foreign import kernel32 "system:kernel32"
foreign kernel32 { GetFileAttributesA :: (path: cstring) -> u32 }
foreign import libc "system:c"
foreign libc {
    dlopen :: (path: cstring, flags: i32) -> rawptr
    dlsym :: (handle: rawptr, name: cstring) -> rawptr
    dlclose :: (handle: rawptr) -> i32
    rename :: (from: cstring, to: cstring) -> i32
    unlink :: (path: cstring) -> i32
    access :: (path: cstring, mode: i32) -> i32
    usleep :: (microseconds: u32) -> i32
}

when target.Os == target.Windows {
    import windows "core:sys/windows"
    OpenGeneration :: (path: string) -> rawptr { return windows.OpenLibrary(path); }
    Symbol :: (handle: rawptr, name: string) -> rawptr { return windows.LibrarySymbol(handle, name); }
    CloseGeneration :: (handle: rawptr) -> bool { return windows.CloseLibrary(handle); }
    MoveGeneration :: (from: string, to: string) -> bool { return windows.Rename(from, to); }
    // All polling names are fixed ASCII protocol files. Avoid UTF conversion
    // and allocation on every frame; dynamic image paths use LoadLibraryW.
    HasNext :: () -> bool { return GetFileAttributesA("./next.so") != InvalidFileAttributes; }
    PauseFrame :: () -> bool { return windows.Pause(5); }
    LoadedFile :: (path: string) -> bool { return true; }
    RetiredFile :: (path: string) -> bool { return windows.Remove(path); }
    ProcessArguments :: () -> rawptr { return 0; }
} else {
    // Darwin defaults to global symbol visibility. Look only in this image
    // and keep its symbols private from the other generations.
    when target.Os == target.Darwin {
        OpenGeneration :: (path: string) -> rawptr {
            return dlopen(path, RtldNow | DarwinRtldLocal | DarwinRtldFirst);
        }
    } else {
        OpenGeneration :: (path: string) -> rawptr { return dlopen(path, RtldNow); }
    }
    Symbol :: (handle: rawptr, name: string) -> rawptr { return dlsym(handle, name); }
    CloseGeneration :: (handle: rawptr) -> bool { return dlclose(handle) == 0; }
    MoveGeneration :: (from: string, to: string) -> bool { return rename(from, to) == 0; }
    HasNext :: () -> bool { return access("./next.so", 0) == 0; }
    PauseFrame :: () -> bool { return usleep(5000) == 0; }
    LoadedFile :: (path: string) -> bool { return unlink(path) == 0; }
    RetiredFile :: (path: string) -> bool { return true; }
    ProcessArguments :: () -> rawptr { return chibi_process_argv(); }
}

foreign {
    chibi_argument_count :: () -> i64
    chibi_process_argv :: () -> rawptr
    chibi_environment :: () -> rawptr
}

// Windows keeps a mapped DLL's file until its loader reference is released.
// A retired generation owns both until its suspended tasks finish.
Generation :: struct { handle: rawptr; path: string; }
Discard :: (generation: Generation) -> int {
    released := Release(generation.handle);
    removed := RetiredFile(generation.path);
    return 0;
}

Main :: () -> int {
    active: Generation = {handle: OpenGeneration("./live-0.so"), path: "./live-0.so"};
    if active.handle == 0 {
        return 2;
    }
    if !Complete(active.handle) {
        released := Release(active.handle);
        return 2;
    }
    initialized := Process(active.handle);
    frame: fn() -> i32 = Symbol(active.handle, "chibi_host_call_Frame");
    entries := Entries(active.handle);
    if entries < 0 || entries > 3 {
        released := Release(active.handle);
        return 2;
    }
    started := entries != 0;
    framing := false;
    status := 0;
    if (entries & 1) != 0 { status = Enter(active.handle); }
    else if entries == 0 { print_string("No runnable Main in the root package"); }
    generation := 0;
    retired: Generation[] = [];
    while status == 0 {
        if (entries & 2) != 0 {
            framing = true;
            status = int(frame());
        }
        if Failed(active.handle) {
            status = 134;
        } else if status == 0 {
            polled_active := Poll(active.handle);
            if Failed(active.handle) {
                status = 134;
            }
        }
        if status != 0 {
            break;
        }
        index := 0;
        while index < length(retired) {
            polled := Poll(retired[index].handle);
            if Failed(retired[index].handle) {
                status = 134;
                break;
            }
            if Pending(retired[index].handle) {
                index += 1;
            } else {
                released := Discard(retired[index]);
                retired.remove_index(index);
            }
        }
        if status != 0 {
            break;
        }
        slept := PauseFrame();
        if !HasNext() {
            continue;
        }
        generation += 1;
        name := format_text("./generation-{}.so", generation);
        moved := MoveGeneration("./next.so", name);
        if !moved {
            continue;
        }
        incoming := OpenGeneration(name);
        if incoming == 0 {
            set_aside := MoveGeneration(name, "./rejected.so");
            continue;
        }
        initialized_incoming := Process(incoming);
        incoming_entries := Entries(incoming);
        if incoming_entries < 0 || incoming_entries > 3 || !Complete(incoming) || !Migrate(active.handle, incoming) {
            released := Release(incoming);
            set_aside := MoveGeneration(name, "./rejected.so");
            continue;
        }
        removed := LoadedFile(name);
        next_frame: fn() -> i32 = Symbol(incoming, "chibi_host_call_Frame");
        if Pending(active.handle) {
            retired.append(active);
        } else {
            released := Discard(active);
        }
        active = {handle: incoming, path: name};
        frame = next_frame;
        entries = incoming_entries;
        if framing && (entries & 2) == 0 { print_string("No runnable Frame in the root package"); }
        if !started {
            if entries == 0 { print_string("No runnable Main in the root package"); }
            else {
                started = true;
                if (entries & 1) != 0 { status = Enter(active.handle); }
            }
        }
    }
    released := Discard(active);
    for previous in retired {
        released_previous := Discard(previous);
    }
    return status;
}

// Older library images have no presence metadata and require both entries.
// Current libraries and generations describe only their runnable entries.
Entries :: (handle: rawptr) -> int {
    address := Symbol(handle, "chibi_host_entries");
    if address == 0 { return 3; }
    read: fn() -> i32 = address;
    return int(read());
}
Enter :: (handle: rawptr) -> int {
    start: fn() -> i32 = Symbol(handle, "chibi_host_call_Main");
    status := int(start());
    if Failed(handle) { return 134; }
    return status;
}

Process :: (handle: rawptr) -> int {
    address := Symbol(handle, "chibi_host_set_process");
    if address == 0 { return 0; }
    initialize: fn(count: i64, arguments: rawptr, environment: rawptr) -> i32 = address;
    return int(initialize(chibi_argument_count(), ProcessArguments(), chibi_environment()));
}

Complete :: (handle: rawptr) -> bool {
    entries := Entries(handle);
    if (entries & 1) != 0 && Symbol(handle, "chibi_host_call_Main") == 0 { return false; }
    if (entries & 2) != 0 && Symbol(handle, "chibi_host_call_Frame") == 0 { return false; }
    for symbol in ["chibi_host_retained_count",
                   "chibi_host_retained_type", "chibi_host_retained_hash", "chibi_host_retained_get",
                   "chibi_host_retained_set", "chibi_host_retained_set_as"] {
        if Symbol(handle, symbol) == 0 {
            return false;
        }
    }
    return true;
}

Failed :: (handle: rawptr) -> bool {
    address := Symbol(handle, "chibi_host_failed");
    if address == 0 {
        return false;
    }
    failed: fn() -> i32 = address;
    return failed() != 0;
}

Pending :: (handle: rawptr) -> bool {
    address := Symbol(handle, "chibi_host_tasks_pending");
    if address == 0 {
        return false;
    }
    count: fn() -> i64 = address;
    return count() != 0;
}

Poll :: (handle: rawptr) -> int {
    address := Symbol(handle, "chibi_host_tasks_poll");
    if address != 0 {
        poll: fn() -> i32 = address;
        polled := poll();
    }
    return 0;
}

Release :: (handle: rawptr) -> int {
    cancel_address := Symbol(handle, "chibi_host_tasks_cancel_all");
    if cancel_address != 0 {
        cancel_tasks: fn() -> i32 = cancel_address;
        cancelled := cancel_tasks();
    }
    release_address := Symbol(handle, "chibi_host_retained_release");
    if release_address != 0 {
        release_states: fn() -> i32 = release_address;
        released := release_states();
    }
    closed := CloseGeneration(handle);
    return 0;
}

// Stable indices into the old state table, ordered by name hash. Migration
// sorts once and uses binary search, rather than comparing every pair of states.
Order :: (hashes: i64[]) -> int[] {
    from: int[] = [];
    for index in 0..<length(hashes) { from.append(index); }
    to := from;
    width := 1;
    while width < length(from) {
        start := 0;
        while start < length(from) {
            middle := start + width;
            if middle > length(from) { middle = length(from); }
            end := middle + width;
            if end > length(from) { end = length(from); }
            left := start;
            right := middle;
            for index in start..<end {
                take_left := right == end || (left < middle && hashes[from[left]] <= hashes[from[right]]);
                if take_left {
                    to[index] = from[left];
                    left += 1;
                } else {
                    to[index] = from[right];
                    right += 1;
                }
            }
            start = end;
        }
        from = to;
        width *= 2;
    }
    return from;
}

// Validate every shared leaf before writing any incoming state. Scalar types
// convert; strings require a string on both sides and copy their bytes before
// the old generation can unload.
Migrate :: (old: rawptr, incoming: rawptr) -> bool {
    old_count: fn() -> i32 = Symbol(old, "chibi_host_retained_count");
    old_type: fn(index: i32) -> i32 = Symbol(old, "chibi_host_retained_type");
    old_hash: fn(index: i32) -> i64 = Symbol(old, "chibi_host_retained_hash");
    old_get: fn(index: i32) -> i64 = Symbol(old, "chibi_host_retained_get");
    ready_address := Symbol(old, "chibi_host_retained_ready");
    new_count: fn() -> i32 = Symbol(incoming, "chibi_host_retained_count");
    new_type: fn(index: i32) -> i32 = Symbol(incoming, "chibi_host_retained_type");
    new_hash: fn(index: i32) -> i64 = Symbol(incoming, "chibi_host_retained_hash");
    new_set: fn(index: i32, word: i64) -> i32 = Symbol(incoming, "chibi_host_retained_set");
    new_set_as: fn(index: i32, from: i32, word: i64) -> i32 = Symbol(incoming, "chibi_host_retained_set_as");
    hashes: i64[] = [];
    for source in 0..<int(old_count()) { hashes.append(old_hash(i32(source))); }
    order := Order(hashes);
    sources: int[] = [];
    for target in 0..<int(new_count()) {
        wanted := new_hash(i32(target));
        low := 0;
        high := length(order);
        while low < high {
            middle := low + (high - low) / 2;
            if hashes[order[middle]] < wanted { low = middle + 1; }
            else { high = middle; }
        }
        source := -1;
        if low < length(order) && hashes[order[low]] == wanted { source = order[low]; }
        sources.append(source);
        if source >= 0 && ((old_type(i32(source)) == RetainedText) != (new_type(i32(target)) == RetainedText)) {
            return false;
        }
    }
    for target in 0..<length(sources) {
        source := sources[target];
        if source < 0 { continue; }
        if ready_address != 0 {
            initialized: fn(index: i32) -> i32 = ready_address;
            if initialized(i32(source)) == 0 { continue; }
        }
        if old_type(i32(source)) == new_type(i32(target)) {
            carried := new_set(i32(target), old_get(i32(source)));
        } else {
            converted := new_set_as(i32(target), old_type(i32(source)), old_get(i32(source)));
        }
    }
    return true;
}
