behavior SaveProbe {
    on Begin {
        saved := read_saved_text(Key: "best", Default: "0");
        await set_saved_text(Key: "best", Text: "1");
        await set_saved_text(Key: "scratch", Text: "x");
        await remove_saved_text(Key: "scratch");
        await commit_save();
        await set_saved_text(Key: "pending", Text: "y");
        await discard_save_changes();
    }
}
