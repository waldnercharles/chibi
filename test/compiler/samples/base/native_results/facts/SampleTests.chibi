package facts

// native results
@test
Calls :: () {
    a1_0: string = "\"a\\u00e9\"";
    r1: string = Decode(a1_0);
    e1: string = "aé/3";
    assert(r1 == e1, "Decode call 1");
    a2_0: string = "bad";
    r2: string = Decode(a2_0);
    e2: string = "?";
    assert(r2 == e2, "Decode call 2");
    a3_0: string = "\"x\"";
    r3: bool = Valid(a3_0);
    e3: bool = true;
    assert(r3 == e3, "Valid call 3");
    a4_0: string = "\"abc\"";
    r4: int = Length(a4_0);
    e4: int = 3;
    assert(r4 == e4, "Length call 4");
}
