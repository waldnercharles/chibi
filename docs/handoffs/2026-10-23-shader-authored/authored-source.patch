diff --git a/tools/compiler/compiler_facts/Facts.chibi b/tools/compiler/compiler_facts/Facts.chibi
new file mode 100644
index 000000000..1f3e18588
--- /dev/null
+++ b/tools/compiler/compiler_facts/Facts.chibi
@@ -0,0 +1,187 @@
+package compiler_facts
+
+import syntax "project:syntax_diagnostics"
+
+// Owned analysis output for domain compilers. These are semantic facts, not
+// prepared instructions or the package compiler's temporary work records.
+// All table references are result-local indices; -1 means absent. Origin.node
+// is instead an opaque source-tree anchor scoped by its document. A span is
+// [first, first + count). Source offsets and positions count bytes, with
+// half-open ranges and one-based line/column. Semantic IDs remain full width.
+
+pub Document :: struct {
+    key: string;
+    identity: string;
+    path: string;
+    text: string;
+}
+
+pub Origin :: struct {
+    document: int;
+    // Provenance only: no node table is exported or needed to consume facts.
+    // Never dereference this anchor or compare it across documents/generations.
+    node: int;
+    start: int;
+    end: int;
+    line: int;
+    column: int;
+    occurrence: uint64;
+}
+
+// Storage/container come from the matching compiler target. Qualifiers are
+// the semantic categories below, not raw prepared value or catalog flags.
+pub ReferenceQualifier: int : 1;
+pub OptionalQualifier: int : 2;
+pub ResultQualifier: int : 4;
+pub GenericQualifier: int : 8;
+pub TaskQualifier: int : 16;
+pub NamespaceQualifier: int : 32;
+
+pub Type :: struct {
+    storage: int;
+    container: int;
+    nominal: uint64;
+    qualifiers: int;
+    first_field: int;
+    field_count: int;
+}
+
+// A field's identity is (owner nominal identity, semantic). Its type is the
+// declared type, including nested record identity; ordinal is source order.
+pub Field :: struct {
+    owner_type: int;
+    type: int;
+    origin: int;
+    semantic: uint64;
+    name: string;
+    ordinal: int;
+}
+
+pub SourceFunction: int : 0;
+pub NativeFunction: int : 1;
+
+// Source and native calls both name rows here. Native metadata preserves the
+// shared catalog's kind, actual linked intrinsic and direct-call admission;
+// direct does not imply purity or eligibility for a domain compiler.
+// Source functions use native_kind/intrinsic = -1 and direct = false. All
+// reachable imported source helpers retain their bodies in this table; a
+// source helper is not replaced by a native catalog summary. effects is the
+// final transitive effect mask after ordinary call-graph analysis.
+// A single ordinary result has result_type; -1 means no result. A callable
+// shape this schema cannot represent is retained with unsupported and origin.
+pub Function :: struct {
+    semantic: uint64;
+    name: string;
+    origin: int;
+    kind: int;
+    first_parameter: int;
+    parameter_count: int;
+    result_type: int;
+    first_statement: int;
+    statement_count: int;
+    effects: int;
+    native_kind: int;
+    intrinsic: int;
+    direct: bool;
+    unsupported: string;
+}
+
+pub ParameterBinding: int : 0;
+pub LocalBinding: int : 1;
+pub ResultBinding: int : 2;
+
+// Parameter spans index this table, not types or arguments. Reads refer to
+// the resolved binding row, including through lexical aliases. write_origin
+// and ref_origin retain the first later write and first escaping reference;
+// a local's initialization alone is not a later write.
+pub Binding :: struct {
+    function: int;
+    type: int;
+    origin: int;
+    name: string;
+    role: int;
+    ordinal: int;
+    initializer: int;
+    write_origin: int;
+    ref_origin: int;
+}
+
+pub UnsupportedStatement: int : 0;
+pub InitializeStatement: int : 1;
+pub ReturnStatement: int : 2;
+
+// Unsupported ordinary-valid statements keep their source instead of being
+// silently omitted. Domain rejection can then report the originating range.
+pub Statement :: struct {
+    kind: int;
+    origin: int;
+    binding: int;
+    expression: int;
+    unsupported: string;
+}
+
+pub UnsupportedExpression: int : 0;
+pub ConstantExpression: int : 1;
+pub ReadExpression: int : 2;
+pub BinaryExpression: int : 3;
+pub ConvertExpression: int : 4;
+pub ConstructExpression: int : 5;
+pub ProjectExpression: int : 6;
+pub CallExpression: int : 7;
+
+// The initial export contract names these resolved scalar operators.
+// Other operators retain an UnsupportedExpression and their original range.
+// These classifications are independent of native shader/prepared opcodes.
+pub AddOperation: int : 1;
+pub MultiplyOperation: int : 2;
+
+pub ExactConversion: int : 0;
+pub WrapConversion: int : 1;
+pub ClampConversion: int : 2;
+
+// Each expression's arguments index Argument in source evaluation order.
+// A binary has two arguments; conversion/projection has one. A read uses
+// binding; a call uses callee; projection uses field. operand_type records the
+// resolved scalar operation/conversion input type, separate from result type.
+// Constants retain exact typed bits, with float32 in the low 32 bits and bool
+// as 0/1. Inactive references use -1; inactive scalar classifications use 0.
+pub Expression :: struct {
+    kind: int;
+    origin: int;
+    type: int;
+    operand_type: int;
+    binding: int;
+    callee: int;
+    field: int;
+    operation: int;
+    conversion: int;
+    bits: uint64;
+    first_argument: int;
+    argument_count: int;
+    unsupported: string;
+}
+
+// parameter indexes the destination Binding row; field indexes the
+// destination Field row. Neither changes source evaluation order. Supplied
+// arguments precede omitted defaults, which follow declaration order and
+// reference typed constant expressions. A default's expression origin is its
+// declaration; origin is its call site. Non-call/construct operands use -1
+// for both destinations and defaulted = false.
+pub Argument :: struct {
+    expression: int;
+    parameter: int;
+    field: int;
+    origin: int;
+    defaulted: bool;
+}
+
+// Accepted means ordinary source validation succeeded. A domain compiler must
+// still inspect all reachable unsupported rows, types, effects and bindings.
+// Returned strings/arrays keep their values after the input snapshot retires.
+// This schema declares no Analyze implementation or prepared transport API.
+pub Result :: union {
+    Accepted(entry: int, documents: Document[], origins: Origin[], types: Type[],
+             fields: Field[], functions: Function[], bindings: Binding[],
+             statements: Statement[], expressions: Expression[], arguments: Argument[])
+    | Rejected(documents: Document[], diagnostic: syntax.Diagnostic)
+}
diff --git a/tools/compiler/shader_source/SourceMap.chibi b/tools/compiler/shader_source/SourceMap.chibi
new file mode 100644
index 000000000..bc3e72e1d
--- /dev/null
+++ b/tools/compiler/shader_source/SourceMap.chibi
@@ -0,0 +1,338 @@
+package shader_source
+
+import strings "core:strings"
+
+// Provenance policy only. The native program owns evaluation and raw lanes.
+// This module is preparation source until the authored facade replaces the
+// existing C policy; it is not a second production authority.
+pub Document :: struct {
+    identity: string;
+    text: string;
+}
+
+pub Origin :: struct {
+    source_id: uint64;
+    occurrence: uint64;
+    call_site: uint64;
+    document: int;
+    start: int;
+    end: int;
+}
+
+pub SourceResult :: struct {
+    source_id: uint64;
+    node: int;
+    // -1 is a scalar/vector result; nonnegative values identify aggregate fields.
+    field: int;
+}
+
+pub Failure :: struct {
+    // A source ID is never an IR node index. Zero means no source ID is known.
+    source_id: uint64;
+    // -1 means no node is implicated. A bad result binding can name a bad index.
+    node: int;
+    // -1 means no safe source range is available; document failures use [0, 0).
+    document: int;
+    start: int;
+    end: int;
+    message: string;
+}
+
+pub Validation :: union {
+    Checked | Failed(failure: Failure)
+}
+
+pub ChainResult :: union {
+    Found(origins: Origin[]) | Failed(failure: Failure)
+}
+
+DocumentLimit: int : 256;
+SourceBytesLimit: int : 524288;
+TotalBytesLimit: int : 8388608;
+IdentityBytesLimit: int : 4096;
+OriginLimit: int : 1024;
+ResultLimit: int : 1024;
+NodeLimit: int : 1024;
+
+WithoutRange :: (source_id: uint64, node: int, message: string) -> Failure {
+    return {source_id: source_id, node: node, document: -1, start: 0, end: 0, message: message};
+}
+
+FromDocument :: (document: int, message: string) -> Failure {
+    failure := WithoutRange(uint64(0), -1, message);
+    failure.document = document;
+    return failure;
+}
+
+// Only use after checking this origin's document and byte range.
+FromOrigin :: (origin: Origin, message: string) -> Failure {
+    return {source_id: origin.source_id, node: -1, document: origin.document,
+            start: origin.start, end: origin.end, message: message};
+}
+
+pub OriginIndex :: (origins: Origin[], source_id: uint64) -> int {
+    if (source_id == uint64(0)) {
+        return -1;
+    }
+    index: int = 0;
+    while (index < length(origins)) {
+        if (origins[index].source_id == source_id) {
+            return index;
+        }
+        index += 1;
+    }
+    return -1;
+}
+
+CheckDocuments :: (documents: Document[]) -> Failure {
+    if (length(documents) > DocumentLimit) {
+        return WithoutRange(uint64(0), -1, "Shader source document limit exceeded");
+    }
+    total: int = 0;
+    index: int = 0;
+    while (index < length(documents)) {
+        document := documents[index];
+        identity_size := strings.ByteLength(document.identity);
+        if (identity_size == 0) {
+            return FromDocument(index, "Shader source needs a document identity");
+        }
+        if (identity_size > IdentityBytesLimit) {
+            return FromDocument(index, "Shader source identity byte limit exceeded");
+        }
+        size := strings.ByteLength(document.text);
+        if (size > SourceBytesLimit || size > TotalBytesLimit - total) {
+            return FromDocument(index, "Shader source text byte limit exceeded");
+        }
+        total += size;
+        earlier: int = 0;
+        while (earlier < index) {
+            if (documents[earlier].identity == document.identity) {
+                return FromDocument(index, "Shader source document identities must be unique");
+            }
+            earlier += 1;
+        }
+        index += 1;
+    }
+    return WithoutRange(uint64(0), -1, "");
+}
+
+CheckOrigins :: (documents: Document[], origins: Origin[]) -> Failure {
+    if (length(origins) > OriginLimit) {
+        return WithoutRange(uint64(0), -1, "Shader source origin limit exceeded");
+    }
+    index: int = 0;
+    while (index < length(origins)) {
+        origin := origins[index];
+        if (origin.source_id == uint64(0) || origin.document < 0 || origin.document >= length(documents)) {
+            return WithoutRange(origin.source_id, -1, "Shader source origin has an invalid identity or document");
+        }
+        if (origin.start < 0 || origin.end <= origin.start ||
+            origin.end > strings.ByteLength(documents[origin.document].text)) {
+            return WithoutRange(origin.source_id, -1, "Shader source origin has an invalid byte range");
+        }
+        earlier: int = 0;
+        while (earlier < index) {
+            if (origins[earlier].source_id == origin.source_id) {
+                return FromOrigin(origin, "Shader source IDs must have unique origins");
+            }
+            earlier += 1;
+        }
+        index += 1;
+    }
+    return WithoutRange(uint64(0), -1, "");
+}
+
+CheckCalls :: (origins: Origin[]) -> Failure {
+    // Resolve links once. Colors are 0 unvisited, 1 on this path, 2 complete.
+    parents: int[] = [];
+    for (origin in origins) {
+        parent: int = -1;
+        if (origin.call_site != uint64(0)) {
+            parent = OriginIndex(origins, origin.call_site);
+            if (parent < 0) {
+                return FromOrigin(origin, "Shader source call chain has a missing origin");
+            }
+        }
+        parents.append(parent);
+    }
+    colors: int[] = resize([int(0)], length(origins));
+    index: int = 0;
+    while (index < length(origins)) {
+        at := index;
+        while (at >= 0 && colors[at] == 0) {
+            colors[at] = 1;
+            at = parents[at];
+        }
+        if (at >= 0 && colors[at] == 1) {
+            return FromOrigin(origins[at], "Shader source call chain contains a cycle");
+        }
+        at = index;
+        while (at >= 0 && colors[at] == 1) {
+            colors[at] = 2;
+            at = parents[at];
+        }
+        index += 1;
+    }
+    return WithoutRange(uint64(0), -1, "");
+}
+
+CheckResults :: (origins: Origin[], results: SourceResult[], node_count: int) -> Failure {
+    if (length(results) > ResultLimit) {
+        return WithoutRange(uint64(0), -1, "Shader source result limit exceeded");
+    }
+    index: int = 0;
+    while (index < length(results)) {
+        result := results[index];
+        found := OriginIndex(origins, result.source_id);
+        if (found < 0) {
+            return WithoutRange(result.source_id, result.node, "Shader source result has no origin");
+        }
+        if (result.node < 0 || result.node >= node_count || result.field < -1) {
+            failure := FromOrigin(origins[found], "Shader source result has an invalid node or field");
+            failure.node = result.node;
+            return failure;
+        }
+        earlier: int = 0;
+        while (earlier < index) {
+            if (results[earlier].source_id == result.source_id && results[earlier].field == result.field) {
+                return FromOrigin(origins[found], "Shader source result bindings must be unique per field");
+            }
+            earlier += 1;
+        }
+        index += 1;
+    }
+    return WithoutRange(uint64(0), -1, "");
+}
+
+// Node sources describe the same immutable program generation as these tables.
+// This checks provenance, not shader operations, types or aggregate member IDs.
+// Results may alias nodes carrying another source ID, or a synthetic zero ID.
+pub Validate :: (documents: Document[], origins: Origin[], results: SourceResult[],
+                 node_sources: uint64[]) -> Validation {
+    failure := CheckDocuments(documents);
+    if (failure.message != "") {
+        return Validation.Failed(failure);
+    }
+    failure = CheckOrigins(documents, origins);
+    if (failure.message != "") {
+        return Validation.Failed(failure);
+    }
+    failure = CheckCalls(origins);
+    if (failure.message != "") {
+        return Validation.Failed(failure);
+    }
+    if (length(node_sources) > NodeLimit) {
+        return Validation.Failed(WithoutRange(uint64(0), -1, "Shader source node limit exceeded"));
+    }
+    index: int = 0;
+    while (index < length(node_sources)) {
+        source_id := node_sources[index];
+        if (source_id != uint64(0) && OriginIndex(origins, source_id) < 0) {
+            return Validation.Failed(WithoutRange(source_id, index, "Shader operation has no source origin"));
+        }
+        index += 1;
+    }
+    failure = CheckResults(origins, results, length(node_sources));
+    if (failure.message != "") {
+        return Validation.Failed(failure);
+    }
+    return Validation.Checked;
+}
+
+// Documents are length-carrying strings. Native C-string rules do not apply.
+// Validate the captured tables before using these equality queries.
+pub DocumentMatches :: (captured: Document, current: Document) -> bool {
+    return captured.identity == current.identity && captured.text == current.text;
+}
+
+pub DocumentsMatch :: (captured: Document[], current: Document[]) -> bool {
+    if (length(captured) != length(current)) {
+        return false;
+    }
+    index: int = 0;
+    while (index < length(captured)) {
+        if (!DocumentMatches(captured[index], current[index])) {
+            return false;
+        }
+        index += 1;
+    }
+    return true;
+}
+
+pub GenerationMatches :: (captured: uint64, current: uint64) -> bool {
+    return captured != uint64(0) && current != uint64(0) && captured == current;
+}
+
+// A mechanical host can compare one document pair at a time, then reduce the
+// ordered results here without sending two entire source closures in one call.
+pub ClosureMatches :: (captured_program: uint64, current_program: uint64,
+                       captured_count: int, current_count: int, matches: bool[]) -> bool {
+    if (!GenerationMatches(captured_program, current_program) || captured_count < 0 ||
+        captured_count > DocumentLimit || current_count != captured_count || length(matches) != captured_count) {
+        return false;
+    }
+    for (matched in matches) {
+        if (!matched) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// Lookups use tables accepted by Validate and return -1 when absent.
+pub ResultNode :: (results: SourceResult[], source_id: uint64, field: int) -> int {
+    if (source_id == uint64(0) || field < -1) {
+        return -1;
+    }
+    for (result in results) {
+        if (result.source_id == source_id && result.field == field) {
+            return result.node;
+        }
+    }
+    return -1;
+}
+
+pub FindNode :: (node_sources: uint64[], source_id: uint64, after: int) -> int {
+    if (source_id == uint64(0) || after < -1 || after >= length(node_sources)) {
+        return -1;
+    }
+    index := after + 1;
+    while (index < length(node_sources)) {
+        if (node_sources[index] == source_id) {
+            return index;
+        }
+        index += 1;
+    }
+    return -1;
+}
+
+// Returns owned origin copies, requested origin first and outermost caller
+// last. Origin-only callers are retained. Validate supplies range/uniqueness
+// guarantees; this query also rejects missing links and cycles on its own.
+pub CallChain :: (origins: Origin[], source_id: uint64) -> ChainResult {
+    if (length(origins) > OriginLimit) {
+        return ChainResult.Failed(WithoutRange(source_id, -1, "Shader source origin limit exceeded"));
+    }
+    at := OriginIndex(origins, source_id);
+    if (at < 0) {
+        return ChainResult.Failed(WithoutRange(source_id, -1, "Shader source origin was not found"));
+    }
+    seen: bool[] = resize([false], length(origins));
+    chain: Origin[] = [];
+    while (at >= 0) {
+        origin := origins[at];
+        if (seen[at]) {
+            return ChainResult.Failed(FromOrigin(origin, "Shader source call chain contains a cycle"));
+        }
+        seen[at] = true;
+        chain.append(origin);
+        if (origin.call_site == uint64(0)) {
+            return ChainResult.Found(chain);
+        }
+        at = OriginIndex(origins, origin.call_site);
+        if (at < 0) {
+            return ChainResult.Failed(FromOrigin(origin, "Shader source call chain has a missing origin"));
+        }
+    }
+    return ChainResult.Found(chain);
+}
