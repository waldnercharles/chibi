package facts
import lib "project:forwarded_callback_labels_survive_erased_and_reordered_argum/lib"
Join :: (left: int, right: int) -> int { return left * 100 + right; }
Mark :: (order: ^int, digit: int, value: int) -> int { order^ = order^ * 10 + digit; return value; }
Positional :: () -> int { return lib.Forward(2, 3, Join, 4); }
Named :: () -> int { order := 0; result := lib.Forward(tail: Mark(&order, 1, 4), operation: Join, input: Mark(&order, 2, 3), Count: 2); return order * 1000 + result; }
Inline :: () -> int { return lib.Forward(2, 3, (a: int, b: int) => a * 10 + b, 4); }
