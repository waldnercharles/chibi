package view_schema_probe

import native "project:llvm_native"
import abi "project:native_abi"
import link "project:native_link"
import host "project:native_link_host"
import os "core:os"
import strings "core:strings"

foreign import libc "system:c"
foreign libc { strtoll :: (text: cstring, end: rawptr, base: i32) -> i64 }

Op :: (op: int, type: int, output: int, left: int, right: int, target: int, literal: i64) -> native.Instruction {
    return {op: op, type: type, output: output, left: left, right: right, target: target, literal: literal};
}
Module :: (target: abi.Target, ordinal: int, tag: i64, create: bool) -> string {
    record := native.RecordType + ordinal;
    inner := native.ArrayType + abi.IntStorage;
    array := native.ArrayType + record;
    records: native.Record[] = [{first: 0, count: 2, identity: 0}];
    fields := [abi.IntStorage, inner];
    if (ordinal == 1) { records = [{first: 0, count: 1, identity: 0}, {first: 1, count: 2, identity: 0}]; fields = [abi.DoubleStorage, abi.IntStorage, inner]; }
    parameters: int[] = [];
    slots: int[] = [];
    code: native.Instruction[] = [];
    result := abi.IntStorage;
    adapter := "";
    if (create) {
        result = native.PointerType;
        slots = [abi.IntStorage, inner, inner, record, record, array, array, native.PointerType];
        code = [Op(native.Constant, abi.IntStorage, 0, 0, 0, 0, 7),
            Op(native.Constant, inner, 1, 0, 0, 0, 0), Op(native.ArrayPush, inner, 2, 1, 0, 0, 1),
            Op(native.Constant, record, 3, 0, 0, 0, 0), Op(native.Insert, record, 4, 3, 2, 0, 1),
            Op(native.Constant, array, 5, 0, 0, 0, 0), Op(native.ArrayPush, array, 6, 5, 4, 0, 1),
            Op(native.ManagedNew, native.PointerType, 7, 6, array, 0, tag),
            Op(native.ArrayDrop, array, 0, 6, 0, 0, 0),
            Op(native.Publish, native.PointerType, 0, 7, 0, 0, 0), Op(native.Return, 0, 0, 0, 0, 0, 0)];
        adapter = strings.Concatenate([
            "@view_schema.root = internal global %chibi.managed.root zeroinitializer\n",
            "@view_schema.owner = internal global { ptr, i64, i64 } zeroinitializer\n",
            "define i32 @view_schema_create(ptr %window) {\nentry:\n",
            "  %pointer = call { ptr, i64, i64 } @chibi_scalar.0(ptr @chibi_context)\n",
            "  store { ptr, i64, i64 } %pointer, ptr @view_schema.owner\n",
            "  %value = insertvalue { { ptr, i64, i64 }, i32, i32 } zeroinitializer, { ptr, i64, i64 } %pointer, 0\n",
            "  %window.value = insertvalue { { ptr, i64, i64 }, i32, i32 } %value, i32 1, 2\n",
            "  store { { ptr, i64, i64 }, i32, i32 } %window.value, ptr %window\n",
            format_text("  %heap.at = getelementptr {}, ptr @chibi_context, i32 0, i32 {}\n", abi.ManagedContextType(), abi.ManagedOwnerField),
            "  %heap = load ptr, ptr %heap.at\n",
            "  call void @chibi_managed.push(ptr %heap, ptr @view_schema.root, ptr @view_schema.owner, ptr @chibi_managed.trace.pointer)\n  ret i32 0\n}\n",
            "define i32 @view_schema_release() {\nentry:\n",
            format_text("  %heap.at = getelementptr {}, ptr @chibi_context, i32 0, i32 {}\n", abi.ManagedContextType(), abi.ManagedOwnerField),
            "  %heap = load ptr, ptr %heap.at\n  call void @chibi_managed.pop(ptr %heap, ptr @view_schema.root)\n",
            "  store { ptr, i64, i64 } zeroinitializer, ptr @view_schema.owner\n  ret i32 0\n}\n"]);
    } else {
        parameters = [native.ViewType];
        slots = [native.ViewType, abi.IntStorage, record, inner, abi.IntStorage];
        code = [Op(native.Argument, native.ViewType, 0, 0, 0, 0, 0), Op(native.Constant, abi.IntStorage, 1, 0, 0, 0, 0),
            Op(native.ViewGet, record, 2, 0, 1, 0, tag), Op(native.Extract, inner, 3, 2, record, 0, 1),
            Op(native.ArrayGet, abi.IntStorage, 4, 3, 1, 0, 0),
            Op(native.Publish, abi.IntStorage, 0, 4, 0, 0, 0), Op(native.Return, 0, 0, 0, 0, 0, 0)];
        adapter = strings.Concatenate([
            "define i32 @view_schema_read(ptr %window) {\nentry:\n",
            "  %value = load { { ptr, i64, i64 }, i32, i32 }, ptr %window\n",
            "  %result = call i32 @chibi_scalar.0(ptr @chibi_context, { { ptr, i64, i64 }, i32, i32 } %value)\n  ret i32 %result\n}\n"]);
    }
    shape: native.Function = {result: result, first_parameter: 0, parameters: length(parameters), first_slot: 0, slots: length(slots),
        first_local: 0, locals: 0, first_code: 0, code: length(code), first_argument: 0, arguments: 0};
    switch native.EmitFamilyLibraryStates(target, "ViewSchema", ["Value"], [i64(1)], [shape], parameters, slots, [], code, [],
                                          records, fields, [], [], 1, [], -1, []) {
        case .Rejected(pc, message): os.Print(format_text("view schema IR{}: {}", pc, message)); return "";
        case .Emitted(text): return strings.Concatenate([text, adapter]);
    }
}
Main :: () -> int {
    args := os.Arguments();
    if (length(args) != 5) { return 2; }
    work := args[0]; llvm := args[1];
    tags: i64[] = [];
    for (identity in slice(args, 2, 3)) {
        if (strings.ByteLength(identity) == 0 || strings.ByteLength(identity) > 20) { return 2; }
        for (index in 0..<strings.ByteLength(identity)) {
            byte := text_byte_at(identity, index);
            if (index == 0 && byte == 45) { continue; }
            if (byte < 48 || byte > 57) { return 2; }
        }
        tag := strtoll(identity, 0, 10);
        if (tag == 0 || format_text("{}", tag) != identity) { return 2; }
        tags.append(tag);
    }
    if (args[2] != args[3] || args[2] == args[4] || args[2] == "0" || args[4] == "0") { return 1; }
    target := abi.LinuxX64();
    if (os.Platform() == "Darwin") { target = abi.MacOSArm64(); }
    start := strings.Concatenate([work, "/schema-start.ll"]);
    if (os.WriteText(start, link.ManagedFamilyContext(link.SharedContext(target.triple, true), true))) { return 2; }
    for (level in [int(0), 2]) {
        for (name in ["old", "compatible", "changed"]) {
            ordinal := 1; tag := tags[0];
            if (name == "old") { ordinal = 0; }
            if (name == "changed") { tag = tags[2]; }
            text := Module(target, ordinal, tag, name == "old");
            if (text == "") { return 1; }
            path := format_text("{}/schema-{}.ll", work, name);
            output := format_text("{}/schema-{}-O{}.so", work, name, level);
            if (os.WriteText(path, text)) { return 2; }
            objects := [strings.Concatenate([output, ".o"]), strings.Concatenate([output, "-start.o"])];
            if (host.Objects(llvm, [path, start], objects, level, 1)) { return 1; }
            plan := link.Program(target.triple, llvm, objects, [], [], [], output, "", false);
            plan.shared = true;
            if (os.Platform() == "Darwin") { plan.imports = [{name: "System", symbols: ["malloc", "calloc", "free", "write", "abort"]}]; }
            else { plan.libraries = ["c"]; }
            if (host.Link(plan)) { return 1; }
        }
    }
    return 0;
}
