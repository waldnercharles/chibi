package facts

// fallible sibling assignments permit actual error handling
@test
Calls :: () {
    r1: int = Use();
    e1: int = 5;
    assert(r1 == e1, "Use call 1");
    r2: int = Alias();
    e2: int = 5;
    assert(r2 == e2, "Alias call 2");
    r3: int = Original();
    e3: int = 5;
    assert(r3 == e3, "Original call 3");
}
