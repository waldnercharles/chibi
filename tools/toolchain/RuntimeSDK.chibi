package toolchain

import sdk "graph:sdk"
import os "core:os"

// The dependency archive is the one the build recorded unless one is named.
RuntimePackage :: () -> int {
    arguments := os.Arguments();
    for (index in 0..<length(arguments)) {
        if (index % 2 == 0 && (arguments[index] != "--build" && arguments[index] != "--third-party" &&
                               arguments[index] != "--output")) {
            sdk.RuntimeFail("unknown runtime package option");
            return 2;
        }
    }
    build_dir := sdk.RuntimeOption(arguments, "--build");
    third_party := sdk.RuntimeOption(arguments, "--third-party");
    if (third_party == "" && length(arguments) == 4) {
        configuration := sdk.JsonCanonical(build.read_file(sdk.RuntimeJoin([build_dir, "/sdk/runtime-build.json"])));
        third_party = sdk.JsonText(sdk.JsonGet(sdk.JsonGet(configuration, "profile"), "third_party"));
    }
    if ((length(arguments) != 6 && length(arguments) != 4) || build_dir == "" || third_party == "" ||
        sdk.RuntimeOption(arguments, "--output") == "") {
        sdk.RuntimeFail("runtime package requires --build and --output, and --third-party unless the build recorded one");
        return 2;
    }
    return sdk.RuntimeAssemble(os.Root(), build_dir, third_party, sdk.RuntimeOption(arguments, "--output"));
}
