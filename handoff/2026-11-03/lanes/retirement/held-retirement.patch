-                   (i->op >= BF_LT && i->op <= BF_NE) ||
-                   (i->op >= BF_BIT_AND && i->op <= BF_SHR) || i->op == BF_SAVE ||
-                   i->op == BF_BRANCH || i->op == BF_INDEX || i->op == BF_WRITE;
