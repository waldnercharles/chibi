package vnext_typed

import parser "project:source_parser"
import reader "project:signature_reader"
import binding "project:lexical_binding"
import named "project:named_binding"
import constructors "project:type_constructors"
import syntax "project:syntax_diagnostics"
import token "project:source_tokenizer"
import graph "project:package_graph"
import strings "core:strings"

DecimalZero: int : 48;
PathSlash: int : 47;
PathDot: int : 46;
PathColon: int : 58;
PathBackslash: int : 92;
MaxSources: int : 8;
MaxImports: int : 32;
MaxPathBytes: int : 256;

// Invocation inputs, not part of Model or its native transport. Paths are
// canonical project-relative locations; the first file selects the entry
// package. The caller supplies bytes and locations, never semantic decisions.
pub Source :: struct { path: string; text: string; document: int; }
Document :: struct {
    tree: reader.Tree;
    nodes: syntax.Node[];
    text: string;
    document: int;
    root: int;
    node_base: int;
}
Header :: struct { source: int; declaration: int; name: int; public: bool; }
Library :: struct { alias: int; path: string; name: u32; }

// One invocation owns this scratch state and a separate Module. Output helpers
// take both as direct scoped parameters: the old seed rejected the version
// storing a Module pointer with ReadEffect. This removes that path without duplicating the
// schema or explicitly copying Module values per node. Actual lowering/COW
// traffic remains unmeasured. Branch snapshots copy at most 64 IDs per detach.
State :: struct {
    tree: reader.Tree;
    environment: reader.Environment;
    nodes: syntax.Node[];
    text: string;
    document: int;
    source: int;
    node_base: int;
    documents: Document[];
    packages: int[];
    imports: graph.Binding[];
    headers: Header[];
    diagnostics: syntax.Diagnostic[];
    parameter_names: int[];
    bindings: int[];
    current_values: u32[];
    origin_ids: u32[];
    block: u32;
    first_block: int;
    result_type: u32;
}

EmptyModule :: () -> Module {
    return {functions: [], foreigns: [], signatures: [], parameter_types: [], blocks: [],
            block_parameters: [], values: [], instructions: [], edges: [], calls: [],
            arguments: [], literals: [], origins: [], names: [], name_bytes: []};
}

// Retain the real annotation reader without broad callable-header publication,
// prepared emission, scalar lowering or a second type interpretation.
SignatureEnvironment :: () -> reader.Environment {
    scope: binding.Scope = {parent: -1, function: -1, start: 0, end: 0,
                            line: 1, column: 1, document: 0};
    symbols: binding.Symbol[] = [];
    functions: binding.Function[] = [];
    ids: u64[] = [];
    keys: string[] = [];
    lexical := binding.Environment.Tables([scope], symbols, functions, ids, keys);
    types: named.Type[] = [];
    entries: named.Entry[] = [];
    indices: int[] = [];
    imports: named.Import[] = [];
    exports: named.Export[] = [];
    uses: named.Use[] = [];
    names := named.Environment.Tables(lexical, types, ids, entries, entries, entries,
                                      indices, imports, exports, uses, "vnext-scalar", 0, false, true, 0);
    definitions: constructors.Definition[] = [];
    variants: constructors.RawVariant[] = [];
    capabilities: constructors.Capability[] = [];
    constructors_functions: constructors.Function[] = [];
    constructors_symbols: constructors.Symbol[] = [];
    construction := constructors.Environment.Tables(types, ids, definitions, variants,
                                                    capabilities, constructors_functions, constructors_symbols, indices);
    return reader.Environment.Tables(names, construction, 8);
}

Fail :: (s: ^State, node: int, message: string) {
    if (length(s.diagnostics) == 0) {
        diagnostic := reader.Diagnostic(s.tree, node, s.document, message);
        diagnostic.document = s.document;
        s.diagnostics.append(diagnostic);
    }
}
SelectSource :: (s: ^State, source: int) {
    document := s.documents[source];
    s.tree = document.tree;
    s.nodes = document.nodes;
    s.text = document.text;
    s.document = document.document;
    s.source = source;
    s.node_base = document.node_base;
}
First :: (s: ^State, parent: int) -> int {
    if (parent < 0) { return -1; }
    return reader.NextMember(s.tree, s.nodes[parent].first_child);
}
Next :: (s: ^State, node: int) -> int {
    return reader.NextMember(s.tree, s.nodes[node].next_sibling);
}

// Local names compare source byte views without allocating per use.
// FindBinding scans at most 64 currently visible parameters/locals.
SameName :: (s: ^State, left: int, right: int) -> bool {
    a := s.nodes[left];
    b := s.nodes[right];
    if (a.end - a.start != b.end - b.start) { return false; }
    index: int = 0;
    while (index < a.end - a.start) {
        if (text_byte_at(s.text, a.start + index) != text_byte_at(s.text, b.start + index)) { return false; }
        index += 1;
    }
    return true;
}
// Header and import lookups are bounded by 32 rows for the entire closure.
// Compare source views across documents without allocating per call/use.
HeaderMatches :: (s: ^State, header: Header, node: int) -> bool {
    document := s.documents[header.source];
    a := document.nodes[header.name];
    b := s.nodes[node];
    if (a.end - a.start != b.end - b.start) { return false; }
    for (index in 0..<a.end - a.start) {
        if (text_byte_at(document.text, a.start + index) != text_byte_at(s.text, b.start + index)) { return false; }
    }
    return true;
}
SpellingMatches :: (s: ^State, node: int, name: string) -> bool {
    source := s.nodes[node];
    if (source.end - source.start != text_byte_length(name)) { return false; }
    for (index in 0..<source.end - source.start) {
        if (text_byte_at(s.text, source.start + index) != text_byte_at(name, index)) { return false; }
    }
    return true;
}
AdmitName :: (s: ^State, node: int) -> bool {
    if (!reader.Kind(s.tree, node, syntax.Identifier)) {
        Fail(s, node, "vNext scalar slice requires an identifier binding");
        return false;
    }
    spelling := reader.Text(s.tree, node);
    if (spelling == "_") {
        Fail(s, node, "vNext scalar slice requires a named binding");
        return false;
    }
    if (spelling == "Cancelled") {
        Fail(s, node, "'Cancelled' is reserved for the cancellation singleton");
        return false;
    }
    return true;
}
FindBinding :: (s: ^State, node: int) -> int {
    index := length(s.bindings) - 1;
    while (index >= 0) {
        if (SameName(s, s.bindings[index], node)) { return index; }
        index -= 1;
    }
    return -1;
}
OriginID :: (s: ^State, output: ^Module, node: int) -> u32 {
    assert(node >= 0, "origin requires a syntax node");
    slot := s.node_base + node;
    if (s.origin_ids[slot] != 0) { return s.origin_ids[slot]; }
    source := s.nodes[node];
    row: Origin = {document: u32(s.document), start: u32(source.start), end: u32(source.end)};
    output.origins.append(row);
    id := u32(length(output.origins));
    s.origin_ids[slot] = id;
    return id;
}
ReadType :: (s: ^State, node: int, owner: int) -> u32 {
    if (node < 0) { node = owner; }
    // Ordinary scalar annotations only. Reject modifiers, constructors, units,
    // nominal types and parameter types before they can expand the closure.
    if (!reader.Kind(s.tree, node, syntax.Type)) {
        Fail(s, node, "vNext scalar slice requires an explicit i64 or bool type");
        return 0;
    }
    spelling := reader.Text(s.tree, node);
    if (spelling != "i64" && spelling != "bool") {
        Fail(s, node, "vNext scalar slice supports only ordinary i64 and bool types");
        return 0;
    }
    switch reader.Signature(s.environment, s.tree, node, 0, s.document) {
        case .Read(value, has_unit, unit, updated, diagnostics, uses, publications, collection):
            if (length(diagnostics) != 0) {
                s.diagnostics.append(diagnostics[0]);
                return 0;
            }
            switch value {
                case .Typed(storage, container, flags, nominal, parameter):
                    if ((storage != 1 && storage != 8) || container != 0 || flags != 0 ||
                        nominal != 0 || parameter != 0 || has_unit || unit != "" || collection != 0 ||
                        length(uses) != 0 || length(publications) != 0) {
                        Fail(s, node, "vNext scalar slice rejected a nonordinary scalar signature");
                        return 0;
                    }
                    if (storage == 1) { return Bool; }
                    return I64;
            }
    }
}

// Both authored and foreign declarations use the retained annotation reader.
FunctionHeader :: (s: ^State, output: ^Module, declaration: int, library_id: u32) {
    if (length(s.headers) == MaxFunctions) {
        Fail(s, declaration, "vNext scalar slice exceeds 32 functions");
        return;
    }
    if (reader.Field(s.tree, declaration, syntax.FieldAttribute) >= 0) {
        Fail(s, declaration, "attributes are unsupported in vNext scalar slice");
        return;
    }
    name := reader.Field(s.tree, declaration, syntax.FieldName);
    if (!AdmitName(s, name)) { return; }
    for (header in s.headers) {
        if (s.packages[header.source] == s.packages[s.source] && HeaderMatches(s, header, name)) {
            Fail(s, name, "duplicate function name");
            return;
        }
    }
    parameter_first := length(output.parameter_types);
    parameters := reader.Field(s.tree, declaration, syntax.FieldParameters);
    parameter := First(s, parameters);
    s.bindings = [];
    while (parameter >= 0 && length(s.diagnostics) == 0) {
        if (length(s.bindings) == MaxParameters) {
            Fail(s, parameter, "vNext scalar slice exceeds 32 parameters");
            return;
        }
        if (!reader.Kind(s.tree, parameter, syntax.Parameter) ||
            reader.Field(s.tree, parameter, syntax.FieldComptime) >= 0 ||
            reader.Field(s.tree, parameter, syntax.FieldValue) >= 0 ||
            reader.Field(s.tree, parameter, syntax.FieldSource) >= 0) {
            Fail(s, parameter, "vNext scalar slice requires ordinary explicit parameters");
            return;
        }
        parameter_name := reader.Field(s.tree, parameter, syntax.FieldName);
        if (!AdmitName(s, parameter_name)) { return; }
        if (FindBinding(s, parameter_name) >= 0) {
            Fail(s, parameter_name, "duplicate parameter name");
            return;
        }
        type := ReadType(s, reader.Field(s.tree, parameter, syntax.FieldType), parameter);
        if (type == 0) { return; }
        s.bindings.append(parameter_name);
        s.parameter_names.append(parameter_name);
        output.parameter_types.append(type);
        parameter = Next(s, parameter);
    }
    result_type := ReadType(s, reader.Field(s.tree, declaration, syntax.FieldResults), declaration);
    if (result_type == 0) { return; }
    count := length(s.bindings);
    if (count == 0) { parameter_first = 0; }
    signature: Signature = {first_parameter: u32(parameter_first), parameter_count: u32(count), result_type: result_type};
    output.signatures.append(signature);
    source := s.nodes[name];
    first_name := length(output.name_bytes);
    entry_package := s.packages[s.source] == s.packages[0];
    if (entry_package || library_id != 0) {
        for (index in source.start..<source.end) {
            output.name_bytes.append(u8(text_byte_at(s.text, index)));
        }
    } else {
        // A dot cannot be part of a source Identifier. Global IDs keep
        // dependency names unique without hashing or backend resolution.
        symbol := format_text(".vnext.{}", length(s.headers) + 1);
        for (index in 0..<text_byte_length(symbol)) {
            output.name_bytes.append(u8(text_byte_at(symbol, index)));
        }
    }
    // Each <=9-byte dependency name is shorter than its declaration;
    // entry names are disjoint source spans within the aggregate byte cap.
    assert(length(output.name_bytes) <= MaxSourceBytes, "admitted source bounds emitted names");
    function_name: Name = {start: u32(first_name), count: u32(length(output.name_bytes) - first_name)};
    output.names.append(function_name);
    public := reader.Field(s.tree, declaration, syntax.FieldVisibility) >= 0;
    exported: u32 = 0;
    if (entry_package && public && library_id == 0) { exported = 1; }
    function: Function = {name: u32(length(output.names)), signature: u32(length(output.signatures)),
                          first_block: 0, block_count: 0, origin: OriginID(s, output, declaration), exported: exported};
    // At most 32 function names are compared per admitted header. Native names
    // must be unique even across libraries: AOT cannot distinguish two C symbols.
    for (previous in output.functions) {
        a := output.names[int(previous.name) - 1];
        b := output.names[int(function.name) - 1];
        equal := a.count == b.count;
        for (index in 0..<int(a.count)) {
            if (!equal) { break; }
            if (output.name_bytes[int(a.start) + index] != output.name_bytes[int(b.start) + index]) { equal = false; }
        }
        if (equal) { Fail(s, name, "duplicate native symbol name"); return; }
    }
    output.functions.append(function);
    if (library_id != 0) {
        imported: Foreign = {function: u32(length(output.functions)), library: library_id};
        output.foreigns.append(imported);
    }
    header: Header = {source: s.source, declaration: declaration, name: name, public: public};
    s.headers.append(header);
}

Headers :: (s: ^State, output: ^Module, root: int) {
    declaration := First(s, root);
    if (!reader.Kind(s.tree, declaration, syntax.PackageHeader)) {
        Fail(s, root, "vNext scalar slice requires one package header");
        return;
    }
    // Foreign aliases are file-local and precede their blocks, matching the
    // current compiler. At most 32 rows are scanned once per foreign block.
    libraries: Library[] = [];
    declaration = Next(s, declaration);
    while (declaration >= 0 && length(s.diagnostics) == 0) {
        kind := s.nodes[declaration].kind;
        if (kind == syntax.FunctionDeclaration) {
            FunctionHeader(s, output, declaration, 0);
        } else if (kind == syntax.ForeignImportDeclaration) {
            if (length(libraries) == MaxLibraries) {
                Fail(s, declaration, "vNext scalar slice exceeds 32 foreign libraries per source");
                return;
            }
            alias := reader.Field(s.tree, declaration, syntax.FieldAlias);
            if (!AdmitName(s, alias)) { return; }
            for (foreign_library in libraries) {
                if (SameName(s, alias, foreign_library.alias)) { Fail(s, alias, "duplicate foreign library alias"); return; }
            }
            path_node := reader.Field(s.tree, declaration, syntax.FieldPath);
            switch reader.Name(s.tree, path_node, s.document) {
                case .Name(path, diagnostics):
                    if (length(diagnostics) != 0) { s.diagnostics.append(diagnostics[0]); return; }
                    if (text_byte_length(path) == 0 || text_byte_length(path) > MaxLibraryBytes) {
                        Fail(s, path_node, "foreign library identity requires 1..256 bytes"); return;
                    }
                    for (index in 0..<text_byte_length(path)) {
                        if (text_byte_at(path, index) == 0) { Fail(s, path_node, "foreign library identity contains a zero byte"); return; }
                    }
                    foreign_library: Library = {alias: alias, path: path, name: 0};
                    libraries.append(foreign_library);
            }
        } else if (kind == syntax.ForeignBlock) {
            alias := reader.Field(s.tree, declaration, syntax.FieldLibrary);
            if (!reader.Kind(s.tree, alias, syntax.Identifier)) {
                Fail(s, declaration, "vNext scalar slice requires an explicit foreign library alias"); return;
            }
            slot: int = -1;
            for (foreign_library, index in libraries) {
                if (SameName(s, alias, foreign_library.alias)) { slot = index; break; }
            }
            if (slot < 0) { Fail(s, alias, "unknown foreign library alias"); return; }
            foreign_library := libraries[slot];
            member := Next(s, alias);
            while (member >= 0 && length(s.diagnostics) == 0) {
                if (!reader.Kind(s.tree, member, syntax.ForeignFunction)) {
                    Fail(s, member, "unsupported foreign declaration in vNext scalar slice"); return;
                }
                if (foreign_library.name == 0) {
                    start := length(output.name_bytes);
                    for (index in 0..<text_byte_length(foreign_library.path)) {
                        output.name_bytes.append(u8(text_byte_at(foreign_library.path, index)));
                    }
                    name: Name = {start: u32(start), count: u32(text_byte_length(foreign_library.path))};
                    output.names.append(name);
                    foreign_library.name = u32(length(output.names));
                    libraries[slot] = foreign_library;
                }
                FunctionHeader(s, output, member, foreign_library.name);
                member = Next(s, member);
            }
        } else if (kind != syntax.ImportDeclaration) {
            Fail(s, declaration, "unsupported declaration in vNext scalar slice"); return;
        }
        declaration = Next(s, declaration);
    }
}

NewBlock :: (s: ^State, output: ^Module, node: int) -> u32 {
    if (length(output.blocks) - s.first_block == MaxBlocks) {
        Fail(s, node, "vNext scalar slice exceeds 64 blocks in one function");
        return 0;
    }
    block: Block = {first_parameter: 0, parameter_count: 0,
                    first_instruction: u32(length(output.instructions)), instruction_count: 0};
    output.blocks.append(block);
    s.block = u32(length(output.blocks));
    return s.block;
}
NewParameter :: (s: ^State, output: ^Module, type: u32) -> u32 {
    assert(s.block != 0, "block parameter requires an active block");
    row: Value = {type: type, definition: BlockDefinition | s.block};
    output.values.append(row);
    id := u32(length(output.values));
    block := output.blocks[int(s.block) - 1];
    if (block.parameter_count == 0) { block.first_parameter = u32(length(output.block_parameters)); }
    block.parameter_count += 1;
    output.blocks[int(s.block) - 1] = block;
    output.block_parameters.append(id);
    return id;
}
Emit :: (s: ^State, output: ^Module, op: u32, type: u32, left: u32, right: u32, payload: u32, node: int) -> u32 {
    assert(s.block != 0, "instruction requires an active block");
    id := u32(length(output.instructions) + 1);
    result: u32 = 0;
    if (type != 0) {
        value: Value = {type: type, definition: id};
        output.values.append(value);
        result = u32(length(output.values));
    }
    instruction: Instruction = {op: op, result: result, left: left, right: right, payload: payload, origin: OriginID(s, output, node)};
    output.instructions.append(instruction);
    block := output.blocks[int(s.block) - 1];
    block.instruction_count += 1;
    output.blocks[int(s.block) - 1] = block;
    if (op == Jump || op == Branch || op == Return) { s.block = 0; }
    return result;
}
Expression :: (s: ^State, output: ^Module, node: int, depth: int) -> u32 {
    if (length(s.diagnostics) != 0) { return 0; }
    if (node < 0) {
        Fail(s, node, "vNext scalar slice requires an expression");
        return 0;
    }
    if (depth >= MaxDepth) {
        Fail(s, node, "vNext scalar slice exceeds expression nesting 32");
        return 0;
    }
    kind := s.nodes[node].kind;
    if (kind == syntax.Identifier) {
        slot := FindBinding(s, node);
        if (slot < 0) {
            Fail(s, node, "unknown scalar name");
            return 0;
        }
        return s.current_values[slot];
    }
    if (kind == syntax.ParenthesizedExpression) {
        return Expression(s, output, reader.Field(s.tree, node, syntax.FieldExpression), depth + 1);
    }
    if (kind == syntax.Number) {
        // Accumulate only after range checking, with no signed overflow or
        // float conversion. Hex, separators and floating literals are rejected.
        value: i64 = 0;
        at := s.nodes[node].start;
        stop := s.nodes[node].end;
        while (at < stop) {
            digit := text_byte_at(s.text, at) - DecimalZero;
            if (digit < 0 || digit > 9) {
                Fail(s, node, "vNext scalar slice requires a decimal i64 literal");
                return 0;
            }
            if (value > 922337203685477580 || (value == 922337203685477580 && digit > 7)) {
                Fail(s, node, "decimal literal is outside i64 range");
                return 0;
            }
            value = value * 10 + i64(digit);
            at += 1;
        }
        output.literals.append(value);
        return Emit(s, output, ConstantI64, I64, 0, 0, u32(length(output.literals)), node);
    }
    if (kind == syntax.Boolean) {
        keyword := s.nodes[node].first_child;
        assert(reader.Kind(s.tree, keyword, token.True) || reader.Kind(s.tree, keyword, token.False),
               "parser boolean has a true or false token");
        value: u32 = 0;
        if (reader.Kind(s.tree, keyword, token.True)) { value = 1; }
        return Emit(s, output, ConstantBool, Bool, 0, 0, value, node);
    }
    if (kind == syntax.UnaryExpression) {
        operator := reader.Field(s.tree, node, syntax.FieldOperator);
        if (!reader.Kind(s.tree, operator, token.Not)) {
            Fail(s, operator, "vNext scalar slice supports only bool ! as a unary operation");
            return 0;
        }
        operand := reader.Field(s.tree, node, syntax.FieldOperand);
        value := Expression(s, output, operand, depth + 1);
        if (value == 0) { return 0; }
        if (output.values[int(value) - 1].type != Bool) {
            Fail(s, operand, "bool ! requires a bool operand");
            return 0;
        }
        return Emit(s, output, NotBool, Bool, value, 0, 0, node);
    }
    if (kind == syntax.BinaryExpression) {
        operator := reader.Field(s.tree, node, syntax.FieldOperator);
        if (reader.Kind(s.tree, operator, token.CmpAnd)) {
            return Conjunction(s, output, node, depth);
        }
        op: u32 = 0;
        result_type: u32 = I64;
        if (reader.Kind(s.tree, operator, token.Add)) { op = AddI64; }
        else if (reader.Kind(s.tree, operator, token.Mul)) { op = MultiplyI64; }
        else if (reader.Kind(s.tree, operator, token.Gt)) { op = GreaterI64; result_type = Bool; }
        else if (reader.Kind(s.tree, operator, token.CmpEq)) { op = EqualI64; result_type = Bool; }
        else {
            Fail(s, operator, "vNext scalar slice supports only i64 +, *, >, == and bool && binary operations");
            return 0;
        }
        left_node := reader.Field(s.tree, node, syntax.FieldLeft);
        right_node := reader.Field(s.tree, node, syntax.FieldRight);
        left := Expression(s, output, left_node, depth + 1);
        if (left == 0) { return 0; }
        if (output.values[int(left) - 1].type != I64) {
            Fail(s, left_node, "i64 binary operation requires an i64 operand");
            return 0;
        }
        right := Expression(s, output, right_node, depth + 1);
        if (right == 0) { return 0; }
        if (output.values[int(right) - 1].type != I64) {
            Fail(s, right_node, "i64 binary operation requires an i64 operand");
            return 0;
        }
        return Emit(s, output, op, result_type, left, right, 0, node);
    }
    if (kind == syntax.CallExpression) {
        name := reader.Field(s.tree, node, syntax.FieldFunction);
        target := s.packages[s.source];
        member := name;
        qualified := reader.Kind(s.tree, name, syntax.MemberExpression);
        if (reader.Kind(s.tree, name, syntax.Identifier)) {
            if (FindBinding(s, name) >= 0) {
                Fail(s, name, "scalar binding is not callable");
                return 0;
            }
        } else if (qualified) {
            object := reader.Field(s.tree, name, syntax.FieldObject);
            member = reader.Field(s.tree, name, syntax.FieldMember);
            if (!reader.Kind(s.tree, object, syntax.Identifier) || !reader.Kind(s.tree, member, syntax.Identifier)) {
                Fail(s, name, "vNext scalar slice requires an identifier package and member");
                return 0;
            }
            if (FindBinding(s, object) >= 0) {
                Fail(s, object, "scalar binding has no package members");
                return 0;
            }
            target = -1;
            for (imported in s.imports) {
                if (imported.file == s.source && SpellingMatches(s, object, imported.name)) {
                    target = imported.target;
                    break;
                }
            }
            if (target < 0) {
                Fail(s, object, "unknown package alias");
                return 0;
            }
        } else {
            Fail(s, name, "vNext scalar slice requires an identifier direct callee");
            return 0;
        }
        // All closure headers precede bodies. Both scans have an aggregate
        // 32-row bound, and produce the one authoritative global callee ID.
        callee: u32 = 0;
        for (header, index in s.headers) {
            if (s.packages[header.source] == target && HeaderMatches(s, header, member)) {
                if (target != s.packages[s.source] && !header.public) {
                    Fail(s, name, "private member");
                    return 0;
                }
                callee = u32(index + 1);
                break;
            }
        }
        if (callee == 0) {
            message := "unknown direct callee";
            if (qualified) { message = "unknown imported function"; }
            Fail(s, member, message);
            return 0;
        }
        function := output.functions[int(callee) - 1];
        signature := output.signatures[int(function.signature) - 1];
        list := reader.Field(s.tree, node, syntax.FieldArguments);
        argument := First(s, list);
        count: int = 0;
        while (argument >= 0) {
            if (count == MaxParameters) {
                Fail(s, list, "vNext scalar slice exceeds 32 call arguments");
                return 0;
            }
            argument_kind := s.nodes[argument].kind;
            if (argument_kind == syntax.NamedArgument || argument_kind == syntax.TypedArgument) {
                Fail(s, argument, "vNext scalar slice requires positional call arguments");
                return 0;
            }
            count += 1;
            argument = Next(s, argument);
        }
        if (count != int(signature.parameter_count)) {
            Fail(s, list, "direct call argument count does not match signature");
            return 0;
        }
        first: int = 0;
        if (count != 0) {
            first = length(output.arguments);
            // Each source call has <=32 arguments, and <=2 edges/block carry
            // <=64 bindings. Admission proves this bound before growth/int use.
            limit := MaxNodes * MaxParameters + MaxFunctions * MaxBlocks * 2 * MaxLocals;
            assert(first <= limit - count, "admitted source bounds all argument spans");
            // Resize copies the whole existing prefix. Consuming append keeps
            // unique capacity and grows geometrically across successive calls.
            for (slot in 0..<count) { output.arguments.append(u32(0)); }
        }
        // Reserve the outer span first. Nested calls append beyond it; write
        // by offset after each evaluation, never retain an element pointer.
        argument = First(s, list);
        ordinal: int = 0;
        while (argument >= 0) {
            value := Expression(s, output, argument, depth + 1);
            if (value == 0) { return 0; }
            expected := output.parameter_types[int(signature.first_parameter) + ordinal];
            if (output.values[int(value) - 1].type != expected) {
                Fail(s, argument, "direct call argument type does not match signature");
                return 0;
            }
            output.arguments[first + ordinal] = value;
            ordinal += 1;
            argument = Next(s, argument);
        }
        assert(length(output.calls) < MaxNodes, "each admitted syntax node emits at most one Call");
        call: Call = {callee: callee, first_argument: u32(first)};
        output.calls.append(call);
        return Emit(s, output, DirectCall, signature.result_type, 0, 0, u32(length(output.calls)), node);
    }
    Fail(s, node, "unsupported expression in vNext scalar slice");
    return 0;
}

NewEdge :: (output: ^Module) -> u32 {
    edge: Edge = {target: 0, first_argument: 0, argument_count: 0};
    output.edges.append(edge);
    return u32(length(output.edges));
}
FinishEdge :: (output: ^Module, edge: u32, target: u32, arguments: u32[]) {
    row: Edge = {target: target, first_argument: 0, argument_count: u32(length(arguments))};
    if (length(arguments) != 0) {
        row.first_argument = u32(length(output.arguments));
        output.arguments.extend(arguments);
    }
    output.edges[int(edge) - 1] = row;
}
FinishScalarEdge :: (output: ^Module, edge: u32, target: u32, argument: u32) {
    row: Edge = {target: target, first_argument: u32(length(output.arguments)), argument_count: 1};
    output.arguments.append(argument);
    output.edges[int(edge) - 1] = row;
}

// The false edge carries left, already false. The right expression is emitted
// only in the true block; nested conjunctions finish before this merge exists.
Conjunction :: (s: ^State, output: ^Module, node: int, depth: int) -> u32 {
    left_node := reader.Field(s.tree, node, syntax.FieldLeft);
    left := Expression(s, output, left_node, depth + 1);
    if (left == 0) { return 0; }
    if (output.values[int(left) - 1].type != Bool) { Fail(s, left_node, "bool && requires a bool operand"); return 0; }
    true_edge := NewEdge(output);
    false_edge := NewEdge(output);
    Emit(s, output, Branch, 0, left, 0, true_edge, node);
    right_block := NewBlock(s, output, node);
    if (right_block == 0) { return 0; }
    empty: u32[] = [];
    FinishEdge(output, true_edge, right_block, empty);
    right_node := reader.Field(s.tree, node, syntax.FieldRight);
    right := Expression(s, output, right_node, depth + 1);
    if (right == 0) { return 0; }
    if (output.values[int(right) - 1].type != Bool) { Fail(s, right_node, "bool && requires a bool operand"); return 0; }
    right_exit := NewEdge(output);
    Emit(s, output, Jump, 0, 0, 0, right_exit, node);
    merge := NewBlock(s, output, node);
    if (merge == 0) { return 0; }
    result := NewParameter(s, output, Bool);
    FinishScalarEdge(output, false_edge, merge, left);
    FinishScalarEdge(output, right_exit, merge, right);
    return result;
}

// Acyclic source if becomes branch/true/[else]/merge. Without an else, the
// branch's false edge supplies the pre-branch values directly to the merge.
// Each authored arm has an isolated snapshot; differing values get parameters.
// Arm snapshots retain scoped-local suffixes, but the merge reads only the
// pre-branch prefix. COW supplies isolation without eagerly slicing each arm.
// Blocks are allocated in topological order, including nested conditionals.
Conditional :: (s: ^State, output: ^Module, node: int, depth: int) {
    condition := Expression(s, output, reader.Field(s.tree, node, syntax.FieldCondition), 0);
    if (condition == 0) { return; }
    if (output.values[int(condition) - 1].type != Bool) {
        Fail(s, node, "if condition requires bool");
        return;
    }
    bindings := s.bindings;
    before := s.current_values;
    true_entry_edge := NewEdge(output);
    false_entry_edge := NewEdge(output);
    Emit(s, output, Branch, 0, condition, 0, true_entry_edge, node);
    true_block := NewBlock(s, output, node);
    if (true_block == 0) { return; }
    empty: u32[] = [];
    FinishEdge(output, true_entry_edge, true_block, empty);
    Statements(s, output, reader.Field(s.tree, node, syntax.FieldConsequence), depth + 1);
    if (length(s.diagnostics) != 0) { return; }
    after_true := s.current_values;
    true_exit: u32 = 0;
    if (s.block != 0) {
        true_exit = NewEdge(output);
        Emit(s, output, Jump, 0, 0, 0, true_exit, node);
    }
    s.bindings = bindings;
    s.current_values = before;
    after_false := before;
    false_exit := false_entry_edge;
    alternative := reader.Field(s.tree, node, syntax.FieldAlternative);
    if (alternative >= 0) {
        false_block := NewBlock(s, output, node);
        if (false_block == 0) { return; }
        FinishEdge(output, false_entry_edge, false_block, empty);
        if (reader.Kind(s.tree, alternative, syntax.IfStatement)) {
            if (depth + 1 >= MaxDepth) {
                Fail(s, alternative, "vNext scalar slice exceeds statement nesting 32");
                return;
            }
            Conditional(s, output, alternative, depth + 1);
        } else {
            Statements(s, output, alternative, depth + 1);
        }
        if (length(s.diagnostics) != 0) { return; }
        after_false = s.current_values;
        false_exit = 0;
        if (s.block != 0) {
            false_exit = NewEdge(output);
            Emit(s, output, Jump, 0, 0, 0, false_exit, node);
        }
    }
    s.bindings = bindings;
    s.current_values = before;
    if (true_exit == 0 && false_exit == 0) { return; }
    merge := NewBlock(s, output, node);
    if (merge == 0) { return; }
    true_arguments: u32[] = [];
    false_arguments: u32[] = [];
    index: int = 0;
    while (index < length(before)) {
        if (true_exit == 0) {
            s.current_values[index] = after_false[index];
        } else if (false_exit == 0) {
            s.current_values[index] = after_true[index];
        } else if (after_true[index] == after_false[index]) {
            s.current_values[index] = after_true[index];
        } else {
            type := output.values[int(before[index]) - 1].type;
            s.current_values[index] = NewParameter(s, output, type);
            true_arguments.append(after_true[index]);
            false_arguments.append(after_false[index]);
        }
        index += 1;
    }
    if (true_exit != 0) { FinishEdge(output, true_exit, merge, true_arguments); }
    if (false_exit != 0) { FinishEdge(output, false_exit, merge, false_arguments); }
}

Statements :: (s: ^State, output: ^Module, parent: int, depth: int) {
    if (depth >= MaxDepth) {
        Fail(s, parent, "vNext scalar slice exceeds statement nesting 32");
        return;
    }
    statement := First(s, parent);
    while (statement >= 0 && length(s.diagnostics) == 0) {
        if (s.block == 0) {
            Fail(s, statement, "unreachable statement after return");
            return;
        }
        kind := s.nodes[statement].kind;
        if (kind == syntax.LocalDeclaration) {
            name := reader.Field(s.tree, statement, syntax.FieldName);
            if (length(s.bindings) == MaxLocals) {
                Fail(s, name, "vNext scalar slice exceeds 64 visible bindings");
                return;
            }
            if (!AdmitName(s, name)) { return; }
            if (FindBinding(s, name) >= 0) {
                Fail(s, name, "duplicate scalar local name");
                return;
            }
            annotation := reader.Field(s.tree, statement, syntax.FieldType);
            type: u32 = 0;
            if (annotation >= 0) {
                type = ReadType(s, annotation, statement);
                if (type == 0) { return; }
            }
            value := Expression(s, output, reader.Field(s.tree, statement, syntax.FieldValue), 0);
            if (value == 0) { return; }
            if (type != 0 && output.values[int(value) - 1].type != type) {
                Fail(s, statement, "scalar local initializer type does not match annotation");
                return;
            }
            s.bindings.append(name);
            s.current_values.append(value);
        } else if (kind == syntax.ExpressionStatement) {
            expression := First(s, statement);
            if (!reader.Kind(s.tree, expression, syntax.CallExpression)) {
                Fail(s, statement, "vNext scalar slice permits only a discarded call statement"); return;
            }
            Expression(s, output, expression, 0);
        } else if (kind == syntax.Assignment) {
            target := reader.Field(s.tree, statement, syntax.FieldTarget);
            operator := reader.Field(s.tree, statement, syntax.FieldOperator);
            if (!reader.Kind(s.tree, target, syntax.Identifier) || !reader.Kind(s.tree, operator, token.Eq)) {
                Fail(s, statement, "vNext scalar slice requires plain scalar assignment");
                return;
            }
            slot := FindBinding(s, target);
            if (slot < 0) {
                Fail(s, target, "assignment to unknown scalar name");
                return;
            }
            value := Expression(s, output, reader.Field(s.tree, statement, syntax.FieldValue), 0);
            if (value == 0) { return; }
            if (output.values[int(value) - 1].type != output.values[int(s.current_values[slot]) - 1].type) {
                Fail(s, statement, "scalar assignment changes the local type");
                return;
            }
            s.current_values[slot] = value;
        } else if (kind == syntax.IfStatement) {
            Conditional(s, output, statement, depth);
        } else if (kind == syntax.ReturnStatement) {
            if (reader.Field(s.tree, statement, syntax.FieldOutcome) >= 0) {
                Fail(s, statement, "named return outcomes are unsupported in vNext scalar slice");
                return;
            }
            expression := reader.Field(s.tree, statement, syntax.FieldValue);
            if (expression < 0) {
                Fail(s, statement, "vNext scalar slice requires a return value");
                return;
            }
            value := Expression(s, output, expression, 0);
            if (value == 0) { return; }
            if (output.values[int(value) - 1].type != s.result_type) {
                Fail(s, statement, "return type does not match function result");
                return;
            }
            Emit(s, output, Return, 0, value, 0, 0, statement);
        } else {
            Fail(s, statement, "unsupported statement in vNext scalar slice");
            return;
        }
        statement = Next(s, statement);
    }
}

// Canonical relative locations only: no filesystem access or normalization.
// Empty denotes the project root for an imported directory, not a source file.
CanonicalDirectory :: (path: string) -> bool {
    size := text_byte_length(path);
    if (size > MaxPathBytes) { return false; }
    if (size == 0) { return true; }
    first: int = 0;
    for (at in 0..size) {
        byte: int = PathSlash;
        if (at < size) {
            byte = text_byte_at(path, at);
            if (byte == 0 || byte == PathBackslash || byte == PathColon) { return false; }
        }
        if (byte == PathSlash) {
            count := at - first;
            if (count == 0 || (count == 1 && text_byte_at(path, first) == PathDot) ||
                (count == 2 && text_byte_at(path, first) == PathDot && text_byte_at(path, first + 1) == PathDot)) {
                return false;
            }
            first = at + 1;
        }
    }
    return true;
}
InputError :: (document: int, message: string) -> Result {
    return Result.Rejected({start: 0, end: 0, line: 1, column: 1, document: document, message: message});
}

pub Produce :: (text: string, document: int) -> Result {
    sources: Source[] = [{path: "Main.chibi", text: text, document: document}];
    return ProduceSources(sources);
}

pub ProduceSources :: (sources: Source[]) -> Result {
    if (length(sources) == 0) {
        return InputError(0, "vNext scalar slice requires 1..8 source files");
    }
    if (length(sources) > MaxSources) {
        return InputError(sources[MaxSources].document, "vNext scalar slice requires 1..8 source files");
    }
    // Validate the entire input byte budget before invoking the retained
    // parser. Source paths/documents identify input, not semantic facts.
    source_bytes: int = 0;
    for (source, index in sources) {
        bytes := text_byte_length(source.text);
        if (source.document < 0 || bytes > MaxSourceBytes - source_bytes) {
            return InputError(source.document, "vNext scalar slice requires a nonnegative document and at most 64 KiB source");
        }
        source_bytes += bytes;
        if (text_byte_length(source.path) == 0 || !CanonicalDirectory(source.path) || !strings.HasSuffix(source.path, ".chibi")) {
            return InputError(source.document, "vNext scalar slice requires a canonical project-relative .chibi path");
        }
        for (previous in 0..<index) {
            if (sources[previous].document == source.document) {
                return InputError(source.document, "duplicate source document label");
            }
        }
    }

    documents: Document[] = [];
    files: graph.File[] = [];
    import_rows: graph.Import[] = [];
    import_nodes: int[] = [];
    node_count: int = 0;
    // Parse exactly once per document, keeping original trees and origins.
    // Imports are AST fields. No preparer or backend interprets their syntax.
    for (source, index in sources) {
        switch parser.Parse(source.text) {
            case .Rejected(diagnostic):
                located := diagnostic;
                located.document = source.document;
                return Result.Rejected(located);
            case .Parsed(nodes, fields, named_flags, extras, root):
                tree := reader.Tree.Raw(nodes, fields, named_flags, extras, source.text);
                if (length(nodes) > MaxNodes - node_count) {
                    return Result.Rejected(reader.Diagnostic(tree, root, source.document, "vNext scalar slice exceeds 8192 syntax nodes"));
                }
                document: Document = {tree: tree, nodes: nodes, text: source.text,
                                       document: source.document, root: root, node_base: node_count};
                documents.append(document);
                node_count += length(nodes);
                header := reader.Field(tree, root, syntax.FieldPackage);
                if (!reader.Kind(tree, header, syntax.PackageHeader)) {
                    return Result.Rejected(reader.Diagnostic(tree, root, source.document, "vNext scalar slice requires one package header"));
                }
                name := reader.Field(tree, header, syntax.FieldName);
                if (!reader.Kind(tree, name, syntax.Identifier)) {
                    return Result.Rejected(reader.Diagnostic(tree, header, source.document, "vNext scalar slice requires a named package"));
                }
                package_name := reader.Text(tree, name);
                if (package_name == "_") {
                    return Result.Rejected(reader.Diagnostic(tree, header, source.document, "vNext scalar slice requires a named package"));
                }
                slash := strings.LastIndexByte(source.path, PathSlash);
                directory := "/project";
                if (slash >= 0) { directory = format_text("/project/{}", strings.Slice(source.path, 0, slash)); }
                file: graph.File = {path: format_text("/project/{}", source.path), directory: directory, name: package_name};
                files.append(file);
                declaration := reader.NextMember(tree, nodes[header].next_sibling);
                while (declaration >= 0) {
                    if (reader.Kind(tree, declaration, syntax.ImportDeclaration)) {
                        if (length(import_rows) == MaxImports) {
                            return Result.Rejected(reader.Diagnostic(tree, declaration, source.document, "vNext scalar slice exceeds 32 imports"));
                        }
                        alias := reader.Field(tree, declaration, syntax.FieldAlias);
                        if (!reader.Kind(tree, alias, syntax.Identifier)) {
                            return Result.Rejected(reader.Diagnostic(tree, declaration, source.document, "vNext scalar slice requires an explicit import alias"));
                        }
                        spelling := reader.Text(tree, alias);
                        if (spelling == "_" || spelling == "Cancelled") {
                            return Result.Rejected(reader.Diagnostic(tree, alias, source.document, "vNext scalar slice requires a nonreserved import alias"));
                        }
                        path := reader.Field(tree, declaration, syntax.FieldPath);
                        switch reader.Name(tree, path, source.document) {
                            case .Name(value, diagnostics):
                                if (length(diagnostics) != 0) { return Result.Rejected(diagnostics[0]); }
                                if (text_byte_length(value) > MaxPathBytes || !strings.HasPrefix(value, "project:")) {
                                    return Result.Rejected(reader.Diagnostic(tree, path, source.document, "vNext scalar slice requires a canonical project: import"));
                                }
                                tail := strings.Slice(value, 8, text_byte_length(value) - 8);
                                if (!CanonicalDirectory(tail)) {
                                    return Result.Rejected(reader.Diagnostic(tree, path, source.document, "vNext scalar slice requires a canonical project: import"));
                                }
                                target := "/project";
                                if (tail != "") { target = format_text("/project/{}", tail); }
                                row: graph.Import = {file: index, directory: target, alias: spelling, explicit_alias: true, conditional: false};
                                import_rows.append(row);
                                import_nodes.append(declaration);
                        }
                    } else if (!reader.Kind(tree, declaration, syntax.FunctionDeclaration) &&
                               !reader.Kind(tree, declaration, syntax.ForeignImportDeclaration) &&
                               !reader.Kind(tree, declaration, syntax.ForeignBlock)) {
                        return Result.Rejected(reader.Diagnostic(tree, declaration, source.document, "unsupported declaration in vNext scalar slice"));
                    }
                    declaration = reader.NextMember(tree, nodes[declaration].next_sibling);
                }
        }
    }

    package_ids: int[] = [];
    imports: graph.Binding[] = [];
    // This retained transform receives location/header/import descriptors only,
    // never source trees, bodies or type catalogs. Its 256-int cycle scratch
    // and <=32-row binding sort are bounded costs of reusing one graph policy.
    switch graph.Build(files, import_rows) {
        case .Rejected(error, cycle):
            document := documents[error.file];
            node := reader.Field(document.tree, reader.Field(document.tree, document.root, syntax.FieldPackage), syntax.FieldName);
            message := "";
            switch error.code {
                case graph.DuplicateFile: return InputError(document.document, "duplicate source path");
                case graph.HeaderMismatch: message = "package header mismatch";
                case graph.DuplicateName: message = "duplicate package name";
                case graph.Missing:
                    node = reader.Field(document.tree, import_nodes[error.import_index], syntax.FieldPath);
                    message = "import target is outside the supplied source closure";
                case graph.ImportName:
                    node = reader.Field(document.tree, import_nodes[error.import_index], syntax.FieldAlias);
                    message = "invalid import alias";
                case graph.DuplicateImport:
                    node = reader.Field(document.tree, import_nodes[error.import_index], syntax.FieldAlias);
                    message = "duplicate import alias";
                case graph.Cycle:
                    node = import_nodes[error.import_index];
                    message = "package import cycle";
                case: assert(false, "retained graph returned an unknown failure");
            }
            return Result.Rejected(reader.Diagnostic(document.tree, node, document.document, message));
        case .Accepted(packages, members, file_packages, order, edges, bindings):
            package_ids = file_packages;
            imports = bindings;
            reached := resize([false], length(packages));
            pending: int[] = [file_packages[0]];
            reached[file_packages[0]] = true;
            cursor: int = 0;
            while (cursor < length(pending)) {
                from := pending[cursor];
                for (edge in edges) {
                    if (edge.from == from && !reached[edge.to]) {
                        reached[edge.to] = true;
                        pending.append(edge.to);
                    }
                }
                cursor += 1;
            }
            for (package, index in file_packages) {
                if (!reached[package]) {
                    document := documents[index];
                    header := reader.Field(document.tree, document.root, syntax.FieldPackage);
                    return Result.Rejected(reader.Diagnostic(document.tree, header, document.document, "source package is unreachable from the entry package"));
                }
            }
    }

    output := EmptyModule();
    first := documents[0];
    pass_state: State = {tree: first.tree, environment: SignatureEnvironment(),
                        nodes: first.nodes, text: first.text, document: first.document,
                        source: 0, node_base: 0, documents: documents, packages: package_ids,
                        imports: imports, headers: [], diagnostics: [], parameter_names: [], bindings: [],
                        current_values: [], origin_ids: resize([u32(0)], node_count), block: 0,
                        first_block: 0, result_type: 0};
    // One global header catalog, in supplied file/declaration order. Empty
    // files may contribute imports; only the entire module requires a body.
    for (document, index in documents) {
        SelectSource(&pass_state, index);
        Headers(&pass_state, &output, document.root);
        if (length(pass_state.diagnostics) != 0) { return Result.Rejected(pass_state.diagnostics[0]); }
    }
    if (length(pass_state.headers) == 0) {
        return Result.Rejected(reader.Diagnostic(first.tree, first.root, first.document, "vNext scalar slice requires at least one function"));
    }
    // Graph bindings are sorted for lookup; conflicts still follow the
    // original import declaration order, not alias spelling order.
    for (imported, index in import_rows) {
        SelectSource(&pass_state, imported.file);
        alias := reader.Field(pass_state.tree, import_nodes[index], syntax.FieldAlias);
        for (header in pass_state.headers) {
            if (package_ids[header.source] == package_ids[imported.file] && HeaderMatches(&pass_state, header, alias)) {
                return Result.Rejected(reader.Diagnostic(pass_state.tree, alias, pass_state.document, "import alias conflicts with a package function"));
            }
        }
    }

    // No body is visited until every package's signatures and aliases exist.
    foreign_index: int = 0;
    for (header, function_index in pass_state.headers) {
        if (foreign_index < length(output.foreigns) && output.foreigns[foreign_index].function == u32(function_index + 1)) {
            foreign_index += 1;
            continue;
        }
        SelectSource(&pass_state, header.source);
        declaration := header.declaration;
        function := output.functions[function_index];
        signature := output.signatures[int(function.signature) - 1];
        pass_state.first_block = length(output.blocks);
        pass_state.result_type = signature.result_type;
        pass_state.bindings = [];
        pass_state.current_values = [];
        entry_block := NewBlock(&pass_state, &output, declaration);
        assert(entry_block != 0, "fresh function has room for its entry block");
        parameter: int = 0;
        while (parameter < int(signature.parameter_count)) {
            at := int(signature.first_parameter) + parameter;
            pass_state.bindings.append(pass_state.parameter_names[at]);
            value := NewParameter(&pass_state, &output, output.parameter_types[at]);
            pass_state.current_values.append(value);
            parameter += 1;
        }
        Statements(&pass_state, &output, reader.Field(pass_state.tree, declaration, syntax.FieldBody), 0);
        if (length(pass_state.diagnostics) != 0) { return Result.Rejected(pass_state.diagnostics[0]); }
        if (pass_state.block != 0) {
            return Result.Rejected(reader.Diagnostic(pass_state.tree, declaration, pass_state.document, "function has a reachable exit without return"));
        }
        function.first_block = u32(pass_state.first_block);
        function.block_count = u32(length(output.blocks) - pass_state.first_block);
        output.functions[function_index] = function;
    }
    verification := Verify(output);
    assert(verification == 0, "typed producer emitted an invalid module");
    return Result.Produced(output);
}
