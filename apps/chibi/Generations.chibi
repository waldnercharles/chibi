package chibi_cli

// A native program's state across generations (docs/edit-and-continue.md,
// "Native code"). Each generation exports its retained states as words under a
// schema: the name and manifest type of each, in order. The host reads the old
// generation's words, migrates them to the new generation's schema, and sets
// them in the new generation before its next Frame.
//
// A state of the new schema starts from the value its generation gives it
// unless the old schema has one of the same name. Same name and type keeps the
// word. Another integer type converts, clamped to the new type's range. Any
// other change, such as a bool that became a number, starts over, and a state
// the new schema lacks is dropped. The new words are built whole, so a
// migration never partly applies.

// The manifest types of an integer state: int, i8, u8, i16, u16, u32, i64, u64.
StateInteger :: (type: int) -> bool {
    return type == 1 || (type >= 3 && type <= 9);
}

StateSigned :: (type: int) -> bool {
    return type == 1 || type == 3 || type == 5 || type == 8;
}

StateBits :: (type: int) -> int {
    if type == 3 || type == 4 {
        return 8
    }
    if type == 5 || type == 6 {
        return 16
    }
    if type == 1 || type == 7 {
        return 32
    }
    return 64
}

StateLeast :: (type: int) -> i64 {
    if !StateSigned(type) {
        return 0
    }
    if StateBits(type) == 64 {
        return 0 - (i64(1) << u32(62)) - (i64(1) << u32(62))
    }
    return 0 - (i64(1) << u32(StateBits(type) - 1))
}

// The greatest value of an integer state, or for u64 the greatest an i64 holds.
StateGreatest :: (type: int) -> i64 {
    bits := StateBits(type)
    if bits == 64 {
        return (i64(1) << u32(62)) - 1 + (i64(1) << u32(62))
    }
    if StateSigned(type) {
        return (i64(1) << u32(bits - 1)) - 1
    }
    return (i64(1) << u32(bits)) - 1
}

// An integer state's word as a value: a u64 above what an i64 holds is the
// greatest an i64 holds.
StateValue :: (type: int, word: u64) -> i64 {
    value := i64(wrap: word)
    if type == 9 && value < 0 {
        return StateGreatest(8)
    }
    return value
}

// An integer state's word as the integer type `to`, clamped to its range.
StateConverted :: (from: int, to: int, word: u64) -> u64 {
    value := StateValue(from, word)
    if value < StateLeast(to) {
        value = StateLeast(to)
    }
    if value > StateGreatest(to) {
        value = StateGreatest(to)
    }
    return u64(wrap: value)
}

// The words of schema `names` and `types` for the program that had `old_words`
// under `old_names` and `old_types`; `initial` holds each state's own start.
Migrate :: (old_names: string[], old_types: int[], old_words: u64[], names: string[], types: int[],
            initial: u64[]) -> u64[] {
    words: u64[] = []
    for index in 0..<length(names) {
        word := initial[index]
        for old in 0..<length(old_names) {
            if old_names[old] != names[index] {
                continue
            }
            if old_types[old] == types[index] {
                word = old_words[old]
            } else if StateInteger(old_types[old]) && StateInteger(types[index]) {
                word = StateConverted(old_types[old], types[index], old_words[old])
            }
        }
        words.append(word)
    }
    return words
}

@test
MigrationKeepsStatesByNameAndType :: () {
    words := Migrate(["a", "b"], [1, 11], [7, 9], ["b", "a"], [11, 1], [0, 0])
    assert(words[0] == 9 && words[1] == 7)
}

@test
MigrationStartsNewStatesAndDropsRemovedOnes :: () {
    words := Migrate(["gone", "kept"], [1, 1], [5, 6], ["kept", "fresh"], [1, 1], [0, 42])
    assert(length(words) == 2 && words[0] == 6 && words[1] == 42)
}

@test
MigrationConvertsIntegersByClamping :: () {
    wide := Migrate(["n"], [1], [u64(wrap: 0 - 3)], ["n"], [8], [0])
    assert(i64(wrap: wide[0]) == -3)
    narrow := Migrate(["n"], [8], [300], ["n"], [4], [0])
    assert(narrow[0] == 255)
    negative := Migrate(["n"], [1], [u64(wrap: 0 - 1)], ["n"], [4], [9])
    assert(negative[0] == 0)
}

@test
MigrationStartsOverWhenTheTypeCannotConvert :: () {
    words := Migrate(["flag", "ratio"], [2, 11], [1, 5], ["flag", "ratio"], [1, 1], [3, 4])
    assert(words[0] == 3 && words[1] == 4)
}
