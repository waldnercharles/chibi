behavior "ModelBoundsMotion" {
    owner "ecs.entity";
    state elapsed: float = 0.0;
    value self_2 = engine["Self"]();
    on Tick as tick(DeltaSeconds: float = 0.0) {
        &state.elapsed += cast<double>(&delta);
        await set_shape_parameter(Entity: self_2, Name: "Reach", Value: double = (31.5 + 23.5 * sin(cast<double>(&state.elapsed) * 0.9)));
        await set_shape_parameter(Entity: self_2, Name: "Bend", Value: double = (0.7 * sin(cast<double>(&state.elapsed) * 1.3)));
        &component("GAME.GameVisualTransform", "pitch") = 0.45 + 0.25 * sin(cast<double>(&state.elapsed) * 0.7);
    }
}
