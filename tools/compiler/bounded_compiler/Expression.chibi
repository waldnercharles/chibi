package bounded_compiler

import reader "project:signature_reader"
import lower "project:scalar_lowering"
import syntax "project:syntax_diagnostics"
import strings "core:strings"

ScalarExpression :: union {
    Rejected(diagnostic: syntax.Diagnostic) |
    Accepted(expressions: lower.Expression[], literals: lower.Literal[], ranges: lower.Range[], result: int)
}
Decimal :: union {
    Parsed(value: int) | Invalid
}
ExpressionFrame :: struct {
    node: int;
    phase: int;
    left: int;
    expected: int;
}

// Accumulate in int64 so even signed minimum is exact. Other literal syntax
// and implicit numeric promotion are outside this first source subset.
DecimalValue :: (text: string, negative: bool) -> Decimal {
    size := strings.ByteLength(text);
    if (size == 0) {
        return Decimal.Invalid;
    }
    magnitude: i64 = 0;
    index: int = 0;
    while (index < size) {
        digit := strings.ByteAt(text, index) - 48;
        if (digit < 0 || digit > 9) {
            return Decimal.Invalid;
        }
        magnitude = magnitude * 10 + i64(digit);
        if (magnitude > 2147483648) {
            return Decimal.Invalid;
        }
        index += 1;
    }
    if (negative) {
        return Decimal.Parsed(int(-magnitude));
    }
    if (magnitude == 2147483648) {
        return Decimal.Invalid;
    }
    return Decimal.Parsed(int(magnitude));
}

// The one positional argument of a call, or -1.
SoleArgument :: (tree: reader.Tree, call: int) -> int {
    arguments := reader.Field(tree, call, syntax.FieldArguments);
    if (arguments < 0) {
        return -1;
    }
    switch tree {
        case .Raw(nodes, fields, named_flags, extra_flags, text):
            first := reader.NextMember(tree, nodes[arguments].first_child);
            if (first < 0 || reader.Kind(tree, first, syntax.NamedArgument) ||
                reader.NextMember(tree, nodes[first].next_sibling) >= 0) {
                return -1;
            }
            return first;
    }
}

ExpressionRange :: (tree: reader.Tree, node: int, document: int) -> lower.Range {
    place := reader.Request(tree, node, 0, document, "");
    return {start: place.start, end: place.end, line: place.line,
            column: place.column, document: document};
}

BinaryOperator :: (text: string) -> int {
    if (text == "+") {
        return 1;
    }
    if (text == "-") {
        return 2;
    }
    if (text == "*") {
        return 3;
    }
    if (text == "&&" || text == "and") {
        return 8;
    }
    if (text == "||" || text == "or") {
        return 9;
    }
    if (text == "==") {
        return 10;
    }
    if (text == "!=") {
        return 11;
    }
    if (text == "<") {
        return 12;
    }
    if (text == "<=") {
        return 13;
    }
    if (text == ">") {
        return 14;
    }
    if (text == ">=") {
        return 15;
    }
    if (text == "&") {
        return 16;
    }
    if (text == "|") {
        return 17;
    }
    if (text == "^") {
        return 18;
    }
    return -1;
}

ExpressionFailure :: (tree: reader.Tree, node: int, document: int, message: string) -> ScalarExpression {
    return ScalarExpression.Rejected(reader.Diagnostic(tree, node, document, message));
}

// Explicit frames bound source traversal independently of callable depth. The
// only native input is a raw parser tree; all typed rows are constructed here.
ReadExpression :: (tree: reader.Tree, root: int, document: int, expected: int) -> ScalarExpression {
    expressions: lower.Expression[] = [];
    literals: lower.Literal[] = [];
    ranges: lower.Range[] = [];
    // resize cannot grow record arrays, so fill the fixed stack row by row.
    initial: ExpressionFrame = {node: root, phase: 0, left: -1, expected: expected};
    frames: ExpressionFrame[] = [];
    while (length(frames) < 65) {
        frames.append(initial);
    }
    top: int = 0;
    visits: int = 0;
    value: int = -1;
    returning: bool = false;
    while (top >= 0) {
        frame := frames[top];
        node := frame.node;
        row: lower.Expression = {kind: 0, op: 0, left: -1, right: -1,
                                 symbol: -1, type: -1, literal: -1, range: length(ranges)};
        if (returning) {
            if (frame.phase == 1) {
                top -= 1;
                continue;
            }
            if (frame.phase == 4) {
                frame.left = value;
                frame.phase = 5;
                frames[top] = frame;
                next: ExpressionFrame = {node: reader.Field(tree, node, syntax.FieldRight), phase: 0, left: -1, expected: 0};
                top += 1;
                frames[top] = next;
                returning = false;
                continue;
            }
            row.left = value;
            row.type = expressions[value].type;
            if (frame.phase == 2) {
                if (row.type != 1) {
                    return ExpressionFailure(tree, node, document, "bounded compiler supports only identity int conversions");
                }
                row.kind = 5;
            } else if (frame.phase == 3) {
                row.kind = 3;
                op := reader.Text(tree, reader.Field(tree, node, syntax.FieldOperator));
                if (op == "!" || op == "not") {
                    if (row.type != 0) {
                        return ExpressionFailure(tree, node, document, "logical negation needs bool");
                    }
                    row.op = 7;
                } else {
                    if (row.type != 1) {
                        return ExpressionFailure(tree, node, document, "integer unary operation needs int");
                    }
                    if (op == "-") {
                        row.op = 6;
                    }
                    if (op == "~") {
                        row.op = 21;
                    }
                }
            } else {
                row.kind = 4;
                row.left = frame.left;
                row.right = value;
                row.op = BinaryOperator(reader.Text(tree, reader.Field(tree, node, syntax.FieldOperator)));
                left_type := expressions[row.left].type;
                if (left_type != row.type) {
                    return ExpressionFailure(tree, node, document, "bounded binary operands need the same scalar type");
                }
                if (row.op == 8 || row.op == 9) {
                    if (row.type != 0) {
                        return ExpressionFailure(tree, node, document, "logical operation needs bool operands");
                    }
                } else if (row.op == 10 || row.op == 11) {
                    row.type = 0;
                } else {
                    if (row.type != 1) {
                        return ExpressionFailure(tree, node, document, "integer operation needs explicitly typed int operands");
                    }
                    if (row.op >= 12 && row.op <= 15) {
                        row.type = 0;
                    }
                }
            }
        } else {
            visits += 1;
            if (visits > 64 || top >= 64 || node < 0) {
                return ExpressionFailure(tree, root, document, "bounded expression exceeds its traversal limit");
            }
            if (reader.Kind(tree, node, syntax.ParenthesizedExpression)) {
                frame.phase = 1;
                frames[top] = frame;
                child: ExpressionFrame = {node: reader.Field(tree, node, syntax.FieldExpression), phase: 0, left: -1, expected: frame.expected};
                top += 1;
                frames[top] = child;
                continue;
            }
            if (reader.Kind(tree, node, syntax.CallExpression)) {
                argument := SoleArgument(tree, node);
                if (reader.Text(tree, reader.Field(tree, node, syntax.FieldFunction)) != "int" || argument < 0) {
                    return ExpressionFailure(tree, node, document, "bounded compiler supports no call except int(value)");
                }
                frame.phase = 2;
                frames[top] = frame;
                child: ExpressionFrame = {node: argument, phase: 0, left: -1, expected: 6};
                top += 1;
                frames[top] = child;
                continue;
            }
            if (reader.Kind(tree, node, syntax.BinaryExpression)) {
                if (BinaryOperator(reader.Text(tree, reader.Field(tree, node, syntax.FieldOperator))) < 0) {
                    return ExpressionFailure(tree, node, document, "unsupported bounded binary operator");
                }
                frame.phase = 4;
                frames[top] = frame;
                child: ExpressionFrame = {node: reader.Field(tree, node, syntax.FieldLeft), phase: 0, left: -1, expected: 0};
                top += 1;
                frames[top] = child;
                continue;
            }
            negative: bool = false;
            literal_node := node;
            if (reader.Kind(tree, node, syntax.UnaryExpression)) {
                op := reader.Text(tree, reader.Field(tree, node, syntax.FieldOperator));
                operand := reader.Field(tree, node, syntax.FieldOperand);
                negative = op == "-" && reader.Kind(tree, operand, syntax.Number);
                if (negative) {
                    literal_node = operand;
                } else {
                    if (op != "!" && op != "not" && op != "+" && op != "-" && op != "~") {
                        return ExpressionFailure(tree, node, document, "unsupported bounded unary operator");
                    }
                    frame.phase = 3;
                    frames[top] = frame;
                    child_expected := frame.expected;
                    if (op == "!" || op == "not") {
                        child_expected = 1;
                    }
                    child: ExpressionFrame = {node: operand, phase: 0, left: -1, expected: child_expected};
                    top += 1;
                    frames[top] = child;
                    continue;
                }
            }
            row.kind = 1;
            literal: lower.Literal = {storage: 0, payload: 0};
            if (reader.Kind(tree, literal_node, syntax.Number)) {
                if (frame.expected == 1) {
                    return ExpressionFailure(tree, node, document, "bounded Boolean context cannot take a number");
                }
                if (frame.expected != 6) {
                    return ExpressionFailure(tree, node, document, "bounded integer operands need explicit int(value)");
                }
                switch DecimalValue(reader.Text(tree, literal_node), negative) {
                    case .Invalid:
                        return ExpressionFailure(tree, node, document, "bounded compiler needs a decimal literal in the int range");
                    case .Parsed(number):
                        literal.payload = number;
                }
                literal.storage = 6;
                row.type = 1;
            } else if (reader.Kind(tree, node, syntax.Boolean)) {
                literal.storage = 1;
                row.type = 0;
                if (reader.Text(tree, node) == "true") {
                    literal.payload = 1;
                }
            } else {
                return ExpressionFailure(tree, node, document, "unsupported bounded expression");
            }
            row.literal = length(literals);
            literals.append(literal);
        }
        if (length(expressions) >= 24) {
            return ExpressionFailure(tree, root, document, "bounded expression exceeds its 24-row limit");
        }
        ranges.append(ExpressionRange(tree, node, document));
        expressions.append(row);
        value = length(expressions) - 1;
        top -= 1;
        returning = true;
    }
    return ScalarExpression.Accepted(expressions, literals, ranges, value);
}
