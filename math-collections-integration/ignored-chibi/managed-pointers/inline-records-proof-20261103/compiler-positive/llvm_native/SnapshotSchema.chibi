package llvm_native

import strings "core:strings"

// The compatibility map belongs to one migration transaction. The ring and
// temporary session are drained before return; no image pointer survives it.
SnapshotSchemaRuntime :: () -> string {
    return strings.Join([
        "%chibi.snapshot.view = type { ptr, ptr }\n",
        "%chibi.snapshot.shape = type { i32, i32, i32, i32, ptr, ptr }\n",
        "%chibi.snapshot.node = type { i32, i32, i32, i32 }\n",
        "%chibi.snapshot.edge = type { ptr, i32, i32 }\n",
        "%chibi.snapshot.schema = type { ptr, ptr, ptr, ptr }\n",
        "\n",
        "; Tables belong to mapped images. A transaction maps identities both ways,\n",
        "; so repeated roots and recursive type edges are checked only once.\n",
        "define internal i1 @chibi_snapshot.schema.pair(ptr %ctx, ptr %session, ptr %old, ptr %new) {\n",
        "entry:\n",
        "  %memo = load ptr, ptr %session\n",
        "  %forward = call ptr @chibi_snapshot.memo.find(ptr %memo, ptr %old, i64 0)\n",
        "  %seen = icmp ne ptr %forward, null\n",
        "  br i1 %seen, label %known, label %reverse\n",
        "known:\n",
        "  %stored.at = getelementptr %chibi.snapshot.entry, ptr %forward, i32 0, i32 2\n",
        "  %stored = load i64, ptr %stored.at\n",
        "  %wanted = ptrtoint ptr %new to i64\n",
        "  %same = icmp eq i64 %stored, %wanted\n",
        "  ret i1 %same\n",
        "reverse:\n",
        "  %backward = call ptr @chibi_snapshot.memo.find(ptr %memo, ptr %new, i64 1)\n",
        "  %merged = icmp ne ptr %backward, null\n",
        "  br i1 %merged, label %rejected, label %insert\n",
        "insert:\n",
        "  %new.word = ptrtoint ptr %new to i64\n",
        "  %old.word = ptrtoint ptr %old to i64\n",
        "  call void @chibi_snapshot.memo.put(ptr %ctx, ptr %memo, ptr %old, i64 0, i64 %new.word)\n",
        "  call void @chibi_snapshot.memo.put(ptr %ctx, ptr %memo, ptr %new, i64 1, i64 %old.word)\n",
        "  %queue.at = getelementptr %chibi.snapshot.schema, ptr %session, i32 0, i32 1\n",
        "  %queue = load ptr, ptr %queue.at\n",
        "  call void @chibi_snapshot.queue.put(ptr %ctx, ptr %queue, ptr %old, ptr %new, ptr @chibi_snapshot.schema.visit, i32 0)\n",
        "  ret i1 true\n",
        "rejected:\n",
        "  ret i1 false\n",
        "}\n",
        "\n",
        "define internal i1 @chibi_snapshot.schema.name(ptr %old, ptr %new) {\n",
        "entry:\n",
        "  %old.length.at = getelementptr %chibi.snapshot.edge, ptr %old, i32 0, i32 1\n",
        "  %new.length.at = getelementptr %chibi.snapshot.edge, ptr %new, i32 0, i32 1\n",
        "  %old.length = load i32, ptr %old.length.at\n",
        "  %new.length = load i32, ptr %new.length.at\n",
        "  %same.length = icmp eq i32 %old.length, %new.length\n",
        "  %valid.length = icmp sge i32 %old.length, 0\n",
        "  %comparable = and i1 %same.length, %valid.length\n",
        "  br i1 %comparable, label %prepare, label %rejected\n",
        "prepare:\n",
        "  %old.text = load ptr, ptr %old\n",
        "  %new.text = load ptr, ptr %new\n",
        "  br label %head\n",
        "head:\n",
        "  %index = phi i32 [ 0, %prepare ], [ %next, %compare ]\n",
        "  %done = icmp eq i32 %index, %old.length\n",
        "  br i1 %done, label %accepted, label %compare\n",
        "compare:\n",
        "  %old.byte.at = getelementptr i8, ptr %old.text, i32 %index\n",
        "  %new.byte.at = getelementptr i8, ptr %new.text, i32 %index\n",
        "  %old.byte = load i8, ptr %old.byte.at\n",
        "  %new.byte = load i8, ptr %new.byte.at\n",
        "  %same = icmp eq i8 %old.byte, %new.byte\n",
        "  %next = add i32 %index, 1\n",
        "  br i1 %same, label %head, label %rejected\n",
        "accepted:\n",
        "  ret i1 true\n",
        "rejected:\n",
        "  ret i1 false\n",
        "}\n",
        "\n",
        "; Positional labels deliberately reject layout evolution inside an opaque\n",
        "; snapshot. Existing flattened retained records retain their per-leaf ABI.\n",
        "define internal i1 @chibi_snapshot.schema.visit(ptr %ctx, ptr %session, ptr %old, ptr %new, i32 %unused) {\n",
        "entry:\n",
        "  %old.node = load %chibi.snapshot.node, ptr %old\n",
        "  %new.node = load %chibi.snapshot.node, ptr %new\n",
        "  %old.kind = extractvalue %chibi.snapshot.node %old.node, 0\n",
        "  %new.kind = extractvalue %chibi.snapshot.node %new.node, 0\n",
        "  %old.extra = extractvalue %chibi.snapshot.node %old.node, 1\n",
        "  %new.extra = extractvalue %chibi.snapshot.node %new.node, 1\n",
        "  %old.first = extractvalue %chibi.snapshot.node %old.node, 2\n",
        "  %new.first = extractvalue %chibi.snapshot.node %new.node, 2\n",
        "  %old.count = extractvalue %chibi.snapshot.node %old.node, 3\n",
        "  %new.count = extractvalue %chibi.snapshot.node %new.node, 3\n",
        "  %same.kind = icmp eq i32 %old.kind, %new.kind\n",
        "  %valid.kind = icmp ule i32 %old.kind, 4\n",
        "  %kind = and i1 %same.kind, %valid.kind\n",
        "  %same.extra = icmp eq i32 %old.extra, %new.extra\n",
        "  %same.count = icmp eq i32 %old.count, %new.count\n",
        "  %same = and i1 %kind, %same.extra\n",
        "  %comparable = and i1 %same, %same.count\n",
        "  br i1 %comparable, label %tables, label %rejected\n",
        "tables:\n",
        "  %old.shape.at = getelementptr %chibi.snapshot.schema, ptr %session, i32 0, i32 2\n",
        "  %new.shape.at = getelementptr %chibi.snapshot.schema, ptr %session, i32 0, i32 3\n",
        "  %old.shape = load ptr, ptr %old.shape.at\n",
        "  %new.shape = load ptr, ptr %new.shape.at\n",
        "  %old.shape.value = load %chibi.snapshot.shape, ptr %old.shape\n",
        "  %new.shape.value = load %chibi.snapshot.shape, ptr %new.shape\n",
        "  %old.edge.count = extractvalue %chibi.snapshot.shape %old.shape.value, 3\n",
        "  %new.edge.count = extractvalue %chibi.snapshot.shape %new.shape.value, 3\n",
        "  %old.start.valid = icmp ule i32 %old.first, %old.edge.count\n",
        "  %new.start.valid = icmp ule i32 %new.first, %new.edge.count\n",
        "  %old.remaining = sub i32 %old.edge.count, %old.first\n",
        "  %new.remaining = sub i32 %new.edge.count, %new.first\n",
        "  %old.span.valid = icmp ule i32 %old.count, %old.remaining\n",
        "  %new.span.valid = icmp ule i32 %new.count, %new.remaining\n",
        "  %old.span = and i1 %old.start.valid, %old.span.valid\n",
        "  %new.span = and i1 %new.start.valid, %new.span.valid\n",
        "  %spans = and i1 %old.span, %new.span\n",
        "  br i1 %spans, label %prepare, label %rejected\n",
        "prepare:\n",
        "  %old.node.count = extractvalue %chibi.snapshot.shape %old.shape.value, 2\n",
        "  %new.node.count = extractvalue %chibi.snapshot.shape %new.shape.value, 2\n",
        "  %old.nodes = extractvalue %chibi.snapshot.shape %old.shape.value, 4\n",
        "  %new.nodes = extractvalue %chibi.snapshot.shape %new.shape.value, 4\n",
        "  %old.edges = extractvalue %chibi.snapshot.shape %old.shape.value, 5\n",
        "  %new.edges = extractvalue %chibi.snapshot.shape %new.shape.value, 5\n",
        "  %old.start = getelementptr %chibi.snapshot.edge, ptr %old.edges, i32 %old.first\n",
        "  %new.start = getelementptr %chibi.snapshot.edge, ptr %new.edges, i32 %new.first\n",
        "  br label %head\n",
        "head:\n",
        "  %index = phi i32 [ 0, %prepare ], [ %next, %pair ]\n",
        "  %done = icmp eq i32 %index, %old.count\n",
        "  br i1 %done, label %accepted, label %edge\n",
        "edge:\n",
        "  %old.edge = getelementptr %chibi.snapshot.edge, ptr %old.start, i32 %index\n",
        "  %new.edge = getelementptr %chibi.snapshot.edge, ptr %new.start, i32 %index\n",
        "  %same.name = call i1 @chibi_snapshot.schema.name(ptr %old.edge, ptr %new.edge)\n",
        "  br i1 %same.name, label %targets, label %rejected\n",
        "targets:\n",
        "  %old.target.at = getelementptr %chibi.snapshot.edge, ptr %old.edge, i32 0, i32 2\n",
        "  %new.target.at = getelementptr %chibi.snapshot.edge, ptr %new.edge, i32 0, i32 2\n",
        "  %old.target = load i32, ptr %old.target.at\n",
        "  %new.target = load i32, ptr %new.target.at\n",
        "  %old.valid = icmp ult i32 %old.target, %old.node.count\n",
        "  %new.valid = icmp ult i32 %new.target, %new.node.count\n",
        "  %valid = and i1 %old.valid, %new.valid\n",
        "  br i1 %valid, label %pair, label %rejected\n",
        "pair:\n",
        "  %old.child = getelementptr %chibi.snapshot.node, ptr %old.nodes, i32 %old.target\n",
        "  %new.child = getelementptr %chibi.snapshot.node, ptr %new.nodes, i32 %new.target\n",
        "  %compatible = call i1 @chibi_snapshot.schema.pair(ptr %ctx, ptr %session, ptr %old.child, ptr %new.child)\n",
        "  %next = add i32 %index, 1\n",
        "  br i1 %compatible, label %head, label %rejected\n",
        "accepted:\n",
        "  ret i1 true\n",
        "rejected:\n",
        "  ret i1 false\n",
        "}\n",
        "\n",
        "; A rejected comparison invalidates this transaction's map. The caller aborts\n",
        "; staged values, rather than trying another schema with partially mapped nodes.\n",
        "define internal i1 @chibi_snapshot.schema.accept(ptr %ctx, ptr %memo, ptr %queue, ptr %old, ptr %new) {\n",
        "entry:\n",
        "  %old.shape = load %chibi.snapshot.shape, ptr %old\n",
        "  %new.shape = load %chibi.snapshot.shape, ptr %new\n",
        "  %old.version = extractvalue %chibi.snapshot.shape %old.shape, 0\n",
        "  %new.version = extractvalue %chibi.snapshot.shape %new.shape, 0\n",
        "  %old.version.valid = icmp eq i32 %old.version, 2\n",
        "  %new.version.valid = icmp eq i32 %new.version, 2\n",
        "  %version = and i1 %old.version.valid, %new.version.valid\n",
        "  %old.count = extractvalue %chibi.snapshot.shape %old.shape, 2\n",
        "  %new.count = extractvalue %chibi.snapshot.shape %new.shape, 2\n",
        "  %old.root = extractvalue %chibi.snapshot.shape %old.shape, 1\n",
        "  %new.root = extractvalue %chibi.snapshot.shape %new.shape, 1\n",
        "  %old.root.valid = icmp ult i32 %old.root, %old.count\n",
        "  %new.root.valid = icmp ult i32 %new.root, %new.count\n",
        "  %roots = and i1 %old.root.valid, %new.root.valid\n",
        "  %old.edges = extractvalue %chibi.snapshot.shape %old.shape, 3\n",
        "  %new.edges = extractvalue %chibi.snapshot.shape %new.shape, 3\n",
        "  %old.edges.valid = icmp sge i32 %old.edges, 0\n",
        "  %new.edges.valid = icmp sge i32 %new.edges, 0\n",
        "  %edges = and i1 %old.edges.valid, %new.edges.valid\n",
        "  %old.count.valid = icmp sgt i32 %old.count, 0\n",
        "  %new.count.valid = icmp sgt i32 %new.count, 0\n",
        "  %counts = and i1 %old.count.valid, %new.count.valid\n",
        "  %headers = and i1 %version, %counts\n",
        "  %indices = and i1 %roots, %edges\n",
        "  %valid = and i1 %headers, %indices\n",
        "  br i1 %valid, label %compare, label %rejected\n",
        "compare:\n",
        "  %old.nodes = extractvalue %chibi.snapshot.shape %old.shape, 4\n",
        "  %new.nodes = extractvalue %chibi.snapshot.shape %new.shape, 4\n",
        "  %old.node = getelementptr %chibi.snapshot.node, ptr %old.nodes, i32 %old.root\n",
        "  %new.node = getelementptr %chibi.snapshot.node, ptr %new.nodes, i32 %new.root\n",
        "  %session = alloca %chibi.snapshot.schema\n",
        "  %with.memo = insertvalue %chibi.snapshot.schema zeroinitializer, ptr %memo, 0\n",
        "  %with.queue = insertvalue %chibi.snapshot.schema %with.memo, ptr %queue, 1\n",
        "  %with.old = insertvalue %chibi.snapshot.schema %with.queue, ptr %old, 2\n",
        "  %complete = insertvalue %chibi.snapshot.schema %with.old, ptr %new, 3\n",
        "  store %chibi.snapshot.schema %complete, ptr %session\n",
        "  %paired = call i1 @chibi_snapshot.schema.pair(ptr %ctx, ptr %session, ptr %old.node, ptr %new.node)\n",
        "  br i1 %paired, label %drain, label %rejected\n",
        "drain:\n",
        "  %compatible = call i1 @chibi_snapshot.queue.drain(ptr %ctx, ptr %queue, ptr %session)\n",
        "  ret i1 %compatible\n",
        "rejected:\n",
        "  ret i1 false\n",
        "}\n"
    ], "");
}
