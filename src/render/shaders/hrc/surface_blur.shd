// Separable Gaussian blur of the surface light seed along one axis.
// Edges repeat their nearest texel.

layout(set = 0, binding = 0) uniform sampler2D u_in;

layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D u_out;

layout(set = 2, binding = 0) uniform Params
{
	int u_width;
	int u_height;
	int u_vertical;
	float u_sigma;
};

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main()
{
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (p.x >= u_width || p.y >= u_height) return;
	ivec2 axis = u_vertical != 0 ? ivec2(0, 1) : ivec2(1, 0);
	ivec2 last = ivec2(u_width - 1, u_height - 1);
	int radius = int(ceil(u_sigma * 3.0));
	float falloff = -0.5 / (u_sigma * u_sigma);
	vec4 sum = vec4(0);
	float total = 0.0;
	for (int i = -radius; i <= radius; i++) {
		float weight = exp(float(i * i) * falloff);
		sum += texelFetch(u_in, clamp(p + axis * i, ivec2(0), last), 0) * weight;
		total += weight;
	}
	imageStore(u_out, p, sum / total);
}
