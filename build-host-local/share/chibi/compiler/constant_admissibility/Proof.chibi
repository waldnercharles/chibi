package constant_admissibility

import ir "project:constant_ir"

pub Request :: struct {
    expression: int;
    steps: int;
    scalar: bool;
    has_steps: bool;
}
pub Proof :: union {
    Checked(allowed: bool, steps_remaining: int, depths: int[])
}
Frame :: struct {
    expression: int;
    depth: int;
    next_arg: int;
}

FrameValue :: (expression: int, depth: int) -> Frame {
    return {expression: expression, depth: depth, next_arg: 0};
}
Frames :: (count: int) -> Frame[] {
    frames: Frame[] = [];
    index: int = 0;
    while (index < count) {
        frames.append(FrameValue(0, 0));
        index += 1;
    }
    return frames;
}
ScalarForm :: (expression: ir.Expression, type: ir.Type) -> bool {
    if (type.container != ir.Single || (type.flags & ~(ir.Untyped | ir.Literal)) != 0 ||
        type.storage < ir.Boolean || type.storage > ir.String) {
        return false;
    }
    return expression.kind == ir.Constant || expression.kind == ir.SymbolReference ||
           expression.kind == ir.Unary || expression.kind == ir.Binary || expression.kind == ir.Cast;
}
ChildCount :: (expression: ir.Expression) -> int {
    kind := expression.kind;
    if (kind == ir.Constant || kind == ir.Nil) {
        return 0;
    }
    if (kind == ir.SymbolReference || kind == ir.Unary || kind == ir.Cast || kind == ir.Member) {
        return 1;
    }
    if (kind == ir.Binary || kind == ir.Index) {
        return 2;
    }
    if (kind == ir.Array || kind == ir.Record || kind == ir.Union) {
        return expression.arg_count;
    }
    return -1;
}
Child :: (expression: ir.Expression, ordinal: int, symbols: ir.Symbol[], arguments: ir.Argument[]) -> int {
    kind := expression.kind;
    if (kind == ir.SymbolReference) {
        return symbols[expression.symbol].initializer;
    }
    if (kind == ir.Unary || kind == ir.Cast || kind == ir.Member) {
        return expression.left;
    }
    if (kind == ir.Binary || kind == ir.Index) {
        if (ordinal == 0) {
            return expression.left;
        }
        return expression.right;
    }
    return arguments[expression.arg_start + ordinal].value;
}

// Each query starts a new proof generation. A depth of -1 means that no
// successful proof belongs to this query. A deeper successful proof may be
// reused at a shallower visit, without consuming another step.
pub Check :: (expressions: ir.Expression[], types: ir.Type[], symbols: ir.Symbol[],
              arguments: ir.Argument[], request: Request) -> Proof {
    depths := resize([int(0)], length(expressions));
    index: int = 0;
    while (index < length(depths)) {
        depths[index] = -1;
        index += 1;
    }
    // The extra frame receives depth256, which is rejected before cache/budget.
    frames := Frames(257);
    frames[0] = FrameValue(request.expression, 0);
    top: int = 0;
    steps := request.steps;
    returning := false;
    valid := false;
    while (top >= 0) {
        frame := frames[top];
        if (returning) {
            if (!valid) {
                top -= 1;
                continue;
            }
            expression := expressions[frame.expression];
            frame.next_arg += 1;
            if (frame.next_arg == ChildCount(expression)) {
                depths[frame.expression] = frame.depth;
                top -= 1;
                continue;
            }
            frames[top] = frame;
            child := Child(expression, frame.next_arg, symbols, arguments);
            top += 1;
            frames[top] = FrameValue(child, frame.depth + 1);
            returning = false;
            continue;
        }
        if (frame.expression < 0 || frame.depth >= 256) {
            valid = false;
            returning = true;
            top -= 1;
            continue;
        }
        if (depths[frame.expression] >= frame.depth) {
            valid = true;
            returning = true;
            top -= 1;
            continue;
        }
        if (request.has_steps) {
            steps -= 1;
            if (steps < 0) {
                valid = false;
                returning = true;
                top -= 1;
                continue;
            }
        }
        expression := expressions[frame.expression];
        if (expression.effects != 0 ||
            (request.scalar && !ScalarForm(expression, types[expression.type]))) {
            valid = false;
            returning = true;
            top -= 1;
            continue;
        }
        if (expression.kind == ir.SymbolReference &&
            (expression.symbol < 0 || symbols[expression.symbol].kind != ir.ConstantSymbol)) {
            valid = false;
            returning = true;
            top -= 1;
            continue;
        }
        count := ChildCount(expression);
        if (count < 0) {
            valid = false;
            returning = true;
            top -= 1;
            continue;
        }
        if (count == 0) {
            depths[frame.expression] = frame.depth;
            valid = true;
            returning = true;
            top -= 1;
            continue;
        }
        child := Child(expression, 0, symbols, arguments);
        top += 1;
        frames[top] = FrameValue(child, frame.depth + 1);
    }
    return Proof.Checked(valid, steps, depths);
}
