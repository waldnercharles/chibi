diff --git a/.github/workflows/paired-studio.yml b/.github/workflows/paired-studio.yml
new file mode 100644
index 000000000..843c21b02
--- /dev/null
+++ b/.github/workflows/paired-studio.yml
@@ -0,0 +1,225 @@
+name: Paired Studio SDK verification
+
+on:
+  workflow_call:
+    inputs:
+      studio_sha:
+        description: Exact Studio commit to compile against this engine
+        required: true
+        type: string
+
+permissions:
+  contents: read
+
+jobs:
+  paired-studio-sdk:
+    name: Paired Studio native and Web SDK verification
+    runs-on: ubuntu-24.04
+    timeout-minutes: 45
+    defaults:
+      run:
+        working-directory: engine
+    env:
+      CC: clang-18
+      CXX: clang++-18
+      LIBCLANG_ROOT: /usr/lib/llvm-18
+      NATIVE_TOOLCHAIN_FLAGS: -DCMAKE_C_COMPILER=clang-18 -DCMAKE_CXX_COMPILER=clang++-18
+      EMSDK_VERSION: 6.0.10
+      GH_TOKEN: ${{ github.token }}
+      STUDIO_SHA: ${{ inputs.studio_sha }}
+      SDL_AUDIODRIVER: dummy
+    steps:
+      - name: Validate exact Studio revision
+        working-directory: ${{ github.workspace }}
+        shell: bash
+        run: |
+          printf 'PAIR_ROOT=%s\nXDG_RUNTIME_DIR=%s\n' "$RUNNER_TEMP/paired-studio" "$RUNNER_TEMP/chibi-runtime" >> "$GITHUB_ENV"
+          if [[ ! "$STUDIO_SHA" =~ ^[0-9a-f]{40}$ ]]; then
+            echo '::error::studio_sha must be a full lowercase 40-character commit SHA'
+            exit 1
+          fi
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ github.sha }}
+          path: engine
+          persist-credentials: false
+      - uses: actions/checkout@v4
+        with:
+          repository: waldnercharles/chibi-studio
+          ref: ${{ inputs.studio_sha }}
+          path: studio
+          persist-credentials: false
+      - name: Verify clean source pair
+        run: |
+          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
+          test "$(git -C "$GITHUB_WORKSPACE/studio" rev-parse HEAD)" = "$STUDIO_SHA"
+          test -z "$(git status --porcelain --untracked-files=normal)"
+          test -z "$(git -C "$GITHUB_WORKSPACE/studio" status --porcelain --untracked-files=normal)"
+          mkdir -p "$PAIR_ROOT/evidence"
+          python3 - <<'PY_SOURCE'
+          import json, os, subprocess
+          from pathlib import Path
+          def source(path):
+              def git(*args):
+                  return subprocess.check_output(['git', '-C', str(path), *args], text=True).strip()
+              return {'revision': git('rev-parse', 'HEAD'), 'tree': git('rev-parse', 'HEAD^{tree}'), 'dirty': False}
+          receipt = {'engine': source(Path.cwd()),
+                     'studio': source(Path(os.environ['GITHUB_WORKSPACE']) / 'studio')}
+          (Path(os.environ['PAIR_ROOT']) / 'evidence/sources.json').write_text(json.dumps(receipt, indent=2) + '\n')
+          PY_SOURCE
+      - name: Install build dependencies
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y --no-install-recommends \
+            clang-18 clang-tools-18 libclang-18-dev libclang-rt-18-dev ninja-build ccache \
+            python3-venv libssl-dev xvfb xauth libgl1-mesa-dev libvulkan1 mesa-vulkan-drivers \
+            libx11-dev libxcursor-dev libxext-dev libxi-dev libxrandr-dev libxss-dev \
+            libxtst-dev libwayland-dev libxkbcommon-dev libasound2-dev libpulse-dev
+          python3 -m venv "$RUNNER_TEMP/build-tools"
+          "$RUNNER_TEMP/build-tools/bin/pip" install --only-binary=:all: --require-hashes -r .github/build-tools.txt
+          echo "$RUNNER_TEMP/build-tools/bin" >> "$GITHUB_PATH"
+          install -d -m 700 "$XDG_RUNTIME_DIR"
+      - uses: mymindstorm/setup-emsdk@v14
+        with:
+          version: ${{ env.EMSDK_VERSION }}
+          actions-cache-folder: emsdk-cache
+      - name: Record Emscripten version
+        run: emcc --version | tee "$PAIR_ROOT/evidence/emscripten-version.txt"
+      - name: Package native SDK
+        run: make package-sdk SDK_PREFIX="$PAIR_ROOT/native/sdk" JOBS=2
+      - name: Verify native SDK source and retain manifest
+        run: |
+          python3 - <<'PY_NATIVE'
+          import os, shutil, subprocess
+          from pathlib import Path
+          from tools.package_sdk import previous_package
+          pair = Path(os.environ['PAIR_ROOT'])
+          prefix = pair / 'native/sdk'
+          sdk = previous_package(prefix, 'sdk')
+          if (subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip() != os.environ['GITHUB_SHA']
+                  or subprocess.check_output(['git', 'status', '--porcelain', '--untracked-files=normal'], text=True).strip()
+                  or sdk['source']['revision'] != os.environ['GITHUB_SHA'] or sdk['source']['dirty'] is not False
+                  or sdk['requirements']['system'] != 'Linux' or sdk['build']['configuration'] != 'Debug'):
+              raise SystemExit('Native SDK does not identify the clean engine/Linux Debug candidate')
+          shutil.copyfile(prefix / 'share/chibi/package.json', pair / 'evidence/native-package.json')
+          PY_NATIVE
+      - name: Build exact Studio against native SDK
+        run: |
+          cmake -S "$GITHUB_WORKSPACE/studio" -B "$PAIR_ROOT/native/build" -G Ninja \
+            -DCMAKE_C_COMPILER=clang-18 -DCMAKE_CXX_COMPILER=clang++-18 -DCMAKE_BUILD_TYPE=Debug \
+            -DChibi_DIR="$PAIR_ROOT/native/sdk/lib/cmake/Chibi"
+          cmake --build "$PAIR_ROOT/native/build" --target chibi-studio --parallel 2
+      - name: Two hidden Studio frames
+        shell: bash
+        run: |
+          cp -a --reflink=auto "$GITHUB_WORKSPACE/studio/projects/starter" "$PAIR_ROOT/startup-project"
+          xvfb-run -a "$PAIR_ROOT/native/build/bin/chibi-dev" \
+            --project-root "$PAIR_ROOT/startup-project" \
+            --headless --frames 2 --fixed-dt 0.0166667 2>&1 | tee "$PAIR_ROOT/evidence/native-startup.log"
+          ! grep -E 'Studio UI:|runtime frame failed|Could not initialize' "$PAIR_ROOT/evidence/native-startup.log"
+      - name: Package serial Web SDK
+        run: |
+          make package-web-sdk WEB_SDK_BUILD_DIR=build-web-sdk \
+            WEB_SDK_PREFIX="$PAIR_ROOT/web/sdk" WEB_THREADS=0 WEB_WORKERS=4 JOBS=2
+      - name: Verify serial Web SDK source and retain manifest
+        run: |
+          python3 - <<'PY_WEB'
+          import os, shutil, subprocess
+          from pathlib import Path
+          from tools.package_sdk import previous_package
+          pair = Path(os.environ['PAIR_ROOT'])
+          prefix = pair / 'web/sdk'
+          sdk = previous_package(prefix, 'sdk')
+          requirement = sdk['requirements']
+          if (subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip() != os.environ['GITHUB_SHA']
+                  or subprocess.check_output(['git', 'status', '--porcelain', '--untracked-files=normal'], text=True).strip()
+                  or sdk['source']['revision'] != os.environ['GITHUB_SHA'] or sdk['source']['dirty'] is not False
+                  or requirement['system'] != 'Emscripten' or sdk['build']['configuration'] != 'Release'
+                  or requirement['web_threads'] is not False or requirement['web_workers'] != 4
+                  or sdk['build']['native_backend'] is not False):
+              raise SystemExit('Web SDK does not identify the clean engine/serial Emscripten Release candidate')
+          shutil.copyfile(prefix / 'share/chibi/package.json', pair / 'evidence/web-package.json')
+          PY_WEB
+      - name: Compile exact Studio against Web SDK
+        run: |
+          sh tools/web_env.sh emcmake cmake \
+            -S "$GITHUB_WORKSPACE/studio" -B "$PAIR_ROOT/web/build" -G Ninja \
+            -DCMAKE_BUILD_TYPE=Release -DChibi_DIR="$PAIR_ROOT/web/sdk/lib/cmake/Chibi"
+          cmake --build "$PAIR_ROOT/web/build" --target chibi-studio --parallel 2
+      - name: Verify SDK bindings and retain paired evidence
+        run: |
+          python3 - <<'PY'
+          import hashlib, json, os, re, shutil, subprocess
+          from pathlib import Path
+          from tools.package_sdk import previous_package
+          engine = Path.cwd()
+          studio = Path(os.environ['GITHUB_WORKSPACE']) / 'studio'
+          pair = Path(os.environ['PAIR_ROOT'])
+          evidence = pair / 'evidence'
+          def digest(path):
+              return hashlib.sha256(path.read_bytes()).hexdigest()
+          def source(path, expected):
+              def git(*args):
+                  return subprocess.check_output(['git', '-C', str(path), *args], text=True).strip()
+              if git('rev-parse', 'HEAD') != expected or git('status', '--porcelain', '--untracked-files=normal'):
+                  raise SystemExit(f'Source changed: {path}')
+              return {'revision': expected, 'tree': git('rev-parse', 'HEAD^{tree}'), 'dirty': False}
+          def cache(path):
+              result = {}
+              for line in path.read_text().splitlines():
+                  if ':' in line and '=' in line and not line.startswith(('#', '//')):
+                      key, value = line.split('=', 1)
+                      result[key.split(':', 1)[0]] = value
+              return result
+          receipt = {'engine': source(engine, os.environ['GITHUB_SHA']),
+                     'studio': source(studio, os.environ['STUDIO_SHA']), 'sdks': {}}
+          version = (evidence / 'emscripten-version.txt').read_text().splitlines()[0]
+          if not re.search(r'\b6\.0\.10\b', version):
+              raise SystemExit('Unexpected Emscripten version')
+          receipt['emscripten'] = version
+          receipt['startup_project'] = {
+              'source': 'studio/projects/starter', 'copy': str(pair / 'startup-project'),
+              'source_manifest_sha256': digest(studio / 'projects/starter/project.kdl'),
+              'opened_manifest_sha256': digest(pair / 'startup-project/project.kdl')}
+          for name, system, configuration in [('native', 'Linux', 'Debug'), ('web', 'Emscripten', 'Release')]:
+              prefix = pair / name / 'sdk'
+              manifest = prefix / 'share/chibi/package.json'
+              sdk = previous_package(prefix, 'sdk')
+              requirement = sdk['requirements']
+              if (sdk['source']['revision'] != receipt['engine']['revision'] or sdk['source']['dirty']
+                      or requirement['system'] != system or sdk['build']['configuration'] != configuration):
+                  raise SystemExit(f'SDK does not identify the clean source/configuration: {name}')
+              if name == 'web' and (requirement['web_threads'] or requirement['web_workers'] != 4
+                                    or sdk['build']['native_backend']):
+                  raise SystemExit('Expected a serial Web SDK without the native backend')
+              values = cache(pair / name / 'build/CMakeCache.txt')
+              expected = {'Chibi_DIR': str(prefix / 'lib/cmake/Chibi'),
+                          'CHIBI_STUDIO_SDK_BUILD_ID': sdk['build_id'],
+                          'CHIBI_STUDIO_SDK_MANIFEST_SHA256': digest(manifest)}
+              if any(values.get(key) != value for key, value in expected.items()):
+                  raise SystemExit(f'Studio consumed a different SDK: {name}')
+              receipt['sdks'][name] = {'build_id': sdk['build_id'], 'manifest_sha256': digest(manifest),
+                                      'source': sdk['source'], 'bindings': expected,
+                                      'prepared_format': requirement['prepared_format'],
+                                      'project_format': requirement['project_format']}
+              shutil.copyfile(manifest, evidence / f'{name}-package.json')
+          if (receipt['sdks']['native']['source'] != receipt['sdks']['web']['source']
+                  or receipt['sdks']['native']['prepared_format'] != receipt['sdks']['web']['prepared_format']
+                  or receipt['sdks']['native']['project_format'] != receipt['sdks']['web']['project_format']):
+              raise SystemExit('Native and Web SDK source/format identities differ')
+          products = [pair / 'native/build/bin/chibi-dev']
