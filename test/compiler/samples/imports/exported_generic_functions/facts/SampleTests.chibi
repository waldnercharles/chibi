package facts

// exported generic functions
@test
Calls :: () {
    a1_0: int = 7;
    r1: int = Main(a1_0);
    e1: int = 21;
    assert(r1 == e1, "Main call 1");
    a2_0: i64 = 9007199254740993;
    r2: i64 = Wide(a2_0);
    e2: i64 = 9007199254740993;
    assert(r2 == e2, "Wide call 2");
    r3: int = First();
    e3: int = 7;
    assert(r3 == e3, "First call 3");
    r4: int = Scaled();
    e4: int = 23;
    assert(r4 == e4, "Scaled call 4");
    r5: int = Enabled();
    e5: int = 7;
    assert(r5 == e5, "Enabled call 5");
}
