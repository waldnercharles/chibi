#!/bin/bash
# Cloud defaults without changing compiler-name lookup in the ambient PATH.
set -euo pipefail
prefix=${CHIBI_CLOUD_TOOLS:-/workspace/.cloud-tools}
tool=${0##*/}
case $tool in
    cmake)
        target="$prefix/python/bin/cmake"
        if [[ ${CMAKE+x} ]]; then
            [[ -n $CMAKE ]] || { echo 'Explicit CMAKE is empty; unset it for the cloud default or select an executable.' >&2; exit 1; }
            target=$(PATH="${CHIBI_CLOUD_ORIGINAL_PATH:-$PATH}" command -v "$CMAKE") || {
                echo "Explicit CMAKE=$CMAKE is unavailable on the original PATH." >&2; exit 1;
            }
            [[ -x $target ]] || { echo "Explicit CMAKE=$CMAKE must resolve to an executable file." >&2; exit 1; }
            # Explicitly selecting this wrapper selects its provisioned default.
            [[ $target != "$0" ]] || target="$prefix/python/bin/cmake"
        fi ;;
    clang-format) target="$prefix/python/bin/clang-format" ;;
    emcc|emcmake) target="$prefix/emsdk-6.0.10/upstream/emscripten/$tool" ;;
    ninja|ccache) target="$prefix/root/usr/bin/$tool" ;;
    *) echo "Unknown cloud tool: $tool" >&2; exit 2 ;;
esac
exec "$target" "$@"
