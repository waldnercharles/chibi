-                            : behavior_function_entry(f);
-    behavior_run_record(inspected ? EXECUTION_RUN_INSPECTED_SLJIT : EXECUTION_RUN_SLJIT);
-    return ((int (*)(behavior_function_context *))entry)(ctx);
-#endif
-}
