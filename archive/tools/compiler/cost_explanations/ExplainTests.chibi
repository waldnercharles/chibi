package cost_explanations

import strings "core:strings"

Matches :: (bytes: u8[], expected: string) -> bool {
    if (length(bytes) != strings.ByteLength(expected)) {
        return false;
    }
    index: int = 0;
    while (index < length(bytes)) {
        if (int(bytes[index]) != strings.ByteAt(expected, index)) {
            return false;
        }
        index += 1;
    }
    return true;
}

Contains :: (bytes: u8[], expected: string) -> bool {
    start: int = 0;
    while (start <= length(bytes) - strings.ByteLength(expected)) {
        index: int = 0;
        while (index < strings.ByteLength(expected) && int(bytes[start + index]) == strings.ByteAt(expected, index)) {
            index += 1;
        }
        if (index == strings.ByteLength(expected)) {
            return true;
        }
        start += 1;
    }
    return false;
}

Entry :: (id: u64, complete: bool) -> Function {
    return {id: id, name: "Update", path: "game/Main.chibi", start: 10, end: 80, line: 2, column: 1, complete: complete};
}

Evidence :: (kind: int, possible: bool) -> Cost {
    return {function: 0, kind: kind, possible: possible, capability: 7, path: "game/Helpers.chibi",
            start: 40, end: 49, line: 4, column: 8, reason: "Dynamic storage request"};
}

@test
EmptyReport :: () {
    assert(Matches(Report([], [], false), "Static allocation/copy report\nCoverage: finalized function bodies and linked callees. Binding, subscription, query evaluator roots and backend/activation setup are excluded.\nPresent means an operation exists in compiled code; a branch may not execute it.\nAllocation includes every dynamic storage request, including arenas and pools.\nRuntime traffic and backing allocations are unmeasured; lending causes and GC costs are unavailable.\nFirst evidence per kind and certainty. Traversal completeness covers the inspected graph only; unknown native costs remain unknown.\nNo zero-allocation guarantee.\nNo functions.\n"));
    assert(Matches(Report([], [], true), "{\"version\":1,\"mode\":\"static\",\"analysis_scope\":\"function_bodies_and_linked_callees\",\"excluded_roots\":[\"bindings\",\"subscriptions\",\"query_evaluators\"],\"backend_and_activation_setup\":\"unavailable\",\"present_meaning\":\"operation exists in compiled code; a branch may not execute it\",\"allocation_scope\":\"every dynamic storage request, including arenas and pools\",\"runtime_traffic\":\"unmeasured\",\"backing_allocations\":\"unmeasured\",\"lending_causes\":\"unavailable\",\"gc_costs\":\"unavailable\",\"evidence\":\"first_per_kind_and_certainty\",\"traversal_completeness\":\"inspected graph only; unknown native costs remain unknown\",\"zero_allocation_guarantee\":false,\"functions\":[]}\n"));
}

@test
EntryAndOriginLocations :: () {
    functions := [Entry(9, true)];
    costs := [Evidence(1, false)];
    json := Report(functions, costs, true);
    assert(Contains(json, "\"source\":{\"path\":\"game/Main.chibi\",\"start\":10,\"end\":80,\"line\":2,\"column\":1},\"traversal_complete\":true"));
    assert(Contains(json, "\"kind\":\"allocation\",\"status\":\"present\",\"reason\":\"Dynamic storage request\",\"origin\":{\"capability_id\":\"7\",\"source\":{\"path\":\"game/Helpers.chibi\",\"start\":40,\"end\":49,\"line\":4,\"column\":8}}"));
    assert(Contains(json, "\"column\":8}}}]}]}\n"));
    human := Report(functions, costs, false);
    assert(Contains(human, "Entry Update [9] at game/Main.chibi:2:1; traversal complete\n"));
    assert(Contains(human, "  allocation present at game/Helpers.chibi:4:8: Dynamic storage request [capability 7]\n"));
}

@test
UncertainAndUnlocated :: () {
    item := Entry(0, false);
    item.path = "";
    cost := Evidence(4, true);
    cost.line = 0;
    cost.reason = "Capture may escape; lending cause unavailable";
    json := Report([item], [cost], true);
    assert(Contains(json, "\"id\":\"0\",\"name\":\"Update\",\"source\":null,\"traversal_complete\":false"));
    assert(Contains(json, "\"kind\":\"escape\",\"status\":\"possible\",\"reason\":\"Capture may escape; lending cause unavailable\",\"origin\":{\"capability_id\":\"7\",\"source\":null}"));
    human := Report([item], [cost], false);
    assert(Contains(human, "Entry Update [0] at source unavailable; traversal incomplete\n"));
    assert(Contains(human, "  escape possible at source unavailable: Capture may escape; lending cause unavailable [capability 7]\n"));
}

@test
FullWidthIdentifiersAndJsonEscaping :: () {
    item := Entry(18446744073709551615, true);
    item.name = "Quote\" slash\\ café";
    item.path = "tab\tline\nreturn\r.chibi";
    cost := Evidence(2, false);
    cost.capability = 9223372036854775808;
    cost.reason = "zero\u0000 back\b form\f end\u001f";
    json := Report([item], [cost], true);
    assert(Contains(json, "\"id\":\"18446744073709551615\""));
    assert(Contains(json, "\"capability_id\":\"9223372036854775808\""));
    assert(Contains(json, "\"name\":\"Quote\\\" slash\\\\ café\""));
    assert(Contains(json, "\"path\":\"tab\\u0009line\\u000areturn\\u000d.chibi\""));
    assert(Contains(json, "\"reason\":\"zero\\u0000 back\\u0008 form\\u000c end\\u001f\""));
}

@test
FirstEvidenceAndStableKindOrder :: () {
    escape := Evidence(4, true);
    copy := Evidence(2, false);
    copy.reason = "First copy evidence";
    possible := Evidence(2, true);
    possible.reason = "Copy may occur";
    later := Evidence(2, false);
    later.reason = "Later copy evidence";
    allocate := Evidence(1, false);
    json := Report([Entry(1, true)], [escape, copy, possible, later, allocate], true);
    assert(!Contains(json, "Later copy evidence"));
    assert(Contains(json, "\"reason\":\"First copy evidence\""));
    assert(Contains(json, "\"kind\":\"copy\",\"status\":\"possible\",\"reason\":\"Copy may occur\""));
    human := Report([Entry(1, true)], [escape, copy, possible, later, allocate], false);
    assert(Contains(human, "  allocation present at game/Helpers.chibi:4:8: Dynamic storage request [capability 7]\n  copy present at game/Helpers.chibi:4:8: First copy evidence [capability 7]\n  copy possible at game/Helpers.chibi:4:8: Copy may occur [capability 7]\n  escape possible at game/Helpers.chibi:4:8: Dynamic storage request [capability 7]\n"));
}

@test
CompletenessIsNotAZeroAllocationVerdict :: () {
    json := Report([Entry(1, true), Entry(2, false)], [], true);
    assert(Contains(json, "\"traversal_complete\":true,\"costs\":[]"));
    assert(Contains(json, "\"traversal_complete\":false,\"costs\":[]"));
    assert(Contains(json, "\"zero_allocation_guarantee\":false"));
    assert(Contains(json, "unknown native costs remain unknown"));
    human := Report([Entry(1, true)], [], false);
    assert(Contains(human, "  No allocation/copy/escape evidence recorded.\n"));
    assert(Contains(human, "No zero-allocation guarantee.\n"));
}
