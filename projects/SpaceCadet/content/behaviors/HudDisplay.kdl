version 3
name "HudDisplay"
id_counter 105
description "Shows score, balls, rank, plunger charge and the mission on the HUD document."
owner_type "ecs.entity"
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 1
                type "Event"
                reference_name "Tick"
                outputs {
                    DeltaSeconds id=3 type="float" kind="data"
                }
            }
            - {
                id 4
                type "Get Global Variable"
                inputs Name="Score"
                outputs {
                    Value type="float"
                }
            }
            - {
                id 7
                type "Format Text"
                inputs {
                    Format "{:08.0f}"
                    Arg0 type="float"
                }
            }
            - {
                id 11
                type "Set UI Text"
                inputs Element="#score"
            }
            - {
                id 17
                type "Get Global Variable"
                inputs Name="Lives"
                outputs {
                    Value type="double"
                }
            }
            - {
                id 20
                type "Format Text"
                inputs {
                    Format "BALLS   {:.0f}"
                    Arg0 type="double"
                }
            }
            - {
                id 24
                type "Set UI Text"
                inputs Element="#lives"
            }
            - {
                id 30
                type "Get Global Variable"
                inputs Name="Rank"
                outputs {
                    Value type="float"
                }
            }
            - {
                id 33
                type "Format Text"
                inputs {
                    Format "RANK   {:.0f}"
                    Arg0 type="float"
                }
            }
            - {
                id 37
                type "Set UI Text"
                inputs Element="#rank"
            }
            - {
                id 43
                type "Get Global Variable"
                inputs Name="Charge"
            }
            - {
                id 46
                type "Set UI Value"
                inputs Element="#charge"
            }
            - {
                id 66
                type "Behavior Expression"
                reference_name "lives <= 0"
                inputs {
                    Exec id=69 kind="exec"
                    lives id=67 type="double"
                }
                outputs {
                    True id=70 kind="exec"
                    False id=71 kind="exec"
                    Result id=68 type="bool"
                }
            }
            - {
                id 86
                type "Set UI Text"
                inputs Element="#mission" Text="GAME OVER"
            }
            - {
                id 92
                type "Get Global Variable"
                inputs Name="Hits"
                outputs {
                    Value type="float"
                }
            }
            - {
                id 95
                type "Format Text"
                inputs {
                    Format "TARGET PRACTICE\n{:.0f} / 8 HITS"
                    Arg0 type="float"
                }
            }
            - {
                id 99
                type "Set UI Text"
                inputs Element="#mission"
            }
        }
        (array)edges {
            - from="1.Then" to="11.Exec"
            - from="4.Value" to="7.Arg0"
            - from="7.Result" to="11.Text"
            - from="11.Then" to="24.Exec"
            - from="17.Value" to="20.Arg0"
            - from="17.Value" to="66.lives"
            - from="20.Result" to="24.Text"
            - from="24.Then" to="37.Exec"
            - from="30.Value" to="33.Arg0"
            - from="33.Result" to="37.Text"
            - from="37.Then" to="46.Exec"
            - from="43.Value" to="46.Value"
            - from="46.Then" to="66.Exec"
            - from="66.True" to="86.Exec"
            - from="66.False" to="99.Exec"
            - from="92.Value" to="95.Arg0"
            - from="95.Result" to="99.Text"
        }
    }
    - id=52 kind="function" math_expression="lives <= 0" entry_id=73
}
