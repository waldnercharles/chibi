version: 3
name: ShaderMath
domain: shader-library
id_counter: 589
description: Shared pulse, ring mask and hit flash functions with explicit inputs.
graphs:
- {kind: event, name: Functions}
- id: 56
  kind: function
  name: Pulse
  entry_id: 57
  return_id: 59
  call_depth_limit: 64
  nodes:
  - id: 57
    type: Function Entry
    outputs:
    - {id: 61, name: Time, type: float, kind: data}
    - {id: 62, name: Speed, type: float, kind: data}
  - id: 59
    type: Return
    inputs:
    - {id: 63, name: Brightness, type: float, kind: data}
  - id: 190
    type: Behavior Expression
    reference_id: 163
    reference_name: (sin(time * speed) + 1) * 0.5
    inputs:
      time: {type: float}
      speed: {type: float}
    outputs:
      Result: {type: float}
  edges:
  - {from: 57.Time, to: 190.time}
  - {from: 57.Speed, to: 190.speed}
  - {from: 190.Result, to: 59.Brightness}
- id: 102
  kind: function
  name: Ring Mask
  entry_id: 103
  return_id: 107
  call_depth_limit: 64
  nodes:
  - id: 103
    type: Function Entry
    outputs:
    - id: 104
      name: Position
      type: struct
      type_name: ShaderVec2
      kind: data
      default: {x: 0.0, "y": 0.0}
    - {id: 105, name: Radius, type: float, kind: data, default: 35.0}
    - {id: 106, name: Width, type: float, kind: data, default: 3.0}
  - id: 107
    type: Return
    inputs:
    - {id: 108, name: Mask, type: float, kind: data}
  - id: 110
    type: Shader Circle
    inputs:
      Position:
        default: {x: 0.0, "y": 0.0}
  - id: 305
    type: Behavior Expression
    reference_id: 275
    reference_name: saturate(1 - abs(distance) / max(width, 0.001))
    inputs:
      distance: {type: float}
      width: {type: float}
    outputs:
      Result: {type: float}
  edges:
  - {from: 103.Position, to: 110.Position}
  - {from: 103.Radius, to: 110.Radius}
  - {from: 103.Width, to: 305.width}
  - {from: 110.Value, to: 305.distance}
  - {from: 305.Result, to: 107.Mask}
- id: 163
  kind: function
  math_expression: (sin(time * speed) + 1) * 0.5
  entry_id: 249
- id: 275
  kind: function
  math_expression: saturate(1 - abs(distance) / max(width, 0.001))
  entry_id: 370
- id: 399
  kind: function
  name: Hit Flash
  entry_id: 400
  return_id: 402
  call_depth_limit: 64
  nodes:
  - id: 400
    type: Function Entry
    outputs:
    - {id: 404, name: Color, type: struct, type_name: ShaderVec3, kind: data}
    - {id: 405, name: Flash, type: float, kind: data}
  - id: 402
    type: Return
    inputs:
    - {id: 406, name: Base Color, type: struct, type_name: ShaderVec3, kind: data}
    - {id: 407, name: Glow, type: struct, type_name: ShaderVec3, kind: data}
  - id: 435
    type: Behavior Expression
    reference_id: 408
    reference_name: mix(color, vec3(0.75, 0.95, 1), saturate(flash))
    inputs:
      color: {type: struct, type_name: ShaderVec3}
      flash: {type: float}
    outputs:
      Result: {type: struct, type_name: ShaderVec3}
  - id: 515
    type: Behavior Expression
    reference_id: 493
