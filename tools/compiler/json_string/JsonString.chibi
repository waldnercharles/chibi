package json_string

import bytes "core:bytes"
import strings "core:strings"

// Decodes one JSON string literal, quotes included, to the bytes it denotes:
// the compiler's reading of a source string literal. Surrounding JSON
// whitespace is skipped and nothing else may follow the closing quote.
// A literal that is not exactly one string decodes to invalid, empty text and
// zero length. One pass over the literal's bytes appends to one buffer.
//
// This replaces the compiler_json_string and compiler_json_value_string
// natives (src/toolchain/compiler_json.c). The compiler's callers switch to it,
// and CompilerSources.txt lists it, once the bootstrap seed has the
// text-from-bytes builtin that core:bytes uses; the seed compiles the
// compiler's sources, so they may use only what it supports.

Space: int : 32;
Tab: int : 9;
Newline: int : 10;
Return: int : 13;
Quote: int : 34;
Backslash: int : 92;
Slash: int : 47;
LowerB: int : 98;
LowerF: int : 102;
LowerN: int : 110;
LowerR: int : 114;
LowerT: int : 116;
LowerU: int : 117;
FirstControlEnd: int : 32;
Ascii: int : 128;

// The value of a hexadecimal digit, or -1.
Digit :: (byte: int) -> int {
    if (byte >= 48 && byte <= 57) {
        return byte - 48;
    }
    if (byte >= 65 && byte <= 70) {
        return byte - 55;
    }
    if (byte >= 97 && byte <= 102) {
        return byte - 87;
    }
    return -1;
}

// The four hexadecimal digits at `at`, or -1.
Hex4 :: (data: int[], at: int) -> int {
    if (at + 4 > length(data)) {
        return -1;
    }
    value: int = 0;
    for offset in 0..<4 {
        digit := Digit(data[at + offset]);
        if (digit < 0) {
            return -1;
        }
        value = value * 16 + digit;
    }
    return value;
}

// Whether `data[at]` is a continuation byte inside [low, high].
Within :: (data: int[], at: int, low: int, high: int) -> bool {
    return at < length(data) && data[at] >= low && data[at] <= high;
}

// The width of the well-formed UTF-8 sequence at `at`, or 0: no overlong
// forms, surrogates or code points above U+10FFFF.
Sequence :: (data: int[], at: int) -> int {
    lead := data[at];
    if (lead >= 194 && lead <= 223) {
        if (Within(data, at + 1, 128, 191)) {
            return 2;
        }
        return 0;
    }
    if (lead >= 224 && lead <= 239) {
        low: int = 128;
        high: int = 191;
        if (lead == 224) {
            low = 160;
        }
        if (lead == 237) {
            high = 159;
        }
        if (Within(data, at + 1, low, high) && Within(data, at + 2, 128, 191)) {
            return 3;
        }
        return 0;
    }
    if (lead >= 240 && lead <= 244) {
        low: int = 128;
        high: int = 191;
        if (lead == 240) {
            low = 144;
        }
        if (lead == 244) {
            high = 143;
        }
        if (Within(data, at + 1, low, high) && Within(data, at + 2, 128, 191) && Within(data, at + 3, 128, 191)) {
            return 4;
        }
        return 0;
    }
    return 0;
}

// The position after the whitespace at `at`.
SkipSpace :: (data: int[], at: int) -> int {
    while (at < length(data) && (data[at] == Space || data[at] == Tab || data[at] == Newline || data[at] == Return)) {
        at += 1;
    }
    return at;
}

// A character the single-character escapes denote, or -1.
Simple :: (byte: int) -> int {
    if (byte == Quote || byte == Backslash || byte == Slash) {
        return byte;
    }
    if (byte == LowerB) {
        return 8;
    }
    if (byte == LowerF) {
        return 12;
    }
    if (byte == LowerN) {
        return 10;
    }
    if (byte == LowerR) {
        return 13;
    }
    if (byte == LowerT) {
        return 9;
    }
    return -1;
}

pub Decoded :: struct {
    valid: bool;
    value: string;
    byte_length: int;
}

Invalid :: () -> Decoded {
    return {valid: false, value: "", byte_length: 0};
}

// A strict literal rejects raw control bytes and malformed UTF-8. Otherwise
// every raw byte is kept, as the compiler's value strings are arbitrary bytes.
Decode :: (literal: string, strict: bool) -> Decoded {
    data := strings.Bytes(literal);
    count := length(data);
    out: u8[] = [];
    at := SkipSpace(data, 0);
    if (at >= count || data[at] != Quote) {
        return Invalid();
    }
    at += 1;
    closed := false;
    while (!closed) {
        if (at >= count) {
            return Invalid();
        }
        byte := data[at];
        if (byte == Quote) {
            closed = true;
            at += 1;
        } else if (byte == Backslash) {
            if (at + 1 >= count) {
                return Invalid();
            }
            escape := data[at + 1];
            if (escape != LowerU) {
                simple := Simple(escape);
                if (simple < 0) {
                    return Invalid();
                }
                out.append(u8(simple));
                at += 2;
            } else {
                high := Hex4(data, at + 2);
                if (high < 0) {
                    return Invalid();
                }
                at += 6;
                point := high;
                if (high >= 55296 && high <= 57343) {
                    if (high >= 56320 || at + 1 >= count || data[at] != Backslash || data[at + 1] != LowerU) {
                        return Invalid();
                    }
                    low := Hex4(data, at + 2);
                    if (low < 56320 || low > 57343) {
                        return Invalid();
                    }
                    point = 65536 + (high - 55296) * 1024 + (low - 56320);
                    at += 6;
                }
                // The UTF-8 encoding of the code point, appended in place: a
                // helper's array parameter would be a copy.
                if (point < 128) {
                    out.append(u8(point));
                } else if (point < 2048) {
                    out.append(u8(192 + point / 64));
                    out.append(u8(128 + point % 64));
                } else if (point < 65536) {
                    out.append(u8(224 + point / 4096));
                    out.append(u8(128 + point / 64 % 64));
                    out.append(u8(128 + point % 64));
                } else {
                    out.append(u8(240 + point / 262144));
                    out.append(u8(128 + point / 4096 % 64));
                    out.append(u8(128 + point / 64 % 64));
                    out.append(u8(128 + point % 64));
                }
            }
        } else if (byte < FirstControlEnd && strict) {
            return Invalid();
        } else if (byte >= Ascii && strict) {
            width := Sequence(data, at);
            if (width == 0) {
                return Invalid();
            }
            for offset in 0..<width {
                out.append(u8(data[at + offset]));
            }
            at += width;
        } else {
            out.append(u8(byte));
            at += 1;
        }
    }
    if (SkipSpace(data, at) != count) {
        return Invalid();
    }
    text := bytes.ToString(out);
    return {valid: true, value: text, byte_length: length(out)};
}

// A metadata string: well-formed Unicode only.
pub Metadata :: (literal: string) -> Decoded {
    return Decode(literal, true);
}

// A value string: any bytes between the quotes.
pub Value :: (literal: string) -> Decoded {
    return Decode(literal, false);
}
