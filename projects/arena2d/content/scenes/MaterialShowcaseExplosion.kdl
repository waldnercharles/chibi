version 1
name "MaterialShowcaseExplosion"
(array)entities {
    - name="Materials" prototype="MaterialShowcaseExplosionWorld"
    - {
        name "Camera"
        prototype "MaterialShowcaseEntity"
        components {
            GameCamera width=260.0 height=180.0
        }
    }
    - {
        name "Floor"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=0.0 y=64.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=204.0 height=8.0 category=8 mask=15 friction=0.6
            GameAppearance width=204.0 height=8.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Ceiling"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=0.0 y=-64.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=204.0 height=8.0 category=8 mask=15 friction=0.6
            GameAppearance width=204.0 height=8.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Left wall"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=-100.0 y=0.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=8.0 height=136.0 category=8 mask=15 friction=0.6
            GameAppearance width=8.0 height=136.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Right wall"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=100.0 y=0.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" width=8.0 height=136.0 category=8 mask=15 friction=0.6
            GameAppearance width=8.0 height=136.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Crater slab"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=0.0 y=20.0
            GameBody type="Static" allow_rotation=#true
            GameCollider shape="Box" category=8 mask=15 width=130.0 height=24.0 friction=0.6
            GameAppearance width=130.0 height=24.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
            GameDestructible cell_size=2.0 min_fragment_cells=6
            GameSubstance hardness=1.0 retain_chips=#false blast_multiplier=1.0
            MaterialBreakProfile chip_speed=8.0 fragment_speed=4.0 release_speed=4.0 dust_limit=0 chunk_limit=0 smoke_count=0
        }
    }
    - {
        name "Charge"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=6.0 y=-6.0
            GameFluidVolume {
                kind "Liquid"
                width 6.0
                height 6.0
                spacing 0.25
                mass 7.142857e-05
                color 0xf3b24aff
                velocity x=0.0 y=0.0
                absorption 0.08
                visibility 0.4
                refraction 0.0
                grain_radius 0.0
            }
            MaterialConstitutive density=0.001 bulk_modulus=4.0 shear_modulus=0.0
            GameFuel amount=0.0035714286
        }
    }
    - {
        name "Timed igniter"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=6.0 y=-6.0
            GameBody type="Static"
            GameCollider shape="Circle" radius=0.1 category=8 mask=15
            GameIgniter heat=0.0
        }
        (array)behaviors "MaterialShowcaseExplosionIgnition"
    }
    - {
        name "Water"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=-26.0 y=-4.0
            GameFluidVolume {
                kind "Liquid"
                width 24.0
                height 24.0
                spacing 0.25
                mass 6.19469e-05
                color 0x369de8ff
                velocity x=0.0 y=0.0
                absorption 0.08
                visibility 0.4
                refraction 0.0
                grain_radius 0.0
            }
            MaterialConstitutive density=0.001 bulk_modulus=4.0 shear_modulus=0.0
        }
    }
    - {
        name "Gas"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=38.0 y=-12.0
            GameFluidVolume {
                kind "Gas"
                width 30.0
                height 28.0
                spacing 0.375
                mass 0.00014011585
                color 0x42d7dfff
                velocity x=0.0 y=0.0
                absorption 0.025
                visibility 0.25
                refraction 0.0
                grain_radius 0.0
            }
        }
    }
    - {
        name "Loose block 1"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=-35.0 y=-32.0
            GameVelocity x=0.0 y=0.0
            GameBody type="Dynamic" allow_rotation=#true
            GameCollider shape="Box" width=10.0 height=10.0 category=8 mask=15
            GameAppearance width=10.0 height=10.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Loose block 2"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=-8.0 y=-38.0
            GameVelocity x=0.0 y=0.0
            GameBody type="Dynamic" allow_rotation=#true
            GameCollider shape="Box" width=10.0 height=10.0 category=8 mask=15
            GameAppearance width=10.0 height=10.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
    - {
        name "Loose block 3"
        prototype "MaterialShowcaseEntity"
        components {
            GameTransform x=32.0 y=-38.0
            GameVelocity x=0.0 y=0.0
            GameBody type="Dynamic" allow_rotation=#true
            GameCollider shape="Box" width=10.0 height=10.0 category=8 mask=15
            GameAppearance width=10.0 height=10.0 color=0x697887ff
            GameMaterial scene=0x697887ff albedo=0x697887ff absorption=1.0
        }
    }
}
