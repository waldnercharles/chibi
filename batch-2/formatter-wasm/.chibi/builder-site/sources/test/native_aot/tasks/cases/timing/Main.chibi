package task_timing

Main :: () -> int {
    immediate := Worker();
    cancel immediate after 0
    await immediate
    negative := Worker();
    cancel negative after -1
    await negative
    if (Count(false) != 0) { return 1; }

    // A later deadline request cannot extend the first one. Children are
    // cancelled before their continuation even though they enter the queue first.
    timed := Parent();
    cancel timed after 0.002
    cancel timed after 1
    await Delay(0.008)
    await timed
    if (Count(false) != 0) { return 2; }

    // Nonpositive delays do not give up this turn.
    done := Worker();
    await Delay(0)
    await Delay(-1)
    if (Count(false) != 0) { return 3; }
    await done
    if (Count(false) != 1) { return 4; }
    return 0;
}

Parent :: () -> int {
    Worker();
    await Delay(0.02)
    Count(true);
    return 0;
}

Worker :: () -> int {
    await Delay(0.01)
    Count(true);
    return 0;
}

Count :: (increment: bool) -> int {
    count: retain int = 0;
    if (increment) { count += 1; }
    return count;
}
