            "chibi_physics_runtime", "chibi_material_runtime", "chibi_entity_runtime", "chibi_tilemap_runtime",
            "chibi_particle_runtime", "chibi_save_runtime", "chibi_mesh_runtime",
            "third-party/lib/chibi-vendor/libchibi_vendor_box2d.a",
            "chibi_field_capabilities", "chibi_model_runtime",
            "chibi_field_catalog", "chibi_fields", "chibi_ui_authoring",
            "chibi_builtin_fonts",
            "chibi_ui_documents", "chibi_image_preparation", "chibi_image_catalog", "chibi_shader_runtime",
            "chibi_compiler_syntax", "chibi_compiler_json", "chibi_task_pool_runtime",
            "third-party/lib/chibi-vendor/libchibi_vendor_enkits.a", "-lc++",
            "chibi_source_catalog", "chibi_ui_document", "chibi_ui_document_values",
            "chibi_scene_runtime",
            "chibi_text_capabilities", "chibi_fmt",
            "chibi_array_capabilities", "chibi_core_capabilities", "chibi_state_capabilities",
            "chibi_selection_capabilities", "chibi_set_capabilities", "chibi_comparison_capabilities",
            "chibi_conversion_capabilities", "chibi_vector_capabilities", "chibi_math_capabilities",
            "chibi_arithmetic_capabilities", "chibi_value_document", "chibi_text_source", "chibi_text_search",
            "chibi_authoring", "chibi_reference_index", "chibi_compiler",
            "chibi_language", "chibi_json", "chibi_language_syntax",
            "third-party/lib/chibi-vendor/libchibi_vendor_tree_sitter.a",
            "chibi_input_runtime", "chibi_behavior_runtime", "chibi_events",
