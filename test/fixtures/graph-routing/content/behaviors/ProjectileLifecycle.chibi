behavior "ProjectileLifecycle" {
    on Tick {
        self.Projectile.Age += double(delta)
        if double(self.Projectile.Age) >= double(self.Projectile.Lifetime) {
            destroy_entity(self)
        } else {
            if length(self.Velocity) > 0.0001 {
                self.Orientation.Radians = atan2(self.Velocity.y, self.Velocity.x)
            }
        }
    }
}
