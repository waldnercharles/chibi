package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Cave")),
            data.Field.Named("components", data.Object([
                data.Field.Named("MaterialTerrain", data.Object([
                    data.Field.Named("field", data.Value.Text("BasaltCave"))
                ])),
                data.Field.Named("Shader", data.Object([
                    data.Field.Named("material", data.Value.Text("Basalt"))
                ]))
            ]))
        ])
    );
}
