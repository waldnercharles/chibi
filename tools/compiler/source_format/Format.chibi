package source_format

import strings "core:strings"
import syntax "project:compiler_syntax"
import parser "project:source_parser"
import diag "project:syntax_diagnostics"

// Layout formatting for Chibi source: a whitespace-only pass over the
// tokens of the parser's tree. Line breaks the author wrote stay, except
// where the grammar forces one; this pass chooses indentation, alignment of
// continued lines, blank lines (at most one) and the single spaces between
// tokens. The result is parsed again and must match the input's tree kind for
// kind, field for field and byte for byte on every leaf, or it is rejected.
// The rules are the archived C formatter's (archive/src/authoring/source_format.c),
// written over the same tree.

// The largest source the formatter accepts, in bytes.
pub MaxBytes: int : 8388608;

pub Options :: struct {
    // Spaces per indentation level, 1 to 16. Ignored when `use_tabs`.
    indent_width: int;
    // One tab per level; continued-line alignment still uses spaces.
    use_tabs: bool;
}

pub Defaults :: () -> Options {
    return {indent_width: 4, use_tabs: false};
}

pub Result :: union {
    Formatted(text: string) |
    Rejected(message: string)
}

// Formats `text`: LF line ends, no trailing spaces and one final newline.
// Empty or all-whitespace source has no tokens and is returned unchanged.
pub Format :: (text: string, options: Options) -> Result {
    if (options.indent_width < 1 || options.indent_width > 16) {
        return Result.Rejected("Invalid formatter options: indent_width must be 1..16");
    }
    if (text_byte_length(text) > MaxBytes) {
        return Result.Rejected("Source exceeds the formatter's byte limit");
    }
    switch syntax.Parse(text) {
        case .Parsed(rows, fields, named, extras, root):
            if (rows[root].has_error) {
                return Result.Rejected("Cannot format source with syntax errors");
            }
            tokens := Tokens(rows, fields);
            if (length(tokens) == 0) {
                return Result.Formatted(text);
            }
            formatted := Layout(text, rows, fields, root, tokens, options);
            switch syntax.Parse(formatted) {
                case .Parsed(again, again_fields, again_named, again_extras, again_root):
                    if (again[again_root].has_error ||
                        !Equivalent(text, rows, fields, named, formatted, again, again_fields, again_named)) {
                        return Result.Rejected("Formatting would change the syntax tree");
                    }
            }
            return Result.Formatted(formatted);
    }
}

// A leaf of the tree with width, in source order, and what the layout needs
// to know about its place. `node` is its row in the tree. Closed sets of
// kinds are named by the grammar, so the flags are computed once here instead
// of re-asking the tree for every gap.
Token :: struct {
    node: int;
    start: int;
    end: int;
    // The brace that opens or closes a block-like body.
    open: bool;
    close: bool;
    // The last token of a statement or declaration: a newline follows.
    end_line: bool;
    // A bracket whose contents may continue on later lines.
    nest_open: bool;
    nest_close: bool;
    // A switch arm's colon with a bare body, and that body's last token.
    case_open: bool;
    case_close: bool;
    // Binary-expression chains that start or end at this token.
    chain_open: int;
    chain_close: int;
}

// Leading whitespace: indentation levels, then alignment spaces.
Margin :: struct {
    levels: int;
    spaces: int;
}

// An open block, bracket, case arm or operator chain: the margin of the
// lines inside it, and of a line that starts with its closing token.
Frame :: struct {
    inside: Margin;
    close: Margin;
}

// The open frames; the first `depth` entries are live.
Frames :: struct {
    list: Frame[];
    depth: int;
}

KindOf :: (rows: diag.Node[], node: int) -> string {
    if (node < 0) {
        return "";
    }
    return rows[node].kind;
}

ParentOf :: (rows: diag.Node[], node: int) -> int {
    if (node < 0) {
        return -1;
    }
    return rows[node].parent;
}

ParentKind :: (rows: diag.Node[], node: int) -> string {
    return KindOf(rows, ParentOf(rows, node));
}

FirstChild :: (rows: diag.Node[], node: int) -> int {
    if (node < 0) {
        return -1;
    }
    return rows[node].first_child;
}

PreviousSibling :: (rows: diag.Node[], node: int) -> int {
    parent := ParentOf(rows, node);
    if (parent < 0) {
        return -1;
    }
    previous: int = -1;
    child := rows[parent].first_child;
    while (child >= 0 && child != node) {
        previous = child;
        child = rows[child].next_sibling;
    }
    return previous;
}

ChildByField :: (rows: diag.Node[], fields: string[], parent: int, name: string) -> int {
    child := rows[parent].first_child;
    while (child >= 0) {
        if (fields[child] == name) {
            return child;
        }
        child = rows[child].next_sibling;
    }
    return -1;
}

// Nodes whose braces open an indented body.
IsBlock :: (rows: diag.Node[], node: int) -> bool {
    kind := KindOf(rows, node);
    if (kind == "block" || kind == "declaration_body" || kind == "system_body" ||
        kind == "callable_body" || kind == "component_body" || kind == "record_body" ||
        kind == "prototype_body" || kind == "switch_statement" ||
        kind == "union_declaration" || kind == "sequence_statement") {
        return true;
    }
    if (kind == "struct_expression") {
        parent := ParentKind(rows, node);
        return parent == "prototype_component" || parent == "relationship_declaration";
    }
    return false;
}

// Brackets whose contents may continue on later lines.
IsNest :: (rows: diag.Node[], node: int) -> bool {
    if (IsBlock(rows, node)) {
        return false;
    }
    kind := KindOf(rows, node);
    return kind == "argument_list" || kind == "parameter_list" || kind == "query_list" ||
           kind == "pattern_bindings" || kind == "array_expression" ||
           kind == "map_expression" || kind == "struct_expression" ||
           kind == "prototype_bases" || kind == "struct_field" ||
           kind == "parenthesized_expression";
}

// The outermost operator of an expression, whose operands may continue on
// later lines.
IsChain :: (rows: diag.Node[], node: int) -> bool {
    return KindOf(rows, node) == "binary_expression" && ParentKind(rows, node) != "binary_expression";
}

// Nodes whose last token ends a line.
EndsLine :: (rows: diag.Node[], node: int) -> bool {
    kind := KindOf(rows, node);
    return strings.HasSuffix(kind, "_declaration") || strings.HasSuffix(kind, "_statement") ||
           kind == "assignment" || kind == "handler" || kind == "component_field" ||
           kind == "record_field";
}

// A bare switch-arm body is a block that does not start with a brace.
IsBareArm :: (rows: diag.Node[], node: int) -> bool {
    return KindOf(rows, node) == "block" && ParentKind(rows, node) == "switch_arm" &&
           KindOf(rows, FirstChild(rows, node)) != "{";
}

// The leaves with width, in source order. Zero-width terminators never
// print, so they have no row here.
Tokens :: (rows: diag.Node[], fields: string[]) -> Token[] {
    tokens: Token[] = [];
    i: int = 0;
    while (i < length(rows)) {
        row := rows[i];
        if (row.first_child < 0 && row.start >= 0 && row.end > row.start) {
            tokens.append(MakeToken(rows, fields, i));
        }
        i += 1;
    }
    return tokens;
}

MakeToken :: (rows: diag.Node[], fields: string[], node: int) -> Token {
    kind := rows[node].kind;
    parent := rows[node].parent;
    start := rows[node].start;
    end := rows[node].end;
    block := IsBlock(rows, parent);
    brace := kind == "(" || kind == "[" || kind == "{";
    closer := kind == ")" || kind == "]" || kind == "}";
    nest := IsNest(rows, parent);
    token: Token = {node: node, start: start, end: end,
                    open: kind == "{" && block, close: kind == "}" && block,
                    end_line: kind == "," && block,
                    nest_open: brace && nest, nest_close: closer && nest,
                    case_open: false, case_close: false, chain_open: 0, chain_close: 0};
    if (kind == ":" && ParentKind(rows, node) == "switch_arm") {
        body := ChildByField(rows, fields, parent, "body");
        token.case_open = KindOf(rows, FirstChild(rows, body)) != "{";
    }
    ancestor := parent;
    while (ancestor >= 0 && rows[ancestor].start == start) {
        if (IsChain(rows, ancestor)) {
            token.chain_open += 1;
        }
        ancestor = rows[ancestor].parent;
    }
    ancestor = parent;
    while (ancestor >= 0 && rows[ancestor].end == end) {
        if (EndsLine(rows, ancestor)) {
            token.end_line = true;
        }
        if (IsChain(rows, ancestor)) {
            token.chain_close += 1;
        }
        if (IsBareArm(rows, ancestor)) {
            token.case_close = true;
        }
        ancestor = rows[ancestor].parent;
    }
    return token;
}

// `Name: T : value` spaces the colon that follows a constant's type.
IsConstantColon :: (rows: diag.Node[], node: int) -> bool {
    return rows[node].kind == ":" && ParentKind(rows, node) == "constant_declaration" &&
           KindOf(rows, PreviousSibling(rows, node)) == "type";
}

// u/s^2
IsUnitOperator :: (rows: diag.Node[], node: int) -> bool {
    kind := rows[node].kind;
    return (kind == "/" || kind == "^") && ParentKind(rows, node) == "unit";
}

// A token that takes no space before it.
TightBefore :: (rows: diag.Node[], node: int) -> bool {
    kind := rows[node].kind;
    parent := ParentKind(rows, node);
    if (kind == "," || kind == ";" || kind == ".." || kind == "..<" || kind == ")" || kind == "]") {
        return true;
    }
    if (kind == ":") {
        return !IsConstantColon(rows, node);
    }
    if (kind == ".") {
        return parent != "variant_pattern";
    }
    if (kind == "}") {
        return parent == "struct_expression";
    }
    if (kind == "(") {
        if (parent == "parameter_list" || parent == "query_list" || parent == "pattern_bindings" ||
            parent == "reduce_statement" || parent == "prototype_bases" ||
            parent == "parenthesized_type") {
            return true;
        }
        return parent == "argument_list" && ParentKind(rows, rows[node].parent) != "return_statement";
    }
    if (kind == "[") {
        return parent == "type" || parent == "index_expression";
    }
    if (kind == "?") {
        return parent == "type";
    }
    if (kind == "^") {
        return parent == "dereference_expression" || parent == "unit";
    }
    if (kind == "/") {
        return parent == "unit";
    }
    return false;
}

// A token that takes no space after it.
TightAfter :: (rows: diag.Node[], node: int) -> bool {
    kind := rows[node].kind;
    parent := ParentKind(rows, node);
    if (kind == "(" || kind == "[" || kind == "." || kind == ".." || kind == "..<" || kind == "@") {
        return true;
    }
    if (kind == "$") {
        return parent == "type_binder" || parent == "parameter";
    }
    if (kind == "{") {
        return parent == "struct_expression";
    }
    if (kind == "^") {
        return parent == "pointer_type" || parent == "unit";
    }
    if (kind == "/") {
        return parent == "unit";
    }
    if (kind == "&") {
        return parent == "address_expression" || parent == "for_statement";
    }
    return parent == "unary_expression" && kind != "not" &&
           rows[rows[node].parent].start == rows[node].start;
}

SpaceBetween :: (rows: diag.Node[], previous: Token, current: Token) -> bool {
    if (previous.open && current.close) {
        return false;
    }
    kind := rows[previous.node].kind;
    if (kind == "->" || kind == "::") {
        return true;
    }
    return !TightBefore(rows, current.node) && !TightAfter(rows, previous.node);
}

Push :: (frames: ^Frames, frame: Frame) {
    if (frames.depth == length(frames.list)) {
        frames.list.append(frame);
    } else {
        frames.list[frames.depth] = frame;
    }
    frames.depth += 1;
}

// The margin of a line inside the innermost open frame.
Inner :: (frames: ^Frames) -> Margin {
    if (frames.depth == 0) {
        return {levels: 0, spaces: 0};
    }
    return frames.list[frames.depth - 1].inside;
}

// Aligns later lines at `column`, indenting with as many of the line's
// levels as fit.
Align :: (line: Margin, column: int, width: int) -> Margin {
    levels := line.levels;
    if (column / width < levels) {
        levels = column / width;
    }
    return {levels: levels, spaces: column - levels * width};
}

// Whether a line break (or the legacy lone CR of a package file) separates
// two tokens, and how many such breaks the gap holds.
Breaks :: (bytes: int[], packaged: bool, start: int, end: int) -> int {
    count: int = 0;
    at := start;
    while (at < end) {
        if (bytes[at] == 10) {
            count += 1;
        } else if (packaged && bytes[at] == 13 && !(at + 1 < length(bytes) && bytes[at + 1] == 10)) {
            count += 1;
        }
        at += 1;
    }
    return count;
}

// Appends a line break and `margin` to the output pieces.
Break :: (out: ^(string[]), blank: bool, margin: Margin, unit: string) {
    if (blank) {
        out.append("\n\n");
    } else {
        out.append("\n");
    }
    if (margin.levels > 0) {
        out.append(strings.Repeat(unit, margin.levels));
    }
    if (margin.spaces > 0) {
        out.append(strings.Repeat(" ", margin.spaces));
    }
}

Layout :: (text: string, rows: diag.Node[], fields: string[], root: int, tokens: Token[],
           options: Options) -> string {
    bytes := text_bytes(text);
    width := options.indent_width;
    unit := strings.Repeat(" ", width);
    if (options.use_tabs) {
        unit = "\t";
    }
    packaged := ChildByField(rows, fields, root, "package") >= 0;
    frames: Frames = {list: [], depth: 0};
    out: string[] = [];
    line: Margin = {levels: 0, spaces: 0};
    column: int = 0;
    i: int = 0;
    while (i < length(tokens)) {
        current := tokens[i];
        at := Inner(&frames);
        if (current.close || current.nest_close) {
            frames.depth -= 1;
            at = frames.list[frames.depth].close;
        }
        if (i > 0) {
            previous := tokens[i - 1];
            lines := Breaks(bytes, packaged, previous.end, current.start);
            comment := rows[current.node].kind == "comment";
            inline_comment := comment && lines == 0;
            empty_block := previous.open && current.close;
            kind := rows[current.node].kind;
            chained := previous.close && (kind == "else" || kind == ";");
            newline := (lines > 0 && !chained) ||
                       (!inline_comment && !empty_block && !chained &&
                        (previous.open || previous.close || previous.end_line ||
                         previous.case_open || current.close));
            if (newline) {
                Break(&out, lines > 1, at, unit);
                line = at;
                column = at.levels * width + at.spaces;
            } else if (SpaceBetween(rows, previous, current)) {
                out.append(" ");
                column += 1;
            }
        }
        start_column := column;
        out.append(text_slice(text, current.start, current.end - current.start));
        at_byte := current.start;
        while (at_byte < current.end) {
            if (bytes[at_byte] == 10 || (packaged && bytes[at_byte] == 13)) {
                column = 0;
            } else {
                column += 1;
            }
            at_byte += 1;
        }
        // Operands continued on later lines align with the first one.
        chains: int = 0;
        while (chains < current.chain_open) {
            Push(&frames, {inside: Align(line, start_column, width), close: line});
            chains += 1;
        }
        if (current.open || current.case_open) {
            outer := Inner(&frames);
            Push(&frames, {inside: {levels: outer.levels + 1, spaces: outer.spaces}, close: outer});
        }
        frames.depth -= current.chain_close;
        if (current.case_close) {
            frames.depth -= 1;
        }
        if (current.nest_open) {
            // A bracket that ends its line indents the next lines one level
            // past that line; otherwise they align with its first item.
            wraps := Breaks(bytes, packaged, current.end, tokens[i + 1].start) > 0;
            within := Align(line, column, width);
            if (wraps) {
                within = {levels: line.levels + 1, spaces: line.spaces};
            }
            Push(&frames, {inside: within, close: line});
        }
        i += 1;
    }
    out.append("\n");
    return strings.Join(out, "");
}

// Visible rows are the ones with width; the tree-sitter cursor walk the
// archived formatter compared skipped the zero-width terminators the same way.
NextVisible :: (rows: diag.Node[], at: int) -> int {
    while (at < length(rows) && rows[at].end == rows[at].start) {
        at += 1;
    }
    return at;
}

// Depths of every row; a parent's row precedes its children's.
Depths :: (rows: diag.Node[]) -> int[] {
    depths := resize([int(0)], length(rows));
    i: int = 1;
    while (i < length(rows)) {
        depths[i] = depths[rows[i].parent] + 1;
        i += 1;
    }
    return depths;
}

// Whether two parses have the same shape: depth, kind, namedness and field of
// every visible row, and the same bytes in every visible leaf.
Equivalent :: (original: string, a: diag.Node[], a_fields: string[], a_named: bool[],
               rewritten: string, b: diag.Node[], b_fields: string[], b_named: bool[]) -> bool {
    a_depths := Depths(a);
    b_depths := Depths(b);
    i := NextVisible(a, 0);
    j := NextVisible(b, 0);
    while (i < length(a) && j < length(b)) {
        if (a_depths[i] != b_depths[j] || a[i].kind != b[j].kind || a_named[i] != b_named[j] ||
            a_fields[i] != b_fields[j]) {
            return false;
        }
        if (a[i].first_child < 0 && b[j].first_child < 0) {
            size := a[i].end - a[i].start;
            if (size != b[j].end - b[j].start ||
                text_slice(original, a[i].start, size) != text_slice(rewritten, b[j].start, size)) {
                return false;
            }
        }
        i = NextVisible(a, i + 1);
        j = NextVisible(b, j + 1);
    }
    return i >= length(a) && j >= length(b);
}
