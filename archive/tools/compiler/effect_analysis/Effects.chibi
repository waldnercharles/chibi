package effect_analysis
import syntax "project:syntax_diagnostics"
import strings "core:strings"

// Flat raw resolved rows retain analyzer order and enum values. Negative ID
// slots denote zero; all other indices and spans obey analyzer invariants.
pub Expression :: struct {
    kind: int;
    op: int;
    effects: int;
    left: int;
    right: int;
    arg_start: int;
    arg_count: int;
    symbol: int;
    flags: int;
    container: int;
    nominal_slot: int;
    capability_slot: int;
    read_slot: int;
    write_slot: int;
    task: bool;
    range: int;
    storage: int;
}
pub Statement :: struct {
    kind: int;
    effects: int;
    expression: int;
    second: int;
    third: int;
    body: int;
    alternative: int;
    child_start: int;
    child_count: int;
    reduction: int;
    range: int;
    symbol: int;
}
pub Function :: struct {
    kind: int;
    parent: int;
    body: int;
    effects: int;
    range: int;
    pure: bool;
}
pub Symbol :: struct {
    kind: int;
    scope: int;
    initializer: int;
    nominal_slot: int;
    range: int;
    flags: int;
    query_description: int;
    component_slot: int;
    storage: int;
    mutations: int;
}
pub Scope :: struct {
    function: int;
}
pub Query :: struct {
    description: int;
    kind: int;
    value: int;
    component_slot: int;
    range: int;
}
pub Description :: struct {
    system: bool;
    stage_start: int;
    stage_count: int;
}
pub Stage :: struct {
    symbol: int;
    expression: int;
    range: int;
}
pub Binding :: struct {
    target: int;
    value: int;
    read_start: int;
    read_count: int;
    write_start: int;
    write_count: int;
    range: int;
}
pub Capability :: struct {
    id_slot: int;
    component_access: int;
    state_access: int;
    component_slot: int;
    effects: int;
}
pub CatalogType :: struct {
    id_slot: int;
    component_id_slot: int;
    name: string;
}
pub Range :: struct {
    start: int;
    end: int;
    line: int;
    column: int;
    document: int;
}
pub Environment :: union {
    Tables(expressions: Expression[], arguments: int[], statements: Statement[], children: int[], functions: Function[], symbols: Symbol[], scopes: Scope[], queries: Query[], bindings: Binding[], reads: u64[], writes: u64[], capabilities: Capability[], catalog_types: CatalogType[], ids: u64[], ranges: Range[], descriptions: Description[], stages: Stage[])
}
pub Analysis :: union {
    Completed(expression_effects: int[], statement_effects: int[], function_effects: int[], diagnostics: syntax.Diagnostic[])
}
pub Ordering :: union {
    Ordered(permutation: int[], diagnostics: syntax.Diagnostic[])
}
Restrictions :: union {
    Restricted(bits: int, seen: bool[])
}
Reduction :: union {
    Checked(access: bool, opaque: bool, task: bool, seen: bool[])
}

Expressions :: (environment: Environment) -> Expression[] {
    switch environment {
        case .Tables(expressions, arguments, statements, children, functions, symbols, scopes, queries, bindings, reads, writes, capabilities, catalog_types, ids, ranges, descriptions, stages):
            return expressions;
    }
}
Arguments :: (environment: Environment) -> int[] {
    switch environment {
        case .Tables(expressions, arguments, statements, children, functions, symbols, scopes, queries, bindings, reads, writes, capabilities, catalog_types, ids, ranges, descriptions, stages):
            return arguments;
    }
}
Statements :: (environment: Environment) -> Statement[] {
    switch environment {
        case .Tables(expressions, arguments, statements, children, functions, symbols, scopes, queries, bindings, reads, writes, capabilities, catalog_types, ids, ranges, descriptions, stages):
            return statements;
    }
}
Children :: (environment: Environment) -> int[] {
    switch environment {
        case .Tables(expressions, arguments, statements, children, functions, symbols, scopes, queries, bindings, reads, writes, capabilities, catalog_types, ids, ranges, descriptions, stages):
            return children;
    }
}
Functions :: (environment: Environment) -> Function[] {
    switch environment {
        case .Tables(expressions, arguments, statements, children, functions, symbols, scopes, queries, bindings, reads, writes, capabilities, catalog_types, ids, ranges, descriptions, stages):
            return functions;
    }
}
Symbols :: (environment: Environment) -> Symbol[] {
    switch environment {
        case .Tables(expressions, arguments, statements, children, functions, symbols, scopes, queries, bindings, reads, writes, capabilities, catalog_types, ids, ranges, descriptions, stages):
            return symbols;
