version 1
name "SdfQualityStudy"
(array)entities {
    - {
        name "Camera"
        prototype "SdfOptimizationCamera"
        components {
            GameTransform x=0.0 y=0.0
            GameCamera width=620.0 height=400.0 focal_distance=650.0
            GameHRC2D ambient=0.08 fog=0.02 bounce_intensity=0.12
        }
    }
    - {
        name "West cyan"
        prototype "SdfLight"
        components {
            GameTransform x=-260.0 y=0.0
            GameMaterial emission_color=0x38d9edff
        }
    }
    - {
        name "East amber"
        prototype "SdfLight"
        components {
            GameTransform x=260.0 y=0.0
            GameMaterial emission_color=0xffac54ff
        }
    }
    - {
        name "North rose"
        prototype "SdfLight"
        components {
            GameTransform x=0.0 y=-160.0
            GameMaterial emission_color=0xec749fff
        }
    }
    - {
        name "South ivory"
        prototype "SdfLight"
        components {
            GameTransform x=0.0 y=160.0
            GameMaterial emission_color=0xcddcffff
        }
    }
    - {
        name "Large near sphere"
        prototype "SdfSphere"
        components {
            GameTransform x=-165.0 y=-85.0
            GameVisualTransform scale=1.3 pitch=0.0
            GameGeometry3D elevation=180.0
            GameShader material="SdfCyan"
        }
    }
    - {
        name "Large far sphere"
        prototype "SdfSphere"
        components {
            GameTransform x=-55.0 y=-85.0
            GameVisualTransform scale=1.3 pitch=0.0
            GameGeometry3D elevation=-220.0
            GameShader material="SdfAmber"
        }
    }
    - {
        name "Small sphere 1"
        prototype "SdfSphere"
        components {
            GameTransform x=45.0 y=-85.0
            GameVisualTransform scale=0.5 pitch=0.0
            GameShader material="SdfRose"
        }
    }
    - {
        name "Small sphere 2"
        prototype "SdfSphere"
        components {
            GameTransform x=90.0 y=-85.0
            GameVisualTransform scale=0.15 pitch=0.0
            GameShader material="SdfRose"
        }
    }
    - {
        name "Small sphere 3"
        prototype "SdfSphere"
        components {
            GameTransform x=135.0 y=-85.0
            GameVisualTransform scale=0.045 pitch=0.0
            GameShader material="SdfRose"
        }
    }
    - {
        name "Small sphere 4"
        prototype "SdfSphere"
        components {
            GameTransform x=180.0 y=-85.0
            GameVisualTransform scale=0.015 pitch=0.0
            GameShader material="SdfRose"
        }
    }
    - {
        name "Thin ring"
        prototype "SdfQualityThinRing"
        components {
            GameTransform x=-160.0 y=25.0
            GameVisualTransform scale=1.0 pitch=0.3
            GameShader material="SdfAmber"
        }
    }
    - {
        name "Small thin ring"
        prototype "SdfQualityThinRing"
        components {
            GameTransform x=-80.0 y=25.0
            GameVisualTransform scale=0.3 pitch=0.3
        }
    }
    - {
        name "Narrow cut"
        prototype "SdfQualityNarrowCut"
        components {
            GameTransform x=15.0 y=25.0
            GameVisualTransform pitch=0.45
            GameShader material="SdfCyan"
        }
    }
    - {
        name "Moving cut"
        prototype "SdfQualityNarrowCut"
        components {
            GameTransform x=130.0 y=25.0
        }
        (array)behaviors "SdfRigidSweep"
    }
    - {
        name "Rear triangle"
        prototype "SdfComparisonMesh"
        components {
            GameTransform x=-25.0 y=115.0
            GameGeometry3D width=90.0 height=8.0 depth=55.0 elevation=-8.0
            GameVisualTransform pitch=0.0 roll=0.0
        }
    }
    - {
        name "Front distance sphere"
        prototype "SdfSphere"
        components {
            GameTransform x=0.0 y=115.0
            GameGeometry3D elevation=8.0
            GameVisualTransform scale=0.7 pitch=0.0
            GameShader material="SdfRose"
        }
    }
    - {
        name "Large detailed LOD control"
        prototype "SdfQualityNarrowCut"
        components {
            GameTransform x=-130.0 y=165.0
            GameVisualTransform scale=0.6
            GameSdfSurface3D enabled=#true low_detail_shape="SdfSphere" low_detail_pixels=24.0
        }
    }
    - {
        name "Small simplified LOD control"
        prototype "SdfQualityNarrowCut"
        components {
            GameTransform x=-40.0 y=165.0
            GameVisualTransform scale=0.08
            GameSdfSurface3D enabled=#true low_detail_shape="SdfSphere" low_detail_pixels=24.0
        }
    }
    - {
        name "Moving LOD threshold"
        prototype "SdfQualityNarrowCut"
        components {
            GameTransform x=55.0 y=165.0
            GameVisualTransform scale=0.23
            GameSdfSurface3D enabled=#true low_detail_shape="SdfSphere" low_detail_pixels=24.0
        }
        (array)behaviors "SdfQualityScaleSweep"
    }
}
