behavior "DashBehavior" {
    state "Just Started" := false
    state "Struck Entities": handle<"ecs.entity">[] = []
    value get_gamedash = get_game_dash()
    value delta_time = delta_time()
    value greater_or_equal = greater_or_equal(delta_time, get_gamedash.Value.cooldown_remaining)
    value get_gamedash_2 = get_game_dash()
    value less = less(0.0, get_gamedash_2.Value.remaining)
    value greater_or_equal_2 = greater_or_equal(0.0, get_gamedash.Value.remaining)
    on Dash {
        if greater_or_equal {
            if greater_or_equal_2 {
                await "Start Dash"()
            }
        }
    }
    on Tick {
        await "Advance Dash Timers"()
        if less {
            await "Drive Dash"()
        }
    }
    on "Contact Begin" {
        await "Strike Target"(event.Other)
    }
    function "Capture Dash Direction"() {
        value get_gameinput = get_game_input()
        value get_gameaim = get_game_aim()
        value break_cf_v2 = break_cf_v2(get_gameinput.Value.move)
        value abs = abs(break_cf_v2.x)
        value abs_2 = abs(break_cf_v2.y)
        value add = add(abs, abs_2)
        value greater_or_equal = greater_or_equal(add, 0.0001)
        value normalize_vector_2 = vec2_norm(get_gameinput.Value.move)
        value normalize_vector_2_2 = vec2_norm(get_gameaim.Value.direction)
        after entry {
            if greater_or_equal {
                await set_game_dash_direction(normalize_vector_2)
                return
            } else {
                await set_game_dash_direction(normalize_vector_2_2)
                return
            }
        }
    }
    function "Drive Dash"() {
        value get_gamedash = get_game_dash()
        value break_cf_v2 = break_cf_v2(get_gamedash.Value.direction)
        after entry {
            await set_game_velocity(multiply(get_gamedash.Value.direction, get_gamedash.Value.speed))
            await set_game_orientation("DirectionMath"."Direction Orientation"(break_cf_v2.x, break_cf_v2.y))
            return
        }
    }
    function "Restore Movement"() {
        value get_gameinput = get_game_input()
        value has_gameinput = has_game_input()
        after entry {
            if has_gameinput {
                await set_game_velocity("MovementActions"."Movement Velocity"(get_gameinput.Value.move, get_game_movement()))
                return
            } else {
                await set_game_velocity({
                    x: 0.0,
                    y: 0.0
                })
                return
            }
        }
    }
    function "Advance Dash"() {
        value get_gamedash = get_game_dash()
        action set_gamedash_remaining = set_game_dash_remaining(max(subtract(get_gamedash.Value.remaining, delta_time()), B: float = 0.0))
        value less = less(0.0, set_gamedash_remaining.Value.remaining)
        after entry {
            set_gamedash_remaining()
        }
        after set_gamedash_remaining {
            if less {
                return
            } else {
                await "Restore Movement"()
                return
            }
        }
    }
    function "Advance Dash Timers"() {
        value just_started = get_variable<"Just Started">()
        value get_gamedash = get_game_dash()
        value less = less(0.0, get_gamedash.Value.remaining)
        after entry {
            if just_started {
                await set_variable<"Just Started">(false)
                return
            } else {
                await set_game_dash_cooldown_remaining(max(subtract(get_gamedash.Value.cooldown_remaining, delta_time()), B: float = 0.0))
                if less {
                    await "Advance Dash"()
                    return
                } else {
                    return
                }
            }
        }
    }
    function "Strike Target"(Other: handle<"ecs.entity"> = 0) {
        value get_gamedash = get_game_dash()
        value less = less(0.0, get_gamedash.Value.remaining)
        value hasentity_gamehealth = has_entity_game_health(entry.Other)
        value hasentity_gamecollider = has_entity_game_collider(entry.Other)
        value getentity_gamecollider = get_entity_game_collider(entry.Other)
        value has_any_flags = has_any_flags(getentity_gamecollider.Value.category, 2)
        value struck_entities = get_variable<"Struck Entities">()
        value contains = contains(struck_entities, entry.Other)
        after entry {
            if less {
                if hasentity_gamehealth {
                    if hasentity_gamecollider {
                        if has_any_flags {
                            if contains {
                                return
                            } else {
                                await set_variable<"Struck Entities">(array_add(struck_entities, entry.Other))
                                await send_event<"Damage">(entry.Other, get_gamedash.Value.damage, self)
                                return
                            }
                        } else {
                            return
                        }
                    } else {
                        return
                    }
                } else {
                    return
                }
            } else {
                return
            }
        }
    }
    function "Strike Current Contacts"() {
        after entry {
            foreach (foreach_2 in get_contact_entities(self, 2)) {
                await "Strike Target"(foreach_2)
            }
            return
        }
    }
    function "Start Dash"() {
        value get_gamehealth = get_game_health()
        value integer_greater_or_equal = integer_greater_or_equal(get_gamehealth.Value.current, 1)
        value get_gamedash = get_game_dash()
        after entry {
            if integer_greater_or_equal {
                await "Capture Dash Direction"()
                await set_game_dash_remaining(get_gamedash.Value.duration)
                await set_game_dash_cooldown_remaining(get_gamedash.Value.cooldown)
                await set_variable<"Just Started">(true)
                await set_variable<"Struck Entities">([])
                await "Strike Current Contacts"()
                return
            } else {
                return
            }
        }
    }
}
