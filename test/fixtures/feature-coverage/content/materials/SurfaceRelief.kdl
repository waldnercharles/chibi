version 3
name "SurfaceRelief"
domain "material"
id_counter 1000
description "Generic destructible specimen. Retained part X gives signed world-unit surface height; the generated mesh supplies its physical normal."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=100 type="Shader PartPosition" x=0.0 y=0.0
            - {
                id 200
                type "Behavior Expression"
                x 250.0
                y 0.0
                reference_name "surface_position.x * 0.05"
                inputs {
                    surface_position id=201 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=202 type="number"
                }
            }
            - {
                id 300
                type "Shader Surface Output"
                x 550.0
                y 0.0
                inputs {
                    "Base Color" {
                        default x=0.16 y=0.4 z=0.56
                    }
                    Roughness 0.6
                    Normal {
                        default x=0.0 y=0.0 z=0.0
                    }
                }
            }
        }
        (array)edges {
            - from="100.Value" to="200.surface_position"
            - from="200.Result" to="300.Height"
        }
    }
    - id=500 kind="function" math_expression="surface_position.x * 0.05" expression_mode=1 entry_id=501
}
