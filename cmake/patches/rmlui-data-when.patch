+DataViewWhen::DataViewWhen(Element* element) : DataViewCommon(element) {}
+
+bool DataViewWhen::Initialize(DataModel& model, Element* element, const String& expression, const String& modifier)
+{
+	if (!DataViewCommon::Initialize(model, element, expression, modifier))
+		return false;
+
+	element->SetProperty(PropertyId::Display, Property(Style::Display::None));
+
+	// The copy takes the other attributes and builds its own views from them.
+	for (const auto& attribute : element->GetAttributes())
+	{
+		if (attribute.first != "data-when" && attribute.first != "rmlui-inner-rml")
+			attributes.emplace(attribute.first, attribute.second);
+	}
+	return true;
+}
+
+bool DataViewWhen::Update(DataModel& model)
+{
+	Element* element = GetElement();
+	Variant variant;
+	DataExpressionInterface expr_interface(&model, element);
+	if (!element || !GetExpression().Run(expr_interface, variant) || variant.Get<bool>() == (instance != nullptr))
+		return false;
+
+	if (instance)
+	{
+		instance->GetParentNode()->RemoveChild(instance).reset();
+		instance = nullptr;
+		return true;
+	}
+
+	ElementPtr copy = Factory::InstanceElement(nullptr, element->GetTagName(), element->GetTagName(), attributes);
+	instance = element->GetParentNode()->InsertBefore(std::move(copy), element);
+	// The inner RML arrives after the view is made, and an empty element has none.
+	const Variant* rml = element->GetAttribute("rmlui-inner-rml");
+	instance->SetInnerRML(rml ? rml->Get<String>() : String());
+	return true;
+}
+
