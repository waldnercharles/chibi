version 1
name "Shader Demo"
(array)entities {
    - {
        name "Animated emission"
        prototype "ShaderRing"
        components {
            GameTransform x=220 y=300
        }
        (array)behaviors "DamageFlashBehavior"
    }
    - {
        name "Color gradient"
        prototype "ShaderGradient"
        components {
            GameTransform x=400 y=300
        }
    }
    - {
        name "Smooth union"
        prototype "ShaderUnion"
        components {
            GameTransform x=580 y=300
        }
    }
}
