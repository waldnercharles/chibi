cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/dev_snapshot.cmake")
file(READ "${DEV_CONFIG}" config)
string(JSON version GET "${config}" version)
if(NOT version EQUAL 1)
    message(FATAL_ERROR "Unsupported development descriptor version")
endif()
foreach(key source_dir build_dir cmake)
    string(JSON ${key} GET "${config}" "${key}")
endforeach()
file(MAKE_DIRECTORY "${build_dir}")
file(LOCK "${build_dir}/dev-build.lock" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE locked)
if(NOT locked STREQUAL "0")
    message(FATAL_ERROR "Another development build is active")
endif()
set(rebuild_marker "${build_dir}/dev-rebuild-required")
if(FORCE_REBUILD)
    file(WRITE "${rebuild_marker}" "Sources changed during the previous build.\n")
endif()
chibi_source_snapshot(before resident_sources "${config}")
set(compiled_snapshot "${build_dir}/dev-source-digest")
# Apple ships GNU Make 3.81, which can compile an object and then miss the
# relink when both outputs share a timestamp second. Hashes detect that work
# is needed; clean-first prevents the old build tool from reusing those files.
if(EXISTS "${build_dir}/CMakeCache.txt")
    file(STRINGS "${build_dir}/CMakeCache.txt" generator REGEX "^CMAKE_GENERATOR:INTERNAL=")
    if(generator STREQUAL "CMAKE_GENERATOR:INTERNAL=Unix Makefiles")
        file(STRINGS "${build_dir}/CMakeCache.txt" make_program REGEX "^CMAKE_MAKE_PROGRAM:FILEPATH=")
        string(REGEX REPLACE "^[^=]*=" "" make_program "${make_program}")
        execute_process(COMMAND "${make_program}" --version OUTPUT_VARIABLE make_version)
        if(make_version MATCHES "GNU Make ([0-9.]+)")
            if(CMAKE_MATCH_1 VERSION_LESS "4.0")
                set(previous "")
                if(EXISTS "${compiled_snapshot}")
                    file(READ "${compiled_snapshot}" previous)
                endif()
                if(NOT previous STREQUAL before)
                    file(WRITE "${rebuild_marker}" "Changed sources require a clean build with GNU Make before 4.0.\n")
                endif()
            endif()
        endif()
    endif()
endif()
set(rebuild_args)
if(EXISTS "${rebuild_marker}")
    list(APPEND rebuild_args --clean-first)
    set(SKIP_BUILD OFF)
endif()
set(built FALSE)
if(NOT JOBS)
    set(JOBS 4)
endif()
if(NOT JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "JOBS must be a positive integer")
endif()
if(NOT SKIP_BUILD)
    execute_process(COMMAND "${cmake}" -S "${source_dir}" -B "${build_dir}"
        -DCHIBI_DEVELOPMENT_RELOAD=ON RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Development configure failed")
    endif()
    string(JSON build_config ERROR_VARIABLE config_error GET "${config}" build_config)
    set(config_args)
    if(NOT config_error AND build_config)
        list(APPEND config_args --config "${build_config}")
    endif()
    execute_process(COMMAND "${cmake}" --build "${build_dir}" --target chibi chibi_dll
        ${config_args} ${rebuild_args} --parallel "${JOBS}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Development build failed")
    endif()
    file(REMOVE "${rebuild_marker}")
    set(built TRUE)
endif()
# Reconfiguration can change dependency roots and artifact paths.
file(READ "${DEV_CONFIG}" config)
chibi_source_snapshot(after resident_sources "${config}")
if(NOT before STREQUAL after)
    file(WRITE "${rebuild_marker}" "Sources changed during the previous build.\n")
    chibi_write_generated("${RESULT}" "{\"status\":\"stale\"}\n")
    return()
endif()
foreach(key application host)
    string(JSON ${key} GET "${config}" "${key}")
endforeach()
chibi_config_array(libraries "${config}" libraries)
set(resident "${resident_sources}\n")
foreach(path IN ITEMS "${host}" ${libraries})
    file(SHA256 "${path}" hash)
    get_filename_component(name "${path}" NAME)
    string(APPEND resident "${name}\n${hash}\n")
endforeach()
string(SHA256 resident "${resident}")
string(TIMESTAMP timestamp "%Y%m%d-%H%M%S" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(directory "${source_dir}/.chibi/generations/${timestamp}-${nonce}")
file(MAKE_DIRECTORY "${directory}")
get_filename_component(application_stem "${application}" NAME_WE)
get_filename_component(application_extension "${application}" LAST_EXT)
# DYLD_LIBRARY_PATH can override even absolute dlopen paths by basename.
# A distinct leaf name prevents lookup from finding an older staged module.
set(application_name "${application_stem}-${nonce}${application_extension}")
foreach(path IN ITEMS "${host}" "${application}" ${libraries})
    get_filename_component(name "${path}" NAME)
    if(path STREQUAL application)
        set(name "${application_name}")
    endif()
    execute_process(COMMAND "${cmake}" -E copy "${path}" "${directory}/${name}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        file(REMOVE_RECURSE "${directory}")
        message(FATAL_ERROR "Could not stage ${path}")
    endif()
    if(path STREQUAL application)
        continue()
    endif()
    file(REAL_PATH "${path}" real)
    get_filename_component(parent "${path}" DIRECTORY)
    get_filename_component(name "${path}" NAME)
    file(GLOB siblings "${parent}/*")
    foreach(sibling IN LISTS siblings)
        if(IS_SYMLINK "${sibling}")
            file(REAL_PATH "${sibling}" sibling_real)
            if(sibling_real STREQUAL real)
                get_filename_component(alias "${sibling}" NAME)
                if(NOT alias STREQUAL name)
                    file(CREATE_LINK "${name}" "${directory}/${alias}" SYMBOLIC RESULT result)
                    if(NOT result STREQUAL "0")
                        file(REMOVE_RECURSE "${directory}")
                        message(FATAL_ERROR "Could not stage library alias ${alias}")
                    endif()
                endif()
            endif()
        endif()
    endforeach()
endforeach()
# Do not publish outputs made from sources edited during artifact staging.
chibi_source_snapshot(final unused "${config}")
if(NOT final STREQUAL after)
    file(REMOVE_RECURSE "${directory}")
    file(WRITE "${rebuild_marker}" "Sources changed during the previous build.\n")
    chibi_write_generated("${RESULT}" "{\"status\":\"stale\"}\n")
    return()
endif()
if(built)
    chibi_write_generated("${compiled_snapshot}" "${after}")
endif()
get_filename_component(host_name "${host}" NAME)
set(application "${directory}/${application_name}")
set(host "${directory}/${host_name}")
file(REAL_PATH "${DEV_CONFIG}" config_path)
set(source_digest "${after}")
set(result "{\"status\":\"ready\"}")
foreach(key application host directory resident source_digest)
    chibi_json_string(value "${${key}}")
    string(JSON result SET "${result}" "${key}" "${value}")
endforeach()
chibi_json_string(value "${config_path}")
string(JSON result SET "${result}" config "${value}")
chibi_write_generated("${RESULT}" "${result}\n")
