package llvm_native_tests

import native "project:llvm_native"

import abi "project:native_abi"
import strings "core:strings"

Code :: (op: int, type: int, output: int, left: int, right: int, target: int, literal: int) -> native.Instruction {
    return {op: op, type: type, output: output, left: left, right: right, target: target, literal: literal};
}
Accepted :: (slots: int[], locals: int[], code: native.Instruction[]) -> bool {
    parameters: int[] = [];
    switch native.Emit(abi.LinuxX64(), parameters, 6, slots, locals, code, true, 64) {
        case .Rejected(instruction, message):
            return false;
        case .Emitted(text):
            return strings.Contains(text, "define i32 @main()") &&
                   !strings.Contains(text, "nsw") && !strings.Contains(text, "nuw");
    }
}

pub Tests :: () -> int {
    if (!ScalarBodyEmitsWithoutRuntime()) { return 1; }
    if (!InvalidTypesAndBranchesAreRejected()) { return 2; }
    if (!DefinitionMustDominateUse()) { return 3; }
    if (!CheckedArithmeticKeepsFailureEdges()) { return 4; }
    if (!BudgetIsExplicit()) { return 5; }
    return 0;
}
ScalarBodyEmitsWithoutRuntime :: () -> bool {
    locals: int[] = [];
    code := [Code(native.Constant, 6, 0, 0, 0, 0, 42), Code(native.Publish, 6, 0, 0, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0)];
    if (!Accepted([6], locals, code)) { return false; }
    code[0] = Code(native.Constant, 1, 0, 0, 0, 0, 2);
    if (Accepted([1], locals, code)) { return false; }
    return true;
}
InvalidTypesAndBranchesAreRejected :: () -> bool {
    locals: int[] = [];
    code := [Code(native.Constant, 6, 0, 0, 0, 0, 42), Code(native.Publish, 6, 0, 0, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0)];
    if (Accepted([13], locals, code)) { return false; }
    if (Accepted([9], locals, code)) { return false; }
    code[1] = Code(native.Jump, 0, 0, 0, 0, 3, 0);
    if (Accepted([6], locals, code)) { return false; }
    code[1] = Code(99, 0, 0, 0, 0, 0, 0);
    if (Accepted([6], locals, code)) { return false; }
    return true;
}
DefinitionMustDominateUse :: () -> bool {
    locals: int[] = [];
    code := [Code(native.Constant, 1, 0, 0, 0, 0, 1), Code(native.Branch, 0, 0, 0, 0, 3, 0),
             Code(native.Constant, 6, 1, 0, 0, 0, 42), Code(native.Publish, 6, 0, 1, 0, 0, 0),
             Code(native.Return, 0, 0, 0, 0, 0, 0)];
    if (Accepted([1, 6], locals, code)) { return false; }
    code[1] = Code(native.Branch, 0, 0, 0, 0, 2, 0);
    if (!Accepted([1, 6], locals, code)) { return false; }
    return true;
}
CheckedArithmeticKeepsFailureEdges :: () -> bool {
    operations := [native.Div, native.Mod, native.Shl, native.Shr];
    empty: int[] = [];
    for (op in operations) {
        code := [Code(native.Constant, 6, 0, 0, 0, 0, -2147483648), Code(native.Constant, 6, 1, 0, 0, 0, -1),
                 Code(op, 6, 2, 0, 1, 0, 0), Code(native.Return, 0, 0, 0, 0, 0, 0)];
        // The arithmetic result is deliberately unused. Failure is an effect.
        switch native.Emit(abi.LinuxX64(), empty, 6, [6, 6, 6], empty, code, true, 64) {
            case .Rejected(instruction, message):
                return false;
            case .Emitted(text):
                if (!strings.Contains(text, "label %trap")) { return false; }
                if (!strings.Contains(text, "call void @llvm.trap()")) { return false; }
                if (strings.Contains(text, "nsw") || strings.Contains(text, "nuw")) { return false; }
                if (op == native.Div || op == native.Mod) {
                    if (!strings.Contains(text, "br i1 %bad2, label %trap, label %safe2")) { return false; }
                    if (!strings.Contains(text, "safe2:\n")) { return false; }
                }
        }
    }
    return true;
}

BudgetIsExplicit :: () -> bool {
    empty: int[] = [];
    code := [Code(native.Check, 0, 0, 0, 0, 0, 0), Code(native.Return, 0, 0, 0, 0, 0, 0)];
    budgets: int[] = [0, -1];
    for (budget in budgets) {
        switch native.Emit(abi.LinuxX64(), empty, 6, empty, empty, code, true, budget) {
            case .Rejected(instruction, message):
                if (message == "") { return false; }
            case .Emitted(text):
                return false;
        }
    }
    switch native.Emit(abi.LinuxX64(), empty, 6, empty, empty, code, true, 1) {
        case .Rejected(instruction, message):
            return false;
        case .Emitted(text):
            return strings.Contains(text, "icmp sgt i32 %remaining0, 0") &&
                   strings.Contains(text, "sub i32 %remaining0, 1");
    }
}
