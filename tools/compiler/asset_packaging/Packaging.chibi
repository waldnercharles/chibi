package asset_packaging

import strings "core:strings"

Bytes :: (text: string) -> byte[] {
    result: byte[] = [];
    for (value in strings.Bytes(text)) { result.append(byte(value)); }
    return result;
}

// Only generated byte arrays carry source text. C never interprets authored
// syntax, and source snapshots keep their exact UTF-8 bytes and final zero.
pub Packaged :: (paths: string[], sources: string[]) -> byte[] {
    assert(length(paths) == length(sources));
    parts := ["#include \"authoring/asset_compiler_host.h\"\n#include \"asset_compiler_blob.inc\"\n"];
    index: int = 0;
    while (index < length(paths)) {
        parts.append(format_text("static const unsigned char asset_library_{}[] = {{", index));
        for (value in strings.Bytes(sources[index])) { parts.append(format_text("{},", value)); }
        parts.append("0};\n");
        index += 1;
    }
    parts.append("static const asset_source_library asset_libraries[] = {\n");
    index = 0;
    while (index < length(paths)) {
        path := paths[index];
        assert(strings.HasPrefix(path, "/sdk/core/") || strings.HasPrefix(path, "/sdk/game/"));
        assert(strings.ByteLength(path) > 10);
        for (value in strings.Bytes(path)) { assert(value >= 32 && value != 34 && value != 92); }
        parts.append(format_text("{{\"{}\", (const char *)asset_library_{}}},\n", path, index));
        index += 1;
    }
    parts.append("};\nstatic const asset_source_collection asset_collections[] = {\n{\"core\", \"/sdk/core\"}, {\"game\", \"/sdk/game\"}};\n");
    parts.append("const asset_compiler_options *asset_compiler_packaged_options() {\nstatic const asset_compiler_options options = {\n.compiler = asset_compiler_blob, .compiler_length = sizeof asset_compiler_blob,\n.libraries = asset_libraries, .library_count = sizeof asset_libraries / sizeof asset_libraries[0],\n.collections = asset_collections, .collection_count = 2\n};\nreturn &options;\n}\n");
    return Bytes(strings.Join(parts, ""));
}
