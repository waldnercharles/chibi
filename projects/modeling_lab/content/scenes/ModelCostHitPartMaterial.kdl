version 1
name "ModelCostHitPartMaterial"
(array)entities {
    - {
        name "Camera"
        prototype "StudyCamera"
        components {
            GameCamera width=600.0 height=400.0 focal_distance=0.0
            GameHRC2D adaptive=#false resolution=0.5 min_resolution=0.5 surface_relief=0.0 ambient=0.12
        }
    }
    - {
        name "Light"
        prototype "StudyLight"
        components {
            GameTransform x=-250.0 y=-145.0
        }
    }
    - {
        name "Matched material control"
        prototype "CostHitPartMaterial"
        components {
            GameTransform x=0.0 y=0.0
            GameVisualTransform scale=3.0 roll=0.75 yaw=0.2 pitch=-0.1
        }
    }
}
