package facts

// plain drops
@test
Calls :: () {
    a1_0: int = 3;
    r1: int = PlainPoint(a1_0);
    e1: int = 7;
    assert(r1 == e1, "PlainPoint call 1");
    a2_0: int = 2;
    r2: int = PlainLine(a2_0);
    e2: int = 4;
    assert(r2 == e2, "PlainLine call 2");
    a3_0: int = 2;
    r3: int = PlainDot(a3_0);
    e3: int = 2;
    assert(r3 == e3, "PlainDot call 3");
    a4_0: int = 4;
    r4: int = HeldBag(a4_0);
    e4: int = 2;
    assert(r4 == e4, "HeldBag call 4");
    a5_0: int = 4;
    r5: int = HeldArray(a5_0);
    e5: int = 1;
    assert(r5 == e5, "HeldArray call 5");
    a6_0: int = 4;
    r6: int = HeldExtend(a6_0);
    e6: int = 8;
    assert(r6 == e6, "HeldExtend call 6");
    a7_0: int = 4;
    r7: int = HeldPush(a7_0);
    e7: int = 5;
    assert(r7 == e7, "HeldPush call 7");
}
