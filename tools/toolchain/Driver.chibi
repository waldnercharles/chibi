package driver

import os "core:os"
import strings "core:strings"
import engine "graph:engine"
import files "graph:files"
import programs "graph:programs"
import paths "graph:install"

// The engine's one build command, `chibi build` in an engine checkout. It
// is compiled by the verified native seed and cached by tools/build.sh.
// Every authored build program runs natively; a failed compile stops the build.
//
//   build [--release|--debug|--profile NAME] [--build DIR] [--release-build DIR]
//         [--target NAME]... [--jobs N (default: every processor)]
//         [--debug-optimization 0|1]
//         [--debug-frame-pointers on|off] [--native-driver PATH --llvm DIR] [--dry-run]
//
// The default build directory is `build`; --release builds `build-release`
// and --debug `build-debug`. Without --target it builds the native compiler
// and asset service; --target names a graph subset. --dry-run prints the
// commands instead of running them. With --native-driver and --llvm the authored
// programs this starts run as native executables kept under .chibi/build-runner
// (see Runner). The other verbs are `test`, `install`,
// `format`, `clean`, `census`, `native-evidence` and `native-self-host`; Usage lists them.

Join :: (parts: string[]) -> string {
    return strings.Join(parts, "")
}

Flag :: (arguments: string[], name: string) -> bool {
    for (argument in arguments) {
        if (argument == name) {
            return true
        }
    }
    return false
}

Option :: (arguments: string[], name: string, fallback: string) -> string {
    for (i in 0..<length(arguments) - 1) {
        if (arguments[i] == name) {
            return arguments[i + 1]
        }
    }
    return fallback
}

Values :: (arguments: string[], name: string) -> string[] {
    values: string[] = []
    for (i in 0..<length(arguments) - 1) {
        if (arguments[i] == name) {
            values = extend(values, [arguments[i + 1]])
        }
    }
    return values
}

Absolute :: (path: string) -> string {
    normalized := path
    if (os.Platform() == "Windows") {
        normalized = strings.ReplaceAll(path, "\\", "/")
    }
    if (strings.HasPrefix(normalized, "/") || (os.Platform() == "Windows" && paths.IsAbsolute(normalized))) {
        return normalized
    }
    return Join([os.Root(), "/", normalized])
}

// Prints or runs one step and reports a failure under its name.
Step :: (name: string, command: string[], dry: bool) -> int {
    if (dry) {
        os.Print(Join([name, ": ", strings.Join(command, " ")]))
        return 0
    }
    status := os.Run(command)
    if (status != 0) {
        os.Print(format_text("{}: failed with status {}", name, status))
    }
    return status
}

Profile :: (arguments: string[]) -> string {
    named := Option(arguments, "--profile", "")
    if (named != "") {
        return named
    }
    if (Flag(arguments, "--release")) {
        return "release"
    }
    if (Flag(arguments, "--debug")) {
        return "debug"
    }
    return "sanitizer"
}

DefaultDirectory :: (profile: string) -> string {
    if (profile == "release") {
        return "build-release"
    }
    if (profile == "debug") {
        return "build-debug"
    }
    return "build"
}

Runner :: (arguments: string[], source: string, function: string, collections: string[]) -> string {
    return programs.Build(os.Root(), Option(arguments, "--native-driver", ""), Option(arguments, "--llvm", ""),
                          source, function, collections)
}

// A native command, or [] after Runner reports why it could not be built.
Program :: (arguments: string[], source: string, function: string, collections: string[]) -> string[] {
    runner := Runner(arguments, source, function, collections)
    if (runner == "") {
        empty: string[] = []
        return empty
    }
    return [runner]
}

// The --jobs a build runs its steps with: the option, else every processor
// online, from NUMBER_OF_PROCESSORS on Windows or getconf on POSIX. 8 when
// the platform cannot report a positive count.
Jobs :: (arguments: string[]) -> string {
    jobs := Option(arguments, "--jobs", "")
    if (jobs != "") {
        return jobs
    }
    count := ""
    if (os.Platform() == "Windows") {
        count = strings.TrimSpace(os.Getenv("NUMBER_OF_PROCESSORS"))
    } else {
        online := os.Capture(["getconf", "_NPROCESSORS_ONLN"])
        count = strings.TrimSpace(online.stdout)
        if (online.status != 0) { count = "" }
    }
    if (Count(count) < 1) {
        return "8"
    }
    return count
}

// Builds native products by default. Explicit C graph targets use their
// requested profile and the same native asset compiler service.
Build :: (arguments: string[]) -> int {
    dry := Flag(arguments, "--dry-run")
    profile := Profile(arguments)
    directory := Option(arguments, "--build", DefaultDirectory(profile))
    jobs := Jobs(arguments)
    targets := Values(arguments, "--target")
    if (length(targets) == 0) { targets = engine.NativeToolchain() }
    needs_archive := engine.NeedsThirdParty(targets)
    native_only := true
    native_archives := engine.NativeArchives()
    web_products := engine.WebAssemblyProducts()
    for (target in targets) {
        native_only = native_only && (length(engine.NativeArguments(target)) != 0 || native_archives.contains(target) || web_products.contains(target))
        for (resource in engine.Resources(target)) {
            needs_archive = needs_archive || strings.HasPrefix(strings.Partition(resource, "=").tail, "third-party/")
        }
    }
    status := 0
    if (needs_archive) {
        third_party := Program(arguments, "tools/toolchain/Build.chibi", "Build", [])
        if (length(third_party) == 0) { return 1 }
        command := extend(third_party, ["third-party", directory])
        if (native_only) { command.append("release") }
        status = Step("third-party", command, dry)
        if (status != 0) { return status }
    }
    graph := ["--build", Absolute(directory), "--profile", profile]
    for (name in ["--native-driver", "--llvm", "--emcc", "--wasm-llvm"]) {
        value := Option(arguments, name, "")
        if (value != "") {
            graph = extend(graph, [name, Absolute(value)])
        }
    }
    for (name in ["--debug-optimization", "--debug-frame-pointers"]) {
        value := Option(arguments, name, "")
        if (value != "" && profile != "release") {
            graph = extend(graph, [name, value])
        }
    }
    graph = extend(graph, ["--jobs", jobs])
    graph = extend(graph, ["--all-commands", "on"])
    // Targets have one authority in the authored engine graph.
    for (target in targets) {
        graph = extend(graph, ["--target", target])
    }
    program := Program(arguments, "tools/toolchain/Graph.chibi", "Libraries", ["graph=tools/graph"])
    if (length(program) == 0) {
        return 1
    }
    command := extend(program, graph)
    if (os.Platform() != "Windows" || !native_only) {
        command = extend(["env", Join(["CCACHE_BASEDIR=", os.Root()])], command)
    }
    status = Step("graph", command, dry)
    if (status != 0) {
        return status
    }
    if (os.Platform() == "Windows" && native_only) { return 0 }
    return Step("compile-commands", ["ln", "-sfn", Join([Absolute(directory), "/compile_commands.json"]), "compile_commands.json"], dry)
}

// Verifies that the build in --build ran with the profile CI selected and keeps
// the receipt and the evidence it checked in --output.
NativeEvidence :: (arguments: string[]) -> int {
    dry := Flag(arguments, "--dry-run")
    tail := ["--build", Absolute(Option(arguments, "--build", "build")), "--output", Absolute(Option(arguments, "--output", "native-profile"))]
    tail = extend(tail, ["--nm", Option(arguments, "--nm", "nm")])
    for (name in ["--sha", "--run", "--attempt", "--job", "--outcome"]) {
        tail = extend(tail, [name, Option(arguments, name, "")])
    }
    return GraphStep(arguments, "native-evidence", "tools/toolchain/Evidence.chibi", "Capture", tail, dry)
}

// A tab separated row split into fields; empty fields are kept.
Fields :: (row: string) -> string[] {
    fields: string[] = []
    rest := row
    while (true) {
        head := strings.Partition(rest, "\t").head
        fields = extend(fields, [head])
        if (head == rest) {
            return fields
        }
        rest = strings.Partition(rest, "\t").tail
    }
    return fields
}

// The selector table's rows: `tool NAME COMMAND...` and `group NAME MEMBER...`.
Rows :: () -> string[] {
    rows: string[] = []
    table := os.ReadText("tools/tests.tsv")
    if (table.error) {
        os.Print("test: cannot read tools/tests.tsv")
        return rows
    }
    for (line in strings.Lines(table.text)) {
        if (line != "" && !strings.HasPrefix(line, "#")) {
            rows = extend(rows, [line])
        }
    }
    return rows
}

Row :: (rows: string[], kind: string, name: string) -> string {
    prefix := Join([kind, "\t", name])
    for (row in rows) {
        if (row == prefix || strings.HasPrefix(row, Join([prefix, "\t"]))) {
            return row
        }
    }
    return ""
}

// The tool selectors a command line names, groups expanded, or [] and a
// report when one is unknown.
Selection :: (rows: string[], requested: string[]) -> string[] {
    selected: string[] = []
    for (name in requested) {
        group := Row(rows, "group", name)
        if (group != "") {
            members := Fields(group)
            for (i in 2..<length(members)) {
                selected = extend(selected, [members[i]])
            }
        } else if (Row(rows, "tool", name) != "") {
            selected = extend(selected, [name])
        } else {
            os.Print(format_text("test: unknown selector '{}'; use --list", name))
            none: string[] = []
            return none
        }
    }
    return selected
}

// The arguments after `build test` that are neither options nor option values.
Positionals :: (arguments: string[]) -> string[] {
    names: string[] = []
    skip := false
    for (i in 2..<length(arguments)) {
        argument := arguments[i]
        if (skip) {
            skip = false
        } else if (argument == "--build" || argument == "--release-build" || argument == "--jobs" ||
            argument == "--timeout" || argument == "--native-driver" || argument == "--llvm") {
            skip = true
        } else if (!strings.HasPrefix(argument, "--")) {
            names = extend(names, [argument])
        }
    }
    return names
}

Count :: (text: string) -> int {
    value := 0
    for (byte in strings.Bytes(text)) {
        if (byte < 48 || byte > 57 || value > 10000) {
            return -1
        }
        value = value * 10 + byte - 48
    }
    return value
}

// The deadline of one selector: its `timeout NAME SECONDS` row, else `fallback`.
Deadline :: (rows: string[], name: string, fallback: string) -> string {
    row := Row(rows, "timeout", name)
    if (row == "") {
        return fallback
    }
    return Fields(row)[2]
}

// The command one selector runs: its row's words with the build directories
// filled in; each row owns any environment its program needs.
TestCommand :: (row: string, directory: string, releases: string, native: string, llvm: string, prepared: string, current: string) -> string[] {
    fields := Fields(row)
    build_directory := Absolute(directory)
    release_directory := Absolute(releases)
    native_path := Absolute(native)
    llvm_directory := Absolute(llvm)
    root := os.Root()
    command: string[] = []
    first := 2
    if (length(fields) >= 5 && fields[2] == "@program@") {
        if (prepared == "") {
            preview := programs.Command(root, Absolute(current), llvm_directory, fields[3], fields[4], ["graph=tools/graph"],
                                        programs.HostTriple(), "<cached-native-program>")
            command.extend(preview)
            command.extend(["&&", "<cached-native-program>"])
        } else {
            command.append(prepared)
        }
        first = 5
    }
    for (i in first..<length(fields)) {
        word := strings.ReplaceAll(fields[i], "@root@", root)
        word = strings.ReplaceAll(strings.ReplaceAll(word, "@build@", build_directory), "@release@", release_directory)
        word = strings.ReplaceAll(strings.ReplaceAll(word, "@native@", native_path), "@llvm@", llvm_directory)
        word = strings.ReplaceAll(word, "@compiler@", Absolute(current))
        command = extend(command, [word])
    }
    return command
}

// A selector `build test` has started and not yet reported.
Running :: struct {
    index: int; // into the selection
    process: int;
    // Milliseconds spent waiting while it ran: a lower bound on its age.
    waited: int;
}

// How long `build test` waits on its oldest selector before polling the rest.
TestSlice: int : 250

// Whether tools/tests.tsv has an `exclusive NAME` row: the selector runs alone,
// because it starts its own workers or shares files with others.
Exclusive :: (rows: string[], name: string) -> bool {
    return Row(rows, "exclusive", name) != ""
}

// Runs the named selectors or groups of tools/tests.tsv against the built test
// drivers, up to --jobs at a time (an `exclusive` row runs one alone), and fails
// when any fails.
//   build test [--build DIR] [--release-build DIR] [--jobs N] [--timeout SECONDS] [--list] [--dry-run] NAME...
// Each selector gets --timeout seconds (600 by default; a `timeout NAME SECONDS` row of tools/tests.tsv sets one selector's); a hung one is killed
// and reported as timed out, and the rest still run.
Test :: (arguments: string[]) -> int {
    rows := Rows()
    if (Flag(arguments, "--list")) {
        for (row in rows) {
            fields := Fields(row)
            os.Print(Join([fields[0], " ", fields[1]]))
        }
        return 0
    }
    directory := Option(arguments, "--build", "build")
    releases := Option(arguments, "--release-build", "build-release")
    native := Option(arguments, "--native-driver", "")
    llvm := Option(arguments, "--llvm", "")
    jobs := Count(Option(arguments, "--jobs", "1"))
    seconds := Option(arguments, "--timeout", "600")
    if (Count(seconds) < 1) {
        os.Print("test: --timeout takes a whole number of seconds")
        return 2
    }
    requested := Positionals(arguments)
    if (jobs < 1 || length(requested) == 0) {
        os.Print("usage: build test [--build DIR] [--release-build DIR] [--jobs N] [--list] [--dry-run] NAME...")
        return 2
    }
    selected := Selection(rows, requested)
    if (length(selected) == 0) {
        return 2
    }
    // Native rows fail closed before any selector starts. Dry-run accepts
    // proposed paths so its exact commands remain reviewable.
    needs_native := false
    needs_current := false
    for (name in selected) {
        row := Row(rows, "tool", name)
        fields := Fields(row)
        if (length(fields) > 2 && fields[2] == "@program@") {
            if (length(fields) < 5 || fields[3] == "" || fields[4] == "") {
                os.Print(Join(["test: malformed native program selector ", name]))
                return 2
            }
        }
        needs_current = needs_current || strings.Contains(row, "@program@") || strings.Contains(row, "@compiler@")
        needs_native = needs_native || strings.Contains(row, "@native@") || strings.Contains(row, "@program@") || strings.Contains(row, "@compiler@")
    }
    needs_llvm := needs_native
    for (name in selected) { needs_llvm = needs_llvm || strings.Contains(Row(rows, "tool", name), "@llvm@") }
    if (!Flag(arguments, "--dry-run")) {
        if (needs_native) { native = os.RealPath(native) }
        if (needs_llvm) { llvm = os.RealPath(llvm) }
        if (needs_native && (native == "" || !os.IsFile(native))) {
            os.Print("test: native selectors need --native-driver PROGRAM")
            return 2
        }
        if (needs_llvm && (llvm == "" || !os.IsDirectory(llvm))) {
            os.Print("test: LLVM selectors need --llvm DIR")
            return 2
        }
    }
    if (Flag(arguments, "--dry-run")) {
        preview_compiler := native
        if (needs_current) {
            preview_compiler = Absolute(".chibi/build-runner/<compiler-key>/chibi")
            plan := programs.CompilerCommand(os.Root(), Absolute(native), Absolute(llvm), preview_compiler)
            os.Print(Join(["native compiler (cached): ", strings.Join(plan, " ")]))
        }
        for (name in selected) {
            command := TestCommand(Row(rows, "tool", name), directory, releases, native, llvm, "", preview_compiler)
            os.Print(format_text("{} ({}s): {}", name, Deadline(rows, name, seconds), strings.Join(command, " ")))
        }
        return 0
    }
    // Compile before any selector starts, so compilation cannot delay polling
    // already-running selectors or consume one selector's execution deadline.
    current := native
    if (needs_current) {
        current = programs.Compiler(os.Root(), native, llvm)
        if (current == "") { return 1 }
    }
    prepared: string[] = []
    for (name in selected) {
        fields := Fields(Row(rows, "tool", name))
        program := ""
        if (length(fields) > 2 && fields[2] == "@program@") {
            program = programs.Build(os.Root(), current, llvm, fields[3], fields[4], ["graph=tools/graph"])
            if (program == "") {
                os.Print(Join(["test: native program selector does not compile: ", name]))
                return 1
            }
        }
        prepared.append(program)
    }
    // Piped output keeps each selector's lines together when several run.
    stdio := os.Inherited
    if (jobs > 1) {
        stdio = os.Piped
    }
    running: Running[] = []
    // Selectors start in order, but one that must run alone waits for the
    // pool to drain while later ones fill free slots, so it never leaves the
    // other jobs idle behind a long selector.
    started: bool[] = []
    while (length(started) < length(selected)) {
        started = extend(started, [false])
    }
    remaining := length(selected)
    failed := 0
    while (remaining > 0 || length(running) > 0) {
        while (remaining > 0 && length(running) < jobs &&
               (length(running) == 0 || !Exclusive(rows, selected[running[0].index]))) {
            next := -1
            for (i in 0..<length(selected)) {
                if (next < 0 && !started[i] && (length(running) == 0 || !Exclusive(rows, selected[i]))) {
                    next = i
                }
            }
            if (next < 0) {
                break
            }
            os.Print(format_text("RUN {}", selected[next]))
            command := TestCommand(Row(rows, "tool", selected[next]), directory, releases, native, llvm, prepared[next], current)
            job: Running = {index: next, process: os.Start(command, stdio), waited: 0}
            running.append(job)
            started[next] = true
            remaining -= 1
        }
        // Wait a slice for the oldest, then poll the rest, so a short selector
        // frees its slot while a long one runs. Only a slice that passes in
        // full counts toward the running deadlines, so none stops early.
        status := os.Wait(running[0].process, TestSlice)
        passed := 0
        if (status == os.StillRunning) {
            passed = TestSlice
        }
        left: Running[] = []
        for (i in 0..<length(running)) {
            job := running[i]
            if (i > 0) {
                status = os.Wait(job.process, 0)
            }
            job.waited += passed
            name := selected[job.index]
            limit := Count(Deadline(rows, name, seconds))
            if (status == os.StillRunning && job.waited >= limit * 1000) {
                os.Kill(job.process)
                os.Print(format_text("FAIL {} (timed out after {}s)", name, limit))
                failed += 1
            } else if (status == os.StillRunning) {
                left.append(job)
            } else if (status == 0) {
                os.Print(format_text("PASS {}", name))
            } else {
                os.Print(format_text("FAIL {} (status {})", name, status))
                failed += 1
            }
        }
        running = left
    }
    os.Print(format_text("{} tests, {} failed", length(selected), failed))
    if (failed > 0) {
        return 1
    }
    return 0
}

// Runs an authored graph program natively. POSIX worktrees share C compiler
// cache objects through CCACHE_BASEDIR; native Windows programs need no env tool.
GraphStep :: (arguments: string[], name: string, source: string, function: string, tail: string[], dry: bool) -> int {
    program := Program(arguments, source, function, ["graph=tools/graph"])
    if (length(program) == 0) {
        return 1
    }
    command := extend(program, tail)
    if (os.Platform() != "Windows") {
        command = extend(["env", Join(["CCACHE_BASEDIR=", os.Root()])], command)
    }
    return Step(name, command, dry)
}

// The Release products an install or a release-only verb needs.
ReleaseBuild :: (arguments: string[], targets: string[], dry: bool) -> int {
    nested := ["--release", "--release-build", Option(arguments, "--release-build", "build-release"),
               "--build", Option(arguments, "--release-build", "build-release"),
               "--jobs", Jobs(arguments)]
    for (name in ["--native-driver", "--llvm", "--emcc", "--wasm-llvm"]) {
        value := Option(arguments, name, "")
        if (value != "") {
            nested = extend(nested, [name, value])
        }
    }
    for (target in targets) {
        nested = extend(nested, ["--target", target])
    }
    if (dry) {
        nested = extend(nested, ["--dry-run"])
    }
    return Build(nested)
}

// Installs the Release products into --prefix (default ~/.local):
// bin/chibi, its compiler alias, the native asset service and authored resources.
Install :: (arguments: string[]) -> int {
    dry := Flag(arguments, "--dry-run")
    releases := Absolute(Option(arguments, "--release-build", "build-release"))
    targets := engine.NativeToolchain()
    with_wasm := Flag(arguments, "--with-wasm")
    if (with_wasm) { targets = extend(targets, engine.WebAssemblyProducts()) }
    status := ReleaseBuild(arguments, targets, dry)
    if (status != 0) {
        return status
    }
    prefix := Absolute(Option(arguments, "--prefix", Join([os.Getenv("HOME"), "/.local"])))
    installed := ["--build", releases, "--prefix", prefix]
    if (with_wasm) { installed.append("--with-wasm") }
    return GraphStep(
        arguments, "install", "tools/toolchain/SDK.chibi", "Install",
        installed, dry
    )
}

// Whole seconds from date(1); the build host has no clock.
Clock :: () -> int {
    seconds := 0
    for (byte in strings.Bytes(strings.TrimSpace(os.Capture(["date", "+%s"]).stdout))) {
        seconds = seconds * 10 + byte - 48
    }
    return seconds
}

// The program the native build driver's last `native: PATH` report names, or "".
NativeProgram :: (report: string) -> string {
    program := ""
    for (line in strings.Lines(report)) {
        if (strings.HasPrefix(line, "native: /")) {
            program = strings.TrimSuffix(strings.TrimPrefix(line, "native: "), " is up to date")
        }
    }
    return program
}

// The file's SHA-256, or "" when it cannot be read.
Digest :: (path: string) -> string {
    hashed := os.HashFile(path)
    if (hashed.error) {
        return ""
    }
    return hashed.digest
}

// The name of the program a stage writes for `target`.
StageProgram :: (target: string) -> string {
    if (strings.HasPrefix(target, "x86_64-pc-windows")) {
        return "/chibi.exe"
    }
    return "/chibi"
}

// Runs one stage compiler in a clean directory and prints its wall time.
// The stage contract (docs/native-llvm-ledger.md, W22): `STAGE --compiler DIR
// --core DIR --output FILE --llvm DIR` writes a native executable with the same
// interface; exit 1 means the native lane rejected the sources, and the first
// stderr line then names the first rejected function.
NativeStage :: (name: string, stage: string, directory: string, llvm: string, target: string, dry: bool) -> int {
    status := Step(name, ["sh", "-c", Join(["rm -rf '", directory, "' && mkdir -p '", directory, "'"])], dry)
    if (status != 0) {
        return status
    }
    command := [stage, "--compiler", Absolute("tools/compiler"), "--core", Absolute("packages/core"), "--output", Join([directory, StageProgram(target)]), "--llvm", llvm, "--target", target]
    began := Clock()
    if (dry) {
        return Step(name, command, dry)
    }
    ran := os.Capture(command)
    os.Print(format_text("{}: {} s, exit {}", name, Clock() - began, ran.status))
    if (ran.status != 0) {
        os.Print(Join([name, " rejected: ", strings.TrimSpace(ran.stderr)]))
    }
    return ran.status
}

// The fixed compiler proves exact Driver streams and complete Graph command
// tables against independent fixtures. Failures retain the contract's status.
NativeRunner :: (stage: string, llvm: string) -> int {
    contract := programs.Build(os.Root(), stage, llvm, "test/graph/CommandTests.chibi", "Run", ["graph=tools/graph"])
    if (contract == "") {
        return 1
    }
    return Step("native command contract", [contract, stage, llvm], false)
}

// The FreeType sample (test/compiler/samples/native/foreign_vendor) as a program: the @test mark
// goes and Calls returns 0, since a program's functions have a result.
VendorProgram :: (sample: string) -> string {
    lines: string[] = []
    for (line in strings.SplitLines(sample)) {
        if (line != "@test") {
            lines = extend(lines, [line])
        }
    }
    last := length(lines) - 1
    while (last > 0 && lines[last] != "}") {
        last = last - 1
    }
    text := ""
    for (index in 0..<length(lines)) {
        if (index == last) {
            text = Join([text, "    return 0\n}\n"])
        } else if (lines[index] == "Calls :: () {") {
            text = Join([text, "Calls :: () -> int {\n"])
        } else {
            text = Join([text, lines[index], "\n"])
        }
    }
    return text
}

// Links the `vendor:` FreeType program against the prebuilt archives and runs it, with the native
// driver and LLVM tools, without a build host or compiler host. The SDK
// layout the driver reads vendored archives from (share/chibi/core beside lib/chibi-vendor) is
// staged in --work from the checkout's core and the pinned third-party archive.
NativeVendorSample :: (arguments: string[]) -> int {
    dry := Flag(arguments, "--dry-run")
    llvm := Option(arguments, "--llvm", "")
    compiler := Option(arguments, "--native-driver", "")
    work := Absolute(Option(arguments, "--work", "build-native-vendor-sample"))
    if (llvm == "" || compiler == "") {
        os.Print("native-vendor-sample: pass --llvm DIR and --native-driver PROGRAM")
        return 2
    }
    target := "x86_64-unknown-linux-gnu"
    if (os.Platform() == "Darwin") {
        target = "aarch64-apple-darwin"
    }
    sdk := Join([work, "/sdk"])
    project := Join([work, "/project"])
    sample := Join([project, "/foreign_vendor/facts"])
    command := [compiler, "--compiler", Absolute("tools/compiler"), "--core", Join([sdk, "/share/chibi/core"]),
                "--root", project, "--entry", "Main", "--llvm", llvm, "--target", target]
    if (dry) {
        os.Print(Join(["native-vendor-sample: stage ", sdk, " and ", project]))
        return Step("native-build", command, dry)
    }
    if (Step("stage", ["rm", "-rf", work], false) != 0 ||
        Step("stage", ["mkdir", "-p", Join([sdk, "/share/chibi"]), Join([sdk, "/lib"]), sample], false) != 0) {
        return 1
    }
    vendor := Program(arguments, "tools/toolchain/Build.chibi", "Build", [])
    if (length(vendor) == 0) {
        return 1
    }
    vendored := os.Capture(extend(vendor, ["vendor", Join([work, "/third-party"])]))
    // A program's reports are its standard error.
    folder := ""
    for (line in strings.SplitLines(vendored.stderr)) {
        if (strings.HasPrefix(line, "/")) {
            folder = strings.TrimSpace(line)
        }
    }
    if (vendored.status != 0 || folder == "") {
        os.Print(format_text("native-vendor-sample: no vendored libraries (status {}, folder '{}'): {}{}", vendored.status, folder, strings.TrimSpace(vendored.stdout), strings.TrimSpace(vendored.stderr)))
        return 1
    }
    if (Step("stage", ["ln", "-s", Absolute("packages/core"), Join([sdk, "/share/chibi/core"])], false) != 0 ||
        Step("stage", ["ln", "-s", folder, Join([sdk, "/lib/chibi-vendor"])], false) != 0 ||
        Step("stage", ["ln", "-s", Absolute("third_party/fonts/inter/Inter.ttf"), Join([project, "/Inter.ttf"])], false) != 0) {
        return 1
    }
    text := os.ReadText(Absolute("test/compiler/samples/native/foreign_vendor/facts/SampleTests.chibi"))
    if (text.error) {
        os.Print("native-vendor-sample: cannot read the foreign_vendor sample")
        return 1
    }
    if (os.WriteText(Join([sample, "/Sample.chibi"]), VendorProgram(text.text)) != nil ||
        os.WriteText(Join([sample, "/Native.chibi"]), "package facts\npub Native :: () -> int {\n    return Calls()\n}\n") != nil ||
        os.WriteText(Join([project, "/Main.chibi"]), "package main\nimport facts \"project:foreign_vendor/facts\"\nMain :: () -> int {\n    return facts.Native()\n}\n") != nil) {
        os.Print("native-vendor-sample: cannot write the project")
        return 1
    }
    began := Clock()
    built := os.Capture(command)
    os.Print(format_text("native-vendor-sample: build {} s, exit {}", Clock() - began, built.status))
    program := NativeProgram(built.stderr)
    if (built.status != 0 || program == "") {
        os.Print(Join(["native-vendor-sample: the build failed: ", strings.TrimSpace(built.stderr)]))
        return 1
    }
    receipt := os.ReadText(Join([strings.Slice(program, 0, strings.LastIndex(program, "/")), "/receipt.txt"]))
    if (receipt.error || !strings.Contains(receipt.text, "libchibi_vendor_freetype.a")) {
        os.Print("native-vendor-sample: the receipt does not record the vendored archive")
        return 1
    }
    ran := Step("run", ["sh", "-c", Join(["cd '", project, "' && '", program, "'"])], false)
    if (ran != 0) {
        os.Print("native-vendor-sample: the program failed")
        return 1
    }
    os.Print("native-vendor-sample: the FreeType program linked the vendored archive and ran")
    return 0
}

// The selected native compiler builds stages two and three. A mismatched old
// seed gets one additional generation, which must match stage three exactly.
// Prints each stage's wall time; --stage-one explicitly selects another seed.
NativeSelfHost :: (arguments: string[]) -> int {
    dry := Flag(arguments, "--dry-run")
    llvm := Option(arguments, "--llvm", "")
    work := Absolute(Option(arguments, "--work", "build-native-self-host"))
    if (llvm == "") {
        os.Print("native-self-host: pass --llvm DIR, the folder of opt, llc and ld.lld")
        return 2
    }
    prebuilt := Option(arguments, "--stage-one", Option(arguments, "--native-driver", ""))
    if (prebuilt == "") {
        os.Print("native-self-host: pass --stage-one PROGRAM or --native-driver PROGRAM")
        return 2
    }
    target := "x86_64-unknown-linux-gnu"
    if (os.Platform() == "Darwin") {
        target = "aarch64-apple-darwin"
    }
    stage_one := Absolute(prebuilt)
    two := Join([work, "/stage2"])
    three := Join([work, "/stage3"])
    status := NativeStage("stage-two", stage_one, two, llvm, target, dry)
    if (status != 0) {
        return status
    }
    if (Flag(arguments, "--stage-two-only")) {
        os.Print("native-self-host: stage two built")
        return 0
    }
    status = NativeStage("stage-three", Join([two, "/chibi"]), three, llvm, target, dry)
    if (status != 0) {
        return status
    }
    fixed := Join([two, "/chibi"])
    proof := "stage two and stage three are byte-identical"
    if (!dry) {
        digest_two := Digest(Join([two, "/chibi"]))
        digest_three := Digest(Join([three, "/chibi"]))
        os.Print(Join(["stage two sha256 ", digest_two]))
        os.Print(Join(["stage three sha256 ", digest_three]))
        if (digest_two == "" || digest_three == "") {
            os.Print("native-self-host: stage two and stage three differ")
            return 1
        }
        // A prebuilt stage one, such as the pinned native seed, may be an older
        // compiler: its stage two then differs from the stage three the current
        // compiler gives, and the fixed point is stage three, which stage four
        // must reproduce.
        if (digest_two != digest_three) {
            four := Join([work, "/stage4"])
            status = NativeStage("stage-four", Join([three, "/chibi"]), four, llvm, target, dry)
            if (status != 0) {
                return status
            }
            digest_four := Digest(Join([four, "/chibi"]))
            os.Print(Join(["stage four sha256 ", digest_four]))
            if (digest_four == "" || digest_four != digest_three) {
                os.Print("native-self-host: stage three and stage four differ")
                return 1
            }
            fixed = Join([three, "/chibi"])
            proof = "stage three and stage four are byte-identical"
        }
        os.Print(Join(["native-self-host: the fixed point is ", fixed]))
    }
    // Goal item 8: stage two, cross-linked for Windows with lld-link and the import
    // libraries. The windows-2022 job runs it to build stage three, then stage four,
    // and requires the two to match; each is built there by the one LLVM that
    // job installs, so the digests are comparable where stage two's is not.
    windows := Option(arguments, "--windows", "")
    if (windows != "") {
        folder := Absolute(windows)
        status = NativeStage("stage-two-windows", Join([two, "/chibi"]), folder, llvm, "x86_64-pc-windows-msvc", dry)
        if (status != 0) {
            return status
        }
        if (!dry) {
            os.Print(Join(["stage two windows sha256 ", Digest(Join([folder, StageProgram("x86_64-pc-windows-msvc")]))]))
        }
    }
    if (!dry) {
        status = NativeRunner(fixed, llvm)
        if (status != 0) { return status }
    }
    if (!dry) {
        os.Print(Join(["native-self-host: ", proof]))
    }
    return 0
}

// Whether a registered worktree lives under `directory`.
HoldsWorktree :: (directory: string) -> bool {
    listed := os.Capture(["git", "worktree", "list", "--porcelain"])
    for (line in strings.Lines(listed.stdout)) {
        if (strings.HasPrefix(line, "worktree ") && strings.HasPrefix(strings.Partition(line, "worktree ").tail, Join([directory, "/"]))) {
            return true
        }
    }
    return false
}

// Removes the build outputs, except a build directory that holds a worktree.
Clean :: (arguments: string[]) -> int {
    for (name in [Option(arguments, "--build", "build"), "build-debug", Option(arguments, "--release-build", "build-release")]) {
        directory := Absolute(name)
        if (HoldsWorktree(directory)) {
            os.Print(Join(["Skipping ", directory, ": it contains a registered worktree"]))
        } else {
            Step("clean", ["rm", "-rf", "--", directory], Flag(arguments, "--dry-run"))
        }
    }
    return 0
}

// Consumer build adapters and test controllers are allowed. Only the retired
// repository build/recovery entries fail the census; a file suffix cannot tell
// an SDK interface or foreign-code fixture from the engine's build system.
RetiredBuildEntry :: (path: string) -> bool {
    if (path == "test/native_aot/asset_compiler/wasm_sdk/CMakeLists.txt") { return false }
    name := strings.BaseName(path)
    if (name == "CMakeLists.txt" || name == "Makefile" || name == "GNUmakefile" ||
        strings.HasPrefix(path, "cmake/")) { return true }
    return path == "tools/build.py" || path == "tools/test_policy.py" ||
           path == "tools/bootstrap/seed.sh" || path == "tools/bootstrap/seed.tsv" ||
           path == "tools/bootstrap/publish-seed.sh" || path == "tools/compiler/runtime.json"
}

// Goal items 3 and 4 as numbers over the tracked files outside archive/ and
// third_party/: it fails on retired build/recovery entries, and prints the
// first-party C and the C++/Objective-C shims that remain, with line counts.
Census :: () -> int {
    listed := os.Capture(["git", "-C", os.Root(), "ls-files"])
    if (listed.status != 0) {
        os.Print("census: git ls-files failed")
        return 1
    }
    banned: string[] = []
    shims: string[] = []
    c_files := 0
    c_lines := 0
    for (path in strings.SplitLines(listed.stdout)) {
        if (strings.HasPrefix(path, "archive/") || strings.HasPrefix(path, "third_party/")) {
            continue
        }
        if (RetiredBuildEntry(path)) {
            banned.append(path)
            continue
        }
        is_c := strings.HasSuffix(path, ".c") || strings.HasSuffix(path, ".h")
        is_shim := false
        for (suffix in [".cpp", ".cc", ".cxx", ".hpp", ".m", ".mm"]) {
            is_shim = is_shim || strings.HasSuffix(path, suffix)
        }
        if (!is_c && !is_shim) {
            continue
        }
        read := os.ReadText(Absolute(path))
        lines := 0
        if (!read.error) {
            lines = strings.Count(read.text, "\n")
        }
        if (is_c) {
            c_files = c_files + 1
            c_lines = c_lines + lines
        } else {
            shims.append(format_text("{} {}", lines, path))
        }
    }
    for (path in banned) {
        os.Print(Join(["census: build tooling outside archive/: ", path]))
    }
    for (shim in shims) {
        os.Print(Join(["census: shim ", shim]))
    }
    os.Print(format_text("census: {} first-party C files, {} lines, {} C++/Objective-C shims, {} build tooling files", c_files, c_lines, length(shims), length(banned)))
    if (length(banned) > 0) {
        return 1
    }
    return 0
}

Usage :: () -> int {
    os.Print("usage: build [--release|--debug|--profile NAME] [--build DIR] [--target NAME]... [--jobs N] [--dry-run]")
    os.Print("       build test [--build DIR] [--release-build DIR] [--jobs N] [--timeout SECONDS] [--list] [--dry-run] NAME...")
    os.Print("       build install [--prefix DIR] [--release-build DIR]")
    os.Print("       build format [--check] | clean | census | native-evidence --build DIR --output DIR --nm PATH --sha SHA ...")
    os.Print("       build native-self-host --llvm DIR [--stage-one PROGRAM] [--windows DIR] [--work DIR] [--stage-two-only] [--dry-run]")
    os.Print("       build native-vendor-sample --llvm DIR --native-driver PROGRAM [--work DIR] [--dry-run]")
    return 2
}

Main :: () -> int {
    arguments := os.Arguments()
    if (length(arguments) == 0 || arguments[0] != "build") {
        return Usage()
    }
    verb := ""
    if (length(arguments) > 1 && !strings.HasPrefix(arguments[1], "--")) {
        verb = arguments[1]
    }
    dry := Flag(arguments, "--dry-run")
    if (verb == "test") {
        return Test(arguments)
    }
    if (verb == "install") {
        return Install(arguments)
    }
    if (verb == "format") {
        check: string[] = []
        if (Flag(arguments, "--check")) {
            check = ["--check"]
        }
        return Step("format", extend(["sh", "tools/clang-format.sh"], check), dry)
    }
    if (verb == "clean") {
        return Clean(arguments)
    }
    if (verb == "native-evidence") {
        return NativeEvidence(arguments)
    }
    if (verb == "census") {
        return Census()
    }
    if (verb == "native-vendor-sample") {
        return NativeVendorSample(arguments)
    }
    if (verb == "native-self-host") {
        return NativeSelfHost(arguments)
    }
    if (verb != "") {
        return Usage()
    }
    return Build(arguments)
}
