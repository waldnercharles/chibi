package scalar
foreign import libc "system:c"
foreign libc {
    dlsym :: (handle: rawptr, name: cstring) -> rawptr
}
Main :: () -> int {
    name := text_slice("xabsx", 1, 3);
    absolute: fn(n: i32) -> i32 = dlsym(0, name);
    other: fn(n: i32) -> i32 = dlsym(0, "abs");
    return absolute(-42) + other(-1);
}
