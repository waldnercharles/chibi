+    behavior_function_release_host(&context);
+    behavior_function_activation_free(&activation);
+    context = (behavior_function_context){ 0 };
+    activation = (behavior_function_activation){ 0 };
+    behavior_managed_heap_free(&managed);
+    arena_free(&storage);
+}
