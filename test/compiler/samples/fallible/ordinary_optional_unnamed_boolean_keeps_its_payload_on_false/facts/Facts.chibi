package facts
Flag :: (value: bool, absent: bool) -> bool? { if absent { return nil; } return value; }
TakeBool :: (value: bool) -> int { if value { return 99; } return 17; }
Use :: (value: bool, absent: bool) -> int { error := Flag(value, absent); if error { if error { return 99; } else { return TakeBool(error); } } return 0; }
