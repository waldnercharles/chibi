package facts

// forwarded callbacks preserve sequence values
@test
Calls :: () {
    a1_0: int[] = [1, 2, 3];
    r1: int = ReadNamed(a1_0);
    e1: int = 3;
    assert(r1 == e1, "ReadNamed call 1");
    a2_0: int[] = [];
    r2: int = ReadNamed(a2_0);
    e2: int = 0;
    assert(r2 == e2, "ReadNamed call 2");
    a3_0: int[] = [1, 2];
    r3: int = ReadInline(a3_0);
    e3: int = 2;
    assert(r3 == e3, "ReadInline call 3");
    a4_0: int[] = [];
    r4: int = ReadInline(a4_0);
    e4: int = 0;
    assert(r4 == e4, "ReadInline call 4");
    r5: int = CopiedNamed();
    e5: int = 1273;
    assert(r5 == e5, "CopiedNamed call 5");
    r6: int = CopiedInline();
    e6: int = 1283;
    assert(r6 == e6, "CopiedInline call 6");
}
