behavior InputProbe {
    on Input {
        self.Transform += Direction
        if input.Shoot.held {
            self.Aim.firing = true
        }
        if input.Shoot.pressed {
            self.Aim.firing = true
        }
    }
    on Fire {
        self.Aim.firing = true
    }
    on Dash {
        self.Aim.firing = false
    }
}
