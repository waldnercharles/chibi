version 1
name "ModelBooleanStudy"
(array)entities {
    - {
        name "Camera"
        prototype "StudyCamera"
        components {
            GameCamera width=540.0 height=370.0
        }
    }
    - {
        name "Key light"
        prototype "StudyLight"
        components {
            GameTransform x=-200.0 y=-100.0
        }
    }
    - {
        name "Fill light"
        prototype "StudyLight"
        components {
            GameTransform x=200.0 y=30.0
            GameMaterial emission_color=0x9dd4ffff
        }
    }
    - {
        name "CrossBoredHousing"
        prototype "CrossBoredHousing"
        components {
            GameTransform x=-145.0 y=-60.0
        }
    }
    - {
        name "ClippedSphere"
        prototype "ClippedSphere"
        components {
            GameTransform x=0.0 y=-60.0
        }
    }
    - {
        name "SmoothJoin"
        prototype "SmoothJoin"
        components {
            GameTransform x=145.0 y=-60.0
        }
    }
    - {
        name "RoundedBlock"
        prototype "RoundedBlock"
        components {
            GameTransform x=-145.0 y=50.0
        }
    }
    - {
        name "Torus"
        prototype "Torus"
        components {
            GameTransform x=0.0 y=50.0
        }
    }
    - {
        name "EmptyIntersection"
        prototype "EmptyIntersection"
        components {
            GameTransform x=145.0 y=50.0
        }
    }
}
