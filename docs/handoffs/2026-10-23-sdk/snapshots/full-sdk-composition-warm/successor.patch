+    int expected = semantic_files(source, "", ours);
+    REQUIRE(expected > 0 && semantic_files(ours, "", source) == expected);
+    for (size_t i = 0; i < sizeof native_build_files / sizeof *native_build_files; i++) {
+        char path[SDK_PATH];
+        join(path, ours, native_build_files[i]);
+        REQUIRE(!exists(path));
+    }
+    return true;
 }
 
