                    ])),
                    data.Field.Named("behaviors", data.List([]))
                ]),
                data.Object([
                    data.Field.Named("name", data.Value.Text("Gem")),
                    data.Field.Named("prototype", data.Value.Text("Prop")),
                    data.Field.Named("components", data.Object([
