// The directory below the source root, or below the third-party archive for
// `third-party/`, whose files a target publishes as its headers, keeping their
// paths below it.
pub HeaderSource :: (target: string) -> string {
    if (target == "chibi_json") {
        return "third_party/yyjson";
    }
    if (target == "chibi_math") {
        return "third-party/source/cute_framework/include";
    }
    return "src";
}

// The headers a target publishes, below its HeaderSource. Windows adds posix
// shims to chibi_support; this graph does not build Windows yet.
pub PublicHeaders :: (target: string) -> string[] {
    if (target == "chibi_compiler_host") {
        return ["toolchain/compiler_host.h"];
    }
    if (target == "chibi_asset_compiler_host") {
        return ["authoring/asset_compiler_host.h", "authoring/package_compile.h"];
    }
    if (target == "chibi_support") {
        return [
            "support/arena.h", "support/array.h", "support/cos_sin.h", "support/enum.h", "support/file_io.h",
            "support/math.h", "support/xalloc.h"
        ];
    }
    if (target == "chibi_types") {
        return [
            "types/annotate.h", "types/array.h", "types/catalog.h", "types/map.h",
            "types/record.h", "types/pointer.h", "types/query.h", "types/schema.h", "types/scalar.h", "types/state_machine.h", "types/trace.h", "types/type.h",
            "types/union.h", "types/value.h", "types/text.h", "types/value_format.h", "types/value_wire.h"
        ];
    }
    if (target == "chibi_asset_values") {
        return ["support/asset_format.h", "support/asset_value.h"];
    }
    if (target == "chibi_value_document") {
        return ["types/value_document.h"];
    }
    if (target == "chibi_capabilities") {
        return ["capabilities/catalog.h", "capabilities/catalog_snapshot.h", "capabilities/definition.h"];
    }
    if (target == "chibi_ecs") {
        return ["ecs/ecs.h", "ecs/execution.h"];
    }
    if (target == "chibi_events") {
        return ["runtime/events.h"];
    }
    if (target == "chibi_execution_contract") {
        return [
            "execution/arguments.h", "execution/backend.h", "execution/borrow.h", "execution/component.h",
            "execution/diagnostic.h", "execution/managed.h", "execution/function.h", "execution/host.h",
            "execution/instruction.h", "execution/log.h", "execution/operation.h", "execution/random.h",
            "execution/request.h", "execution/scalar.h",
            "execution/service.h", "execution/source_debug.h", "execution/state.h", "execution/status.h",
            "execution/value_kind.h"
        ];
    }
    if (target == "chibi_tasks") {
        return ["runtime/tasks.h"];
    }
    if (target == "chibi_input_action") {
        return ["runtime/input_action.h"];
    }
    if (target == "chibi_native_capabilities") {
        return [
            "runtime/native_capabilities.h", "runtime/native_definitions.h"
        ];
    }
    if (target == "chibi_selection_capabilities") {
        return ["runtime/selection.h", "runtime/selection_definition.h"];
    }
    if (target == "chibi_set_capabilities") {
        return ["runtime/sets.h", "runtime/sets_definition.h"];
    }
    if (target == "chibi_comparison_capabilities") {
        return ["runtime/comparison_definition.h", "runtime/comparisons.h"];
    }
    if (target == "chibi_conversion_capabilities") {
        return ["runtime/conversion_definition.h", "runtime/conversions.h"];
    }
    if (target == "chibi_host_native_catalog") {
        return ["host/native_catalog.h"];
    }
    if (target == "chibi_host_clock") {
        return ["host/clock.h", "host/clock_package.h"];
    }
    if (target == "chibi_scheduling") {
        return ["runtime/systems/scheduler.h"];
    }
    if (target == "chibi_json") {
        return ["yyjson.h"];
    }
    if (target == "chibi_asset_json") {
        return ["support/asset_json.h"];
    }
    if (target == "chibi_text_capabilities") {
        return ["runtime/text_definition.h", "runtime/text_format.h"];
    }
    if (target == "chibi_array_capabilities") {
        return ["runtime/arrays.h", "runtime/arrays_definition.h"];
    }
    if (target == "chibi_math") {
        return ["cute_defines.h", "cute_user_config.h", "cute_math.h", "cute_math3d.h"];
    }
    if (target == "chibi_execution") {
        return [
            "execution/component_write.h", "execution/delay.h", "execution/ecs_reader.h",
            "execution/function_builder.h", "execution/inspection.h", "execution/integer_report.h",
            "execution/intrinsics.h",
            "execution/map_intrinsics.h", "execution/module.h", "execution/module_builder.h",
            "execution/native.h", "execution/prepared.h", "execution/task.h", "execution/update.h"
        ];
    }
    if (target == "chibi_core_capabilities") {
        return ["runtime/core_definition.h"];
    }
    if (target == "chibi_behavior_runtime") {
        return [
            "runtime/behaviors/module_set.h", "runtime/behaviors/package.h",
            "runtime/event_catalog.h"
        ];
    }
    if (target == "chibi_native_prepared") {
        return ["runtime/native_prepared.h"];
    }
    if (target == "chibi_vector_capabilities") {
        return ["runtime/vectors.h", "runtime/vectors_definition.h"];
    }
    if (target == "chibi_math_capabilities") {
        return ["runtime/math_definition.h", "runtime/math_native.h"];
    }
    if (target == "chibi_arithmetic_capabilities") {
        return ["runtime/arithmetic.h", "runtime/arithmetic_definition.h"];
    }
    if (target == "chibi_native_types") {
        return ["runtime/component_catalog.h", "runtime/components.h"];
    }
    if (target == "chibi_task_pool_runtime") {
        return ["runtime/task_pool.h"];
    }
    if (target == "chibi_host_native_default") {
        return ["host/native_default.h"];
    }
    if (target == "chibi_source_catalog") {
        return ["authoring/package_tests.h", "authoring/source_package_io.h"];
    }
    if (target == "chibi_program") {
        return ["authoring/program.h", "authoring/program_service.h"];
    }
    return [];
}

// The headers only a target's own sources include, below src/. A name that is
// no target, such as chibi_physics, is a private/NAME directory several
// libraries share, which CMake stages for none of them alone.
pub PrivateHeaders :: (target: string) -> string[] {
    if (target == "chibi_asset_compiler_host") {
        return ["authoring/asset_compiler_host_internal.h", "support/binary_cache.h", "support/sha256.h"];
    }
    if (target == "chibi_types") {
        return ["types/array_internal.h"];
    }
    if (target == "chibi_asset_values") {
        return ["support/float_text.h"];
    }
    if (target == "chibi_ecs") {
        return ["ecs/ecs_internal.h"];
    }
    if (target == "chibi_native_capabilities") {
        return ["capabilities/catalog_index.h"];
    }
    if (target == "chibi_execution") {
        // Every header beside its sources, as sdk/execution.cmake globs them.
        return HeadersIn("execution");
    }
    if (target == "chibi_physics") {
        // Shared by the task pool and physics runtimes, as CMake stages them.
        return ["diagnostics/tracy.h", "diagnostics/web_trace.h"];
    }
    if (target == "chibi_build-host") {
        // The build host's private headers, which its object library and
        // executable share.
        return [
            "host/build_host.h", "host/build_host_internal.h", "host/build_timing.h", "host/build_io.h", "host/build_values.h",
            "host/process.h", "support/sha256.h", "authoring/source_package_io.h"
        ];
    }
    if (target == "chibi_compiler-host") {
        return [
            "support/binary_cache.h", "support/file_io.h", "support/sha256.h", "toolchain/compiler_artifact.h",
            "toolchain/compiler_bootstrap.h",
            "toolchain/compiler_host.h", "toolchain/compiler_json.h", "toolchain/compiler_syntax.h",
            "toolchain/compiler_target.h"
        ];
    }
    if (target == "chibi_launcher") {
        return ["host/application.h", "host/application_tools.h", "host/application_io.h",
                "host/process.h",
                "toolchain/compiler_syntax.h", "toolchain/compiler_json.h"];
    }
    if (target == "chibi_compiler-syntax") {
        return ["toolchain/compiler_syntax.h"];
    }
    if (target == "chibi_compiler-json") {
        return ["toolchain/compiler_json.h"];
    }
    if (target == "chibi_compiler-target") {
        return ["toolchain/compiler_artifact.h", "toolchain/compiler_target.h"];
    }
    if (target == "chibi_host_tests") {
        // The headers the host tests include, as root CMakeLists.txt stages
        // them below its binary directory.
        return ["host/process.h", "host/state_file.h", "support/array.h", "support/xalloc.h"];
    }
    return [];
}

// The headers in src/DIRECTORY, as paths below src/.
HeadersIn :: (directory: string) -> string[] {
    headers: string[] = [];
    for (name in build.list_directory(Join([os.Root(), "/src/", directory]))) {
        if (strings.HasSuffix(name, ".h")) {
            headers.append(Join([directory, "/", name]));
        }
    }
    return headers;
}

// Where a target's private headers are staged, when not below
// BUILD/sdk/private: the language's sit in its CMake subdirectory's binary
// directory.
pub PrivateDirectory :: (target: string) -> string {
    if (target == "chibi_host_tests") {
        return "build/testing/host/include";
    }
    if (target == "chibi_language_testing") {
        return "build/test/language/testing/include";
    }
    if (target == "chibi_tools_testing") {
        return "build/test/tools/testing/include";
    }
    return "";
}

// The tooling tests' SDK contract consumers, object libraries that compile
// against staged SDK headers and pico_unit alone, as test/tools/CMakeLists.tx
// declares them, so a header that leaks a private include fails here.
ToolConsumers :: () -> string[] {
    return [
        "chibi_sdk_contracts",
        "chibi_native_consumer", "chibi_asset_values_consumer",
        "chibi_source_runtime_consumer",
        "chibi_source_features_consumer", "chibi_program_consumer"
    ];
}

// The header set staged in a `build/` include directory, or empty.
pub DirectorySet :: (include: string) -> string {
    if (include == "build/testing/host/include") {
        return "chibi_host_tests";
    }
    if (include == "build/test/language/testing/include") {
        return "chibi_language_testing";
    }
    if (include == "build/test/tools/testing/include") {
        return "chibi_tools_testing";
    }
    return "";
}

// Private headers a step writes rather than copies, `HEADER=INPUT`: INPUT
// with each of Renames' pairs replaced in turn, as sdk/images.cmake gives
// Cute's codecs private symbols.
pub Rewrites :: (target: string) -> string[] {
    if (target == "chibi_sound_preparation") {
        // The players' Vorbis decoder, as sdk/project_preparation.cmake writes it.
        return ["vendor/sound_vorbis.h=third-party/source/cute_framework/libraries/stb/stb_vorbis.c"];
    }
    if (target == "chibi_host_tests") {
        return ["third_party/pico_headers/pico_unit.h=third_party/pico_headers/pico_unit.h"];
    }
    return [];
}
pub Renames :: (target: string) -> string[] {
    if (target == "chibi_sound_preparation") {
        return ["stb_vorbis_=chibi_sound_vorbis_"];
    }
    return [];
}

// A target's include directories in CMake's order: public/NAME and
// private/NAME are the staged headers of the library chibi_NAME; any other
// path is below the source root, or below the third-party archive for
// `third-party/`.
