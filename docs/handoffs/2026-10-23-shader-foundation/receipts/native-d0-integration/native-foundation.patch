+typedef struct
+{
+    shader_image_view view;
+    int calls;
+    bool available;
+} volume_resolver;
+static bool resolve_volume(void *userdata, const shader_image_source *source, shader_image_view *view)
+{
+    volume_resolver *resolver = userdata;
+    resolver->calls++;
