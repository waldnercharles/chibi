package nominal_binding

import binding "project:lexical_binding"
import syntax "project:syntax_diagnostics"

// Exact header-pass facts. Full declaration coordinates are needed for record
// placement errors; lexical admission and origin guards use the name token.
pub Context :: struct {
    program_name: string;
    program_kind: int;
    pointer_size: int;
}
pub Request :: struct {
    name: string;
    kind: int;
    start: int;
    end: int;
    line: int;
    column: int;
    document: int;
    name_start: int;
    name_end: int;
    name_line: int;
    name_column: int;
    name_document: int;
}
// Parallel to binding.Symbol[]. Parameter IDs retain unsigned precision in a
// separate value bank; nominal IDs are replaced by the admitted symbol's ID.
pub SymbolType :: struct {
    storage: int;
    container: int;
    flags: int;
    parameter_slot: int;
}
pub Declaration :: union {
    Skipped(diagnostics: syntax.Diagnostic[])
    | Bound(existing: int, id: u64, initial_storage: int, initial_flags: int,
            publish: bool, storage: int, container: int, flags: int, parameter: u64,
            catalog_name: string, source_name: string, authored_record: bool, size: int,
            diagnostics: syntax.Diagnostic[])
}

RecordKind: int : 0;
LibraryKind: int : 1;
TypeKind: int : 13;
StructStorage: int : 15;
UnionStorage: int : 18;
UnionFlag: int : 256;

pub Declare :: (environment: binding.Environment, lexical: binding.Context, context: Context,
                types: SymbolType[], type_ids: u64[], request: Request) -> Declaration {
    record := request.kind == RecordKind;
    diagnostics: syntax.Diagnostic[] = [];
    if (record && (context.program_kind != LibraryKind || lexical.function >= 0)) {
        diagnostic: syntax.Diagnostic = {
            start: request.start, end: request.end, line: request.line,
            column: request.column, document: request.document,
            message: "Records must be declared in a library"
        };
        diagnostics.append(diagnostic);
        return Declaration.Skipped(diagnostics);
    }
    initialStorage := UnionStorage;
    initialFlags := UnionFlag;
    if (record) {
        initialStorage = StructStorage;
        initialFlags = 0;
    }
    admission: binding.Request = {
        name: request.name, kind: TypeKind, start: request.name_start, end: request.name_end,
        line: request.name_line, column: request.name_column, document: request.name_document
    };
    existing: int = -1;
    id: u64 = 0;
    switch binding.Declare(environment, lexical, admission) {
        case .Appended(value, errors):
            id = value;
            diagnostics = errors;
        case .Existing(symbol, errors):
            existing = symbol;
            diagnostics = errors;
    }
    name := request.name;
    storage := initialStorage;
    container: int = 0;
    flags := initialFlags;
    parameter: u64 = 0;
    if (existing >= 0) {
        switch environment {
            case .Tables(scopes, symbols, functions, ids, keys):
                symbol := symbols[existing];
                id = ids[symbol.id_slot];
                prior := types[existing];
                if (symbol.kind != TypeKind || (!record && prior.storage != UnionStorage) ||
                    symbol.document != request.name_document || symbol.start != request.name_start) {
                    return Declaration.Bound(existing, id, initialStorage, initialFlags,
                                             false, 0, 0, 0, 0, "", "", false, 0, diagnostics);
                }
                name = symbol.name;
                storage = prior.storage;
                container = prior.container;
                flags = prior.flags;
                parameter = type_ids[prior.parameter_slot];
        }
    }
    catalogName := name;
    size: int = context.pointer_size;
    if (record) {
        catalogName = format_text("{}.{}", context.program_name, name);
        size = 0;
    }
    return Declaration.Bound(existing, id, initialStorage, initialFlags,
                             true, storage, container, flags, parameter, catalogName, name, record, size, diagnostics);
}
