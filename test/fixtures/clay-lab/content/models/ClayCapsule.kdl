version 3
name "ClayCapsule"
domain "model"
id_counter 1000
description "Y-axis capsule; radius 12 and half segment 12 authored units."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 100
                type "Model Capsule"
                x 0.0
                y 0.0
                inputs Radius=12.0 "Half Segment"=12.0
            }
            - id=200 type="Model Output" x=300.0 y=0.0
        }
        (array)edges {
            - from="100.Geometry" to="200.Geometry"
        }
    }
}
