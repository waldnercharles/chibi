+// The retained parser and ordinary package catalog, not spelling reservation,
+// decide whether an annotation can acquire the compiler-owned nominal type.
+CheckAnnotationScope :: () {
+    message := "function shadows an annotation type";
+    for (text in [
+        "package p\nF :: (input: BorrowedBytes) -> i64 { return 0; }\nBorrowedBytes :: () -> i64 { return 0; }\n",
+        "package p\nBorrowedBytes :: () -> i64 { return 0; }\nF :: (input: BorrowedBytes) -> i64 { return 0; }\n",
+        "package p\nBorrowedBytes :: (input: BorrowedBytes) -> i64 { return 0; }\n",
+        "package p\nF :: () -> BorrowedBytes { return 0; }\nBorrowedBytes :: () -> i64 { return 0; }\n",
+        "package p\nF :: (input: BorrowedBytes) -> i64 { return 0; }\nforeign import a \"one.a\"\nforeign a { BorrowedBytes :: () -> i64 }\n",
+        "package p\nforeign import a \"one.a\"\nforeign a { BorrowedBytes :: () -> i64 }\nF :: (input: BorrowedBytes) -> i64 { return 0; }\n",
+        "package p\nforeign import a \"one.a\"\nforeign a { BorrowedBytes :: (input: BorrowedBytes) -> i64 }\n",
+        "package p\nforeign import a \"one.a\"\nforeign a { F :: (input: BorrowedBytes) -> i64 }\nBorrowedBytes :: () -> i64 { return 0; }\n"
+    ]) { CheckRejectedAt(text, message, "BorrowedBytes"); }
+    caller: typed.Source = {path: "p/Caller.chibi", text: "package p\nF :: (input: BorrowedBytes) -> i64 { return 0; }\n", document: 91};
+    shadows: string[] = [
+        "package p\nBorrowedBytes :: () -> i64 { return 0; }\n",
+        "package p\nforeign import a \"one.a\"\nforeign a { BorrowedBytes :: () -> i64 }\n"
+    ];
+    for (text in shadows) {
+        shadow: typed.Source = {path: "p/Shadow.chibi", text: text, document: 92};
+        CheckSourcesRejected([caller, shadow], message, 0, "BorrowedBytes");
+        CheckSourcesRejected([shadow, caller], message, 1, "BorrowedBytes");
+    }
+    // A reachable dependency's public name is not an unqualified type binding.
+    separate: typed.Source[] = [
+        {path: "p/Main.chibi", text: "package p\nimport q \"project:q\"\npub F :: (input: BorrowedBytes) -> i64 { return byte_length(input) + q.BorrowedBytes(); }\n", document: 93},
+        {path: "q/Main.chibi", text: "package q\npub BorrowedBytes :: () -> i64 { return 7; }\n", document: 94}
+    ];
+    module := AcceptedSources(separate);
+    assert(module.parameter_types[0] == typed.BorrowedBytes && module.calls[0].callee == 2 &&
+           NameMatches(module, 1, ".vnext.2"), "dependency spelling neither shadows the borrow nor changes dense native IDs");
+    ordinary := Accepted("package p\nF :: () -> i64 { return BorrowedBytes(); }\nBorrowedBytes :: () -> i64 { return 7; }\n");
+    assert(ordinary.calls[0].callee == 2 && NameMatches(ordinary, 1, "BorrowedBytes"),
+           "ordinary function spelling remains legal and callable");
+
+    // Collection must not move later structural failures ahead of signatures.
+    for (suffix in [
+        "First :: () -> i64 { return 0; }\n",
+        "foreign missing { Later :: () -> i64 }\n"
+    ]) {
+        text := strings.Concatenate(["package p\nFirst :: (input: i64[]) -> i64 { return 0; }\n", suffix]);
+        CheckRejectedAt(text, "vNext rejected a modified or constructed signature", "i64[]");
+    }
+    // Foreign library rows are still emitted at first use, between function
+    // names, rather than being published eagerly by name collection.
+    mixed_source := "package p\nF :: () -> i64 { return A() + B(); }\nforeign import a \"one.a\"\nforeign import b \"two.a\"\nforeign a { A :: () -> i64 }\nMiddle :: () -> i64 { return 0; }\nforeign a { Again :: () -> i64 }\nforeign b { B :: () -> i64 }\n";
+    mixed := Accepted(mixed_source);
+    assert(length(mixed.functions) == 5 && length(mixed.names) == 7 && length(mixed.foreigns) == 3,
+           "two-phase headers preserve authored and foreign table counts");
+    assert(mixed.calls[0].callee == 2 && mixed.calls[1].callee == 5 &&
+           mixed.foreigns[0].function == 2 && mixed.foreigns[1].function == 4 && mixed.foreigns[2].function == 5,
+           "foreign and authored function IDs share declaration order");
+    assert(mixed.foreigns[0].library == 2 && mixed.foreigns[1].library == 2 && mixed.foreigns[2].library == 6 &&
+           mixed.functions[0].name == 1 && mixed.functions[1].name == 3 && mixed.functions[2].name == 4 &&
+           mixed.functions[3].name == 5 && mixed.functions[4].name == 7,
+           "library identities retain first-use sharing and native name order");
+    CheckEqual(mixed, Accepted(mixed_source));
+}
