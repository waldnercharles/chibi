diff --git a/Include/RmlUi/Core/Context.h b/Include/RmlUi/Core/Context.h
--- a/Include/RmlUi/Core/Context.h
+++ b/Include/RmlUi/Core/Context.h
@@ -55,7 +55,9 @@
 
 	/// Updates all elements in the context's documents.
 	/// This must be called before Context::Render, but after any elements have been changed, added, or removed.
-	bool Update();
+	/// Optional four disjoint durations in seconds: data models, root update, layout/position, document release.
