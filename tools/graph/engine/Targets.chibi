    }
    if (target == "chibi_execution_sljit") {
        return ["third-party/source/sljit/sljit_src/sljitLir.c"];
    }
    if (target == "chibi_execution") {
        return [
            "src/execution/artifact.c", "src/execution/backend.c", "src/execution/borrow.c",
            "src/execution/c.c", "src/execution/call.c", "src/execution/component.c",
            "src/execution/ecs_reader.c", "src/execution/function.c", "src/execution/function_builder.c",
