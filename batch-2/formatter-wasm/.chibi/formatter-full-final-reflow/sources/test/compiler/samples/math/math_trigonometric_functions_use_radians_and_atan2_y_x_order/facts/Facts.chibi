package facts
Check :: () -> bool { a := sin(vec2(0, 1.5707963)); b := cos(vec2(0, 1.5707963)); c := atan2(vec2(0, 1), vec2(1, 0)); return a.x == 0.0 && abs(a.y - 1.0) < 0.000001 && b.x == 1.0 && abs(b.y) < 0.000001 && c.x == 0.0 && abs(c.y - 1.5707963) < 0.000001 && tan(vec2(0)) == vec2(0) && asin(vec2(0)) == vec2(0) && acos(vec2(1)) == vec2(0) && atan(vec2(0)) == vec2(0); }
