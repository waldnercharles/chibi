// Adapted from Neon-Swarm shaders/hrc/merge.shd; original source comments retained.
// Builds angular fluence R_n from R_{n+1} (Sec 4, Eq 14-17).
//
// Odd probe x (Eq 14): trace one T_n step outward to reach R_{n+1} probes.
// Even probe x (Eq 15-17): average direct R_{n+1} lookup with traced T_{n+1} path.
//
// R_N is implicitly zero; the top merge never reads a previous fluence buffer.
//
// Buffer layout:
//   T: width = ceil(world_w / 2^n) * (2^n + 1), height = world_h
//   R: width = ceil(world_w / 2^n) * 2^n,       height = world_h

layout(std430, set = 0, binding = 0) readonly  buffer TCurr { uvec2 data[]; } u_t_curr;
layout(std430, set = 0, binding = 1) readonly  buffer TNext { uvec2 data[]; } u_t_next;
layout(std430, set = 0, binding = 2) readonly  buffer RPrevRad { uint data[]; } u_r_prev_rad;
layout(std430, set = 0, binding = 3) readonly  buffer Weights { vec2 data[]; } u_weights;
layout(std430, set = 1, binding = 0) writeonly buffer RCurrRad { uint data[]; } u_r_curr_rad;

layout(set = 2, binding = 0) uniform Params
{
	int u_cascade;
	int u_world_w;
	int u_world_h;
	int u_t_curr_w;
	int u_t_next_w;
	int u_r_prev_w;
	int u_r_curr_w;
	float u_falloff;
	int u_cascade_count;
};

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#include "hrc_common.shd"

vec3 merge_r(Interval near, vec3 far_rad)
{
	// Distance falloff: attenuate far-field by this cascade's interval length.
	// Exponential compounding across levels gives total atten = exp(-falloff * dist).
	float atten = u_falloff > 0.0 ? exp(-u_falloff * float(1 << u_cascade)) : 1.0;
	return near.rad + exp(-near.tau) * far_rad * atten;
}

Interval T_load(int probe_x, int k, int y)
{
	int n = u_cascade;
	int directions = (1 << n) + 1;
	int num_probes = probe_count(u_world_w, n);
	if (probe_x < 0 || probe_x >= num_probes || k < 0 || k >= directions || y < 0 || y >= u_world_h) {
		return Interval(vec3(0.0), 0.0);
	}
	int idx = y * u_t_curr_w + probe_x * directions + k;
	vec4 v = f16_load(u_t_curr.data[idx]);
	return Interval(v.rgb, v.w);
}

Interval T_load_next(int probe_x, int k, int y)
{
	int n = u_cascade + 1;
	if (n >= u_cascade_count) return Interval(vec3(0.0), 0.0);
	int directions = (1 << n) + 1;
	int num_probes = probe_count(u_world_w, n);
	if (probe_x < 0 || probe_x >= num_probes || k < 0 || k >= directions || y < 0 || y >= u_world_h) {
		return Interval(vec3(0.0), 0.0);
	}
	int idx = y * u_t_next_w + probe_x * directions + k;
	vec4 v = f16_load(u_t_next.data[idx]);
	return Interval(v.rgb, v.w);
}

vec3 R_load(int probe_x, int i, int y)
{
	int n = u_cascade + 1;
	if (n >= u_cascade_count) return vec3(0.0);
	int directions = 1 << n;
	int num_probes = probe_count(u_world_w, n);
	if (probe_x < 0 || probe_x >= num_probes || i < 0 || i >= directions || y < 0 || y >= u_world_h) {
		return vec3(0.0);
	}
	int idx = y * u_r_prev_w + probe_x * directions + i;
	return fluence_load(u_r_prev_rad.data[idx]);
}

struct SubCone
{
	int   j_plus;     // upper sub-cone index in R_{n+1}
	int   j_minus;    // lower sub-cone index in R_{n+1}
	float w_plus;     // angular span of upper sub-cone
	float w_minus;    // angular span of lower sub-cone
};

SubCone subcone(int i)
{
	SubCone sc;
	sc.j_plus  = 2 * i + 1;
	sc.j_minus = 2 * i;
	vec2 w = u_weights.data[i];
	sc.w_plus = w.x;
	sc.w_minus = w.y;
	return sc;
}

vec3 weighted_merge(Interval traced, float weight, vec3 far_fluence)
{
	return weight * merge_r(traced, far_fluence);
}

vec3 merge_odd(int probe_x, int i, int y)
{
    SubCone sc = subcone(i);

	int next_probe_x = (probe_x + 1) / 2;
	int pow2n = 1 << u_cascade;

	vec3 F_plus = weighted_merge(
		T_load(probe_x, i + 1, y),
		sc.w_plus,
		R_load(next_probe_x, sc.j_plus, y + 2 * (i + 1) - pow2n)
	);

	vec3 F_minus = weighted_merge(
		T_load(probe_x, i, y),
		sc.w_minus,
		R_load(next_probe_x, sc.j_minus, y + 2 * i - pow2n)
	);

	return F_plus + F_minus;
}

vec3 merge_even(int probe_x, int i, int y)
{
	SubCone sc = subcone(i);

	int next_probe_x = probe_x / 2;

	int far_probe_x = next_probe_x + 1;
	int pow2n1 = 1 << (u_cascade + 1);

	vec3 F1_plus = weighted_merge(
		T_load_next(next_probe_x, 2 * (i + 1), y),
		sc.w_plus,
		R_load(far_probe_x, sc.j_plus, y + 2 * 2 * (i + 1) - pow2n1)
	);

	vec3 F1_minus = weighted_merge(
		T_load_next(next_probe_x, 2 * i, y),
		sc.w_minus,
		R_load(far_probe_x, sc.j_minus, y + 2 * 2 * i - pow2n1)
	);

	vec3 F0_plus  = sc.w_plus  * R_load(next_probe_x, sc.j_plus,  y);
	vec3 F0_minus = sc.w_minus * R_load(next_probe_x, sc.j_minus, y);

	return (F0_plus + F1_plus + F0_minus + F1_minus) * 0.5;
}

void main()
{
	ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
	if (gid.x >= u_r_curr_w) return;

	int y = int(gl_GlobalInvocationID.y);
	if (y >= u_world_h) return;

	int directions = 1 << u_cascade;
	int probe_x = gid.x / directions;
	int i = gid.x - probe_x * directions;

	vec3 fluence = (probe_x % 2 == 0) ? merge_even(probe_x, i, y) : merge_odd(probe_x, i, y);

	int out_idx = y * u_r_curr_w + gid.x;
	u_r_curr_rad.data[out_idx] = fluence_store(fluence);
}
