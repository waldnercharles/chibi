behavior ToneProbe {
    on Begin {
        set_audio_source(0)
        await play_tone(440.0, 220.0, 0.1, 0.2, 0.0, 0.0)
        await set_master_volume(0.8)
        await set_sound_volume(0.5)
        await set_music_volume(0.5)
        await play_sound("Tone")
        await play_music("Tone")
        await stop_music()
    }

    on Tick(dt) {
        signal := get_audio_analysis()
        rhythm := get_audio_rhythm()
        character := get_audio_character()
        self.Transform = vec2(rhythm.Phase * 24 * rhythm.Confidence + character.Width * 8, rhythm.Beat * 8 + character.Flux * 12)
        print_string(format_text("Audio {} {}", signal.Bass, signal.Treble))
        print_string(format_text("Texture {} {} {} {}", character.Centroid, character.Flatness, character.LowWeight, character.Crest))
    }
}
