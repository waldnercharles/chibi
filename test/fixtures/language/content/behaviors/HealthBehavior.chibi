behavior "HealthBehavior" {
    owner "ecs.entity";
    macro HealthChanged(Current: double, RemainingHealth: double) -> () {
        exit True;
        exit False;
        if (Current > RemainingHealth) {
            goto True;
        } else {
            goto False;
        }
    }
    on Damage as damage(Amount: int = 0, Source: handle<"ecs.entity"> = 0) {
        if (convert<"To Real">(damage.Amount) > 0) {
            await "Apply Damage"(Current: component("Health", "current"), Maximum: component("Health", "maximum"), Amount: damage.Amount, Source: damage.Source);
        } else {
        }
    }
    on Died as died(Source: handle<"ecs.entity"> = 0) {
        if (cast<double>(component("Health", "current")) <= 0) {
            await "Notify Encounter"();
            destroy_entity(Entity: self);
        } else {
        }
    }
    "Apply Damage" :: fn(Current: int = 0, Maximum: int = 0, Amount: int = 0, Source: handle<"ecs.entity"> = 0) -> () {
        depth_limit 0;
        action current_remaininghealth = HealthChanged(Current: plain double = convert<"To Real">(entry.Current), RemainingHealth: plain double = cast<double>(clamp(convert<"To Real">(entry.Current) - clamp(convert<"To Real">(entry.Amount), 0, convert<"To Real">(entry.Current)), 0, convert<"To Real">(entry.Maximum))));
        after entry {
            if (convert<"To Real">(entry.Current) > 0) {
                if (has_dash()) {
                    if (cast<double>(component("Dash", "remaining")) > 0) {
                        return ();
                    } else {
                        current_remaininghealth();
                    }
                } else {
                    current_remaininghealth();
                }
            } else {
                return ();
            }
        }
        after current_remaininghealth.True {
            Current := entry.Current
            RemainingHealth := cast<double>(clamp(convert<"To Real">(Current) - clamp(convert<"To Real">(entry.Amount), 0, convert<"To Real">(Current)), 0, convert<"To Real">(entry.Maximum)))
            await set_health_current(Value: convert<"To Integer">(RemainingHealth), Target: 0);
            await send_event<"Damaged">(Entity: engine["Self"](), Amount: int = subtract(A: int = Current, B: int = convert<"To Integer">(RemainingHealth)), Source: entry.Source);
            if (cast<double>(clamp(convert<"To Real">(Current) - clamp(convert<"To Real">(entry.Amount), 0, convert<"To Real">(Current)), 0, convert<"To Real">(entry.Maximum))) <= 0) {
                await send_event<"Died">(Entity: engine["Self"](), Source: entry.Source);
                return ();
            } else {
                return ();
            }
        }
        after current_remaininghealth.False {
            return ();
        }
    }
    "Notify Encounter" :: fn() -> () {
        depth_limit 0;
        after entry {
            if (has_encounter_member()) {
                foreach (foreach_2 in find_entities_with_component(Component: "Encounter")) {
                    send_event<"RefreshEncounter">(Entity: foreach_2);
                }
                return ();
            } else {
                return ();
            }
        }
    }
}
