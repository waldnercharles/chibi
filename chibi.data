  kind: function
  name: Pulse Angle
  math_expression: Eased * 2 * pi
  entry_id: 1855
- id: 536
  kind: function
  name: Pulse Fade
  math_expression: clamp((Lifetime - Age) / 2, 0, 1)
  entry_id: 1876
- id: 573
  kind: function
  name: Pulse Yaw
  math_expression: Angle + BaseRotation
  entry_id: 1906
- id: 589
  kind: function
  name: Pulse Scale
  math_expression: (0.9 + 0.1 * cos(Angle)) * Fade
  entry_id: 1918
- id: 622
  kind: function
  name: Spiral T
  math_expression: CollectionAge / 0.6
  entry_id: 1947
- id: 639
  kind: function
  name: Spiral Angle
  math_expression: T * 2.5 * pi
  entry_id: 1961
- id: 663
  kind: function
  name: Spiral Weight
  math_expression: (1 - T) * (1 - T) * (1 + 5 * T)
  entry_id: 1982
- id: 709
  kind: function
  name: Spiral X
  math_expression: TargetX + Weight * ((OriginX - TargetX) * cos(Theta) - (OriginY - TargetY) * sin(Theta)) + 12 * sin(pi * T) * cos(Theta)
  entry_id: 2025
- id: 793
  kind: function
  name: Spiral Y
  math_expression: TargetY + Weight * ((OriginX - TargetX) * sin(Theta) + (OriginY - TargetY) * cos(Theta)) + 12 * sin(pi * T) * sin(Theta)
  entry_id: 2100
- id: 877
  kind: function
  name: Spiral Yaw
  math_expression: BaseRotation + Theta
  entry_id: 2175
- id: 893
  kind: function
  name: Spiral Scale
  math_expression: 1 - 0.5 * T
  entry_id: 2187
- id: 917
  kind: function
  name: Collection Age
  math_expression: CollectionAge + Delta
  entry_id: 2208
