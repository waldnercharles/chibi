RejectsImportWithoutPath :: () {
    Rejects("package demo\n\nimport project:greet\n\nMain :: () {\n}\n", 3, 8);
}

@test
RejectsUnclosedParen :: () {
    Rejects("package demo\n\nMain :: () -> int {\n    x := (1 + 2\n    return x\n}\n", 5, 5);
}

@test
RejectsMissingSeparator :: () {
    Rejects("package demo\n\nMain :: () {\n    a := 1 b := 2\n}\n", 4, 12);
