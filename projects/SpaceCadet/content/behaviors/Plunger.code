behavior "Plunger" {
    owner "ecs.entity";
    value get_global_variable: double = get_global_variable(Name: "Ready");
    value get_global_variable_2: double = get_global_variable(Name: "Lives");
    value get_global_variable_3: double = get_global_variable(Name: "Charge");
    local charge = get_global_variable_3;
    on Tick as tick(DeltaSeconds: float = 0.0) {
        if (get_global_variable > 0.5 && get_global_variable_2 > 0) {
            if (&component("GAME.GameActionBinding", "pressed")) {
                set_global_variable(Name: "Charge", Value: double = (min(&local.charge + cast<double>(&delta), 1)));
            } else {
                if (&local.charge > 0.01) {
                    &component("GAME.GameVelocity") = vec2(0, -800 - 230 * &local.charge);
                    await set_global_variable(Name: "Ready", Value: float = 0.0);
                    await set_global_variable(Name: "Charge", Value: float = 0.0);
                    play_sound(Frequency: 100.0, "End Frequency": 720.0, Duration: 0.16, Volume: 0.35, Pan: 0.5, Noise: 0.0);
                } else {
                }
            }
        } else {
        }
    }
}
