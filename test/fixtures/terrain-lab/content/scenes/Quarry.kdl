version 1
name "The seam quarry"
(array)entities {
    - name="World" prototype="World"
    - name="Backdrop" prototype="Backdrop"
    - {
        name "Distant ridge west"
        prototype "Scenery"
        components {
            Appearance height=78.0 width=280.0 color=0x1b3441ff
            Transform x=-260.0 y=-36.0
        }
    }
    - {
        name "Distant ridge east"
        prototype "Scenery"
        components {
            Appearance height=54.0 width=330.0 color=0x23414aff
            Transform x=250.0 y=-26.0
        }
    }
    - {
        name "Moon"
        prototype "Scenery"
        components {
            Appearance color=0xa4b9b5ff height=30.0 width=30.0 shape="Circle"
            Transform x=250.0 y=-115.0
        }
    }
    - name="Quarry terrain" prototype="Terrain"
    - name="Explorer" prototype="Explorer"
    - name="Explorer visor" prototype="Visor"
    - name="Dig outline" prototype="Target"
    - name="Camera" prototype="Camera"
    - name="128-cell seam marker" prototype="Marker"
    - name="128-cell seam flag" prototype="Flag"
    - {
        name "Untouched reference marker"
        prototype "Marker"
        components {
            Appearance color=0xffc383ff
            Transform x=256.0 y=-9.0
        }
    }
    - {
        name "Untouched reference flag"
        prototype "Flag"
        components {
            Appearance color=0xffc383ff
            Transform x=263.0 y=-16.0
        }
    }
}
