package native_link

import abi "project:native_abi"

// Runtime format_text uses the same grammar and scalar conversions as
// src/runtime/text_format.c: explicit indexes leave the sequential index alone,
// escaped braces remain literal, missing inputs emit nothing, and at most 12
// successful placeholders render. Invalid modifiers display the original value.
//
// There are two linear walks of the format and at most 12 numeric conversions.
// A failed close scan disables later hole parsing because no close remains.
// The first walk renders once into 12 fixed 256-byte slots (or keeps raw string
// pointers), computes the exact result length, and allocates once. The second
// copies those results. This bounds scratch space to 3 KiB and avoids repeated
// indexed values exceeding an estimate based on each input appearing once.
//
// printf receives only validated scalar conversions and widths/precisions up
// to 255. Text padding is manual so embedded NUL bytes retain their length.
// Windows uses the UCRT vsnprintf entry directly: its Win64 va_list points
// to one 8-byte argument word, with standard snprintf and rounding options.
// Numeric output is always terminated and bounded to 255 bytes.
// Modern standalone modules prove every Format operand's storage. Text/count
// calls cannot enter the numeric renderer, even with dynamic modifiers.
// Legacy and shared contexts can receive arbitrary values and keep it complete.
pub RuntimeFormat :: (windows: bool, numeric: bool = true) -> string {
    numbers := "define internal i32 @chibi_format_number(ptr %buffer, ptr %conversion, i64 %word, i1 %floating, i1 %wide) {\n  unreachable\n}\n";
    if (numeric) { numbers = FormatNumbers(windows); }
    return Join([numbers, FormatGrammar(), FormatModifiers(), FormatRenderer(), FormatWalk()]);
}

FormatGrammar :: () -> string {
    return Join([
        "%chibi_format_value = type { i32, i32, i64, ptr }\n",
        "%chibi_format_hole = type { i32, i32, i32, i32 }\n",
        "%chibi_format_text = type { ptr, i32 }\n",
        "@chibi_true = private unnamed_addr constant [4 x i8] c\"true\"\n",
        "@chibi_false = private unnamed_addr constant [5 x i8] c\"false\"\n",
        "@chibi_format_array = private unnamed_addr constant [6 x i8] c\"Array[\"\n",
        "@chibi_format_map = private unnamed_addr constant [4 x i8] c\"Map[\"\n",
        "\n",
        "define internal void @chibi_copy(ptr %to, ptr %from, i32 %count) {\n",
        "entry:\n",
        "  br label %loop\n",
        "loop:\n",
        "  %at = phi i32 [ 0, %entry ], [ %next, %body ]\n",
        "  %more = icmp slt i32 %at, %count\n",
        "  br i1 %more, label %body, label %done\n",
        "body:\n",
        "  %source = getelementptr inbounds i8, ptr %from, i32 %at\n",
        "  %byte = load i8, ptr %source\n",
        "  %target = getelementptr inbounds i8, ptr %to, i32 %at\n",
        "  store i8 %byte, ptr %target\n",
        "  %next = add i32 %at, 1\n",
        "  br label %loop\n",
        "done:\n",
        "  ret void\n",
        "}\n",
        "\n",
        "define internal i1 @chibi_format_signed(i32 %tag) {\n",
        "  switch i32 %tag, label %no [ i32 1, label %yes\n",
        "    i32 3, label %yes\n",
        "    i32 5, label %yes\n",
        "    i32 8, label %yes ]\n",
        "yes:\n",
        "  ret i1 true\n",
        "no:\n",
        "  ret i1 false\n",
        "}\n",
        "\n",
        "define internal i1 @chibi_format_floating(i8 %letter) {\n",
        "  switch i8 %letter, label %no [ i8 97, label %yes\n",
        "    i8 65, label %yes\n",
        "    i8 101, label %yes\n",
        "    i8 69, label %yes\n",
        "    i8 102, label %yes\n",
        "    i8 70, label %yes\n",
        "    i8 103, label %yes\n",
        "    i8 71, label %yes ]\n",
        "yes:\n",
        "  ret i1 true\n",
        "no:\n",
        "  ret i1 false\n",
        "}\n",
        "\n",
        "; end=0 is a literal opening brace; end=-1 proves no close remains.\n",
        "; Saturating indexes before multiplication prevents overflow on long digits.\n",
        "define internal %chibi_format_hole @chibi_format_parse(ptr %format, i32 %length, i32 %start) {\n",
        "entry:\n",
        "  %first = add i32 %start, 1\n",
        "  br label %index.loop\n",
        "index.loop:\n",
        "  %at = phi i32 [ %first, %entry ], [ %next, %index.digit ]\n",
        "  %index = phi i32 [ -1, %entry ], [ %index.next, %index.digit ]\n",
        "  %more = icmp slt i32 %at, %length\n",
        "  br i1 %more, label %index.byte, label %invalid\n",
        "index.byte:\n",
        "  %p = getelementptr inbounds i8, ptr %format, i32 %at\n",
        "  %byte = load i8, ptr %p\n",
        "  %digit = sub i8 %byte, 48\n",
        "  %is.digit = icmp ult i8 %digit, 10\n",
        "  br i1 %is.digit, label %index.digit, label %delimiter\n",
        "index.digit:\n",
        "  %absent = icmp slt i32 %index, 0\n",
        "  %base = select i1 %absent, i32 0, i32 %index\n",
        "  %full = icmp sge i32 %base, 12\n",
        "  %times = mul i32 %base, 10\n",
        "  %number = zext i8 %digit to i32\n",
        "  %sum = add i32 %times, %number\n",
        "  %index.next = select i1 %full, i32 12, i32 %sum\n",
        "  %next = add i32 %at, 1\n",
        "  br label %index.loop\n",
        "delimiter:\n",
        "  %colon = icmp eq i8 %byte, 58\n",
        "  %close = icmp eq i8 %byte, 125\n",
        "  %valid = or i1 %colon, %close\n",
        "  br i1 %valid, label %modifiers, label %invalid\n",
        "modifiers:\n",
        "  %after = add i32 %at, 1\n",
        "  %mods = select i1 %colon, i32 %after, i32 %at\n",
        "  br label %close.loop\n",
        "close.loop:\n",
        "  %q = phi i32 [ %mods, %modifiers ], [ %q.next, %close.byte ]\n",
        "  %has.byte = icmp slt i32 %q, %length\n",
        "  br i1 %has.byte, label %close.byte, label %unterminated\n",
        "close.byte:\n",
        "  %q.p = getelementptr inbounds i8, ptr %format, i32 %q\n",
        "  %q.byte = load i8, ptr %q.p\n",
        "  %ended = icmp eq i8 %q.byte, 125\n",
        "  %q.next = add i32 %q, 1\n",
        "  br i1 %ended, label %found, label %close.loop\n",
        "found:\n",
        "  %span = sub i32 %q, %mods\n",
        "  %size = select i1 %colon, i32 %span, i32 0\n",
        "  %r0 = insertvalue %chibi_format_hole zeroinitializer, i32 %q.next, 0\n",
        "  %r1 = insertvalue %chibi_format_hole %r0, i32 %index, 1\n",
        "  %r2 = insertvalue %chibi_format_hole %r1, i32 %mods, 2\n",
        "  %r3 = insertvalue %chibi_format_hole %r2, i32 %size, 3\n",
        "  ret %chibi_format_hole %r3\n",
        "unterminated:\n",
        "  ret %chibi_format_hole { i32 -1, i32 0, i32 0, i32 0 }\n",
        "invalid:\n",
        "  ret %chibi_format_hole zeroinitializer\n",
        "}\n",
        "\n"
    ]);
}

FormatModifiers :: () -> string {
    return Join([
        "; Normalize '<'/'>' and validate flags, literal widths and precisions before\n",
        "; constructing printf syntax. A zero letter requests canonical formatting.\n",
        "; state = {width, precision (-1 means absent), left alignment}.\n",
        "define internal i8 @chibi_format_modifier(i32 %tag, ptr %mods, i32 %size, ptr %conversion, ptr %state) {\n",
        "entry:\n",
        "  %width.p = getelementptr inbounds i32, ptr %state, i32 0\n",
        "  %precision.p = getelementptr inbounds i32, ptr %state, i32 1\n",
        "  %left.p = getelementptr inbounds i32, ptr %state, i32 2\n",
        "  store i32 0, ptr %width.p\n",
        "  store i32 -1, ptr %precision.p\n",
        "  store i32 0, ptr %left.p\n",
        "  %small = icmp ult i32 %size, 64\n",
        "  br i1 %small, label %normalize, label %invalid\n",
        "normalize:\n",
        "  br label %normalize.loop\n",
        "normalize.loop:\n",
        "  %i = phi i32 [ 0, %normalize ], [ %i.next, %normalize.next ]\n",
        "  %n = phi i32 [ 0, %normalize ], [ %n.next, %normalize.next ]\n",
        "  %remaining = icmp slt i32 %i, %size\n",
        "  br i1 %remaining, label %normalize.byte, label %flags.loop\n",
        "normalize.byte:\n",
        "  %mod.p = getelementptr inbounds i8, ptr %mods, i32 %i\n",
        "  %mod = load i8, ptr %mod.p\n",
        "  %zero = icmp eq i8 %mod, 0\n",
        "  %star = icmp eq i8 %mod, 42\n",
        "  %unsafe = or i1 %zero, %star\n",
        "  br i1 %unsafe, label %invalid, label %normalize.angle\n",
        "normalize.angle:\n",
        "  %right = icmp eq i8 %mod, 62\n",
        "  br i1 %right, label %normalize.next, label %normalize.store\n",
        "normalize.store:\n",
        "  %left = icmp eq i8 %mod, 60\n",
        "  %normalized = select i1 %left, i8 45, i8 %mod\n",
        "  %offset = add i32 %n, 1\n",
        "  %dest = getelementptr inbounds i8, ptr %conversion, i32 %offset\n",
        "  store i8 %normalized, ptr %dest\n",
        "  br label %normalize.next\n",
        "normalize.next:\n",
        "  %written = phi i32 [ %n, %normalize.angle ], [ %offset, %normalize.store ]\n",
        "  %n.next = add i32 %written, 0\n",
        "  %i.next = add i32 %i, 1\n",
        "  br label %normalize.loop\n",
        "flags.loop:\n",
        "  %flag.at = phi i32 [ 0, %normalize.loop ], [ %flag.next, %flag ]\n",
        "  %has.flag = icmp slt i32 %flag.at, %n\n",
        "  br i1 %has.flag, label %flag.byte.block, label %width.loop\n",
        "flag.byte.block:\n",
        "  %flag.offset = add i32 %flag.at, 1\n",
        "  %flag.p = getelementptr inbounds i8, ptr %conversion, i32 %flag.offset\n",
        "  %flag.byte = load i8, ptr %flag.p\n",
        "  switch i8 %flag.byte, label %width.loop [ i8 45, label %flag.left\n",
        "    i8 43, label %flag\n",
        "    i8 32, label %flag\n",
        "    i8 35, label %flag\n",
        "    i8 48, label %flag ]\n",
        "flag.left:\n",
        "  store i32 1, ptr %left.p\n",
        "  br label %flag\n",
        "flag:\n",
        "  %flag.next = add i32 %flag.at, 1\n",
        "  br label %flags.loop\n",
        "width.loop:\n",
        "  %w.at = phi i32 [ %flag.at, %flags.loop ], [ %flag.at, %flag.byte.block ], [ %w.next, %width.digit ]\n",
        "  %width = phi i32 [ 0, %flags.loop ], [ 0, %flag.byte.block ], [ %w.sum, %width.digit ]\n",
        "  %has.width = icmp slt i32 %w.at, %n\n",
        "  br i1 %has.width, label %width.byte, label %precision.check\n",
        "width.byte:\n",
        "  %w.offset = add i32 %w.at, 1\n",
        "  %w.p = getelementptr inbounds i8, ptr %conversion, i32 %w.offset\n",
        "  %w.byte = load i8, ptr %w.p\n",
        "  %w.digit = sub i8 %w.byte, 48\n",
        "  %w.numeric = icmp ult i8 %w.digit, 10\n",
        "  br i1 %w.numeric, label %width.number, label %precision.check\n",
        "width.number:\n",
        "  %w.times = mul i32 %width, 10\n",
        "  %w.number = zext i8 %w.digit to i32\n",
        "  %w.sum = add i32 %w.times, %w.number\n",
        "  %w.safe = icmp ule i32 %w.sum, 255\n",
        "  br i1 %w.safe, label %width.digit, label %invalid\n",
        "width.digit:\n",
        "  %w.next = add i32 %w.at, 1\n",
        "  br label %width.loop\n",
        "precision.check:\n",
        "  store i32 %width, ptr %width.p\n",
        "  %at.end = icmp eq i32 %w.at, %n\n",
        "  br i1 %at.end, label %letter, label %precision.byte\n",
        "precision.byte:\n",
        "  %dot.offset = add i32 %w.at, 1\n",
        "  %dot.p = getelementptr inbounds i8, ptr %conversion, i32 %dot.offset\n",
        "  %dot.byte = load i8, ptr %dot.p\n",
        "  %dot = icmp eq i8 %dot.byte, 46\n",
        "  br i1 %dot, label %precision.begin, label %letter\n",
        "precision.begin:\n",
        "  %p.first = add i32 %w.at, 1\n",
        "  br label %precision.loop\n",
        "precision.loop:\n",
        "  %p.at = phi i32 [ %p.first, %precision.begin ], [ %p.next, %precision.digit ]\n",
        "  %precision = phi i32 [ 0, %precision.begin ], [ %p.sum, %precision.digit ]\n",
        "  %has.precision = icmp slt i32 %p.at, %n\n",
        "  br i1 %has.precision, label %precision.value, label %precision.done\n",
        "precision.value:\n",
        "  %p.offset = add i32 %p.at, 1\n",
        "  %p.p = getelementptr inbounds i8, ptr %conversion, i32 %p.offset\n",
        "  %p.byte = load i8, ptr %p.p\n",
        "  %p.digit = sub i8 %p.byte, 48\n",
        "  %p.numeric = icmp ult i8 %p.digit, 10\n",
        "  br i1 %p.numeric, label %precision.number, label %precision.done\n",
        "precision.number:\n",
        "  %p.times = mul i32 %precision, 10\n",
        "  %p.number = zext i8 %p.digit to i32\n",
        "  %p.sum = add i32 %p.times, %p.number\n",
        "  %p.safe = icmp ule i32 %p.sum, 255\n",
        "  br i1 %p.safe, label %precision.digit, label %invalid\n",
        "precision.digit:\n",
        "  %p.next = add i32 %p.at, 1\n",
        "  br label %precision.loop\n",
        "precision.done:\n",
        "  store i32 %precision, ptr %precision.p\n",
        "  br label %letter\n",
        "letter:\n",
        "  %letter.at = phi i32 [ %w.at, %precision.check ], [ %w.at, %precision.byte ], [ %p.at, %precision.done ]\n",
        "  %has.dot = phi i1 [ false, %precision.check ], [ false, %precision.byte ], [ true, %precision.done ]\n",
        "  %default = icmp eq i32 %letter.at, %n\n",
        "  %text = icmp eq i32 %tag, 12\n",
        "  %f32 = icmp eq i32 %tag, 10\n",
        "  %f64 = icmp eq i32 %tag, 11\n",
        "  %float = or i1 %f32, %f64\n",
        "  %signed = call i1 @chibi_format_signed(i32 %tag)\n",
        "  %boolean = icmp eq i32 %tag, 2\n",
        "  %signed.default = or i1 %signed, %boolean\n",
        "  %integer.letter = select i1 %signed.default, i8 100, i8 117\n",
        "  %number.letter = select i1 %float, i8 103, i8 %integer.letter\n",
        "  %default.letter = select i1 %text, i8 115, i8 %number.letter\n",
        "  br i1 %default, label %validate, label %letter.explicit\n",
        "letter.explicit:\n",
        "  %letter.offset = add i32 %letter.at, 1\n",
        "  %one.letter = icmp eq i32 %letter.offset, %n\n",
        "  br i1 %one.letter, label %letter.load, label %invalid\n",
        "letter.load:\n",
        "  %letter.p = getelementptr inbounds i8, ptr %conversion, i32 %letter.offset\n",
        "  %explicit.letter = load i8, ptr %letter.p\n",
        "  br label %validate\n",
        "validate:\n",
        "  %conversion.letter = phi i8 [ %default.letter, %letter ], [ %explicit.letter, %letter.load ]\n",
        "  %floating = call i1 @chibi_format_floating(i8 %conversion.letter)\n",
        "  %bad.float = xor i1 %floating, true\n",
        "  %character = icmp eq i8 %conversion.letter, 99\n",
        "  %i64 = icmp eq i32 %tag, 8\n",
        "  %u64 = icmp eq i32 %tag, 9\n",
        "  %wide = or i1 %i64, %u64\n",
        "  br i1 %text, label %validate.text, label %validate.numeric\n",
        "validate.text:\n",
        "  %string.letter = icmp eq i8 %conversion.letter, 115\n",
        "  br i1 %string.letter, label %validate.flags, label %invalid\n",
        "validate.numeric:\n",
        "  %float.integer = and i1 %float, %bad.float\n",
        "  %bad.character = or i1 %has.dot, %wide\n",
        "  %invalid.character = and i1 %character, %bad.character\n",
        "  %invalid.numeric = or i1 %float.integer, %invalid.character\n",
        "  br i1 %invalid.numeric, label %invalid, label %validate.family\n",
        "validate.family:\n",
        "  br i1 %floating, label %validate.flags, label %validate.integer\n",
        "validate.integer:\n",
        "  switch i8 %conversion.letter, label %invalid [ i8 100, label %validate.flags\n",
        "    i8 105, label %validate.flags\n",
        "    i8 111, label %validate.flags\n",
        "    i8 117, label %validate.flags\n",
        "    i8 120, label %validate.flags\n",
        "    i8 88, label %validate.flags\n",
        "    i8 99, label %validate.flags ]\n",
        "validate.flags:\n",
        "  %restricted = or i1 %text, %character\n",
        "  br label %validate.loop\n",
        "validate.loop:\n",
        "  %v.at = phi i32 [ 0, %validate.flags ], [ %v.next, %validate.next ]\n",
        "  %v.more = icmp slt i32 %v.at, %flag.at\n",
        "  br i1 %v.more, label %validate.flag, label %construct\n",
        "validate.flag:\n",
        "  %v.offset = add i32 %v.at, 1\n",
        "  %v.p = getelementptr inbounds i8, ptr %conversion, i32 %v.offset\n",
        "  %v.byte = load i8, ptr %v.p\n",
        "  %not.left = icmp ne i8 %v.byte, 45\n",
        "  %bad.restricted = and i1 %restricted, %not.left\n",
        "  br i1 %bad.restricted, label %invalid, label %validate.alternate\n",
        "validate.alternate:\n",
        "  %hash = icmp eq i8 %v.byte, 35\n",
        "  %check.alternate = and i1 %hash, %bad.float\n",
        "  br i1 %check.alternate, label %validate.radix, label %validate.sign\n",
        "validate.radix:\n",
        "  switch i8 %conversion.letter, label %invalid [ i8 111, label %validate.sign\n",
        "    i8 120, label %validate.sign\n",
        "    i8 88, label %validate.sign ]\n",
        "validate.sign:\n",
        "  %plus = icmp eq i8 %v.byte, 43\n",
        "  %space = icmp eq i8 %v.byte, 32\n",
        "  %sign.flag = or i1 %plus, %space\n",
        "  %check.sign = and i1 %sign.flag, %bad.float\n",
        "  br i1 %check.sign, label %validate.decimal, label %validate.next\n",
        "validate.decimal:\n",
        "  switch i8 %conversion.letter, label %invalid [ i8 100, label %validate.next\n",
        "    i8 105, label %validate.next ]\n",
        "validate.next:\n",
        "  %v.next = add i32 %v.at, 1\n",
        "  br label %validate.loop\n",
        "construct:\n",
        "  store i8 37, ptr %conversion\n",
        "  %end = add i32 %letter.at, 1\n",
        "  %integer.family = xor i1 %floating, true\n",
        "  %length.modifier = and i1 %integer.family, %wide\n",
        "  br i1 %length.modifier, label %construct.wide, label %construct.letter\n",
        "construct.wide:\n",
        "  %l0 = getelementptr inbounds i8, ptr %conversion, i32 %end\n",
        "  store i8 108, ptr %l0\n",
        "  %end.one = add i32 %end, 1\n",
        "  %l1 = getelementptr inbounds i8, ptr %conversion, i32 %end.one\n",
        "  store i8 108, ptr %l1\n",
        "  %end.two = add i32 %end, 2\n",
        "  br label %construct.letter\n",
        "construct.letter:\n",
        "  %letter.end = phi i32 [ %end, %construct ], [ %end.two, %construct.wide ]\n",
        "  %letter.dest = getelementptr inbounds i8, ptr %conversion, i32 %letter.end\n",
        "  store i8 %conversion.letter, ptr %letter.dest\n",
        "  %zero.end = add i32 %letter.end, 1\n",
        "  %zero.dest = getelementptr inbounds i8, ptr %conversion, i32 %zero.end\n",
        "  store i8 0, ptr %zero.dest\n",
        "  ret i8 %conversion.letter\n",
        "invalid:\n",
        "  ret i8 0\n",
        "}\n",
        "\n"
    ]);
}

FormatRenderer :: () -> string {
    return Join([
        "; Render each selected placeholder once into its own bounded scratch, or keep\n",
        "; the input string's pointer. String precision and padding preserve NUL bytes.\n",
        "define internal %chibi_format_text @chibi_format_render(ptr %value, ptr %mods, i32 %size, ptr %scratch) {\n",
        "entry:\n",
        "  %conversion = alloca [80 x i8]\n",
        "  %state = alloca [3 x i32]\n",
        "  %tag = load i32, ptr %value\n",
        "  %word.p = getelementptr inbounds %chibi_format_value, ptr %value, i32 0, i32 2\n",
        "  %word = load i64, ptr %word.p\n",
        "  %modified = icmp ne i32 %size, 0\n",
        format_text("  %is.array = icmp eq i32 %tag, {}\n  %is.map = icmp eq i32 %tag, {}\n", abi.FormatArrayTag, abi.FormatMapTag),
        "  %is.summary = or i1 %is.array, %is.map\n",
        "  br i1 %is.summary, label %summary, label %regular\n",
        "regular:\n",
        "  br i1 %modified, label %modifier, label %dispatch\n",
        "modifier:\n",
        "  %valid.letter = call i8 @chibi_format_modifier(i32 %tag, ptr %mods, i32 %size, ptr %conversion, ptr %state)\n",
        "  br label %dispatch\n",
        "dispatch:\n",
        "  %letter = phi i8 [ 0, %regular ], [ %valid.letter, %modifier ]\n",
        "  %is.text = icmp eq i32 %tag, 12\n",
        "  %canonical = icmp eq i8 %letter, 0\n",
        "  br i1 %is.text, label %text, label %scalar\n",
        "text:\n",
        "  %bytes.p = getelementptr inbounds %chibi_format_value, ptr %value, i32 0, i32 3\n",
        "  %bytes = load ptr, ptr %bytes.p\n",
        "  %length.p = getelementptr inbounds %chibi_format_value, ptr %value, i32 0, i32 1\n",
        "  %length = load i32, ptr %length.p\n",
        "  br i1 %canonical, label %text.raw, label %text.modified\n",
        "text.modified:\n",
        "  %precision.p = getelementptr inbounds i32, ptr %state, i32 1\n",
        "  %precision = load i32, ptr %precision.p\n",
        "  %has.precision = icmp sge i32 %precision, 0\n",
        "  %too.long = icmp sgt i32 %length, %precision\n",
        "  %truncate = and i1 %has.precision, %too.long\n",
        "  %trimmed = select i1 %truncate, i32 %precision, i32 %length\n",
        "  %width = load i32, ptr %state\n",
        "  %padding = icmp sgt i32 %width, %trimmed\n",
        "  br i1 %padding, label %text.pad, label %text.raw\n",
        "text.pad:\n",
        "  br label %text.spaces\n",
        "text.spaces:\n",
        "  %space.at = phi i32 [ 0, %text.pad ], [ %space.next, %text.space ]\n",
        "  %space.more = icmp slt i32 %space.at, %width\n",
        "  br i1 %space.more, label %text.space, label %text.copy\n",
        "text.space:\n",
        "  %space.p = getelementptr inbounds i8, ptr %scratch, i32 %space.at\n",
        "  store i8 32, ptr %space.p\n",
        "  %space.next = add i32 %space.at, 1\n",
        "  br label %text.spaces\n",
        "text.copy:\n",
        "  %left.p = getelementptr inbounds i32, ptr %state, i32 2\n",
        "  %left = load i32, ptr %left.p\n",
        "  %left.aligned = icmp ne i32 %left, 0\n",
        "  %gap = sub i32 %width, %trimmed\n",
        "  %offset = select i1 %left.aligned, i32 0, i32 %gap\n",
        "  %destination = getelementptr inbounds i8, ptr %scratch, i32 %offset\n",
        "  call void @chibi_copy(ptr %destination, ptr %bytes, i32 %trimmed)\n",
        "  br label %finish\n",
        "text.raw:\n",
        "  %raw.length = phi i32 [ %length, %text ], [ %trimmed, %text.modified ]\n",
        "  br label %finish\n",
        "scalar:\n",
        "  %is.bool = icmp eq i32 %tag, 2\n",
        "  %bool.default = and i1 %is.bool, %canonical\n",
        "  br i1 %bool.default, label %boolean, label %number\n",
        "boolean:\n",
        "  %truth = icmp ne i64 %word, 0\n",
        "  %bool.bytes = select i1 %truth, ptr @chibi_true, ptr @chibi_false\n",
        "  %bool.length = select i1 %truth, i32 4, i32 5\n",
        "  br label %finish\n",
        "number:\n",
        "  %f32 = icmp eq i32 %tag, 10\n",
        "  %f64 = icmp eq i32 %tag, 11\n",
        "  %float = or i1 %f32, %f64\n",
        "  %signed = call i1 @chibi_format_signed(i32 %tag)\n",
        "  %i64 = icmp eq i32 %tag, 8\n",
        "  %u64 = icmp eq i32 %tag, 9\n",
        "  %wide = or i1 %i64, %u64\n",
        "  br i1 %canonical, label %default, label %numeric\n",
        "default:\n",
        "  store i8 37, ptr %conversion\n",
        "  %default.wide = select i1 %wide, i32 3, i32 1\n",
        "  br i1 %wide, label %default.length, label %default.letter\n",
        "default.length:\n",
        "  %length0 = getelementptr inbounds i8, ptr %conversion, i32 1\n",
        "  %length1 = getelementptr inbounds i8, ptr %conversion, i32 2\n",
        "  store i8 108, ptr %length0\n",
        "  store i8 108, ptr %length1\n",
        "  br label %default.letter\n",
        "default.letter:\n",
        "  %default.integer = select i1 %signed, i8 100, i8 117\n",
        "  %default.conversion = select i1 %float, i8 103, i8 %default.integer\n",
        "  %default.p = getelementptr inbounds i8, ptr %conversion, i32 %default.wide\n",
        "  store i8 %default.conversion, ptr %default.p\n",
        "  %default.end = add i32 %default.wide, 1\n",
        "  %default.zero = getelementptr inbounds i8, ptr %conversion, i32 %default.end\n",
        "  store i8 0, ptr %default.zero\n",
        "  br label %numeric\n",
        "numeric:\n",
        "  %numeric.letter = phi i8 [ %letter, %number ], [ %default.conversion, %default.letter ]\n",
        "  %floating = call i1 @chibi_format_floating(i8 %numeric.letter)\n",
        "  br i1 %floating, label %floating.kind, label %integer.kind\n",
        "floating.kind:\n",
        "  br i1 %f32, label %floating.single, label %floating.double.check\n",
        "floating.single:\n",
        "  %bits32 = trunc i64 %word to i32\n",
        "  %single = bitcast i32 %bits32 to float\n",
        "  %extended = fpext float %single to double\n",
        "  br label %floating.print\n",
        "floating.double.check:\n",
        "  br i1 %f64, label %floating.double, label %floating.integer\n",
        "floating.double:\n",
        "  %double = bitcast i64 %word to double\n",
        "  br label %floating.print\n",
        "floating.integer:\n",
        "  br i1 %signed, label %floating.signed, label %floating.unsigned\n",
        "floating.signed:\n",
        "  %signed.double = sitofp i64 %word to double\n",
        "  br label %floating.print\n",
        "floating.unsigned:\n",
        "  %unsigned.double = uitofp i64 %word to double\n",
        "  br label %floating.print\n",
        "floating.print:\n",
        "  %number.double = phi double [ %extended, %floating.single ], [ %double, %floating.double ], [ %signed.double, %floating.signed ], [ %unsigned.double, %floating.unsigned ]\n",
        "  %number.bits = bitcast double %number.double to i64\n",
        "  %float.length = call i32 @chibi_format_number(ptr %scratch, ptr %conversion, i64 %number.bits, i1 true, i1 true)\n",
        "  br label %numeric.done\n",
        "integer.kind:\n",
        "  %character = icmp eq i8 %numeric.letter, 99\n",
        "  br i1 %character, label %character.print, label %integer.width\n",
        "character.print:\n",
        "  %byte.word = and i64 %word, 255\n",

        "  %character.length = call i32 @chibi_format_number(ptr %scratch, ptr %conversion, i64 %byte.word, i1 false, i1 false)\n",
        "  br label %numeric.done\n",
        "integer.width:\n",
        "  br i1 %wide, label %integer.wide, label %integer.narrow\n",
        "integer.wide:\n",
        "  %wide.length = call i32 @chibi_format_number(ptr %scratch, ptr %conversion, i64 %word, i1 false, i1 true)\n",
        "  br label %numeric.done\n",
        "integer.narrow:\n",

        "  %narrow.length = call i32 @chibi_format_number(ptr %scratch, ptr %conversion, i64 %word, i1 false, i1 false)\n",
        "  br label %numeric.done\n",
        "numeric.done:\n",
        "  %printed = phi i32 [ %float.length, %floating.print ], [ %character.length, %character.print ], [ %wide.length, %integer.wide ], [ %narrow.length, %integer.narrow ]\n",
        "  %end.p = getelementptr inbounds i8, ptr %scratch, i32 255\n",
        "  store i8 0, ptr %end.p\n",
        "  %negative = icmp slt i32 %printed, 0\n",
        "  %oversized = icmp sgt i32 %printed, 255\n",
        "  %truncated = or i1 %negative, %oversized\n",
        "  %numeric.length = select i1 %truncated, i32 255, i32 %printed\n",
        "  br label %finish\n",
        "; Container modifiers are ignored, matching fmt_modifier's SINGLE gate.\n",
        "summary:\n",
        "  %digits = alloca [10 x i8]\n",
        "  %count.p = getelementptr inbounds %chibi_format_value, ptr %value, i32 0, i32 1\n",
        "  %count = load i32, ptr %count.p\n",
        "  %prefix = select i1 %is.array, ptr @chibi_format_array, ptr @chibi_format_map\n",
        "  %prefix.length = select i1 %is.array, i32 6, i32 4\n",
        "  call void @chibi_copy(ptr %scratch, ptr %prefix, i32 %prefix.length)\n",
        "  br label %summary.digit\n",
        "summary.digit:\n",
        "  %summary.number = phi i32 [ %count, %summary ], [ %quotient, %summary.digit ]\n",
        "  %digit.at = phi i32 [ 0, %summary ], [ %digit.next, %summary.digit ]\n",
        "  %digit = urem i32 %summary.number, 10\n",
        "  %digit.byte = trunc i32 %digit to i8\n",
        "  %summary.character = add i8 %digit.byte, 48\n",
        "  %digit.p = getelementptr inbounds i8, ptr %digits, i32 %digit.at\n",
        "  store i8 %summary.character, ptr %digit.p\n",
        "  %quotient = udiv i32 %summary.number, 10\n",
        "  %digit.next = add i32 %digit.at, 1\n",
        "  %more.digits = icmp ne i32 %quotient, 0\n",
        "  br i1 %more.digits, label %summary.digit, label %summary.copy\n",
        "summary.copy:\n",
        "  %copy.at = phi i32 [ 0, %summary.digit ], [ %copy.next, %summary.copy ]\n",
        "  %copy.next = add i32 %copy.at, 1\n",
        "  %reversed = sub i32 %digit.next, %copy.next\n",
        "  %copy.source = getelementptr inbounds i8, ptr %digits, i32 %reversed\n",
        "  %copy.byte = load i8, ptr %copy.source\n",
        "  %summary.offset = add i32 %prefix.length, %copy.at\n",
        "  %copy.destination = getelementptr inbounds i8, ptr %scratch, i32 %summary.offset\n",
        "  store i8 %copy.byte, ptr %copy.destination\n",
        "  %copied = icmp eq i32 %copy.next, %digit.next\n",
        "  br i1 %copied, label %summary.done, label %summary.copy\n",
        "summary.done:\n",
        "  %summary.end = add i32 %prefix.length, %digit.next\n",
        "  %summary.close = getelementptr inbounds i8, ptr %scratch, i32 %summary.end\n",
        "  store i8 93, ptr %summary.close\n",
        "  %summary.length = add i32 %summary.end, 1\n",
        "  br label %finish\n",
        "finish:\n",
        "  %output.bytes = phi ptr [ %scratch, %text.copy ], [ %bytes, %text.raw ], [ %bool.bytes, %boolean ], [ %scratch, %numeric.done ], [ %scratch, %summary.done ]\n",
        "  %output.length = phi i32 [ %width, %text.copy ], [ %raw.length, %text.raw ], [ %bool.length, %boolean ], [ %numeric.length, %numeric.done ], [ %summary.length, %summary.done ]\n",
        "  %r0 = insertvalue %chibi_format_text zeroinitializer, ptr %output.bytes, 0\n",
        "  %r1 = insertvalue %chibi_format_text %r0, i32 %output.length, 1\n",
        "  ret %chibi_format_text %r1\n",
        "}\n",
        "\n"
    ]);
}

FormatWalk :: () -> string {
    return Join([
        "; Two linear walks: render at most 12 holes once, allocate the exact output,\n",
        "; then copy literals and those rendered values. Explicit indexes do not\n",
        "; advance the sequential index; missing values and holes after 12 emit nothing.\n",
        "define internal void @chibi_format_text(ptr %ctx, ptr %values, i32 %count, ptr %result) {\n",
        "entry:\n",
        "  %rendered = alloca [12 x %chibi_format_text]\n",
        "  %scratch = alloca [12 x [256 x i8]]\n",
        "  %buffer.slot = alloca ptr\n",
        "  %owner.slot = alloca ptr\n",
        "  %pass.slot = alloca i1\n",
        "  %position.slot = alloca i32\n",
        "  %sequential.slot = alloca i32\n",
        "  %used.slot = alloca i32\n",
        "  %parsing.slot = alloca i1\n",
        "  %length.slot = alloca i64\n",
        "  %fmt.length.p = getelementptr inbounds %chibi_format_value, ptr %values, i32 0, i32 1\n",
        "  %fmt.length = load i32, ptr %fmt.length.p\n",
        "  %fmt.bytes.p = getelementptr inbounds %chibi_format_value, ptr %values, i32 0, i32 3\n",
        "  %fmt = load ptr, ptr %fmt.bytes.p\n",
        "  %input.count = sub i32 %count, 1\n",
        "  store ptr null, ptr %buffer.slot\n",
        "  store ptr null, ptr %owner.slot\n",
        "  store i1 false, ptr %pass.slot\n",
        "  br label %begin\n",
        "begin:\n",
        "  store i32 0, ptr %position.slot\n",
        "  store i32 0, ptr %sequential.slot\n",
        "  store i32 0, ptr %used.slot\n",
        "  store i1 true, ptr %parsing.slot\n",
        "  store i64 0, ptr %length.slot\n",
        "  %writing = load i1, ptr %pass.slot\n",
        "  %buffer = load ptr, ptr %buffer.slot\n",
        "  br label %walk\n",
        "walk:\n",
        "  %at = load i32, ptr %position.slot\n",
        "  %length = load i64, ptr %length.slot\n",
        "  %more = icmp slt i32 %at, %fmt.length\n",
        "  br i1 %more, label %step, label %pass.done\n",
        "step:\n",
        "  %byte.p = getelementptr inbounds i8, ptr %fmt, i32 %at\n",
        "  %byte = load i8, ptr %byte.p\n",
        "  %after = add i32 %at, 1\n",
        "  %open = icmp eq i8 %byte, 123\n",
        "  %close = icmp eq i8 %byte, 125\n",
        "  %brace = or i1 %open, %close\n",
        "  %has.after = icmp slt i32 %after, %fmt.length\n",
        "  %can.escape = and i1 %brace, %has.after\n",
        "  br i1 %can.escape, label %escape.check, label %hole.check\n",
        "escape.check:\n",
        "  %next.p = getelementptr inbounds i8, ptr %fmt, i32 %after\n",
        "  %next.byte = load i8, ptr %next.p\n",
        "  %escaped = icmp eq i8 %next.byte, %byte\n",
        "  br i1 %escaped, label %escape, label %hole.check\n",
        "escape:\n",
        "  %skip = add i32 %at, 2\n",
        "  br label %literal\n",
        "hole.check:\n",
        "  %parsing = load i1, ptr %parsing.slot\n",
        "  %can.parse = and i1 %open, %parsing\n",
        "  br i1 %can.parse, label %hole.parse, label %plain\n",
        "hole.parse:\n",
        "  %hole = call %chibi_format_hole @chibi_format_parse(ptr %fmt, i32 %fmt.length, i32 %at)\n",
        "  %end = extractvalue %chibi_format_hole %hole, 0\n",
        "  %unterminated = icmp slt i32 %end, 0\n",
        "  %keep.parsing = xor i1 %unterminated, true\n",
        "  store i1 %keep.parsing, ptr %parsing.slot\n",
        "  %valid.hole = icmp sgt i32 %end, 0\n",
        "  br i1 %valid.hole, label %hole.index, label %plain\n",
        "plain:\n",
        "  br label %literal\n",
        "literal:\n",
        "  %literal.next = phi i32 [ %skip, %escape ], [ %after, %plain ]\n",
        "  store i32 %literal.next, ptr %position.slot\n",
        "  br i1 %writing, label %literal.write, label %literal.done\n",
        "literal.write:\n",
        "  %destination = getelementptr inbounds i8, ptr %buffer, i64 %length\n",
        "  store i8 %byte, ptr %destination\n",
        "  br label %literal.done\n",
        "literal.done:\n",
        "  %length.one = add i64 %length, 1\n",
        "  store i64 %length.one, ptr %length.slot\n",
        "  br label %walk\n",
        "hole.index:\n",
        "  store i32 %end, ptr %position.slot\n",
        "  %index = extractvalue %chibi_format_hole %hole, 1\n",
        "  %implicit = icmp slt i32 %index, 0\n",
        "  br i1 %implicit, label %hole.sequential, label %hole.validate\n",
        "hole.sequential:\n",
        "  %sequential = load i32, ptr %sequential.slot\n",
        "  %sequential.next = add i32 %sequential, 1\n",
        "  store i32 %sequential.next, ptr %sequential.slot\n",
        "  br label %hole.validate\n",
        "hole.validate:\n",
        "  %selected = phi i32 [ %index, %hole.index ], [ %sequential, %hole.sequential ]\n",
        "  %used = load i32, ptr %used.slot\n",
        "  %provided = icmp slt i32 %selected, %input.count\n",
        "  %selected.bounded = icmp ult i32 %selected, 12\n",
        "  %used.bounded = icmp ult i32 %used, 12\n",
        "  %valid.index = and i1 %provided, %selected.bounded\n",
        "  %available = and i1 %valid.index, %used.bounded\n",
        "  br i1 %available, label %hole.rendered, label %walk\n",
        "hole.rendered:\n",
        "  %render.p = getelementptr inbounds [12 x %chibi_format_text], ptr %rendered, i32 0, i32 %used\n",
        "  br i1 %writing, label %hole.copy, label %hole.render\n",
        "hole.render:\n",
        "  %input = add i32 %selected, 1\n",
        "  %value = getelementptr inbounds %chibi_format_value, ptr %values, i32 %input\n",
        "  %mods = extractvalue %chibi_format_hole %hole, 2\n",
        "  %size = extractvalue %chibi_format_hole %hole, 3\n",
        "  %mods.p = getelementptr inbounds i8, ptr %fmt, i32 %mods\n",
        "  %scratch.p = getelementptr inbounds [12 x [256 x i8]], ptr %scratch, i32 0, i32 %used\n",
        "  %text = call %chibi_format_text @chibi_format_render(ptr %value, ptr %mods.p, i32 %size, ptr %scratch.p)\n",
        "  store %chibi_format_text %text, ptr %render.p\n",
        "  br label %hole.done\n",
        "hole.copy:\n",
        "  %rendered.text = load %chibi_format_text, ptr %render.p\n",
        "  %text.bytes = extractvalue %chibi_format_text %rendered.text, 0\n",
        "  %text.length = extractvalue %chibi_format_text %rendered.text, 1\n",
        "  %text.dest = getelementptr inbounds i8, ptr %buffer, i64 %length\n",
        "  call void @chibi_copy(ptr %text.dest, ptr %text.bytes, i32 %text.length)\n",
        "  br label %hole.done\n",
        "hole.done:\n",
        "  %current.text = phi %chibi_format_text [ %text, %hole.render ], [ %rendered.text, %hole.copy ]\n",
        "  %current.length = extractvalue %chibi_format_text %current.text, 1\n",
        "  %current.wide = zext i32 %current.length to i64\n",
        "  %sum = add i64 %length, %current.wide\n",
        "  store i64 %sum, ptr %length.slot\n",
        "  %used.next = add i32 %used, 1\n",
        "  store i32 %used.next, ptr %used.slot\n",
        "  %unconsumed = sub i32 %fmt.length, %end\n",
        "  %unconsumed.wide = zext i32 %unconsumed to i64\n",
        "  %maximum = add i64 %sum, %unconsumed.wide\n",
        "  %overflow = icmp ugt i64 %maximum, 2147483647\n",
        "  br i1 %overflow, label %failed, label %walk\n",
        "pass.done:\n",
        "  br i1 %writing, label %finish, label %allocate\n",
        "allocate:\n",
        "; The existing counted text layout: refs, length, bytes, NUL/padding.\n",
        "  %capacity = add i64 %length, 17\n",
        "  %allocator.at = getelementptr { ptr, ptr, ptr, ptr, ptr }, ptr %ctx, i32 0, i32 2\n",
        "  %allocator = load ptr, ptr %allocator.at\n",
        "  %allocation = call ptr %allocator(ptr %ctx, i64 %capacity)\n",
        "  store i64 1, ptr %allocation\n",
        "  %allocation.size = getelementptr inbounds i8, ptr %allocation, i64 8\n",
        "  %allocation.length = trunc i64 %length to i32\n",
        "  store i32 %allocation.length, ptr %allocation.size\n",
        "  %allocation.bytes = getelementptr inbounds i8, ptr %allocation, i64 12\n",
        "  store ptr %allocation, ptr %owner.slot\n",
        "  store ptr %allocation.bytes, ptr %buffer.slot\n",
        "  store i1 true, ptr %pass.slot\n",
        "  br label %begin\n",
        "finish:\n",
        "  %terminator = getelementptr inbounds i8, ptr %buffer, i64 %length\n",
        "  store i8 0, ptr %terminator\n",
        "  %output.length = trunc i64 %length to i32\n",
        "  br label %return\n",
        "failed:\n",
        "  br label %return\n",
        "return:\n",
        "  %output.bytes = phi ptr [ %buffer, %finish ], [ null, %failed ]\n",
        "  %output.size = phi i32 [ %output.length, %finish ], [ 0, %failed ]\n",
        "  %output.owner = load ptr, ptr %owner.slot\n",
        "  store ptr %output.bytes, ptr %result\n",
        "  %result.length = getelementptr inbounds { ptr, i32, ptr }, ptr %result, i32 0, i32 1\n",
        "  store i32 %output.size, ptr %result.length\n",
        "  %result.owner = getelementptr inbounds { ptr, i32, ptr }, ptr %result, i32 0, i32 2\n",
        "  store ptr %output.owner, ptr %result.owner\n",
        "  ret void\n",
        "}\n"
    ]);
}


FormatNumbers :: (windows: bool) -> string {
    if (windows) {
        return Join([
            "; chibi-import system:ucrtbase __stdio_common_vsprintf\n",
            "declare dllimport i32 @__stdio_common_vsprintf(i64, ptr, i64, ptr, ptr, ptr)\n",
            "define internal i32 @chibi_format_number(ptr %buffer, ptr %conversion, i64 %word, i1 %floating, i1 %wide) {\n",
            "  %argument = alloca i64\n",
            "  store i64 %word, ptr %argument\n",
            "  %length = call i32 @__stdio_common_vsprintf(i64 34, ptr %buffer, i64 256, ptr %conversion, ptr null, ptr %argument)\n",
            "  ret i32 %length\n",
            "}\n"
        ]);
    }
    return Join([
        "declare i32 @snprintf(ptr, i64, ptr, ...)\n",
        "define internal i32 @chibi_format_number(ptr %buffer, ptr %conversion, i64 %word, i1 %floating, i1 %wide) {\n",
        "  br i1 %floating, label %float, label %integer\n",
        "float:\n",
        "  %value = bitcast i64 %word to double\n",
        "  %float.length = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buffer, i64 256, ptr %conversion, double %value)\n",
        "  ret i32 %float.length\n",
        "integer:\n",
        "  br i1 %wide, label %long, label %short\n",
        "long:\n",
        "  %long.length = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buffer, i64 256, ptr %conversion, i64 %word)\n",
        "  ret i32 %long.length\n",
        "short:\n",
        "  %narrow = trunc i64 %word to i32\n",
        "  %short.length = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buffer, i64 256, ptr %conversion, i32 %narrow)\n",
        "  ret i32 %short.length\n",
        "}\n"
    ]);
}
