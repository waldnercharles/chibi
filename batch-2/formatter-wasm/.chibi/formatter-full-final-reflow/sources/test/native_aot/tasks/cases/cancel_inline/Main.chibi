package task_cancel_inline
Main :: () -> int {
    parent := Parent();
    cancel parent
    yield
    yield
    if (Count(false) != 0) { return 1; }
    return 0;
}
Parent :: () -> int {
    value := await Child();
    return value;
}
Child :: () -> int {
    yield
    yield
    Count(true);
    return 1;
}
Count :: (increment: bool) -> int {
    count: retain int = 0;
    if (increment) { count += 1; }
    return count;
}
