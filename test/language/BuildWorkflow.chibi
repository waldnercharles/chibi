BuildWorkflow :: library {
    Build :: () -> int {
        configure := RunBuildStep([
            "cmake", "-S", ".", "-B", "build self-hosting",
            "-DCHIBI_NOTE=space \"quote\";$literal*"
        ]);
        if (configure != 0) {
            return configure;
        }
        return RunBuildStep(["cmake", "--build", "build self-hosting"]);
    }
}
