package compiler_syntax

import syntax "project:syntax_diagnostics"

Tree :: union {
    Parsed(nodes: syntax.Node[], fields: string[], is_named: bool[], is_extra: bool[], root: int)
}

// The private parser returns aligned columns of public tree facts. An explicit
// read-only count keeps the ordinary record-array builder's loop-bound proof.
Assemble :: (count: int, kinds: string[], starts: int[], ends: int[],
             rows: int[], columns: int[], parents: int[],
             first_children: int[], next_siblings: int[],
             errors: bool[], missing: bool[], has_errors: bool[]) -> syntax.Node[] {
    nodes: syntax.Node[] = [];
    index: int = 0;
    while (index < count) {
        node: syntax.Node = {
            kind: kinds[index], start: starts[index], end: ends[index],
            row: rows[index], column: columns[index], parent: parents[index],
            first_child: first_children[index], next_sibling: next_siblings[index],
            error: errors[index], missing: missing[index], has_error: has_errors[index]
        };
        nodes.append(node);
        index += 1;
    }
    return nodes;
}

pub Parse :: (text: string) -> Tree {
    raw := compiler_syntax_parse(text);
    nodes := Assemble(length(raw.kinds), raw.kinds, raw.starts, raw.ends,
                      raw.rows, raw.columns, raw.parents, raw.first_children,
                      raw.next_siblings, raw.errors, raw.missing, raw.has_errors);
    return Tree.Parsed(nodes, raw.fields, raw.is_named, raw.is_extra, raw.root);
}
