version 3
name "OutlinerRows"
id_counter 423
description "Shows the Outliner's rows: the scene's root row, then the window of objects the object filter shows that the List asks for (ShowRows), refreshed with each UI refresh; folds the root, and scrolls an object Studio reveals into view."
owner_type "ecs.entity"
(array)variables {
    - id=1 name="First" type="int" category="Window"
    - id=2 name="Count" type="int" category="Window"
    - id=3 name="Collapsed" type="bool" category="View"
    - id=4 name="ShownOpen" type="bool" category="View" default=#true
}
