MovementTrailBehavior :: behavior {
    // The last frame step, for actions and functions.
    Step: number = 0
    on Tick :: (dt: number s) {
        Step = dt
    }
    Particle_Carry := 0.0
    on Input :: (Direction: vec2) {
        if Is_Stationary(Direction) {
            Particle_Carry = 0.0
        } else {
            await Emit_Movement_Trail(Direction)
        }
    }
    Emit_Movement_Trail :: (Direction: vec2 = null) {

        Particle_Carry = Particle_Carry + Emission_Budget(Step)
        while Particle_Carry >= 1.0 {
            await emit_directed_particles(transform_to_cf(self.Transform) + vec2_norm(Direction) * -1.0 * 9.0, vec2_norm(Direction) * -1.0, 1, 4288223999, 1291911040, 30.0, 60.0, 0.2, 0.4, 2.0, 4.0, 1.571, 4.0, 8.0, 0.2, 0.4, 1.5, 0.0, 0)
            Particle_Carry = Particle_Carry - 1.0
        }
        return
    }
    Emission_Budget :: (dt: number = 0.0) -> (Result: number = 0.0) {
        return number(clamp(dt, real(0.0), real(0.10000000149011612)) * real(64.0))
    }
    Is_Stationary :: (Direction: vec2 = null) -> (Stationary: bool = false) {

        return 0.0 >= Direction.x * Direction.x + Direction.y * Direction.y
    }
}
