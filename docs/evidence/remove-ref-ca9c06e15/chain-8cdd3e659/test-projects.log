       /tmp/chibi-cli-Nq0UwO/bin/chibi export [PROJECT] --output DIR [--web PLAYER] [--archive]
       /tmp/chibi-cli-Nq0UwO/bin/chibi web [PROJECT] --player PLAYER [--port PORT]
