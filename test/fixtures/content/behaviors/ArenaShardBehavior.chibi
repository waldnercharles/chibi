// The twelve original box-frame beams keep their source pose and material,
// separate outward, tumble at independent rates, arc above the floor, and
// shrink away after 0.55 seconds.
ArenaShardBehavior :: behavior {
    // The last frame step, for actions and functions.
    Step: float = 0
    // State
    Age: float = 0.0
    Pitch_Rate: float = 0.0
    Roll_Rate: float = 0.0
    Lift: float = 0.0
    Birth_Scale: float = 1.0
    on Tick :: (dt: float s) {
        Step = dt
        Age = Age + Step
        if Age_Phase(Age, Step) >= 1.0 {
            destroy_entity(self)
        } else {
            await Advance_Shard_Motion(Step, Age)
        }
    }
    on Begin :: () {
        await Initialize_Shard(self.VisualTransform.scale, random_range(-6.0, 6.0), random_range(-7.0, 7.0), random_range(18.0, 42.0))
    }
    Age_Phase :: (Age: float = 0.0, Delta: float = 0.0) -> (Result: float = 0.0) {
        return float((Age + Delta) / real(0.55))
    }
    Fade :: (Normalized: float = 0.0) -> (Result: double = 0.0) {
        return (real(1.0) - Normalized) * (real(1.0) - Normalized)
    }
    Position_X :: (PositionX: float = 0.0, VelocityX: float = 0.0, Delta: float = 0.0) -> (Result: float = 0.0) {
        return PositionX + VelocityX * Delta
    }
    Position_Y :: (PositionY: float = 0.0, VelocityY: float = 0.0, Delta: float = 0.0) -> (Result: float = 0.0) {
        return PositionY + VelocityY * Delta
    }
    Pitch :: (Pitch: float = 0.0, PitchRate: float = 0.0, Delta: float = 0.0) -> (Result: float = 0.0) {
        return Pitch + PitchRate * Delta
    }
    Roll :: (Roll: float = 0.0, RollRate: float = 0.0, Delta: float = 0.0) -> (Result: float = 0.0) {
        return Roll + RollRate * Delta
    }
    Initialize_Shard :: (scale: float = 0.0, Pitch_Rate: double = 0.0, Roll_Rate: double = 0.0, Lift: double = 0.0) {
        Birth_Scale = scale
        state.Pitch_Rate = float(Pitch_Rate)
        state.Roll_Rate = float(Roll_Rate)
        state.Lift = float(Lift)
        return
    }
    Advance_Shard_Motion :: (Seconds: float = 0.0, Age: float = 0.0) {
        self.Transform.x = Position_X(self.Transform.x, self.Velocity.x, Seconds)
        self.Transform.y = Position_Y(self.Transform.y, self.Velocity.y, Seconds)
        self.VisualTransform.pitch = Pitch(self.VisualTransform.pitch, Pitch_Rate, Seconds)
        self.VisualTransform.roll = Roll(self.VisualTransform.roll, Roll_Rate, Seconds)
        self.VisualTransform.scale = float(Birth_Scale * Fade(Age_Phase(Age, Seconds)))
        self.Geometry3D.elevation = float(self.Geometry3D.elevation + double(Lift * Seconds))
        Lift = float(Lift - multiply(Seconds, B: plain double = 90.0))
        return
    }
}
