package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("version", data.Value.UInt(1)),
            data.Field.Named("name", data.Value.Text("Start")),
            data.Field.Named("entities", data.List([
                data.Object([
                    data.Field.Named("name", data.Value.Text("Camera")),
                    data.Field.Named("prototype", data.Value.Text("Camera"))
                ]),
                data.Object([
                    data.Field.Named("name", data.Value.Text("Recharge")),
                    data.Field.Named("prototype", data.Value.Text("RechargeSystem"))
                ]),
                data.Object([
                    data.Field.Named("name", data.Value.Text("Cell")),
                    data.Field.Named("prototype", data.Value.Text("Battery"))
                ]),
                data.Object([
                    data.Field.Named("name", data.Value.Text("Spare")),
                    data.Field.Named("prototype", data.Value.Text("Battery")),
                    data.Field.Named("components", data.Object([
                        data.Field.Named("Charge", data.Object([
                            data.Field.Named("level", data.Value.Real(1.5)),
                            data.Field.Named("rate", data.Value.Real(0.5)),
                            data.Field.Named("capacity", data.Value.Real(2.0)),
                            data.Field.Named("drift", data.Object([
                                data.Field.Named("x", data.Value.Real(1.0)),
                                data.Field.Named("y", data.Value.Real(-1.0))
                            ]))
                        ]))
                    ]))
                ])
            ]))
        ])
    );
}
