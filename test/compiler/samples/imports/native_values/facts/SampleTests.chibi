package facts

// native values
@test
Calls :: () {
    a1_0: int[] = [1, 2, 3];
    r1: int = LentLength(a1_0);
    e1: int = 6;
    assert(r1 == e1, "LentLength call 1");
    a2_0: int[] = [];
    r2: int = LentLength(a2_0);
    e2: int = 0;
    assert(r2 == e2, "LentLength call 2");
    a3_0: int[] = [1, 2, 3];
    r3: int = LentSlice(a3_0);
    e3: int = 337;
    assert(r3 == e3, "LentSlice call 3");
    a4_0: int[] = [1, 2, 3];
    r4: int[] = LentReturn(a4_0);
    e4: int[] = [2];
    assert(length(r4) == length(e4), "LentReturn call 4 length");
    for k in 0..<length(e4) {
        assert(r4[k] == e4[k], "LentReturn call 4 element");
    }
    r5: int = CopiedElement();
    e5: int = 2;
    assert(r5 == e5, "CopiedElement call 5");
}
