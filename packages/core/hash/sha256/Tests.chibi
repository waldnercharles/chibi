package sha256

import strings "core:strings"

Same :: (a: u8[], b: u8[]) -> bool {
    if length(a) != length(b) {
        return false;
    }
    i := 0;
    while i < length(a) {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    return true;
}

// The ASCII bytes of text, for the published vectors below.
Ascii :: (text: string) -> u8[] {
    data: u8[] = [];
    for (byte in strings.Bytes(text)) {
        data.append(u8(byte));
    }
    return data;
}

@test
PublishedFips180Vectors :: () {
    empty: u8[] = [];
    // e3b0c442 98fc1c14 9afbf4c8 996fb924 27ae41e4 649b934c a495991b 7852b855
    assert(Same(Sum(empty), [227, 176, 196, 66, 152, 252, 28, 20, 154, 251, 244, 200, 153, 111, 185, 36,
                             39, 174, 65, 228, 100, 155, 147, 76, 164, 149, 153, 27, 120, 82, 184, 85]));
    // ba7816bf 8f01cfea 414140de 5dae2223 b00361a3 96177a9c b410ff61 f20015ad
    assert(Same(Sum(Ascii("abc")), [186, 120, 22, 191, 143, 1, 207, 234, 65, 65, 64, 222, 93, 174, 34, 35,
                                    176, 3, 97, 163, 150, 23, 122, 156, 180, 16, 255, 97, 242, 0, 21, 173]));
    // 56 bytes: the padding needs a second block.
    // 248d6a61 d20638b8 e5c02693 0c3e6039 a33ce459 64ff2167 f6ecedd4 19db06c1
    assert(Same(Sum(Ascii("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")),
                [36, 141, 106, 97, 210, 6, 56, 184, 229, 192, 38, 147, 12, 62, 96, 57,
                 163, 60, 228, 89, 100, 255, 33, 103, 246, 236, 237, 212, 25, 219, 6, 193]));
    // 112 bytes: two whole blocks read in place, then a padding-only block.
    // cf5b16a7 78af8380 036ce59e 7b049237 0b249b11 e8f07a51 afac4503 7afee9d1
    assert(Same(Sum(Ascii("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")),
                [207, 91, 22, 167, 120, 175, 131, 128, 3, 108, 229, 158, 123, 4, 146, 55,
                 11, 36, 155, 17, 232, 240, 122, 81, 175, 172, 69, 3, 122, 254, 233, 209]));
    return;
}

@test
DigestHasThirtyTwoBytesAndLeavesInputUnchanged :: () {
    data: u8[] = [0, 255, 128, 1];
    digest := Sum(data);
    assert(length(digest) == DigestBytes);
    assert(Same(data, [0, 255, 128, 1]));
    assert(Same(Sum(data), digest));
    return;
}

@test
PaddingBoundariesChangeTheDigest :: () {
    // 55 bytes fit one block with the marker and length; 56 and 64 need two.
    previous: u8[] = [];
    count := 54;
    while count <= 65 {
        data: u8[] = [];
        i := 0;
        while i < count {
            data.append(u8(97));
            i += 1;
        }
        digest := Sum(data);
        assert(length(digest) == DigestBytes);
        assert(!Same(previous, digest));
        previous = digest;
        count += 1;
    }
    return;
}

@test
HexSpellsTheDigestInLowercase :: () {
    assert(Hex("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
    assert(Hex("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
}
