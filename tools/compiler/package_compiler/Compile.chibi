package package_compiler

import snapshot "project:source_snapshot"
import routes "project:package_routes"
import graph "project:package_graph"
import binding "project:lexical_binding"
import syntax "project:syntax_diagnostics"
import writer "project:prepared_writer"
import strings "core:strings"

// Compiles packages of functions, records and unions, and the packages they
// import, to a prepared closure. Stage zero builds this compiler; everything
// after the raw parser is authored.

// Facts of the runtime this compiler targets, which Chibi cannot see: pointer
// width, the byte offsets of a value header's and an array's members, and the
// failure kinds a host call and a failed assertion report.
pub Target :: struct {
    pointer_storage: int;
    pointer_size: int;
    value_size: int;
    payload_offset: int;
    arguments_offset: int;
    delta_seconds_offset: int;
    results_offset: int;
    error_status_offset: int;
    type_offset: int;
    container_offset: int;
    name_offset: int;
    record_offset: int;
    schema_offset: int;
    count_offset: int;
    items_offset: int;
    data_offset: int;
    stride_offset: int;
    map_count_offset: int;
    data_failure: int;
    argument_failure: int;
    // The failure kind of an assert whose condition is false.
    assert_failure: int;
}
// Prepared instructions this compiler emits, as ordinals on the target.
Ops :: struct {
    constant: int;
    argument: int;
    local: int;
    save: int;
    context: int;
    array: int;
    host_slot: int;
    string_equal: int;
    index: int;
    load: int;
    write: int;
    result: int;
    host_call: int;
    command_argument: int;
    command_begin: int;
    command_result: int;
    command_output: int;
    suspend: int;
    invoke: int;
    guard: int;
    check: int;
    branch_if: int;
    jump: int;
    finish: int;
    end: int;
    add: int;
    sub: int;
    mul: int;
    div: int;
    mod: int;
    neg: int;
    bit_and: int;
    bit_or: int;
    bit_xor: int;
    bit_not: int;
    shl: int;
    shr: int;
    lt: int;
    le: int;
    gt: int;
    ge: int;
    eq: int;
    ne: int;
    cast: int;
    select: int;
    variable: int;
    store: int;
    store_value: int;
    owner: int;
    query_variable: int;
    convert: int;
    source_point: int;
    source_watch: int;
    // Whether the code carries debugger points and watches.
    debug: bool;
}
// A type: a storage code, whether it is an array, and for records, unions and
// arrays of them the index of their declaration in `types`.
ValueType :: struct {
    storage: int;
    container: int;
    record: int;
}
// A function of package `package`; its parameters are params[first, first +
// count). It has one `result` of its own type, storage 0 for none, or
// `results` named results, the params after its parameters.
Callable :: struct {
    name: string;
    package: int;
    document: int;
    node: int;
    first: int;
    count: int;
    result: int;
    result_container: int;
    result_record: int;
    results: int;
    waits: bool;
}
// A function's parameters, then its named results, and its callable.
Signature :: union {
    Failed(diagnostic: syntax.Diagnostic) | Read(callable: Callable, added: Param[])
}
Param :: struct {
    name: string;
    storage: int;
    container: int;
    record: int;
    // A literal default a call that omits the argument passes: its bits, or
    // its text for a string.
    has_default: bool;
    default_bits: u64;
    default_text: string;
    // The occurrence of the default's expression, which stage zero evaluates
    // where a call omits the argument.
    default_occurrence: u64;
    // A scoped pointer parameter, whose argument is a reference to the
    // caller's location.
    reference: bool;
    // The node that declares the parameter, -1 when the source declares none.
    node: int;
}
// A native function the target links, as its catalog describes it. Its
// parameters and then its results are ports[first, first + parameters +
// results); its ID and ABI are identities[2 * index] and [2 * index + 1]. A
// variadic native's last parameter takes any number of arguments, none
// included.
pub Native :: struct {
    name: string;
    first: int;
    parameters: int;
    results: int;
    variadic: bool;
    effects: int;
}
// Rich catalogs retain function and action declarations with their actual
// names and kinds. `direct` admits only bindings callable as synchronous data;
// unsupported rows remain visible to source name resolution.
pub CatalogNative :: struct {
    name: string;
    first: int;
    parameters: int;
    results: int;
    variadic: bool;
    direct: bool;
    qualified_name: string;
    kind: int;
    intrinsic: int;
    effects: int;
}
ResolvedNative :: struct {
    name: string;
    first: int;
    parameters: int;
    results: int;
    variadic: bool;
    direct: bool;
    qualified_name: string;
    kind: int;
    intrinsic: int;
    // The catalog's declared script effects, such as suspension.
    effects: int;
    // Exact parsed callable IDs identify source-owned rows for this compile.
    source: bool;
}
NativeFunctionKind: int : 0;
NativeActionKind: int : 1;
LegacyNatives :: (natives: Native[], names: string[]) -> ResolvedNative[] {
    resolved: ResolvedNative[] = [];
    for (native in natives) {
        // The stable pure catalog predates linked intrinsic metadata.
        intrinsic: int = 0;
        if (NameMatches("assert", native.name)) {
            intrinsic = Ordinal(names, "ASSERT");
        }
        row: ResolvedNative = {name: native.name, first: native.first, parameters: native.parameters,
                               results: native.results, variadic: native.variadic, direct: true,
                               qualified_name: native.name, kind: NativeFunctionKind, intrinsic: intrinsic,
                               effects: native.effects, source: false};
        resolved.append(row);
    }
    return resolved;
}
CatalogNatives :: (natives: CatalogNative[]) -> ResolvedNative[] {
    resolved: ResolvedNative[] = [];
    for (native in natives) {
        row: ResolvedNative = {name: native.name, first: native.first, parameters: native.parameters,
                               results: native.results, variadic: native.variadic, direct: native.direct,
                               qualified_name: native.qualified_name, kind: native.kind,
                               intrinsic: native.intrinsic, effects: native.effects, source: false};
        resolved.append(row);
    }
    return resolved;
}
// Host kernels have canonical names such as host:clock.Sample. Only the owning
// authored package sees the exact private member. Keep every row's index so its
// ports, effects and identity/ABI pair remain those supplied by the host.
HostPackageAvailable :: (natives: ResolvedNative[], identity: string) -> bool {
    if (!strings.HasPrefix(identity, "host:")) {
        return true;
    }
    prefix := format_text("{}.", identity);
    for (native in natives) {
        if (!native.source && strings.HasPrefix(native.name, prefix)) {
            return true;
        }
    }
    return false;
}

PackageNatives :: (natives: ResolvedNative[], identity: string) -> ResolvedNative[] {
    if (!strings.HasPrefix(identity, "host:")) {
        return natives;
    }
    prefix := format_text("{}.", identity);
    prefix_length := strings.ByteLength(prefix);
    scoped: ResolvedNative[] = [];
    for (item in natives) {
        native := item;
        if (!native.source && strings.HasPrefix(native.name, prefix)) {
            native.name = strings.Slice(native.name, prefix_length, strings.ByteLength(native.name) - prefix_length);
        }
        scoped.append(native);
    }
    return scoped;
}
// A native port. Storage 0 is a type the call infers, one type for every such
// port of the native; AnyPort takes each argument's own type, and
// UnsupportedPort is a type this compiler cannot pass.
pub Port :: struct {
    name: string;
    storage: int;
    container: int;
    c_string: bool;
}
// Rich game ports preserve nominal identity and actual native defaults. The
// game wrapper resolves nominal types before any body is emitted; unsupported
// defaults reject only calls that omit that parameter.
pub CatalogPort :: struct {
    name: string;
    storage: int;
    container: int;
    c_string: bool;
    nominal: u64;
    has_default: bool;
    default_owner: bool;
    default_supported: bool;
    default_bits: u64;
    default_text: string;
}
ResolvedPort :: struct {
    name: string;
    storage: int;
    container: int;
    c_string: bool;
    record: int;
    has_default: bool;
    default_owner: bool;
    default_supported: bool;
    default_bits: u64;
    default_text: string;
}
LegacyPorts :: (ports: Port[]) -> ResolvedPort[] {
    resolved: ResolvedPort[] = [];
    for (port in ports) {
        row: ResolvedPort = {name: port.name, storage: port.storage, container: port.container,
                             c_string: port.c_string, record: -1, has_default: false, default_owner: false,
                             default_supported: false, default_bits: 0, default_text: ""};
        resolved.append(row);
    }
    return resolved;
}
NativeInputValid :: (natives: ResolvedNative[], ports: ResolvedPort[], identities: u64[], effects: int[]) -> bool {
    if (length(identities) != 2 * length(natives) || length(effects) != length(natives)) {
        return false;
    }
    for (effect in effects) {
        if (effect < 0 || effect > NativeEffectsMask) {
            return false;
        }
    }
    for (native in natives) {
        if (native.first < 0 || native.parameters < 0 || native.results < 0 || native.first > length(ports) ||
            native.parameters > length(ports) - native.first ||
            native.results > length(ports) - native.first - native.parameters) {
            return false;
        }
    }
    return true;
}
AnyPort: int : -2;
UnsupportedPort: int : -1;
// A declared type. A record's fields and a variant's payload are
// members[first, first + count); a union's variants are types[first, first +
// count), and each variant names its union as `parent`. A native type, one the
// game links, also has its storage, ID and layout, and a component its
// component ID, and a record or union its package-symbol ID. A map type
// `[K: V]` that a package spells has its key's storage and its value's type,
// and is named as stage zero names it.
TypeDecl :: struct {
    name: string;
    type_name: string;
    package: int;
    // The source declaration, or -1 for a native or synthesized type.
    node: int;
    kind: int;
    first: int;
    count: int;
    size: int;
    parent: int;
    storage: int;
    id: u64;
    layout: u64;
    component: u64;
    key: int;
    value_storage: int;
    value_container: int;
    value_record: int;
}
// A record field, with its byte offset, or a variant's payload field. A
// native type's field may be read-only, a constant whose value is its name,
// or read by natives[read] when that is not -1, with `read_key` instead of
// the value when that is not "".
TypeMember :: struct {
    name: string;
    storage: int;
    container: int;
    record: int;
    offset: int;
    writable: bool;
    c_string: bool;
    constant: bool;
    read: int;
    read_key: string;
}
pub Result :: union {
    Rejected(diagnostic: syntax.Diagnostic) | Compiled(module: u64, bytes: u8[])
}
// Package assembly also returns the effects of its callables, so importers
// reuse their summaries without compiling a dependency's bodies again.
Assembly :: union {
    Rejected(diagnostic: syntax.Diagnostic) | Compiled(module: u64, bytes: u8[], effects: int[])
}
EffectCall :: struct {
    caller: int;
    callee: int;
    task: bool;
}
// The target catalog's READ, WRITE, STRUCTURAL, HOST, SUSPEND, RANDOM and
// INVOCATION_READ bits.
NativeEffectsMask: int : 127;
// A package constant: an integer literal of an integer type, its 64 bits,
// sign-extended for signed types.
ConstDecl :: struct {
    name: string;
    package: int;
    storage: int;
    bits: u64;
    // Where its value is written, until the value is folded.
    node: int;
    file: int;
    folded: bool;
    // The occurrence of the constant's symbol, in its own document.
    occurrence: u64;
}
Declarations :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Collected(callables: Callable[], params: Param[], types: TypeDecl[], members: TypeMember[],
                constants: ConstDecl[])
}

BoolStorage: int : 1;
IntStorage: int : 6;
WordStorage: int : 9;
FloatStorage: int : 10;
DoubleStorage: int : 11;
TextStorage: int : 13;
HandleStorage: int : 14;
StructStorage: int : 15;
UnionStorage: int : 18;
TaskStorage: int : 17;
RecordDecl: int : 0;
UnionDecl: int : 1;
VariantDecl: int : 2;
NativeDecl: int : 3;
// A game namespace, such as SceneGlobals: a native type no module requires.
NamespaceDecl: int : 4;
MapDecl: int : 5;
// Symbol kinds in package-symbol IDs.
FunctionKind: int : 1;
TypeKind: int : 13;
// Runtime intrinsics are host capabilities with this prefix and ABI one.
IntrinsicBase: u64 : 0x4348494900000000;

Ordinal :: (names: string[], name: string) -> int {
    index: int = 0;
    while (index < length(names)) {
        if (names[index] == name) {
            return index;
        }
        index += 1;
    }
    return -1;
}
// The index of `value` in `items`, -1 when absent.
Position :: (items: int[], value: int) -> int {
    index: int = 0;
    while (index < length(items)) {
        if (items[index] == value) {
            return index;
        }
        index += 1;
    }
    return -1;
}
ResolveOps :: (names: string[], debug: bool) -> Ops {
    return {constant: Ordinal(names, "CONSTANT"), argument: Ordinal(names, "ARGUMENT"),
            local: Ordinal(names, "LOCAL"), save: Ordinal(names, "SAVE"), context: Ordinal(names, "CONTEXT"),
            array: Ordinal(names, "ARRAY"), host_slot: Ordinal(names, "HOST_SLOT"),
            string_equal: Ordinal(names, "STRING_EQUAL"), index: Ordinal(names, "INDEX"),
            load: Ordinal(names, "LOAD"), write: Ordinal(names, "WRITE"), result: Ordinal(names, "RESULT"),
            host_call: Ordinal(names, "HOST_CALL"),
            command_argument: Ordinal(names, "COMMAND_ARGUMENT"), command_begin: Ordinal(names, "COMMAND_BEGIN"),
            command_result: Ordinal(names, "COMMAND_RESULT"), command_output: Ordinal(names, "COMMAND_OUTPUT"),
            suspend: Ordinal(names, "SUSPEND"), invoke: Ordinal(names, "INVOKE"), guard: Ordinal(names, "ASSERT"),
            check: Ordinal(names, "CHECK"),
            branch_if: Ordinal(names, "BRANCH"), jump: Ordinal(names, "JUMP"), finish: Ordinal(names, "RETURN"),
            end: Ordinal(names, "END"), add: Ordinal(names, "ADD"), sub: Ordinal(names, "SUB"),
            mul: Ordinal(names, "MUL"), div: Ordinal(names, "DIV"), mod: Ordinal(names, "MOD"),
            neg: Ordinal(names, "NEG"), bit_and: Ordinal(names, "BIT_AND"), bit_or: Ordinal(names, "BIT_OR"),
            bit_xor: Ordinal(names, "BIT_XOR"), bit_not: Ordinal(names, "BIT_NOT"), shl: Ordinal(names, "SHL"),
            shr: Ordinal(names, "SHR"), lt: Ordinal(names, "LT"), le: Ordinal(names, "LE"),
            gt: Ordinal(names, "GT"), ge: Ordinal(names, "GE"), eq: Ordinal(names, "EQ"), ne: Ordinal(names, "NE"),
            cast: Ordinal(names, "CAST"), select: Ordinal(names, "SELECT"), variable: Ordinal(names, "VARIABLE"),
            store: Ordinal(names, "STORE"), store_value: Ordinal(names, "STORE_VALUE"),
            owner: Ordinal(names, "OWNER"), query_variable: Ordinal(names, "QUERY_VARIABLE"), convert: Ordinal(names, "CONVERT"),
            source_point: Ordinal(names, "SOURCE_POINT"), source_watch: Ordinal(names, "SOURCE_WATCH"),
            debug: debug};
}
// Whether the target names every instruction this compiler emits.
Complete :: (ops: Ops) -> bool {
    used: int[] = [ops.constant, ops.argument, ops.local, ops.save, ops.context, ops.array,
                   ops.host_slot, ops.string_equal, ops.index, ops.load, ops.write, ops.result, ops.host_call,
                   ops.command_argument, ops.command_begin, ops.command_result, ops.command_output, ops.suspend,
                   ops.invoke, ops.guard, ops.check, ops.branch_if, ops.jump, ops.finish,
                   ops.end, ops.add, ops.sub, ops.mul, ops.div, ops.mod, ops.neg, ops.bit_and, ops.bit_or,
                   ops.bit_xor, ops.bit_not, ops.shl, ops.shr, ops.lt, ops.le, ops.gt, ops.ge, ops.eq, ops.ne, ops.cast,
                   ops.select, ops.variable, ops.store, ops.store_value, ops.owner, ops.query_variable, ops.convert, ops.source_point,
                   ops.source_watch];
    for (op in used) {
        if (op < 0) {
            return false;
        }
    }
    return true;
}
// The storage of a scalar type, any of which a record field may hold: an
// integer, bool or string; 0 for any other.
ScalarStorage :: (text: string) -> int {
    integer: int = Int8Storage;
    while (integer <= WordStorage) {
        if (text == TypeName(integer)) {
            return integer;
        }
        integer += 1;
    }
    if (text == "i32") {
        return IntStorage;
    }
    if (text == "bool") {
        return BoolStorage;
    }
    if (text == "string") {
        return TextStorage;
    }
    if (text == "number" || text == "f32") {
        return FloatStorage;
    }
    if (text == "f64") {
        return DoubleStorage;
    }
    return 0;
}
// The record or union of `package` named `name`, -1 when none.
FindType :: (types: TypeDecl[], package: int, name: string) -> int {
    index: int = 0;
    while (index < length(types)) {
        declared := types[index];
        if (declared.package == package && declared.kind != VariantDecl && declared.name == name) {
            return index;
        }
        index += 1;
    }
    // Game-native types are shared by every executable source.
    index = 0;
    while (index < length(types)) {
        if (types[index].package == -1 && types[index].name == name) {
            return index;
        }
        index += 1;
    }
    return -1;
}
// The constant of `package` named `name`, -1 when none.
FindConstant :: (constants: ConstDecl[], package: int, name: string) -> int {
    index: int = 0;
    while (index < length(constants)) {
        if (constants[index].package == package && constants[index].name == name) {
            return index;
        }
        index += 1;
    }
    return -1;
}
// The import aliases of file `file`, each a name for the package it imports,
// from the graph's bindings. They are the outermost names of its functions.
Aliases :: (links: graph.Binding[], file: int) -> Name[] {
    aliases: Name[] = [];
    for (link in links) {
        if (link.file == file) {
            alias: Name = {owned: false, name: link.name, place: AliasPlace, index: link.target, storage: 0, container: 0,
                           record: -1, writable: false, node: -1};
            if (link.import_index == -2) {
                alias.place = LibraryPlace;
            }
            aliases.append(alias);
        }
    }
    return aliases;
}
// The index of the type whose ID is `id`, -1 when none.
TypeWithId :: (types: TypeDecl[], id: u64) -> int {
    index: int = 0;
    while (index < length(types)) {
        if (types[index].id == id) {
            return index;
        }
        index += 1;
    }
    return -1;
}
// The variant `name` of union types[of], -1 when none.
FindVariant :: (types: TypeDecl[], of: int, name: string) -> int {
    at := types[of].first;
    while (at < types[of].first + types[of].count) {
        if (types[at].name == name) {
            return at;
        }
        at += 1;
    }
    return -1;
}
// The type a `type` node names: a field type, a record or union of package
// `package` or, qualified by an alias in `names`, of an imported one, or an
// array of one; storage 0 for any other.
ReadType :: (forest: snapshot.SnapshotNode[], text: string, table: ^(TypeDecl[]), names: Name[], package: int,
             node: int) -> ValueType {
    none: ValueType = {storage: 0, container: 0, record: -1};
    view := HasTypeTrait(forest, text, node, "view");
    if (!Is(forest, node, "type") || !ViewTraits(forest, text, node) || Field(forest, node, "arguments") >= 0) {
        return none;
    }
    pointer := TypePointerNode(forest, node);
    if (pointer >= 0) {
        element := ReadType(forest, text, table, names, package, Field(forest, pointer, "target"));
        declared := FindPointer(table^, element, false);
        if (declared < 0) {
            return none;
        }
        return ReadTypeSuffixes(forest, node, table, {storage: PointerStorage, container: 0, record: declared},
                                package, view);
    }
    grouped := TypeGroupNode(forest, node);
    if (grouped >= 0) {
        return ReadTypeSuffixes(forest, node, table, ReadType(forest, text, table, names, package, grouped),
                                package, view);
    }
    map := Field(forest, node, "map");
    if (map >= 0) {
        key := ReadType(forest, text, table, names, package, Field(forest, map, "key"));
        value := ReadType(forest, text, table, names, package, Field(forest, map, "value"));
        declared := FindMap(table^, key, value);
        if (declared < 0) {
            return none;
        }
        return ReadTypeSuffixes(forest, node, table, {storage: UnionStorage, container: MapContainer, record: declared},
                                package, view);
    }
    first := FirstMember(forest, Field(forest, node, "name"));
    name := Text(forest, text, first);
    home := package;
    part := NextMember(forest, first);
    if (part >= 0) {
        home = QualifierOf(forest, text, names, package, first);
        name = Text(forest, text, part);
        if (home < 0 || NextMember(forest, part) >= 0) {
            return none;
        }
    } else if (ScalarStorage(name) != 0) {
        return ReadTypeSuffixes(forest, node, table, {storage: ScalarStorage(name), container: 0, record: -1},
                                package, view);
    }
    declared := FindType(table^, home, name);
    if (declared < 0) {
        return none;
    }
    storage := StructStorage;
    if (table^[declared].kind == NativeDecl || table^[declared].kind == NamespaceDecl) {
        storage = table^[declared].storage;
    } else if (table^[declared].kind == UnionDecl) {
        storage = UnionStorage;
    }
    return ReadTypeSuffixes(forest, node, table, {storage: storage, container: 0, record: declared}, package, view);
}
// Whether the type `node` has the trait `trait`. Native signatures may
// repeat a trait, so look at every trait child.
HasTypeTrait :: (forest: snapshot.SnapshotNode[], text: string, node: int, trait: string) -> bool {
    if (node < 0) {
        return false;
    }
    child := forest[node].first_child;
    while (child >= 0) {
        if (forest[child].field == "trait" && Text(forest, text, child) == trait) {
            return true;
        }
        child = forest[child].next_sibling;
    }
    return false;
}
// Whether every trait of the type `node` is `view`, the only one ReadType
// reads.
ViewTraits :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> bool {
    if (node < 0) {
        return false;
    }
    child := forest[node].first_child;
    while (child >= 0) {
        if (forest[child].field == "trait" && Text(forest, text, child) != "view") {
            return false;
        }
        child = forest[child].next_sibling;
    }
    return true;
}
// Suffixes are applied in source order. int?[] holds optional integers;
// int[]? is an optional array. Pointer presence remains its own nullable flag.
ReadTypeSuffixes :: (forest: snapshot.SnapshotNode[], node: int, table: ^(TypeDecl[]), base: ValueType,
                     package: int, view: bool) -> ValueType {
    value := base;
    if (value.storage == 0) {
        return value;
    }
    child := forest[node].first_child;
    while (child >= 0) {
        token := forest[child].kind;
        if (!forest[child].is_extra && token == "[") {
            if (value.container != 0 || SequenceFlags(table^, value) != 0) {
                EnsureSequenceCollection(table, value, package);
            }
            value = SequenceArrayType(table^, value);
        } else if (!forest[child].is_extra && token == "?") {
            if (value.storage == PointerStorage && value.container == 0) {
                element := PointerElement(table^, Typed(-1, value.storage, value.container, value.record));
                value.record = EnsurePointer(table, element, true, package);
            } else {
                optional := EnsureOptional(table, value, package);
                value = {storage: UnionStorage, container: 0, record: optional};
            }
        }
        child = forest[child].next_sibling;
    }
    if (view) {
        return ReadViewType(table, value, package);
    }
    return value;
}
ReadViewType :: (table: ^(TypeDecl[]), value: ValueType, package: int) -> ValueType {
    element := OptionalElement(table^, Typed(-1, value.storage, value.container, value.record));
    if (element.storage != 0) {
        viewed := ReadViewType(table, element, package);
        if (viewed.storage == 0) {
            return viewed;
        }
        return {storage: UnionStorage, container: 0, record: EnsureOptional(table, viewed, package)};
    }
    if (value.container != ArrayContainer) {
        return {storage: 0, container: 0, record: -1};
    }
    return {storage: value.storage, container: ViewContainer, record: value.record};
}
// The map type keyed by `key` holding `value`, -1 when none is declared.
FindMap :: (types: TypeDecl[], key: ValueType, value: ValueType) -> int {
    index: int = 0;
    while (index < length(types)) {
        declared := types[index];
        if (declared.kind == MapDecl && declared.key == key.storage && declared.value_storage == value.storage &&
            declared.value_container == value.container && declared.value_record == value.record) {
            return index;
        }
        index += 1;
    }
    return -1;
}
// The ID stage zero gives a single key or value type: its storage and the
// ID of the record, union or native type it names.
TypeTag :: (types: TypeDecl[], storage: int, record: int) -> u64 {
    return SemanticTag(types, {storage: storage, container: 0, record: record});
}
// Declares each map type that file `root` spells, inner ones first, when its
// key is a number, bool or string and its value a single value of a type
// this compiler supports. Stage zero names the map's collection type from
// both types.
DeclareMaps :: (forest: snapshot.SnapshotNode[], text: string, types: TypeDecl[], aliases: Name[], package: int,
                root: int) -> TypeDecl[] {
    // A depth-first walk that skips expressions, where no type is spelled,
    // so it visits a small part of the file.
    found: int[] = [];
    pending: int[] = [root];
    top: int = 1;
    while (top > 0) {
        top -= 1;
        node := pending[top];
        kind := forest[node].kind;
        if (kind == "map_type") {
            found.append(node);
        }
        child := forest[node].first_child;
        while (child >= 0 && !Expression(kind)) {
            if (forest[child].is_named && !forest[child].is_extra) {
                if (top < length(pending)) {
                    pending[top] = child;
                } else {
                    pending.append(child);
                }
                top += 1;
            }
            child = forest[child].next_sibling;
        }
    }
    // Candidate map declarations belong to the returned table until accepted.
    known := types;
    at := length(found) - 1;
    while (at >= 0) {
        map := found[at];
        at -= 1;
        key := ReadType(forest, text, &known, aliases, package, Field(forest, map, "key"));
        value := ReadType(forest, text, &known, aliases, package, Field(forest, map, "value"));
        if (key.storage == 0 || key.container != 0 || key.record >= 0 || value.storage == 0 ||
            FindMap(known, key, value) >= 0) {
            continue;
        }
        id := binding.ID("collection-type", format_text("{}:{}:{}", MapContainer, OptionalTag(known, key),
                                                        OptionalTag(known, value)));
        declared: TypeDecl = {name: "", type_name: format_text("__collection_{}", id), package: package, node: -1, kind: MapDecl,
                              first: 0, count: 0, size: 0, parent: -1, storage: UnionStorage, id: id, layout: 0, component: 0,
                              key: key.storage, value_storage: value.storage, value_container: value.container,
                              value_record: value.record};
        known.append(declared);
    }
    return known;
}
// Field width, which is also its alignment, as the runtime lays records out.
FieldSize :: (storage: int, target: Target) -> int {
    if (storage == TextStorage || storage == PointerStorage) {
        return target.pointer_size;
    }
    if (Integer(storage)) {
        return Width(storage) / 8;
    }
    if (storage == FloatStorage) {
        return 4;
    }
    if (storage == DoubleStorage) {
        return 8;
    }
    return 1;
}
AlignTo :: (size: int, alignment: int) -> int {
    rest := size % alignment;
    if (rest == 0) {
        return size;
    }
    return size + alignment - rest;
}
InputFailure :: (document: int, message: string) -> Result {
    diagnostic: syntax.Diagnostic = {start: 0, end: 0, line: 1, column: 1, document: document, message: message};
    return Result.Rejected(diagnostic);
}
AssemblyFailure :: (document: int, message: string) -> Assembly {
    diagnostic: syntax.Diagnostic = {start: 0, end: 0, line: 1, column: 1, document: document, message: message};
    return Assembly.Rejected(diagnostic);
}

// Every record, union and function of each package, dependencies first, so
// a package's declarations follow those of every package it imports.
pub Declare :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], packages: graph.Package[],
                files_of: int[], order: int[], imports: snapshot.ResolvedImport[], links: graph.Binding[],
                target: Target) -> Declarations {
    callables: Callable[] = [];
    params: Param[] = [];
    types: TypeDecl[] = [];
    members: TypeMember[] = [];
    constants: ConstDecl[] = [];
    for (package in order) {
        files := slice(files_of, packages[package].member_start, packages[package].member_count);
        switch DeclarePackage(forest, documents, files, package, packages[package].name, links, target, callables,
                              params, types, members, constants) {
            case .Failed(diagnostic):
                return Declarations.Failed(diagnostic);
            case .Collected(more_callables, more_params, more_types, more_members, more_constants):
                callables = more_callables;
                params = more_params;
                types = more_types;
                members = more_members;
                constants = more_constants;
        }
        // An import alias may not name a declaration of its package.
        for (link in links) {
            if (Position(files, link.file) >= 0 &&
                (FindType(types, package, link.name) >= 0 || FindCallable(callables, package, link.name) >= 0 ||
                 FindConstant(constants, package, link.name) >= 0)) {
                return Declarations.Failed(snapshot.Diagnostic(snapshot.ImportRange(imports[link.import_index]),
                                                               "Package import alias conflicts with a package declaration"));
            }
        }
    }
    return Declarations.Collected(callables, params, types, members, constants);
}
// Adds package `package`'s records, unions, functions and constants, in file
// and source order. Types come first, so any signature or payload may name any
// type.
pub DeclarePackage :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], files: int[],
                       package: int, package_name: string, links: graph.Binding[], target: Target,
                       callables: Callable[], params: Param[], types: TypeDecl[],
                       members: TypeMember[], constants: ConstDecl[]) -> Declarations {
    for (file in files) {
        text := documents[file].text;
        member := FirstMember(forest, documents[file].syntax_root);
        while (member >= 0) {
            record := Is(forest, member, "record_declaration");
            if (record || Is(forest, member, "union_declaration")) {
                name := Text(forest, text, Field(forest, member, "name"));
                if (name == "") {
                    return Declarations.Failed(Diagnose(forest, Field(forest, member, "name"), file, "Invalid string or embedded NUL"));
                }
                if (FindType(types, package, name) >= 0) {
                    return Declarations.Failed(Diagnose(forest, member, file, format_text("Duplicate declaration '{}'", name)));
                }
                declared: TypeDecl = {name: name, type_name: format_text("{}.{}", package_name, name), package: package,
                                      node: member,
                                      kind: RecordDecl, first: length(members), count: 0, size: 0, parent: -1,
                                      storage: 0,
                                      id: binding.ID("package-symbol", format_text("{}:{}:{}", documents[files[0]].identity,
                                                                                   TypeKind, name)),
                                      layout: 0, component: 0, key: 0, value_storage: 0,
                                      value_container: 0, value_record: -1};
                if (!record) {
                    // Variants follow their union; their payloads resolve below.
                    declared.kind = UnionDecl;
                    declared.first = length(types) + 1;
                    holder := length(types);
                    types.append(declared);
                    variant := FirstMember(forest, member);
                    while (variant >= 0) {
                        if (Is(forest, variant, "union_variant")) {
                            if (Field(forest, variant, "literal") >= 0) {
                                return Declarations.Failed(Diagnose(forest, variant, file,
                                                                    "literal union alternatives are not supported yet"));
                            }
                            variant_name := Text(forest, text, Field(forest, variant, "name"));
                            if (FindVariant(types, holder, variant_name) >= 0) {
                                return Declarations.Failed(Diagnose(forest, variant, file,
                                                                    format_text("Duplicate union alternative '{}'", variant_name)));
                            }
                            alternative: TypeDecl = {name: variant_name, type_name: "", package: package, node: member,
                                                     kind: VariantDecl, first: 0, count: 0, size: 0, parent: holder,
                                                     storage: 0, id: 0, layout: 0, component: 0, key: 0, value_storage: 0,
                                                     value_container: 0, value_record: -1};
                            types.append(alternative);
                            grown := types[holder];
                            grown.count += 1;
                            types[holder] = grown;
                        }
                        variant = NextMember(forest, variant);
                    }
                } else {
                    size: int = 0;
                    alignment: int = 1;
                    item := FirstMember(forest, Field(forest, member, "body"));
                    while (item >= 0) {
                        field_name := Text(forest, text, Field(forest, item, "name"));
                        if (field_name == "") {
                            return Declarations.Failed(Diagnose(forest, Field(forest, item, "name"), file, "Invalid string or embedded NUL"));
                        }
                        storage := ScalarStorage(Text(forest, text, Field(forest, item, "type")));
                        pointer_field := TypePointerNode(forest, Field(forest, item, "type")) >= 0;
                        initial := Field(forest, item, "value");
                        nullable_pointer := pointer_field && HasToken(forest, Field(forest, item, "type"), "?");
                        if ((storage == 0 && !pointer_field) ||
                            (initial >= 0 && !(nullable_pointer && Is(forest, initial, "nil")))) {
                            return Declarations.Failed(Diagnose(forest, item, file,
                                                                "record field needs a number, bool or string type and no default"));
                        }
                        at := declared.first;
                        while (at < length(members)) {
                            if (members[at].name == field_name) {
                                return Declarations.Failed(Diagnose(forest, item, file,
                                                                    format_text("Duplicate field '{}'", field_name)));
                            }
                            at += 1;
                        }
                        if (pointer_field) {
                            storage = PointerStorage;
                        }
                        width := FieldSize(storage, target);
                        size = AlignTo(size, width);
                        field: TypeMember = {name: field_name, storage: storage, container: 0, record: -1, offset: size,
                                             writable: true, c_string: false, constant: false, read: -1, read_key: ""};
                        members.append(field);
                        size += width;
                        if (width > alignment) {
                            alignment = width;
                        }
                        item = NextMember(forest, item);
                    }
                    if (length(members) == declared.first) {
                        return Declarations.Failed(Diagnose(forest, member, file, "record needs a field"));
                    }
                    declared.count = length(members) - declared.first;
                    declared.size = AlignTo(size, alignment);
                    types.append(declared);
                }
            }
            member = NextMember(forest, member);
        }
    }
    for (file in files) {
        types = DeclarePointers(forest, documents[file].text, types, Aliases(links, file), package, documents[file].syntax_root);
        types = DeclareMaps(forest, documents[file].text, types, Aliases(links, file), package, documents[file].syntax_root);
        types = DeclarePointers(forest, documents[file].text, types, Aliases(links, file), package, documents[file].syntax_root);
    }
    // Resolve nested collection spellings from their element types outwards.
    // Each source bracket/map can introduce at most one dependency level.
    depth: int = 0;
    for (syntax_node in forest) {
        if (syntax_node.kind == "type") {
            brackets: int = 0;
            child := syntax_node.first_child;
            while (child >= 0) {
                if (!forest[child].is_extra && forest[child].kind == "[") {
                    brackets += 1;
                }
                child = forest[child].next_sibling;
            }
            if (brackets > depth) {
                depth = brackets;
            }

        }
    }
    passes: int = 0;
    changed := true;
    while (changed && passes <= length(forest)) {
        before := length(types);
        types = DeclareSequenceCollections(types, depth, package);
        types = DeclareSequenceOptionals(types, package);
        for (file in files) {
            types = DeclarePointers(forest, documents[file].text, types, Aliases(links, file), package, documents[file].syntax_root);
            types = DeclareMaps(forest, documents[file].text, types, Aliases(links, file), package, documents[file].syntax_root);
        }
        changed = length(types) != before;
        passes += 1;
    }
    // An address points to any declared type, so its pointers are added once
    // the other types stop changing; adding them inside the loop would add
    // a pointer to every new pointer and optional on each pass.
    for (file in files) {
        types = DeclareAddressPointers(forest, documents[file].text, types, Aliases(links, file), package, documents[file].syntax_root);
    }
    types = DeclareSequenceOptionals(types, package);
    // Resolve pointer fields after every record name and constructor exists,
    // including self-referential nullable links.
    for (file in files) {
        for (declaration in Members(forest, documents[file].syntax_root)) {
            if (Is(forest, declaration, "record_declaration")) {
                holder := FindType(types, package, Text(forest, documents[file].text, Field(forest, declaration, "name")));
                index := types[holder].first;
                for (field_node in Members(forest, Field(forest, declaration, "body"))) {
                    field := members[index];
                    if (field.storage == PointerStorage) {
                        resolved := ReadType(forest, documents[file].text, &types, Aliases(links, file), package,
                                             Field(forest, field_node, "type"));
                        if (resolved.storage != PointerStorage || resolved.container != 0) {
                            return Declarations.Failed(Diagnose(forest, field_node, file, "record pointer field type is invalid"));
                        }
                        field.record = resolved.record;
                        members[index] = field;
                    }
                    index += 1;
                }
            }
        }
    }
    // Payloads may name any type, so they resolve once every type is known.
    for (file in files) {
        text := documents[file].text;
        aliases := Aliases(links, file);
        member := FirstMember(forest, documents[file].syntax_root);
        while (member >= 0) {
            if (Is(forest, member, "union_declaration")) {
                holder := FindType(types, package, Text(forest, text, Field(forest, member, "name")));
                variant := FirstMember(forest, member);
                while (variant >= 0) {
                    if (Is(forest, variant, "union_variant")) {
                        at := FindVariant(types, holder, Text(forest, text, Field(forest, variant, "name")));
                        alternative := types[at];
                        alternative.first = length(members);
                        parameter := FirstMember(forest, Field(forest, variant, "parameters"));
                        while (parameter >= 0) {
                            hidden := PrivateType(forest, text, types, aliases, package, Field(forest, parameter, "type"));
                            if (hidden >= 0) {
                                return Declarations.Failed(Diagnose(forest, hidden, file,
                                                                    PrivateMessage(Text(forest, text, hidden))));
                            }
                            payload := ReadType(forest, text, &types, aliases, package, Field(forest, parameter, "type"));
                            if (payload.storage == 0) {
                                return Declarations.Failed(Diagnose(forest, parameter, file, "payload type is not supported yet"));
                            }
                            field: TypeMember = {name: Text(forest, text, Field(forest, parameter, "name")),
                                                 storage: payload.storage, container: payload.container, record: payload.record, offset: 0,
                                                 writable: true, c_string: false, constant: false, read: -1, read_key: ""};
                            members.append(field);
                            parameter = NextMember(forest, parameter);
                        }
                        alternative.count = length(members) - alternative.first;
                        types[at] = alternative;
                    }
                    variant = NextMember(forest, variant);
                }
            }
            member = NextMember(forest, member);
        }
    }
    for (file in files) {
        text := documents[file].text;
        solid := SolidOffsets(text);
        aliases := Aliases(links, file);
        member := FirstMember(forest, documents[file].syntax_root);
        while (member >= 0) {
            if (Is(forest, member, "function_declaration")) {
                name := Text(forest, text, Field(forest, member, "name"));
                if (name == "") {
                    return Declarations.Failed(Diagnose(forest, Field(forest, member, "name"), file, "Invalid string or embedded NUL"));
                }
                // Types, functions and constants share the package scope.
                if (FindCallable(callables, package, name) >= 0 || FindType(types, package, name) >= 0 ||
                    FindConstant(constants, package, name) >= 0) {
                    return Declarations.Failed(Diagnose(forest, member, file, format_text("Duplicate declaration '{}'", name)));
                }
                switch FunctionSignature(forest, text, documents[file].key, solid, &types, aliases, package, file,
                                         member, name, length(params)) {
                    case .Failed(diagnostic):
                        return Declarations.Failed(diagnostic);
                    case .Read(callable, added):
                        params.extend(added);
                        callables.append(callable);
                }
            } else if (Is(forest, member, "constant_declaration")) {
                name := Text(forest, text, Field(forest, member, "name"));
                if (name == "") {
                    return Declarations.Failed(Diagnose(forest, Field(forest, member, "name"), file, "Invalid string or embedded NUL"));
                }
                if (FindCallable(callables, package, name) >= 0 || FindType(types, package, name) >= 0 ||
                    FindConstant(constants, package, name) >= 0) {
                    return Declarations.Failed(Diagnose(forest, member, file, format_text("Duplicate declaration '{}'", name)));
                }
                // An untyped constant is an int, as its integer literals are;
                // its value folds once every constant of the package is known.
                storage := IntStorage;
                declared := Field(forest, member, "type");
                if (declared >= 0) {
                    hidden := PrivateType(forest, text, types, aliases, package, declared);
                    if (hidden >= 0) {
                        return Declarations.Failed(Diagnose(forest, hidden, file,
                                                            PrivateMessage(Text(forest, text, hidden))));
                    }
                    constant_type := ReadType(forest, text, &types, aliases, package, declared);
                    storage = constant_type.storage;
                    if ((!Integer(storage) && !Floating(storage)) || constant_type.container != 0) {
                        return Declarations.Failed(Diagnose(forest, declared, file, "constant type is not supported yet"));
                    }
                }
                named := forest[Field(forest, member, "name")];
                constant: ConstDecl = {name: name, package: package, storage: storage, bits: 0,
                                       node: Field(forest, member, "value"), file: file, folded: false,
                                       occurrence: Occurrence(documents[file].key, SymbolRecord, solid[named.start],
                                                              solid[named.end])};
                constants.append(constant);
            } else if (!Is(forest, member, "package_header") && !Is(forest, member, "import_declaration") &&
                       !Is(forest, member, "record_declaration") && !Is(forest, member, "union_declaration")) {
                return Declarations.Failed(Diagnose(forest, member, file, "unsupported declaration"));
            }
            member = NextMember(forest, member);
        }
    }
    // Constants may name one another in any order: fold every one whose
    // operands are known, until none is left or none can be.
    progress := true;
    waiting: int = 0;
    while (progress) {
        progress = false;
        waiting = 0;
        at: int = 0;
        while (at < length(constants)) {
            constant := constants[at];
            if (constant.package == package && !constant.folded) {
                switch FoldConstant(forest, documents[constant.file].text, constant.file, constants,
                                    Aliases(links, constant.file), package, constant.node, constant.storage) {
                    case .Failed(diagnostic):
                        return Declarations.Failed(diagnostic);
                    case .Waiting:
                        waiting += 1;
                    case .Folded(value):
                        constant.bits = value;
                        constant.folded = true;
                        constants[at] = constant;
                        progress = true;
                }
            }
            at += 1;
        }
    }
    for (constant in constants) {
        if (waiting > 0 && constant.package == package && !constant.folded) {
            return Declarations.Failed(Diagnose(forest, constant.node, constant.file,
                                                format_text("Constant '{}' depends on itself", constant.name)));
        }
    }
    return Declarations.Collected(callables, params, types, members, constants);
}

Folding :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Waiting
    | Folded(bits: u64)
}
Evaluated :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Waiting
    | Value(exact: u64[])
}
// The number type a conversion call converts to, 0 for any other node.
NumberConversionType :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> int {
    callee := Field(forest, node, "function");
    if (!Is(forest, node, "call_expression") || !Is(forest, callee, "identifier")) {
        return 0;
    }
    storage := ScalarStorage(Text(forest, text, callee));
    if (!Integer(storage) && !Floating(storage)) {
        return 0;
    }
    return storage;
}
// The integer type a conversion call converts to, 0 for any other node.
ConversionType :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> int {
    storage := NumberConversionType(forest, text, node);
    if (!Integer(storage)) {
        return 0;
    }
    return storage;
}
Arithmetic :: (operator: string) -> bool {
    return operator == "+" || operator == "-" || operator == "*" || operator == "/" || operator == "%" ||
           operator == "&" || operator == "|" || operator == "^";
}
Shift :: (operator: string) -> bool {
    return operator == "<<" || operator == ">>";
}
// Whether `node` is a constant integer expression: integer literals, the
// package's constants and an import's, parentheses, conversions to integer
// types and the integer operators over them.
ConstantExpression :: (forest: snapshot.SnapshotNode[], text: string, constants: ConstDecl[], aliases: Name[],
                       package: int, node: int) -> bool {
    value := Unparenthesized(forest, node);
    if (Is(forest, value, "number")) {
        return InferredNumberStorage(forest, text, value) != FloatStorage;
    }
    named := ConstantOf(forest, text, constants, aliases, package, value);
    if (named >= 0) {
        // This classifier admits only the exact integer evaluator. Floating
        // expressions in bodies retain ordinary runtime lowering.
        return Integer(constants[named].storage);
    }
    if (ConversionType(forest, text, value) != 0) {
        argument := FirstMember(forest, Field(forest, value, "arguments"));
        if (argument < 0 || NextMember(forest, argument) >= 0) {
            return false;
        }
        if (Is(forest, argument, "named_argument")) {
            argument = Field(forest, argument, "value");
        }
        return ConstantExpression(forest, text, constants, aliases, package, argument);
    }
    operator := Text(forest, text, Field(forest, value, "operator"));
    if (Is(forest, value, "unary_expression")) {
        return (operator == "+" || operator == "-" || operator == "~") &&
               ConstantExpression(forest, text, constants, aliases, package, Field(forest, value, "operand"));
    }
    return Is(forest, value, "binary_expression") && (Arithmetic(operator) || Shift(operator)) &&
           ConstantExpression(forest, text, constants, aliases, package, Field(forest, value, "left")) &&
           ConstantExpression(forest, text, constants, aliases, package, Field(forest, value, "right"));
}
// The type a constant expression has of its own: a constant's or a
// conversion's, through unary operators and a shift's value, else either
// operand's of another binary operator, left first. 0 when it is untyped
// literals alone, which take their type from its use.
ConstantType :: (forest: snapshot.SnapshotNode[], text: string, constants: ConstDecl[], aliases: Name[], package: int,
                 node: int) -> int {
    value := Unparenthesized(forest, node);
    named := ConstantOf(forest, text, constants, aliases, package, value);
    if (named >= 0) {
        return constants[named].storage;
    }
    if (ConversionType(forest, text, value) != 0) {
        return ConversionType(forest, text, value);
    }
    callee := Field(forest, value, "function");
    if (Is(forest, value, "call_expression") && Is(forest, callee, "identifier")) {
        converted := ScalarStorage(Text(forest, text, callee));
        if (Floating(converted)) {
            return converted;
        }
    }
    if (Is(forest, value, "unary_expression")) {
        return ConstantType(forest, text, constants, aliases, package, Field(forest, value, "operand"));
    }
    if (!Is(forest, value, "binary_expression")) {
        return 0;
    }
    left := ConstantType(forest, text, constants, aliases, package, Field(forest, value, "left"));
    if (left != 0 || Shift(Text(forest, text, Field(forest, value, "operator")))) {
        return left;
    }
    return ConstantType(forest, text, constants, aliases, package, Field(forest, value, "right"));
}
// An untyped floating literal takes its spelled type, number, through
// grouping and unary signs. Integer operands retain i64, or u64 for a literal
// beyond it.
UntypedStorage :: (forest: snapshot.SnapshotNode[], text: string, node: int) -> int {
    literal := Unparenthesized(forest, node);
    while (Is(forest, literal, "unary_expression") &&
           (Text(forest, text, Field(forest, literal, "operator")) == "+" ||
            Text(forest, text, Field(forest, literal, "operator")) == "-")) {
        literal = Unparenthesized(forest, Field(forest, literal, "operand"));
    }
    if (Is(forest, literal, "number") && Floating(InferredNumberStorage(forest, text, literal))) {
        return InferredNumberStorage(forest, text, literal);
    }
    switch ParseNumber(forest, text, Unparenthesized(forest, node)) {
        case .Invalid:
            return Int64Storage;
        case .Number(negative, magnitude):
            if (Fits(negative, magnitude, Int64Storage)) {
                return Int64Storage;
            }
            return WordStorage;
    }
}
// The bits of a constant of its own type, or the context's storage when
// untyped. Integer expressions fold exactly; floating literals, names and
// conversions use their represented values. Waiting on an unfolded name.
FoldConstant :: (forest: snapshot.SnapshotNode[], text: string, file: int, constants: ConstDecl[], aliases: Name[],
                 package: int, node: int, storage: int) -> Folding {
    typed := ConstantType(forest, text, constants, aliases, package, node);
    if (typed == 0) {
        typed = storage;
    }
    if (Floating(storage)) {
        if (typed != storage && !FloatWidens(typed, storage) && !Integer(typed)) {
            return Folding.Failed(Diagnose(forest, node, file, "a constant of another type needs a conversion"));
        }
        if (Integer(typed)) {
            // Reuse the ordinary exact fold before the existing decimal-to-
            // floating conversion, including the source integer's range check.
            switch FoldConstant(forest, text, file, constants, aliases, package, node, typed) {
                case .Failed(diagnostic):
                    return Folding.Failed(diagnostic);
                case .Waiting:
                    return Folding.Waiting;
                case .Folded(bits):
                    exact := ExactStored(bits, typed);
                    switch LiteralBits(format_text("{}", LowBits(Magnitude(exact))), ExactNegative(exact)) {
                        case .OutOfRange:
                            return Folding.Failed(OutsideRange(forest, file, node, storage));
                        case .Finite(wide, fits, narrow):
                            if (storage == FloatStorage) {
                                return Folding.Folded(narrow);
                            }
                            return Folding.Folded(wide);
                    }
            }
        }
        value := Unparenthesized(forest, node);
        if (ParsedLiteral(forest, text, value)) {
            switch NumberBits(forest, text, value) {
                case .OutOfRange:
                    return Folding.Failed(Diagnose(forest, value, file, "Numeric literal is outside the range of its type"));
                case .Finite(wide, fits, narrow):
                    if (storage == FloatStorage && !fits) {
                        return Folding.Failed(Diagnose(forest, value, file, "Numeric literal is outside the range of number"));
                    }
                    if (storage == FloatStorage) {
                        return Folding.Folded(narrow);
                    }
                    return Folding.Folded(wide);
            }
        }
        named := ConstantOf(forest, text, constants, aliases, package, value);
        if (named >= 0) {
            constant := constants[named];
            if (constant.package != package && PrivateDeclaration(forest, forest[constant.node].parent)) {
                return Folding.Failed(Diagnose(forest, value, file, PrivateMessage(Text(forest, text, value))));
            }
            if (!constant.folded) {
                return Folding.Waiting;
            }
            return Folding.Folded(FloatingBits(constant.bits, constant.storage, storage));
        }
        callee := Field(forest, value, "function");
        if (Is(forest, value, "call_expression") && Is(forest, callee, "identifier") &&
            Floating(ScalarStorage(Text(forest, text, callee)))) {
            converted := ScalarStorage(Text(forest, text, callee));
            operand := FirstMember(forest, Field(forest, value, "arguments"));
            if (operand < 0 || NextMember(forest, operand) >= 0) {
                return Folding.Failed(Diagnose(forest, value, file, "Conversion takes one value"));
            }
            if (Is(forest, operand, "named_argument")) {
                return Folding.Failed(Diagnose(forest, value, file, "wrap and clamp convert between integer types"));
            }
            inner := ConstantType(forest, text, constants, aliases, package, operand);
            if (inner == 0) {
                inner = UntypedStorage(forest, text, Unparenthesized(forest, operand));
                if (Floating(inner)) {
                    // Untyped floating literals take the conversion's context;
                    // already typed operands keep their represented values.
                    inner = converted;
                }
            }
            // Integer-to-floating conversion uses the same ordinary FoldConstant
            // entry; floating-to-integer is not expanded by this dependency.
            if (Integer(inner)) {
                switch FoldConstant(forest, text, file, constants, aliases, package, operand, inner) {
                    case .Failed(diagnostic):
                        return Folding.Failed(diagnostic);
                    case .Waiting:
                        return Folding.Waiting;
                    case .Folded(bits):
                        exact := ExactStored(bits, inner);
                        switch LiteralBits(format_text("{}", LowBits(Magnitude(exact))), ExactNegative(exact)) {
                            case .OutOfRange:
                                return Folding.Failed(OutsideRange(forest, file, operand, converted));
                            case .Finite(wide, fits, narrow):
                                converted_bits := wide;
                                if (converted == FloatStorage) {
                                    converted_bits = narrow;
                                }
                                return Folding.Folded(FloatingBits(converted_bits, converted, storage));
                        }
                }
            }
            switch FoldConstant(forest, text, file, constants, aliases, package, operand, inner) {
                case .Failed(diagnostic):
                    return Folding.Failed(diagnostic);
                case .Waiting:
                    return Folding.Waiting;
                case .Folded(bits):
                    return Folding.Folded(FloatingBits(FloatingBits(bits, inner, converted), converted, storage));
            }
        }
        operator := Text(forest, text, Field(forest, value, "operator"));
        if (Is(forest, value, "unary_expression") && (operator == "+" || operator == "-")) {
            switch FoldConstant(forest, text, file, constants, aliases, package,
                                Field(forest, value, "operand"), storage) {
                case .Failed(diagnostic):
                    return Folding.Failed(diagnostic);
                case .Waiting:
                    return Folding.Waiting;
                case .Folded(bits):
                    if (operator == "-") {
                        sign: u64 = 0x8000000000000000;
                        if (storage == FloatStorage) {
                            sign = 0x80000000;
                        }
                        return Folding.Folded(bits ^ sign);
                    }
                    return Folding.Folded(bits);
            }
        }
        return Folding.Failed(Diagnose(forest, value, file, "floating constant initializer is not supported yet"));
    }
    if (typed != storage && !Widens(typed, storage)) {
        return Folding.Failed(Diagnose(forest, node, file, "a constant of another type needs a conversion"));
    }
    switch Evaluate(forest, text, file, constants, aliases, package, node, typed) {
        case .Failed(diagnostic):
            return Folding.Failed(diagnostic);
        case .Waiting:
            return Folding.Waiting;
        case .Value(exact):
            if (!ExactFits(exact, typed)) {
                // Anchored inside parentheses, as stage zero anchors it.
                return Folding.Failed(OutsideRange(forest, file, Unparenthesized(forest, node), typed));
            }
            return Folding.Folded(ExactWrapped(exact, typed));
    }
}
// The exact value of the constant integer expression `node` of type
// `storage`.
Evaluate :: (forest: snapshot.SnapshotNode[], text: string, file: int, constants: ConstDecl[], aliases: Name[],
             package: int, node: int, storage: int) -> Evaluated {
    if (Is(forest, node, "parenthesized_expression")) {
        return Evaluate(forest, text, file, constants, aliases, package, Field(forest, node, "expression"), storage);
    }
    // A literal, `-` on one included, so the most negative value is one.
    signed_literal := Is(forest, node, "unary_expression") &&
                      Text(forest, text, Field(forest, node, "operator")) == "-" &&
                      Is(forest, Field(forest, node, "operand"), "number");
    if (Is(forest, node, "number") || signed_literal) {
        switch ParseNumber(forest, text, node) {
            case .Invalid:
                return Evaluated.Failed(Diagnose(forest, node, file, "only integer constants are supported yet"));
            case .Number(negative, magnitude):
                if (!Fits(negative, magnitude, storage)) {
                    return Evaluated.Failed(Diagnose(forest, node, file,
                                                     format_text("Numeric literal is outside the range of {}",
                                                                 TypeName(storage))));
                }
                return Evaluated.Value(ExactOf(negative, magnitude));
        }
    }
    named := ConstantOf(forest, text, constants, aliases, package, node);
    if (named >= 0) {
        if (constants[named].package != package && PrivateDeclaration(forest, forest[constants[named].node].parent)) {
            return Evaluated.Failed(Diagnose(forest, node, file, PrivateMessage(Text(forest, text, node))));
        }
        if (!constants[named].folded) {
            return Evaluated.Waiting;
        }
        if (!Integer(constants[named].storage)) {
            return Evaluated.Failed(Diagnose(forest, node, file, "constant value must be an integer expression"));
        }
        return Evaluated.Value(ExactStored(constants[named].bits, constants[named].storage));
    }
    if (ConversionType(forest, text, node) != 0) {
        return EvaluateConversion(forest, text, file, constants, aliases, package, node);
    }
    unary := Is(forest, node, "unary_expression");
    if (!unary && !Is(forest, node, "binary_expression")) {
        return Evaluated.Failed(Diagnose(forest, node, file, "constant value must be an integer expression"));
    }
    operator := Text(forest, text, Field(forest, node, "operator"));
    if (!unary && Shift(operator)) {
        return EvaluateShift(forest, text, file, constants, aliases, package, node, storage);
    }
    if ((unary && operator != "+" && operator != "-" && operator != "~") || (!unary && !Arithmetic(operator))) {
        return Evaluated.Failed(Diagnose(forest, node, file,
                                         format_text("constant operator '{}' is not supported yet", operator)));
    }
    if (unary && operator == "-" && !Signed(storage)) {
        return Evaluated.Failed(Diagnose(forest, node, file, "Cannot negate an unsigned constant"));
    }
    operands: int[] = [Field(forest, node, "operand")];
    if (!unary) {
        operands = [Field(forest, node, "left"), Field(forest, node, "right")];
        left_type := ConstantType(forest, text, constants, aliases, package, operands[0]);
        right_type := ConstantType(forest, text, constants, aliases, package, operands[1]);
        if (left_type != 0 && right_type != 0 && left_type != right_type) {
            return Evaluated.Failed(Diagnose(forest, node, file,
                                             format_text("Mismatched integer types {} and {}; convert one operand",
                                                         TypeName(left_type), TypeName(right_type))));
        }
    }
    value: u64[] = [];
    right: u64[] = [];
    for (index in 0..<length(operands)) {
        switch Evaluate(forest, text, file, constants, aliases, package, operands[index], storage) {
            case .Failed(diagnostic):
                return Evaluated.Failed(diagnostic);
            case .Waiting:
                return Evaluated.Waiting;
            case .Value(exact):
                if (index == 0) {
                    value = exact;
                } else {
                    right = exact;
                }
        }
    }
    if (unary && operator == "-") {
        value = ExactNegate(value);
    } else if (unary && operator == "~" && Signed(storage)) {
        value = ExactSubtract(ExactNegate(value), ExactOf(false, 1));
    } else if (unary && operator == "~") {
        // An unsigned type's complement is its largest value less this one.
        value = ExactSubtract(ExactMax(storage), value);
    } else if (!unary && operator == "+") {
        // A unary plus keeps its operand.
        value = ExactAdd(value, right);
    } else if (operator == "-") {
        value = ExactSubtract(value, right);
    } else if (operator == "*") {
        value = ExactMultiply(value, right);
    } else if (operator == "/" || operator == "%") {
        if (ExactZero(right)) {
            return Evaluated.Failed(Diagnose(forest, node, file, "Constant division by zero"));
        }
        value = ExactDivide(value, right, operator == "%");
    } else if (!unary) {
        value = ExactBitwise(operator, value, right);
    }
    if (MagnitudeBits(Magnitude(value)) > ExactLimit) {
        return Evaluated.Failed(OutsideRange(forest, file, node, storage));
    }
    return Evaluated.Value(value);
}
// A constant whose value does not fit its type. A value beyond ExactLimit
// bits fits none.
OutsideRange :: (forest: snapshot.SnapshotNode[], file: int, node: int, storage: int) -> syntax.Diagnostic {
    return Diagnose(forest, node, file, format_text("Constant value is outside the range of {}", TypeName(storage)));
}
// A shift's value has the type of its left operand. Its count has its own
// type, which must be unsigned, and must not be negative.
EvaluateShift :: (forest: snapshot.SnapshotNode[], text: string, file: int, constants: ConstDecl[], aliases: Name[],
                  package: int, node: int, storage: int) -> Evaluated {
    count := Unparenthesized(forest, Field(forest, node, "right"));
    count_type := ConstantType(forest, text, constants, aliases, package, count);
    if (Signed(count_type)) {
        return Evaluated.Failed(Diagnose(forest, count, file, "Shift count must be unsigned; convert it with u32(value)"));
    }
    if (count_type == 0) {
        count_type = UntypedStorage(forest, text, count);
    }
    value: u64[] = [];
    shift: u64[] = [];
    operands: int[] = [Field(forest, node, "left"), count];
    types: int[] = [storage, count_type];
    for (index in 0..<2) {
        switch Evaluate(forest, text, file, constants, aliases, package, operands[index], types[index]) {
            case .Failed(diagnostic):
                return Evaluated.Failed(diagnostic);
            case .Waiting:
                return Evaluated.Waiting;
            case .Value(exact):
                if (index == 0) {
                    value = exact;
                } else {
                    shift = exact;
                }
        }
    }
    if (ExactNegative(shift)) {
        return Evaluated.Failed(Diagnose(forest, count, file, "Shift count must not be negative"));
    }
    if (MagnitudeCompare(Magnitude(shift), Magnitude(ExactOf(false, u64(ExactLimit)))) > 0) {
        return Evaluated.Failed(Diagnose(forest, count, file, "Constant shift count is too large"));
    }
    bits := int(LowBits(Magnitude(shift)));
    if (Text(forest, text, Field(forest, node, "operator")) == ">>") {
        return Evaluated.Value(ExactShiftRight(value, bits));
    }
    shifted := ExactShiftLeft(value, bits);
    if (MagnitudeBits(Magnitude(shifted)) > ExactLimit) {
        return Evaluated.Failed(OutsideRange(forest, file, node, storage));
    }
    return Evaluated.Value(shifted);
}
// `T(value)` must fit T; `T(wrap: value)` keeps the low bits. The value has
// its own type, or i64 when untyped, and must fit it.
EvaluateConversion :: (forest: snapshot.SnapshotNode[], text: string, file: int, constants: ConstDecl[],
                       aliases: Name[], package: int, node: int) -> Evaluated {
    storage := ConversionType(forest, text, node);
    argument := FirstMember(forest, Field(forest, node, "arguments"));
    if (argument < 0 || NextMember(forest, argument) >= 0) {
        return Evaluated.Failed(Diagnose(forest, node, file, "Conversion takes one value"));
    }
    wrap := Is(forest, argument, "named_argument");
    value := argument;
    if (wrap) {
        if (Text(forest, text, Field(forest, argument, "name")) != "wrap") {
            return Evaluated.Failed(Diagnose(forest, Field(forest, argument, "name"), file,
                                             "A conversion argument may only be named wrap"));
        }
        value = Field(forest, argument, "value");
    }
    inner := ConstantType(forest, text, constants, aliases, package, value);
    if (inner == 0) {
        inner = UntypedStorage(forest, text, value);
    }
    if (Floating(inner)) {
        return Evaluated.Failed(Diagnose(forest, value, file,
                                         "floating-to-integer constant conversion is not supported yet"));
    }
    switch FoldConstant(forest, text, file, constants, aliases, package, value, inner) {
        case .Failed(diagnostic):
            return Evaluated.Failed(diagnostic);
        case .Waiting:
            return Evaluated.Waiting;
        case .Folded(bits):
            exact := ExactStored(bits, inner);
            if (wrap) {
                return Evaluated.Value(ExactStored(ExactWrapped(exact, storage), storage));
            }
            if (!ExactFits(exact, storage)) {
                return Evaluated.Failed(Diagnose(forest, node, file,
                                                 format_text("Constant does not fit in {}; use {}(wrap: value)",
                                                             TypeName(storage), TypeName(storage))));
            }
            return Evaluated.Value(exact);
    }
}

Default :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Read(bits: u64, text: string)
}
// A parameter's default, as the literal stage zero folds it to: an integer of
// the parameter's type, a bool or a string.
LiteralDefault :: (forest: snapshot.SnapshotNode[], text: string, file: int, node: int, declared: ValueType) -> Default {
    if (declared.container == ViewContainer) {
        return Default.Failed(Diagnose(forest, node, file, "view requires an initialized value"));
    }
    if (declared.container != 0) {
        return Default.Failed(Diagnose(forest, node, file, "a parameter default needs a literal yet"));
    }
    if (Floating(declared.storage)) {
        literal := StateNumberNode(forest, text, node);
        if (literal >= 0) {
            switch NumberBits(forest, text, literal) {
                case .Finite(double_bits, float_fits, float_bits):
                    if (declared.storage == DoubleStorage) {
                        return Default.Read(double_bits, "");
                    }
                    if (float_fits) {
                        return Default.Read(float_bits, "");
                    }
                case .OutOfRange:
                    return Default.Failed(Diagnose(forest, node, file, "Numeric literal is outside the range of its type"));
            }
        }
        return Default.Failed(Diagnose(forest, node, file, "a parameter default needs a representable numeric literal"));
    }
    if (Integer(declared.storage)) {
        switch ParseNumber(forest, text, node) {
            case .Invalid:
                return Default.Failed(Diagnose(forest, node, file, "a parameter default needs a literal yet"));
            case .Number(negative, magnitude):
                if (!Fits(negative, magnitude, declared.storage)) {
                    return Default.Failed(Diagnose(forest, node, file,
                                                   format_text("Numeric literal is outside the range of {}",
                                                               TypeName(declared.storage))));
                }
                return Default.Read(Bits(negative, magnitude), "");
        }
    }
    if (declared.storage == BoolStorage && Is(forest, node, "boolean")) {
        if (Text(forest, text, node) == "true") {
            return Default.Read(1, "");
        }
        return Default.Read(0, "");
    }
    if (declared.storage == TextStorage && Is(forest, node, "string")) {
        decoded := compiler_json_value_string(Text(forest, text, node));
        if (!decoded.valid) {
            return Default.Failed(Diagnose(forest, node, file, "Invalid string literal"));
        }
        return Default.Read(0, decoded.value);
    }
    return Default.Failed(Diagnose(forest, node, file, "a parameter default needs a literal yet"));
}
// The signature of the function `member` named `name`, its params numbered
// from `first`. A named result is a scalar or a single record.
FunctionSignature :: (forest: snapshot.SnapshotNode[], text: string, key: string, solid: int[], table: ^(TypeDecl[]),
                      aliases: Name[], package: int, file: int, member: int, name: string, first: int) -> Signature {
    added: Param[] = [];
    parameter := FirstMember(forest, Field(forest, member, "parameters"));
    while (parameter >= 0) {
        type_node := Field(forest, parameter, "type");
        hidden := PrivateType(forest, text, table^, aliases, package, type_node);
        if (hidden >= 0) {
            return Signature.Failed(Diagnose(forest, hidden, file, PrivateMessage(Text(forest, text, hidden))));
        }
        // A scoped pointer parameter takes a reference to its target.
        pointer := PointerAnnotation(forest, type_node);
        reference := pointer >= 0 && ScopedPointer(forest, text, member, parameter, []);
        if (reference) {
            type_node = Field(forest, pointer, "target");
        }
        declared := ReadType(forest, text, table, aliases, package, type_node);
        if (declared.storage == 0) {
            return Signature.Failed(Diagnose(forest, parameter, file, "parameter type is not supported yet"));
        }
        if (reference && Field(forest, parameter, "value") >= 0) {
            return Signature.Failed(Diagnose(forest, parameter, file, "a scoped pointer parameter takes no default"));
        }
        param_name := Text(forest, text, Field(forest, parameter, "name"));
        if (param_name == "") {
            return Signature.Failed(Diagnose(forest, Field(forest, parameter, "name"), file,
                                             "Invalid string or embedded NUL"));
        }
        default_value := Field(forest, parameter, "value");
        default_occurrence: u64 = 0;
        if (default_value >= 0) {
            default_occurrence = Occurrence(key, ExpressionRecord, solid[forest[default_value].start],
                                            solid[forest[default_value].end]);
        }
        param: Param = {name: param_name, storage: declared.storage, container: declared.container,
                        record: declared.record, has_default: false, default_bits: 0, default_text: "",
                        default_occurrence: default_occurrence, reference: reference,
                        node: Field(forest, parameter, "name")};
        if (default_value >= 0 && declared.storage == PointerStorage && declared.container == 0 &&
            declared.record >= 0 && table^[declared.record].key != 0 && Is(forest, default_value, "nil")) {
            param.has_default = true;
        } else if (default_value >= 0 && OptionalElement(table^, Typed(-1, declared.storage, declared.container,
                                                                       declared.record)).storage != 0 &&
                   Is(forest, default_value, "nil")) {
            param.has_default = true;
        } else if (default_value >= 0) {
            switch LiteralDefault(forest, text, file, default_value, declared) {
                case .Failed(diagnostic):
                    return Signature.Failed(diagnostic);
                case .Read(bits, literal):
                    param.has_default = true;
                    param.default_bits = bits;
                    param.default_text = literal;
            }
        }
        added.append(param);
        parameter = NextMember(forest, parameter);
    }
    count := length(added);
    result: ValueType = {storage: 0, container: 0, record: -1};
    results := Field(forest, member, "results");
    if (Is(forest, results, "parameter_list")) {
        named := FirstMember(forest, results);
        if (named < 0) {
            return Signature.Failed(Diagnose(forest, results, file, "named results need at least one result"));
        }
        while (named >= 0) {
            hidden := PrivateType(forest, text, table^, aliases, package, Field(forest, named, "type"));
            if (hidden >= 0) {
                return Signature.Failed(Diagnose(forest, hidden, file, PrivateMessage(Text(forest, text, hidden))));
            }
            declared := ReadType(forest, text, table, aliases, package, Field(forest, named, "type"));
            if (declared.storage == 0 || declared.storage == TextStorage || declared.storage == UnionStorage ||
                declared.storage == PointerStorage || declared.container != 0) {
                return Signature.Failed(Diagnose(forest, named, file, "named result type is not supported yet"));
            }
            result_name := Text(forest, text, Field(forest, named, "name"));
            param: Param = {name: result_name, storage: declared.storage, container: declared.container,
                            record: declared.record,
                            has_default: false, default_bits: 0, default_text: "", default_occurrence: 0,
                            reference: false, node: Field(forest, named, "name")};
            added.append(param);
            named = NextMember(forest, named);
        }
    } else if (results >= 0) {
        hidden := PrivateType(forest, text, table^, aliases, package, results);
        if (hidden >= 0) {
            return Signature.Failed(Diagnose(forest, hidden, file, PrivateMessage(Text(forest, text, hidden))));
        }
        result = ReadType(forest, text, table, aliases, package, results);
        if (result.storage == 0) {
            return Signature.Failed(Diagnose(forest, results, file, "result type is not supported yet"));
        }
    }
    callable: Callable = {name: name, package: package, document: file, node: member, first: first, count: count,
                          result: result.storage, result_container: result.container, result_record: result.record,
                          results: length(added) - count, waits: false};
    return Signature.Read(callable, added);
}
ScalarValue :: (storage: int, wide: int) -> writer.Value {
    return {tag: storage, container: 0, type_name: "", has_type_name: false, authored: false,
            wide: wide, text: "", has_text: false, present: false, first: 0, count: 0};
}
// The header of an absent value of a type. A record names its layout; an
// array of records, like a record, names its type, and so does a handle of a
// game type, such as an entity. A native type's header lists no fields.
Header :: (storage: int, container: int, record: int, types: TypeDecl[], layouts: int[]) -> writer.Value {
    if (record >= 0 && types[record].kind == CollectionDecl) {
        return SequenceHeader({storage: storage, container: container, record: record}, types);
    }
    if (storage == QueryStorage && record >= 0) {
        described := ScalarValue(storage, 0);
        described.container = container;
        described.type_name = types[record].type_name;
        described.has_type_name = true;
        return described;
    }
    if (container != 0) {
        value := ScalarValue(storage, 0);
        value.container = container;
        if (container == MapContainer) {
            value.type_name = types[record].type_name;
            value.has_type_name = true;
        } else if (storage == StructStorage || storage == PointerStorage) {
            value.type_name = types[record].type_name;
            value.has_type_name = true;
            value.authored = storage == StructStorage && types[record].kind != NativeDecl;
        }
        return value;
    }
    if (storage == HandleStorage && record >= 0) {
        handle := ScalarValue(storage, 0);
        handle.type_name = types[record].type_name;
        handle.has_type_name = true;
        return handle;
    }
    if (storage == PointerStorage && record >= 0) {
        value := ScalarValue(storage, 0);
        value.type_name = types[record].type_name;
        value.has_type_name = true;
        return value;
    }
    if (storage != StructStorage) {
        return ScalarValue(storage, 0);
    }
    if (types[record].kind == NativeDecl || types[record].kind == OptionalComponentDecl) {
        return {tag: StructStorage, container: 0, type_name: types[record].type_name, has_type_name: true,
                authored: false, wide: layouts[record], text: "", has_text: false, present: false, first: 0, count: 0};
    }
    return {tag: StructStorage, container: 0, type_name: types[record].type_name, has_type_name: true,
            authored: true, wide: layouts[record], text: "", has_text: false, present: false, first: 0,
            count: types[record].count};
}
// A parameter's header: its type's, or a scoped parameter's descriptor pointer.
ParamHeader :: (param: Param, types: TypeDecl[], layouts: int[], target: Target) -> writer.Value {
    if (param.reference) {
        return ScalarValue(target.pointer_storage, 0);
    }
    return Header(param.storage, param.container, param.record, types, layouts);
}
NoSource :: () -> writer.Source {
    return {graph: 0, call: 0, parent: -1, asset: "", has_asset: false, start: 0, end: 0, line: 0, column: 0};
}
Range :: (first: int, count: int) -> writer.Span {
    return {first: first, count: count};
}
Own :: (index: int) -> writer.Reference {
    return {imported: -1, own: index, function: 0, role: 0};
}
// FNV-1a over `count` little-endian bytes of `value`, as the runtime hashes
// layouts.
HashBytes :: (hash: u64, value: u64, count: int) -> u64 {
    out := hash;
    rest := value;
    index: int = 0;
    while (index < count) {
        out = (out ^ (rest & 255)) * 1099511628211;
        rest = rest >> 8;
        index += 1;
    }
    return out;
}
HashText :: (hash: u64, text: string) -> u64 {
    out := hash;
    // Each ByteAt measures the text, so a whole text reads Bytes once.
    for (byte in strings.Bytes(text)) {
        out = HashBytes(out, u64(byte), 1);
    }
    return HashBytes(out, 0, 1);
}
// The runtime's layout hash of a record: its size and field count, then each
// field's name, offset, size, storage, string descriptor marker and absent type name.
LayoutHash :: (record: TypeDecl, fields: TypeMember[], types: TypeDecl[], target: Target) -> u64 {
    hash: u64 = 1469598103934665603;
    hash = HashBytes(hash, u64(record.size), target.pointer_size);
    hash = HashBytes(hash, u64(record.count), 4);
    at := record.first;
    while (at < record.first + record.count) {
        field := fields[at];
        hash = HashText(hash, field.name);
        hash = HashBytes(hash, u64(field.offset), target.pointer_size);
        hash = HashBytes(hash, u64(FieldSize(field.storage, target)), target.pointer_size);
        hash = HashBytes(hash, u64(field.storage), 4);
        if (field.storage == TextStorage) {
            hash = HashBytes(hash, 1, 1);
        }
        if (field.storage == PointerStorage) {
            hash = HashText(hash, types[field.record].type_name);
        } else {
            hash = HashText(hash, "");
        }
        at += 1;
    }
    return hash;
}

// Whether each of `count` packages is `package` or one it imports, directly
// or through others.
Reachable :: (edges: graph.Edge[], count: int, package: int) -> bool[] {
    seen := resize([false], count);
    seen[package] = true;
    pending: int[] = [package];
    while (length(pending) > 0) {
        at := pending[length(pending) - 1];
        pending = slice(pending, 0, length(pending) - 1);
        for (edge in edges) {
            if (edge.from == at && !seen[edge.to]) {
                seen[edge.to] = true;
                pending.append(edge.to);
            }
        }
    }
    return seen;
}
// The closure of every package, each a prepared module, rooted at package
// `root`. Dependencies come first, so an importer has every module it imports.
Link :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], packages: graph.Package[],
         files_of: int[], root: int, order: int[], edges: graph.Edge[], links: graph.Binding[],
         input_callables: Callable[], params: Param[], input_types: TypeDecl[], input_members: TypeMember[],
         constants: ConstDecl[], natives: ResolvedNative[], ports: ResolvedPort[], identities: u64[], native_effects: int[], ops: Ops,
         target: Target, abi: u64) -> Result {
    callables := WaitingCallables(forest, input_callables);
    types := input_types;
    members := input_members;
    switch TaskResultDeclarations(callables, params, types, members) {
        case .Collected(declared_types, declared_members):
            types = declared_types;
            members = declared_members;
    }
    // Each package's identity and module ID, and the fingerprint of its module.
    package_names: string[] = [];
    package_ids: u64[] = [];
    for (listed in packages) {
        package_names.append(documents[files_of[listed.member_start]].identity);
        package_ids.append(binding.ID("module", package_names[length(package_names) - 1]));
    }
    context: BodyContext = BodyContext.Known(native_effects);
    prepared: Body[] = [];
    // Bodies may declare types, which every module then reads.
    switch PreparePackages(forest, documents, packages, files_of, order, edges, links, package_names,
                           callables, params, &types, members, constants, natives, ports, identities,
                           context, ops, target) {
        case .Failed(diagnostic):
            return Result.Rejected(diagnostic);
        case .Read(bodies):
            prepared = bodies;
    }
    fingerprints := resize([u64(0)], length(packages));
    data: u8[] = [];
    starts := resize([int(0)], length(packages));
    lengths := resize([int(0)], length(packages));
    effects := resize([int(0)], length(callables));
    for (package in order) {
        switch Assemble(forest, documents, package, files_of[packages[package].member_start], package_names,
                        package_ids, fingerprints,
                        Reachable(edges, length(packages), package), links, callables, params, types, members, constants,
                        natives, ports, identities, native_effects, effects, ops, target, abi, Game.Package, prepared, []) {
            case .Rejected(diagnostic):
                return Result.Rejected(diagnostic);
            case .Compiled(module, bytes, summaries):
                effects = summaries;
                // Only an importer reads a fingerprint, and none imports the root.
                if (package != root) {
                    fingerprints[package] = writer.Fingerprint(bytes);
                }
                starts[package] = length(data);
                lengths[package] = length(bytes);
                data.extend(bytes);
        }
    }
    return Result.Compiled(package_ids[root],
                           writer.Closure(package_ids[root], package_ids, package_names, data, starts, lengths));
}
// The prepared module of package `package`, or of a behavior, whose
// functions are its handlers; its bytes are the Compiled result's. Each body
// is a canonical definition the runtime verifies and finalizes when it loads
// it.
// `constants`, each another package's taking the occurrence of the first use
// in package `package`, where stage zero declares its symbol.
UsedConstants :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], links: graph.Binding[],
                  callables: Callable[], constants: ConstDecl[], package: int, first_own: int,
                  reachable: bool[]) -> ConstDecl[] {
    // Only a package this one imports declares a constant it can use.
    foreign := false;
    for (constant in constants) {
        foreign = foreign || (constant.package != package && reachable[constant.package]);
    }
    if (!foreign) {
        return constants;
    }
    seen := resize([false], length(constants));
    firsts := resize([u64(0)], length(constants));
    solid: int[] = [];
    solid_document: int = -1;
    index := first_own;
    while (index < length(callables) && callables[index].package == package) {
        document := callables[index].document;
        text := documents[document].text;
        if (document != solid_document) {
            solid = SolidOffsets(text);
            solid_document = document;
        }
        aliases := Aliases(links, document);
        // The body's nodes in source order.
        pending: int[] = [Field(forest, callables[index].node, "body")];
        while (length(pending) > 0) {
            node := pending[length(pending) - 1];
            pending = slice(pending, 0, length(pending) - 1);
            found: int = -1;
            if (Is(forest, node, "member_expression")) {
                found = ConstantOf(forest, text, constants, aliases, package, node);
            }
            if (found >= 0 && constants[found].package != package && !seen[found]) {
                seen[found] = true;
                firsts[found] = Occurrence(documents[document].key, SymbolRecord, solid[forest[node].start],
                                           solid[forest[node].end]);
            }
            children: int[] = [];
            child := forest[node].first_child;
            while (child >= 0) {
                children.append(child);
                child = forest[child].next_sibling;
            }
            at_child := length(children) - 1;
            while (at_child >= 0) {
                pending.append(children[at_child]);
                at_child -= 1;
            }
        }
        index += 1;
    }
    used: ConstDecl[] = [];
    at: int = 0;
    while (at < length(constants)) {
        occurrence := constants[at].occurrence;
        if (seen[at]) {
            occurrence = firsts[at];
        }
        first: ConstDecl = {name: constants[at].name, package: constants[at].package, storage: constants[at].storage,
                            bits: constants[at].bits, node: constants[at].node, file: constants[at].file,
                            folded: constants[at].folded, occurrence: occurrence};
        used.append(first);
        at += 1;
    }
    return used;
}
// A closed, prepared source cycle starts at its direct facts. Unknown native
// contracts remain unknown; WRITE propagates through actual invocation edges.
WriteSummaries :: (bodies: Body[]) -> int[] {
    summaries: int[] = [];
    for (body in bodies) {
        switch body {
            case .Failed(diagnostic):
                summaries.append(UnknownWrite);
            case .Inferred(value):
                summaries.append(UnknownWrite);
            case .Emitted(slots, locals, cells, code, calls, hosts, roots, points, watches, effects,
                          direct_write, facts):
                summaries.append(direct_write);
        }
    }
    changed := true;
    while (changed) {
        changed = false;
        index: int = 0;
        for (body in bodies) {
            switch body {
                case .Failed(diagnostic):
                    summaries[index] = UnknownWrite;
                case .Inferred(value):
                    summaries[index] = UnknownWrite;
                case .Emitted(slots, locals, cells, code, calls, hosts, roots, points, watches, effects,
                              direct_write, facts):
                    for (call in calls) {
                        joined := JoinWrite(summaries[index], summaries[call.callee]);
                        if (joined != summaries[index]) {
                            summaries[index] = joined;
                            changed = true;
                        }
                    }
            }
            index += 1;
        }
    }
    return summaries;
}
ItemWrite :: (forest: snapshot.SnapshotNode[], facts: SemanticFact[], item: int, summaries: int[],
              context: BodyContext) -> int {
    summary: int = 0;
    for (fact in facts) {
        if (fact.kind != UpdateFact && InSubtree(forest, fact.node, item)) {
            if (fact.kind == WriteFact) {
                summary = WriteEffect;
            } else if (fact.kind == NativeFact) {
                summary = JoinWrite(summary, NativeWrite(context, fact.target));
            } else if (fact.kind == CallFact) {
                summary = JoinWrite(summary, summaries[fact.target]);
            }
        }
    }
    return summary;
}
// Only a proven clear item may mutate the receiver in place. The first pass
// uses contextual in-place typing, but is never published before this proof.
GenericUpdates :: (forest: snapshot.SnapshotNode[], body: Body, summaries: int[], context: BodyContext) -> int[] {
    generic: int[] = [];
    switch body {
        case .Failed(diagnostic):
            return generic;
        case .Inferred(value):
            return generic;
        case .Emitted(slots, locals, cells, code, calls, hosts, roots, points, watches, effects,
                      direct_write, facts):
            for (fact in facts) {
                if (fact.kind == UpdateFact && ItemWrite(forest, facts, fact.target, summaries, context) != 0) {
                    generic.append(fact.node);
                }
            }
    }
    return generic;
}
// Changing the lowering must preserve its resolved semantic write contract.
StablePreparation :: (forest: snapshot.SnapshotNode[], before: Body, next_body: Body, summaries: int[],
                      context: BodyContext) -> bool {
    switch before {
        case .Failed(diagnostic):
            return false;
        case .Inferred(value):
            return false;
        case .Emitted(slots, locals, cells, code, calls, hosts, roots, points, watches, effects,
                      direct_write, facts):
            switch next_body {
                case .Failed(diagnostic):
                    return false;
                case .Inferred(next_value):
                    return false;
                case .Emitted(next_slots, next_locals, next_cells, next_code, next_calls, next_hosts, next_roots,
                              next_points, next_watches, next_effects, next_write, next_facts):
                    if (direct_write != next_write || length(calls) != length(next_calls)) {
                        return false;
                    }
                    index: int = 0;
                    while (index < length(calls)) {
                        if (calls[index].callee != next_calls[index].callee) {
                            return false;
                        }
                        index += 1;
                    }
                    index = 0;
                    next_index: int = 0;
                    while (index < length(facts)) {
                        if (facts[index].kind == UpdateFact) {
                            while (next_index < length(next_facts) && next_facts[next_index].kind != UpdateFact) {
                                next_index += 1;
                            }
                            if (next_index == length(next_facts)) {
                                return false;
                            }
                            old := facts[index];
                            current := next_facts[next_index];
                            if (old.node != current.node || old.target != current.target ||
                                ItemWrite(forest, facts, old.target, summaries, context) !=
                                ItemWrite(forest, next_facts, current.target, summaries, context)) {
                                return false;
                            }
                            next_index += 1;
                        }
                        index += 1;
                    }
                    while (next_index < length(next_facts)) {
                        if (next_facts[next_index].kind == UpdateFact) {
                            return false;
                        }
                        next_index += 1;
                    }
            }
    }
    return true;
}
Preparation :: union {
    Failed(diagnostic: syntax.Diagnostic) | Read(bodies: Body[])
}
// Pure packages use the same two-stage body cache as executable sources.
// Constants keep the importing package's first-use symbol occurrence.
PreparePackages :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], packages: graph.Package[],
                    files_of: int[], order: int[], edges: graph.Edge[], links: graph.Binding[],
                    package_names: string[], callables: Callable[], params: Param[], table: ^(TypeDecl[]),
                    members: TypeMember[], constants: ConstDecl[], natives: ResolvedNative[], ports: ResolvedPort[],
                    identities: u64[], context: BodyContext, ops: Ops, target: Target) -> Preparation {
    bodies: Body[] = [];
    for (callable in callables) {
        bodies.append(Body.Failed(Diagnose(forest, callable.node, callable.document, "missing prepared body")));
    }
    summaries: int[] = [];
    // A scoped parameter's `p^` reads and writes `p` in every body.
    scoped := forest;
    if (AnyReference(params)) {
        scoped = ScopedTargets(forest, documents, callables, params);
    }
    pass: int = 0;
    while (pass < 2) {
        for (package in order) {
            if (!HostPackageAvailable(natives, package_names[package])) {
                document := files_of[packages[package].member_start];
                return Preparation.Failed(Diagnose(forest, documents[document].root, document,
                                                   "Host package is unavailable for this target"));
            }
            first: int = 0;
            while (first < length(callables) && callables[first].package != package) {
                first += 1;
            }
            // The second pass prepares only callables with generic updates,
            // so it reads a package's constants for its first such callable.
            used: ConstDecl[] = [];
            undeclared: u64 = 0;
            loaded := false;
            solid: int[] = [];
            solid_document: int = -1;
            index := first;
            while (index < length(callables) && callables[index].package == package) {
                callable := callables[index];
                generic: int[] = [];
                if (pass > 0) {
                    generic = GenericUpdates(scoped, bodies[index], summaries, context);
                }
                if (pass == 0 || length(generic) > 0) {
                    if (!loaded) {
                        used = UsedConstants(forest, documents, links, callables, constants, package, first,
                                             Reachable(edges, length(packages), package));
                        first_document := files_of[packages[package].member_start];
                        first_solid := SolidOffsets(documents[first_document].text);
                        undeclared = OccurrenceIn(DocumentHash(documents[first_document].key), SymbolRecord, 0,
                                                  first_solid[length(first_solid) - 1]);
                        loaded = true;
                    }
                    if (callable.document != solid_document) {
                        solid = SolidOffsets(documents[callable.document].text);
                        solid_document = callable.document;
                    }
                    meaning := binding.ID("package-symbol",
                                          format_text("{}:{}:{}:callable", package_names[package], FunctionKind,
                                                      callable.name));
                    body := FunctionBody(scoped, documents, callables, params, table, members, used, natives, ports,
                                         identities, Aliases(links, callable.document), [], [], [], index, solid,
                                         undeclared, meaning, context, generic, ops, target, []);
                    switch body {
                        case .Failed(diagnostic):
                            return Preparation.Failed(diagnostic);
                        case .Inferred(value):
                            return Preparation.Failed(Diagnose(forest, callable.node, callable.document,
                                                               "expression inferred where a callable body was required"));
                        case .Emitted(slots, locals, cells, code, calls, hosts, roots, points, watches, effects,
                                      direct_write, facts):
                            if (pass > 0 && !StablePreparation(scoped, bodies[index], body, summaries, context)) {
                                return Preparation.Failed(Diagnose(forest, callable.node, callable.document,
                                                                   "array update effects changed during preparation"));
                            }
                            bodies[index] = body;
                    }
                }
                index += 1;
            }
        }
        if (pass == 0) {
            summaries = WriteSummaries(bodies);
        }
        pass += 1;
    }
    return Preparation.Read(bodies);
}
// A body may declare the sequence and optional types it uses in `table`. A
// query evaluator's analysis covers its parameter list, which holds the
// query's predicate; every other callable's covers its body.
FunctionBody :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], callables: Callable[],
                 params: Param[], table: ^(TypeDecl[]), members: TypeMember[], constants: ConstDecl[],
                 natives: ResolvedNative[], ports: ResolvedPort[], identities: u64[], aliases: Name[],
                 operators: NumericOperator[], makes: NativeMake[], make_fields: int[], index: int,
                 solid: int[], undeclared: u64, meaning: u64, context: BodyContext, generic_updates: int[],
                 ops: Ops, target: Target, query_specs: QuerySpec[]) -> Body {
    callable := callables[index];
    document := documents[callable.document];
    analysis_body := Field(forest, callable.node, "body");
    if (QueryEvaluator(query_specs, index) >= 0) {
        analysis_body = Field(forest, callable.node, "parameters");
    }
    if (analysis_body < 0) {
        return Body.Failed(Diagnose(forest, callable.node, callable.document,
                                    format_text("Callable '{}' has no body", callable.name)));
    }
    referenced: string[] = [];
    if (AnyReference(params)) {
        referenced = ReferencedNames(forest, document.text, callables, params, natives, aliases, callable.package,
                                     analysis_body);
    }
    mutated := MutatedNames(forest, document.text, analysis_body, referenced);
    built: int[] = [];
    if (callable.results == 0) {
        built = BuiltLocals(forest, document.text, table^, aliases, callable.package, analysis_body, referenced);
    }
    if (strings.HasPrefix(document.identity, "host:")) {
        return EmitBody(forest, document.text, callable.document, callables, params, table, members, constants,
                        PackageNatives(natives, document.identity), ports, identities, operators, makes, make_fields,
                        aliases, document.key, solid, undeclared, meaning, index, referenced, mutated, built, context,
                        generic_updates, ops, target, query_specs);
    }
    return EmitBody(forest, document.text, callable.document, callables, params, table, members, constants,
                    natives, ports, identities, operators, makes, make_fields, aliases, document.key, solid,
                    undeclared, meaning, index, referenced, mutated, built, context, generic_updates, ops, target,
                    query_specs);
}
Assemble :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], package: int, first_document: int,
             package_names: string[], package_ids: u64[], fingerprints: u64[], reachable: bool[],
             links: graph.Binding[], callables: Callable[], params: Param[], types: TypeDecl[],
             members: TypeMember[], constants: ConstDecl[], natives: ResolvedNative[], ports: ResolvedPort[],
             identities: u64[], native_effects: int[], callable_effects: int[], ops: Ops, target: Target,
             abi: u64, game: Game, prepared: Body[], query_specs: QuerySpec[]) -> Assembly {
    identity := package_names[package];
    module := package_ids[package];
    // A behavior's states, the event each of its functions handles, the
    // game's events and the type of the entity that owns it.
    kept_states: StateDecl[] = [];
    handled: int[] = [];
    game_events: GameEvent[] = [];
    game_fields: GameEventField[] = [];
    owner_type: u64 = 0;
    source_mode: bool = true;
    library_mode: bool = false;
    switch game {
        case .Package:
            source_mode = false;
        case .Library(entity, operators, globals, makes, made_fields):
            owner_type = entity;
            library_mode = true;
        case .Behavior(declared_states, handlers, declared_events, payloads, entity, operators, globals, makes,
                       made_fields):
            kept_states = declared_states;
            handled = handlers;
            game_events = declared_events;
            game_fields = payloads;
            owner_type = entity;
    }
    wide: u64[] = [0];
    values: writer.Value[] = [];
    ints: int[] = [];
    spans: writer.Span[] = [];
    functions: writer.Function[] = [];
    instructions: writer.Instruction[] = [];
    locals: writer.Local[] = [];
    parameters: writer.Parameter[] = [];
    frames: writer.Frame[] = [];
    sources: writer.Source[] = [];
    data: writer.Data[] = [];
    hosts: writer.Host[] = [];
    commands: writer.Command[] = [];
    roots: writer.Root[] = [];
    calls: writer.Call[] = [];
    references: writer.Reference[] = [];
    components: writer.Component[] = [];
    entries: writer.Entry[] = [];
    effects: int[] = [];
    for (summary in callable_effects) {
        effects.append(summary);
    }
    effect_calls: EffectCall[] = [];
    requirements: writer.Requirement[] = [];
    fields: writer.Field[] = [];
    // Each record's layout and each variant's tag, as indices into `wide`, for
    // the types of this package and those it reaches; no others can occur.
    layouts: int[] = [];
    tags: int[] = [];
    for (declared in types) {
        layouts.append(int(0));
        tags.append(int(0));
        if (declared.kind == OptionalComponentDecl) {
            layouts[length(layouts) - 1] = layouts[declared.parent];
            continue;
        }
        if (!source_mode && !reachable[declared.package]) {
            continue;
        }
        if (declared.kind == VariantDecl) {
            // Stage zero's tag: the union's ID in decimal, then the variant.
            union_id := binding.ID("package-symbol",
                                   format_text("{}:{}:{}", package_names[declared.package], TypeKind, types[declared.parent].name));
            tag := binding.ID("union-variant", format_text("{}:{}", union_id, declared.name));
            if (types[declared.parent].kind == TaskResultDecl) {
                tag = declared.id;
            }
            wide.append(tag);
            tags[length(tags) - 1] = length(wide) - 1;
        } else if (declared.kind == RecordDecl) {
            id := declared.id;
            if (!source_mode) {
                id = binding.ID("package-symbol",
                                format_text("{}:{}:{}", package_names[declared.package], TypeKind, declared.name));
            }
            wide.append(id);
            wide.append(LayoutHash(declared, members, types, target));
            layouts[length(layouts) - 1] = length(wide) - 1;
            requirement: writer.Requirement = {id: length(wide) - 2, layout: length(wide) - 1, storage: StructStorage,
                                               name: declared.type_name, size: declared.size, authored: true, first: length(fields),
                                               count: declared.count};
            requirements.append(requirement);
            at := declared.first;
            while (at < declared.first + declared.count) {
                // Record fields are integers, bools or strings, so none names a type or unit.
                field: writer.Field = {name: members[at].name, kind: members[at].storage, type_name: "",
                                       has_type_name: false, unit: "", has_unit: false};
                if (members[at].storage == PointerStorage) {
                    field.type_name = types[members[at].record].type_name;
                    field.has_type_name = true;
                }
                fields.append(field);
                at += 1;
            }
        } else if ((declared.kind == PointerDecl && declared.key == 0) || declared.kind == QueryDecl) {
            wide.append(declared.id);
            pointer_requirement: writer.Requirement = {id: length(wide) - 1, layout: 0, storage: declared.storage,
                                                       name: declared.type_name, size: target.pointer_size,
                                                       authored: false, first: 0, count: 0};
            requirements.append(pointer_requirement);
        } else if (declared.kind == NativeDecl) {
            wide.append(declared.id);
            wide.append(declared.layout);
            layouts[length(layouts) - 1] = length(wide) - 1;
            requirement: writer.Requirement = {id: length(wide) - 2, layout: length(wide) - 1, storage: declared.storage,
                                               name: declared.type_name, size: declared.size, authored: false, first: 0,
                                               count: 0};
            requirements.append(requirement);
        }
    }
    abi_one := length(wide);
    wide.append(u64(1));
    // A package's functions are contiguous; the module numbers them from 0.
    first_own: int = 0;
    while (first_own < length(callables) && callables[first_own].package != package) {
        first_own += 1;
    }
    // The packages this module calls into, each an import row.
    imported: int[] = [];
    imports: writer.Import[] = [];
    points: writer.Point[] = [];
    watches: writer.Watch[] = [];
    index := first_own;
    while (index < length(callables) && callables[index].package == package) {
        callable := callables[index];
        handler: int = -1;
        if (index - first_own < length(handled)) {
            handler = handled[index - first_own];
        }
        tables := prepared[index];
        switch tables {
            case .Failed(diagnostic):
                return Assembly.Rejected(diagnostic);
            case .Inferred(value):
                return AssemblyFailure(callable.document, "expression inferred where a callable body was required");
            case .Emitted(body_slots, body_locals, body_cells, body_code, body_calls, body_hosts, body_roots,
                          body_points, body_watches, body_effects, body_write, body_facts):
                direct_effects := body_effects;
                if (library_mode) {
                    for (instruction in body_code) {
                        if (instruction.op == ops.owner) {
                            direct_effects = direct_effects | InvocationReadEffect;
                        }
                    }
                }
                host_indices: int[] = [];
                command_indices: int[] = [];
                host_count: int = 0;
                command_count: int = 0;
                for (operation in body_hosts) {
                    host_indices.append(host_count);
                    command_indices.append(command_count);
                    if (operation.command == 0) {
                        host_count += 1;
                    } else {
                        command_count += 1;
                    }
                }
                base := length(spans);
                // Event payload slots remain part of the physical handler ABI.
                // A system reads dt from context and declares no source parameter.
                system_payload := handler >= 0 && Is(forest, callable.node, "system");
                argument_count := callable.count;
                if (system_payload) {
                    argument_count = game_events[handler].count;
                }
                spans.append(Range(length(values), argument_count));
                at: int = 0;
                while (at < argument_count) {
                    if (system_payload) {
                        field := game_fields[game_events[handler].first + at];
                        values.append(ScalarValue(field.storage, 0));
                    } else {
                        values.append(ParamHeader(params[callable.first + at], types, layouts, target));
                    }
                    at += 1;
                }
                spans.append(Range(length(ints), argument_count));
                at = 0;
                while (at < argument_count) {
                    kind: int = 0;
                    if (!system_payload && params[callable.first + at].reference) {
                        kind = ReferenceKind;
                    }
                    ints.append(kind);
                    at += 1;
                }
                // Result defaults and kinds: the one result, or each named one.
                result_count := callable.results;
                if (callable.result != 0) {
                    result_count = 1;
                }
                spans.append(Range(length(values), result_count));
                if (callable.result != 0) {
                    values.append(Header(callable.result, callable.result_container, callable.result_record,
                                         types, layouts));
                }
                at = 0;
                while (at < callable.results) {
                    named := params[callable.first + callable.count + at];
                    values.append(Header(named.storage, named.container, named.record, types, layouts));
                    at += 1;
                }
                spans.append(Range(length(ints), result_count));
                at = 0;
                while (at < result_count) {
                    ints.append(int(0));
                    at += 1;
                }
                // A behavior's states are each function's variables.
                spans.append(Range(length(values), length(kept_states)));
                for (kept in kept_states) {
                    values.append(StateValue(kept, types, layouts, length(wide)));
                    wide.append(kept.bits);
                }
                spans.append(Range(length(ints), length(body_slots)));
                for (slot in body_slots) {
                    ints.append(slot.storage);
                }
                spans.append(Range(length(ints), length(body_slots)));
                for (slot in body_slots) {
                    ints.append(slot.kind);
                }
                // Record and array pointers each slot may hold while the function waits.
                spans.append(Range(length(roots), length(body_roots)));
                for (root in body_roots) {
                    values.append(Header(root.storage, root.container, root.record, types, layouts));
                    row: writer.Root = {bank: 0, index: root.slot, shape: length(values) - 1};
                    roots.append(row);
                }
                // Instructions, each with its own value row and source at pc + 1.
                spans.append(Range(length(instructions), length(body_code)));
                pc: int = 0;
                for (body_instruction in body_code) {
                    code := body_instruction;
                    if (code.op == ops.host_call) {
                        code.target = host_indices[code.target];
                    }
                    if (code.op == ops.command_begin) {
                        code.target = command_indices[code.target];
                    }
                    node_id: int = 0;
                    if (code.op == ops.command_begin || code.op == ops.suspend) {
                        wide.append(code.payload);
                        node_id = length(wide) - 1;
                        code.payload = 0;
                    }
                    value := Header(code.value_storage, code.value_container, code.value_record, types, layouts);
                    if (code.has_text) {
                        value.text = code.text;
                        value.has_text = true;
                    }
                    if (code.payload != 0) {
                        value.wide = length(wide);
                        wide.append(code.payload);
                    }
                    values.append(value);
                    row: writer.Instruction = {op: code.op, type: code.type, output: code.output,
                                               left: code.left, right: code.right, target: code.target, frame: 0, source: pc + 1,
                                               stack: -1, pin: 0, offset: code.offset, indirect: false, component_index: 0, node: node_id,
                                               value: length(values) - 1, layout: 0, message: code.message, has_message: code.has_message};
                    instructions.append(row);
                    pc += 1;
                }
                spans.append(Range(length(locals), length(body_locals)));
                for (body_local in body_locals) {
                    values.append(ScalarValue(body_local.storage, 0));
                    local: writer.Local = {kind: body_local.kind, initial: length(values) - 1, frame: 0, node: 0, pin: 0,
                                           offset: 0, parameter: false, array_default: false, data_index: 0};
                    locals.append(local);
                }
                spans.append(Range(length(parameters), callable.count));
                at = 0;
                while (at < callable.count) {
                    values.append(ParamHeader(params[callable.first + at], types, layouts, target));
                    parameter: writer.Parameter = {initial: length(values) - 1, frame: 0, pin: 0};
                    parameters.append(parameter);
                    at += 1;
                }
                // One frame with an empty origin, then the instruction origins.
                sources.append(NoSource());
                frame: writer.Frame = {source: length(sources) - 1, depth: 0, resume: 0, source_index: 0, stack: -1};
                spans.append(Range(length(frames), 1));
                frames.append(frame);
                spans.append(Range(length(sources), length(body_code) + 1));
                sources.append(NoSource());
                asset := documents[callable.document].key;
                for (code in body_code) {
                    source := NoSource();
                    source.asset = asset;
                    source.has_asset = true;
                    source.start = code.start;
                    source.end = code.end;
                    source.line = code.line;
                    source.column = code.column;
                    sources.append(source);
                }
                spans.append(Range(0, 0));
                spans.append(Range(0, 0));
                // Data cells: record cells own a buffer of the record's size;
                // others may hold a constant or a variant's tag.
                spans.append(Range(length(data), length(body_cells)));
                for (cell in body_cells) {
                    value := Header(cell.storage, cell.container, cell.record, types, layouts);
                    size: int = 0;
                    if (cell.storage == StructStorage && cell.container == 0) {
                        size = types[cell.record].size;
                    }
                    if (cell.variant >= 0) {
                        value.wide = tags[cell.variant];
                    } else if (cell.constant != 0) {
                        value.wide = length(wide);
                        wide.append(cell.constant);
                    }
                    values.append(value);
                    datum: writer.Data = {kind: cell.kind, initial: length(values) - 1, size: size};
                    data.append(datum);
                }
                spans.append(Range(length(hosts), host_count));
                for (host in body_hosts) {
                    if (host.command != 0) {
                        continue;
                    }
                    capability := length(wide);
                    host_abi := abi_one;
                    if (host.linked >= 0) {
                        direct_effects = direct_effects | native_effects[host.linked];
                        wide.append(identities[2 * host.linked]);
                        wide.append(identities[2 * host.linked + 1]);
                        host_abi = capability + 1;
                    } else {
                        wide.append(IntrinsicBase | u64(host.intrinsic));
                    }
                    row: writer.Host = {owned_arguments: host.owned_arguments, capability: capability, abi: host_abi, first: host.first,
                                        result_first: host.result_first, result_count: host.result_count, outcome_first: 0,
                                        outcome_count: 0};
                    hosts.append(row);
                }
                spans.append(Range(length(commands), command_count));
                for (operation in body_hosts) {
                    if (operation.command == 0) {
                        continue;
                    }
                    wide.append(TaskCommandBase | u64(operation.command));
                    command_abi: u64 = 2;
                    if (operation.command == DelayCommand) {
                        command_abi = 1;
                    }
                    wide.append(command_abi);
                    wide.append(TaskCommandNode(operation.command, operation.syntax_node));
                    command: writer.Command = {capability: length(wide) - 3, abi: length(wide) - 2,
                                               first: operation.first, count: operation.result_first - operation.first,
                                               node: length(wide) - 1, result_first: operation.result_first,
                                               result_count: operation.result_count};
                    commands.append(command);
                    if (operation.command == CancelCommand || operation.command == CancelAfterCommand) {
                        direct_effects = direct_effects | WriteEffect;
                    } else {
                        direct_effects = direct_effects | SuspendEffect;
                    }
                }
                // The command banks use the same stable cell coordinates as the
                // body's host banks. Each has independent mutable payload storage.
                command_cells: int = 0;
                if (command_count > 0) {
                    command_cells = length(body_cells);
                }
                spans.append(Range(length(values), command_cells));
                at = 0;
                while (at < command_cells) {
                    cell := body_cells[at];
                    initial := Header(cell.storage, cell.container, cell.record, types, layouts);
                    if (cell.constant != 0) {
                        wide.append(cell.constant);
                        initial.wide = length(wide) - 1;
                    }
                    if (cell.variant >= 0) {
                        initial.wide = tags[cell.variant];
                    }
                    values.append(initial);
                    at += 1;
                }
                spans.append(Range(length(ints), command_cells));
                at = 0;
                while (at < command_cells) {
                    ints.append(ValueKind);
                    at += 1;
                }
                spans.append(Range(length(values), command_cells));
                at = 0;
                while (at < command_cells) {
                    cell := body_cells[at];
                    values.append(Header(cell.storage, cell.container, cell.record, types, layouts));
                    at += 1;
                }
                spans.append(Range(length(ints), command_cells));
                at = 0;
                while (at < command_cells) {
                    ints.append(ValueKind);
                    at += 1;
                }
                spans.append(Range(length(calls), length(body_calls)));
                for (invocation in body_calls) {
                    effect_call: EffectCall = {caller: index, callee: invocation.callee, task: invocation.task};
                    effect_calls.append(effect_call);
                    callee := callables[invocation.callee];
                    if (callee.package == package) {
                        references.append(Own(invocation.callee - first_own));
                    } else {
                        row := Position(imported, callee.package);
                        if (row < 0) {
                            imported.append(callee.package);
                            wide.append(package_ids[callee.package]);
                            wide.append(fingerprints[callee.package]);
                            dependency: writer.Import = {id: length(wide) - 2, fingerprint: length(wide) - 1};
                            imports.append(dependency);
                            row = length(imports) - 1;
                        }
                        called_id := binding.ID("package-symbol",
                                                format_text("{}:{}:{}:callable", package_names[callee.package], FunctionKind, callee.name));
                        if (source_mode) {
                            called_id = binding.ID("symbol", format_text("{}:1:{}:callable", package_names[callee.package], callee.name));
                        }
                        wide.append(called_id);
                        foreign: writer.Reference = {imported: row, own: 0, function: length(wide) - 1, role: 0};
                        references.append(foreign);
                    }
                    call: writer.Call = {owned_arguments: invocation.owned_arguments, function: length(references) - 1, first: invocation.first,
                                         count: invocation.count, result_first: invocation.result_first,
                                         result_count: invocation.result_count, task: invocation.task};
                    calls.append(call);
                }
                // No definitions; then the components the body reads or
                // writes through references, each once, and each write.
                spans.append(Range(0, 0));
                written := ComponentsOf(body_cells, body_hosts, true);
                reached := Distinct(ComponentsOf(body_cells, body_hosts, false));
                effects[index] = direct_effects;
                if (source_mode) {
                    effects[index] = effects[index] | Effects(ops, body_code, length(reached) != 0, length(written) != 0);
                }
                spans.append(Range(length(components), length(reached)));
                for (component_id in reached) {
                    reached_row: writer.Component = {id: length(wide), binding: false};
                    components.append(reached_row);
                    wide.append(component_id);
                }
                spans.append(Range(length(ints), length(written)));
                for (component_id in written) {
                    ints.append(length(wide));
                    wide.append(component_id);
                }
                spans.append(Range(length(points), length(body_points)));
                for (point in body_points) {
                    wide.append(point.occurrence);
                    wide.append(point.meaning);
                    row: writer.Point = {occurrence: length(wide) - 2, meaning: length(wide) - 1, start: point.start,
                                         end: point.end, line: point.line, column: point.column, kind: point.kind,
                                         completion: point.completion};
                    points.append(row);
                }
                // Each watch's origin is a point of its own, past the
                // function's points, and its initial value the type's header.
                spans.append(Range(length(watches), length(body_watches)));
                for (watched in body_watches) {
                    wide.append(watched.occurrence);
                    wide.append(u64(0));
                    origin: writer.Point = {occurrence: length(wide) - 2, meaning: length(wide) - 1,
                                            start: watched.start, end: watched.end, line: watched.line,
                                            column: watched.column, kind: ExpressionRecord, completion: false};
                    points.append(origin);
                    // A behavior's handles are its entities.
                    watched_record := watched.record;
                    if (watched.storage == HandleStorage && watched_record < 0 && owner_type != 0) {
                        watched_record = TypeWithId(types, owner_type);
                    }
                    values.append(Header(watched.storage, watched.container, watched_record, types, layouts));
                    row: writer.Watch = {origin: length(points) - 1, initial: length(values) - 1,
                                         ordinal: watched.ordinal, output: watched.output, reference: watched.reference};
                    watches.append(row);
                }
                while (length(spans) < base + writer.Tables) {
                    spans.append(Range(0, 0));
                }
                head: writer.Function = {argument_count: argument_count, result_count: result_count,
                                         variable_count: length(kept_states), root_steps: 0, child_budget: 0,
                                         depth_bound: 0, pure_depth_limit: 0, breakpoints: false, batchable: false,
                                         managed: false, custom_lowering: false, checkpoints: false, pin_watches: false,
                                         watch_size: 0, component_bindings: false, component_access: length(reached) != 0,
                                         spans: base};
                functions.append(head);
                references.append(Own(index - first_own));
                references.append(Own(-1));
                if (handler >= 0) {
                    // Stage zero's handler ID: the source, the handler's offset and its kind.
                    handled_event := game_events[handler];
                    function_kind := HandlerFunction;
                    if (Is(forest, callable.node, "system")) {
                        function_kind = 3;
                    }
                    wide.append(binding.ID("function", format_text("{}:{}:{}", identity,
                                                                   forest[callable.node].start, function_kind)));
                    wide.append(handled_event.id);
                    wide.append(handled_event.abi);
                    wide.append(u64(0));
                    row: writer.Entry = {id: length(wide) - 4, kind: function_kind, entry_name: "", has_entry: false,
                                         event_id: length(wide) - 3, event_abi: length(wide) - 2,
                                         event_name: handled_event.name, has_event_name: true, continuation_wait: false,
                                         effects: length(wide) - 1, body: length(references) - 2,
                                         subscription: length(references) - 1};
                    entries.append(row);
                } else if (QueryEvaluator(query_specs, index) >= 0) {
                    // Evaluators are reached through descriptions.
                } else if (source_mode) {
                    // A behavior's member procedure is a symbol of its source's scope.
                    // Stage zero lets every authored function wait.
                    wide.append(binding.ID("symbol", format_text("{}:1:{}:callable", identity,
                                                                 callable.name)));
                    procedure: writer.Entry = {id: length(wide) - 1, kind: 0, entry_name: "", has_entry: false,
                                               event_id: 0, event_abi: 0, event_name: "", has_event_name: false,
                                               continuation_wait: true, effects: 0, body: length(references) - 2,
                                               subscription: length(references) - 1};
                    entries.append(procedure);
                } else {
                    wide.append(binding.ID("package-symbol",
                                           format_text("{}:{}:{}:callable", identity, FunctionKind, callable.name)));
                    exported: writer.Entry = {id: length(wide) - 1, kind: 0, entry_name: callable.name, has_entry: true,
                                              event_id: 0, event_abi: 0, event_name: "", has_event_name: false,
                                              continuation_wait: false, effects: 0, body: length(references) - 2,
                                              subscription: length(references) - 1};
                    entries.append(exported);
                }
        }
        index += 1;
    }
    // A local cycle reaches a fixed point; imported callees already carry
    // the summaries computed when their dependency modules were assembled.
    changed := true;
    while (changed) {
        changed = false;
        for (called in effect_calls) {
            inherited := effects[called.callee];
            if (called.task) {
                inherited = inherited & ~SuspendEffect;
            }
            combined := effects[called.caller] | inherited;
            if (combined != effects[called.caller]) {
                effects[called.caller] = combined;
                changed = true;
            }
        }
    }
    at_entry: int = 0;
    while (at_entry < length(entries)) {
        declared := entries[at_entry];
        wide.append(u64(effects[first_own + at_entry]));
        declared.effects = length(wide) - 1;
        entries[at_entry] = declared;
        at_entry += 1;
    }
    // The events the handlers take, each once, in the order they first do.
    event_declarations: writer.Event[] = [];
    event_fields: writer.EventField[] = [];
    listed: int[] = [];
    for (handler in handled) {
        if (handler < 0 || Position(listed, handler) >= 0) {
            continue;
        }
        listed.append(handler);
        handled_event := game_events[handler];
        wide.append(handled_event.id);
        wide.append(handled_event.abi);
        declared: writer.Event = {id: length(wide) - 2, abi: length(wide) - 1, name: handled_event.name,
                                  first: length(event_fields), count: handled_event.count};
        event_declarations.append(declared);
        at := handled_event.first;
        while (at < handled_event.first + handled_event.count) {
            payload := game_fields[at];
            values.append(ScalarValue(payload.storage, 0));
            wide.append(payload.nominal);
            field: writer.EventField = {name: payload.name, nominal: length(wide) - 1, has_default: payload.has_default,
                                        default_owner: payload.default_owner, initial: length(values) - 1};
            event_fields.append(field);
            at += 1;
        }
    }
    states: writer.State[] = [];
    for (kept in kept_states) {
        values.append(StateValue(kept, types, layouts, length(wide)));
        wide.append(kept.bits);
        wide.append(kept.id);
        row: writer.State = {id: length(wide) - 1, initial: length(values) - 1, shared: false, contains_tasks: false};
        states.append(row);
    }
    layouts_table: writer.ResultLayout[] = [];
    queries: writer.Query[] = [];
    descriptions: writer.QueryDescription[] = [];
    system_root: int = -1;
    system_variables: int = 0;
    system_description: int = 0;
    for (described in query_specs) {
        clause_roots: int[] = [];
        query_base := length(queries);
        query_terms := QueryTerms(forest, documents[first_document].text, types, members, params, described);
        for (term in query_terms) {
            children := length(ints);
            child_count: int = 0;
            if (term.left >= 0) {
                ints.append(query_base + term.left);
                child_count += 1;
            }
            if (term.right >= 0) {
                ints.append(query_base + term.right);
                child_count += 1;
            }
            wide.append(term.source_relationship);
            relation_index := length(wide) - 1;
            wide.append(term.component);
            query_term: writer.Query = {kind: term.kind, required: term.required,
                                        component_id: length(wide) - 1, source_relationship: relation_index,
                                        source_traversal: term.source_traversal, source_variable: term.source_variable,
                                        target_variable: term.target_variable, predicate: -1, first: children, count: child_count};
            if (term.root) {
                clause_roots.append(length(queries));
            }
            queries.append(query_term);
        }
        children := length(ints);
        ints.extend(clause_roots);
        all: writer.Query = {kind: 1, required: false, component_id: 0, source_relationship: 0, source_traversal: 0,
                             source_variable: 0, target_variable: 0, predicate: -1,
                             first: children, count: length(clause_roots)};
        root := length(queries);
        queries.append(all);
        values.append(Header(QueryStorage, 0, described.row, types, layouts));
        references.append(Own(described.evaluator - first_own));
        description: writer.QueryDescription = {query_root: root, query_variable_count: described.variables,
                                                row_type: length(values) - 1, evaluate: length(references) - 1};
        descriptions.append(description);
        if (Is(forest, described.node, "system")) {
            system_root = root;
            system_variables = described.variables;
            system_description = length(descriptions);
        }
    }
    return Assembly.Compiled(module, writer.Write(writer.Module.Tables(module, owner_type, abi, target.pointer_size, wide, values, ints, requirements,
                                                                       fields, event_declarations, event_fields, imports, functions, spans, roots, instructions,
                                                                       locals, parameters, frames, sources, layouts_table, data, hosts, commands, calls,
                                                                       references, components, points, watches, states, entries,
                                                                       queries, system_root, system_variables, 0, descriptions,
                                                                       system_description)), effects);
}

// `paths` and `sources` are the files of every package, `paths[0]` one of the
// root package's; `project` and each named collection are roots that paths
// and imports resolve against. `abi` is the target's prepared header ABI,
// `names` its instruction names in ordinal order, and `natives` the native
// functions it links.
pub Compile :: (project: string, collection_names: string[], collection_paths: string[], paths: string[],
                sources: string[], debug: bool, target: Target, abi: u64, names: string[], natives: Native[],
                ports: Port[], identities: u64[]) -> Result {
    return CompileWithEffects(project, collection_names, collection_paths, paths, sources, debug, target, abi,
                              names, natives, ports, identities, resize([int(0)], length(natives)));
}
// The complete target catalog supplies one effect mask per native, in the
// same order as natives and identities. Compile retains the bootstrap's
// stable signature for its verified pure-native catalog.
pub CompileWithEffects :: (project: string, collection_names: string[], collection_paths: string[], paths: string[],
                           sources: string[], debug: bool, target: Target, abi: u64, names: string[], natives: Native[],
                           ports: Port[], identities: u64[], native_effects: int[]) -> Result {
    ops := ResolveOps(names, debug);
    resolved_ports := LegacyPorts(ports);
    resolved_natives := LegacyNatives(natives, names);
    complete := NativeInputValid(resolved_natives, resolved_ports, identities, native_effects);
    if (abi == 0 || !Complete(ops) || !complete || length(paths) == 0 || length(paths) != length(sources) ||
        length(collection_names) != length(collection_paths)) {
        return InputFailure(-1, "unsupported compiler input or target");
    }
    collections: routes.Collection[] = [];
    index: int = 0;
    while (index < length(collection_names)) {
        collection: routes.Collection = {name: collection_names[index], path: collection_paths[index], has_name: true,
                                         has_path: true};
        collections.append(collection);
        index += 1;
    }
    inputs: snapshot.Input[] = [];
    sizes: u64[] = [];
    index = 0;
    while (index < length(paths)) {
        input: snapshot.Input = {path: paths[index], text: sources[index], has_path: true, has_text: true};
        inputs.append(input);
        sizes.append(u64(strings.ByteLength(sources[index])));
        index += 1;
    }
    options: snapshot.Options = {project: project, has_project: true, has_options: true,
                                 has_files: true, has_collections: length(collections) != 0, file_count: length(inputs),
                                 collection_count: length(collections)};
    switch snapshot.Build(options, collections, inputs, sizes) {
        case .Rejected(diagnostic, related, graph_error, cycle, documents, nodes, imports):
            return Result.Rejected(diagnostic);
        case .Accepted(roots, documents, nodes, imports, built):
            switch built {
                case .Rejected(error, cycle):
                    return InputFailure(-1, "package graph is invalid");
                case .Accepted(packages, files_of, file_packages, order, edges, links):
                    switch Declare(nodes, documents, packages, files_of, order, imports, links, target) {
                        case .Failed(diagnostic):
                            return Result.Rejected(diagnostic);
                        case .Collected(callables, params, types, members, constants):
                            return Link(nodes, documents, packages, files_of, file_packages[0], order, edges, links,
                                        callables, params, types, members, constants, resolved_natives, resolved_ports, identities, native_effects, ops, target,
                                        abi);
                    }
            }
    }
}
// Compile's closure, for a host that takes one byte[] result; empty when
// Compile rejects the input, whose diagnostic Compile returns.
pub CompileClosure :: (project: string, collection_names: string[], collection_paths: string[], paths: string[],
                       sources: string[], debug: bool, target: Target, abi: u64, names: string[],
                       natives: Native[], ports: Port[], identities: u64[]) -> u8[] {
    switch Compile(project, collection_names, collection_paths, paths, sources, debug, target, abi, names, natives,
                   ports, identities) {
        case .Rejected(diagnostic):
            return [];
        case .Compiled(module, bytes):
            return bytes;
    }
}
pub CompileClosureWithEffects :: (project: string, collection_names: string[], collection_paths: string[], paths: string[],
                                  sources: string[], debug: bool, target: Target, abi: u64, names: string[],
                                  natives: Native[], ports: Port[], identities: u64[], native_effects: int[]) -> u8[] {
    switch CompileWithEffects(project, collection_names, collection_paths, paths, sources, debug, target, abi,
                              names, natives, ports, identities, native_effects) {
        case .Rejected(diagnostic):
            return [];
        case .Compiled(module, bytes):
            return bytes;
    }
}
