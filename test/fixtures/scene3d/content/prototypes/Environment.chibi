package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Environment")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Environment", data.Object([
                    data.Field.Named("adaptation_speed", data.Value.Real(2.0)),
                    data.Field.Named("ambient_ground", data.Value.UInt(252844799)),
                    data.Field.Named("ambient_intensity", data.Value.Real(1.0)),
                    data.Field.Named("ambient_sky", data.Value.UInt(724780543)),
                    data.Field.Named("auto_exposure", data.Value.Bool(true)),
                    data.Field.Named("bloom_radius", data.Value.Real(0.012)),
                    data.Field.Named("bloom_strength", data.Value.Real(0.17999999999999999)),
                    data.Field.Named("bloom_threshold", data.Value.Real(1.0)),
                    data.Field.Named("fog_resolution", data.Value.Real(0.25)),
                    data.Field.Named("fog_steps", data.Value.UInt(4)),
                    data.Field.Named("occlusion", data.Value.Text("Medium")),
                    data.Field.Named("occlusion_radius", data.Value.Real(120.0)),
                    data.Field.Named("sky", data.Value.Text("content/skies/field.hdr"))
                ]))
            ]))
        ])
    );
}
