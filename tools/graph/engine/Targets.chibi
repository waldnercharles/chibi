// A target's system include directories, which CMake gives after its others as
// -isystem: staged headers as Includes names them.
// Cute's Linux interface links s2n after PhysicsFS and before SDL. Preserve
// that transitive include order; other platforms do not link s2n.
pub SystemIncludes :: (target: string) -> string[] {
    if (target == "chibi") {
        return [
            "public/math"
        ];
    }
    if (target == "chibi_application") {
        return [
            "public/math"
        ];
    }
    includes: string[] = [];
    for (include in CommonSystemIncludes(target)) {
        if (os.Platform() == "Linux" && include == "third-party/include/chibi/vendor/physfs_static/1") {
            includes.append("system/opengl");
        }
        if (os.Platform() == "Linux" && include == "third-party/include/chibi/vendor/SDL3_Headers/1") {
            includes.extend(["third-party/include/chibi/vendor/s2n/1", "third-party/include/chibi/vendor/s2n/2"]);
        }
        includes.append(include);
    }
    return includes;
}

CommonSystemIncludes :: (target: string) -> string[] {
    if (target == "chibi_vector_capabilities") {
        return ["public/math"];
    }
    if (target == "chibi_native_types") {
        return ["public/math"];
    }
    if (target == "chibi_native_bindings") {
        return ["public/math"];
    }
    if (target == "chibi_host_native_default") {
        return ["public/math"];
    }
    if (target == "chibi-compile") {
        return [
            "public/math"
        ];
    }
    if (target == "test_language") {
        return [
            "third-party/include/chibi/vendor/enkits/1",
            "public/math"
        ];
    }
    if (target == "chibi_sdk_contracts") {
        return ["public/math"];
    }
    if (target == "chibi_native_consumer") {
        return ["public/math"];
    }
    if (target == "chibi_source_runtime_consumer") {
        return ["public/math"];
    }
    if (target == "chibi_source_features_consumer") {
        return [
            "public/math",
            "third-party/include/chibi/vendor/cute/1",
            "third-party/include/chibi/vendor/cute/2",
            "third-party/include/chibi/vendor/cute/3",
            "third-party/include/chibi/vendor/cute/4",
            "third-party/include/chibi/vendor/cute/5",
            "third-party/include/chibi/vendor/physfs_static/1",
            "third-party/include/chibi/vendor/SDL3_Headers/1",
            "third-party/include/chibi/vendor/SDL3_Headers/2"
        ];
    }
    if (target == "test_tools") {
        return [
            "public/math",
            "third-party/include/chibi/vendor/cute/1", "third-party/include/chibi/vendor/cute/2",
            "third-party/include/chibi/vendor/cute/3", "third-party/include/chibi/vendor/cute/4",
            "third-party/include/chibi/vendor/cute/5", "third-party/include/chibi/vendor/physfs_static/1",
            "third-party/include/chibi/vendor/SDL3_Headers/1",
            "third-party/include/chibi/vendor/SDL3_Headers/2", "third-party/include/chibi/vendor/box3d/1"
        ];
    }
    if (target == "chibi_execution") {
        return ["third-party/include/chibi/vendor/sljit/1"];
    }
    if (target == "chibi_task_pool_runtime") {
        return ["third-party/include/chibi/vendor/enkits/1"];
    }
    if (target == "chibi_compiler_host") {
        return [];
    }
    return [];
}

// The macros a target's compiles define, before its include directories.
pub Defines :: (target: string) -> string[] {
    if (target == "chibi_execution") {
        return ["CHIBI_HAVE_SJLIT=1"];
    }
    if (target == "chibi_task_pool_runtime") {
        return ["CHIBI_HAS_ENKITS=1", "ENKITS_TASK_PRIORITIES_NUM=3"];
    }
    if (target == "policy_worker") {
        return ["_DEFAULT_SOURCE", "_POSIX_C_SOURCE=200809L"];
    }
    if (target == "benchmark_trials") {
        return ["_POSIX_C_SOURCE=200809L"];
    }
    if (target == "test_language") {
        return [
            "CHIBI_PACKAGE_TEST_POOL=1", "CHIBI_TEST_ASSET_COMPILER_HOST=1", "CHIBI_TEST_ENKITS=1",
            "CHIBI_TEST_RECORD_SERVICES", "CHIBI_TEST_SOURCE_ASSETS", "ENKITS_TASK_PRIORITIES_NUM=3"
        ];
    }
    if (target == "chibi_sdk_contracts") {
        return [
            "CHIBI_TEST_SOURCE_FEATURES=1", "CHIBI_TEST_SOURCE_RUNTIME=1"
        ];
    }
    if (target == "chibi_native_consumer") {
        return [
            "CHIBI_SOURCE_ROOT=\"{source_root}\"", "CHIBI_TEST_NATIVE_RUNTIME=1",
            "CHIBI_TEST_PREPARATION=1"
        ];
    }
    if (target == "chibi_source_features_consumer") {
        return [
            "CF_RUNTIME_SHADER_COMPILATION", "CF_STATIC", "CHIBI_SOURCE_ROOT=\"{source_root}\"",
            "IMGUI_USE_WCHAR32", "ImDrawIdx=unsigned int"
        ];
    }
    if (target == "test_tools") {
        return [
            "CF_RUNTIME_SHADER_COMPILATION", "CF_STATIC",
            "CHIBI_POLICY_WORKER_PATH=\"{program:policy_worker}\"",
            "CHIBI_SOURCE_ROOT=\"{source_root}\"", "CHIBI_TEST_ASSET_VALUES=1",
            "CHIBI_TEST_BOX3D=1", "CHIBI_TEST_BUILD_PROCESS=1", "CHIBI_TEST_COMPILER_ARTIFACT=1",
            "CHIBI_TEST_FMT=1", "CHIBI_TEST_NATIVE_RUNTIME=1", "CHIBI_TEST_PROGRAM=1",
            "CHIBI_TEST_SOURCE_FEATURES=1",
            "CHIBI_TEST_SOURCE_RUNTIME=1",
            "IMGUI_USE_WCHAR32", "ImDrawIdx=unsigned int", "_DARWIN_C_SOURCE", "_DEFAULT_SOURCE",
            "_POSIX_C_SOURCE=200809L"
        ];
    }
    return [];
}

// Options a target adds after the profile's flags. The graph drives Clang
// and GCC, which both take them: fields and math keep floating-poin
// contraction off so their results match on every backend, vendored C
// compiles without warnings, and on Linux execution puts each function and
// object in its own section, so the compiler host's link can discard the
// prepared writer it does not call.
pub Options :: (target: string) -> string[] {
    if (target == "chibi_program_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_fmt") {
        return ["-w"];
    }
    if (target == "chibi_json") {
        return ["-w"];
    }
    if (target == "chibi_execution" && os.Platform() == "Linux") {
        return ["-ffunction-sections", "-fdata-sections"];
    }
    if (target == "chibi_math_capabilities") {
        return ["-ffp-contract=off"];
    }
    if (target == "test_host") {
        return ["-UNDEBUG"];
    }
    if (target == "concurrent_runner") {
        return ["-UNDEBUG"];
    }
    if (target == "policy_worker") {
        return ["-UNDEBUG"];
    }
    if (target == "test_language") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_asset_compiler_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_sdk_contracts") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_native_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_asset_values_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_source_runtime_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "chibi_source_features_consumer") {
        return ["-UNDEBUG"];
    }
    if (target == "test_tools") {
        return ["-UNDEBUG"];
    }
    return [];
}

// Options one source adds after its target's, as CMake's COMPILE_OPTIONS
// source property adds them: generated parsers compile without warnings.
pub SourceOptions :: (target: string, file: string) -> string[] {
    return [];
}

// The language tests' sources that include private headers below src/, as
// test/language/CMakeLists.txt gives them.
LanguageTestsOverSource :: () -> string[] {
    return [
        "src/host/process.c", "src/host/native_libraries.c", "src/host/stack_overflow.c",
        "src/toolchain/compiler_artifact.c", "src/toolchain/compiler_host.c",
        "src/toolchain/compiler_json.c", "src/toolchain/compiler_syntax.c",
        "src/toolchain/compiler_target.c",
        "test/language/capture.c",
        "test/language/component_write_ir.c",
        "test/language/execution.c", "test/language/execution_scope.c",
        "test/language/host_packages_compiler.c",
        "test/language/native_census.c", "test/language/scalar_host.c",
        "test/language/package_compiler_chibi.c",
        "test/language/ranges.c",
        "test/language/record_prepared.c"
    ];
}

// Defines one source adds after its target's, as CMake's COMPILE_DEFINITIONS
// source property adds them; Expand fills {source_root}, {build_type},
// {sha256:PATH} and {program:NAME}.
pub SourceDefines :: (target: string, file: string) -> string[] {
    if (target == "test_language" && file == "test/language/package_compiler_chibi.c") {
        return ["CHIBI_CORE_MATH_ROOT=\"{source_root}/packages/core/math\""];
    }
    if (target == "test_language" &&
        (file == "test/language/host_packages_compiler.c" || file == "test/language/native_census.c" ||
         file == "test/language/scalar_host.c")) {
        return ["CHIBI_SOURCE_ROOT=\"{source_root}\""];
    }
    if (target == "test_tools" && file == "test/tools/native_build.c") {
        return ["CHIBI_SOURCE_ROOT=\"{source_root}\""];
    }
    return [];
}

// Include directories one source adds before its target's, as CMake's
// INCLUDE_DIRECTORIES source property adds them: test_tools' C export cases
// the testing headers.
pub SourceIncludes :: (target: string, file: string) -> string[] {
    if (target == "test_language" && Listed(LanguageTestsOverSource(), file)) {
        return ["src"];
    }
    return [];
}

// The C++ standard a target's C++ sources compile with, its CMake
// CXX_STANDARD with GNU extensions, or empty for none: the UI host, over RmlUi,
// declares C++17.
pub CxxStandard :: (target: string) -> string {
    return "";
}

// The name a target's headers are staged under, its CMake EXPORT_NAME when
// that is not the target's name without chibi_, and the target an expor
// name stages.
pub ExportName :: (target: string) -> string {
    return "";
}
pub ExportTarget :: (component: string) -> string {
    return Join(["chibi_", component]);
}

// Whether names hold name.
Listed :: (names: string[], name: string) -> bool {
    for (listed in names) {
        if (listed == name) {
            return true;
        }
    }
    return false;
}

// Headers a header set configures below its private root, `HEADER=INPUT`, as
// CMake's configure_file writes them: a `.in` INPUT with its Substitutions,
// any other copied. The language tests embed the Chibi sources they compile;
// the tooling tests copy the fixtures their consumers include.
pub Configures :: (target: string) -> string[] {
    if (target == "chibi_language_testing") {
        return [
            "third_party/pico_headers/pico_unit.h=third_party/pico_headers/pico_unit.h",
            "test/prepared_fixture.h=test/prepared_fixture.h",
            "test/parallel.h=test/parallel.h",
            "package_core_source.h=test/language/package_core_source.h.in",
            "host_packages_source.h=test/language/host_packages_source.h.in",
            "portable_asset_source.h=test/language/portable_asset_source.h.in",
            "package_graph_chibi_source.h=test/language/package_graph_chibi_source.h.in",
            "syntax_chibi_source.h=test/language/syntax_chibi_source.h.in",
            "package_syntax_chibi_source.h=test/language/package_syntax_chibi_source.h.in",
            "package_paths_chibi_source.h=test/language/package_paths_chibi_source.h.in",
            "json_string_chibi_source.h=test/language/json_string_chibi_source.h.in",
            "package_routes_chibi_source.h=test/language/package_routes_chibi_source.h.in",
            "package_snapshot_chibi_source.h=test/language/package_snapshot_chibi_source.h.in",
            "lexical_binding_chibi_source.h=test/language/lexical_binding_chibi_source.h.in",
            "prepared_writer_chibi_source.h=test/language/prepared_writer_chibi_source.h.in",
            "package_compiler_chibi_source.h=test/language/package_compiler_chibi_source.h.in"
        ];
    }
    if (target == "chibi_tools_testing") {
        return [
            "third_party/pico_headers/pico_unit.h=third_party/pico_headers/pico_unit.h",
            "test/prepared_fixture.h=test/prepared_fixture.h",
            "test/tools/fixture.h=test/tools/fixture.h",
            "test/support/reflected_types.h=test/support/reflected_types.h",
            "export_compiler.h=test/tools/export_compiler.h.in"
        ];
    }
    return [];
}

// The values of a target's `@NAME@` placeholders, `NAME=KIND:VALUE`: `bytes:PATH`
// as CMake's file(READ ... HEX) initializer, `cstring:PATH` as C string lines,
// and `compiler:ARGUMENT` as C string initializer lines of the profile's C
// compiler, its C flags and then ARGUMENT, as test/tools writes the compiler
// its exported C builds with. `test-sources:PREFIX:PACKAGE:DIR` and
// `test-inputs:PREFIX:PACKAGE:DIR` discover a test package's direct .chibi files.
pub Substitutions :: (target: string) -> string[] {
    if (target == "chibi_language_testing") {
        return [
            "CHIBI_PORTABLE_ASSET_BYTES=bytes:test/fixtures/portable-byte-asset/Build.chibi",
            "CHIBI_COMPILER_SYNTAX_BYTES=bytes:tools/compiler/compiler_syntax/Syntax.chibi",
            "CHIBI_CORE_STRINGS_BYTES=bytes:packages/core/strings/Strings.chibi",
            "CHIBI_CORE_TIME_BYTES=bytes:packages/core/time/Time.chibi",
            "CHIBI_CORE_TIME_TEST_BYTES=bytes:test/standard_library/time/TimeTests.chibi",
            "CHIBI_HOST_CLOCK_BYTES=bytes:packages/host/clock/Clock.chibi",
            "CHIBI_LEXICAL_BINDING_BYTES=bytes:tools/compiler/lexical_binding/Binding.chibi",
            "CHIBI_LLVM_NATIVE_BYTES=bytes:tools/compiler/llvm_native/Emit.chibi",
            "CHIBI_NATIVE_ABI_BYTES=bytes:tools/compiler/native_abi/Abi.chibi",
            "CHIBI_PACKAGE_COMPILER_BEHAVIOR_BYTES=bytes:tools/compiler/package_compiler/Behavior.chibi",
            "CHIBI_PACKAGE_COMPILER_QUERIES_BYTES=bytes:tools/compiler/package_compiler/Queries.chibi",
            "CHIBI_PACKAGE_COMPILER_QUERYLOOPS_BYTES=bytes:tools/compiler/package_compiler/QueryLoops.chibi",
            "CHIBI_PACKAGE_COMPILER_BODY_BYTES=bytes:tools/compiler/package_compiler/Body.chibi",
            "CHIBI_PACKAGE_COMPILER_GENERICS_BYTES=bytes:tools/compiler/package_compiler/Generics.chibi",
            "CHIBI_PACKAGE_COMPILER_COMPTIME_BYTES=bytes:tools/compiler/package_compiler/Comptime.chibi",
            "CHIBI_PACKAGE_COMPILER_COMPILE_BYTES=bytes:tools/compiler/package_compiler/Compile.chibi",
            "CHIBI_PACKAGE_COMPILER_MAPS_BYTES=bytes:tools/compiler/package_compiler/Maps.chibi",
            "CHIBI_PACKAGE_COMPILER_MATH_BYTES=bytes:tools/compiler/package_compiler/Math.chibi",
            "CHIBI_MATH_TYPES_BYTES=bytes:tools/compiler/math_types/Types.chibi",
            "CHIBI_MATH_FUNCTIONS_BYTES=bytes:tools/compiler/math_types/Functions.chibi",
            "CHIBI_PACKAGE_COMPILER_NUMBER_BYTES=bytes:tools/compiler/package_compiler/Number.chibi",
            "CHIBI_PACKAGE_COMPILER_OPTIONAL_BYTES=bytes:tools/compiler/package_compiler/Optional.chibi",
            "CHIBI_PACKAGE_COMPILER_REFERENCES_BYTES=bytes:tools/compiler/package_compiler/References.chibi",
            "CHIBI_PACKAGE_COMPILER_POINTERS_BYTES=bytes:tools/compiler/package_compiler/Pointers.chibi",
            "CHIBI_PACKAGE_COMPILER_SCALAR_BYTES=bytes:tools/compiler/package_compiler/Scalar.chibi",
            "CHIBI_PACKAGE_COMPILER_SCALARARRAYS_BYTES=bytes:tools/compiler/package_compiler/ScalarArrays.chibi",
            "CHIBI_PACKAGE_COMPILER_FALLIBLE_BYTES=bytes:tools/compiler/package_compiler/Fallible.chibi",
            "CHIBI_PACKAGE_COMPILER_SEQUENCES_BYTES=bytes:tools/compiler/package_compiler/Sequences.chibi",
            "CHIBI_PACKAGE_COMPILER_TASKS_BYTES=bytes:tools/compiler/package_compiler/Tasks.chibi",
            "CHIBI_PACKAGE_COMPILER_TASKRESULTS_BYTES=bytes:tools/compiler/package_compiler/TaskResults.chibi",
            "CHIBI_PACKAGE_COMPILER_STEPS_BYTES=bytes:tools/compiler/package_compiler/Steps.chibi",
            "CHIBI_PACKAGE_COMPILER_TREE_BYTES=bytes:tools/compiler/package_compiler/Tree.chibi",
            "CHIBI_PACKAGE_GRAPH_BYTES=bytes:tools/compiler/package_graph/Graph.chibi",
            "CHIBI_PACKAGE_PATHS_BYTES=bytes:tools/compiler/package_paths/Paths.chibi",
            "CHIBI_JSON_STRING_BYTES=bytes:tools/compiler/json_string/JsonString.chibi",
            "CHIBI_PACKAGE_ROUTES_BYTES=bytes:tools/compiler/package_routes/Routes.chibi",
            "CHIBI_PACKAGE_SNAPSHOT_BYTES=bytes:tools/compiler/source_snapshot/Snapshot.chibi",
            "CHIBI_PACKAGE_SYNTAX_BYTES=bytes:tools/compiler/package_syntax/Extract.chibi",
            "CHIBI_PREPARED_WRITER_BYTES=bytes:tools/compiler/prepared_writer/Writer.chibi",
            "CHIBI_SCALAR_CASES_BYTES=bytes:test/scalar_facts/cases/Cases.chibi",
            "CHIBI_SCALAR_FACTS_BYTES=bytes:tools/compiler/scalar_facts/Facts.chibi",
            "CHIBI_SCALAR_LLVM_BYTES=bytes:tools/compiler/scalar_llvm/Emit.chibi",
            "CHIBI_SOURCE_TOKENIZER_BYTES=bytes:tools/compiler/source_tokenizer/Tokenizer.chibi",
            "CHIBI_SOURCE_PARSER_TREE_BYTES=bytes:tools/compiler/source_parser/Tree.chibi",
            "CHIBI_SOURCE_PARSER_TYPES_BYTES=bytes:tools/compiler/source_parser/Types.chibi",
            "CHIBI_SOURCE_PARSER_EXPRESSIONS_BYTES=bytes:tools/compiler/source_parser/Expressions.chibi",
            "CHIBI_SOURCE_PARSER_STATEMENTS_BYTES=bytes:tools/compiler/source_parser/Statements.chibi",
            "CHIBI_SOURCE_PARSER_DECLARATIONS_BYTES=bytes:tools/compiler/source_parser/Declarations.chibi",
            "CHIBI_SOURCE_PARSER_PARSER_BYTES=bytes:tools/compiler/source_parser/Parser.chibi",
            "CHIBI_SYNTAX_DIAGNOSTICS_BYTES=bytes:tools/compiler/syntax_diagnostics/Diagnostics.chibi",
            "CHIBI_BUILD_WORKFLOW_SOURCE=cstring:test/language/BuildWorkflow.chibi"
        ];
    }
    if (target == "chibi_tools_testing") {
        return ["CHIBI_EXPORT_COMPILER_ARGUMENTS=compiler:-UNDEBUG"];
    }
    return [];
}

// The program that writes a target's `build/` sources before it compiles, or
// empty: reflect writes the native type and binding tables.
pub Generator :: (target: string) -> string {
    if (target == "chibi_native_types" || target == "chibi_native_bindings") {
        return "reflect";
    }
    return "";
}

// The directory below the build directory CMake writes an executable to, as
// the CMake subdirectory that declares it or its RUNTIME_OUTPUT_DIRECTORY
// places it; empty for the build directory itself.
pub ProgramDirectory :: (target: string) -> string {
    if (target == "chibi-compile" || target == "chibi-build-host" ||
        target == "chibi-compiler-host" || target == "chibi") {
        return "sdk";
    }
    if (target == "test_language") {
        return "test/language";
    }
    if (target == "policy_worker" || target == "test_tools" || target == "benchmark_trials") {
        return "test/tools";
    }
    return "";
}

// Files a target installs into the build tree, `DESTINATION=SOURCE`, as roo
// CMakeLists.txt configures them: a directory SOURCE copies every file below
// it. The launcher's players, `chibi version`, `chibi test` and `chibi doc`
// read ../share/chibi as installed ones do.
// build/sdk/chibi_engine_metadata.json is the build identity (Identity).
pub Resources :: (target: string) -> string[] {
    if (target == "chibi-build-host") {
        return [
            "build/share/chibi/compiler=tools/compiler",
            "build/share/chibi/core=packages/core",
            "build/share/chibi/tools/native_aot=tools/native_aot"
        ];
    }
    if (target == "chibi") {
        return [
            "build/share/chibi/engine.json=build/sdk/chibi_engine_metadata.json",
            "build/share/chibi/apps/chibi=apps/chibi",
            "build/share/chibi/apps/host=apps/host",
            "build/share/chibi/core=packages/core"
        ];
    }
    return [];
}

// Source lists a target's tests read, `OUTPUT=ROOT`: every .chibi file below
// ROOT, by absolute path, sorted, as
// test/language/CMakeLists.txt writes the language corpus.
pub SourceLists :: (target: string) -> string[] {
    return [];
}

// The artifact formats the build identity records, as
// sdk/artifact_formats.cmake lists them: `NAME SOURCE HEADER MACRO`,
// then VALUE_WIRE for a format that encodes through types/value_wire and
// EXECUTION_CODECS for the prepared function and record codecs. Paths are
// below src/.
pub ArtifactFormats :: () -> string[] {
    return [
        "execution execution/prepared.c execution/prepared.h EXECUTION_PREPARED_VERSION VALUE_WIRE EXECUTION_CODECS",
        "events runtime/event_catalog.c runtime/event_catalog.h EVENT_CATALOG_VERSION VALUE_WIRE"
    ];
}

// The programs an executable runs, built with it as CMake's add_dependencies
// builds them: test_tools runs the workers and tools whose paths it compiles
// in, and the launcher the compiler and player beside it.
pub Runs :: (target: string) -> string[] {
    if (target == "chibi_asset_compiler_host") {
        return ["chibi-build-host", "chibi-compiler-host"];
    }
    if (target == "chibi") {
        return ["chibi-compile"];
    }
    if (target == "test_tools") {
        return ["policy_worker", "benchmark_trials", "chibi-build-host", "chibi-compiler-host", "chibi-compile"];
    }
    return [];
}

// The executables the graph builds; every other target is a library.
pub Programs :: () -> string[] {
    programs := [
        "reflect", "chibi-build-host", "chibi-compiler-host", "chibi", "test_host", "concurrent_runner",
        "policy_worker", "benchmark_trials"
    ];
    if (os.Platform() == "Darwin" || os.Platform() == "Linux") {
        programs.extend(["chibi-compile", "test_language", "test_tools"]);
    }
    return programs;
}

// Whether an executable links with the C++ compiler, as CMake does when a
// library it links has C++ sources.
pub LinksCxx :: (target: string) -> bool {
    return target == "chibi" || target == "chibi-compile" || target == "test_language" ||
           target == "test_tools";
}

// The libraries whose objects executables link directly, as CMake's OBJECT
// libraries, rather than archive.
pub ObjectLibrary :: (target: string) -> bool {
    return target == "chibi_application" || target == "chibi_build_host" || target == "chibi_asset_compiler_consumer" ||
           Listed(ToolConsumers(), target);
}

// The object libraries an executable links, whose objects come before its
// own, as CMake orders them.
pub LinkedObjects :: (target: string) -> string[] {
    if (target == "chibi") {
        return ["chibi_application"];
    }
    if (target == "chibi-build-host") {
        return ["chibi_build_host"];
    }
    if (target == "test_language") {
        return ["chibi_asset_compiler_consumer"];
    }
    if (target == "test_tools") {
        return [
            "chibi_sdk_contracts", "chibi_program_consumer", "chibi_native_consumer",
            "chibi_asset_values_consumer", "chibi_source_runtime_consumer",
            "chibi_source_features_consumer", "chibi_build_host"
        ];
    }
    return [];
}

// Options an executable's link adds after the profile's, its CMake
// LINK_OPTIONS: the compiler host drops what it does not call.
pub LinkOptions :: (target: string) -> string[] {
    if ((target == "chibi-compiler-host" || target == "test_language") && os.Platform() == "Darwin") {
        return ["-Wl,-dead_strip"];
    }
    if (target == "chibi-compiler-host") {
        return ["-Wl,--gc-sections"];
    }
    // SDL's interface link option, which CMake puts among the link flags.
    if (target == "test_tools") {
        if (os.Platform() == "Linux") {
            return ["-pthread"];
        }
        return ["-lpthread"];
    }
    return [];
}

// What an executable links after its output, in CMake's order, which may
// name a library twice: the graph's libraries by name, the third-party
// archive's as `third-party/` paths, and options and framework names as they
// are.
pub Links :: (target: string) -> string[] {
    if (target == "reflect") {
        return ["chibi_capabilities", "chibi_capabilities", "chibi_types", "chibi_support", "-lm"];
    }
    if (target == "chibi-build-host") {
        return [
            "chibi_compiler_host",
            "chibi_support", "chibi_value_document", "chibi_asset_json", "chibi_asset_values", "chibi_json", "chibi_native_prepared",
            "chibi_behavior_runtime", "chibi_execution", "chibi_ecs",
            "third-party/lib/chibi-vendor/libchibi_vendor_sljit.a", "chibi_events",
            "chibi_text_capabilities", "chibi_fmt", "chibi_array_capabilities", "chibi_native_capabilities",
            "chibi_capabilities", "chibi_types", "chibi_support", "-lm"
        ];
    }
    if (target == "chibi-compiler-host") {
        return [
            "chibi_compiler_host",
            "chibi_asset_values", "chibi_json",
            "chibi_native_prepared", "chibi_behavior_runtime", "chibi_execution", "chibi_ecs",
            "third-party/lib/chibi-vendor/libchibi_vendor_sljit.a", "chibi_events",
            "chibi_text_capabilities", "chibi_fmt", "chibi_array_capabilities", "chibi_native_capabilities",
            "chibi_capabilities", "chibi_value_document", "chibi_types", "chibi_asset_json",
            "chibi_asset_values", "chibi_json", "chibi_support", "-lm"
        ];
    }
    if (target == "chibi" && os.Platform() == "Darwin") {
        return [
            "chibi_program", "chibi_source_catalog",
            "chibi_asset_compiler_host", "chibi_compiler_host", "chibi_asset_json", "chibi_native_prepared",
            "chibi_scheduling",
            "chibi_host_native_default", "chibi_host_native_catalog",
            "chibi_selection_capabilities",
            "chibi_set_capabilities", "chibi_comparison_capabilities", "chibi_conversion_capabilities",
            "chibi_native_bindings", "chibi_vector_capabilities",
            "chibi_math_capabilities", "chibi_arithmetic_capabilities", "chibi_value_document", "chibi_asset_values", "third-party/lib/chibi-vendor/libchibi_vendor_box3d.a", "third-party/lib/chibi-vendor/libchibi_vendor_box2d.a", "chibi_behavior_runtime", "chibi_events", "chibi_native_types",
            "chibi_core_capabilities", "chibi_execution", "chibi_ecs",
            "third-party/lib/chibi-vendor/libchibi_vendor_sljit.a", "chibi_text_capabilities", "chibi_fmt",
            "chibi_array_capabilities", "chibi_task_pool_runtime",
            "third-party/lib/chibi-vendor/libchibi_vendor_enkits.a", "-lc++", "chibi_compiler_syntax",
            "chibi_compiler_json", "chibi_json", "chibi_native_capabilities", "chibi_capabilities",
            "chibi_types", "chibi_support", "-lm"
        ];
    }
    if (target == "chibi" && os.Platform() == "Linux") {
        links := ["chibi_program"];
        links.extend(LinuxLinks("chibi-compile"));
        return links;
    }
    if (os.Platform() == "Linux") {
        links: string[] = [];
        if (target == "test_language" || target == "test_tools") {
            links.append("chibi_program");
        }
        links.extend(LinuxLinks(target));
        return links;
    }
    if (target == "chibi-compile" && os.Platform() == "Darwin") {
        return [
            "chibi_behavior_runtime",
            "chibi_asset_json", "chibi_asset_compiler_host", "chibi_compiler_host", "chibi_asset_json", "chibi_native_prepared",
