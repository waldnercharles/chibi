package native_link_host

import link "project:native_link"
import os "core:os"
import strings "core:strings"

// The effects of the link step: finding the LLVM tools and the C library's
// start files, writing the macOS stubs and running the tools. Everything it
// runs comes from native_link, which has no effects and is tested on its own.

Join :: (parts: string[]) -> string {
    return strings.Join(parts, "");
}

Fail :: (kind: int, code: int) -> link.Error {
    failed: link.Error = {kind: kind, code: code};
    return failed;
}

// The LLVM tool `name` in the LLVM folder, "" when it is not there. A Windows
// folder holds name.exe, and a distribution's lld tools are links to lld.
pub Tool :: (llvm: string, name: string) -> string {
    for (candidate in [Join([llvm, "/", name]), Join([llvm, "/", name, ".exe"])]) {
        kind := os.Kind(candidate);
        if (kind == os.KindFile || kind == os.KindLink) {
            return candidate;
        }
    }
    return "";
}

pub Object :: (llvm: string, module: string, object: string, level: int) -> link.Error? {
    llc := Tool(llvm, "llc");
    if (llc == "") {
        return Fail(link.MissingTool, 0);
    }
    status := os.Run(link.ObjectCommand(llc, module, object, level));
    if (status != 0) {
        return Fail(link.ToolFailed, status);
    }
    return nil;
}

// Each module optimized by opt and compiled by llc to its object, at most
// `jobs` modules at once, so the pieces of a split module use the machine's
// cores; `object + ".bc"` holds the optimized bitcode in between and is
// removed. The objects depend on the modules alone, whatever `jobs` is. The
// first failure stops the others.
pub Objects :: (llvm: string, modules: string[], objects: string[], level: int, jobs: int) -> link.Error? {
    opt := Tool(llvm, "opt");
    llc := Tool(llvm, "llc");
    if (opt == "" || llc == "") {
        return Fail(link.MissingTool, 0);
    }
    // Each module's step: 0 waiting, 1 optimizing, 2 compiling, 3 done.
    count := length(modules);
    steps := resize([int(0)], count);
    processes := resize([int(0)], count);
    next := 0;
    running := 0;
    done := 0;
    while (done < count) {
        while (running < jobs && next < count) {
            processes[next] = os.Start(link.OptimizeCommand(opt, modules[next], Join([objects[next], ".bc"]), level),
                                       os.Piped);
            steps[next] = 1;
            running += 1;
            next += 1;
        }
        // A slice on the oldest running module, then a look at the others,
        // so a short one frees its place while a long one runs.
        oldest := 0;
        while (steps[oldest] == 0 || steps[oldest] == 3) {
            oldest += 1;
        }
        for (index in oldest..<next) {
            if (steps[index] != 1 && steps[index] != 2) {
                continue;
            }
            wait := 0;
            if (index == oldest) {
                wait = 20;
            }
            status := os.Wait(processes[index], wait);
            if (status == os.StillRunning) {
                continue;
            }
            if (status != 0) {
                for (other in 0..<next) {
                    if (other != index && (steps[other] == 1 || steps[other] == 2)) {
                        stopped := os.Kill(processes[other]);
                    }
                }
                return Fail(link.ToolFailed, status);
            }
            if (steps[index] == 1) {
                processes[index] = os.Start(link.ObjectCommand(llc, Join([objects[index], ".bc"]), objects[index], level),
                                            os.Piped);
                steps[index] = 2;
            } else {
                removed := os.Remove(Join([objects[index], ".bc"]));
                steps[index] = 3;
                running -= 1;
                done += 1;
            }
        }
    }
    return nil;
}

// The folder with the C library's start files and development library, and
// the dynamic linker's path, on a Linux system; empty strings when it has none.
pub Libc :: () -> (folder: string, interpreter: string) {
    for (folder in link.LibcFolders()) {
        complete := true;
        for (name in link.LibcFiles()) {
            complete = complete && os.IsFile(Join([folder, "/", name]));
        }
        if (!complete) {
            continue;
        }
        for (interpreter in link.Interpreters()) {
            if (os.Exists(interpreter)) {
                return (folder, interpreter);
            }
        }
    }
    return ("", "");
}

// The plan with what the system provides filled in.
pub Discover :: (plan: link.Plan) -> link.Plan {
    found := plan;
    if (link.TargetOf(plan.triple) == link.LinuxX64 && !plan.static && plan.libc == "") {
        located := Libc();
        found.libc = located.folder;
        found.interpreter = located.interpreter;
    }
    return found;
}

Write :: (path: string, text: string) -> bool {
    return os.WriteText(path, text) == nil;
}

// The link itself, with the stubs written into plan.work.
Build :: (plan: link.Plan) -> link.Error? {
    target := link.TargetOf(plan.triple);
    if (target < 0) {
        return Fail(link.BadTriple, 0);
    }
    if (length(plan.objects) == 0 || plan.output == "") {
        return Fail(link.BadPlan, 0);
    }
    if (Tool(plan.llvm, link.Linker(target)) == "") {
        return Fail(link.MissingTool, 0);
    }
    ready := Discover(plan);
    if (target == link.LinuxX64 && !plan.static && ready.libc == "") {
        return Fail(link.MissingLibc, 0);
    }
    // The stubs, and on Windows the import libraries lld-link writes from them.
    for (stub in link.Imports(ready)) {
        if (!Write(link.ImportPath(ready, stub.name), link.ImportText(ready, stub))) {
            return Fail(link.CannotWrite, 0);
        }
        made := link.ImportCommand(ready, stub.name);
        if (length(made) > 0) {
            made[0] = Tool(plan.llvm, "lld-link");
            written := os.Run(made);
            if (written != 0) {
                return Fail(link.ToolFailed, written);
            }
        }
    }
    partial := link.Partial(ready);
    if (os.Exists(partial) && os.Remove(partial) != nil) {
        return Fail(link.CannotWrite, 0);
    }
    command := link.Command(ready, partial);
    command[0] = Tool(plan.llvm, link.Linker(target));
    status := os.Run(command);
    if (status != 0) {
        if (os.Exists(partial) && os.Remove(partial) != nil) {
            return Fail(link.CannotWrite, 0);
        }
        return Fail(link.ToolFailed, status);
    }
    if (os.Rename(partial, plan.output) != nil) {
        return Fail(link.CannotWrite, 0);
    }
    return nil;
}

// The files Build leaves in the work folder.
Leftovers :: (plan: link.Plan) -> string[] {
    names: string[] = [link.Partial(plan)];
    for (stub in link.Imports(plan)) {
        names.append(link.ImportPath(plan, stub.name));
        if (length(link.ImportCommand(plan, stub.name)) > 0) {
            names.append(link.ImportLibrary(plan, stub.name));
        }
    }
    return names;
}

// Links the plan's program and publishes it at `output`, replacing nothing
// until the link has succeeded. Nothing else outlives the call: the work
// folder, `output.work` unless the plan names one, holds only the stubs and is
// removed with them. No path, time or process id reaches the program's bytes.
pub Link :: (plan: link.Plan) -> link.Error? {
    ready := plan;
    own := false;
    if (plan.work == "") {
        ready.work = Join([plan.output, ".work"]);
        own = true;
    }
    if (os.Kind(ready.work) == os.KindNone) {
        if (os.MakeDirectory(ready.work) != nil) {
            return Fail(link.CannotWrite, 0);
        }
    } else {
        own = false;
    }
    failure := Build(ready);
    cleaned := true;
    for (path in Leftovers(ready)) {
        cleaned = cleaned && (!os.Exists(path) || os.Remove(path) == nil);
    }
    if (own) {
        cleaned = cleaned && (!os.Exists(ready.work) || os.Remove(ready.work) == nil);
    }
    if (failure != nil) {
        return failure;
    }
    if (!cleaned) {
        return Fail(link.CannotWrite, 0);
    }
    return nil;
}
