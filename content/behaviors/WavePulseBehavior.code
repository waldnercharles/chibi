behavior "WavePulseBehavior" {
    owner "ecs.entity";
    state Age: float = 0.0;
    value age_0_8: double = (cast<double>(&state.Age) / 0.8);
    value _24_336_progress: double = (24 + 336 * &local.Progress);
    value max_0_radius_28: double = (max(0, _24_336_progress - 28));
    value _0_65_1_progress: double = (0.65 * (1 - &local.Progress));
    local Progress = age_0_8;
    on Tick as tick() {
        &state.Age += cast<double>(&delta);
        if (&local.Progress >= 1) {
            destroy_entity(Entity: self);
        } else {
            set_component(Component: "GAME.GameSurfaceInfluence", Entity: 0, Value.strength: float = _0_65_1_progress, Value.radius: float = _24_336_progress, Value.inner_radius: float = max_0_radius_28);
        }
    }
}
