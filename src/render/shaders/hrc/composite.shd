layout(set = 2, binding = 1) uniform sampler2D scene_tex;
layout(set = 2, binding = 2) uniform sampler2D fluence_tex;
layout(set = 2, binding = 3) uniform sampler2D emission_tex;
layout(set = 2, binding = 4) uniform sampler2D absorption_tex;
layout(set = 2, binding = 5) uniform sampler2D albedo_tex;
layout(set = 2, binding = 6) uniform sampler2D normal_tex;

layout(set = 2, binding = 7) uniform sampler2D background_tex;
layout(set = 2, binding = 8) uniform sampler2D visibility_tex;
layout(set = 2, binding = 9) uniform sampler2D luminance_tex;
layout(set = 2, binding = 10) uniform sampler2D surface_tex;
layout(set = 2, binding = 11) uniform sampler2D surface_dir_tex;
layout(set = 2, binding = 12) uniform sampler2D relief_tex;

layout(set = 3, binding = 1) uniform shd_uniforms
{
    float ambient;
    float intensity;
    float debug_view;
    float shadow_floor;
    float fog;
    float dither_phase;
    vec4 crop_uv;
    int split_lighting;
    float surface_sigma;
    // x enabled, y relief, z bevel, w specular gain.
    vec4 surface_params;
    // xy canvas uv to surface uv scale, zw one surface texel in uv.
    vec4 surface_map;
    int linear_output;
    float world_per_px;
    float reconstruction_threshold;
};

#include "color.shd"

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

float reconstruction_transmittance(ivec2 p, ivec2 sample_size, ivec2 full_size)
{
    vec2 uv = (vec2(p) + 0.5) / vec2(sample_size);
    ivec2 absorption_p = clamp(ivec2(uv * vec2(full_size)), ivec2(0), full_size - 1);
    float tau = dot(texelFetch(absorption_tex, absorption_p, 0).rgb, vec3(1.0 / 3.0));
    return exp(-max(tau, 0.0));
}

vec4 reconstruction_weights(vec2 uv, ivec2 sample_size, ivec2 full_size,
                            out ivec2 p00, out ivec2 p10,
                            out ivec2 p01, out ivec2 p11)
{
    vec2 grid = uv * vec2(sample_size) - 0.5;
    ivec2 base = ivec2(floor(grid));
    vec2 f = fract(grid);
    ivec2 last = sample_size - 1;
    p00 = clamp(base, ivec2(0), last);
    p10 = clamp(base + ivec2(1, 0), ivec2(0), last);
    p01 = clamp(base + ivec2(0, 1), ivec2(0), last);
    p11 = clamp(base + ivec2(1, 1), ivec2(0), last);

    ivec2 center = clamp(ivec2(uv * vec2(full_size)), ivec2(0), full_size - 1);
    float target = exp(-max(dot(texelFetch(absorption_tex, center, 0).rgb,
                                vec3(1.0 / 3.0)), 0.0));
    float t00 = reconstruction_transmittance(p00, sample_size, full_size) - target;
    float t10 = reconstruction_transmittance(p10, sample_size, full_size) - target;
    float t01 = reconstruction_transmittance(p01, sample_size, full_size) - target;
    float t11 = reconstruction_transmittance(p11, sample_size, full_size) - target;
    float sigma = max(reconstruction_threshold, 0.02);
    float sigma2 = 2.0 * sigma * sigma;
    return vec4((1.0 - f.x) * (1.0 - f.y) * exp(-(t00 * t00) / sigma2),
                f.x * (1.0 - f.y) * exp(-(t10 * t10) / sigma2),
                (1.0 - f.x) * f.y * exp(-(t01 * t01) / sigma2),
                f.x * f.y * exp(-(t11 * t11) / sigma2));
}

vec3 sample_fluence(vec2 uv)
{
    ivec2 sample_size = textureSize(fluence_tex, 0);
    ivec2 full_size = textureSize(absorption_tex, 0);
    if (all(equal(sample_size, full_size))) return texture(fluence_tex, uv).rgb;

    ivec2 p00, p10, p01, p11;
    vec4 weights = reconstruction_weights(uv, sample_size, full_size, p00, p10, p01, p11);
    float total = dot(weights, vec4(1));
    if (total <= 1e-6) return vec3(0);
    vec3 sum = texelFetch(fluence_tex, p00, 0).rgb * weights.x +
               texelFetch(fluence_tex, p10, 0).rgb * weights.y +
               texelFetch(fluence_tex, p01, 0).rgb * weights.z +
               texelFetch(fluence_tex, p11, 0).rgb * weights.w;
    return max(sum / total, vec3(0));
}

float sample_luminance(vec2 uv)
{
    ivec2 sample_size = textureSize(luminance_tex, 0);
    ivec2 full_size = textureSize(absorption_tex, 0);
    if (all(equal(sample_size, full_size))) return texture(luminance_tex, uv).r;

    ivec2 p00, p10, p01, p11;
    vec4 weights = reconstruction_weights(uv, sample_size, full_size, p00, p10, p01, p11);
    float total = dot(weights, vec4(1));
    if (total <= 1e-6) return 0.0;
    float sum = texelFetch(luminance_tex, p00, 0).r * weights.x +
                texelFetch(luminance_tex, p10, 0).r * weights.y +
                texelFetch(luminance_tex, p01, 0).r * weights.z +
                texelFetch(luminance_tex, p11, 0).r * weights.w;
    return max(sum / total, 0.0);
}

// GGX distribution, height-correlated Smith visibility and Schlick Fresnel for
// a dielectric, viewed straight down the camera axis.
float highlight(vec3 n, vec3 l, float roughness)
{
    vec3 h = normalize(l + vec3(0, 0, 1));
    float nv = max(n.z, 0.0001);
    float nl = max(dot(n, l), 0.0);
    float nh = max(dot(n, h), 0.0);
    float alpha = max(roughness * roughness, 0.0025);
    float a2 = alpha * alpha;
    float d = nh * nh * (a2 - 1.0) + 1.0;
    float distribution = a2 / max(3.14159265 * d * d, 0.00000001);
    float visibility = 0.5 / max(nl * sqrt(nv * nv * (1.0 - a2) + a2) +
                                 nv * sqrt(nl * nl * (1.0 - a2) + a2), 0.0001);
    float fresnel = 0.04 + 0.96 * pow(1.0 - max(h.z, 0.0), 5.0);
    return fresnel * distribution * visibility * nl;
}

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 source_uv = mix(crop_uv.xy, crop_uv.zw, screen_uv);
    vec4 scene = texture(scene_tex, source_uv);
    vec3 emission = texture(emission_tex, source_uv).rgb;
    vec3 absorption = texture(absorption_tex, source_uv).rgb;
    vec3 albedo = texture(albedo_tex, source_uv).rgb;
    vec3 fluence = sample_fluence(source_uv);
    vec4 normal = texture(normal_tex, source_uv);

    int mode = int(debug_view + 0.5);
    if (mode == 1) return scene;
    if (mode == 2) return vec4(emission, 1.0);
    if (mode == 3) return vec4(exp(-absorption), 1.0);
    if (mode == 4) return vec4(albedo, 1.0);
    if (mode == 5) return vec4(fluence * 5.0, 1.0);
    if (mode == 6) return vec4(normal.xyz * 0.5 + 0.5, normal.a);

    // Screen-space liquid distortion samples the background and incident light.
    // Foreground opaque objects remain in front; this is not a depth/Snell solve.
    vec2 pixel_uv = 1.0 / vec2(textureSize(normal_tex, 0));
    vec2 distortion = normal.z < 0.0 ? normal.xy * (-normal.z) * pixel_uv : vec2(0);
    vec2 fluence_uv = source_uv + distortion;
    if (normal.z < 0.0) fluence = sample_fluence(fluence_uv);
    if (split_lighting != 0) {
        float Y = sample_luminance(fluence_uv);
        float coarseY = dot(fluence, LUMA);
        fluence = coarseY > 1e-8 ? fluence * (Y / coarseY) : vec3(Y);
    }
    vec4 visibility = texture(visibility_tex, source_uv);
    // The same exposure as visible emitters reveals light received by fluid.
    // Coverage blends this artistic gain; it never feeds the transport solver.
    float volume_exposure = mix(1.0, intensity, visibility.a);
    vec3 incident = fluence * volume_exposure;
    if (normal.z < 0.0) {
        // Liquid edges brighten from light received just outside them.
        vec2 reach = 8.0 * pixel_uv;
        vec3 outside = .25 * (sample_fluence(source_uv + vec2(reach.x, 0)) +
                              sample_fluence(source_uv - vec2(reach.x, 0)) +
                              sample_fluence(source_uv + vec2(0, reach.y)) +
                              sample_fluence(source_uv - vec2(0, reach.y)));
        incident += outside * normal.a * 2.0 * intensity;
    }

    // Solids: normal.xy is the bump tilt (world axes, y up), z the edge-light
    // gain and w the gloss. Light from the open space around a solid reaches
    // surface_radius into it. It arrives from four quadrants; within each, the
    // slope of that quadrant's light points at its sources. No received light
    // means no surface light.
    bool solid = normal.z > 0.0 || (normal.z == 0.0 && (normal.w > 0.0 || dot(normal.xy, normal.xy) > 0.0));
    vec3 surface_light = vec3(0);
    vec2 tilt = solid ? normal.xy : vec2(0);
    // Per quadrant: light fraction and direction toward it (world axes, y up).
    vec4 weights = vec4(0);
    vec2 dirs[4] = vec2[4](vec2(1, 0), vec2(0, -1), vec2(-1, 0), vec2(0, 1));
    if (solid && surface_params.x > 0.0) {
        vec2 suv = source_uv * surface_map.xy;
        vec2 dx = vec2(surface_map.z, 0), dy = vec2(0, surface_map.w);
        vec4 s = texture(surface_tex, suv);
        vec4 left = texture(surface_tex, suv - dx), right = texture(surface_tex, suv + dx);
        vec4 up = texture(surface_tex, suv - dy), down = texture(surface_tex, suv + dy);
        vec4 q = max(texture(surface_dir_tex, suv), vec4(0));
        // Texture rows run down the screen; world axes run up.
        vec4 qx = texture(surface_dir_tex, suv + dx) - texture(surface_dir_tex, suv - dx);
        vec4 qy = texture(surface_dir_tex, suv - dy) - texture(surface_dir_tex, suv + dy);
        float open = max(s.a, 0.0);
        // One at a straight face, less in concave corners, zero one radius deep.
        float reach = clamp((2.0 * open - 0.05) / 0.95, 0.0, 1.0);
        surface_light = s.rgb / max(open, 1e-4) * reach * normal.z * intensity;
        weights = q / max(dot(q, vec4(1)), 1e-6);
        for (int i = 0; i < 4; i++) {
            vec2 slope = 0.5 * surface_sigma * vec2(qx[i], qy[i]) / max(q[i], 1e-6);
            vec2 d = dirs[i] + slope / max(1.0, length(slope));
            // Keep each direction within its quadrant's half plane.
            d -= dirs[i] * min(dot(d, dirs[i]) - 0.2, 0.0);
            dirs[i] = normalize(d);
        }
        // Near a silhouette the surface turns toward the open side (rim light).
        vec2 outward = 0.5 * surface_sigma * vec2(right.a - left.a, up.a - down.a);
        tilt += outward * surface_params.z * step(1e-4, normal.z);
    }
    incident += surface_light;
    vec3 n = vec3(0, 0, 1);
    if (solid) n = normalize(vec3(tilt, sqrt(max(1.0 - dot(normal.xy, normal.xy), 0.0))));
    // Material relief shadows itself: march toward the dominant light over
    // the height field, which rises 1/relief units per unit across the plane.
    // Open space casts no relief shadow.
    float shadow = 1.0;
    vec4 relief = texture(relief_tex, source_uv);
    vec2 toward = vec2(0);
    for (int i = 0; i < 4; i++) toward += weights[i] * dirs[i];
    if (solid && relief.y > 0.5 && dot(toward, toward) > 0.01) {
        float h0 = relief.x / relief.y;
        const float STEP = 0.6;
        vec2 step_uv = normalize(vec2(toward.x, -toward.y)) * (STEP / world_per_px) * pixel_uv;
        float rise = STEP / max(surface_params.y, 1e-3);
        for (int i = 1; i <= 10; i++) {
            vec4 r = texture(relief_tex, source_uv + step_uv * float(i));
            if (r.y < 0.5) break;
            shadow = min(shadow, clamp(1.0 - (r.x / r.y - h0 - rise * float(i)), 0.0, 1.0));
        }
    }
    // A flat face keeps the received light; tilted relief gains or loses it.
    // Specular is a physically based dielectric for the same light; one in
    // surface_params.w means physical.
    float gloss = solid ? clamp(normal.w, 0.0, 1.0) : 0.0;
    float diffuse = 0.0, sheen = 0.0;
    vec2 dominant = vec2(0);
    if (dot(weights, vec4(1)) <= 0.0) {
        diffuse = 1.0;
    }
    for (int i = 0; i < 4; i++) {
        if (weights[i] <= 0.0) continue;
        vec3 l = normalize(vec3(dirs[i] * surface_params.y, 1.0));
        diffuse += weights[i] * max(dot(n, l), 0.0) / l.z;
        if (gloss > 0.0) {
            sheen += weights[i] * 3.14159265 * highlight(n, l, 1.0 - gloss) / l.z * surface_params.w;
        }
        dominant += weights[i] * dirs[i];
    }
    diffuse = mix(diffuse * shadow, diffuse, 1.0 - dot(weights, vec4(1)));
    sheen *= shadow;
    if (mode == 7) return vec4(surface_light, 1.0);
    if (mode == 8) return vec4(dominant * 0.5 + 0.5, shadow, 1.0);
    if (mode == 9) return vec4(n * 0.5 + 0.5, 1.0);

    vec3 lit = incident * (albedo * diffuse + vec3(sheen)) +
               max(albedo * shadow_floor, visibility.rgb);
    vec3 out_linear = fluence * fog + emission * intensity + scene.rgb * ambient + lit;
    vec2 background_uv = clamp(screen_uv + distortion / (crop_uv.zw - crop_uv.xy), vec2(0), vec2(1));
    out_linear += texture(background_tex, background_uv).rgb * (1.0 - scene.a);
    if (linear_output != 0) return vec4(max(out_linear, vec3(0.0)), 1.0);
    vec3 out_srgb = linear_to_srgb(max(out_linear, vec3(0.0)));
    float dither = dither8bit_ign(gl_FragCoord.xy, dither_phase);
    return vec4(clamp(out_srgb + vec3(dither), vec3(0.0), vec3(1.0)), 1.0);
}
