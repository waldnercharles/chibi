/* A row of a tree or list, as the Outliner's and Assets' native rows: depth
   indent, twisty, icon, label, meta and the use's children trailing (the
   Outliner's eye and lock). Alias the row as data-alias-item: an object
   with label, icon (a glyph), meta, depth, parent (it has children), open,
   selected, active, marked and hidden; the twisty writes item.open, which
   is UI-local. Put data-drag, data-drop and data-drop-zones (src/ui/drag.h)
   on the use: the row's marks follow them here. The use may mark the row
   selected itself, with data-selected, when its selection lives in a
   variable of its own. The rows' own look is the theme's .tree-row
   (theme/tree.rcss). */
body { display: block; }
body[data-selected] .tree-row { background-color: var(--selected); }
/* A drop target that takes the drag, then the one under the pointer, and
   where in it a drop lands: a line before or after it, or filled. */
body[data-drop-accept] .tree-row { border-color: var(--primary-edge); }
body[data-drop-over] { background-color: transparent; }
body[data-drop-over] .tree-row { border-color: var(--primary); background-color: var(--primary-soft); }
body[data-drop-zone=before] .tree-row { border-color: transparent; border-top-color: var(--primary); background-color: transparent; }
body[data-drop-zone=after] .tree-row { border-color: transparent; border-bottom-color: var(--primary); background-color: transparent; }
