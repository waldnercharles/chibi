+QueryExpressionStep :: (forest: snapshot.SnapshotNode[], params: Param[], queries: QuerySpec[], values: Value[], top: int,
+                        item: Work, ops: Ops, target: Target, at: Bases) -> Step {
+    node := forest[item.node];
+    index := FindQuery(queries, item.node);
+    if (index < 0) {
+        return Fail(forest, item.node, 0, "Query description was not declared");
+    }
+    described := queries[index];
+    if (item.phase == 0) {
+        next: Work[] = [];
+        index: int = 0;
