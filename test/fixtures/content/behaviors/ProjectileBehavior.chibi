behavior "ProjectileBehavior" {
    value get_gameprojectile = get_game_projectile()
    action set_gameprojectile_age = set_game_projectile_age(add(get_gameprojectile.Value.age, delta_time()))
    value greater_or_equal = greater_or_equal(set_gameprojectile_age.Value.age, set_gameprojectile_age.Value.lifetime)
    value get_gamevelocity = get_game_velocity()
    on Tick {
        await "Face Direction"(get_gamevelocity.Value.x, get_gamevelocity.Value.y)
        set_gameprojectile_age()
    }
    after set_gameprojectile_age {
        if greater_or_equal {
            destroy_entity(self)
        }
    }
    function "Face Direction"(X: float = 0.0, Y: float = 0.0) {
        value has_gameorientation = has_game_orientation()
        value greater_or_equal = greater_or_equal(0.0, "Direction Magnitude"(entry.X, entry.Y))
        after entry {
            if has_gameorientation {
                if greater_or_equal {
                    return
                } else {
                    await set_game_orientation("DirectionMath"."Direction Orientation"(entry.X, entry.Y))
                    return
                }
            } else {
                return
            }
        }
    }
    pure function "Direction Magnitude"<T0: float, T1: float, T2: float>(x: T0 = 0.0, y: T1 = 0.0) -> (Result: T2 = 0.0) {
        value abs = abs(entry.x)
        value abs_2 = abs(entry.y)
        value add = add(abs, abs_2)
        return add
    }
}
