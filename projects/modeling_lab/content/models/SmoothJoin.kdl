version 3
name "SmoothJoin"
domain "model"
id_counter 19
description "A polynomial smooth union joins two spheres."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Sphere"
                inputs Radius=19.0
            }
            - {
                id 6
                type "Model Translate"
                inputs {
                    Offset {
                        default x=-17.0 y=0.0 z=0.0
                    }
                }
            }
            - {
                id 10
                type "Model Translate"
                inputs {
                    Offset {
                        default x=17.0 y=0.0 z=0.0
                    }
                }
            }
            - {
                id 14
                type "Model Smooth Union"
                inputs Smoothness=10.0
            }
        }
        (array)edges {
            - from="3.Geometry" to="6.Geometry"
            - from="3.Geometry" to="10.Geometry"
            - from="6.Geometry" to="14.A"
            - from="10.Geometry" to="14.B"
            - from="14.Geometry" to="1.Geometry"
        }
    }
}
