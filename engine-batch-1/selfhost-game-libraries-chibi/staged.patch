+// the pure package/bootstrap entry points keep their original record layouts.
+pub CompileBehaviorsWithCatalog :: (identities: string[], sources: string[], target: Target, abi: uint64,
+                                    names: string[], natives: Native[], ports: CatalogPort[], native_ids: uint64[],
+                                    game_events: GameEvent[], event_fields: GameEventField[], types: GameType[],
+                                    type_fields: GameField[], entity: uint64, operators: NumericOperator[],
+                                    globals: GameGlobal[], makes: NativeMake[], make_fields: int[],
+                                    native_effects: int[]) -> byte[] {
+    resolved := CatalogPorts(ports, NativeTypes(types));
+    if (!NativeInputValid(natives, resolved, native_ids, native_effects)) {
+        return [];
+    }
+    return CompileBehaviorsResolved(identities, sources, target, abi, names, natives, resolved, native_ids,
+                                    game_events, event_fields, types, type_fields, entity, operators, globals,
+                                    CatalogMakes(makes, natives, resolved), make_fields, native_effects);
+}
+pub BehaviorRejectionWithCatalog :: (identities: string[], sources: string[], target: Target, abi: uint64,
+                                     names: string[], natives: Native[], ports: CatalogPort[], native_ids: uint64[],
+                                     game_events: GameEvent[], event_fields: GameEventField[], types: GameType[],
+                                     type_fields: GameField[], entity: uint64, operators: NumericOperator[],
+                                     globals: GameGlobal[], makes: NativeMake[], make_fields: int[],
+                                     native_effects: int[]) -> string {
+    resolved := CatalogPorts(ports, NativeTypes(types));
+    if (!NativeInputValid(natives, resolved, native_ids, native_effects)) {
+        return "unsupported compiler input or target";
+    }
+    return BehaviorRejectionResolved(identities, sources, target, abi, names, natives, resolved, native_ids,
+                                     game_events, event_fields, types, type_fields, entity, operators, globals,
+                                     CatalogMakes(makes, natives, resolved), make_fields, native_effects);
+}
