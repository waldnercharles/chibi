+// The structural 'data-when', as Vue's v-if: while its expression is true, a copy of the element is built before it,
+// as data-for builds an item, and while false the copy and its views are gone. The element stays as the hidden
+// template. 'data-if' only hides an element and keeps its views, as Vue's v-show.
+class DataViewWhen final : public DataViewCommon {
+public:
+	DataViewWhen(Element* element);
+
+	bool Initialize(DataModel& model, Element* element, const String& expression, const String& modifier) override;
+
+	bool Update(DataModel& model) override;
+
+private:
+	ElementAttributes attributes;
+	Element* instance = nullptr;
+};
