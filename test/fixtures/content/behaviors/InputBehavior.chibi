behavior "InputBehavior" {
    action set_gamevelocity = set_velocity("MovementActions"."Movement Velocity"(input.Direction, self.Movement))
    on Input as input {
        if self.Dash {
            if 0.0 < self.Dash.remaining {
            } else {
                set_gamevelocity()
            }
        } else {
            set_gamevelocity()
        }
    }
    after set_gamevelocity {
        await "Face Direction"(input.Direction)
    }
    function "Face Direction"(Direction: struct<"CF_V2"> = null) {
        after entry {
            if self.Orientation {
                if 0.0 >= abs(entry.Direction.x) + abs(entry.Direction.y) {
                    return
                } else {
                    self.Orientation = "DirectionMath"."Direction Orientation"(entry.Direction.x, entry.Direction.y)
                    return
                }
            } else {
                return
            }
        }
    }
}
