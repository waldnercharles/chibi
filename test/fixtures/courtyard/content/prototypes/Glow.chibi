package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Glow")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Appearance", data.Object([
                    data.Field.Named("color", data.Value.UInt(1626394879)),
                    data.Field.Named("height", data.Value.Real(3.0)),
                    data.Field.Named("layer", data.Value.UInt(2)),
                    data.Field.Named("shape", data.Value.Text("Circle")),
                    data.Field.Named("width", data.Value.Real(3.0))
                ])),
                data.Field.Named("Material", data.Object([
                    data.Field.Named("albedo", data.Value.UInt(1626394879)),
                    data.Field.Named("emission_color", data.Value.UInt(1626394879)),
                    data.Field.Named("emission_intensity", data.Value.Real(0.14999999999999999)),
                    data.Field.Named("emission_multiplier", data.Value.Real(1.0)),
                    data.Field.Named("scene", data.Value.UInt(1626394879))
                ])),
                data.Field.Named("Transform", data.Object([]))
            ]))
        ])
    );
}
