    RejectChanged(rows, [Changed(25, LiteralField, 0)], "scalar function can end without returning");
    RejectChanged(rows, [Changed(24, KindField, 9)], "invalid scalar module layout");
    RejectChanged(rows, [Changed(17, CountField, 1)], "invalid scalar module layout");
    RejectChanged(rows, [Changed(17, TypeField, 1)], "invalid scalar statement row");
    RejectChanged(rows, [Changed(41, ValueField, 1)], "invalid scalar statement row");
    RejectChanged(rows, [Changed(25, TypeField, 1)], "scalar condition is not one bool");
    RejectChanged(rows, [Changed(11, TypeField, 2)], "scalar range differs from its int bounds");
    RejectChanged(rows, [Changed(10, ValueField, 5)], "invalid scalar local row");
