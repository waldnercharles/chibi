behavior "GameState" {
    owner "ecs.entity";
    action set_global_variable = engine["Set Global Variable"](Name: "Score", Value: float = 0.0);
    on Begin as begin() {
        set_global_variable();
    }
    on Restart as restart() {
        set_global_variable();
    }
    after set_global_variable {
        await engine["Set Global Variable"](Name: "Lives", Value: float = 3.0);
        await engine["Set Global Variable"](Name: "Hits", Value: float = 0.0);
        await engine["Set Global Variable"](Name: "Rank", Value: float = 1.0);
        await engine["Set Global Variable"](Name: "Ready", Value: float = 1.0);
        await engine["Set Global Variable"](Name: "Charge", Value: float = 0.0);
        await set_game_transform(Value: {
            x: 196.0,
            y: 260.0
        });
        set_game_velocity(Value: {
            x: 0.0,
            y: 0.0
        });
    }
    on LeftFlip as leftflip() {
    }
    on RightFlip as rightflip() {
    }
    on Dash as dash() {
    }
}
