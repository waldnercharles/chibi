package package_compiler

import snapshot "project:source_snapshot"
import graph "project:package_graph"
import syntax "project:syntax_diagnostics"
import tk "project:source_tokenizer"
import json "project:json_string"
import strings "core:strings"

// Compile-time execution of authored functions. A constant initializer may
// call a function of any package whose parameters and result are numbers,
// bools, text, records, or arrays of them, to any depth: the body runs on the
// compiler, with locals, assignment (plain, compound, and to a field or an
// element at any depth), `append`, `if`, `while`, `for` over a range or an
// array, `break`, `continue` and `return`. Integer expressions reuse the exact
// constant evaluator, so arithmetic keeps its range checks and a result that
// does not fit its type is an error, not a wrap; floats use exact IEEE
// arithmetic. Each evaluation has a step budget and a call-depth limit.
CtSteps: int : 65536;
CtDepth: int : 128;

// What the compiler knows while it runs a function, read-only except `steps`.
CtContext :: struct {
    forest: snapshot.SnapshotNode[];
    documents: snapshot.Document[];
    links: graph.Binding[];
    callables: Callable[];
    params: Param[];
    constants: ConstDecl[];
    types: TypeDecl[];
    members: TypeMember[];
    // The text values of the run: a string is the index of its bytes here.
    texts: string[];
    steps: int;
}
// The locals of one activation, innermost last. A local's storage is its
// type, or the negation of its kind when it is an array or a record, whose
// image is in `arrays`.
CtFrame :: struct {
    names: string[];
    bits: u64[];
    storages: int[];
    arrays: CtRow[];
}
// The image of one array or record local.
CtRow :: struct {
    items: u64[];
}

CtResult :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Waiting
    | Value(bits: u64, storage: int)
    | Elements(values: u64[], storage: int)
}
CtFlow :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Waiting
    | Normal
    | Returned(bits: u64, storage: int)
    | ReturnedElements(values: u64[], storage: int)
    | Broke
    | Continued
}

// The constant `name` of an activation, its current value.
CtLocal :: (name: string, package: int, file: int, storage: int, bits: u64) -> ConstDecl {
    return {name: name, package: package, storage: storage, bits: bits, node: -1, file: file, folded: true,
            occurrence: 0};
}
// What an expression of an activation reads: the nodes already evaluated, its
// scalar locals, innermost first, then the constants.
CtScope :: (constants: ConstDecl[], package: int, file: int, frame: ^CtFrame, memo: ConstDecl[]) -> ConstDecl[] {
    scope := memo;
    at := length(frame.names) - 1;
    while (at >= 0) {
        if (frame.storages[at] > 0) {
            scope.append(CtLocal(frame.names[at], package, file, frame.storages[at], frame.bits[at]));
        }
        at -= 1;
    }
    scope.extend(constants);
    return scope;
}
// The memo constant standing for the evaluated node, -1 for none. Memo
// constants have no name and come first, so the search ends at the first name.
FindMemo :: (constants: ConstDecl[], node: int) -> int {
    index: int = 0;
    while (index < length(constants) && constants[index].name == "") {
        if (constants[index].node == node) {
            return index;
        }
        index += 1;
    }
    return -1;
}
// The function a call names, in `package` or through an import alias; -1 when
// it names none.
CtCallee :: (context: ^CtContext, package: int, file: int, call: int) -> int {
    text := context.documents[file].text;
    function := Field(context.forest, call, syntax.FieldFunction);
    if (Is(context.forest, function, syntax.Identifier)) {
        return FindCallable(context.callables, package, Text(context.forest, text, function));
    }
    if (Is(context.forest, function, syntax.MemberExpression)) {
        home := QualifierOf(context.forest, text, Aliases(context.links, file), package,
                            Field(context.forest, function, syntax.FieldObject));
        if (home < 0) {
            return -1;
        }
        return FindCallable(context.callables, home, Text(context.forest, text, Field(context.forest, function, syntax.FieldMember)));
    }
    return -1;
}
// The operations a compile-time call performs itself: `length` of an array or
// a string, and the byte operations of text.
CtLengthOf: int : 1;
CtByteLength: int : 2;
CtByteAt: int : 3;
CtSliceOf: int : 4;
CtBytesOf: int : 5;
CtFormatText: int : 6;
// Which of them `call` is, 0 for none.
CtIntrinsic :: (context: ^CtContext, package: int, file: int, call: int) -> int {
    function := Field(context.forest, call, syntax.FieldFunction);
    if (!Is(context.forest, call, syntax.CallExpression) || !Is(context.forest, function, syntax.Identifier) ||
        CtCallee(context, package, file, call) >= 0) {
        return 0;
    }
    name := Text(context.forest, context.documents[file].text, function);
    if (name == "length") {
        return CtLengthOf;
    }
    if (name == "text_byte_length") {
        return CtByteLength;
    }
    if (name == "text_byte_at") {
        return CtByteAt;
    }
    if (name == "text_slice") {
        return CtSliceOf;
    }
    if (name == "text_bytes") {
        return CtBytesOf;
    }
    if (name == "format_text") {
        return CtFormatText;
    }
    return 0;
}
// Whether `node` is a condition: a comparison, a logical operation, `not`, or
// a boolean literal, local or call.
CtBoolean :: (forest: snapshot.SnapshotNode[], text: string, scope: ConstDecl[], aliases: Name[], package: int,
              node: int) -> bool {
    value := Unparenthesized(forest, node);
    if (Is(forest, value, syntax.Boolean)) {
        return true;
    }
    named := ConstantOf(forest, text, scope, aliases, package, value);
    if (named >= 0) {
        return scope[named].storage == BoolStorage;
    }
    if (Is(forest, value, syntax.CallExpression)) {
        return Text(forest, text, Field(forest, value, syntax.FieldFunction)) == "not";
    }
    if (Is(forest, value, syntax.UnaryExpression)) {
        operator := Operator(forest, value);
        return operator == tk.NotKeyword || operator == tk.Not;
    }
    if (Is(forest, value, syntax.BinaryExpression)) {
        operator := Operator(forest, value);
        return ComparisonOperator(operator) || operator == tk.AndKeyword || operator == tk.CmpAnd || operator == tk.OrKeyword ||
               operator == tk.CmpOr;
    }
    return false;
}
CtFail :: (context: ^CtContext, node: int, file: int, message: string) -> syntax.Diagnostic {
    return Diagnose(context.forest, node, file, message);
}
// Counts a step against the budget; false once it is spent.
CtStep :: (context: ^CtContext, node: int, file: int) -> bool {
    context.steps += 1;
    return context.steps <= CtSteps;
}
// The index of local `name`, the newest first; -1 for none.
CtLookup :: (frame: ^CtFrame, name: string) -> int {
    at := length(frame.names) - 1;
    while (at >= 0) {
        if (frame.names[at] == name) {
            return at;
        }
        at -= 1;
    }
    return -1;
}
// The array or record local that `node` names, -1 when it names none.
CtArrayLocal :: (context: ^CtContext, file: int, frame: ^CtFrame, node: int) -> int {
    value := Unparenthesized(context.forest, node);
    if (!Is(context.forest, value, syntax.Identifier)) {
        return -1;
    }
    at := CtLookup(frame, Text(context.forest, context.documents[file].text, value));
    if (at >= 0 && frame.storages[at] < 0) {
        return at;
    }
    return -1;
}
// Whether values of `storage` are numbers or bools.
CtScalar :: (storage: int) -> bool {
    return Integer(storage) || Floating(storage) || storage == BoolStorage || storage == TextStorage;
}
// The value of the scalar expression `node` in an activation. `want` is the
// type an untyped expression takes, 0 for the default.
CtEval :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, node: int,
           want: int) -> CtResult {
    text := context.documents[file].text;
    if (CtIsText(context, package, file, frame, node)) {
        return CtEvalText(context, package, file, frame, depth, node);
    }
    memo: ConstDecl[] = [];
    reads: int[] = [];
    CtCollect(context, package, file, frame, node, &reads);
    for (read in reads) {
        switch CtRead(context, package, file, frame, depth, read) {
            case .Failed(diagnostic):
                return CtResult.Failed(diagnostic);
            case .Waiting:
                return CtResult.Waiting;
            case .Elements(values, storage):
                return CtResult.Failed(CtFail(context, read, file, "an array or record cannot be used as a number here"));
            case .Value(value, storage):
                placed: ConstDecl = {name: "", package: package, storage: storage, bits: value, node: read,
                                     file: file, folded: true, occurrence: 0};
                memo.append(placed);
        }
    }
    scope := CtScope(context.constants, package, file, frame, memo);
    aliases := Aliases(context.links, file);
    if (CtBoolean(context.forest, text, scope, aliases, package, node)) {
        switch FoldCondition(context.forest, text, file, scope, aliases, package, node) {
            case .Failed(diagnostic):
                return CtResult.Failed(diagnostic);
            case .Waiting:
                return CtResult.Waiting;
            case .Yes:
                return CtResult.Value(1, BoolStorage);
            case .No:
                return CtResult.Value(0, BoolStorage);
        }
    }
    typed := ConstantType(context.forest, text, scope, aliases, package, node);
    if (typed == 0) {
        typed = want;
    }
    if (typed == 0 && Floating(UntypedStorage(context.forest, text, node))) {
        typed = UntypedStorage(context.forest, text, node);
    }
    if (typed == 0) {
        typed = IntStorage;
    }
    switch FoldConstant(context.forest, text, file, scope, aliases, package, node, typed) {
        case .Failed(diagnostic):
            return CtResult.Failed(diagnostic);
        case .Waiting:
            return CtResult.Waiting;
        case .Folded(folded):
            return CtResult.Value(folded, typed);
    }
}
// An image kind names a type: below `CtRecord` the storage of a scalar,
// `CtRecord` plus a declaration for a record, `CtArray` plus an element kind
// for an array of scalars or records.
CtRecord: int : 1048576;
CtArray: int : 2097152;

// The kind of a type, 0 for one a compile-time function does not hold.
CtTypeKind :: (storage: int, container: int, record: int) -> int {
    element: int = 0;
    if (storage == StructStorage) {
        if (record >= 0) {
            element = CtRecord + record;
        }
    } else if (CtScalar(storage)) {
        element = storage;
    }
    if (element == 0 || container == 0) {
        return element;
    }
    if (container == ArrayContainer) {
        return CtArray + element;
    }
    return 0;
}
// The kind of field `index` of a record.
CtMemberKind :: (context: ^CtContext, index: int) -> int {
    member := context.members[index];
    return CtTypeKind(member.storage, member.container, member.record);
}
// Whether a compile-time function holds values of `kind`: scalars, records of
// held kinds and arrays of scalars and records.
CtKindOk :: (context: ^CtContext, kind: int) -> bool {
    if (kind < CtRecord) {
        return CtScalar(kind);
    }
    if (kind >= CtArray) {
        element := kind - CtArray;
        return element != 0 && element < CtArray && CtKindOk(context, element);
    }
    declaration := context.types[kind - CtRecord];
    if (declaration.kind != RecordDecl) {
        return false;
    }
    at := declaration.first;
    while (at < declaration.first + declaration.count) {
        field := CtMemberKind(context, at);
        if (field == 0 || !CtKindOk(context, field)) {
            return false;
        }
        at += 1;
    }
    return true;
}
// A value of a kind is an image: a scalar is one slot; a record is its fields'
// images in declaration order; an array is its length and then its elements'
// images. The slots a value takes at `at` in `image`:
CtSize :: (context: ^CtContext, kind: int, image: u64[], at: int) -> int {
    if (kind < CtRecord) {
        return 1;
    }
    if (kind >= CtArray) {
        element := kind - CtArray;
        count := int(image[at]);
        if (element < CtRecord) {
            return 1 + count;
        }
        used := 1;
        index := 0;
        while (index < count) {
            used += CtSize(context, element, image, at + used);
            index += 1;
        }
        return used;
    }
    declaration := context.types[kind - CtRecord];
    used := 0;
    field := declaration.first;
    while (field < declaration.first + declaration.count) {
        used += CtSize(context, CtMemberKind(context, field), image, at + used);
        field += 1;
    }
    return used;
}
// Where field `index` of the record image at `at` begins.
CtFieldAt :: (context: ^CtContext, record: int, image: u64[], at: int, index: int) -> int {
    place := at;
    field := context.types[record].first;
    while (field < index) {
        place += CtSize(context, CtMemberKind(context, field), image, place);
        field += 1;
    }
    return place;
}
// Where element `position` of the array image at `at` begins.
CtElementAt :: (context: ^CtContext, element: int, image: u64[], at: int, position: int) -> int {
    if (element < CtRecord) {
        return at + 1 + position;
    }
    place := at + 1;
    index := 0;
    while (index < position) {
        place += CtSize(context, element, image, place);
        index += 1;
    }
    return place;
}
// `image` with `size` slots at `at` replaced by `replacement`.
CtSplice :: (image: u64[], at: int, size: int, replacement: u64[]) -> u64[] {
    output := slice(image, 0, at);
    output.extend(replacement);
    output.extend(slice(image, at + size, length(image) - at - size));
    return output;
}
// The kind an expression has by its form, 0 when it has none a compile-time
// function holds: a local, a field or element of one, a call's result, text.
CtStaticKind :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, node: int) -> int {
    forest := context.forest;
    value := Unparenthesized(forest, node);
    if (Is(forest, value, syntax.String)) {
        return TextStorage;
    }
    if (Is(forest, value, syntax.Identifier)) {
        at := CtLookup(frame, Text(forest, context.documents[file].text, value));
        if (at < 0) {
            return 0;
        }
        if (frame.storages[at] < 0) {
            return -frame.storages[at];
        }
        return frame.storages[at];
    }
    if (Is(forest, value, syntax.MemberExpression)) {
        object := CtStaticKind(context, package, file, frame, Field(forest, value, syntax.FieldObject));
        if (object < CtRecord || object >= CtArray) {
            return 0;
        }
        index := FindField(context.types, context.members, object - CtRecord,
                           Text(forest, context.documents[file].text, Field(forest, value, syntax.FieldMember)));
        if (index < 0) {
            return 0;
        }
        return CtMemberKind(context, index);
    }
    if (Is(forest, value, syntax.IndexExpression)) {
        object := CtStaticKind(context, package, file, frame, Field(forest, value, syntax.FieldObject));
        if (object < CtArray) {
            return 0;
        }
        return object - CtArray;
    }
    if (Is(forest, value, syntax.CallExpression)) {
        callee := CtCallee(context, package, file, value);
        if (callee >= 0) {
            return CtTypeKind(context.callables[callee].result, context.callables[callee].result_container,
                              context.callables[callee].result_record);
        }
        code := CtIntrinsic(context, package, file, value);
        if (code == CtSliceOf || code == CtFormatText) {
            return TextStorage;
        }
        if (code == CtBytesOf) {
            return CtArray + IntStorage;
        }
    }
    return 0;
}
// Whether `node` is a text expression here.
CtIsText :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, node: int) -> bool {
    return CtStaticKind(context, package, file, frame, node) == TextStorage;
}
// Appends the outermost nodes of the expression `node` that run before it is
// folded: calls of authored functions and of the operations a compile-time call
// performs itself, fields and elements of records and arrays, and comparisons
// of text. Their own operands are evaluated with them.
CtCollect :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, node: int, out: ^(int[])) {
    if (node < 0) {
        return;
    }
    forest := context.forest;
    reads := false;
    if (Is(forest, node, syntax.CallExpression)) {
        reads = CtCallee(context, package, file, node) >= 0 || CtIntrinsic(context, package, file, node) != 0;
    } else if (Is(forest, node, syntax.MemberExpression) || Is(forest, node, syntax.IndexExpression)) {
        reads = CtStaticKind(context, package, file, frame, Field(forest, node, syntax.FieldObject)) >= CtRecord;
    } else if (Is(forest, node, syntax.BinaryExpression) && ComparisonOperator(Operator(forest, node))) {
        reads = CtIsText(context, package, file, frame, Field(forest, node, syntax.FieldLeft)) ||
                CtIsText(context, package, file, frame, Field(forest, node, syntax.FieldRight));
    }
    if (reads) {
        out.append(node);
        return;
    }
    for (child in Members(forest, node)) {
        CtCollect(context, package, file, frame, child, out);
    }
}
CtSpot :: union {
    Failed(diagnostic: syntax.Diagnostic)
    | Waiting
    | Spot(image: u64[], at: int, kind: int, local: int)
}
// The place of a local, a field or element of one, or of a call's result:
// the image that holds it, where, its kind, and the local that owns the image,
// -1 for none.
CtLocate :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, node: int) -> CtSpot {
    forest := context.forest;
    value := Unparenthesized(forest, node);
    if (Is(forest, value, syntax.Identifier)) {
        local := CtArrayLocal(context, file, frame, value);
        if (local < 0) {
            return CtSpot.Failed(CtFail(context, node, file, "a compile-time array or record is a local, a call, a field or an element"));
        }
        return CtSpot.Spot(frame.arrays[local].items, 0, -frame.storages[local], local);
    }
    if (Is(forest, value, syntax.CallExpression)) {
        if (CtCallee(context, package, file, value) < 0 && CtIntrinsic(context, package, file, value) == 0) {
            return CtSpot.Failed(CtFail(context, node, file, "a compile-time array or record is a local, a call, a field or an element"));
        }
        switch CtRead(context, package, file, frame, depth, value) {
            case .Failed(diagnostic):
                return CtSpot.Failed(diagnostic);
            case .Waiting:
                return CtSpot.Waiting;
            case .Value(item, kind):
                return CtSpot.Failed(CtFail(context, node, file, "a number has no fields or elements"));
            case .Elements(image, kind):
                return CtSpot.Spot(image, 0, kind, -1);
        }
    }
    if (Is(forest, value, syntax.MemberExpression)) {
        switch CtLocate(context, package, file, frame, depth, Field(forest, value, syntax.FieldObject)) {
            case .Failed(diagnostic):
                return CtSpot.Failed(diagnostic);
            case .Waiting:
                return CtSpot.Waiting;
            case .Spot(image, at, kind, local):
                if (kind < CtRecord || kind >= CtArray) {
                    return CtSpot.Failed(CtFail(context, node, file, "only a record has fields"));
                }
                record := kind - CtRecord;
                name := Text(forest, context.documents[file].text, Field(forest, value, syntax.FieldMember));
                index := FindField(context.types, context.members, record, name);
                if (index < 0) {
                    return CtSpot.Failed(CtFail(context, node, file, format_text("Unknown field '{}'", name)));
                }
                return CtSpot.Spot(image, CtFieldAt(context, record, image, at, index), CtMemberKind(context, index), local);
        }
    }
    if (Is(forest, value, syntax.IndexExpression)) {
        switch CtLocate(context, package, file, frame, depth, Field(forest, value, syntax.FieldObject)) {
            case .Failed(diagnostic):
                return CtSpot.Failed(diagnostic);
            case .Waiting:
                return CtSpot.Waiting;
            case .Spot(image, at, kind, local):
                if (kind < CtArray) {
                    return CtSpot.Failed(CtFail(context, node, file, "only an array can be indexed at compile time"));
                }
                switch CtEval(context, package, file, frame, depth, Field(forest, value, syntax.FieldIndex), IntStorage) {
                    case .Failed(diagnostic):
                        return CtSpot.Failed(diagnostic);
                    case .Waiting:
                        return CtSpot.Waiting;
                    case .Elements(more, other):
                        return CtSpot.Failed(CtFail(context, node, file, "an array index is a number"));
                    case .Value(position, storage):
                        if (!Integer(storage)) {
                            return CtSpot.Failed(CtFail(context, node, file, "an array index is a number"));
                        }
                        signed := ExactStored(position, storage);
                        if (ExactNegative(signed) ||
                            MagnitudeCompare(Magnitude(signed), Magnitude(ExactOf(false, image[at]))) >= 0) {
                            return CtSpot.Failed(CtFail(context, node, file, "array index out of range"));
                        }
                        element := kind - CtArray;
                        return CtSpot.Spot(image, CtElementAt(context, element, image, at, int(LowBits(Magnitude(signed)))),
                                           element, local);
                }
        }
    }
    return CtSpot.Failed(CtFail(context, node, file, "a compile-time array or record is a local, a call, a field or an element"));
}
// The value at a place: a scalar's bits, or the image of an aggregate.
CtSpotValue :: (context: ^CtContext, image: u64[], at: int, kind: int) -> CtResult {
    if (kind < CtRecord) {
        return CtResult.Value(image[at], kind);
    }
    return CtResult.Elements(slice(image, at, CtSize(context, kind, image, at)), kind);
}
// The value of an expression of any kind: an aggregate where a local, a field,
// an element or a call gives one, else a scalar. `want` is the kind an untyped
// literal takes, 0 for the default.
CtEvalValue :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, node: int,
                want: int) -> CtResult {
    forest := context.forest;
    value := Unparenthesized(forest, node);
    if (Is(forest, value, syntax.StructExpression) || Is(forest, value, syntax.ArrayExpression)) {
        return CtEvalArray(context, package, file, frame, depth, value, want);
    }
    if (CtStaticKind(context, package, file, frame, value) >= CtRecord) {
        return CtEvalArray(context, package, file, frame, depth, value, want);
    }
    return CtEval(context, package, file, frame, depth, value, want);
}
// The value of an expression of `kind`.
CtEvalAny :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, node: int,
              kind: int) -> CtResult {
    if (kind < CtRecord) {
        return CtEval(context, package, file, frame, depth, node, kind);
    }
    return CtEvalArray(context, package, file, frame, depth, node, kind);
}
// The value of an aggregate expression: its image and kind. `want` is the kind
// an untyped literal takes, 0 for the default.
CtEvalArray :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, node: int,
                want: int) -> CtResult {
    forest := context.forest;
    value := Unparenthesized(forest, node);
    if (Is(forest, value, syntax.StructExpression)) {
        if (want < CtRecord || want >= CtArray) {
            return CtResult.Failed(CtFail(context, node, file, "a record literal needs a record type here"));
        }
        return CtRecordLiteral(context, package, file, frame, depth, value, want - CtRecord);
    }
    if (Is(forest, value, syntax.ArrayExpression)) {
        return CtArrayLiteral(context, package, file, frame, depth, value, want);
    }
    if (Is(forest, value, syntax.CallExpression)) {
        return CtRead(context, package, file, frame, depth, value);
    }
    switch CtLocate(context, package, file, frame, depth, value) {
        case .Failed(diagnostic):
            return CtResult.Failed(diagnostic);
        case .Waiting:
            return CtResult.Waiting;
        case .Spot(image, at, kind, local):
            return CtSpotValue(context, image, at, kind);
    }
}
// The value of the array literal `[element, ...]` of array kind `want`, or of
// the kind its first scalar element has.
CtArrayLiteral :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, node: int,
                   want: int) -> CtResult {
    element: int = 0;
    if (want >= CtArray) {
        element = want - CtArray;
    }
    image: u64[] = [0];
    count: u64 = 0;
    for item in Members(context.forest, node) {
        result := CtEvalValue(context, package, file, frame, depth, item, element);
        switch result {
            case .Failed(diagnostic):
                return CtResult.Failed(diagnostic);
            case .Waiting:
                return CtResult.Waiting;
            case .Value(bits, kind):
                if (element == 0) {
                    element = kind;
                }
                if (kind != element && !CtWidens(kind, element)) {
                    return CtResult.Failed(CtFail(context, item, file, "array elements differ in type"));
                }
                image.append(CtWidened(bits, kind, element));
            case .Elements(more, kind):
                if (element == 0) {
                    element = kind;
                }
                if (kind != element) {
                    return CtResult.Failed(CtFail(context, item, file, "array elements differ in type"));
                }
                image.extend(more);
        }
        count += 1;
    }
    if (element == 0) {
        return CtResult.Failed(CtFail(context, node, file, "an empty compile-time array needs its type"));
    }
    image[0] = count;
    return CtResult.Elements(image, CtArray + element);
}
// The value of the record literal `{field: value, ...}` of declaration
// `record`: each field once, in any order.
CtRecordLiteral :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, node: int,
                    record: int) -> CtResult {
    if (!CtKindOk(context, CtRecord + record)) {
        return CtResult.Failed(CtFail(context, node, file, "this record holds a type compile-time execution does not"));
    }
    declaration := context.types[record];
    initializers := Members(context.forest, node);
    image: u64[] = [];
    matched := 0;
    field := declaration.first;
    while (field < declaration.first + declaration.count) {
        kind := CtMemberKind(context, field);
        found := -1;
        for initializer in initializers {
            name := Text(context.forest, context.documents[file].text,
                         Field(context.forest, initializer, syntax.FieldName));
            if (found < 0 && name == context.members[field].name) {
                found = initializer;
            }
        }
        if (found < 0) {
            return CtResult.Failed(CtFail(context, node, file, "a compile-time record literal needs every field once"));
        }
        matched += 1;
        switch CtEvalAny(context, package, file, frame, depth, Field(context.forest, found, syntax.FieldValue), kind) {
            case .Failed(diagnostic):
                return CtResult.Failed(diagnostic);
            case .Waiting:
                return CtResult.Waiting;
            case .Elements(more, other):
                if (other != kind) {
                    return CtResult.Failed(CtFail(context, found, file, "field value differs from its type"));
                }
                image.extend(more);
            case .Value(item, storage):
                if (storage != kind && !CtWidens(storage, kind)) {
                    return CtResult.Failed(CtFail(context, found, file, "field value differs from its type"));
                }
                image.append(CtWidened(item, storage, kind));
        }
        field += 1;
    }
    if (matched != length(initializers)) {
        return CtResult.Failed(CtFail(context, node, file, "a compile-time record literal needs every field once"));
    }
    return CtResult.Elements(image, CtRecord + record);
}
// Evaluates a node CtCollect found: a call, a field or element, or a text
// comparison.
CtRead :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, node: int) -> CtResult {
    forest := context.forest;
    if (Is(forest, node, syntax.MemberExpression) || Is(forest, node, syntax.IndexExpression)) {
        switch CtLocate(context, package, file, frame, depth, node) {
            case .Failed(diagnostic):
                return CtResult.Failed(diagnostic);
            case .Waiting:
                return CtResult.Waiting;
            case .Spot(image, at, kind, local):
                return CtSpotValue(context, image, at, kind);
        }
    }
    if (Is(forest, node, syntax.BinaryExpression)) {
        return CtReadComparison(context, package, file, frame, depth, node);
    }
    code := CtIntrinsic(context, package, file, node);
    if (code == 0) {
        return CtCall(context, package, file, frame, depth, node);
    }
    if (code == CtFormatText) {
        return CtReadFormat(context, package, file, frame, depth, node);
    }
    if (code != CtLengthOf) {
        return CtReadText(context, package, file, frame, depth, node, code);
    }
    arguments := Members(forest, Field(forest, node, syntax.FieldArguments));
    if (length(arguments) != 1) {
        return CtResult.Failed(CtFail(context, node, file, "length takes one array or string"));
    }
    if (CtIsText(context, package, file, frame, arguments[0])) {
        return CtReadText(context, package, file, frame, depth, node, CtByteLength);
    }
    switch CtEvalArray(context, package, file, frame, depth, arguments[0], 0) {
        case .Failed(diagnostic):
            return CtResult.Failed(diagnostic);
        case .Waiting:
            return CtResult.Waiting;
        case .Value(item, kind):
            return CtResult.Failed(CtFail(context, arguments[0], file, "length takes an array"));
        case .Elements(image, kind):
            if (kind < CtArray) {
                return CtResult.Failed(CtFail(context, arguments[0], file, "length takes an array"));
            }
            return CtResult.Value(image[0], IntStorage);
    }
}
// Calls the function that `call` names with its arguments evaluated here.
CtCall :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, call: int) -> CtResult {
    callee := CtCallee(context, package, file, call);
    callable := context.callables[callee];
    if (callable.count < 0) {
        return CtResult.Failed(CtFail(context, call, file, "compile-time execution does not call generic functions yet"));
    }
    if (depth >= CtDepth) {
        return CtResult.Failed(CtFail(context, call, file, "compile-time evaluation exceeded 128 nested calls"));
    }
    arguments := Members(context.forest, Field(context.forest, call, syntax.FieldArguments));
    if (length(arguments) != callable.count) {
        return CtResult.Failed(CtFail(context, call, file, "compile-time call needs every argument"));
    }
    inner: CtFrame = {names: [], bits: [], storages: [], arrays: []};
    index: int = 0;
    while (index < length(arguments)) {
        param := context.params[callable.first + index];
        kind := CtTypeKind(param.storage, param.container, param.record);
        if (kind == 0 || !CtKindOk(context, kind) || param.reference ||
            Is(context.forest, arguments[index], syntax.NamedArgument)) {
            return CtResult.Failed(CtFail(context, arguments[index], file,
                                          "compile-time calls take numbers, bools, text, and arrays and records of them by position"));
        }
        if (kind >= CtRecord) {
            switch CtEvalArray(context, package, file, frame, depth, arguments[index], kind) {
                case .Failed(diagnostic):
                    return CtResult.Failed(diagnostic);
                case .Waiting:
                    return CtResult.Waiting;
                case .Value(item, got):
                    return CtResult.Failed(CtFail(context, arguments[index], file, "the argument must be an array or record"));
                case .Elements(image, got):
                    if (got != kind) {
                        return CtResult.Failed(CtFail(context, arguments[index], file,
                                                      "argument differs from its parameter type"));
                    }
                    inner.names.append(param.name);
                    inner.bits.append(0);
                    inner.storages.append(-kind);
                    CtAddRow(&inner, image);
            }
        } else {
            switch CtEval(context, package, file, frame, depth, arguments[index], param.storage) {
                case .Failed(diagnostic):
                    return CtResult.Failed(diagnostic);
                case .Waiting:
                    return CtResult.Waiting;
                case .Elements(values, got):
                    return CtResult.Failed(CtFail(context, arguments[index], file, "the argument must be a number"));
                case .Value(value, storage):
                    if (storage != param.storage && !CtWidens(storage, param.storage)) {
                        return CtResult.Failed(CtFail(context, arguments[index], file,
                                                      format_text("Mismatched integer types {} and {}; convert one operand",
                                                                  TypeName(storage), TypeName(param.storage))));
                    }
                    inner.names.append(param.name);
                    inner.bits.append(CtWidened(value, storage, param.storage));
                    inner.storages.append(param.storage);
                    CtAddRow(&inner, []);
            }
        }
        index += 1;
    }
    return CtRun(context, callee, &inner, depth + 1);
}
// Runs function `callee` with its arguments in `frame`.
CtRun :: (context: ^CtContext, callee: int, frame: ^CtFrame, depth: int) -> CtResult {
    callable := context.callables[callee];
    file := callable.document;
    kind := CtTypeKind(callable.result, callable.result_container, callable.result_record);
    if (callable.result == 0 || callable.results != 0 || kind == 0 || !CtKindOk(context, kind)) {
        return CtResult.Failed(CtFail(context, callable.node, file,
                                      "compile-time execution needs a function with one number, bool, text, array or record result"));
    }
    body := Field(context.forest, callable.node, syntax.FieldBody);
    switch CtBlock(context, callable.package, file, frame, depth, callable, Members(context.forest, body)) {
        case .Failed(diagnostic):
            return CtResult.Failed(diagnostic);
        case .Waiting:
            return CtResult.Waiting;
        case .Returned(value, storage):
            return CtResult.Value(value, storage);
        case .ReturnedElements(values, storage):
            return CtResult.Elements(values, storage);
        case .Normal:
            return CtResult.Failed(CtFail(context, callable.node, file, "a compile-time function must return a value"));
        case .Broke:
            return CtResult.Failed(CtFail(context, callable.node, file, "break outside a loop"));
        case .Continued:
            return CtResult.Failed(CtFail(context, callable.node, file, "continue outside a loop"));
    }
}
// The kind a type text names, 0 for none: a scalar, a record, or an array of
// either written `T[]`.
CtDeclared :: (context: ^CtContext, package: int, text: string) -> int {
    base := text;
    size := text_byte_length(text);
    listed := size > 2 && text_slice(text, size - 2, 2) == "[]";
    if (listed) {
        base = text_slice(text, 0, size - 2);
    }
    element := ScalarStorage(base);
    if (element == 0) {
        record := FindType(context.types, package, base);
        if (record >= 0 && context.types[record].kind == RecordDecl) {
            element = CtRecord + record;
        }
    }
    if (element != 0 && listed) {
        return CtArray + element;
    }
    return element;
}
// `name: type = value` or `name := value`, of any kind.
CtDeclaration :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int,
                  statement: int) -> CtFlow {
    forest := context.forest;
    text := context.documents[file].text;
    want: int = 0;
    declared := Field(forest, statement, syntax.FieldType);
    if (declared >= 0) {
        want = CtDeclared(context, package, Text(forest, text, declared));
        if (want == 0 || !CtKindOk(context, want)) {
            return CtFlow.Failed(CtFail(context, declared, file,
                                        "compile-time locals are numbers, bools, text, and arrays and records of them"));
        }
    }
    value := Field(forest, statement, syntax.FieldValue);
    if (value < 0) {
        return CtFlow.Failed(CtFail(context, statement, file, "a compile-time local needs a value"));
    }
    name := Text(forest, text, Field(forest, statement, syntax.FieldName));
    switch CtEvalValue(context, package, file, frame, depth, value, want) {
        case .Failed(diagnostic):
            return CtFlow.Failed(diagnostic);
        case .Waiting:
            return CtFlow.Waiting;
        case .Elements(image, kind):
            if (want != 0 && kind != want) {
                return CtFlow.Failed(CtFail(context, value, file, "local value differs from its type"));
            }
            frame.names.append(name);
            frame.bits.append(0);
            frame.storages.append(-kind);
            CtAddRow(frame, image);
            return CtFlow.Normal;
        case .Value(initial, storage):
            if (want != 0 && storage != want && !CtWidens(storage, want)) {
                return CtFlow.Failed(CtFail(context, value, file, "local value differs from its type"));
            }
            if (want == 0) {
                want = storage;
            }
            frame.names.append(name);
            frame.bits.append(CtWidened(initial, storage, want));
            frame.storages.append(want);
            CtAddRow(frame, []);
            return CtFlow.Normal;
    }
}
// The value of `current operator assigned` for a number of type `kind`; just
// `assigned` when there is no operator.
CtCombine :: (context: ^CtContext, file: int, statement: int, operator: int, kind: int, current: u64,
              assigned: u64) -> CtResult {
    if (operator == NoOperator) {
        return CtResult.Value(assigned, kind);
    }
    if (Floating(kind)) {
        if (operator != tk.Add && operator != tk.Sub && operator != tk.Mul && operator != tk.Quo) {
            return CtResult.Failed(CtFail(context, statement, file, "compound assignment on a float needs + - * or /"));
        }
        return CtResult.Value(FloatArithmetic(operator, current, assigned, kind), kind);
    }
    if (!Integer(kind)) {
        return CtResult.Failed(CtFail(context, statement, file, "compound assignment needs number operands"));
    }
    operand := ExactStored(assigned, kind);
    if ((operator == tk.Quo || operator == tk.Mod) && ExactZero(operand)) {
        return CtResult.Failed(CtFail(context, statement, file, "Constant division by zero"));
    }
    combined := CtApply(operator, ExactStored(current, kind), operand);
    if (MagnitudeBits(Magnitude(combined)) > ExactLimit || !ExactFits(combined, kind)) {
        return CtResult.Failed(OutsideRange(context.forest, file, statement, kind));
    }
    return CtResult.Value(ExactWrapped(combined, kind), kind);
}
// `x = v`, `x op= v`, and the same for a field or an element of a local, at any
// depth: `a.b[i].c += v`. An array or a record may be assigned whole.
CtAssignment :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int,
                 statement: int) -> CtFlow {
    forest := context.forest;
    text := context.documents[file].text;
    target := Field(forest, statement, syntax.FieldTarget);
    operator := CompoundOperator(Operator(forest, statement));
    value := Field(forest, statement, syntax.FieldValue);
    if (Is(forest, target, syntax.Identifier)) {
        at := CtLookup(frame, Text(forest, text, target));
        if (at < 0) {
            return CtFlow.Failed(CtFail(context, statement, file, "compile-time assignment needs a local"));
        }
        local := frame.storages[at];
        if (local > 0) {
            switch CtEval(context, package, file, frame, depth, value, local) {
                case .Failed(diagnostic):
                    return CtFlow.Failed(diagnostic);
                case .Waiting:
                    return CtFlow.Waiting;
                case .Elements(values, other):
                    return CtFlow.Failed(CtFail(context, statement, file, "assigned value differs from its local"));
                case .Value(assigned, storage):
                    if (storage != local && !CtWidens(storage, local)) {
                        return CtFlow.Failed(CtFail(context, statement, file, "assigned value differs from its local"));
                    }
                    switch CtCombine(context, file, statement, operator, local, frame.bits[at],
                                     CtWidened(assigned, storage, local)) {
                        case .Failed(diagnostic):
                            return CtFlow.Failed(diagnostic);
                        case .Waiting:
                            return CtFlow.Waiting;
                        case .Elements(values, other):
                            return CtFlow.Waiting;
                        case .Value(result, other):
                            frame.bits[at] = result;
                            return CtFlow.Normal;
                    }
            }
        }
    }
    switch CtLocate(context, package, file, frame, depth, target) {
        case .Failed(diagnostic):
            return CtFlow.Failed(diagnostic);
        case .Waiting:
            return CtFlow.Waiting;
        case .Spot(image, at, kind, local):
            if (local < 0) {
                return CtFlow.Failed(CtFail(context, statement, file, "compile-time assignment needs a local"));
            }
            if (kind >= CtRecord) {
                if (operator != NoOperator) {
                    return CtFlow.Failed(CtFail(context, statement, file, "compound assignment needs number operands"));
                }
                switch CtEvalArray(context, package, file, frame, depth, value, kind) {
                    case .Failed(diagnostic):
                        return CtFlow.Failed(diagnostic);
                    case .Waiting:
                        return CtFlow.Waiting;
                    case .Value(item, other):
                        return CtFlow.Failed(CtFail(context, statement, file, "assigned value differs from its local"));
                    case .Elements(replacement, got):
                        if (got != kind) {
                            return CtFlow.Failed(CtFail(context, statement, file, "assigned value differs from its local"));
                        }
                        CtSetRow(frame, local, CtSplice(image, at, CtSize(context, kind, image, at), replacement));
                        return CtFlow.Normal;
                }
            }
            switch CtEval(context, package, file, frame, depth, value, kind) {
                case .Failed(diagnostic):
                    return CtFlow.Failed(diagnostic);
                case .Waiting:
                    return CtFlow.Waiting;
                case .Elements(values, other):
                    return CtFlow.Failed(CtFail(context, statement, file, "assigned value differs from its local"));
                case .Value(assigned, storage):
                    if (storage != kind && !CtWidens(storage, kind)) {
                        return CtFlow.Failed(CtFail(context, statement, file, "assigned value differs from its local"));
                    }
                    switch CtCombine(context, file, statement, operator, kind, image[at], CtWidened(assigned, storage, kind)) {
                        case .Failed(diagnostic):
                            return CtFlow.Failed(diagnostic);
                        case .Waiting:
                            return CtFlow.Waiting;
                        case .Elements(values, other):
                            return CtFlow.Waiting;
                        case .Value(result, other):
                            updated := image;
                            updated[at] = result;
                            CtSetRow(frame, local, updated);
                            return CtFlow.Normal;
                    }
            }
    }
}
// `array.append(value)`, on a local array or an array in one, the one
// expression statement a compile-time function may use.
CtAppend :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int,
             statement: int) -> CtFlow {
    forest := context.forest;
    text := context.documents[file].text;
    call := FirstMember(forest, statement);
    function := Field(forest, call, syntax.FieldFunction);
    if (!Is(forest, call, syntax.CallExpression) || !Is(forest, function, syntax.MemberExpression) ||
        Text(forest, text, Field(forest, function, syntax.FieldMember)) != "append") {
        return CtFlow.Failed(CtFail(context, statement, file, "compile-time execution does not support this statement yet"));
    }
    arguments := Members(forest, Field(forest, call, syntax.FieldArguments));
    if (length(arguments) != 1) {
        return CtFlow.Failed(CtFail(context, statement, file, "append takes one value for a local array"));
    }
    switch CtLocate(context, package, file, frame, depth, Field(forest, function, syntax.FieldObject)) {
        case .Failed(diagnostic):
            return CtFlow.Failed(diagnostic);
        case .Waiting:
            return CtFlow.Waiting;
        case .Spot(image, at, kind, local):
            if (local < 0 || kind < CtArray) {
                return CtFlow.Failed(CtFail(context, statement, file, "append takes one value for a local array"));
            }
            element := kind - CtArray;
            piece: u64[] = [];
            switch CtEvalAny(context, package, file, frame, depth, arguments[0], element) {
                case .Failed(diagnostic):
                    return CtFlow.Failed(diagnostic);
                case .Waiting:
                    return CtFlow.Waiting;
                case .Elements(more, got):
                    if (got != element) {
                        return CtFlow.Failed(CtFail(context, statement, file, "array elements differ in type"));
                    }
                    piece = more;
                case .Value(item, storage):
                    if (storage != element && !CtWidens(storage, element)) {
                        return CtFlow.Failed(CtFail(context, statement, file, "array elements differ in type"));
                    }
                    piece = [CtWidened(item, storage, element)];
            }
            size := CtSize(context, kind, image, at);
            replacement: u64[] = [image[at] + 1];
            replacement.extend(slice(image, at + 1, size - 1));
            replacement.extend(piece);
            CtSetRow(frame, local, CtSplice(image, at, size, replacement));
            return CtFlow.Normal;
    }
}
// A new text value of the run: its index.
CtIntern :: (context: ^CtContext, value: string) -> u64 {
    context.texts.append(value);
    return u64(length(context.texts) - 1);
}
// The value of a text expression: the index of its bytes.
CtEvalText :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, node: int) -> CtResult {
    forest := context.forest;
    value := Unparenthesized(forest, node);
    if (Is(forest, value, syntax.String)) {
        decoded := json.Value(Text(forest, context.documents[file].text, value));
        if (!decoded.valid) {
            return CtResult.Failed(CtFail(context, value, file, "Invalid string literal"));
        }
        return CtResult.Value(CtIntern(context, decoded.value), TextStorage);
    }
    if (Is(forest, value, syntax.Identifier)) {
        at := CtLookup(frame, Text(forest, context.documents[file].text, value));
        if (at >= 0 && frame.storages[at] == TextStorage) {
            return CtResult.Value(frame.bits[at], TextStorage);
        }
    }
    if (Is(forest, value, syntax.CallExpression) || Is(forest, value, syntax.MemberExpression) ||
        Is(forest, value, syntax.IndexExpression)) {
        return CtRead(context, package, file, frame, depth, value);
    }
    return CtResult.Failed(CtFail(context, node, file, "a compile-time text is a literal, a local or a call"));
}
// `left == right` or `left != right` over text.
CtReadComparison :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int,
                     node: int) -> CtResult {
    operator := Operator(context.forest, node);
    if (operator != tk.CmpEq && operator != tk.NotEq) {
        return CtResult.Failed(CtFail(context, node, file, "text compares with == and !="));
    }
    switch CtEvalText(context, package, file, frame, depth, Field(context.forest, node, syntax.FieldLeft)) {
        case .Failed(diagnostic):
            return CtResult.Failed(diagnostic);
        case .Waiting:
            return CtResult.Waiting;
        case .Elements(more, other):
            return CtResult.Failed(CtFail(context, node, file, "text compares with text"));
        case .Value(left, kind):
            switch CtEvalText(context, package, file, frame, depth, Field(context.forest, node, syntax.FieldRight)) {
                case .Failed(diagnostic):
                    return CtResult.Failed(diagnostic);
                case .Waiting:
                    return CtResult.Waiting;
                case .Elements(more, other):
                    return CtResult.Failed(CtFail(context, node, file, "text compares with text"));
                case .Value(right, other):
                    same := context.texts[int(left)] == context.texts[int(right)];
                    if (same == (operator == tk.CmpEq)) {
                        return CtResult.Value(1, BoolStorage);
                    }
                    return CtResult.Value(0, BoolStorage);
            }
    }
}
// The decimal digits of `value` of integer type `kind`, with a sign if negative.
CtDecimal :: (value: u64, kind: int) -> string {
    exact := ExactStored(value, kind);
    digits := format_text("{}", LowBits(Magnitude(exact)));
    if (ExactNegative(exact)) {
        return format_text("-{}", digits);
    }
    return digits;
}
// `format_text(template, arguments...)` with `{}` for the next argument, which
// is text, an integer or a bool, and `{{` and `}}` for the braces.
CtReadFormat :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int,
                 call: int) -> CtResult {
    arguments := Members(context.forest, Field(context.forest, call, syntax.FieldArguments));
    if (length(arguments) == 0) {
        return CtResult.Failed(CtFail(context, call, file, "format_text needs a template"));
    }
    template: string = "";
    switch CtEvalText(context, package, file, frame, depth, arguments[0]) {
        case .Failed(diagnostic):
            return CtResult.Failed(diagnostic);
        case .Waiting:
            return CtResult.Waiting;
        case .Elements(more, other):
            return CtResult.Failed(CtFail(context, arguments[0], file, "format_text takes a text template"));
        case .Value(slot, kind):
            template = context.texts[int(slot)];
    }
    pieces: string[] = [];
    for argument in slice(arguments, 1, length(arguments) - 1) {
        if (CtIsText(context, package, file, frame, argument)) {
            switch CtEvalText(context, package, file, frame, depth, argument) {
                case .Failed(diagnostic):
                    return CtResult.Failed(diagnostic);
                case .Waiting:
                    return CtResult.Waiting;
                case .Elements(more, other):
                    return CtResult.Failed(CtFail(context, argument, file, "format_text takes text"));
                case .Value(slot, kind):
                    pieces.append(context.texts[int(slot)]);
            }
            continue;
        }
        switch CtEval(context, package, file, frame, depth, argument, 0) {
            case .Failed(diagnostic):
                return CtResult.Failed(diagnostic);
            case .Waiting:
                return CtResult.Waiting;
            case .Elements(more, other):
                return CtResult.Failed(CtFail(context, argument, file, "format_text takes text, integers and bools here"));
            case .Value(value, kind):
                if (kind == BoolStorage) {
                    if (value != 0) {
                        pieces.append("true");
                    } else {
                        pieces.append("false");
                    }
                } else if (Integer(kind)) {
                    pieces.append(CtDecimal(value, kind));
                } else {
                    return CtResult.Failed(CtFail(context, argument, file,
                                                  "format_text takes text, integers and bools here"));
                }
        }
    }
    output := "";
    size := strings.ByteLength(template);
    used := 0;
    at := 0;
    while (at < size) {
        byte := strings.ByteAt(template, at);
        next := strings.ByteAt(template, at + 1);
        if (byte == 123 && next == 123) {
            output = format_text("{}{}", output, "{");
            at += 2;
        } else if (byte == 125 && next == 125) {
            output = format_text("{}{}", output, "}");
            at += 2;
        } else if (byte == 123 && next == 125) {
            if (used >= length(pieces)) {
                return CtResult.Failed(CtFail(context, call, file, "format_text has fewer arguments than placeholders"));
            }
            output = format_text("{}{}", output, pieces[used]);
            used += 1;
            at += 2;
        } else if (byte == 123 || byte == 125) {
            return CtResult.Failed(CtFail(context, arguments[0], file, "format_text supports only {} at compile time"));
        } else {
            output = format_text("{}{}", output, strings.Slice(template, at, 1));
            at += 1;
        }
    }
    if (used != length(pieces)) {
        return CtResult.Failed(CtFail(context, call, file, "format_text has more arguments than placeholders"));
    }
    return CtResult.Value(CtIntern(context, output), TextStorage);
}
// The text operations: `text_byte_length(text)`, `text_byte_at(text, index)`,
// `text_slice(text, start, count)` and `text_bytes(text)`, `code` of them.
CtReadText :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, call: int,
               code: int) -> CtResult {
    arguments := Members(context.forest, Field(context.forest, call, syntax.FieldArguments));
    wanted := 1;
    if (code == CtByteAt) {
        wanted = 2;
    } else if (code == CtSliceOf) {
        wanted = 3;
    }
    if (length(arguments) != wanted) {
        return CtResult.Failed(CtFail(context, call, file, "a text operation needs its arguments"));
    }
    subject: string = "";
    switch CtEvalText(context, package, file, frame, depth, arguments[0]) {
        case .Failed(diagnostic):
            return CtResult.Failed(diagnostic);
        case .Waiting:
            return CtResult.Waiting;
        case .Elements(more, other):
            return CtResult.Failed(CtFail(context, arguments[0], file, "a text operation takes text"));
        case .Value(slot, kind):
            subject = context.texts[int(slot)];
    }
    if (code == CtByteLength) {
        return CtResult.Value(u64(strings.ByteLength(subject)), IntStorage);
    }
    if (code == CtBytesOf) {
        bytes: u64[] = [];
        for byte in strings.Bytes(subject) {
            bytes.append(u64(byte));
        }
        image: u64[] = [u64(length(bytes))];
        image.extend(bytes);
        return CtResult.Elements(image, CtArray + IntStorage);
    }
    numbers: int[] = [];
    for argument in slice(arguments, 1, wanted - 1) {
        switch CtEval(context, package, file, frame, depth, argument, IntStorage) {
            case .Failed(diagnostic):
                return CtResult.Failed(diagnostic);
            case .Waiting:
                return CtResult.Waiting;
            case .Elements(more, other):
                return CtResult.Failed(CtFail(context, argument, file, "a text offset is a number"));
            case .Value(number, kind):
                if (!Integer(kind)) {
                    return CtResult.Failed(CtFail(context, argument, file, "a text offset is a number"));
                }
                signed := ExactStored(number, kind);
                if (ExactNegative(signed)) {
                    numbers.append(-1);
                } else {
                    numbers.append(int(LowBits(Magnitude(signed))));
                }
        }
    }
    if (code == CtByteAt) {
        found := strings.ByteAt(subject, numbers[0]);
        if (found < 0) {
            return CtResult.Value(ExactWrapped(ExactOf(true, 1), IntStorage), IntStorage);
        }
        return CtResult.Value(u64(found), IntStorage);
    }
    return CtResult.Value(CtIntern(context, strings.Slice(subject, numbers[0], numbers[1])), TextStorage);
}
// `value` of type `from` as a value of the wider type `to`.
CtWidened :: (value: u64, from: int, to: int) -> u64 {
    if (Floating(from) && Floating(to)) {
        return FloatingBits(value, from, to);
    }
    return ExactWrapped(ExactStored(value, from), to);
}
// Whether a value of type `from` converts to `to` without loss: an integer to
// a wider one, a float to a wider float.
CtWidens :: (from: int, to: int) -> bool {
    return Widens(from, to) || FloatWidens(from, to);
}
// `left op right` over exact values.
CtApply :: (operator: int, left: u64[], right: u64[]) -> u64[] {
    if (operator == tk.Add) {
        return ExactAdd(left, right);
    }
    if (operator == tk.Sub) {
        return ExactSubtract(left, right);
    }
    if (operator == tk.Mul) {
        return ExactMultiply(left, right);
    }
    if (operator == tk.Quo || operator == tk.Mod) {
        return ExactDivide(left, right, operator == tk.Mod);
    }
    return ExactBitwise(operator, left, right);
}
// Adds the elements of a new array local, or an empty row for a scalar.
CtAddRow :: (frame: ^CtFrame, values: u64[]) {
    row: CtRow = {items: values};
    frame.arrays.append(row);
}
CtSetRow :: (frame: ^CtFrame, at: int, values: u64[]) {
    row: CtRow = {items: values};
    frame.arrays[at] = row;
}
// Drops the locals declared after the first `mark`.
CtDrop :: (frame: ^CtFrame, mark: int) {
    frame.names.resize(mark);
    frame.bits.resize(mark);
    frame.storages.resize(mark);
    frame.arrays.resize(mark);
}
// Runs the statements of a block of `function`; its locals end with it.
CtBlock :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, function: Callable,
            statements: int[]) -> CtFlow {
    mark := length(frame.names);
    for (statement in statements) {
        if (!CtStep(context, statement, file)) {
            return CtFlow.Failed(CtFail(context, statement, file, "compile-time evaluation exceeded 65536 steps"));
        }
        switch CtStatement(context, package, file, frame, depth, function, statement) {
            case .Normal:
                continue;
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Returned(value, storage):
                CtDrop(frame, mark);
                return CtFlow.Returned(value, storage);
            case .ReturnedElements(values, storage):
                CtDrop(frame, mark);
                return CtFlow.ReturnedElements(values, storage);
            case .Broke:
                CtDrop(frame, mark);
                return CtFlow.Broke;
            case .Continued:
                CtDrop(frame, mark);
                return CtFlow.Continued;
        }
    }
    CtDrop(frame, mark);
    return CtFlow.Normal;
}
CtStatement :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, function: Callable,
                statement: int) -> CtFlow {
    forest := context.forest;
    if (Is(forest, statement, syntax.ReturnStatement)) {
        value := Field(forest, statement, syntax.FieldValue);
        if (value < 0) {
            return CtFlow.Failed(CtFail(context, statement, file, "return needs a value"));
        }
        row := CtTypeKind(function.result, function.result_container, function.result_record);
        if (row >= CtRecord) {
            switch CtEvalArray(context, package, file, frame, depth, value, row) {
                case .Failed(diagnostic):
                    return CtFlow.Failed(diagnostic);
                case .Waiting:
                    return CtFlow.Waiting;
                case .Value(item, kind):
                    return CtFlow.Failed(CtFail(context, value, file, "returned value differs from the result type"));
                case .Elements(values, kind):
                    if (kind != row) {
                        return CtFlow.Failed(CtFail(context, value, file, "returned value differs from the result type"));
                    }
                    return CtFlow.ReturnedElements(values, kind);
            }
        }
        switch CtEval(context, package, file, frame, depth, value, function.result) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Elements(values, kind):
                return CtFlow.Failed(CtFail(context, value, file, "returned value differs from the result type"));
            case .Value(returned, storage):
                if (storage != function.result && !CtWidens(storage, function.result)) {
                    return CtFlow.Failed(CtFail(context, value, file, "returned value differs from the result type"));
                }
                return CtFlow.Returned(CtWidened(returned, storage, function.result), function.result);
        }
    }
    if (Is(forest, statement, syntax.BreakStatement)) {
        return CtFlow.Broke;
    }
    if (Is(forest, statement, syntax.ContinueStatement)) {
        return CtFlow.Continued;
    }
    if (Is(forest, statement, syntax.LocalDeclaration)) {
        return CtDeclaration(context, package, file, frame, depth, statement);
    }
    if (Is(forest, statement, syntax.Assignment)) {
        return CtAssignment(context, package, file, frame, depth, statement);
    }
    if (Is(forest, statement, syntax.ExpressionStatement)) {
        return CtAppend(context, package, file, frame, depth, statement);
    }
    if (Is(forest, statement, syntax.IfStatement)) {
        switch CtEval(context, package, file, frame, depth, Field(forest, statement, syntax.FieldCondition), BoolStorage) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Elements(values, kind):
                return CtFlow.Failed(CtFail(context, statement, file, "an if condition must be a bool"));
            case .Value(taken, storage):
                if (storage != BoolStorage) {
                    return CtFlow.Failed(CtFail(context, Field(forest, statement, syntax.FieldCondition), file,
                                                "an if condition must be a bool"));
                }
                if (taken != 0) {
                    return CtBlock(context, package, file, frame, depth, function,
                                   Members(forest, Field(forest, statement, syntax.FieldConsequence)));
                }
                alternative := Field(forest, statement, syntax.FieldAlternative);
                if (Is(forest, alternative, syntax.IfStatement)) {
                    return CtStatement(context, package, file, frame, depth, function, alternative);
                }
                if (alternative >= 0) {
                    return CtBlock(context, package, file, frame, depth, function, Members(forest, alternative));
                }
                return CtFlow.Normal;
        }
    }
    if (Is(forest, statement, syntax.WhileStatement)) {
        return CtWhile(context, package, file, frame, depth, function, statement);
    }
    if (Is(forest, statement, syntax.ForStatement)) {
        return CtFor(context, package, file, frame, depth, function, statement);
    }
    return CtFlow.Failed(CtFail(context, statement, file, "compile-time execution does not support this statement yet"));
}
// `while condition { ... }`.
CtWhile :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, function: Callable,
            statement: int) -> CtFlow {
    forest := context.forest;
    while (true) {
        if (!CtStep(context, statement, file)) {
            return CtFlow.Failed(CtFail(context, statement, file, "compile-time evaluation exceeded 65536 steps"));
        }
        switch CtEval(context, package, file, frame, depth, Field(forest, statement, syntax.FieldCondition), BoolStorage) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Elements(values, kind):
                return CtFlow.Failed(CtFail(context, statement, file, "a while condition must be a bool"));
            case .Value(taken, storage):
                if (storage != BoolStorage) {
                    return CtFlow.Failed(CtFail(context, Field(forest, statement, syntax.FieldCondition), file,
                                                "a while condition must be a bool"));
                }
                if (taken == 0) {
                    return CtFlow.Normal;
                }
        }
        switch CtBlock(context, package, file, frame, depth, function, Members(forest, Field(forest, statement, syntax.FieldBody))) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Returned(value, storage):
                return CtFlow.Returned(value, storage);
            case .ReturnedElements(values, storage):
                return CtFlow.ReturnedElements(values, storage);
            case .Broke:
                return CtFlow.Normal;
            case .Normal:
                continue;
            case .Continued:
                continue;
        }
    }
}
// `for i in first..<last`, `for i in first..last`, `for item in array`,
// `for index, item in array`, each also reversed with `for <`.
CtFor :: (context: ^CtContext, package: int, file: int, frame: ^CtFrame, depth: int, function: Callable,
          statement: int) -> CtFlow {
    forest := context.forest;
    text := context.documents[file].text;
    name := Text(forest, text, Field(forest, statement, syntax.FieldName));
    reverse := Field(forest, statement, syntax.FieldReverse) >= 0;
    if (Field(forest, statement, syntax.FieldReference) >= 0) {
        return CtFlow.Failed(CtFail(context, statement, file, "compile-time loops iterate by value"));
    }
    values: u64[] = [];
    kind: int = IntStorage;
    // An array of records iterates by element: the kind and the images.
    element: int = 0;
    parts: CtRow[] = [];
    key := Field(forest, statement, syntax.FieldKey);
    if (Field(forest, statement, syntax.FieldFirst) >= 0) {
        first: u64 = 0;
        last: u64 = 0;
        switch CtEval(context, package, file, frame, depth, Field(forest, statement, syntax.FieldFirst), 0) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Elements(more, other):
                return CtFlow.Failed(CtFail(context, statement, file, "a range bound is a number"));
            case .Value(low, storage):
                first = low;
                kind = storage;
        }
        switch CtEval(context, package, file, frame, depth, Field(forest, statement, syntax.FieldLast), kind) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Elements(more, other):
                return CtFlow.Failed(CtFail(context, statement, file, "a range bound is a number"));
            case .Value(high, storage):
                last = CtWidened(high, storage, kind);
        }
        if (!Integer(kind)) {
            return CtFlow.Failed(CtFail(context, statement, file, "a range bound is an integer"));
        }
        low := ExactStored(first, kind);
        high := ExactStored(last, kind);
        if (Text(forest, text, Field(forest, statement, syntax.FieldBound)) == "..") {
            high = ExactAdd(high, ExactOf(false, 1));
        }
        while (!ExactNegative(ExactSubtract(high, low)) && !ExactZero(ExactSubtract(high, low))) {
            if (length(values) >= CtSteps) {
                return CtFlow.Failed(CtFail(context, statement, file, "compile-time evaluation exceeded 65536 steps"));
            }
            values.append(ExactWrapped(low, kind));
            low = ExactAdd(low, ExactOf(false, 1));
        }
    } else {
        switch CtEvalArray(context, package, file, frame, depth, Field(forest, statement, syntax.FieldValue), 0) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Value(item, other):
                return CtFlow.Failed(CtFail(context, statement, file, "only an array can be iterated at compile time"));
            case .Elements(image, storage):
                if (storage < CtArray) {
                    return CtFlow.Failed(CtFail(context, statement, file, "only an array can be iterated at compile time"));
                }
                element = storage - CtArray;
                count := int(image[0]);
                if (element < CtRecord) {
                    values = slice(image, 1, count);
                    kind = element;
                } else {
                    place := 1;
                    index := 0;
                    while (index < count) {
                        size := CtSize(context, element, image, place);
                        part: CtRow = {items: slice(image, place, size)};
                        parts.append(part);
                        place += size;
                        index += 1;
                    }
                }
        }
    }
    total := length(values);
    if (element >= CtRecord) {
        total = length(parts);
    }
    mark := length(frame.names);
    position: int = 0;
    while (position < total) {
        if (!CtStep(context, statement, file)) {
            return CtFlow.Failed(CtFail(context, statement, file, "compile-time evaluation exceeded 65536 steps"));
        }
        at := position;
        if (reverse) {
            at = total - 1 - position;
        }
        if (key >= 0) {
            frame.names.append(Text(forest, text, key));
            frame.bits.append(u64(at));
            frame.storages.append(IntStorage);
            CtAddRow(frame, []);
        }
        frame.names.append(name);
        if (element >= CtRecord) {
            frame.bits.append(0);
            frame.storages.append(-element);
            CtAddRow(frame, parts[at].items);
        } else {
            frame.bits.append(values[at]);
            frame.storages.append(kind);
            CtAddRow(frame, []);
        }
        position += 1;
        switch CtBlock(context, package, file, frame, depth, function, Members(forest, Field(forest, statement, syntax.FieldBody))) {
            case .Failed(diagnostic):
                return CtFlow.Failed(diagnostic);
            case .Waiting:
                return CtFlow.Waiting;
            case .Returned(value, storage):
                CtDrop(frame, mark);
                return CtFlow.Returned(value, storage);
            case .ReturnedElements(items, storage):
                CtDrop(frame, mark);
                return CtFlow.ReturnedElements(items, storage);
            case .Broke:
                CtDrop(frame, mark);
                return CtFlow.Normal;
            case .Normal:
                CtDrop(frame, mark);
            case .Continued:
                CtDrop(frame, mark);
        }
    }
    CtDrop(frame, mark);
    return CtFlow.Normal;
}
// Folds the value of a constant whose expression calls authored functions:
// each call runs first and stands for its value.
FoldCalling :: (forest: snapshot.SnapshotNode[], documents: snapshot.Document[], links: graph.Binding[],
                callables: Callable[], params: Param[], constants: ConstDecl[], types: TypeDecl[],
                members: TypeMember[], package: int, file: int, node: int, storage: int) -> Folding {
    text := documents[file].text;
    aliases := Aliases(links, file);
    context: CtContext = {forest: forest, documents: documents, links: links, callables: callables, params: params,
                          constants: constants, types: types, members: members, texts: [], steps: 0};
    frame: CtFrame = {names: [], bits: [], storages: [], arrays: []};
    reads: int[] = [];
    CtCollect(&context, package, file, &frame, node, &reads);
    if (length(reads) == 0) {
        return FoldConstant(forest, text, file, constants, aliases, package, node, storage);
    }
    memo: ConstDecl[] = [];
    for (read in reads) {
        switch CtRead(&context, package, file, &frame, 0, read) {
            case .Failed(diagnostic):
                return Folding.Failed(diagnostic);
            case .Waiting:
                return Folding.Waiting;
            case .Elements(values, kind):
                return Folding.Failed(Diagnose(forest, read, file, "constant value must be an integer expression"));
            case .Value(value, result):
                placed: ConstDecl = {name: "", package: package, storage: result, bits: value, node: read, file: file,
                                     folded: true, occurrence: 0};
                memo.append(placed);
        }
    }
    scope := memo;
    scope.extend(constants);
    return FoldConstant(forest, text, file, scope, aliases, package, node, storage);
}
