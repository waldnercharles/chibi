version 3
name "SurfaceRing"
domain "shape"
bounds_x 12.0
bounds_y 12.0
id_counter 1000
description "A horizontal ring with an open center; local Y is the tube's height."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=100 type="Shader ObjectPosition" x=0.0 y=0.0
            - {
                id 200
                type "Behavior Expression"
                x 250.0
                y 0.0
                reference_name "length(vec2(length(position.xz) - 8, position.y)) - 2.5"
                inputs {
                    position id=201 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=202 type="float"
                }
            }
            - id=300 type="Shader Shape Output" x=750.0 y=0.0
        }
        (array)edges {
            - from="100.Value" to="200.position"
            - from="200.Result" to="300.Distance"
        }
    }
    - id=500 kind="function" math_expression="length(vec2(length(position.xz) - 8, position.y)) - 2.5" expression_mode=1 entry_id=501
}
