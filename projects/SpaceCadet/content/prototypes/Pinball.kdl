name "Pinball"
components {
    GAME.GameActionBinding action="Dash" source="Space"
    GAME.GameAppearance border_color=0x64758cff border_width=2.0 color=0xeef4ffff glow_color=0xbde5ffff glow_radius=2.0 height=15.0 layer=20 shape="Circle" width=15.0
    GAME.GameBody continuous=#true type="Dynamic"
    GAME.GameCollider category=1 friction=0.08 mask=30 radius=7.5 restitution=0.7
    GAME.GameGlobalBinding name="Ball"
    (object)GAME.GameInput
    GAME.GameTransform x=196.0 y=260.0
    (object)GAME.GameVelocity
}
(array)behaviors "BallMotion" "GameState" "Nudge" "Plunger" "Scoring"
