behavior "ProjectileLifecycle" {
    owner "ecs.entity";
    on Tick as tick(DeltaSeconds: float = 0.0) {
        &component("GAME.GameProjectile", "age") += tick.DeltaSeconds;
        if (cast<double>(&component("GAME.GameProjectile", "age")) >= cast<double>(&component("GAME.GameProjectile", "lifetime"))) {
            destroy_entity(Entity: self);
        } else {
        }
    }
}
