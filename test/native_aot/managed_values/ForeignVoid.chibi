package foreign_void

foreign import libc "system:c"
foreign libc {
    qsort :: (bytes: u8[], count: u64, size: u64, compare: fn(left: u64, right: u64) -> i32)
    memcmp :: (left: u64, right: u64, count: u64) -> i32
}

Main :: () -> int {
    values := [u8(3), 1, 2];
    previous := values;
    qsort(values, 3, 1, Compare);
    assert(values[0] == 1 && values[1] == 2 && values[2] == 3);
    assert(previous[0] == 3 && previous[1] == 1 && previous[2] == 2);
    qsort([u8(3), 2, 1], 3, 1, Compare);
    // The void call retains the first argument's value through a later
    // argument replacing its canonical place, then releases that loan.
    qsort(values, Replace(&values), 1, Compare);
    assert(length(values) == 1 && values[0] == 9);
    return 0;
}
Compare :: (left: u64, right: u64) -> i32 { return memcmp(left, right, 1); }
Replace :: (values: ^(u8[])) -> u64 { values^ = [9]; return 3; }
