version 1
name "SdfOcclusionNearPlane"
(array)entities {
    - {
        name "Camera"
        prototype "SdfOptimizationCamera"
        components {
            GameTransform x=0.0 y=0.0
            GameCamera width=180.0 height=120.0 focal_distance=120.0
            GameHRC2D surface_shadow_mode="Horizon8" ambient=0.25 fog=0.01 bounce_intensity=0.1
        }
        (array)behaviors "SdfOcclusionCameraSweep"
    }
    - {
        name "Cyan light"
        prototype "SdfLight"
        components {
            GameTransform x=-280.0 y=-150.0
            GameMaterial emission_color=0x38d9edff
        }
    }
    - {
        name "Amber light"
        prototype "SdfLight"
        components {
            GameTransform x=280.0 y=150.0
            GameMaterial emission_color=0xffac54ff
        }
    }
    - {
        name "Behind clipped blocker"
        prototype "SdfTorus"
        components {
            GameTransform x=0.0 y=0.0
            GameVisualTransform scale=0.8 pitch=0.0 yaw=0.0 roll=0.0
            GameGeometry3D elevation=0.0
        }
    }
    - {
        name "Near-plane crossing mesh"
        prototype "SdfComparisonMesh"
        components {
            GameTransform x=2.0 y=0.0
            GameVisualTransform scale=0.05 pitch=0.0 yaw=0.0 roll=0.0
            GameGeometry3D width=60.0 height=100.0 depth=60.0 elevation=119.0
            GameShader material="SdfCyan"
        }
    }
    - {
        name "Near-plane crossing SDF"
        prototype "SdfRoundedBox"
        components {
            GameTransform x=-2.0 y=0.0
            GameVisualTransform scale=0.05 pitch=0.0 yaw=0.0 roll=0.0
            GameGeometry3D elevation=119.0
            GameShader material="SdfRose"
        }
    }
    - {
        name "Ordinary receiver"
        prototype "SdfSmoothUnion"
        components {
            GameTransform x=-35.0 y=30.0
            GameVisualTransform scale=0.5 pitch=0.0 yaw=0.0 roll=0.0
        }
    }
}
