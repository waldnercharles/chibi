package map_evaluation_effects

ResetKey :: (values: ^([int: int])) -> int { values^ = [9: 90]; return 1; }
ResetValue :: (values: ^([int: int])) -> int { values^ = [8: 80]; return 7; }
ResetRead :: (values: ^([int: int])) -> int { values^ = [1: 99]; return 1; }
OldArgument :: (values: [int: int], ignored: int) -> int { return values[1]; }
Main :: () -> int {
    CallsCaptured();
    WritesCurrent();
    values: [int: int] = [1: 5];
    assert(ScopedCall(&values, &values) == 11);
    assert(values[1] == 99);
    assert(ScopedLoop(&values, &values) == 33);
    return 0;
}
ScopedCall :: (read: ^([int: int]), changed: ^([int: int])) -> int {
    read^ = [1: 11];
    return OldArgument(read^, ResetRead(changed));
}
ScopedLoop :: (read: ^([int: int]), changed: ^([int: int])) -> int {
    read^ = [1: 11, 2: 22];
    total: int = 0;
    for (key, value in read^) {
        ResetRead(changed);
        total += value;
    }
    return total;
}
CallsCaptured :: () -> int {
    values: [int: int] = [1: 11];
    assert(OldArgument(values, ResetRead(&values)) == 11);
    assert(values[1] == 99);
    return 0;
}
WritesCurrent :: () -> int {
    values: [int: int] = [1: 11];
    // Changes resolve their current target after evaluating key and value.
    values[ResetKey(&values)] = 5;
    assert(values[9] == 90 && values[1] == 5);
    values[1] = ResetValue(&values);
    assert(values[8] == 80 && values[1] == 7 && !values.has(9));
    values[ResetKey(&values)] = ResetValue(&values);
    assert(values[8] == 80 && values[1] == 7 && !values.has(9));
    delete values[ResetRead(&values)];
    assert(!values.has(1));
    return 0;
}
