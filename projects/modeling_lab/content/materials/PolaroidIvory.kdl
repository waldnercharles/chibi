    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 1
                type "Shader Surface Output"
                inputs {
                    "Base Color" {
                        default x=0.8 y=0.77 z=0.66
                    }
                    Emission {
                        default x=0.0 y=0.0 z=0.0
                    }
                    Roughness 0.38
                    Normal {
                        default x=0.0 y=0.0 z=0.0
                    }
                }
            }
        }
    }
}
