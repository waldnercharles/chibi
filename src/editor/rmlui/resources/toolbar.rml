<rml>
<head>
    <title>Workspace Toolbar</title>
    <link type="text/rcss" href="toolbar.rcss" />
</head>
<body>
    <div id="toolbar-root" class="toolbar-root" role="toolbar" aria-label="Workspace navigation">
        <button id="workspace.back" class="toolbar-button icon-button" data-action="workspace.back" aria-label="Back" disabled>
            <span class="arrow" aria-hidden="true">←</span>
        </button>
        <button id="workspace.forward" class="toolbar-button icon-button" data-action="workspace.forward" aria-label="Forward" disabled>
            <span class="arrow" aria-hidden="true">→</span>
        </button>
        <button id="content.quick_open" class="toolbar-button quick-open" data-action="content.quick_open">
            <span class="quick-open-label">Quick Open</span>
        </button>
        <button id="workspace.documents.list" class="toolbar-button icon-button" data-action="workspace.documents.list" aria-label="Open documents">
            <span class="documents-caret" aria-hidden="true">⌄</span>
        </button>
    </div>
</body>
</rml>
