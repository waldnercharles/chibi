package nested_map_places

Item :: struct { name: string; values: int[]; }
Index :: (trace: ^int) -> int { trace^ = trace^ * 10 + 1; return 0; }
Key :: (trace: ^int) -> string { trace^ = trace^ * 10 + 2; return "a"; }
Value :: (trace: ^int) -> int { trace^ = trace^ * 10 + 3; return 9; }
ReplaceRows :: (rows: ^([string:int][])) -> int { rows^ = [["a":10, "b":20]]; return 9; }
ReplaceIndex :: (rows: ^([string:int][])) -> int { rows^ = [["a":10]]; return 0; }
ReplaceKey :: (rows: ^([string:int][])) -> string { rows^ = [["a":10, "b":20]]; return "a"; }
ReplaceGroups :: (groups: ^([string:[string:int]])) -> int {
    replacement: [string:[string:int]] = ["g":["a":10, "b":20]];
    groups^ = replacement;
    return 9;
}
GroupKey :: (groups: ^([string:[string:int]])) -> string { ignored := ReplaceGroups(groups); return "g"; }
InnerKey :: (groups: ^([string:[string:int]])) -> string { ignored := ReplaceGroups(groups); return "a"; }
Word :: (value: u8) -> string { return text_from_bytes([u8(97), 0, value]); }
ChangeKey :: (key: ^string) -> int { key^ = Word(2); return 4; }
Aliased :: (read: ^([string:int][]), changed: ^([string:int][])) -> int {
    read^[0]["a"] += ReplaceRows(changed);
    return read^[0]["a"];
}
Main :: () -> int {
    trace := 0;
    rows: [string:int][] = [["a":1]];
    old := rows;
    rows[Index(&trace)][Key(&trace)] = Value(&trace);
    assert(trace == 123 && rows[0]["a"] == 9 && old[0]["a"] == 1);
    rows[0]["a"] += ReplaceRows(&rows);
    assert(rows[0]["a"] == 18 && rows[0]["b"] == 20);
    rows[ReplaceIndex(&rows)]["a"] += 9;
    assert(rows[0]["a"] == 19);
    rows[0][ReplaceKey(&rows)] += 9;
    assert(rows[0]["a"] == 19);
    rows = [];
    rows[0]["a"] += ReplaceRows(&rows);
    assert(rows[0]["a"] == 9);
    snapshot := rows;
    delete rows[0][ReplaceKey(&rows)];
    assert(!rows[0].has("a") && rows[0]["b"] == 20 && snapshot[0]["a"] == 9);
    joined := Aliased(&rows, &rows);
    assert(joined == 9 && rows[0]["a"] == 9);

    groups: [string:[string:int]] = ["g":["a":1]];
    saved := groups;
    groups["g"]["a"] += ReplaceGroups(&groups);
    assert(groups["g"]["a"] == 10 && saved["g"]["a"] == 1);
    groups[GroupKey(&groups)]["a"] += 9;
    assert(groups["g"]["a"] == 19);
    groups["g"][InnerKey(&groups)] += 9;
    assert(groups["g"]["a"] == 19);
    groups = [:];
    groups["g"]["a"] += ReplaceGroups(&groups);
    assert(groups["g"]["a"] == 9);
    kept := groups;
    delete groups["g"]["a"];
    assert(!groups["g"].has("a") && kept["g"]["a"] == 9);

    for (index in 0..<96) {
        key := Word(1);
        words: [string:int][] = [[:]];
        words[0][key] += ChangeKey(&key);
        assert(words[0][Word(1)] == 4 && !words[0].has(Word(2)));
        dynamic := text_from_bytes([u8(110), 97, 109, 101]);
        records: [int:Item][] = [[:]];
        records[0][1] = {name:dynamic, values:[index,2]};
        copy := records;
        records[0][1] = {name:"replacement", values:[3]};
        delete records[0][1];
        assert(copy[0][1].name == "name" && copy[0][1].values[0] == index && !records[0].has(1));
        nested: [int:[int:Item]] = [1:[:]];
        nested[1][2] = copy[0][1];
        prior := nested;
        delete nested[1][2];
        assert(prior[1][2].name == "name" && prior[1][2].values[0] == index && !nested[1].has(2));
    }
    buffers: [int:int[]][] = [[:]];
    buffers[0][1] = [1,2];
    old_buffers := buffers;
    buffers[0][1] = [3];
    assert(old_buffers[0][1][1] == 2 && buffers[0][1][0] == 3);
    optionals: [int:int?][] = [[:]];
    optionals[0][1] = 7;
    optionals[0][2] = nil;
    assert(optionals[0][1] != nil && optionals[0][2] == nil);
    booleans: [int:bool][] = [[:]];
    booleans[0][1] = true;
    assert(booleans[0][1]);
    wide: [int:f64][] = [[1:1.5]];
    wide[0][1] += 2.5;
    assert(wide[0][1] == 4.0);
    deeper: [int:[int:[int:string]]] = [1:[:]];
    deeper[1][2] = [3:text_from_bytes([u8(118), 97, 108, 117, 101])];
    old_deeper := deeper;
    deeper[1][2] = [4:"replacement"];
    delete deeper[1][2];
    assert(old_deeper[1][2][3] == "value" && !deeper[1].has(2));
    return 0;
}
