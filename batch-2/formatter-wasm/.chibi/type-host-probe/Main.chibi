package host_context_probe
import style "project:source_type_style"
Main :: () {
    source := "package host\n\nimport target \"core:target\"\n\n// The native Edit and Continue host loads live-0.so, calls Main once, and\n// calls Frame until its nonzero result ends the program. A next.so generation\n// replaces code between Frames. Named retained leaves migrate before the next\n// Frame; incompatible string/scalar changes reject the incoming generation.\n// Retired generations keep their code and state until their tasks finish.\n\nRetainedText: int : 12;\nRtldNow: i32 : 2;\nDarwinRtldLocal: i32 : 4;\nDarwinRtldFirst: i32 : 256;\nInvalidFileAttributes: u32 : 4294967295;\n\nforeign import kernel32 \"system:kernel32\"\nforeign kernel32 { GetFileAttributesA :: (path: cstring) -> u32 }\nforeign import libc \"system:c\"\nforeign libc {\n    dlopen :: (path: cstring, flags: i32) -> rawptr\n    dlsym :: (handle: rawptr, name: cstring) -> rawptr\n    dlclose :: (handle: rawptr) -> i32\n    rename :: (from: cstring, to: cstring) -> i32\n    unlink :: (path: cstring) -> i32\n    access :: (path: cstring, mode: i32) -> i32\n    usleep :: (microseconds: u32) -> i32\n}\n\nwhen target.Os == target.Windows {\n    import windows \"core:sys/windows\"\n    OpenGeneration :: (path: string) -> rawptr { return windows.OpenLibrary(path); }\n    Symbol :: (handle: rawptr, name: string) -> rawptr { return windows.LibrarySymbol(handle, name); }\n    CloseGeneration :: (handle: rawptr) -> bool { return windows.CloseLibrary(handle); }\n    MoveGeneration :: (from: string, to: string) -> bool { return windows.Rename(from, to); }\n    // All polling names are fixed ASCII protocol files. Avoid UTF conversion\n    // and allocation on every frame; dynamic image paths use LoadLibraryW.\n    HasNext :: () -> bool { return GetFileAttributesA(\"./next.so\") != InvalidFileAttributes; }\n    PauseFrame :: () -> bool { return windows.Pause(5); }\n    LoadedFile :: (path: string) -> bool { return true; }\n    RetiredFile :: (path: string) -> bool { return windows.Remove(path); }\n    ProcessArguments :: () -> rawptr { return 0; }\n} else {\n    // Darwin defaults to global symbol visibility. Look only in this image\n    // and keep its symbols private from the other generations.\n    when target.Os == target.Darwin {\n        OpenGeneration :: (path: string) -> rawptr {\n            return dlopen(path, RtldNow | DarwinRtldLocal | DarwinRtldFirst);\n        }\n    } else {\n        OpenGeneration :: (path: string) -> rawptr { return dlopen(path, RtldNow); }\n    }\n    Symbol :: (handle: rawptr, name: string) -> rawptr { return dlsym(handle, name); }\n    CloseGeneration :: (handle: rawptr) -> bool { return dlclose(handle) == 0; }\n    MoveGeneration :: (from: string, to: string) -> bool { return rename(from, to) == 0; }\n    HasNext :: () -> bool { return access(\"./next.so\", 0) == 0; }\n    PauseFrame :: () -> bool { return usleep(5000) == 0; }\n    LoadedFile :: (path: string) -> bool { return unlink(path) == 0; }\n    RetiredFile :: (path: string) -> bool { return true; }\n    ProcessArguments :: () -> rawptr { return chibi_process_argv(); }\n}\n\nforeign {\n    chibi_argument_count :: () -> i64\n    chibi_process_argv :: () -> rawptr\n    chibi_environment :: () -> rawptr\n}\n\n// Windows keeps a mapped DLL's file until its loader reference is released.\n// A retired generation owns both until its suspended tasks finish.\nGeneration :: struct { handle: rawptr; path: string; }\nDiscard :: (generation: Generation) -> int {\n    released := Release(generation.handle);\n    removed := RetiredFile(generation.path);\n    return 0;\n}\n\nMain :: () -> int {\n    active: Generation = {handle: OpenGeneration(\"./live-0.so\"), path: \"./live-0.so\"};\n    if active.handle == 0 {\n        return 2;\n    }\n    if !Complete(active.handle) {\n        released := Release(active.handle);\n        return 2;\n    }\n    initialized := Process(active.handle);\n    start: fn() -> i32 = Symbol(active.handle, \"chibi_host_call_Main\");\n    frame: fn() -> i32 = Symbol(active.handle, \"chibi_host_call_Frame\");\n    status := int(start());\n    if Failed(active.handle) {\n        status = 134;\n    }\n    generation := 0;\n    retired: Generation[] = [];\n    while status == 0 {\n        status = int(frame());\n        if Failed(active.handle) {\n            status = 134;\n        } else if status == 0 {\n            polled_active := Poll(active.handle);\n            if Failed(active.handle) {\n                status = 134;\n            }\n        }\n        if status != 0 {\n            break;\n        }\n        index := 0;\n        while index < length(retired) {\n            polled := Poll(retired[index].handle);\n            if Failed(retired[index].handle) {\n                status = 134;\n                break;\n            }\n            if Pending(retired[index].handle) {\n                index += 1;\n            } else {\n                released := Discard(retired[index]);\n                retired.remove_index(index);\n            }\n        }\n        if status != 0 {\n            break;\n        }\n        slept := PauseFrame();\n        if !HasNext() {\n            continue;\n        }\n        generation += 1;\n        name := format_text(\"./generation-{}.so\", generation);\n        moved := MoveGeneration(\"./next.so\", name);\n        if !moved {\n            continue;\n        }\n        incoming := OpenGeneration(name);\n        if incoming == 0 {\n            set_aside := MoveGeneration(name, \"./rejected.so\");\n            continue;\n        }\n        initialized_incoming := Process(incoming);\n        if !Complete(incoming) || !Migrate(active.handle, incoming) {\n            released := Release(incoming);\n            set_aside := MoveGeneration(name, \"./rejected.so\");\n            continue;\n        }\n        removed := LoadedFile(name);\n        next_frame: fn() -> i32 = Symbol(incoming, \"chibi_host_call_Frame\");\n        if Pending(active.handle) {\n            retired.append(active);\n        } else {\n            released := Discard(active);\n        }\n        active = {handle: incoming, path: name};\n        frame = next_frame;\n    }\n    released := Discard(active);\n    for previous in retired {\n        released_previous := Discard(previous);\n    }\n    return status;\n}\n\nProcess :: (handle: rawptr) -> int {\n    address := Symbol(handle, \"chibi_host_set_process\");\n    if address == 0 { return 0; }\n    initialize: fn(count: i64, arguments: rawptr, environment: rawptr) -> i32 = address;\n    return int(initialize(chibi_argument_count(), ProcessArguments(), chibi_environment()));\n}\n\nComplete :: (handle: rawptr) -> bool {\n    for symbol in [\"chibi_host_call_Main\", \"chibi_host_call_Frame\", \"chibi_host_retained_count\",\n                   \"chibi_host_retained_type\", \"chibi_host_retained_hash\", \"chibi_host_retained_get\",\n                   \"chibi_host_retained_set\", \"chibi_host_retained_set_as\"] {\n        if Symbol(handle, symbol) == 0 {\n            return false;\n        }\n    }\n    return true;\n}\n\nFailed :: (handle: rawptr) -> bool {\n    address := Symbol(handle, \"chibi_host_failed\");\n    if address == 0 {\n        return false;\n    }\n    failed: fn() -> i32 = address;\n    return failed() != 0;\n}\n\nPending :: (handle: rawptr) -> bool {\n    address := Symbol(handle, \"chibi_host_tasks_pending\");\n    if address == 0 {\n        return false;\n    }\n    count: fn() -> i64 = address;\n    return count() != 0;\n}\n\nPoll :: (handle: rawptr) -> int {\n    address := Symbol(handle, \"chibi_host_tasks_poll\");\n    if address != 0 {\n        poll: fn() -> i32 = address;\n        polled := poll();\n    }\n    return 0;\n}\n\nRelease :: (handle: rawptr) -> int {\n    cancel_address := Symbol(handle, \"chibi_host_tasks_cancel_all\");\n    if cancel_address != 0 {\n        cancel_tasks: fn() -> i32 = cancel_address;\n        cancelled := cancel_tasks();\n    }\n    release_address := Symbol(handle, \"chibi_host_retained_release\");\n    if release_address != 0 {\n        release_states: fn() -> i32 = release_address;\n        released := release_states();\n    }\n    closed := CloseGeneration(handle);\n    return 0;\n}\n\n// Stable indices into the old state table, ordered by name hash. Migration\n// sorts once and uses binary search, rather than comparing every pair of states.\nOrder :: (hashes: i64[]) -> int[] {\n    from: int[] = [];\n    for index in 0..<length(hashes) { from.append(index); }\n    to := from;\n    width := 1;\n    while width < length(from) {\n        start := 0;\n        while start < length(from) {\n            middle := start + width;\n            if middle > length(from) { middle = length(from); }\n            end := middle + width;\n            if end > length(from) { end = length(from); }\n            left := start;\n            right := middle;\n            for index in start..<end {\n                take_left := right == end || (left < middle && hashes[from[left]] <= hashes[from[right]]);\n                if take_left {\n                    to[index] = from[left];\n                    left += 1;\n                } else {\n                    to[index] = from[right];\n                    right += 1;\n                }\n            }\n            start = end;\n        }\n        from = to;\n        width *= 2;\n    }\n    return from;\n}\n\n// Validate every shared leaf before writing any incoming state. Scalar types\n// convert; strings require a string on both sides and copy their bytes before\n// the old generation can unload.\nMigrate :: (old: rawptr, incoming: rawptr) -> bool {\n    old_count: fn() -> i32 = Symbol(old, \"chibi_host_retained_count\");\n    old_type: fn(index: i32) -> i32 = Symbol(old, \"chibi_host_retained_type\");\n    old_hash: fn(index: i32) -> i64 = Symbol(old, \"chibi_host_retained_hash\");\n    old_get: fn(index: i32) -> i64 = Symbol(old, \"chibi_host_retained_get\");\n    ready_address := Symbol(old, \"chibi_host_retained_ready\");\n    new_count: fn() -> i32 = Symbol(incoming, \"chibi_host_retained_count\");\n    new_type: fn(index: i32) -> i32 = Symbol(incoming, \"chibi_host_retained_type\");\n    new_hash: fn(index: i32) -> i64 = Symbol(incoming, \"chibi_host_retained_hash\");\n    new_set: fn(index: i32, word: i64) -> i32 = Symbol(incoming, \"chibi_host_retained_set\");\n    new_set_as: fn(index: i32, from: i32, word: i64) -> i32 = Symbol(incoming, \"chibi_host_retained_set_as\");\n    hashes: i64[] = [];\n    for source in 0..<int(old_count()) { hashes.append(old_hash(i32(source))); }\n    order := Order(hashes);\n    sources: int[] = [];\n    for target in 0..<int(new_count()) {\n        wanted := new_hash(i32(target));\n        low := 0;\n        high := length(order);\n        while low < high {\n            middle := low + (high - low) / 2;\n            if hashes[order[middle]] < wanted { low = middle + 1; }\n            else { high = middle; }\n        }\n        source := -1;\n        if low < length(order) && hashes[order[low]] == wanted { source = order[low]; }\n        sources.append(source);\n        if source >= 0 && ((old_type(i32(source)) == RetainedText) != (new_type(i32(target)) == RetainedText)) {\n            return false;\n        }\n    }\n    for target in 0..<length(sources) {\n        source := sources[target];\n        if source < 0 { continue; }\n        if ready_address != 0 {\n            initialized: fn(index: i32) -> i32 = ready_address;\n            if initialized(i32(source)) == 0 { continue; }\n        }\n        if old_type(i32(source)) == new_type(i32(target)) {\n            carried := new_set(i32(target), old_get(i32(source)));\n        } else {\n            converted := new_set_as(i32(target), old_type(i32(source)), old_get(i32(source)));\n        }\n    }\n    return true;\n}\n";
    preferences := style.Defaults(); preferences.bindings = style.OmitRedundant;
    switch style.RewriteProjectWith(source, preferences, "/repo/apps/host", ["core", "graph"], ["/repo/packages/core", "/repo/tools/graph"], ["/repo/apps/host/Host.chibi", "/repo/packages/core/target/Target.chibi", "/repo/packages/core/sys/windows/Decimal.chibi", "/repo/packages/core/sys/windows/Windows.chibi", "/repo/packages/core/strings/Strings.chibi"], ["package host\n\nimport target \"core:target\"\n\n// The native Edit and Continue host loads live-0.so, calls Main once, and\n// calls Frame until its nonzero result ends the program. A next.so generation\n// replaces code between Frames. Named retained leaves migrate before the next\n// Frame; incompatible string/scalar changes reject the incoming generation.\n// Retired generations keep their code and state until their tasks finish.\n\nRetainedText: int : 12;\nRtldNow: i32 : 2;\nDarwinRtldLocal: i32 : 4;\nDarwinRtldFirst: i32 : 256;\nInvalidFileAttributes: u32 : 4294967295;\n\nforeign import kernel32 \"system:kernel32\"\nforeign kernel32 { GetFileAttributesA :: (path: cstring) -> u32 }\nforeign import libc \"system:c\"\nforeign libc {\n    dlopen :: (path: cstring, flags: i32) -> rawptr\n    dlsym :: (handle: rawptr, name: cstring) -> rawptr\n    dlclose :: (handle: rawptr) -> i32\n    rename :: (from: cstring, to: cstring) -> i32\n    unlink :: (path: cstring) -> i32\n    access :: (path: cstring, mode: i32) -> i32\n    usleep :: (microseconds: u32) -> i32\n}\n\nwhen target.Os == target.Windows {\n    import windows \"core:sys/windows\"\n    OpenGeneration :: (path: string) -> rawptr { return windows.OpenLibrary(path); }\n    Symbol :: (handle: rawptr, name: string) -> rawptr { return windows.LibrarySymbol(handle, name); }\n    CloseGeneration :: (handle: rawptr) -> bool { return windows.CloseLibrary(handle); }\n    MoveGeneration :: (from: string, to: string) -> bool { return windows.Rename(from, to); }\n    // All polling names are fixed ASCII protocol files. Avoid UTF conversion\n    // and allocation on every frame; dynamic image paths use LoadLibraryW.\n    HasNext :: () -> bool { return GetFileAttributesA(\"./next.so\") != InvalidFileAttributes; }\n    PauseFrame :: () -> bool { return windows.Pause(5); }\n    LoadedFile :: (path: string) -> bool { return true; }\n    RetiredFile :: (path: string) -> bool { return windows.Remove(path); }\n    ProcessArguments :: () -> rawptr { return 0; }\n} else {\n    // Darwin defaults to global symbol visibility. Look only in this image\n    // and keep its symbols private from the other generations.\n    when target.Os == target.Darwin {\n        OpenGeneration :: (path: string) -> rawptr {\n            return dlopen(path, RtldNow | DarwinRtldLocal | DarwinRtldFirst);\n        }\n    } else {\n        OpenGeneration :: (path: string) -> rawptr { return dlopen(path, RtldNow); }\n    }\n    Symbol :: (handle: rawptr, name: string) -> rawptr { return dlsym(handle, name); }\n    CloseGeneration :: (handle: rawptr) -> bool { return dlclose(handle) == 0; }\n    MoveGeneration :: (from: string, to: string) -> bool { return rename(from, to) == 0; }\n    HasNext :: () -> bool { return access(\"./next.so\", 0) == 0; }\n    PauseFrame :: () -> bool { return usleep(5000) == 0; }\n    LoadedFile :: (path: string) -> bool { return unlink(path) == 0; }\n    RetiredFile :: (path: string) -> bool { return true; }\n    ProcessArguments :: () -> rawptr { return chibi_process_argv(); }\n}\n\nforeign {\n    chibi_argument_count :: () -> i64\n    chibi_process_argv :: () -> rawptr\n    chibi_environment :: () -> rawptr\n}\n\n// Windows keeps a mapped DLL's file until its loader reference is released.\n// A retired generation owns both until its suspended tasks finish.\nGeneration :: struct { handle: rawptr; path: string; }\nDiscard :: (generation: Generation) -> int {\n    released := Release(generation.handle);\n    removed := RetiredFile(generation.path);\n    return 0;\n}\n\nMain :: () -> int {\n    active: Generation = {handle: OpenGeneration(\"./live-0.so\"), path: \"./live-0.so\"};\n    if active.handle == 0 {\n        return 2;\n    }\n    if !Complete(active.handle) {\n        released := Release(active.handle);\n        return 2;\n    }\n    initialized := Process(active.handle);\n    start: fn() -> i32 = Symbol(active.handle, \"chibi_host_call_Main\");\n    frame: fn() -> i32 = Symbol(active.handle, \"chibi_host_call_Frame\");\n    status := int(start());\n    if Failed(active.handle) {\n        status = 134;\n    }\n    generation := 0;\n    retired: Generation[] = [];\n    while status == 0 {\n        status = int(frame());\n        if Failed(active.handle) {\n            status = 134;\n        } else if status == 0 {\n            polled_active := Poll(active.handle);\n            if Failed(active.handle) {\n                status = 134;\n            }\n        }\n        if status != 0 {\n            break;\n        }\n        index := 0;\n        while index < length(retired) {\n            polled := Poll(retired[index].handle);\n            if Failed(retired[index].handle) {\n                status = 134;\n                break;\n            }\n            if Pending(retired[index].handle) {\n                index += 1;\n            } else {\n                released := Discard(retired[index]);\n                retired.remove_index(index);\n            }\n        }\n        if status != 0 {\n            break;\n        }\n        slept := PauseFrame();\n        if !HasNext() {\n            continue;\n        }\n        generation += 1;\n        name := format_text(\"./generation-{}.so\", generation);\n        moved := MoveGeneration(\"./next.so\", name);\n        if !moved {\n            continue;\n        }\n        incoming := OpenGeneration(name);\n        if incoming == 0 {\n            set_aside := MoveGeneration(name, \"./rejected.so\");\n            continue;\n        }\n        initialized_incoming := Process(incoming);\n        if !Complete(incoming) || !Migrate(active.handle, incoming) {\n            released := Release(incoming);\n            set_aside := MoveGeneration(name, \"./rejected.so\");\n            continue;\n        }\n        removed := LoadedFile(name);\n        next_frame: fn() -> i32 = Symbol(incoming, \"chibi_host_call_Frame\");\n        if Pending(active.handle) {\n            retired.append(active);\n        } else {\n            released := Discard(active);\n        }\n        active = {handle: incoming, path: name};\n        frame = next_frame;\n    }\n    released := Discard(active);\n    for previous in retired {\n        released_previous := Discard(previous);\n    }\n    return status;\n}\n\nProcess :: (handle: rawptr) -> int {\n    address := Symbol(handle, \"chibi_host_set_process\");\n    if address == 0 { return 0; }\n    initialize: fn(count: i64, arguments: rawptr, environment: rawptr) -> i32 = address;\n    return int(initialize(chibi_argument_count(), ProcessArguments(), chibi_environment()));\n}\n\nComplete :: (handle: rawptr) -> bool {\n    for symbol in [\"chibi_host_call_Main\", \"chibi_host_call_Frame\", \"chibi_host_retained_count\",\n                   \"chibi_host_retained_type\", \"chibi_host_retained_hash\", \"chibi_host_retained_get\",\n                   \"chibi_host_retained_set\", \"chibi_host_retained_set_as\"] {\n        if Symbol(handle, symbol) == 0 {\n            return false;\n        }\n    }\n    return true;\n}\n\nFailed :: (handle: rawptr) -> bool {\n    address := Symbol(handle, \"chibi_host_failed\");\n    if address == 0 {\n        return false;\n    }\n    failed: fn() -> i32 = address;\n    return failed() != 0;\n}\n\nPending :: (handle: rawptr) -> bool {\n    address := Symbol(handle, \"chibi_host_tasks_pending\");\n    if address == 0 {\n        return false;\n    }\n    count: fn() -> i64 = address;\n    return count() != 0;\n}\n\nPoll :: (handle: rawptr) -> int {\n    address := Symbol(handle, \"chibi_host_tasks_poll\");\n    if address != 0 {\n        poll: fn() -> i32 = address;\n        polled := poll();\n    }\n    return 0;\n}\n\nRelease :: (handle: rawptr) -> int {\n    cancel_address := Symbol(handle, \"chibi_host_tasks_cancel_all\");\n    if cancel_address != 0 {\n        cancel_tasks: fn() -> i32 = cancel_address;\n        cancelled := cancel_tasks();\n    }\n    release_address := Symbol(handle, \"chibi_host_retained_release\");\n    if release_address != 0 {\n        release_states: fn() -> i32 = release_address;\n        released := release_states();\n    }\n    closed := CloseGeneration(handle);\n    return 0;\n}\n\n// Stable indices into the old state table, ordered by name hash. Migration\n// sorts once and uses binary search, rather than comparing every pair of states.\nOrder :: (hashes: i64[]) -> int[] {\n    from: int[] = [];\n    for index in 0..<length(hashes) { from.append(index); }\n    to := from;\n    width := 1;\n    while width < length(from) {\n        start := 0;\n        while start < length(from) {\n            middle := start + width;\n            if middle > length(from) { middle = length(from); }\n            end := middle + width;\n            if end > length(from) { end = length(from); }\n            left := start;\n            right := middle;\n            for index in start..<end {\n                take_left := right == end || (left < middle && hashes[from[left]] <= hashes[from[right]]);\n                if take_left {\n                    to[index] = from[left];\n                    left += 1;\n                } else {\n                    to[index] = from[right];\n                    right += 1;\n                }\n            }\n            start = end;\n        }\n        from = to;\n        width *= 2;\n    }\n    return from;\n}\n\n// Validate every shared leaf before writing any incoming state. Scalar types\n// convert; strings require a string on both sides and copy their bytes before\n// the old generation can unload.\nMigrate :: (old: rawptr, incoming: rawptr) -> bool {\n    old_count: fn() -> i32 = Symbol(old, \"chibi_host_retained_count\");\n    old_type: fn(index: i32) -> i32 = Symbol(old, \"chibi_host_retained_type\");\n    old_hash: fn(index: i32) -> i64 = Symbol(old, \"chibi_host_retained_hash\");\n    old_get: fn(index: i32) -> i64 = Symbol(old, \"chibi_host_retained_get\");\n    ready_address := Symbol(old, \"chibi_host_retained_ready\");\n    new_count: fn() -> i32 = Symbol(incoming, \"chibi_host_retained_count\");\n    new_type: fn(index: i32) -> i32 = Symbol(incoming, \"chibi_host_retained_type\");\n    new_hash: fn(index: i32) -> i64 = Symbol(incoming, \"chibi_host_retained_hash\");\n    new_set: fn(index: i32, word: i64) -> i32 = Symbol(incoming, \"chibi_host_retained_set\");\n    new_set_as: fn(index: i32, from: i32, word: i64) -> i32 = Symbol(incoming, \"chibi_host_retained_set_as\");\n    hashes: i64[] = [];\n    for source in 0..<int(old_count()) { hashes.append(old_hash(i32(source))); }\n    order := Order(hashes);\n    sources: int[] = [];\n    for target in 0..<int(new_count()) {\n        wanted := new_hash(i32(target));\n        low := 0;\n        high := length(order);\n        while low < high {\n            middle := low + (high - low) / 2;\n            if hashes[order[middle]] < wanted { low = middle + 1; }\n            else { high = middle; }\n        }\n        source := -1;\n        if low < length(order) && hashes[order[low]] == wanted { source = order[low]; }\n        sources.append(source);\n        if source >= 0 && ((old_type(i32(source)) == RetainedText) != (new_type(i32(target)) == RetainedText)) {\n            return false;\n        }\n    }\n    for target in 0..<length(sources) {\n        source := sources[target];\n        if source < 0 { continue; }\n        if ready_address != 0 {\n            initialized: fn(index: i32) -> i32 = ready_address;\n            if initialized(i32(source)) == 0 { continue; }\n        }\n        if old_type(i32(source)) == new_type(i32(target)) {\n            carried := new_set(i32(target), old_get(i32(source)));\n        } else {\n            converted := new_set_as(i32(target), old_type(i32(source)), old_get(i32(source)));\n        }\n    }\n    return true;\n}\n", "package target\n\n// The platform a package compiles for, as constants. A compile that supplies a\n// platform replaces this file's text with the same declarations and its own\n// Os, Arch and PointerBits, so a package can select what depends on the target\n// with a `when` on them.\npub Linux: int : 1\npub Darwin: int : 2\npub Windows: int : 3\npub Web: int : 4\n\npub X86_64: int : 1\npub Arm64: int : 2\npub Wasm32: int : 3\n\npub Os: int : 0\npub Arch: int : 0\npub PointerBits: int : 0\n\n// 1 when the package compiles into a native program, 0 when it runs on the VM\n// (and in this file's own text), so a package can pick native code or the VM's\n// natives with a `when` on it.\npub Native: int : 0\n", "package windows\n\nimport strings \"core:strings\"\n\n// Win32 paths, stamps and process ownership records need only decimal words.\n// Keep these helpers independent of the general formatter and the C runtime.\nUnsignedDecimal :: (value: u64) -> string {\n    digits := resize([u8(0)], 20);\n    cursor := 20;\n    remaining := value;\n    while true {\n        cursor -= 1;\n        digits[cursor] = u8(remaining % 10) + u8(48);\n        remaining /= 10;\n        if remaining == 0 { break; }\n    }\n    return text_from_bytes(slice(digits, cursor, 20 - cursor));\n}\n\nSignedDecimal :: (value: i64) -> string {\n    magnitude := u64(wrap: value);\n    if value < 0 {\n        // Unsigned subtraction also handles the minimum signed word.\n        return strings.Concatenate([\"-\", UnsignedDecimal(u64(0) - magnitude)]);\n    }\n    return UnsignedDecimal(magnitude);\n}\n", "package windows\n\nimport strings \"core:strings\"\n\n// The Windows calls core:os needs, declared against kernel32 and called from\n// native programs; the VM never runs foreign code. It mirrors core:sys/posix:\n// the same names and shapes, so core:os picks one by `target.Os`.\n//\n// Paths and names are UTF-8 strings. The calls take UTF-16, so each string is\n// converted with MultiByteToWideChar and back with WideCharToMultiByte, which\n// keep Unicode paths. Each call borrows a NUL-terminated UTF-16 array. A call\n// that fails returns false (or -1, or an empty result); the error\n// code is not read yet. Arguments reads GetCommandLineW itself, so it works\n// with any start module.\n\nforeign import kernel32 \"system:kernel32\"\nforeign import bcrypt \"system:bcrypt\"\n\nforeign bcrypt {\n    BCryptGenRandom :: (algorithm: rawptr, buffer: u8[], size: u32, flags: u32) -> i32\n}\n\nforeign kernel32 {\n    MultiByteToWideChar :: (page: u32, flags: u32, text: u8[], length: i32, wide: u16[], size: i32) -> i32\n    WideCharToMultiByte :: (page: u32, flags: u32, wide: u16[], length: i32, text: u8[], size: i32, fallback: rawptr, used: rawptr) -> i32\n    GetFileAttributesW :: (path: u16[]) -> u32\n    CreateDirectoryW :: (path: u16[], security: rawptr) -> i32\n    DeleteFileW :: (path: u16[]) -> i32\n    RemoveDirectoryW :: (path: u16[]) -> i32\n    MoveFileExW :: (source: u16[], destination: u16[], flags: u32) -> i32\n    CreateFileW :: (path: u16[], access: u32, share: u32, security: rawptr, creation: u32, flags: u32, template: rawptr) -> u64\n    ReadFile :: (handle: u64, buffer: u8[], count: u32, read: u32[], overlapped: rawptr) -> i32\n    WriteFile :: (handle: u64, buffer: u8[], count: u32, written: u32[], overlapped: rawptr) -> i32\n    GetFileSizeEx :: (handle: u64, size: u8[]) -> i32\n    GetFileInformationByHandle :: (handle: u64, information: u8[]) -> i32\n    GetFileInformationByHandleEx :: (handle: u64, kind: i32, information: u8[], size: u32) -> i32\n    GetFinalPathNameByHandleW :: (handle: u64, path: u16[], size: u32, flags: u32) -> u32\n    GetCurrentDirectoryW :: (size: u32, path: u16[]) -> u32\n    SetCurrentDirectoryW :: (path: u16[]) -> i32\n    GetCurrentProcessId :: () -> u32\n    GetCurrentProcess :: () -> u64\n    GetProcessId :: (handle: u64) -> u32\n    GetProcessTimes :: (handle: u64, created: u8[], exited: u8[], kernel: u8[], user: u8[]) -> i32\n    GetTempPathW :: (size: u32, path: u16[]) -> u32\n    GetTempFileNameW :: (path: u16[], prefix: u16[], unique: u32, name: u16[]) -> u32\n    CopyFileW :: (source: u16[], destination: u16[], no_replace: i32) -> i32\n    CloseHandle :: (handle: u64) -> i32\n    GetEnvironmentVariableW :: (name: u16[], buffer: u16[], size: u32) -> u32\n    GetEnvironmentStringsW :: () -> rawptr\n    FreeEnvironmentStringsW :: (environment: rawptr) -> i32\n    CompareStringOrdinal :: (left: rawptr, left_size: i32, right: u16[], right_size: i32, ignore_case: i32) -> i32\n    FindFirstFileW :: (pattern: u16[], data: u16[]) -> u64\n    FindNextFileW :: (handle: u64, data: u16[]) -> i32\n    FindClose :: (handle: u64) -> i32\n    GetCommandLineW :: () -> rawptr\n    LoadLibraryW :: (path: u16[]) -> rawptr\n    GetProcAddress :: (module: rawptr, name: cstring) -> rawptr\n    FreeLibrary :: (module: rawptr) -> i32\n    lstrlenW :: (text: rawptr) -> i32\n    RtlMoveMemory :: (destination: u16[], source: rawptr, length: u64) -> i32\n    GetStdHandle :: (which: i32) -> u64\n    ExitProcess :: (code: u32) -> u32\n    SetHandleInformation :: (handle: u64, mask: u32, flags: u32) -> i32\n    CreatePipe :: (read: u64[], write: u64[], security: u8[], size: u32) -> i32\n    PeekNamedPipe :: (pipe: u64, buffer: rawptr, size: u32, read: rawptr, available: u32[], left: rawptr) -> i32\n    CreateProcessW :: (application: rawptr, command: u16[], process: rawptr, thread: rawptr, inherit: i32, flags: u32, environment: rawptr, directory: rawptr, startup: u8[], information: u8[]) -> i32\n    WaitForSingleObject :: (handle: u64, milliseconds: u32) -> u32\n    GetExitCodeProcess :: (handle: u64, code: u32[]) -> i32\n    CreateJobObjectW :: (security: rawptr, name: rawptr) -> u64\n    AssignProcessToJobObject :: (job: u64, process: u64) -> i32\n    TerminateJobObject :: (job: u64, code: u32) -> i32\n    TerminateProcess :: (process: u64, code: u32) -> i32\n    ResumeThread :: (thread: u64) -> u32\n    GetLastError :: () -> u32\n}\n\npub KindNone: int : 0;\npub KindFile: int : 1;\npub KindDirectory: int : 2;\npub KindLink: int : 3;\npub KindOther: int : 4;\n\nUtf8: u32 : 65001;\nInvalidAttributes: u32 : 4294967295;\nDirectoryAttribute: u32 : 16;\nLinkAttribute: u32 : 1024;\nReadAccess: u32 : 2147483648;\nWriteAccess: u32 : 1073741824;\nShareAll: u32 : 7;\nShareDelete: u32 : 4;\nCreateAlways: u32 : 2;\nOpenExisting: u32 : 3;\nReplaceExisting: u32 : 1;\nReadChunk: int : 65536;\nFindDataUnits: int : 296;\nFindNameUnit: int : 22;\nFindNameUnits: int : 260;\nInfinite: u32 : 4294967295;\nUseStandardHandles: u32 : 256;\nBackupSemantics: u32 : 33554432;\nReadOnlyAttribute: u32 : 1;\nFileBasicInfo: i32 : 0;\nFileInformationBytes: int : 52;\nFileBasicBytes: int : 40;\nFileTimeTicks: i64 : 10000000;\nFileTimeEpochSeconds: i64 : 11644473600;\nSlash: int : 47;\nBackslash: int : 92;\nCreateNew: u32 : 1;\nCreateSuspended: u32 : 4;\nNewProcessGroup: u32 : 512;\nKilledExit: u32 : 4294967287; // The DWORD representation of exit status -9.\nWaitTimeout: u32 : 258;\nMaxPathUnits: int : 260;\nSystemPreferredRng: u32 : 2;\nOrdinalEqual: i32 : 2;\n\n// A zeroed block for a structure the program only passes along.\nBlock :: (size: int) -> u8[] {\n    block: u8[] = [];\n    for index in 0..<size {\n        block.append(0);\n    }\n    return block;\n}\n\n// The UTF-16 units of `text` and a terminating NUL.\nWide :: (text: string) -> u16[] {\n    // Counted Win32 text must not pass through the foreign CString's 4 KiB\n    // bound: complete linker command lines can contain many Unicode paths.\n    bytes := Block(text_byte_length(text) + 1);\n    for index in 0..<text_byte_length(text) {\n        byte := text_byte_at(text, index);\n        assert(byte != 0, \"the string contains no NUL\");\n        bytes[index] = u8(byte);\n    }\n    wide: u16[] = [];\n    size := MultiByteToWideChar(Utf8, 0, bytes, i32(length(bytes)), wide, 0);\n    for index in 0..<int(size) {\n        wide.append(0);\n    }\n    converted := MultiByteToWideChar(Utf8, 0, bytes, i32(length(bytes)), wide, size);\n    assert(converted == size, \"the string converts\");\n    return wide;\n}\n\n// A successful open owns one loader reference. Symbol addresses stay valid\n// until the matching CloseLibrary; a failed open or lookup returns null.\npub OpenLibrary :: (path: string) -> rawptr {\n    return LoadLibraryW(Wide(path));\n}\npub LibrarySymbol :: (module: rawptr, name: string) -> rawptr {\n    return GetProcAddress(module, name);\n}\npub CloseLibrary :: (module: rawptr) -> bool {\n    return FreeLibrary(module) != 0;\n}\n\n// The current process cannot signal while this call runs. Its pseudo-handle\n// is borrowed, so pausing needs no owned handle, timer or per-call allocation.\npub Pause :: (milliseconds: int) -> bool {\n    if (milliseconds < 0) { return false; }\n    return WaitForSingleObject(GetCurrentProcess(), u32(milliseconds)) == WaitTimeout;\n}\n\n// The text of the first `count` UTF-16 units of `wide`.\nNarrow :: (wide: u16[], count: int) -> string {\n    if count == 0 {\n        return \"\";\n    }\n    none: u8[] = [];\n    size := WideCharToMultiByte(Utf8, 0, wide, i32(count), none, 0, 0, 0);\n    buffer := Block(int(size));\n    converted := WideCharToMultiByte(Utf8, 0, wide, i32(count), buffer, size, 0, 0);\n    return text_from_bytes(buffer);\n}\n\n// The attribute bits of the path, InvalidAttributes when it does not exist.\nAttributes :: (path: string) -> u32 {\n    return GetFileAttributesW(Wide(path));\n}\n\n// Whether the path names anything.\npub Exists :: (path: string) -> bool {\n    return Attributes(path) != InvalidAttributes;\n}\n\n// What the path names, KindNone when nothing. A link is not followed.\npub Kind :: (path: string) -> int {\n    attributes := Attributes(path);\n    if attributes == InvalidAttributes {\n        return KindNone;\n    }\n    if (attributes & LinkAttribute) != 0 {\n        return KindLink;\n    }\n    if (attributes & DirectoryAttribute) != 0 {\n        return KindDirectory;\n    }\n    return KindFile;\n}\n\npub MakeDirectory :: (path: string) -> bool {\n    for index in 1..<text_byte_length(path) {\n        byte := text_byte_at(path, index);\n        if byte == Slash || byte == Backslash {\n            made := CreateDirectoryW(Wide(text_slice(path, 0, index)), 0);\n        }\n    }\n    made := CreateDirectoryW(Wide(path), 0);\n    attributes := Attributes(path);\n    return attributes != InvalidAttributes && (attributes & DirectoryAttribute) != 0;\n}\n\n// Removes a file or link, or an empty directory.\npub Remove :: (path: string) -> bool {\n    kind := Kind(path);\n    if kind == KindNone {\n        return true;\n    }\n    if kind == KindDirectory || (kind == KindLink && (Attributes(path) & DirectoryAttribute) != 0) {\n        return RemoveDirectoryW(Wide(path)) != 0;\n    }\n    return DeleteFileW(Wide(path)) != 0;\n}\n\n// Renames, replacing an existing destination as rename does elsewhere.\npub Rename :: (source: string, destination: string) -> bool {\n    return MoveFileExW(Wide(source), Wide(destination), ReplaceExisting) != 0;\n}\n\n// The file's size in bytes, -1 when it cannot be opened.\npub FileSize :: (path: string) -> int {\n    handle := CreateFileW(Wide(path), ReadAccess, ShareAll, 0, OpenExisting, 0, 0);\n    if ~handle == 0 {\n        return -1;\n    }\n    size := Block(8);\n    found := GetFileSizeEx(handle, size);\n    closed := CloseHandle(handle);\n    if found == 0 {\n        return -1;\n    }\n    total := 0;\n    for index in 0..<8 {\n        total += int(size[index]) << u32(8 * index);\n    }\n    return total;\n}\n\n// The file's bytes, including NUL and malformed UTF-8; no bytes when it cannot\n// be read (FileSize tells that from an empty file).\npub ReadBytes :: (path: string) -> u8[] {\n    contents: u8[] = [];\n    handle := CreateFileW(Wide(path), ReadAccess, ShareAll, 0, OpenExisting, 0, 0);\n    if ~handle == 0 {\n        return contents;\n    }\n    chunk := Block(ReadChunk);\n    read: u32[] = [0];\n    while true {\n        if ReadFile(handle, chunk, u32(ReadChunk), read, 0) == 0 {\n            contents = [];\n            break;\n        }\n        count := int(read[0]);\n        if count == 0 {\n            break;\n        }\n        for index in 0..<count {\n            contents.append(chunk[index]);\n        }\n    }\n    closed := CloseHandle(handle);\n    return contents;\n}\n\n// Replaces the file with the bytes; false when it cannot be written whole.\npub WriteBytes :: (path: string, data: u8[]) -> bool {\n    handle := CreateFileW(Wide(path), WriteAccess, ShareAll, 0, CreateAlways, 0, 0);\n    if ~handle == 0 {\n        return false;\n    }\n    written: u32[] = [0];\n    done := true;\n    if length(data) > 0 {\n        done = WriteFile(handle, data, u32(length(data)), written, 0) != 0 && int(written[0]) == length(data);\n    }\n    closed := CloseHandle(handle);\n    return done && closed != 0;\n}\n\n// The bytes of the text, a copy.\nBytes :: (text: string) -> u8[] {\n    data: u8[] = [];\n    size := text_byte_length(text);\n    for index in 0..<size {\n        data.append(u8(text_byte_at(text, index)));\n    }\n    return data;\n}\n\n// Writes the line and a newline to standard error, as build reports do; false\n// when it cannot be written whole.\npub Print :: (line: string) -> bool {\n    data := Bytes(line);\n    data.append(10);\n    written: u32[] = [0];\n    done := WriteFile(GetStdHandle(-12), data, u32(length(data)), written, 0);\n    return done != 0 && int(written[0]) == length(data);\n}\n\n// Writes the text to standard output without a newline.\npub WriteOutput :: (text: string) -> bool {\n    data := Bytes(text);\n    written: u32[] = [0];\n    offset := 0;\n    while (offset < length(data)) {\n        rest := data;\n        if (offset != 0) {\n            rest = slice(data, offset, length(data) - offset);\n        }\n        done := WriteFile(GetStdHandle(-11), rest, u32(length(rest)), written, 0);\n        if (done == 0 || written[0] == 0) {\n            return false;\n        }\n        offset += int(written[0]);\n    }\n    return true;\n}\n\n// Replaces the file with the text; false when it cannot be written whole.\npub WriteText :: (path: string, text: string) -> bool {\n    return WriteBytes(path, Bytes(text));\n}\n\npub IsFile :: (path: string) -> bool {\n    return Kind(path) == KindFile;\n}\n\npub IsDirectory :: (path: string) -> bool {\n    return Kind(path) == KindDirectory;\n}\n\n// Ends the process with the exit status; it does not return.\npub Exit :: (code: int) -> int {\n    return int(ExitProcess(u32(code)));\n}\n\n// The text of the bytes, which may hold NUL and malformed UTF-8.\npub Text :: (data: u8[]) -> string {\n    return text_from_bytes(data);\n}\n\n// The file's text, \"\" when it cannot be read.\npub ReadText :: (path: string) -> string {\n    return text_from_bytes(ReadBytes(path));\n}\n\n// Inspect an owned OS snapshot so an empty value differs from a missing name,\n// without relying on GetEnvironmentVariable's ambiguous zero/last-error state.\npub HasEnv :: (name: string) -> bool {\n    if name == \"\" { return false; }\n    environment := GetEnvironmentStringsW();\n    if environment == 0 { return false; }\n    wanted := Wide(strings.Concatenate([name, \"=\"]));\n    size := length(wanted) - 1;\n    cursor := u64(environment);\n    found := false;\n    while true {\n        count := lstrlenW(cursor);\n        if count == 0 { break; }\n        if count >= size && CompareStringOrdinal(cursor, i32(size), wanted, i32(size), 1) == OrdinalEqual {\n            found = true;\n            break;\n        }\n        cursor += u64(count + 1) * 2;\n    }\n    freed := FreeEnvironmentStringsW(environment);\n    return found;\n}\n\n// The environment variable's value, \"\" when it is unset or empty.\npub Getenv :: (name: string) -> string {\n    none: u16[] = [];\n    wide := Wide(name);\n    size := GetEnvironmentVariableW(wide, none, 0);\n    if size == 0 {\n        return \"\";\n    }\n    buffer: u16[] = [];\n    for index in 0..<int(size) {\n        buffer.append(0);\n    }\n    count := GetEnvironmentVariableW(wide, buffer, size);\n    return Narrow(buffer, int(count));\n}\n\n// The names in the directory, in the order the system gives them and without\n// \".\" and \"..\". Empty when it cannot be opened (Kind tells a missing directory\n// from an empty one).\npub List :: (path: string) -> string[] {\n    names: string[] = [];\n    data: u16[] = [];\n    for index in 0..<FindDataUnits {\n        data.append(0);\n    }\n    pattern := Wide(path);\n    pattern[length(pattern) - 1] = 92;\n    pattern.append(42);\n    pattern.append(0);\n    handle := FindFirstFileW(pattern, data);\n    if ~handle == 0 {\n        return names;\n    }\n    more := true;\n    while more {\n        count := 0;\n        while count < FindNameUnits && data[FindNameUnit + count] != 0 {\n            count += 1;\n        }\n        name: u16[] = [];\n        for index in 0..<count {\n            name.append(data[FindNameUnit + index]);\n        }\n        text := Narrow(name, count);\n        if text != \".\" && text != \"..\" {\n            names.append(text);\n        }\n        more = FindNextFileW(handle, data) != 0;\n    }\n    closed := FindClose(handle);\n    return names;\n}\n\n// The program's arguments, the first being how it was started, split from the\n// command line by the C runtime's rules: spaces and tabs separate them outside\n// quotes, a quote toggles quoting, 2n backslashes before a quote are n\n// backslashes and a toggle, 2n+1 are n backslashes and a literal quote. The\n// program name keeps its backslashes.\npub Arguments :: () -> string[] {\n    source := GetCommandLineW();\n    size := int(lstrlenW(source));\n    wide: u16[] = [];\n    for index in 0..<size {\n        wide.append(0);\n    }\n    moved := RtlMoveMemory(wide, source, u64(size) * 2);\n    return Split(Narrow(wide, size));\n}\n\n// The arguments of the command line `line`.\npub Split :: (line: string) -> string[] {\n    arguments: string[] = [];\n    size := text_byte_length(line);\n    at := 0;\n    first := true;\n    while at < size {\n        while at < size && (text_byte_at(line, at) == 32 || text_byte_at(line, at) == 9) {\n            at += 1;\n        }\n        if at >= size {\n            break;\n        }\n        current: u8[] = [];\n        quoted := false;\n        while at < size {\n            byte := text_byte_at(line, at);\n            if !quoted && (byte == 32 || byte == 9) {\n                break;\n            }\n            if byte == 92 && !first {\n                slashes := 0;\n                while at < size && text_byte_at(line, at) == 92 {\n                    slashes += 1;\n                    at += 1;\n                }\n                if at < size && text_byte_at(line, at) == 34 {\n                    for index in 0..<(slashes / 2) {\n                        current.append(92);\n                    }\n                    if slashes % 2 == 1 {\n                        current.append(34);\n                        at += 1;\n                    }\n                } else {\n                    for index in 0..<slashes {\n                        current.append(92);\n                    }\n                }\n                continue;\n            }\n            if byte == 34 {\n                quoted = !quoted;\n                at += 1;\n                continue;\n            }\n            current.append(u8(byte));\n            at += 1;\n        }\n        first = false;\n        arguments.append(text_from_bytes(current));\n    }\n    return arguments;\n}\n\n// A finished child process: its exit status (-1 when it could not be waited\n// for, 127 when the program could not be started) and, for Capture, what it\n// wrote.\npub Output :: struct {\n    status: int;\n    stdout: string;\n    stderr: string;\n}\n\n// The argument quoted for a command line, by the C runtime's rules: an argument\n// with a space, tab or quote, or an empty one, is quoted; backslashes before a\n// quote, and at the end of a quoted argument, are doubled.\nQuoted :: (argument: string) -> u8[] {\n    out: u8[] = [];\n    size := text_byte_length(argument);\n    bare := size > 0;\n    for index in 0..<size {\n        byte := text_byte_at(argument, index);\n        if byte == 32 || byte == 9 || byte == 34 {\n            bare = false;\n        }\n    }\n    if bare {\n        for index in 0..<size {\n            out.append(u8(text_byte_at(argument, index)));\n        }\n        return out;\n    }\n    out.append(34);\n    slashes := 0;\n    for index in 0..<size {\n        byte := text_byte_at(argument, index);\n        if byte == 92 {\n            slashes += 1;\n            continue;\n        }\n        if byte == 34 {\n            for each in 0..<(slashes * 2 + 1) {\n                out.append(92);\n            }\n            out.append(34);\n            slashes = 0;\n            continue;\n        }\n        for each in 0..<slashes {\n            out.append(92);\n        }\n        slashes = 0;\n        out.append(u8(byte));\n    }\n    for each in 0..<(slashes * 2) {\n        out.append(92);\n    }\n    out.append(34);\n    return out;\n}\n\n// The command line of the command's arguments, separated by spaces.\nCommandLine :: (command: string[]) -> string {\n    line: u8[] = [];\n    for argument in command {\n        if length(line) > 0 {\n            line.append(32);\n        }\n        line.extend(Quoted(argument));\n    }\n    return text_from_bytes(line);\n}\n\n// A SECURITY_ATTRIBUTES whose handles a child inherits.\nInheritable :: () -> u8[] {\n    attributes := Block(24);\n    attributes[0] = 24;\n    attributes[16] = 1;\n    return attributes;\n}\n\n// The 64-bit integer at `at` in `bytes`, little endian.\nWord64 :: (bytes: u8[], at: int) -> u64 {\n    value: u64 = 0;\n    for index in 0..<8 {\n        value = value | (u64(bytes[at + index]) << u32(8 * index));\n    }\n    return value;\n}\n\n// The bytes with the 64-bit integer stored at `at`, little endian. Arrays are\n// values, so the caller keeps what this returns.\nPut64 :: (bytes: u8[], at: int, value: u64) -> u8[] {\n    changed := bytes;\n    for index in 0..<8 {\n        changed[at + index] = u8((value >> u32(8 * index)) & 255);\n    }\n    return changed;\n}\n\n// A standard handle made inheritable, or 0 when this process has none, so a\n// child can be given it.\nShared :: (handle: u64) -> u64 {\n    if handle == 0 || ~handle == 0 {\n        return 0;\n    }\n    marked := SetHandleInformation(handle, 1, 1);\n    if marked == 0 {\n        return 0;\n    }\n    return handle;\n}\n\n// The PROCESS_INFORMATION of a new child, empty when CreateProcessW fails.\nLaunch :: (command: string[], input: u64, output: u64, errors: u64, flags: u32) -> u8[] {\n    if length(command) == 0 {\n        empty: u8[] = [];\n        return empty;\n    }\n    startup := Block(104);\n    startup[0] = 104;\n    startup[61] = 1;\n    startup = Put64(startup, 80, input);\n    startup = Put64(startup, 88, output);\n    startup = Put64(startup, 96, errors);\n    information := Block(24);\n    started := CreateProcessW(0, Wide(CommandLine(command)), 0, 0, 1, flags, 0, 0, startup, information);\n    if started == 0 {\n        empty: u8[] = [];\n        return empty;\n    }\n    return information;\n}\n\n// The synchronous callers do not need the child's initial thread handle.\nCreate :: (command: string[], input: u64, output: u64, errors: u64) -> int {\n    information := Launch(command, input, output, errors, 0);\n    if length(information) == 0 {\n        return -1;\n    }\n    thread := Word64(information, 8);\n    closed := CloseHandle(thread);\n    return int(Word64(information, 0));\n}\n\n// Starts the program with the command's arguments, keeping this process's\n// standard streams, and returns its process handle; -1 when it cannot be\n// started.\npub Spawn :: (command: string[]) -> int {\n    return Create(command, Shared(GetStdHandle(-10)), Shared(GetStdHandle(-11)), Shared(GetStdHandle(-12)));\n}\n\n// Waits for the process, closes its handle and returns its exit status.\npub Wait :: (process: int) -> int {\n    waited := WaitForSingleObject(u64(process), Infinite);\n    code: u32[] = [0];\n    found := GetExitCodeProcess(u64(process), code);\n    closed := CloseHandle(u64(process));\n    if waited != 0 || found == 0 {\n        return -1;\n    }\n    return int(code[0]);\n}\n\n// Runs the program, keeping the standard streams, and returns its exit status;\n// 127 when it cannot be started.\npub Run :: (command: string[]) -> int {\n    process := Spawn(command);\n    if process < 0 {\n        return 127;\n    }\n    return Wait(process);\n}\n\n// How many bytes are waiting in the pipe; -1 once it is closed or broken.\nWaiting :: (pipe: u64) -> int {\n    available: u32[] = [0];\n    if PeekNamedPipe(pipe, 0, 0, 0, available, 0) == 0 {\n        return -1;\n    }\n    return int(available[0]);\n}\n\n// Up to `count` of the bytes waiting in the pipe.\nTake :: (pipe: u64, count: int) -> u8[] {\n    wanted := count;\n    if wanted > 4096 {\n        wanted = 4096;\n    }\n    chunk := Block(wanted);\n    read: u32[] = [0];\n    taken: u8[] = [];\n    if ReadFile(pipe, chunk, u32(wanted), read, 0) != 0 {\n        for index in 0..<int(read[0]) {\n            taken.append(chunk[index]);\n        }\n    }\n    return taken;\n}\n\n// Runs the program with its standard output and error read into the result.\n// Both pipes are read together, so a child filling one cannot stop on the other.\npub Capture :: (command: string[]) -> Output {\n    result: Output = {status: 127, stdout: \"\", stderr: \"\"};\n    if length(command) == 0 {\n        return result;\n    }\n    out_read: u64[] = [0];\n    out_write: u64[] = [0];\n    err_read: u64[] = [0];\n    err_write: u64[] = [0];\n    made := CreatePipe(out_read, out_write, Inheritable(), 0);\n    made = made * CreatePipe(err_read, err_write, Inheritable(), 0);\n    if made == 0 {\n        return result;\n    }\n    process := Create(command, Shared(GetStdHandle(-10)), out_write[0], err_write[0]);\n    closed := CloseHandle(out_write[0]);\n    closed = CloseHandle(err_write[0]);\n    standard: u8[] = [];\n    errors: u8[] = [];\n    if process >= 0 {\n        open_out := true;\n        open_err := true;\n        while open_out || open_err {\n            before := length(standard) + length(errors);\n            if open_out {\n                waiting := Waiting(out_read[0]);\n                if waiting < 0 {\n                    open_out = false;\n                } else if waiting > 0 {\n                    standard.extend(Take(out_read[0], waiting));\n                }\n            }\n            if open_err {\n                waiting := Waiting(err_read[0]);\n                if waiting < 0 {\n                    open_err = false;\n                } else if waiting > 0 {\n                    errors.extend(Take(err_read[0], waiting));\n                }\n            }\n            if length(standard) + length(errors) == before && (open_out || open_err) {\n                // Nothing waiting: let the child run for a moment.\n                waited := WaitForSingleObject(u64(process), 10);\n            }\n        }\n        result.status = Wait(process);\n    }\n    closed = CloseHandle(out_read[0]);\n    closed = CloseHandle(err_read[0]);\n    result.stdout = text_from_bytes(standard);\n    result.stderr = text_from_bytes(errors);\n    return result;\n}\n\npub Platform :: () -> string {\n    return \"Windows\";\n}\n\n// The unsigned DWORD at the Win32 structure's byte offset.\nWord32 :: (bytes: u8[], at: int) -> u64 {\n    value: u64 = 0;\n    for index in 0..<4 {\n        value = value | (u64(bytes[at + index]) << u32(8 * index));\n    }\n    return value;\n}\n\n// FILETIME's 100 ns ticks since 1601, as Unix seconds.nanoseconds. No access\n// time enters a stamp, so reading or hashing a file leaves its stamp alone.\nFileTime :: (ticks: u64) -> string {\n    nanoseconds := SignedDecimal((i64(ticks) % FileTimeTicks) * 100);\n    while text_byte_length(nanoseconds) < 9 {\n        nanoseconds = strings.Concatenate([\"0\", nanoseconds]);\n    }\n    return strings.Concatenate([SignedDecimal(i64(ticks) / FileTimeTicks - FileTimeEpochSeconds), \".\", nanoseconds]);\n}\n\n// Same fields as POSIX stamps: volume:file-id:size:mode:modified:changed.\n// Identity and size come from BY_HANDLE_FILE_INFORMATION. FILE_BASIC_INFO\n// supplies the metadata change time, which LastWriteTime alone misses.\n// These are metadata, not a content hash: two writes within the filesystem's\n// timestamp resolution may keep the same stamp when their sizes match.\npub Stamp :: (path: string) -> string {\n    handle := CreateFileW(Wide(path), 0, ShareAll, 0, OpenExisting, BackupSemantics, 0);\n    if ~handle == 0 {\n        return \"\";\n    }\n    information := Block(FileInformationBytes);\n    basic := Block(FileBasicBytes);\n    found := GetFileInformationByHandle(handle, information);\n    changed := GetFileInformationByHandleEx(handle, FileBasicInfo, basic, u32(FileBasicBytes));\n    closed := CloseHandle(handle);\n    if found == 0 || changed == 0 || closed == 0 {\n        return \"\";\n    }\n    identity := (Word32(information, 44) << u32(32)) | Word32(information, 48);\n    size := (Word32(information, 32) << u32(32)) | Word32(information, 36);\n    attributes := u32(Word32(information, 0));\n    mode := \"100666\";\n    if (attributes & DirectoryAttribute) != 0 {\n        mode = \"40777\";\n    }\n    if (attributes & ReadOnlyAttribute) != 0 {\n        mode = \"100444\";\n        if (attributes & DirectoryAttribute) != 0 {\n            mode = \"40555\";\n        }\n    }\n    return strings.Concatenate([UnsignedDecimal(Word32(information, 28)), \":\", UnsignedDecimal(identity), \":\",\n                                UnsignedDecimal(size), \":\", mode, \":\", FileTime(Word64(basic, 16)), \":\", FileTime(Word64(basic, 24))]);\n}\n\n// The kernel copies into a private directory beside the destination, then\n// renames the complete file. A failed copy leaves the old destination intact.\npub Copy :: (source: string, destination: string) -> bool {\n    attributes := Attributes(source);\n    if attributes == InvalidAttributes || (attributes & DirectoryAttribute) != 0 {\n        return false;\n    }\n    work := strings.Concatenate([destination, \".copy-\", SignedDecimal(i64(int(GetCurrentProcessId())))]);\n    if !Reserve(work) {\n        return false;\n    }\n    temporary := strings.Concatenate([work, \"/file\"]);\n    copied := CopyFileW(Wide(source), Wide(temporary), 1) != 0;\n    if copied {\n        copied = Rename(temporary, destination);\n    }\n    removed := Remove(temporary);\n    closed := Remove(work);\n    return copied && removed && closed;\n}\n\n// A 128-bit system nonce avoids a shared counter or a tempfile-to-directory\n// conversion window. Exclusive creation never replaces somebody else's path.\npub TemporaryDirectory :: (parent: string) -> string {\n    random := Block(16);\n    if BCryptGenRandom(0, random, 16, SystemPreferredRng) != 0 {\n        return \"\";\n    }\n    hexadecimal := \"0123456789abcdef\";\n    name := Block(32);\n    for index in 0..<16 {\n        name[2 * index] = u8(text_byte_at(hexadecimal, int(random[index] >> 4)));\n        name[2 * index + 1] = u8(text_byte_at(hexadecimal, int(random[index] & 15)));\n    }\n    path := strings.Concatenate([parent, \"/work-\", text_from_bytes(name)]);\n    if !Reserve(path) {\n        return \"\";\n    }\n    return path;\n}\n\n// CreateDirectoryW refuses every existing path, unlike MakeDirectory.\npub Reserve :: (path: string) -> bool {\n    return CreateDirectoryW(Wide(path), 0) != 0;\n}\n\n// Without MOVEFILE_REPLACE_EXISTING, the kernel rejects every occupied name,\n// including an empty directory. No check-then-rename race can replace one.\npub Publish :: (source: string, destination: string) -> bool {\n    if Kind(source) != KindDirectory {\n        return false;\n    }\n    return MoveFileExW(Wide(source), Wide(destination), 0) != 0;\n}\n\npub RealPath :: (path: string) -> string {\n    handle := CreateFileW(Wide(path), 0, ShareAll, 0, OpenExisting, BackupSemantics, 0);\n    if ~handle == 0 {\n        return \"\";\n    }\n    none: u16[] = [];\n    size := GetFinalPathNameByHandleW(handle, none, 0, 0);\n    if size == 0 {\n        closed := CloseHandle(handle);\n        return \"\";\n    }\n    buffer := resize([u16(0)], int(size) + 1);\n    count := GetFinalPathNameByHandleW(handle, buffer, u32(length(buffer)), 0);\n    closed := CloseHandle(handle);\n    if count == 0 || int(count) >= length(buffer) || closed == 0 {\n        return \"\";\n    }\n    normalized := strings.ReplaceAll(Narrow(buffer, int(count)), \"\\\\\", \"/\");\n    if strings.HasPrefix(normalized, \"//?/UNC/\") {\n        return strings.Concatenate([\"//\", strings.TrimPrefix(normalized, \"//?/UNC/\")]);\n    }\n    return strings.TrimPrefix(normalized, \"//?/\");\n}\n\npub ChangeDirectory :: (path: string) -> bool {\n    converted := Wide(path);\n    return length(converted) > 0 && SetCurrentDirectoryW(converted) != 0;\n}\n\npub Root :: () -> string {\n    none: u16[] = [];\n    size := GetCurrentDirectoryW(0, none);\n    if size == 0 {\n        return \"\";\n    }\n    buffer := resize([u16(0)], int(size));\n    count := GetCurrentDirectoryW(size, buffer);\n    if count == 0 || count >= size {\n        return \"\";\n    }\n    return strings.ReplaceAll(Narrow(buffer, int(count)), \"\\\\\", \"/\");\n}\n\n// Look only on PATH, or use a name containing a directory as supplied. Windows\n// native programs use .exe or .com; command scripts require an explicit shell.\npub FindExecutable :: (name: string) -> string {\n    if name == \"\" {\n        return \"\";\n    }\n    directories := strings.Split(Getenv(\"PATH\"), \";\");\n    explicit := strings.ContainsAny(name, \"/\\\\:\");\n    if explicit {\n        directories = [\"\"];\n    }\n    for directory in directories {\n        folder := strings.Trim(directory, \"\\\"\");\n        candidate := name;\n        if !explicit {\n            if folder == \"\" {\n                folder = \".\";\n            }\n            candidate = strings.Concatenate([folder, \"/\", name]);\n        }\n        for suffix in [\"\", \".exe\", \".com\"] {\n            path := strings.Concatenate([candidate, suffix]);\n            attributes := Attributes(path);\n            if attributes != InvalidAttributes && (attributes & DirectoryAttribute) == 0 {\n                return path;\n            }\n        }\n    }\n    return \"\";\n}\n\npub StillRunning: int : 65536;\n\n// A parent's creation time isolates its ownership files from recycled PIDs.\n// Each file holds a PID and the parent's opaque OS job descriptor, never a\n// Chibi memory pointer. It is only read by this process while claiming a child.\nProcessIdentity :: () -> string {\n    created := Block(8);\n    exited := Block(8);\n    kernel := Block(8);\n    user := Block(8);\n    if GetProcessTimes(GetCurrentProcess(), created, exited, kernel, user) == 0 {\n        return \"\";\n    }\n    return strings.Concatenate([\"chibi-\", UnsignedDecimal(u64(GetCurrentProcessId())), \"-\", UnsignedDecimal(Word64(created, 0))]);\n}\n\nProcessFolder :: () -> string {\n    identity := ProcessIdentity();\n    if identity == \"\" {\n        return \"\";\n    }\n    none: u16[] = [];\n    size := GetTempPathW(0, none);\n    if size == 0 {\n        return \"\";\n    }\n    buffer := resize([u16(0)], int(size) + 1);\n    count := GetTempPathW(u32(length(buffer)), buffer);\n    if count == 0 || int(count) >= length(buffer) {\n        return \"\";\n    }\n    return strings.Concatenate([strings.TrimRight(Narrow(buffer, int(count)), \"/\\\\\"), \"/\", identity]);\n}\n\nProcessPath :: (folder: string, process: int, suffix: string) -> string {\n    return strings.Concatenate([folder, \"/\", SignedDecimal(i64(process)), suffix]);\n}\n\nClose :: (handle: u64) {\n    if handle != 0 && ~handle != 0 {\n        closed := CloseHandle(handle);\n    }\n}\n\n// Creates one ownership marker without replacing an earlier invocation's file.\nRecordProcess :: (path: string, pid: u32, job: u64, piped: bool) -> bool {\n    handle := CreateFileW(Wide(path), WriteAccess, 0, 0, CreateNew, 0, 0);\n    if ~handle == 0 {\n        return false;\n    }\n    data := Block(16);\n    for index in 0..<4 {\n        data[index] = u8((pid >> u32(index * 8)) & 255);\n    }\n    if piped { data[4] = 1; }\n    data = Put64(data, 8, job);\n    written: u32[] = [0];\n    status := WriteFile(handle, data, 16, written, 0);\n    closed := CloseHandle(handle);\n    if status == 0 || written[0] != 16 || closed == 0 {\n        removed := Remove(path);\n        return false;\n    }\n    return true;\n}\n\n// Exclusive marker access makes concurrent Wait/Kill calls reject a handle\n// already being consumed. A foreign or completed handle never reaches Close.\nProcessClaim :: struct {\n    marker: u64;\n    job: u64;\n    piped: bool;\n}\n\nClaimProcess :: (folder: string, process: int) -> ProcessClaim {\n    claim: ProcessClaim = {marker: 0, job: 0, piped: false};\n    if folder == \"\" || process <= 0 {\n        return claim;\n    }\n    pid := GetProcessId(u64(process));\n    if pid == 0 {\n        return claim;\n    }\n    handle := CreateFileW(Wide(ProcessPath(folder, process, \".state\")), ReadAccess, ShareDelete, 0, OpenExisting, 0, 0);\n    if ~handle == 0 {\n        return claim;\n    }\n    size := Block(8);\n    data := Block(16);\n    count: u32[] = [0];\n    sized := GetFileSizeEx(handle, size);\n    read := ReadFile(handle, data, 16, count, 0);\n    if sized == 0 || Word64(size, 0) != 16 || read == 0 || count[0] != 16 ||\n       Word32(data, 0) != u64(pid) || Word32(data, 4) > 1 || Word64(data, 8) == 0 {\n        Close(handle);\n        return claim;\n    }\n    claim.marker = handle;\n    claim.job = Word64(data, 8);\n    claim.piped = Word32(data, 4) == 1;\n    return claim;\n}\n\nStartingProcess :: struct {\n    information: u8[];\n    input: u64;\n    output: u64;\n    errors: u64;\n    job: u64;\n    waiting: string;\n    marker: string;\n}\n\nAbandonProcess :: (starting: StartingProcess, folder: string) {\n    process: u64 = 0;\n    if length(starting.information) != 0 {\n        process = Word64(starting.information, 0);\n        stopped := TerminateProcess(process, 127);\n        waited := WaitForSingleObject(process, Infinite);\n        Close(Word64(starting.information, 8));\n    }\n    Close(starting.job);\n    Close(starting.input);\n    Close(starting.output);\n    Close(starting.errors);\n    if starting.waiting != \"\" {\n        removed := Remove(starting.waiting);\n    }\n    if starting.marker != \"\" {\n        removed := Remove(starting.marker);\n    }\n    Close(process);\n    removed := RemoveDirectoryW(Wide(folder));\n}\n\n// Launch suspended so the job owns the child before any descendants can start.\n// Retain the job handle until reap: closing the last handle removes its name\n// even while associated processes still live, so reopening by name is unsafe.\npub Start :: (command: string[], piped: bool) -> int {\n    return StartProcess(command, piped, \"\", \"\");\n}\n\n// The caller owns the files, including cleanup after a failed launch. Empty\n// stdout inherits this process's stdout; stderr must name a distinct file.\n// Wait/Kill never report or remove redirected output. Windows already inherits\n// containing parent jobs, including when POSIX's attached group option is false.\npub StartRedirected :: (command: string[], stdout_path: string, stderr_path: string, attached: bool = false) -> int {\n    if stderr_path == \"\" || stdout_path == stderr_path { return -1; }\n    return StartProcess(command, false, stdout_path, stderr_path);\n}\n\nStartProcess :: (command: string[], piped: bool, stdout_path: string, stderr_path: string) -> int {\n    if length(command) == 0 {\n        return -1;\n    }\n    folder := ProcessFolder();\n    if folder == \"\" || !MakeDirectory(folder) {\n        return -1;\n    }\n    starting: StartingProcess = {information: [], input: 0, output: 0, errors: 0, job: 0, waiting: \"\", marker: \"\"};\n    starting.input = CreateFileW(Wide(\"NUL\"), ReadAccess, ShareAll, 0, OpenExisting, 0, 0);\n    if ~starting.input == 0 || Shared(starting.input) == 0 {\n        AbandonProcess(starting, folder);\n        return -1;\n    }\n    output: u64 = 0;\n    errors: u64 = 0;\n    if piped {\n        name := resize([u16(0)], MaxPathUnits);\n        if GetTempFileNameW(Wide(folder), Wide(\"out\"), 0, name) == 0 {\n            AbandonProcess(starting, folder);\n            return -1;\n        }\n        end := 0;\n        while end < length(name) && name[end] != 0 {\n            end += 1;\n        }\n        starting.waiting = Narrow(name, end);\n        starting.output = CreateFileW(Wide(starting.waiting), WriteAccess, ShareAll, 0, OpenExisting, 0, 0);\n        if ~starting.output == 0 || Shared(starting.output) == 0 {\n            AbandonProcess(starting, folder);\n            return -1;\n        }\n        output = starting.output;\n        errors = output;\n    } else if stderr_path != \"\" {\n        if stdout_path != \"\" {\n            starting.output = CreateFileW(Wide(stdout_path), WriteAccess, ShareAll, 0, CreateAlways, 0, 0);\n            if ~starting.output == 0 || Shared(starting.output) == 0 {\n                AbandonProcess(starting, folder);\n                return -1;\n            }\n            output = starting.output;\n        } else {\n            output = Shared(GetStdHandle(-11));\n        }\n        starting.errors = CreateFileW(Wide(stderr_path), WriteAccess, ShareAll, 0, CreateAlways, 0, 0);\n        if ~starting.errors == 0 || Shared(starting.errors) == 0 {\n            AbandonProcess(starting, folder);\n            return -1;\n        }\n        errors = starting.errors;\n    } else {\n        output = Shared(GetStdHandle(-11));\n        errors = Shared(GetStdHandle(-12));\n    }\n    starting.information = Launch(command, starting.input, output, errors, CreateSuspended | NewProcessGroup);\n    if length(starting.information) == 0 {\n        AbandonProcess(starting, folder);\n        return -1;\n    }\n    process := int(Word64(starting.information, 0));\n    pid := u32(Word32(starting.information, 16));\n    job := CreateJobObjectW(0, 0);\n    if job == 0 {\n        AbandonProcess(starting, folder);\n        return -1;\n    }\n    starting.job = job;\n    if AssignProcessToJobObject(job, u64(process)) == 0 {\n        AbandonProcess(starting, folder);\n        return -1;\n    }\n    marker := ProcessPath(folder, process, \".state\");\n    if !RecordProcess(marker, pid, job, piped) {\n        AbandonProcess(starting, folder);\n        return -1;\n    }\n    starting.marker = marker;\n    if piped {\n        published := ProcessPath(folder, process, \".out\");\n        if MoveFileExW(Wide(starting.waiting), Wide(published), 0) == 0 {\n            AbandonProcess(starting, folder);\n            return -1;\n        }\n        starting.waiting = published;\n    }\n    if ResumeThread(Word64(starting.information, 8)) == InvalidAttributes {\n        AbandonProcess(starting, folder);\n        return -1;\n    }\n    Close(Word64(starting.information, 8));\n    Close(starting.input);\n    Close(starting.output);\n    Close(starting.errors);\n    return process;\n}\n\n// Report in bounded chunks, preserving NUL bytes and combined output order.\nReportProcess :: (path: string) -> bool {\n    if !Exists(path) {\n        return true;\n    }\n    handle := CreateFileW(Wide(path), ReadAccess, ShareAll, 0, OpenExisting, 0, 0);\n    if ~handle == 0 {\n        return false;\n    }\n    data := Block(ReadChunk);\n    read: u32[] = [0];\n    written: u32[] = [0];\n    complete := true;\n    while true {\n        if ReadFile(handle, data, u32(ReadChunk), read, 0) == 0 {\n            complete = false;\n            break;\n        }\n        if read[0] == 0 {\n            break;\n        }\n        if WriteFile(GetStdHandle(-12), data, read[0], written, 0) == 0 || written[0] != read[0] {\n            complete = false;\n            break;\n        }\n    }\n    Close(handle);\n    removed := Remove(path);\n    return complete && removed;\n}\n\n// Timeouts preserve ownership. Completion consumes a handle exactly once.\npub WaitFor :: (process: int, timeout_ms: int) -> int {\n    if process < 0 {\n        return 127;\n    }\n    folder := ProcessFolder();\n    claim := ClaimProcess(folder, process);\n    if claim.marker == 0 {\n        return -1;\n    }\n    return WaitClaimed(folder, process, claim, timeout_ms);\n}\n\nWaitClaimed :: (folder: string, process: int, claim: ProcessClaim, timeout_ms: int) -> int {\n    timeout := Infinite;\n    if timeout_ms >= 0 {\n        timeout = u32(timeout_ms);\n    }\n    waited := WaitForSingleObject(u64(process), timeout);\n    if waited == WaitTimeout {\n        Close(claim.marker);\n        return StillRunning;\n    }\n    code: u32[] = [0];\n    found := GetExitCodeProcess(u64(process), code);\n    reported := true;\n    if claim.piped { reported = ReportProcess(ProcessPath(folder, process, \".out\")); }\n    removed := Remove(ProcessPath(folder, process, \".state\"));\n    // Drop the ownership marker before the OS can reuse the process handle.\n    // ShareDelete permits this removal while other claim readers stay excluded.\n    Close(claim.marker);\n    Close(claim.job);\n    Close(u64(process));\n    directory := RemoveDirectoryW(Wide(folder));\n    if waited != 0 || found == 0 || !reported || !removed {\n        return -1;\n    }\n    return int(wrap: code[0]);\n}\n\npub Kill :: (process: int) -> int {\n    if process < 0 {\n        return 127;\n    }\n    folder := ProcessFolder();\n    claim := ClaimProcess(folder, process);\n    if claim.marker == 0 {\n        return -1;\n    }\n    // The root may have exited while descendants still belong to its job.\n    // Stop that job before reaping the root, preserving a completed root's code.\n    stopped := TerminateJobObject(claim.job, KilledExit);\n    if stopped == 0 {\n        failure := GetLastError();\n        Print(strings.Concatenate([\"windows: cannot terminate process job: Win32 error \", UnsignedDecimal(u64(failure))]));\n        Close(claim.marker);\n        return -1;\n    }\n    return WaitClaimed(folder, process, claim, -1);\n}\n", "package strings\n\n// String operations compare, count and offset bytes.\n// Spaces and case use ASCII. Offsets are byte offsets, and -1 means not found.\n\n// Compiler text operations use bytes, including bytes inside UTF-8 sequences.\npub ByteLength :: (value: string) -> int {\n    return text_byte_length(value);\n}\n\n// Returns -1 outside the string; valid bytes are unsigned values from 0 to 255.\n// Reads the runtime's stored byte length.\npub ByteAt :: (value: string, index: int) -> int {\n    return text_byte_at(value, index);\n}\n\n// Every byte of the string, from 0 to 255, read in one pass.\npub Bytes :: (value: string) -> int[] {\n    return text_bytes(value);\n}\n\n// Start clamps to the string and count clamps to its remaining bytes.\npub Slice :: (value: string, start: int, count: int) -> string {\n    return text_slice(value, start, count);\n}\n\npub Compare :: (left: string, right: string) -> int {\n    leftLength := ByteLength(left);\n    rightLength := ByteLength(right);\n    index: int = 0;\n    while (index < leftLength && index < rightLength) {\n        a := ByteAt(left, index);\n        b := ByteAt(right, index);\n        if (a < b) {\n            return -1;\n        }\n        if (a > b) {\n            return 1;\n        }\n        index += 1;\n    }\n    if (leftLength < rightLength) {\n        return -1;\n    }\n    if (leftLength > rightLength) {\n        return 1;\n    }\n    return 0;\n}\n\npub IsIdentifier :: (value: string) -> bool {\n    size := ByteLength(value);\n    if (size == 0) {\n        return false;\n    }\n    index: int = 0;\n    while (index < size) {\n        byte := ByteAt(value, index);\n        letter := byte == 95 || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122);\n        if (!letter && !(index > 0 && byte >= 48 && byte <= 57)) {\n            return false;\n        }\n        index += 1;\n    }\n    return true;\n}\n\npub BaseName :: (path: string) -> string {\n    size := ByteLength(path);\n    start: int = 0;\n    index: int = 0;\n    while (index < size) {\n        if (ByteAt(path, index) == 47) {\n            start = index + 1;\n        }\n        index += 1;\n    }\n    return Slice(path, start, size - start);\n}\n\npub Contains :: (s: string, substr: string) -> bool {\n    return Index(s, substr) >= 0;\n}\n\npub ContainsAny :: (s: string, chars: string) -> bool {\n    return IndexAny(s, chars) >= 0;\n}\n\npub HasPrefix :: (s: string, prefix: string) -> bool {\n    size := ByteLength(prefix);\n    return ByteLength(s) >= size && Slice(s, 0, size) == prefix;\n}\n\npub HasSuffix :: (s: string, suffix: string) -> bool {\n    size := ByteLength(s);\n    count := ByteLength(suffix);\n    return size >= count && Slice(s, size - count, count) == suffix;\n}\n\npub IndexByte :: (s: string, c: int) -> int {\n    size := ByteLength(s);\n    i: int = 0;\n    while (i < size) {\n        if (ByteAt(s, i) == c) {\n            return i;\n        }\n        i += 1;\n    }\n    return -1;\n}\n\npub LastIndexByte :: (s: string, c: int) -> int {\n    i: int = ByteLength(s) - 1;\n    while (i >= 0) {\n        if (ByteAt(s, i) == c) {\n            return i;\n        }\n        i -= 1;\n    }\n    return -1;\n}\n\n// Verify hash hits byte for byte.\nMatchesAt :: (s: string, substr: string, start: int) -> bool {\n    i: int = 0;\n    while (i < ByteLength(substr)) {\n        if (ByteAt(s, start + i) != ByteAt(substr, i)) {\n            return false;\n        }\n        i += 1;\n    }\n    return true;\n}\n\n// Search from a byte offset without copying.\nIndexFrom :: (s: string, substr: string, start: int) -> int {\n    n := ByteLength(substr);\n    size := ByteLength(s);\n    if (n == 0) {\n        return start;\n    }\n    if (n > size - start) {\n        return -1;\n    }\n    if (n == 1) {\n        c := ByteAt(substr, 0);\n        i := start;\n        while (i < size) {\n            if (ByteAt(s, i) == c) {\n                return i;\n            }\n            i += 1;\n        }\n        return -1;\n    }\n    hash: i64 = 0;\n    pow: i64 = 1;\n    h: i64 = 0;\n    i: int = 0;\n    while (i < n) {\n        hash = (hash * 16777619 + i64(ByteAt(substr, i))) & 0xFFFFFFFF;\n        pow = (pow * 16777619) & 0xFFFFFFFF;\n        h = (h * 16777619 + i64(ByteAt(s, start + i))) & 0xFFFFFFFF;\n        i += 1;\n    }\n    i += start;\n    if (h == hash && MatchesAt(s, substr, start)) {\n        return start;\n    }\n    while (i < size) {\n        h = (h * 16777619 + i64(ByteAt(s, i)) - pow * i64(ByteAt(s, i - n))) & 0xFFFFFFFF;\n        i += 1;\n        if (h == hash && MatchesAt(s, substr, i - n)) {\n            return i - n;\n        }\n    }\n    return -1;\n}\n\n// Uses a 32-bit Rabin-Karp rolling hash. An empty substring is found at 0.\npub Index :: (s: string, substr: string) -> int {\n    return IndexFrom(s, substr, 0);\n}\n\n// Index's search from the end. An empty substring is found at the length of s.\npub LastIndex :: (s: string, substr: string) -> int {\n    n := ByteLength(substr);\n    size := ByteLength(s);\n    if (n == 0) {\n        return size;\n    }\n    if (n == 1) {\n        return LastIndexByte(s, ByteAt(substr, 0));\n    }\n    if (n == size) {\n        if (s == substr) {\n            return 0;\n        }\n        return -1;\n    }\n    if (n > size) {\n        return -1;\n    }\n    hash: i64 = 0;\n    pow: i64 = 1;\n    h: i64 = 0;\n    i: int = 0;\n    while (i < n) {\n        hash = (hash * 16777619 + i64(ByteAt(substr, n - 1 - i))) & 0xFFFFFFFF;\n        pow = (pow * 16777619) & 0xFFFFFFFF;\n        h = (h * 16777619 + i64(ByteAt(s, size - 1 - i))) & 0xFFFFFFFF;\n        i += 1;\n    }\n    i = size - n;\n    if (h == hash && Slice(s, i, n) == substr) {\n        return i;\n    }\n    i -= 1;\n    while (i >= 0) {\n        h = (h * 16777619 + i64(ByteAt(s, i)) - pow * i64(ByteAt(s, i + n))) & 0xFFFFFFFF;\n        if (h == hash && Slice(s, i, n) == substr) {\n            return i;\n        }\n        i -= 1;\n    }\n    return -1;\n}\n\n// The offset of the first byte of s that is any byte of chars.\npub IndexAny :: (s: string, chars: string) -> int {\n    size := ByteLength(s);\n    i: int = 0;\n    while (i < size) {\n        if (IndexByte(chars, ByteAt(s, i)) >= 0) {\n            return i;\n        }\n        i += 1;\n    }\n    return -1;\n}\n\npub LastIndexAny :: (s: string, chars: string) -> int {\n    i: int = ByteLength(s) - 1;\n    while (i >= 0) {\n        if (IndexByte(chars, ByteAt(s, i)) >= 0) {\n            return i;\n        }\n        i -= 1;\n    }\n    return -1;\n}\n\n// Non-overlapping occurrences. An empty substring occurs at every byte\n// boundary, one more than the byte length.\npub Count :: (s: string, substr: string) -> int {\n    n := ByteLength(substr);\n    if (n == 0) {\n        return ByteLength(s) + 1;\n    }\n    total: int = 0;\n    if (n == 1) {\n        c := ByteAt(substr, 0);\n        size := ByteLength(s);\n        i: int = 0;\n        while (i < size) {\n            if (ByteAt(s, i) == c) {\n                total += 1;\n            }\n            i += 1;\n        }\n        return total;\n    }\n    start: int = 0;\n    while (true) {\n        i := IndexFrom(s, substr, start);\n        if (i < 0) {\n            break;\n        }\n        total += 1;\n        start = i + n;\n    }\n    return total;\n}\n\n// Everything before the first c, or all of s when c is absent.\npub TruncateToByte :: (s: string, c: int) -> string {\n    n := IndexByte(s, c);\n    if (n < 0) {\n        return s;\n    }\n    return Slice(s, 0, n);\n}\n\n// ASCII letters match in either case; every other byte must be equal.\npub EqualFold :: (u: string, v: string) -> bool {\n    size := ByteLength(u);\n    if (size != ByteLength(v)) {\n        return false;\n    }\n    i: int = 0;\n    while (i < size) {\n        sr := ByteAt(u, i);\n        tr := ByteAt(v, i);\n        if (tr < sr) {\n            swap := sr;\n            sr = tr;\n            tr = swap;\n        }\n        if (tr != sr && !(sr >= 65 && sr <= 90 && tr == sr + 32)) {\n            return false;\n        }\n        i += 1;\n    }\n    return true;\n}\n\n// ASCII letters only; other bytes, including those of UTF-8 sequences, stay.\npub ToLower :: (s: string) -> string {\n    size := ByteLength(s);\n    result: string = \"\";\n    start: int = 0;\n    i: int = 0;\n    while (i < size) {\n        c := ByteAt(s, i);\n        if (c >= 65 && c <= 90) {\n            letter := Slice(\"abcdefghijklmnopqrstuvwxyz\", c - 65, 1);\n            result = format_text(\"{}{}{}\", result, Slice(s, start, i - start), letter);\n            start = i + 1;\n        }\n        i += 1;\n    }\n    if (start == 0) {\n        return s;\n    }\n    return format_text(\"{}{}\", result, Slice(s, start, size - start));\n}\n\npub ToUpper :: (s: string) -> string {\n    size := ByteLength(s);\n    result: string = \"\";\n    start: int = 0;\n    i: int = 0;\n    while (i < size) {\n        c := ByteAt(s, i);\n        if (c >= 97 && c <= 122) {\n            letter := Slice(\"ABCDEFGHIJKLMNOPQRSTUVWXYZ\", c - 97, 1);\n            result = format_text(\"{}{}{}\", result, Slice(s, start, i - start), letter);\n            start = i + 1;\n        }\n        i += 1;\n    }\n    if (start == 0) {\n        return s;\n    }\n    return format_text(\"{}{}\", result, Slice(s, start, size - start));\n}\n\n// Tab, line feed, vertical tab, form feed, carriage return and space.\npub IsAsciiSpace :: (c: int) -> bool {\n    return c == 32 || (c >= 9 && c <= 13);\n}\n\n// Removes the leading bytes that are bytes of cutset.\npub TrimLeft :: (s: string, cutset: string) -> string {\n    size := ByteLength(s);\n    i: int = 0;\n    while (i < size && IndexByte(cutset, ByteAt(s, i)) >= 0) {\n        i += 1;\n    }\n    return Slice(s, i, size - i);\n}\n\npub TrimRight :: (s: string, cutset: string) -> string {\n    i := ByteLength(s);\n    while (i > 0 && IndexByte(cutset, ByteAt(s, i - 1)) >= 0) {\n        i -= 1;\n    }\n    return Slice(s, 0, i);\n}\n\npub Trim :: (s: string, cutset: string) -> string {\n    return TrimRight(TrimLeft(s, cutset), cutset);\n}\n\npub TrimLeftSpace :: (s: string) -> string {\n    size := ByteLength(s);\n    i: int = 0;\n    while (i < size && IsAsciiSpace(ByteAt(s, i))) {\n        i += 1;\n    }\n    return Slice(s, i, size - i);\n}\n\npub TrimRightSpace :: (s: string) -> string {\n    i := ByteLength(s);\n    while (i > 0 && IsAsciiSpace(ByteAt(s, i - 1))) {\n        i -= 1;\n    }\n    return Slice(s, 0, i);\n}\n\npub TrimSpace :: (s: string) -> string {\n    return TrimRightSpace(TrimLeftSpace(s));\n}\n\npub TrimPrefix :: (s: string, prefix: string) -> string {\n    if (HasPrefix(s, prefix)) {\n        return Slice(s, ByteLength(prefix), ByteLength(s));\n    }\n    return s;\n}\n\npub TrimSuffix :: (s: string, suffix: string) -> string {\n    if (HasSuffix(s, suffix)) {\n        return Slice(s, 0, ByteLength(s) - ByteLength(suffix));\n    }\n    return s;\n}\n\n// The count bytes from offset, or all bytes from offset when count is below 1.\n// An offset outside s keeps all of s. A count past the end keeps the rest.\npub Cut :: (s: string, offset: int, count: int) -> string {\n    rest: string = s;\n    size := ByteLength(s);\n    if (offset >= 0 && offset < size) {\n        rest = Slice(s, offset, size - offset);\n    }\n    if (count < 1 || count >= ByteLength(rest)) {\n        return rest;\n    }\n    return Slice(rest, 0, count);\n}\n\n// Produces at most n parts, or every part when n is negative.\n// The last part holds the rest of s. Each other part keeps the first keep\n// bytes of the separator after it. An empty separator splits s into bytes.\nSplitKeeping :: (s: string, sep: string, keep: int, n: int) -> string[] {\n    parts: string[] = [];\n    size := ByteLength(sep);\n    limit := n;\n    if (size == 0) {\n        count := ByteLength(s);\n        if (limit < 0 || limit > count) {\n            limit = count;\n        }\n        while (length(parts) < limit - 1) {\n            parts.append(Slice(s, length(parts), 1));\n        }\n        if (limit > 0) {\n            parts.append(Slice(s, limit - 1, count));\n        }\n        return parts;\n    }\n    if (limit == 0) {\n        return parts;\n    }\n    start: int = 0;\n    while (limit < 0 || length(parts) < limit - 1) {\n        m := IndexFrom(s, sep, start);\n        if (m < 0) {\n            break;\n        }\n        parts.append(Slice(s, start, m - start + keep));\n        start = m + size;\n    }\n    if (start == 0) {\n        parts.append(s);\n        return parts;\n    }\n    parts.append(Slice(s, start, ByteLength(s) - start));\n    return parts;\n}\n\npub Split :: (s: string, sep: string) -> string[] {\n    return SplitKeeping(s, sep, 0, -1);\n}\n\npub SplitN :: (s: string, sep: string, n: int) -> string[] {\n    return SplitKeeping(s, sep, 0, n);\n}\n\npub SplitAfter :: (s: string, sep: string) -> string[] {\n    return SplitKeeping(s, sep, ByteLength(sep), -1);\n}\n\npub SplitAfterN :: (s: string, sep: string, n: int) -> string[] {\n    return SplitKeeping(s, sep, ByteLength(sep), n);\n}\n\n// Splits at line feeds; a line that ends in a carriage return loses it.\nSplitLinesKeeping :: (s: string, keep: int, n: int) -> string[] {\n    lines: string[] = [];\n    for (line in SplitKeeping(s, \"\\n\", keep, n)) {\n        lines.append(TrimSuffix(line, \"\\r\"));\n    }\n    return lines;\n}\n\npub SplitLines :: (s: string) -> string[] {\n    return SplitLinesKeeping(s, 0, -1);\n}\n\n// The lines of s as a reader sees them: split at line feeds, each without a\n// trailing carriage return, and no empty last line after a final terminator,\n// so \"\" has none and \"a\\n\" has one. SplitLines keeps that empty line.\npub Lines :: (s: string) -> string[] {\n    lines := SplitLines(s);\n    if (length(lines) > 0 && lines[length(lines) - 1] == \"\") {\n        return slice(lines, 0, length(lines) - 1);\n    }\n    return lines;\n}\n\npub SplitLinesN :: (s: string, n: int) -> string[] {\n    return SplitLinesKeeping(s, 0, n);\n}\n\npub SplitLinesAfter :: (s: string) -> string[] {\n    return SplitLinesKeeping(s, 1, -1);\n}\n\npub SplitLinesAfterN :: (s: string, n: int) -> string[] {\n    return SplitLinesKeeping(s, 1, n);\n}\n\n// The runs of bytes between ASCII spaces.\npub Fields :: (s: string) -> string[] {\n    fields: string[] = [];\n    size := ByteLength(s);\n    start: int = -1;\n    i: int = 0;\n    while (i < size) {\n        if (IsAsciiSpace(ByteAt(s, i))) {\n            if (start >= 0) {\n                fields.append(Slice(s, start, i - start));\n                start = -1;\n            }\n        } else if (start < 0) {\n            start = i;\n        }\n        i += 1;\n    }\n    if (start >= 0) {\n        fields.append(Slice(s, start, size - start));\n    }\n    return fields;\n}\n\n// Joins neighbours pairwise, so each byte is copied once per halving of the\n// part count rather than once per later part: joining a source's lines takes\n// O(bytes * log parts), not O(bytes * parts).\npub Join :: (a: string[], sep: string) -> string {\n    if (length(a) == 0) {\n        return \"\";\n    }\n    parts := a;\n    while (length(parts) > 1) {\n        merged: string[] = [];\n        i: int = 0;\n        while (i + 1 < length(parts)) {\n            merged.append(format_text(\"{}{}{}\", parts[i], sep, parts[i + 1]));\n            i += 2;\n        }\n        if (i < length(parts)) {\n            merged.append(parts[i]);\n        }\n        parts = merged;\n    }\n    return parts[0];\n}\n\npub Concatenate :: (a: string[]) -> string {\n    return Join(a, \"\");\n}\n\n// Doubles the result until it reaches the requested length.\n// A count below 1 gives an empty string.\npub Repeat :: (s: string, count: int) -> string {\n    if (count < 1) {\n        return \"\";\n    }\n    total: i64 = i64(ByteLength(s)) * i64(count);\n    result: string = s;\n    while (i64(ByteLength(result)) < total) {\n        rest: i64 = total - i64(ByteLength(result));\n        result = format_text(\"{}{}\", result, Slice(result, 0, int(rest)));\n    }\n    return result;\n}\n\n// Replaces the first n non-overlapping matches of old, or all of them when n is\n// negative. An empty old matches at every byte boundary.\npub Replace :: (s: string, old: string, new: string, n: int) -> string {\n    if (old == new || n == 0) {\n        return s;\n    }\n    matches := Count(s, old);\n    if (matches == 0) {\n        return s;\n    }\n    if (n > 0 && n < matches) {\n        matches = n;\n    }\n    size := ByteLength(s);\n    width := ByteLength(old);\n    result: string = \"\";\n    start: int = 0;\n    i: int = 0;\n    while (i < matches) {\n        j := start;\n        if (width == 0) {\n            if (i > 0) {\n                j += 1;\n            }\n        } else {\n            j += Index(Slice(s, start, size - start), old);\n        }\n        result = format_text(\"{}{}{}\", result, Slice(s, start, j - start), new);\n        start = j + width;\n        i += 1;\n    }\n    return format_text(\"{}{}\", result, Slice(s, start, size - start));\n}\n\npub ReplaceAll :: (s: string, old: string, new: string) -> string {\n    return Replace(s, old, new, -1);\n}\n\npub Remove :: (s: string, key: string, n: int) -> string {\n    return Replace(s, key, \"\", n);\n}\n\npub RemoveAll :: (s: string, key: string) -> string {\n    return Remove(s, key, -1);\n}\n\npub Parts :: struct {\n    head: string;\n    match: string;\n    tail: string;\n}\n\n// The text before the first sep, sep and the text after it; when sep is\n// absent, head is all of str and the others are empty.\npub Partition :: (str: string, sep: string) -> Parts {\n    i := Index(str, sep);\n    if (i < 0) {\n        return {head: str, match: \"\", tail: \"\"};\n    }\n    size := ByteLength(sep);\n    return {head: Slice(str, 0, i), match: sep, tail: Slice(str, i + size, ByteLength(str))};\n}\n"]) {
        case .Rejected(message): print_string(message);
        case .Rewritten(text, changed, skipped, notes): print_string(format_text("changed={} skipped={} notes={}\n", changed, skipped, notes));
    }
}
