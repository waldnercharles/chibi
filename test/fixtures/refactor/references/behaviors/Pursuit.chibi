Pursuit :: behavior {
    on Tick :: () {
        if find_nearest_entity(self.Transform, 600.0, 1, 0).Found {
            self.Velocity += (direction_to(self.Transform, convert<transform_to_cf>(find_nearest_entity(self.Transform, 600.0, 1, 0).Position)) * double(self.Movement.Speed) - self.Velocity) * min(1, 120.0 * double(delta) / max(length(direction_to(self.Transform, convert<transform_to_cf>(find_nearest_entity(self.Transform, 600.0, 1, 0).Position)) * double(self.Movement.Speed) - self.Velocity), 0.0001))
        } else {
            self.Velocity = vec2(0, 0)
        }
    }
}
