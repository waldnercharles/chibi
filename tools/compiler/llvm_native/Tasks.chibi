package llvm_native

import strings "core:strings"

// Execution belongs to the program while active. Source values own observers;
// dropping the last one never cancels running work. Completed results and
// cancelled rows remain only while observed, then return to the generation
// free list. Owners and phase fill the old entry-flag padding: rows remain
// 72 bytes, or 96 with timing. The kind/free field is a success type while live.
TaskScheduler :: (timed: bool, guarded: bool = false) -> string {
    fields := "";
    sample := "";
    started := "";
    tick := "";
    attached := "";
    runnable := "";
    reset_wait := "";
    updated_wait := "";
    runnable = "  br i1 %over, label %run, label %next\n";
    if (timed) {
        fields = ", double, double, double";
        sample = "  call void @chibi_tasks.sample_time()\n";
        started = "  %started.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 11\n  %now = load double, ptr @chibi_tasks.now\n  store double %now, ptr %started.at\n  %deadline.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 12\n  store double 0x7FF0000000000000, ptr %deadline.at\n";
        tick = "  call void @chibi_tasks.sample_time()\n  call void @chibi_tasks.expire()\n";
        attached = "  %time.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 13\n  %time = load double, ptr @chibi_tasks.pending_time\n  store double %time, ptr %time.at\n  store double 0xFFF0000000000000, ptr @chibi_tasks.pending_time\n";
        runnable = "  %time.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 13\n  %time = load double, ptr %time.at\n  %now = load double, ptr @chibi_tasks.now\n  %awake = fcmp oge double %now, %time\n  %runnable = and i1 %over, %awake\n  br i1 %runnable, label %run, label %next\n";
        reset_wait = "  store double 0xFFF0000000000000, ptr @chibi_tasks.pending_time\n";
        updated_wait = "  %updated.time = getelementptr inbounds %chibi.task, ptr %updated, i32 0, i32 13\n  %time.pending = load double, ptr @chibi_tasks.pending_time\n  store double %time.pending, ptr %updated.time\n  store double 0xFFF0000000000000, ptr @chibi_tasks.pending_time\n";
    }
    text := strings.Join([
        "%chibi.task = type { ptr, i64, i64, i32, i32, ptr, i32, i32, i64, i64, i64$fields }\n@chibi_tasks.table = internal global ptr null\n@chibi_tasks.capacity = internal global i32 0\n@chibi_tasks.free = internal global i32 0\n@chibi_tasks.owner = internal global ptr null\n",
        "@chibi_tasks.ready = internal global ptr null\n@chibi_tasks.ready_count = internal global i64 0\n@chibi_tasks.ready_capacity = internal global i64 0\n@chibi_tasks.ready_owner = internal global ptr null\n@chibi_tasks.pending = internal global i64 0\n",
        "@chibi_tasks.current = internal global i64 0\n\n@chibi_tasks.stopping = internal global i1 false\ndefine internal ptr @chibi_tasks.row(i64 %handle) #0 {\nentry:\n",
        "  %index = trunc i64 %handle to i32\n  %capacity = load i32, ptr @chibi_tasks.capacity\n  %offset = sub i32 %index, 1\n  %valid = icmp ult i32 %offset, %capacity\n  br i1 %valid, label %check, label %none\n",
        "check:\n  %table = load ptr, ptr @chibi_tasks.table\n  %wide = zext i32 %offset to i64\n  %row = getelementptr inbounds %chibi.task, ptr %table, i64 %wide\n  %generation.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 3\n",
        "  %generation = load i32, ptr %generation.at\n  %expected.wide = lshr i64 %handle, 32\n  %expected = trunc i64 %expected.wide to i32\n  %same = icmp eq i32 %generation, %expected\n  %state.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 7\n",
        "  %state = load i32, ptr %state.at\n  %live = icmp ne i32 %state, 0\n  %matches = and i1 %same, %live\n  br i1 %matches, label %found, label %none\nfound:\n",
        "  ret ptr %row\nnone:\n  ret ptr null\n}\n\n",
        "define internal void @chibi_tasks.grow(ptr %ctx) #1 {\nentry:\n  %capacity = load i32, ptr @chibi_tasks.capacity\n  %doubled = shl i32 %capacity, 1\n  %empty = icmp eq i32 %capacity, 0\n",
        "  %next = select i1 %empty, i32 16, i32 %doubled\n  %room = icmp ugt i32 %next, %capacity\n  br i1 %room, label %allocate, label %trap\nallocate:\n  %wide = zext i32 %next to i64\n",
        "  %end = getelementptr %chibi.task, ptr null, i64 %wide\n  %bytes = ptrtoint ptr %end to i64\n",
        Allocated("table", "%bytes", guarded),
        "  %allocated = icmp ne ptr %table, null\n  br i1 %allocated, label %copy.start, label %trap\ncopy.start:\n  %old = load ptr, ptr @chibi_tasks.table\n  br label %copy\n",
        "copy:\n  %i = phi i32 [ 0, %copy.start ], [ %i.next, %copy.row ]\n  %more = icmp ult i32 %i, %capacity\n  br i1 %more, label %copy.row, label %initialize\ncopy.row:\n",
        "  %i.wide = zext i32 %i to i64\n  %from = getelementptr inbounds %chibi.task, ptr %old, i64 %i.wide\n  %to = getelementptr inbounds %chibi.task, ptr %table, i64 %i.wide\n  %value = load %chibi.task, ptr %from\n  store %chibi.task %value, ptr %to\n",
        "  %i.next = add i32 %i, 1\n  br label %copy\ninitialize:\n  %j = phi i32 [ %capacity, %copy ], [ %j.next, %initialize.row ]\n  %left = icmp ult i32 %j, %next\n",
        "  br i1 %left, label %initialize.row, label %publish\ninitialize.row:\n  %j.wide = zext i32 %j to i64\n  %row = getelementptr inbounds %chibi.task, ptr %table, i64 %j.wide\n  store %chibi.task zeroinitializer, ptr %row\n",
        "  %j.next = add i32 %j, 1\n  %following = add i32 %j, 2\n  %last = icmp eq i32 %j.next, %next\n  %link = select i1 %last, i32 0, i32 %following\n  %link.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 4\n",
        "  store i32 %link, ptr %link.at\n  br label %initialize\npublish:\n  store ptr %table, ptr @chibi_tasks.table\n  store i32 %next, ptr @chibi_tasks.capacity\n",
        "  %first = add i32 %capacity, 1\n  store i32 %first, ptr @chibi_tasks.free\n  store ptr %ctx, ptr @chibi_tasks.owner\n  %had = icmp ne ptr %old, null\n  br i1 %had, label %release, label %exit\n",
        "release:\n", ContextCall("release.fn", 4, guarded),
        "  call void %release.fn(ptr %ctx, ptr %old)\n  br label %exit\n",
        "exit:\n  ret void\ntrap:\n  call void @llvm.trap()\n  unreachable\n",
        "}\n\ndefine internal i64 @chibi_tasks.begin(ptr %ctx, i32 %kind) #0 {\nentry:\n$sample  %available = load i32, ptr @chibi_tasks.free\n",
        "  %empty = icmp eq i32 %available, 0\n  br i1 %empty, label %grow, label %take\ngrow:\n  call void @chibi_tasks.grow(ptr %ctx)\n  br label %take\n",
        "take:\n  %index = load i32, ptr @chibi_tasks.free\n  %offset = sub i32 %index, 1\n  %wide = zext i32 %offset to i64\n  %table = load ptr, ptr @chibi_tasks.table\n",
        "  %row = getelementptr inbounds %chibi.task, ptr %table, i64 %wide\n  %next.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 4\n  %next = load i32, ptr %next.at\n  store i32 %next, ptr @chibi_tasks.free\n  %generation.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 3\n",
        "  %old.generation = load i32, ptr %generation.at\n  %generation = add i32 %old.generation, 1\n  %wrapped = icmp eq i32 %generation, 0\n  br i1 %wrapped, label %trap, label %initialize\ninitialize:\n",
        "  store %chibi.task zeroinitializer, ptr %row\n$started  store i32 %generation, ptr %generation.at\n  %parent.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 2\n  %parent = load i64, ptr @chibi_tasks.current\n  store i64 %parent, ptr %parent.at\n",
        "  %ctx.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 5\n  store ptr %ctx, ptr %ctx.at\n  %kind.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 4\n  store i32 %kind, ptr %kind.at\n  %owners.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 6\n",
        "  store i32 1, ptr %owners.at\n  %state.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 7\n  store i32 1, ptr %state.at\n  %generation.wide = zext i32 %generation to i64\n  %high = shl i64 %generation.wide, 32\n",
        "  %index.wide = zext i32 %index to i64\n  %handle = or i64 %high, %index.wide\n  store i64 %handle, ptr @chibi_tasks.current\n  %parent.row = call ptr @chibi_tasks.row(i64 %parent)\n  %has.parent = icmp ne ptr %parent.row, null\n",
        "  br i1 %has.parent, label %link, label %exit\nlink:\n  %first.at = getelementptr inbounds %chibi.task, ptr %parent.row, i32 0, i32 8\n  %first = load i64, ptr %first.at\n  store i64 %handle, ptr %first.at\n",
        "  %following.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 10\n  store i64 %first, ptr %following.at\n  %following.row = call ptr @chibi_tasks.row(i64 %first)\n  %has.following = icmp ne ptr %following.row, null\n  br i1 %has.following, label %back, label %exit\n",
        "back:\n  %back.at = getelementptr inbounds %chibi.task, ptr %following.row, i32 0, i32 9\n  store i64 %handle, ptr %back.at\n  br label %exit\nexit:\n",
        "  ret i64 %handle\ntrap:\n  call void @llvm.trap()\n  unreachable\n}\n",
        "\ndefine internal void @chibi_tasks.unlink(i64 %handle) #0 {\nentry:\n  %row = call ptr @chibi_tasks.row(i64 %handle)\n  %valid = icmp ne ptr %row, null\n",
        "  br i1 %valid, label %check, label %exit\ncheck:\n  %frame = load ptr, ptr %row\n  %live = icmp ne ptr %frame, null\n  br i1 %live, label %unlink, label %exit\n",
        "unlink:\n  %parent.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 2\n  %parent = load i64, ptr %parent.at\n  %previous.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 9\n  %previous = load i64, ptr %previous.at\n",
        "  %following.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 10\n  %following = load i64, ptr %following.at\n  %previous.row = call ptr @chibi_tasks.row(i64 %previous)\n  %has.previous = icmp ne ptr %previous.row, null\n  br i1 %has.previous, label %previous.link, label %parent.check\n",
        "previous.link:\n  %previous.next = getelementptr inbounds %chibi.task, ptr %previous.row, i32 0, i32 10\n  store i64 %following, ptr %previous.next\n  br label %following.check\nparent.check:\n",
        "  %parent.row = call ptr @chibi_tasks.row(i64 %parent)\n  %has.parent = icmp ne ptr %parent.row, null\n  br i1 %has.parent, label %parent.link, label %following.check\nparent.link:\n  %parent.first = getelementptr inbounds %chibi.task, ptr %parent.row, i32 0, i32 8\n",
        "  store i64 %following, ptr %parent.first\n  br label %following.check\nfollowing.check:\n  %following.row = call ptr @chibi_tasks.row(i64 %following)\n  %has.following = icmp ne ptr %following.row, null\n",
        "  br i1 %has.following, label %following.link, label %children.start\nfollowing.link:\n  %following.previous = getelementptr inbounds %chibi.task, ptr %following.row, i32 0, i32 9\n  store i64 %previous, ptr %following.previous\n  br label %children.start\n",
        "children.start:\n  %first.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 8\n  %first = load i64, ptr %first.at\n  store i64 0, ptr %first.at\n  br label %children\n",
        "children:\n  %child = phi i64 [ %first, %children.start ], [ %child.next, %detach ]\n  %child.row = call ptr @chibi_tasks.row(i64 %child)\n  %has.child = icmp ne ptr %child.row, null\n  br i1 %has.child, label %detach, label %release\n",
        "detach:\n  %child.parent = getelementptr inbounds %chibi.task, ptr %child.row, i32 0, i32 2\n  %child.previous = getelementptr inbounds %chibi.task, ptr %child.row, i32 0, i32 9\n  %child.following = getelementptr inbounds %chibi.task, ptr %child.row, i32 0, i32 10\n  %child.next = load i64, ptr %child.following\n",
        "  store i64 0, ptr %child.parent\n  store i64 0, ptr %child.previous\n  store i64 0, ptr %child.following\n  br label %children\nrelease:\n",
        "  br label %exit\nexit:\n  ret void\n}\ndefine internal ptr @chibi_tasks.result_frame(i64 %handle, i32 %kind) #0 {\n",
        "entry:\n  %empty = icmp eq i64 %handle, 0\n  br i1 %empty, label %cancelled, label %lookup\nlookup:\n  %row = call ptr @chibi_tasks.row(i64 %handle)\n",
        "  %valid = icmp ne ptr %row, null\n  br i1 %valid, label %check, label %trap\ncheck:\n  %kind.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 4\n  %actual = load i32, ptr %kind.at\n",
        "  %same = icmp eq i32 %actual, %kind\n  br i1 %same, label %state, label %trap\nstate:\n  %state.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 7\n  %phase = load i32, ptr %state.at\n",
        "  switch i32 %phase, label %trap [ i32 2, label %success\n                                  i32 3, label %cancelled ]\nsuccess:\n  %frame = load ptr, ptr %row\n  ret ptr %frame\n",
        "cancelled:\n  ret ptr null\ntrap:\n  call void @llvm.trap()\n  unreachable\n",
        "}\ndefine internal void @chibi_tasks.reclaim(i64 %handle) #0 {\nentry:\n  %row = call ptr @chibi_tasks.row(i64 %handle)\n  %frame = load ptr, ptr %row\n",
        "  %has = icmp ne ptr %frame, null\n  br i1 %has, label %destroy, label %free\ndestroy:\n  call void @llvm.coro.destroy(ptr %frame)\n  br label %free\n",
        "free:\n  store ptr null, ptr %row\n  %state.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 7\n  store i32 0, ptr %state.at\n  %head = load i32, ptr @chibi_tasks.free\n",
        "  %next.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 4\n  store i32 %head, ptr %next.at\n  %index = trunc i64 %handle to i32\n  store i32 %index, ptr @chibi_tasks.free\n  ret void\n",
        "}\ndefine internal void @chibi_tasks.retain(i64 %handle) #0 {\nentry:\n  %empty = icmp eq i64 %handle, 0\n  br i1 %empty, label %exit, label %lookup\n",
        "lookup:\n  %row = call ptr @chibi_tasks.row(i64 %handle)\n  %valid = icmp ne ptr %row, null\n  br i1 %valid, label %count, label %trap\ncount:\n",
        "  %owners.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 6\n  %owners = load i32, ptr %owners.at\n  %room = icmp ult i32 %owners, -1\n  br i1 %room, label %keep, label %trap\nkeep:\n",
        "  %next = add i32 %owners, 1\n  store i32 %next, ptr %owners.at\n  br label %exit\ntrap:\n  call void @llvm.trap()\n",
        "  unreachable\nexit:\n  ret void\n}\ndefine internal void @chibi_tasks.release(i64 %handle) #0 {\n",
        "entry:\n  %empty = icmp eq i64 %handle, 0\n  %stopping = load i1, ptr @chibi_tasks.stopping\n  %skip = or i1 %empty, %stopping\n  br i1 %skip, label %exit, label %lookup\n",
        "lookup:\n  %row = call ptr @chibi_tasks.row(i64 %handle)\n  %valid = icmp ne ptr %row, null\n  br i1 %valid, label %count, label %trap\ncount:\n",
        "  %owners.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 6\n  %owners = load i32, ptr %owners.at\n  %has = icmp ne i32 %owners, 0\n  br i1 %has, label %drop, label %trap\ndrop:\n",
        "  %next = sub i32 %owners, 1\n  store i32 %next, ptr %owners.at\n  %none = icmp eq i32 %next, 0\n  %state.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 7\n  %state = load i32, ptr %state.at\n",
        "  %done = icmp ne i32 %state, 1\n  %free = and i1 %none, %done\n  br i1 %free, label %reclaim, label %exit\nreclaim:\n  call void @chibi_tasks.reclaim(i64 %handle)\n",
        "  br label %exit\ntrap:\n  call void @llvm.trap()\n  unreachable\nexit:\n",
        "  ret void\n}\ndefine internal i1 @chibi_tasks.finished(i64 %handle) #0 {\nentry:\n  %row = call ptr @chibi_tasks.row(i64 %handle)\n",
        "  %valid = icmp ne ptr %row, null\n  br i1 %valid, label %check, label %yes\ncheck:\n  %state.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 7\n  %state = load i32, ptr %state.at\n",
        "  %done = icmp ne i32 %state, 1\n  ret i1 %done\nyes:\n  ret i1 true\n}\n",
        "define internal void @chibi_tasks.complete(i64 %handle, i1 %cancelled) #0 {\nentry:\n  %row = call ptr @chibi_tasks.row(i64 %handle)\n  call void @chibi_tasks.unlink(i64 %handle)\n  %state.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 7\n",
        "  %state = select i1 %cancelled, i32 3, i32 2\n  %wake.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 1\n  %wake = load i64, ptr %wake.at\n  store i64 0, ptr %wake.at\n  call void @chibi_tasks.release(i64 %wake)\n",
        "  br i1 %cancelled, label %destroy, label %check\ndestroy:\n  %frame = load ptr, ptr %row\n  store ptr null, ptr %row\n  call void @llvm.coro.destroy(ptr %frame)\n",
        "  br label %check\ncheck:\n  store i32 %state, ptr %state.at\n  %owners.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 6\n  %owners = load i32, ptr %owners.at\n",
        "  %none = icmp eq i32 %owners, 0\n  br i1 %none, label %reclaim, label %exit\nreclaim:\n  call void @chibi_tasks.reclaim(i64 %handle)\n  br label %exit\n",
        "exit:\n  ret void\n}\ndefine internal void @chibi_tasks.wait(i64 %awaited) #0 {\nentry:\n",
        "  %current = load i64, ptr @chibi_tasks.current\n  %self = icmp eq i64 %current, %awaited\n  br i1 %self, label %trap, label %keep\nkeep:\n  call void @chibi_tasks.retain(i64 %awaited)\n",
        "  store i64 %awaited, ptr @chibi_tasks.pending\n  ret void\ntrap:\n  call void @llvm.trap()\n  unreachable\n",
        "}\ndefine internal void @chibi_tasks.attach(i64 %handle, ptr %frame) #0 {\nentry:\n  %row = call ptr @chibi_tasks.row(i64 %handle)\n  store ptr %frame, ptr %row\n",
        "  %wake.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 1\n  %pending = load i64, ptr @chibi_tasks.pending\n  store i64 %pending, ptr %wake.at\n  store i64 0, ptr @chibi_tasks.pending\n$attached  %done = call i1 @llvm.coro.done(ptr %frame)\n",
        "  br i1 %done, label %complete, label %queue\ncomplete:\n  call void @chibi_tasks.complete(i64 %handle, i1 false)\n  ret void\nqueue:\n",
        "  %count = load i64, ptr @chibi_tasks.ready_count\n  %capacity = load i64, ptr @chibi_tasks.ready_capacity\n  %room = icmp ult i64 %count, %capacity\n  br i1 %room, label %append, label %grow\ngrow:\n",
        "  %ctx.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 5\n  %ctx = load ptr, ptr %ctx.at\n  %empty = icmp eq i64 %capacity, 0\n  %doubled = shl i64 %capacity, 1\n  %next.capacity = select i1 %empty, i64 16, i64 %doubled\n",
        "  %bytes = shl i64 %next.capacity, 3\n", Allocated("new", "%bytes", guarded),
        "  %old = load ptr, ptr @chibi_tasks.ready\n",
        "  br label %copy\ncopy:\n  %i = phi i64 [ 0, %grow ], [ %i.next, %copy.row ]\n  %more = icmp ult i64 %i, %count\n  br i1 %more, label %copy.row, label %publish\n",
        "copy.row:\n  %from = getelementptr inbounds i64, ptr %old, i64 %i\n  %to = getelementptr inbounds i64, ptr %new, i64 %i\n  %value = load i64, ptr %from\n  store i64 %value, ptr %to\n",
        "  %i.next = add i64 %i, 1\n  br label %copy\npublish:\n  store ptr %new, ptr @chibi_tasks.ready\n  store i64 %next.capacity, ptr @chibi_tasks.ready_capacity\n",
        "  store ptr %ctx, ptr @chibi_tasks.ready_owner\n  %had = icmp ne ptr %old, null\n  br i1 %had, label %free, label %append\nfree:\n",
        ContextCall("release.fn", 4, guarded),
        "  call void %release.fn(ptr %ctx, ptr %old)\n  br label %append\nappend:\n  %ready = load ptr, ptr @chibi_tasks.ready\n",
        "  %at = getelementptr inbounds i64, ptr %ready, i64 %count\n  store i64 %handle, ptr %at\n  %next = add i64 %count, 1\n  store i64 %next, ptr @chibi_tasks.ready_count\n  ret void\n",
        "}\n\ndefine internal void @chibi_tasks.cancel(i64 %handle) #0 {\nentry:\n  %done = call i1 @chibi_tasks.finished(i64 %handle)\n",
        "  br i1 %done, label %exit, label %start\nstart:\n  br label %visit\nvisit:\n  %current = phi i64 [ %handle, %start ], [ %child, %descend ], [ %parent, %advance ]\n",
        "  %row = call ptr @chibi_tasks.row(i64 %current)\n  %first.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 8\n  %child = load i64, ptr %first.at\n  %has.child = icmp ne i64 %child, 0\n  br i1 %has.child, label %descend, label %stop\n",
        "descend:\n  br label %visit\nstop:\n  %parent.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 2\n  %parent = load i64, ptr %parent.at\n",
        "  call void @chibi_tasks.complete(i64 %current, i1 true)\n  %root = icmp eq i64 %current, %handle\n  br i1 %root, label %exit, label %advance\nadvance:\n  br label %visit\n",
        "exit:\n  ret void\n}\n\ndefine internal void @chibi_tasks.update() #0 {\n",
        "entry:\n$tick  %count = load i64, ptr @chibi_tasks.ready_count\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %i.next, %next ]\n",
        "  %more = icmp ult i64 %i, %count\n  br i1 %more, label %task, label %compact.start\ntask:\n  %ready = load ptr, ptr @chibi_tasks.ready\n  %at = getelementptr inbounds i64, ptr %ready, i64 %i\n",
        "  %handle = load i64, ptr %at\n  %done = call i1 @chibi_tasks.finished(i64 %handle)\n  br i1 %done, label %next, label %waiting\nwaiting:\n  %row = call ptr @chibi_tasks.row(i64 %handle)\n",
        "  %wake.at = getelementptr inbounds %chibi.task, ptr %row, i32 0, i32 1\n  %wake = load i64, ptr %wake.at\n  %over = call i1 @chibi_tasks.finished(i64 %wake)\n$runnable run:\n  %frame = load ptr, ptr %row\n",
        "  %previous = load i64, ptr @chibi_tasks.current\n  store i64 %handle, ptr @chibi_tasks.current\n  store i64 0, ptr @chibi_tasks.pending\n$reset_wait  call void @llvm.coro.resume(ptr %frame)\n  store i64 %previous, ptr @chibi_tasks.current\n",
        "  %updated = call ptr @chibi_tasks.row(i64 %handle)\n  %updated.wake = getelementptr inbounds %chibi.task, ptr %updated, i32 0, i32 1\n  store i64 0, ptr %updated.wake\n  call void @chibi_tasks.release(i64 %wake)\n  %pending = load i64, ptr @chibi_tasks.pending\n",
        "  store i64 %pending, ptr %updated.wake\n  store i64 0, ptr @chibi_tasks.pending\n$updated_wait  %finished = call i1 @llvm.coro.done(ptr %frame)\n  br i1 %finished, label %complete, label %next\ncomplete:\n",
        "  call void @chibi_tasks.complete(i64 %handle, i1 false)\n  br label %next\nnext:\n  %i.next = add i64 %i, 1\n  br label %loop\n",
        "compact.start:\n  %total = load i64, ptr @chibi_tasks.ready_count\n  %all = load ptr, ptr @chibi_tasks.ready\n  br label %compact\ncompact:\n",
        "  %read = phi i64 [ 0, %compact.start ], [ %read.next, %compact.next ]\n  %write = phi i64 [ 0, %compact.start ], [ %write.next, %compact.next ]\n  %left = icmp ult i64 %read, %total\n  br i1 %left, label %compact.check, label %exit\ncompact.check:\n",
        "  %source = getelementptr inbounds i64, ptr %all, i64 %read\n  %candidate = load i64, ptr %source\n  %candidate.row = call ptr @chibi_tasks.row(i64 %candidate)\n  %exists = icmp ne ptr %candidate.row, null\n  br i1 %exists, label %compact.live, label %compact.next\n",
        "compact.live:\n  %candidate.state.at = getelementptr inbounds %chibi.task, ptr %candidate.row, i32 0, i32 7\n  %candidate.state = load i32, ptr %candidate.state.at\n  %live = icmp eq i32 %candidate.state, 1\n  br i1 %live, label %compact.keep, label %compact.next\n",
        "compact.keep:\n  %destination = getelementptr inbounds i64, ptr %all, i64 %write\n  store i64 %candidate, ptr %destination\n  %kept = add i64 %write, 1\n  br label %compact.next\n",
        "compact.next:\n  %write.next = phi i64 [ %write, %compact.check ], [ %write, %compact.live ], [ %kept, %compact.keep ]\n  %read.next = add i64 %read, 1\n  br label %compact\nexit:\n",
        "  store i64 %write, ptr @chibi_tasks.ready_count\n  ret void\n}\n\ndefine i64 @chibi_host_tasks_pending() #0 {\n",
        "entry:\n  %count = load i64, ptr @chibi_tasks.ready_count\n  %ready = load ptr, ptr @chibi_tasks.ready\n  br label %loop\nloop:\n",
        "  %i = phi i64 [ 0, %entry ], [ %i.next, %body ]\n  %pending = phi i64 [ 0, %entry ], [ %next.pending, %body ]\n  %more = icmp ult i64 %i, %count\n  br i1 %more, label %body, label %exit\nbody:\n",
        "  %at = getelementptr inbounds i64, ptr %ready, i64 %i\n  %handle = load i64, ptr %at\n  %done = call i1 @chibi_tasks.finished(i64 %handle)\n  %added = select i1 %done, i64 0, i64 1\n  %next.pending = add i64 %pending, %added\n",
        "  %i.next = add i64 %i, 1\n  br label %loop\nexit:\n  ret i64 %pending\n}\n",
        "\ndefine i32 @chibi_host_tasks_poll() #0 {\nentry:\n  call void @chibi_tasks.update()\n  ret i32 0\n",
        "}\n\ndefine i32 @chibi_host_tasks_cancel_all() #0 {\nentry:\n  store i1 true, ptr @chibi_tasks.stopping\n",
        "  %count = load i32, ptr @chibi_tasks.capacity\n  %rows = load ptr, ptr @chibi_tasks.table\n  br label %loop\nloop:\n  %i = phi i32 [ 0, %entry ], [ %next, %advance ]\n",
        "  %more = icmp ult i32 %i, %count\n  br i1 %more, label %read, label %table\nread:\n  %wide = zext i32 %i to i64\n  %row = getelementptr inbounds %chibi.task, ptr %rows, i64 %wide\n",
        "  %frame = load ptr, ptr %row\n  %has = icmp ne ptr %frame, null\n  br i1 %has, label %destroy, label %advance\ndestroy:\n  store ptr null, ptr %row\n",
        "  call void @llvm.coro.destroy(ptr %frame)\n  br label %advance\nadvance:\n  %next = add i32 %i, 1\n  br label %loop\n",
        "table:\n  %has.rows = icmp ne ptr %rows, null\n  br i1 %has.rows, label %table.free, label %ready.check\ntable.free:\n  %ctx = load ptr, ptr @chibi_tasks.owner\n",
        ContextCall("release.fn", 4, guarded),
        "  call void %release.fn(ptr %ctx, ptr %rows)\n  br label %ready.check\nready.check:\n",
        "  %ready = load ptr, ptr @chibi_tasks.ready\n  %has.ready = icmp ne ptr %ready, null\n  br i1 %has.ready, label %ready.free, label %exit\nready.free:\n  %ready.ctx = load ptr, ptr @chibi_tasks.ready_owner\n",
        strings.ReplaceAll(ContextCall("ready.release.fn", 4, guarded), "%ctx", "%ready.ctx"),
        "  call void %ready.release.fn(ptr %ready.ctx, ptr %ready)\n  br label %exit\nexit:\n",
        "  store ptr null, ptr @chibi_tasks.table\n  store i32 0, ptr @chibi_tasks.capacity\n  store i32 0, ptr @chibi_tasks.free\n  store ptr null, ptr @chibi_tasks.ready\n  store i64 0, ptr @chibi_tasks.ready_count\n",
        "  store i64 0, ptr @chibi_tasks.ready_capacity\n  store i64 0, ptr @chibi_tasks.current\n  store i64 0, ptr @chibi_tasks.pending\n  store i1 false, ptr @chibi_tasks.stopping\n  ret i32 0\n",
        "}\n",
    ], "");
    text = strings.ReplaceAll(text, "$fields", fields);
    text = strings.ReplaceAll(text, "$sample", sample);
    text = strings.ReplaceAll(text, "$started", started);
    text = strings.ReplaceAll(text, "$tick", tick);
    text = strings.ReplaceAll(text, "$attached", attached);
    text = strings.ReplaceAll(text, "$runnable", runnable);
    text = strings.ReplaceAll(text, "$reset_wait", reset_wait);
    text = strings.ReplaceAll(text, "$updated_wait", updated_wait);
    return text;
}
