package graph_link_response

import c "graph_c:."
import strings "core:strings"

// The native dispatcher owns scratch paths and an argv-recording compiler shim.
Check :: (condition: bool, note: string) -> bool {
    if (!condition) {
        build.report(note);
    }
    return condition;
}

TransportMatches :: (root: string, command: string[], empties: int) -> bool {
    actual := build.lines(build.read_file(build.join([root, "/transport-argv"], "")));
    original_bytes := 0;
    for (argument in command) {
        original_bytes += strings.ByteLength(argument) + 1;
    }
    transport_bytes := strings.ByteLength(command[0]) + 1;
    empty_count := 0;
    for (argument in actual) {
        transport_bytes += strings.ByteLength(argument) + 1;
        if (argument == "") {
            empty_count += 1;
        }
    }
    return Check(length(actual) + 1 <= length(command) && transport_bytes <= original_bytes &&
        empty_count == empties, "link transport grew argv or lost an empty argument");
}

Build :: () -> int {
    args := build.arguments();
    root := args[0];
    quoted := args[1];
    search_dir := args[2];
    source := build.join([root, "/link.c"], "");
    selected := build.environment("CC");
    if (selected == "") {
        selected = "clang";
    }
    compiler := build.find_executable(selected);
    tools: c.Tools = {
        launcher: "", compiler: compiler, cxx_compiler: "",
        archiver: "", ranlib: "", jobs: 1
    };
    object := build.join([quoted, "/object '\"\\ name.o"], "");
    output := build.join([quoted, "/program '\"\\ name"], "");
    flags := ["-Wl,-dead_strip"];
    if (build.platform() == "Linux") {
        flags[0] = "-Wl,--gc-sections";
    }
    record := build.join([output, ".chibi-record"], "");
    response := build.join([output, ".chibi-link.rsp"], "");
    if (!Check(compiler != "" && build.run([compiler, "-c", source, "-o", object]) == 0, "compile failed")) {
        return 1;
    }
    if (!Check(c.Link(tools, output, [object], flags, []) == 1 && build.run([output]) == 37,
        "quoted link failed")) {
        return 2;
    }
    original := c.LinkCommand(tools, output, [object], flags, []);
    prefix := build.join([build.join(original, "\n"), "\n\n"], "");
    if (!Check(strings.HasPrefix(build.read_file(record), prefix), "short original argv lost")) {
        return 3;
    }
    stamp := build.file_stamp(output);
    if (!Check(!build.file_exists(response) && build.make_directory(response), "response cleanup failed")) {
        return 4;
    }
    if (!Check(c.Link(tools, output, [object], flags, []) == 0 && build.file_stamp(output) == stamp &&
        build.remove(response), "cache hit ran link")) {
        return 5;
    }

    // Standalone empties retain driver behavior, provenance and cache identity.
    empty_output := build.join([quoted, "/empty-argument"], "");
    empty_flags := slice(flags, 0, length(flags));
    empty_flags.append("");
    empty_command := c.LinkCommand(tools, empty_output, [object], empty_flags, []);
    direct_status := build.run(empty_command);
    response_status := c.Link(tools, empty_output, [object], empty_flags, []);
    if (!Check((direct_status == 0 && response_status == 1) || (direct_status != 0 && response_status == -1),
        "empty argument transport changed driver semantics")) {
        return 25;
    }
    empty_record := build.join([empty_output, ".chibi-record"], "");
    if (direct_status == 0) {
        empty_prefix := build.join([build.join(empty_command, "\n"), "\n\n"], "");
        if (!Check(build.run([empty_output]) == 37 && strings.HasPrefix(build.read_file(empty_record),
            empty_prefix), "accepted empty argument lost original argv")) {
            return 26;
        }
        if (!Check(c.Link(tools, empty_output, [object], empty_flags, []) == 0,
            "empty argument cache identity changed")) {
            return 30;
        }
    } else if (!Check(!build.file_exists(empty_record), "rejected empty argument retained a success record")) {
        return 27;
    }
    if (!build.write_file(build.join([root, "/empty_link_commands.json"], ""), c.LinkEntry(empty_command,
        empty_output))) {
        return 28;
    }
    if (!Check(!build.file_exists(build.join([empty_output, ".chibi-link.rsp"], "")),
        "empty argument response cleanup failed")) {
        return 29;
    }
    build.report(format_text("empty link: direct {0}, response {1}", direct_status, response_status));

    // Empty option operands must stay between their surrounding response runs.
    captured := tools;
    captured.compiler = build.join([root, "/record-driver"], "");
    if (!build.write_file(build.join([captured.compiler, ".compiler"], ""), build.join([compiler, "\n"], ""))) {
        return 31;
    }
    operand_output := build.join([quoted, "/empty-operand"], "");
    operand_flags := slice(flags, 0, length(flags));
    for (i in 0..<8) {
        operand_flags.append(build.join(["-L", search_dir], ""));
    }
    operand_flags.extend(["-L", "", ""]);
    operand_direct := c.LinkCommand(tools, operand_output, [object], operand_flags, []);
    operand_command := c.LinkCommand(captured, operand_output, [object], operand_flags, []);
    if (!Check(build.run(operand_direct) == 0 && c.Link(captured, operand_output, [object], operand_flags,
        []) == 1 && build.run([operand_output]) == 37, "empty -L operand changed link semantics")) {
        return 32;
    }
    if (!TransportMatches(root, operand_command, 2)) {
        return 33;
    }
    operand_record := build.join([operand_output, ".chibi-record"], "");
    operand_response := build.join([operand_output, ".chibi-link.rsp"], "");
    numbered := build.join([operand_response, ".1"], "");
    operand_prefix := build.join([build.join(operand_command, "\n"), "\n\n"], "");
    if (!Check(strings.HasPrefix(build.read_file(operand_record), operand_prefix) && c.Link(captured,
        operand_output, [object], operand_flags, []) == 0 && !build.file_exists(operand_response) &&
        !build.file_exists(numbered), "segmented link lost provenance, cache or cleanup")) {
        return 34;
    }
    if (!build.write_file(build.join([root, "/operand_link_commands.json"], ""), c.LinkEntry(operand_command,
        operand_output))) {
        return 35;
    }
    if (!build.remove(operand_record) || !build.make_directory(numbered)) {
        return 36;
    }
    if (!Check(c.Link(captured, operand_output, [object], operand_flags, []) == -1 &&
        !build.file_exists(operand_record) && !build.file_exists(operand_response) &&
        build.file_kind(numbered) == "directory", "numbered response write failure retained owned inputs")) {
        return 37;
    }
    if (!build.remove(numbered) || c.Link(captured, operand_output, [object], operand_flags, []) != 1) {
        return 38;
    }
    missing := build.join([root, "/missing.a"], "");
    if (!Check(c.Link(captured, operand_output, [object], operand_flags, [missing]) == -1 &&
        !build.file_exists(operand_record) && !build.file_exists(operand_response) && !build.file_exists(numbered),
        "segmented failed link retained response files")) {
        return 39;
    }
    if (c.Link(captured, operand_output, [object], operand_flags, []) != 1) {
        return 40;
    }

    // Short runs must not grow into long response paths around many empties.
    tiny_output := build.join([quoted, "/many empty runs"], "");
    tiny_flags := slice(flags, 0, length(flags));
    for (i in 0..<64) {
        tiny_flags.extend(["-L", ""]);
    }
    tiny_command := c.LinkCommand(captured, tiny_output, [object], tiny_flags, []);
    if (!Check(c.Link(captured, tiny_output, [object], tiny_flags, []) == 1 && build.run([tiny_output]) == 37 &&
        TransportMatches(root, tiny_command, 64),
        "short empty-separated arguments changed admission or semantics")) {
        return 41;
    }
    build.report("empty operand and transport admission checks passed");

    // A real link exceeds the host byte admission limit without changing it.
    libraries: string[] = [];
    for (i in 0..<400) {
        libraries.append(build.join(["-L", search_dir], ""));
    }
    command := c.LinkCommand(tools, output, [object], flags, libraries);
    bytes := 0;
    for (argument in command) {
        bytes += strings.ByteLength(argument) + 1;
    }
    if (!Check(bytes > 65536 && length(command) < 1023, "fixture did not exceed argv byte limit")) {
        return 6;
    }
    if (!Check(c.Link(tools, output, [object], flags, libraries) == 1 && build.run([output]) == 37,
        "long real link failed")) {
        return 7;
    }
    prefix = build.join([build.join(command, "\n"), "\n\n"], "");
    if (!Check(strings.HasPrefix(build.read_file(record), prefix) && !build.file_exists(response),
        "long original argv lost")) {
        return 8;
    }
    if (!build.write_file(build.join([root, "/link_commands.json"], ""), c.LinkEntry(command, output))) {
        return 9;
    }
    if (!Check(c.Link(tools, output, [object], flags, libraries) == 0, "long cache miss")) {
        return 10;
    }
    libraries.append("-lm");
    if (!Check(c.Link(tools, output, [object], flags, libraries) == 1 && c.Link(tools, output, [object], flags,
        libraries) == 0, "command invalidation failed")) {
        return 11;
    }
    if (!build.write_file(source, "int main(void) { return 38; }\n")) {
        return 12;
    }
    if (build.run([compiler, "-c", source, "-o", object]) != 0) {
        return 13;
    }
    if (!Check(c.Link(tools, output, [object], flags, libraries) == 1 && build.run([output]) == 38,
        "input invalidation failed")) {
        return 14;
    }
    failed := slice(libraries, 0, length(libraries));
    failed.append(build.join([root, "/missing.a"], ""));
    if (!Check(c.Link(tools, output, [object], flags, failed) == -1 && !build.file_exists(record) &&
        !build.file_exists(response), "link failure retained success")) {
        return 15;
    }
    if (!Check(c.Link(tools, output, [object], flags, libraries) == 1 && build.run([output]) == 38,
        "link retry failed")) {
        return 16;
    }
    partial := build.join([root, "/partial-output"], "");
    if (c.Link(tools, partial, [object], flags, []) != 1) {
        return 17;
    }
    broken := tools;
    broken.compiler = build.join([root, "/partial-driver"], "");
    if (!Check(c.Link(broken, partial, [object], flags, []) == -1 && build.read_file(partial) == "partial" &&
        !build.file_exists(build.join([partial, ".chibi-record"], "")), "partial failure retained success")) {
        return 18;
    }
    if (!Check(c.Link(tools, partial, [object], flags, []) == 1 && build.run([partial]) == 38,
        "partial retry failed")) {
        return 19;
    }
    if (!build.remove(record) || !build.make_directory(response)) {
        return 20;
    }
    if (!Check(c.Link(tools, output, [object], flags, libraries) == -1 && !build.file_exists(record),
        "response write failure retained success")) {
        return 21;
    }

    // A retry with fewer segments removes abandoned numeric files only.
    abandoned := build.join([response, ".17"], "");
    neighbor := build.join([response, ".notes"], "");
    if (!build.write_file(abandoned, "interrupted link") || !build.write_file(neighbor, "keep")) {
        return 42;
    }
    if (!build.remove(response) || c.Link(tools, output, [object], flags, libraries) != 1) {
        return 22;
    }
    if (!Check(!build.file_exists(abandoned) && build.read_file(neighbor) == "keep" && build.remove(neighbor),
        "retry left old segments or removed unrelated files")) {
        return 43;
    }
    for (bad in ["line\nending", "line\rending", "nul\u0000ending"]) {
        if (!Check(c.Link(tools, output, [object], [bad], []) == -1, "malformed link argument accepted")) {
            return 23;
        }
    }
    if (!Check(c.Link(tools, "", [object], flags, []) == -1, "empty output accepted")) {
        return 24;
    }
    build.report(format_text("response link: {0} arguments, {1} bytes", length(command), bytes));
    return 0;
}
