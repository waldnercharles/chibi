behavior "OrbitLaunch" {
    owner "ecs.entity";
    value get_ui_value = get_ui_value(Entity: 0, Element: "#score");
    value add = add(A: float = get_ui_value.Value, B: float = 100.0);
    value v_350_dt = "v + 350 * dt"(v: double = &component("GAME.GameVelocity", "y"), dt: float = tick.DeltaSeconds);
    on Dash as dash() {
        await set_game_transform(Value: {
            x: 166.0,
            y: -165.0
        });
        await set_game_velocity(Value: {
            x: -65.0,
            y: -740.0
        });
        await set_ui_value(Entity: 0, Element: "#score", Value: 0.0);
        set_ui_text(Entity: 0, Element: "#score", Text: "0");
    }
    on "Contact Begin" as contact_begin(Other: handle<"ecs.entity"> = 0, Point: struct<"CF_V2"> = null) {
        await set_ui_text(Entity: 0, Element: "#score", Text: format_text(Format: "{:.0f}", Arg0: float = add, Arg1: any = null));
        set_ui_value(Entity: 0, Element: "#score", Value: add);
    }
    on Tick as tick(DeltaSeconds: float = 0.0) {
        set_game_velocity_y(Value: v_350_dt, Target: 0);
    }
    pure function "v + 350 * dt"<T0: double, T1: float, T2: double>(v: T0 = 0.0, dt: T1 = 0.0) -> (Result: T2 = 0.0) {
        depth_limit 64;
        value real = real(Value: 350.0);
        value multiply = multiply(A: double = real, B: double = entry.dt);
        value add = add(A: double = entry.v, B: double = multiply);
        result Result: double = add;
    }
}
