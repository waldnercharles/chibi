new file mode 100644
index 0000000000000000000000000000000000000000..892b62fad821af6473b889c9e3c9b2b101085802
--- /dev/null
+++ b/tools/experiments/vnext/source_census/host.c
@@ -0,0 +1,211 @@
+/* AOT entry for one opaque frame. Census owns framing and every byte count.
+ * Source preparation and repository identity checks are deliberately elsewhere.
+ * This first host targets the contract's Linux x86-64 System V ABI.
+ */
+#define _POSIX_C_SOURCE 200809L
+#include "host-contract.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+enum {
+    HOST_REJECTED = 1,
+    HOST_USAGE = 2,
+    HOST_INPUT_IO = 3,
+    HOST_REPORT_CONTRACT = 4,
+    HOST_OUTPUT_IO = 5
+};
+
+/* One process-wide foreign hook, used synchronously by the one Census call.
+ * No pointer into the allocation is captured. Saturation preserves duplicate
+ * detection without making the call counter itself capable of overflowing.
+ */
+static struct {
+    unsigned calls;
+    int64_t fields[16];
+} report;
+
+int64_t chibi_census_report(int64_t status, int64_t error_offset, int64_t packages,
+    int64_t original_files, int64_t original_bytes,
+    int64_t original_lines, int64_t original_nonblank,
+    int64_t replaced_files, int64_t replaced_bytes,
+    int64_t replaced_lines, int64_t replaced_nonblank,
+    int64_t generated_files, int64_t generated_bytes,
+    int64_t generated_lines, int64_t generated_nonblank,
+    int64_t frame_bytes)
+{
+    if (report.calls == 0) {
+        const int64_t fields[16] = {
+            status, error_offset, packages,
+            original_files, original_bytes, original_lines, original_nonblank,
+            replaced_files, replaced_bytes, replaced_lines, replaced_nonblank,
+            generated_files, generated_bytes, generated_lines, generated_nonblank,
+            frame_bytes
+        };
+        memcpy(report.fields, fields, sizeof fields);
+        report.calls = 1;
+    } else {
+        report.calls = 2;
+    }
+    return status;
+}
+
+/* Output errors take precedence over input/rejection/contract exit codes.
+ * Closing both streams also catches delayed buffered-write failures.
+ */
+static int finish(int result)
+{
+    if (fclose(stdout) == EOF) {
+        result = HOST_OUTPUT_IO;
+        if (fprintf(stderr, "source-census: closing stdout failed\n") < 0)
+            result = HOST_OUTPUT_IO;
+    }
+    if (fclose(stderr) == EOF)
+        result = HOST_OUTPUT_IO;
+    return result;
+}
+
+static int input_error(const char *path, const char *operation, int error)
+{
+    if (fprintf(stderr, "%s: %s: %s\n", path, operation,
+            error == 0 ? "file extent changed during read" : strerror(error)) < 0)
+        return HOST_OUTPUT_IO;
+    return HOST_INPUT_IO;
+}
+
+int main(int argc, char **argv)
+{
+    /* A closed output pipe must produce HOST_OUTPUT_IO, not a SIGPIPE exit. */
+    if (signal(SIGPIPE, SIG_IGN) == SIG_ERR)
+        return finish(input_error("source-census", "ignore SIGPIPE", errno));
+    if (argc != 2) {
+        const int written = fprintf(stderr, "usage: source-census FRAME\n");
+        return finish(written < 0 ? HOST_OUTPUT_IO : HOST_USAGE);
+    }
+
+    const char *path = argv[1];
+    int result = HOST_INPUT_IO;
+    /* O_NONBLOCK prevents waiting on a FIFO before fstat can reject it;
+     * it has no effect on regular-file reads on this Linux target.
+     */
+    int file = open(path, O_RDONLY | O_CLOEXEC | O_NONBLOCK);
+    uint8_t *bytes = NULL;
+    bool out_of_memory = false;
+    if (file < 0)
+        return finish(input_error(path, "open", errno));
+
+    struct stat metadata;
+    if (fstat(file, &metadata) < 0) {
+        result = input_error(path, "stat", errno);
+        goto cleanup;
+    }
+    if (!S_ISREG(metadata.st_mode) || metadata.st_size < 0 ||
+            (uintmax_t)metadata.st_size > SIZE_MAX ||
+            (uintmax_t)metadata.st_size > INT64_MAX) {
+        const int written = fprintf(stderr,
+            "%s: expected a regular file whose extent fits size_t and i64\n", path);
+        result = written < 0 ? HOST_OUTPUT_IO : HOST_INPUT_IO;
+        goto cleanup;
+    }
+
+    const size_t length = (size_t)metadata.st_size;
+    if (length != 0) {
+        bytes = malloc(length);
+        if (bytes == NULL) {
+            out_of_memory = true;
+            if (fprintf(stderr, "%s: cannot allocate %zu input bytes\n", path, length) < 0)
+                result = HOST_OUTPUT_IO;
+            goto cleanup;
+        }
+    }
+
+    size_t at = 0;
+    while (at != length) {
+        const size_t remaining = length - at;
+        const size_t wanted = remaining > (size_t)SSIZE_MAX ? (size_t)SSIZE_MAX : remaining;
+        const ssize_t count = read(file, bytes + at, wanted);
+        if (count < 0) {
+            if (errno == EINTR)
+                continue;
+            result = input_error(path, "read", errno);
+            goto cleanup;
+        }
+        if (count == 0) {
+            result = input_error(path, "read", 0);
+            goto cleanup;
+        }
+        at += (size_t)count;
+    }
+
+    /* Check EOF, not frame contents. Never silently census a prefix of a file
+     * that grew after fstat. This is not a provenance or atomic-snapshot proof.
+     */
+    uint8_t extra;
+    ssize_t tail;
+    do {
+        tail = read(file, &extra, 1);
+    } while (tail < 0 && errno == EINTR);
+    if (tail != 0) {
+        result = input_error(path, "read past measured extent", tail < 0 ? errno : 0);
+        goto cleanup;
+    }
+    if (close(file) < 0) {
+        file = -1; /* Linux consumes the descriptor even when close reports EINTR. */
+        result = input_error(path, "close", errno);
+        goto cleanup;
+    }
+    file = -1;
+
+    /* malloc/read established actual readable storage, not merely integer
+     * bounds. No writer or reallocator runs while Census borrows it. NULL is
+     * used only at length zero; ownership and lifetime end after return.
+     */
+    const int64_t returned = Census(bytes, (int64_t)length);
+    free(bytes);
+    bytes = NULL;
+    if (report.calls != 1 || returned != report.fields[0]) {
+        const int written = fprintf(stderr,
+            "%s: report contract failure: calls=%u%s return=%" PRId64
+            " reported_status=%" PRId64 "\n", path, report.calls,
+            report.calls == 2 ? " (at least)" : "", returned, report.fields[0]);
+        result = written < 0 ? HOST_OUTPUT_IO : HOST_REPORT_CONTRACT;
+        goto cleanup;
+    }
+    if (returned != 0) {
+        const int written = fprintf(stderr,
+            "%s:%" PRId64 ": census status=%" PRId64 " frame_bytes=%" PRId64 "\n",
+            path, report.fields[1], returned, report.fields[15]);
+        result = written < 0 ? HOST_OUTPUT_IO : HOST_REJECTED;
+        goto cleanup;
+    }
+
+    result = 0;
+    for (size_t field = 0; field != 16; ++field) {
+        if (printf("%" PRId64 "%c", report.fields[field], field == 15 ? '\n' : ' ') < 0) {
+            result = HOST_OUTPUT_IO;
+            break;
+        }
+    }
+
+cleanup:
+    if (file >= 0 && close(file) < 0) {
+        const int close_result = input_error(path, "close", errno);
+        if (result != HOST_OUTPUT_IO)
+            result = close_result;
+    }
+    free(bytes);
+    result = finish(result);
+    if (out_of_memory)
+        abort(); /* Repository policy: allocation failure is not invalid input. */
+    return result;
+}
diff --git a/tools/experiments/vnext/source_census/reference.py b/tools/experiments/vnext/source_census/reference.py
new file mode 100644
index 0000000000000000000000000000000000000000..e1d5410302c96cb16f87a108f2c525962b320af9
--- /dev/null
+++ b/tools/experiments/vnext/source_census/reference.py
@@ -0,0 +1,167 @@
+#!/usr/bin/env python3
+"""Independent CCN1 byte oracle, not a source-closure/preparation tool.
+
+The result is the contract's sixteen integers. Input is bytes or a read-only
+mmap kept unchanged through the call. No decoding, Unicode line/space rules,
+Chibi byte loop, or compiler/backend module participates in the answer.
+"""
+
+import mmap
+import re
+import struct
+import sys
+
+
+MAGIC = 827212611
+PACKAGE_LIMIT = 4096
+ORIGINAL_FILE_COUNT_LIMIT = 16384
+ORIGINAL_FILE_LIMIT = 16 * 1024 * 1024
+ORIGINAL_TOTAL_LIMIT = 256 * 1024 * 1024
+GENERATED_COUNT_LIMIT = 1
+GENERATED_TOTAL_LIMIT = 256
+FRAME_LIMIT = 16 + 12 * (ORIGINAL_FILE_COUNT_LIMIT + GENERATED_COUNT_LIMIT) + ORIGINAL_TOTAL_LIMIT + GENERATED_TOTAL_LIMIT
+
+HEADER = struct.Struct("<4I")
+RECORD = struct.Struct("<3I")
+NONBLANK = re.compile(rb"[^\x09-\x0d\x20]")
+LINE_CHUNK = 64 * 1024
+
+
+def count_lines(frame: bytes | mmap.mmap, start: int, stop: int) -> tuple[int, int]:
+    """Split on LF only, bounded to 64 KiB plus its line-segment list.
+
+    Split copies at most one chunk's bytes, not a complete large payload. At
+    most 65,537 segment references exist per chunk, independent of frame size.
+    A boolean carries a line spanning chunks. The regex searches bytes for the
+    exact non-whitespace set without another stripped/translated payload copy.
+    """
+    physical = nonblank = 0
+    pending_text = False
+    for at in range(start, stop, LINE_CHUNK):
+        parts = frame[at:min(at + LINE_CHUNK, stop)].split(b"\n")
+        tail = parts.pop()
+        physical += len(parts)
+        for line in parts:
+            nonblank += pending_text or NONBLANK.search(line) is not None
+            pending_text = False
+        pending_text = pending_text or NONBLANK.search(tail) is not None
+        del parts  # Release this bounded list before constructing the next one.
+    if stop > start and frame[stop - 1] != 10:
+        physical += 1
+        nonblank += pending_text
+    return physical, nonblank
+
+
+def census(frame: bytes | mmap.mmap) -> tuple[int, ...]:
+    """Validate in specified first-failure order; errors zero all 13 counters."""
+    size = len(frame)
+
+    def failure(status: int, offset: int) -> tuple[int, ...]:
+        return (status, offset, *(0,) * 13, size)
+
+    if size < HEADER.size:
+        return failure(1, 0)
+    if size > FRAME_LIMIT:
+        return failure(2, 0)
+    magic, declared_packages, declared_originals, declared_generated = HEADER.unpack_from(frame)
+    if magic != MAGIC:
+        return failure(3, 0)
+    if not (1 <= declared_packages <= PACKAGE_LIMIT and
+            1 <= declared_originals <= ORIGINAL_FILE_COUNT_LIMIT and
+            declared_generated <= GENERATED_COUNT_LIMIT):
+        return failure(4, 0)
+
+    packages = 0
+    # Four counters per category: files, bytes, physical lines, nonblank lines.
+    original = [0, 0, 0, 0]
+    replaced = [0, 0, 0, 0]
+    generated = [0, 0, 0, 0]
+    pending_package = 0
+    at = HEADER.size
+    while at < size:
+        if size - at < RECORD.size:
+            return failure(5, at)
+        tag, package, length = RECORD.unpack_from(frame, at)
+        start = at + RECORD.size
+        if tag not in (1, 2, 3):
+            return failure(6, at)
+        if length > size - start:
+            return failure(7, at)
+        if ((pending_package and (tag != 3 or package != pending_package)) or
+                (not pending_package and tag == 3)):
+            return failure(8, at)
+        if tag == 3:
+            if generated[0] >= declared_generated:
+                return failure(9, at)
+            if length > GENERATED_TOTAL_LIMIT - generated[1]:
+                return failure(10, at)
+        else:
+            if not (1 <= package <= declared_packages and
+                    (package == packages or package == packages + 1)):
+                return failure(11, at)
+            if original[0] >= declared_originals:
+                return failure(12, at)
+            if length > ORIGINAL_FILE_LIMIT:
+                return failure(13, at)
+            if length > ORIGINAL_TOTAL_LIMIT - original[1]:
+                return failure(14, at)
+            if tag == 2 and replaced[0]:
+                return failure(15, at)
+
+        stop = start + length
+        physical, nonblank = count_lines(frame, start, stop)
+        if tag == 3:
+            generated[0] += 1
+            generated[1] += length
+            generated[2] += physical
+            generated[3] += nonblank
+            pending_package = 0
+        else:
+            packages = package
+            original[0] += 1
+            original[1] += length
+            original[2] += physical
+            original[3] += nonblank
+            if tag == 2:
+                replaced[:] = (1, length, physical, nonblank)
+                pending_package = package
+        at = stop
+
+    if pending_package:
+        return failure(16, size)
+    if packages != declared_packages:
+        return failure(17, size)
+    if original[0] != declared_originals:
+        return failure(18, size)
+    if generated[0] != declared_generated:
+        return failure(19, size)
+    return (0, 0, packages, *original, *replaced, *generated, size)
+
+
+def main() -> int:
+    if len(sys.argv) != 2:
+        print("usage: reference.py FRAME", file=sys.stderr)
+        return 2
+    path = sys.argv[1]
+    try:
+        with open(path, "rb") as source:
+            # Empty files cannot be mapped; their exact bytes still reach census.
+            if source.seek(0, 2) == 0:
+                report = census(b"")
+            else:
+                with mmap.mmap(source.fileno(), 0, access=mmap.ACCESS_READ) as frame:
+                    report = census(frame)
+    except (OSError, ValueError) as error:
+        print(f"{path}: input I/O: {error}", file=sys.stderr)
+        return 3
+    try:
+        print(*report)
+        sys.stdout.flush()
+    except OSError as error:
+        print(f"{path}: output I/O: {error}", file=sys.stderr)
+        return 5
+    return 0 if report[0] == 0 else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
