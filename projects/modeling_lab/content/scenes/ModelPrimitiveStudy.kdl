version 1
name "ModelPrimitiveStudy"
(array)entities {
    - name="Camera" prototype="StudyCamera"
    - {
        name "Key light"
        prototype "StudyLight"
        components {
            GameTransform x=0.0 y=-70.0
        }
    }
    - {
        name "Model sphere"
        prototype "ModelSphere"
        components {
            GameTransform x=-60.0 y=0.0
        }
    }
    - {
        name "Analytical sphere"
        prototype "AnalyticalSphere"
        components {
            GameTransform x=60.0 y=0.0
        }
    }
}
