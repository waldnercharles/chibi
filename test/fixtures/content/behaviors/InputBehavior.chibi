behavior "InputBehavior" {
    action set_gamevelocity = set_game_velocity("MovementActions"."Movement Velocity"(input.Direction, get_game_movement()))
    value has_gamedash = has_game_dash()
    value get_gamedash = get_game_dash()
    value less = less(0.0, get_gamedash.Value.remaining)
    on Input as input {
        if has_gamedash {
            if less {
            } else {
                set_gamevelocity()
            }
        } else {
            set_gamevelocity()
        }
    }
    after set_gamevelocity {
        await "Face Direction"(input.Direction)
    }
    function "Face Direction"(Direction: struct<"CF_V2"> = null) {
        value has_gameorientation = has_game_orientation()
        value abs = abs(entry.Direction.x)
        value abs_2 = abs(entry.Direction.y)
        value add = add(abs, abs_2)
        value greater_or_equal = greater_or_equal(0.0, add)
        after entry {
            if has_gameorientation {
                if greater_or_equal {
                    return
                } else {
                    await set_game_orientation("DirectionMath"."Direction Orientation"(entry.Direction.x, entry.Direction.y))
                    return
                }
            } else {
                return
            }
        }
    }
}
