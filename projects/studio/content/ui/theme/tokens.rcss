/* The palette, in shadcn/ui's tokens: light on :root, dark on .dark. A shadcn
   theme's two variable blocks paste over these, and the editor's roles
   (roles.rcss) follow them. */
:root {
    --radius: 6dp;
    --background: #f7f8fa;
    --foreground: #23262c;
    --card: #fcfdff;
    --card-foreground: #23262c;
    --popover: #fcfdff;
    --popover-foreground: #23262c;
    --primary: #315ea8;
    --primary-foreground: #fcfdff;
    --secondary: #e9edf3;
    --secondary-foreground: #23262c;
    --muted: #eef1f5;
    --muted-foreground: #556071;
    --accent: #0000000b;
    --accent-foreground: #23262c;
    --destructive: #b42332;
    --border: #cbd2dd;
    --input: #cbd2dd;
    --ring: #315ea8;
}
.dark {
    --background: #202328;
    --foreground: #e8edf5;
    --card: #282c33;
    --card-foreground: #e8edf5;
    --popover: #252930;
    --popover-foreground: #e8edf5;
    --primary: #426baa;
    --primary-foreground: #fcfdff;
    --secondary: #353b45;
    --secondary-foreground: #e8edf5;
    --muted: #252930;
    --muted-foreground: #aeb9ca;
    --accent: #fcfdff0f;
    --accent-foreground: #e8edf5;
    --destructive: #ff9aa3;
    --border: #444d5b;
    --input: #444d5b;
    --ring: #9abbf1;
}
