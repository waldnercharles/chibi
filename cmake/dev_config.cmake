include("${CMAKE_CURRENT_LIST_DIR}/generated_file.cmake")

function(bp_shared_targets directory output)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    set(shared)
    foreach(target IN LISTS targets)
        get_target_property(type "${target}" TYPE)
        if(type STREQUAL "SHARED_LIBRARY" AND NOT target STREQUAL "blueprints_application")
            list(APPEND shared "$<TARGET_FILE:${target}>")
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        bp_shared_targets("${child}" nested)
        list(APPEND shared ${nested})
    endforeach()
    set(${output} "${shared}" PARENT_SCOPE)
endfunction()

function(bp_json_array output)
    set(json "[]")
    set(index 0)
    foreach(value IN LISTS ARGN)
        bp_json_string(quoted "${value}")
        string(JSON json SET "${json}" ${index} "${quoted}")
        math(EXPR index "${index} + 1")
    endforeach()
    set(${output} "${json}" PARENT_SCOPE)
endfunction()

set(roots "${CMAKE_SOURCE_DIR}/CMakeLists.txt" "${CMAKE_SOURCE_DIR}/Makefile")
foreach(directory src include tools cmake third_party)
    list(APPEND roots "${CMAKE_SOURCE_DIR}/${directory}")
endforeach()
file(GLOB fetched_sources LIST_DIRECTORIES true "${FETCHCONTENT_BASE_DIR}/*-src")
list(APPEND roots ${fetched_sources})
get_cmake_property(cache_variables CACHE_VARIABLES)
foreach(variable IN LISTS cache_variables)
    if(variable MATCHES "^FETCHCONTENT_SOURCE_DIR_")
        if(IS_DIRECTORY "${${variable}}")
            list(APPEND roots "${${variable}}")
        endif()
    endif()
endforeach()
set(canonical_roots)
foreach(root IN LISTS roots)
    if(EXISTS "${root}")
        file(REAL_PATH "${root}" canonical)
        list(APPEND canonical_roots "${canonical}")
    endif()
endforeach()
list(REMOVE_DUPLICATES canonical_roots)
list(SORT canonical_roots)
bp_json_array(root_json ${canonical_roots})
bp_json_array(suffix_json .c .h .cpp .hpp .cc .cxx .hh .m .mm .in .tsv .shd .glsl .patch .ttf .otf .cmake)
bp_shared_targets("${CMAKE_SOURCE_DIR}" shared_libraries)
bp_json_array(library_json ${shared_libraries})
set(config "{\"version\":1}")
foreach(pair source_dir build_dir cmake host application build_config)
    if(pair STREQUAL "source_dir")
        file(REAL_PATH "${CMAKE_SOURCE_DIR}" value)
    elseif(pair STREQUAL "build_dir")
        file(REAL_PATH "${CMAKE_BINARY_DIR}" value)
    elseif(pair STREQUAL "cmake")
        set(value "${CMAKE_COMMAND}")
    elseif(pair STREQUAL "host")
        set(value "$<TARGET_FILE:blueprints_host>")
    elseif(pair STREQUAL "application")
        set(value "$<TARGET_FILE:blueprints_application>")
    else()
        set(value "${CMAKE_BUILD_TYPE}")
        if(CMAKE_CONFIGURATION_TYPES)
            set(value Debug)
        endif()
    endif()
    bp_json_string(quoted "${value}")
    string(JSON config SET "${config}" "${pair}" "${quoted}")
endforeach()
string(JSON config SET "${config}" roots "${root_json}")
string(JSON config SET "${config}" suffixes "${suffix_json}")
string(JSON config SET "${config}" libraries "${library_json}")
if(CMAKE_CONFIGURATION_TYPES)
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/dev.json" CONTENT "${config}\n" CONDITION "$<CONFIG:Debug>")
else()
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/dev.json" CONTENT "${config}\n")
endif()
