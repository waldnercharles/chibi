                            data.Field.Named("to", data.Value.Text("800.variation"))
                        ]),
                        data.Object([
                            data.Field.Named("from", data.Value.Text("500.Value")),
                            data.Field.Named("to", data.Value.Text("900.Strength"))
                        ]),
                        data.Object([
                            data.Field.Named("from", data.Value.Text("600.Value")),
                            data.Field.Named("to", data.Value.Text("700.spacing"))
                        ]),
                        data.Object([
