diff --git a/src/cute_graphics_sdlgpu.cpp b/src/cute_graphics_sdlgpu.cpp
index 3ea8eec5..5a50db9f 100644
--- a/src/cute_graphics_sdlgpu.cpp
+++ b/src/cute_graphics_sdlgpu.cpp
@@ -941,6 +941,59 @@ SDL_GPUCommandBuffer* cf_sdlgpu_get_command_buffer()
 	return g_ctx.cmd;
 }
 
+SDL_GPURenderPass* cf_sdlgpu_begin_imgui_render_pass(CF_Canvas canvas_handle)
+{
+	CF_CanvasInternal* canvas = (CF_CanvasInternal*)canvas_handle.id;
+	CF_ASSERT(canvas);
+	CF_ASSERT(g_ctx.cmd);
+	if (g_ctx.active_pass && g_ctx.canvas != canvas) s_end_active_pass();
+	g_ctx.canvas = canvas;
+	if (g_ctx.active_pass) return g_ctx.active_pass;
+
+	int target_count = canvas->attached_depth ? 0 : (canvas->target_count > 1 ? canvas->target_count : 1);
+	SDL_GPUColorTargetInfo color_infos[CF_MAX_CANVAS_TARGETS];
+	CF_MEMSET(color_infos, 0, sizeof(color_infos));
+	for (int i = 0; i < target_count; ++i) {
+		SDL_GPUColorTargetInfo& color = color_infos[i];
+		color.texture = i == 0 ? canvas->texture : canvas->textures_mrt[i];
+		color.load_op = SDL_GPU_LOADOP_LOAD;
+		color.store_op = canvas->sample_count == CF_SAMPLE_COUNT_1
+			? SDL_GPU_STOREOP_STORE
+			: SDL_GPU_STOREOP_RESOLVE_AND_STORE;
+		color.resolve_texture = canvas->resolve_texture;
+		if (canvas->attached) {
+			color.layer_or_depth_plane = (Uint32)canvas->attach_layer;
+			color.mip_level = (Uint32)canvas->attach_mip;
+		}
+	}
+
+	SDL_GPUDepthStencilTargetInfo depth_info;
+	CF_MEMSET(&depth_info, 0, sizeof(depth_info));
+	SDL_GPUDepthStencilTargetInfo* depth = NULL;
+	if (canvas->depth_stencil) {
+		depth_info.texture = canvas->depth_stencil;
+		depth_info.load_op = SDL_GPU_LOADOP_LOAD;
+		depth_info.store_op = SDL_GPU_STOREOP_STORE;
+		depth_info.stencil_load_op = SDL_GPU_LOADOP_LOAD;
+		depth_info.stencil_store_op = SDL_GPU_STOREOP_STORE;
+		depth_info.mip_level = (Uint8)(canvas->attached_depth ? canvas->attach_mip : 0);
+		depth_info.layer = (Uint8)(canvas->attached_depth ? canvas->attach_layer : 0);
+		depth = &depth_info;
+	}
+
+	SDL_GPURenderPass* pass = SDL_BeginGPURenderPass(g_ctx.cmd, color_infos, (Uint32)target_count, depth);
+	CF_ASSERT(pass);
+	g_ctx.active_pass = pass;
+	canvas->pass = pass;
+	canvas->clear = false;
+	return pass;
+}
+
+void cf_sdlgpu_end_imgui_render_pass()
+{
+	s_end_active_pass();
+}
