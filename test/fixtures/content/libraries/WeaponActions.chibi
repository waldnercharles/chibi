WeaponActions :: library {
    Check_Firing_Interval :: (Elapsed: float = 0.0, Cooldown: float = 0.0) -> (Ready: bool = false, Remainder: float = 0.0) {
        return (entry.Elapsed >= max(entry.Cooldown, B: float = 0.01), entry.Elapsed - max(entry.Cooldown, B: float = 0.01))
    }
    Fire_Projectile :: (Origin: struct<CF_V2> = null, Direction: struct<CF_V2> = null, Damage: int = 0, Prototype: Prototype = Projectile, Shooter: handle<ecs.entity> = 0) -> (Entity: handle<ecs.entity> = 0) {
        action spawn_prototype_action = spawn_prototype(entry.Prototype)
        after spawn_prototype_action {
            spawn_prototype_action.Entity.Transform = entry.Origin
            spawn_prototype_action.Entity.Velocity = vec2_norm(entry.Direction).Result * spawn_prototype_action.Entity.Projectile.speed
            spawn_prototype_action.Entity.Orientation = DirectionMath.Direction_Orientation(vec2_norm(entry.Direction).Result.x, vec2_norm(entry.Direction).Result.y)
            spawn_prototype_action.Entity.Projectile.damage = entry.Damage
            spawn_prototype_action.Entity.Collider.ignore_entity = entry.Shooter
            return spawn_prototype_action.Entity
        }
        after entry {
            spawn_prototype_action()
        }
    }
}
