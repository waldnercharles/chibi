package scalar_llvm_tests

import facts "project:scalar_facts"
import scalar "project:scalar_llvm"
import strings "core:strings"

Row :: (kind: int, type: int, value: int, count: int, name: string, start: int, end: int, line: int,
        column: int) -> facts.Row {
    return {kind: kind, type: type, value: value, count: count, literal: 0, name: name, text: "", start: start,
            end: end, line: line, column: column};
}
Literal :: (type: int, literal: i64, start: int, end: int, line: int, column: int) -> facts.Row {
    row := Row(facts.LiteralRow, type, 0, 0, "", start, end, line, column);
    row.literal = literal;
    return row;
}
// Synthetic representation fixture, not a substitute for the real producer:
// Main calls Pick(7, true), which returns its int parameter.
pub Accepted :: () -> facts.Row[] {
    source: facts.Row = {kind: facts.SourceRow, type: 0, value: 0, count: 0, literal: 0, name: "Scalar.chibi",
                         text: "package scalar\nMain :: () -> int { return Pick(7, true); }\nPick :: (x: int, b: bool) -> int { return x; }",
                         start: 0, end: 0, line: 0, column: 0};
    return [
        source, Row(facts.DocumentRow, 0, 0, 0, "project:Scalar.chibi", 0, 0, 0, 0),
        Row(facts.FunctionRow, facts.IntType, 0, 0, "Main", 15, 58, 2, 1),
        Row(facts.ReturnRow, 0, 0, 3, "", 35, 56, 2, 21),
        Literal(facts.IntType, 7, 47, 48, 2, 33),
        Literal(facts.BoolType, 1, 50, 54, 2, 36),
        Row(facts.CallRow, facts.IntType, 1, 2, "Pick", 42, 55, 2, 28),
        Row(facts.FunctionRow, facts.IntType, 0, 2, "Pick", 59, 105, 3, 1),
        Row(facts.ParameterRow, facts.IntType, 0, 0, "x", 68, 69, 3, 10),
        Row(facts.ParameterRow, facts.BoolType, 1, 0, "b", 76, 77, 3, 18),
        Row(facts.ReturnRow, 0, 0, 1, "", 94, 103, 3, 36),
        Row(facts.ReadRow, facts.IntType, 0, 0, "", 101, 102, 3, 43),
    ];
}
pub Rejected :: () -> facts.Row[] {
    source: facts.Row = {kind: facts.SourceRow, type: 0, value: 0, count: 0, literal: 0, name: "Bad.chibi", text: "bad",
                         start: 0, end: 0, line: 0, column: 0};
    rejection: facts.Row = {kind: facts.RejectionRow, type: 0, value: 0, count: 0, literal: 0, name: "",
                            text: "expected package", start: 0, end: 3, line: 1, column: 1};
    return [source, rejection];
}

Kind: int : 0;
Type: int : 1;
Value: int : 2;
Count: int : 3;
Start: int : 4;
Column: int : 5;
LiteralValue: int : 6;
// A copy of rows with one integer field of one row replaced.
Changed :: (rows: facts.Row[], index: int, field: int, value: int) -> facts.Row[] {
    row := rows[index];
    switch field {
        case Kind:
            row.kind = value;
        case Type:
            row.type = value;
        case Value:
            row.value = value;
        case Count:
            row.count = value;
        case Start:
            row.start = value;
        case Column:
            row.column = value;
        case LiteralValue:
            row.literal = i64(value);
    }
    rows[index] = row;
    return rows;
}
Renamed :: (rows: facts.Row[], index: int, name: string, text: string) -> facts.Row[] {
    row := rows[index];
    row.name = name;
    row.text = text;
    rows[index] = row;
    return rows;
}
Invalid :: (rows: facts.Row[]) -> bool {
    if (scalar.Validate(rows) == "" || length(scalar.EmitBytes(rows)) != 0) {
        return false;
    }
    switch scalar.Emit(rows) {
        case .Invalid(message):
            return message != "";
        case .Rejected(projection):
            return false;
        case .Emitted(text):
            return false;
    }
}
Emitted :: (rows: facts.Row[]) -> string {
    if (scalar.Validate(rows) != "" || length(scalar.EmitBytes(rows)) == 0) {
        return "";
    }
    switch scalar.Emit(rows) {
        case .Invalid(message):
            return "";
        case .Rejected(projection):
            return "";
        case .Emitted(text):
            return text;
    }
}

// The accepted module with Pick's read of its int parameter replaced by a
// call of Main, so the two functions recurse.
Recursive :: () -> facts.Row[] {
    return Renamed(Changed(Changed(Accepted(), 11, Kind, facts.CallRow), 11, Value, 0), 11, "Main", "");
}
// Each fixture changes one fact of an otherwise valid module.
MalformedCount: int : 26;
Malformed :: (index: int) -> facts.Row[] {
    rows := Accepted();
    switch index {
        case 0:
            return Renamed(rows, 1, "", ""); // document key
        case 1:
            return Changed(rows, 0, Start, 1); // located source
        case 2:
            return Renamed(rows, 2, "Main", "x"); // function text
        case 3:
            return Changed(rows, 2, Type, facts.BoolType); // entry result
        case 4:
            return Changed(rows, 2, Count, 9); // too many parameters
        case 5:
            return Changed(rows, 3, Count, 0); // empty return
        case 6:
            return Changed(rows, 3, Count, 2); // return/operand layout
        case 7:
            return Changed(rows, 4, Kind, 9); // operand kind
        case 8:
            return Changed(rows, 4, Start, 10); // operand outside its return
        case 9:
            return Changed(rows, 4, Column, 34); // operand column
        case 10:
            return Changed(rows, 5, LiteralValue, 2); // noncanonical bool
        case 11:
            return Changed(rows, 5, Type, facts.IntType); // argument type
        case 12:
            return Changed(rows, 6, Value, 2); // callee index
        case 13:
            return Changed(rows, 6, Value, -1); // callee index
        case 14:
            return Renamed(rows, 6, "Other", ""); // callee name
        case 15:
            return Changed(rows, 6, Type, facts.BoolType); // callee result
        case 16:
            return Changed(rows, 6, Count, 1); // callee arity
        case 17:
            return Changed(rows, 6, Count, 3); // more arguments than operands
        case 18:
            return Changed(rows, 8, Value, 1); // parameter ordinal
        case 19:
            return Changed(rows, 9, Type, 99); // parameter type
        case 20:
            return Changed(rows, 11, Value, 1); // read of the bool parameter as int
        case 21:
            return Changed(rows, 11, Value, 2); // read outside the parameters
        case 22:
            return Renamed(Recursive(), 11, "Other", ""); // recursive callee name
        case 23:
            rejected := Rejected();
            rejected.append(rows[2]);
            return rejected; // rejection keeps a partial result
        case 24:
            return Renamed(Rejected(), 1, "", ""); // rejection without a message
    }
    return Changed(Rejected(), 1, Start, 4); // rejection outside its source
}

pub Tests :: () -> int {
    text := Emitted(Accepted());
    if (!strings.Contains(text, "define i32 @chibi_scalar()") ||
        !strings.Contains(text, "define internal i32 @chibi_scalar.1(i32 %arg0, i1 %arg1)") ||
        !strings.Contains(text, "call i32 @chibi_scalar.1(i32 %c3_0, i1 %c3_1)") ||
        !strings.Contains(text, "store i32 1, ptr %budget0") || !strings.Contains(text, "icmp sgt i32 %remaining0, 0") ||
        !strings.Contains(text, "store i32 7, ptr %s0") || !strings.Contains(text, "store i1 1, ptr %s1")) {
        return 1;
    }
    rejected := Rejected();
    if (scalar.Validate(rejected) != "" || length(scalar.EmitBytes(rejected)) != 0) {
        return 2;
    }
    switch scalar.Emit(rejected) {
        case .Invalid(message):
            return 3;
        case .Emitted(output):
            return 4;
        case .Rejected(projection):
            if (length(projection) != 2 || projection[0].text != "bad" || projection[1].text != "expected package" ||
                projection[1].end != 3) {
                return 5;
            }
    }
    for (index in 0..<MalformedCount) {
        if (!Invalid(Malformed(index))) {
            return 100 + index;
        }
    }
    // Recursive functions call each other directly, with no depth counter.
    recursive := Emitted(Recursive());
    if (!strings.Contains(recursive, "call i32 @chibi_scalar()") ||
        !strings.Contains(recursive, "call i32 @chibi_scalar.1(i32 %c3_0, i1 %c3_1)") ||
        strings.Contains(recursive, "depth")) {
        return 8;
    }
    // A coherent fabricated value is not authenticated by shape checks. Only
    // producer/source/envelope binding establishes source semantics.
    if (!strings.Contains(Emitted(Changed(Accepted(), 4, LiteralValue, 8)), "store i32 8, ptr %s0")) {
        return 7;
    }
    return 0;
}
