package asset_compiler_cache_tests

import cache "graph:asset_compiler"
import os "core:os"
import strings "core:strings"

// The asset compiler's machine-wide product cache: where it lives, how stamps
// read, and which products go when the directory outgrows its budget.

Fresh :: () -> string {
    made := os.Capture(["mktemp", "-d"]);
    assert(made.status == 0, "a scratch directory");
    return strings.TrimSpace(made.stdout);
}

Clean :: (directory: string) {
    assert(os.Capture(["rm", "-rf", directory]).status == 0, "cleanup");
}

Product :: (directory: string, name: string, size: int) {
    assert(os.WriteText(format_text("{}/{}", directory, name), strings.Repeat("x", size)) == nil, "a product");
}

LocationPrefersTheOverrideThenTheMachineCache :: () {
    assert(cache.Location("/tmp/mine", "/xdg", "/home/me", "/checkout") == "/tmp/mine", "the override");
    assert(cache.Location("", "/xdg", "/home/me", "/checkout") == "/xdg/chibi/asset-compiler-cache", "XDG_CACHE_HOME");
    assert(cache.Location("", "", "/home/me", "/checkout") == "/home/me/.cache/chibi/asset-compiler-cache", "HOME");
    assert(cache.Location("", "", "", "/checkout") == "/checkout/.chibi/asset-compiler-cache", "the checkout");
    assert(cache.Location("off", "/xdg", "/home/me", "/checkout") == "", "off keeps nothing");
}

StampsReadSizeAndModifiedTime :: () {
    stamp := "16777232:123:4096:100644:1700000000.000000007:1700000001.000000000";
    assert(cache.StampSize(stamp) == 4096, "size");
    assert(cache.StampModified(stamp) == 1700000000000000007, "modified nanoseconds");
    assert(cache.StampSize("") == 0 && cache.StampModified("not a stamp") == 0, "malformed stamps read as zero");
}

// With 400 bytes held and 250 allowed, the oldest unkept products go until 250
// remain: b then c, never the kept a, never the newest d.
EvictionRemovesTheOldestUnkeptFirst :: () {
    directory := Fresh();
    for (name in ["a", "b", "c", "d"]) {
        Product(directory, name, 100);
        os.Capture(["sleep", "0.05"]);
    }
    Product(directory, "e.new", 500);
    left := cache.Evict(directory, 250, ["a"]);
    assert(left == 200, "bytes left");
    assert(os.Exists(format_text("{}/a", directory)), "a is kept");
    assert(!os.Exists(format_text("{}/b", directory)) && !os.Exists(format_text("{}/c", directory)), "b and c are gone");
    assert(os.Exists(format_text("{}/d", directory)), "d is newest");
    assert(os.Exists(format_text("{}/e.new", directory)), "a half-written file is left alone");
    Clean(directory);
}

EvictionStopsWhenOnlyKeptProductsRemain :: () {
    directory := Fresh();
    Product(directory, "a", 100);
    Product(directory, "b", 100);
    left := cache.Evict(directory, 10, ["a", "b"]);
    assert(left == 200 && os.Exists(format_text("{}/a", directory)) && os.Exists(format_text("{}/b", directory)), "kept products stay over budget");
    assert(cache.Evict(format_text("{}/missing", directory), 10, []) == 0, "a missing directory holds nothing");
    Clean(directory);
}

RefreshRewritesAnOldProductOnly :: () {
    directory := Fresh();
    Product(directory, "a", 100);
    path := format_text("{}/a", directory);
    before := os.Stamp(path);
    cache.Refresh(path, 0);
    assert(os.Stamp(path) == before, "a recent product is left alone");
    cache.Refresh(path, 4000000000);
    assert(os.Stamp(path) != before && cache.StampSize(os.Stamp(path)) == 100, "an old product is rewritten");
    assert(!os.Exists(format_text("{}.refresh", path)), "no temporary file remains");
    Clean(directory);
}

// A stand-in compiler host: it counts its invocations in `host.calls` and writes
// `marker` to the output, the last argument, as the real host writes the product.
FakeHost :: (host: string, marker: string) {
    script := format_text("#!/bin/sh\nset -eu\nprintf x >> \"$0.calls\"\nwhile [ \"$#\" -gt 1 ]; do shift; done\nprintf '{}' > \"$1\"\n", marker);
    assert(os.WriteText(host, script) == nil, "a fake host");
    assert(os.Run(["chmod", "+x", host]) == 0, "executable");
}

Text :: (path: string) -> string {
    read := os.ReadText(path);
    assert(read.error == nil, "a readable file");
    return read.text;
}

Calls :: (host: string) -> string {
    return Text(format_text("{}.calls", host));
}

// The seed calls natives in the host, so the host's bytes are part of a product's
// identity: the same seed, request and target under another host rebuilds.
KeyBindsTheHostTheSeedAndTheRequest :: () {
    directory := Fresh();
    host := format_text("{}/host", directory);
    seed := format_text("{}/seed", directory);
    assert(os.WriteText(seed, "seed") == nil, "a seed");
    FakeHost(host, "first");
    first := cache.Key(host, seed, "request");
    assert(first != "" && first == cache.Key(host, seed, "request"), "a stable key");
    copied := format_text("{}/copy", directory);
    assert(os.Copy(host, copied) == nil && cache.Key(copied, seed, "request") == first, "equal bytes at another path");
    FakeHost(host, "second");
    assert(cache.Key(host, seed, "request") != first, "a host-only change");
    assert(cache.Key(host, seed, "other") != cache.Key(host, seed, "request"), "a changed request");
    assert(os.WriteText(seed, "other seed") == nil && cache.Key(host, seed, "request") != first, "a changed seed");
    assert(cache.Key(format_text("{}/missing", directory), seed, "request") == "", "a missing host");
    assert(cache.Key(host, format_text("{}/missing", directory), "request") == "", "a missing seed");
    Clean(directory);
}

// A product is reused under its key and made again under another; without a
// key nothing runs and nothing is written.
ProductsFollowTheirKeys :: () {
    directory := Fresh();
    host := format_text("{}/host", directory);
    seed := format_text("{}/seed", directory);
    store := format_text("{}/store", directory);
    output := format_text("{}/output", directory);
    inputs := format_text("{}/input", directory);
    assert(os.WriteText(seed, "seed") == nil, "a seed");
    FakeHost(host, "first");
    assert(!cache.Product(host, seed, "entry", "request", "", output, store, "1000", inputs), "no key, no product");
    assert(!os.Exists(output) && !os.Exists(store) && !os.Exists(inputs) && !os.Exists(format_text("{}.calls", host)), "nothing ran or was written");
    first := cache.Key(host, seed, "request");
    assert(cache.Product(host, seed, "entry", "request", first, output, store, "1000", inputs), "a product");
    assert(Calls(host) == "x" && Text(output) == "first", "made once");
    assert(os.Remove(output) == nil && cache.Product(host, seed, "entry", "request", first, output, store, "1000", inputs), "a hit");
    assert(Calls(host) == "x" && Text(output) == "first", "a hit runs nothing");
    FakeHost(host, "second");
    second := cache.Key(host, seed, "request");
    assert(cache.Product(host, seed, "entry", "request", second, output, store, "1000", inputs), "another host");
    assert(Calls(host) == "xx" && Text(output) == "second", "made again under the new host's key");
    Clean(directory);
}

pub Run :: () -> int {
    LocationPrefersTheOverrideThenTheMachineCache();
    StampsReadSizeAndModifiedTime();
    EvictionRemovesTheOldestUnkeptFirst();
    EvictionStopsWhenOnlyKeptProductsRemain();
    RefreshRewritesAnOldProductOnly();
    KeyBindsTheHostTheSeedAndTheRequest();
    ProductsFollowTheirKeys();
    return 0;
}
