# Generic verification of an authored snapshot's files and directory inventory.
foreach(name sources.sha256 inventory.txt inventory-directories.txt)
    if(NOT EXISTS "${RESOURCE}/${name}")
        message(FATAL_ERROR "Source snapshot is incomplete; regenerate ${RESOURCE}")
    endif()
endforeach()
file(STRINGS "${RESOURCE}/sources.sha256" fingerprints)
foreach(record IN LISTS fingerprints)
    string(SUBSTRING "${record}" 0 64 expected)
    string(SUBSTRING "${record}" 65 -1 path)
    if(NOT EXISTS "${ROOT}/${path}")
        message(FATAL_ERROR "Source snapshot input is missing: ${path}; regenerate ${RESOURCE}")
    endif()
    file(SHA256 "${ROOT}/${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Source snapshot is stale: ${path}; regenerate ${RESOURCE}")
    endif()
endforeach()
file(STRINGS "${RESOURCE}/inventory-directories.txt" directories)
set(inventory "")
foreach(directory IN LISTS directories)
    file(GLOB_RECURSE paths LIST_DIRECTORIES false RELATIVE "${ROOT}" "${ROOT}/${directory}/*.chibi")
    list(SORT paths)
    foreach(path IN LISTS paths)
        string(APPEND inventory "${path}\n")
    endforeach()
endforeach()
file(READ "${RESOURCE}/inventory.txt" expected_inventory)
if(NOT inventory STREQUAL expected_inventory)
    message(FATAL_ERROR "Source snapshot inventory changed; regenerate ${RESOURCE}")
endif()
