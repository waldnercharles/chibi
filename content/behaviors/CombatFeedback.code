behavior "CombatFeedback" {
    owner "ecs.entity";
    state "Hit Duration": float = 0.14;
    state "Hit Strength": float = 2.0;
    state "Dash Strength": float = 1.8;
    state "Hit Remaining": float = 0.0;
    action update_dash_glow = "Update Dash Glow"();
    on Damaged as damaged(Amount: int = 0, Source: handle<"ecs.entity"> = 0) {
        "Start Hit Flash"();
    }
    on Tick as tick() {
        if (cast<double>(&state."Hit Remaining") > 0) {
            await "Update Hit Flash"();
            update_dash_glow();
        } else {
            update_dash_glow();
        }
    }
    function "Start Hit Flash"() -> () {
        depth_limit 64;
        value max: float = max(A: plain float = &state."Hit Duration", B: plain float = 0.001);
        after entry {
            await set_variable<"Hit Remaining">(Value: float = max);
            await set_material_parameter(Entity: self, Name: "Hit Flash", Value: plain float = &state."Hit Strength");
            return();
        }
    }
    function "Update Hit Flash"() -> () {
        depth_limit 64;
        value max_hitremaining_dt_0: double = (max(cast<double>(&state."Hit Remaining") - cast<double>(&delta), 0));
        value hitremaining_max_hitduration_0_001_hitstrength: double = (cast<double>(&state."Hit Remaining") / max(cast<double>(&state."Hit Duration"), 0.001) * cast<double>(&state."Hit Strength"));
        after entry {
            if (cast<double>(&state."Hit Remaining") < 0) {
                return();
            } else {
                await set_variable<"Hit Remaining">(Value: float = max_hitremaining_dt_0);
                await set_material_parameter(Entity: self, Name: "Hit Flash", Value: plain float = hitremaining_max_hitduration_0_001_hitstrength);
                return();
            }
        }
    }
    function "Update Dash Glow"() -> () {
        depth_limit 64;
        value has_gamedash = has_game_dash();
        value remaining_max_duration_0_001_dashstrength: double = (cast<double>(&component("GAME.GameDash", "remaining")) / max(cast<double>(&component("GAME.GameDash", "duration")), 0.001) * cast<double>(&state."Dash Strength"));
        after entry {
            if (has_gamedash) {
                await set_material_parameter(Entity: self, Name: "Dash Glow", Value: plain float = remaining_max_duration_0_001_dashstrength);
                return();
            } else {
                return();
            }
        }
    }
}
