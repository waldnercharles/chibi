FieldShapes :: library {
    Islands :: (X: number = 0.0, Y: number = 0.0) -> (Value: number = 0.0) {
        return field_smooth_union(field_min(field_circle(field_add(X, 90.0), Y, 65.0), field_box(field_subtract(X, 60.0), Y, 55.0, 85.0)), field_capsule(X, Y, -90.0, 0.0, 60.0, 0.0, 18.0), 15.0)
    }
}
