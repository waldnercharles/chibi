// The editor's tabs and icons for the engine's own components. A project's
// editor/Components.kdl overrides any of them. A component left out shows
// under Object without an icon.
components {
    EngineSystem icon="system"
    Aim tab="Gameplay"
    Appearance icon="shape"
    Body tab="Physics"
    Body3D tab="Physics"
    Camera icon="camera"
    Character3D tab="Physics"
    Collider tab="Physics"
    Collider3D tab="Physics"
    Combustion tab="Gameplay"
    Dash tab="Gameplay"
    Destructible tab="Physics" icon="diamond"
    DirectionalLight tab="Material" icon="light"
    Drive tab="Physics"
    Encounter tab="Gameplay"
    EncounterMember tab="Gameplay"
    Environment tab="Material"
    Experience tab="Gameplay"
    FluidVolume tab="Physics" icon="water"
    Fog tab="Material"
    FragmentGlow tab="Material"
    Fuel tab="Gameplay"
    Geometry3D tab="Material"
    Gravity tab="Physics"
    Gravity3D tab="Physics"
    HRC2D tab="Material" icon="light"
    Health tab="Gameplay" icon="health"
    Igniter tab="Gameplay"
    Input tab="Gameplay" icon="gamepad"
    Joint tab="Physics"
    Joint3D tab="Physics"
    Material tab="Material"
    MaterialCavity tab="Physics"
    MaterialFrame tab="Physics"
    // material_height consumes the bound static material Height in geometry.
    MaterialSurface3D tab="Material"
    TerrainVolume tab="Material"
    IndirectOccluder tab="Material"
    MeshAsset tab="Material"
    MeshParts tab="Material"
    MeshSurface2D tab="Material"
    Movement tab="Gameplay"
    ParticleEmitter icon="emitter"
    ParticleField3D tab="Material" icon="emitter"
    Pickup tab="Gameplay"
    PointLight tab="Material" icon="light"
    Projectile tab="Gameplay" icon="projectile"
    Reflection tab="Material"
    SdfSurface3D tab="Material"
    SensorContact tab="Physics"
    Shader tab="Material"
    SpawnRequest tab="Gameplay"
    SpotLight tab="Material" icon="light"
    Sprite tab="Material"
    Tilemap tab="Material"
    Starfield2D tab="Material"
    Substance tab="Physics"
    SurfaceInfluence tab="Material"
    SurfaceQuality tab="Material"
    Trail tab="Material"
    Velocity tab="Physics"
    Vision tab="Gameplay"
    Weapon tab="Gameplay"
    MaterialBreakProfile tab="Physics"
    MaterialConstitutive tab="Physics"
    MaterialDestructionWorld tab="Physics"
    MaterialFluidWorld tab="Physics"
    MaterialTerrain tab="Material" icon="terrain"
    MaterialThermal tab="Physics"
}
