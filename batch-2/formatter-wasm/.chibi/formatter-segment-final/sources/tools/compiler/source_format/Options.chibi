        return "Invalid formatter options: trailing_commas_arguments must be inherit, preserve, omit or multiline";
    }
    if (options.trailing_commas_parameters != -1 && options.trailing_commas_parameters != 0 && options.trailing_commas_parameters != 1 && options.trailing_commas_parameters != 2) {
        return "Invalid formatter options: trailing_commas_parameters must be inherit, preserve, omit or multiline";
    }
    if (options.trailing_commas_arrays != -1 && options.trailing_commas_arrays != 0 && options.trailing_commas_arrays != 1 && options.trailing_commas_arrays != 2) {
        return "Invalid formatter options: trailing_commas_arrays must be inherit, preserve, omit or multiline";
    }
    if (options.trailing_commas_records != -1 && options.trailing_commas_records != 0 && options.trailing_commas_records != 1 && options.trailing_commas_records != 2) {
        return "Invalid formatter options: trailing_commas_records must be inherit, preserve, omit or multiline";
    }
    if (options.trailing_commas_tuples != -1 && options.trailing_commas_tuples != 0 && options.trailing_commas_tuples != 1 && options.trailing_commas_tuples != 2) {
        return "Invalid formatter options: trailing_commas_tuples must be inherit, preserve, omit or multiline";
    }
    if (options.trailing_commas_bindings != -1 && options.trailing_commas_bindings != 0 && options.trailing_commas_bindings != 1 && options.trailing_commas_bindings != 2) {
        return "Invalid formatter options: trailing_commas_bindings must be inherit, preserve, omit or multiline";
    }
    if (options.start_line < 0 || options.start_line > 1000000) {
        return "Invalid formatter options: start_line must be 0..1000000";
    }
    if (options.end_line < 0 || options.end_line > 1000000) {
        return "Invalid formatter options: end_line must be 0..1000000";
    }
    if (options.range_scope != 0 && options.range_scope != 1) {
        return "Invalid formatter options: range_scope must be declarations or statements";
    }
    if (options.end_line > 0 && options.start_line > options.end_line) {
        return "Invalid formatter options: end_line must not precede start_line";
    }
    return "";
}

Number :: (text: string) -> int {
    if (text == "") { return -2147483648; }
    value: int = 0;
    negative := strings.ByteAt(text, 0) == 45;
    index: int = 0;
    if (negative) { index = 1; }
    if (index == strings.ByteLength(text)) { return -2147483648; }
    while (index < strings.ByteLength(text)) {
        digit := strings.ByteAt(text, index) - 48;
        if (digit < 0 || digit > 9 || value > 100000000) { return -2147483648; }
        value = value * 10 + digit;
        index += 1;
    }
    if (negative) { return -value; }
    return value;
}

pub ParseOptions :: (base: Options, text: string) -> (options: Options, error: string) {
    pairs: string[] = [];
    for (line in strings.SplitLines(text)) {
        content := line;
        hash := strings.IndexByte(line, 35);
        if (hash >= 0) { content = strings.Slice(line, 0, hash); }
        pairs.extend(strings.Fields(content));
    }
    options := base;
    for (pair in pairs) {
        if (strings.HasPrefix(pair, "profile=")) {
            value := strings.TrimPrefix(pair, "profile=");
            if (value == "current_v1") { options = Profile(0); }
            else if (value == "compact_v1") { options = Profile(1); }
            else if (value == "expanded_v1") { options = Profile(2); }
            else if (value == "tabular_v1") { options = Profile(3); }
            else { return (options, "Invalid formatter profile"); }
        }
    }
    for (pair in pairs) {
        equals := strings.IndexByte(pair, 61);
        if (equals <= 0) { return (options, format_text("Invalid formatter option {}; write NAME=VALUE", pair)); }
        name := strings.Slice(pair, 0, equals);
        value := strings.Slice(pair, equals + 1, strings.ByteLength(pair) - equals - 1);
        number := Number(value);
        if (name == "profile") { continue; }
        else if (name == "preferred_width" && number != -2147483648) { options.preferred_width = number; }
        else if (name == "magic_trailing_comma" && (value == "true" || value == "false")) { options.magic_trailing_comma = value == "true"; }
        else if (name == "use_tabs" && (value == "true" || value == "false")) { options.use_tabs = value == "true"; }
        else if (name == "indent_width" && number != -2147483648) { options.indent_width = number; }
        else if (name == "continuation_indent" && number != -2147483648) { options.continuation_indent = number; }
        else if (name == "align_after_open_bracket" && (value == "true" || value == "false")) { options.align_after_open_bracket = value == "true"; }
        else if (name == "align_operands" && (value == "true" || value == "false")) { options.align_operands = value == "true"; }
        else if (name == "indent_case_labels" && (value == "true" || value == "false")) { options.indent_case_labels = value == "true"; }
