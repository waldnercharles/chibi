package consumer

import facts "project:scalar_facts"

// Transport capability fixture, deliberately independent of package_compiler.
pub Read :: (proof: facts.NullaryPureInt32Return) -> int {
    if (!proof.accepted || proof.value != 42 || proof.name != "Main" || proof.path != "Main.chibi" ||
        proof.key != "/project/Main.chibi" || proof.text != "42" ||
        proof.declaration_start != 0 || proof.declaration_end != 2 ||
        proof.declaration_line != 1 || proof.declaration_column != 1 ||
        proof.body_start != 0 || proof.body_end != 2 || proof.body_line != 1 || proof.body_column != 1 ||
        proof.return_start != 0 || proof.return_end != 2 || proof.return_line != 1 || proof.return_column != 1 ||
        proof.expression_start != 0 || proof.expression_end != 2 ||
        proof.expression_line != 1 || proof.expression_column != 1 ||
        proof.diagnostic_start != 0 || proof.diagnostic_end != 0 ||
        proof.diagnostic_line != 0 || proof.diagnostic_column != 0 || proof.diagnostic_message != "") {
        return -1;
    }
    return proof.value;
}
