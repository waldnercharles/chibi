package managed_native_probe

import native "project:llvm_native"
import abi "project:native_abi"
import host "project:native_link_host"
import link "project:native_link"
import os "core:os"
import strings "core:strings"

Op :: (op: int, type: int, output: int, left: int, right: int, literal: i64) -> native.Instruction {
    return {op: op, type: type, output: output, left: left, right: right, target: 0, literal: literal};
}
Shape :: (slots: int[], code: native.Instruction[]) -> native.Function {
    return {result: abi.IntStorage, first_parameter: 0, parameters: 0,
        first_slot: 0, slots: length(slots), first_local: 0, locals: 0, first_code: 0, code: length(code),
        first_argument: 0, arguments: 0};
}
// A canonical scoped place starts null before any Save. Its initialized
// empty registration must not become a descriptor load through null.
NullPollEmission :: (target: abi.Target) -> native.Result {
    array := native.ArrayType + native.PointerType;
    slots := [abi.IntStorage];
    track := Op(native.ManagedTrack, native.RefType + array, 0, 0, 0, 0);
    track.target = native.ManagedTrackLocal;
    code := [track, Op(native.ManagedPoll, 0, 0, 0, 0, 0), Op(native.Constant, abi.IntStorage, 0, 0, 0, 0),
        Op(native.Publish, abi.IntStorage, 0, 0, 0, 0), Op(native.Return, 0, 0, 0, 0, 0)];
    shape := Shape(slots, code);
    shape.locals = 1;
    source: native.Source = {file: "", directory: ""};
    return native.EmitProgramTyped(target, [shape], [], slots, [native.RefType + array], code, [], [], [], [], [], source, [], [], []);
}
RecordEmission :: (target: abi.Target, mode: int) -> native.Result {
    number := abi.IntStorage;
    pointer := native.PointerType;
    first := native.RecordType;
    second := first + 1;
    slots := [first, number, first, pointer, pointer, native.RefType + number, number, number, number];
    projected := Op(native.ManagedProject, pointer, 4, 3, first, -123);
    if (mode == 1) { projected.right = second; projected.literal = -125; }
    if (mode == 2) { projected.target = 1; }
    if (mode == 3) { projected.literal = -999; }
    code := [Op(native.Constant, first, 0, 0, 0, 0), Op(native.Constant, number, 1, 0, 0, 7),
        Op(native.Insert, first, 2, 0, 1, 0), Op(native.ManagedNew, pointer, 3, 2, first, -700), projected,
        Op(native.ManagedAddress, native.RefType + number, 5, 4, 0, -123), Op(native.Deref, number, 6, 5, 0, 0),
        Op(native.Constant, number, 7, 0, 0, 7), Op(native.Sub, number, 8, 6, 7, 0),
        Op(native.Publish, number, 0, 8, 0, 0), Op(native.Return, 0, 0, 0, 0, 0)];
    records: native.Record[] = [{first: 0, count: 1, identity: -700}, {first: 1, count: 1, identity: -701}];
    tags: i64[] = [-123, -125];
    if (mode == 4) { records[0] = {first: 0, count: 1, identity: 0}; }
    if (mode == 5) { tags = [-123]; }
    source: native.Source = {file: "", directory: ""};
    return native.EmitProgramTyped(target, [Shape(slots, code)], [], slots, [], code, [], records,
        [number, number], tags, [], source, [], [], []);
}
// An optional's physical tag and nested plain payload are one typed cell.
// Its whole-only layout cannot be used to project an inline child address.
OptionalEmission :: (target: abi.Target, mode: int) -> native.Result {
    number := abi.IntStorage;
    child := native.RecordType;
    optional := child + 1;
    resolved := optional;
    tag: i64 = -701;
    if (mode == 1) { resolved = optional + 1; tag = -702; }
    if (mode == 2) { resolved = number; }
    slots := [number, child, child, number, optional, optional, optional, native.PointerType,
              native.RefType + resolved, resolved, child, number, number];
    code := [Op(native.Constant, number, 0, 0, 0, 7), Op(native.Constant, child, 1, 0, 0, 0),
        Op(native.Insert, child, 2, 1, 0, 0), Op(native.Constant, number, 3, 0, 0, 1),
        Op(native.Constant, optional, 4, 0, 0, 0), Op(native.Insert, optional, 5, 4, 3, 0),
        Op(native.Insert, optional, 6, 5, 2, 1), Op(native.ManagedNew, native.PointerType, 7, 6, optional, -701),
        Op(native.ManagedAddress, native.RefType + resolved, 8, 7, 0, tag),
        Op(native.Deref, resolved, 9, 8, 0, 0)];
    if (mode == 2) {
        code.extend([Op(native.Publish, number, 0, 9, 0, 0), Op(native.Return, 0, 0, 0, 0, 0)]);
    } else {
        code.extend([Op(native.Extract, child, 10, 9, resolved, 1), Op(native.Extract, number, 11, 10, child, 0),
            Op(native.Sub, number, 12, 11, 0, 0), Op(native.Publish, number, 0, 12, 0, 0),
            Op(native.Return, 0, 0, 0, 0, 0)]);
    }
    if (mode == 3) {
        code[8] = {op: native.ManagedProject, type: native.PointerType, output: 8, left: 7,
                   right: optional, target: 1, literal: -700};
        slots[8] = native.PointerType;
    }
    fields := [number, number, child];
    if (mode == 4) { fields[0] = abi.TextStorage; }
    records: native.Record[] = [{first: 0, count: 1, identity: 0}, {first: 1, count: 2, identity: -701}];
    tags: i64[] = [0, 0, 0];
    if (mode == 1) {
        records.append({first: 3, count: 2, identity: -702});
        fields.extend([number, child]);
        tags.extend([i64(0), 0]);
    }
    source: native.Source = {file: "", directory: ""};
    return native.EmitProgramTyped(target, [Shape(slots, code)], [], slots, [], code, [], records,
                                   fields, tags, [], source, [], [], []);
}
ArrayEmission :: (target: abi.Target, mode: int) -> native.Result {
    array := native.ArrayType + abi.IntStorage;
    if (mode == 3) { array = native.ArrayType + abi.TextStorage; }
    resolved := array;
    tag: i64 = -880;
    if (mode == 1) { tag = -881; }
    if (mode == 2) { resolved = native.ArrayType + abi.BoolStorage; }
    slots := [array, native.PointerType, native.RefType + resolved, resolved, abi.IntStorage];
    code := [Op(native.Constant, array, 0, 0, 0, 0),
        Op(native.ManagedNew, native.PointerType, 1, 0, array, -880),
        Op(native.ManagedAddress, native.RefType + resolved, 2, 1, 0, tag),
        Op(native.Deref, resolved, 3, 2, 0, 0), Op(native.ArrayLength, abi.IntStorage, 4, 3, 0, 0),
        Op(native.Publish, abi.IntStorage, 0, 4, 0, 0), Op(native.Return, 0, 0, 0, 0, 0)];
    return Emit(target, slots, code, false, [], []);
}
Emit :: (target: abi.Target, slots: int[], code: native.Instruction[], embedded: bool,
         records: native.Record[], fields: int[]) -> native.Result {
    shape := Shape(slots, code);
    source: native.Source = {file: "", directory: ""};
    empty: int[] = [];
    if (embedded) {
        return native.Emit(target, [shape], empty, slots, empty, code, empty, records, fields, [], source, [], empty, empty, false, 1);
    }
    return native.EmitProgram(target, [shape], empty, slots, empty, code, empty, records, fields, [], source, [], empty, empty);
}
Rejected :: (target: abi.Target, slots: int[], code: native.Instruction[], embedded: bool,
             records: native.Record[], fields: int[], expected: string) -> bool {
    switch Emit(target, slots, code, embedded, records, fields) {
        case .Emitted(text): os.Print(strings.Concatenate(["accepted invalid managed IR: ", expected])); return false;
        case .Rejected(instruction, message):
            if (!strings.Contains(message, expected)) { os.Print(message); return false; }
    }
    return true;
}
Main :: () -> int {
    args := os.Arguments();
    if (length(args) == 2 && args[0] == "--weak-null") {
        switch NullPollEmission(abi.LinuxX64()) {
            case .Rejected(instruction, message): os.Print(message); return 1;
            case .Emitted(text):
                if (os.WriteText(args[1], text)) { return 2; }
        }
        return 0;
    }
    if (length(args) != 4) { return 2; }
    work := args[0];
    llvm := args[1];
    fixture := os.ReadText(args[2]);
    if (fixture.error) { return 2; }
    audit := os.ReadText(args[3]);
    if (audit.error) { return 2; }
    target := abi.LinuxX64();
    if (os.Platform() == "Darwin") { target = abi.MacOSArm64(); }
    number := abi.IntStorage;
    pointer := native.PointerType;
    reference := native.RefType + number;
    array := native.ArrayType + pointer;
    // A negative tag pins full u64 identity bits through the signed literal.
    slots := [number, pointer, reference, number, abi.BoolStorage, pointer, abi.BoolStorage, array, array, number];
    code := [Op(native.Constant, number, 0, 0, 0, 7),
        Op(native.ManagedNew, pointer, 1, 0, number, -123),
        Op(native.ManagedAddress, reference, 2, 1, 0, -123),
        Op(native.Deref, number, 3, 2, 0, 0),
        Op(native.Eq, pointer, 4, 1, 1, 0),
        {op: native.Branch, type: 0, output: 0, left: 4, right: 0, target: 7, literal: 0},
        Op(native.TypedFail, 0, 0, 0, 0, 4),
        Op(native.ManagedNew, pointer, 5, 0, number, -123),
        Op(native.Ne, pointer, 6, 1, 5, 0),
        {op: native.Branch, type: 0, output: 0, left: 6, right: 0, target: 11, literal: 0},
        Op(native.TypedFail, 0, 0, 0, 0, 4),
        Op(native.Constant, array, 7, 0, 0, 0),
        Op(native.ValueCopy, array, 8, 7, 0, 0),
        Op(native.ValueDrop, array, 0, 8, 0, 0),
        Op(native.Sub, number, 9, 3, 0, 0),
        Op(native.Publish, number, 0, 9, 0, 0), Op(native.Return, 0, 0, 0, 0, 0)];
    no_records: native.Record[] = [];
    empty: int[] = [];
    payload_code := [Op(native.Constant, array, 0, 0, 0, 0),
        Op(native.ManagedNew, pointer, 1, 0, array, -880),
        Op(native.Constant, number, 2, 0, 0, 0), Op(native.Publish, number, 0, 2, 0, 0),
        Op(native.Return, 0, 0, 0, 0, 0)];
    switch Emit(target, [array, pointer, number], payload_code, false, [], []) {
        case .Emitted(text): { }
        case .Rejected(instruction, message): os.Print(message); return 1;
    }
    // Pointer arrays now own traced cells; map cells remain outside this domain.
    map := native.MapType + number;
    payload_code[0] = Op(native.Constant, map, 0, 0, 0, 0);
    payload_code[1] = Op(native.ManagedNew, pointer, 1, 0, map, -880);
    if (!Rejected(target, [map, pointer, number], payload_code, false, [], [],
                  "native scalar slot cannot hold a managed value or pointer")) { return 1; }
    for (mode in 2..<6) {
        switch RecordEmission(target, mode) {
            case .Emitted(text): os.Print("accepted invalid managed record metadata or projection"); return 1;
            case .Rejected(instruction, message):
                expected := "projection differs from its typed record field";
                if (mode == 4) { expected = "initializer differs from its scalar type"; }
                if (mode == 5) { expected = "identities differ from the field table"; }
                if (!strings.Contains(message, expected)) { os.Print(message); return 1; }
        }
    }
    for (mode in [int(3), 4]) {
        switch OptionalEmission(target, mode) {
            case .Emitted(text): os.Print("accepted an unsafe optional cell layout or projection"); return 1;
            case .Rejected(instruction, message):
                expected := "projection differs";
                if (mode == 4) { expected = "metadata requires scalar, text or pointer fields"; }
                if (!strings.Contains(message, expected)) { os.Print(message); return 1; }
        }
    }
    metadata: native.Record[] = [{first: 0, count: 1, identity: -700}];
    source: native.Source = {file: "", directory: ""};
    for (valid in [true, false]) {
        tags: i64[] = [];
        if (valid) { tags.append(-123); }
        switch native.EmitProgramTyped(target, [Shape(slots, code)], empty, slots, empty, code, empty,
                                        metadata, [number], tags, [], source, [], empty, empty) {
            case .Emitted(text): if (!valid) { os.Print("accepted an incomplete field identity table"); return 1; }
            case .Rejected(instruction, message):
                if (valid || !strings.Contains(message, "identities differ from the field table")) { os.Print(message); return 1; }
        }
    }
    if (!Rejected(target, slots, code, true, no_records, empty, "standalone collector owner") ||
        !Rejected(abi.WebAssembly32(), slots, code, false, no_records, empty, "WebAssembly managed pointers") ||
        !Rejected(target, slots, code, false, [{first: 0, count: 1, identity: 0}], [native.ViewType], "aggregate roots")) { return 1; }
    // Inline pointer roots and active backing owners need no nominal cell
    // identity. Unsupported view aggregates retain the rejection above.
    for leaf in [pointer, array] {
        switch Emit(target, slots, code, false, [{first: 0, count: 1, identity: 0}], [leaf]) {
            case .Emitted(text): { }
            case .Rejected(instruction, message): os.Print(message); return 1;
        }
    }
    invalid := code;
    wrong := invalid[1];
    wrong.literal = 0;
    invalid[1] = wrong;
    if (!Rejected(target, slots, invalid, false, no_records, empty, "identity is invalid")) { return 1; }
    invalid = code;
    invalid[1] = Op(native.Constant, pointer, 1, 0, 0, 1);
    if (!Rejected(target, slots, invalid, false, no_records, empty, "outside its type")) { return 1; }
    invalid = code;
    wrong = invalid[1];
    wrong.right = abi.TextStorage;
    invalid[1] = wrong;
    if (!Rejected(target, slots, invalid, false, no_records, empty, "initializer differs")) { return 1; }
    membership := [Op(native.Constant, array, 0, 0, 0, 0), Op(native.Constant, pointer, 1, 0, 0, 0),
        Op(native.ArrayContains, abi.BoolStorage, 2, 0, 1, i64(pointer)),
        Op(native.Constant, number, 3, 0, 0, 0), Op(native.Publish, number, 0, 3, 0, 0),
        Op(native.Return, 0, 0, 0, 0, 0)];
    if (!Rejected(target, [array, pointer, abi.BoolStorage, number], membership, false, no_records, empty,
                  "array operation differs from its operands")) { return 1; }
    pin_slots := [number, array, pointer];
    pinned := [Op(native.Constant, number, 0, 0, 0, 7), Op(native.Constant, array, 1, 0, 0, 0),
        Op(native.Jump, 0, 0, 0, 0, 0), Op(native.ManagedPin, array, 0, 1, 0, 0),
        Op(native.ManagedNew, pointer, 2, 0, number, -123), Op(native.ManagedUnpin, 0, 0, 0, 0, 0),
        Op(native.Publish, number, 0, 0, 0, 0), Op(native.Return, 0, 0, 0, 0, 0)];
    jump := pinned[2];
    jump.target = 3;
    pinned[2] = jump;
    switch Emit(target, pin_slots, pinned, false, no_records, empty) {
        case .Rejected(instruction, message): os.Print(message); return 1;
        case .Emitted(text): {}
    }
    for (destination in [int(4), 5]) {
        invalid = pinned;
        jump.target = destination;
        invalid[2] = jump;
        if (!Rejected(target, pin_slots, invalid, false, no_records, empty, "cannot enter a collector pin region")) { return 1; }
    }
    invalid = pinned;
    wrong = invalid[5];
    wrong.right = 1;
    invalid[5] = wrong;
    if (!Rejected(target, pin_slots, invalid, false, no_records, empty, "close in reverse order")) { return 1; }
    invalid = pinned;
    wrong = invalid[3];
    wrong.left = 0;
    invalid[3] = wrong;
    if (!Rejected(target, pin_slots, invalid, false, no_records, empty, "owning array place")) { return 1; }
    text := "";
    switch Emit(target, slots, code, false, no_records, empty) {
        case .Rejected(instruction, message): os.Print(message); return 1;
        case .Emitted(module): text = module;
    }
    text = strings.ReplaceAll(text, "define i32 @chibi_scalar(ptr %ctx)", "define i32 @managed_native.entry(ptr %ctx)");
    text = strings.ReplaceAll(text, "call void @chibi_managed.trace.pointer(ptr %heap, ptr %at)",
        "call void @managed_runtime.visit(ptr %heap, ptr %at)");
    start := strings.Concatenate([work, "/native-start.ll"]);
    if (os.WriteText(start, link.ManagedProgramContext(link.ProgramStart(target.triple, false, true, false)))) { return 2; }
    for (mode in ["positive", "persistent", "typed_layout", "untraced_layout", "bad_layout_storage", "bad_layout_identity", "bad_layout_root",
                  "wrong_tag", "wrong_storage", "wrong_range", "nil", "wrong_owner", "array_owner", "epoch_wrap",
                  "code_underflow", "code_overflow", "no_layout_drop", "poll_null", "record", "record_parent",
                  "array_cell", "array_cell_tag", "array_cell_storage", "text_array_cell", "optional_cell", "optional_cell_tag", "optional_cell_storage"]) {
        module := format_text("{}/native-{}.ll", work, mode);
        body := format_text("\ndefine i32 @managed_source.entry(ptr %ctx) {{\n  %native = call i32 @managed_native.entry(ptr %ctx)\n  %runtime = call i32 @managed_runtime.{}(ptr %ctx)\n  %result = or i32 %native, %runtime\n  ret i32 %result\n}}\n", mode);
        current := strings.Concatenate([text, fixture.text, body]);
        if (mode == "record" || mode == "record_parent") {
            record_mode := 0;
            if (mode == "record_parent") { record_mode = 1; }
            switch RecordEmission(target, record_mode) {
                case .Rejected(instruction, message): os.Print(message); return 1;
                case .Emitted(emitted):
                    current = strings.ReplaceAll(emitted, "define i32 @chibi_scalar(ptr %ctx)",
                        "define i32 @managed_source.entry(ptr %ctx)");
            }
        }
        if (mode == "array_cell" || mode == "array_cell_tag" || mode == "array_cell_storage" || mode == "text_array_cell") {
            array_mode := 0;
            if (mode == "array_cell_tag") { array_mode = 1; }
            if (mode == "array_cell_storage") { array_mode = 2; }
            if (mode == "text_array_cell") { array_mode = 3; }
            switch ArrayEmission(target, array_mode) {
                case .Rejected(instruction, message): os.Print(message); return 1;
                case .Emitted(emitted):
                    current = strings.ReplaceAll(emitted, "define i32 @chibi_scalar(ptr %ctx)",
                        "define i32 @managed_source.entry(ptr %ctx)");
            }
        }
        if (mode == "optional_cell" || mode == "optional_cell_tag" || mode == "optional_cell_storage") {
            optional_mode := 0;
            if (mode == "optional_cell_tag") { optional_mode = 1; }
            if (mode == "optional_cell_storage") { optional_mode = 2; }
            switch OptionalEmission(target, optional_mode) {
                case .Rejected(instruction, message): os.Print(message); return 1;
                case .Emitted(emitted):
                    current = strings.ReplaceAll(emitted, "define i32 @chibi_scalar(ptr %ctx)",
                        "define i32 @managed_source.entry(ptr %ctx)");
            }
        }
        if (mode == "poll_null") {
            switch NullPollEmission(target) {
                case .Rejected(instruction, message): os.Print(message); return 1;
                case .Emitted(emitted):
                    current = strings.ReplaceAll(emitted, "define i32 @chibi_scalar(ptr %ctx)",
                        "define i32 @managed_poll.entry(ptr %ctx)");
                    current = strings.Concatenate([current, format_text("\ndefine i32 @managed_source.entry(ptr %ctx) {{\n  %heap = call ptr @chibi_managed.owner(ptr %ctx)\n  %at = getelementptr %chibi.managed.heap, ptr %heap, i32 0, i32 {}\n  store i1 true, ptr %at\n  %result = call i32 @managed_poll.entry(ptr %ctx)\n  ret i32 %result\n}}\n", abi.ManagedRequestedField)]);
            }
        }
        if (os.WriteText(module, strings.Concatenate([current, audit.text]))) { return 2; }
        for (level in [int(0), 2]) {
            output := format_text("{}/native-{}-O{}", work, mode, level);
            objects := [strings.Concatenate([output, ".o"]), strings.Concatenate([output, "-start.o"])];
            if (host.Objects(llvm, [module, start], objects, level, 1)) { return 1; }
            plan := link.Program(target.triple, llvm, objects, [], [], [], output, "", false);
            if (os.Platform() == "Darwin") {
                runtime: link.Import = {name: "System", symbols: ["malloc", "calloc", "free", "printf", "write", "dprintf", "abort", "__error"]};
                plan.imports = [runtime];
            }
            if (host.Link(plan)) { return 1; }
            result := os.Capture([output]);
            valid := result.status == 0;
            trapped := mode == "epoch_wrap" || mode == "code_underflow" || mode == "code_overflow" || mode == "no_layout_drop";
            if (mode != "positive" && mode != "persistent" && mode != "typed_layout" && mode != "untraced_layout" && mode != "record" && mode != "poll_null" && mode != "array_cell" && mode != "text_array_cell" && mode != "optional_cell" && !trapped) {
                valid = result.status == 134 && strings.Contains(result.stderr, "native failure: another failure");
            }
            // Capture preserves negative signals; some runners encode 128+sig.
            // LLVM trap is SIGILL/SIGTRAP, distinct from audit99 or failure134.
            if (trapped) { valid = result.status == -4 || result.status == -5 || result.status == 132 || result.status == 133; }
            if (!valid) { os.Print(format_text("managed native {} O{} status{} {}{}", mode, level, result.status, result.stdout, result.stderr)); return 1; }
            os.Print(format_text("PASS managed native {} O{}", mode, level));
            if (mode == "positive") { os.Print(result.stdout); }
        }
    }
    return 0;
}
