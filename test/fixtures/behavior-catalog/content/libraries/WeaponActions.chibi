library "WeaponActions" {
    pure function "Check Firing Interval"(Elapsed: float = 0.0, Cooldown: float = 0.0) -> (Ready: bool = false, Remainder: float = 0.0) {
        return (greater_or_equal(entry.Elapsed, max(entry.Cooldown, B: float = 0.01)), subtract(entry.Elapsed, max(entry.Cooldown, B: float = 0.01)))
    }
    function "Fire Projectile"(Origin: struct<"CF_V2"> = null, Direction: struct<"CF_V2"> = null, Damage: int = 0, Prototype: name = "ArenaProjectile", Shooter: handle<"ecs.entity"> = 0) -> (Entity: handle<"ecs.entity"> = 0) {
        action spawn_prototype = engine["Spawn Prototype"](entry.Prototype)
        after spawn_prototype {
            await set_entity_game_transform(spawn_prototype.Entity, entry.Origin)
            await set_entity_game_velocity(spawn_prototype.Entity, multiply(vec2_norm(entry.Direction).Result, get_entity_game_projectile(spawn_prototype.Entity).Value.speed))
            await set_entity_game_orientation(spawn_prototype.Entity, "DirectionMath"."Direction Orientation"(vec2_norm(entry.Direction).Result.x, vec2_norm(entry.Direction).Result.y))
            await set_game_projectile_damage(entry.Damage, spawn_prototype.Entity)
            await set_game_collider_ignore_entity(entry.Shooter, spawn_prototype.Entity)
            return spawn_prototype.Entity
        }
        after entry {
            spawn_prototype()
        }
    }
}
