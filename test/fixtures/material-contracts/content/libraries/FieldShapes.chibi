library "FieldShapes" {
    pure function "Islands"(X: float = 0.0, Y: float = 0.0) -> (Value: float = 0.0) {
        value field_add = field_add(entry.X, 90.0)
        value field_circle = field_circle(field_add, entry.Y, 65.0)
        value field_subtract = field_subtract(entry.X, 60.0)
        value field_box = field_box(field_subtract, entry.Y, 55.0, 85.0)
        value field_min = field_min(field_circle, field_box)
        value field_capsule = field_capsule(entry.X, entry.Y, -90.0, 0.0, 60.0, 0.0, 18.0)
        value field_smooth_union = field_smooth_union(field_min, field_capsule, 15.0)
        return field_smooth_union
    }
}
