/* The behavior graph canvas (studio_graph.c), ported from the Studio prototype's
   graph styles. This document lives in its own context whose dp ratio is the
   zoom, so every length here is in graph units and scales with the view. */

body { width: 100%; height: 100%; margin: 0dp; padding: 0dp; overflow: hidden; }

body.graph-canvas {
    background-color: var(--canvas);
    /* Node categories. */
    --n-event: #7a2f42;
    --n-flow: #46464e;
    --n-pure: #2f4a36;
    --n-function: #2d4f7a;
    --n-variable: #5a3a2c;
    --n-literal: #6b5530;
    --n-expr: #245e6c;
    --n-call: #2d5a3c;
    --node: #2b2b2fef;
    --node-edge: #0c0c0e;
    --chip: #1d1d20;
    --chip-fg: #c6b8ea;
    --conversion: #1d1d20e6;
    --selected-object: #e0701c;
    --active-object: #ffa53a;
    --bubble: #e6e2cbf2;
    --bubble-fg: #1f1f22;
}
/* Light canvases keep full-color titles in lighter tints (Blender's light theme). */
body.graph-canvas:not(.dark) {
    --n-event: #c9737f;
    --n-flow: #8e8e98;
    --n-pure: #6d9a78;
    --n-function: #6f8fbd;
    --n-variable: #a57d68;
    --n-literal: #b79a5c;
    --n-expr: #5f9aa8;
    --n-call: #6e9e7a;
    --node: #fbfbfcf2;
    --node-edge: #c6c6cc;
    --chip: #ececef;
    --chip-fg: #6d4fb0;
    --conversion: #ffffffe6;
    --bubble: #fff6ccf2;
}

#back, #front { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; pointer-events: none; }
#world { position: absolute; left: 0dp; top: 0dp; width: 0dp; height: 0dp; }
.wires { display: block; position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; pointer-events: none; }
.stage { position: absolute; left: 0dp; top: 0dp; width: 0dp; height: 0dp; }

/* measure_node sizes nodes; widths come from C. */
.gnode {
    position: absolute;
    background-color: var(--node); border: 1dp var(--node-edge); border-radius: var(--r-lg);
    color: var(--foreground); font-size: 12dp;
}
.gnode[data-error] { border-color: var(--destructive); }
.gnode[data-warning] { border-color: var(--warning); }
.gnode[data-selected] { border-color: var(--selected-object); z-index: 2; }
.gnode[data-active] { border-color: var(--active-object); }
.gnode[data-dim] { opacity: 0.45; }
.gnode[data-breakpoint] .gnode-head { border-left: 4dp #e5534b; }
.gnode[data-disabled] { opacity: 0.5; }

.gnode-head {
    position: relative; display: flex; align-items: center; gap: 6dp; height: 24dp; padding: 0dp 10dp;
    border-radius: 5dp 5dp 0dp 0dp; color: #ffffff; background-color: var(--n-pure);
}
.gnode-head:last-child { border-radius: 5dp; }
/* Unlabeled execution pins sit on the title's edges (Unity Visual Scripting). */
.hpin { position: absolute; top: 0dp; width: 0dp; height: 24dp; }
.hpin.in { left: 0dp; }
.hpin.out { right: 0dp; }
.hpin > .socket { top: 4dp; }
.gnode-head .icon { color: #ffffffcc; font-size: 12dp; width: 14dp; }
.gnode-head .title { display: block; flex: 1 1 auto; white-space: nowrap; overflow: hidden; font-weight: 600; line-height: 24dp; }
.gnode-head .symbol { display: block; font-weight: 700; font-size: 14dp; line-height: 24dp; }
.gnode[data-kind=event] .gnode-head { background-color: var(--n-event); }
.gnode[data-kind=flow] .gnode-head { background-color: var(--n-flow); }
.gnode[data-kind=function] .gnode-head { background-color: var(--n-function); }
.gnode[data-kind=variable] .gnode-head { background-color: var(--n-variable); }
.gnode[data-kind=literal] .gnode-head { background-color: var(--n-literal); }
.gnode[data-kind=call] .gnode-head { background-color: var(--n-call); }
.gnode[data-kind=expression] .gnode-head { background-color: var(--n-expr); }

/* Rows sit on a fixed pitch, which pin_y assumes: row i's socket is at head (24)
   + pad (4) + (i + 0.5) * 22 below the node's border, after any code. Execution
   pins pair up first, then data outputs, then data inputs (Blender's order). */
.gnode-body { display: block; padding: 4dp 0dp 6dp; }
.grow { position: relative; display: flex; align-items: center; gap: 6dp; height: 22dp; padding: 0dp 10dp; }
.grow.out { justify-content: flex-end; }
.grow.exec { padding: 0dp; gap: 12dp; }
.ghalf { position: relative; display: flex; align-items: center; gap: 6dp; height: 22dp; }
.ghalf.in { padding-left: 10dp; }
.ghalf.out { padding-right: 10dp; margin-left: auto; justify-content: flex-end; }
.gpin-label { display: block; flex: 0 0 auto; color: var(--muted-foreground); white-space: nowrap; overflow: hidden; line-height: 22dp; }
[data-hover] > .gpin-label { color: var(--foreground); }
.grow .field { flex: 1 1 auto; min-width: 0dp; height: 18dp; }
.grow.out .field { flex: 0 0 64dp; }
.grow .field .part { height: 16dp; line-height: 16dp; }
.grow .segmented { height: 18dp; }
.grow .check { flex: 0 0 auto; }
/* Editors and chips fill the row to the node's edge, so their right edges align. */
.grow .chip {
    display: flex; align-items: center; gap: 4dp; flex: 1 1 auto; min-width: 0dp; height: 18dp;
    padding: 0dp 6dp; border-radius: 3dp; background-color: var(--chip); color: var(--chip-fg);
    font-size: 11dp; line-height: 18dp; overflow: hidden;
}
.grow .chip .icon { flex: 0 0 auto; width: 12dp; font-size: 11dp; line-height: 18dp; color: var(--faint-foreground); }
.chip-text { display: block; flex: 1 1 auto; min-width: 0dp; white-space: nowrap; overflow: hidden; }
.grow .chip.source { color: var(--tok-name); }
/* A variadic node's last row adds a pin on its side (Unreal's Add pin). */
.gadd .btn { color: var(--faint-foreground); }

/* An expression's source, lines wrapped by measure_node: 16 dp lines, 12 dp of
   padding and margin below, 28 dp across. */
.gcode {
    display: block; margin: 0dp 8dp 4dp; padding: 4dp 6dp; border-radius: 4dp;
    background-color: var(--chip); font-size: 11dp; line-height: 16dp;
}
.gcode-line { display: block; height: 16dp; white-space: pre; overflow: hidden; }

/* Compact nodes (Unreal): an operator's symbol sits between its inputs and its
   centered output; a one-output read is a pill with its socket on the title. */
.gnode[data-form=operator] { border-radius: 10dp; }
.gnode[data-form=operator] .gnode-body { position: relative; padding: 4dp 0dp; }
.gnode[data-form=operator] .grow.in { padding-right: 0dp; }
.gsymbol {
    position: absolute; top: 0dp; bottom: 0dp; text-align: center; white-space: nowrap;
    font-size: 18dp; font-weight: 700; color: var(--muted-foreground);
}
.gout { position: absolute; right: 0dp; width: 12dp; height: 22dp; }
.gnode[data-form=getter] { border-radius: 13dp; }
.gnode[data-form=getter] .gnode-head { border-radius: 12dp; }

/* A socket is a 16 dp hit area centered on the node edge; kit_dot draws it. */
.socket { position: absolute; top: 3dp; width: 16dp; height: 16dp; }
.in > .socket { left: -8dp; }
.out > .socket { right: -8dp; }
.socket kit-dot { position: absolute; left: 3dp; top: 3dp; width: 10dp; height: 10dp; }

/* Level of detail: far out, pins and values give way to titles. */
body.far .gpin-label, body.far .grow .field, body.far .grow .chip, body.far .grow .check, body.far .grow .segmented, body.far .gcode, body.far .gadd { visibility: hidden; }
body.far .gnode-head .title { font-size: 16dp; }

/* Comment frames (studio_graph_comment.c): a tint layer keyed by the frame's
   color, the title, and grips on the edges and corners that resize it. */
.gcomment { position: absolute; }
.gcomment[data-selected] { margin: -2dp 0dp 0dp -2dp; border: 2dp var(--selected-object); border-radius: var(--r-lg); }
.gcomment-tint {
    position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp;
    border: 1dp #8a8a9666; border-radius: var(--r-lg); background-color: #8a8a961f;
}
.gcomment-title {
    position: relative; display: block; height: 28dp; padding: 0dp 10dp; line-height: 28dp; font-size: 14dp; font-weight: 600;
    color: var(--foreground); white-space: nowrap; overflow: hidden; cursor: move;
}
.gcomment-edit { position: relative; display: block; padding: 3dp 4dp; }
.gcomment-edit .field { font-size: 14dp; font-weight: 600; }
body.far .gcomment-title { font-size: 28dp; height: 44dp; line-height: 44dp; }
.grip { position: absolute; }
.grip.n, .grip.s { left: 8dp; right: 8dp; height: 8dp; cursor: ns-resize; }
.grip.w, .grip.e { top: 8dp; bottom: 8dp; width: 8dp; cursor: ew-resize; }
.grip.n { top: -4dp; }
.grip.s { bottom: -4dp; }
.grip.w { left: -4dp; }
.grip.e { right: -4dp; }
.grip.nw, .grip.ne, .grip.sw, .grip.se { width: 12dp; height: 12dp; }
.grip.nw { left: -4dp; top: -4dp; cursor: nwse-resize; }
.grip.se { right: -4dp; bottom: -4dp; cursor: nwse-resize; }
.grip.ne { right: -4dp; top: -4dp; cursor: nesw-resize; }
.grip.sw { left: -4dp; bottom: -4dp; cursor: nesw-resize; }

/* A node's comment floats above it (Unreal's comment bubble). */
.gbubble {
    position: absolute; left: 0dp; bottom: 100%; margin-bottom: 6dp;
    padding: 3dp 8dp; border-radius: 6dp; background-color: var(--bubble); border: 1dp var(--node-edge);
    color: var(--bubble-fg); font-size: 12dp; line-height: 16dp;
}
.gbubble-text { display: block; white-space: pre-wrap; }
body.far .gbubble { visibility: hidden; }

/* Centered on the wire's middle by a negative margin (emit_conversions). */
.gconversion {
    position: absolute; display: block; height: 16dp; margin-top: -8dp;
    border-radius: 8dp; background-color: var(--conversion); border: 1dp var(--border);
    color: var(--muted-foreground); font-size: 10dp; line-height: 14dp; text-align: center; white-space: nowrap; overflow: hidden;
}

.marquee { position: absolute; border: 1dp var(--primary-edge); background-color: var(--primary-soft); }
.link-error {
    position: absolute; padding: 2dp 8dp; border-radius: var(--r); background-color: var(--notice);
    color: var(--notice-fg); font-size: 11dp; line-height: 16dp; white-space: nowrap;
}

/* A wire's reroute point: a 14 dp hit area centered on the point. */
.greroute { position: absolute; width: 14dp; height: 14dp; margin-left: -7dp; margin-top: -7dp; cursor: move; }
.greroute kit-dot { position: absolute; left: 2dp; top: 2dp; width: 10dp; height: 10dp; }

/* A problem sits on the node's top edge by its right corner, clear of the
   title's socket (Blender's node warnings); a paused run's node takes a 3 dp
   accent ring outside its border. */
.gproblem {
    position: absolute; top: -10dp; right: 14dp; width: 18dp; height: 18dp; border-radius: 9dp;
    background-color: var(--node); text-align: center; z-index: 3;
}
.gproblem .icon { width: 18dp; font-size: 14dp; line-height: 18dp; color: var(--warning); }
.gnode[data-error] .gproblem .icon { color: var(--destructive); }
.gpaused {
    position: absolute; left: -5dp; top: -5dp; right: -5dp; bottom: -5dp;
    border: 3dp var(--primary); border-radius: 10dp; pointer-events: none;
    opacity: 1; transition: opacity 0.14s cubic-out;
}
.gpaused[data-starting-style] { opacity: 0; }
.gnode[data-paused] { z-index: 3; }

/* A watched pin's value floats outside the node beside its socket (Unreal). */
.gwatch {
    position: absolute; top: -9dp; height: 16dp; padding: 0dp 6dp; border-radius: 8dp;
    background-color: var(--primary); color: var(--primary-foreground); font-size: 10dp; line-height: 16dp;
    font-family: InterNumeric; white-space: nowrap; pointer-events: none;
}
.in > .gwatch { right: 100%; margin-right: 10dp; }
.out > .gwatch { left: 100%; margin-left: 10dp; }
<rml>
<head>
    <title>Chibi Graph Canvas</title>
</head>
<body class="graph-canvas">
    <div id="back"></div>
    <div id="world"></div>
    <div id="front"></div>
    <div id="layer"></div>
</body>
</rml>
/* Studio workspace, ported from docs/prototypes/studio/studio.css. Areas are
   Blender-style splits, each with a header and an editor type. */

body { width: 100%; height: 100%; margin: 0dp; padding: 0dp; background-color: var(--app); overflow: hidden; }

#app { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; flex-direction: column; }

/* Top bar: menus, documents, transport, search. */
.topbar { height: 30dp; flex: 0 0 auto; display: flex; align-items: center; gap: 2dp; padding: 0dp 6dp; background-color: var(--muted); border-bottom: 1dp var(--edge); }
.topbar .brand { width: 22dp; height: 22dp; display: flex; align-items: center; justify-content: center; margin-right: 4dp; }
.topbar .brand .mark { width: 11dp; height: 11dp; border-radius: 3dp; background-color: var(--primary); transform: rotate(45deg); }
.topbar .menus { display: flex; flex: 0 0 auto; }
.topbar .brand, .topbar .sep, .topbar .btn { flex-shrink: 0; }
.topbar .trigger { color: var(--foreground); padding: 0dp 7dp; }
.topbar .sep { width: 1dp; height: 14dp; background-color: var(--border); margin: 0dp 6dp; }
/* Tabs give way first when the window narrows; menus and transport keep their size. */
.doc-tabs { display: flex; align-items: center; gap: 1dp; height: 100%; flex: 0 1 auto; min-width: 96dp; overflow: hidden; }
.doc-tab { gap: 6dp; height: 24dp; padding: 0dp 6dp 0dp 8dp; color: var(--muted-foreground); }
.doc-tab[data-state=on] { background-color: var(--background); color: var(--foreground); border-color: var(--border); }
.doc-tab[data-state=on] .icon { color: var(--foreground); }
.dirty-dot { width: 6dp; height: 6dp; border-radius: 3dp; background-color: var(--muted-foreground); }
.transport { display: flex; align-items: center; gap: 4dp; flex: 0 0 auto; }
.transport .target { width: 168dp; flex: 0 0 auto; }
.transport .group { display: flex; background-color: var(--secondary); border-radius: var(--r); }
.transport .group .btn { border-radius: 0dp; width: 26dp; padding: 0dp; }
.transport .group .btn[data-state=on] { background-color: var(--primary); }
.transport .group .btn[data-state=on] .icon { color: var(--primary-foreground); }
.transport .clock { width: 64dp; text-align: right; color: var(--faint-foreground); font-family: InterNumeric; }
.transport .clock.running { color: var(--foreground); }
.topbar .search-trigger { flex: 0 4 220dp; min-width: 28dp; overflow: hidden; }
.search-trigger { width: 220dp; justify-content: flex-start; background-color: var(--field-edit); color: var(--faint-foreground); padding: 0dp 6dp 0dp 7dp; }
.search-trigger:hover { background-color: var(--input-hover); color: var(--muted-foreground); }
.search-trigger .label { flex: 1 1 0dp; }

/* Workspace and areas. */
.workspace { flex: 1 1 0dp; display: flex; padding: 2dp; }
.column { display: flex; flex-direction: column; }
.column.main { flex: 1 1 0dp; }
.area { position: relative; display: flex; flex-direction: column; background-color: var(--background); border-radius: var(--r-lg); overflow: hidden; }
.area.fill { flex: 1 1 0dp; }
.area-head { height: var(--header-h); flex: 0 0 auto; display: flex; align-items: center; gap: 2dp; padding: 0dp 4dp; background-color: var(--muted); border-bottom: 1dp var(--edge); }
.area-head .btn { height: 22dp; }
.area-head .editor-type { gap: 2dp; padding: 0dp 3dp 0dp 5dp; }
.area-head .menu-btn { color: var(--foreground); padding: 0dp 6dp; }
/* Breadcrumbs (studio_graph_nav.c): the behavior, the calls entered and the open graph. */
.area-head .crumbs { display: flex; align-items: center; gap: 2dp; color: var(--muted-foreground); white-space: nowrap; overflow: hidden; flex: 0 1 auto; min-width: 0dp; }
.area-head .crumbs .crumb { padding: 0dp 4dp; color: var(--muted-foreground); flex: 0 1 auto; min-width: 0dp; }
.area-head .crumbs .crumb.current { color: var(--foreground); }
.area-head .crumbs .crumb-sep { color: var(--disabled-foreground); font-size: 10dp; width: 10dp; flex: 0 0 auto; }
.area-body { flex: 1 1 0dp; position: relative; overflow: hidden; }
.area-panel { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; overflow-y: auto; padding: 4dp 6dp; }
.area.live .area-head { border-bottom-color: var(--primary-edge); }

/* Splitters: 4 dp hit area. */
.split-v { width: 4dp; flex: 0 0 auto; cursor: ew-resize; drag: drag; }
.split-h { height: 4dp; flex: 0 0 auto; cursor: ns-resize; drag: drag; }
.split-v:hover, .split-v[data-dragging], .split-h:hover, .split-h[data-dragging] { background-color: var(--primary-wash); }

/* Drawer: the collapsible bottom area of the main column. */
.area.drawer { flex: 0 0 auto; }
.area-head .drawer-close { margin-left: 2dp; }
.statusbar .drawers { display: flex; align-items: center; gap: 2dp; }
.statusbar .toggle-drawer { color: var(--faint-foreground); }
.statusbar .toggle-drawer .icon { font-size: 12dp; width: 14dp; }
.statusbar .ui-scale { flex-shrink: 0; color: var(--faint-foreground); font-family: InterNumeric; }
.statusbar .toggle-drawer[data-state=on] { background-color: transparent; color: var(--foreground); }
.statusbar .toggle-drawer[data-state=on] .icon { color: var(--primary-text); }

/* Status bar. */
.statusbar { height: 24dp; flex: 0 0 auto; display: flex; align-items: center; gap: 14dp; padding: 0dp 10dp; background-color: var(--muted); border-top: 1dp var(--edge); color: var(--muted-foreground); font-size: 11dp; white-space: nowrap; }
/* Hints give way first when the window narrows. */
.statusbar .hints { display: flex; align-items: center; gap: 12dp; flex: 0 1 auto; min-width: 0dp; overflow: hidden; }
.statusbar .drawers, .statusbar .stats { flex-shrink: 0; }
.statusbar .hint { display: flex; align-items: center; gap: 4dp; }
.statusbar .hint .icon { font-size: 13dp; width: 14dp; color: var(--faint-foreground); }
.statusbar .hint .kbd-key { height: 16dp; min-width: 16dp; }
.statusbar .report { display: flex; align-items: center; gap: 6dp; color: var(--foreground); opacity: 1; transition: opacity 0.2s cubic-out; }
.statusbar .report[data-starting-style], .statusbar .report[data-ending-style] { opacity: 0; }
.statusbar .report .icon { color: var(--success); font-size: 12dp; }
.statusbar .stats { display: flex; gap: 10dp; color: var(--faint-foreground); font-family: InterNumeric; }
.statusbar .stats .strong { color: var(--muted-foreground); }
.statusbar .count { display: block; white-space: nowrap; line-height: 16dp; }

/* Scene viewport. */
.viewport { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; background-color: var(--viewport); }
/* The scene renders on a dark canvas in every theme; its chrome keeps dark roles. */
body:not(.dark) .viewport {
    --foreground: #e5e5e8; --muted-foreground: #adadb5; --faint-foreground: #7a7a83; --line: #ffffff10; --accent: #ffffff0f; --press: #ffffff1a;
    --floating: #2c2c30e6; --primary-text: #9dbef5; --notice: #1a1612f0; --notice-fg: #ffad66;
}
.viewport .surface { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; }
.viewport .toolshelf { position: absolute; left: 8dp; top: 8dp; display: flex; flex-direction: column; gap: 2dp; padding: 3dp; background-color: var(--floating); border: 1dp var(--line); border-radius: var(--r-lg); }
.viewport .toolshelf .btn { width: 28dp; height: 28dp; padding: 0dp; }
.viewport .toolshelf .btn .icon { font-size: 15dp; width: 18dp; }
.viewport .toolshelf .btn[data-state=on] { background-color: var(--primary); }
.viewport .toolshelf .btn[data-state=on] .icon { color: var(--primary-foreground); }
.viewport .view-label { position: absolute; left: 50dp; top: 10dp; color: var(--foreground); font-size: 11dp; pointer-events: none; }
.viewport .view-label .dim { display: block; }
.viewport .readout { position: absolute; right: 10dp; bottom: 8dp; color: var(--faint-foreground); font-size: 11dp; font-family: InterNumeric; pointer-events: none; }
.viewport .live-badge { position: absolute; left: 50dp; bottom: 10dp; }
.viewport .notice { position: absolute; left: 12dp; right: 12dp; bottom: 36dp; padding: 6dp 8dp; border-radius: var(--r); background-color: var(--notice); color: var(--notice-fg); white-space: normal; }

/* Outliner. */
.outliner { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; overflow-y: auto; padding: 3dp 4dp 8dp; }
.outliner-empty { position: absolute; left: 0dp; right: 0dp; top: 40dp; color: var(--faint-foreground); text-align: center; pointer-events: none; }

/* Properties: Blender context tabs + panels. */
.properties { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; }
.prop-tabs { width: 32dp; flex: 0 0 auto; display: flex; flex-direction: column; align-items: center; gap: 2dp; padding: 4dp 0dp; background-color: var(--rail); border-right: 1dp var(--edge); }
.prop-tabs .btn { width: 26dp; height: 26dp; padding: 0dp; }
.prop-tabs .btn .icon { font-size: 15dp; width: 18dp; color: var(--faint-foreground); }
.prop-tabs .btn[data-state=on] { background-color: var(--panel-head); }
.prop-tabs .btn[data-state=on] .icon { color: var(--foreground); }
.prop-tabs .tab-sep { width: 16dp; height: 1dp; background-color: var(--border); margin: 3dp 0dp; }
.prop-scroll { flex: 1 1 0dp; overflow-y: auto; padding: 6dp 6dp 16dp; }
.identity { display: flex; align-items: center; gap: 8dp; padding: 2dp 2dp 8dp; }
.identity .glyph { width: 30dp; height: 30dp; flex: 0 0 auto; border-radius: var(--r-lg); background-color: var(--panel-head); display: flex; align-items: center; justify-content: center; }
.identity .glyph .icon { font-size: 16dp; color: var(--foreground); }
.identity .who { flex: 1 1 0dp; display: flex; flex-direction: column; gap: 3dp; }
.identity .who .title { font-size: 13dp; font-weight: 600; }
.identity .lineage { display: flex; align-items: center; gap: 4dp; color: var(--faint-foreground); font-size: 11dp; white-space: nowrap; }
.identity .lineage .btn { height: 16dp; padding: 0dp 3dp; font-size: 11dp; color: var(--muted-foreground); gap: 3dp; }
.identity .lineage .btn .icon { font-size: 10dp; width: 11dp; }
.prop-empty { padding: 20dp 8dp; color: var(--faint-foreground); text-align: center; }
.behavior-row { display: flex; align-items: center; gap: 6dp; height: 26dp; padding: 0dp 4dp 0dp 6dp; border-radius: var(--r); margin-top: 2dp; background-color: var(--secondary); }
.behavior-row { cursor: pointer; transition: background-color 0.11s cubic-out; }
.behavior-row:hover { background-color: var(--field-hover); }
.behavior-row[data-current] { background-color: var(--primary-soft); }
.behavior-row[data-current] .icon { color: var(--primary-text); }
.behavior-row .name { flex: 1 1 0dp; }
.behavior-row .graphs { color: var(--faint-foreground); font-size: 11dp; }
.add-row { margin-top: 6dp; display: flex; }
.add-row .btn { flex: 1 1 0dp; }

/* Behavior graph: the canvas is its own zoomed document (graph.rml), shown here. */
.graph-surface { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; }
.area-head .readout { color: var(--faint-foreground); font-size: 11dp; font-family: InterNumeric; padding: 0dp 4dp; }
/* A paused run's call stack floats over the canvas's bottom-left corner. */
.call-stack {
    position: absolute; left: 8dp; bottom: 8dp; width: 280dp; padding: 4dp; display: flex; flex-direction: column;
    background-color: var(--floating); border: 1dp var(--line); border-radius: var(--r-lg);
    opacity: 1; margin-top: 0dp; transition: opacity margin-top 0.14s cubic-out;
}
.call-stack[data-starting-style], .call-stack[data-ending-style] { opacity: 0; margin-top: 6dp; }
.call-stack[data-ending-style] { transition: opacity margin-top 0.1s cubic-in; }
.call-stack-head { display: flex; align-items: center; gap: 6dp; height: 20dp; padding: 0dp 6dp; font-size: 11dp; font-weight: 600; white-space: nowrap; overflow: hidden; }
.call-stack-head .dim { font-weight: 400; overflow: hidden; text-overflow: ellipsis; }
.call-stack .tree-row .icon { color: var(--faint-foreground); }
.call-stack .tree-row[data-selected] .icon { color: var(--warning); }

/* A source that feeds a pin, in Properties (the graph draws its own). */
.prop .chip { display: block; height: 18dp; padding: 0dp 6dp; border-radius: 3dp; background-color: var(--field-edit); color: #c6b8ea; font-size: 11dp; line-height: 18dp; white-space: nowrap; overflow: hidden; }

/* Editors without content yet. */
.pending-editor { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; align-items: center; justify-content: center; color: var(--faint-foreground); background-color: var(--canvas); }

/* Output. */
/* View labels carry counts, so segments fit their labels. */
.output-views, .output-scope { display: flex; flex: 0 0 auto; }
.output-views .segmented, .output-scope .segmented { flex: 0 0 auto; }
.output-views .seg, .output-scope .seg { flex: 0 0 auto; }
.output-scope { margin-left: 6dp; }
.output-filter { width: 160dp; display: flex; }
.output-list { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; padding: 2dp 0dp 6dp; font-family: InterNumeric; }
.output-list .vlist-content > .output-line, .output-row { display: block; height: 20dp; line-height: 20dp; padding: 0dp 10dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
body.comfortable .output-list .vlist-content > .output-line, body.comfortable .output-row { height: 24dp; line-height: 24dp; }
.output-row { display: flex; align-items: center; gap: 6dp; }
.output-row .kind { font-size: 12dp; width: 14dp; flex: 0 0 auto; }
.output-row .output-line { display: block; flex: 1 1 0dp; padding: 0dp; overflow: hidden; text-overflow: ellipsis; }
.output-row[data-kind=error] .kind { color: var(--destructive); }
.output-row[data-kind=warning] .kind { color: var(--warning); }
.output-row[data-kind=success] .kind { color: var(--success); }
.output-row[data-kind=info] .kind { color: var(--faint-foreground); }
.output-list .vlist-content > .output-line:hover, .output-row:hover { background-color: var(--accent); }
/* Rows at a node open it: where, muted, then the message and a repeat count. */
.output-row.located { cursor: pointer; }
.output-row .output-at { display: block; flex: 0 0 auto; color: var(--faint-foreground); white-space: nowrap; }
.output-row .output-count { flex: 0 0 auto; font-family: InterNumeric; }
.output-empty { position: absolute; left: 0dp; right: 0dp; top: 45%; text-align: center; color: var(--faint-foreground); pointer-events: none; }

/* Output's Find view (studio_find.c): what the references are to, then a row per use. */
.find-head { position: absolute; left: 0dp; top: 0dp; right: 0dp; height: 24dp; display: flex; align-items: center; gap: 6dp; padding: 0dp 10dp; border-bottom: 1dp var(--line); }
.find-head .icon { color: var(--faint-foreground); font-size: 12dp; width: 14dp; }
.find-title { display: block; line-height: 16dp; color: var(--foreground); font-weight: 600; white-space: nowrap; }
.find-count { display: block; line-height: 16dp; color: var(--faint-foreground); font-family: InterNumeric; }
.output-list.find-list { top: 24dp; padding: 2dp 4dp 6dp; }

/* Find in graph (studio_graph_find.c): floats over the canvas's top right. */
.graph-find {
    position: absolute; top: 8dp; right: 8dp; width: 340dp; display: flex; flex-direction: column; gap: 4dp;
    padding: 4dp; background-color: var(--popover); border: 1dp var(--popover-edge); border-radius: var(--r-lg);
}
.graph-find-bar { display: flex; align-items: center; gap: 2dp; }
.graph-find-bar .search { flex: 1 1 0dp; min-width: 0dp; }
.graph-find-count { display: block; flex: 0 0 auto; padding: 0dp 4dp; line-height: 16dp; color: var(--faint-foreground); font-size: 11dp; font-family: InterNumeric; white-space: nowrap; }
.graph-find-list { position: relative; }
.graph-find-list .tree-row .meta { display: block; flex: 0 1 auto; max-width: 60%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* Assets. */
.assets-kind { width: 140dp; display: flex; }
.assets-filter { flex: 1 1 0dp; display: flex; max-width: 220dp; margin-left: 4dp; }
.assets-list { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; padding: 3dp 4dp 8dp; }
.assets-list .tree-row { tab-index: none; }
.assets-list .tree-row[data-unused] .meta { color: var(--disabled-foreground); }
.assets-list .tree-row[data-unresolved] .icon { color: var(--warning); }

/* Performance. */
.perf-title { display: block; line-height: 16dp; color: var(--foreground); font-weight: 500; margin-left: 2dp; }
.perf-readout { display: block; line-height: 16dp; color: var(--muted-foreground); font-family: InterNumeric; margin-right: 6dp; }
.perf { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; flex-direction: column; padding: 6dp 10dp 8dp; gap: 4dp; overflow-y: auto; }
.perf-heading { display: block; line-height: 16dp; color: var(--faint-foreground); font-size: 11dp; }
.perf-chart { flex: 1 1 0dp; min-height: 60dp; }
.perf-legend { display: flex; gap: 14dp; flex: 0 0 auto; height: 18dp; align-items: center; }
.perf-key { display: flex; align-items: center; gap: 5dp; }
.perf-key span { display: block; line-height: 16dp; color: var(--muted-foreground); font-size: 11dp; }
.perf-dot { width: 8dp; height: 8dp; border-radius: 4dp; }
.perf-idle { flex: 1 1 0dp; display: block; line-height: 40dp; text-align: center; color: var(--faint-foreground); }
.perf-status { flex: 0 0 auto; display: block; line-height: 16dp; color: var(--muted-foreground); font-size: 11dp; }

/* Members (Unreal's My Blueprint). */
.members-filter { flex: 1 1 0dp; display: flex; max-width: 240dp; }
.members-list { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; padding: 3dp 4dp 8dp; }
.members-list .tree-row { tab-index: none; }
.members-list .tree-row[data-section] .name { font-weight: 600; }
.member-row { display: block; }
.member-swatch { width: 9dp; height: 9dp; flex: 0 0 auto; margin: 0dp 5dp 0dp 3dp; }
/* A member's use count, which lists its uses in Find. */
.tree-row .member-uses { height: 18dp; min-width: 20dp; padding: 0dp 4dp; justify-content: center; color: var(--faint-foreground); font-family: InterNumeric; }
.tree-row .member-uses[data-unused] { color: var(--disabled-foreground); }
.member-rename .field { height: 20dp; margin-right: 4dp; }
/* Rename and safe delete: the new name, then the assets it rewrites or the
   uses a delete leaves, as rows shaped like the menu's items. */
.popup.refactor { width: 300dp; }
.refactor-field { display: block; padding: 2dp 4dp 4dp; }
.refactor-field .field { height: 24dp; }
.refactor-row { display: flex; align-items: center; gap: 8dp; height: var(--h); padding: 0dp 8dp 0dp 6dp; white-space: nowrap; color: var(--fg); }
.refactor-row .lead { color: var(--fg-2); }
.refactor-row .label { flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; }
.refactor-row .kbd { margin-left: 16dp; flex: 0 0 auto; color: var(--fg-3); }
.type-pick { display: flex; align-items: center; gap: 2dp; flex: 1 1 0dp; }
.type-pick .member-swatch { margin: 0dp 4dp; }
.type-pick .type-button { flex: 1 1 0dp; justify-content: flex-start; overflow: hidden; }
.param-row { display: flex; align-items: center; gap: 4dp; margin-top: var(--gap); }
.param-row .field { flex: 1 1 0dp; }
.param-row .type-pick { flex: 0 0 104dp; }
.param-row .select { flex: 0 0 78dp; }
.param-row .param-grip { flex: 0 0 12dp; width: 12dp; font-size: 12dp; color: var(--disabled-foreground); cursor: grab; }
.param-row .param-grip:hover { color: var(--muted-foreground); }
.param { border-radius: 4dp; }
<rml>
<head>
    <title>Chibi Studio</title>
</head>
<body>
    <div id="app"></div>
    <div id="layer"></div>
</body>
</rml>
layout(location = 0) in vec3 v_normal;
layout(location = 1) in vec3 v_world;
layout(location = 2) flat in vec4 v_material;
layout(location = 0) out vec4 result;
layout(set = 2, binding = 0) uniform sampler2D arena_parameters;
const float PI = 3.141592653589793;

vec4 material_value(int slot)
{
    int texel = int(v_material.x) * 38 + slot;
    return texelFetch(arena_parameters, ivec2(texel % 2048, texel / 2048), 0);
}

vec3 safe_normal(vec3 value, vec3 fallback)
{
    float magnitude = dot(value, value);
    return magnitude > 0.00000001 ? value * inversesqrt(magnitude) : fallback;
}

vec2 primitive_uv(vec3 local, vec3 dimensions, vec3 object_normal, int primitive)
{
    vec3 p = local / dimensions;
    if (primitive == 9 || primitive == 10) p.x -= 1.0 / 6.0;
    if (primitive == 0 || primitive >= 4) {
        vec3 side = abs(object_normal);
        if (side.y >= side.x && side.y >= side.z) return p.xz + 0.5;
        if (side.x >= side.z) return vec2(p.z + 0.5, 0.5 - p.y);
        return vec2(p.x + 0.5, 0.5 - p.y);
    }
    float u = atan(p.z, p.x) / (2.0 * PI) + 0.5;
    if (primitive == 1) {
        vec3 direction = safe_normal(p, vec3(0, 1, 0));
        return vec2(u, 0.5 - asin(clamp(direction.y, -1.0, 1.0)) / PI);
    }
    return vec2(u, 0.5 - p.y);
}

// GGX distribution, height-correlated Smith visibility, Schlick Fresnel.
// Reference: https://google.github.io/filament/main/filament.html#materialsystem/standardmodelsummary
vec3 surface_light(vec3 base, float roughness, float metallic, vec3 normal, vec3 view, vec3 light)
{
    vec3 halfway = safe_normal(light + view, normal);
    float nv = max(dot(normal, view), 0.0001);
    float nl = max(dot(normal, light), 0.0);
    float nh = max(dot(normal, halfway), 0.0);
    float vh = max(dot(view, halfway), 0.0);
    float alpha = max(roughness * roughness, 0.0025);
    float a2 = alpha * alpha;
    float denominator = nh * nh * (a2 - 1.0) + 1.0;
    float distribution = a2 / max(PI * denominator * denominator, 0.00000001);
    float visibility = 0.5 / max(
        nl * sqrt(nv * nv * (1.0 - a2) + a2) +
        nv * sqrt(nl * nl * (1.0 - a2) + a2), 0.0001);
    vec3 f0 = mix(vec3(0.04), base, metallic);
    vec3 fresnel = f0 + (1.0 - f0) * pow(1.0 - vh, 5.0);
    vec3 diffuse = base * (1.0 - metallic) * (1.0 - fresnel) / PI;
    vec3 specular = fresnel * distribution * visibility;
    return (diffuse + specular) * nl;
}

vec3 direct_light(vec3 base, float roughness, float metallic, vec3 normal, vec3 view)
{
    vec3 key = normalize(vec3(-0.45, 0.85, 0.4));
    float sky = 0.5 + 0.5 * normal.y;
    vec3 ambient = mix(vec3(0.06, 0.07, 0.10), vec3(0.17, 0.20, 0.27), sky);
    vec3 result = surface_light(base, roughness, metallic, normal, view, key) * 2.8 +
                  base * (1.0 - metallic) * ambient;
    for (int i = 0; i < int(arena_light_count.x); i++) {
        vec3 delta = arena_light_positions[i].xyz - v_world;
        float radius = arena_light_positions[i].w;
        float distance_squared = dot(delta, delta);
        if (distance_squared >= radius * radius || dot(normal, delta) < 0.0) continue;
        float fade = 1.0 - distance_squared / (radius * radius);
        vec3 light = safe_normal(delta, normal);
        vec3 radiance = arena_light_colors[i].rgb * arena_light_colors[i].w * fade * fade;
        result += surface_light(base, roughness, metallic, normal, view, light) * radiance;
    }
    return result;
}

vec4 graphic_particle(vec2 p, int shape, float age, vec4 tint, vec3 emission)
{
    float distance;
    if (shape == 1 || shape == 2) {
        distance = max(-p.x - 0.45, abs(p.y) - (0.9 - p.x) * 0.578);
        if (shape == 2) distance = max(distance, -distance - 0.14);
    } else if (shape == 3) {
        distance = abs(length(p) - 0.72) - mix(0.12, 0.045, age);
    } else if (shape == 4) {
        distance = abs(p.x) + abs(p.y) * 2.6 - 0.88;
    } else {
        // Three crisp lobes make a flat plasma mark, with no spherical shading.
        distance = length((p - vec2(0.05, 0)) * vec2(0.95, 1.12)) - 0.62;
        distance = min(distance, length(p - vec2(-0.42, 0.18)) - 0.33);
        distance = min(distance, length(p - vec2(-0.36, -0.25)) - 0.27);
    }
    float edge = max(fwidth(distance), 0.003);
    float coverage = 1.0 - smoothstep(-edge, edge, distance);
    float core = 1.0 - smoothstep(-edge, edge, distance + 0.19);
    if (shape == 2 || shape == 3) {
        core = 1.0 - smoothstep(-edge, edge, abs(distance + 0.06) - 0.025);
    }
    float ink = 1.0 - smoothstep(-edge, edge, distance + 0.055);
    vec3 body = tint.rgb * mix(0.48, 1.0, ink);
    body = mix(body, vec3(1.0, 0.98, 0.88), core * (0.86 - age * 0.3));
    return vec4(body + emission * (0.45 + core * 0.65), tint.a * coverage);
}

void main()
{
    vec4 inverse_x = material_value(34), inverse_y = material_value(35), inverse_z = material_value(36);
    vec4 world = vec4(v_world, 1.0);
    vec3 local = vec3(dot(inverse_x, world), dot(inverse_y, world), dot(inverse_z, world));
    if (v_material.w > 0.0) {
        result = graphic_particle(local.xy * 2.0 / material_value(37).xy,
            int(v_material.w) - 1, material_value(2).x, material_value(0), material_value(1).rgb);
        if (result.a <= 0.0) discard;
        return;
    }
    vec3 normal = safe_normal(v_normal, vec3(0, 1, 0));
    vec3 object_normal = vec3(dot(inverse_x.xyz, normal), dot(inverse_y.xyz, normal), dot(inverse_z.xyz, normal));
    vec3 view = safe_normal(arena_camera_time.xyz - v_world, normal);
    SGSample sg_context;
    sg_context.position = local.xz;
    sg_context.uv = primitive_uv(local, material_value(37).xyz, object_normal, int(v_material.z));
    sg_context.object_position = local;
    sg_context.world_position = v_world;
    sg_context.normal = normal;
    sg_context.view_direction = view;
    sg_context.time = arena_camera_time.w;
    vec4 fallback = material_value(0);
    vec3 base = fallback.rgb;
    vec3 emission = material_value(1).rgb;
    float roughness = 0.5, metallic = 0.0, opacity = fallback.a;
    bool unlit = false;
    int material = int(v_material.y);
    if (material > 0) {
        vec4 parameters[32], surface[8];
        for (int i = 0; i < 32; i++) parameters[i] = material_value(i + 2);
        sg_dispatch(material, sg_context, parameters, surface);
        base = max(surface[0].rgb, vec3(0));
        emission = max(surface[1].rgb, vec3(0));
        roughness = clamp(surface[2].x, 0.0, 1.0);
        metallic = clamp(surface[3].x, 0.0, 1.0);
        normal = safe_normal(surface[4].xyz, normal);
        opacity = clamp(surface[5].x, 0.0, 1.0);
        unlit = surface[6].x > 0.5;
    }
    if (isnan(opacity) || opacity <= 0.0) discard;
    vec3 color = (unlit ? base : direct_light(base, roughness, metallic, normal, view)) + emission;
    // Keep the scene-linear result within RGBA16F storage. A graph can produce
    // a larger value without turning subsequent bloom taps into infinity.
    if (isnan(color.r)) color.r = 0.0;
    if (isnan(color.g)) color.g = 0.0;
    if (isnan(color.b)) color.b = 0.0;
    result = vec4(clamp(color, vec3(0), vec3(65504)), opacity);
}
layout(location = 0) in vec3 in_pos;
layout(location = 1) in vec3 in_normal;
layout(location = 8) in vec4 in_model0;
layout(location = 9) in vec4 in_model1;
layout(location = 10) in vec4 in_model2;
layout(location = 11) in vec4 in_uv_rect;
layout(location = 15) in vec4 in_mesh_attributes;
layout(location = 0) out vec3 v_normal;
layout(location = 1) out vec3 v_world;
layout(location = 2) flat out vec4 v_material;
layout(set = 1, binding = 0) uniform uniform_block {
    mat4 u_view_projection;
};

void main()
{
    vec4 p = vec4(in_pos, 1.0);
    vec3 world = vec3(dot(in_model0, p), dot(in_model1, p), dot(in_model2, p));
    // Cofactors preserve perpendicular normals under nonuniform positive scale.
    vec3 a = vec3(in_model0.x, in_model1.x, in_model2.x);
    vec3 b = vec3(in_model0.y, in_model1.y, in_model2.y);
    vec3 c = vec3(in_model0.z, in_model1.z, in_model2.z);
    v_normal = normalize(cross(b, c) * in_normal.x +
                         cross(c, a) * in_normal.y + cross(a, b) * in_normal.z);
    v_world = world;
    v_material = in_uv_rect;
    gl_Position = u_view_projection * vec4(world, 1.0);
}
#define SG_SCENE_INFLUENCE 1

#ifndef SG_RAMP_COUNT
#define SG_RAMP_COUNT 512
#endif

layout(set = 3, binding = 0) uniform uniform_block {
    vec4 arena_camera_time;
    vec4 arena_rhythm;
    vec4 arena_light_count;
    vec4 arena_light_positions[32];
    vec4 arena_light_colors[32];
    vec4 arena_influence_count;
    vec4 arena_influence_positions[64];
    vec4 arena_influence_colors[64];
    vec4 sg_ramp_data[SG_RAMP_COUNT];
};

float sg_scene_beat_phase() { return arena_rhythm.x; }
float sg_scene_beat_pulse() { return arena_rhythm.y; }

vec3 sg_scene_influence(vec3 position)
{
    vec3 activity = vec3(0);
    for (int i = 0; i < int(arena_influence_count.x); i++) {
        vec4 source = arena_influence_positions[i];
        vec2 delta = (position.xz - source.xy) / source.z;
        float distance_squared = dot(delta, delta);
        if (distance_squared >= 1.0) continue;
        float fade = 1.0 - distance_squared;
        if (source.w > 0.0) {
            float middle = (1.0 + source.w) * 0.5;
            float half_width = (1.0 - source.w) * 0.5;
            fade = max(0.0, 1.0 - abs(sqrt(distance_squared) - middle) / half_width);
        }
        activity = max(activity, arena_influence_colors[i].rgb * fade * fade);
    }
    return activity;
}
layout(set = 3, binding = 1) uniform shd_uniforms {
    vec2 step_uv;
};

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 uv = params.uv;
    // Nine-tap Gaussian, sigma two samples. The caller sets their spacing in
    // viewport units, so non-square targets and resizing preserve the radius.
    vec3 c = texture(u_image, uv).rgb * 0.204164;
    c += (texture(u_image, uv - step_uv).rgb + texture(u_image, uv + step_uv).rgb) * 0.180174;
    c += (texture(u_image, uv - step_uv * 2.0).rgb + texture(u_image, uv + step_uv * 2.0).rgb) * 0.123832;
    c += (texture(u_image, uv - step_uv * 3.0).rgb + texture(u_image, uv + step_uv * 3.0).rgb) * 0.066282;
    c += (texture(u_image, uv - step_uv * 4.0).rgb + texture(u_image, uv + step_uv * 4.0).rgb) * 0.027630;
    return vec4(c, 1);
}
layout(set = 2, binding = 1) uniform sampler2D bloom_low;
layout(set = 2, binding = 2) uniform sampler2D bloom_high;
layout(set = 3, binding = 1) uniform shd_uniforms {
    float exposure;
    float strength;
    float level_mix;
};

vec3 finite_hdr(vec3 c)
{
    if (isnan(c.r)) c.r = 0.0;
    if (isnan(c.g)) c.g = 0.0;
    if (isnan(c.b)) c.b = 0.0;
    return clamp(c, vec3(0), vec3(65504));
}

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 uv = params.uv;
    vec3 scene = finite_hdr(texture(u_image, uv).rgb);
    vec3 bloom = vec3(0);
    if (strength > 0.0) {
        bloom = mix(finite_hdr(texture(bloom_low, uv).rgb), finite_hdr(texture(bloom_high, uv).rgb), level_mix);
    }
    vec3 hdr = (scene + bloom * strength) * exp2(exposure);
    // Reinhard written without inf/inf for values above half-float range.
    vec3 mapped = 1.0 - 1.0 / (1.0 + hdr);
    vec3 srgb = mix(mapped * 12.92, 1.055 * pow(mapped, vec3(1.0 / 2.4)) - 0.055,
                    step(vec3(0.0031308), mapped));
    return vec4(srgb, 1);
}
layout(set = 3, binding = 1) uniform shd_uniforms {
    vec2 source_texel;
    float threshold;
};

vec3 sample_bright(vec2 uv)
{
    vec3 c = texture(u_image, uv).rgb;
    if (isnan(c.r)) c.r = 0.0;
    if (isnan(c.g)) c.g = 0.0;
    if (isnan(c.b)) c.b = 0.0;
    c = clamp(c, vec3(0), vec3(65504));
    float peak = max(c.r, max(c.g, c.b));
    return threshold < 0.0 ? c : c * max(peak - threshold, 0.0) / max(peak, 0.00001);
}

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 d = source_texel * 0.5;
    vec2 uv = params.uv;
    vec3 c = sample_bright(uv + vec2(-d.x, -d.y));
    c += sample_bright(uv + vec2(d.x, -d.y));
    c += sample_bright(uv + vec2(-d.x, d.y));
    c += sample_bright(uv + d);
    return vec4(c * 0.25, 1);
}
layout(location = 0) in vec4 v_color;
layout(location = 1) in vec4 v_edge;
layout(location = 0) out vec4 result;

void main()
{
    float side = 1.0 - abs(v_edge.x);
    vec3 distance = vec3(side, v_edge.y, v_edge.z);
    vec3 coverage = smoothstep(vec3(0), max(fwidth(distance), vec3(0.00001)), distance);
    float alpha = v_color.a * min(coverage.x, min(coverage.y, coverage.z));
    if (alpha <= 0.0) discard;
    result = vec4(clamp(v_color.rgb * (1.0 + v_edge.w), vec3(0), vec3(65504)), alpha);
}
layout(location = 0) in vec3 in_pos;
layout(location = 1) in vec4 in_color;
layout(location = 2) in vec4 in_edge;
layout(location = 8) in vec4 in_model0;
layout(location = 9) in vec4 in_model1;
layout(location = 10) in vec4 in_model2;
layout(location = 0) out vec4 v_color;
layout(location = 1) out vec4 v_edge;
layout(set = 1, binding = 0) uniform uniform_block {
    mat4 u_view_projection;
    vec4 trail_origin;
};

void main()
{
    vec3 world = vec3(dot(in_model0.xyz, in_pos), dot(in_model1.xyz, in_pos),
                      dot(in_model2.xyz, in_pos)) + trail_origin.xyz;
    v_color = in_color;
    v_edge = in_edge;
    gl_Position = u_view_projection * vec4(world, 1.0);
}
// From Neon-Swarm shaders/color.shd.
// Shared color and blending utilities.

vec4 alpha_over(vec4 front, vec4 back)
{
    return front + back * (1.0 - front.a);
}

vec3 linear_to_srgb(vec3 c)
{
    return pow(c, vec3(1.0 / 2.2));
}

float dither8bit_ign(vec2 pixel, float frame)
{
    pixel += frame * 5.588238;
    float t = fract(52.9829189 * fract(dot(pixel, vec2(0.06711056, 0.00583715))));
    return (t - 0.5) / 255.0;
}
// Adapted from the user-supplied Neon-Swarm shaders. Original shader equations retained.
// Shared std430 layout; must match render_material_entity in material_raster.h.

#define SHAPE_CIRCLE   0
#define SHAPE_BOX      1
#define SHAPE_CAPSULE  2
#define SHAPE_LINE     3
#define SHAPE_TRI      4
#define SHAPE_POLY     5
#define SHAPE_DIAMOND    6
#define SHAPE_POLY_FILL  7

struct Entity {
    vec4 inv_rot;       // inv_xx, inv_xy, inv_yx, inv_yy
    vec2 pos;           // pos_x, pos_y
    vec2 extent;       // conservative world-space half extents
    uint shape_type;
    float radius;
    float thickness;
    float chubbiness;
    float aa;
    uint point_count;
    uint metaball_group;
    float metaball_blend;
    float border_thickness;
    float reserved0; float reserved1; float reserved2;
    vec4 points_01;     // points[0..3]
    vec4 points_23;     // points[4..7]
    vec4 points_45;     // points[8..11]
    vec4 points_67;     // points[12..15]
    vec4 scene;
    vec4 emission;
    vec4 absorption;
    vec4 albedo;
    vec4 border_scene;
    vec4 border_emission;
    vec4 border_absorption;
    vec4 border_albedo;
    vec4 wobble_pad; // .x = wobble, .y = ang_freq, .z = time_freq, .w = sort_key
    vec4 pluck_data; // .x=amplitude, .y=origin, .z=age, .w=speed
    vec3 simulation_time;
    float tile_group;   // nonzero: adds coverage with neighbors sharing it
    vec4 material_frame; // laid-out position (Y up), cos, sin; zero cos and sin = none
};
layout(set = 2, binding = 1) uniform sampler2D visibility_mask;
layout(set = 3, binding = 1) uniform shd_uniforms {
    mat4 inverse_camera;
    vec4 fog_color;
    vec2 grid_origin;
    vec2 grid_extent;
    vec2 view_center;
    vec2 view_span;
    float fog_time;
    int perspective;
};

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 ndc = params.screen_uv * vec2(2, -2) + vec2(-1, 1);
    vec2 world = view_center + ndc * view_span * vec2(0.5, -0.5);
    if (perspective != 0) {
        vec4 near_h = inverse_camera * vec4(ndc, 0, 1);
        vec4 far_h = inverse_camera * vec4(ndc, 1, 1);
        vec3 origin = near_h.xyz / near_h.w;
        vec3 direction = far_h.xyz / far_h.w - origin;
        world = (origin - direction * origin.y / direction.y).xz;
    }
    vec2 uv = (world - grid_origin) / grid_extent;
    float sight = texture(visibility_mask, clamp(uv, vec2(0), vec2(1))).r;
    if (any(lessThan(uv, vec2(0))) || any(greaterThanEqual(uv, vec2(1)))) sight = 0;
    float opacity = 1 - smoothstep(0.15, 0.85, sight);
    float clouds = sin(world.x * 0.018 + fog_time * 0.2) * sin(world.y * 0.023 - fog_time * 0.13);
    vec3 tint = fog_color.rgb * (1 + clouds * 0.12);
    return vec4(tint, opacity);
}
// Adapted from Neon-Swarm shaders/hrc/bounce.shd; original source comments retained.
// Reflected light for the next frame's transport: albedo times this frame's
// received far light. Alpha blending with u_hysteresis as alpha mixes it into
// the previous result in place.

layout(set = 2, binding = 0) uniform sampler2D u_radiance;
layout(set = 2, binding = 1) uniform sampler2D u_albedo;

layout(location = 0) out vec4 out_value;

layout(set = 3, binding = 0) uniform uniform_block
{
	float u_hysteresis;
};

void main()
{
	ivec2 p = ivec2(gl_FragCoord.xy);
	vec2 size = vec2(textureSize(u_radiance, 0));
	ivec2 albedo_p = ivec2((vec2(p) + 0.5) * vec2(textureSize(u_albedo, 0)) / size);
	vec3 bounce = texelFetch(u_albedo, albedo_p, 0).rgb * texelFetch(u_radiance, p, 0).rgb;
	out_value = vec4(bounce, u_hysteresis);
}
// Material targets; see render_material_textures.
layout(set = 2, binding = 1) uniform sampler2D scene_tex;
layout(set = 2, binding = 2) uniform sampler2D fluence_tex;
layout(set = 2, binding = 3) uniform sampler2D source_tex;
layout(set = 2, binding = 4) uniform sampler2D albedo_tex;
layout(set = 2, binding = 5) uniform sampler2D normal_tex;

layout(set = 2, binding = 6) uniform sampler2D background_tex;
layout(set = 2, binding = 7) uniform sampler2D visibility_tex;
layout(set = 2, binding = 8) uniform sampler2D surface_tex;
layout(set = 2, binding = 9) uniform sampler2D surface_dir_tex;
layout(set = 2, binding = 10) uniform sampler2D cover_tex;

layout(set = 3, binding = 1) uniform shd_uniforms
{
    float ambient;
    float intensity;
    float debug_view;
    float shadow_floor;
    float fog;
    float dither_phase;
    vec4 crop_uv;
    float surface_sigma;
    // x enabled, y relief, z bevel, w specular gain.
    vec4 surface_params;
    // xy canvas uv to surface uv scale, zw one surface texel in uv.
    vec4 surface_map;
    int linear_output;
    float world_per_px;
    float reconstruction_threshold;
};

#include "color.shd"

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

float reconstruction_transmittance(ivec2 p, ivec2 sample_size, ivec2 full_size)
{
    vec2 uv = (vec2(p) + 0.5) / vec2(sample_size);
    ivec2 absorption_p = clamp(ivec2(uv * vec2(full_size)), ivec2(0), full_size - 1);
    float tau = texelFetch(source_tex, absorption_p, 0).a;
    return exp(-max(tau, 0.0));
}

vec4 reconstruction_weights(vec2 uv, ivec2 sample_size, ivec2 full_size,
                            out ivec2 p00, out ivec2 p10,
                            out ivec2 p01, out ivec2 p11)
{
    vec2 grid = uv * vec2(sample_size) - 0.5;
    ivec2 base = ivec2(floor(grid));
    vec2 f = fract(grid);
    ivec2 last = sample_size - 1;
    p00 = clamp(base, ivec2(0), last);
    p10 = clamp(base + ivec2(1, 0), ivec2(0), last);
    p01 = clamp(base + ivec2(0, 1), ivec2(0), last);
    p11 = clamp(base + ivec2(1, 1), ivec2(0), last);

    ivec2 center = clamp(ivec2(uv * vec2(full_size)), ivec2(0), full_size - 1);
    float target = exp(-max(texelFetch(source_tex, center, 0).a, 0.0));
    float t00 = reconstruction_transmittance(p00, sample_size, full_size) - target;
    float t10 = reconstruction_transmittance(p10, sample_size, full_size) - target;
    float t01 = reconstruction_transmittance(p01, sample_size, full_size) - target;
    float t11 = reconstruction_transmittance(p11, sample_size, full_size) - target;
    float sigma = max(reconstruction_threshold, 0.02);
    float sigma2 = 2.0 * sigma * sigma;
    return vec4((1.0 - f.x) * (1.0 - f.y) * exp(-(t00 * t00) / sigma2),
                f.x * (1.0 - f.y) * exp(-(t10 * t10) / sigma2),
                (1.0 - f.x) * f.y * exp(-(t01 * t01) / sigma2),
                f.x * f.y * exp(-(t11 * t11) / sigma2));
}

// Material height times coverage, and the coverage.
vec2 relief_at(vec2 uv)
{
    return vec2(texture(albedo_tex, uv).a, texture(scene_tex, uv).a);
}

vec3 sample_fluence(vec2 uv)
{
    ivec2 sample_size = textureSize(fluence_tex, 0);
    ivec2 full_size = textureSize(source_tex, 0);
    if (all(equal(sample_size, full_size))) return texture(fluence_tex, uv).rgb;

    ivec2 p00, p10, p01, p11;
    vec4 weights = reconstruction_weights(uv, sample_size, full_size, p00, p10, p01, p11);
    float total = dot(weights, vec4(1));
    if (total <= 1e-6) return vec3(0);
    vec3 sum = texelFetch(fluence_tex, p00, 0).rgb * weights.x +
               texelFetch(fluence_tex, p10, 0).rgb * weights.y +
               texelFetch(fluence_tex, p01, 0).rgb * weights.z +
               texelFetch(fluence_tex, p11, 0).rgb * weights.w;
    return max(sum / total, vec3(0));
}

// GGX distribution, height-correlated Smith visibility and Schlick Fresnel for
// a dielectric, viewed straight down the camera axis.
float highlight(vec3 n, vec3 l, float roughness)
{
    vec3 h = normalize(l + vec3(0, 0, 1));
    float nv = max(n.z, 0.0001);
    float nl = max(dot(n, l), 0.0);
    float nh = max(dot(n, h), 0.0);
    float alpha = max(roughness * roughness, 0.0025);
    float a2 = alpha * alpha;
    float d = nh * nh * (a2 - 1.0) + 1.0;
    float distribution = a2 / max(3.14159265 * d * d, 0.00000001);
    float visibility = 0.5 / max(nl * sqrt(nv * nv * (1.0 - a2) + a2) +
                                 nv * sqrt(nl * nl * (1.0 - a2) + a2), 0.0001);
    float fresnel = 0.04 + 0.96 * pow(1.0 - max(h.z, 0.0), 5.0);
    return fresnel * distribution * visibility * nl;
}

// Emission as display shows it: each texel's light scaled back by its cover,
// then filtered, so partly covered edges keep their coverage.
vec3 display_emission(vec2 uv)
{
    ivec2 size = textureSize(source_tex, 0);
    vec2 p = uv * vec2(size) - 0.5;
    ivec2 lo = clamp(ivec2(floor(p)), ivec2(0), size - 1);
    ivec2 hi = min(lo + 1, size - 1);
    vec2 f = clamp(p - floor(p), 0.0, 1.0);
    vec3 e00 = texelFetch(source_tex, lo, 0).rgb * texelFetch(cover_tex, lo, 0).r;
    vec3 e10 = texelFetch(source_tex, ivec2(hi.x, lo.y), 0).rgb * texelFetch(cover_tex, ivec2(hi.x, lo.y), 0).r;
    vec3 e01 = texelFetch(source_tex, ivec2(lo.x, hi.y), 0).rgb * texelFetch(cover_tex, ivec2(lo.x, hi.y), 0).r;
    vec3 e11 = texelFetch(source_tex, hi, 0).rgb * texelFetch(cover_tex, hi, 0).r;
    return mix(mix(e00, e10, f.x), mix(e01, e11, f.x), f.y);
}

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 source_uv = mix(crop_uv.xy, crop_uv.zw, screen_uv);
    vec4 scene = texture(scene_tex, source_uv);
    vec4 source = texture(source_tex, source_uv);
    vec3 emission = display_emission(source_uv);
    vec3 albedo = texture(albedo_tex, source_uv).rgb;
    vec3 fluence = sample_fluence(source_uv);
    vec4 normal = texture(normal_tex, source_uv);

    int mode = int(debug_view + 0.5);
    if (mode == 1) return scene;
    if (mode == 2) return vec4(emission, 1.0);
    if (mode == 3) return vec4(vec3(exp(-source.a)), 1.0);
    if (mode == 4) return vec4(albedo, 1.0);
    if (mode == 5) return vec4(fluence * 5.0, 1.0);
    if (mode == 6) return vec4(normal.xyz * 0.5 + 0.5, normal.a);

    // Screen-space liquid distortion samples the background and incident light.
    // Foreground opaque objects remain in front; this is not a depth/Snell solve.
    vec2 pixel_uv = 1.0 / vec2(textureSize(normal_tex, 0));
    vec2 distortion = normal.z < 0.0 ? normal.xy * (-normal.z) * pixel_uv : vec2(0);
    vec2 fluence_uv = source_uv + distortion;
    if (normal.z < 0.0) fluence = sample_fluence(fluence_uv);
    vec4 visibility = texture(visibility_tex, source_uv);
    // The same exposure as visible emitters reveals light received by fluid.
    // Coverage blends this artistic gain; it never feeds the transport solver.
    float volume_exposure = mix(1.0, intensity, visibility.a);
    vec3 incident = fluence * volume_exposure;
    if (normal.z < 0.0) {
        // Liquid edges brighten from light received just outside them.
        vec2 reach = 8.0 * pixel_uv;
        vec3 outside = .25 * (sample_fluence(source_uv + vec2(reach.x, 0)) +
                              sample_fluence(source_uv - vec2(reach.x, 0)) +
                              sample_fluence(source_uv + vec2(0, reach.y)) +
                              sample_fluence(source_uv - vec2(0, reach.y)));
        incident += outside * normal.a * 2.0 * intensity;
    }

    // Solids: normal.xy is the bump tilt (world axes, y up), z the edge-light
    // gain and w the gloss. Light from the open space around a solid reaches
    // surface_radius into it. It arrives from four quadrants; within each, the
    // slope of that quadrant's light points at its sources. No received light
    // means no surface light.
    bool solid = normal.z > 0.0 || (normal.z == 0.0 && (normal.w > 0.0 || dot(normal.xy, normal.xy) > 0.0));
    vec3 surface_light = vec3(0);
    vec2 tilt = solid ? normal.xy : vec2(0);
    // Per quadrant: light fraction and direction toward it (world axes, y up).
    vec4 weights = vec4(0);
    vec2 dirs[4] = vec2[4](vec2(1, 0), vec2(0, -1), vec2(-1, 0), vec2(0, 1));
    if (solid && surface_params.x > 0.0) {
        vec2 suv = source_uv * surface_map.xy;
        vec2 dx = vec2(surface_map.z, 0), dy = vec2(0, surface_map.w);
        vec4 s = texture(surface_tex, suv);
        vec4 left = texture(surface_tex, suv - dx), right = texture(surface_tex, suv + dx);
        vec4 up = texture(surface_tex, suv - dy), down = texture(surface_tex, suv + dy);
        vec4 q = max(texture(surface_dir_tex, suv), vec4(0));
        // Texture rows run down the screen; world axes run up.
        vec4 qx = texture(surface_dir_tex, suv + dx) - texture(surface_dir_tex, suv - dx);
        vec4 qy = texture(surface_dir_tex, suv - dy) - texture(surface_dir_tex, suv + dy);
        float open = max(s.a, 0.0);
        // One at a straight face, less in concave corners, zero one radius deep.
        float reach = clamp((2.0 * open - 0.05) / 0.95, 0.0, 1.0);
        surface_light = s.rgb / max(open, 1e-4) * reach * normal.z * intensity;
        weights = q / max(dot(q, vec4(1)), 1e-6);
        for (int i = 0; i < 4; i++) {
            vec2 slope = 0.5 * surface_sigma * vec2(qx[i], qy[i]) / max(q[i], 1e-6);
            vec2 d = dirs[i] + slope / max(1.0, length(slope));
            // Keep each direction within its quadrant's half plane.
            d -= dirs[i] * min(dot(d, dirs[i]) - 0.2, 0.0);
            dirs[i] = normalize(d);
        }
        // Near a silhouette the surface turns toward the open side (rim light).
        vec2 outward = 0.5 * surface_sigma * vec2(right.a - left.a, up.a - down.a);
        tilt += outward * surface_params.z * step(1e-4, normal.z);
    }
    incident += surface_light;
    vec3 n = vec3(0, 0, 1);
    if (solid) n = normalize(vec3(tilt, sqrt(max(1.0 - dot(normal.xy, normal.xy), 0.0))));
    // Material relief shadows itself: march toward the dominant light over
    // the height field, which rises 1/relief units per unit across the plane.
    // Open space casts no relief shadow.
    float shadow = 1.0;
    vec2 relief = relief_at(source_uv);
    vec2 toward = vec2(0);
    for (int i = 0; i < 4; i++) toward += weights[i] * dirs[i];
    if (solid && relief.y > 0.5 && dot(toward, toward) > 0.01) {
        float h0 = relief.x / relief.y;
        const float STEP = 0.6;
        vec2 step_uv = normalize(vec2(toward.x, -toward.y)) * (STEP / world_per_px) * pixel_uv;
        float rise = STEP / max(surface_params.y, 1e-3);
        for (int i = 1; i <= 10; i++) {
            vec2 r = relief_at(source_uv + step_uv * float(i));
            if (r.y < 0.5) break;
            shadow = min(shadow, clamp(1.0 - (r.x / r.y - h0 - rise * float(i)), 0.0, 1.0));
        }
    }
    // A flat face keeps the received light; tilted relief gains or loses it.
    // Specular is a physically based dielectric for the same light; one in
    // surface_params.w means physical.
    float gloss = solid ? clamp(normal.w, 0.0, 1.0) : 0.0;
    float diffuse = 0.0, sheen = 0.0;
    vec2 dominant = vec2(0);
    if (dot(weights, vec4(1)) <= 0.0) {
        diffuse = 1.0;
    }
    for (int i = 0; i < 4; i++) {
        if (weights[i] <= 0.0) continue;
        vec3 l = normalize(vec3(dirs[i] * surface_params.y, 1.0));
        diffuse += weights[i] * max(dot(n, l), 0.0) / l.z;
        if (gloss > 0.0) {
            sheen += weights[i] * 3.14159265 * highlight(n, l, 1.0 - gloss) / l.z * surface_params.w;
        }
        dominant += weights[i] * dirs[i];
    }
    diffuse = mix(diffuse * shadow, diffuse, 1.0 - dot(weights, vec4(1)));
    sheen *= shadow;
    if (mode == 7) return vec4(surface_light, 1.0);
    if (mode == 8) return vec4(dominant * 0.5 + 0.5, shadow, 1.0);
    if (mode == 9) return vec4(n * 0.5 + 0.5, 1.0);

    vec3 lit = incident * (albedo * diffuse + vec3(sheen)) +
               max(albedo * shadow_floor, visibility.rgb);
    vec3 out_linear = fluence * fog + emission * intensity + scene.rgb * ambient + lit;
    vec2 background_uv = clamp(screen_uv + distortion / (crop_uv.zw - crop_uv.xy), vec2(0), vec2(1));
    out_linear += texture(background_tex, background_uv).rgb * (1.0 - scene.a);
    if (linear_output != 0) return vec4(max(out_linear, vec3(0.0)), 1.0);
    vec3 out_srgb = linear_to_srgb(max(out_linear, vec3(0.0)));
    float dither = dither8bit_ign(gl_FragCoord.xy, dither_phase);
    return vec4(clamp(out_srgb + vec3(dither), vec3(0.0), vec3(1.0)), 1.0);
}
// Averages prefiltered transport inputs over square blocks of u_factor fine
// cells for a coarser grid: the far-field cascades, or color transport under a
// finer luminance transport. The view snaps to whole coarse cells, so blocks
// stay world-aligned; blocks past a dimension's end cover what remains.
// Light and transmittance average over a step of the coarse cell's length, in
// canvas pixels, as hrc/source_average.shd describes.

#include "hrc/source_average.shd"

layout(set = 2, binding = 0) uniform sampler2D u_source;
layout(set = 2, binding = 1) uniform sampler2D u_bounce;

layout(location = 0) out vec4 out_source;
layout(location = 1) out vec4 out_bounce;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_fine_w;
	int u_fine_h;
	int u_factor;
	float u_coarse_step;
};

void main()
{
	ivec2 gid = ivec2(gl_FragCoord.xy);

	ivec2 lo = gid * u_factor;
	ivec2 hi = min(lo + u_factor, ivec2(u_fine_w, u_fine_h));

	vec4 part = vec4(0.0), bounce = vec4(0.0);
	for (int y = lo.y; y < hi.y; y++) {
		for (int x = lo.x; x < hi.x; x++) {
			part += source_step(texelFetch(u_source, ivec2(x, y), 0), u_coarse_step);
			bounce += texelFetch(u_bounce, ivec2(x, y), 0);
		}
	}
	float inv_count = 1.0 / float((hi.x - lo.x) * (hi.y - lo.y));
	out_source = source_resolve(part * inv_count, u_coarse_step);
	out_bounce = bounce * inv_count;
}
// Adapted from the user-supplied Neon-Swarm shaders. Original shader equations retained.
// Entity tile rasterization pass.
//
// A full-screen fragment pass. Each pixel iterates its 16x16 tile's entity
// list, transforms to entity local space, evaluates the shape SDF, and blends
// the results into render targets, which the GPU compresses:
//   scene:  premultiplied color, A coverage
//   source: RGB emission, A optical depth (mean absorption) for the transport
//   albedo: RGB albedo, A material height times coverage; the coverage is
//           scene's alpha, which the same over-recurrence accumulates
//   normal: see render_material_textures
//   visibility: zero; fluid adds it
//   cover: R, the scale that returns source's emission to display's
// Later batches start from the previous batch's targets.

#include "entity.shd"
#ifndef SG_ENTITY_BINDING
#define SG_PREVIOUS_SCENE_BINDING 0
#define SG_PREVIOUS_SOURCE_BINDING 1
#define SG_PREVIOUS_ALBEDO_BINDING 2
#define SG_PREVIOUS_NORMAL_BINDING 3
#define SG_PREVIOUS_COVER_BINDING 4
#define SG_ENTITY_BINDING 0
#define SG_COUNTS_BINDING 1
#define SG_INDICES_BINDING 2
#define SG_PARAMETERS_BINDING 3
#endif
#ifndef SG_RAMP_COUNT
#define SG_RAMP_COUNT 512
#endif
#ifndef SG_GRAPHS
void sg_dispatch_2d(int id,vec2 p,vec2 wp,vec2 half_size,float time,vec4 values[32],out vec4 result[8]) {
 for(int i=0;i<8;i++) result[i]=vec4(0);
}
layout(set = 3, binding = 0) uniform uniform_block {
    float u_world_min_x;
    float u_world_max_y;
    vec2 u_unit_per_px;
    int u_tiles_x;
    int u_first_entity;
    int u_last_entity;
    int u_metaball_group;
    vec4 sg_ramp_data[SG_RAMP_COUNT];
};
#endif
// GLSL ES emulates each storage buffer as texel fetches of a single vec4 or
// uvec4 array, so entities and tile lists are read through uvec4 arrays.
layout(set = 2, binding = SG_ENTITY_BINDING) readonly buffer EntityBuf { uvec4 entity_data[]; };
layout(set = 2, binding = SG_COUNTS_BINDING) readonly buffer TileOffsets { uvec4 tile_offsets[]; };
layout(set = 2, binding = SG_INDICES_BINDING) readonly buffer TileEntities { uvec4 tile_entities[]; };
layout(set = 2, binding = SG_PARAMETERS_BINDING) readonly buffer ShaderParameters { vec4 shader_parameters[]; };

#define ENTITY_VEC4S 21u

uint tile_offset(uint i) { return tile_offsets[i >> 2u][i & 3u]; }
uint tile_entity(uint i) { return tile_entities[i >> 2u][i & 3u]; }
vec4 entity_vec4(uint i) { return uintBitsToFloat(entity_data[i]); }

Entity entity_at(uint index)
{
    uint b = index * ENTITY_VEC4S;
    Entity e;
    e.inv_rot = entity_vec4(b);
    vec4 v = entity_vec4(b + 1u);
    e.pos = v.xy;
    e.extent = v.zw;
    uvec4 u = entity_data[b + 2u];
    e.shape_type = u.x;
    e.radius = uintBitsToFloat(u.y);
    e.thickness = uintBitsToFloat(u.z);
    e.chubbiness = uintBitsToFloat(u.w);
    u = entity_data[b + 3u];
    e.aa = uintBitsToFloat(u.x);
    e.point_count = u.y;
    e.metaball_group = u.z;
    e.metaball_blend = uintBitsToFloat(u.w);
    v = entity_vec4(b + 4u);
    e.border_thickness = v.x;
    e.reserved0 = v.y;
    e.reserved1 = v.z;
    e.reserved2 = v.w;
    e.points_01 = entity_vec4(b + 5u);
    e.points_23 = entity_vec4(b + 6u);
    e.points_45 = entity_vec4(b + 7u);
    e.points_67 = entity_vec4(b + 8u);
    e.scene = entity_vec4(b + 9u);
    e.emission = entity_vec4(b + 10u);
    e.absorption = entity_vec4(b + 11u);
    e.albedo = entity_vec4(b + 12u);
    e.border_scene = entity_vec4(b + 13u);
    e.border_emission = entity_vec4(b + 14u);
    e.border_absorption = entity_vec4(b + 15u);
    e.border_albedo = entity_vec4(b + 16u);
    e.wobble_pad = entity_vec4(b + 17u);
    e.pluck_data = entity_vec4(b + 18u);
    v = entity_vec4(b + 19u);
    e.simulation_time = v.xyz;
    e.tile_group = v.w;
    e.material_frame = entity_vec4(b + 20u);
    return e;
}

#ifdef SG_ACCUMULATE
layout(set = 2, binding = SG_PREVIOUS_SCENE_BINDING) uniform sampler2D u_prev_scene;
layout(set = 2, binding = SG_PREVIOUS_SOURCE_BINDING) uniform sampler2D u_prev_source;
layout(set = 2, binding = SG_PREVIOUS_ALBEDO_BINDING) uniform sampler2D u_prev_albedo;
layout(set = 2, binding = SG_PREVIOUS_NORMAL_BINDING) uniform sampler2D u_prev_normal;
layout(set = 2, binding = SG_PREVIOUS_COVER_BINDING) uniform sampler2D u_prev_cover;
#endif

layout(location = 0) out vec4 out_scene;
layout(location = 1) out vec4 out_source;
layout(location = 2) out vec4 out_albedo;
layout(location = 3) out vec4 out_normal;
layout(location = 4) out vec4 out_visibility;
layout(location = 5) out vec4 out_cover;

// Tile lists are already ordered by stable CPU sort and deterministic binning.

#include "sdf.shd"
#include "noise.shd"

float sdf_polyline(vec2 p, Entity e)
{
    int count = int(e.point_count);
    if (count < 3) count = 3;
    if (count > 8) count = 8;

    // Extract points.
    vec2 pts[8];
    pts[0] = e.points_01.xy;
    pts[1] = e.points_01.zw;
    pts[2] = e.points_23.xy;
    pts[3] = e.points_23.zw;
    pts[4] = e.points_45.xy;
    pts[5] = e.points_45.zw;
    pts[6] = e.points_67.xy;
    pts[7] = e.points_67.zw;

    // Min distance to any closed polyline segment.
    float min_d = 1e30;
    for (int i = 0; i < count; i++) {
        int j = (i + 1) % count;
        // Manually index to avoid dynamic indexing issues.
        vec2 a, b;
        // Use ternary chain for compile-time indexable access.
        a = (i == 0) ? pts[0] : (i == 1) ? pts[1] : (i == 2) ? pts[2] : (i == 3) ? pts[3] :
            (i == 4) ? pts[4] : (i == 5) ? pts[5] : (i == 6) ? pts[6] : pts[7];
        b = (j == 0) ? pts[0] : (j == 1) ? pts[1] : (j == 2) ? pts[2] : (j == 3) ? pts[3] :
            (j == 4) ? pts[4] : (j == 5) ? pts[5] : (j == 6) ? pts[6] : pts[7];
        float d = sdf_segment(p, a, b);
        min_d = min(min_d, d);
    }
    return min_d - e.thickness * 0.5;
}

float sdf_polygon_filled(vec2 p, Entity e)
{
    int count = int(e.point_count);
    if (count < 3) count = 3;
    if (count > 8) count = 8;

    // Extract points.
    vec2 pts[8];
    pts[0] = e.points_01.xy;
    pts[1] = e.points_01.zw;
    pts[2] = e.points_23.xy;
    pts[3] = e.points_23.zw;
    pts[4] = e.points_45.xy;
    pts[5] = e.points_45.zw;
    pts[6] = e.points_67.xy;
    pts[7] = e.points_67.zw;

    // Winding-number SDF for filled polygon.
    float min_d = 1e30;
    float winding = 0.0;
    for (int i = 0; i < count; i++) {
        int j = (i + 1) % count;
        vec2 a = (i == 0) ? pts[0] : (i == 1) ? pts[1] : (i == 2) ? pts[2] : (i == 3) ? pts[3] :
                 (i == 4) ? pts[4] : (i == 5) ? pts[5] : (i == 6) ? pts[6] : pts[7];
        vec2 b = (j == 0) ? pts[0] : (j == 1) ? pts[1] : (j == 2) ? pts[2] : (j == 3) ? pts[3] :
                 (j == 4) ? pts[4] : (j == 5) ? pts[5] : (j == 6) ? pts[6] : pts[7];

        vec2 edge = b - a;
        vec2 pa = p - a;
        float t = clamp(dot(pa, edge) / max(dot(edge, edge), 1e-20), 0.0, 1.0);
        float d = length(pa - edge * t);
        min_d = min(min_d, d);

        // Winding number contribution.
        bvec3 cond = bvec3(a.y <= p.y, b.y > p.y, edge.x * pa.y - edge.y * pa.x > 0.0);
        if (all(cond)) winding += 1.0;
        cond = bvec3(a.y > p.y, b.y <= p.y, edge.x * pa.y - edge.y * pa.x < 0.0);
        if (all(cond)) winding -= 1.0;
    }
    return (winding != 0.0) ? -min_d : min_d;
}

// Where a material samples the world: the laid-out frame when the entity
// carries one, so patterns stay attached to moving fragments.
vec2 material_position(Entity e, vec2 local_p, vec2 world_pos)
{
    vec4 f = e.material_frame;
    if (f.z == 0.0 && f.w == 0.0) return world_pos;
    return f.xy + vec2(f.z * local_p.x - f.w * local_p.y, f.w * local_p.x + f.z * local_p.y);
}

vec2 shader_half_size(Entity e)
{
    if (e.shape_type == SHAPE_CIRCLE)
        return vec2(e.radius + e.thickness * 0.5);
    if (e.shape_type == SHAPE_DIAMOND)
        return vec2(e.radius + e.chubbiness + e.thickness * 0.5);
    if (e.shape_type == SHAPE_BOX)
        return abs(e.points_01.xy) + e.thickness * 0.5;
    vec2 bounds = max(abs(e.points_01.xy), abs(e.points_01.zw));
    if (e.shape_type == SHAPE_CAPSULE) return bounds + e.radius + e.thickness * 0.5;
    if (e.shape_type == SHAPE_LINE) return bounds + e.thickness * 0.5;
    vec2 points[6] = vec2[6](e.points_23.xy,e.points_23.zw,e.points_45.xy,
                            e.points_45.zw,e.points_67.xy,e.points_67.zw);
    int count = e.shape_type == SHAPE_TRI ? 3 : clamp(int(e.point_count),3,8);
    for (int i = 2; i < count; i++) bounds = max(bounds, abs(points[i-2]));
    return bounds + e.chubbiness + e.thickness * 0.5;
}

float evaluate_sdf(vec2 local_p, Entity e)
{
    uint shape = e.shape_type;
    float d;

    // LINE and POLY: inherently stroked, thickness built into SDF.
    if (shape == SHAPE_LINE) {
        return sdf_line(local_p, e.points_01.xy, e.points_01.zw, e.thickness);
    }
    if (shape == SHAPE_POLY) {
        return sdf_polyline(local_p, e);
    }

    // All other shapes: compute filled SDF, then optionally stroke.
    if (shape == SHAPE_CIRCLE) {
        d = sdf_circle(local_p, e.radius);
    } else if (shape == SHAPE_BOX) {
        d = sdf_box(local_p, abs(e.points_01.xy), e.chubbiness);
        if (e.points_23.w > 0.0) d = max(d, dot(e.points_23.xy, local_p) - e.points_23.z);
    } else if (shape == SHAPE_CAPSULE) {
        d = sdf_capsule(local_p, e.points_01.xy, e.points_01.zw, e.radius);
    } else if (shape == SHAPE_TRI) {
        d = sdf_triangle(local_p, e.points_01.xy, e.points_01.zw, e.points_23.xy, e.chubbiness);
    } else if (shape == SHAPE_DIAMOND) {
        d = sdf_diamond(local_p, e.radius) - e.chubbiness;
    } else if (shape == SHAPE_POLY_FILL) {
        d = sdf_polygon_filled(local_p, e) - e.chubbiness;
    } else {
        d = sdf_circle(local_p, e.radius);
    }

    // Unified stroke: thickness > 0 converts filled shape to outline.
    if (e.thickness > 0.0)
        d = abs(d) - e.thickness * 0.5;

    return d;
}

#include "color.shd"

vec4 unpack_color(vec4 p) { return p; }

float circle_emission_half_width(Entity e)
{
    float max_pixel = max(u_unit_per_px.x, u_unit_per_px.y);
    return max(1.5 * max_pixel, max(e.aa, 0.0) * 0.5);
}

float circle_emission_coverage(float sdf, float half_width)
{
    return 1.0 - smoothstep(-half_width, half_width, sdf);
}

// Area of the rectangle [lo, hi] where dot(n, q) <= d, for a box's cut.
// Corners' clamped squared distances give the exact area by inclusion and
// exclusion.
float cut_area(vec2 lo, vec2 hi, vec2 n, float d)
{
    // Mirror so both normal components are positive.
    vec2 m = vec2(n.x < 0.0 ? -1.0 : 1.0, n.y < 0.0 ? -1.0 : 1.0);
    vec2 a = min(lo * m, hi * m), b = max(lo * m, hi * m);
    n = max(abs(n), vec2(1e-3));
    vec4 f = max(vec4(d) - vec4(dot(n, a), dot(n, vec2(b.x, a.y)), dot(n, vec2(a.x, b.y)), dot(n, b)), 0.0);
    f *= f;
    return max((f.x - f.y - f.z + f.w) / (2.0 * n.x * n.y), 0.0);
}

// The fraction of a square footprint of half size r around local point p
// that a tile group box, cut or not, covers. Boxes tiling a shape cover each
// footprint exactly once between them.
float footprint_coverage(Entity e, vec2 p, float r)
{
    vec2 h = abs(e.points_01.xy);
    vec2 lo = max(p - r, -h), hi = min(p + r, h);
    if (any(lessThanEqual(hi, lo))) return 0.0;
    float area = e.points_23.w > 0.0 ? cut_area(lo, hi, e.points_23.xy, e.points_23.z)
                                     : (hi.x - lo.x) * (hi.y - lo.y);
    return clamp(area / (4.0 * r * r), 0.0, 1.0);
}

// Material accumulated at this pixel. Emission and albedo alpha never reach
// their color. Absorption blends under earlier absorbers by its own alpha;
// only its mean, the optical depth, is kept.
vec4 scene_acc;
vec4 emission_acc;
vec4 albedo_acc;
vec4 normal_acc;
float tau_acc;
float absorption_cover;
float relief_acc;

// Composites one layer of premultiplied channels over the accumulated material.
void layer_over(vec4 sc, vec4 em, vec4 tr, vec4 al, vec4 surface, float height)
{
    scene_acc = alpha_over(sc, scene_acc);
    normal_acc = mix(normal_acc, surface, sc.a);
    relief_acc = mix(relief_acc, height, sc.a);
    emission_acc = alpha_over(em, emission_acc);
    tau_acc += dot(tr.rgb, vec3(1.0 / 3.0)) * (1.0 - absorption_cover);
    absorption_cover += tr.a * (1.0 - absorption_cover);
    albedo_acc = alpha_over(al, albedo_acc);
}

// A layer of premultiplied channels and the footprint coverage behind them.
// Surface and height are weighted by scene alpha until it is composited.
struct Layer
{
    vec4 scene;
    vec4 emission;
    vec4 absorption;
    vec4 albedo;
    vec4 surface;
    float height;
    float cover;
};

Layer layer_empty()
{
    return Layer(vec4(0), vec4(0), vec4(0), vec4(0), vec4(0), 0.0, 0.0);
}

Layer layer_scaled(Layer l, float k)
{
    return Layer(l.scene * k, l.emission * k, l.absorption * k, l.albedo * k,
                 l.surface * k, l.height * k, l.cover * k);
}

Layer layer_sum(Layer a, Layer b)
{
    return Layer(a.scene + b.scene, a.emission + b.emission, a.absorption + b.absorption,
                 a.albedo + b.albedo, a.surface + b.surface, a.height + b.height,
                 a.cover + b.cover);
}

// Pieces that overlap by float error still cover a footprint once.
// Pieces that overlap by float error still cover a footprint once.
void layer_composite(Layer l)
{
    l = layer_scaled(l, 1.0 / max(l.cover, 1.0));
    float a = max(l.scene.a, 1e-6);
    layer_over(l.scene, l.emission, l.absorption, l.albedo, l.surface / a, l.height / a);
}

// The pieces of a tile group composite as one layer: their footprint
// coverages add, so edges they share stay covered wherever the shape sits
// against the pixels. Layering each piece would dim those edges by an amount
// that follows the shape's subpixel position, which flickers as it moves.
//
// A group whose id has a half, a mask's border, comes before the group with
// its whole part, the mask's fill, and lies over it. Both share the
// silhouette, so the border hides as much fill as it can: fill pieces add
// only where they cover more than the border. Layering them independently
// would count partly covered silhouette pixels twice.
float group_id;
Layer group_layer;
float border_cover;

void group_flush()
{
    if (group_id == 0.0) return;
    layer_composite(group_layer);
    group_id = 0.0;
    group_layer = layer_empty();
}

void group_add(float id, float cover, vec4 sc, vec4 em, vec4 tr, vec4 al, vec4 surface, float height)
{
    if (id != group_id) {
        bool fill = fract(group_id) > 0.0 && id == floor(group_id);
        border_cover = fill ? group_layer.cover : 0.0;
        if (!fill) group_flush();
        group_id = id;
    }
    float k = border_cover > 0.0 ? max(cover - border_cover, 0.0) / max(cover, 1e-6) : 1.0;
    Layer piece = Layer(sc, em, tr, al, surface * sc.a, height * sc.a, cover);
    group_layer = layer_sum(group_layer, layer_scaled(piece, k));
}

void main()
{
    ivec2 pixel = ivec2(gl_FragCoord.xy);
    ivec2 tile_id = pixel / 16;
    uint tile_idx = uint(tile_id.y * u_tiles_x + tile_id.x);
    uint tile_begin = tile_offset(tile_idx);
    uint tile_end = tile_offset(tile_idx + 1u);

    // Pixel center -> world position (Y flipped: pixel 0 = world max Y).
    vec2 world_pos = vec2(
        u_world_min_x + (float(pixel.x) + 0.5) * u_unit_per_px.x,
        u_world_max_y - (float(pixel.y) + 0.5) * u_unit_per_px.y
    );

    // Tile entity list.
    uint total = tile_end - tile_begin;
    uint base = tile_begin;

    scene_acc = vec4(0);
    emission_acc = vec4(0, 0, 0, 1);
    tau_acc = 0.0;
    absorption_cover = 0.0;
    albedo_acc = vec4(0, 0, 0, 1);
    normal_acc = vec4(0);
    relief_acc = 0.0;
    group_id = 0.0;
    border_cover = 0.0;
    group_layer = layer_empty();
#ifdef SG_ACCUMULATE
    // Earlier batches' absorbers continue with their coverage, their
    // emission premultiplied by it, and the optical depth that gave their
    // transmittance at that coverage.
    scene_acc = texelFetch(u_prev_scene, pixel, 0);
    vec4 prev_source = texelFetch(u_prev_source, pixel, 0);
    float prev_cover = texelFetch(u_prev_cover, pixel, 0).r;
    emission_acc.rgb = prev_source.rgb * prev_cover;
    absorption_cover = prev_source.a > 0.0 ? prev_cover : 0.0;
    float prev_opacity = (1.0 - exp(-prev_source.a)) / max(absorption_cover, 1e-4);
    tau_acc = -log(1.0 - min(prev_opacity, 0.999999)) * absorption_cover;
    vec4 prev_albedo = texelFetch(u_prev_albedo, pixel, 0);
    albedo_acc.rgb = prev_albedo.rgb;
    relief_acc = prev_albedo.a;
    normal_acc = texelFetch(u_prev_normal, pixel, 0);
#endif

    // Metaball group accumulators.
    #define MAX_METABALL_GROUPS 1
    float mb_sdf[MAX_METABALL_GROUPS];
    vec4 mb_scene[MAX_METABALL_GROUPS];
    vec4 mb_emission[MAX_METABALL_GROUPS];
    vec4 mb_absorption[MAX_METABALL_GROUPS];
    vec4 mb_albedo[MAX_METABALL_GROUPS];
    vec4 mb_border_scene[MAX_METABALL_GROUPS];
    vec4 mb_border_emission[MAX_METABALL_GROUPS];
    vec4 mb_border_absorption[MAX_METABALL_GROUPS];
    vec4 mb_border_albedo[MAX_METABALL_GROUPS];
    float mb_aa[MAX_METABALL_GROUPS];
    float mb_border_thickness[MAX_METABALL_GROUPS];
    // Solid surface: xy bump tilt (world axes, y up), z edge light, w gloss.
    vec4 mb_surface[MAX_METABALL_GROUPS];
    float mb_height[MAX_METABALL_GROUPS];
    bool mb_active[MAX_METABALL_GROUPS];
    for (int g = 0; g < MAX_METABALL_GROUPS; g++) {
        mb_sdf[g] = 1e30;
        mb_scene[g] = vec4(0);
        mb_emission[g] = vec4(0);
        mb_absorption[g] = vec4(0);
        mb_albedo[g] = vec4(0);
        mb_border_scene[g] = vec4(0);
        mb_border_emission[g] = vec4(0);
        mb_border_absorption[g] = vec4(0);
        mb_border_albedo[g] = vec4(0);
        mb_aa[g] = 0.0;
        mb_border_thickness[g] = 0.0;
        mb_surface[g] = vec4(0);
        mb_height[g] = 0.0;
        mb_active[g] = false;
    }

    for (uint i = 0u; i < total; i++) {
        uint eidx = tile_entity(base + i);
        if (eidx < uint(u_first_entity) || eidx >= uint(u_last_entity)) continue;
        Entity e = entity_at(eidx);
        if (e.metaball_group != uint(u_metaball_group)) continue;

        // Transform pixel to entity local space.
        vec2 dp = world_pos - e.pos;
        vec2 local_p = vec2(
            e.inv_rot.x * dp.x + e.inv_rot.y * dp.y,
            e.inv_rot.z * dp.x + e.inv_rot.w * dp.y
        );

        // SDF wobble: standing wave (sustained hum) + traveling wave (pluck transient).
        float wobble = e.wobble_pad.x;
        float pluck_amp = e.pluck_data.x;

        if (wobble > 0.0 || pluck_amp > 0.0) {
            float ang_freq = round(e.wobble_pad.y);
            float time_freq = e.wobble_pad.z;
            float angle = atan(local_p.y, local_p.x);
            float deform = 0.0;

            // Traveling wave: sustained energy hum rotating around the border.
            if (wobble > 0.0) {
                deform += sin(angle * ang_freq - e.simulation_time.x * time_freq) * wobble;
            }

            // Traveling wave: pluck transient.
            if (pluck_amp > 0.01) {
                float pluck_origin = e.pluck_data.y;
                float pluck_age = e.pluck_data.z;
                float pluck_speed = e.pluck_data.w;

                float dist = angle - pluck_origin;
                dist = dist - 6.2831853 * floor((dist + 3.1415926) / 6.2831853);

                float wave_front = pluck_age * pluck_speed;

                // Counter-propagating wave packets from pluck origin.
                float p1 = dist - wave_front;
                float p2 = dist + wave_front;
                float env_w = 0.8 + ang_freq * 0.1;
                float env1 = exp(-p1 * p1 * env_w);
                float env2 = exp(-p2 * p2 * env_w);

                float traveling = sin(dist * ang_freq - wave_front) * env1
                                + sin(dist * ang_freq + wave_front) * env2;
                deform += traveling * pluck_amp;
            }

            vec2 radial = local_p + vec2(0.0001);
            float radial_length = length(radial);
            if (radial_length > 0.0) local_p += radial / radial_length * deform;
        }

        float sdf = evaluate_sdf(local_p, e);
        vec2 half_size = shader_half_size(e);
        vec2 material_pos = material_position(e, local_p, world_pos);
        vec4 graph_output[8];
        vec4 parameters[32];
        if (e.reserved1 > 0.0) {
            for(int p=0;p<32;p++) parameters[p]=shader_parameters[eidx*64u+32u+uint(p)];
            sg_dispatch_2d(int(e.reserved1), local_p, material_pos, half_size, e.simulation_time.x, parameters, graph_output);
            sdf = graph_output[0].x;
        }
        float aa = e.aa > 0.0 ? e.aa : max(u_unit_per_px.x, u_unit_per_px.y) * 0.5;
        bool filtered_circle_emission = e.shape_type == SHAPE_CIRCLE &&
                                        e.thickness <= 0.0 && e.border_thickness <= 0.0 &&
                                        e.reserved0 <= 0.0 && e.reserved1 <= 0.0 &&
                                        e.metaball_group == 0u && e.wobble_pad.x == 0.0 &&
                                        e.pluck_data.x == 0.0;
        bool may_emit = any(notEqual(e.emission.rgb, vec3(0.0)));
        float emission_half_width = filtered_circle_emission
                                      ? circle_emission_half_width(e)
                                      : aa;
        // Tile group pieces cover the pixel's footprint, at least a pixel wide.
        bool tiled = e.tile_group != 0.0 && e.shape_type == SHAPE_BOX;
        float footprint = 0.5 * max(aa, max(u_unit_per_px.x, u_unit_per_px.y));
        float reach = tiled ? 1.4143 * footprint : aa;
        // Uncovered pixels need no material; metaballs still blend beyond their edge.
        if (e.metaball_group == 0u && sdf >= reach &&
            (!filtered_circle_emission || !may_emit || sdf >= emission_half_width)) continue;
        vec4 surface = vec4(0.0, 0.0, e.reserved2, 0.0);
        float height = 0.0;
        if (e.reserved0 > 0.0) {
            for(int p=0;p<32;p++) parameters[p]=shader_parameters[eidx*64u+uint(p)];
            sg_dispatch_2d(int(e.reserved0), local_p, material_pos, half_size, e.simulation_time.x, parameters, graph_output);
            e.scene=graph_output[0]; e.emission=graph_output[1];
            e.albedo=graph_output[2]; e.absorption=graph_output[3];
            e.border_scene=graph_output[0]; e.border_emission=graph_output[1];
            e.border_albedo=graph_output[2]; e.border_absorption=graph_output[3];
            surface.xyw = graph_output[4].xyz;
            height = graph_output[4].w;
        }

        if (e.metaball_group > 0u) {
            // Accumulate into metaball group.
            uint g = 0u; // Each dispatch processes one authored group.
            if (g < MAX_METABALL_GROUPS) {
                float k = e.metaball_blend;
                vec4 e_scene = unpack_color(e.scene);
                vec4 e_emission = unpack_color(e.emission);
                vec4 e_absorption = unpack_color(e.absorption);
                vec4 e_albedo = unpack_color(e.albedo);
                vec4 e_bscene = unpack_color(e.border_scene);
                vec4 e_bemission = unpack_color(e.border_emission);
                vec4 e_babsorption = unpack_color(e.border_absorption);
                vec4 e_balbedo = unpack_color(e.border_albedo);
                if (!mb_active[g] || k <= 0.0) {
                    // First entity in group or no blending: just take the closer one.
                    if (sdf < mb_sdf[g]) {
                        mb_sdf[g] = sdf;
                        mb_scene[g] = e_scene;
                        mb_emission[g] = e_emission;
                        mb_absorption[g] = e_absorption;
                        mb_albedo[g] = e_albedo;
                        mb_border_scene[g] = e_bscene;
                        mb_border_emission[g] = e_bemission;
                        mb_border_absorption[g] = e_babsorption;
                        mb_border_albedo[g] = e_balbedo;
                        mb_aa[g] = e.aa;
                        mb_border_thickness[g] = e.border_thickness;
                        mb_surface[g] = surface;
                        mb_height[g] = height;
                    }
                } else {
                    float h = clamp(0.5 + 0.5 * (sdf - mb_sdf[g]) / k, 0.0, 1.0);
                    mb_sdf[g] = mix(sdf, mb_sdf[g], h) - k * h * (1.0 - h);
                    mb_scene[g] = mix(e_scene, mb_scene[g], h);
                    mb_emission[g] = mix(e_emission, mb_emission[g], h);
                    mb_absorption[g] = mix(e_absorption, mb_absorption[g], h);
                    mb_albedo[g] = mix(e_albedo, mb_albedo[g], h);
                    mb_border_scene[g] = mix(e_bscene, mb_border_scene[g], h);
                    mb_border_emission[g] = mix(e_bemission, mb_border_emission[g], h);
                    mb_border_absorption[g] = mix(e_babsorption, mb_border_absorption[g], h);
                    mb_border_albedo[g] = mix(e_balbedo, mb_border_albedo[g], h);
                    mb_aa[g] = mix(e.aa, mb_aa[g], h);
                    mb_border_thickness[g] = mix(e.border_thickness, mb_border_thickness[g], h);
                    mb_surface[g] = mix(surface, mb_surface[g], h);
                    mb_height[g] = mix(height, mb_height[g], h);
                }
                mb_active[g] = true;
            }
            continue;
        }

        // Normal entity (metaball_group == 0).
        float bt = e.border_thickness;

        if (bt > 0.0) {
            group_flush();
            // Border rendering: fill is interior, border is edge band.
            float shape_coverage = 1.0 - smoothstep(0.0, aa, sdf);
            float fill_coverage = 1.0 - smoothstep(-bt, -bt + aa, sdf);
            float border_coverage = shape_coverage - fill_coverage;
            if (shape_coverage <= 0.0) continue;

            // Scene: border over fill, then onto canvas.
            vec4 sc = unpack_color(e.scene); sc.rgb *= sc.a; sc *= fill_coverage;
            vec4 bsc = unpack_color(e.border_scene); bsc.rgb *= bsc.a; bsc *= border_coverage;
            scene_acc = alpha_over(alpha_over(bsc, sc), scene_acc);
            float cover = bsc.a + sc.a * (1.0 - bsc.a);
            normal_acc = mix(normal_acc, surface, cover);
            relief_acc = mix(relief_acc, height, cover);

            // Emission.
            vec4 em = unpack_color(e.emission); em.rgb *= em.a;
            em *= fill_coverage;
            vec4 bem = unpack_color(e.border_emission); bem.rgb *= bem.a; bem *= border_coverage;
            emission_acc = alpha_over(alpha_over(bem, em), emission_acc);

            // Absorption.
            vec4 tr = unpack_color(e.absorption); tr *= fill_coverage;
            vec4 btr = unpack_color(e.border_absorption); btr *= border_coverage;
            vec4 combined_tr = tr + btr;
            tau_acc += dot(combined_tr.rgb, vec3(1.0 / 3.0)) * (1.0 - absorption_cover);
            absorption_cover += combined_tr.a * (1.0 - absorption_cover);

            // Albedo.
            vec4 al = unpack_color(e.albedo); al.rgb *= al.a; al *= fill_coverage;
            vec4 bal = unpack_color(e.border_albedo); bal.rgb *= bal.a; bal *= border_coverage;
            albedo_acc = alpha_over(alpha_over(bal, al), albedo_acc);
        } else {
            // No border: original path.
            float coverage = !tiled         ? 1.0 - smoothstep(0.0, aa, sdf)
                           : sdf <= -reach ? 1.0
                                           : footprint_coverage(e, local_p, footprint);
            float emission_coverage = filtered_circle_emission
                                        ? circle_emission_coverage(sdf, emission_half_width)
                                        : coverage;
            if (coverage <= 0.0 && emission_coverage <= 0.0) continue;

            vec4 sc = unpack_color(e.scene); sc.rgb *= sc.a; sc *= coverage;
            vec4 em = unpack_color(e.emission); em.rgb *= em.a;
            em.rgb *= e.simulation_time.z;
            em *= emission_coverage;
            vec4 tr = unpack_color(e.absorption); tr *= coverage;
            vec4 al = unpack_color(e.albedo); al.rgb *= al.a; al *= coverage;
            if (tiled) {
                group_add(e.tile_group, coverage, sc, em, tr, al, surface, height);
                continue;
            }
            group_flush();
            layer_over(sc, em, tr, al, surface, height);
        }
    }
    group_flush();


    // Composite metaball groups on top.
    for (int g = 0; g < MAX_METABALL_GROUPS; g++) {
        if (!mb_active[g]) continue;
        float aa = mb_aa[g] > 0.0 ? mb_aa[g] : max(u_unit_per_px.x, u_unit_per_px.y) * 0.5;
        float bt = mb_border_thickness[g];

        if (bt > 0.0) {
            float shape_coverage = 1.0 - smoothstep(0.0, aa, mb_sdf[g]);
            float fill_coverage = 1.0 - smoothstep(-bt, -bt + aa, mb_sdf[g]);
            float border_coverage = shape_coverage - fill_coverage;
            if (shape_coverage <= 0.0) continue;

            vec4 sc = mb_scene[g]; sc.rgb *= sc.a; sc *= fill_coverage;
            vec4 bsc = mb_border_scene[g]; bsc.rgb *= bsc.a; bsc *= border_coverage;
            scene_acc = alpha_over(alpha_over(bsc, sc), scene_acc);
            float cover = bsc.a + sc.a * (1.0 - bsc.a);
            normal_acc = mix(normal_acc, mb_surface[g], cover);
            relief_acc = mix(relief_acc, mb_height[g], cover);

            vec4 em = mb_emission[g]; em.rgb *= em.a; em *= fill_coverage;
            vec4 bem = mb_border_emission[g]; bem.rgb *= bem.a; bem *= border_coverage;
            emission_acc = alpha_over(alpha_over(bem, em), emission_acc);

            vec4 tr = mb_absorption[g]; tr *= fill_coverage;
            vec4 btr = mb_border_absorption[g]; btr *= border_coverage;
            vec4 combined_tr = tr + btr;
            tau_acc += dot(combined_tr.rgb, vec3(1.0 / 3.0)) * (1.0 - absorption_cover);
            absorption_cover += combined_tr.a * (1.0 - absorption_cover);

            vec4 al = mb_albedo[g]; al.rgb *= al.a; al *= fill_coverage;
            vec4 bal = mb_border_albedo[g]; bal.rgb *= bal.a; bal *= border_coverage;
            albedo_acc = alpha_over(alpha_over(bal, al), albedo_acc);
        } else {
            float coverage = 1.0 - smoothstep(0.0, aa, mb_sdf[g]);
            if (coverage <= 0.0) continue;

            vec4 sc = mb_scene[g]; sc.rgb *= sc.a; sc *= coverage;
            vec4 em = mb_emission[g]; em.rgb *= em.a; em *= coverage;
            vec4 al = mb_albedo[g]; al.rgb *= al.a; al *= coverage;
            layer_over(sc, em, mb_absorption[g] * coverage, al, mb_surface[g], mb_height[g]);
        }
    }

    // Absorbers covering part of the pixel give the light and transmittance
    // of a whole pixel of them scaled by their coverage, so both follow
    // coverage linearly; see hrc/source_average.shd. Display multiplies the
    // light by cover to show emission premultiplied by coverage again.
    float tau = absorption_cover > 1e-4 ? tau_acc / absorption_cover : 0.0;
    float opacity = absorption_cover * (1.0 - exp(-tau));
    float cover = opacity > 1.0 / 512.0 ? absorption_cover : 1.0;
    out_scene = scene_acc;
    out_source = vec4(emission_acc.rgb / cover, -log(max(1.0 - opacity, 1e-6)));
    out_cover = vec4(cover, 0.0, 0.0, 0.0);
    out_albedo = vec4(albedo_acc.rgb, relief_acc);
    out_normal = normal_acc;
    out_visibility = vec4(0);
}
// Adapted from Neon-Swarm shaders/hrc/extend.shd; original source comments retained.
// Builds the ray interval hierarchy T_0 .. T_N (Sec 4.1).
//
// Each level doubles ray length by chaining two T_{n-1} intervals end-to-end.
// Stores optical depth. Serial segments add depths; alternative paths average
// transmission (Sec 4.1, Eq 20), then convert back to optical depth.
//
// Level layout: element = probe_x * directions + slot of k, row = y; see
// hrc_slots.shd.

#include "hrc/hrc_pass.shd"

layout(set = 2, binding = 0) uniform sampler2D u_prev;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_cascade;
	int u_transposed;
	int u_world_w;
	int u_world_h;
};

Interval merge(Interval a, Interval b)
{
	return Interval(
		a.rad + exp(-a.tau) * b.rad,
		a.tau + b.tau
	);
}

float blend_depth(float a, float b)
{
	// -log((exp(-a) + exp(-b)) / 2), without underflow for opaque paths.
	// Equal depths also cover two half-float infinities without inf - inf.
	if (a == b) return a;
	return min(a, b) - log(0.5 + 0.5 * exp(-abs(a - b)));
}

Interval T_load_prev(int probe_x, int k, int y)
{
	int prev_n = u_cascade - 1;
	int directions = (1 << prev_n) + 1;
	int num_probes = probe_count(u_world_w, prev_n);

	if (probe_x < 0 || probe_x >= num_probes || k < 0 || k >= directions || y < 0 || y >= u_world_h) {
		return Interval(HRC_LIGHT(0.0), 0.0);
	}

	int element = probe_x * directions + hrc_parity_slot(k, directions);
	return interval_fetch(u_prev, hrc_texel(element, y, u_transposed));
}

int far_y_offset(int k)
{
	int prev_pow2 = 1 << (u_cascade - 1);
	return 2 * k - prev_pow2;
}

Interval extend(int probe_x, int k, int y)
{
	int k_lo = k / 2;
	int k_hi = (k + 1) / 2;
	int prev_probe_x = probe_x * 2;
	int mid_probe_x = prev_probe_x + 1;

	// Candidate A: go k_lo then k_hi
	Interval near_a = T_load_prev(prev_probe_x, k_lo, y);
	int far_y_a = y + far_y_offset(k_lo);
	Interval far_a = T_load_prev(mid_probe_x, k_hi, far_y_a);
	Interval A = merge(near_a, far_a);
	// Even directions use the same two intervals for both candidates.
	if (k_lo == k_hi) return A;

	// Candidate B: go k_hi then k_lo
	Interval near_b = T_load_prev(prev_probe_x, k_hi, y);
	int far_y_b = y + far_y_offset(k_hi);
	Interval far_b = T_load_prev(mid_probe_x, k_lo, far_y_b);
	Interval B = merge(near_b, far_b);

	return Interval(
		(A.rad + B.rad) * 0.5,
		blend_depth(A.tau, B.tau)
	);
}

void main()
{
	ivec2 er = hrc_element_row(u_transposed);
	int directions = (1 << u_cascade) + 1;
	int probe_x = er.x / directions;
	int k = hrc_parity_item(er.x - probe_x * directions, directions);
	out_value = interval_texel(extend(probe_x, k, er.y));
}
#define HRC_SCALAR 1
#include "hrc/extend.frag"
// Adapted from Neon-Swarm shaders/hrc/blur.shd; original source comments retained.
// 3x3 edge-aware Gaussian blur for gather output, blended with the previous
// frame's result. Weights: [1 2 1]^2 / 16. Skips taps where transmittance
// differs from center by more than u_threshold (hard edge detection).

layout(set = 2, binding = 0) uniform sampler2D u_in_radiance;
// A holds optical depth; see render_material_textures.
layout(set = 2, binding = 1) uniform sampler2D u_source;
layout(set = 2, binding = 2) uniform sampler2D u_prev_radiance;

layout(location = 0) out vec4 out_value;

layout(set = 3, binding = 0) uniform uniform_block
{
	vec2 u_texel_size;
	float u_threshold;
	float u_hysteresis;
	vec2 u_history_offset;
	int u_history_valid;
};

vec3 input_radiance(vec2 uv)
{
	return texture(u_in_radiance, uv).rgb;
}

void main()
{
	vec2 uv = gl_FragCoord.xy * u_texel_size;

	float center_s = texture(u_source, uv).a;

	bool history_active = false;
	vec2 history_uv = uv;
	if (u_hysteresis < 1.0 && u_history_valid != 0) {
		history_uv += u_history_offset;
		vec2 inset = u_texel_size * 0.5;
		history_active = all(greaterThanEqual(history_uv, inset)) &&
		                 all(lessThanEqual(history_uv, vec2(1.0) - inset));
	}

	// 1D weights: [1 2 1] / 4
	const float w1d[3] = float[3](1.0/4.0, 2.0/4.0, 1.0/4.0);

	vec3 sum = vec3(0.0);
	float wsum = 0.0;
	vec3 lower = vec3(0.0), upper = vec3(0.0);
	if (history_active) {
		lower = input_radiance(uv);
		upper = lower;
	}

	for (int dy = -1; dy <= 1; ++dy) {
		for (int dx = -1; dx <= 1; ++dx) {
			vec2 uv_q = uv + vec2(float(dx), float(dy)) * u_texel_size;

			float s = texture(u_source, uv_q).a;
			float edge_w = 1.0 - smoothstep(0.0, u_threshold, abs(s - center_s));

			float w = w1d[dx + 1] * w1d[dy + 1] * edge_w;
			vec3 current = input_radiance(uv_q);
			sum += current * w;
			wsum += w;
			if (history_active && edge_w > 0.0) {
				lower = min(lower, current);
				upper = max(upper, current);
			}
		}
	}

	vec3 out_r = wsum > 0.0 ? sum / wsum : input_radiance(uv);
	if (history_active) {
		vec3 prev = texture(u_prev_radiance, history_uv).rgb;
		out_r = mix(clamp(prev, lower, upper), out_r, u_hysteresis);
	}
	out_value = vec4(out_r, 1.0);
}
// Compact density splats feed the same emission/absorption field as solids.
// Gas joins into a translucent density field. Liquid keeps a continuous surface.
// Authored exhaust uses smooth unions; combustion uses separate hot streaks.
//
// Each pixel reads its 16x16 tile's particle list. Including passes define
// the storage buffer bindings, which follow their samplers. GLSL ES emulates
// each storage buffer as texel fetches of a single vec4 or uvec4 array.
struct Particle { vec4 position; vec4 color; vec4 optical; vec4 detail; };
layout(set = 2, binding = FLUID_PARTICLES_BINDING) readonly buffer Particles { vec4 particle_data[]; };
layout(set = 2, binding = FLUID_OFFSETS_BINDING) readonly buffer Offsets { uvec4 offset_data[]; };
layout(set = 2, binding = FLUID_INDICES_BINDING) readonly buffer Indices { uvec4 index_data[]; };

int tile_start(int i) { return int(offset_data[i >> 2][i & 3]); }

Particle particle_at(int i)
{
    int b = 4 * int(index_data[i >> 2][i & 3]);
    return Particle(particle_data[b], particle_data[b + 1], particle_data[b + 2], particle_data[b + 3]);
}
layout(set = 3, binding = 0) uniform uniform_block {
    vec4 u_view;
    int u_tiles_x;
};

struct FluidSample
{
    float gas, liquid, absorption;
    float gas_alpha, liquid_alpha, flame_alpha;
    vec4 gas_color, liquid_color, flame_color;
    vec3 emission, gas_visibility, liquid_visibility;
    float liquid_refraction;
    vec2 gradient;
    float aa;
};

// False where no fluid covers the pixel.
bool fluid_sample(ivec2 pixel, out FluidSample f)
{
    int tile = (pixel.y / 16) * u_tiles_x + pixel.x / 16;
    f.gas = 0; f.liquid = 0; f.absorption = 0;
    f.gas_alpha = 0; f.liquid_alpha = 0; f.flame_alpha = 0;
    f.gas_color = vec4(0); f.liquid_color = vec4(0); f.flame_color = vec4(0);
    f.emission = vec3(0); f.gas_visibility = vec3(0); f.liquid_visibility = vec3(0);
    f.liquid_refraction = 0;
    f.gradient = vec2(0);
    int first = tile_start(tile), last = tile_start(tile + 1);
    if (first == last) return false;
    vec2 world = u_view.xy + (vec2(pixel) + .5) * u_view.zw * vec2(1, -1);
    float liquid_absorption = 0;
    f.aa = max(u_view.z, u_view.w) * .5;
    float flame_distance = 1e20;
    vec2 flame_optical = vec2(0);
    vec3 hot_emission = vec3(0);
    for (int i = first; i < last; i++) {
        Particle p = particle_at(i);
        vec2 local = (world - p.position.xy) / p.position.z;
        if (p.optical.z > 0.0) {
            float d = length(world - p.position.xy) - p.position.z;
            float k = p.optical.z;
            float h = clamp(.5 + .5 * (d - flame_distance) / k, 0.0, 1.0);
            flame_distance = mix(d, flame_distance, h) - k * h * (1.0 - h);
            f.flame_color = mix(p.color, f.flame_color, h);
            flame_optical = mix(p.optical.xy, flame_optical, h);
            continue;
        }
        // Negative gas stretch marks a cold wisp. Area-preserving ellipses
        // follow velocity; the widened support connects neighboring parcels.
        bool wisp = p.position.w < .5 && p.detail.z < 0.0;
        if (wisp) {
            vec2 direction = p.detail.xy;
            local = vec2(dot(local, direction) / -p.detail.z,
                         dot(local, vec2(-direction.y, direction.x)) * -p.detail.z);
        }
        float q = max(0.0, 1.0 - dot(local, local));
        if (q <= 0.0) continue;
        float weight = q * q * q;
        if (wisp) weight /= 2.25;
        if (p.optical.w > .001) {
            vec2 offset = world - p.position.xy;
            float half_length = p.position.z * .12 * p.detail.z;
            offset -= p.detail.xy * clamp(dot(offset, p.detail.xy), -half_length, half_length);
            float radius = p.position.z * .16 * sqrt(p.optical.w);
            float core = (1.0 - smoothstep(-f.aa, f.aa, length(offset) - radius)) * p.color.a;
            // Overlapping burning samples cannot accumulate an unlimited glow.
            hot_emission = max(hot_emission, p.color.rgb * p.optical.y * core);
        } else {
            f.emission += p.color.rgb * p.optical.y * weight;
        }
        if (p.position.w < .5) {
            f.gas += weight;
            f.gas_color += p.color * weight;
            f.gas_visibility += p.color.rgb * p.detail.w * weight;
            f.absorption += p.optical.x * weight;
        } else {
            f.liquid += weight;
            f.liquid_color += p.color * weight;
            liquid_absorption += p.optical.x * weight;
            f.liquid_visibility += p.color.rgb * p.detail.w * weight;
            f.liquid_refraction += p.detail.z * weight;
            f.gradient -= 6.0 * q * q * local / p.position.z;
        }
    }
    f.flame_alpha = (1.0 - smoothstep(-f.aa, f.aa, flame_distance)) * f.flame_color.a;
    if (f.gas + f.liquid + f.flame_alpha <= .00001) return false;
    f.gas_color /= max(f.gas, .00001);
    f.liquid_color /= max(f.liquid, .00001);
    // A single dispersed parcel is nearly invisible; overlapping parcels stay
    // continuous. Broad support replaces the old four-lobe beaded contour.
    f.gas_alpha = smoothstep(.25, 1.4, f.gas) * (1.0 - exp(-f.gas * .5)) * f.gas_color.a;
    // Convert one screen pixel to density units using the analytic gradient.
    float density_aa = max(.0001, f.aa * length(f.gradient));
    f.liquid_alpha = smoothstep(.6 - density_aa, .6 + density_aa, f.liquid) * f.liquid_color.a;
    f.absorption += liquid_absorption / max(f.liquid, .00001) * f.liquid_alpha;
    f.absorption += flame_optical.x * f.flame_alpha;
    f.emission += hot_emission + f.flame_color.rgb * flame_optical.y * f.flame_alpha;
    return true;
}
// Adds fluid to the material targets in the tiles it covers: reads a copy of
// the material raster's and writes the originals, including the camera-only
// visibility; see render_material_textures.

layout(set = 2, binding = 0) uniform sampler2D u_scene;
layout(set = 2, binding = 1) uniform sampler2D u_source;
layout(set = 2, binding = 2) uniform sampler2D u_albedo;
layout(set = 2, binding = 3) uniform sampler2D u_normal;
layout(set = 2, binding = 4) uniform sampler2D u_visibility;
layout(set = 2, binding = 5) uniform sampler2D u_cover;

#define FLUID_PARTICLES_BINDING 6
#define FLUID_OFFSETS_BINDING 7
#define FLUID_INDICES_BINDING 8
#include "hrc/fluid_common.shd"

layout(location = 0) out vec4 out_scene;
layout(location = 1) out vec4 out_source;
layout(location = 2) out vec4 out_albedo;
layout(location = 3) out vec4 out_normal;
layout(location = 4) out vec4 out_visibility;
layout(location = 5) out vec4 out_cover;

void main()
{
    ivec2 pixel = ivec2(gl_FragCoord.xy);
    vec4 old_scene = texelFetch(u_scene, pixel, 0);
    vec4 old_source = texelFetch(u_source, pixel, 0);
    vec4 old_albedo = texelFetch(u_albedo, pixel, 0);
    vec4 old_normal = texelFetch(u_normal, pixel, 0);
    out_scene = old_scene;
    out_source = old_source;
    out_albedo = old_albedo;
    out_normal = old_normal;
    out_visibility = texelFetch(u_visibility, pixel, 0);
    out_cover = texelFetch(u_cover, pixel, 0);
    FluidSample f;
    if (!fluid_sample(pixel, f)) return;
    vec4 surface = vec4(f.liquid_color.rgb * f.liquid_alpha, f.liquid_alpha);
    surface += vec4(f.gas_color.rgb * f.gas_alpha, f.gas_alpha) * (1.0 - surface.a);
    surface += vec4(f.flame_color.rgb * f.flame_alpha, f.flame_alpha) * (1.0 - surface.a);

    // Gas overlaps the visible surface as a shallow volume. Preserve some
    // emissive detail for ship/projectile readability; AI never samples this.
    float visible = 1.0 - old_scene.a;
    vec4 liquid_surface = vec4(f.liquid_color.rgb * f.liquid_alpha, f.liquid_alpha);
    vec4 flame_surface = vec4(f.flame_color.rgb * f.flame_alpha, f.flame_alpha);
    vec4 under = old_scene + (flame_surface + liquid_surface * (1.0 - f.flame_alpha)) * visible;
    float cover = f.gas_alpha * .8;
    out_scene = vec4(under.rgb * (1.0 - cover) + f.gas_color.rgb * f.gas_alpha,
                     under.a + f.gas_alpha * (1.0 - under.a));
    // Optical depth is the mean absorption; fluid absorbs evenly.
    out_source = vec4(old_source.rgb * (1.0 - cover * .6) + f.emission,
                      old_source.a + f.absorption * max(visible, cover));
    // Display scales solids' light by their coverage but shows fluid's whole.
    float old_display = texelFetch(u_cover, pixel, 0).r;
    vec3 luma = vec3(.2126, .7152, .0722);
    float light = dot(out_source.rgb, luma);
    float display = dot(old_source.rgb * (1.0 - cover * .6) * old_display + f.emission, luma);
    out_cover = vec4(light > 1e-6 ? display / light : old_display, 0.0, 0.0, 0.0);
    // Albedo alpha is material relief, which fluid leaves.
    out_albedo = vec4(old_albedo.rgb * (1.0 - cover) + surface.rgb * max(visible, cover), old_albedo.a);
    vec3 readability = f.liquid_alpha * f.liquid_visibility / max(f.liquid, .00001);
    readability += f.gas_alpha * f.gas_visibility / max(f.gas, .00001) * (1.0 - f.liquid_alpha);
    // Alpha marks participating fluid for camera exposure, not radiance feedback.
    float volume = f.liquid_alpha + f.gas_alpha * (1.0 - f.liquid_alpha);
    out_visibility = vec4(readability * visible, volume * visible);
    float gradient_length = length(f.gradient);
    if (f.liquid_alpha > 0.0 && visible > 0.0) {
        float inside_distance = max(0.0, f.liquid - .6) / max(gradient_length, .0001);
        float surface_band = 1.0 - smoothstep(f.aa, f.aa * 12.0, inside_distance);
        float confidence = f.liquid_alpha * surface_band * visible;
        vec4 surface_normal = old_normal + vec4(-f.gradient / max(gradient_length, .0001), 0, 1) * confidence * (1.0 - old_normal.a);
        // Planar normals need only XY. Positive Z is solid edge-light gain;
        // negative Z marks liquid and stores its coverage-weighted distortion.
        surface_normal.z = mix(old_normal.z, -max(.001, f.liquid_refraction / f.liquid) * f.liquid_alpha, visible);
        out_normal = surface_normal;
    }
}
// Adapted from Neon-Swarm shaders/hrc/gather.shd; original source comments retained.
// C-1 gather: per-quadrant raymarching at canvas resolution.
//
// Samples each quadrant's resolved cascade-0 fluence (see resolve.frag) and
// traces c-1 intervals at full canvas resolution for per-pixel detail even
// when work_res < canvas_res.
//
// With split lighting, the work grid is a finer luminance transport's: its
// four directions arrive in one image (resolve_luminance.frag), and color
// comes from a coarser RGB transport on the color grid. Each quadrant keeps
// its color's proportions at the luminance's brightness.
//
// A fragment pass into three render targets, which the GPU compresses: the
// received light, the far light that bounce reflects, and each quadrant's
// luminance.

// RGB emission, A optical depth per canvas pixel, mipmapped; see
// render_material_textures.
layout(set = 2, binding = 0) uniform sampler2D u_source;
// The same, prefiltered onto the work grid.
layout(set = 2, binding = 1) uniform sampler2D u_source_filtered;
layout(set = 2, binding = 2) uniform sampler2D u_bounce;

// Color transport quadrants on the color grid.
layout(set = 2, binding = 3) uniform sampler2D u_f0;
layout(set = 2, binding = 4) uniform sampler2D u_f1;
layout(set = 2, binding = 5) uniform sampler2D u_f2;
layout(set = 2, binding = 6) uniform sampler2D u_f3;
// Split lighting: each quadrant's luminance on the work grid.
layout(set = 2, binding = 7) uniform sampler2D u_luminance;

layout(location = 0) out vec4 out_light;
layout(location = 1) out vec4 out_far;
// Luminance of the light arriving from each quadrant: from +x, +y (down the
// texture), -x and -y. Surface lighting shades relief from these directions.
layout(location = 2) out vec4 out_dirs;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_canvas_w;
	int u_canvas_h;
	int u_work_w;
	int u_work_h;
	int u_color_w;
	int u_color_h;
	int u_out_w;
	int u_out_h;
	int u_split;
	int u_upscale_mode;
	float u_upscale_threshold;
	float u_bounce_intensity;
	vec2 u_history_offset;
	int u_history_valid;
	vec4 u_crop_uv;
};

#include "hrc_common.shd"
#include "hrc/hrc_domain.shd"
#include "hrc/source_average.shd"

// Emission at canvas pixel p, whose full-resolution source texel is source.
vec3 emission_at(ivec2 p, vec4 source)
{
	ivec2 out_size = ivec2(u_out_w, u_out_h);
	vec2 uv = (vec2(p) + 0.5) / vec2(u_canvas_w, u_canvas_h);
	vec3 emission;
	if (all(equal(out_size, ivec2(u_canvas_w, u_canvas_h)))) {
		emission = source.rgb;
	} else {
		vec2 cell = floor(uv * vec2(out_size));
		uv = (cell + 0.5) / vec2(out_size);
		vec2 ratio = vec2(u_canvas_w, u_canvas_h) / vec2(out_size);
		float lod = log2(max(ratio.x, ratio.y));
		emission = textureLod(u_source, uv, lod).rgb;
	}
	return emission * hrc_emission_weight(uv, u_crop_uv);
}

vec4 add_direction(vec4 dirs, int rot, vec3 light)
{
	float l = dot(light, HRC_LUMA);
	if (rot == 0) dirs.x += l;
	else if (rot == 1) dirs.y += l;
	else if (rot == 2) dirs.z += l;
	else dirs.w += l;
	return dirs;
}

vec3 bounce_at(ivec2 p)
{
	vec2 uv = (vec2(p) + 0.5) / vec2(u_canvas_w, u_canvas_h) + u_history_offset;
	if (u_history_valid == 0 || any(lessThan(uv, vec2(0.0))) ||
	    any(greaterThanEqual(uv, vec2(1.0)))) return vec3(0.0);
	return textureLod(u_bounce, uv, 0.0).rgb * u_bounce_intensity;
}

// Quadrant fluence at a color pixel; nothing arrives from outside the domain.
vec3 F_load(int rot, ivec2 p)
{
	if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, ivec2(u_color_w, u_color_h)))) return vec3(0.0);
	if (rot == 0) return texelFetch(u_f0, p, 0).rgb;
	if (rot == 1) return texelFetch(u_f1, p, 0).rgb;
	if (rot == 2) return texelFetch(u_f2, p, 0).rgb;
	return texelFetch(u_f3, p, 0).rgb;
}

// Hardware-filtered quadrant fluence at a continuous color-pixel position.
// Textures may keep a larger capacity; filtering stays inside the domain.
vec3 F_filtered(int rot, vec2 grid)
{
	grid = clamp(grid, vec2(0.0), vec2(u_color_w - 1, u_color_h - 1));
	vec2 uv = (grid + 0.5) / vec2(textureSize(u_f0, 0));
	if (rot == 0) return textureLod(u_f0, uv, 0.0).rgb;
	if (rot == 1) return textureLod(u_f1, uv, 0.0).rgb;
	if (rot == 2) return textureLod(u_f2, uv, 0.0).rgb;
	return textureLod(u_f3, uv, 0.0).rgb;
}

vec3 F_world_load(int rot, ivec2 p)
{
	return F_load(rot, clamp(p, ivec2(0), ivec2(u_color_w - 1, u_color_h - 1)));
}

// Split lighting: color with this luminance, or grey where color has none.
vec3 with_luminance(vec3 color, float luminance)
{
	float l = dot(color, HRC_LUMA);
	return l > 1e-8 ? color * (luminance / l) : vec3(luminance);
}

// Color pixel position of a canvas pixel center.
vec2 color_grid(ivec2 canvas_pos)
{
	return (vec2(canvas_pos) + 0.5) * vec2(u_color_w, u_color_h) / vec2(u_canvas_w, u_canvas_h) - 0.5;
}

// Light and transmittance of a step of length s at a canvas pixel, and its
// reflected light.
vec4 near_step(ivec2 p, float s, out vec3 bounce)
{
	vec4 source = texelFetch(u_source, p, 0);
	bounce = bounce_at(p);
	return source_step(vec4(emission_at(p, source), source.a), s);
}

// World-space march direction for each quadrant's rotated +x axis.
ivec2 quadrant_dir(int rot)
{
	if (rot == 1) return ivec2(0, 1);
	if (rot == 2) return ivec2(-1, 0);
	if (rot == 3) return ivec2(0, -1);
	return ivec2(1, 0);
}

// Raymarch c-1 interval from canvas pixel toward nearest c0 probe.
// Covers the gap between the pixel and the R_0 probe at +1 grid offset
// in the quadrant's +x direction, sampled at full canvas resolution.
// Starts from step 1 — step 0 (center pixel) is pre-accumulated by the caller.
Interval trace_cminus1(ivec2 canvas_pos, int rot, vec3 init_rad, float init_tau, float init_trn)
{
	ivec2 dir = quadrant_dir(rot);

	// Dimensions along march direction.
	int canvas_dim = (rot == 0 || rot == 2) ? u_canvas_w : u_canvas_h;
	int work_dim = (rot == 0 || rot == 2) ? u_work_w : u_work_h;

	// Position along march direction in canvas space.
	int pos_along;
	if      (rot == 0) pos_along = canvas_pos.x;
	else if (rot == 1) pos_along = canvas_pos.y;
	else if (rot == 2) pos_along = (u_canvas_w - 1) - canvas_pos.x;
	else               pos_along = (u_canvas_h - 1) - canvas_pos.y;

	// Grid cell this pixel maps to (must match R_0 bilinear grid in main()).
	float cell_f = (float(pos_along) + 0.5) * float(work_dim) / float(canvas_dim) - 0.5;
	int grid_cell = int(floor(cell_f));

	// First canvas pixel of the next cell (where grid_f = grid_cell + 1).
	int next_probe = int(ceil((float(grid_cell) + 1.5) * float(canvas_dim) / float(work_dim) - 0.5));
	int num_steps = max(next_probe - pos_along, 1);

	vec3 acc_rad = init_rad;
	float acc_trn = init_trn;
	float acc_tau = init_tau;

	// Bound full-resolution refinement work as adaptive resolution decreases.
	int samples = min(num_steps - 1, 2);
	float stride = float(num_steps - 1) / float(max(samples, 1));
	for (int i = 0; i < samples; i++) {
		int offset = int(ceil((float(i) + 0.5) * stride));
		ivec2 p = clamp(canvas_pos + dir * offset, ivec2(0), ivec2(u_canvas_w - 1, u_canvas_h - 1));

		vec3 bounce;
		vec4 near = near_step(p, stride, bounce);
		float T = max(near.a, 1e-6);
		vec3 rad = near.rgb + (1.0 - T) * bounce;
		acc_rad += acc_trn * rad;
		acc_trn *= T;
		acc_tau -= log(T);
	}

	return Interval(acc_rad, acc_tau);
}

void main()
{
	ivec2 gid = ivec2(gl_FragCoord.xy);
	ivec2 out_size = ivec2(u_out_w, u_out_h);
	ivec2 canvas_pos = gid;
	if (out_size.x != u_canvas_w || out_size.y != u_canvas_h) {
		canvas_pos = clamp(
			ivec2((vec2(gid) + 0.5) * vec2(u_canvas_w, u_canvas_h) / vec2(out_size)),
			ivec2(0),
			ivec2(u_canvas_w - 1, u_canvas_h - 1)
		);
	}

	// Matching grids need one probe per quadrant and only the center interval.
	// Keep the same accumulation order as the reconstruction path below.
	if (u_canvas_w == u_work_w && u_canvas_h == u_work_h) {
		vec3 bounce;
		vec4 near = near_step(canvas_pos, 1.0, bounce);
		float trn = near.a;
		vec3 near_rad = near.rgb + (1.0 - trn) * bounce;
		vec3 total = vec3(0.0), raw = vec3(0.0);
		vec4 dirs = vec4(0.0);
		vec4 luminance = u_split != 0 ? texelFetch(u_luminance, canvas_pos, 0) : vec4(0.0);
		for (int rot = 0; rot < 4; rot++) {
			vec3 far_rad = u_split != 0
			                 ? F_filtered(rot, color_grid(canvas_pos))
			                 : F_load(rot, canvas_pos);
			vec3 quadrant = near_rad + trn * far_rad;
			if (u_split != 0) {
				quadrant = with_luminance(quadrant, dot(near_rad, HRC_LUMA) + trn * luminance[rot]);
				far_rad = with_luminance(far_rad, luminance[rot]);
			}
			total += quadrant;
			dirs = add_direction(dirs, rot, quadrant);
			raw += far_rad;
		}
		out_light = vec4(total * 0.25, 1.0);
		out_far = vec4(raw * 0.25, 1.0);
		out_dirs = dirs * 0.25;
		return;
	}

	// Floating-point grid position for bilinear R_0 interpolation.
	// At scale=1.0 this degenerates to nearest-neighbor (frac = 0).
	vec2 grid_f = (vec2(canvas_pos) + 0.5) * vec2(u_work_w, u_work_h) / vec2(u_canvas_w, u_canvas_h) - 0.5;
	ivec2 g0 = ivec2(floor(grid_f));
	vec2 frac = grid_f - vec2(g0);

	// Precompute edge factor for minmax mode (mode 1).
	float edge = 0.0;
	if (u_upscale_mode == 1) {
		ivec2 c00 = clamp(g0, ivec2(0), ivec2(u_work_w - 1, u_work_h - 1));
		ivec2 c11 = clamp(g0 + ivec2(1, 1), ivec2(0), ivec2(u_work_w - 1, u_work_h - 1));
		float t00 = texelFetch(u_source_filtered, c00, 0).a;
		float t10 = texelFetch(u_source_filtered, ivec2(c11.x, c00.y), 0).a;
		float t01 = texelFetch(u_source_filtered, ivec2(c00.x, c11.y), 0).a;
		float t11 = texelFetch(u_source_filtered, c11, 0).a;
		float mn = min(min(t00, t10), min(t01, t11));
		float mx = max(max(t00, t10), max(t01, t11));
		edge = smoothstep(0.0, u_upscale_threshold, mx - mn);
	}

	// Precompute bilateral weights (mode 2).
	float bw00 = 1.0, bw10 = 1.0, bw01 = 1.0, bw11 = 1.0;
	if (u_upscale_mode == 2) {
		vec2 uv_center = (vec2(canvas_pos) + 0.5) / vec2(u_canvas_w, u_canvas_h);
		float t_center = textureLod(u_source, uv_center, 0.0).a;
		ivec2 c00 = clamp(g0, ivec2(0), ivec2(u_work_w - 1, u_work_h - 1));
		ivec2 c10 = clamp(g0 + ivec2(1, 0), ivec2(0), ivec2(u_work_w - 1, u_work_h - 1));
		ivec2 c01 = clamp(g0 + ivec2(0, 1), ivec2(0), ivec2(u_work_w - 1, u_work_h - 1));
		ivec2 c11 = clamp(g0 + ivec2(1, 1), ivec2(0), ivec2(u_work_w - 1, u_work_h - 1));
		float sigma2 = 2.0 * u_upscale_threshold * u_upscale_threshold;
		float d00 = texelFetch(u_source_filtered, c00, 0).a - t_center;
		float d10 = texelFetch(u_source_filtered, c10, 0).a - t_center;
		float d01 = texelFetch(u_source_filtered, c01, 0).a - t_center;
		float d11 = texelFetch(u_source_filtered, c11, 0).a - t_center;
		bw00 = exp(-(d00 * d00) / sigma2);
		bw10 = exp(-(d10 * d10) / sigma2);
		bw01 = exp(-(d01 * d01) / sigma2);
		bw11 = exp(-(d11 * d11) / sigma2);
	}

	// Sample center pixel once for all quadrants (step 0 of trace_cminus1).
	vec3 center_bounce;
	vec4 center = near_step(canvas_pos, 1.0, center_bounce);
	float center_T = max(center.a, 1e-6);
	float center_tau = -log(center_T);
	vec3 center_rad = center.rgb + (1.0 - center_T) * center_bounce;

	// Split lighting: every quadrant's luminance from one image, blended toward
	// the nearest work probe at absorption edges like color in mode 1.
	vec4 luminance = vec4(0.0);
	vec2 grid_c = grid_f;
	if (u_split != 0) {
		ivec2 last = ivec2(u_work_w - 1, u_work_h - 1);
		vec2 uv = (clamp(grid_f, vec2(0.0), vec2(last)) + 0.5) / vec2(textureSize(u_luminance, 0));
		luminance = textureLod(u_luminance, uv, 0.0);
		if (edge > 0.0) {
			ivec2 nearest = clamp(g0 + ivec2(step(vec2(0.5), frac)), ivec2(0), last);
			luminance = mix(luminance, texelFetch(u_luminance, nearest, 0), edge);
		}
		grid_c = color_grid(canvas_pos);
	}

	vec3 total = vec3(0.0);
	vec3 total_raw = vec3(0.0);
	vec4 dirs = vec4(0.0);
	for (int rot = 0; rot < 4; rot++) {
		ivec2 s0 = g0;
		vec3 r0;
		if (u_split != 0) {
			// Color supplies only proportions; bilinear on its coarser grid.
			r0 = F_filtered(rot, grid_c);
		} else if (u_upscale_mode == 1) {
			// Edge: blend bilinear -> nearest at absorption edges.
			r0 = F_filtered(rot, grid_f);
			if (edge > 0.0) {
				r0 = mix(r0, F_load(rot, s0 + ivec2(step(vec2(0.5), frac))), edge);
			}
		} else if (u_upscale_mode == 2) {
			vec3 v00 = F_load(rot, s0);
			vec3 v10 = F_load(rot, s0 + ivec2(1, 0));
			vec3 v01 = F_load(rot, s0 + ivec2(0, 1));
			vec3 v11 = F_load(rot, s0 + ivec2(1, 1));
			// Joint bilateral: bilinear weights modulated by transmittance similarity.
			float w00 = (1.0 - frac.x) * (1.0 - frac.y) * bw00;
			float w10 = frac.x          * (1.0 - frac.y) * bw10;
			float w01 = (1.0 - frac.x) * frac.y          * bw01;
			float w11 = frac.x          * frac.y          * bw11;
			float wsum = w00 + w10 + w01 + w11;
			if (wsum > 1e-6)
				r0 = (v00 * w00 + v10 * w10 + v01 * w01 + v11 * w11) / wsum;
			else
				r0 = (frac.x < 0.5 && frac.y < 0.5) ? v00
				   : (frac.x >= 0.5 && frac.y < 0.5) ? v10
				   : (frac.x < 0.5)                   ? v01
				   :                                     v11;
		} else if (u_upscale_mode == 3) {
			// Five-tap cross reconstruction. The nearest work probe is the center;
			// distance from it distributes weight to the four axial neighbors. This
			// keeps a single emissive probe from being diluted across four corners.
			ivec2 center_cell = ivec2(floor(grid_f + vec2(0.5)));
			vec2 center_delta = grid_f - vec2(center_cell);
			float wc = max(0.0, 1.0 - abs(center_delta.x) - abs(center_delta.y));
			float wl = max(0.0, -center_delta.x);
			float wr = max(0.0, center_delta.x);
			float wb = max(0.0, -center_delta.y);
			float wt = max(0.0, center_delta.y);
			vec3 vc = F_world_load(rot, center_cell);
			vec3 vl = F_world_load(rot, center_cell + ivec2(-1, 0));
			vec3 vr = F_world_load(rot, center_cell + ivec2(1, 0));
			vec3 vb = F_world_load(rot, center_cell + ivec2(0, -1));
			vec3 vt = F_world_load(rot, center_cell + ivec2(0, 1));
			float wsum = wc + wl + wr + wb + wt;
			r0 = wsum > 1e-6 ? (vc * wc + vl * wl + vr * wr + vb * wb + vt * wt) / wsum : vc;
		} else {
			// Mode 0: plain bilinear.
			r0 = F_filtered(rot, grid_f);
		}

		Interval cminus1 = trace_cminus1(canvas_pos, rot, center_rad, center_tau, center_T);
		float trn = exp(-cminus1.tau);
		vec3 quadrant = cminus1.rad + trn * r0;
		if (u_split != 0) {
			quadrant = with_luminance(quadrant, dot(cminus1.rad, HRC_LUMA) + trn * luminance[rot]);
			r0 = with_luminance(r0, luminance[rot]);
		}
		total += quadrant;
		dirs = add_direction(dirs, rot, quadrant);
		total_raw += r0;
	}

	out_light = vec4(total * 0.25, 1.0);
	out_far = vec4(total_raw * 0.25, 1.0);
	out_dirs = dirs * 0.25;
}
// Fade only the outer half of the lighting margin. The camera rectangle and
// nearby offscreen sources retain their full power; occluders are never faded.
float hrc_emission_weight(vec2 uv, vec4 crop)
{
    if (crop.z <= crop.x || crop.w <= crop.y) return 1.0;
    vec4 margin = vec4(crop.xy, vec2(1.0) - crop.zw);
    vec4 weight = smoothstep(vec4(0.0), max(margin * 0.5, vec4(1e-6)),
                             vec4(uv, vec2(1.0) - uv));
    return min(min(weight.x, weight.y), min(weight.z, weight.w));
}
// Hierarchy levels are render targets written by fragment passes, which the
// GPU compresses losslessly; empty space costs little bandwidth. Each pixel
// holds one element: an interval of T (light, optical depth) or a direction of
// R (light). Quadrants 1 and 3 run along world y, so their levels are stored
// transposed, rows along x, which gives every quadrant the same texture shape.

#include "hrc_common.shd"
#include "hrc/hrc_slots.shd"

layout(location = 0) out vec4 out_value;

ivec2 hrc_texel(int element, int row, int transposed)
{
	return transposed != 0 ? ivec2(row, element) : ivec2(element, row);
}

// This fragment's element and row.
ivec2 hrc_element_row(int transposed)
{
	ivec2 p = ivec2(gl_FragCoord.xy);
	return transposed != 0 ? p.yx : p;
}

#ifdef HRC_SCALAR
Interval interval_fetch(sampler2D level, ivec2 p)
{
	vec4 v = texelFetch(level, p, 0);
	return Interval(v.r, v.g);
}

vec4 interval_texel(Interval v)
{
	return vec4(clamp(v.rad, 0.0, 65504.0), v.tau, 0.0, 0.0);
}

float light_fetch(sampler2D level, ivec2 p)
{
	return texelFetch(level, p, 0).r;
}

vec4 light_texel(float v)
{
	return vec4(clamp(v, 0.0, 65504.0), 0.0, 0.0, 0.0);
}
#else
Interval interval_fetch(sampler2D level, ivec2 p)
{
	vec4 v = texelFetch(level, p, 0);
	return Interval(v.rgb, v.a);
}

vec4 interval_texel(Interval v)
{
	return vec4(clamp(v.rad, vec3(0.0), vec3(65504.0)), v.tau);
}

vec3 light_fetch(sampler2D level, ivec2 p)
{
	return texelFetch(level, p, 0).rgb;
}

vec4 light_texel(vec3 v)
{
	return vec4(clamp(v, vec3(0.0), vec3(65504.0)), 1.0);
}
#endif
// Levels store items in parity order, evens first and odds after, so fragments
// that run together take the same branch: fluence rows order their probes this
// way, and interval rows order each probe's directions. Slot s of count items
// holds item hrc_parity_item(s, count); item i sits in slot hrc_parity_slot.
int hrc_parity_item(int slot, int count)
{
	int evens = (count + 1) / 2;
	return slot < evens ? 2 * slot : 2 * (slot - evens) + 1;
}

int hrc_parity_slot(int item, int count)
{
	return (item & 1) != 0 ? (count + 1) / 2 + item / 2 : item / 2;
}
// DDA path-traces one interval of a level. The including shader declares the
// u_rotate, u_work_w, u_work_h and u_step_scale uniforms.
//
// For each interval, march along the ray from probe origin to target endpoint,
// stepping once per pixel boundary along the longest axis and accumulating
// radiance/optical-depth front-to-back. Stores τ (optical depth) instead of T.
// The luminance variant accumulates each step's luminance.

// RGB emission, A optical depth per canvas pixel.
layout(set = 2, binding = 0) uniform sampler2D u_source;
// Reflected light, already scaled by bounce intensity.
layout(set = 2, binding = 1) uniform sampler2D u_bounce;

vec2 rotate_pos(vec2 p, int rot, int w, int h)
{
	if (rot == 1)      return vec2(float(w - 1) - p.y, p.x);
	else if (rot == 2) return vec2(float(w - 1) - p.x, float(h - 1) - p.y);
	else if (rot == 3) return vec2(p.y, float(h - 1) - p.x);
	return p;
}

vec2 rotate_dir(vec2 d, int rot)
{
	if (rot == 1)      return vec2(-d.y, d.x);
	else if (rot == 2) return vec2(-d.x, -d.y);
	else if (rot == 3) return vec2(d.y, -d.x);
	return d;
}

// Light, optical depth and transmittance of one DDA step through the cell at
// a sample position in world work pixels.
void cell_step(vec2 sample_pos, float dda_step, float eps, out vec3 rad, out float tau_step, out float trn)
{
	vec2 uv = (clamp(sample_pos, vec2(0.0), vec2(u_work_w - 1, u_work_h - 1)) + vec2(0.5)) /
	          vec2(textureSize(u_source, 0));
	vec4 cell = texture(u_source, uv);
	tau_step = max(cell.a, 0.0) * dda_step;
	trn = exp(-tau_step);
	float opacity = 1.0 - trn;
	rad = opacity > eps ? opacity * cell.rgb : cell.rgb * dda_step;
	// Reflected light requires an interaction with matter. The emissive
	// fallback in nearly empty cells must never amplify temporal bounce.
	rad += opacity * texture(u_bounce, uv).rgb;
}

// A level-0 interval is one diagonal step through its probe's cell, the same
// for both of its directions.
Interval trace_cell(int probe_x, int row)
{
	vec3 rad;
	float tau_step, trn;
	vec2 cell = rotate_pos(vec2(float(probe_x), float(row)), u_rotate, u_work_w, u_work_h);
	cell_step(cell, sqrt(2.0) * u_step_scale, 1.0 / 512.0, rad, tau_step, trn);
#ifdef HRC_SCALAR
	return Interval(dot(rad, HRC_LUMA), tau_step);
#else
	return Interval(rad, tau_step);
#endif
}

Interval trace_interval(int level, int probe_x, int k, int row)
{
	int step = 1 << level;

	// Ray endpoints in rotated cascade space.
	float y_offset = float(2 * k - step);
	vec2 ray_start = vec2(float(probe_x * step), float(row));
	vec2 ray_end = vec2(float(probe_x * step + step), float(row) + y_offset);

	// DDA: step once per pixel boundary along longest axis.
	vec2 segment = ray_end - ray_start;
	float intrv = max(max(abs(segment.x), abs(segment.y)), 1.0);
	vec2 delta = segment / intrv;
	float step_length = length(delta);

	// Pre-rotate start and delta to avoid per-step rotation.
	vec2 rot_start = rotate_pos(ray_start, u_rotate, u_work_w, u_work_h);
	vec2 rot_delta = rotate_dir(delta, u_rotate);

	// Clip iteration range to world bounds [-0.5, work_{w,h} - 0.5).
	float ii_lo = 0.0;
	float ii_hi = intrv;
	vec2 lo_bound = vec2(-0.5);
	vec2 hi_bound = vec2(float(u_work_w), float(u_work_h)) - 0.5;

	if (abs(rot_delta.x) > 1e-6) {
		float t0 = (lo_bound.x - rot_start.x) / rot_delta.x;
		float t1 = (hi_bound.x - rot_start.x) / rot_delta.x;
		ii_lo = max(ii_lo, min(t0, t1));
		ii_hi = min(ii_hi, max(t0, t1));
	} else if (rot_start.x < lo_bound.x || rot_start.x >= hi_bound.x) {
		ii_hi = -1.0;
	}

	if (abs(rot_delta.y) > 1e-6) {
		float t0 = (lo_bound.y - rot_start.y) / rot_delta.y;
		float t1 = (hi_bound.y - rot_start.y) / rot_delta.y;
		ii_lo = max(ii_lo, min(t0, t1));
		ii_hi = min(ii_hi, max(t0, t1));
	} else if (rot_start.y < lo_bound.y || rot_start.y >= hi_bound.y) {
		ii_hi = -1.0;
	}

	ii_lo = ceil(ii_lo);

	float eps = 1.0 / 512.0;
	float dda_step = step_length * u_step_scale;
	Interval total = Interval(HRC_LIGHT(0.0), 0.0);
	float total_trn = 1.0;
	for (float ii = ii_lo; ii < ii_hi; ii += 1.0) {
		vec3 rad;
		float tau_step, trn;
		cell_step(rot_start + rot_delta * ii, dda_step, eps, rad, tau_step, trn);
#ifdef HRC_SCALAR
		total.rad += total_trn * dot(rad, HRC_LUMA);
#else
		total.rad += total_trn * rad;
#endif
		total_trn *= trn;
		total.tau += tau_step;
		if (total_trn < eps) break;
	}
	return total;
}
// Copies the material targets; see render_material_textures.

layout(set = 2, binding = 0) uniform sampler2D u_scene;
layout(set = 2, binding = 1) uniform sampler2D u_source;
layout(set = 2, binding = 2) uniform sampler2D u_albedo;
layout(set = 2, binding = 3) uniform sampler2D u_normal;
layout(set = 2, binding = 4) uniform sampler2D u_visibility;
layout(set = 2, binding = 5) uniform sampler2D u_cover;

layout(location = 0) out vec4 out_scene;
layout(location = 1) out vec4 out_source;
layout(location = 2) out vec4 out_albedo;
layout(location = 3) out vec4 out_normal;
layout(location = 4) out vec4 out_visibility;
layout(location = 5) out vec4 out_cover;

void main()
{
	ivec2 pixel = ivec2(gl_FragCoord.xy);
	out_scene = texelFetch(u_scene, pixel, 0);
	out_source = texelFetch(u_source, pixel, 0);
	out_albedo = texelFetch(u_albedo, pixel, 0);
	out_normal = texelFetch(u_normal, pixel, 0);
	out_visibility = texelFetch(u_visibility, pixel, 0);
	out_cover = texelFetch(u_cover, pixel, 0);
}
// Adapted from Neon-Swarm shaders/hrc/merge.shd; original source comments retained.
// Builds angular fluence R_n from R_{n+1} (Sec 4, Eq 14-17).
//
// Odd probe x (Eq 14): trace one T_n step outward to reach R_{n+1} probes.
// Even probe x (Eq 15-17): average direct R_{n+1} lookup with traced T_{n+1} path.
//
// R_N is implicitly zero; the top merge never reads a previous fluence level.
//
// Level layout:
//   T: element = probe_x * (2^n + 1) + slot of k, row = y
//   R: element = slot * 2^n + i,          row = y; see hrc_parity_slot

#include "hrc/hrc_pass.shd"

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_cascade;
	int u_transposed;
	int u_world_w;
	int u_world_h;
	int u_cascade_count;
	float u_falloff;
	// Levels below this one are traced here rather than stored.
	int u_stored_from;
	int u_rotate;
	int u_work_w;
	int u_work_h;
	float u_step_scale;
};

#include "hrc/hrc_trace.shd"

layout(set = 2, binding = 2) uniform sampler2D u_t_curr;
layout(set = 2, binding = 3) uniform sampler2D u_t_next;
layout(set = 2, binding = 4) uniform sampler2D u_r_prev;
// Row n holds each level-n direction's shares of its sector in its upper (x)
// and lower (y) sub-cones.
layout(set = 2, binding = 5) uniform sampler2D u_weights;

HRC_LIGHT merge_r(Interval near, HRC_LIGHT far_rad)
{
	// Distance falloff: attenuate far-field by this cascade's interval length.
	// Exponential compounding across levels gives total atten = exp(-falloff * dist).
	float atten = u_falloff > 0.0 ? exp(-u_falloff * float(1 << u_cascade)) : 1.0;
	return near.rad + exp(-near.tau) * far_rad * atten;
}

Interval T_load(sampler2D level_tex, int n, int probe_x, int k, int y)
{
	if (n >= u_cascade_count) return Interval(HRC_LIGHT(0.0), 0.0);
	int directions = (1 << n) + 1;
	int num_probes = probe_count(u_world_w, n);
	if (probe_x < 0 || probe_x >= num_probes || k < 0 || k >= directions || y < 0 || y >= u_world_h) {
		return Interval(HRC_LIGHT(0.0), 0.0);
	}
	// WebGL forbids ?: on structs.
	if (n < u_stored_from) {
		if (n == 0) return trace_cell(probe_x, y);
		return trace_interval(n, probe_x, k, y);
	}
	int element = probe_x * directions + hrc_parity_slot(k, directions);
	return interval_fetch(level_tex, hrc_texel(element, y, u_transposed));
}

HRC_LIGHT R_load(int probe_x, int i, int y)
{
	int n = u_cascade + 1;
	if (n >= u_cascade_count) return HRC_LIGHT(0.0);
	int directions = 1 << n;
	int num_probes = probe_count(u_world_w, n);
	if (probe_x < 0 || probe_x >= num_probes || i < 0 || i >= directions || y < 0 || y >= u_world_h) {
		return HRC_LIGHT(0.0);
	}
	int element = hrc_parity_slot(probe_x, num_probes) * directions + i;
	return light_fetch(u_r_prev, hrc_texel(element, y, u_transposed));
}

HRC_LIGHT merge_odd(int probe_x, int i, int y, vec2 w)
{
	int next_probe_x = (probe_x + 1) / 2;
	int pow2n = 1 << u_cascade;
	Interval upper = T_load(u_t_curr, u_cascade, probe_x, i + 1, y);
	// Both level-0 intervals of a probe cross only its cell.
	Interval lower = upper;
	if (u_cascade != 0) lower = T_load(u_t_curr, u_cascade, probe_x, i, y);
	return w.x * merge_r(upper, R_load(next_probe_x, 2 * i + 1, y + 2 * (i + 1) - pow2n)) +
	       w.y * merge_r(lower, R_load(next_probe_x, 2 * i, y + 2 * i - pow2n));
}

HRC_LIGHT merge_even(int probe_x, int i, int y, vec2 w)
{
	int next_probe_x = probe_x / 2;
	int far_probe_x = next_probe_x + 1;
	int pow2n1 = 1 << (u_cascade + 1);
	HRC_LIGHT far = w.x * merge_r(T_load(u_t_next, u_cascade + 1, next_probe_x, 2 * (i + 1), y),
	                              R_load(far_probe_x, 2 * i + 1, y + 2 * 2 * (i + 1) - pow2n1)) +
	                w.y * merge_r(T_load(u_t_next, u_cascade + 1, next_probe_x, 2 * i, y),
	                              R_load(far_probe_x, 2 * i, y + 2 * 2 * i - pow2n1));
	HRC_LIGHT near = w.x * R_load(next_probe_x, 2 * i + 1, y) + w.y * R_load(next_probe_x, 2 * i, y);
	return (near + far) * 0.5;
}

void main()
{
	ivec2 er = hrc_element_row(u_transposed);
	int directions = 1 << u_cascade;
	int slot = er.x / directions;
	int i = er.x - slot * directions;
	int probe_x = hrc_parity_item(slot, probe_count(u_world_w, u_cascade));
	vec2 w = texelFetch(u_weights, ivec2(i, u_cascade), 0).xy;
	out_value = light_texel((probe_x % 2 == 0) ? merge_even(probe_x, i, er.y, w)
	                                           : merge_odd(probe_x, i, er.y, w));
}
#define HRC_SCALAR 1
#include "hrc/merge.frag"
// A triangle covering the viewport; fragment passes address their target by
// gl_FragCoord.
layout(location = 0) in vec2 in_pos;

void main()
{
	gl_Position = vec4(in_pos, 0.0, 1.0);
}
// Adapted from Neon-Swarm shaders/hrc/prefilter.shd; original source comments retained.
// Prefilter for trace shader inputs.
//
// Averages each work cell's canvas-resolution footprint directly, so inputs
// need no mipmaps. Pixels count by the area they share with the cell, so
// cells that are not a whole number of pixels neither lose nor gain pixels:
//   Light:         box average up to 2x2 pixels, Gaussian-weighted beyond
//   Transmittance: area mean over a step of the cell's length
//   Bounce:        weighted like light, reprojected into the current view
// Light and transmittance average as hrc/source_average.shd describes.
//
// Emission and optical depth share one texture, which the trace samples at
// every step. Reflected light stays separate: it scales with the opacity a
// step meets even where emission does not.
//
// Drawn at work_w x work_h. Each fragment reads an S x S block of
// canvas-resolution pixels (S = canvas_dim / work_dim).

// RGB emission, A optical depth; see render_material_textures.
layout(set = 2, binding = 0) uniform sampler2D u_source;
layout(set = 2, binding = 1) uniform sampler2D u_bounce;

// RGB emission, A optical depth per canvas pixel.
layout(location = 0) out vec4 out_source;
layout(location = 1) out vec4 out_bounce;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_canvas_w;
	int u_canvas_h;
	int u_work_w;
	int u_work_h;
	float u_bounce_intensity;
	vec2 u_history_offset;
	int u_history_valid;
	vec4 u_crop_uv;
};

#include "hrc/hrc_domain.shd"
#include "hrc/source_average.shd"

vec3 bounce_sample(vec2 uv)
{
	uv += u_history_offset;
	if (u_history_valid == 0 || any(lessThan(uv, vec2(0.0))) ||
	    any(greaterThanEqual(uv, vec2(1.0)))) return vec3(0.0);
	return textureLod(u_bounce, uv, 0.0).rgb;
}

void main()
{
	ivec2 gid = ivec2(gl_FragCoord.xy);

	// Floating-point cell size (handles non-integer canvas/work ratios).
	vec2 canvas = vec2(u_canvas_w, u_canvas_h);
	vec2 cell = canvas / vec2(u_work_w, u_work_h);
	vec2 origin = vec2(gid) * cell;
	ivec2 lo = ivec2(floor(origin));
	ivec2 hi = min(ivec2(ceil(origin + cell)), ivec2(u_canvas_w, u_canvas_h));

	// Cells up to 2x2 pixels use a uniform average; larger cells use a Gaussian
	// with the Nyquist-correct sigma of half a cell.
	bool uniform_weights = all(lessThanEqual(cell, vec2(2.0)));
	vec2 center = origin + cell * 0.5;
	vec2 inv2s2 = 2.0 / (cell * cell);

	vec3 light_sum = vec3(0.0);
	vec3 bounce_sum = vec3(0.0);
	float transmittance_sum = 0.0;
	float area_sum = 0.0;
	float weight_sum = 0.0;
	for (int y = lo.y; y < hi.y; y++) {
		for (int x = lo.x; x < hi.x; x++) {
			ivec2 p = ivec2(x, y);
			vec2 pixel = vec2(p) + 0.5;
			vec2 overlap = min(vec2(p) + 1.0, origin + cell) - max(vec2(p), origin);
			float area = overlap.x * overlap.y;
			vec2 d = pixel - center;
			float w = area * (uniform_weights ? 1.0 : exp(-dot(d * d, inv2s2)));
			vec4 part = source_step(texelFetch(u_source, p, 0), cell.x);
			light_sum += part.rgb * w;
			bounce_sum += bounce_sample(pixel / canvas) * w;
			transmittance_sum += part.a * area;
			area_sum += area;
			weight_sum += w;
		}
	}
	vec2 uv = (vec2(gid) + 0.5) / vec2(u_work_w, u_work_h);
	vec4 source = source_resolve(vec4(light_sum / weight_sum, transmittance_sum / area_sum), cell.x);
	vec3 bounce = bounce_sum / weight_sum;
	out_source = vec4(source.rgb * hrc_emission_weight(uv, u_crop_uv), source.a);
	out_bounce = vec4(bounce * u_bounce_intensity, 1.0);
}
// Hands the far field from a coarse hierarchy to a finer one. The coarse grid
// is 2^u_shift times coarser and solves cascades above the fine grid's handoff
// level K. Its level K + 1 - u_shift probes sit on the fine level K + 1 probe
// columns and cover the same interval lengths with 2^u_shift times fewer
// directions. Angular fluence is the mean over a direction's sector, so each
// fine sub-direction takes its coarse sector's value, and fine rows
// interpolate between coarse rows. Blending between neighboring sectors
// instead leaves the streaks of a coarse far field and adds error.
//
// The coarse hierarchy is always RGB; the luminance variant converts it.

#include "hrc/hrc_pass.shd"

layout(set = 2, binding = 0) uniform sampler2D u_coarse;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_level;
	int u_shift;
	int u_transposed;
	int u_coarse_w;
	int u_coarse_h;
	int u_fine_probes;
	// Coarse coordinate of fine pixel 0 along each rotated axis. Coarse cells
	// group world-aligned fine cells, so rotations that flip a dimension that
	// is not a multiple of the ratio shift the grouping.
	vec2 u_offset;
};

void main()
{
	ivec2 er = hrc_element_row(u_transposed);
	int fine_directions = 2 << u_level;
	int slot = er.x / fine_directions;
	int i = er.x - slot * fine_directions;
	int probe_x = hrc_parity_item(slot, u_fine_probes);

	int coarse_level = u_level + 1 - u_shift;
	int coarse_directions = 1 << coarse_level;
	vec2 coarse = vec2(probe_x * fine_directions, er.y) / float(1 << u_shift) + u_offset;
	int coarse_probe = clamp(int(round(coarse.x / float(coarse_directions))), 0,
	                         probe_count(u_coarse_w, coarse_level) - 1);
	float row = clamp(coarse.y, 0.0, float(u_coarse_h - 1));
	int y0 = int(floor(row));
	int y1 = min(y0 + 1, u_coarse_h - 1);
	int coarse_probes = probe_count(u_coarse_w, coarse_level);
	int column = hrc_parity_slot(coarse_probe, coarse_probes) * coarse_directions + (i >> u_shift);
	vec3 near_row = texelFetch(u_coarse, hrc_texel(column, y0, u_transposed), 0).rgb;
	vec3 far_row = texelFetch(u_coarse, hrc_texel(column, y1, u_transposed), 0).rgb;
	vec3 fluence = mix(near_row, far_row, row - float(y0));
#ifdef HRC_SCALAR
	out_value = light_texel(dot(fluence, HRC_LUMA));
#else
	out_value = light_texel(fluence);
#endif
}
#define HRC_SCALAR 1
#include "hrc/refine.frag"
// Stylized 2D planar image mapping. HRC supplies the already-lit source.
// No recursive feedback, offscreen reconstruction, refraction or extra lights.
layout(set = 2, binding = 1) uniform sampler2D u_scene;
layout(set = 3, binding = 1) uniform shd_uniforms {
    vec4 u_view;
    vec4 u_plane;
    vec4 u_tint;
    vec2 u_optics;
    vec2 u_pixel;
};
vec4 shader(vec4 color, ShaderParams params)
{
    vec2 world = u_view.xy + screen_uv * u_view.zw * vec2(1,-1);
    vec2 normal = vec2(-u_plane.w, u_plane.z);
    vec2 reflected = world - 2.0 * normal * dot(world-u_plane.xy,normal);
    vec2 uv = (reflected-u_view.xy) / (u_view.zw*vec2(1,-1));
    float edge = min(min(uv.x,uv.y),min(1.0-uv.x,1.0-uv.y));
    float weight = u_optics.x * smoothstep(0.0,.04,edge);
    vec3 base = texture(u_scene,screen_uv).rgb;
    vec2 spread = u_pixel*(1.0+u_optics.y*6.0);
    vec3 reflection = texture(u_scene,uv).rgb*.5;
    reflection += texture(u_scene,uv+spread).rgb*.125;
    reflection += texture(u_scene,uv-spread).rgb*.125;
    reflection += texture(u_scene,uv+vec2(spread.x,-spread.y)).rgb*.125;
    reflection += texture(u_scene,uv+vec2(-spread.x,spread.y)).rgb*.125;
    return vec4(mix(base,reflection*u_tint.rgb,weight),1);
}
// Unrotates one quadrant's cascade-0 fluence into a filterable world-space
// image for gather. World pixel p holds the fluence arriving at the next probe
// along the quadrant's direction, where gather's near interval ends; probes
// past the domain receive nothing.

#include "hrc/hrc_pass.shd"

layout(set = 2, binding = 0) uniform sampler2D u_frustum;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_rotate;
	int u_work_w;
	int u_work_h;
};

// Fluence arriving at rotated probe rp; probes past the domain receive none.
vec3 probe_fluence(ivec2 rp, int rot_w, int rot_h)
{
	if (rp.x >= rot_w) return vec3(0.0);
	ivec2 texel = ivec2(hrc_parity_slot(rp.x, rot_w), clamp(rp.y, 0, rot_h - 1));
	return texelFetch(u_frustum, (u_rotate & 1) != 0 ? texel.yx : texel, 0).rgb;
}

void main()
{
	ivec2 p = ivec2(gl_FragCoord.xy);
	int rot_w = (u_rotate & 1) != 0 ? u_work_h : u_work_w;
	int rot_h = (u_rotate & 1) != 0 ? u_work_w : u_work_h;
	ivec2 rp;
	if (u_rotate == 1)      rp = ivec2(p.y, u_work_w - 1 - p.x);
	else if (u_rotate == 2) rp = ivec2(u_work_w - 1 - p.x, u_work_h - 1 - p.y);
	else if (u_rotate == 3) rp = ivec2(u_work_h - 1 - p.y, p.x);
	else                    rp = p;
	rp.x += 1;
	// Even and odd probes merge differently, which leaves a checkerboard at
	// the probe grid's highest frequency. A 1-2-1 tent removes exactly it.
	vec3 fluence = vec3(0.0);
	for (int dy = -1; dy <= 1; dy++) {
		for (int dx = -1; dx <= 1; dx++) {
			float weight = float((2 - abs(dx)) * (2 - abs(dy)));
			fluence += weight * probe_fluence(rp + ivec2(dx, dy), rot_w, rot_h);
		}
	}
	out_value = vec4(fluence / 16.0, 1.0);
}
// Unrotates the luminance hierarchy's cascade-0 fluence into one filterable
// world-space image: channel r holds the luminance arriving from quadrant r
// (+x, +y, -x, -y). As in resolve.shd, world pixel p holds the fluence
// arriving at the next probe along each direction.

#include "hrc/hrc_pass.shd"

layout(set = 2, binding = 0) uniform sampler2D u_q0;
layout(set = 2, binding = 1) uniform sampler2D u_q1;
layout(set = 2, binding = 2) uniform sampler2D u_q2;
layout(set = 2, binding = 3) uniform sampler2D u_q3;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_work_w;
	int u_work_h;
};

ivec2 world_to_rotated(ivec2 p, int rot)
{
	if (rot == 1) return ivec2(p.y, u_work_w - 1 - p.x);
	if (rot == 2) return ivec2(u_work_w - 1 - p.x, u_work_h - 1 - p.y);
	if (rot == 3) return ivec2(u_work_h - 1 - p.y, p.x);
	return p;
}

float quadrant_fetch(int rot, ivec2 texel)
{
	if (rot == 0) return texelFetch(u_q0, texel, 0).r;
	if (rot == 1) return texelFetch(u_q1, texel, 0).r;
	if (rot == 2) return texelFetch(u_q2, texel, 0).r;
	return texelFetch(u_q3, texel, 0).r;
}

// Luminance arriving at a rotated probe; probes past the domain receive none.
float probe_luminance(int rot, ivec2 rp, int rot_w, int rot_h)
{
	if (rp.x >= rot_w) return 0.0;
	ivec2 texel = ivec2(hrc_parity_slot(rp.x, rot_w), clamp(rp.y, 0, rot_h - 1));
	return quadrant_fetch(rot, (rot & 1) != 0 ? texel.yx : texel);
}

void main()
{
	ivec2 p = ivec2(gl_FragCoord.xy);
	vec4 luminance = vec4(0.0);
	for (int rot = 0; rot < 4; rot++) {
		int rot_w = (rot & 1) != 0 ? u_work_h : u_work_w;
		int rot_h = (rot & 1) != 0 ? u_work_w : u_work_h;
		ivec2 rp = world_to_rotated(p, rot) + ivec2(1, 0);
		// The 1-2-1 tent of resolve.frag, against the probe checkerboard.
		for (int dy = -1; dy <= 1; dy++) {
			for (int dx = -1; dx <= 1; dx++) {
				float weight = float((2 - abs(dx)) * (2 - abs(dy)));
				luminance[rot] += weight * probe_luminance(rot, rp + ivec2(dx, dy), rot_w, rot_h);
			}
		}
		luminance[rot] /= 16.0;
	}
	out_value = luminance;
}
// Averaging transport inputs over partly covered cells. A cell's light and
// transmittance are the means of its parts' over one step of the cell's
// length, so both follow coverage linearly. Averaging optical depth instead
// turns a half-covered opaque cell nearly opaque and dims its light, by
// amounts that change as edges cross cells, so moving bodies flicker.
//
// Steps match the trace's: opacity times light, or light times length where
// the step is nearly transparent.

const float SOURCE_TRANSPARENT = 1.0 / 512.0;

// A source's light over a step of length s, and the step's transmittance.
vec4 source_step(vec4 source, float s)
{
	float t = exp(-max(source.a, 0.0) * s);
	float o = 1.0 - t;
	return vec4(o > SOURCE_TRANSPARENT ? o * source.rgb : source.rgb * s, t);
}

// The source whose step of length s gives a mean step's light and
// transmittance.
vec4 source_resolve(vec4 part, float s)
{
	float t = max(part.a, 1e-6);
	float o = 1.0 - t;
	return vec4(o > SOURCE_TRANSPARENT ? part.rgb / o : part.rgb / s, -log(t) / s);
}
// Separable Gaussian blur of both surface light seed images along one axis.
// Edges repeat their nearest texel.

layout(set = 2, binding = 0) uniform sampler2D u_light;
layout(set = 2, binding = 1) uniform sampler2D u_dirs;

layout(location = 0) out vec4 out_light;
layout(location = 1) out vec4 out_dirs;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_width;
	int u_height;
	int u_vertical;
	float u_sigma;
};

void main()
{
	ivec2 p = ivec2(gl_FragCoord.xy);
	ivec2 axis = u_vertical != 0 ? ivec2(0, 1) : ivec2(1, 0);
	ivec2 last = ivec2(u_width - 1, u_height - 1);
	int radius = int(ceil(u_sigma * 3.0));
	float falloff = -0.5 / (u_sigma * u_sigma);
	vec4 light = vec4(0), dirs = vec4(0);
	float total = 0.0;
	for (int i = -radius; i <= radius; i++) {
		float weight = exp(float(i * i) * falloff);
		ivec2 q = clamp(p + axis * i, ivec2(0), last);
		light += texelFetch(u_light, q, 0) * weight;
		dirs += texelFetch(u_dirs, q, 0) * weight;
		total += weight;
	}
	out_light = light / total;
	out_dirs = dirs / total;
}
// Surface light seed: averages received light over open space in square
// canvas blocks. Target 0 holds light times openness in RGB and the open
// fraction in A; target 1 holds the per-quadrant arriving luminance times
// openness.
//
// Each tap filters a 2x2 pixel group, so a block has (block / 2)^2 taps; the
// blur that follows is several blocks wide. Blurring these images gives, for
// a solid pixel, the light in the open space around it, how far that space
// is, and the directions the light arrives from.

layout(set = 2, binding = 0) uniform sampler2D u_fluence;
layout(set = 2, binding = 1) uniform sampler2D u_scene;
layout(set = 2, binding = 2) uniform sampler2D u_dirs;

layout(location = 0) out vec4 out_light;
layout(location = 1) out vec4 out_dirs;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_canvas_w;
	int u_canvas_h;
	int u_block;
};

void main()
{
	ivec2 p = ivec2(gl_FragCoord.xy);
	int taps = max(u_block / 2, 1);
	float spacing = float(u_block) / float(taps);
	vec4 sum = vec4(0), dirs = vec4(0);
	for (int y = 0; y < taps; y++) {
		for (int x = 0; x < taps; x++) {
			vec2 uv = (vec2(p * u_block) + (vec2(x, y) + 0.5) * spacing) /
			          vec2(u_canvas_w, u_canvas_h);
			float open = 1.0 - clamp(texture(u_scene, uv).a, 0.0, 1.0);
			vec3 light = max(texture(u_fluence, uv).rgb, vec3(0));
			sum += vec4(light * open, open);
			dirs += max(texture(u_dirs, uv), vec4(0)) * open;
		}
	}
	float area = float(taps * taps);
	out_light = sum / area;
	out_dirs = dirs / area;
}
// Adapted from Neon-Swarm shaders/hrc/trace.shd; original source comments retained.
// DDA path-traces the lowest level the hierarchy stores; see hrc_trace.shd.

#include "hrc/hrc_pass.shd"

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_cascade;
	int u_rotate;
	int u_transposed;
	int u_work_w;
	int u_work_h;
	float u_step_scale;
};

#include "hrc/hrc_trace.shd"

void main()
{
	ivec2 er = hrc_element_row(u_transposed);
	int directions = (1 << u_cascade) + 1;
	int probe_x = er.x / directions;
	int k = hrc_parity_item(er.x - probe_x * directions, directions);
	out_value = interval_texel(trace_interval(u_cascade, probe_x, k, er.y));
}
#define HRC_SCALAR 1
#include "hrc/trace.frag"
// From Neon-Swarm shaders/hrc_common.shd.
// Shared HRC cascade utilities: interval type and probe helpers. The RGB
// transport's light is a color; the luminance transport (HRC_SCALAR) carries
// brightness alone.

#ifdef HRC_SCALAR
#define HRC_LIGHT float
#else
#define HRC_LIGHT vec3
#endif

struct Interval
{
	HRC_LIGHT rad;
	float tau;
};

int probe_count(int world_w, int n)
{
	int step = 1 << n;
	return (world_w + step - 1) / step;
}

const vec3 HRC_LUMA = vec3(0.2126, 0.7152, 0.0722);
// Adapted from the user-supplied Neon-Swarm shaders. Original shader equations retained.
// Noise utilities (from LYGIA, MIT/Prosperity License)

float random(vec2 st)
{
    return fract(sin(dot(st, vec2(12.9898, 78.233))) * 43758.5453);
}

vec2 random2(vec2 p)
{
    vec4 s = vec4(443.897, 441.423, 0.0973, 0.1099);
    vec3 p3 = fract(p.xyx * s.xyz);
    p3 += dot(p3, p3.yzx + 19.19);
    return fract((p3.xx + p3.yz) * p3.zy);
}

float gnoise(vec2 st)
{
    vec2 i = floor(st);
    vec2 f = fract(st);
    float a = random(i);
    float b = random(i + vec2(1.0, 0.0));
    float c = random(i + vec2(0.0, 1.0));
    float d = random(i + vec2(1.0, 1.0));
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(a, b, u.x) +
           (c - a) * u.y * (1.0 - u.x) +
           (d - b) * u.x * u.y;
}
// 13-tap bloom downsample (Jimenez, "Next Generation Post Processing in Call
// of Duty: Advanced Warfare", 2014). The first level weights each 2x2 group by
// the inverse of its luminance, so single bright pixels do not flicker.
layout(set = 3, binding = 1) uniform shd_uniforms {
    vec2 source_texel;
    float karis;
};

vec3 tap(vec2 uv)
{
    vec3 c = texture(u_image, uv).rgb;
    if (isnan(c.r) || isnan(c.g) || isnan(c.b)) return vec3(0);
    return clamp(c, vec3(0), vec3(65504));
}

float weight(vec3 c)
{
    return 1.0 / (1.0 + dot(c, vec3(0.2126, 0.7152, 0.0722)));
}

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 uv = params.uv, t = source_texel;
    vec3 a = tap(uv + t * vec2(-2, 2)), b = tap(uv + t * vec2(0, 2)), c = tap(uv + t * vec2(2, 2));
    vec3 d = tap(uv + t * vec2(-2, 0)), e = tap(uv), f = tap(uv + t * vec2(2, 0));
    vec3 g = tap(uv + t * vec2(-2, -2)), h = tap(uv + t * vec2(0, -2)), i = tap(uv + t * vec2(2, -2));
    vec3 j = tap(uv + t * vec2(-1, 1)), k = tap(uv + t * vec2(1, 1));
    vec3 l = tap(uv + t * vec2(-1, -1)), m = tap(uv + t * vec2(1, -1));
    vec3 g0 = (a + b + d + e) * .25, g1 = (b + c + e + f) * .25;
    vec3 g2 = (d + e + g + h) * .25, g3 = (e + f + h + i) * .25;
    vec3 g4 = (j + k + l + m) * .25;
    vec4 w = karis > .5 ? vec4(weight(g0), weight(g1), weight(g2), weight(g3)) : vec4(1);
    float w4 = karis > .5 ? weight(g4) : 1.0;
    vec3 sum = (g0 * w.x + g1 * w.y + g2 * w.z + g3 * w.w) * .125 + g4 * w4 * .5;
    return vec4(sum / (dot(w, vec4(.125)) + w4 * .5), 1);
}
// Linear HDR frame to display: energy-conserving bloom mix, exposure and AgX
// tone mapping (Troy Sobotka's AgX, polynomial fit of the default contrast
// curve by Benjamin Wrensch). The AgX curve already encodes for display.
layout(set = 2, binding = 1) uniform sampler2D bloom_tex;
layout(set = 3, binding = 1) uniform shd_uniforms {
    float exposure;
    float bloom;
    float bloom_scale;
    float dither_phase;
};

#include "color.shd"

vec3 finite_hdr(vec3 c)
{
    if (isnan(c.r) || isnan(c.g) || isnan(c.b)) return vec3(0);
    return clamp(c, vec3(0), vec3(65504));
}

vec3 agx_contrast(vec3 x)
{
    vec3 x2 = x * x, x4 = x2 * x2;
    return 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x +
           0.4298 * x2 + 0.1191 * x - 0.00232;
}

vec3 agx(vec3 c)
{
    const mat3 inset = mat3(0.842479062253094, 0.0423282422610123, 0.0423756549057051,
                            0.0784335999999992, 0.878468636469772, 0.0784336,
                            0.0792237451477643, 0.0791661274605434, 0.879142973793104);
    const mat3 outset = mat3(1.19687900512017, -0.0528968517574562, -0.0529716355144438,
                             -0.0980208811401368, 1.15190312990417, -0.0980434501171241,
                             -0.0990297440797205, -0.0989611768448433, 1.15107367264116);
    const float min_ev = -12.47393, max_ev = 4.026069;
    c = inset * c;
    c = clamp(log2(max(c, vec3(1e-10))), min_ev, max_ev);
    c = (c - min_ev) / (max_ev - min_ev);
    return outset * agx_contrast(c);
}

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 uv = params.uv;
    vec3 hdr = finite_hdr(texture(u_image, uv).rgb);
    vec3 glow = finite_hdr(texture(bloom_tex, uv).rgb) * bloom_scale;
    vec3 mapped = agx(mix(hdr, glow, bloom) * exp2(exposure));
    float dither = dither8bit_ign(gl_FragCoord.xy, dither_phase);
    return vec4(clamp(mapped + vec3(dither), vec3(0), vec3(1)), 1);
}
// Bloom upsample: a 3x3 tent filter of the level below, added to this level.
layout(set = 2, binding = 1) uniform sampler2D current;
layout(set = 3, binding = 1) uniform shd_uniforms {
    vec2 source_texel;
};

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 uv = params.uv, t = source_texel;
    vec3 s = texture(u_image, uv + t * vec2(-1, 1)).rgb + texture(u_image, uv + t * vec2(1, 1)).rgb +
             texture(u_image, uv + t * vec2(-1, -1)).rgb + texture(u_image, uv + t * vec2(1, -1)).rgb;
    s += 2.0 * (texture(u_image, uv + t * vec2(0, 1)).rgb + texture(u_image, uv + t * vec2(0, -1)).rgb +
                texture(u_image, uv + t * vec2(1, 0)).rgb + texture(u_image, uv + t * vec2(-1, 0)).rgb);
    s += 4.0 * texture(u_image, uv).rgb;
    return vec4(texture(current, uv).rgb + s / 16.0, 1);
}
// Adapted from the user-supplied Neon-Swarm shaders. Original shader equations retained.
// Shared SDF primitives.

float sdf_circle(vec2 p, float r)
{
    return length(p) - r;
}

float sdf_circle_stroked(vec2 p, float r, float t)
{
    return abs(length(p) - r) - t * 0.5;
}

float sdf_box(vec2 p, vec2 half_ext, float r)
{
    vec2 d = abs(p) - half_ext + r;
    return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0) - r;
}

float sdf_segment(vec2 p, vec2 a, vec2 b)
{
    vec2 ba = b - a;
    vec2 pa = p - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h);
}

float sdf_capsule(vec2 p, vec2 a, vec2 b, float r)
{
    return sdf_segment(p, a, b) - r;
}

float sdf_line(vec2 p, vec2 a, vec2 b, float t)
{
    return sdf_segment(p, a, b) - t * 0.5;
}

float cross2(vec2 a, vec2 b)
{
    return a.x * b.y - a.y * b.x;
}

float sdf_triangle(vec2 p, vec2 a, vec2 b, vec2 c, float r)
{
    vec2 e0 = b - a, e1 = c - b, e2 = a - c;
    vec2 v0 = p - a, v1 = p - b, v2 = p - c;

    vec2 pq0 = v0 - e0 * clamp(dot(v0, e0) / dot(e0, e0), 0.0, 1.0);
    vec2 pq1 = v1 - e1 * clamp(dot(v1, e1) / dot(e1, e1), 0.0, 1.0);
    vec2 pq2 = v2 - e2 * clamp(dot(v2, e2) / dot(e2, e2), 0.0, 1.0);

    float s = sign(cross2(e0, e2));
    vec2 d0 = vec2(dot(pq0, pq0), s * cross2(v0, e0));
    vec2 d1 = vec2(dot(pq1, pq1), s * cross2(v1, e1));
    vec2 d2 = vec2(dot(pq2, pq2), s * cross2(v2, e2));

    vec2 dm = min(min(d0, d1), d2);
    float dist = -sqrt(dm.x) * sign(dm.y);
    return dist - r;
}

float smin(float a, float b, float k)
{
    float h = max(k - abs(a - b), 0.0) / k;
    return min(a, b) - h * h * k * 0.25;
}

float sdf_square(vec2 p, float r)
{
    return max(abs(p.x), abs(p.y)) - r;
}

float sdf_diamond(vec2 p, float r)
{
    return (abs(p.x) + abs(p.y)) - r;
}
// Procedural star placement adapted from Neon-Swarm. Cached as unlit presentation.
layout(set = 3, binding = 1) uniform shd_uniforms {
    vec2 camera_pos;
    vec2 world_size;
    vec4 far_layer;
    vec4 middle_layer;
    vec4 near_layer;
    vec3 parallax;
    vec4 palette_a;
    vec4 palette_b;
    vec4 palette_c;
    vec4 palette_d;
};
#include "noise.shd"
vec2 voronoi_star(vec2 pos, float cell_size, float star_radius, float density, vec2 layer_seed)
{
    vec2 cell = floor(pos / cell_size);
    float min_dist = 1e9;
    float color_seed = 0.0;

    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            vec2 neighbor = cell + vec2(float(dx), float(dy));
            vec2 h = random2(neighbor + layer_seed);

            if (h.x > density) continue;

            vec2 star_pos = (neighbor + h) * cell_size;
            float d = length(pos - star_pos);

            if (d < min_dist) {
                min_dist = d;
                color_seed = random(neighbor + layer_seed * 17.31);
            }
        }
    }

    float brightness = exp(-min_dist * min_dist / (star_radius * star_radius));
    brightness = smoothstep(0.3, 1.0, brightness);

    return vec2(brightness, color_seed);
}


vec3 star_color(float seed) {
    float t = seed * 4.0;
    if (t < 1.0) return mix(palette_a.rgb, palette_b.rgb, t);
    if (t < 2.0) return mix(palette_b.rgb, palette_c.rgb, t - 1.0);
    if (t < 3.0) return mix(palette_c.rgb, palette_d.rgb, t - 2.0);
    return mix(palette_d.rgb, palette_a.rgb, t - 3.0);
}
vec3 layer(vec2 offset, vec4 settings, float depth, vec2 seed) {
    if (settings.x <= 0.0 || settings.y <= 0.0 || settings.z <= 0.0) return vec3(0.0);
    vec2 s = voronoi_star(offset + camera_pos * depth, settings.x, settings.y, settings.z, seed);
    return star_color(s.y) * s.x * settings.w;
}
vec4 shader(vec4 color, ShaderParams params) {
    vec2 offset = (screen_uv - 0.5) * vec2(1.0, -1.0) * world_size;
    vec3 stars = layer(offset, far_layer, parallax.x, vec2(0.0));
    stars += layer(offset, middle_layer, parallax.y, vec2(53.7,91.2));
    stars += layer(offset, near_layer, parallax.z, vec2(137.4,219.8));
    return vec4(stars, 1.0);
}
