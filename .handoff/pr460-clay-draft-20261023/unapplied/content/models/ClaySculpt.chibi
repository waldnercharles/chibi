package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("version", data.Value.UInt(3)),
            data.Field.Named("name", data.Value.Text("ClaySculpt")),
            data.Field.Named("domain", data.Value.Text("model")),
            data.Field.Named("id_counter", data.Value.UInt(2000)),
            data.Field.Named("description", data.Value.Text("Bounded primitive sculpt: a softened lobe and thumb cut. Form 0 recovers ClayBlock; Form 1 shows the worked silhouette.")),
            data.Field.Named("graphs", data.List([
                data.Object([
                    data.Field.Named("kind", data.Value.Text("event")),
                    data.Field.Named("name", data.Value.Text("")),
                    data.Field.Named("nodes", data.List([
                        data.Object([
                            data.Field.Named("id", data.Value.UInt(100)),
