    s51: int[];
    s52: int[];
    s53: int[];
    s54: int[];
    s55: int[];
    s56: int[];
    s57: int[];
    s58: int[];
    s59: int[];
    s60: int[];
    s61: int[];
    s62: int[];
    s63: int[];
}
Main :: () -> int {
    rows: Wide[] = [{values: [u8(0)],s0: [0],s1: [1],s2: [2],s3: [3],s4: [4],s5: [5],s6: [6],s7: [7],s8: [8],s9: [9],s10: [10],s11: [11],s12: [12],s13: [13],s14: [14],s15: [15],s16: [16],s17: [17],s18: [18],s19: [19],s20: [20],s21: [21],s22: [22],s23: [23],s24: [24],s25: [25],s26: [26],s27: [27],s28: [28],s29: [29],s30: [30],s31: [31],s32: [32],s33: [33],s34: [34],s35: [35],s36: [36],s37: [37],s38: [38],s39: [39],s40: [40],s41: [41],s42: [42],s43: [43],s44: [44],s45: [45],s46: [46],s47: [47],s48: [48],s49: [49],s50: [50],s51: [51],s52: [52],s53: [53],s54: [54],s55: [55],s56: [56],s57: [57],s58: [58],s59: [59],s60: [60],s61: [61],s62: [62],s63: [63]}];
    allocated := chibi_value_test_allocations();
    owners := chibi_value_test_owner_calls();
    for index in 0..<4096 { written := memset(rows[0].values,1,1); }
    completed := chibi_value_test_allocations();
    visited := chibi_value_test_owner_calls();
    assert(completed == allocated, "unique foreign buffers keep their existing storage");
    assert(visited - owners <= 17000, "capture and call each keep/drop one leaf, without sibling owners");
    copy := rows;
    allocated = chibi_value_test_allocations();
    owners = chibi_value_test_owner_calls();
    for index in 0..<4096 { written := memset(copy[0].values,2,1); }
    completed = chibi_value_test_allocations();
    visited = chibi_value_test_owner_calls();
    assert(completed - allocated <= 2, "shared foreign field and outer backing detach once");
    assert(visited - owners <= 17200, "one detach visits siblings once before constant leaf calls");
    assert(rows[0].values[0] == 1 && copy[0].values[0] == 2);
    assert(rows[0].s0[0] == 0 && copy[0].s0[0] == 0);
    assert(rows[0].s1[0] == 1 && copy[0].s1[0] == 1);
    assert(rows[0].s2[0] == 2 && copy[0].s2[0] == 2);
    assert(rows[0].s3[0] == 3 && copy[0].s3[0] == 3);
    assert(rows[0].s4[0] == 4 && copy[0].s4[0] == 4);
    assert(rows[0].s5[0] == 5 && copy[0].s5[0] == 5);
    assert(rows[0].s6[0] == 6 && copy[0].s6[0] == 6);
    assert(rows[0].s7[0] == 7 && copy[0].s7[0] == 7);
    assert(rows[0].s8[0] == 8 && copy[0].s8[0] == 8);
    assert(rows[0].s9[0] == 9 && copy[0].s9[0] == 9);
    assert(rows[0].s10[0] == 10 && copy[0].s10[0] == 10);
    assert(rows[0].s11[0] == 11 && copy[0].s11[0] == 11);
    assert(rows[0].s12[0] == 12 && copy[0].s12[0] == 12);
    assert(rows[0].s13[0] == 13 && copy[0].s13[0] == 13);
    assert(rows[0].s14[0] == 14 && copy[0].s14[0] == 14);
    assert(rows[0].s15[0] == 15 && copy[0].s15[0] == 15);
    assert(rows[0].s16[0] == 16 && copy[0].s16[0] == 16);
    assert(rows[0].s17[0] == 17 && copy[0].s17[0] == 17);
    assert(rows[0].s18[0] == 18 && copy[0].s18[0] == 18);
    assert(rows[0].s19[0] == 19 && copy[0].s19[0] == 19);
    assert(rows[0].s20[0] == 20 && copy[0].s20[0] == 20);
    assert(rows[0].s21[0] == 21 && copy[0].s21[0] == 21);
    assert(rows[0].s22[0] == 22 && copy[0].s22[0] == 22);
    assert(rows[0].s23[0] == 23 && copy[0].s23[0] == 23);
    assert(rows[0].s24[0] == 24 && copy[0].s24[0] == 24);
    assert(rows[0].s25[0] == 25 && copy[0].s25[0] == 25);
    assert(rows[0].s26[0] == 26 && copy[0].s26[0] == 26);
    assert(rows[0].s27[0] == 27 && copy[0].s27[0] == 27);
    assert(rows[0].s28[0] == 28 && copy[0].s28[0] == 28);
    assert(rows[0].s29[0] == 29 && copy[0].s29[0] == 29);
    assert(rows[0].s30[0] == 30 && copy[0].s30[0] == 30);
    assert(rows[0].s31[0] == 31 && copy[0].s31[0] == 31);
    assert(rows[0].s32[0] == 32 && copy[0].s32[0] == 32);
    assert(rows[0].s33[0] == 33 && copy[0].s33[0] == 33);
    assert(rows[0].s34[0] == 34 && copy[0].s34[0] == 34);
    assert(rows[0].s35[0] == 35 && copy[0].s35[0] == 35);
    assert(rows[0].s36[0] == 36 && copy[0].s36[0] == 36);
    assert(rows[0].s37[0] == 37 && copy[0].s37[0] == 37);
    assert(rows[0].s38[0] == 38 && copy[0].s38[0] == 38);
    assert(rows[0].s39[0] == 39 && copy[0].s39[0] == 39);
    assert(rows[0].s40[0] == 40 && copy[0].s40[0] == 40);
    assert(rows[0].s41[0] == 41 && copy[0].s41[0] == 41);
    assert(rows[0].s42[0] == 42 && copy[0].s42[0] == 42);
    assert(rows[0].s43[0] == 43 && copy[0].s43[0] == 43);
    assert(rows[0].s44[0] == 44 && copy[0].s44[0] == 44);
    assert(rows[0].s45[0] == 45 && copy[0].s45[0] == 45);
    assert(rows[0].s46[0] == 46 && copy[0].s46[0] == 46);
    assert(rows[0].s47[0] == 47 && copy[0].s47[0] == 47);
    assert(rows[0].s48[0] == 48 && copy[0].s48[0] == 48);
    assert(rows[0].s49[0] == 49 && copy[0].s49[0] == 49);
    assert(rows[0].s50[0] == 50 && copy[0].s50[0] == 50);
    assert(rows[0].s51[0] == 51 && copy[0].s51[0] == 51);
    assert(rows[0].s52[0] == 52 && copy[0].s52[0] == 52);
    assert(rows[0].s53[0] == 53 && copy[0].s53[0] == 53);
    assert(rows[0].s54[0] == 54 && copy[0].s54[0] == 54);
    assert(rows[0].s55[0] == 55 && copy[0].s55[0] == 55);
    assert(rows[0].s56[0] == 56 && copy[0].s56[0] == 56);
    assert(rows[0].s57[0] == 57 && copy[0].s57[0] == 57);
    assert(rows[0].s58[0] == 58 && copy[0].s58[0] == 58);
    assert(rows[0].s59[0] == 59 && copy[0].s59[0] == 59);
    assert(rows[0].s60[0] == 60 && copy[0].s60[0] == 60);
    assert(rows[0].s61[0] == 61 && copy[0].s61[0] == 61);
    assert(rows[0].s62[0] == 62 && copy[0].s62[0] == 62);
    assert(rows[0].s63[0] == 63 && copy[0].s63[0] == 63);
    return 0;
}
