version 1
name "SdfHrcComparison"
(array)entities {
    - {
        name "Camera"
        prototype "SdfCamera"
        components {
            (object)GameCamera
        }
    }
    - {
        name "Cyan light"
        prototype "SdfLight"
        components {
            GameTransform x=-195.0 y=0.0
            GameMaterial emission_color=0x38d9edff
        }
    }
    - {
        name "Amber light"
        prototype "SdfLight"
        components {
            GameTransform x=195.0 y=0.0
            GameMaterial emission_color=0xffac54ff
        }
    }
    - {
        name "Rose light"
        prototype "SdfLight"
        components {
            GameTransform x=0.0 y=118.0
            GameMaterial emission_color=0xec749fff
        }
    }
    - {
        name "Triangle box"
        prototype "SdfComparisonMesh"
        components {
            GameTransform x=-95.0 y=-60.0
        }
    }
    - {
        name "Distance box"
        prototype "SdfComparisonField"
        components {
            GameTransform x=95.0 y=-60.0
        }
    }
    - {
        name "Rear triangle box"
        prototype "SdfComparisonMesh"
        components {
            GameTransform x=-12.0 y=70.0
            GameGeometry3D elevation=-12.0
            GameShader material="SdfAmber"
        }
    }
    - {
        name "Front distance box"
        prototype "SdfComparisonField"
        components {
            GameTransform x=12.0 y=70.0
            GameGeometry3D elevation=12.0
            GameShader material="SdfCyan"
        }
    }
}
