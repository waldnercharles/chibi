package lib
pub Sorted :: (values: $T[], less: fn(a: T, b: T) -> bool) -> T[] {
  result := values; i := 1; while i < length(result) { j := i; while j > 0 && less(result[j], result[j - 1]) { item: T = result[j]; result[j] = result[j - 1]; result[j - 1] = item; j -= 1; } i += 1; } return result; }
pub Any :: (values: $T[], predicate: fn(value: T) -> bool) -> bool { return AnyInternal(values, predicate); }
AnyInternal :: (values: $T[], predicate: fn(value: T) -> bool) -> bool { for value in values { if predicate(value) { return true; } } return false; }
pub Remap :: (value: $T, transform: (fn(value: T) -> T)) -> T { return transform(value: value); }
