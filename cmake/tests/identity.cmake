cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/assertions.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/generation_stability.cmake")
if(NOT REFLECT OR NOT TEST_DIR OR NOT CONCURRENT)
    message(FATAL_ERROR "REFLECT, TEST_DIR and CONCURRENT are required")
endif()
file(REMOVE_RECURSE "${TEST_DIR}")
file(MAKE_DIRECTORY "${TEST_DIR}")
set(source "${TEST_DIR}/components.c")
set(output "${TEST_DIR}/types.c")
set(runtime "${TEST_DIR}/capabilities.c")
set(manifest "${TEST_DIR}/components.tsv")
set(command "${REFLECT}" "${source}" --prefix TEST --types-output "${output}" --runtime-output "${runtime}" --manifest "${manifest}")
function(generate prefix declarations)
    file(WRITE "${source}" "#define COMPONENT(T) struct __attribute__((annotate(\"node:type\"), annotate(\"node:component:index:dense\"))) T\n${declarations}")
    run_checked(${command})
    file(STRINGS "${manifest}" rows)
    set(identities)
    foreach(row IN LISTS rows)
        if(row MATCHES "^#" OR row STREQUAL "")
            continue()
        endif()
        string(REGEX MATCHALL "[^ \t]+" columns "${row}")
        list(GET columns 2 id)
        list(GET columns 3 key)
        list(GET columns 4 name)
        set(${prefix}_${name} "${id};${key}" PARENT_SCOPE)
        list(APPEND identities "${id}")
    endforeach()
    list(LENGTH identities count)
    list(REMOVE_DUPLICATES identities)
    list(LENGTH identities unique)
    if(NOT count EQUAL unique)
        message(FATAL_ERROR "Component identities collided: ${rows}")
    endif()
    set(${prefix}_count ${count} PARENT_SCOPE)
endfunction()
generate(original "typedef COMPONENT(Health) { int current; } Health;\ntypedef COMPONENT(Speed) { float value; } Speed;\n")
if(NOT original_count EQUAL 2)
    message(FATAL_ERROR "Expected two original components")
endif()
generate(inserted "typedef COMPONENT(Collider) { float value; } Collider;\ntypedef COMPONENT(Health) { int current; } Health;\ntypedef COMPONENT(Speed) { float value; } Speed;\n")
if(NOT inserted_count EQUAL 3 OR NOT inserted_Health STREQUAL original_Health OR NOT inserted_Speed STREQUAL original_Speed)
    message(FATAL_ERROR "Insertion changed existing identities")
endif()
generate(renamed "typedef COMPONENT(Collider) { float value; } Collider;\n\n\ntypedef COMPONENT(Vitality) { int current; } Vitality;\ntypedef COMPONENT(Speed) { float value; } Speed;\n")
if(NOT renamed_Vitality STREQUAL original_Health)
    message(FATAL_ERROR "Rename lost Health identity")
endif()
generate(reverted "typedef COMPONENT(Collider) { float value; } Collider;\ntypedef COMPONENT(Speed) { float value; } Speed;\ntypedef COMPONENT(Health) { int current; int maximum; } Health;\n")
if(NOT reverted_Health STREQUAL original_Health OR NOT reverted_Speed STREQUAL original_Speed OR NOT reverted_Collider STREQUAL inserted_Collider)
    message(FATAL_ERROR "Alias restoration changed identities")
endif()
generate(removed "typedef COMPONENT(Collider) { float value; } Collider;\ntypedef COMPONENT(Health) { int current; int maximum; } Health;\n")
if(DEFINED removed_Speed OR NOT removed_count EQUAL 2)
    message(FATAL_ERROR "Removed component kept its manifest row")
endif()
generate(readded "typedef COMPONENT(Collider) { float value; } Collider;\ntypedef COMPONENT(Health) { int current; int maximum; } Health;\ntypedef COMPONENT(Pace) { float value; } Pace;\n")
if(readded_Pace STREQUAL original_Speed)
    message(FATAL_ERROR "A new component inherited a removed identity")
endif()
set(registry_target "${output}.stable")
set(identity_target "${manifest}.stable")
file(RENAME "${output}" "${registry_target}")
file(RENAME "${manifest}" "${identity_target}")
file(CREATE_LINK "${registry_target}" "${output}" SYMBOLIC)
file(CREATE_LINK "${identity_target}" "${manifest}" SYMBOLIC)
file(CHMOD "${registry_target}" "${identity_target}" PERMISSIONS OWNER_READ GROUP_READ WORLD_READ)
snapshot_generated(registry "${output}")
snapshot_generated(identity "${manifest}")
if(CMAKE_VERSION VERSION_LESS 3.23)
    # Older CMake cannot report subsecond file timestamps.
    run_checked("${CMAKE_COMMAND}" -E sleep 1.1)
endif()
# Keep generated paths as symlinks to read-only references. Reflection can
# stage and compare output, while replacement removes the links and the
# timestamps catch same-byte in-place writes within one timestamp tick.
run_checked(${command})
if(NOT IS_SYMLINK "${output}" OR NOT IS_SYMLINK "${manifest}")
    message(FATAL_ERROR "Unchanged reflection replaced a generated output")
endif()
file(READ_SYMLINK "${output}" actual_registry_target)
file(READ_SYMLINK "${manifest}" actual_identity_target)
if(NOT actual_registry_target STREQUAL registry_target OR
   NOT actual_identity_target STREQUAL identity_target)
    message(FATAL_ERROR "Unchanged reflection retargeted generated outputs")
endif()
assert_generation_unchanged(registry "${output}")
assert_generation_unchanged(identity "${manifest}")
run_checked("${CONCURRENT}" 6 ${command})
if(NOT IS_SYMLINK "${output}" OR NOT IS_SYMLINK "${manifest}")
    message(FATAL_ERROR "Concurrent unchanged reflection replaced a generated output")
endif()
file(READ_SYMLINK "${output}" actual_registry_target)
file(READ_SYMLINK "${manifest}" actual_identity_target)
if(NOT actual_registry_target STREQUAL registry_target OR
   NOT actual_identity_target STREQUAL identity_target)
    message(FATAL_ERROR "Concurrent unchanged reflection retargeted generated outputs")
endif()
assert_generation_unchanged(registry "${output}")
assert_generation_unchanged(identity "${manifest}")
file(WRITE "${source}" "this is invalid C")
execute_process(COMMAND ${command} RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
    message(FATAL_ERROR "Invalid source unexpectedly reflected")
endif()
if(NOT IS_SYMLINK "${output}" OR NOT IS_SYMLINK "${manifest}")
    message(FATAL_ERROR "Failed reflection replaced a generated output")
endif()
file(READ_SYMLINK "${output}" actual_registry_target)
file(READ_SYMLINK "${manifest}" actual_identity_target)
if(NOT actual_registry_target STREQUAL registry_target OR
   NOT actual_identity_target STREQUAL identity_target)
    message(FATAL_ERROR "Failed reflection retargeted generated outputs")
endif()
assert_generation_unchanged(registry "${output}")
assert_generation_unchanged(identity "${manifest}")
message(STATUS "PASS: component insertion, shared layouts, renames, alias restoration, concurrent and failed reflection")

# Reflected runtime handles retain nominal typing in Make/Break and field Set.
set(handle_header "typedef unsigned long long uint64_t;\n#define COMPONENT(T) struct __attribute__((annotate(\"node:type\"), annotate(\"node:component:index:dense\"))) T\n")
file(WRITE "${source}" "${handle_header}typedef COMPONENT(Owner) { uint64_t entity __attribute__((annotate(\"node:handle:ecs.entity\"))); } Owner;\n")
run_checked(${command})
file(READ "${output}" handles)
if(NOT handles MATCHES "PIN_HANDLE,[^\n]*\"ecs.entity\"" OR handles MATCHES "PIN_HANDLE,[^\n]*\"handle\"")
    message(FATAL_ERROR "Reflected handle lost its nominal type")
endif()
snapshot_generated(registry "${output}")
snapshot_generated(identity "${manifest}")
foreach(storage "int" "void *")
    file(WRITE "${source}" "${handle_header}typedef COMPONENT(Owner) { ${storage} entity __attribute__((annotate(\"node:handle:ecs.entity\"))); } Owner;\n")
    execute_process(COMMAND ${command} RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(result EQUAL 0)
        message(FATAL_ERROR "Invalid handle storage ${storage} unexpectedly reflected")
    endif()
    assert_generation_unchanged(registry "${output}")
    assert_generation_unchanged(identity "${manifest}")
endforeach()
message(STATUS "PASS: nominal handle pins and rejected non-64-bit storage")

# JIT identity is an explicit promise on a by-value struct alias conversion.
set(jit_header "#define TYPE __attribute__((annotate(\"node:type\")))\n#define FN __attribute__((annotate(\"node:fn\"), annotate(\"node:jit:identity\")))\ntypedef struct TYPE Vector { float x; float y; } Vector;\ntypedef Vector Alias;\ntypedef struct TYPE Different { float x; float y; } Different;\n")
file(WRITE "${source}" "${jit_header}FN Alias convert(Vector value);\n")
run_checked(${command})
snapshot_generated(registry "${output}")
snapshot_generated(identity "${manifest}")
foreach(signature "Alias convert()" "Alias convert(float value)" "float convert(Vector value)" "Alias convert(Vector *value)" "Different convert(Vector value)" "Alias convert(Vector a, Vector b)")
    file(WRITE "${source}" "${jit_header}FN ${signature};\n")
    execute_process(COMMAND ${command} RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
    if(result EQUAL 0 OR NOT error MATCHES "identity requires one struct argument")
        message(FATAL_ERROR "Invalid JIT identity accepted: ${signature}: ${error}")
    endif()
    assert_generation_unchanged(registry "${output}")
    assert_generation_unchanged(identity "${manifest}")
endforeach()
message(STATUS "PASS: explicit JIT identity aliases and rejected scalar, pointer, arity and layout contracts")
