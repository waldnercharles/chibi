package foreign_element_bounds
foreign import libc "system:c"
foreign libc { memset :: (data:u8[],value:i32,count:u64) -> rawptr }
Entry :: struct { values:u8[]; }
Where :: () -> int { return 3; }
Never :: () -> i32 { assert(false,"RHS evaluated"); return 9; }
Main :: () -> int { rows:Entry[]=[{values:[u8(1)]}]; written:=memset(rows[Where()].values,Never(),1); return 0; }
