-{
-    const char *text;
-    size_t length;
-    const char *error = text_bytes(arguments, count, 1, &text, &length);
-    if (error) {
-        return error;
-    }
-    *result = (pin_value){ .type = PIN_I32, .type_name = "int", .i = (int)length };
