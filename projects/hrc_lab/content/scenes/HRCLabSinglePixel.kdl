version 1
name "HRCLabSinglePixel"
(array)entities {
    - {
        name "Camera"
        prototype "HRCLabCamera"
        components {
            GameTransform x=0 y=0
        }
    }
    - {
        name "HRC"
        prototype "HRCLabHRC"
        components {
            GameTransform x=0 y=0
        }
    }
    - {
        name "Emitter"
        prototype "HRCLabEmitter"
        components {
            GameTransform x=-300 y=0
            GameAppearance width=4 height=4 shape="Circle"
        }
    }
    - {
        name "Receiver"
        prototype "HRCLabReceiver"
        components {
            GameTransform x=270 y=0
            GameAppearance width=180 height=420
        }
    }
    - {
        name "Backdrop"
        prototype "HRCLabReceiver"
        components {
            GameTransform x=0 y=0
            GameAppearance width=960 height=540 shape="Box" layer=-100
            GameMaterial absorption=0 albedo=3503345919 scene=1802202111 edge_light=0
        }
    }
}
