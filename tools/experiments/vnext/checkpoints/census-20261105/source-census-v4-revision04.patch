+CheckCyclicMutations :: () {
+    source := "package p\nF :: (b: bool, x: i64) -> i64 { while (b) { x = x + 1; x = x + 7; } return x; }\nOther :: (x: i64) -> i64 { return x; }\n";
+    original := Accepted(source);
+    entry_jump := Terminator(original, 1);
+    back := Terminator(original, 3);
+    entry_index := int(entry_jump.payload) - 1;
+    back_index := int(back.payload) - 1;
+    header := original.blocks[1];
+    parameter := original.block_parameters[int(header.first_parameter)];
+    body := original.blocks[2];
+    first_add := int(body.first_instruction) + 1;
+    second_add := first_add + 2;
+    assert(original.instructions[first_add].op == typed.AddI64 &&
+           original.instructions[second_add].op == typed.AddI64, "two ordered body updates");
+    changed := original;
+    arguments := changed.arguments;
+    arguments[int(original.edges[entry_index].first_argument)] = parameter;
+    changed.arguments = arguments;
+    error := typed.Verify(changed);
+    assert(error == typed.InvalidDominance, "loop parameter cannot initialize itself on the entry edge");
+    changed = original;
+    arguments = changed.arguments;
+    arguments[int(original.edges[back_index].first_argument)] = 1;
+    changed.arguments = arguments;
+    error = typed.Verify(changed);
+    assert(error == typed.InvalidType, "bool backedge operand cannot feed i64 loop parameter");
+    changed = original;
+    values := changed.values;
+    value := values[int(parameter) - 1];
+    value.type = typed.Bool;
+    values[int(parameter) - 1] = value;
+    changed.values = values;
+    error = typed.Verify(changed);
+    assert(error == typed.InvalidType, "loop parameter type must match incoming values");
+    changed = original;
+    instructions := changed.instructions;
+    instruction := instructions[first_add];
+    instruction.left = instructions[second_add].result;
+    instructions[first_add] = instruction;
+    changed.instructions = instructions;
+    error = typed.Verify(changed);
+    assert(error == typed.InvalidDominance, "cycle does not make a later same-block definition available");
+    moved := ReverseBlockLayout(changed);
+    error = typed.Verify(moved);
+    assert(error == typed.InvalidDominance, "same-block future use still fails after layout reversal");
+    changed = original;
+    edges := changed.edges;
+    edge := edges[back_index];
+    edge.first_argument = edges[entry_index].first_argument;
+    edges[back_index] = edge;
+    changed.edges = edges;
+    error = typed.Verify(changed);
+    assert(error == typed.InvalidSpan, "backedge cannot share ownership of the entry argument span");
+    changed = original;
+    edges = changed.edges;
+    edge = edges[back_index];
+    edge.target = original.functions[1].first_block + 1;
+    edges[back_index] = edge;
+    changed.edges = edges;
+    error = typed.Verify(changed);
+    assert(error == typed.InvalidEdge, "same-arity cross-function backedge is rejected");
+    // All edge spans here are empty. Redirecting both header arms to the exit
+    // leaves a body with an owned self-edge but no path from the entry.
+    isolated := Accepted("package p\nF :: (b: bool) -> bool { while (b) { } return b; }\n");
+    header_branch := Terminator(isolated, 2);
+    back = Terminator(isolated, 3);
+    edges = isolated.edges;
+    edge = edges[int(header_branch.payload) - 1];
+    edge.target = 4;
+    edges[int(header_branch.payload) - 1] = edge;
+    edge = edges[int(back.payload) - 1];
+    edge.target = 3;
+    edges[int(back.payload) - 1] = edge;
+    isolated.edges = edges;
+    error = typed.Verify(isolated);
+    assert(error == typed.InvalidDominance, "unreachable self-cycle is not accepted by initialized dominance masks");
+    error = typed.Verify(original);
+    assert(error == 0, "invalid uses and edge mutations preserve their source module");
+}
+
+CheckBlockBoundaries :: () {
+    assert(typed.MaxBlocks == 64 || typed.MaxBlocks == 128, "only separately reviewed block caps are under test");
+    // One entry, three blocks per while, two per no-else conditional. These
+    // literal input/expected tables are independent of the active admission cap.
+    counts: int[] = [64, 65, 128, 129];
+    loops: int[] = [1, 0, 1, 0];
+    branches: int[] = [30, 32, 62, 64];
+    for (count, index in counts) {
+        source := strings.Concatenate([
+            "package p\nF :: (b: bool, x: i64) -> i64 {\n",
+            strings.Repeat("while (b) { x = x + 1; }\n", loops[index]),
+            strings.Repeat("if (b) { x = x + 7; }\n", branches[index]),
+            "return x; }\n"]);
+        if (count > typed.MaxBlocks) {
+            message := Rejected(source);
+            expected := format_text("vNext scalar slice exceeds {} blocks in one function", typed.MaxBlocks);
+            assert(message == expected, "exact boundary source fails only the configured block admission");
+        } else {
+            module := Accepted(source);
+            assert(length(module.blocks) == count && module.functions[0].block_count == u32(count),
+                   "exact 64/65/128 block source admission");
+            moved := ReverseBlockLayout(module);
+            error := typed.Verify(moved);
+            assert(error == 0, "boundary masks accept reversed cyclic and acyclic layouts");
+            CheckEqual(module, ReverseBlockLayout(moved));
+            // The first optional body does not dominate the final return.
+            // Reversal places this definition near the upper mask boundary.
+            changed := module;
+            instructions := changed.instructions;
+            last := length(instructions) - 1;
+            returned := instructions[last];
+            returned.left = instructions[OpcodeInstruction(module, typed.AddI64)].result;
+            instructions[last] = returned;
+            changed.instructions = instructions;
+            error = typed.Verify(changed);
+            assert(error == typed.InvalidDominance, "boundary exit cannot bypass optional-body merge values");
+            error = typed.Verify(ReverseBlockLayout(changed));
+            assert(error == typed.InvalidDominance, "upper-word non-dominator stays invalid after permutation");
+        }
+    }
+}
