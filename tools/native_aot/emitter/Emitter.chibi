package native_emitter

import facts "project:scalar_facts"
import scalar "project:scalar_llvm"
import strings "core:strings"

// `chibi build --native`'s entries over CollectScalar's rows. Both return raw
// bytes the compiler host writes unchanged: the module's IR, or why it has
// none.
pub Emit :: (rows: facts.Row[]) -> u8[] {
    if (Library(rows)) {
        none: u8[] = [];
        return none;
    }
    return scalar.EmitBytes(rows);
}

// Whether the rows are a native library's, which has no entry to link a
// program from: its Document row names the library.
Library :: (rows: facts.Row[]) -> bool {
    return rows[1].kind == facts.DocumentRow && rows[1].text != "";
}

pub Diagnose :: (rows: facts.Row[]) -> u8[] {
    message := "";
    switch scalar.Emit(rows) {
        case .Rejected(rejected):
            message = format_text("{}:{}: {}", rejected[1].line, rejected[1].column, rejected[1].text);
        case .Invalid(reason):
            message = reason;
        case .Emitted(text):
            if (Library(rows)) {
                message = "a native library has no entry; build --native links a package";
            }
    }
    bytes: u8[] = [];
    for (value in strings.Bytes(message)) {
        bytes.append(u8(value));
    }
    return bytes;
}
