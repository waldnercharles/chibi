package authored_parser

import parser "project:parser"
import raw "project:compiler_syntax"

// Every successful parse compares every public fact, not only leaf tokens.
// This oracle is confined to the parity fixture; the authored parser never
// invokes raw.Parse and has no native parse capability dependency.
pub Parity :: (text: string) -> int {
    switch parser.Parse(text) {
        case .Rejected(code, diagnostic):
            return 1;
        case .Parsed(nodes, fields, named, extra, root):
            switch raw.Parse(text) {
                case .Parsed(expected, expected_fields, expected_named, expected_extra, expected_root):
                    if (root != expected_root || length(nodes) != length(expected)) {
                        return 2;
                    }
                    index: int = 0;
                    while (index < length(nodes)) {
                        got := nodes[index];
                        want := expected[index];
                        if (got.kind != want.kind || got.start != want.start || got.end != want.end ||
                            got.row != want.row || got.column != want.column || got.parent != want.parent ||
                            got.first_child != want.first_child || got.next_sibling != want.next_sibling ||
                            got.error != want.error || got.missing != want.missing || got.has_error != want.has_error ||
                            fields[index] != expected_fields[index] || named[index] != expected_named[index] ||
                            extra[index] != expected_extra[index]) {
                            return 100 + index;
                        }
                        index += 1;
                    }
            }
    }
    return 0;
}

pub Cases :: () -> string[] {
    return [
        "package sample;",
        "package sample",
        "  package sample  \n\n",
        "// leading\npackage sample\n// trailing\n",
        "package /*between*/ sample;",
        "package sample // boundary\nimport \"core:strings\"",
        "package sample /* line\nboundary */ import s \"core:strings\"",
        "package sample\r\nimport s \"core:strings\"\r\n",
        "package sample\nimport \"core:strings\"; import x \"project:x\";",
        "package sample\nimport /* before alias */ s /* before path */ \"core:strings\";",
        "package sample\nA :: 0; B :: 12.5; C :: 1e-2; D :: 0x2f;",
        "package sample\nA :: true\nB :: false\nC :: nil\nD :: null\n",
        "package sample\npub A :: 1; pub B :: \"hi\";",
        "package sample\nA :: \"é雪\"\n// café\nB :: 2\n",
        "package sample\nA /*name*/ :: /*value*/ 1 /*tail*/;",
        "package sample\nA :: true /*tail*/;",
        "package sample\nA :: \"a\\n\\\"b\";",
        "package package\nimport from \"core:strings\";",
        "package sample\nimport :: 1; package :: 2; struct :: 3;",
        "package sample\npub import :: 1;",
        "package sample\nA :: 1 // end\nB :: 2",
        "package sample\nA :: 1 /* end\n */ B :: 2"
    ];
}

pub CheckAccepted :: () -> int {
    cases := Cases();
    index: int = 0;
    while (index < length(cases)) {
        if (Parity(cases[index]) != 0) {
            return index + 1;
        }
        index += 1;
    }
    return 0;
}

pub Rejection :: (text: string, expected_code: string, expected_start: int, expected_line: int, expected_column: int) -> bool {
    switch parser.Parse(text) {
        case .Parsed(nodes, fields, named, extra, root):
            return false;
        case .Rejected(code, diagnostic):
            return code == expected_code && diagnostic.start == expected_start &&
                diagnostic.line == expected_line && diagnostic.column == expected_column && diagnostic.message != "";
    }
}

pub CheckRejected :: () -> int {
    if (!Rejection("package", "syntax", 7, 1, 8)) { return 1; }
    if (!Rejection("package sample\nimport", "syntax", 21, 2, 7)) { return 2; }
    if (!Rejection("package sample\nimport x", "syntax", 23, 2, 9)) { return 3; }
    if (!Rejection("package sample\nA ::", "syntax", 19, 2, 5)) { return 4; }
    if (!Rejection("package sample\npub pub A :: 1", "syntax", 19, 2, 5)) { return 5; }
    if (!Rejection("package sample\nF :: () {}", "unsupported", 23, 2, 9)) { return 6; }
    if (!Rejection("package sample\nA :: 1 + 2", "unsupported", 22, 2, 8)) { return 7; }
    if (!Rejection("package sample\nA: int : 1", "unsupported", 16, 2, 2)) { return 8; }
    if (!Rejection("package sample\nA :: \"oops", "lexical", 20, 2, 6)) { return 9; }
    if (!Rejection("package sample\n/*oops", "lexical", 15, 2, 1)) { return 10; }
    if (!Rejection("package sample\nA :: \"a\u0000b\";", "input", 22, 2, 8)) { return 11; }
    if (!Rejection("package sample\nA :: \"é\u0000\";", "input", 23, 2, 9)) { return 12; }
    return 0;
}


// Every byte prefix of one fixed 65-byte source is either an explicit
// rejection or an exact raw-fact match; incomplete UTF-8 prefixes are included.
pub CheckPrefixes :: () -> int {
    text := "// é\npackage p\nimport x \"core:strings\"\npub A :: true\nB :: \"雪\"\n";
    count := text_byte_length(text);
    end: int = 0;
    while (end <= count) {
        prefix := text_slice(text, 0, end);
        switch parser.Parse(prefix) {
            case .Parsed(nodes, fields, named, extra, root):
                if (Parity(prefix) != 0) { return end + 1; }
            case .Rejected(code, diagnostic):
                if (diagnostic.start < 0 || diagnostic.end < diagnostic.start ||
                    diagnostic.end > end || diagnostic.line < 1 || diagnostic.column < 1) {
                    return end + 1;
                }
        }
        end += 1;
    }
    return 0;
}

// This slice constructs ordinary function syntax, not type or name semantics.
pub FunctionCases :: () -> string[] {
    cases: string[] = [
        "package p\nF :: () -> int { return 42; }",
        "package p\npub F :: (x: int, flag: bool,) -> int { return x } ;",
        "package p\nF :: /*a*/ (/*b*/ x /*c*/ : /*d*/ int /*e*/, /*f*/ y: bool /*g*/) /*h*/ -> /*i*/ int /*j*/ { /*k*/ return /*l*/ true /*m*/; /*n*/ } /*o*/ ; /*p*/",
        "package p\nF :: () -> int { return 1 }\nG :: () -> int { return 2; }",
        "package p\nF :: () -> int\n{ return 1; }",
        "package p\nF :: () -> int /*line\nbreak*/ { return 1; }",
        "package p\nF :: () -> int { return 1 /*end\n*/ }\n",
        "package p\nF :: () -> int { return 1; } /*outside*/\nG :: () -> int { return 2; }",
        "package p\nF :: () -> int { return 1; } /*inside*/\n; /*outside*/",
        "package p\r\n// café\r\npub Read :: () -> string { return \"é雪\"\r\n}\r\n",
        "package p\nA :: () -> bool { return true; } B :: () -> bool { return false }",
        "package p\nA :: () -> Thing { return nil; } B :: () -> Thing { return null }",
        "package p\nA :: () -> float { return 1.25; } B :: () -> int { return 0x2f }",
        "package p\nself :: () -> int { return self; }",
        "package p\nF :: () -> not { return not /*tail*/ } /*outside*/",
        "package p\nF :: () -> not { return 1; } /*inside*/ ;",
        "package p\nA :: 7; import s \"core:strings\"; pub F :: (x: int) -> int { return A; } B :: true;"
    ];
    for (name in ["package", "import", "struct", "from", "split", "component", "not", "join", "unordered"]) {
        cases.append(format_text("package p\npub {} :: ({}: {}) -> {} {{ return {} }}", name, name, name, name, name));
    }
    return cases;
}

pub CheckFunctions :: () -> int {
    cases := FunctionCases();
    index: int = 0;
    while (index < length(cases)) {
        if (Parity(cases[index]) != 0) { return index + 1; }
        index += 1;
    }
    return 0;
}

pub FunctionRejections :: () -> string[] {
    return [
        "package p\nF :: () { return 1; }",
        "package p\nF :: () -> int {}",
        "package p\nF :: () -> int { return; }",
        "package p\nF :: () -> int => { return 1; }",
        "package p\nF :: (x) -> int { return x; }",
        "package p\nF :: (x: int = 1) -> int { return x; }",
        "package p\nF :: ($x: int) -> int { return x; }",
        "package p\nF :: (x: int from source) -> int { return x; }",
        "package p\nF :: (x: ref int) -> int { return x; }",
        "package p\nF :: (x: int[]) -> int { return x; }",
        "package p\nF :: () -> lib.Int { return 1; }",
        "package p\nF :: () -> Box<int> { return 1; }",
        "package p\nF :: () -> int? { return 1; }",
        "package p\nF :: () -> int | bool { return 1; }",
        "package p\nF :: () -> (x: int) { return 1; }",
        "package p\nF :: () -> int { return 1 + 2; }",
        "package p\nF :: () -> int { return -1; }",
        "package p\nF :: () -> int { return G(); }",
        "package p\nF :: () -> int { return 1; return 2; }",
        "package p\nF :: () -> int { x := 1; return x; }",
        "package p\n@test F :: () -> int { return 1; }",
        "package p\nF :: () -> int; { return 1; }",
        "package p\nF :: () -> self { return 1; }",
        "package p\nF :: (self: int) -> int { return 1; }",
        "package p\nF :: () -> not { return 1\n; }",
        "package p\nF :: () -> not { return 1 /*line\nbreak*/; }",
        "package p\nF :: () -> int { return 1; }; ;",
        "package p\nF :: () -> int { return 1; } junk",
        "package p\nF :: (x: int,) -> int { return x;",
        "package p\nF :: () -> int { return 1; } /*tail"
    ];
}

// Rejections expose a byte position even after multibyte text; never a tree.
Position :: (text: string, start: int, end: int, line: int, column: int) -> bool {
    bytes := text_bytes(text);
    if (start < 0 || end < start || end > length(bytes)) { return false; }
    row: int = 1;
    begin: int = 0;
    at: int = 0;
    while (at < start) {
        if (bytes[at] == 10) { row += 1; begin = at + 1; }
        at += 1;
    }
    return line == row && column == start - begin + 1;
}

pub CheckFunctionRejected :: () -> int {
    cases := FunctionRejections();
    index: int = 0;
    while (index < length(cases)) {
        switch parser.Parse(cases[index]) {
            case .Parsed(nodes, fields, named, extra, root):
                return index + 1;
            case .Rejected(code, diagnostic):
                if ((code != "unsupported" && code != "syntax" && code != "lexical") ||
                    diagnostic.message == "" || !Position(cases[index], diagnostic.start, diagnostic.end,
                                                         diagnostic.line, diagnostic.column)) {
                    return index + 1;
                }
        }
        index += 1;
    }
    return 0;
}

pub CheckFunctionPrefixes :: () -> int {
    text := "// é\npackage p\npub import :: (not: bool, x: int,) -> not { return not /*雪*/ };\n";
    count := text_byte_length(text);
    end: int = 0;
    while (end <= count) {
        prefix := text_slice(text, 0, end);
        switch parser.Parse(prefix) {
            case .Parsed(nodes, fields, named, extra, root):
                if (Parity(prefix) != 0) { return end + 1; }
            case .Rejected(code, diagnostic):
                if (!Position(prefix, diagnostic.start, diagnostic.end, diagnostic.line, diagnostic.column)) {
                    return end + 1;
                }
        }
        end += 1;
    }
    return 0;
}

pub Check :: () -> int {
    accepted := CheckAccepted();
    if (accepted != 0) {
        return accepted;
    }
    rejected := CheckRejected();
    if (rejected != 0) {
        return 100 + rejected;
    }
    prefixes := CheckPrefixes();
    if (prefixes != 0) {
        return 200 + prefixes;
    }
    functions := CheckFunctions();
    if (functions != 0) { return 400 + functions; }
    unsupported := CheckFunctionRejected();
    if (unsupported != 0) { return 500 + unsupported; }
    truncated := CheckFunctionPrefixes();
    if (truncated != 0) { return 600 + truncated; }
    return 0;
}
