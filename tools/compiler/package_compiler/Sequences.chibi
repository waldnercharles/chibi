package package_compiler

import snapshot "project:source_snapshot"

SequenceSliceIntrinsic: int : 51;
SequenceViewIntrinsic: int : 52;
SequenceCloneIntrinsic: int : 53;
ArrayMutateIntrinsic: int : 54;
SequenceGetIntrinsic: int : 55;
SequenceLengthIntrinsic: int : 56;

// Ranges occur only as an index or a sequence method's argument. They never
// become runtime values. Existing slice(start, count) calls stay native calls.
SequenceOperation :: (forest: snapshot.SnapshotNode[], text: string, names: Name[], package: int, node: int) -> int {
    if (Is(forest, node, "index_expression") && Is(forest, Field(forest, node, "index"), "range_expression")) {
        return 0;
    }
    if (!Is(forest, node, "call_expression")) {
        return -1;
    }
    callee := Field(forest, node, "function");
    if (!Is(forest, callee, "member_expression") ||
        QualifierOf(forest, text, names, package, Field(forest, callee, "object")) >= 0) {
        return -1;
    }
    member := Text(forest, text, Field(forest, callee, "member"));
    argument := FirstMember(forest, Field(forest, node, "arguments"));
    if (member == "clone" && argument < 0) {
        return 2;
    }
    if (member == "length" && argument < 0) {
        return 3;
    }
    if (member == "view") {
        return 1;
    }
    if (member == "slice" && Is(forest, argument, "range_expression")) {
        return 0;
    }
    return -1;
}

// Emits one intrinsic call with typed cells. A literal tag, when present,
// follows the evaluated arguments. No argument is copied implicitly.
SequenceCallStep :: (arguments: Value[], intrinsic: int, result: Value, tag: uint64, tagged: bool,
                     popped: int, ops: Ops, target: Target, at: Bases, node: snapshot.SnapshotNode) -> Step {
    code: Code[] = [];
    slots: Slot[] = [];
    cells: Cell[] = [];
    roots: Root[] = [];
    index: int = 0;
    for (argument in arguments) {
        cells.append(MovedCell(argument));
        slots.append(AddressSlot(target));
        code.append(Instruction(ops.host_slot, target.pointer_storage, at.slot + index, at.cell + index, 0, 0, node));
        write := Instruction(ops.write, SlotStorage(argument.storage, argument.container, target), 0,
                             argument.slot, at.slot + index, 0, node);
        write.offset = target.payload_offset;
        code.append(write);
        index += 1;
    }
    if (tagged) {
        cells.append({storage: WordStorage, container: 0, record: -1, constant: tag, variant: -1, kind: ValueKind});
    }
    output := at.cell + length(cells);
    cells.append(MovedCell(result));
    hosts: Host[] = [{intrinsic: intrinsic, linked: -1, first: at.cell, result_first: output,
                     result_count: 1, written: false}];
    code.append(Instruction(ops.host_call, 0, 0, target.data_failure, 0, at.host, node));
    slots.append(AddressSlot(target));
    address := at.slot + length(slots) - 1;
    code.append(Instruction(ops.host_slot, target.pointer_storage, address, output, 0, 0, node));
    slots.append({storage: SlotStorage(result.storage, result.container, target),
                  kind: SlotKind(result.storage, result.container)});
    result.slot = at.slot + length(slots) - 1;
    read := Instruction(ops.load, SlotStorage(result.storage, result.container, target), result.slot, address, 0, 0, node);
    read.offset = target.payload_offset;
    code.append(read);
    if (Pointer(result.storage, result.container)) {
        roots.append({slot: result.slot, storage: result.storage, container: result.container, record: result.record});
    }
    return Step.Emitted(code, slots, [], cells, hosts, roots, [], [], [], popped, result, NoValue(), []);
}

SequenceStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, types: TypeDecl[],
                 values: Value[], top: int, item: Work, ops: Ops, target: Target, at: Bases) -> Step {
    node := forest[item.node];
    index := node.kind == "index_expression";
    receiver := Field(forest, item.node, "object");
    range := Field(forest, item.node, "index");
    operation: int = 0;
    if (!index) {
        callee := Field(forest, item.node, "function");
        receiver = Field(forest, callee, "object");
        range = FirstMember(forest, Field(forest, item.node, "arguments"));
        member := Text(forest, text, Field(forest, callee, "member"));
        if (member == "view") {
            operation = 1;
        } else if (member == "clone") {
            operation = 2;
        } else if (member == "length") {
            operation = 3;
        }
    }
    count: int = 1;
    ranged := operation == 0 || operation == 1;
    if (ranged) {
        count = 3;
        if (!Is(forest, range, "range_expression") || (!index && NextMember(forest, range) >= 0)) {
            return Fail(forest, item.node, document, "sequence slice or view needs one half-open range");
        }
    }
    if (item.phase == 0) {
        next: Work[] = [Visit(receiver)];
        if (ranged) {
            next.append(Expect(Field(forest, range, "start"), IntStorage, 0, -1));
            next.append(Expect(Field(forest, range, "end"), IntStorage, 0, -1));
        }
        next.append(Resume(item.node, 1, 0, 0));
        return Step.Emitted([], [], [], [], [], [], [], [], next, 0, NoValue(), NoValue(), []);
    }
    object := values[top - count];
    if (object.container != ArrayContainer && object.container != ViewContainer && !Single(object, TextStorage)) {
        return Fail(forest, receiver, document, "slice, view and clone need a string or array");
    }
    if (operation == 3) {
        return SequenceCallStep([object], SequenceLengthIntrinsic, Typed(-1, IntStorage, 0, -1),
                                uint64(0), false, 1, ops, target, at, node);
    }
    element: ValueType = {storage: object.storage, container: object.container, record: object.record};
    if (element.container != 0) {
        element.container = ArrayContainer;
        if (operation == 1) {
            element.container = ViewContainer;
        }
    }
    result := Typed(-1, element.storage, element.container, element.record);
    intrinsic := SequenceCloneIntrinsic;
    if (ranged) {
        if (!Single(values[top - 2], IntStorage) || !Single(values[top - 1], IntStorage)) {
            return Fail(forest, range, document, "range bounds need int values");
        }
        optional := EnsureOptional(types, element, 0);
        result = Typed(-1, UnionStorage, 0, optional);
        intrinsic = SequenceSliceIntrinsic;
        if (operation == 1) {
            intrinsic = SequenceViewIntrinsic;
        }
    }
    return SequenceCallStep(slice(values, top - count, count), intrinsic, result, OptionalTag(types, element),
                            ranged, count, ops, target, at, node);
}

ArrayMutation :: (forest: snapshot.SnapshotNode[], text: string, names: Name[], natives: Native[],
                  ports: Port[], package: int, node: int) -> int {
    if (!Is(forest, node, "call_expression")) {
        return 0;
    }
    callee := Field(forest, node, "function");
    if (!Is(forest, callee, "member_expression") ||
        QualifierOf(forest, text, names, package, Field(forest, callee, "object")) >= 0) {
        return 0;
    }
    method := Text(forest, text, Field(forest, callee, "member"));
    native := ArrayMethod(natives, ports, method);
    if (native < 0 || !ArrayChanger(natives, native)) {
        return 0;
    }
    changers: string[] = ["append", "add_unique", "extend", "set_array_elem", "insert", "remove_index",
                          "remove_item", "clear", "reverse", "swap", "resize"];
    operation: int = 1;
    for (changer in changers) {
        if (NameMatches(method, changer)) {
            return operation;
        }
        operation += 1;
    }
    return 0;
}

MutationStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, types: TypeDecl[], members: TypeMember[],
                 values: Value[], top: int, item: Work, operation: int, ops: Ops, target: Target, at: Bases) -> Step {
    node := forest[item.node];
    receiver := Field(forest, Field(forest, item.node, "function"), "object");
    first := FirstMember(forest, Field(forest, item.node, "arguments"));
    if (item.phase == 0) {
        return Step.Emitted([], [], [], [], [], [], [], [],
                            [Visit(receiver), Resume(item.node, 1, 0, 0)], 0, NoValue(), NoValue(), []);
    }
    if (item.phase == 1) {
        object := values[top - 1];
        if (object.container != ArrayContainer && object.container != ViewContainer) {
            return Fail(forest, receiver, document, "mutating method needs an array or view");
        }
        if (object.container == ViewContainer && operation != 4 && operation != 9 && operation != 10) {
            return Fail(forest, item.node, document, "a view has fixed length");
        }
        next: Work[] = [];
        argument := first;
        count: int = 0;
        element := SequenceElement(types, {storage: object.storage, container: object.container, record: object.record});
        if (operation == 11 && NeedsPointerValue(types, members, element.storage, element.container, element.record)) {
            return Fail(forest, item.node, document, "resize cannot create missing initialized values");
        }
        while (argument >= 0) {
            storage := element.storage;
            container := element.container;
            record := element.record;
            if (operation == 3) {
                storage = object.storage;
                container = ArrayContainer;
                record = object.record;
            } else if (operation == 6 || operation == 10 || operation == 11 ||
                       ((operation == 4 || operation == 5) && count == 0)) {
                storage = IntStorage;
                record = -1;
            }
            next.append(Expect(argument, storage, container, record));
            count += 1;
            argument = NextMember(forest, argument);
        }
        expected: int = 1;
        if (operation == 4 || operation == 5 || operation == 10) {
            expected = 2;
        } else if (operation == 8 || operation == 9) {
            expected = 0;
        }
        if (count != expected) {
            return Fail(forest, item.node, document, "mutating method has the wrong number of arguments");
        }
        next.append(Resume(item.node, 2, count, 0));
        return Step.Emitted([], [], [], [], [], [], [], [], next, 0, NoValue(), NoValue(), []);
    }
    count := item.a + 1;
    arguments := slice(values, top - count, count);
    object := arguments[0];
    element := SequenceElement(types, {storage: object.storage, container: object.container, record: object.record});
    index: int = 1;
    while (index < count) {
        expected := Typed(-1, element.storage, element.container, element.record);
        if (operation == 3) {
            expected = Typed(-1, object.storage, ArrayContainer, object.record);
        } else if (operation == 6 || operation == 10 || operation == 11 ||
                   ((operation == 4 || operation == 5) && index == 1)) {
            expected = Typed(-1, IntStorage, 0, -1);
        }
        if (!Accepts(types, expected.storage, expected.container, expected.record, arguments[index])) {
            return Fail(forest, item.node, document, "argument differs from the mutating method's parameter type");
        }
        index += 1;
    }
    // Runtime accepts the operation as its second, int-typed argument.
    operation_slot := at.slot;
    operation_code := ConstantCode(ops, IntStorage, uint64(operation), operation_slot, node);
    operation_value := Typed(operation_slot, IntStorage, 0, -1);
    arguments = insert(arguments, 1, operation_value);
    shifted: Bases = {pc: at.pc + 1, slot: at.slot + 1, local: at.local, cell: at.cell, host: at.host, call: at.call};
    switch SequenceCallStep(arguments, ArrayMutateIntrinsic, Typed(-1, BoolStorage, 0, -1), uint64(0), false,
                            count, ops, target, shifted, node) {
        case .Failed(diagnostic):
            return Step.Failed(diagnostic);
        case .Emitted(code, slots, locals, cells, hosts, roots, calls, names, next, popped, result, retained, marks):
            return Step.Emitted(extend([operation_code], code), extend([ValueLocal(IntStorage)], slots),
                                locals, cells, hosts, roots, calls, names, next, popped, result, retained, marks);
    }
}

ArrayElementAssignment :: (forest: snapshot.SnapshotNode[], text: string, names: Name[], node: int) -> bool {
    if (!Is(forest, node, "assignment") || !Is(forest, Field(forest, node, "target"), "index_expression")) {
        return false;
    }
    object := Field(forest, Field(forest, node, "target"), "object");
    if (Is(forest, object, "identifier")) {
        named := Lookup(names, Text(forest, text, object));
        if (named >= 0 && names[named].container == MapContainer) { return false; }
    }
    return true;
}

SequenceBoundsStep :: (object: Value, index: Value, ops: Ops, target: Target, at: Bases,
                       node: snapshot.SnapshotNode) -> Step {
    switch SequenceCallStep([object], SequenceLengthIntrinsic, Typed(-1, IntStorage, 0, -1),
                            uint64(0), false, 0, ops, target, at, node) {
        case .Failed(diagnostic): return Step.Failed(diagnostic);
        case .Emitted(code, slots, locals, cells, hosts, roots, calls, names, next, popped, result, retained, marks):
            zero := at.slot + length(slots);
            slots.extend([ValueLocal(IntStorage), ValueLocal(BoolStorage), ValueLocal(BoolStorage)]);
            code.append(ConstantCode(ops, IntStorage, 0, zero, node));
            code.append(Instruction(ops.ge, IntStorage, zero + 1, index.slot, zero, -1, node));
            code.append(Instruction(ops.guard, 0, 0, zero + 1, 0, target.argument_failure, node));
            code.append(Instruction(ops.lt, IntStorage, zero + 2, index.slot, result.slot, -1, node));
            code.append(Instruction(ops.guard, 0, 0, zero + 2, 0, target.argument_failure, node));
            return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, names, next,
                                0, NoValue(), NoValue(), marks);
    }
}

// Keep the receiver and logical index across evaluation of the right side.
// Compound assignment loads its old value before evaluating that side.
ElementAssignStep :: (forest: snapshot.SnapshotNode[], text: string, document: int, types: TypeDecl[],
                      values: Value[], top: int, item: Work, ops: Ops, target: Target, at: Bases) -> Step {
    node := forest[item.node];
    destination := Field(forest, item.node, "target");
    receiver := Field(forest, destination, "object");
    operator := CompoundOperator(Text(forest, text, Field(forest, item.node, "operator")));
    compound := operator != "";
    if (item.phase == 0) {
        return Step.Emitted([], [], [], [], [], [], [], [],
                            [Visit(receiver), Expect(Field(forest, destination, "index"), IntStorage, 0, -1),
                             Resume(item.node, 1, 0, 0)], 0, NoValue(), NoValue(), []);
    }
    if (item.phase == 1) {
        object := values[top - 2];
        index := values[top - 1];
        if ((object.container != ArrayContainer && object.container != ViewContainer) || !Single(index, IntStorage)) {
            return Fail(forest, destination, document, "element assignment needs an array and int index");
        }
        element := SequenceElement(types, {storage: object.storage, container: object.container, record: object.record});
        next: Work[] = [Expect(Field(forest, item.node, "value"), element.storage, element.container, element.record),
                        Resume(item.node, 2, 0, 0)];
        checked := SequenceBoundsStep(object, index, ops, target, at, node);
        if (compound) {
            checked = SequenceCallStep([object, index], SequenceGetIntrinsic,
                                    Typed(-1, element.storage, element.container, element.record),
                                    uint64(0), false, 0, ops, target, at, node);
        }
        switch checked {
                case .Failed(diagnostic): return Step.Failed(diagnostic);
                case .Emitted(code, slots, locals, cells, hosts, roots, calls, bound, scheduled,
                              popped, result, retained, marks):
                    return Step.Emitted(code, slots, locals, cells, hosts, roots, calls, bound,
                                        next, 0, result, NoValue(), marks);
        }
    }
    count: int = 3;
    if (compound) { count = 4; }
    object := values[top - count];
    index := values[top - count + 1];
    value := values[top - 1];
    element := SequenceElement(types, {storage: object.storage, container: object.container, record: object.record});
    if (!Accepts(types, element.storage, element.container, element.record, value)) {
        return Fail(forest, destination, document, "array item differs from the array's type");
    }
    code: Code[] = [];
    slots: Slot[] = [];
    if (compound) {
        before := values[top - 2];
        operation := BinaryOp(ops, operator);
        if (!Numeric(element.storage) || element.container != 0 || !Computes(ops, operation, element.storage)) {
            return Fail(forest, destination, document, "compound element assignment needs numeric operands");
        }
        slots.append(ValueLocal(element.storage));
        code.append(Instruction(operation, element.storage, at.slot, before.slot, value.slot, -1, node));
        value.slot = at.slot;
    }
    operation_slot := at.slot + length(slots);
    slots.append(ValueLocal(IntStorage));
    code.append(ConstantCode(ops, IntStorage, uint64(4), operation_slot, node));
    checked_cells: Cell[] = [];
    checked_hosts: Host[] = [];
    checked_roots: Root[] = [];
    check_at: Bases = {pc: at.pc + length(code), slot: at.slot + length(slots), local: at.local,
                       cell: at.cell, host: at.host, call: at.call};
    // A right-side call can shrink the same root. Recheck against its current
    // length before writing; method-form set_array_elem has a different
    // out-of-range contract and cannot supply this check itself.
    switch SequenceBoundsStep(object, index, ops, target, check_at, node) {
        case .Failed(diagnostic): return Step.Failed(diagnostic);
        case .Emitted(added_code, added_slots, locals, cells, hosts, roots, calls, names, next,
                      popped, result, retained, marks):
            code.extend(added_code);
            slots.extend(added_slots);
            checked_cells = cells;
            checked_hosts = hosts;
            checked_roots = roots;
    }
    shifted: Bases = {pc: at.pc + length(code), slot: at.slot + length(slots), local: at.local,
                      cell: at.cell + length(checked_cells), host: at.host + length(checked_hosts), call: at.call};
    switch SequenceCallStep([object, Typed(operation_slot, IntStorage, 0, -1), index, value], ArrayMutateIntrinsic,
                            Typed(-1, BoolStorage, 0, -1), uint64(0), false, count, ops, target, shifted, node) {
        case .Failed(diagnostic): return Step.Failed(diagnostic);
        case .Emitted(added_code, added_slots, locals, cells, hosts, roots, calls, names, next,
                      popped, result, retained, marks):
            return Step.Emitted(extend(code, added_code), extend(slots, added_slots), locals,
                                extend(checked_cells, cells), extend(checked_hosts, hosts),
                                extend(checked_roots, roots), calls, names, next, popped, NoValue(), NoValue(), marks);
    }
}
