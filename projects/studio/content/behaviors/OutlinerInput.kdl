version 3
name "OutlinerInput"
id_counter 109
description "Turns the Outliner's row events into editor actions: a click selects (Mod toggles, Shift extends), a right click keeps a selection it lands in and opens the row menu at the pointer, the eye hides or with Alt isolates, the lock locks, drops attach or assign on a row and place prototypes on the list, and the menu's Break When Spawned toggles."
owner_type "ecs.entity"
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 1
                type "Event"
                reference_name "RowClicked"
                outputs {
                    Key id=3 declaration_id=1 type="const char *" kind="data"
                    Shift id=4 declaration_id=2 type="bool" kind="data"
                    Mod id=5 declaration_id=3 type="bool" kind="data"
                }
            }
            - id=6 type="Select Object"
            - {
                id 12
                type "Event"
                reference_name "RowMenu"
                comment "A right click keeps a selection it lands in (Unity), then opens the row menu at the pointer."
                outputs {
                    Key id=14 declaration_id=1 type="const char *" kind="data"
                    Pointer id=15 declaration_id=2 type="struct" type_name="CF_V2" kind="data"
                }
            }
            - id=16 type="Object Selected"
            - id=19 type="Branch"
            - id=24 type="Select Object"
            - {
                id 30
                type "Show UI Popover"
                inputs Element="#outliner-menu"
            }
            - {
                id 36
                type "Event"
                reference_name "EyeClicked"
                outputs {
                    Key id=38 declaration_id=1 type="const char *" kind="data"
                    Hidden id=39 declaration_id=2 type="bool" kind="data"
                    Alt id=40 declaration_id=3 type="bool" kind="data"
                }
            }
            - id=41 type="Branch"
            - id=46 type="Isolate Object"
            - id=50 type="Not"
            - id=53 type="Set Object Hidden"
            - {
                id 58
                type "Event"
                reference_name "LockClicked"
                outputs {
                    Key id=60 declaration_id=1 type="const char *" kind="data"
                    Locked id=61 declaration_id=2 type="bool" kind="data"
                }
            }
            - id=62 type="Not"
            - id=65 type="Set Object Locked"
            - {
                id 70
                type "Event"
                reference_name "RowDropped"
                outputs {
                    Key id=72 declaration_id=1 type="const char *" kind="data"
                    Type id=73 declaration_id=2 type="const char *" kind="data"
                    Payload id=74 declaration_id=3 type="const char *" kind="data"
                }
            }
            - id=75 type="Drop on Object"
            - {
                id 81
                type "Event"
                reference_name "ListDropped"
                comment "A row's drop stops at the row (RowDropped), so the list takes only prototypes."
                outputs {
                    Type id=83 declaration_id=1 type="const char *" kind="data"
                    Payload id=84 declaration_id=2 type="const char *" kind="data"
                }
            }
            - {
                id 85
                type "Text Equal"
                inputs B="prototype"
            }
            - id=89 type="Branch"
            - id=94 type="Add Object"
            - id=98 type="Event" reference_name="SpawnBreak"
            - id=100 type="Selection"
            - id=105 type="Toggle Spawn Break"
        }
        (array)edges {
            - from="1.Then" to="6.Exec"
            - from="1.Key" to="6.Object"
            - from="1.Shift" to="6.Extend"
            - from="1.Mod" to="6.Toggle"
            - from="12.Then" to="19.Exec"
            - from="12.Key" to="16.Object"
            - from="12.Key" to="24.Object"
            - from="12.Pointer" to="30.At"
            - from="16.Selected" to="19.Condition"
            - from="19.True" to="30.Exec"
            - from="19.False" to="24.Exec"
            - from="24.Then" to="30.Exec"
            - from="36.Then" to="41.Exec"
            - from="36.Key" to="46.Object"
            - from="36.Key" to="53.Object"
            - from="36.Hidden" to="50.Value"
            - from="36.Alt" to="41.Condition"
            - from="41.True" to="46.Exec"
            - from="41.False" to="53.Exec"
            - from="50.Result" to="53.Hidden"
            - from="58.Then" to="65.Exec"
            - from="58.Key" to="65.Object"
            - from="58.Locked" to="62.Value"
            - from="62.Result" to="65.Locked"
            - from="70.Then" to="75.Exec"
            - from="70.Key" to="75.Object"
            - from="70.Type" to="75.Type"
            - from="70.Payload" to="75.Payload"
            - from="81.Then" to="89.Exec"
            - from="81.Type" to="85.A"
            - from="81.Payload" to="94.Prototype"
            - from="85.Result" to="89.Condition"
            - from="89.True" to="94.Exec"
            - from="98.Then" to="105.Exec"
            - from="100.Prototype" to="105.Prototype"
        }
    }
}
