HealthBehavior :: behavior {

    macro HealthChanged(Current: double, RemainingHealth: double) -> () {
        exit True;
        exit False;
        if (Current > RemainingHealth) {
            goto True;
        } else {
            goto False;
        }
    }
    on Damage as damage(Amount: int = 0, Source: handle<ecs.entity> = 0) {
        if (convert<To_Real>(damage.Amount) > 0) {
            await Apply_Damage(Current: self.Health.current, Maximum: self.Health.maximum, Amount: damage.Amount, Source: damage.Source);
        } else {
        }
    }
    on Died as died(Source: handle<ecs.entity> = 0) {
        if (double(self.Health.current) <= 0) {
            await Notify_Encounter();
            destroy_entity(Entity: self);
        } else {
        }
    }
    Apply_Damage :: (Current: int = 0, Maximum: int = 0, Amount: int = 0, Source: handle<ecs.entity> = 0) -> () {

        action current_remaininghealth = HealthChanged(Current: plain double = convert<To_Real>(entry.Current), RemainingHealth: plain double = double(clamp(convert<To_Real>(entry.Current) - clamp(convert<To_Real>(entry.Amount), 0, convert<To_Real>(entry.Current)), 0, convert<To_Real>(entry.Maximum))));
        after entry {
            if (convert<To_Real>(entry.Current) > 0) {
                if (self.Dash != nil) {
                    if (double(self.Dash.remaining) > 0) {
                        return ();
                    } else {
                        current_remaininghealth();
                    }
                } else {
                    current_remaininghealth();
                }
            } else {
                return ();
            }
        }
        after current_remaininghealth.True {
            Current := entry.Current
            RemainingHealth := double(clamp(convert<To_Real>(Current) - clamp(convert<To_Real>(entry.Amount), 0, convert<To_Real>(Current)), 0, convert<To_Real>(entry.Maximum)))
            self.Health.current = convert<To_Integer>(RemainingHealth);
            await send_event<Damaged>(Entity: self, Amount: int = subtract(A: int = Current, B: int = convert<To_Integer>(RemainingHealth)), Source: entry.Source);
            if (double(clamp(convert<To_Real>(Current) - clamp(convert<To_Real>(entry.Amount), 0, convert<To_Real>(Current)), 0, convert<To_Real>(entry.Maximum))) <= 0) {
                await send_event<Died>(Entity: self, Source: entry.Source);
                return ();
            } else {
                return ();
            }
        }
        after current_remaininghealth.False {
            return ();
        }
    }
    Notify_Encounter :: () -> () {

        after entry {
            if (self.EncounterMember != nil) {
                for (foreach_2 in find_entities_with_component(Component: Encounter)) {
                    send_event<RefreshEncounter>(Entity: foreach_2);
                }
                return ();
            } else {
                return ();
            }
        }
    }
}
