behavior "WaveBehavior" {
    state CountLimit: int = 8
    state Interval: float = 1.5
    state SpawnDistance: float = 260.0
    state Elapsed: float = 0.0
    state Spawned: int = 0
    state Side: float = -1.0
    on Tick {
        if find_nearest_entity(self.Transform, 1000000.0, 1, engine["Self"]()).Found {
            state."Elapsed" = state."Elapsed" + delta_time()
            await "Spawn Within Wave Limit"(find_nearest_entity(self.Transform, 1000000.0, 1, engine["Self"]()).Position)
        }
    }
    function "Spawn Within Wave Limit"("Player Position": struct<"CF_V2"> = null) {
        after entry {
            while state."Elapsed" >= max(state."Interval", B: float = 0.01) {
                if state."Spawned" >= state."CountLimit" {
                    return
                } else {
                    state."Elapsed" = state."Elapsed" - max(state."Interval", B: float = 0.01)
                    await "Spawn Enemy"(entry."Player Position")
                    state."Spawned" = add(state."Spawned", B: int = 1)
                    state."Side" = state."Side" * -1.0
                }
            }
            return
        }
    }
    function "Spawn Enemy"("Player Position": struct<"CF_V2"> = null) {
        action spawn_prototype = engine["Spawn Prototype"]("Enemy")
        after entry {
            spawn_prototype()
        }
        after spawn_prototype {
            spawn_prototype.Entity.Transform = make_game_transform(entry."Player Position".x + state."Side" * state."SpawnDistance", entry."Player Position".y)
            return
        }
    }
}
