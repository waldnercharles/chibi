version 3
name "FreeMotion"
id_counter 120
owner_type "ecs.entity"
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 1
                type "Event"
                reference_name "Tick"
                outputs {
                    DeltaSeconds id=3 type="float" kind="data"
                }
            }
            - id=4 type="Get_GameTransform"
            - id=6 type="Get_GameVelocity"
            - {
                id 25
                type "Behavior Expression"
                reference_name "position + velocity * dt"
                inputs {
                    position id=26 type="struct" type_name="GameTransform"
                    velocity id=27 type="struct" type_name="GameVelocity"
                    dt id=28 type="float"
                }
                outputs {
                    Result id=29 type="struct" type_name="GameTransform"
                }
            }
            - id=81 type="Set_GameTransform"
        }
        (array)edges {
            - from="1.Then" to="81.Exec"
            - from="1.DeltaSeconds" to="25.dt"
            - from="4.Value" to="25.position"
            - from="6.Value" to="25.velocity"
            - from="25.Result" to="81.Value"
        }
    }
    - id=8 kind="function" math_expression="position + velocity * dt" entry_id=104
}
query {
    op "all"
    (array)terms {
        - op="has" component="GAME.GameTransform"
        - op="has" component="GAME.GameVelocity"
        - op="has" component="GAME.GameAppearance"
        - {
            op "not"
            (array)terms {
                - op="has" component="GAME.GameCollider"
            }
        }
        - {
            op "not"
            (array)terms {
                - op="has" component="GAME.GameBody"
            }
        }
    }
}
