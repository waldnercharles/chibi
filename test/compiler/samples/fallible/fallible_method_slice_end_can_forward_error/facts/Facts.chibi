package facts
@error Failure :: struct { code: int; }
Read :: () -> (value: int, error: Failure?) { return(7, {code: 3}); }
Bound :: (error: Failure?) -> int { if error { return 1; } return 0; }
Use :: () -> int { values: int[] = [10, 20, 30, 40]; selected := values.slice(0..<Bound(Read().error)); if selected { return selected[0] * 10 + selected.length(); } return -1; }
