package foreign_element_width
foreign { chibi_value_test_allocations :: () -> i64; chibi_value_test_owner_calls :: () -> i64 }
foreign import libc "system:c"
foreign libc { memset :: (data:u8[],value:i32,count:u64) -> rawptr }
Wide :: struct {
    values: u8[];
    s0: int[];
    s1: int[];
    s2: int[];
    s3: int[];
    s4: int[];
    s5: int[];
    s6: int[];
    s7: int[];
    s8: int[];
    s9: int[];
