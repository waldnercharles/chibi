package llvm_native_calls

import native "project:llvm_native"
import abi "project:native_abi"
import strings "core:strings"

// Main returns the length of "abcd" with one byte dropped and two taken,
// plus that slice's byte 1: 2 + 'c'.
TextReads :: () -> native.Instruction[] {
    return [Code(native.Check, 0, 0, 0, 0, 0, 0),
            Code(native.Constant, 13, 0, 0, 0, 0, 0),
            Code(native.Constant, 6, 1, 0, 0, 0, 1),
            Code(native.TextDrop, 13, 2, 0, 1, 0, 0),
            Code(native.Constant, 6, 3, 0, 0, 0, 2),
            Code(native.TextTake, 13, 4, 2, 3, 0, 0),
            Code(native.TextLength, 6, 5, 4, 0, 0, 0),
            Code(native.TextByte, 6, 6, 4, 1, 0, 0),
            Code(native.Add, 6, 7, 5, 6, 0, 0),
            Code(native.Publish, 6, 0, 7, 0, 0, 0),
            Code(native.Return, 0, 0, 0, 0, 0, 0)];
}
TextReadModule :: (code: native.Instruction[]) -> native.Result {
    empty: int[] = [];
    records: native.Record[] = [];
    names: string[] = [];
    source: native.Source = {file: "", directory: ""};
    return native.Emit(abi.LinuxX64(), [Function(6, 0, 0, 8, 0, 11, 0, 0)], empty,
                       [13, 6, 13, 6, 13, 6, 6, 6], empty, code, empty, records, empty,
                       ["abcd"], source, names, empty, empty, false, 1);
}
TextReadMismatch :: () -> string { return "native text read differs from its operands"; }
ChangedTextRead :: (row: int, item: native.Instruction) {
    code := TextReads();
    code[row] = item;
    Rejects(TextReadModule(code), TextReadMismatch());
}
// Length is the second field. Byte reads stay below it, and slices clamp
// their count so neither a read nor a pointer passes the string's bytes.
@test
TextReadsKeepBoundsAndSliceViews :: () {
    text := Emitted(TextReadModule(TextReads()));
    assert(strings.Contains(text, "%length6 = extractvalue { ptr, i32, ptr } %a6, 1\n"));
    assert(strings.Contains(text, "%inside7 = icmp ult i32 %b7, %length7\n  br i1 %inside7, label %read7, label %byte7\n"));
    assert(strings.Contains(text, "%at7 = getelementptr inbounds i8, ptr %bytes7, i64 %offset7\n"));
    assert(strings.Contains(text, "byte7:\n  %v7 = phi i32 [ %wide7, %read7 ], [ -1, %p7 ]\n"));
    assert(strings.Contains(text, "%over5 = icmp ugt i32 %low5, %length5\n  %n5 = select i1 %over5, i32 %length5, i32 %low5\n"));
    assert(strings.Contains(text, "%v5 = insertvalue { ptr, i32, ptr } %a5, i32 %n5, 1\n"));
    assert(strings.Contains(text, "%start3 = getelementptr inbounds i8, ptr %bytes3, i64 %offset3\n"));
    assert(strings.Contains(text, "%rest3 = sub i32 %length3, %n3\n"));
    assert(strings.Contains(text, "%v3 = insertvalue { ptr, i32, ptr } %moved3, i32 %rest3, 1\n"));
}
@test
TextByteRejectsStringIndex :: () {
    ChangedTextRead(7, Code(native.TextByte, 6, 6, 4, 0, 0, 0));
}
@test
TextLengthRejectsIntOperand :: () {
    ChangedTextRead(6, Code(native.TextLength, 6, 5, 1, 0, 0, 0));
}
@test
TextDropRejectsIntOperand :: () {
    ChangedTextRead(3, Code(native.TextDrop, 13, 2, 1, 1, 0, 0));
}
@test
TextTakeRejectsStringCount :: () {
    ChangedTextRead(5, Code(native.TextTake, 13, 4, 2, 2, 0, 0));
}
@test
TextLengthRejectsStringResult :: () {
    ChangedTextRead(5, Code(native.TextLength, 13, 4, 2, 3, 0, 0));
}
@test
TextDropRejectsIntResult :: () {
    ChangedTextRead(7, Code(native.TextDrop, 6, 6, 4, 1, 0, 0));
}
@test
UnsupportedTextReadInstructionIsRejected :: () {
    code := TextReads();
    code[7] = Code(native.InstructionCount, 6, 6, 4, 1, 0, 0);
    Rejects(TextReadModule(code), "unsupported native scalar instruction");
}
