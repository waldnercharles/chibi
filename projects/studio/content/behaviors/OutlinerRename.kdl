version 3
name "OutlinerRename"
id_counter 73
description "Renames an object in its Outliner row: a committed name renames it as one Undo step and closes the field; Escape closes it first, so nothing commits; Enter and Escape return the keyboard to the list; a field left without a commit closes at the refresh after its events."
owner_type "ecs.entity"
(array)variables {
    - id=1 name="Left" type="const char *" category="Rename"
}
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 2
                type "Event"
                reference_name "RenameCommitted"
                outputs {
                    Key id=4 declaration_id=1 type="const char *" kind="data"
                    Name id=5 declaration_id=2 type="const char *" kind="data"
                }
            }
            - id=6 type="Renaming Object"
            - id=8 type="Text Equal"
            - id=12 type="Branch"
            - id=17 type="Rename Object"
            - id=22 type="End Rename"
            - id=25 type="Event" reference_name="RenameCancel"
            - id=27 type="End Rename"
            - {
                id 30
                type "Focus UI Element"
                inputs Element="#outliner-list"
            }
            - id=35 type="Event" reference_name="RenameEnter"
            - {
                id 37
                type "Focus UI Element"
                inputs Element="#outliner-list"
            }
            - {
                id 42
                type "Event"
                reference_name "RenameLeft"
                outputs {
                    Key id=44 declaration_id=1 type="const char *" kind="data"
                }
            }
            - {
                id 45
                type "Set Variable"
                reference_name "Left"
                inputs {
                    Value type="const char *"
                }
                outputs {
                    Value type="const char *"
                }
            }
            - id=50 type="Event" reference_name="Refresh"
            - {
                id 52
                type "Get Variable"
                reference_name "Left"
                outputs {
                    Value type="const char *"
                }
            }
            - id=54 type="Renaming Object"
            - id=56 type="Text Equal"
            - id=60 type="Branch"
            - id=65 type="End Rename"
            - {
                id 68
                type "Set Variable"
                reference_name "Left"
                inputs {
                    Value type="const char *"
                }
                outputs {
                    Value type="const char *"
                }
            }
        }
        (array)edges {
            - from="2.Then" to="12.Exec"
            - from="2.Key" to="8.B"
            - from="2.Key" to="17.Object"
            - from="2.Name" to="17.Name"
            - from="6.Object" to="8.A"
            - from="8.Result" to="12.Condition"
            - from="12.True" to="17.Exec"
            - from="17.Then" to="22.Exec"
            - from="25.Then" to="27.Exec"
            - from="27.Then" to="30.Exec"
            - from="35.Then" to="37.Exec"
            - from="42.Then" to="45.Exec"
            - from="42.Key" to="45.Value"
            - from="50.Then" to="60.Exec"
            - from="52.Value" to="56.A"
            - from="54.Object" to="56.B"
            - from="56.Result" to="60.Condition"
            - from="60.True" to="65.Exec"
            - from="60.False" to="68.Exec"
            - from="65.Then" to="68.Exec"
        }
    }
}
