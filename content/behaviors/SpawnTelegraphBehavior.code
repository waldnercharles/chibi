behavior "SpawnTelegraphBehavior" {
    owner "ecs.entity";
    state Remaining: float = 0.0;
    state Dispatched: bool = false;
    value max: double = max(A: plain double = &component("GAME.GameSpawnRequest", "delay"), B: plain double = 0.05);
    value remaining_dt: double = (cast<double>(&state.Remaining) - cast<double>(&delta));
    value sin_remaining_10: double = (sin(cast<double>(&state.Remaining) * 10));
    value _0_8_0_2_wave_wave: double = (0.8 + 0.2 * (sin_remaining_10 * sin_remaining_10));
    on Begin as begin() {
        set_variable<"Remaining">(Value: float = max);
    }
    on Tick as tick() {
        if (&state.Dispatched) {
        } else {
            await set_variable<"Remaining">(Value: float = remaining_dt);
            if (cast<double>(&state.Remaining) <= 0) {
                await set_variable<"Dispatched">(Value: bool = true);
                await "Arrive At Marker"(Prototype: &component("GAME.GameSpawnRequest", "prototype"), Position: &component("GAME.GameTransform"));
                destroy_entity(Entity: self);
            } else {
                set_game_visual_transform_scale(Value: _0_8_0_2_wave_wave, Target: 0);
            }
        }
    }
    function "Arrive At Marker"(Prototype: name = "", Position: struct<"GameTransform"> = null) -> () {
        depth_limit 64;
        action spawn_prototype = engine["Spawn Prototype"](Prototype: entry.Prototype);
        after entry {
            spawn_prototype();
        }
        after spawn_prototype {
            await set_entity_game_transform(Entity: spawn_prototype.Entity, Value: entry.Position);
            return();
        }
    }
}
