                            data.Field.Named("layer", data.Value.UInt(1))
                        ]))
                    ])),
                    data.Field.Named("behaviors", data.List([]))
                ]),
                data.Object([
                    data.Field.Named("name", data.Value.Text("Flipped Arrow")),
                    data.Field.Named("prototype", data.Value.Text("Prop")),
