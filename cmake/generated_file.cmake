# Publish a complete sibling file, leaving unchanged outputs and their timestamps alone.
function(chibi_write_generated path content)
    get_filename_component(directory "${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(LOCK "${path}.lock" GUARD FUNCTION TIMEOUT 60)
    if(EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
        file(READ "${path}" previous)
        if(previous STREQUAL content)
            return()
        endif()
    endif()
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(temporary "${path}.${nonce}.tmp")
    file(WRITE "${temporary}" "${content}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E rename "${temporary}" "${path}"
        RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        file(REMOVE "${temporary}")
        message(FATAL_ERROR "Could not publish ${path}: ${error}")
    endif()
endfunction()
