package facts

// boxed elements
@test
Calls :: () {
    a1_0: string[] = ["a", "b", "c"];
    a1_1: int = 1;
    r1: string = BoxedWord(a1_0, a1_1);
    e1: string = "b";
    assert(r1 == e1, "BoxedWord call 1");
    a4_0: string[] = ["a", "b", "b"];
    r4: int = BoxedWords(a4_0);
    e4: int = 2;
    assert(r4 == e4, "BoxedWords call 4");
    a7_0: int = 2;
    r7: int = BoxedShapes(a7_0);
    e7: int = 517;
    assert(r7 == e7, "BoxedShapes call 7");
    a8_0: int = 1;
    r8: int = BoxedShapes(a8_0);
    e8: int = 17;
    assert(r8 == e8, "BoxedShapes call 8");
}
