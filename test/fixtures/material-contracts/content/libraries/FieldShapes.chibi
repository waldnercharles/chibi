library "FieldShapes" {
    pure function "Islands"(X: float = 0.0, Y: float = 0.0) -> (Value: float = 0.0) {
        return field_smooth_union(field_min(field_circle(field_add(entry.X, 90.0), entry.Y, 65.0), field_box(field_subtract(entry.X, 60.0), entry.Y, 55.0, 85.0)), field_capsule(entry.X, entry.Y, -90.0, 0.0, 60.0, 0.0, 18.0), 15.0)
    }
}
