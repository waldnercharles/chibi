version 3
name "QuarryField"
domain "field"
id_counter 56
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=45 type="Field X"
            - id=47 type="Field Y"
            - {
                id 49
                type "Call Pure Function"
                reference_name "Quarry"
                reference_asset "QuarryShapes"
                inputs {
                    X id=50 type="number"
                    Y id=51 type="number"
                }
                outputs {
                    Value id=52 type="number"
                }
            }
            - id=53 type="Field Output"
        }
        (array)edges {
            - from="45.Value" to="49.X"
            - from="47.Value" to="49.Y"
            - from="49.Value" to="53.Value"
        }
    }
}
