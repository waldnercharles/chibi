version 3
name "Polished"
domain "material"
id_counter 11000
description "A plain PBR surface; Base Color, Metallic and Roughness are parameters an entity overrides."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 1100
                type "Shader Surface Output"
                inputs "Alpha Mode"=1
            }
            - {
                id 4000
                type "Shader Parameter"
                reference_name "Base Color"
                outputs {
                    Value {
                        type "struct"
                        type_name "ShaderVec3"
                        default x=0.95 y=0.74 z=0.35
                    }
                }
            }
            - {
                id 5000
                type "Shader Parameter"
                reference_id 1
                reference_name "Metallic"
                outputs Value=1.0
            }
            - {
                id 6000
                type "Shader Parameter"
                reference_id 2
                reference_name "Roughness"
                outputs Value=0.2
            }
        }
        (array)edges {
            - from="4000.Value" to="1100.Base Color"
            - from="5000.Value" to="1100.Metallic"
            - from="6000.Value" to="1100.Roughness"
        }
    }
}
