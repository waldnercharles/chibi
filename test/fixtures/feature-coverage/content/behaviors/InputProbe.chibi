behavior InputProbe {
    on Input {
        self.Transform += Direction
        if held("Fire") {
            self.Aim.firing = true
        }
        if pressed("Fire") {
            self.Aim.firing = true
        }
    }
    on Fire {
        self.Aim.firing = true
    }
    on Dash {
        self.Aim.firing = false
    }
    on PressedChanged {
    }
}
