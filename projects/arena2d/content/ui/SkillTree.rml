                <div class="tfoot"><span class="cost">1 point</span><span class="need">Needs Shield Capacitors</span></div>
              </div>
            </div>
            <div class="node" id="learn" style="left: 164dp; top: 116dp;" data-event-click="emit('Learn', 6)" data-class-owned="self.n6 == 2" data-class-open="self.n6 == 1" data-class-poor="self.a6 == 0">
              <div class="ring"><div class="val">+12%</div><div class="tag">Thrust</div></div>
              <div class="tip" style="left: -73dp;">
                <div class="tname">Slipstream</div>
                <div class="tdesc">Fly another 12% faster.</div>
                <div class="tfoot"><span class="cost">1 point</span><span class="need">Needs Vector Thrusters</span></div>
              </div>
