package package_compiler_tests

import compiler "project:package_compiler"
import facts "project:scalar_facts"
import scalar "project:scalar_llvm"

Target :: () -> compiler.Target {
    return {pointer_storage: 9, pointer_size: 8, value_size: 48, payload_offset: 8, arguments_offset: 168, results_offset: 208, delta_seconds_offset: 344, error_status_offset: 496, type_offset: 0, container_offset: 16, name_offset: 24, record_offset: 32, schema_offset: 40, count_offset: 24, items_offset: 32, data_offset: 40, stride_offset: 48, map_count_offset: 96, data_failure: 4, argument_failure: 7, assert_failure: 3};
}
Names :: () -> string[] {
    return ["CONSTANT", "VARIABLE", "DELTA", "ARGUMENT", "LOCAL", "PRESENT", "TYPE_NAME", "OWNER", "WORLD", "CONTEXT", "STORAGE_NAME", "ARRAY", "QUERY_VARIABLE", "QUERY", "HOST_SLOT", "HOST_SERVICE", "COMMAND_SERVICE", "COMMAND_RESULT", "OWN_NAME", "COPY_STRING", "COPY_ARRAY", "INTERN_STRING", "STRING_EQUAL", "STATE_SELECT", "RANDOM", "ADD", "SUB", "MUL", "DIV", "MOD", "NEG", "ABS", "MIN", "MAX", "CONVERT", "CAST", "FLAGS", "LT", "LE", "GT", "GE", "EQ", "NE", "SELECT", "BIT_AND", "BIT_OR", "BIT_XOR", "BIT_NOT", "SHL", "SHR", "SIN", "COS", "TAN", "ASIN", "ACOS", "ATAN", "EXP", "LOG", "LOG10", "FRACT", "SIGN", "SQRT", "FLOOR", "CEIL", "ROUND", "POW", "ATAN2", "MOD_F32", "MOD_F64", "HYPOT", "FMA", "RANDOM_RANGE", "ENTITY", "COMPONENT", "COMPONENT_READ", "COLUMN", "COLUMN_TRY", "ROW", "INDEX", "LOAD", "READ", "RETRIGGER", "STORE", "STORE_VALUE", "RESULT", "SAVE", "RESULT_PRESENT", "RESULT_TYPE_NAME", "RESULT_ARRAY", "STORE_HEADER", "STORE_TYPE_NAME", "REQUIRE", "ASSERT", "WRITE", "COMPONENT_WRITE", "COMMAND_ARGUMENT", "COMMAND_OUTPUT", "COMMAND", "COMMAND_BEGIN", "HOST_CALL", "INVOKE", "SUSPEND", "DELAY", "POINT", "WATCH_BEGIN", "WATCH_RESET", "WATCH_VALUE", "WATCH_PRESENT", "WATCH_END", "TRACE", "CHECK", "CALL_CHECK", "ENTER", "LEAVE", "FAIL", "JUMP", "BRANCH", "RETURN", "SOURCE_POINT", "SOURCE_WATCH", "END"];
}
Natives :: () -> compiler.Native[] {
    return [{name: "format_text", first: 0, parameters: 2, results: 1, variadic: true, effects: 0},
            {name: "text_byte_length", first: 3, parameters: 1, results: 1, variadic: false, effects: 0},
            {name: "text_byte_at", first: 5, parameters: 2, results: 1, variadic: false, effects: 0},
            {name: "text_slice", first: 8, parameters: 3, results: 1, variadic: false, effects: 0}];
}
Ports :: () -> compiler.Port[] {
    return [{name: "Format", storage: 13, container: 0, c_string: false},
            {name: "Arg0", storage: -2, container: 0, c_string: false},
            {name: "Result", storage: 13, container: 0, c_string: false},
            {name: "Value", storage: 13, container: 0, c_string: false},
            {name: "Result", storage: 6, container: 0, c_string: false},
            {name: "Value", storage: 13, container: 0, c_string: false},
            {name: "Index", storage: 6, container: 0, c_string: false},
            {name: "Result", storage: 6, container: 0, c_string: false},
            {name: "Value", storage: 13, container: 0, c_string: false},
            {name: "Start", storage: 6, container: 0, c_string: false},
            {name: "Count", storage: 6, container: 0, c_string: false},
            {name: "Result", storage: 13, container: 0, c_string: false}];
}
Identities :: () -> u64[] {
    return [11766263161483317927, 2488592934114488867, 9751228472515978090, 16063057558298538155,
            17242165570387488779, 12343909921556459566, 17083074289450012770, 11058014659850463058];
}

@test
Tiny :: () {
    rows := compiler.CollectScalar("/project", "Scalar.chibi", "package scalar\nMain :: () -> int { return 1; }\n", Target(), Names(), Natives(), Ports(), Identities());
    assert(length(rows) > 2, "rows");
}
@test
Guard :: () {
    rows := compiler.CollectScalar("/project", "Scalar.chibi", "package scalar\nMain :: () -> int { return Pick(1, 2); }\nPick :: (a: int, b: int) -> int {\n    if (a < b) { return Id(a); }\n    return b;\n}\nId :: (x: int) -> int { return x; }\n", Target(), Names(), Natives(), Ports(), Identities());
    assert(length(rows) == 24, "rows");
}
