version 3
name "ProfileVessel"
domain "model"
id_counter 19
description "A hollow vessel from two convex radial profiles revolved about Y. The cut keeps the outer solid's surface ownership."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - {
                id 3
                type "Model Profile Polygon"
                inputs {
                    Vertices {
                        (array)default {
                            - x=0.0 y=-28.0
                            - x=17.0 y=-28.0
                            - x=28.0 y=-8.0
                            - x=28.0 y=14.0
                            - x=16.0 y=28.0
                            - x=0.0 y=28.0
                        }
                    }
                }
            }
            - id=6 type="Model Revolve"
            - {
                id 9
                type "Model Profile Polygon"
                inputs {
                    Vertices {
                        (array)default {
                            - x=0.0 y=-20.0
                            - x=12.0 y=-20.0
                            - x=23.0 y=-5.0
                            - x=23.0 y=14.0
                            - x=13.0 y=32.0
                            - x=0.0 y=32.0
                        }
                    }
                }
            }
            - id=12 type="Model Revolve"
            - id=15 type="Model Difference"
        }
        (array)edges {
            - from="3.Profile" to="6.Profile"
            - from="6.Geometry" to="15.A"
            - from="9.Profile" to="12.Profile"
            - from="12.Geometry" to="15.B"
            - from="15.Geometry" to="1.Geometry"
        }
    }
}
