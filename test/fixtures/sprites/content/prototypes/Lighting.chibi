package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Lighting")),
            data.Field.Named("components", data.Object([
                data.Field.Named("HRC2D", data.Object([
                    data.Field.Named("ambient", data.Value.Real(0.25)),
                    data.Field.Named("intensity", data.Value.Real(1.0)),
                    data.Field.Named("resolution", data.Value.Real(0.5))
                ]))
            ]))
        ])
    );
}
