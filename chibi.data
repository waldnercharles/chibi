  - {from: 4.Entity, to: 13.Entity}
  - {from: 13.Value.current, to: 49.Collected, conversion: To Real}
  - {from: 49.True, to: 28.Exec}
- {id: 35, kind: function, math_expression: Collected >= 8, entry_id: 56}
version: 3
name: CombatFeedback
id_counter: 561
description: Accepted damage restarts an authored hit flash; its final active tick clears the material parameter. Idle entities skip hit-flash work, and only entities with GameDash evaluate dash glow.
owner_type: ecs.entity
variables:
- id: 1
  name: Hit Duration
  type: float
  type_name: float
  category: Feedback
  default: 0.14
- id: 2
  name: Hit Strength
  type: float
  type_name: float
  category: Feedback
  default: 2.0
- id: 3
  name: Dash Strength
  type: float
  type_name: float
  category: Feedback
  default: 1.8
- {id: 4, name: Hit Remaining, type: float, type_name: float, category: State}
