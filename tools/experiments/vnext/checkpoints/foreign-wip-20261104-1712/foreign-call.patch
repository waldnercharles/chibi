+    rows := changed.foreigns;
+    row := rows[0];
+    row.function = 0;
+    rows[0] = row;
+    changed.foreigns = rows;
+    assert(typed.Verify(changed) == typed.InvalidSpan, "foreign function ID must exist");
+    changed = original;
+    rows = changed.foreigns;
+    rows[1] = rows[0];
+    changed.foreigns = rows;
+    assert(typed.Verify(changed) == typed.InvalidSpan, "foreign membership cannot repeat");
+    changed = original;
+    rows = changed.foreigns;
+    row = rows[0];
+    row.library = u32(length(changed.names) + 1);
+    rows[0] = row;
+    changed.foreigns = rows;
+    assert(typed.Verify(changed) == typed.InvalidSpan, "foreign library ID must exist");
+    changed = original;
+    functions := changed.functions;
+    function := functions[0];
+    function.block_count = 1;
+    functions[0] = function;
+    changed.functions = functions;
+    assert(typed.Verify(changed) == typed.InvalidSpan, "foreign declarations cannot own body blocks");
+    changed = original;
+    functions = changed.functions;
+    function = functions[0];
+    function.exported = 1;
+    functions[0] = function;
+    changed.functions = functions;
+    assert(typed.Verify(changed) == typed.InvalidSpan, "foreign declarations cannot publish entries");
+    changed = original;
+    instructions := changed.instructions;
+    for (instruction, index in instructions) {
+        if (instruction.op == typed.EqualI64) {
+            changed_instruction := instruction;
+            changed_instruction.left = 3;
+            instructions[index] = changed_instruction;
+            break;
+        }
+    }
+    changed.instructions = instructions;
+    assert(typed.Verify(changed) == typed.InvalidType, "equality rejects a bool operand");
+}
