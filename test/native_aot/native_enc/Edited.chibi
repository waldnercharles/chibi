package loop

Detail :: struct { label: string; }
Progress :: struct { extra: int; detail: Detail; text: string; count: int; added: string; }
Main :: () -> int { return 9; }
Frame :: () -> int {
    progress: retain Progress = {extra: 37, detail: {label: "reset"}, text: "reset", count: 0, added: "new field"};
    message: retain string = "edited generation";
    note: retain string = "reset";
    if progress.count < 3 { return 3; }
    if message != "first generation" { return 4; }
    if progress.extra != 37 { return 5; }
    if text_byte_length(note) < 6 { return 6; }
    assert(text_byte_length(progress.text) > 9);
    assert(text_byte_length(progress.detail.label) > 7);
    assert(progress.added == "new field");
    return 7;
}
