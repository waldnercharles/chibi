version 1
name "SdfMotion"
(array)entities {
    - {
        name "Camera"
        prototype "SdfCamera"
        components {
            (object)GameCamera
        }
    }
    - {
        name "Cyan light"
        prototype "SdfLight"
        components {
            GameTransform x=-195.0 y=0.0
            GameMaterial emission_color=0x38d9edff
        }
    }
    - {
        name "Amber light"
        prototype "SdfLight"
        components {
            GameTransform x=195.0 y=0.0
            GameMaterial emission_color=0xffac54ff
        }
    }
    - {
        name "Rose light"
        prototype "SdfLight"
        components {
            GameTransform x=0.0 y=118.0
            GameMaterial emission_color=0xec749fff
        }
    }
    - {
        name "Rigid torus"
        prototype "SdfTorus"
        components {
            GameTransform x=-110.0 y=0.0
            GameShader material="SdfCyan"
        }
        (array)behaviors "SdfRigidSweep"
    }
    - {
        name "Changing radius"
        prototype "SdfBreathingSphere"
        components {
            GameTransform x=0.0 y=0.0
            GameShader material="SdfRose"
        }
    }
    - {
        name "Static radius control"
        prototype "SdfSphere"
        components {
            GameTransform x=110.0 y=0.0
            GameShader material="SdfAmber"
        }
    }
}
