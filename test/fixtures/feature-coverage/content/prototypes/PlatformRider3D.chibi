package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("PlatformRider3D")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Body3D", data.Object([
                    data.Field.Named("type", data.Value.Text("Kinematic"))
                ])),
                data.Field.Named("Character3D", data.Object([])),
                data.Field.Named("Collider3D", data.Object([
                    data.Field.Named("category", data.Value.UInt(1)),
                    data.Field.Named("height", data.Value.Real(48.0)),
                    data.Field.Named("mask", data.Value.UInt(1)),
                    data.Field.Named("radius", data.Value.Real(12.0)),
                    data.Field.Named("shape", data.Value.Text("Capsule"))
                ])),
                data.Field.Named("Geometry3D", data.Object([
                    data.Field.Named("depth", data.Value.Real(24.0)),
                    data.Field.Named("height", data.Value.Real(48.0)),
                    data.Field.Named("primitive", data.Value.UInt(2)),
                    data.Field.Named("width", data.Value.Real(24.0))
                ])),
                data.Field.Named("Material", data.Object([
                    data.Field.Named("scene", data.Value.UInt(4039139583))
                ])),
                data.Field.Named("Transform3D", data.Object([
                    data.Field.Named("scale", data.Object([
                        data.Field.Named("x", data.Value.Real(1.0)),
                        data.Field.Named("y", data.Value.Real(1.0)),
                        data.Field.Named("z", data.Value.Real(1.0))
                    ]))
                ]))
            ])),
            data.Field.Named("behaviors", data.List([
                data.Value.Text("PlatformRiderGravity")
            ]))
        ])
    );
}
