package facts

import testing "core:testing"

// pointer sequence views
@test
Calls :: () {
    r1: int = Follow();
    e1: int = 8592;
    assert(r1 == e1, "Follow call 1");
    r2: int = OrdinaryCopy();
    e2: int = 727;
    assert(r2 == e2, "OrdinaryCopy call 2");
    r3: int = Grow();
    e3: int = 824;
    assert(r3 == e3, "Grow call 3");
    r4: int = Cloned();
    e4: int = 119;
    assert(r4 == e4, "Cloned call 4");
    r5: int = Sliced();
    e5: int = 117;
    assert(r5 == e5, "Sliced call 5");
    r6: int = Empty();
    e6: int = 1;
    assert(r6 == e6, "Empty call 6");
    r7: int = Escaped();
    e7: int = 85;
    assert(r7 == e7, "Escaped call 7");
    r8: int = InvalidRange();
    e8: int = 0;
    assert(r8 == e8, "InvalidRange call 8");
    r10: int = Parameter();
    e10: int = 907;
    assert(r10 == e10, "Parameter call 10");
}

@test
ShrunkViewFails :: () {
    testing.ExpectFailure(testing.Failure.ViewOutOfRange);
    Shrunk();
}
