version 3
name "WeaponActions"
domain "library"
id_counter 298
description "Shared weapon cooldown and projectile initialization functions."
(array)graphs {
    - kind="event" name="Events"
    - {
        id 256
        kind "function"
        name "Spawn Prototype At"
        entry_id 257
        return_id 259
        call_depth_limit 64
        (array)nodes {
            - {
                id 257
                type "Function Entry"
                outputs {
                    Prototype id=261 type="name" kind="data"
                    Transform id=262 type="struct" type_name="GameTransform" kind="data"
                }
            }
            - {
                id 259
                type "Return"
                inputs {
                    Entity id=263 type="handle" type_name="ecs.entity" kind="data"
                }
            }
            - id=264 type="Spawn Prototype"
            - id=269 type="SetEntity_GameTransform"
        }
        (array)edges {
            - from="257.Exec" to="264.Exec"
            - from="257.Prototype" to="264.Prototype"
            - from="257.Transform" to="269.Value" conversion="game_transform_to_cf"
            - from="264.Then" to="269.Exec"
            - from="264.Entity" to="259.Entity"
            - from="264.Entity" to="269.Entity"
            - from="269.Then" to="259.Exec"
        }
    }
    - {
        id 173
        kind "function"
        name "Fire Projectile"
        entry_id 174
        return_id 179
        call_depth_limit 64
        (array)nodes {
            - {
                id 110
                type "GetEntity_GameProjectile"
                outputs {
                    Value.speed id=115
                }
            }
            - {
                id 133
                type "Set_GameProjectile_damage"
                inputs {
                    Value id=136
                    Target id=135
                }
                outputs {
                    Then id=137
                }
            }
            - {
                id 174
                type "Function Entry"
                (array)outputs {
                    - id=175 name="Then"
                    - id=176 name="Origin" type="struct" type_name="CF_V2" kind="data"
                    - id=177 name="Direction" type="struct" type_name="CF_V2" kind="data"
                    - id=178 name="Damage" type="int" kind="data"
                    - id=220 name="Prototype" type="name" kind="data" default="Projectile"
                    - id=255 name="Shooter" type="handle" type_name="ecs.entity" kind="data"
                }
            }
            - {
                id 179
                type "Return"
                inputs {
                    Entity id=181 type="handle" type_name="ecs.entity" kind="data"
                }
            }
            - {
                id 225
                type "Multiply"
                inputs {
                    A type="struct" type_name="CF_V2" flags=0 group=0
                    B flags=0 group=0
                }
                outputs {
                    Result type="struct" type_name="CF_V2" flags=0 group=0
                }
            }
            - id=229 type="SetEntity_GameVelocity"
            - {
                id 235
                type "Call Pure Function"
                reference_id 1
                reference_name "Direction Orientation"
                reference_asset "DirectionMath"
                inputs {
                    X id=236 declaration_id=4 type="float"
                    Y id=237 declaration_id=5 type="float"
                }
                outputs {
                    Orientation id=238 declaration_id=6 type="struct" type_name="GameOrientation"
                }
            }
            - id=239 type="SetEntity_GameOrientation"
            - id=247 type="Set_GameCollider_ignore_entity"
            - {
                id 253
                type "Normalize Vector 2"
                inputs {
                    Value id=221
                }
                outputs {
                    Result.x id=223
                    Result.y id=224
                }
            }
            - {
                id 292
                type "Call Function"
                reference_name "Spawn Prototype At"
                inputs {
                    Prototype id=295 type="name" kind="data"
                    Transform id=296 type="struct" type_name="GameTransform" kind="data"
                }
                outputs {
                    Then id=294
                    Entity id=297 type="handle" type_name="ecs.entity" kind="data"
                }
            }
        }
        (array)edges {
            - from="110.Value.speed" to="225.B"
            - from="133.Then" to="247.Exec"
            - from="174.Then" to="292.Exec"
            - from="174.Origin" to="292.Transform" conversion="game_transform_to_cf"
            - from="174.Direction" to="253.Value"
            - from="174.Damage" to="133.Value"
            - from="174.Prototype" to="292.Prototype"
            - from="174.Shooter" to="247.Value"
            - from="225.Result" to="229.Value"
            - from="229.Then" to="239.Exec"
            - from="235.Orientation" to="239.Value"
            - from="239.Then" to="133.Exec"
            - from="247.Then" to="179.Exec"
            - from="253.Result" to="225.A"
            - from="253.Result.x" to="235.X"
            - from="253.Result.y" to="235.Y"
            - from="292.Then" to="229.Exec"
            - from="292.Entity" to="110.Entity"
            - from="292.Entity" to="133.Target"
            - from="292.Entity" to="179.Entity"
            - from="292.Entity" to="229.Entity"
            - from="292.Entity" to="239.Entity"
            - from="292.Entity" to="247.Target"
        }
    }
}
