// What both occlusion passes read: the camera's depth and how to place it.
layout(location = 0) out vec4 result;
layout(set = 2, binding = 0) uniform sampler2D depth_map;
layout(set = 3, binding = 0) uniform uniform_block {
    // Clip space back to view space.
    mat4 occlusion_unproject;
    // The depth map's size, frame pixels per occlusion texel, and the widest
    // search in pixels.
    vec4 occlusion_frame;
    // Pixels per view unit where clip w is one, clip w's change with view z
    // and its constant, and the radius in view units.
    vec4 occlusion_lens;
    // Slices and steps along each side of a slice.
    vec4 occlusion_search;
};

ivec2 frame_size()
{
    return ivec2(occlusion_frame.xy);
}

// The view-space point at a depth behind pixel coordinate p, whose row 0 is
// the top of the frame, as in the shadow lookups.
vec3 view_at(vec2 p, float depth)
{
    vec2 uv = p / occlusion_frame.xy;
    vec4 view = occlusion_unproject * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    return view.xyz / view.w;
}

float depth_at(ivec2 p)
{
    return texelFetch(depth_map, clamp(p, ivec2(0), frame_size() - 1), 0).r;
}

// The view-space point the depth map holds at pixel p.
vec3 view_point(ivec2 p)
{
    p = clamp(p, ivec2(0), frame_size() - 1);
    return view_at(vec2(p) + 0.5, texelFetch(depth_map, p, 0).r);
}

// The view-space direction toward the eye along pixel coordinate p's ray,
// which orthographic lenses keep parallel.
vec3 toward_eye(vec2 p)
{
    return normalize(view_at(p, 0.0) - view_at(p, 0.5));
}

// The surface's view-space normal at pixel p, facing the eye, from the
// neighbor nearer in depth along each axis, so that it keeps to one surface
// at an edge.
vec3 view_normal(ivec2 p, vec3 center, vec3 eye)
{
    ivec2 last = frame_size() - 1;
    vec3 left = view_point(p - ivec2(1, 0)), right = view_point(p + ivec2(1, 0));
    vec3 above = view_point(p - ivec2(0, 1)), below = view_point(p + ivec2(0, 1));
    bool rightward = p.x < last.x && (p.x == 0 || abs(right.z - center.z) < abs(center.z - left.z));
    bool downward = p.y < last.y && (p.y == 0 || abs(below.z - center.z) < abs(center.z - above.z));
    vec3 across = rightward ? right - center : center - left;
    vec3 down = downward ? below - center : center - above;
    vec3 normal = cross(across, down);
    float length_squared = dot(normal, normal);
    if (length_squared <= 0.0) return eye;
    normal *= inversesqrt(length_squared);
    return dot(normal, eye) < 0.0 ? -normal : normal;
}
