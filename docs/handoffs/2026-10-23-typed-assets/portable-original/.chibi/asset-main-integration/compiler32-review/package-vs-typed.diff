+// Parsed roots, signatures and catalog types share one index space. Bodies
+// establish exact imports; dependencies are assembled before their callers.
+SourceNatives :: (documents: snapshot.Document[], callables: Callable[], natives: ResolvedNative[],
+                  identities: uint64[]) -> ResolvedNative[] {
+    owned: uint64[] = [];
+    for (callable in callables) {
+        owned.append(binding.ID("symbol", format_text("{}:1:{}:callable", documents[callable.document].identity,
+                                                      callable.name)));
+    }
+    resolved: ResolvedNative[] = [];
+    index: int = 0;
+    for (native in natives) {
+        row := native;
+        for (id in owned) {
+            row.source = row.source || identities[2 * index] == id;
+        }
+        resolved.append(row);
+        index += 1;
+    }
+    return resolved;
+}
