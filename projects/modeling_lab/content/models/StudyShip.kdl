version 3
name "StudyShip"
domain "model"
id_counter 117
description "A static hull, convex extruded mirrored wings and two references to an editable engine. Local Y is up and the nose points toward +Z."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Model Output"
            - id=6 type="Model Material Slot" reference_name="Paint" reference_asset="ShipPaint"
            - id=8 type="Model Material Slot" reference_name="Wing finish" reference_asset="ShipMetal"
            - {
                id 10
                type "Model Parameter"
                reference_name "Hull Radius"
                inputs Default=16.0 Minimum=12.0 Maximum=20.0
            }
            - {
                id 15
                type "Model Parameter"
                reference_name "Hull Half Segment"
                inputs Default=40.0 Minimum=30.0 Maximum=50.0
            }
            - {
                id 20
                type "Model Parameter"
                reference_name "Wing Scale"
                inputs {
                    Default {
                        type "struct"
                        type_name "ShaderVec3"
                        default x=1.0 y=1.0 z=1.0
                    }
                    Minimum {
                        type "struct"
                        type_name "ShaderVec3"
                        default x=0.7 y=0.8 z=0.7
                    }
                    Maximum {
                        type "struct"
                        type_name "ShaderVec3"
                        default x=1.25 y=1.2 z=1.25
                    }
                }
            }
            - id=25 type="Model Capsule"
            - {
                id 29
                type "Model Rotate"
                inputs {
                    Angles {
                        default x=1.5707964 y=0.0 z=0.0
                    }
                }
            }
            - id=33 type="Model Part" reference_name="Main hull"
            - id=37 type="Model Sphere"
            - {
                id 40
                type "Model Scale"
                inputs {
                    Factors {
                        default x=10.0 y=6.0 z=19.0
                    }
                }
            }
            - {
                id 44
                type "Model Translate"
                inputs {
                    Offset {
                        default x=0.0 y=14.0 z=14.0
                    }
                }
            }
            - id=48 type="Model Part" reference_name="Raised cockpit"
            - {
                id 52
                type "Model Profile Polygon"
                inputs {
                    Vertices {
                        (array)default {
                            - x=8.0 y=-28.0
                            - x=72.0 y=-36.0
                            - x=60.0 y=5.0
                            - x=8.0 y=22.0
                        }
                    }
                }
            }
            - {
                id 55
                type "Model Extrude"
                inputs "Half Depth"=2.5
            }
            - {
                id 59
                type "Model Rotate"
                inputs {
                    Angles {
                        default x=1.5707964 y=0.0 z=0.0
                    }
                }
            }
            - id=63 type="Model Scale"
            - {
                id 67
                type "Model Translate"
                inputs {
                    Offset {
                        default x=0.0 y=-5.0 z=0.0
                    }
                }
            }
            - id=71 type="Model Part" reference_name="Starboard wing"
            - id=75 type="Model Reflect"
            - id=79 type="Model Part" reference_name="Port wing"
            - {
                id 83
                type "Model Instance"
                reference_asset "StudyShipEngine"
                inputs {
                    Radius id=85 declaration_id=10 type="float" default=9.0
                }
                outputs {
                    Geometry id=84
                }
            }
            - {
                id 86
                type "Model Translate"
                inputs {
                    Offset {
                        default x=-33.0 y=-3.0 z=-30.0
                    }
                }
            }
            - {
                id 90
                type "Model Instance"
                reference_asset "StudyShipEngine"
                inputs {
                    Radius id=92 declaration_id=10 type="float" default=11.0
                }
                outputs {
                    Geometry id=91
                }
            }
            - {
                id 93
                type "Model Translate"
                inputs {
                    Offset {
                        default x=33.0 y=-3.0 z=-30.0
                    }
                }
            }
            - id=97 type="Model Union"
            - id=101 type="Model Union"
            - id=105 type="Model Union"
            - id=109 type="Model Union"
            - id=113 type="Model Union"
        }
        (array)edges {
            - from="6.Slot" to="33.Material"
            - from="8.Slot" to="48.Material"
            - from="8.Slot" to="71.Material"
            - from="8.Slot" to="79.Material"
            - from="10.Value" to="25.Radius"
            - from="15.Value" to="25.Half Segment"
            - from="20.Value" to="63.Factors"
            - from="25.Geometry" to="29.Geometry"
            - from="29.Geometry" to="33.Geometry"
            - from="33.Geometry" to="97.A"
            - from="37.Geometry" to="40.Geometry"
            - from="40.Geometry" to="44.Geometry"
            - from="44.Geometry" to="48.Geometry"
            - from="48.Geometry" to="97.B"
            - from="52.Profile" to="55.Profile"
            - from="55.Geometry" to="59.Geometry"
            - from="59.Geometry" to="63.Geometry"
            - from="63.Geometry" to="67.Geometry"
            - from="67.Geometry" to="71.Geometry"
            - from="67.Geometry" to="75.Geometry"
            - from="71.Geometry" to="101.B"
            - from="75.Geometry" to="79.Geometry"
            - from="79.Geometry" to="105.B"
            - from="83.Geometry" to="86.Geometry"
            - from="86.Geometry" to="109.B"
            - from="90.Geometry" to="93.Geometry"
            - from="93.Geometry" to="113.B"
            - from="97.Geometry" to="101.A"
            - from="101.Geometry" to="105.A"
            - from="105.Geometry" to="109.A"
            - from="109.Geometry" to="113.A"
            - from="113.Geometry" to="1.Geometry"
        }
    }
}
