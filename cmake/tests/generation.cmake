cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/assertions.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/generation_stability.cmake")
if(NOT ROOT OR NOT TEST_DIR OR NOT CONCURRENT)
    message(FATAL_ERROR "ROOT, TEST_DIR and CONCURRENT are required")
endif()
file(REMOVE_RECURSE "${TEST_DIR}")
file(MAKE_DIRECTORY "${TEST_DIR}")
file(WRITE "${TEST_DIR}/registry.cmake" "set(OUTPUT [==[${TEST_DIR}/registry.c]==])\nset(PACKS PACK_A PACK_B)\ninclude([==[${ROOT}/cmake/compose_registry.cmake]==])\n")
file(WRITE "${TEST_DIR}/embed.cmake" "set(INPUT [==[${ROOT}/test/fixtures/generation.bin]==])\nset(OUTPUT [==[${TEST_DIR}/embed.c]==])\nset(SYMBOL test_blob)\ninclude([==[${ROOT}/cmake/embed_binary.cmake]==])\n")
foreach(generator registry embed)
    run_checked("${CMAKE_COMMAND}" -P "${TEST_DIR}/${generator}.cmake")
    set(output "${TEST_DIR}/${generator}.c")
    set(stable_target "${output}.stable")
    file(RENAME "${output}" "${stable_target}")
    file(CREATE_LINK "${stable_target}" "${output}" SYMBOLIC)
    file(CHMOD "${stable_target}" PERMISSIONS OWNER_READ GROUP_READ WORLD_READ)
    snapshot_generated(before "${output}")
    if(CMAKE_VERSION VERSION_LESS 3.23)
        # Older CMake cannot report subsecond file timestamps.
        run_checked("${CMAKE_COMMAND}" -E sleep 1.1)
    endif()
    # Keep the generator's output path as a symlink to a read-only reference.
    # Replacing the output removes the link; the timestamp also catches
    # same-byte in-place writes within one timestamp tick.
    run_checked("${CMAKE_COMMAND}" -P "${TEST_DIR}/${generator}.cmake")
    run_checked("${CONCURRENT}" 4 "${CMAKE_COMMAND}" -P "${TEST_DIR}/${generator}.cmake")
    if(NOT IS_SYMLINK "${output}")
        message(FATAL_ERROR "Unchanged generation replaced ${output}")
    endif()
    file(READ_SYMLINK "${output}" actual_target)
    if(NOT actual_target STREQUAL stable_target)
        message(FATAL_ERROR "Unchanged generation retargeted ${output}: ${actual_target}")
    endif()
    assert_generation_unchanged(before "${output}")
endforeach()
file(READ "${TEST_DIR}/registry.c" registry)
if(NOT registry MATCHES "&PACK_A,[ \r\n]+&PACK_B," OR NOT registry MATCHES "REGISTRY_PACK_COUNT = 2;")
    message(FATAL_ERROR "Registry order/count changed: ${registry}")
endif()
file(READ "${TEST_DIR}/embed.c" embedded)
string(REGEX MATCHALL "0x[0-9a-f][0-9a-f]" bytes "${embedded}")
list(LENGTH bytes byte_count)
if(NOT byte_count EQUAL 256)
    message(FATAL_ERROR "Expected all 256 byte values, got ${byte_count}")
endif()
file(READ "${ROOT}/test/fixtures/generation.bin" expected HEX)
string(JOIN "" actual ${bytes})
string(REPLACE "0x" "" actual "${actual}")
if(NOT actual STREQUAL expected OR NOT embedded MATCHES "const unsigned char test_blob\\[\\]")
    message(FATAL_ERROR "Binary embedding changed bytes or symbol")
endif()
# Force a real rename failure after staging a complete file. The existing
# destination and its contents must survive; no publication temporary may leak.
file(MAKE_DIRECTORY "${TEST_DIR}/blocked")
file(WRITE "${TEST_DIR}/blocked/sentinel" "previous output")
file(WRITE "${TEST_DIR}/failure.cmake" "include([==[${ROOT}/cmake/generated_file.cmake]==])\nchibi_write_generated([==[${TEST_DIR}/blocked]==] replacement)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${TEST_DIR}/failure.cmake" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
    message(FATAL_ERROR "Publication onto a nonempty directory unexpectedly succeeded")
endif()
file(READ "${TEST_DIR}/blocked/sentinel" sentinel)
file(GLOB leftovers "${TEST_DIR}/blocked.*.tmp")
if(NOT sentinel STREQUAL "previous output" OR leftovers)
    message(FATAL_ERROR "Failed publication damaged the destination or leaked ${leftovers}")
endif()
message(STATUS "PASS: concurrent changed-only generation, exact binary bytes, failed atomic publication")
