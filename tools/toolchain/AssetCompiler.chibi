package toolchain

import generator "asset_generator:."

pub Build :: () -> int {
    arguments := build.arguments();
    if (length(arguments) < 2 || length(arguments) > 3) {
        build.report("usage: HOST OUTPUT_DIRECTORY [TARGET_JSON]");
        return 2;
    }
    target := "";
    if (length(arguments) == 3) {
        target = build.read_file(arguments[2]);
    }
    if (!generator.Generate(build.root(), arguments[0], arguments[1], target)) {
        return 1;
    }
    return 0;
}
