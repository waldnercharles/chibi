behavior "ArenaDropBehavior" {
    owner "ecs.entity";
    on Begin as begin() {
        if (cast<double>(component("Pickup", "state")) == 3) {
            await "Spawn Surface Pulse"(Prototype: "ArenaDeathPulse", Position: component("Transform"));
            await "Emit Source Frame"(Position: component("Transform"), Appearance: component("Geometry3D"), Material: component("Shader"), Orientation: component("Orientation"), Visual: component("VisualTransform"));
            await set_entity_geometry3_d(Entity: engine["Self"](), Value: {
                primitive: 9,
                width: 5.0,
                depth: 5.0,
                height: 0.1,
                elevation: 5.0
            });
            await set_entity_shader(Entity: engine["Self"](), Value: {
                material: "ArenaExperience",
                shape: "",
                parameters: "",
                bounds_x: 0.0,
                bounds_y: 0.0
            });
            await set_orientation_radians(Value: 0.0, Target: 0);
            await set_component(Component: "VisualTransform", Entity: 0, Value.pitch: float = 0.0, Value.roll: float = 0.0, Value.scale: float = 1.0);
            set_pickup_state(Value: 0, Target: 0);
        } else {
        }
    }
    function "Emit Source Frame"(Position: struct<"Transform"> = null, Appearance: struct<"Geometry3D"> = null, Material: struct<"Shader"> = null, Orientation: struct<"Orientation"> = null, Visual: struct<"VisualTransform"> = null) -> () {
        depth_limit 64;
        action forloop = for_loop(FirstIndex: 0, LastIndex: cast<int>(subtract(A: plain int = primitive_part(Appearance: entry.Appearance, Index: 0).Count, B: plain int = 1)));
        after entry {
            forloop();
        }
        after forloop.Body {
            Appearance := entry.Appearance
            "Spawn Source Beam"(Position: entry.Position, Appearance: Appearance, Material: entry.Material, Orientation: entry.Orientation, Visual: entry.Visual, Center: primitive_part(Appearance: Appearance, Index: forloop.Index).Center, "Center Y": primitive_part(Appearance: Appearance, Index: forloop.Index).Elevation, Width: primitive_part(Appearance: Appearance, Index: forloop.Index).Width, Height: primitive_part(Appearance: Appearance, Index: forloop.Index).Height, Depth: primitive_part(Appearance: Appearance, Index: forloop.Index).Depth, Primitive: primitive_part(Appearance: Appearance, Index: forloop.Index).Primitive);
        }
        after forloop.Completed {
            return ();
        }
    }
    function "Spawn Surface Pulse"(Prototype: name = "ArenaHitPulse", Position: struct<"Transform"> = null) -> () {
        depth_limit 64;
        action spawn_prototype = engine["Spawn Prototype"](Prototype: entry.Prototype);
        after entry {
            spawn_prototype();
        }
        after spawn_prototype {
            await set_entity_transform(Entity: spawn_prototype.Entity, Value: entry.Position);
            return ();
        }
    }
    function "Spawn Source Beam"(Position: struct<"Transform"> = null, Appearance: struct<"Geometry3D"> = null, Material: struct<"Shader"> = null, Orientation: struct<"Orientation"> = null, Visual: struct<"VisualTransform"> = null, Center: struct<"CF_V2"> = null, "Center Y": float = 0.0, Width: float = 0.0, Height: float = 0.0, Depth: float = 0.0, Primitive: int = 0) -> () {
        depth_limit 64;
        action spawn_prototype = engine["Spawn Prototype"](Prototype: "ArenaEnemyShard");
        after entry {
            spawn_prototype();
        }
        after spawn_prototype {
            await set_component(Component: "Transform", Entity: spawn_prototype.Entity, Value.x: float = cast<double>(add(A: plain double = entry.Position.x, B: plain double = transform_visual_offset(Offset: entry.Center, Elevation: entry."Center Y", Heading: entry.Orientation.radians, Visual: entry.Visual).Offset.x)), Value.y: float = cast<double>(add(A: plain double = entry.Position.y, B: plain double = transform_visual_offset(Offset: entry.Center, Elevation: entry."Center Y", Heading: entry.Orientation.radians, Visual: entry.Visual).Offset.y)));
            await set_component(Component: "Geometry3D", Entity: spawn_prototype.Entity, Value.primitive: int = entry.Primitive, Value.width: float = entry.Width, Value.depth: float = entry.Depth, Value.height: float = entry.Height, Value.elevation: float = cast<double>(add(A: plain double = entry.Appearance.elevation, B: plain double = transform_visual_offset(Offset: entry.Center, Elevation: entry."Center Y", Heading: entry.Orientation.radians, Visual: entry.Visual).Elevation)));
            await set_component(Component: "Velocity", Entity: spawn_prototype.Entity, Value.x: float = cast<double>(multiply(A: plain double = transform_visual_offset(Offset: entry.Center, Elevation: entry."Center Y", Heading: entry.Orientation.radians, Visual: entry.Visual).Offset.x, B: plain double = 5.0)), Value.y: float = cast<double>(multiply(A: plain double = transform_visual_offset(Offset: entry.Center, Elevation: entry."Center Y", Heading: entry.Orientation.radians, Visual: entry.Visual).Offset.y, B: plain double = 5.0)));
            Shard := spawn_prototype.Entity
            await set_entity_shader(Entity: Shard, Value: entry.Material);
            await set_entity_orientation(Entity: Shard, Value: entry.Orientation);
            await set_entity_visual_transform(Entity: Shard, Value: entry.Visual);
            return ();
        }
    }
}
