version 1
name "ModelSurfaceDetailStudy"
(array)entities {
    - {
        name "Camera"
        prototype "StudyCamera"
        components {
            GameCamera width=380.0 height=240.0 focal_distance=800.0
            GameHRC2D surface_relief=0.0 ambient=0.14 bloom=0.01
        }
    }
    - {
        name "Key"
        prototype "StudyLight"
        components {
            GameTransform x=-150.0 y=-90.0
        }
    }
    - {
        name "Fill"
        prototype "StudyLight"
        components {
            GameTransform x=145.0 y=80.0
        }
    }
    - {
        name "DetailSmoothTile"
        prototype "DetailSmoothTile"
        components {
            GameTransform x=-100.0 y=-55.0
        }
    }
    - {
        name "DetailBumpTile"
        prototype "DetailBumpTile"
        components {
            GameTransform x=0.0 y=-55.0
        }
    }
    - {
        name "DetailReferenceTile"
        prototype "DetailReferenceTile"
        components {
            GameTransform x=100.0 y=-55.0
        }
    }
    - {
        name "DetailNormalTile"
        prototype "DetailNormalTile"
        components {
            GameTransform x=-100.0 y=55.0
        }
    }
    - {
        name "DetailHeightTile"
        prototype "DetailHeightTile"
        components {
            GameTransform x=0.0 y=55.0
        }
    }
    - {
        name "DetailPaintTile"
        prototype "DetailPaintTile"
        components {
            GameTransform x=100.0 y=55.0
        }
    }
}
