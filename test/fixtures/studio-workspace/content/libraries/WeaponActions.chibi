library "WeaponActions" {
    function "Spawn Prototype At"(Prototype: name = "", Transform: struct<"Transform"> = null) -> (Entity: handle<"ecs.entity"> = 0) {
        action spawn_prototype = engine["Spawn Prototype"](entry.Prototype)
        after entry {
            spawn_prototype()
        }
        after spawn_prototype {
            await set_entity_transform(spawn_prototype.Entity, convert<"transform_to_cf">(entry.Transform))
            return spawn_prototype.Entity
        }
    }
    function "Fire Projectile"(Origin: struct<"CF_V2"> = null, Direction: struct<"CF_V2"> = null, Damage: int = 0, Prototype: name = "Projectile", Shooter: handle<"ecs.entity"> = 0) -> (Entity: handle<"ecs.entity"> = 0) {
        action spawn_prototype_at = "Spawn Prototype At"(entry.Prototype, convert<"transform_to_cf">(entry.Origin))
        after entry {
            spawn_prototype_at()
        }
        after spawn_prototype_at {
            spawn_prototype_at.Entity.Velocity = vec2_norm(entry.Direction).Result * spawn_prototype_at.Entity.Projectile.speed
            spawn_prototype_at.Entity.Orientation = "DirectionMath"."Direction Orientation"(vec2_norm(entry.Direction).Result.x, vec2_norm(entry.Direction).Result.y)
            spawn_prototype_at.Entity.Projectile.damage = entry.Damage
            spawn_prototype_at.Entity.Collider.ignore_entity = entry.Shooter
            return spawn_prototype_at.Entity
        }
    }
}
