// DDA path-traces one interval of a level. The including shader declares the
// u_rotate, u_work_w, u_work_h and u_step_scale uniforms.
//
// For each interval, march along the ray from probe origin to target endpoint,
// stepping once per pixel boundary along the longest axis and accumulating
// radiance/optical-depth front-to-back. Stores τ (optical depth) instead of T.
// The luminance variant traces quadrant u_rotate and its opposite as
// brightness; see hrc_common.shd.

#include "hrc/source_average.shd"

// RGB emission density, A optical depth per canvas pixel.
layout(set = 2, binding = 0) uniform sampler2D u_source;
// Reflected light, already scaled by bounce intensity.
layout(set = 2, binding = 1) uniform sampler2D u_bounce;

vec2 rotate_pos(vec2 p, int rot, int w, int h)
{
	if (rot == 1)      return vec2(float(w - 1) - p.y, p.x);
	else if (rot == 2) return vec2(float(w - 1) - p.x, float(h - 1) - p.y);
	else if (rot == 3) return vec2(p.y, float(h - 1) - p.x);
	return p;
}

vec2 rotate_dir(vec2 d, int rot)
{
	if (rot == 1)      return vec2(-d.y, d.x);
	else if (rot == 2) return vec2(-d.x, -d.y);
	else if (rot == 3) return vec2(d.y, -d.x);
	return d;
}

// Light, optical depth and transmittance of one DDA step through the cell at
// a sample position in world work pixels; see hrc/source_average.shd.
void cell_step(vec2 sample_pos, float dda_step, out vec3 rad, out float tau_step, out float trn)
{
	vec2 uv = (clamp(sample_pos, vec2(0.0), vec2(u_work_w - 1, u_work_h - 1)) + vec2(0.5)) /
	          vec2(textureSize(u_source, 0));
	vec4 cell = texture(u_source, uv);
	tau_step = max(cell.a, 0.0) * dda_step;
	trn = exp(-tau_step);
	rad = cell.rgb * source_length(cell.a, dda_step);
	// Reflected light requires an interaction with matter, so it scales with
	// the step's opacity and never amplifies temporal bounce.
	rad += (1.0 - trn) * texture(u_bounce, uv).rgb;
}

// A level-0 interval of quadrant rot is one diagonal step through its probe's
// cell, the same for both of its directions.
void trace_cell_ray(int rot, int probe_x, int row, out vec3 rad, out float tau)
{
	float trn;
	vec2 cell = rotate_pos(vec2(float(probe_x), float(row)), rot, u_work_w, u_work_h);
	cell_step(cell, sqrt(2.0) * u_step_scale, rad, tau, trn);
}

void trace_ray(int rot, int level, int probe_x, int k, int row, out vec3 rad, out float tau)
{
	int step = 1 << level;

	// Ray endpoints in rotated cascade space.
	float y_offset = float(2 * k - step);
	vec2 ray_start = vec2(float(probe_x * step), float(row));
	vec2 ray_end = vec2(float(probe_x * step + step), float(row) + y_offset);

	// DDA: step once per pixel boundary along longest axis.
	vec2 segment = ray_end - ray_start;
	float intrv = max(max(abs(segment.x), abs(segment.y)), 1.0);
	vec2 delta = segment / intrv;
	float step_length = length(delta);

	// Pre-rotate start and delta to avoid per-step rotation.
	vec2 rot_start = rotate_pos(ray_start, rot, u_work_w, u_work_h);
	vec2 rot_delta = rotate_dir(delta, rot);

	// Clip iteration range to world bounds [-0.5, work_{w,h} - 0.5).
	float ii_lo = 0.0;
	float ii_hi = intrv;
	vec2 lo_bound = vec2(-0.5);
	vec2 hi_bound = vec2(float(u_work_w), float(u_work_h)) - 0.5;

	if (abs(rot_delta.x) > 1e-6) {
		float t0 = (lo_bound.x - rot_start.x) / rot_delta.x;
		float t1 = (hi_bound.x - rot_start.x) / rot_delta.x;
		ii_lo = max(ii_lo, min(t0, t1));
		ii_hi = min(ii_hi, max(t0, t1));
	} else if (rot_start.x < lo_bound.x || rot_start.x >= hi_bound.x) {
		ii_hi = -1.0;
	}

	if (abs(rot_delta.y) > 1e-6) {
		float t0 = (lo_bound.y - rot_start.y) / rot_delta.y;
		float t1 = (hi_bound.y - rot_start.y) / rot_delta.y;
		ii_lo = max(ii_lo, min(t0, t1));
		ii_hi = min(ii_hi, max(t0, t1));
	} else if (rot_start.y < lo_bound.y || rot_start.y >= hi_bound.y) {
		ii_hi = -1.0;
	}

	ii_lo = ceil(ii_lo);

	float eps = 1.0 / 512.0;
	float dda_step = step_length * u_step_scale;
	rad = vec3(0.0);
	tau = 0.0;
	float total_trn = 1.0;
	for (float ii = ii_lo; ii < ii_hi; ii += 1.0) {
		vec3 step_rad;
		float tau_step, trn;
		cell_step(rot_start + rot_delta * ii, dda_step, step_rad, tau_step, trn);
		rad += total_trn * step_rad;
		total_trn *= trn;
		tau += tau_step;
		if (total_trn < eps) break;
	}
}

#ifdef HRC_SCALAR
Interval trace_cell(int probe_x, int row)
{
	Interval paired = Interval(vec2(0.0), vec2(0.0));
	for (int lane = 0; lane < 2; lane++) {
		vec3 rad;
		float tau;
		trace_cell_ray(u_rotate + 2 * lane, probe_x, row, rad, tau);
		paired.rad[lane] = dot(rad, HRC_LUMA);
		paired.tau[lane] = tau;
	}
	return paired;
}

Interval trace_interval(int level, int probe_x, int k, int row)
{
	Interval paired = Interval(vec2(0.0), vec2(0.0));
	for (int lane = 0; lane < 2; lane++) {
		vec3 rad;
		float tau;
		trace_ray(u_rotate + 2 * lane, level, probe_x, k, row, rad, tau);
		paired.rad[lane] = dot(rad, HRC_LUMA);
		paired.tau[lane] = tau;
	}
	return paired;
}
#else
Interval trace_cell(int probe_x, int row)
{
	vec3 rad;
	float tau;
	trace_cell_ray(u_rotate, probe_x, row, rad, tau);
	return Interval(rad, tau);
}

Interval trace_interval(int level, int probe_x, int k, int row)
{
	vec3 rad;
	float tau;
	trace_ray(u_rotate, level, probe_x, k, row, rad, tau);
	return Interval(rad, tau);
}
#endif
