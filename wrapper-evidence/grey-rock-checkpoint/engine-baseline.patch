+    index = halo_index(v.width, v.height, r, x, y);
+    if (v.halo_cells[index] == MATERIAL_HALO_UNAVAILABLE) {
+        return false;
+    }
+    *occupied = v.halo_cells[index] != 0;
+    *distance = v.halo_distance[index];
+    return true;
