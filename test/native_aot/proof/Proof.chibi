package native_aot_proof

import compiler "project:native_compiler"
import abi "project:native_abi"
import strings "core:strings"

// One finite authored corpus drives both ordinary VM execution and native
// object execution. Expected -1 identifies an intentional runtime failure.
pub Count :: () -> int { return 16; }
pub Source :: (sample: int) -> string {
    if (sample == 0) {
        return "package scalar\nMain :: () -> int { return 42; }";
    }
    if (sample == 1) {
        return "package scalar\nMain :: () -> int { a: int = 2147483647; b := a + 1; if (b == -2147483648) { return 42; } return 1; }";
    }
    if (sample == 2) {
        return "package scalar\nMain :: () -> int { a: int = 0; sum: int = 0; while (a < 10) { sum += a; a += 1; } return sum; }";
    }
    if (sample == 3) {
        return "package scalar\nMain :: () -> int { zero: int = 0; value := false && (1 / zero == 0); if (value) { return 1; } return 42; }";
    }
    if (sample == 4) {
        return "package scalar\nMain :: () -> int { zero: int = 0; value := true || (1 / zero == 0); if (value) { return 42; } return 1; }";
    }
    if (sample == 5) {
        return "package scalar\nMain :: () -> int { a: int = -8; b := a >> 2; if (b == -2) { return 42; } return 1; }";
    }
    if (sample == 6) {
        return "package scalar\nMain :: () -> int { a: int = -2147483648; b := -a; if (b == a) { return 42; } return 1; }";
    }
    if (sample == 7) {
        return "package scalar\nMain :: () -> int { a: int = -9; if (a / 2 == -4 && a % 2 == -1) { return 42; } return 1; }";
    }
    if (sample == 8) {
        return "package scalar\nMain :: () -> int { a: int = 1; zero: int = 0; unused := a / zero; return 42; }";
    }
    if (sample == 9) {
        return "package scalar\nMain :: () -> int { a: int = -2147483648; negative: int = -1; unused := a / negative; return 42; }";
    }
    if (sample == 10) {
        return "package scalar\nMain :: () -> int { a: int = -2147483648; negative: int = -1; unused := a % negative; return 42; }";
    }
    if (sample == 11) {
        return "package scalar\nMain :: () -> int { a: int = 1; count: int = 32; unused := a << count; return 42; }";
    }
    if (sample == 12) {
        return "package scalar\nMain :: () -> int { a: int = 1; count: int = -1; unused := a >> count; return 42; }";
    }
    if (sample == 13) {
        return "package scalar\nMain :: () -> int { a: int = 0; while (a < 1000) { a += 1; } return a; }";
    }
    return "package scalar\nMain :: () -> int { value: int = 42; return value; }";
}
pub Expected :: (sample: int) -> int {
    if (sample == 2) { return 45; }
    if ((sample >= 8 && sample <= 13) || sample == 15) { return -1; }
    return 42;
}

pub Budget :: (sample: int) -> int {
    if (sample == 0 || sample == 15) { return 1; }
    if (sample == 14) { return 2; }
    return 64;
}

// Pure source/diagnostic regression entry: no process or LLVM capabilities.
// Object verification and execution consume Source/Expected separately.
pub Tests :: () -> int {
    index: int = 0;
    while (index < Count()) {
        switch compiler.Compile("/project", "Scalar.chibi", Source(index), abi.LinuxX64(), true, Budget(index)) {
            case .Rejected(diagnostic):
                return index + 1;
            case .Emitted(text):
                if (!strings.Contains(text, "define i32 @main()")) {
                    return index + 20;
                }
        }
        index += 1;
    }
    rejected: string[] = [
        "package scalar\nMain :: () -> string { return \"not native\"; }",
        "package scalar\nMain :: (value: int[]) -> int { return value[0]; }",
        "package scalar\nMain :: (value: uint64) -> int { return int(value); }",
        "package scalar\nMain :: () -> int { a: int = 257; return int(byte(wrap: a)); }",
        "package scalar\nMain :: () -> int { return 1; }\nOther :: () -> int { return 2; }",
        "package scalar\nThing :: struct { value: int; }\nMain :: () -> int { return 1; }",
        "package scalar\nMain :: () -> bool { return true; }",
        "package scalar\nMain :: () -> int { return Main(); }",
        "package scalar\nMain :: (value: ref int) -> int { return value; }",
        "package scalar\nMain :: () -> int { values: int[] = [1]; return values[0]; }",
        "package scalar\nMain :: () -> int { return ; invalid }"
    ];
    index = 0;
    for (source in rejected) {
        switch compiler.Compile("/project", "Scalar.chibi", source, abi.LinuxX64(), true, 64) {
            case .Rejected(diagnostic):
                if (diagnostic.message == "") { return 50 + index; }
            case .Emitted(text):
                return 70 + index;
        }
        index += 1;
    }
    return 0;
}

// Transport for the native verifier/executor lane. Tests reports diagnostics
// through a nonzero case number; this entry never substitutes hand-written IR.
pub IR :: (sample: int) -> string {
    switch compiler.Compile("/project", "scalar/Scalar.chibi", Source(sample), abi.LinuxX64(), true, Budget(sample)) {
        case .Rejected(diagnostic):
            return "";
        case .Emitted(text):
            return text;
    }
}
