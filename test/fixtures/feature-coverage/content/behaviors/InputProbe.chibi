InputProbe :: behavior {
    on Input :: (Direction: vec2) {
        pointer := get_pointer_ray()
        if pointer.Active {
            self.Aim.direction = vec2(pointer.Direction.x, pointer.Direction.z)
        }
        self.Transform += Direction
        if input.Shoot.held {
            self.Aim.firing = true
        }
        if input.Shoot.pressed {
            self.Aim.firing = true
        }
        if controller_connected(0) {
            self.Aim.firing = true
        }
    }
}
