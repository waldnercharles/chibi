AutoWeaponBehavior :: behavior {
    Elapsed: float = 0.0
    on Tick {
        if find_nearest_entity(self.Transform, 600.0, 2, self).Found {
            await Fire_Ready_Projectiles(self.Transform, direction_to<Direction_To>(self.Transform, find_nearest_entity(self.Transform, 600.0, 2, self).Position), self.Weapon.damage)
        }
    }
    Fire_Ready_Projectiles :: (Origin: struct<CF_V2> = null, Direction: struct<CF_V2> = null, Damage: int = 0) {
        after entry {
            Elapsed = Elapsed + delta_time()
            while WeaponActions.Check_Firing_Interval(Elapsed, self.Weapon.cooldown).Ready {
                Elapsed = WeaponActions.Check_Firing_Interval(Elapsed, self.Weapon.cooldown).Remainder
                await WeaponActions.Fire_Projectile(entry.Origin, entry.Direction, entry.Damage, Projectile, self)
            }
            return
        }
    }
}
