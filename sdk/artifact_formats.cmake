# Include after selected runtime targets and their scoped public headers exist.
set(CHIBI_ARTIFACT_FORMAT_RECORDS "")
# Hashes one owning source and its scoped public header into a JSON fragment.
function(chibi_artifact_owner out name target source header)
    get_target_property(owner ${target} EXPORT_NAME)
    set(source_path "${CHIBI_SDK_ROOT}/src/${source}")
    set(header_path "${CHIBI_SDK_HEADER_ROOT}/${owner}/${header}")
    if(NOT EXISTS "${source_path}" OR NOT EXISTS "${header_path}")
        message(FATAL_ERROR "Missing configured artifact format owner: ${name}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${source_path}" "${CHIBI_SDK_ROOT}/src/${header}")
    file(SHA256 "${source_path}" source_hash)
    file(SHA256 "${header_path}" header_hash)
    set(${out} "\"source\": \"src/${source}\", \"sha256\": \"${source_hash}\", \"header\": \"src/${header}\", \"header_sha256\": \"${header_hash}\"" PARENT_SCOPE)
    set(${out}_header "${header_path}" PARENT_SCOPE)
endfunction()

# Formats that encode through types/value_wire also record that codec, so a
# codec change changes their metadata.
function(chibi_artifact_format name target source header macro)
    if(NOT TARGET ${target})
        return()
    endif()
    chibi_artifact_owner(owned ${name} ${target} ${source} ${header})
    file(STRINGS "${owned_header}" declaration REGEX "^#define ${macro} ")
    string(REGEX REPLACE "^#define ${macro} (UINT64_C\\()?([0-9]+)\\)?.*$" "\\2" version "${declaration}")
    if(NOT version MATCHES "^[0-9]+$")
        message(FATAL_ERROR "Missing owning artifact format version: ${name}/${macro}")
    endif()
    set(record "\"${name}\": {\"version\": ${version}, ${owned}")
    if("VALUE_WIRE" IN_LIST ARGN)
        chibi_artifact_owner(codec ${name} chibi_types types/value_wire.c types/value_wire.h)
        string(APPEND record ", \"codec\": {${codec}}")
    endif()
    if("EXECUTION_CODECS" IN_LIST ARGN)
        string(APPEND record ", \"implementation\": [")
        set(separator "")
        foreach(source IN ITEMS execution/prepared_function.c execution/prepared_record.c)
            set(path "${CHIBI_SDK_ROOT}/src/${source}")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
            file(SHA256 "${path}" hash)
            string(APPEND record "${separator}{\"source\": \"src/${source}\", \"sha256\": \"${hash}\"}")
            set(separator ", ")
        endforeach()
        string(APPEND record "]")
    endif()
    string(APPEND record "}")
    if(CHIBI_ARTIFACT_FORMAT_RECORDS)
        set(record "${CHIBI_ARTIFACT_FORMAT_RECORDS},\n${record}")
    endif()
    set(CHIBI_ARTIFACT_FORMAT_RECORDS "${record}" PARENT_SCOPE)
endfunction()

