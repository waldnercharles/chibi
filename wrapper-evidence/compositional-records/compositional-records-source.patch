+RecordFieldType :: (types: TypeDecl[], value: ValueType) -> bool {
+    if (value.container != 0 && value.container != ArrayContainer) {
+        return false;
+    }
+    if (value.storage == PointerStorage) {
+        return value.record >= 0 && types[value.record].kind == PointerDecl;
+    }
+    if (value.storage == StructStorage) {
+        return value.record >= 0 &&
+               (types[value.record].kind == RecordDecl || types[value.record].kind == NativeDecl);
+    }
+    return value.record < 0 && (Integer(value.storage) || Floating(value.storage) ||
+                                value.storage == BoolStorage || value.storage == TextStorage);
+}
+RecordFieldSize :: (field: TypeMember, types: TypeDecl[], target: Target) -> int {
+    if (field.container == ArrayContainer) {
