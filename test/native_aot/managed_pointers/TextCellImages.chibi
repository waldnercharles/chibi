package text_cell_images
import native "project:llvm_native"
import abi "project:native_abi"
import link "project:native_link"
import host "project:native_link_host"
import os "core:os"
import strings "core:strings"
foreign import libc "system:c"
foreign libc { strtoll :: (text: cstring, end: rawptr, base: i32) -> i64 }

Old :: (target: abi.Target, tag: i64, optional: bool, authored: bool, member_tags: i64[]) -> string {
    text := abi.TextStorage; pointer := native.PointerType;
    records: native.Record[] = []; fields: int[] = []; tags: i64[] = [];
    if (optional || authored) {
        text = native.RecordType;
        records = [{first: 0, count: 2, identity: tag}];
        fields = [abi.IntStorage, abi.TextStorage];
        tags = [i64(0), 0];
        if (authored) { fields[0] = native.PointerType; tags = member_tags; }
    }
    code: native.Instruction[] = [
        {op: native.Constant, type: text, output: 0, left: 0, right: 0, target: 0, literal: 0},
        {op: native.ManagedNew, type: pointer, output: 1, left: 0, right: text, target: 0, literal: tag},
        {op: native.Publish, type: pointer, output: 0, left: 1, right: 0, target: 0, literal: 0},
        {op: native.Return, type: 0, output: 0, left: 0, right: 0, target: 0, literal: 0}];
    shape: native.Function = {result: pointer, first_parameter: 0, parameters: 0, first_slot: 0, slots: 2,
        first_local: 0, locals: 0, first_code: 0, code: length(code), first_argument: 0, arguments: 0};
    module := "";
    switch native.EmitFamilyLibraryStates(target, "TextCell", ["Create"], [i64(1)], [shape], [], [text, pointer], [],
        code, [], records, fields, tags, ["old"], 1, [], -1, []) {
        case .Rejected(pc, message): os.Print(message); return "";
        case .Emitted(output): module = output;
    }
    owner := format_text("  %heap.at = getelementptr {}, ptr @chibi_context, i32 0, i32 {}\n  %heap = load ptr, ptr %heap.at\n", abi.ManagedContextType(), abi.ManagedOwnerField);
    payload := abi.TextType();
    if (optional || authored) { payload = "%record0"; }
    load := format_text("  %text = load {}, ptr %address\n", abi.TextType());
    if (optional || authored) { load = "  %optional = load %record0, ptr %address\n  %text = extractvalue %record0 %optional, 1\n"; }
    return strings.Concatenate([module,
        "@text_cell.root = internal global %chibi.managed.root zeroinitializer\n",
        format_text("@text_cell.value = internal global {} zeroinitializer\n", abi.ManagedPointerType()),
        "define i32 @text_cell_create(ptr %out) {\nentry:\n", owner,
        format_text("  %value = call {} @chibi_scalar.0(ptr @chibi_context)\n  store {} %value, ptr %out\n  store {} %value, ptr @text_cell.value\n", abi.ManagedPointerType(), abi.ManagedPointerType(), abi.ManagedPointerType()),
        "  call void @chibi_managed.push(ptr %heap, ptr @text_cell.root, ptr @text_cell.value, ptr @chibi_managed.trace.pointer)\n  ret i32 0\n}\n",
        "define i32 @text_cell_read() {\nentry:\n", owner,
        format_text("  %value = load {}, ptr @text_cell.value\n", abi.ManagedPointerType()),
        format_text("  %address = call ptr @chibi_managed.address(ptr %heap, {} %value, i64 {}, i64 ptrtoint (ptr getelementptr ({}, ptr null, i32 1) to i64), i32 {})\n", abi.ManagedPointerType(), tag, payload, text),
        load, format_text("  %data = extractvalue {} %text, 0\n", abi.TextType()),
        "  %byte = load i8, ptr %data\n  %number = zext i8 %byte to i32\n  ret i32 %number\n}\n",
        "define i32 @text_cell_release() {\nentry:\n", owner,
        "  call void @chibi_managed.pop(ptr %heap, ptr @text_cell.root)\n",
        format_text("  store {} zeroinitializer, ptr @text_cell.value\n  ret i32 0\n}}\n", abi.ManagedPointerType())]);
}
Main :: () -> int {
    args := os.Arguments();
    if (length(args) != 4 && length(args) != 5 && length(args) != 7) { return 2; }
    optional := length(args) == 5;
    authored := length(args) == 7;
    if ((optional && args[4] != "optional") || (authored && args[4] != "record")) { return 2; }
    member_tags: i64[] = [];
    if (authored) {
        for (index in 5..<7) {
            member := strtoll(args[index], 0, 10);
            if (member == 0 || format_text("{}", member) != args[index]) { return 2; }
            member_tags.append(member);
        }
    }
    work := args[0]; llvm := args[1];
    read := os.ReadText(args[2]); if (read.error) { return 2; }
    tag := strtoll(args[3], 0, 10); if (tag == 0 || format_text("{}", tag) != args[3]) { return 2; }
    source := read.text; writer := ""; literal := "";
    prefix := format_text("define internal {} @", abi.ManagedPointerType());
    for (line in strings.SplitLines(source)) {
        if (strings.HasPrefix(line, prefix) && strings.Contains(line, format_text(", {} %arg0)", abi.ManagedPointerType()))) {
            if (writer != "") { return 2; }
            first := strings.Index(line, "@"); last := strings.Index(line, "(");
            writer = strings.Slice(line, first, last - first);
        }
        if (strings.HasPrefix(line, "@chibi_scalar.text.") && strings.Contains(line, "c\"new image literal\\00\"")) {
            if (literal != "") { return 2; }
            literal = strings.Slice(line, 0, strings.Index(line, " = "));
        }
    }
    if (writer == "" || literal == "" || !strings.Contains(source, "; chibi-family")) { return 2; }
    source = strings.ReplaceAll(source, strings.Concatenate([literal, " = private unnamed_addr constant"]),
        strings.Concatenate([literal, " = internal global"]));
    adapter := strings.Concatenate([
        "define i32 @text_cell_write(ptr %pointer) {\nentry:\n",
        format_text("  %value = load {}, ptr %pointer\n  %changed = call {} {}(ptr @chibi_context, {} %value)\n", abi.ManagedPointerType(), abi.ManagedPointerType(), writer, abi.ManagedPointerType()),
        format_text("  store {} %changed, ptr %pointer\n  ret i32 0\n}}\n", abi.ManagedPointerType()),
        format_text("define i32 @text_cell_clobber() {{\nentry:\n  store i8 90, ptr {}\n  ret i32 0\n}}\n", literal)]);
    // Only the actual source Write function changes in the negative control.
    first := strings.Index(source, strings.Concatenate([prefix, strings.Slice(writer, 1, strings.ByteLength(writer) - 1), "("]));
    tail := strings.Slice(source, first, strings.ByteLength(source) - first);
    end := strings.Index(tail, "\n}") + 2;
    body := strings.Slice(tail, 0, end); broken: string[] = []; skipped := 0;
    for (line in strings.SplitLines(body)) {
        if (strings.Contains(line, " = call ") && strings.Contains(line, "@chibi_text.share(")) {
            result := strings.Slice(line, 0, strings.Index(line, " = "));
            argument := strings.Slice(line, strings.LastIndex(line, " %") + 1, strings.ByteLength(line) - strings.LastIndex(line, " %") - 2);
            broken.append(format_text("{} = select i1 true, {} {}, {} zeroinitializer", result, abi.TextType(), argument, abi.TextType()));
            skipped += 1;
        } else { broken.append(line); }
    }
    if (skipped != 1) { return 2; }
    negative := strings.ReplaceAll(source, body, strings.Join(broken, "\n"));
    target := abi.LinuxX64(); if (os.Platform() == "Darwin") { target = abi.MacOSArm64(); }
    old := Old(target, tag, optional, authored, member_tags); if (old == "") { return 1; }
    start := strings.Concatenate([work, "/text-cell-start.ll"]);
    if (os.WriteText(start, link.ManagedFamilyContext(link.SharedContext(target.triple, true), true))) { return 2; }
    for (name in ["old", "writer", "broken"]) {
        current := old;
        if (name == "writer") { current = strings.Concatenate([source, adapter]); }
        if (name == "broken") { current = strings.Concatenate([negative, adapter]); }
        path := format_text("{}/text-cell-{}.ll", work, name);
        if (os.WriteText(path, current)) { return 2; }
        for (level in [int(0), 2]) {
            output := format_text("{}/text-cell-{}-O{}.so", work, name, level);
            objects := [strings.Concatenate([output, ".o"]), strings.Concatenate([output, "-start.o"])];
            if (host.Objects(llvm, [path, start], objects, level, 1)) { return 1; }
            plan := link.Program(target.triple, llvm, objects, [], [], [], output, "", false); plan.shared = true;
            if (os.Platform() == "Darwin") { plan.imports = [{name: "System", symbols: ["malloc", "calloc", "free", "write", "abort", "memcpy", "memset", "__error"]}]; }
            else { plan.libraries = ["c"]; }
            if (host.Link(plan)) { return 1; }
        }
    }
    return 0;
}
