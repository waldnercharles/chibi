@import "SanctumTheme.rcss";

#panel { width: 1000dp; }

.wallet.res { color: #b9a6ff; }
.wallet.res .unit { color: #7d6cb8; }
.orb {
  display: inline-block; width: 9dp; height: 9dp; margin-right: 9dp; vertical-align: middle;
  background-color: #9d7bff; border-radius: 5dp;
}

.branches { display: flex; justify-content: space-between; }

.branch {
  display: block; width: 306dp; padding: 12dp 0 0 0;
  background-color: #0b152080; border: 1dp #ffffff0d; border-radius: 6dp;
  .btitle { display: block; text-align: center; font-size: 12dp; letter-spacing: 5dp; text-transform: uppercase; color: #eef6ff; }
  .bsub { display: block; margin-top: 3dp; text-align: center; font-size: 9dp; letter-spacing: 1dp; color: #6a8190; }
}

.tree { display: block; position: relative; width: 300dp; height: 356dp; }

.edge {
  display: block; position: absolute; height: 2dp; background-color: #ffffff12;
  transform-origin: 0 50%; border-radius: 1dp;
  transition: background-color 0.3s cubic-out;
}
.edge.lit { background-color: #9d7bff55; }
.edge.lit.done { background-color: #b9a6ff; }

.node {
  display: block; position: absolute; width: 44dp; height: 44dp;
  .ring {
    display: block; width: 100%; height: 100%; padding-top: 9dp; text-align: center;
    background-color: #0a121a; border: 1dp #ffffff1e; border-radius: 22dp;
    transition: background-color border-color transform 0.18s cubic-out;
  }
  .val { display: block; font-size: 11dp; line-height: 13dp; color: #6a7f8d; }
  .tag { display: block; font-size: 7dp; line-height: 10dp; letter-spacing: 1dp; text-transform: uppercase; color: #4f6370; }
}
.node.open .ring { border-color: #9d7bff; background-color: #9d7bff1a; }
.node.open .val { color: #efe9ff; }
.node.open .tag { color: #b9a6ff; }
.node.open.poor .ring { border-color: #9d7bff66; background-color: #9d7bff0a; }
.node.open.poor .val { color: #9c8fc4; }
.node.owned .ring { border-color: #cbbdff; background-color: #9d7bff; }
.node.owned .val { color: #140c2a; }
.node.owned .tag { color: #2b1d5c; }
.node:hover .ring { transform: scale(1.08); }
.node.open:hover .ring { border-color: #e2d9ff; }

.node.cap { width: 56dp; height: 56dp; }
.node.cap .ring { padding-top: 0; border-radius: 28dp; border-width: 2dp; }
.gem {
  display: block; width: 16dp; height: 16dp; margin: 18dp auto 0 auto;
  background-color: #33404a; transform: rotate(45deg);
  transition: background-color 0.2s cubic-out;
}
.node.cap.open .gem { background-color: #b9a6ff; }
.node.cap.owned .gem { background-color: #140c2a; }
.caption {
  display: block; position: absolute; left: -40dp; width: 136dp; top: 62dp; text-align: center;
  font-size: 9dp; letter-spacing: 2dp; text-transform: uppercase; color: #5d7280;
}
.node.cap.open .caption { color: #b9a6ff; }
.node.cap.owned .caption { color: #e2d9ff; }

.tip {
  display: none; position: absolute; top: 52dp; width: 190dp; z-index: 10;
  padding: 10dp 12dp; background-color: #0d1624f7; border: 1dp #9d7bff55; border-radius: 5dp;
  .tname { display: block; font-size: 12dp; color: #f2f7ff; }
  .tdesc { display: block; margin-top: 4dp; font-size: 10dp; line-height: 14dp; color: #a9bac6; }
  .tfoot { display: block; margin-top: 7dp; font-size: 9dp; letter-spacing: 0.5dp; }
  .cost { color: #b9a6ff; }
  .need { display: block; margin-top: 3dp; color: #6a8190; }
}
.node.cap .tip { top: 64dp; }
.tip.up { top: auto; bottom: 52dp; }
.node.cap .tip.up { top: auto; bottom: 64dp; }
.node:hover .tip { display: block; }
