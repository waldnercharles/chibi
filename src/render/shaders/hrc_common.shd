// From Neon-Swarm shaders/hrc_common.shd.
// Shared HRC cascade utilities: interval type, float16 packing, probe helpers.

struct Interval
{
	vec3 rad;
	float tau;
};

vec4 f16_load(uvec2 packed)
{
	return vec4(unpackHalf2x16(packed.x), unpackHalf2x16(packed.y));
}

uvec2 f16_store(vec4 val)
{
	return uvec2(packHalf2x16(val.xy), packHalf2x16(val.zw));
}

int probe_count(int world_w, int n)
{
	int step = 1 << n;
	return (world_w + step - 1) / step;
}

// RGB9_E5 stores nonnegative HDR fluence in four bytes. Optical intervals
// retain RGB16F plus half-float optical depth; only angular fluence is packed.
uint fluence_store(vec3 value)
{
    vec3 color = clamp(value, vec3(0.0), vec3(65408.0));
    float maximum = max(color.r, max(color.g, color.b));
    uint exponent = uint(max(-16, int(floatBitsToUint(maximum) >> 23) - 127) + 16);
    float scale = uintBitsToFloat((151u - exponent) << 23);
    uvec3 mantissa = uvec3(floor(color * scale + 0.5));
    if (max(mantissa.r, max(mantissa.g, mantissa.b)) == 512u) {
        exponent++;
        mantissa = uvec3(floor(color * (scale * 0.5) + 0.5));
    }
    return mantissa.r | (mantissa.g << 9) | (mantissa.b << 18) | (exponent << 27);
}

vec3 fluence_load(uint value)
{
    float scale = uintBitsToFloat(((value >> 27) + 103u) << 23);
    return vec3(value & 511u, (value >> 9) & 511u, (value >> 18) & 511u) * scale;
}

// Integrate the authored source through an additional participating medium.
// Adding fog must attenuate a clear emitter, never change its source strength
// when optical depth crosses the original surface/clear emission threshold.
vec3 medium_emission(vec4 emission, float tau, float distance, float surface_epsilon, float pixel_size, float opacity)
{
    float material_tau = max(tau - emission.a, 0.0);
    float material_depth = material_tau * distance;
    vec3 source = emission.rgb * (material_depth > -log(1.0 - surface_epsilon) ? material_tau : pixel_size);
    float depth = tau * distance;
    float integral = depth < .01 ? distance * (1.0 - .5 * depth + depth * depth / 6.0)
                                 : opacity / tau;
    return source * integral;
}
