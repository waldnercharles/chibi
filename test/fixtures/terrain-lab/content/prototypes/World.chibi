package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("World")),
            data.Field.Named("components", data.Object([
                data.Field.Named("Gravity", data.Object([
                    data.Field.Named("acceleration", data.Object([
                        data.Field.Named("y", data.Value.Real(360.0))
                    ]))
                ])),
                data.Field.Named("HRC2D", data.Object([
                    data.Field.Named("ambient", data.Value.Real(1.0)),
                    data.Field.Named("intensity", data.Value.Real(1.0)),
                    data.Field.Named("resolution", data.Value.Real(0.5))
                ])),
                data.Field.Named("MaterialDestructionWorld", data.Object([
                    data.Field.Named("fragment_limit", data.Value.UInt(16))
                ])),
                data.Field.Named("Ui", data.Object([
                    data.Field.Named("document", data.Value.Text("QuarryHud"))
                ]))
            ]))
        ])
    );
}
