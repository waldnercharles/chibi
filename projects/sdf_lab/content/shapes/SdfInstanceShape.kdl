version 3
name "SdfInstanceShape"
domain "shape"
bounds_x 48.0
bounds_y 48.0
id_counter 209
description "Rounded body with a through-bore. Radius and Bore are named shape parameters; the crowd shares defaults, while four controls override them."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Shader Shape Output"
            - id=3 type="Shader ObjectPosition"
            - {
                id 5
                type "Shader Parameter"
                reference_name "Radius"
                outputs Value=21.0
            }
            - {
                id 7
                type "Shader Parameter"
                reference_id 1
                reference_name "Bore"
                outputs Value=7.0
            }
            - {
                id 47
                type "Behavior Expression"
                reference_name "abs(p) - vec3(radius * 1.1, radius * 0.6, radius * 0.75)"
                inputs {
                    p id=48 type="struct" type_name="ShaderVec3"
                    radius id=49 type="float"
                }
                outputs {
                    Result id=50 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 91
                type "Behavior Expression"
                reference_name "length(max(offset, 0)) + min(max(max(offset.x, offset.y), offset.z), 0) - 3"
                inputs {
                    offset id=92 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=93 type="float"
                }
            }
            - {
                id 158
                type "Behavior Expression"
                reference_name "length(p.xz) - bore"
                inputs {
                    p id=159 type="struct" type_name="ShaderVec3"
                    bore id=160 type="float"
                }
                outputs {
                    Result id=161 type="float"
                }
            }
            - {
                id 205
                type "Behavior Expression"
                reference_name "max(body, -opening)"
                inputs {
                    body id=206 type="float"
                    opening id=207 type="float"
                }
                outputs {
                    Result id=208 type="float"
                }
            }
        }
        (array)edges {
            - from="3.Value" to="47.p"
            - from="3.Value" to="158.p"
            - from="5.Value" to="47.radius"
            - from="7.Value" to="158.bore"
            - from="47.Result" to="91.offset"
            - from="91.Result" to="205.body"
            - from="158.Result" to="205.opening"
            - from="205.Result" to="1.Distance"
        }
    }
    - id=9 kind="function" math_expression="abs(p) - vec3(radius * 1.1, radius * 0.6, radius * 0.75)" entry_id=10
    - id=51 kind="function" math_expression="length(max(offset, 0)) + min(max(max(offset.x, offset.y), offset.z), 0) - 3" entry_id=95
    - id=143 kind="function" math_expression="length(p.xz) - bore" entry_id=163
    - id=187 kind="function" math_expression="max(body, -opening)" entry_id=188
}
