behavior "Pursuit" {
    value find_nearest_entity = find_nearest_entity(self.Transform, 600.0, 1, 0)
    value direction_speed_velocity = direction_to(self.Transform, convert<"game_transform_to_cf">(find_nearest_entity.Position)) * cast<double>(self.Movement.Speed) - self.Velocity
    on Tick {
        if find_nearest_entity.Found {
            self.Velocity += direction_speed_velocity * min(1, 120.0 * cast<double>(delta) / max(length(direction_speed_velocity), 0.0001))
        } else {
            self.Velocity = vec2(0, 0)
        }
    }
}
